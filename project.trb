name "torbscript/torbscript"
version "0.1.0"

// The standard library, the toolchain that is written in it, the examples and the performance suite. `tests/` is not
// a member: its two workspaces hold inputs of a test rather than parts of the toolchain, and each is checked on its
// own (`torb check tests/conformance tests/language`).
workspace {
  members "std/*", "compiler", "examples/*", "benchmarks"
}

// This package has no tests of its own - every test belongs to a member (`compiler/tests`, `std/*/tests`,
// `examples/*/tests`) - and `tests/` holds the inputs of other workspaces. Without this line `tests/` would be the
// test directory of *this* package and every program below it a module of it.
test {
  input "no-tests"
}
