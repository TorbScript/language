name = "torbscript/torbscript"
version = "0.1.0"

// The standard library, the toolchain that is written in it, the examples and the performance suite. `tests/` is not
// a member: its two workspaces hold inputs of a test rather than parts of the toolchain, and each is checked on its
// own (`torb check tests/conformance tests/language`). A workspace has no test directory of its own, so `tests/` is not
// swept into this package either: every test belongs to a member (`compiler/tests`, `std/*/tests`, `examples/*/tests`).
workspace {
  members "std/*", "compiler", "examples/*", "benchmarks"
}
