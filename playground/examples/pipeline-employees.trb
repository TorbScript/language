// filter, groupBy and map are lazy until a terminal operation pulls the values through.

type Employee {
  name: String
  department: String
  salary: Int
  active: Bool = true
}

const employees = [
  Employee(name: "Ada", department: "Engineering", salary: 95000),
  Employee(name: "Grace", department: "Engineering", salary: 105000),
  Employee(name: "Alan", department: "Research", salary: 88000),
  Employee(name: "Margaret", department: "Research", salary: 91000, active: false),
]

const teams = employees.filter({ _.active }).groupBy({ _.department })

for (department, team) in teams {
  const total = team.map({ _.salary }).sum()
  print "{department}: {team.count()} active, {total} total salary"
}
