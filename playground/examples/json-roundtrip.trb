// Encode and Decode are generated for an ordinary type: nothing written for the format at all.

use Json from "std/json"

type Point {
  x: Int
  y: Int
}

type Shape {
  name: String
  points: List<Point>
}

const triangle = Shape name: "triangle", points: [Point(0, 0), Point(4, 0), Point(0, 3)]

const json = Json()
const text = json.encode triangle
print text

match json.decode<Shape>(text) {
  Ok(shape) => print "decoded {shape.name} with {shape.points.count()} points"
  Fail(error) => print "rejected: {error}"
}
