// There is no null: absence is an Option, taken apart with ??, ?. or match.

type User {
  name: String
  nickname: String? = None
}

fn greeting(user: User): String {
  const label = user.nickname ?? user.name
  "Hey {label}!"
}

const ada = User name: "Ada", nickname: Some("Adi")
const alan = User name: "Alan"

print greeting(ada)
print greeting(alan)
print "shouted: {alan.nickname?.toUpperCase() ?? "(no nickname)"}"
