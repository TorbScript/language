// Text processing: split, groupBy and a sort by a computed key.

const reports = "sun sun rain sun cloud rain sun"

const counted = reports.split(" ")
  .groupBy({ _ })
  .map({ (condition: _.key, days: _.value.count()) })
  .toList()
  .sorted({ -_.days })

for entry in counted {
  print "{entry.condition}: {entry.days} day(s)"
}
