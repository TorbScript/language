// One keyword for data: a case for every shape, and a match that has to cover them all.

type Shape {
  case Circle(radius: Float)
  case Rectangle(width: Float, height: Float)
  case Triangle(base: Float, height: Float)

  fn area(): Float {
    match self {
      .Circle(radius) => Float.pi * radius ** 2
      .Rectangle(width, height) => width * height
      .Triangle(base, height) => base * height / 2
    }
  }

  fn name(): String {
    match self {
      .Circle(...) => "circle"
      .Rectangle(...) => "rectangle"
      .Triangle(...) => "triangle"
    }
  }
}

const shapes = [Shape.Circle(2.0), Shape.Rectangle(3.0, 4.0), Shape.Triangle(6.0, 2.0)]

for shape in shapes {
  print "{shape.name()}: area {shape.area()}"
}
