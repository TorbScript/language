// A trait used as a type: Circle and Square share nothing but Area, and a List<Area> holds both.

trait Area {
  fn area(): Float
}

type Circle with Area {
  radius: Float

  fn area(): Float {
    Float.pi * radius ** 2
  }
}

type Square with Area {
  side: Float

  fn area(): Float {
    side * side
  }
}

fn totalArea(shapes: List<Area>): Float {
  shapes.map({ _.area() }).sum()
}

const shapes: List<Area> = [Circle(2.0), Square(3.0)]

for shape in shapes {
  print "area: {shape.area()}"
}
print "total: {totalArea(shapes)}"
