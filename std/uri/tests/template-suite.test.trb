/**
 * RFC 6570 expansion against the `uritemplate-test` suite (https://github.com/uri-templates/uritemplate-test, Apache
 * License 2.0, copyright 2011- The Authors): the specification's examples of each level and of each operator, the
 * extended tests and the negative tests, one assert per case. Generated from the suite's JSON; where it accepts several
 * expansions (an object's pairs have no order in JSON, and `Pairs` keeps the order they are written in), any of them
 * passes. A negative case passes when the template is refused or its expansion fails.
 */

use test, group from "std/test"
use UriTemplate, TemplateValue from "../src/template"

/** Whether `template` reads and expands with `values` into one of `accepted`. */
fn expandsTo(template: String, values: Map<String, TemplateValue>, accepted: List<String>): Bool {
  match UriTemplate.tryFrom(template) {
    Ok(parsed) => {
      match parsed.expandedText(values) {
        Ok(text) => accepted.contains text
        Fail(_) => false
      }
    }
    Fail(_) => false
  }
}

/** Whether `template` is refused, or its expansion with `values` fails. */
fn refused(template: String, values: Map<String, TemplateValue>): Bool {
  match UriTemplate.tryFrom(template) {
    Ok(parsed) => !parsed.expandedText(values).isOk()
    Fail(_) => true
  }
}

