/**
 * Uniform Resource Identifiers as values: [Uri] and [UriReference] after RFC 3986, read and normalized at construction,
 * so `==`, `hash()` and `compare()` are over the canonical form; IRIs (RFC 3987) read as the URI they stand for and shown
 * back by `iriText()`; [Urn] after RFC 8141; [UriTemplate] after RFC 6570; the `file:` bridge to `Path` after RFC 8089;
 * and the `application/x-www-form-urlencoded` codec of HTML forms.
 *
 * Nothing in `std/uri` touches anything - no network, no file system, no capability. An IP literal host is an address
 * of `std/ip`, and resolving a name or opening a connection is `std/network`'s. `Uri` and `UriError` are in the prelude;
 * everything else is an import (docs/design/URI.md).
 *
 *     const base = Uri.tryFrom("https://example.test/guide/start.html")?
 *     const link = UriReference.tryFrom("../reference/index.html#top")?
 *     print link.resolved(against: base)
 */

public use Uri, UriReference from "./uri"
public use Authority, Host from "./authority"
public use UriError from "./error"
public use Urn from "./urn"
public use UriTemplate, TemplateValue from "./template"
public use formDecoded, formEncoded from "./form"
public use percentDecoded from "./characters"
