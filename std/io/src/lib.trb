/**
 * The three streams every process is started with. They are ordinary `Source` and `Sink` values (`docs/design/STREAMS.md`),
 * so everything that reads a file reads standard input, and everything that writes a file writes to the screen:
 *
 *     const total = lines().count().await()?
 *     standardOutput().addLine("{total} lines").await()?
 *
 * `print`/`printError` of the prelude and `readLine()` here stay as the short form for the common case: a program that
 * prints a line does not want to think about a stream.
 */

use IoError from "std/fs"
use ArrayList from "std/collections"
use Source, Sink, Bytes from "std/stream"
use lines as lineStage from "std/stream"

/** The next line of standard input without its line break, `None` at the end of the input. */
public native fn readLine(): String?

/** Standard input as a stream of byte chunks, each read on a thread of the blocking pool as it arrives. */
public fn standardInput(): Source<Bytes, IoError> {
  StandardInput()
}

/**
 * Standard output as a stream of byte chunks. Not buffered: every `add` goes out. `standardOutput().buffered(capacity:
 * 4096)` is the form a program that writes a lot of small pieces wants, and it says where the flush is.
 */
public fn standardOutput(): Sink<Bytes, IoError> {
  StandardWriter 1
}

/** Standard error, unbuffered for the reason it is everywhere: a diagnostic that is lost is worse than a slow one. */
public fn standardError(): Sink<Bytes, IoError> {
  StandardWriter 2
}

/**
 * The lines of standard input, as a stream: the same stage `File.lines` uses, over the same kind of source.
 *
 * # Examples
 *
 *     const total = lines().count().await()
 *     print total
 */
public fn lines(): Source<String, IoError> {
  standardInput().through(lineStage()).checked()
}

/** Standard input as a `Source`: what [standardInput] answers. There is one standard input, so every one reads it. */
shared type StandardInput with Source<Bytes, IoError> {
  var fn next(): Task<Result<Bytes?, IoError>> {
    const count = standardRead(65536).await()
    if count < 0 {
      return Fail IoError("standard input", ioFailureText(count))
    }
    if count == 0 {
      return Ok None
    }
    var bytes: ArrayList<UInt8> = ArrayList.withCapacity count
    standardTakeRead bytes
    Ok Some(bytes)
  }

  /** Nothing of its own: standard input belongs to the process. */
  var fn close() {}
}

/** Standard output (1) or standard error (2) as a `Sink`: what [standardOutput] and [standardError] answer. */
shared type StandardWriter with Sink<Bytes, IoError> {
  private stream: Int

  var fn add(item: Bytes): Task<Result<Void, IoError>> {
    const buffer: ArrayList<UInt8> = ArrayList.from item
    var from = 0
    while from < buffer.length() {
      const written = standardWrite(stream, buffer, from).await()
      if written < 0 {
        return Fail IoError(nameOf(stream), ioFailureText(written))
      }
      from = from + written
    }
    Ok void
  }

  /** Nothing is buffered, so there is nothing to flush: the stream belongs to the process and stays open. */
  var fn end(): Task<Result<Void, IoError>> {
    Ok void
  }

  var fn close() {}
}

fn nameOf(stream: Int): String {
  if stream == 2 {
    return "standard error"
  }
  "standard output"
}

// --- the natives of runtime/stream.c ---------------------------------------------------------------------------------

/** At most `maximum` bytes of standard input on a thread of the blocking pool: how many (0 at the end), or a failure. */
native fn standardRead(maximum: Int): Task<Int>

/** What the last [standardRead] got, appended to `into`. */
native fn standardTakeRead(var into: ArrayList<UInt8>)

/** The bytes of `bytes` from `from` on to standard output (1) or error (2): how many, or a failure. */
native fn standardWrite(stream: Int, bytes: ArrayList<UInt8>, from: Int): Task<Int>

/** A failure a native answered, in the operating system's own words. */
native fn ioFailureText(failure: Int): String

