/**
 * `Yaml` beyond the suite: a typed decode resolves scalars by the target type, YAML 1.1's rules for a document that
 * asks for them, merge keys, anchors, local tags through `YamlTag`, the alias limit, what an error names; encoding and
 * the quoting that keeps a text a text under both versions; the tree with its comments; the schemas; the framer.
 */

use test, group from "std/test"
use Naming, EncodedValue from "std/encoding"
use Yaml, YamlVersion, YamlNode, YamlDocument, YamlSchema, YamlTag, ScalarStyle, CollectionStyle from "../src/lib"

type Service {
  name: String
  replicas: Int = 1
  ports: List<Int> = []
  enabled: Bool = true
  labels: Map<String, String> = [:]
  owner: String? = None
}

type Flags {
  country: String
  active: Bool
}

type Point {
  x: Int
  y: Int
}

type Offset {
  x: Int = 0
  y: Int = 0
}

type Shape {
  case Circle(radius: Float)
  case Square(side: Float)
  case Empty
}

type Drawing {
  shapes: List<Shape>
}

type Entry {
  logLabel: String
}

type Blob {
  data: List<UInt8>
}

/** The qualified type name a value announces to a format, which a `YamlTag` names. */
fn typeNameOf(value: EncodedValue): String {
  match value {
    .Record(typeName, _) => typeName
    .Variant(typeName, _, _) => typeName
    _ => ""
  }
}

fn decodedService(text: String): Service? {
  Yaml().decode<Service>(text).ok()
}

fn failureOf(text: String): String {
  match Yaml().decode<Service>(text) {
    Ok(_) => "read"
    Fail(problem) => "{problem}"
  }
}

group "decoding into a type" {
  test "a field reads its scalar as its own type" {
    const service = decodedService "name: web\nreplicas: 3\nports: [80, 443]\nlabels:\n  tier: front\n"
    assert(service == Some(Service("web", 3, [80, 443], true, ["tier": "front"], None)))
  }

  test "no is the text `no` in a String field and an error in a Bool field" {
    const flags = Yaml().decode<Flags>("country: no\nactive: true\n")
    assert(flags.ok() == Some(Flags("no", true)))
    assert(!Yaml().decode<Flags>("country: no\nactive: no\n").isOk())
  }

  test "a document that says %YAML 1.1 reads yes, no, on and off as truth values" {
    const flags = Yaml().decode<Flags>("%YAML 1.1\n---\ncountry: no\nactive: yes\n")
    assert(flags.ok() == Some(Flags("no", true)))
    const legacy = Yaml(version: YamlVersion.Yaml11).decode<Flags>("country: NO\nactive: off\n")
    assert(legacy.ok() == Some(Flags("NO", false)))
  }

  test "YAML 1.1 reads 0777 as an octal number and 1_000 with its separator" {
    assert(Yaml(version: YamlVersion.Yaml11).decode<Int>("0777").ok() == Some(511))
    assert(Yaml(version: YamlVersion.Yaml11).decode<Int>("1_000").ok() == Some(1000))
    assert(Yaml(version: YamlVersion.Yaml11).decode<Int>("1:30").ok() == Some(90))
    assert(Yaml().decode<Int>("0777").ok() == Some(777))
    assert(Yaml().decode<String>("0777").ok() == Some("0777"))
  }

  test "numbers in every spelling of the core schema" {
    assert(Yaml().decode<List<Int>>("[0x1F, 0o17, -42, +7]").ok() == Some([31, 15, -42, 7]))
    assert(Yaml().decode<List<Float>>("[1.5, .5, 1e3, 2]").ok() == Some([1.5, 0.5, 1000.0, 2.0]))
    const special = Yaml().decode<List<Float>>("[.inf, -.inf]").ok() ?? []
    assert(special == [Float64.infinity, Float64.negativeInfinity])
    assert(Yaml().decode<Float>(".nan").map({ _ != _ }).ok() == Some(true))
  }

  test "a quoted scalar is a text, and an explicit tag is honoured" {
    assert(!Yaml().decode<Int>("\"5\"").isOk())
    assert(Yaml().decode<String>("\"5\"").ok() == Some("5"))
    assert(Yaml().decode<Int>("!!int \"5\"").ok() == Some(5))
    assert(!Yaml().decode<Int>("!!str 5").isOk())
  }

  test "an absent field takes its default, and null is None" {
    const service = decodedService "name: api\nowner: ~\n"
    assert(service == Some(Service("api", 1, [], true, [:], None)))
    assert(decodedService("name: api\nowner: ada\n").map({ _.owner }) == Some(Some("ada")))
  }

  test "an empty value is an empty list and an empty map" {
    assert(decodedService("name: api\nports:\nlabels:\n").map({ _.ports.length() + _.labels.length() }) == Some(0))
  }

  test "an alias reads the node its anchor stands on" {
    const text = "- &origin \{x: 1, y: 2\}\n- *origin\n"
    assert(Yaml().decode<List<Point>>(text).ok() == Some([Point(1, 2), Point(1, 2)]))
  }

  test "the merge key merges mappings, and the mapping's own keys win" {
    const text = """
      base: &base
        name: base
        replicas: 2
        enabled: false
      service:
        <<: *base
        name: web
      """
    const services = Yaml().decode<Map<String, Service>>(text).ok() ?? [:]
    assert(services.get("service") == Some(Service("web", 2, [], false, [:], None)))
  }

  test "a list of mappings merges in order" {
    const text = "a: &a \{x: 1\}\nb: &b \{x: 2, y: 3\}\nc:\n  <<: [*a, *b]\n"
    assert(Yaml().decode<Map<String, Offset>>(text).ok().flatMap({ _.get "c" }) == Some(Offset(1, 3)))
  }

  test "the merge key can be switched off" {
    assert(!Yaml(mergeKeys: false).decode<Point>("<<: \{x: 1, y: 2\}\n").isOk())
  }

  test "a case by its name, by a mapping of one entry, and by a local tag" {
    const drawing = Yaml().decode<Drawing>("shapes:\n  - Empty\n  - Circle: \{radius: 2\}\n")
    assert(drawing.ok() == Some(Drawing([Shape.Empty, Shape.Circle(2.0)])))
    const shape = typeNameOf EncodedValue.of(Shape.Empty)
    const tags = [YamlTag("!circle", shape, Some("Circle")), YamlTag("!square", shape, Some("Square"))]
    const tagged = Yaml(tags: tags).decode<List<Shape>>("- !circle \{radius: 1\}\n- !square \{side: 2\}\n")
    assert(tagged.ok() == Some([Shape.Circle(1.0), Shape.Square(2.0)]))
  }

  test "a local tag names a type through YamlTag, and an unknown one is an error that names it" {
    const point = typeNameOf EncodedValue.of(Point(0, 0))
    const yaml = Yaml tags: [YamlTag("!point", point)]
    assert(yaml.decode<Point>("!point \{x: 1, y: 2\}").ok() == Some(Point(1, 2)))
    const tagged = "!point \{x: 1, y: 2\}"
    const unknown = Yaml().decode<Point>(tagged)
    assert "{unknown}".contains("`!point` is not known")
  }

  test "naming spells the field names" {
    assert(Yaml(naming: Naming.SnakeCase).decode<Entry>("log_label: a\n").ok() == Some(Entry("a")))
  }

  test "strict refuses a field nothing read" {
    assert Yaml().decode<Point>("x: 1\ny: 2\nz: 3\n").isOk()
    assert(!Yaml(strict: true).decode<Point>("x: 1\ny: 2\nz: 3\n").isOk())
  }

  test "a failure names the line and the field chain" {
    assert(failureOf("name: web\nports:\n  - 80\n  - http\n") == "line 4: ports[1]: a whole number is needed, not `http`")
    assert(failureOf("replicas: 2\n") == "line 1: name: a value is needed")
    assert failureOf("name: [a\n").startsWith("line 2, column 1: ")
  }

  test "a stream of documents" {
    assert(Yaml().decodeDocuments<Int>("1\n---\n2\n--- 3\n").ok() == Some([1, 2, 3]))
    assert(!Yaml().decode<Int>("1\n---\n2\n").isOk())
    assert(Yaml().decode<Int?>("").ok() == Some(None))
  }

  test "bytes are base64" {
    assert(Yaml().decode<Blob>("data: !!binary aGVsbG8=\n").ok() == Some(Blob([104, 101, 108, 108, 111])))
  }

  test "aliases that expand past the limit are an error, not an exhausted memory" {
    var lines = ["a0: &a0 [x, x, x, x, x, x, x, x, x, x]"]
    for level in 1..9 {
      const previous = "*a{level - 1}"
      const items = [previous, previous, previous, previous, previous, previous, previous, previous, previous, previous]
      lines.append "a{level}: &a{level} [{items.joined(separator: ", ")}]"
    }
    const text = lines.joined(separator: "\n") + "\n"
    const result = Yaml().decode<Map<String, EncodedValue>>(text)
    assert "{result}".contains("more than 100000 nodes")
    assert(Yaml(aliasLimit: 20).decode<List<Int>>("- &a 1\n- *a\n").ok() == Some([1, 1]))
  }
}

group "encoding" {
  test "a record is a block mapping in declaration order" {
    const text = Yaml().encode(Service("web", 2, [80], true, ["tier": "front"], None))
    assert(text == "name: web\nreplicas: 2\nports:\n  - 80\nenabled: true\nlabels:\n  tier: front\nowner: null\n")
  }

  test "a string that YAML 1.1 or the core schema would misread is quoted" {
    const texts = ["no", "on", "Yes", "0777", "1_000", "12:30", "~", "", "null", "2024-01-01", "1.5", ".inf", "<<"]
    for text in texts {
      assert(Yaml().encode(text) == "\"{text}\"\n")
    }
    assert(Yaml().encode("plain text") == "plain text\n")
    assert(Yaml().encode("a: b") == "\"a: b\"\n")
    assert(Yaml().encode("- item") == "\"- item\"\n")
  }

  test "a text of several lines is a literal block" {
    assert(Yaml().encode(["first\nsecond\n"]) == "- |\n  first\n  second\n")
    assert(Yaml().encode(["  indented\nline"]) == "- |2-\n    indented\n  line\n")
  }

  test "what is written reads back as the same value" {
    const service = Service "a: b", 0, [1, 2], false, ["no": "yes", "multi": "one\ntwo"], Some("#owner")
    assert(Yaml().decode<Service>(Yaml().encode(service)).ok() == Some(service))
  }

  test "an empty list is [] and a case without fields is its name" {
    assert(Yaml().encode(Drawing([])) == "shapes: []\n")
    assert(Yaml().encode(Drawing([Shape.Empty, Shape.Circle(1.5)])) == "shapes:\n  - Empty\n  - Circle:\n      radius: 1.5\n")
  }

  test "a type YamlTag names is written with its tag" {
    const point = typeNameOf EncodedValue.of(Point(0, 0))
    const yaml = Yaml tags: [YamlTag("!point", point)]
    // `y` is a truth value to a YAML 1.1 reader, so even a key is quoted
    assert(yaml.encode([Point(1, 2)]) == "- !point\n  x: 1\n  \"y\": 2\n")
    assert(yaml.decode<List<Point>>(yaml.encode([Point(1, 2)])).ok() == Some([Point(1, 2)]))
  }

  test "bytes are written as !!binary, and a list of bytes is a sequence" {
    assert(Yaml().encode(EncodedValue.Bytes([104, 105])) == "!!binary aGk=\n")
    assert(Yaml().encode(Blob([104, 105])) == "data:\n  - 104\n  - 105\n")
  }
}

group "the tree" {
  test "a node keeps its style, its tag, its anchor and its line" {
    const document = Yaml().parse("a: 'x'\nb: !!int &n 5\nc: [1, 2]\n").ok() ?? YamlDocument(YamlNode.empty())
    const quoted = document.root.at("a") ?? YamlNode.empty()
    assert(quoted.content == .Scalar("x", ScalarStyle.SingleQuoted))
    const tagged = document.root.at("b") ?? YamlNode.empty()
    assert(tagged.tag == Some("tag:yaml.org,2002:int") && tagged.anchor == Some("n") && tagged.line == 2)
    const flow = document.root.at("c") ?? YamlNode.empty()
    assert(flow.content == .Sequence([YamlNode.scalar("1").copy(line: 3, column: 5), YamlNode.scalar("2").copy(line: 3, column: 8)], CollectionStyle.Flow))
  }

  test "comments are kept and written back where they were" {
    const text = """
      # The service
      name: web # its name
      ports:
        # the public one
        - 80
        - 443 # and TLS
      # the end
      """
    const document = Yaml().parse(text).ok() ?? YamlDocument(YamlNode.empty())
    assert(Yaml().write(document) == text)
  }

  test "updated changes one value and keeps everything else" {
    const text = "# settings\nname: web # the name\nreplicas: 2\n"
    const document = Yaml().parse(text).ok() ?? YamlDocument(YamlNode.empty())
    const changed = document.copy root: document.root.updated("replicas", YamlNode.scalar("3"))
    assert(Yaml().write(changed) == "# settings\nname: web # the name\nreplicas: 3\n")
  }

  test "anchors, aliases and tags are written back" {
    const text = "base: &base\n  x: 1\nother: *base\ntagged: !!str 5\n"
    const document = Yaml().parse(text).ok() ?? YamlDocument(YamlNode.empty())
    assert(Yaml().write(document) == text)
  }

  test "a syntax error has a line and a column" {
    match Yaml().parse("key: value\n- item\n") {
      Ok(_) => assert false
      Fail(problem) => {
        assert(problem.isSyntaxError() && problem.line() == 2)
      }
    }
  }
}

group "schemas" {
  test "the core schema resolves null, truth values and numbers, and leaves yes a text" {
    const document = Yaml().parse("[~, true, 12, 1.5, yes, 0x10]").ok() ?? YamlDocument(YamlNode.empty())
    const value = Yaml().resolved(document).ok()
    const expected = EncodedValue.Sequence([
      EncodedValue.Nothing,
      EncodedValue.Bool(true),
      EncodedValue.Int(12),
      EncodedValue.Float(1.5),
      EncodedValue.String("yes"),
      EncodedValue.Int(16),
    ])
    assert(value == Some(expected))
  }

  test "the 1.1 schema reads yes as true, and a %YAML 1.1 document is read by it" {
    const document = Yaml().parse("[yes, 010]").ok() ?? YamlDocument(YamlNode.empty())
    const expected = EncodedValue.Sequence([EncodedValue.Bool(true), EncodedValue.Int(8)])
    assert(Yaml(schema: Some(YamlSchema.Yaml11)).resolved(document).ok() == Some(expected))
    const versioned = Yaml().parse("%YAML 1.1\n--- [yes, 010]").ok() ?? YamlDocument(YamlNode.empty())
    assert(Yaml().resolved(versioned).ok() == Some(expected))
  }

  test "the failsafe schema reads every scalar as a text, and the JSON schema refuses what JSON has not" {
    const document = Yaml().parse("[1, true]").ok() ?? YamlDocument(YamlNode.empty())
    const texts = EncodedValue.Sequence([EncodedValue.String("1"), EncodedValue.String("true")])
    assert(Yaml(schema: Some(YamlSchema.Failsafe)).resolved(document).ok() == Some(texts))
    const other = Yaml().parse("[yes]").ok() ?? YamlDocument(YamlNode.empty())
    assert(!Yaml(schema: Some(YamlSchema.Json)).resolved(other).isOk())
  }
}

group "streams" {
  test "items frames a stream at its document markers, across chunk borders" {
    const text = "%YAML 1.2\n---\nx: 1\ny: 2\n--- \{x: 3, y: 4\}\n...\n---\nx: 5\ny: 6\n"
    const bytes = text.bytes().toList()
    const chunks = [bytes[0..7], bytes[7..20], bytes[20..bytes.length()]]
    const points = chunks.through(Yaml.items<Point>()).toList()
    assert(points == [Ok(Point(1, 2)), Ok(Point(3, 4)), Ok(Point(5, 6))])
  }
}
