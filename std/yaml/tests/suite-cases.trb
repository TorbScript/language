fn casesPart6(): List<SuiteCase> {
  [
    SuiteCase(
      "EX5H",
      "Multiline Scalar at Top Level [1.3]",
      "---\na\nb  \n  c\nd\n\ne\n",
      "+STR\n+DOC ---\n=VAL :a b c d\\ne\n-DOC\n-STR\n",
      "\"a b c d\\ne\"\n",
      false,
    ),
    SuiteCase(
      "EXG3",
      "Three dashes and content without space [1.3]",
      "---\n---word1\nword2\n",
      "+STR\n+DOC ---\n=VAL :---word1 word2\n-DOC\n-STR\n",
      "\"---word1 word2\"\n",
      false,
    ),
    SuiteCase(
      "F2C7",
      "Anchors and Tags",
      " - &a !!str a\n - !!int 2\n - !!int &c 4\n - &d d\n",
      "+STR\n+DOC\n+SEQ\n=VAL &a <tag:yaml.org,2002:str> :a\n=VAL <tag:yaml.org,2002:int> :2\n=VAL &c <tag:yaml.org,2002:int> :4\n=VAL &d :d\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"a\",\n  2,\n  4,\n  \"d\"\n]\n",
      false,
    ),
    SuiteCase(
      "F3CP",
      "Nested flow collections on one line",
      "---\n\{ a: [b, c, \{ d: [e, f] \} ] \}\n",
      "+STR\n+DOC ---\n+MAP \{\}\n=VAL :a\n+SEQ []\n=VAL :b\n=VAL :c\n+MAP \{\}\n=VAL :d\n+SEQ []\n=VAL :e\n=VAL :f\n-SEQ\n-MAP\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a\": [\n    \"b\",\n    \"c\",\n    \{\n      \"d\": [\n        \"e\",\n        \"f\"\n      ]\n    \}\n  ]\n\}\n",
      false,
    ),
    SuiteCase(
      "F6MC",
      "More indented lines at the beginning of folded block scalars",
      "---\na: >2\n   more indented\n  regular\nb: >2\n\n\n   more indented\n  regular\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :a\n=VAL > more indented\\nregular\\n\n=VAL :b\n=VAL >\\n\\n more indented\\nregular\\n\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a\": \" more indented\\nregular\\n\",\n  \"b\": \"\\n\\n more indented\\nregular\\n\"\n\}\n",
      false,
    ),
    SuiteCase(
      "F8F9",
      "Spec Example 8.5. Chomping Trailing Lines",
      " # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n",
      "+STR\n+DOC\n+MAP\n=VAL :strip\n=VAL |# text\n=VAL :clip\n=VAL |# text\\n\n=VAL :keep\n=VAL |# text\\n\\n\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"strip\": \"# text\",\n  \"clip\": \"# text\\n\",\n  \"keep\": \"# text\\n\\n\"\n\}\n",
      false,
    ),
    SuiteCase(
      "FBC9",
      "Allowed characters in plain scalars",
      "safe: a!\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az\{|\}~\n     !\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az\{|\}~\nsafe question mark: ?foo\nsafe colon: :foo\nsafe dash: -foo\n",
      "+STR\n+DOC\n+MAP\n=VAL :safe\n=VAL :a!\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|\}~ !\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|\}~\n=VAL :safe question mark\n=VAL :?foo\n=VAL :safe colon\n=VAL ::foo\n=VAL :safe dash\n=VAL :-foo\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"safe\": \"a!\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|\}~ !\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|\}~\",\n  \"safe question mark\": \"?foo\",\n  \"safe colon\": \":foo\",\n  \"safe dash\": \"-foo\"\n\}\n",
      false,
    ),
    SuiteCase(
      "FH7J",
      "Tags on Empty Scalars",
      "- !!str\n-\n  !!null : a\n  b: !!str\n- !!str : !!null\n",
      "+STR\n+DOC\n+SEQ\n=VAL <tag:yaml.org,2002:str> :\n+MAP\n=VAL <tag:yaml.org,2002:null> :\n=VAL :a\n=VAL :b\n=VAL <tag:yaml.org,2002:str> :\n-MAP\n+MAP\n=VAL <tag:yaml.org,2002:str> :\n=VAL <tag:yaml.org,2002:null> :\n-MAP\n-SEQ\n-DOC\n-STR\n",
      "",
      false,
    ),
    SuiteCase(
      "FP8R",
      "Zero indented block scalar",
      "--- >\nline1\nline2\nline3\n",
