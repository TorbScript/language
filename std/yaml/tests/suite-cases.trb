fn casesPart2(): List<SuiteCase> {
  [
    SuiteCase(
      "4MUZ/02",
      "Flow mapping colon on line after key",
      "\{foo\n: bar\}\n",
      "+STR\n+DOC\n+MAP \{\}\n=VAL :foo\n=VAL :bar\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo\": \"bar\"\n\}\n",
      false,
    ),
    SuiteCase(
      "4Q9F",
      "Folded Block Scalar [1.3]",
      "--- >\n ab\n cd\n \n ef\n\n\n gh\n",
      "+STR\n+DOC ---\n=VAL >ab cd\\nef\\n\\ngh\\n\n-DOC\n-STR\n",
      "\"ab cd\\nef\\n\\ngh\\n\"\n",
      false,
    ),
    SuiteCase(
      "4QFQ",
      "Spec Example 8.2. Block Indentation Indicator [1.3]",
      "- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n detected\n",
      "+STR\n+DOC\n+SEQ\n=VAL |detected\\n\n=VAL >\\n\\n# detected\\n\n=VAL | explicit\\n\n=VAL >detected\\n\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"detected\\n\",\n  \"\\n\\n# detected\\n\",\n  \" explicit\\n\",\n  \"detected\\n\"\n]\n",
      false,
    ),
    SuiteCase(
      "4RWC",
      "Trailing spaces after flow collection",
      "  [1, 2, 3]  \n  ",
      "+STR\n+DOC\n+SEQ []\n=VAL :1\n=VAL :2\n=VAL :3\n-SEQ\n-DOC\n-STR\n",
      "[\n  1,\n  2,\n  3\n]\n",
      false,
    ),
    SuiteCase(
      "4UYU",
      "Colon in Double Quoted String",
      "\"foo: bar\\\": baz\"\n",
      "+STR\n+DOC\n=VAL \"foo: bar\": baz\n-DOC\n-STR\n",
      "\"foo: bar\\\": baz\"\n",
      false,
    ),
    SuiteCase(
      "4V8U",
      "Plain scalar with backslashes",
      "---\nplain\\value\\with\\backslashes\n",
      "+STR\n+DOC ---\n=VAL :plain\\\\value\\\\with\\\\backslashes\n-DOC\n-STR\n",
      "\"plain\\\\value\\\\with\\\\backslashes\"\n",
      false,
    ),
    SuiteCase(
      "4WA9",
      "Literal scalars",
      "- aaa: |2\n    xxx\n  bbb: |\n    xxx\n",
      "+STR\n+DOC\n+SEQ\n+MAP\n=VAL :aaa\n=VAL |xxx\\n\n=VAL :bbb\n=VAL |xxx\\n\n-MAP\n-SEQ\n-DOC\n-STR\n",
      "[\n  \{\n    \"aaa\" : \"xxx\\n\",\n    \"bbb\" : \"xxx\\n\"\n  \}\n]\n",
      false,
    ),
    SuiteCase(
      "4ZYM",
      "Spec Example 6.4. Line Prefixes",
      "plain: text\n  lines\nquoted: \"text\n  \tlines\"\nblock: |\n  text\n   \tlines\n",
      "+STR\n+DOC\n+MAP\n=VAL :plain\n=VAL :text lines\n=VAL :quoted\n=VAL \"text lines\n=VAL :block\n=VAL |text\\n \\tlines\\n\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"plain\": \"text lines\",\n  \"quoted\": \"text lines\",\n  \"block\": \"text\\n \\tlines\\n\"\n\}\n",
      false,
    ),
    SuiteCase(
      "52DL",
      "Explicit Non-Specific Tag [1.3]",
      "---\n! a\n",
      "+STR\n+DOC ---\n=VAL <!> :a\n-DOC\n-STR\n",
      "\"a\"\n",
      false,
    ),
    SuiteCase(
      "54T7",
      "Flow Mapping",
      "\{foo: you, bar: far\}\n",
      "+STR\n+DOC\n+MAP \{\}\n=VAL :foo\n=VAL :you\n=VAL :bar\n=VAL :far\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo\": \"you\",\n  \"bar\": \"far\"\n\}\n",
      false,
    ),
    SuiteCase(
      "55WF",
      "Invalid escape in double quoted string",
      "---\n\"\\.\"\n",
      "+STR\n+DOC ---\n",
      "",
      true,
    ),
    SuiteCase(
      "565N",
      "Construct Binary",
      "canonical: !!binary \"\\\n R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5\\\n OTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/+\\\n +f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLC\\\n AgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\"\ngeneric: !!binary |\n R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5\n OTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/+\n +f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLC\n AgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\ndescription:\n The binary value above is a tiny arrow encoded as a gif image.\n",
      "+STR\n+DOC\n+MAP\n=VAL :canonical\n=VAL <tag:yaml.org,2002:binary> \"R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5OTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLCAgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\n=VAL :generic\n=VAL <tag:yaml.org,2002:binary> |R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5\\nOTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/+\\n+f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLC\\nAgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\\n\n=VAL :description\n=VAL :The binary value above is a tiny arrow encoded as a gif image.\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"canonical\": \"R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5OTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLCAgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\",\n  \"generic\": \"R0lGODlhDAAMAIQAAP//9/X17unp5WZmZgAAAOfn515eXvPz7Y6OjuDg4J+fn5\\nOTk6enp56enmlpaWNjY6Ojo4SEhP/++f/++f/++f/++f/++f/++f/++f/++f/+\\n+f/++f/++f/++f/++f/++SH+Dk1hZGUgd2l0aCBHSU1QACwAAAAADAAMAAAFLC\\nAgjoEwnuNAFOhpEMTRiggcz4BNJHrv/zCFcLiwMWYNG84BwwEeECcgggoBADs=\\n\",\n  \"description\": \"The binary value above is a tiny arrow encoded as a gif image.\"\n\}\n",
      false,
    ),
    SuiteCase(
      "57H4",
      "Spec Example 8.22. Block Collection Nodes",
      "sequence: !!seq\n- entry\n- !!seq\n - nested\nmapping: !!map\n foo: bar\n",
      "+STR\n+DOC\n+MAP\n=VAL :sequence\n+SEQ <tag:yaml.org,2002:seq>\n=VAL :entry\n+SEQ <tag:yaml.org,2002:seq>\n=VAL :nested\n-SEQ\n-SEQ\n=VAL :mapping\n+MAP <tag:yaml.org,2002:map>\n=VAL :foo\n=VAL :bar\n-MAP\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"sequence\": [\n    \"entry\",\n    [\n      \"nested\"\n    ]\n  ],\n  \"mapping\": \{\n    \"foo\": \"bar\"\n  \}\n\}\n",
      false,
    ),
    SuiteCase(
      "58MP",
      "Flow mapping edge cases",
      "\{x: :x\}\n",
      "+STR\n+DOC\n+MAP \{\}\n=VAL :x\n=VAL ::x\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"x\": \":x\"\n\}\n",
      false,
    ),
    SuiteCase(
      "5BVJ",
      "Spec Example 5.7. Block Scalar Indicators",
      "literal: |\n  some\n  text\nfolded: >\n  some\n  text\n",
      "+STR\n+DOC\n+MAP\n=VAL :literal\n=VAL |some\\ntext\\n\n=VAL :folded\n=VAL >some text\\n\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"literal\": \"some\\ntext\\n\",\n  \"folded\": \"some text\\n\"\n\}\n",
      false,
    ),
    SuiteCase(
      "5C5M",
      "Spec Example 7.15. Flow Mappings",
      "- \{ one : two , three: four , \}\n- \{five: six,seven : eight\}\n",
      "+STR\n+DOC\n+SEQ\n+MAP \{\}\n=VAL :one\n=VAL :two\n=VAL :three\n=VAL :four\n-MAP\n+MAP \{\}\n=VAL :five\n=VAL :six\n=VAL :seven\n=VAL :eight\n-MAP\n-SEQ\n-DOC\n-STR\n",
      "[\n  \{\n    \"one\": \"two\",\n    \"three\": \"four\"\n  \},\n  \{\n    \"five\": \"six\",\n    \"seven\": \"eight\"\n  \}\n]\n",
      false,
    ),
    SuiteCase(
      "5GBF",
      "Spec Example 6.5. Empty Lines",
      "Folding:\n  \"Empty line\n   \t\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n",
      "+STR\n+DOC\n+MAP\n=VAL :Folding\n=VAL \"Empty line\\nas a line feed\n=VAL :Chomping\n=VAL |Clipped empty lines\\n\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"Folding\": \"Empty line\\nas a line feed\",\n  \"Chomping\": \"Clipped empty lines\\n\"\n\}\n",
      false,
    ),
    SuiteCase(
      "5KJE",
      "Spec Example 7.13. Flow Sequence",
      "- [ one, two, ]\n- [three ,four]\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n=VAL :one\n=VAL :two\n-SEQ\n+SEQ []\n=VAL :three\n=VAL :four\n-SEQ\n-SEQ\n-DOC\n-STR\n",
      "[\n  [\n    \"one\",\n    \"two\"\n  ],\n  [\n    \"three\",\n    \"four\"\n  ]\n]\n",
      false,
    ),
    SuiteCase(
      "5LLU",
      "Block scalar with wrong indented line after spaces only",
      "block scalar: >\n \n  \n   \n invalid\n",
      "+STR\n+DOC\n+MAP\n=VAL :block scalar\n",
      "",
      true,
    ),
    SuiteCase(
      "5MUD",
      "Colon and adjacent value on next line",
      "---\n\{ \"foo\"\n  :bar \}\n",
      "+STR\n+DOC ---\n+MAP \{\}\n=VAL \"foo\n=VAL :bar\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo\": \"bar\"\n\}\n",
      false,
    ),
    SuiteCase(
      "5NYZ",
      "Spec Example 6.9. Separated Comment",
      "key:    # Comment\n  value\n",
      "+STR\n+DOC\n+MAP\n=VAL :key\n=VAL :value\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"key\": \"value\"\n\}\n",
      false,
    ),
    SuiteCase(
      "5T43",
      "Colon at the beginning of adjacent flow scalar",
      "- \{ \"key\":value \}\n- \{ \"key\"::value \}\n",
      "+STR\n+DOC\n+SEQ\n+MAP \{\}\n=VAL \"key\n=VAL :value\n-MAP\n+MAP \{\}\n=VAL \"key\n=VAL ::value\n-MAP\n-SEQ\n-DOC\n-STR\n",
      "[\n  \{\n    \"key\": \"value\"\n  \},\n  \{\n    \"key\": \":value\"\n  \}\n]\n",
      false,
    ),
    SuiteCase(
      "5TRB",
      "Invalid document-start marker in doublequoted tring",
      "---\n\"\n---\n\"\n",
      "+STR\n+DOC ---\n",
      "",
      true,
    ),
    SuiteCase(
      "5TYM",
      "Spec Example 6.21. Local Tag Prefix",
      "%TAG !m! !my-\n--- # Bulb here\n!m!light fluorescent\n...\n%TAG !m! !my-\n--- # Color here\n!m!light green\n",
      "+STR\n+DOC ---\n=VAL <!my-light> :fluorescent\n-DOC ...\n+DOC ---\n=VAL <!my-light> :green\n-DOC\n-STR\n",
      "\"fluorescent\"\n\"green\"\n",
      false,
    ),
    SuiteCase(
      "5U3A",
      "Sequence on same Line as Mapping Key",
      "key: - a\n     - b\n",
      "+STR\n+DOC\n+MAP\n=VAL :key\n",
      "",
      true,
    ),
    SuiteCase(
      "5WE3",
      "Spec Example 8.17. Explicit Block Mapping Entries",
      "? explicit key # Empty value\n? |\n  block key\n: - one # Explicit compact\n  - two # block value\n",
      "+STR\n+DOC\n+MAP\n=VAL :explicit key\n=VAL :\n=VAL |block key\\n\n+SEQ\n=VAL :one\n=VAL :two\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"explicit key\": null,\n  \"block key\\n\": [\n    \"one\",\n    \"two\"\n  ]\n\}\n",
      false,
    ),
    SuiteCase(
      "62EZ",
      "Invalid block mapping key on same line as previous key",
      "---\nx: \{ y: z \}in: valid\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :x\n+MAP \{\}\n=VAL :y\n=VAL :z\n-MAP\n",
      "",
      true,
    ),
    SuiteCase(
      "652Z",
      "Question mark at start of flow key",
      "\{ ?foo: bar,\nbar: 42\n\}\n",
      "+STR\n+DOC\n+MAP \{\}\n=VAL :?foo\n=VAL :bar\n=VAL :bar\n=VAL :42\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"?foo\" : \"bar\",\n  \"bar\" : 42\n\}\n",
      false,
    ),
    SuiteCase(
      "65WH",
      "Single Entry Block Sequence",
      "- foo\n",
      "+STR\n+DOC\n+SEQ\n=VAL :foo\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"foo\"\n]\n",
      false,
    ),
    SuiteCase(
      "6BCT",
      "Spec Example 6.3. Separation Spaces",
      "- foo:\t bar\n- - baz\n  -\tbaz\n",
      "+STR\n+DOC\n+SEQ\n+MAP\n=VAL :foo\n=VAL :bar\n-MAP\n+SEQ\n=VAL :baz\n=VAL :baz\n-SEQ\n-SEQ\n-DOC\n-STR\n",
      "[\n  \{\n    \"foo\": \"bar\"\n  \},\n  [\n    \"baz\",\n    \"baz\"\n  ]\n]\n",
      false,
    ),
    SuiteCase(
      "6BFJ",
      "Mapping, key and flow sequence item anchors",
      "---\n&mapping\n&key [ &item a, b, c ]: value\n",
      "+STR\n+DOC ---\n+MAP &mapping\n+SEQ [] &key\n=VAL &item :a\n=VAL :b\n=VAL :c\n-SEQ\n=VAL :value\n-MAP\n-DOC\n-STR\n",
      "",
      false,
    ),
    SuiteCase(
      "6CA3",
      "Tab indented top flow",
      "\t[\n\t]\n",
      "+STR\n+DOC\n+SEQ []\n-SEQ\n-DOC\n-STR\n",
      "[]\n",
      false,
    ),
    SuiteCase(
      "6CK3",
      "Spec Example 6.26. Tag Shorthands",
      "%TAG !e! tag:example.com,2000:app/\n---\n- !local foo\n- !!str bar\n- !e!tag%21 baz\n",
      "+STR\n+DOC ---\n+SEQ\n=VAL <!local> :foo\n=VAL <tag:yaml.org,2002:str> :bar\n=VAL <tag:example.com,2000:app/tag!> :baz\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"foo\",\n  \"bar\",\n  \"baz\"\n]\n",
      false,
    ),
    SuiteCase(
      "6FWR",
      "Block Scalar Keep",
      "--- |+\n ab\n \n  \n...\n",
      "+STR\n+DOC ---\n=VAL |ab\\n\\n \\n\n-DOC ...\n-STR\n",
      "\"ab\\n\\n \\n\"\n",
      false,
    ),
    SuiteCase(
      "6H3V",
      "Backslashes in singlequotes",
      "'foo: bar\\': baz'\n",
      "+STR\n+DOC\n+MAP\n=VAL 'foo: bar\\\\\n=VAL :baz'\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo: bar\\\\\": \"baz'\"\n\}\n",
      false,
    ),
    SuiteCase(
      "6HB6",
      "Spec Example 6.1. Indentation Spaces",
      "  # Leading comment line spaces are\n   # neither content nor indentation.\n    \nNot indented:\n By one space: |\n    By four\n      spaces\n Flow style: [    # Leading spaces\n   By two,        # in flow style\n  Also by two,    # are neither\n  \tStill by two   # content nor\n    ]             # indentation.\n",
      "+STR\n+DOC\n+MAP\n=VAL :Not indented\n+MAP\n=VAL :By one space\n=VAL |By four\\n  spaces\\n\n=VAL :Flow style\n+SEQ []\n=VAL :By two\n=VAL :Also by two\n=VAL :Still by two\n-SEQ\n-MAP\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"Not indented\": \{\n    \"By one space\": \"By four\\n  spaces\\n\",\n    \"Flow style\": [\n      \"By two\",\n      \"Also by two\",\n      \"Still by two\"\n    ]\n  \}\n\}\n",
      false,
    ),
    SuiteCase(
      "6JQW",
      "Spec Example 2.13. In literals, newlines are preserved",
      "# ASCII Art\n--- |\n  \\//||\\/||\n  // ||  ||__\n",
      "+STR\n+DOC ---\n=VAL |\\\\//||\\\\/||\\n// ||  ||__\\n\n-DOC\n-STR\n",
      "\"\\\\//||\\\\/||\\n// ||  ||__\\n\"\n",
      false,
    ),
    SuiteCase(
      "6JTT",
      "Flow sequence without closing bracket",
      "---\n[ [ a, b, c ]\n",
      "+STR\n+DOC ---\n+SEQ []\n+SEQ []\n=VAL :a\n=VAL :b\n=VAL :c\n-SEQ\n",
      "",
      true,
    ),
    SuiteCase(
      "6JWB",
      "Tags for Block Objects",
      "foo: !!seq\n  - !!str a\n  - !!map\n    key: !!str value\n",
      "+STR\n+DOC\n+MAP\n=VAL :foo\n+SEQ <tag:yaml.org,2002:seq>\n=VAL <tag:yaml.org,2002:str> :a\n+MAP <tag:yaml.org,2002:map>\n=VAL :key\n=VAL <tag:yaml.org,2002:str> :value\n-MAP\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo\": [\n    \"a\",\n    \{\n      \"key\": \"value\"\n    \}\n  ]\n\}\n",
      false,
    ),
    SuiteCase(
      "6KGN",
      "Anchor for empty node",
      "---\na: &anchor\nb: *anchor\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :a\n=VAL &anchor :\n=VAL :b\n=ALI *anchor\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a\": null,\n  \"b\": null\n\}\n",
      false,
    ),
  ]
}

fn casesPart3(): List<SuiteCase> {
  [
    SuiteCase(
      "6LVF",
      "Spec Example 6.13. Reserved Directives",
      "%FOO  bar baz # Should be ignored\n              # with a warning.\n--- \"foo\"\n",
      "+STR\n+DOC ---\n=VAL \"foo\n-DOC\n-STR\n",
      "\"foo\"\n",
      false,
    ),
    SuiteCase(
      "6M2F",
      "Aliases in Explicit Block Mapping",
      "? &a a\n: &b b\n: *a\n",
      "+STR\n+DOC\n+MAP\n=VAL &a :a\n=VAL &b :b\n=VAL :\n=ALI *a\n-MAP\n-DOC\n-STR\n",
      "",
      false,
    ),
    SuiteCase(
      "6PBE",
      "Zero-indented sequences in explicit mapping keys",
      "---\n?\n- a\n- b\n:\n- c\n- d\n",
      "+STR\n+DOC ---\n+MAP\n+SEQ\n=VAL :a\n=VAL :b\n-SEQ\n+SEQ\n=VAL :c\n=VAL :d\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "",
      false,
    ),
    SuiteCase(
      "6S55",
      "Invalid scalar at the end of sequence",
      "key:\n - bar\n - baz\n invalid\n",
      "+STR\n+DOC\n+MAP\n=VAL :key\n+SEQ\n=VAL :bar\n=VAL :baz\n",
      "",
      true,
    ),
    SuiteCase(
      "6SLA",
      "Allowed characters in quoted mapping key",
      "\"foo\\nbar:baz\\tx \\\\$%^&*()x\": 23\n'x\\ny:z\\tx $%^&*()x': 24\n",
      "+STR\n+DOC\n+MAP\n=VAL \"foo\\nbar:baz\\tx \\\\$%^&*()x\n=VAL :23\n=VAL 'x\\\\ny:z\\\\tx $%^&*()x\n=VAL :24\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo\\nbar:baz\\tx \\\\$%^&*()x\": 23,\n  \"x\\\\ny:z\\\\tx $%^&*()x\": 24\n\}\n",
      false,
    ),
    SuiteCase(
      "6VJK",
      "Spec Example 2.15. Folded newlines are preserved for \"more indented\" and blank lines",
      ">\n Sammy Sosa completed another\n fine season with great stats.\n\n   63 Home Runs\n   0.288 Batting Average\n\n What a year!\n",
      "+STR\n+DOC\n=VAL >Sammy Sosa completed another fine season with great stats.\\n\\n  63 Home Runs\\n  0.288 Batting Average\\n\\nWhat a year!\\n\n-DOC\n-STR\n",
      "\"Sammy Sosa completed another fine season with great stats.\\n\\n  63 Home Runs\\n  0.288 Batting Average\\n\\nWhat a year!\\n\"\n",
      false,
    ),
    SuiteCase(
      "6WLZ",
      "Spec Example 6.18. Primary Tag Handle [1.3]",
      "# Private\n---\n!foo \"bar\"\n...\n# Global\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n",
      "+STR\n+DOC ---\n=VAL <!foo> \"bar\n-DOC ...\n+DOC ---\n=VAL <tag:example.com,2000:app/foo> \"bar\n-DOC\n-STR\n",
      "\"bar\"\n\"bar\"\n",
      false,
    ),
    SuiteCase(
      "6WPF",
      "Spec Example 6.8. Flow Folding [1.3]",
      "---\n\"\n  foo \n \n    bar\n\n  baz\n\"\n",
      "+STR\n+DOC ---\n=VAL \" foo\\nbar\\nbaz \n-DOC\n-STR\n",
      "\" foo\\nbar\\nbaz \"\n",
      false,
    ),
    SuiteCase(
      "6XDY",
      "Two document start markers",
      "---\n---\n",
      "+STR\n+DOC ---\n=VAL :\n-DOC\n+DOC ---\n=VAL :\n-DOC\n-STR\n",
      "null\nnull\n",
      false,
    ),
    SuiteCase(
      "6ZKB",
      "Spec Example 9.6. Stream",
      "Document\n---\n# Empty\n...\n%YAML 1.2\n---\nmatches %: 20\n",
      "+STR\n+DOC\n=VAL :Document\n-DOC\n+DOC ---\n=VAL :\n-DOC ...\n+DOC ---\n+MAP\n=VAL :matches %\n=VAL :20\n-MAP\n-DOC\n-STR\n",
      "\"Document\"\nnull\n\{\n  \"matches %\": 20\n\}\n",
      false,
    ),
    SuiteCase(
      "735Y",
      "Spec Example 8.20. Block Node Types",
      "-\n  \"flow in block\"\n- >\n Block scalar\n- !!map # Block collection\n  foo : bar\n",
      "+STR\n+DOC\n+SEQ\n=VAL \"flow in block\n=VAL >Block scalar\\n\n+MAP <tag:yaml.org,2002:map>\n=VAL :foo\n=VAL :bar\n-MAP\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"flow in block\",\n  \"Block scalar\\n\",\n  \{\n    \"foo\": \"bar\"\n  \}\n]\n",
      false,
    ),
    SuiteCase(
      "74H7",
      "Tags in Implicit Mapping",
      "!!str a: b\nc: !!int 42\ne: !!str f\ng: h\n!!str 23: !!bool false\n",
      "+STR\n+DOC\n+MAP\n=VAL <tag:yaml.org,2002:str> :a\n=VAL :b\n=VAL :c\n=VAL <tag:yaml.org,2002:int> :42\n=VAL :e\n=VAL <tag:yaml.org,2002:str> :f\n=VAL :g\n=VAL :h\n=VAL <tag:yaml.org,2002:str> :23\n=VAL <tag:yaml.org,2002:bool> :false\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a\": \"b\",\n  \"c\": 42,\n  \"e\": \"f\",\n  \"g\": \"h\",\n  \"23\": false\n\}\n",
      false,
    ),
    SuiteCase(
      "753E",
      "Block Scalar Strip [1.3]",
      "--- |-\n ab\n \n \n...\n",
      "+STR\n+DOC ---\n=VAL |ab\n-DOC ...\n-STR\n",
      "\"ab\"\n",
      false,
    ),
    SuiteCase(
      "7A4E",
      "Spec Example 7.6. Double Quoted Lines",
      "\" 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty \"\n",
      "+STR\n+DOC\n=VAL \" 1st non-empty\\n2nd non-empty 3rd non-empty \n-DOC\n-STR\n",
      "\" 1st non-empty\\n2nd non-empty 3rd non-empty \"\n",
      false,
    ),
    SuiteCase(
      "7BMT",
      "Node and Mapping Key Anchors [1.3]",
      "---\ntop1: &node1\n  &k1 key1: one\ntop2: &node2 # comment\n  key2: two\ntop3:\n  &k3 key3: three\ntop4: &node4\n  &k4 key4: four\ntop5: &node5\n  key5: five\ntop6: &val6\n  six\ntop7:\n  &val7 seven\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :top1\n+MAP &node1\n=VAL &k1 :key1\n=VAL :one\n-MAP\n=VAL :top2\n+MAP &node2\n=VAL :key2\n=VAL :two\n-MAP\n=VAL :top3\n+MAP\n=VAL &k3 :key3\n=VAL :three\n-MAP\n=VAL :top4\n+MAP &node4\n=VAL &k4 :key4\n=VAL :four\n-MAP\n=VAL :top5\n+MAP &node5\n=VAL :key5\n=VAL :five\n-MAP\n=VAL :top6\n=VAL &val6 :six\n=VAL :top7\n=VAL &val7 :seven\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"top1\": \{\n    \"key1\": \"one\"\n  \},\n  \"top2\": \{\n    \"key2\": \"two\"\n  \},\n  \"top3\": \{\n    \"key3\": \"three\"\n  \},\n  \"top4\": \{\n    \"key4\": \"four\"\n  \},\n  \"top5\": \{\n    \"key5\": \"five\"\n  \},\n  \"top6\": \"six\",\n  \"top7\": \"seven\"\n\}\n",
      false,
    ),
    SuiteCase(
      "7BUB",
      "Spec Example 2.10. Node for \u{201c}Sammy Sosa\u{201d} appears twice in this document",
      "---\nhr:\n  - Mark McGwire\n  # Following node labeled SS\n  - &SS Sammy Sosa\nrbi:\n  - *SS # Subsequent occurrence\n  - Ken Griffey\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :hr\n+SEQ\n=VAL :Mark McGwire\n=VAL &SS :Sammy Sosa\n-SEQ\n=VAL :rbi\n+SEQ\n=ALI *SS\n=VAL :Ken Griffey\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"hr\": [\n    \"Mark McGwire\",\n    \"Sammy Sosa\"\n  ],\n  \"rbi\": [\n    \"Sammy Sosa\",\n    \"Ken Griffey\"\n  ]\n\}\n",
      false,
    ),
    SuiteCase(
      "7FWL",
      "Spec Example 6.24. Verbatim Tags",
      "!<tag:yaml.org,2002:str> foo :\n  !<!bar> baz\n",
      "+STR\n+DOC\n+MAP\n=VAL <tag:yaml.org,2002:str> :foo\n=VAL <!bar> :baz\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo\": \"baz\"\n\}\n",
      false,
    ),
    SuiteCase(
      "7LBH",
      "Multiline double quoted implicit keys",
      "\"a\\nb\": 1\n\"c\n d\": 1\n",
      "+STR\n+DOC\n+MAP\n=VAL \"a\\nb\n=VAL :1\n",
      "",
      true,
    ),
    SuiteCase(
      "7MNF",
      "Missing colon",
      "top1:\n  key1: val1\ntop2\n",
      "+STR\n+DOC\n+MAP\n=VAL :top1\n+MAP\n=VAL :key1\n=VAL :val1\n-MAP\n",
      "",
      true,
    ),
    SuiteCase(
      "7T8X",
      "Spec Example 8.10. Folded Lines - 8.13. Final Empty Lines",
      ">\n\n folded\n line\n\n next\n line\n   * bullet\n\n   * list\n   * lines\n\n last\n line\n\n# Comment\n",
      "+STR\n+DOC\n=VAL >\\nfolded line\\nnext line\\n  * bullet\\n\\n  * list\\n  * lines\\n\\nlast line\\n\n-DOC\n-STR\n",
      "\"\\nfolded line\\nnext line\\n  * bullet\\n\\n  * list\\n  * lines\\n\\nlast line\\n\"\n",
      false,
    ),
    SuiteCase(
      "7TMG",
      "Comment in flow sequence before comma",
      "---\n[ word1\n# comment\n, word2]\n",
      "+STR\n+DOC ---\n+SEQ []\n=VAL :word1\n=VAL :word2\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"word1\",\n  \"word2\"\n]\n",
      false,
    ),
    SuiteCase(
      "7W2P",
      "Block Mapping with Missing Values",
      "? a\n? b\nc:\n",
      "+STR\n+DOC\n+MAP\n=VAL :a\n=VAL :\n=VAL :b\n=VAL :\n=VAL :c\n=VAL :\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a\": null,\n  \"b\": null,\n  \"c\": null\n\}\n",
      false,
    ),
    SuiteCase(
      "7Z25",
      "Bare document after document end marker",
      "---\nscalar1\n...\nkey: value\n",
      "+STR\n+DOC ---\n=VAL :scalar1\n-DOC ...\n+DOC\n+MAP\n=VAL :key\n=VAL :value\n-MAP\n-DOC\n-STR\n",
      "\"scalar1\"\n\{\n  \"key\": \"value\"\n\}\n",
      false,
    ),
    SuiteCase(
      "7ZZ5",
      "Empty flow collections",
      "---\nnested sequences:\n- - - []\n- - - \{\}\nkey1: []\nkey2: \{\}\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :nested sequences\n+SEQ\n+SEQ\n+SEQ\n+SEQ []\n-SEQ\n-SEQ\n-SEQ\n+SEQ\n+SEQ\n+MAP \{\}\n-MAP\n-SEQ\n-SEQ\n-SEQ\n=VAL :key1\n+SEQ []\n-SEQ\n=VAL :key2\n+MAP \{\}\n-MAP\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"nested sequences\": [\n    [\n      [\n        []\n      ]\n    ],\n    [\n      [\n        \{\}\n      ]\n    ]\n  ],\n  \"key1\": [],\n  \"key2\": \{\}\n\}\n",
      false,
    ),
    SuiteCase(
      "82AN",
      "Three dashes and content without space",
      "---word1\nword2\n",
      "+STR\n+DOC\n=VAL :---word1 word2\n-DOC\n-STR\n",
      "\"---word1 word2\"\n",
      false,
    ),
    SuiteCase(
      "87E4",
      "Spec Example 7.8. Single Quoted Implicit Keys",
      "'implicit block key' : [\n  'implicit flow key' : value,\n ]\n",
