      "[\n  \{\n    \"single line\": null,\n    \"a\": \"b\"\n  \},\n  \{\n    \"multi line\": null,\n    \"a\": \"b\"\n  \}\n]\n",
      false,
    ),
    SuiteCase(
      "8MK2",
      "Explicit Non-Specific Tag",
      "! a\n",
      "+STR\n+DOC\n=VAL <!> :a\n-DOC\n-STR\n",
      "\"a\"\n",
      false,
    ),
    SuiteCase(
      "8QBE",
      "Block Sequence in Block Mapping",
      "key:\n - item1\n - item2\n",
      "+STR\n+DOC\n+MAP\n=VAL :key\n+SEQ\n=VAL :item1\n=VAL :item2\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"key\": [\n    \"item1\",\n    \"item2\"\n  ]\n\}\n",
      false,
    ),
    SuiteCase(
      "8UDB",
      "Spec Example 7.14. Flow Sequence Entries",
      "[\n\"double\n quoted\", 'single\n           quoted',\nplain\n text, [ nested ],\nsingle: pair,\n]\n",
      "+STR\n+DOC\n+SEQ []\n=VAL \"double quoted\n=VAL 'single quoted\n=VAL :plain text\n+SEQ []\n=VAL :nested\n-SEQ\n+MAP \{\}\n=VAL :single\n=VAL :pair\n-MAP\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"double quoted\",\n  \"single quoted\",\n  \"plain text\",\n  [\n    \"nested\"\n  ],\n  \{\n    \"single\": \"pair\"\n  \}\n]\n",
      false,
