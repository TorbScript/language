/**
 * The cases of the YAML test suite, https://github.com/yaml/yaml-test-suite, from its `data` branch at the release
 * data-2022-01-17: every case's input, the events a parser has to produce for it (empty for a case that is an error),
 * and the JSON a loader has to produce where the suite gives one. Generated from the suite's files; nothing is edited.
 *
 * The suite is under the MIT License:
 *
 * Copyright (c) 2016-2020 Ingy döt Net
 *
 * Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated
 * documentation files (the "Software"), to deal in the Software without restriction, including without limitation the
 * rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit
 * persons to whom the Software is furnished to do so, subject to the following conditions:
 *
 * The above copyright notice and this permission notice shall be included in all copies or substantial portions of the
 * Software.
 *
 * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE
 * WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR
 * COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR
 * OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
 */

/** One case of the suite. */
public type SuiteCase {
  /** The case's directory: `229Q`, or `2G84/00` for one of several. */
  name: String
  title: String
  yaml: String
  /** The events of `test.event`, one per line; empty for an error case. */
  events: String
  /** The JSON of `in.json`, or empty where the suite has none. */
  json: String
  isError: Bool
}

/** Every case, in the order of their names. */
public fn suiteCases(): List<SuiteCase> {
  var cases: List<SuiteCase> = []
  cases.appendAll casesPart1()
  cases.appendAll casesPart2()
  cases.appendAll casesPart3()
  cases.appendAll casesPart4()
  cases.appendAll casesPart5()
  cases.appendAll casesPart6()
  cases.appendAll casesPart7()
  cases.appendAll casesPart8()
  cases.appendAll casesPart9()
  cases.appendAll casesPart10()
  cases.appendAll casesPart11()
  cases
}

fn casesPart1(): List<SuiteCase> {
  [
    SuiteCase(
      "229Q",
      "Spec Example 2.4. Sequence of Mappings",
      "-\n  name: Mark McGwire\n  hr:   65\n  avg:  0.278\n-\n  name: Sammy Sosa\n  hr:   63\n  avg:  0.288\n",
      "+STR\n+DOC\n+SEQ\n+MAP\n=VAL :name\n=VAL :Mark McGwire\n=VAL :hr\n=VAL :65\n=VAL :avg\n=VAL :0.278\n-MAP\n+MAP\n=VAL :name\n=VAL :Sammy Sosa\n=VAL :hr\n=VAL :63\n=VAL :avg\n=VAL :0.288\n-MAP\n-SEQ\n-DOC\n-STR\n",
      "[\n  \{\n    \"name\": \"Mark McGwire\",\n    \"hr\": 65,\n    \"avg\": 0.278\n  \},\n  \{\n    \"name\": \"Sammy Sosa\",\n    \"hr\": 63,\n    \"avg\": 0.288\n  \}\n]\n",
      false,
    ),
    SuiteCase(
      "236B",
      "Invalid value after mapping",
      "foo:\n  bar\ninvalid\n",
      "+STR\n+DOC\n+MAP\n=VAL :foo\n=VAL :bar\n",
      "",
      true,
    ),
    SuiteCase(
      "26DV",
      "Whitespace around colon in mappings",
      "\"top1\" : \n  \"key1\" : &alias1 scalar1\n'top2' : \n  'key2' : &alias2 scalar2\ntop3: &node3 \n  *alias1 : scalar3\ntop4: \n  *alias2 : scalar4\ntop5   :    \n  scalar5\ntop6: \n  &anchor6 'key6' : scalar6\n",
      "+STR\n+DOC\n+MAP\n=VAL \"top1\n+MAP\n=VAL \"key1\n=VAL &alias1 :scalar1\n-MAP\n=VAL 'top2\n+MAP\n=VAL 'key2\n=VAL &alias2 :scalar2\n-MAP\n=VAL :top3\n+MAP &node3\n=ALI *alias1\n=VAL :scalar3\n-MAP\n=VAL :top4\n+MAP\n=ALI *alias2\n=VAL :scalar4\n-MAP\n=VAL :top5\n=VAL :scalar5\n=VAL :top6\n+MAP\n=VAL &anchor6 'key6\n=VAL :scalar6\n-MAP\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"top1\": \{\n    \"key1\": \"scalar1\"\n  \},\n  \"top2\": \{\n    \"key2\": \"scalar2\"\n  \},\n  \"top3\": \{\n    \"scalar1\": \"scalar3\"\n  \},\n  \"top4\": \{\n    \"scalar2\": \"scalar4\"\n  \},\n  \"top5\": \"scalar5\",\n  \"top6\": \{\n    \"key6\": \"scalar6\"\n  \}\n\}\n",
      false,
    ),
    SuiteCase(
      "27NA",
      "Spec Example 5.9. Directive Indicator",
      "%YAML 1.2\n--- text\n",
      "+STR\n+DOC ---\n=VAL :text\n-DOC\n-STR\n",
      "\"text\"\n",
      false,
    ),
    SuiteCase(
      "2AUY",
      "Tags in Block Sequence",
      " - !!str a\n - b\n - !!int 42\n - d\n",
      "+STR\n+DOC\n+SEQ\n=VAL <tag:yaml.org,2002:str> :a\n=VAL :b\n=VAL <tag:yaml.org,2002:int> :42\n=VAL :d\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"a\",\n  \"b\",\n  42,\n  \"d\"\n]\n",
      false,
    ),
    SuiteCase(
      "2CMS",
      "Invalid mapping in plain multiline",
      "this\n is\n  invalid: x\n",
      "+STR\n+DOC\n",
      "",
      true,
    ),
    SuiteCase(
      "2EBW",
      "Allowed characters in keys",
      "a!\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az\{|\}~: safe\n?foo: safe question mark\n:foo: safe colon\n-foo: safe dash\nthis is#not: a comment\n",
      "+STR\n+DOC\n+MAP\n=VAL :a!\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|\}~\n=VAL :safe\n=VAL :?foo\n=VAL :safe question mark\n=VAL ::foo\n=VAL :safe colon\n=VAL :-foo\n=VAL :safe dash\n=VAL :this is#not\n=VAL :a comment\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a!\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|\}~\": \"safe\",\n  \"?foo\": \"safe question mark\",\n  \":foo\": \"safe colon\",\n  \"-foo\": \"safe dash\",\n  \"this is#not\": \"a comment\"\n\}\n",
      false,
    ),
    SuiteCase(
