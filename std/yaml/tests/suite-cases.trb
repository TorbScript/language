      "Spec Example 5.12. Tabs and Spaces",
      "# Tabs and spaces\nquoted: \"Quoted \t\"\nblock:\t|\n  void main() \{\n  \tprintf(\"Hello, world!\\n\");\n  \}\n",
      "+STR\n+DOC\n+MAP\n=VAL :quoted\n=VAL \"Quoted \\t\n=VAL :block\n=VAL |void main() \{\\n\\tprintf(\"Hello, world!\\\\n\");\\n\}\\n\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"quoted\": \"Quoted \\t\",\n  \"block\": \"void main() \{\\n\\tprintf(\\\"Hello, world!\\\\n\\\");\\n\}\\n\"\n\}\n",
      false,
