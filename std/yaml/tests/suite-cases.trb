      "a: &:@*!$\"<foo>: scalar a\nb: *:@*!$\"<foo>:\n",
      "+STR\n+DOC\n+MAP\n=VAL :a\n=VAL &:@*!$\"<foo>: :scalar a\n=VAL :b\n=ALI *:@*!$\"<foo>:\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a\": \"scalar a\",\n  \"b\": \"scalar a\"\n\}\n",
      false,
    ),
    SuiteCase(
      "W9L4",
      "Literal block scalar with more spaces in first line",
      "---\nblock scalar: |\n     \n  more spaces at the beginning\n  are invalid\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :block scalar\n",
      "",
      true,
    ),
    SuiteCase(
      "WZ62",
      "Spec Example 7.2. Empty Content",
      "\{\n  foo : !!str,\n  !!str : bar,\n\}\n",
      "+STR\n+DOC\n+MAP \{\}\n=VAL :foo\n=VAL <tag:yaml.org,2002:str> :\n=VAL <tag:yaml.org,2002:str> :\n=VAL :bar\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo\": \"\",\n  \"\": \"bar\"\n\}\n",
      false,
    ),
    SuiteCase(
      "X38W",
      "Aliases in Flow Objects",
      "\{ &a [a, &b b]: *b, *a : [c, *b, d]\}\n",
      "+STR\n+DOC\n+MAP \{\}\n+SEQ [] &a\n=VAL :a\n=VAL &b :b\n-SEQ\n=ALI *b\n=ALI *a\n+SEQ []\n=VAL :c\n=ALI *b\n=VAL :d\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "",
      false,
    ),
    SuiteCase(
      "X4QW",
      "Comment without whitespace after block scalar indicator",
      "block: ># comment\n  scalar\n",
      "+STR\n+DOC\n+MAP\n=VAL :block\n",
      "",
      true,
    ),
    SuiteCase(
      "X8DW",
      "Explicit key and value seperated by comment",
      "---\n? key\n# comment\n: value\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :key\n=VAL :value\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"key\": \"value\"\n\}\n",
      false,
    ),
    SuiteCase(
      "XLQ9",
      "Multiline scalar that looks like a YAML directive",
      "---\nscalar\n%YAML 1.2\n",
      "+STR\n+DOC ---\n=VAL :scalar %YAML 1.2\n-DOC\n-STR\n",
      "\"scalar %YAML 1.2\"\n",
      false,
    ),
    SuiteCase(
      "XV9V",
      "Spec Example 6.5. Empty Lines [1.3]",
      "Folding:\n  \"Empty line\n\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n",
      "+STR\n+DOC\n+MAP\n=VAL :Folding\n=VAL \"Empty line\\nas a line feed\n=VAL :Chomping\n=VAL |Clipped empty lines\\n\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"Folding\": \"Empty line\\nas a line feed\",\n  \"Chomping\": \"Clipped empty lines\\n\"\n\}\n",
      false,
    ),
    SuiteCase(
      "XW4D",
      "Various Trailing Comments",
      "a: \"double\n  quotes\" # lala\nb: plain\n value  # lala\nc  : #lala\n  d\n? # lala\n - seq1\n: # lala\n - #lala\n  seq2\ne:\n &node # lala\n - x: y\nblock: > # lala\n  abcde\n",
      "+STR\n+DOC\n+MAP\n=VAL :a\n=VAL \"double quotes\n=VAL :b\n=VAL :plain value\n=VAL :c\n=VAL :d\n+SEQ\n=VAL :seq1\n-SEQ\n+SEQ\n=VAL :seq2\n-SEQ\n=VAL :e\n+SEQ &node\n+MAP\n=VAL :x\n=VAL :y\n-MAP\n-SEQ\n=VAL :block\n=VAL >abcde\\n\n-MAP\n-DOC\n-STR\n",
      "",
      false,
    ),
    SuiteCase(
      "Y2GN",
      "Anchor with colon in the middle",
      "---\nkey: &an:chor value\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :key\n=VAL &an:chor :value\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"key\": \"value\"\n\}\n",
      false,
    ),
    SuiteCase(
      "Y79Y/000",
      "Tabs in various contexts",
      "foo: |\n\t\nbar: 1\n",
      "+STR\n+DOC\n+MAP\n=VAL :foo\n",
      "",
      true,
    ),
    SuiteCase(
      "Y79Y/001",
      "Tabs in various contexts",
      "foo: |\n \t\nbar: 1\n",
      "+STR\n+DOC\n+MAP\n=VAL :foo\n=VAL |\\t\\n\n=VAL :bar\n=VAL :1\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"foo\": \"\\t\\n\",\n  \"bar\": 1\n\}\n",
      false,
    ),
    SuiteCase(
      "Y79Y/002",
      "Tabs in various contexts",
      "- [\n\t\n foo\n ]\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n=VAL :foo\n-SEQ\n-SEQ\n-DOC\n-STR\n",
      "[\n  [\n    \"foo\"\n  ]\n]\n",
      false,
    ),
    SuiteCase(
      "Y79Y/003",
      "Tabs in various contexts",
      "- [\n\tfoo,\n foo\n ]\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n",
      "",
      true,
    ),
    SuiteCase(
      "Y79Y/004",
      "Tabs in various contexts",
      "-\t-\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n",
      "",
      true,
    ),
    SuiteCase(
      "Y79Y/005",
      "Tabs in various contexts",
      "- \t-\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n",
      "",
      true,
    ),
    SuiteCase(
      "Y79Y/006",
      "Tabs in various contexts",
      "?\t-\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n",
      "",
      true,
    ),
    SuiteCase(
      "Y79Y/007",
      "Tabs in various contexts",
      "? -\n:\t-\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n",
      "",
      true,
    ),
    SuiteCase(
      "Y79Y/008",
      "Tabs in various contexts",
      "?\tkey:\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n",
      "",
      true,
    ),
    SuiteCase(
      "Y79Y/009",
      "Tabs in various contexts",
      "? key:\n:\tkey:\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n",
      "",
      true,
    ),
    SuiteCase(
      "Y79Y/010",
      "Tabs in various contexts",
      "-\t-1\n",
      "+STR\n+DOC\n+SEQ\n=VAL :-1\n-SEQ\n-DOC\n-STR\n",
      "[\n  -1\n]\n",
      false,
    ),
    SuiteCase(
      "YD5X",
      "Spec Example 2.5. Sequence of Sequences",
      "- [name        , hr, avg  ]\n- [Mark McGwire, 65, 0.278]\n- [Sammy Sosa  , 63, 0.288]\n",
      "+STR\n+DOC\n+SEQ\n+SEQ []\n=VAL :name\n=VAL :hr\n=VAL :avg\n-SEQ\n+SEQ []\n=VAL :Mark McGwire\n=VAL :65\n=VAL :0.278\n-SEQ\n+SEQ []\n=VAL :Sammy Sosa\n=VAL :63\n=VAL :0.288\n-SEQ\n-SEQ\n-DOC\n-STR\n",
      "[\n  [\n    \"name\",\n    \"hr\",\n    \"avg\"\n  ],\n  [\n    \"Mark McGwire\",\n    65,\n    0.278\n  ],\n  [\n    \"Sammy Sosa\",\n    63,\n    0.288\n  ]\n]\n",
      false,
    ),
    SuiteCase(
      "YJV2",
      "Dash in flow sequence",
      "[-]\n",
      "+STR\n+DOC\n+SEQ []\n",
      "",
      true,
    ),
    SuiteCase(
      "Z67P",
      "Spec Example 8.21. Block Scalar Nodes [1.3]",
      "literal: |2\n  value\nfolded: !foo >1\n value\n",
      "+STR\n+DOC\n+MAP\n=VAL :literal\n=VAL |value\\n\n=VAL :folded\n=VAL <!foo> >value\\n\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"literal\": \"value\\n\",\n  \"folded\": \"value\\n\"\n\}\n",
      false,
    ),
    SuiteCase(
      "Z9M4",
      "Spec Example 6.22. Global Tag Prefix",
      "%TAG !e! tag:example.com,2000:app/\n---\n- !e!foo \"bar\"\n",
      "+STR\n+DOC ---\n+SEQ\n=VAL <tag:example.com,2000:app/foo> \"bar\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"bar\"\n]\n",
      false,
    ),
    SuiteCase(
      "ZCZ6",
      "Invalid mapping in plain single line value",
      "a: b: c: d\n",
      "+STR\n+DOC\n+MAP\n=VAL :a\n",
      "",
      true,
    ),
    SuiteCase(
      "ZF4X",
      "Spec Example 2.6. Mapping of Mappings",
      "Mark McGwire: \{hr: 65, avg: 0.278\}\nSammy Sosa: \{\n    hr: 63,\n    avg: 0.288\n  \}\n",
      "+STR\n+DOC\n+MAP\n=VAL :Mark McGwire\n+MAP \{\}\n=VAL :hr\n=VAL :65\n=VAL :avg\n=VAL :0.278\n-MAP\n=VAL :Sammy Sosa\n+MAP \{\}\n=VAL :hr\n=VAL :63\n=VAL :avg\n=VAL :0.288\n-MAP\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"Mark McGwire\": \{\n    \"hr\": 65,\n    \"avg\": 0.278\n  \},\n  \"Sammy Sosa\": \{\n    \"hr\": 63,\n    \"avg\": 0.288\n  \}\n\}\n",
      false,
    ),
    SuiteCase(
      "ZH7C",
      "Anchors in Mapping",
      "&a a: b\nc: &d d\n",
      "+STR\n+DOC\n+MAP\n=VAL &a :a\n=VAL :b\n=VAL :c\n=VAL &d :d\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a\": \"b\",\n  \"c\": \"d\"\n\}\n",
      false,
    ),
    SuiteCase(
      "ZK9H",
      "Nested top level flow mapping",
      "\{ key: [[[\n  value\n ]]]\n\}\n",
      "+STR\n+DOC\n+MAP \{\}\n=VAL :key\n+SEQ []\n+SEQ []\n+SEQ []\n=VAL :value\n-SEQ\n-SEQ\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"key\": [\n    [\n      [\n        \"value\"\n      ]\n    ]\n  ]\n\}\n",
      false,
    ),
    SuiteCase(
      "ZL4Z",
      "Invalid nested mapping",
      "---\na: 'b': c\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :a\n=VAL 'b\n",
      "",
      true,
    ),
    SuiteCase(
      "ZVH3",
      "Wrong indented sequence item",
      "- key: value\n - item1\n",
      "+STR\n+DOC\n+SEQ\n+MAP\n=VAL :key\n=VAL :value\n-MAP\n",
      "",
      true,
    ),
  ]
}

fn casesPart11(): List<SuiteCase> {
  [
    SuiteCase(
      "ZWK4",
      "Key with anchor after missing explicit mapping value",
      "---\na: 1\n? b\n&anchor c: 3\n",
      "+STR\n+DOC ---\n+MAP\n=VAL :a\n=VAL :1\n=VAL :b\n=VAL :\n=VAL &anchor :c\n=VAL :3\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"a\": 1,\n  \"b\": null,\n  \"c\": 3\n\}\n",
      false,
    ),
    SuiteCase(
      "ZXT5",
      "Implicit key followed by newline and adjacent value",
      "[ \"key\"\n  :value ]\n",
      "+STR\n+DOC\n+SEQ []\n=VAL \"key\n",
      "",
      true,
    ),
  ]
}
