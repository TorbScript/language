    SuiteCase(
      "8XDJ",
      "Comment in plain multiline value",
      "key: word1\n#  xxx\n  word2\n",
      "+STR\n+DOC\n+MAP\n=VAL :key\n=VAL :word1\n",
      "",
      true,
    ),
    SuiteCase(
      "8XYN",
      "Anchor with unicode character",
      "---\n- &\u{1f601} unicode anchor\n",
      "+STR\n+DOC ---\n+SEQ\n=VAL &\u{1f601} :unicode anchor\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"unicode anchor\"\n]\n",
      false,
    ),
    SuiteCase(
      "93JH",
      "Block Mappings in Block Sequence",
      " - key: value\n   key2: value2\n -\n   key3: value3\n",
      "+STR\n+DOC\n+SEQ\n+MAP\n=VAL :key\n=VAL :value\n=VAL :key2\n=VAL :value2\n-MAP\n+MAP\n=VAL :key3\n=VAL :value3\n-MAP\n-SEQ\n-DOC\n-STR\n",
      "[\n  \{\n    \"key\": \"value\",\n    \"key2\": \"value2\"\n  \},\n  \{\n    \"key3\": \"value3\"\n  \}\n]\n",
      false,
    ),
    SuiteCase(
      "93WF",
      "Spec Example 6.6. Line Folding [1.3]",
      "--- >-\n  trimmed\n  \n \n\n  as\n  space\n",
      "+STR\n+DOC ---\n=VAL >trimmed\\n\\n\\nas space\n-DOC\n-STR\n",
      "\"trimmed\\n\\n\\nas space\"\n",
      false,
    ),
    SuiteCase(
      "96L6",
      "Spec Example 2.14. In the folded scalars, newlines become spaces",
      "--- >\n  Mark McGwire's\n  year was crippled\n  by a knee injury.\n",
      "+STR\n+DOC ---\n=VAL >Mark McGwire's year was crippled by a knee injury.\\n\n-DOC\n-STR\n",
      "\"Mark McGwire's year was crippled by a knee injury.\\n\"\n",
      false,
    ),
    SuiteCase(
      "96NN/00",
      "Leading tab content in literals",
      "foo: |-\n \tbar\n",
      "+STR\n+DOC\n+MAP\n=VAL :foo\n=VAL |\\tbar\n-MAP\n-DOC\n-STR\n",
      "\{\"foo\":\"\\tbar\"\}\n",
      false,
    ),
    SuiteCase(
      "96NN/01",
      "Leading tab content in literals",
      "foo: |-\n \tbar",
      "+STR\n+DOC\n+MAP\n=VAL :foo\n=VAL |\\tbar\n-MAP\n-DOC\n-STR\n",
      "\{\"foo\":\"\\tbar\"\}\n",
      false,
    ),
    SuiteCase(
      "98YD",
      "Spec Example 5.5. Comment Indicator",
      "# Comment only.\n",
      "+STR\n-STR\n",
      "",
      false,
    ),
  ]
}

