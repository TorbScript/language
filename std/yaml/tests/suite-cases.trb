      "+STR\n+DOC ---\n+MAP\n=VAL :hr\n+SEQ\n=VAL :Mark McGwire\n=VAL :Sammy Sosa\n-SEQ\n=VAL :rbi\n+SEQ\n=VAL :Sammy Sosa\n=VAL :Ken Griffey\n-SEQ\n-MAP\n-DOC\n-STR\n",
      "\{\n  \"hr\": [\n    \"Mark McGwire\",\n    \"Sammy Sosa\"\n  ],\n  \"rbi\": [\n    \"Sammy Sosa\",\n    \"Ken Griffey\"\n  ]\n\}\n",
      false,
    ),
    SuiteCase(
      "JEF9/00",
      "Trailing whitespace in streams",
      "- |+\n\n\n",
      "+STR\n+DOC\n+SEQ\n=VAL |\\n\\n\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"\\n\\n\"\n]\n",
      false,
    ),
    SuiteCase(
      "JEF9/01",
      "Trailing whitespace in streams",
      "- |+\n   \n",
      "+STR\n+DOC\n+SEQ\n=VAL |\\n\n-SEQ\n-DOC\n-STR\n",
      "[\n  \"\\n\"\n]\n",
      false,
    ),
  ]
}

