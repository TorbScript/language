/**
 * The network: IP addresses and socket addresses as values, name resolution, and TCP - a listener that accepts
 * connections and a stream whose two directions are a `Source` and a `Sink` of `Bytes`.
 *
 *     const server = TcpListener.listen(SocketAddress(IpAddress.loopback, 0))?
 *     const client = TcpStream.connect(server.localAddress()).await()?
 *
 * Everything that waits answers a `Task` and is cancellable; a timeout is `within`. Needs the network capability inside
 * a sandboxed script. See `docs/design/NETWORK.md` for the IO core under it and what comes next (UDP, TLS).
 */

public use AddressError, Ipv4Address, Ipv6Address, IpAddress, SocketAddress from "./address"
public use NetworkError from "./error"
public use resolve, TcpListener, TcpStream, TcpSource, TcpSink from "./tcp"
