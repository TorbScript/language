/** [crc32]: the checksum of gzip, zip and PNG. */

use Bytes from "std/stream"

/** The CRC-32 of ISO 3309 and ITU-T V.42 - the reflected polynomial `0xEDB88320` - of `bytes`. */
public fn crc32(bytes: Bytes): UInt32 {
  UInt32.tryFrom(crcValue(bytes)).ok() ?? 0
}

/** The same checksum as an `Int` below 2^32: what gzip writes into its trailer. */
public fn crcValue(bytes: Bytes): Int {
  var table: Array<Int, 256> = Array.filled 0
  for index in 0..256 {
    var value = index
    for _ in 0..8 {
      value = if value & 1 == 1 { 0xEDB88320 ^ (value >> 1) } else { value >> 1 }
    }
    table[index] = value
  }
  var crc = 0xFFFFFFFF
  for byte in bytes {
    crc = table[(crc ^ Int.from(byte)) & 255] ^ (crc >> 8)
  }
  crc ^ 0xFFFFFFFF
}
