/** [gzipped] and [gunzipped]: gzip members (RFC 1952) around DEFLATE. */

use ByteOrder, ByteReader from "std/binary"
use ArrayList from "std/collections"
use Bytes from "std/stream"
use CompressionError from "./error"
use crcBetween, crcValue from "./crc"
use deflateInto from "./deflate"
use inflateInto from "./inflate"

/**
 * `bytes` as one gzip member, with nothing in its header that depends on the machine or the moment: no file name, no
 * time, the operating system "unknown". The same bytes give the same member everywhere.
 */
public fn gzipped(bytes: Bytes): Bytes {
  // The header, the stream and the trailer written into one concrete list
  var output: ArrayList<UInt8> = ArrayList.withCapacity(bytes.length() / 2 + 64)
  for byte in header {
    output.append byte
  }
  deflateInto bytes, output
  appendWord output, crcValue(bytes)
  appendWord output, bytes.length()
  output
}

/** The ten bytes of the header: the magic number, DEFLATE, no flags, no time, no extra flags, an unknown system. */
const header: List<UInt8> = [0x1F, 0x8B, 8, 0, 0, 0, 0, 0, 0, 255]

/** The lowest 32 bits of `value`, little endian: what a gzip trailer holds of a checksum and a length. */
fn appendWord(var output: ArrayList<UInt8>, value: Int) {
  for shift in [0, 8, 16, 24] {
    output.append(UInt8.tryFrom((value >> shift) & 255).ok() ?? 0)
  }
}

/**
 * What every gzip member of `bytes` holds, one after the other. Each member's checksum and length are checked.
 *
 * # Errors
 *
 * - [CompressionError] where a header is not gzip's, a method is not DEFLATE, the DEFLATE stream is broken, or a
 *   checksum or a length does not match what was inflated.
 */
public fn gunzipped(bytes: Bytes): Result<Bytes, CompressionError> {
  // Every member is inflated into the one list, which is checked where each member starts in it
  var output: ArrayList<UInt8> = ArrayList.withCapacity 0
  var reader = ByteReader bytes, order: ByteOrder.LittleEndian
  loop {
    const start = reader.position()
    if reader.remaining() < 10 {
      return Fail CompressionError("the input ends inside a gzip header", start)
    }
    const header = reader.bytes(10)?
    if header[0] != 0x1F || header[1] != 0x8B {
      return Fail CompressionError("not gzip: the first two bytes are not 1f 8b", start)
    }
    if header[2] != 8 {
      return Fail CompressionError("a gzip member whose method is not DEFLATE", start + 2)
    }
    const flags = Int.from header[3]
    // Where the DEFLATE stream starts: the optional fields are skipped by offset, and one that claims more bytes than
    // there are leaves it past the end, where the stream is refused
    var streamStart = reader.position()
    if flags & 4 != 0 {
      const extra = match reader.uint16() {
        Ok(length) => Int.from length
        Fail(_) => {
          return Fail CompressionError("the input ends inside the extra field of a gzip header", streamStart)
        }
      }
      streamStart = streamStart + 2 + extra
    }
    if flags & 8 != 0 {
      streamStart = afterZero(reader, streamStart)?
    }
    if flags & 16 != 0 {
      streamStart = afterZero(reader, streamStart)?
    }
    if flags & 2 != 0 {
      streamStart = streamStart + 2
    }
    const first = output.length()
    const end = inflateInto(bytes, streamStart, output)?
    reader.seek(end)?
    if reader.remaining() < 8 {
      return Fail CompressionError("the input ends inside a gzip trailer", end)
    }
    if Int.from(reader.uint32()?) != crcBetween(output, first, output.length()) {
      return Fail CompressionError("the CRC-32 of the member does not match what it holds", start)
    }
    if Int.from(reader.uint32()?) != (output.length() - first) & 0xFFFFFFFF {
      return Fail CompressionError("the length of the member does not match what it holds", start)
    }
    if reader.remaining() == 0 {
      return output
    }
  }
}

/** The offset after the zero byte that ends a text field of the header, which starts at `from`. */
fn afterZero(var reader: ByteReader, from: Int): Result<Int, CompressionError> {
  if reader.seek(from).isOk() {
    loop {
      match reader.uint8() {
        Ok(0) => {
          return reader.position()
        }
        Ok(_) => {}
        Fail(_) => {
          break
        }
      }
    }
  }
  Fail CompressionError("the input ends inside a text field of a gzip header", from)
}
