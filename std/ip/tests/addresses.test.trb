/**
 * The address values of `std/ip`: IPv4 and IPv6 read from text and shown as text (RFC 5952 for IPv6), socket addresses
 * with and without brackets, the classification questions, and the order.
 */

use test, group from "std/test"
use Ipv4Address, Ipv6Address, IpAddress, SocketAddress from "../src/address"

/** The text an address shows as, or the reason it is none. */
fn shownVersion6(text: String): String {
  match Ipv6Address.tryFrom(text) {
    Ok(address) => address.show()
    Fail(problem) => problem.reason
  }
}

group "IPv4" {
  test "four decimal parts from 0 to 255 read and show as they were written" {
    for text in ["0.0.0.0", "127.0.0.1", "255.255.255.255", "10.1.2.3"] {
      assert(Ipv4Address.tryFrom(text).map({ _.show() }) == text)
    }
  }

  test "a part out of range, missing, extra, with a leading zero or no digits is refused" {
    for text in ["256.0.0.1", "1.2.3", "1.2.3.4.5", "01.2.3.4", "1.2.3.a", "", "1..2.3", "-1.2.3.4"] {
      assert(!Ipv4Address.tryFrom(text).isOk())
    }
  }

  test "the octets come most significant first" {
    assert(Ipv4Address.of(192, 168, 7, 1).octets() == [192, 168, 7, 1])
    assert(Ipv4Address.of(127, 0, 0, 1) == Ipv4Address.loopback)
  }

  test "the classification questions" {
    assert Ipv4Address.loopback.isLoopback()
    assert Ipv4Address.unspecified.isUnspecified()
    assert(Ipv4Address.tryFrom("172.16.0.1").map({ _.isPrivate() }) == true)
    assert(Ipv4Address.tryFrom("172.32.0.1").map({ _.isPrivate() }) == false)
    assert(Ipv4Address.tryFrom("169.254.3.4").map({ _.isLinkLocal() }) == true)
    assert(Ipv4Address.tryFrom("239.1.1.1").map({ _.isMulticast() }) == true)
  }
}

group "IPv6" {
  test "RFC 5952: lower case, no leading zeros, the longest run of zeros collapsed" {
    assert(shownVersion6("2001:DB8:0:0:0:0:0:1") == "2001:db8::1")
    assert(shownVersion6("2001:0db8:0000:0000:0001:0000:0000:0001") == "2001:db8::1:0:0:1")
    assert(shownVersion6("0:0:0:0:0:0:0:1") == "::1")
    assert(shownVersion6("0:0:0:0:0:0:0:0") == "::")
    assert(shownVersion6("1:0:0:2:0:0:0:3") == "1:0:0:2::3")
    assert(shownVersion6("1:0:2:3:4:5:6:7") == "1:0:2:3:4:5:6:7")
    assert(shownVersion6("ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff") == "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff")
  }

  test "an IPv4 address may stand for the last two segments, and a mapped one shows as one" {
    assert(shownVersion6("::ffff:192.0.2.1") == "::ffff:192.0.2.1")
    assert(shownVersion6("64:ff9b::192.0.2.33") == "64:ff9b::c000:221")
    assert(Ipv6Address.tryFrom("::ffff:10.0.0.1").map({ _.mappedVersion4() }) == Ipv4Address.tryFrom("10.0.0.1").ok())
  }

  test "two `::`, too many segments, a long segment, a zone or a stray character is refused" {
    for text in ["1::2::3", "1:2:3:4:5:6:7:8:9", "12345::1", "fe80::1%eth0", "1:2:3:4:5:6:7", "::g", ":1::", "1:2:3:4:5:6:7::8"] {
      assert(!Ipv6Address.tryFrom(text).isOk())
    }
  }

  test "the classification questions" {
    assert Ipv6Address.loopback.isLoopback()
    assert(Ipv6Address.tryFrom("fe80::1").map({ _.isLinkLocal() }) == true)
    assert(Ipv6Address.tryFrom("fd00::1").map({ _.isUniqueLocal() }) == true)
    assert(Ipv6Address.tryFrom("ff02::1").map({ _.isMulticast() }) == true)
  }

  test "the halves carry every bit, the high one included" {
    const all = Ipv6Address.tryFrom("ffff:0:0:0:0:0:0:8000").ok() ?? Ipv6Address.unspecified
    assert(Ipv6Address.ofHalves(all.high(), all.low()) == all)
    assert(all.segments() == [65535, 0, 0, 0, 0, 0, 0, 32768])
  }
}

group "IpAddress and SocketAddress" {
  test "a colon is IPv6, anything else IPv4" {
    assert(IpAddress.tryFrom("::1").map({ _.version() }) == 6)
    assert(IpAddress.tryFrom("127.0.0.1").map({ _.version() }) == 4)
  }

  test "every IPv4 address sorts before every IPv6 address" {
    const version6 = IpAddress.Version6 Ipv6Address.loopback
    assert(IpAddress.loopback.compare(version6) == .Less)
    assert(version6.compare(IpAddress.loopback) == .Greater)
  }

  test "a socket address shows with brackets around IPv6" {
    assert(SocketAddress.tryFrom("127.0.0.1:80").map({ _.show() }) == "127.0.0.1:80")
    assert(SocketAddress.tryFrom("[::1]:8080").map({ _.show() }) == "[::1]:8080")
    assert(SocketAddress.tryFrom("[::1]:8080").map({ _.port }) == 8080)
  }

  test "a missing or wrong port is refused" {
    for text in ["127.0.0.1", "127.0.0.1:", "127.0.0.1:65536", "[::1]", "[::1]8080", "::1:80", "127.0.0.1:8a"] {
      assert(!SocketAddress.tryFrom(text).isOk())
    }
  }
}
