/**
 * The named character references of HTML: every name of the WHATWG's table
 * (https://html.spec.whatwg.org/entities.json) that ends in `;`, which is how CommonMark recognizes one, and the
 * characters it stands for. Generated from the table; 2125 names.
 *
 * The names of one first letter are one text, `\u{1}name\u{2}characters` for each, so a lookup is one search in it.
 */

/** The characters `&name;` stands for, or `None` where HTML has no such reference. `name` is without `&` and `;`. */
public fn entityText(name: String): String? {
  if name.isEmpty() {
    return None
  }
  const table = tableOf name.sliceBytes(0, 1)
  const start = table.indexOf("\u{1}" + name + "\u{2}")?
  const valueStart = start + name.byteLength() + 2
  const rest = table.sliceBytes valueStart, table.byteLength()
  const end = rest.indexOf("\u{1}") ?? rest.byteLength()
  Some rest.sliceBytes(0, end)
}

/** The references whose names start with `letter`. */
fn tableOf(letter: String): String {
  match letter {
    "A" => "\u{1}AElig\u{2}\u{c6}\u{1}AMP\u{2}&\u{1}Aacute\u{2}\u{c1}\u{1}Abreve\u{2}\u{102}\u{1}Acirc\u{2}\u{c2}\u{1}Acy\u{2}\u{410}\u{1}Afr\u{2}\u{1d504}\u{1}Agrave\u{2}\u{c0}\u{1}Alpha\u{2}\u{391}\u{1}Amacr\u{2}\u{100}\u{1}And\u{2}\u{2a53}\u{1}Aogon\u{2}\u{104}\u{1}Aopf\u{2}\u{1d538}\u{1}ApplyFunction\u{2}\u{2061}\u{1}Aring\u{2}\u{c5}\u{1}Ascr\u{2}\u{1d49c}\u{1}Assign\u{2}\u{2254}\u{1}Atilde\u{2}\u{c3}\u{1}Auml\u{2}\u{c4}"
