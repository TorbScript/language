/**
 * The writer: a document tree back to Markdown, so that reading what it writes gives the same tree. It writes one form
 * for each construct - `*` and `**`, fenced code, `-` and `1.` lists, ATX headings where a heading fits on one line -
 * and escapes every character of a text that could be read as markup.
 */

use MarkdownDocument, MarkdownBlock, BlockContent, MarkdownInline, MarkdownList, ColumnAlignment from "./tree"

/** A document as Markdown, with its front matter. */
public fn markdownOf(document: MarkdownDocument): String {
  var pieces: List<String> = []
  if const Some(frontMatter) = document.frontMatter {
    pieces.append "---\n"
    pieces.append frontMatter.text
    pieces.append "---\n"
    if !document.blocks.isEmpty() {
      pieces.append "\n"
    }
  }
  pieces.append blocksText(document.blocks, tight: false)
  pieces.joined separator: ""
}

extend MarkdownDocument {
  /** The document as Markdown text, which reads back as this document. */
  fn markdown(): String {
    markdownOf self
  }
}

/** Blocks, each ending in a line break, separated by an empty line - or, in a tight list, by nothing. */
fn blocksText(blocks: List<MarkdownBlock>, tight: Bool): String {
  var pieces: List<String> = []
  for index in 0..blocks.length() {
    if index > 0 {
      const previous = blocks[index - 1].content
      const current = blocks[index].content
      if !tight || needsSeparation(previous, current) {
        pieces.append "\n"
      }
      // Two lists of the same kind in a row would be read as one: an empty comment keeps them apart
      if isSameKindOfList(previous, current) {
        pieces.append "<!-- -->\n\n"
      }
    }
    pieces.append blockText(blocks[index])
  }
  pieces.joined separator: ""
}

/** Whether two blocks of a tight list item need an empty line between them all the same. */
fn needsSeparation(previous: BlockContent, current: BlockContent): Bool {
  match previous {
    .Paragraph(_) => match current {
      .Paragraph(_) => true
      .HtmlBlock(_) => true
      _ => false
    }
    .HtmlBlock(_) => true
    _ => false
  }
}

fn isSameKindOfList(previous: BlockContent, current: BlockContent): Bool {
  match previous {
    .ItemList(first) => match current {
      .ItemList(second) => first.ordered == second.ordered && first.marker == second.marker
      _ => false
    }
    _ => false
  }
}

fn blockText(block: MarkdownBlock): String {
  match block.content {
    .Paragraph(inlines) => inlinesText(inlines, inCell: false) + "\n"
    .Heading(level, inlines) => headingText level, inlines
    .ThematicBreak => "***\n"
    .CodeBlock(info, text, _) => codeBlockText info, text
    .HtmlBlock(html) => html + "\n"
    .BlockQuote(blocks) => prefixed blocksText(blocks, tight: false), "> ", ">"
    .ItemList(list) => listText list
    .Table(table) => {
      var pieces: List<String> = []
      pieces.append rowText(table.header.map({ inlinesText _, inCell: true }).toList())
      const delimiters = table.alignments.map({ alignment =>
        match alignment {
          .Unspecified => "---"
          .Left => ":--"
          .Center => ":-:"
          .Right => "--:"
        }
      }).toList()
      pieces.append rowText(delimiters)
      for row in table.rows {
        pieces.append rowText(row.map({ inlinesText _, inCell: true }).toList())
      }
      pieces.joined separator: ""
    }
  }
}

fn rowText(cells: List<String>): String {
  "| " + cells.joined(separator: " | ") + " |\n"
}

/** An ATX heading where it fits on one line; a heading of several lines, which only levels 1 and 2 have, underlined. */
fn headingText(level: Int, inlines: List<MarkdownInline>): String {
  const text = inlinesText inlines, inCell: false
  if text.contains("\n") && level <= 2 {
    return text + "\n" + (if level == 1 { "===" } else { "---" }) + "\n"
  }
  if text.isEmpty() {
    return "#".repeat(level) + "\n"
  }
  // A run of `#` at the end would be read as the closing sequence: its first one is escaped
  var body = text.replace "\n", " "
  if body.endsWith("#") {
    var start = body.byteLength()
    while start > 0 && body.sliceBytes(start - 1, start) == "#" {
      start = start - 1
    }
    if start == 0 || body.sliceBytes(start - 1, start) != "\\" {
      body = body.sliceBytes(0, start) + "\\" + body.sliceBytes(start, body.byteLength())
    }
  }
  "#".repeat(level) + " " + body + "\n"
}

/** A fenced code block, with a fence longer than any run of the fence character in the text. */
fn codeBlockText(info: String, text: String): String {
  const fenceCharacter = if info.contains("`") { '~' } else { '`' }
  const length = longestRun(text, fenceCharacter).max(2) + 1
  const fence = fenceCharacter.show().repeat(length)
  const body = if text.isEmpty() || text.endsWith("\n") { text } else { text + "\n" }
  fence + escapedInfo(info) + "\n" + body + fence + "\n"
}

fn escapedInfo(info: String): String {
  info.replace("\\", "\\\\").replace("&", "\\&")
}

fn longestRun(text: String, character: Char): Int {
  var longest = 0
  var current = 0
  for found in text.chars() {
    if found == character {
      current = current + 1
      longest = longest.max current
    } else {
      current = 0
    }
  }
  longest
}

/** Every line of `text` with `prefix` in front of it, and `emptyPrefix` in front of an empty one. */
fn prefixed(text: String, prefix: String, emptyPrefix: String): String {
  var pieces: List<String> = []
  var lines = text.split "\n"
  if text.endsWith("\n") {
    lines = lines.removedAt(lines.length() - 1)
  }
  for line in lines {
    pieces.append(if line.isEmpty() { emptyPrefix } else { prefix + line })
    pieces.append "\n"
  }
  pieces.joined separator: ""
}

fn listText(list: MarkdownList): String {
  var pieces: List<String> = []
  for index in 0..list.items.length() {
    const item = list.items[index]
    if index > 0 && !list.tight {
      pieces.append "\n"
    }
    const marker = if list.ordered { "{list.start + index}{list.marker}" } else { list.marker }
    const content = blocksText item.blocks, list.tight
    if content.isEmpty() {
      pieces.append(marker + "\n")
      continue
    }
    const indentation = " ".repeat(marker.byteLength() + 1)
    const indented = prefixed content, indentation, ""
    // The first line goes behind the marker, which takes the place of its indentation
    pieces.append(marker + " " + indented.sliceBytes(indentation.byteLength(), indented.byteLength()))
  }
  pieces.joined separator: ""
}

// --- Inlines ---------------------------------------------------------------------------------------------------------

/** Inlines as Markdown; `inCell` escapes the `|` a table cell would be cut at, in code spans too. */
fn inlinesText(inlines: List<MarkdownInline>, inCell: Bool): String {
  var pieces: List<String> = []
  var lineStart = true
  for index in 0..inlines.length() {
    const inline = inlines[index]
    // A `!` right before a link would make it an image
    const beforeLink = match inlines.get(index + 1) {
      Some(.Link(_, _, _, _)) => true
      _ => false
    }
    const text = match inline {
      .Text(value) => {
        const escaped = escapedText value, lineStart
        if beforeLink && escaped.endsWith("!") {
          escaped.sliceBytes(0, escaped.byteLength() - 1) + "\\!"
        } else {
          escaped
        }
      }
      other => inlineText other, inCell, lineStart
    }
    pieces.append text
    lineStart = inline == MarkdownInline.SoftBreak || inline == MarkdownInline.HardBreak
  }
  pieces.joined separator: ""
}

fn inlineText(inline: MarkdownInline, inCell: Bool, lineStart: Bool): String {
  match inline {
    .Text(text) => escapedText text, lineStart
    .Code(text) => codeSpanText(if inCell { text.replace "|", "\\|" } else { text })
    .Emphasis(children) => {
      // Emphasis right inside emphasis takes the other character, or the two would be read as strong emphasis
      const marker = if isNestedAtEdge(children) { "_" } else { "*" }
      marker + inlinesText(children, inCell) + marker
    }
    .Strong(children) => "**" + inlinesText(children, inCell) + "**"
    .Link(destination, title, children, _) => "[" + inlinesText(children, inCell) + "]" + linkTarget(destination, title)
    .Image(destination, title, children, _) => "!["
      + inlinesText(children, inCell)
      + "]"
      + linkTarget(destination, title)
    .Html(html) => html
    .SoftBreak => "\n"
    .HardBreak => "\\\n"
  }
}

/** Whether emphasis starts or ends right at the edge of the emphasis it is in: `**` would read as strong emphasis. */
fn isNestedAtEdge(children: List<MarkdownInline>): Bool {
  const edges = [children.first(), children.last()]
  edges.any { edge =>
    match edge {
      Some(.Emphasis(_)) => true
      _ => false
    }
  }
}

/** `(<destination> "title")`: the destination in angle brackets, so spaces and parentheses need no escape. */
fn linkTarget(destination: String, title: String): String {
  const escapedDestination = destination.replace("\\", "\\\\").replace("<", "\\<").replace(">", "\\>")
  if title.isEmpty() {
    return "(<" + escapedDestination + ">)"
  }
  const escapedTitle = title.replace("\\", "\\\\").replace("\"", "\\\"")
  "(<" + escapedDestination + "> \"" + escapedTitle + "\")"
}

/** A code span with a run of backticks that the text does not hold, and spaces where the text needs them. */
fn codeSpanText(text: String): String {
  var length = 1
  while text.contains("`".repeat(length)) {
    length = length + 1
  }
  const fence = "`".repeat(length)
  const needsSpace = text.startsWith("`")
    || text.endsWith("`")
    || (text.startsWith(" ") && text.endsWith(" ") && !text.isBlank())
  if needsSpace {
    return fence + " " + text + " " + fence
  }
  fence + text + fence
}

/**
 * A text with every character escaped that could be read as markup: the characters of emphasis, code, links, HTML,
 * entities and tables anywhere, and at the start of a line the ones that start a block.
 */
fn escapedText(text: String, lineStart: Bool): String {
  var pieces: List<String> = []
  const characters = text.chars().toList()
  var atStart = lineStart
  for index in 0..characters.length() {
    const character = characters[index]
    const always = match character {
      '\\' | '`' | '*' | '_' | '[' | ']' | '<' | '>' | '&' | '|' => true
      _ => false
    }
    // A line break or a carriage return inside a text, and whitespace a line would lose at its start, are references
    if character == '\n' || character == '\r' || (atStart && (character == ' ' || character == '\t')) {
      pieces.append "&#{Int64.from(character)};"
      atStart = false
      continue
    }
    var escape = always
    if atStart {
      escape = escape
        || character == '#'
        || character == '-'
        || character == '+'
        || character == '='
        || character == '~'
    }
    if (character == '.' || character == ')')
      && index > 0
      && characters[index - 1].isDigit()
      && isNumberAtStart(characters, index, lineStart) {
      escape = true
    }
    if escape {
      pieces.append "\\"
    }
    pieces.append character.show()
    atStart = false
  }
  pieces.joined separator: ""
}

/** Whether the digits before `index` are all a line starts with: `1.` there would begin an ordered list. */
fn isNumberAtStart(characters: List<Char>, index: Int, lineStart: Bool): Bool {
  var at = index - 1
  while at >= 0 && characters[at].isDigit() {
    at = at - 1
  }
  if at < 0 {
    return lineStart
  }
  characters[at] == '\n'
}
