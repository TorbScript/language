/**
 * `Add`, `Subtract`, `Multiply`, `Divide`, `Remainder` and `Negate`, the traits the arithmetic operators go through,
 * plus `OrElse` for `??` and `Indexed`/`MutableIndexed`/`Slice`/`MutableSlice` for `a[i]` and `a[from..to]`. Each type
 * parameter list has defaults, which is why `with Add` alone means `Add<Self, Self>`.
 */

/**
 * `a + b`
 *
 * # Examples
 *
 *     print(1 + 2)
 */
public trait Add<Other = Self, Output = Self> {
  /** The sum of the two values. This is `+`. */
  fn add(other: Other): Output
}

/** `a - b` */
public trait Subtract<Other = Self, Output = Self> {
  /** The difference of the two values. This is `-`. */
  fn subtract(other: Other): Output
}

/** `a * b` */
public trait Multiply<Other = Self, Output = Self> {
  /** The product of the two values. This is `*`. */
  fn multiply(other: Other): Output
}

/**
 * `a / b`
 *
 * On the integer types the division truncates toward zero (`-7 / 2` is `-3`), a division by zero panics, and so does
 * the smallest value of a signed type divided by `-1` - an overflow like any other.
 */
public trait Divide<Other = Self, Output = Self> {
  /** The quotient of the two values. This is `/`. */
  fn divide(other: Other): Output
}

/**
 * `a % b`
 *
 * On the integer types the remainder takes the sign of the dividend (`-7 % 2` is `-1`), so `a` is always
 * `(a / b) * b + a % b`. A remainder by zero panics.
 */
public trait Remainder<Other = Self, Output = Self> {
  /** What is left of `self` after dividing out as many `other` as fit. This is `%`. */
  fn remainder(other: Other): Output
}

/** `-a` */
public trait Negate {
  /** The value with its sign flipped. This is unary `-`. */
  fn negate(): Self
}

/**
 * `a ?? b`: the value, or the fallback where there is none.
 *
 * An operator is a trait exactly when it is a method call, and `a ?? b` *is* `a.orElse(b)` - so this is the trait it
 * goes through, like `Add` for `+`. `Option` and `Result` come with it. The fallback is `lazy`, so it is evaluated only
 * where the value is missing.
 */
public trait OrElse<Value> {
  /** The value, or the fallback where there is none. This is `??`. */
  fn orElse(fallback: lazy Value): Value
}

/** `a[key]` */
public trait Indexed<Key, Value> {
  /** The value at the key, or `None` if there is none. This is what `get` on a `Map` or a `List` calls. */
  fn get(key: Key): Value?

  /**
   * The value at the key. This is `a[key]`.
   *
   * # Panics
   *
   * When the key is not there. That is what `a[key]` promises - [Indexed.get] is the same question with an `Option`
   * for an answer, for a caller who expects the key to be missing.
   */
  fn at(key: Key): Value {
    get(key).expect("Key does not exist")
  }
}

/**
 * `a[key] = value`. It also makes `a[key]` a `var` path: `enemies[0].health = 5` and `groups[key].append(value)`
 * take the element out, change it and put it back (without a copy).
 */
public trait MutableIndexed<Key, Value> with Indexed<Key, Value> {
  /** Puts the value at the key, replacing whatever was there. This is `a[key] = value`. */
  var fn set(key: Key, value: Value)
}

/**
 * `a[from..to]`. The slice shares the storage and starts at index 0 again.
 *
 * It takes [Bounds] and not one range type, because all five spellings have a meaning here: an end the range leaves
 * open is the start or the end of the value, which is the receiver's decision and not the range's.
 */
public trait Slice {
  /** The part of the value the range covers. This is `a[from..to]`. */
  fn slice(range: Bounds<Int>): Self
}

/**
 * `a[from..to] = values`. It also makes `a[from..to]` a `var` path, which is what other languages need a
 * mutable span for: `samples[0..100].sort()` and `fill(samples[0..100])` work on this part in place.
 *
 * # Open
 *
 * Whether `values` may be a different length than the range it overwrites - growing or shrinking the receiver - is
 * not decided by the trait. It is up to whatever implements it, and callers should check that type's own signature.
 */
public trait MutableSlice with Slice {
  /** Overwrites the part of the value the range covers with `values`. This is `a[from..to] = values`. */
  var fn replace(range: Bounds<Int>, values: Self)
}
