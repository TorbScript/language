/**
 * Conversion between types: [From]/[Into] for a conversion that always works, [TryFrom]/[TryInto] for one that can
 * fail, and [Parse] for the one from text. [Show] is the direction into a `String` for printing, and
 * [LiteralParseError] is what a generated [Parse] of a literal type answers.
 *
 * One direction of each pair is the one to implement: [From] and [TryFrom]. [Into] and [TryInto] come from a blanket
 * implementation over them, so an `extend` that writes one by hand is reported with the line to write instead.
 */

use Error from "./error"

/**
 * Infallible conversion. Implement this one, `Into` comes for free.
 *
 * # Examples
 *
 *     const codepoint: Int = Int.from 'A'
 *     print codepoint
 *
 * This is also how a package converts **its own type into a foreign one**: a type of this package named as an
 * argument of the trait is enough to own the implementation, so `Float64` may be the target although it belongs to
 * somebody else.
 *
 *     type Celsius {
 *       degrees: Float
 *     }
 *
 *     extend Float64 with From<Celsius> {
 *       fn from(value: Celsius): Float64 {
 *         value.degrees
 *       }
 *     }
 *
 *     const degrees: Float64 = Celsius(21.5).into()
 *     print degrees
 *
 * # Related
 *
 * - [Into] - the other direction, gained for free from this one.
 * - [TryFrom] - the same conversion where it can fail.
 */
public trait From<Source> {
  /** Makes a `Self` from a `Source`. This is what `Self.from(source)` calls, and what [Into.into] calls through it. */
  fn from(value: Source): Self
}

/**
 * The other direction of [From], gained for free wherever `Target: From<Self>`.
 *
 * # Pitfalls
 *
 * - Implement [From] and not this one; the compiler says so at an `extend` that tries.
 *
 * # Related
 *
 * - [TryInto] - the same step where the conversion can fail.
 */
public trait Into<Target> {
  /** Makes a `Target` from `self`. */
  fn into(self): Target
}

/** The blanket implementation that gives every [From] its [Into] for free: nothing implements `Into` by hand. */
extend<Source, Target> Source with Into<Target> where Target: From<Source> {
  fn into(self): Target {
    Target.from self
  }
}

/**
 * Every type can be made from a `Never`, because there is no value to make it from: `Never` coerces to anything, so
 * the body is the argument. What this buys is `?` on a `Result<Value, Never>` - the reading end of a `Channel` cannot
 * fail, and without this every use of one would have to take the `Result` apart with a pattern.
 */
extend<Target> Target with From<Never> {
  fn from(value: Never): Target {
    value
  }
}

/**
 * Fallible conversion: the [From] for a source that may not represent a valid value. Implement this one, `TryInto`
 * comes for free.
 *
 * # Examples
 *
 *     const narrow: Result<Int8, NumberRangeError> = Int8.tryFrom 300
 *     print narrow.isError()
 *
 * # Related
 *
 * - [TryInto] - the other direction, gained for free from this one.
 * - [From] - the same conversion where it cannot fail.
 */
public trait TryFrom<Source, Failure> {
  /**
   * Makes a `Self` from a `Source`, or answers why it could not. This is what `Self.tryFrom(source)` calls, and what
   * [TryInto.tryInto] calls through it.
   */
  fn tryFrom(value: Source): Result<Self, Failure>
}

/**
 * The other direction of [TryFrom], gained for free wherever `Target: TryFrom<Self, Failure>`.
 *
 * Write the target out. `tryInto()` answers a `Result`, so a `?` in front of the annotation is what a reader sees
 * first and the target itself has nowhere else to come from:
 *
 * # Examples
 *
 *     const narrow: Result<Int8, NumberRangeError> = 300.tryInto()
 *     print narrow.isError()
 *
 * # Pitfalls
 *
 * - Implement [TryFrom] and not this one. The blanket implementation below is the only `TryInto` there is, and the
 *   compiler says so at an `extend` that tries.
 *
 * # Related
 *
 * - [TryFrom] - the one to implement.
 * - [Into] - the same step where the conversion cannot fail.
 */
public trait TryInto<Target, Failure> {
  /** Makes a `Target` from `self`, or answers why it could not. */
  fn tryInto(self): Result<Target, Failure>
}

/** The blanket implementation that gives every [TryFrom] its [TryInto] for free: nothing implements `TryInto` by hand. */
extend<Source, Target, Failure> Source with TryInto<Target, Failure> where Target: TryFrom<Source, Failure> {
  fn tryInto(self): Result<Target, Failure> {
    Target.tryFrom self
  }
}

/**
 * Fallible conversion from text: `Int.parse "42"`, `Email.parse "info@example.test"`.
 *
 * # Related
 *
 * - [LiteralParseError] - what a generated `Parse` of a literal type fails with.
 */
public trait Parse<Failure> {
  /** Makes a `Self` from text, or answers why the text does not describe one. */
  fn parse(text: String): Result<Self, Failure>
}

/**
 * What `Status.parse(text)` fails with when `text` is not one of a literal type's members:
 *
 *     'away' is not one of "online", "offline"
 */
public type LiteralParseError with Show, Error {
  /** The text that was given. */
  text: String
  /** The members it could have been instead. */
  expected: List<String>

  /** `'away' is not one of "online", "offline"` */
  fn show(self): String {
    const options = expected.map { option => "\"{option}\"" }
    "'{text}' is not one of {options.joined(separator: ", ")}"
  }
}

/**
 * Used by string interpolation. Generated for every `type`.
 * A `shared trait`, so that objects with an identity (connections, files) can be printed, too.
 * `Equals` and `Hash` are not: `==` always compares content. For identity there is `isSame(a, b)`.
 *
 * # Examples
 *
 *     print 1.show()
 *     print "already text".show()
 */
public shared trait Show {
  /** The text a value shows as: what string interpolation calls, and what `print` calls through it. */
  fn show(self): String

  /**
   * How the value looks _inside_ of another value: in a list, in a field of a generated `Show`, in a tuple.
   * Only `String` (quoted, with escapes) and `Char` (in single quotes) differ from `show()`, so that
   * `["a", "b"]` stays readable while `"{name}"` is still the text itself.
   */
  fn showNested(self): String {
    show()
  }
}
