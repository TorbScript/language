/**
 * What every other package builds on: the types the language itself refers to - [Option] behind `Value?`, [Result]
 * behind `?`, [Range], [RangeFrom] and [RangeTo] behind `a..b`, [Array] as the inline storage a list literal adapts to -
 * the traits the operators
 * and the conversions go through, and the control flow that is a function.
 *
 * Nothing here knows about text, numbers or collections, which is what makes it the bottom of the standard library -
 * with the one exception that `String` is unavoidable in a signature (`Show.show`, `panic`). That import points at
 * `std/text` and is the reason the standard library's packages are cyclic; see "Modules and Packages" in CONCEPT.md.
 */

public use Void, Never, panic from "./void"
public use Bool from "./bool"
public use Option from "./option"
public use Result from "./result"
public use Error from "./error"

public use Equals, Compare, Ordering, Hash, combineHashes from "./compare"
public use From, Into, TryFrom, TryInto, Show, LiteralParseError from "./convert"
public use Add, Subtract, Multiply, Divide, Remainder, Power, Negate, OrElse from "./operators"
public use Index, MutableIndex, Slice, MutableSlice from "./operators"
public use Range, RangeFrom, RangeTo, Bounds from "./range"
public use Array from "./array"
public use Shared, isSame from "./shared"
public use do, unless, retry, Close from "./control"
public use OperatingSystem, Architecture, ByteOrder from "./target"
public use Predicate, Action, Transform from "./functions"
