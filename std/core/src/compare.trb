/**
 * Equality, order and hashing: [Equals], [Ordering], [Compare] and [Hash], generated structurally for every `type`
 * unless it implements one of them by hand, and `combineHashes`, what a hand-written `hash` folds its parts through.
 */

/**
 * `==` and `!=`. Generated by comparing every field, so implement it by hand only where content equality means
 * something else (a `Map` that should ignore insertion order, for instance).
 *
 * # Examples
 *
 *     print(1 == 1)
 *     print("a" != "b")
 */
public trait Equals {
  /** Whether the two values are equal. This is `==`. */
  fn equals(other: Self): Bool

  /** Whether the two values differ. This is `!=`. */
  fn notEquals(other: Self): Bool {
    !equals(other)
  }
}

/** What [Compare.compare] answers: which of the two values comes first, or that neither does. */
public type Ordering {
  /** The first value comes before the second. */
  case Less
  /** The two values are equal. */
  case Equal
  /** The first value comes after the second. */
  case Greater

  /** Flips the direction, so sorting by the reverse of a key is comparing with this instead. */
  fn reversed(): Self {
    match self {
      .Less => .Greater
      .Equal => .Equal
      .Greater => .Less
    }
  }
}

/**
 * `<`, `<=`, `>`, `>=`. Requires [Equals], so a type that implements `Compare` gets both from a single `compare`.
 *
 * # Examples
 *
 *     print(1 < 2)
 *     print 7.clamp(0, 5)
 *
 * # Pitfalls
 *
 * - `compare` and `equals` have to agree: `compare(other) == .Equal` exactly where `equals(other)` is `true`. Nothing
 *   checks this, so a hand-written pair that disagrees breaks sorting and lookups silently instead of failing loudly.
 *
 * # Related
 *
 * - [Ordering] - what `compare` answers.
 */
public trait Compare with Equals {
  /** Which of the two values comes first. */
  fn compare(other: Self): Ordering

  /** Whether this value comes before `other`. */
  fn lessThan(other: Self): Bool {
    compare(other) == .Less
  }

  /** Whether this value comes after `other`. */
  fn greaterThan(other: Self): Bool {
    compare(other) == .Greater
  }

  /** The smaller of the two values. */
  fn min(other: Self): Self {
    if lessThan(other) { self } else { other }
  }

  /** The larger of the two values. */
  fn max(other: Self): Self {
    if greaterThan(other) { self } else { other }
  }

  /** The value, pulled into `[low, high]` when it lies outside of it. */
  fn clamp(low: Self, high: Self): Self {
    max(low).min(high)
  }
}

/**
 * Generated structurally for every `type`. Values that are equal must have equal hashes, which is why `Hash`
 * requires [Equals] and why a hand-written `hash` has to fold in exactly the fields a hand-written `equals` compares.
 *
 * # Related
 *
 * - [combineHashes] - what a hand-written `hash` folds its fields through.
 */
public trait Hash with Equals {
  /** The integer a hashed `Set` or `Map` places the value by. */
  fn hash(): Int
}

/**
 * Folds one more value into a running hash: wrapping, order-dependent, and deterministic across runs and platforms.
 * What `List` folds its items through, in order (see `std/collections`). A `Set` or a `Map` has to
 * combine its entries regardless of their order instead - `bitwiseExclusiveOr` (see `Bits` in `std/number`),
 * which cannot overflow, does that.
 */
public native fn combineHashes(seed: Int, value: Int): Int
