/**
 * [Bool], `true` and `false`: the primitive that `if`, `while`, `&&`, `||` and `!` are built on directly, without
 * going through a trait method the way `+` goes through `Add`.
 */

use Equals, Hash from "./compare"
use Show from "./convert"

/**
 * `true` and `false`, and nothing else. `&&` and `||` short-circuit and cannot be overloaded, because a trait method
 * would evaluate its argument.
 *
 * # Examples
 *
 *     const ready = true
 *     print(ready && !false)
 */
public native type Bool with Equals, Hash, Show {}
