/**
 * The three ranges the syntax writes - [Range] for `0..10`, [RangeFrom] for `0..`, [RangeTo] for `..10` - the trait
 * [Bounds] that reads any of them, and [RangeIterator], what it takes to walk a range of integers.
 *
 * **The type says which ends there are.** `a..b` has both, `a..` has a start, `..b` has an end, and no field is
 * optional anywhere - so `for index in ..10` and `(0..).length()` are refused where they are written and nothing has
 * to panic at run time.
 */

use Equals, Compare, Hash from "./compare"
use Show from "./convert"
use Iterator, Iterate, Length from "std/iteration"

/**
 * `0..10`, `0..=10`: a range with both ends. What `for index in 0..list.length()` counts through, and what a slice of
 * a known part takes (`samples[0..100]`).
 *
 * # Examples
 *
 *     const bounded = 0..10
 *     print bounded.contains(5)
 *     const inclusive = 0..=10
 *     print inclusive.contains(10)
 *
 * # Related
 *
 * - [RangeFrom] - `0..`, open at the end.
 * - [RangeTo] - `..10`, open at the start.
 * - [Bounds] - what a receiver takes to accept all three.
 */
public native type Range<Value> with Equals, Hash {
  /** The first value the range covers. */
  start: Value
  /** The last value, which `inclusive` says whether the range covers itself. */
  end: Value
  /** `0..=10` contains its end, `0..10` does not. An adjective, because it is data and not a question. */
  inclusive: Bool = false
}

/**
 * `0..`: a range with a start and no end. What a slice to the end of a value takes (`text[2..]`), and the one range
 * that iterates forever.
 *
 * # Examples
 *
 *     const fromThree = 3..
 *     print fromThree.contains(1000)
 *
 * # Related
 *
 * - [Range] - `0..10`, the range with both ends.
 */
public native type RangeFrom<Value> with Equals, Hash {
  /** The first value the range covers. */
  start: Value
}

/**
 * `..10`, `..=10`: a range with an end and no start. What a slice from the beginning of a value takes (`items[..3]`).
 *
 * It is not a sequence: there is no first value to start counting at, which is why `for index in ..10` is refused
 * where it is written.
 *
 * # Examples
 *
 *     const upToTen = ..10
 *     print upToTen.contains(9)
 *
 * # Related
 *
 * - [Range] - `0..10`, the range with both ends.
 */
public native type RangeTo<Value> with Equals, Hash {
  /** The last value, which `inclusive` says whether the range covers itself. */
  end: Value
  /** `..=10` contains its end, `..10` does not. */
  inclusive: Bool = false
}

/**
 * What every range has in common: the two ends, each `None` where the range is open on that side.
 *
 * This is what a receiver takes that accepts all three forms - a slice does (`text[2..]`, `items[..3]`,
 * `items[1..=2]`), because an open end has a meaning there: the start or the end of the value. Whoever needs a start
 * takes a [Range] or a [RangeFrom] instead and lets the type refuse the rest.
 *
 * # Examples
 *
 *     fn width(span: Bounds<Int>): String {
 *       "{span.lowest()} {span.highest()} {span.includesHighest()}"
 *     }
 *
 *     print width(2..=5)
 *     print width(2..)
 */
public trait Bounds<Value: Compare> {
  /** The low end, or `None` where the range is open at the start. */
  fn lowest(): Value?
  /** The high end, or `None` where the range is open at the end. */
  fn highest(): Value?
  /** Whether [Bounds.highest] itself lies inside. A range that has no high end answers `false`, which says nothing. */
  fn includesHighest(): Bool

  /** Whether the value lies within the range's bounds. An open end never excludes anything on its side. */
  fn contains(value: Value): Bool {
    if const Some(low) = lowest() {
      if value < low {
        return false
      }
    }
    if const Some(high) = highest() {
      return if includesHighest() { value <= high } else { value < high }
    }
    true
  }
}

/** Both ends are there, and `inclusive` says whether the high one is inside. */
extend<Value: Compare> Range<Value> with Bounds<Value> {
  fn lowest(): Value? {
    Some start
  }

  fn highest(): Value? {
    Some end
  }

  fn includesHighest(): Bool {
    inclusive
  }
}

/** Open at the end, so there is no high end to include. */
extend<Value: Compare> RangeFrom<Value> with Bounds<Value> {
  fn lowest(): Value? {
    Some start
  }

  fn highest(): Value? {
    None
  }

  fn includesHighest(): Bool {
    false
  }
}

/** Open at the start. */
extend<Value: Compare> RangeTo<Value> with Bounds<Value> {
  fn lowest(): Value? {
    None
  }

  fn highest(): Value? {
    Some end
  }

  fn includesHighest(): Bool {
    inclusive
  }
}

/**
 * A range of integers with both ends is a sequence with a length. Other ranges of integers are less: `0..` iterates
 * and has no length, `..10` does neither. Ranges of other types are bounds and nothing more - `'a'..'z'` says what is
 * inside of it, but there is no "the next value after `a`" in general.
 */
extend Range<Int> with Iterate<Int>, Length {
  fn iterate(): Iterator<Int> {
    RangeIterator start, Some(end), inclusive
  }

  /** How many values the range covers, never below zero: `(5..3).length()` is `0`. */
  fn length(): Int {
    const span = if inclusive { end - start + 1 } else { end - start }
    span.max 0
  }
}

/** `0..` counts on forever, which is what makes `for index in 0..` and `(0..).take(3)` work. */
extend RangeFrom<Int> with Iterate<Int> {
  fn iterate(): Iterator<Int> {
    RangeIterator start, None, false
  }
}

/**
 * The cursor over a range of integers: the next value, and where to stop. **TorbScript and not a runtime function**,
 * because it needs nothing the language does not have - which is the rule of `compiler/CONTRIBUTING.md`, "natives stay
 * few". A range without an end never stops, which is what `0..` means.
 */
public type RangeIterator with Iterator<Int> {
  /** The next value to hand out, one past the last one that was. */
  var current: Int
  /** `None` for a `RangeFrom`, which is what makes `0..` iterate forever. */
  end: Int?
  /** Whether `end` itself is still inside the range. */
  inclusive: Bool

  /** The next value, or `None` once `current` has passed `end`. */
  var fn next(): Int? {
    if const Some(highest) = end {
      const isDone = if inclusive { current > highest } else { current >= highest }
      if isDone {
        return None
      }
    }
    const value = current
    current = current + 1
    Some value
  }
}

/**
 * The source form, and not the fields: `0..10`, `0..=10`. A `Show` of its own rather than the derived one because a
 * reader writes a range that way, and because the interpreter has printed it that way all along - the two have to
 * agree to the character (design principle 5).
 *
 * It is **conditional** on `Value: Show`, which is why it cannot be a member of the `native type` itself: a range of
 * something unshowable is still a range.
 */
extend<Value: Show> Range<Value> with Show {
  fn show(): String {
    const dots = if inclusive { "..=" } else { ".." }
    "{start.show()}{dots}{end.show()}"
  }
}

/** `0..`, the source form. */
extend<Value: Show> RangeFrom<Value> with Show {
  fn show(): String {
    "{start.show()}.."
  }
}

/** `..10`, `..=10`, the source form. */
extend<Value: Show> RangeTo<Value> with Show {
  fn show(): String {
    const dots = if inclusive { "..=" } else { ".." }
    "{dots}{end.show()}"
  }
}
