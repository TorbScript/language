/**
 * [Range], the two ends of `0..10`, `0..=10`, `0..` and `..10`, and what it takes to walk one: [RangeIterator] for a
 * range of integers, which is the one kind of range that is also a sequence.
 */

use Equals, Compare, Hash from "./compare"
use Show from "./convert"
use Iterator, Iterable, Length from "std/iteration"

/**
 * `0..10`, `0..=10`, `0..`, `..10`. A range is an ordinary value with two ends; what it means is up to whoever
 * takes one. `Range<Int>` is what `Slice` and `MutableSlice` take (`text[3..]`, `samples[0..100]`), and a range of
 * integers is what `for index in 0..list.length()` counts through.
 *
 * Both ends are optional, because a range may be open on either side. What an open end means is decided by the
 * receiver: for a slice it is the start or the end of the value, for `for` it is a source without an end.
 *
 * # Examples
 *
 *     const bounded = 0..10
 *     print bounded.contains(5)
 *     const inclusive = 0..=10
 *     print inclusive.contains(10)
 *
 * # Related
 *
 * - [RangeIterator] - what `for x in 0..10` pulls through.
 */
public native type Range<Value> with Equals, Hash {
  /** `None` for a range that is open at the start: `..10` */
  start: Value?
  /** `None` for a range that is open at the end: `0..` */
  end: Value?
  /** `0..=10` contains its end, `0..10` does not. An adjective, because it is data and not a question. */
  inclusive: Bool = false

  /** Whether the value lies within the range's bounds. An open end never excludes anything on its side. */
  fn contains(self, value: Value): Bool where Value: Compare {
    if const Some(lowest) = start {
      if value < lowest {
        return false
      }
    }
    if const Some(highest) = end {
      return if inclusive { value <= highest } else { value < highest }
    }
    true
  }
}

/**
 * A range of integers is a sequence. Other ranges are bounds and nothing more: `'a'..'z'` says what is inside of it,
 * but there is no "the next value after `a`" in general.
 *
 * "Has a start" and "has both ends" are properties of a field, not of the type, so the open cases are checked where
 * they are used and not by the checker (a compile-time version would need dependent types).
 */
extend Range<Int> with Iterable<Int>, Length {
  /** Panics for a range without a start: `..10` has no first value. `0..` iterates forever. */
  fn iterator(self): Iterator<Int> {
    RangeIterator start.expect("a range without a start has no first value"), end, inclusive
  }

  /** Panics for a range without both ends: `0..` has no length. */
  fn length(self): Int {
    const lowest = start.expect "a range without both ends has no length"
    const highest = end.expect "a range without both ends has no length"
    const span = if inclusive { highest - lowest + 1 } else { highest - lowest }
    span.max 0
  }
}

/**
 * The cursor over a range of integers: the next value, and where to stop. **TorbScript and not a runtime function**,
 * because it needs nothing the language does not have - which is the rule of `compiler/CONTRIBUTING.md`, "natives stay
 * few". A range without an end never stops, which is what `0..` means.
 */
public type RangeIterator with Iterator<Int> {
  /** The next value to hand out, one past the last one that was. */
  var current: Int
  /** `None` for a range without an end, which is what makes `0..` iterate forever. */
  end: Int?
  /** Whether `end` itself is still inside the range. */
  inclusive: Bool

  /** The next value, or `None` once `current` has passed `end`. */
  fn next(var self): Int? {
    if const Some(highest) = end {
      const isDone = if inclusive { current > highest } else { current >= highest }
      if isDone {
        return None
      }
    }
    const value = current
    current = current + 1
    Some value
  }
}

/**
 * The source form, and not the fields: `0..10`, `0..=10`, `..10`, `0..`. A `Show` of its own rather than the derived one
 * because a reader writes a range that way, and because the interpreter has printed it that way all along - the two have
 * to agree to the character (design principle 5).
 *
 * It is **conditional** on `Value: Show`, which is why it cannot be a member of the `native type` itself: a range of
 * something unshowable is still a range.
 */
extend<Value: Show> Range<Value> with Show {
  fn show(self): String {
    const first = match start {
      Some(value) => value.show()
      None => ""
    }
    const last = match end {
      Some(value) => value.show()
      None => ""
    }
    const dots = if inclusive { "..=" } else { ".." }
    "{first}{dots}{last}"
  }
}
