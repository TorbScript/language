/**
 * Control structures that are ordinary functions.
 * Only constructs that bind names (`const`, `fn`, `type`, ...) or jump (`if`, `match`, `for`, `while`) are built in.
 */

/** Evaluates a block immediately: `const x = do { ... }` */
public fn do<Value>(body: () => Value): Value {
  body()
}

public fn unless(condition: Bool, body: () => Void) {
  if !condition {
    body()
  }
}

/** `const response = retry 3 { http.get(url) }` */
public fn retry<Value, Failure>(times: Int, action: () => Result<Value, Failure>): Result<Value, Failure> {
  const result = action()
  if result.isOk() || times <= 1 {
    return result
  }
  retry(times - 1, action)
}

/**
 * Resources have an identity, so they are `shared type`s: `shared type File with Close { ... }`.
 * A `shared type` can only implement a `shared trait`, which keeps every other trait-typed value a value.
 */
public shared trait Close {
  fn close(var self)
}

/**
 * Closes the resource when the block is done.
 *
 *     const text = using File.open(path)? { file => file.readAll() }
 */
public fn using<Resource: Close, Value>(var resource: Resource, body: (var Resource) => Value): Value {
  const result = body(resource)
  resource.close()
  result
}
