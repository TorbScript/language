use Show, From from "./convert"
use Iterable from "std/iteration"

/**
 * The result of an operation that can fail.
 *
 * The postfix `?` operator unwraps `Ok` or returns the `Fail` from the surrounding function.
 * If the error types differ, the error is converted with `From`.
 *
 * `map`, `flatMap`, `forEach` mean the same as everywhere else (see "One Vocabulary" in CONCEPT.md) and work
 * on the `Ok` side. A Result is a value, not a pipeline: they run immediately.
 */
public type Result<Value, Failure> {
  case Ok(value: Value)
  case Fail(error: Failure)

  fn isOk(self): Bool {
    match self {
      Ok(_) => true
      Fail(_) => false
    }
  }

  fn isError(self): Bool {
    !isOk()
  }

  fn map<Output>(self, transform: (value: Value) => Output): Result<Output, Failure> {
    match self {
      Ok(value) => .Ok(transform(value))
      Fail(error) => .Fail(error)
    }
  }

  fn mapError<OtherFailure>(self, transform: (error: Failure) => OtherFailure): Result<Value, OtherFailure> {
    match self {
      Ok(value) => .Ok(value)
      Fail(error) => .Fail(transform(error))
    }
  }

  fn flatMap<Output>(self, transform: (value: Value) => Result<Output, Failure>): Result<Output, Failure> {
    match self {
      Ok(value) => transform(value)
      Fail(error) => .Fail(error)
    }
  }

  fn forEach(self, action: (value: Value) => Void) {
    if const Ok(value) = self {
      action(value)
    }
  }

  fn toList(self): List<Value> {
    ok().toList()
  }

  fn ok(self): Value? {
    match self {
      Ok(value) => Some(value)
      Fail(_) => None
    }
  }

  fn orElse(self, fallback: lazy Value): Value {
    match self {
      Ok(value) => value
      Fail(_) => fallback
    }
  }

  fn expect(self, message: String): Value where Failure: Show {
    match self {
      Ok(value) => value
      Fail(error) => panic "{message}: {error}"
    }
  }
}

/** `Ok(value)` or `Fail(failure)`. */
extend<Value: Show, Failure: Show> Result<Value, Failure> with Show {
  fn show(self): String {
    match self {
      Ok(value) => "Ok({value.showNested()})"
      Fail(error) => "Fail({error.showNested()})"
    }
  }
}

/**
 * All or the first error: `lines.map(Int.parse).to<Result<List<Int>, NumberParseError>>()`
 * Stops pulling at the first `Fail`. This is what `traverse`/`sequence` is in languages with higher-kinded types.
 */
extend<Value, Failure, Target: From<Iterable<Value>>> Result<Target, Failure> with From<Iterable<Result<Value, Failure>>> {
  fn from(value: Iterable<Result<Value, Failure>>): Result<Target, Failure> {
    var failure: Failure? = None
    const target = Target.from(value.mapWhile { item =>
      match item {                       // The pipeline is lazy: this runs while `Target.from` pulls
        Ok(success) => Some(success)
        Fail(error) => {
          failure = Some(error)
          None
        }
      }
    })
    match failure {
      Some(error) => Fail(error)
      .None => Ok(target)
    }
  }
}
