/**
 * JSON as a format: an implementation of the prelude's `Encoder`/`Decoder` (see "Types, Values and Reflection" in
 * CONCEPT.md), plus `JsonValue` for the rare case of a document whose shape is not known ahead of time.
 *
 *     const text = Json.encode(user)
 *     const user = Json.decode<User>(text)?
 *
 * `Json` is also a `Format<JsonError>` (`std/encoding`), which is what makes it work on a stream: `Json.items<User>()`
 * is a `Stage` that turns byte chunks into `User`s one at a time, over a top-level array as well as over concatenated
 * or newline-separated values.
 */

use Stage, Accumulator, mapping from "std/iteration"
use Bytes, Utf8Error, textOf from "std/stream"

/**
 * A JSON document without a fixed shape. `Encoder`/`Decoder` are driven by the type that is being read or written,
 * so they cannot express "whatever is there" - this ADT is the library type for that (config previews, diffing,
 * passthrough of fields nobody has a type for yet).
 */
public type JsonValue {
  case Null
  case Bool(value: Bool)
  /** JSON does not distinguish integers from floating point, so every number is a `Float64`. */
  case Number(value: Float64)
  case String(value: String)
  case Array(items: List<JsonValue>)
  case Object(entries: Map<String, JsonValue>)
}

/** A `JsonValue` describes itself to any `Encoder`, not only `Json`'s own. */
extend JsonValue with Encode {
  fn encode(var encoder: Encoder) {
    match self {
      .Null => encoder.nothing()
      .Bool(value) => encoder.bool value
      .Number(value) => encoder.float value
      .String(value) => encoder.string value
      .Array(items) => encoder.sequence Some(items.length()) { sequence =>
        for item in items {
          sequence.item item
        }
      }
      .Object(entries) => encoder.map Some(entries.length()) { map =>
        for (key, value) in entries {
          map.entry key, value
        }
      }
    }
  }
}

/**
 * What went wrong turning text into a value and back: malformed JSON text, or JSON that parsed fine but does not
 * fit the requested type.
 */
public type JsonError with Show, Error {
  private kind: JsonErrorKind

  /** The text was not well-formed JSON. */
  static fn syntax(line: Int, message: String): JsonError {
    Self kind: .Syntax(line, message)
  }

  /** The text was well-formed JSON, but `Decode` rejected it. */
  static fn decodeFailed(cause: DecodeError): JsonError {
    Self kind: .Decode(cause)
  }

  /** JSON is text, and the bytes that arrived are not UTF-8 - so there was no text to parse in the first place. */
  static fn invalidText(cause: Utf8Error): JsonError {
    Self kind: .Text(cause)
  }

  /** `true` for malformed JSON text, as opposed to well-formed JSON that did not fit the target type. */
  fn isSyntaxError(): Bool {
    match kind {
      .Syntax(_, _) => true
      _ => false
    }
  }

  fn show(): String {
    match kind {
      .Syntax(line, message) => "line {line}: {message}"
      .Decode(cause) => "{cause}"
      .Text(cause) => "{cause}"
    }
  }

  /** The `DecodeError` a rejected document failed on, so a report can unwind the chain down to the field. */
  fn cause(): Error? {
    match kind {
      .Syntax(_, _) => None
      .Decode(problem) => Some problem
      .Text(problem) => Some problem
    }
  }
}

/** What `checked()` needs to lift a broken byte sequence into the failure of a JSON stream. */
extend JsonError with From<Utf8Error> {
  static fn from(value: Utf8Error): JsonError {
    JsonError.invalidText value
  }
}

type JsonErrorKind {
  case Syntax(line: Int, message: String)
  case Decode(cause: DecodeError)
  case Text(cause: Utf8Error)
}

/** JSON reading and writing. A format is an implementation of `Encoder`/`Decoder` and never sees a type. */
public native type Json {
  /** Renders any `Encode` value as JSON text. */
  native static fn encode(value: Encode): String

  /**
   * Parses `text` and decodes it as `Value`. Fails on malformed JSON as well as on JSON that does not fit `Value`.
   *
   *     match Json.decode<User>(text) {
   *       Ok(user) => print user.name
   *       Fail(error) => print "Rejected: {error}"
   *     }
   */
  native static fn decode<Value: Decode>(text: String): Result<Value, JsonError>

  /** Parses `text` into a `JsonValue`, without knowing its shape. */
  native static fn parse(text: String): Result<JsonValue, JsonError>

  /** Any `Encode` value as a `JsonValue` tree, e.g. to diff two versions of it structurally. */
  native static fn value<Value: Encode>(value: Value): JsonValue
}

// --- JSON as a `Format`: the streaming side -------------------------------------------------------------------------

/**
 * Everything a stream needs, written in TorbScript on top of the natives above: a framer that finds where one element
 * ends, and the ordinary `Decode` for the element itself. Nothing here is native - tracking depth, strings and escapes
 * is ordinary code, and a native would have to be rebuilt by every back end (CONTRIBUTING, "Natives stay few").
 */
extend Json with Format<JsonError> {
  static fn encodeAll(value: Encode): Bytes {
    Json.encode(value).bytes().toList()
  }

  static fn decodeAll<Value: Decode>(bytes: Bytes): Result<Value, JsonError> {
    const text = textOf(bytes).mapError(JsonError.invalidText)?
    Json.decode<Value>(text)
  }

  /**
   * Byte chunks to items. The first byte that is not whitespace decides what the stream is: a `[` opens **one
   * top-level array** and its elements are the items; anything else makes it a sequence of values written one after
   * another, which covers newline-separated JSON (NDJSON) without a rule of its own.
   *
   * Memory is one element - what has arrived of the one being read, and nothing else.
   */
  static fn items<Item: Decode>(): Stage<Bytes, Result<Item, JsonError>> {
    JsonItems<Item>()
  }

  /**
   * Items to bytes, one value per line (NDJSON). Not an array: a stream has no end at which a closing bracket could be
   * written, and a reader would have to hold the whole thing to find one.
   */
  static fn encoded<Item: Encode>(): Stage<Item, Bytes> {
    mapping { "{Json.encode(_)}\n".bytes().toList() }
  }
}

type JsonItems<Item: Decode> with Stage<Bytes, Result<Item, JsonError>> {
  fn onto<Final>(
    downstream: Accumulator<Result<Item, JsonError>, Final>,
  ): Accumulator<Bytes, Final> {
    JsonFramer downstream
  }
}

/**
 * The framer: one pass over the bytes as they arrive, with exactly the state a JSON scanner needs - how deep the
 * brackets go, whether we are inside a string, and whether the last byte was a backslash. An element is complete when
 * the depth comes back to zero, and for a number, `true`, `false` or `null` at the first byte that cannot belong to it
 * any anymore.
 */
type JsonFramer<Item: Decode, Final> with Accumulator<Bytes, Final> {
  var downstream: Accumulator<Result<Item, JsonError>, Final>
  /** The bytes of the element that is being read; empty between two elements. */
  var element: Bytes = []
  var started: Bool = false
  var depth: Int = 0
  var inString: Bool = false
  var escaped: Bool = false
  /** Whether the first `[` of the stream was taken as the opening bracket of a top-level array. */
  var opened: Bool = false
  var atStart: Bool = true

  var fn add(value: Bytes) {
    for byte in value {
      if downstream.isDone() {
        return
      }
      step byte
    }
  }

  /** What is left at the end is one last element without a separator behind it: NDJSON without a final newline. */
  fn finish(): Final {
    var tail = self
    if tail.started && tail.depth == 0 {
      tail.emit()
    }
    var below = tail.downstream
    below.finish()
  }

  fn isDone(): Bool {
    downstream.isDone()
  }

  private var fn step(byte: UInt8) {
    if !started {
      begin byte
      return
    }
    element.append byte
    if inString {
      stepInString byte
      return
    }
    if byte == quoteByte {
      inString = true
      return
    }
    if byte == openBracket || byte == openBrace {
      depth = depth + 1
      return
    }
    if byte == closeBracket || byte == closeBrace {
      depth = depth - 1
      if depth <= 0 {
        emit()
      }
      return
    }
    // A number, `true`, `false` or `null` has no closing byte of its own: it ends where something else begins, and
    // that byte still has to be read as a separator
    if depth == 0 && isSeparator(byte) {
      const scalar = element[0..(element.length() - 1)]
      element = scalar
      emit()
      begin byte
    }
  }

  private var fn stepInString(byte: UInt8) {
    if escaped {
      escaped = false
      return
    }
    if byte == backslashByte {
      escaped = true
      return
    }
    if byte == quoteByte {
      inString = false
      if depth == 0 {
        emit()
      }
    }
  }

  /** Between elements: whitespace and commas are nothing, and the very first `[` of the stream is the array itself. */
  private var fn begin(byte: UInt8) {
    if isWhitespaceByte(byte) || byte == commaByte {
      return
    }
    if byte == closeBracket && opened {
      opened = false
      atStart = false
      return
    }
    if byte == openBracket && atStart && !opened {
      opened = true
      atStart = false
      return
    }
    atStart = false
    started = true
    element = [byte]
    depth = 0
    inString = false
    escaped = false
    if byte == quoteByte {
      inString = true
      return
    }
    if byte == openBracket || byte == openBrace {
      depth = 1
    }
  }

  private var fn emit() {
    const text = textOf(element).mapError(JsonError.invalidText)
    const decoded = text.flatMap { Json.decode<Item>(_) }
    element = []
    started = false
    depth = 0
    inString = false
    escaped = false
    downstream.add decoded
  }
}

fn isSeparator(byte: UInt8): Bool {
  isWhitespaceByte(byte) || byte == commaByte || byte == closeBracket || byte == closeBrace
}

fn isWhitespaceByte(byte: UInt8): Bool {
  byte == spaceByte || byte == tabByte || byte == newlineByte || byte == returnByte
}

const tabByte: UInt8 = 9
const newlineByte: UInt8 = 10
const returnByte: UInt8 = 13
const spaceByte: UInt8 = 32
const quoteByte: UInt8 = 34
const commaByte: UInt8 = 44
const openBracket: UInt8 = 91
const backslashByte: UInt8 = 92
const closeBracket: UInt8 = 93
const openBrace: UInt8 = 123
const closeBrace: UInt8 = 125
