/**
 * Every numeric type of the language: [Numeric], [Signed], [Bits] and [Real], the traits their operators go through;
 * the sized integer types and the two floating-point types; [Decimal]; and the conversions between all of them.
 *
 * Reach for `Int`, `UInt` or `Float` - the three default-width aliases - and only name a sized type (`Int8`,
 * `UInt32`, ...) where a signature has to say exactly how wide a value is.
 */

use Equals, Compare, Hash from "std/core"
use From, TryFrom, Show from "std/core"
use Error from "std/core"
use Add, Subtract, Multiply, Divide, Remainder, Power, Negate from "std/core"

/**
 * The arithmetic and comparison every number has: `+`, `-`, `*`, `/`, `%`, `==`, `<`, reading one from text, and its
 * zero and its one.
 *
 * Text is a source like any other, so `Int.tryFrom("42")` is the conversion and there is no `parse` beside it.
 *
 * # Examples
 *
 *     fn total<Scalar: Numeric>(values: List<Scalar>): Scalar {
 *       var sum = Scalar.zero
 *       for value in values {
 *         sum = sum + value
 *       }
 *       sum
 *     }
 *
 *     print total([1, 2, 3])
 *     print total([0.5, 0.25])
 */
public trait Numeric
  with Add, Subtract, Multiply, Divide, Remainder, Equals, Compare, Show, TryFrom<String, NumberParseError>
{
  /**
   * Zero of this type: what a sum starts from, and what a generic body compares against. `Scalar.zero` reads it
   * through a type parameter, `Int.zero` and `Float.zero` through the type.
   */
  static zero: Self

  /** One of this type: what a product starts from, and the unit of an identity matrix or a homogeneous coordinate. */
  static one: Self
}

/** [Numeric] plus a sign: the unary `-` and [Signed.absolute]. What every signed number has beyond an unsigned one. */
public trait Signed
  with Numeric, Negate {
  /** The value without its sign. */
  fn absolute(): Self
}

/**
 * [Signed] plus the operations that need a root or an angle: the scalar of geometry, trigonometry and interpolation.
 *
 * It is the bound that separates what a vector can do with whole numbers from what it needs a continuous scalar for.
 * `lengthSquared` and `dot` are arithmetic and live under [Numeric]; `length`, `normalized`, `rotated` and every angle
 * need a `Real`. A library that is generic over the scalar therefore says which half it is in by its bound alone, and a
 * grid vector never accidentally gets a square root.
 *
 * Two types carry it. `Float64` is the fast one and answers whatever the platform's mathematics library answers.
 * `Fixed` (`std/linear`) is the deterministic one: every operation is integer arithmetic, so it answers the same bits on
 * every platform and out of every back end, which is what lockstep simulation and a replay need.
 *
 * Angles are in radians throughout, and `std/linear`'s `Angle` is the wrapper that keeps degrees from being passed as
 * radians.
 *
 * # Examples
 *
 *     fn hypotenuse<Scalar: Real>(first: Scalar, second: Scalar): Scalar {
 *       (first * first + second * second).squareRoot()
 *     }
 *
 *     print hypotenuse(3.0, 4.0)
 *
 * # Pitfalls
 *
 * - The results are **not** bit-identical between implementors, and for `Float64` not even between platforms:
 *   `sine` is whatever the platform's mathematics library computes. Where the last bit has to agree - a lockstep
 *   simulation, a replay, a checksum over a world state - the scalar is `Fixed` and not `Float`.
 *
 * # Open
 *
 * - `Float32` cannot carry it yet. `Float32` has no arithmetic that a compiled program runs - every one of its
 *   operators is a planned row of the manifest of natives - and there is no conversion from a `Float64` back down to
 *   one, so no body could be run for it. `<math.h>` has the `float` functions (`sinf`, `powf`, ...), so once its
 *   arithmetic exists, `Real` is one `extend` over them.
 *
 * # Related
 *
 * - [Signed] - what a `Real` is on top of.
 * - [Numeric] - the bound the arithmetic half of a vector library lives under.
 */
public trait Real with Signed, Power, Power<Int64> {
  /**
   * Half a turn in radians - the ratio of a circle's circumference to its diameter - in this scalar's type:
   * `Scalar.pi` in a body that is generic over it, whose literals could not write the digits.
   */
  static pi: Self

  /** A whole turn in radians, twice [Real.pi], rounded once in this scalar's type rather than doubled. */
  static tau: Self

  /** The base of the natural logarithm, in this scalar's type: `Scalar.e`, named like [Real.pi]. */
  static e: Self

  /**
   * The gap between one and the next value this scalar can hold: the resolution a tolerance cannot go below. It is
   * the machine epsilon of a float and the one part of a fixed-point number.
   */
  static epsilon: Self

  /** The non-negative square root. Negative input answers a value the implementor documents. */
  fn squareRoot(): Self

  /** The sine of an angle in radians. */
  fn sine(): Self

  /** The cosine of an angle in radians. */
  fn cosine(): Self

  /** The tangent of an angle in radians. */
  fn tangent(): Self

  /** The angle in radians whose sine is this value, in `[-pi/2, pi/2]`. */
  fn arcSine(): Self

  /** The angle in radians whose cosine is this value, in `[0, pi]`. */
  fn arcCosine(): Self

  /** The angle in radians whose tangent is this value, in `(-pi/2, pi/2)`. */
  fn arcTangent(): Self

  /**
   * The angle in radians of the point `(by, self)`, in `(-pi, pi]`: the arc tangent of `self / by` that uses the sign
   * of both to pick the quadrant. This is what turns a vector into a direction, and it is why it takes a label -
   * `y.arcTangentDivided(by: x)` says which of the two is which, where a bare pair of arguments does not.
   */
  fn arcTangentDivided(by: Self): Self

  /** [Real.e] raised to this value: `Scalar.e ** value`, without a logarithm of `e` in between. */
  fn exponential(): Self

  /** The logarithm to the base [Real.e]. Zero and a negative value answer what the implementor documents. */
  fn naturalLogarithm(): Self

  /**
   * The logarithm to another base: `(8.0).logarithm(base: 2.0)` is `3.0`. It is the natural logarithm of the value
   * over the one of the base, so an implementor that has a faster way overrides it.
   */
  fn logarithm(base: Self): Self {
    naturalLogarithm() / base.naturalLogarithm()
  }

  /** Rounded towards negative infinity. */
  fn floor(): Self

  /** Rounded towards positive infinity. */
  fn ceiling(): Self

  /** Rounded to the nearest whole value, halves away from zero. */
  fn round(): Self

  /**
   * Half the value. It is a member and not `value / 2` at the call, because a body that is generic over the scalar
   * cannot write the literal `2` at all: a literal has a type, and inside such a body that type is the parameter.
   * Halving is what a midpoint, a radius and an average are made of, so the trait carries it.
   */
  fn halved(): Self

  /** Twice the value. */
  fn doubled(): Self {
    self + self
  }

  /**
   * The angle in radians that this many degrees is.
   *
   * Degrees are a member of the scalar and not a function of `std/linear`, because the conversion needs the value of
   * pi in *this* scalar's type - and a body that is generic over the scalar can write neither pi nor `180`. Each
   * implementor carries its own exact factor.
   */
  fn radiansOfDegrees(): Self

  /** The angle in degrees that this many radians is. */
  fn degreesOfRadians(): Self
}

/**
 * The bit operations of an integer, and the operators that are them: `a & b` is `bitwiseAnd`, `a | b` `bitwiseOr`,
 * `a ^ b` `bitwiseExclusiveOr`, `~a` `bitwiseNot`, `a << n` `shiftedLeft(by:)` and `a >> n` `shiftedRight(by:)`.
 *
 *     const value = 0x1234
 *     const low = value & 0xFF
 *     const mixed = (value ^ low) << 5
 *     print "{low} {mixed}"
 *
 * The operators sit where Go and Swift put them, so there is no C trap: `&` binds like `*`, `|` and `^` like `+`, a
 * shift between `*` and `**` - and `flags & 1 == 0` is `(flags & 1) == 0`.
 *
 * The shift of a signed type is arithmetic (it keeps the sign), the shift of an unsigned type is logical, and the bits
 * that leave the width are dropped. A shift by a negative amount or by the width of the type or more panics, like every
 * other operation that leaves its range.
 */
public trait Bits {
  /** Bit-for-bit `and`. This is `&`. */
  fn bitwiseAnd(other: Self): Self
  /** Bit-for-bit `or`. This is `|`. */
  fn bitwiseOr(other: Self): Self
  /** Bit-for-bit exclusive or. This is `^`. */
  fn bitwiseExclusiveOr(other: Self): Self
  /** Every bit flipped. This is the prefix `~`. */
  fn bitwiseNot(): Self
  /** Shifted towards the high bits. This is `<<`. */
  fn shiftedLeft(by: Int64): Self
  /** Shifted towards the low bits: arithmetic for a signed type, logical for an unsigned one. This is `>>`. */
  fn shiftedRight(by: Int64): Self
}

/** What `Int.tryFrom(text)` fails with: the text is not a valid number. */
public type NumberParseError with Error {
  /**
   * The text that does not describe a number. Every conversion that fails with it names its parameter `text`, which is
   * what lets a back end build the failure without knowing anything about this type (docs/BACKEND.md, "the parameter of
   * the same name").
   */
  text: String
}

/** What a narrowing conversion (`Int8.tryFrom`, `Int64.tryFrom`) fails with: the value does not fit the target type. */
public type NumberRangeError with Error {
  /** What went out of range. */
  message: String
}

// `native` types are represented by the runtime.
// The methods of the traits listed after `with` are provided by the runtime, too.

// The types always carry their width. This file uses the sized names only, because here the width is the point.

/** An 8-bit signed integer, from [Int8.minimum] to [Int8.maximum]. */
public native type Int8 with Signed, Hash, Bits, Power<Int64> {}
/** A 16-bit signed integer, from [Int16.minimum] to [Int16.maximum]. */
public native type Int16 with Signed, Hash, Bits, Power<Int64> {}
/** A 32-bit signed integer, from [Int32.minimum] to [Int32.maximum]. */
public native type Int32 with Signed, Hash, Bits, Power<Int64> {}
/** A 64-bit signed integer, and the type of an integer literal. */
public native type Int64 with Signed, Hash, Bits, Power<Int64> {}

/** An 8-bit unsigned integer, from `0` to [UInt8.maximum]. */
public native type UInt8 with Numeric, Hash, Bits, Power<Int64> {}
/** A 16-bit unsigned integer, from `0` to [UInt16.maximum]. */
public native type UInt16 with Numeric, Hash, Bits, Power<Int64> {}
/** A 32-bit unsigned integer, from `0` to [UInt32.maximum]. */
public native type UInt32 with Numeric, Hash, Bits, Power<Int64> {}
/** A 64-bit unsigned integer, from `0` to [UInt64.maximum]. */
public native type UInt64 with Numeric, Hash, Bits, Power<Int64> {}

/** The range of an `Int8`, and its zero and one. */
extend Int8 {
  /** Zero, the [Numeric.zero] of an `Int8`. */
  static zero: Int8 = 0
  /** One, the [Numeric.one] of an `Int8`. */
  static one: Int8 = 1
  /** The smallest `Int8`. */
  static minimum: Int8 = -128
  /** The largest `Int8`. */
  static maximum: Int8 = 127
}

/** The range of an `Int16`, and its zero and one. */
extend Int16 {
  /** Zero, the [Numeric.zero] of an `Int16`. */
  static zero: Int16 = 0
  /** One, the [Numeric.one] of an `Int16`. */
  static one: Int16 = 1
  /** The smallest `Int16`. */
  static minimum: Int16 = -32768
  /** The largest `Int16`. */
  static maximum: Int16 = 32767
}

/** The range of an `Int32`, and its zero and one. */
extend Int32 {
  /** Zero, the [Numeric.zero] of an `Int32`. */
  static zero: Int32 = 0
  /** One, the [Numeric.one] of an `Int32`. */
  static one: Int32 = 1
  /** The smallest `Int32`. */
  static minimum: Int32 = -2147483648
  /** The largest `Int32`. */
  static maximum: Int32 = 2147483647
}

/** The range of a `UInt8`, and its zero and one. */
extend UInt8 {
  /** Zero, the [Numeric.zero] of a `UInt8`. */
  static zero: UInt8 = 0
  /** One, the [Numeric.one] of a `UInt8`. */
  static one: UInt8 = 1
  /** Always `0`. */
  static minimum: UInt8 = 0
  /** The largest `UInt8`. */
  static maximum: UInt8 = 255
}

/** The range of a `UInt16`, and its zero and one. */
extend UInt16 {
  /** Zero, the [Numeric.zero] of a `UInt16`. */
  static zero: UInt16 = 0
  /** One, the [Numeric.one] of a `UInt16`. */
  static one: UInt16 = 1
  /** Always `0`. */
  static minimum: UInt16 = 0
  /** The largest `UInt16`. */
  static maximum: UInt16 = 65535
}

/** The range of a `UInt32`, and its zero and one. */
extend UInt32 {
  /** Zero, the [Numeric.zero] of a `UInt32`. */
  static zero: UInt32 = 0
  /** One, the [Numeric.one] of a `UInt32`. */
  static one: UInt32 = 1
  /** Always `0`. */
  static minimum: UInt32 = 0
  /** The largest `UInt32`. */
  static maximum: UInt32 = 4294967295
}

/** A 32-bit floating-point number. */
public native type Float32 with Signed {}

/** The zero and the one of a `Float32`, its two infinities, and the one value for which `==` is never true. */
extend Float32 {
  /** Zero, the [Numeric.zero] of an `Float32`. */
  static zero: Float32 = 0.0
  /** One, the [Numeric.one] of an `Float32`. */
  static one: Float32 = 1.0
  /** "Not a number" - the one value for which `==` is never true, not even with itself. See [Float64.nan]. */
  static nan: Float32 = 0.0 / 0.0
  /** Larger than every finite `Float32`. [Float32.negativeInfinity] is smaller than every finite one. */
  static infinity: Float32 = 1.0 / 0.0
  /** Smaller than every finite `Float32`, the one value below every finite one. */
  static negativeInfinity: Float32 = -1.0 / 0.0

  /** Whether the value is [Float32.infinity] or [Float32.negativeInfinity]. */
  fn isInfinite(): Bool {
    self == Float32.infinity || self == Float32.negativeInfinity
  }

  /** Whether the value is neither `nan` nor infinite. */
  fn isFinite(): Bool {
    self == self && !isInfinite()
  }
}
/** A 64-bit floating-point number, and the type of a decimal literal. */
public native type Float64 with Signed {}

/**
 * Exact base-10 arithmetic. Decimal literals adapt to it: `const price: Decimal = 19.99`
 *
 * # Open
 *
 * The type checks today, but no back end gives it a value: there is no diagnostic for using it, only the absence of
 * anything that runs it.
 */
public native type Decimal with Signed, Hash {}

/** The zero and the one of a `Decimal`. */
extend Decimal {
  /** Zero, the [Numeric.zero] of an `Decimal`. */
  static zero: Decimal = 0.0
  /** One, the [Numeric.one] of an `Decimal`. */
  static one: Decimal = 1.0
}

// The defaults. Plain aliases, nothing the language treats specially.
/** The default width for a whole number: `Int64`. */
public type Int = Int64
/** The default width for a non-negative whole number: `UInt64`. */
public type UInt = UInt64
/** The default width for a floating-point number: `Float64`. */
public type Float = Float64

/** The range of an `Int64`, its zero and one, and reading digits in another base. */
extend Int64 {
  /** Zero, the [Numeric.zero] of an `Int64`. */
  static zero: Int64 = 0
  /** One, the [Numeric.one] of an `Int64`. */
  static one: Int64 = 1
  /**
   * The smallest `Int64` cannot be written as a positive literal negated (`9223372036854775808` alone does not fit
   * any integer type), so it is spelled the way C spells `INT64_MIN`: one more than the smallest literal there is.
   */
  static minimum: Int64 = -9223372036854775807 - 1
  /** The largest `Int64`. */
  static maximum: Int64 = 9223372036854775807

  /** Digits in another base: `Int.parseDigits("ff", radix: 16)`. No sign, no prefix, `_` is allowed between digits. */
  native static fn parseDigits(text: String, radix: Int64): Result<Int64, NumberParseError>
}

/** The range of a `UInt64`, its zero and one, and the two operations that wrap instead of panicking. */
extend UInt64 {
  /** Zero, the [Numeric.zero] of a `UInt64`. */
  static zero: UInt64 = 0
  /** One, the [Numeric.one] of a `UInt64`. */
  static one: UInt64 = 1
  /** Always `0`. */
  static minimum: UInt64 = 0
  /** Every integer literal is parsed as an `Int64` first, so `18446744073709551615` does not fit as a literal here
   * either - `~UInt64.minimum` is all ones, which is the largest `UInt64` there is. */
  static maximum: UInt64 = ~UInt64.minimum

  /**
   * Addition that wraps around instead of panicking. Together with [UInt64.multipliedWrapping] this is the only
   * arithmetic in the language that does not panic on overflow, and it exists for one reason: a hash function mixes
   * bits and needs the wrap. Everywhere else, overflow is a bug and `+` says so.
   *
   *     var hash: UInt64 = 14695981039346656037
   *     hash = (hash ^ value).multipliedWrapping(1099511628211)
   */
  native fn addedWrapping(other: UInt64): UInt64

  /** Multiplication that wraps around instead of panicking. See [UInt64.addedWrapping]. */
  native fn multipliedWrapping(other: UInt64): UInt64
}

/** The constants and the operations of a `Float64` that read as its own, not as a function of a value. */
extend Float64 {
  /** Zero, the [Numeric.zero] of an `Float64`. */
  static zero: Float64 = 0.0
  /** One, the [Numeric.one] of an `Float64`. */
  static one: Float64 = 1.0
  /** The ratio of a circle's circumference to its diameter: the [Real.pi] of a `Float64`. */
  static pi: Float64 = 3.141592653589793
  /** A whole turn in radians, twice [Float64.pi]: the [Real.tau] of a `Float64`. */
  static tau: Float64 = 6.283185307179586
  /** The gap between `1.0` and the next `Float64`, which is two to the power of minus 52: its [Real.epsilon]. */
  static epsilon: Float64 = 0.0000000000000002220446049250313
  /** The base of the natural logarithm. */
  static e: Float64 = 2.718281828459045
  /**
   * "Not a number" - the one value for which `==` is never true, not even with itself ([Float64.isNaN]). Named the way
   * [Real.pi] is: the compile-time constant evaluator (`ir/constant.trb`) only allows this one declaration and
   * [Float32.nan] to fold to it, because an ordinary expression that produces `nan` is a mistake and stays an error
   * (`docs/language/modules-and-packages/top-level-code.md`, rule 6).
   */
  static nan: Float64 = 0.0 / 0.0
  /** Larger than every finite `Float64`. [Float64.negativeInfinity] is smaller than every finite one. */
  static infinity: Float64 = 1.0 / 0.0
  /** Smaller than every finite `Float64`, the one value below every finite one. */
  static negativeInfinity: Float64 = -1.0 / 0.0

  /** The non-negative square root. */
  native fn squareRoot(): Float64
  /** Rounded towards negative infinity. */
  native fn floor(): Float64
  /** Rounded towards positive infinity. */
  native fn ceiling(): Float64
  /** Rounded to the nearest integer. */
  native fn round(): Float64
  /** Whether the value is "not a number" - the one value for which `==` is never true, not even with itself. */
  native fn isNaN(): Bool
  /** Whether the value is [Float64.infinity] or [Float64.negativeInfinity]. */
  fn isInfinite(): Bool {
    self == Float64.infinity || self == Float64.negativeInfinity
  }
  /** Whether the value is neither `nan` nor infinite. */
  fn isFinite(): Bool {
    !isNaN() && !isInfinite()
  }

  /**
   * Floats are compared with a tolerance: `assert(length.isCloseTo(1.0))`
   *
   * The exact comparisons a float has are deliberately different from each other, because IEEE-754 equality is not an
   * equivalence relation and IEEE-754 ordering is not a total order:
   *
   * - **Every operator is IEEE-754**: `==`, `<`, `<=`, `>` and `>=`. `nan != nan`, every comparison with a `nan` on
   *   either side is `false`, and `0.0 == -0.0`.
   * - `compare` is a **total** order: `nan` is above everything, and `-0.0` compares equal to `0.0`. So `sorted`
   *   terminates whatever pivot it picks, whatever is in the list.
   * - A float is therefore the one type where an operator and the member behind it disagree, which is why everything
   *   that *orders* values calls `compare` and never writes `<=`: an IEEE `<=` would leave a `nan` where it started.
   * - `Float32` and `Float64` are not `Hash`, so a float is never a `Map` key and the `nan` key does not exist.
   */
  fn isCloseTo(other: Float64, tolerance: Float64 = 0.000001): Bool {
    (self - other).absolute() <= tolerance
  }
}

/**
 * `Float64` is the fast [Real]: the square root, the rounding and `isCloseTo` are its own methods already, and the
 * trigonometry, the exponential and the logarithm are the runtime's thin wrappers over `<math.h>`.
 *
 * # Pitfalls
 *
 * - What `sine` answers is what the platform's mathematics library answers, so two machines may differ in the last bit.
 *   `Fixed` (`std/linear`) is the implementor that does not.
 */
extend Float64 with Real {
  /** The sine of an angle in radians. */
  native fn sine(): Float64
  /** The cosine of an angle in radians. */
  native fn cosine(): Float64
  /** The tangent of an angle in radians. */
  native fn tangent(): Float64
  /** In radians, in `[-pi/2, pi/2]`; `nan` outside `[-1, 1]`. */
  native fn arcSine(): Float64
  /** In radians, in `[0, pi]`; `nan` outside `[-1, 1]`. */
  native fn arcCosine(): Float64
  /** In radians, in `(-pi/2, pi/2)`. */
  native fn arcTangent(): Float64
  /** The angle of the point `(by, self)`, which is C's `atan2(self, by)`. */
  native fn arcTangentDivided(by: Float64): Float64
  /** `e` raised to this value. An infinity where it does not fit, and never a panic. */
  native fn exponential(): Float64
  /** The logarithm to the base `e`: `-infinity` at zero, `nan` below it, and never a panic. */
  native fn naturalLogarithm(): Float64

  fn halved(): Float64 {
    self / 2.0
  }

  fn radiansOfDegrees(): Float64 {
    self * 0.017453292519943295
  }

  fn degreesOfRadians(): Float64 {
    self * 57.29577951308232
  }
}

/**
 * `x ** y`: C's `pow`, so IEEE-754 through and through - `(-8.0) ** (1.0 / 3.0)` is `nan`, and nothing panics.
 *
 * It is a declared member and not a runtime row behind the `with` list of `Float64`, because the power by an `Int` below
 * is a member of the same name: the two implementations of `Power` are told apart by their members.
 */
extend Float64 with Power {
  native fn power(exponent: Float64): Float64
}

/**
 * `x ** n` for a whole exponent: `2.0 ** 10` and `10.0 ** -3`. It is `pow` with the exponent as a `Float64` rather
 * than repeated squaring, because `pow` rounds once where squaring rounds at every step, and because squaring towards a
 * negative power overflows to an infinity before it divides.
 *
 * # Pitfalls
 *
 * - An exponent beyond `2 ** 53` in magnitude has no exact `Float64`, and every `Float64` that large is even. The sign
 *   an odd exponent gives a negative base is therefore put back by hand; the magnitude of such a power is an infinity,
 *   a zero or one anyway.
 */
extend Float64 with Power<Int64> {
  fn power(exponent: Int64): Float64 {
    const result = self ** Float64.from(exponent)
    const isInexact = exponent > 9007199254740992 || exponent < -9007199254740992
    if isInexact && exponent % 2 != 0 && self < 0.0 { -result } else { result }
  }
}

// Widening conversions are infallible...
/** A narrower signed integer always fits: `Int.from(byte)` for an `Int8`. */
extend Int64 with From<Int8> {
  native static fn from(value: Int8): Int64
}

/** A narrower signed integer always fits: `Int.from(short)` for an `Int16`. */
extend Int64 with From<Int16> {
  native static fn from(value: Int16): Int64
}

/** A narrower signed integer always fits: `Int.from(word)` for an `Int32`. */
extend Int64 with From<Int32> {
  native static fn from(value: Int32): Int64
}

/** Every unsigned value below the width of an `Int64` fits into it: `Int.from(byte)` for a byte of a `String`. */
extend Int64 with From<UInt8> {
  native static fn from(value: UInt8): Int64
}

/** Every unsigned value below the width of an `Int64` fits into it. */
extend Int64 with From<UInt16> {
  native static fn from(value: UInt16): Int64
}

/** Every unsigned value below the width of an `Int64` fits into it. */
extend Int64 with From<UInt32> {
  native static fn from(value: UInt32): Int64
}

/** Every `Int64` is representable as a `Float64`. */
extend Float64 with From<Int64> {
  native static fn from(value: Int64): Float64
}

/** Every `Float32` widens to `Float64` without loss. */
extend Float64 with From<Float32> {
  native static fn from(value: Float32): Float64
}

/*
 * Reading a number from text, once per type. `Numeric` requires it, so a body that is generic over the number can read
 * one - and every type implements it **directly** rather than leaving it to that requirement, because a type whose only
 * direct `TryFrom` were the narrowing one below would reach that one for both calls (docs/BACKEND.md, "One conversion,
 * one implementation").
 */
/** Fails with a [NumberParseError] when the text is not a whole number, or does not fit an `Int8`. */
extend Int8 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<Int8, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a whole number, or does not fit an `Int16`. */
extend Int16 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<Int16, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a whole number, or does not fit an `Int32`. */
extend Int32 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<Int32, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a whole number, or does not fit an `Int64`. */
extend Int64 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<Int64, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a non-negative whole number, or does not fit a `UInt8`. */
extend UInt8 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<UInt8, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a non-negative whole number, or does not fit a `UInt16`. */
extend UInt16 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<UInt16, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a non-negative whole number, or does not fit a `UInt32`. */
extend UInt32 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<UInt32, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a non-negative whole number, or does not fit a `UInt64`. */
extend UInt64 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<UInt64, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a decimal number. */
extend Float32 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<Float32, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a decimal number. */
extend Float64 with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<Float64, NumberParseError>
}

/** Fails with a [NumberParseError] when the text is not a decimal number. */
extend Decimal with TryFrom<String, NumberParseError> {
  native static fn tryFrom(text: String): Result<Decimal, NumberParseError>
}

// ...narrowing conversions are not.
/** Fails with a [NumberRangeError] when the `Int64` does not fit an `Int8`. */
extend Int8 with TryFrom<Int64, NumberRangeError> {
  native static fn tryFrom(value: Int64): Result<Int8, NumberRangeError>
}

/** Fails with a [NumberRangeError] when the `Int64` does not fit an `Int16`. */
extend Int16 with TryFrom<Int64, NumberRangeError> {
  native static fn tryFrom(value: Int64): Result<Int16, NumberRangeError>
}

/** Fails with a [NumberRangeError] when the `Int64` does not fit an `Int32`. */
extend Int32 with TryFrom<Int64, NumberRangeError> {
  native static fn tryFrom(value: Int64): Result<Int32, NumberRangeError>
}

/**
 * Fails with a [NumberRangeError] when the `Int64` is negative or above 255: the one way from a number to a byte.
 *
 * # Examples
 *
 *     const byte: Result<UInt8, NumberRangeError> = UInt8.tryFrom 200
 *     print byte.isOk()
 */
extend UInt8 with TryFrom<Int64, NumberRangeError> {
  native static fn tryFrom(value: Int64): Result<UInt8, NumberRangeError>
}

/** Fails with a [NumberRangeError] when the `Int64` is negative or does not fit a `UInt16`. */
extend UInt16 with TryFrom<Int64, NumberRangeError> {
  native static fn tryFrom(value: Int64): Result<UInt16, NumberRangeError>
}

/** Fails with a [NumberRangeError] when the `Int64` is negative or does not fit a `UInt32`. */
extend UInt32 with TryFrom<Int64, NumberRangeError> {
  native static fn tryFrom(value: Int64): Result<UInt32, NumberRangeError>
}

/** Fails with a [NumberRangeError] when the `Int64` is negative: every other one fits a `UInt64`. */
extend UInt64 with TryFrom<Int64, NumberRangeError> {
  native static fn tryFrom(value: Int64): Result<UInt64, NumberRangeError>
}

/** Fails with a [NumberRangeError] when the `UInt64` is above the largest `Int64`. */
extend Int64 with TryFrom<UInt64, NumberRangeError> {
  native static fn tryFrom(value: UInt64): Result<Int64, NumberRangeError>
}

/** Fails with a [NumberRangeError] when the `Float64` does not fit an `Int64`, e.g. `nan` or a value out of range. */
extend Int64 with TryFrom<Float64, NumberRangeError> {
  native static fn tryFrom(value: Float64): Result<Int64, NumberRangeError>
}

/**
 * The code point: `Int.from('A')` is 65. It is here and not with `Char`, because an implementation belongs to the
 * package of the type or to the package of the trait, and `Int64` is this package's. The other direction
 * (`Char.tryFrom(65)`) is `std/text`'s for the same reason.
 */
extend Int64 with From<Char> {
  native static fn from(value: Char): Int64
}
