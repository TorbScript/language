/**
 * The wire format of RFC 1035 section 4: a [Message] from bytes and back, names compressed by pointers (section
 * 4.1.4), the EDNS0 record of RFC 6891, and the query and response helpers a transport needs - so that `std/network`,
 * `std/tls` and `std/http` only move bytes (docs/design/DNS.md section 2).
 *
 * Reading never indexes past what it checked: every read goes through a `ByteReader` of `std/binary`, whose failure
 * becomes a [DnsError] that names the part of the message the bytes end in, so bytes from the network cannot make it
 * panic. Writing goes into a `ByteWriter`, whose width types make every field's range a check at the caller.
 */

use ByteReader, ByteWriter, ReadError from "std/binary"
use Ipv4Address, Ipv6Address from "std/ip"
use textOf from "std/stream"
use Operation, RecordClass, RecordType, ResponseCode from "./codes"
use DnsError from "./error"
use DomainName, presentation from "./name"
use Edns, EdnsOption, Message, MessageKind, Question from "./message"
use Record, RecordData, ServiceParameter from "./record"

/** The UDP payload size a query offers: 1232 bytes, which fits every path without fragmentation. */
const offeredPayload = 1232

// --- Reading ---------------------------------------------------------------------------------------------------------

/** What a read that runs out of bytes is inside: the sections of the message, or the data of one record. */
type Scope {
  /** The type whose data is read, or `None` for the sections of the message. */
  recordType: RecordType? = None
  /** Where the data of the record starts, which a failure inside of it names. */
  start: Int = 0

  /** Where the bytes end inside of `part`, which starts at `at`. */
  fn failure(part: String, at: Int): DnsError {
    match recordType {
      Some(found) => DnsError.InvalidRecord found, start, "the data ends inside {part}"
      None => DnsError.Truncated at, part
    }
  }
}

/** The sections of the message: a read that runs out of bytes there is a truncated message. */
const sections = Scope()

extend<Value> Result<Value, ReadError> {
  /** What was read, or the failure of `scope` that says the bytes end inside `part`. */
  fn inside(part: String, scope: Scope): Result<Value, DnsError> {
    match self {
      Ok(value) => Ok value
      Fail(problem) => Fail scope.failure(part, problem.offset())
    }
  }
}

/** The next name of `reader`, following compression pointers anywhere in `message`, and `reader` moved past it. */
fn nameOf(var reader: ByteReader, message: Bytes, part: String, scope: Scope): Result<DomainName, DnsError> {
  const at = reader.offset()
  const (name, end) = nameAt(message, at, part)?
  // A pointer may lead anywhere in the message, but the name itself has to end inside what the reader may read
  match reader.skip(end - at) {
    Ok(_) => Ok name
    Fail(_) => Fail scope.failure(part, at)
  }
}

/**
 * The name that starts at `start`, and where it ends in the stream: after its zero byte, or after its first pointer.
 * A pointer may point anywhere in the message, but never at a pointer this name already followed, and the labels
 * together may not pass 255 bytes - so every name ends after at most as many steps as the message has bytes.
 */
fn nameAt(bytes: Bytes, start: Int, part: String): Result<(DomainName, Int), DnsError> {
  var labels: List<Bytes> = []
  var position = start
  var end = -1
  var followed: List<Int> = []
  var length = 1
  loop {
    if position >= bytes.length() {
      return Fail DnsError.Truncated(start, part)
    }
    const size = Int.from bytes[position]
    if size == 0 {
      if end < 0 {
        end = position + 1
      }
      break
    }
    const kind = size & 192
    if kind == 192 {
      if position + 1 >= bytes.length() {
        return Fail DnsError.Truncated(start, part)
      }
      const target = (size & 63) << 8 | Int.from(bytes[position + 1])
      if end < 0 {
        end = position + 2
      }
      if target >= bytes.length() {
        return Fail DnsError.InvalidPointer(position, target)
      }
      if followed.contains(target) {
        return Fail DnsError.PointerLoop(position)
      }
      followed.append target
      position = target
      continue
    }
    if kind != 0 {
      return Fail DnsError.InvalidMessage(position, "the label type {kind} is not defined (RFC 6891 section 5)")
    }
    if position + 1 + size > bytes.length() {
      return Fail DnsError.Truncated(start, part)
    }
    length = length + size + 1
    if length > 255 {
      return Fail DnsError.InvalidName(presentation(labels), "the name at byte {start} is longer than 255 bytes")
    }
    labels.append bytes[(position + 1)..(position + 1 + size)]
    position = position + 1 + size
  }
  const name = DomainName.ofLabels(labels)?
  Ok((name, end))
}

/** The fixed part of a record: its owner, type, class and time to live, and how many bytes of data follow. */
type Entry {
  name: DomainName
  typeCode: Int
  classCode: Int
  timeToLive: Int
  length: Int
}

/** The next record's fixed part, and the reader moved to its data. */
fn entryOf(var reader: ByteReader, message: Bytes): Result<Entry, DnsError> {
  const name = nameOf(reader, message, "the owner of a record", sections)?
  const typeCode = Int.from(reader.uint16().inside("the type of a record", sections)?)
  const classCode = Int.from(reader.uint16().inside("the class of a record", sections)?)
  const timeToLive = Int.from(reader.uint32().inside("the time to live of a record", sections)?)
  const length = Int.from(reader.uint16().inside("the data length of a record", sections)?)
  Ok Entry(name, typeCode, classCode, timeToLive, length)
}

/** A reader over the data of `entry`, and `reader` moved past it. */
fn dataReaderOf(var reader: ByteReader, entry: Entry): Result<ByteReader, DnsError> {
  // The part is named only where the data is cut short, so that no record pays for the text of its failure
  match reader.limited(entry.length) {
    Ok(data) => Ok data
    Fail(problem) => Fail DnsError.Truncated(problem.offset(), "the data of a {RecordType.of(entry.typeCode)} record")
  }
}

/**
 * The record of an entry of the answer or the authority section, where an OPT record is refused, and `reader` moved
 * past its data.
 */
fn recordOf(var reader: ByteReader, message: Bytes, entry: Entry): Result<Record, DnsError> {
  // The data has a reader of its own that nothing else holds, so reading it changes it in place instead of copying it
  var data = dataReaderOf(reader, entry)?
  const recordType = RecordType.of entry.typeCode
  const start = data.offset()
  if recordType == RecordType.Opt {
    return Fail DnsError.InvalidMessage(start, "an OPT record belongs to the additional section (RFC 6891)")
  }
  const decoded = dataOf(message, recordType, data)?
  if data.remaining() > 0 {
    const reason = "the data is {entry.length} bytes long and ends after {data.position()}"
    return Fail DnsError.InvalidRecord(recordType, start, reason)
  }
  Ok Record(entry.name, RecordClass.of(entry.classCode), entry.timeToLive, decoded)
}

/** Reads a whole message. */
public fn decodedMessage(bytes: Bytes): Result<Message, DnsError> {
  var reader = ByteReader bytes
  const identifier = Int.from(reader.uint16().inside("the header", sections)?)
  const flags = Int.from(reader.uint16().inside("the header", sections)?)
  const questionCount = Int.from(reader.uint16().inside("the header", sections)?)
  const answerCount = Int.from(reader.uint16().inside("the header", sections)?)
  const authorityCount = Int.from(reader.uint16().inside("the header", sections)?)
  const additionalCount = Int.from(reader.uint16().inside("the header", sections)?)
  var questions: List<Question> = []
  for _ in 0..questionCount {
    const name = nameOf(reader, bytes, "a question", sections)?
    const typeCode = Int.from(reader.uint16().inside("a question", sections)?)
    const classCode = Int.from(reader.uint16().inside("a question", sections)?)
    questions.append Question(name, RecordType.of(typeCode), RecordClass.of(classCode))
  }
  var answers: List<Record> = []
  for _ in 0..answerCount {
    const entry = entryOf(reader, bytes)?
    answers.append(recordOf(reader, bytes, entry)?)
  }
  var authority: List<Record> = []
  for _ in 0..authorityCount {
    const entry = entryOf(reader, bytes)?
    authority.append(recordOf(reader, bytes, entry)?)
  }
  var additional: List<Record> = []
  var edns: Edns? = None
  var extendedCode = 0
  for _ in 0..additionalCount {
    const entry = entryOf(reader, bytes)?
    if entry.typeCode != 41 {
      additional.append(recordOf(reader, bytes, entry)?)
      continue
    }
    const data = dataReaderOf(reader, entry)?
    const start = data.offset()
    if edns.isSome() {
      return Fail DnsError.InvalidMessage(start, "a second OPT record (RFC 6891 section 6.1.1)")
    }
    if !entry.name.isRoot() {
      return Fail DnsError.InvalidMessage(start, "the owner of an OPT record is the root (RFC 6891 6.1.2)")
    }
    extendedCode = entry.timeToLive >> 24 & 255
    edns = Some(Edns(
      payloadSize: entry.classCode,
      version: entry.timeToLive >> 16 & 255,
      dnssecOk: entry.timeToLive >> 15 & 1 == 1,
      options: optionsOf(data)?,
    ))
  }
  if reader.remaining() > 0 {
    const reason = "the message is {bytes.length()} bytes long and ends after {reader.position()}"
    return Fail DnsError.InvalidMessage(reader.position(), reason)
  }
  Ok(Message(
    identifier: identifier,
    kind: if flags >> 15 & 1 == 1 { MessageKind.Response } else { MessageKind.Query },
    operation: Operation.of(flags >> 11 & 15),
    authoritative: flags >> 10 & 1 == 1,
    truncated: flags >> 9 & 1 == 1,
    recursionDesired: flags >> 8 & 1 == 1,
    recursionAvailable: flags >> 7 & 1 == 1,
    authenticated: flags >> 5 & 1 == 1,
    checkingDisabled: flags >> 4 & 1 == 1,
    responseCode: ResponseCode.of(extendedCode << 4 | flags & 15),
    questions: questions,
    answers: answers,
    authority: authority,
    additional: additional,
    edns: edns,
  ))
}

/** The options of an OPT record: a code, a length and that many bytes, until the data ends. */
fn optionsOf(data: ByteReader): Result<List<EdnsOption>, DnsError> {
  var reader = data
  const scope = Scope Some(RecordType.Opt), reader.offset()
  var options: List<EdnsOption> = []
  while reader.remaining() > 0 {
    const code = Int.from(reader.uint16().inside("an option code", scope)?)
    const length = Int.from(reader.uint16().inside("an option length", scope)?)
    options.append EdnsOption(code, reader.bytes(length).inside("the data of an option", scope)?)
  }
  Ok options
}

/** The data of a record of `recordType`, which `reader` holds and nothing else. */
fn dataOf(message: Bytes, recordType: RecordType, var reader: ByteReader): Result<RecordData, DnsError> {
  const start = reader.offset()
  const length = reader.remaining()
  const scope = Scope Some(recordType), start
  const decoded = match recordType {
    .A => {
      if length != 4 {
        return Fail DnsError.InvalidRecord(recordType, start, "an A record holds 4 bytes, not {length}")
      }
      const octets = reader.bytes(4).inside("an IPv4 address", scope)?
      RecordData.A Ipv4Address.of(octets[0], octets[1], octets[2], octets[3])
    }
    .Aaaa => {
      if length != 16 {
        return Fail DnsError.InvalidRecord(recordType, start, "an AAAA record holds 16 bytes, not {length}")
      }
      var segments: List<Int> = []
      for _ in 0..8 {
        segments.append Int.from(reader.uint16().inside("an IPv6 address", scope)?)
      }
      match Ipv6Address.of(segments) {
        Ok(address) => RecordData.Aaaa address
        Fail(problem) => {
          return Fail DnsError.InvalidRecord(recordType, start, problem.reason)
        }
      }
    }
    .Cname => RecordData.Cname(nameOf(reader, message, "the canonical name", scope)?)
    .Ns => RecordData.Ns(nameOf(reader, message, "the name server", scope)?)
    .Ptr => RecordData.Ptr(nameOf(reader, message, "the target", scope)?)
    .Mx => {
      const preference = Int.from(reader.uint16().inside("the preference", scope)?)
      RecordData.Mx(preference, nameOf(reader, message, "the exchange", scope)?)
    }
    .Txt => {
      var strings: List<Bytes> = []
      while reader.remaining() > 0 {
        const size = Int.from(reader.uint8().inside("a text string", scope)?)
        strings.append(reader.bytes(size).inside("a text string", scope)?)
      }
      RecordData.Txt strings
    }
    .Srv => {
      const priority = Int.from(reader.uint16().inside("the priority", scope)?)
      const weight = Int.from(reader.uint16().inside("the weight", scope)?)
      const port = Int.from(reader.uint16().inside("the port", scope)?)
      RecordData.Srv(priority, weight, port, nameOf(reader, message, "the target", scope)?)
    }
    .Soa => {
      const primaryServer = nameOf(reader, message, "the primary server", scope)?
      const responsibleMailbox = nameOf(reader, message, "the responsible mailbox", scope)?
      const serial = Int.from(reader.uint32().inside("the serial", scope)?)
      const refresh = Int.from(reader.uint32().inside("the refresh interval", scope)?)
      const retry = Int.from(reader.uint32().inside("the retry interval", scope)?)
      const expire = Int.from(reader.uint32().inside("the expire interval", scope)?)
      const minimum = Int.from(reader.uint32().inside("the minimum", scope)?)
      RecordData.Soa primaryServer, responsibleMailbox, serial, refresh, retry, expire, minimum
    }
    .Caa => {
      const flags = Int.from(reader.uint8().inside("the flags", scope)?)
      const tagLength = Int.from(reader.uint8().inside("the tag length", scope)?)
      const tag = reader.bytes(tagLength).inside("the tag", scope)?
      if tag.isEmpty() || !tag.all({ isAlphanumeric Int.from(_) }) {
        return Fail DnsError.InvalidRecord(recordType, start, "a CAA tag is ASCII letters and digits (RFC 8659)")
      }
      const text = textOf(tag) ?? ""
      RecordData.Caa(flags, text, reader.bytes(reader.remaining()).inside("the value", scope)?)
    }
    .Svcb => {
      const (priority, target, parameters) = bindingOf(reader, message, recordType, scope)?
      RecordData.Svcb priority, target, parameters
    }
    .Https => {
      const (priority, target, parameters) = bindingOf(reader, message, recordType, scope)?
      RecordData.Https priority, target, parameters
    }
    _ => RecordData.Unknown(recordType, reader.bytes(length).inside("the data", scope)?)
  }
  Ok decoded
}

/** An ASCII letter or digit. */
fn isAlphanumeric(code: Int): Bool {
  (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || (code >= 48 && code <= 57)
}

/** The priority, target and parameters of an SVCB or HTTPS record, the keys strictly increasing (RFC 9460 2.2). */
fn bindingOf(
  var reader: ByteReader,
  message: Bytes,
  recordType: RecordType,
  scope: Scope,
): Result<(Int, DomainName, List<ServiceParameter>), DnsError> {
  const priority = Int.from(reader.uint16().inside("the priority", scope)?)
  const target = nameOf(reader, message, "the target", scope)?
  var parameters: List<ServiceParameter> = []
  var previous = -1
  while reader.remaining() > 0 {
    const key = Int.from(reader.uint16().inside("a parameter key", scope)?)
    const length = Int.from(reader.uint16().inside("a parameter length", scope)?)
    const value = reader.bytes(length).inside("a parameter value", scope)?
    if key <= previous {
      const reason = "the parameter keys do not increase (RFC 9460 section 2.2)"
      return Fail DnsError.InvalidRecord(recordType, scope.start, reason)
    }
    previous = key
    parameters.append(parameterOf(recordType, scope.start, key, value)?)
  }
  Ok((priority, target, parameters))
}

/** One service parameter, typed where RFC 9460 defines its key. */
fn parameterOf(recordType: RecordType, start: Int, key: Int, value: Bytes): Result<ServiceParameter, DnsError> {
  const broken = DnsError.InvalidRecord recordType, start, "the value of the parameter `{key}` does not fit its key"
  var reader = ByteReader value
  match key {
    0 => {
      if value.isEmpty() || value.length() % 2 != 0 {
        return Fail broken
      }
      var keys: List<Int> = []
      while reader.remaining() > 0 {
        keys.append Int.from(reader.uint16().mapError({ _ => broken })?)
      }
      Ok ServiceParameter.Mandatory(keys)
    }
    1 => {
      var protocols: List<String> = []
      while reader.remaining() > 0 {
        const size = Int.from(reader.uint8().mapError({ _ => broken })?)
        if size == 0 {
          return Fail broken
        }
        const protocol = reader.bytes(size).mapError({ _ => broken })?
        match textOf(protocol) {
          Ok(text) => protocols.append text
          Fail(_) => {
            return Ok ServiceParameter.Other(key, value)
          }
        }
      }
      if protocols.isEmpty() {
        return Fail broken
      }
      Ok ServiceParameter.Alpn(protocols)
    }
    2 => {
      if !value.isEmpty() {
        return Fail broken
      }
      Ok ServiceParameter.NoDefaultAlpn
    }
    3 => {
      if value.length() != 2 {
        return Fail broken
      }
      Ok ServiceParameter.Port(Int.from(reader.uint16().mapError({ _ => broken })?))
    }
    4 => {
      if value.isEmpty() || value.length() % 4 != 0 {
        return Fail broken
      }
      var addresses: List<Ipv4Address> = []
      while reader.remaining() > 0 {
        const octets = reader.bytes(4).mapError({ _ => broken })?
        addresses.append Ipv4Address.of(octets[0], octets[1], octets[2], octets[3])
      }
      Ok ServiceParameter.Ipv4Hint(addresses)
    }
    5 => Ok ServiceParameter.EncryptedClientHello(value)
    6 => {
      if value.isEmpty() || value.length() % 16 != 0 {
        return Fail broken
      }
      var addresses: List<Ipv6Address> = []
      while reader.remaining() > 0 {
        var segments: List<Int> = []
        for _ in 0..8 {
          segments.append Int.from(reader.uint16().mapError({ _ => broken })?)
        }
        match Ipv6Address.of(segments) {
          Ok(address) => addresses.append address
          Fail(_) => {
            return Fail broken
          }
        }
      }
      Ok ServiceParameter.Ipv6Hint(addresses)
    }
    _ => Ok ServiceParameter.Other(key, value)
  }
}

// --- Writing ---------------------------------------------------------------------------------------------------------

/**
 * `value` as the width type of its field, or the refusal that names `what`: the one range check in front of every
 * field whose number comes from a caller.
 */
fn narrowed<Width: TryFrom<Int, NumberRangeError> & Integer & Into<Int>>(
  value: Int,
  what: String,
): Result<Width, DnsError> {
  match Width.tryFrom(value) {
    Ok(width) => Ok width
    Fail(_) => {
      const largest: Int = Width.maximum.into()
      Fail DnsError.Unencodable("{what} is {value}, outside 0 to {largest}")
    }
  }
}

/** The lowest sixteen bits of `value`, for a number this file has already checked or means to cut. */
fn lowest16(value: Int): UInt16 {
  UInt16.tryFrom(value & 65535).ok() ?? 0
}

/** The lowest eight bits of `value`. */
fn lowest8(value: Int): UInt8 {
  UInt8.tryFrom(value & 255).ok() ?? 0
}

/** The bytes of a message written so far, and where each name already written starts, for compression. */
type MessageWriter {
  var output: ByteWriter = ByteWriter()
  /** Every name written at an offset a pointer can reach (below 16384), by its first offset. */
  var offsets: Map<DomainName, Int> = [:]

  /** `name`, ending in a pointer to an earlier occurrence of its longest suffix where `compressed` allows one. */
  var fn name(name: DomainName, compressed: Bool) {
    var current = name
    while !current.isRoot() {
      if compressed {
        if const Some(offset) = offsets.get(current) {
          output.uint16 lowest16(49152 | offset)
          return
        }
      }
      if output.length() < 16384 && !offsets.containsKey(current) {
        offsets[current] = output.length()
      }
      const label = current.labels()[0]
      output.uint8 lowest8(label.length())
      output.append label
      current = current.parent() ?? DomainName.root
    }
    output.uint8 0
  }
}

/** The header: identifier, flags and the four counts. */
fn writeHeader(var output: ByteWriter, message: Message, additionalCount: Int) {
  var flags = message.operation.code() << 11 | message.responseCode.code() & 15
  for (bit, set) in [
    (15, message.kind == MessageKind.Response),
    (10, message.authoritative),
    (9, message.truncated),
    (8, message.recursionDesired),
    (7, message.recursionAvailable),
    (5, message.authenticated),
    (4, message.checkingDisabled),
  ] {
    if set {
      flags = flags | 1 << bit
    }
  }
  output.uint16 lowest16(message.identifier)
  output.uint16 lowest16(flags)
  output.uint16 lowest16(message.questions.length())
  output.uint16 lowest16(message.answers.length())
  output.uint16 lowest16(message.authority.length())
  output.uint16 lowest16(additionalCount)
}

/** A question, its name compressed. */
fn writeQuestion(var writer: MessageWriter, question: Question) {
  writer.name question.name, compressed: true
  writer.output.uint16 lowest16(question.recordType.code())
  writer.output.uint16 lowest16(question.recordClass.code())
}

/** The EDNS0 record: the root, type 41, the payload size as its class, and the extended code, version and DO bit. */
fn writeEdns(var output: ByteWriter, edns: Edns, extendedCode: Int) {
  output.uint8 0
  output.uint16 41
  output.uint16 lowest16(edns.payloadSize)
  output.uint8 lowest8(extendedCode)
  output.uint8 lowest8(edns.version)
  output.uint16(if edns.dnssecOk { 32768 } else { 0 })
  const mark = output.reserve16()
  for option in edns.options {
    output.uint16 lowest16(option.code)
    output.uint16 lowest16(option.data.length())
    output.append option.data
  }
  output.patch mark, lowest16(output.lengthAfter(mark))
}

/** A record: its owner compressed, the fixed part, and its data with the length in front. */
fn writeRecord(var writer: MessageWriter, record: Record): Result<Void, DnsError> {
  writer.name record.name, compressed: true
  writer.output.uint16 lowest16(record.recordType().code())
  writer.output.uint16 lowest16(record.recordClass.code())
  writer.output.uint32(narrowed(record.timeToLive, "the time to live of a record")?)
  const mark = writer.output.reserve16()
  writeData(writer, record.data)?
  const length = writer.output.lengthAfter mark
  if length > 65535 {
    return Fail DnsError.Unencodable("the data of a {record.recordType()} record is {length} bytes, more than 65535")
  }
  writer.output.patch mark, lowest16(length)
  Ok void
}

/** The data of a record, checked against the bits of its fields. */
fn writeData(var writer: MessageWriter, data: RecordData): Result<Void, DnsError> {
  match data {
    .A(address) => {
      for octet in address.octets() {
        writer.output.uint8 lowest8(octet)
      }
    }
    .Aaaa(address) => {
      for segment in address.segments() {
        writer.output.uint16 lowest16(segment)
      }
    }
    .Cname(target) => writer.name target, compressed: true
    .Ns(server) => writer.name server, compressed: true
    .Ptr(target) => writer.name target, compressed: true
    .Mx(preference, exchange) => {
      writer.output.uint16(narrowed(preference, "the preference of an MX record")?)
      writer.name exchange, compressed: true
    }
    .Txt(strings) => {
      for string in strings {
        if string.length() > 255 {
          return Fail DnsError.Unencodable("a text string is {string.length()} bytes, and one holds at most 255")
        }
        writer.output.uint8 lowest8(string.length())
        writer.output.append string
      }
    }
    .Srv(priority, weight, port, target) => {
      writer.output.uint16(narrowed(priority, "the priority of an SRV record")?)
      writer.output.uint16(narrowed(weight, "the weight of an SRV record")?)
      writer.output.uint16(narrowed(port, "the port of an SRV record")?)
      writer.name target, compressed: false
    }
    .Soa(primaryServer, responsibleMailbox, serial, refresh, retry, expire, minimum) => {
      writer.name primaryServer, compressed: true
      writer.name responsibleMailbox, compressed: true
      writer.output.uint32(narrowed(serial, "the serial of an SOA record")?)
      writer.output.uint32(narrowed(refresh, "the refresh interval of an SOA record")?)
      writer.output.uint32(narrowed(retry, "the retry interval of an SOA record")?)
      writer.output.uint32(narrowed(expire, "the expire interval of an SOA record")?)
      writer.output.uint32(narrowed(minimum, "the minimum of an SOA record")?)
    }
    .Caa(flags, tag, value) => {
      writer.output.uint8(narrowed(flags, "the flags of a CAA record")?)
      const tagBytes = tag.bytes().toList()
      if tagBytes.isEmpty() || tagBytes.length() > 255 || !tagBytes.all({ isAlphanumeric Int.from(_) }) {
        return Fail DnsError.Unencodable("the CAA tag `{tag}` is not ASCII letters and digits (RFC 8659)")
      }
      writer.output.uint8 lowest8(tagBytes.length())
      writer.output.append tagBytes
      writer.output.append value
    }
    .Svcb(priority, target, parameters) => writeBinding(writer, priority, target, parameters)?
    .Https(priority, target, parameters) => writeBinding(writer, priority, target, parameters)?
    .Unknown(recordType, bytes) => {
      if recordType == RecordType.Opt {
        return Fail DnsError.Unencodable("an OPT record is written from `Message.edns`, not as a record")
      }
      writer.output.append bytes
    }
  }
  Ok void
}

/** The data of an SVCB or HTTPS record: the target uncompressed (RFC 9460 section 2.2), the parameters by key. */
fn writeBinding(
  var writer: MessageWriter,
  priority: Int,
  target: DomainName,
  parameters: List<ServiceParameter>,
): Result<Void, DnsError> {
  writer.output.uint16(narrowed(priority, "the priority of a service binding")?)
  writer.name target, compressed: false
  var previous = -1
  for parameter in parameters.sorted(by: { _.key() }) {
    const key: UInt16 = narrowed(parameter.key(), "the key of a service parameter")?
    if Int.from(key) == previous {
      return Fail DnsError.Unencodable("two service parameters with the key {key}")
    }
    previous = Int.from key
    const value = parameterValue(parameter)?
    if value.length() > 65535 {
      return Fail DnsError.Unencodable("the value of the service parameter {key} is longer than 65535 bytes")
    }
    writer.output.uint16 key
    writer.output.uint16 lowest16(value.length())
    writer.output.append value
  }
  Ok void
}

/** The value of a service parameter as bytes, checked. */
fn parameterValue(parameter: ServiceParameter): Result<Bytes, DnsError> {
  var value = ByteWriter()
  match parameter {
    .Mandatory(keys) => {
      if keys.isEmpty() {
        return Fail DnsError.Unencodable("a `mandatory` parameter names at least one key")
      }
      for key in keys {
        value.uint16(narrowed(key, "a key of a `mandatory` parameter")?)
      }
    }
    .Alpn(protocols) => {
      if protocols.isEmpty() {
        return Fail DnsError.Unencodable("an `alpn` parameter names at least one protocol")
      }
      for protocol in protocols {
        const size = protocol.byteLength()
        if size == 0 || size > 255 {
          return Fail DnsError.Unencodable("the protocol `{protocol}` is not 1 to 255 bytes")
        }
        value.uint8 lowest8(size)
        value.text protocol
      }
    }
    .NoDefaultAlpn => {}
    .Port(port) => value.uint16(narrowed(port, "the port of a service binding")?)
    .Ipv4Hint(addresses) => {
      if addresses.isEmpty() {
        return Fail DnsError.Unencodable("an `ipv4hint` parameter names at least one address")
      }
      for address in addresses {
        for octet in address.octets() {
          value.uint8 lowest8(octet)
        }
      }
    }
    .EncryptedClientHello(configurations) => value.append configurations
    .Ipv6Hint(addresses) => {
      if addresses.isEmpty() {
        return Fail DnsError.Unencodable("an `ipv6hint` parameter names at least one address")
      }
      for address in addresses {
        for segment in address.segments() {
          value.uint16 lowest16(segment)
        }
      }
    }
    .Other(_, bytes) => value.append bytes
  }
  Ok value.bytes()
}

/** Nothing where `value` fits the width type of its field, and otherwise the refusal that names `what`. */
fn checked<Width: TryFrom<Int, NumberRangeError> & Integer & Into<Int>>(
  value: Int,
  what: String,
): Result<Void, DnsError> {
  const _fitting: Width = narrowed(value, what)?
  Ok void
}

/** Writes a whole message, checked. */
public fn encodedMessage(message: Message): Result<Bytes, DnsError> {
  checked<UInt16>(message.identifier, "the identifier")?
  for (count, section) in [
    (message.questions.length(), "question"),
    (message.answers.length(), "answer"),
    (message.authority.length(), "authority"),
    (message.additional.length(), "additional"),
  ] {
    if count > 65535 {
      return Fail DnsError.Unencodable("the {section} section has {count} entries, more than 65535")
    }
  }
  const extendedCode = message.responseCode.code() >> 4
  var additionalCount = message.additional.length()
  match message.edns {
    Some(edns) => {
      checked<UInt16>(edns.payloadSize, "the payload size of the EDNS0 record")?
      checked<UInt8>(edns.version, "the EDNS version")?
      for option in edns.options {
        checked<UInt16>(option.code, "the code of an EDNS0 option")?
        checked<UInt16>(option.data.length(), "the length of an EDNS0 option")?
      }
      additionalCount = additionalCount + 1
    }
    None => {
      if extendedCode > 0 {
        return Fail DnsError.Unencodable("the response code {message.responseCode} needs an EDNS0 record")
      }
    }
  }
  checked<UInt16>(additionalCount, "the number of additional records")?
  var writer = MessageWriter()
  writeHeader writer.output, message, additionalCount
  for question in message.questions {
    writeQuestion writer, question
  }
  for section in [message.answers, message.authority, message.additional] {
    for record in section {
      writeRecord(writer, record)?
    }
  }
  if const Some(edns) = message.edns {
    writeEdns writer.output, edns, extendedCode
  }
  Ok writer.output.bytes()
}

// --- Queries and responses -------------------------------------------------------------------------------------------

/**
 * The bytes of a standard query for the records of `recordType` at `name`: one question in class `Internet`,
 * recursion desired unless `recursionDesired` says otherwise, and an EDNS0 record that offers a UDP payload of 1232
 * bytes and sets the DO bit where `dnssecOk` asks for DNSSEC records. The identifier is taken modulo 65536; a transport
 * draws it at random for every query (RFC 5452 section 9.2). What it sends is these bytes, as they are over UDP and
 * after a length of two bytes over TCP (RFC 7766 section 8).
 *
 * # Examples
 *
 *     const bytes = query(DomainName.tryFrom("example.test")?, RecordType.A, 4660)
 *     print bytes.length()
 */
public fn query(
  name: DomainName,
  recordType: RecordType,
  identifier: Int,
  recursionDesired: Bool = true,
  dnssecOk: Bool = false,
): Bytes {
  const message = Message(
    identifier: identifier & 65535,
    recursionDesired: recursionDesired,
    questions: [Question(name, recordType)],
  )
  var writer = MessageWriter()
  writeHeader writer.output, message, 1
  writeQuestion writer, message.questions[0]
  writeEdns writer.output, Edns(payloadSize: offeredPayload, dnssecOk: dnssecOk), 0
  writer.output.bytes()
}

/**
 * The response in `bytes`, checked against the `query` it is supposed to answer: it is a response, its identifier and
 * operation are the query's, and its question section is the query's, the names compared without their case - or empty,
 * which a server may send with an error code. What the response says is not judged here: a `NameError`, an empty
 * answer and a truncated response (`truncated`, to be asked again over TCP) are messages like any other.
 *
 * # Errors
 *
 * - Every [DnsError] of [Message.tryFrom], for either message.
 * - [DnsError.UnexpectedResponse] for a message that is not the response to `query`.
 */
public fn readResponse(bytes: Bytes, query: Bytes): Result<Message, DnsError> {
  const asked = decodedMessage(query)?
  const response = decodedMessage(bytes)?
  if response.kind != MessageKind.Response {
    return Fail DnsError.UnexpectedResponse("the QR bit is not set, so it is a query")
  }
  if response.identifier != asked.identifier {
    const reason = "the identifier is {response.identifier}, and the query's is {asked.identifier}"
    return Fail DnsError.UnexpectedResponse(reason)
  }
  if response.operation != asked.operation {
    const reason = "the operation is {response.operation}, and the query's is {asked.operation}"
    return Fail DnsError.UnexpectedResponse(reason)
  }
  if response.questions.isEmpty() {
    if response.responseCode == ResponseCode.NoError {
      return Fail DnsError.UnexpectedResponse("an answer without the question it answers")
    }
    return Ok response
  }
  if response.questions != asked.questions {
    const answered = response.questions.map({ _.show() }).joined(separator: ", ")
    const questioned = asked.questions.map({ _.show() }).joined(separator: ", ")
    return Fail DnsError.UnexpectedResponse("the question is `{answered}`, and the query asked `{questioned}`")
  }
  Ok response
}
