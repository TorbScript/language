/**
 * The Domain Name System as values: [DomainName] with IDNA and the comparison of RFC 4343, the records as a closed set
 * of typed cases, and the wire format of RFC 1035 with name compression and EDNS0 - a [Message] from bytes and back,
 * [query] for the bytes of a query, and [readResponse] for the response to it.
 *
 * `std/dns` touches nothing: it has no natives and needs no capability. Sending a query is a transport's -
 * `std/network` over UDP and TCP, `std/tls` for DNS over TLS, `std/http` for DNS over HTTPS - and every one of them
 * moves the bytes this package writes and reads (docs/design/DNS.md).
 *
 *     const name = DomainName.tryFrom("bücher.example")?
 *     const bytes = query name, RecordType.Aaaa, 4660
 *     print name
 */

public use DomainName from "./name"
public use DnsError from "./error"
public use RecordType, RecordClass, Operation, ResponseCode from "./codes"
public use Record, RecordData, ServiceParameter from "./record"
public use Message, MessageKind, Question, Edns, EdnsOption from "./message"
public use query, readResponse from "./wire"
