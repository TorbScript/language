/**
 * The search tests of RE2, `re2/testdata/re2-search.txt` as the Go distribution keeps it
 * (https://github.com/golang/go/blob/master/src/regexp/testdata/re2-search.txt): for a pattern and a text, the first
 * match of the whole text and the first match anywhere, each as the byte offsets of the match and of every group.
 * Generated from the file; the 80 checks whose pattern uses `\C`, which matches a byte and not a character, are left
 * out, as Go leaves them out. The longest-match columns of the file are not read: a Regex prefers the first match.
 *
 * RE2 is under the BSD 3-Clause License:
 *
 * Copyright (c) 2009 The RE2 Authors. All rights reserved.
 *
 * Redistribution and use in source and binary forms, with or without modification, are permitted provided that the
 * following conditions are met:
 *
 *    * Redistributions of source code must retain the above copyright notice, this list of conditions and the
 * following disclaimer.
 *    * Redistributions in binary form must reproduce the above copyright notice, this list of conditions and the
 * following disclaimer in the documentation and/or other materials provided with the distribution.
 *    * Neither the name of Google Inc. nor the names of its contributors may be used to endorse or promote products
 * derived from this software without specific prior written permission.
 *
 * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES,
 * INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE
 * DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
 * SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
 * SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
 * WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
 * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 */

/** One pattern against one text. A result is `-` for no match, or `start-end` of the match and of every group. */
public type SearchCase {
  pattern: String
  text: String
  /** The first match of the whole text. */
  whole: String
  /** The first match anywhere in the text. */
  first: String
}

/** Every check of the file, in its order. */
public fn searchCases(): List<SearchCase> {
  var cases: List<SearchCase> = []
  cases.appendAll searchCasesPart1()
  cases.appendAll searchCasesPart2()
  cases.appendAll searchCasesPart3()
  cases.appendAll searchCasesPart4()
  cases.appendAll searchCasesPart5()
  cases.appendAll searchCasesPart6()
  cases.appendAll searchCasesPart7()
  cases.appendAll searchCasesPart8()
  cases.appendAll searchCasesPart9()
  cases.appendAll searchCasesPart10()
  cases.appendAll searchCasesPart11()
  cases.appendAll searchCasesPart12()
  cases.appendAll searchCasesPart13()
  cases.appendAll searchCasesPart14()
  cases.appendAll searchCasesPart15()
  cases.appendAll searchCasesPart16()
  cases.appendAll searchCasesPart17()
  cases.appendAll searchCasesPart18()
  cases.appendAll searchCasesPart19()
  cases
}

