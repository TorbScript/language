    SearchCase("ab|cd", "", "-", "-"),
    SearchCase("ab|cd", "xabcdx", "-", "1-3"),
    SearchCase("^(?:ab|cd)$", "", "-", "-"),
    SearchCase("^(?:ab|cd)$", "xabcdx", "-", "-"),
