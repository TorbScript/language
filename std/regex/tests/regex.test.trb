/**
 * `Regex` beyond RE2's search tests: what a pattern is refused for, groups by name, replacing, splitting, every match,
 * named groups read into a type, Unicode, positions in text of several bytes per character, and the linear time that
 * makes a pathological pattern harmless.
 */

use test, group from "std/test"
use Regex, RegexMatch, RegexError from "../src/lib"

type Date {
  year: Int
  month: Int
  day: Int
  note: String = ""
}

type Rule {
  name: String
  pattern: Regex
}

/**
 * A pattern the compiler compiled where the test wrote it: a literal where a `Regex` is expected, read verbatim, so
 * `\d` and `{2}` are the pattern's and a pattern of these tests that does not compile is a compile error.
 */
fn regexOf(pattern: Regex): Regex {
  pattern
}

fn refusal(pattern: String): String {
  match Regex.tryFrom(pattern) {
    Ok(_) => "accepted"
    Fail(problem) => problem.message
  }
}

group "compiling" {
  test "a backreference and lookaround are refused with the reason" {
    assert refusal(raw"(a)\1").contains("backreference")
    assert refusal(raw"(?P<x>a)(?P=x)").contains("backreference")
    assert refusal("a(?=b)").contains("lookaround")
    assert refusal("(?<!a)b").contains("lookaround")
  }

  test "a syntax error names what is wrong, and where" {
    assert(refusal("(ab") == "a `(` is not closed")
    assert(refusal("ab)") == "a `)` has no `(` to close")
    assert(refusal("[a-") == "a `[` is not closed")
    assert(refusal("*a") == "`*` repeats nothing")
    assert(refusal("a**") == "a repetition cannot be repeated: `**`")
    assert refusal("a\{1001\}").contains("at most 1000")
    assert(refusal("[z-a]") == "the range `z-a` runs backwards")
    assert(Regex.tryFrom("ab)").map({ _.text() }) == Fail(RegexError("ab)", 2, "a `)` has no `(` to close")))
  }

  test "a repeat count that is no repeat count is a literal brace" {
    assert regexOf("a{,2}").matches("a\{,2\}")
    assert regexOf("a{2}").matches("aa")
  }

  test "a pattern shows as it was written, and two of the same text are equal" {
    assert(regexOf("\d+").show() == raw"\d+")
    assert(regexOf("a|b") == regexOf("a|b"))
  }
}

group "matching" {
  test "matches is the whole text, find anywhere" {
    const digits = regexOf "\d+"
    assert digits.matches("2026")
    assert(!digits.matches("2026a"))
    assert digits.isFound("in 2026")
    assert(digits.find("in 2026 and 2027").map({ _.text() }) == "2026")
  }

  test "groups by index and by name, and a group that took no part" {
    const found = regexOf("(?P<key>\w+)=(?P<value>\w+)?").find("x size=").expect("a match")
    assert(found.named("key") == "size")
    assert(found.named("value") == None)
    assert(found.group(0) == "size=")
    assert(found.groups() == ["size=", "size", None])
    assert(found.start() == 2 && found.end() == 7)
  }

  test "the first alternative wins where both match at the same place" {
    assert(regexOf("a|ab").find("ab").map({ _.text() }) == "a")
    assert(regexOf("a+?").find("aaa").map({ _.text() }) == "a")
  }

  test "findAll finds every match, and an empty match next to the last one does not count" {
    const words = regexOf("\w+").findAll("one two  three").map({ _.text() }).toList()
    assert(words == ["one", "two", "three"])
    const empties = regexOf("a*").findAll("baaac").map({ "{_.start()}-{_.end()}" }).toList()
    assert(empties == ["0-0", "1-4", "5-5"])
  }

  test "positions are byte offsets in text of several bytes per character" {
    const found = regexOf("é+").find("café é").expect("a match")
    assert(found.start() == 3 && found.end() == 5)
    assert(regexOf(".").findAll("aé😀").length() == 3)
  }

  test "multi-line, dot-all and case-insensitive flags" {
    assert(regexOf("(?m)^b$").find("a\nb\nc").map({ _.start() }) == 2)
    assert(!regexOf("^b$").isFound("a\nb\nc"))
    assert regexOf("(?s)a.b").matches("a\nb")
    assert(!regexOf("a.b").matches("a\nb"))
    assert regexOf("(?i)straße").matches("STRAßE")
    assert regexOf("(?i)σ").matches("ς")
    assert regexOf("(?i:a)b").matches("Ab")
    assert(!regexOf("(?i:a)b").matches("AB"))
  }

  test "Unicode classes and the classes of RE2" {
    assert regexOf("\p{Greek}+").matches("αβγ")
    assert regexOf("\pL+").matches("Grüße")
    assert regexOf("[[:alpha:]]+").matches("abc")
    assert(!regexOf("\d").isFound("٣"))
    assert regexOf("\p{Nd}").matches("٣")
    assert regexOf("\x{1F600}").matches("😀")
    assert(refusal(raw"\p{Klingon}") == "the Unicode class `Klingon` is not known")
  }

  test "a pathological pattern stays linear" {
    const long = "a".repeat(5000)
    assert(!regexOf("(a*)*b").isFound(long))
    assert(!regexOf("(a|aa)+$").isFound(long + "b"))
  }
}

group "replacing and splitting" {
  test "replace expands groups by number and by name, and $$ is a dollar" {
    const date = regexOf "(?P<year>\d{4})-(?P<month>\d{2})-(?P<day>\d{2})"
    assert(date.replace("on 2026-09-25.", "$day.$month.$year") == "on 25.09.2026.")
    assert(date.replace("2026-09-25", "$\{1\}y $$3") == "2026y $3")
    assert(regexOf("a").replaceFirst("banana", "o") == "bonana")
    assert(regexOf("a").replace("banana", "o") == "bonono")
  }

  test "replaceWith hands every match to a function" {
    const doubled = regexOf("\d+").replaceWith("1 and 21", { found => "{(Int.tryFrom(found.text()) ?? 0) * 2}" })
    assert(doubled == "2 and 42")
  }

  test "split cuts at every match, as RE2's split does" {
    assert(regexOf(",\s*").split("a, b,c") == ["a", "b", "c"])
    assert(regexOf("x*").split("axbxc") == ["a", "b", "c"])
    assert(regexOf(",").split("") == [""])
    assert(regexOf(",").split("a,") == ["a", ""])
  }
}

group "reading and writing" {
  test "named groups decode into a type, each text read as its field's type" {
    const date = regexOf "(?P<year>\d{4})-(?P<month>\d{2})-(?P<day>\d{2})(?: \((?P<note>\w+)\))?"
    const plain = date.find("due 2026-09-25").expect("a match").decoded<Date>()
    assert(plain.ok() == Date(2026, 9, 25))
    const noted = date.find("2026-10-01 (release)").expect("a match").decoded<Date>()
    assert(noted.ok() == Date(2026, 10, 1, "release"))
  }

  test "a Regex is written and read as its pattern" {
    const rule = Rule "digits", regexOf("\d+")
    const text = Json().encode(rule)
    assert(text == raw"{" + "\"name\":\"digits\",\"pattern\":\"\\\\d+\"" + raw"}")
    assert(Json().decode<Rule>(text).ok() == rule)
    assert(!Json().decode<Rule>("\{\"name\":\"x\",\"pattern\":\"(\"\}").isOk())
  }
}
