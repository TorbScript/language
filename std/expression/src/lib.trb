/**
 * Quoted expressions: [Expression], the typed tree a quoted parameter hands over, and [ExpressionNode], the plain
 * data anyone can build, match and transform. [assert] and [nameOf] are what most callers reach for; a provider
 * that renders its own explanation of a captured expression works with [ExpressionNode] directly.
 */

/**
 * The typed tree behind a quoted parameter: `Expression<Value>` type checks its argument as an ordinary `Value` and
 * hands it over together with the expression tree that produced it.
 *
 * A caller writes nothing special for this - passing an ordinary `Value` where a parameter is declared
 * `Expression<Value>` is enough. Only the compiler creates one; [ExpressionNode] is the data an ordinary function
 * can build as well.
 *
 * # Related
 *
 * - [assert] - the one function most callers need an `Expression<Bool>` for.
 */
public native type Expression<Value> {
  /** Static data, created at compile time. */
  tree: ExpressionNode
  /** The source text of the quoted expression: `"_.age >= minAge"` */
  source: String
  /** Where the quoted expression starts in its file. */
  location: SourceLocation

  /** The ordinary value (for function types: the closure). Evaluated at most once. */
  native fn value(): Value

  /** The values of the captured variables, in the order of their `Captured.index`. */
  native fn captures(): List<EncodedValue>
}

/** A place in a source file: what [Expression.location] and a diagnostic point at. */
public type SourceLocation with Show {
  /** The path of the file. */
  file: String
  /** The line the location points at. */
  line: Int
  /** The column the location points at. */
  column: Int

  /** `"{file}:{line}:{column}"`. */
  fn show(): String {
    "{file}:{line}:{column}"
  }
}

/** A description of a type. Data, not reflection: there is no way back from a `TypeReference` to a type. */
public type TypeReference with Show {
  /** The type's name, without its arguments. */
  name: String
  /** The type arguments, empty for a type with none. */
  arguments: List<Self> = []

  /** `name`, or `name<arguments>` when there are any. */
  fn show(): String {
    if arguments.isEmpty() {
      return name
    }
    const inner = arguments.map { _.show() }.joined(separator: ", ")
    "{name}<{inner}>"
  }
}

/** The prefix operators a quoted expression can carry, one case per operator. */
public type UnaryOperator {
  /** `-`. */
  case Negate
  /** `!`. */
  case Not
  /** `~`. */
  case BitwiseNot
}

/** The infix operators a quoted expression can carry, one case per operator. */
public type BinaryOperator {
  /** `+`. */
  case Add
  /** `-`. */
  case Subtract
  /** `*`. */
  case Multiply
  /** `/`. */
  case Divide
  /** `%`. */
  case Remainder
  /** `**`. */
  case Power
  /** `&`. */
  case BitwiseAnd
  /** `|`. */
  case BitwiseOr
  /** `^`. */
  case BitwiseExclusiveOr
  /** `<<`. */
  case ShiftLeft
  /** `>>`. */
  case ShiftRight
  /** `==`. */
  case Equal
  /** `!=`. */
  case NotEqual
  /** `<`. */
  case Less
  /** `<=`. */
  case LessOrEqual
  /** `>`. */
  case Greater
  /** `>=`. */
  case GreaterOrEqual
  /** `&&`. */
  case And
  /** `||`. */
  case Or
}

/**
 * Names are already resolved and everything is typed: implicit `_`, named closure parameters, receivers and
 * implicit `self` show up as explicit `Parameter`, `Field` and `Call` nodes.
 *
 * An ordinary ADT. New node kinds come with new versions of the language; providers end their `match` with
 * `_ => Fail(Unsupported(...))` anyway, because they need that arm for calls they do not know.
 */
public type ExpressionNode {
  /** A literal value written in the source. */
  case Literal(value: EncodedValue, of: TypeReference)
  /** An explicit parameter of the quoted closure, or its implicit `_`. */
  case Parameter(index: Int, name: String, of: TypeReference)
  /** A binding from outside the quoted expression, captured by value. */
  case Captured(index: Int, name: String, of: TypeReference)
  /** A field read off `target`, or a receiver method turned into a field access. */
  case Field(target: Self, name: String, of: TypeReference)
  /** A method call on `target`, or a free function call when `target` is `None`. */
  case Call(target: Self?, owner: TypeReference, method: String, arguments: List<Self>, of: TypeReference)
  /** A constructor call for the type `of`. */
  case Construct(arguments: List<Self>, of: TypeReference)
  /** A prefix operator applied to `operand`. */
  case Unary(operator: UnaryOperator, operand: Self, of: TypeReference)
  /** An infix operator applied to `left` and `right`. */
  case Binary(operator: BinaryOperator, left: Self, right: Self, of: TypeReference)
  /** An `if`/`else` expression. */
  case Conditional(condition: Self, then: Self, else: Self, of: TypeReference)
  /** A closure literal, with its parameter names and its body. */
  case Lambda(parameters: List<String>, body: Self, of: TypeReference)
  /** A list or tuple literal. */
  case Items(items: List<Self>, of: TypeReference)
  /** `"{a} and {b}"`: literals and expressions in order. `?.` and `??` have no nodes, they are calls on `Option`. */
  case Interpolation(parts: List<Self>)

  /** All `Captured` nodes below this node, e.g. to explain a failed assertion. */
  fn capturedNodes(): List<Self> {
    match self {
      .Captured(_, _, _) => [self]
      .Field(target, _, _) => target.capturedNodes()
      .Call(target, _, _, arguments, _) =>
        (target.map { _.capturedNodes() } ?? []).appendedAll(arguments.flatMap { _.capturedNodes() })
      .Construct(arguments, _) => arguments.flatMap { _.capturedNodes() }.toList()
      .Unary(_, operand, _) => operand.capturedNodes()
      .Binary(_, left, right, _) => left.capturedNodes().appendedAll(right.capturedNodes())
      .Conditional(condition, then, otherwise, _) =>
        condition.capturedNodes().appendedAll(then.capturedNodes()).appendedAll(otherwise.capturedNodes())
      .Lambda(_, body, _) => body.capturedNodes()
      .Items(items, _) => items.flatMap { _.capturedNodes() }.toList()
      .Interpolation(parts) => parts.flatMap { _.capturedNodes() }.toList()
      _ => []
    }
  }
}

/**
 * The name of what was written, never its value: `nameOf(user.email)` is `"email"`, `nameOf(limit)` is `"limit"`.
 * For a type there is the compile-time function `typeName<User>()` instead.
 *
 * # Examples
 *
 *     // check
 *     fn label(value: Expression<Int>): String {
 *       nameOf value
 *     }
 *
 *     const limit = 5
 *     print label(limit)
 */
public fn nameOf<Value>(expression: Expression<Value>): String {
  match expression.tree {
    .Field(_, name, _) => name
    .Captured(_, name, _) => name
    .Parameter(_, name, _) => name
    .Call(_, _, method, _, _) => method
    _ => expression.source
  }
}

/**
 * Panics if `condition` is `false`. There are no matchers: the message names the source text of the condition and
 * every value the condition read from around it, one per line, and then the site:
 *
 *     panic: Assertion failed: count < limit
 *       count = the Int 7
 *       limit = the Int 5
 *       at acme/app/src/main.trb:12:1
 *
 * A **scalar** - every integer type, every float, `Bool`, `Char` and `String` - is shown as `the <kind> <value>`,
 * where the word is the language's name for the *kind* of value and not the name of its type, so `Int` for an `Int64`
 * and `Float` for a `Float64`. Everything else is shown by its name and its type, `found: Point`: a value of the
 * program shown in full needs the whole `Show` machinery of its type and of every type under it in the binary, and
 * one type that has none would refuse the whole build. Until a capture carries its own encoded value, that is the
 * one thing the two implementations word differently - the interpreter writes `a value of type List` where a
 * compiled binary writes the name and the type.
 *
 * # Examples
 *
 *     // check
 *     const limit = 5
 *     const count = 7
 *     assert(count < limit)
 *
 * # Panics
 *
 * When `condition` is `false`.
 */
public fn assert(condition: Expression<Bool>) {
  if condition.value() {
    return
  }
  const values = condition.captures()
  const details = condition.tree.capturedNodes().map { node =>
    match node {
      .Captured(index, name, _) => "{name} = {values[index]}"
      _ => ""
    }
  }
  const explanation = details.joined separator: ", "
  panic "Assertion failed: {condition.source}   ({explanation})   at {condition.location}"
}
