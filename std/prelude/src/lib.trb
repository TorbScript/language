/**
 * The prelude: what is in scope in every file of a project, unless its `project.trb` names another prelude.
 *
 * It declares nothing of its own. Everything it names lives in a package that can also be imported directly, and this
 * file is the decision about what "one always needs" - the pure things: values, text, numbers, collections, pipelines,
 * encoding, quotations, tasks, printing, JSON, the two time *values*, `Path` and `Uri`. The stage factories
 * (`mapping`, `filtering`, ...) are in as well; `std/linear` is not, and a program that computes with vectors imports it.
 *
 * **What a program can touch is not in here.** `std/fs`, `std/os`, `std/process`, `std/io`, `std/http`,
 * `std/sandbox` and `Clock` stay explicit imports, because there the import *is* the statement: "this file touches
 * files" is readable at the top of the file, a sandbox is defined as "the prelude and nothing else", and a name that
 * exists on one target and not on another would be a worse error than a missing import.
 */

public use Void, Never, panic, Bool, Option, Result, Error from "std/core"
// The one reason these four can be written without their type, in an expression and in a pattern
public use Option.Some, Option.None, Result.Ok, Result.Fail from "std/core"
public use Equals, Compare, Ordering, Hash, combineHashes from "std/core"
public use From, Into, TryFrom, TryInto, Show, LiteralParseError from "std/core"
public use Add, Subtract, Multiply, Divide, Remainder, Power, Negate, OrElse from "std/core"
public use Index, MutableIndex, Slice, MutableSlice from "std/core"
public use Range, RangeFrom, RangeTo, Bounds from "std/core"
public use Array, Shared, isSame from "std/core"
public use do, unless, retry, Close from "std/core"
public use Predicate, Action, Transform from "std/core"

public use Char, String, TextIndex from "std/text"

public use Numeric, Signed, Integer, Real, Bits, NumberParseError, NumberRangeError from "std/number"
public use Int8, Int16, Int32, Int64 from "std/number"
public use UInt8, UInt16, UInt32, UInt64 from "std/number"
public use Float32, Float64, Decimal from "std/number"
public use Int, UInt, Float from "std/number"

public use List, ArrayList, TrieList from "std/collections"
public use Map, TrieMap, HashMap, Set, TrieSet, HashSet from "std/collections"
public use Stack, ArrayStack, Queue, ArrayQueue from "std/collections"

public use Iterator, Iterate, Length from "std/iteration"
public use Stage from "std/iteration"
public use mapping, filtering, filterMapping, mappingWhile, flatMapping from "std/iteration"
public use taking, takingWhile, skipping, indexing, chunking from "std/iteration"
public use Accumulator, Merge, ListAccumulator, collector, mergingCollector, into, listing from "std/iteration"
public use counting, summing, averaging, minBy, maxBy, joining, partitioningBy, groupingBy from "std/iteration"

public use Encode, Decode, Describe, DecodeError, Format, rendered from "std/encoding"
public use Encoder, Decoder, Describer, FieldDescription, FieldDefault, EncodedValue from "std/encoding"

public use Expression, ExpressionNode, TypeReference, SourceLocation, UnaryOperator, BinaryOperator, assert, nameOf from "std/expression"
public use Task, Channel, ChannelClosed, Cancelled, TimedOut, spawn, both from "std/task"
// One thing going faster is the same sentence as one thing going at all, one word longer: `numbers.parallel().map(...)`
// needs no import. `map`, `filter` and the rest are members of `Parallel`, and `parallel` an extension member of
// every `Iterate` - of a `Cut` and of a `List` too, the more specific ones, which cut instead of reading everything first
public use Parallel from "std/parallel"
use Cut from "std/parallel"
public use Iterate.parallel, Cut.parallel, List.parallel from "std/parallel"
// `Source`, `Sink` and `Bytes` are vocabulary like `Iterate`: a signature says which end of a stream it wants, and
// the traits touch nothing by themselves - what touches something (`File`, standard input, a socket) stays an import
public use Source, Sink, Bytes from "std/stream"
public use print, printError from "std/console"

public use Json, JsonValue, JsonError from "std/json"
// The time *values* only. `Clock` reads the clock, which is a capability and therefore an import
public use Duration, Instant from "std/time"
// `2.seconds()`: a member `std/time` adds to a type of `std/number`, so the file that uses it names where it comes
// from - and this is that name for every file, because a duration written out is as basic as the two types above
public use Int64.seconds, Int64.milliseconds from "std/time"
// A path is a value like a duration: it names a file and reads nothing, so every signature may say `Path` without an
// import. What touches the file it names - `File`, `Directory` - is `std/fs`, and that stays an import
public use Path, PathError from "std/path"
// A URI is a value like a path: it names a resource and opens nothing, so a signature may say `Uri` or `UriReference`
// without an import. `Urn`, `UriTemplate` and the rest stay behind `use … from "std/uri"`; what reaches the resource a
// URI names - `std/http`, `std/network` - stays an import (docs/design/URI.md section 16, question 2)
public use Uri, UriReference, UriError from "std/uri"
