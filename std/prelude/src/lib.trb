/**
 * The prelude: what is in scope in every file of a project, unless its `project.trb` names another prelude.
 * The rest of the standard library are packages of their own (`std/fs`, `std/io`, `std/test`, ...) and imported
 * where they are needed.
 */

public use Void, Never from "./void"
public use Option from "./option"
public use Result from "./result"
// The one reason these four can be written without their type
public use Some, None from Option
public use Ok, Error from Result
public use print, printError, panic from "./console"

public use Equals, Compare, Ordering, Hash from "./compare"
public use From, Into, TryFrom, Parse, Show from "./convert"
public use Add, Subtract, Multiply, Divide, Remainder, Negate, Indexed, MutableIndexed, Slice, MutableSlice from "./operators"

public use Numeric, Signed, Bits, NumberParseError, NumberRangeError from "./numeric"
public use Int8, Int16, Int32, Int64 from "./numeric"
public use UInt8, UInt16, UInt32, UInt64 from "./numeric"
public use Float32, Float64, Decimal from "./numeric"
public use Int, UInt, Float from "./numeric"
public use Bool, Char, String from "./string"
public use Encode, Decode, DecodeError, describe from "./encoding"
public use Encoder, SequenceEncoder, MapEncoder, RecordEncoder from "./encoding"
public use Decoder, SequenceDecoder, MapDecoder, RecordDecoder from "./encoding"
public use Expression, ExpressionNode, TypeReference, SourceLocation, UnaryOperator, BinaryOperator, assert, nameOf from "./expression"

public use Iterator, Iterable, Length from "./iteration"
public use Range from "./range"
public use Collector, Accumulator, collector, into, listing from "./collectors"
public use counting, summing, averaging, minBy, maxBy, joining, partitioningBy, groupingBy from "./collectors"
public use Array from "./array"
// Collections: the traits are what signatures talk about, the implementations are what gets constructed
public use Collection from "./collections/collection"
public use List, ArrayList, TrieList from "./collections/list"
public use Map, TrieMap, HashMap from "./collections/map"
public use Set, TrieSet, HashSet from "./collections/set"
public use Stack, ArrayStack from "./collections/stack"
public use Queue, ArrayQueue from "./collections/queue"
public use Shared, isSame from "./shared"
public use Task, Channel, spawn, all from "./task"

public use do, unless, retry, using, Close from "./control"
