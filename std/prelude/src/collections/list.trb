use Equals, Compare, Hash, combineHashes from "../compare"
use MutableIndexed, MutableSlice from "../operators"
use From, Show from "../convert"
use Collection from "./collection"

/**
 * An ordered sequence, addressable by index. This is the type of the literal `[1, 2, 3]`.
 *
 *     var numbers = [3, 1, 2]
 *     numbers.add(4)                       // In place, needs `var`
 *     numbers[0] = 5
 *     numbers[1..3].sort()                 // A range is a path, too: sorts this part in place
 *     const more = numbers.added(6)        // The participle returns a changed copy
 */
public trait List<Item>
  with Collection<Item>, MutableIndexed<Int, Item>, MutableSlice
{
  /** `List.of(1, 2, 3)` or, with a spread, `List.of(...anyIterable)` */
  fn of(...items: Item): List<Item> {
    items
  }

  /** `List.filled(3, "-")` is `["-", "-", "-"]` */
  fn filled(count: Int, value: Item): List<Item> {
    (0..count).map { value }.toList()
  }

  // --- In place ------------------------------------------------------------------------------------

  fn insert(var self, index: Int, value: Item)
  fn removeAt(var self, index: Int): Item?
  fn reverse(var self)
  fn sort<Key: Compare>(var self, by: (value: Item) => Key)

  fn remove(var self, value: Item): Bool where Item: Equals {
    match indexOf(value) {
      Some(index) => {
        removeAt(index)
        true
      }
      .None => false
    }
  }

  fn swapAt(var self, first: Int, second: Int) {
    const value = self[first]
    self[first] = self[second]
    self[second] = value
  }

  /** Changes one element in place: `enemies.update(0) { enemy => enemy.health = 0 }` */
  fn update(var self, index: Int, change: (var element: Item) => Void) {
    change(self[index])
  }

  // --- Changed copies --------------------------------------------------------------------------------

  fn inserted(self, index: Int, value: Item): Self {
    var result = self
    result.insert(index, value)
    result
  }

  fn updated(self, index: Int, value: Item): Self {
    var result = self
    result[index] = value
    result
  }

  fn removedAt(self, index: Int): Self {
    var result = self
    result.removeAt(index)
    result
  }

  fn removed(self, value: Item): Self where Item: Equals {
    var result = self
    result.remove(value)
    result
  }

  fn reversed(self): Self {
    var result = self
    result.reverse()
    result
  }

  // --- Reading -----------------------------------------------------------------------------------------

  fn first(self): Item? {
    get(0)
  }

  fn last(self): Item? {
    get(length() - 1)
  }

  fn indexOf(self, value: Item): Int? where Item: Equals {
    indexed().find { _.1 == value }.map { _.0 }
  }
}

/** The factory picks the default implementation. This is also what makes `toList()` and `to<List<Item>>()` work. */
extend<Item> List<Item> with From<Iterable<Item>> {
  fn from(items: Iterable<Item>): List<Item> {
    ArrayList.from(items)
  }
}

/** `[1, 2, 3]`, and `[]` when it is empty - the format of the literal. */
extend<Item: Show> List<Item> with Show {
  fn show(self): String {
    const parts = map { _.showNested() }
    "[{String.join(parts, separator: ", ")}]"
  }
}

/** Equal when they have the same length and equal items in the same order. */
extend<Item: Equals> List<Item> with Equals {
  fn equals(self, other: Self): Bool {
    length() == other.length() && indexed().all { pair => pair.1 == other[pair.0] }
  }
}

/**
 * Order-dependent, unlike [Set.hash] and [Map.hash]: two lists with the same items in a different order differ.
 *
 * `Hash` requires `Equals`, and the `Equals` implementation above satisfies that: `Item: Hash` implies `Item: Equals`.
 */
extend<Item: Hash> List<Item> with Hash {
  fn hash(self): Int {
    fold(0) { seed, item => combineHashes(seed, item.hash()) }
  }
}

// --- Implementations -----------------------------------------------------------------------------------

/**
 * Contiguous, growable buffer - the default. The buffer is shared between copies and slices and only copied when
 * somebody writes to it while it is shared. Nobody can observe the difference.
 */
public native type ArrayList<Item>
  with List<Item>, From<Iterable<Item>>
{
  native fn from(items: Iterable<Item>): ArrayList<Item>
  native fn withCapacity(capacity: Int): ArrayList<Item>

  native fn length(self): Int
  native fn get(self, index: Int): Item?
  native fn iterator(self): Iterator<Item>
  native fn slice(self, range: Range<Int>): ArrayList<Item>

  native fn add(var self, value: Item)
  native fn set(var self, index: Int, value: Item)
  native fn insert(var self, index: Int, value: Item)
  native fn removeAt(var self, index: Int): Item?
  native fn replace(var self, range: Range<Int>, values: ArrayList<Item>)
  native fn reverse(var self)
  native fn sort<Key: Compare>(var self, by: (value: Item) => Key)
  native fn clear(var self)
  native fn compact(var self)
}

/**
 * Bit-partitioned trie. A write to a shared list copies one path (O(log n)) instead of the whole buffer:
 * the one for big lists that are kept in many versions (undo, history, snapshots).
 *
 * Until the trie exists, this name is a documented alias of [ArrayList]. Only performance differs: iteration order
 * and `Show` are the same either way.
 */
public native type TrieList<Item>
  with List<Item>, From<Iterable<Item>>
{
  native fn from(items: Iterable<Item>): TrieList<Item>

  native fn length(self): Int
  native fn get(self, index: Int): Item?
  native fn iterator(self): Iterator<Item>
  native fn slice(self, range: Range<Int>): TrieList<Item>

  native fn add(var self, value: Item)
  native fn set(var self, index: Int, value: Item)
  native fn insert(var self, index: Int, value: Item)
  native fn removeAt(var self, index: Int): Item?
  native fn replace(var self, range: Range<Int>, values: TrieList<Item>)
  native fn reverse(var self)
  native fn sort<Key: Compare>(var self, by: (value: Item) => Key)
  native fn clear(var self)
  native fn compact(var self)
}
