use From from "../convert"
use Collection from "./collection"

/**
 * LIFO stack. Iterates from top to bottom. `add` is `push`.
 *
 *     var pending = Stack.of(root)
 *     while const Some(node) = pending.pop() {
 *       pending.addAll(node.children)
 *     }
 *
 * In a `const` (or to keep the old version) use the participles:
 *
 *     if const Some((top, rest)) = stack.popped() { ... }
 */
public trait Stack<Item>
  with Collection<Item>
{
  /** The last item ends up on top. */
  fn of(...items: Item): Stack<Item> {
    ArrayStack.from(items)
  }

  // --- In place ------------------------------------------------------------------------------------

  fn push(var self, value: Item)
  fn pop(var self): Item?

  fn add(var self, value: Item) {
    push(value)
  }

  // --- Changed copies --------------------------------------------------------------------------------

  fn pushed(self, value: Item): Self {
    added(value)
  }

  /** The top element and the remaining stack, or `None` if the stack is empty. */
  fn popped(self): (Item, Self)? {
    var rest = self
    const top = rest.pop()?
    Some((top, rest))
  }

  fn peek(self): Item? {
    first()
  }
}

extend<Item> Stack<Item> with From<Iterable<Item>> {
  fn from(items: Iterable<Item>): Stack<Item> {
    ArrayStack.from(items)
  }
}

// --- Implementation, written in plain TorbScript ----------------------------------------------------------

/** A value, because it consists of values: nothing had to be done for that. */
public type ArrayStack<Item> with Stack<Item>, From<Iterable<Item>> {
  private var items: List<Item> = []

  fn from(items: Iterable<Item>): ArrayStack<Item> {
    Self(items.toList())
  }

  fn push(var self, value: Item) {
    items.add(value)
  }

  fn pop(var self): Item? {
    items.removeAt(items.length() - 1)
  }

  fn clear(var self) {
    items.clear()
  }

  fn length(self): Int {
    items.length()
  }

  fn iterator(self): Iterator<Item> {
    items.reversed().iterator()
  }
}
