use Equals, Hash from "./compare"
use Show from "./convert"

/**
 * The type with exactly one value - and the one name in the language that is both. `Void` is the result type of a
 * function that declares none, and `Void` is the value it returns:
 *
 *     fn start(): Result<Void, AppError> {
 *       setUp()?
 *       Ok(Void)
 *     }
 *
 * A block that ends in a statement has the value `Void`, too. It carries nothing, so it is no way from a type to a
 * value: there is nothing to look at.
 */
public native type Void with Equals, Hash, Show {}

/**
 * The type of an expression that does not return: `panic`, `return`, `break`, `continue`. It has no value at all,
 * which is why it converts to every type - `const port = config.port ?? panic "no port"` type checks as an `Int`.
 */
public native type Never {}
