/** `==` and `!=`. Generated structurally for every `type`. */
public trait Equals {
  fn equals(self, other: Self): Bool

  fn notEquals(self, other: Self): Bool {
    !equals(other)
  }
}

public type Ordering {
  case Less
  case Equal
  case Greater

  fn reversed(self): Ordering {
    match self {
      .Less => .Greater
      .Equal => .Equal
      .Greater => .Less
    }
  }
}

/** `<`, `<=`, `>`, `>=` */
public trait Compare with Equals {
  fn compare(self, other: Self): Ordering

  fn lessThan(self, other: Self): Bool {
    compare(other) == .Less
  }

  fn greaterThan(self, other: Self): Bool {
    compare(other) == .Greater
  }

  fn min(self, other: Self): Self {
    if lessThan(other) { self } else { other }
  }

  fn max(self, other: Self): Self {
    if greaterThan(other) { self } else { other }
  }

  fn clamp(self, low: Self, high: Self): Self {
    max(low).min(high)
  }
}

/** Generated structurally for every `type`. Values that are equal must have equal hashes. */
public trait Hash with Equals {
  fn hash(self): Int
}
