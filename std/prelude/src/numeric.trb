use Equals, Compare, Hash from "./compare"
use From, TryFrom, Parse, Show from "./convert"
use Add, Subtract, Multiply, Divide, Remainder, Negate from "./operators"

public trait Numeric
  with Add, Subtract, Multiply, Divide, Remainder, Equals, Compare, Show, Parse<NumberParseError> {}

public trait Signed
  with Numeric, Negate {
  fn absolute(self): Self
}

public type NumberParseError {
  text: String
}

public type NumberRangeError {
  message: String
}

// `native` types are represented by the runtime.
// The methods of the traits listed after `with` are provided by the runtime, too.

// The types always carry their width. This file uses the sized names only, because here the width is the point.

public native type Int8 with Signed, Hash {}
public native type Int16 with Signed, Hash {}
public native type Int32 with Signed, Hash {}
/** The type of integer literals. */
public native type Int64 with Signed, Hash {}

public native type UInt8 with Numeric, Hash {}
public native type UInt16 with Numeric, Hash {}
public native type UInt32 with Numeric, Hash {}
public native type UInt64 with Numeric, Hash {}

public native type Float32 with Signed {}
/** The type of decimal literals. */
public native type Float64 with Signed {}

/** Exact base-10 arithmetic. Decimal literals adapt to it: `const price: Decimal = 19.99` */
public native type Decimal with Signed, Hash {}

// The defaults. Plain aliases, nothing the language treats specially.
public type Int = Int64
public type UInt = UInt64
public type Float = Float64

extend Int64 {
  /** Digits in another base: `Int.parseDigits("ff", radix: 16)`. No sign, no prefix, `_` is allowed between digits. */
  native fn parseDigits(text: String, radix: Int64): Result<Int64, NumberParseError>
}

extend Float64 {
  const pi: Float64 = 3.141592653589793
  const e: Float64 = 2.718281828459045

  native fn squareRoot(self): Float64
  native fn floor(self): Float64
  native fn ceiling(self): Float64
  native fn round(self): Float64
  native fn isNaN(self): Bool

  /** Floats are compared with a tolerance: `assert(length.isCloseTo(1.0))` */
  fn isCloseTo(self, other: Float64, tolerance: Float64 = 0.000001): Bool {
    (self - other).absolute() <= tolerance
  }
}

// Widening conversions are infallible...
extend Int64 with From<Int32> {
  native fn from(value: Int32): Int64
}

extend Float64 with From<Int64> {
  native fn from(value: Int64): Float64
}

extend Float64 with From<Float32> {
  native fn from(value: Float32): Float64
}

// ...narrowing conversions are not.
extend Int32 with TryFrom<Int64, NumberRangeError> {
  native fn tryFrom(value: Int64): Result<Int32, NumberRangeError>
}

extend Int64 with TryFrom<Float64, NumberRangeError> {
  native fn tryFrom(value: Float64): Result<Int64, NumberRangeError>
}
