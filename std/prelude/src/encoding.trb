/**
 * Encoding and decoding: what other languages need reflection for (serialization, config mapping, database rows).
 *
 *     const text = Json.encode(user)
 *     const user = Json.decode<User>(text)?
 *
 * A type describes itself to an `Encoder` and reads itself from a `Decoder`. A format (`Json`, `Toml`, a database
 * driver) is an implementation of these two traits and never sees a type. There is no tree in between: values are
 * written while the type describes itself, and nothing is lost on the way.
 *
 * `Encode` is generated for every type whose fields are all `Encode`. `Decode` is generated if, in addition, the
 * constructor is usable from outside. The generated code is exactly what one would write by hand:
 *
 *     extend User with Encode, Decode {
 *       fn encode(self, var encoder: Encoder) {
 *         encoder.record("User") { fields =>
 *           fields.field("name", name)
 *           fields.field("tags", tags)
 *         }
 *       }
 *
 *       fn decode(var decoder: Decoder): Result<User, DecodeError> {
 *         decoder.record("User") { fields =>
 *           Ok(User(
 *             name: fields.field("name")?,
 *             tags: fields.fieldOr("tags", [])?,        // Fields with a default value may be missing
 *           ))
 *         }
 *       }
 *     }
 */

use Hash from "./compare"
use Show from "./convert"

public trait Encode {
  fn encode(self, var encoder: Encoder)
}

public trait Decode {
  fn decode(var decoder: Decoder): Result<Self, DecodeError>
}

public type DecodeError with Show {
  message: String
  path: List<String> = []

  /** `error.inside("email")`: errors collect the path on their way out. */
  fn inside(self, segment: String): DecodeError {
    copy(path: path.inserted(0, segment))
  }

  fn show(self): String {
    if path.isEmpty() {
      return message
    }
    const location = path.joined(separator: ".")
    "{location}: {message}"
  }
}

// --- What a format implements: writing --------------------------------------------------------------------------

/** The methods are named after the types of the language. Narrow numbers are widened, so nothing is lost. */
public trait Encoder {
  fn nothing(var self)
  fn bool(var self, value: Bool)
  fn int(var self, value: Int64)
  fn unsigned(var self, value: UInt64)
  fn float(var self, value: Float64)
  fn decimal(var self, value: Decimal)
  fn string(var self, value: String)
  fn bytes(var self, value: List<UInt8>)

  /** `length` is known for collections and unknown for pipelines. Items are written one by one: this streams. */
  fn sequence(var self, length: Int?, write: (var items: SequenceEncoder) => Void)
  fn map(var self, length: Int?, write: (var entries: MapEncoder) => Void)
  fn record(var self, typeName: String, write: (var fields: RecordEncoder) => Void)
  fn variant(var self, typeName: String, name: String, write: (var fields: RecordEncoder) => Void)
}

public trait SequenceEncoder {
  fn item(var self, value: Encode)
}

public trait MapEncoder {
  fn entry(var self, key: Encode, value: Encode)
}

public trait RecordEncoder {
  fn field(var self, name: String, value: Encode)
}

// --- What a format implements: reading ---------------------------------------------------------------------------

/**
 * Reading is driven by the type: it asks for what it expects and gets an error if something else is there.
 * (A format with unordered fields, like JSON, buffers one record at a time. Sequences are streamed.)
 */
public trait Decoder {
  /** Consumes a "nothing" if there is one. This is how `Option` decides between `None` and `Some`. */
  fn nothing(var self): Bool

  fn bool(var self): Result<Bool, DecodeError>
  fn int(var self): Result<Int64, DecodeError>
  fn unsigned(var self): Result<UInt64, DecodeError>
  fn float(var self): Result<Float64, DecodeError>
  fn decimal(var self): Result<Decimal, DecodeError>
  fn string(var self): Result<String, DecodeError>
  fn bytes(var self): Result<List<UInt8>, DecodeError>

  fn sequence<Output>(
    var self,
    read: (var items: SequenceDecoder) => Result<Output, DecodeError>,
  ): Result<Output, DecodeError>

  fn map<Output>(
    var self,
    read: (var entries: MapDecoder) => Result<Output, DecodeError>,
  ): Result<Output, DecodeError>

  fn record<Output>(
    var self,
    typeName: String,
    read: (var fields: RecordDecoder) => Result<Output, DecodeError>,
  ): Result<Output, DecodeError>

  fn variant<Output>(
    var self,
    typeName: String,
    read: (name: String, var fields: RecordDecoder) => Result<Output, DecodeError>,
  ): Result<Output, DecodeError>
}

public trait SequenceDecoder {
  /** `None` at the end of the sequence. */
  fn next<Item: Decode>(var self): Result<Item?, DecodeError>
}

public trait MapDecoder {
  fn next<Key: Decode, Value: Decode>(var self): Result<(Key, Value)?, DecodeError>
}

public trait RecordDecoder {
  fn field<Value: Decode>(var self, name: String): Result<Value, DecodeError>
  fn fieldOr<Value: Decode>(var self, name: String, default: lazy Value): Result<Value, DecodeError>
}

/** Any `Encode` value as readable text, for messages and debugging: `User(name: "Ada", tags: ["math"])` */
public native fn describe(value: Encode): String

// --- The standard library describes itself, too --------------------------------------------------------------------

extend Bool with Encode, Decode {
  fn encode(self, var encoder: Encoder) {
    encoder.bool(self)
  }

  fn decode(var decoder: Decoder): Result<Bool, DecodeError> {
    decoder.bool()
  }
}

extend Int64 with Encode, Decode {
  fn encode(self, var encoder: Encoder) {
    encoder.int(self)
  }

  fn decode(var decoder: Decoder): Result<Int64, DecodeError> {
    decoder.int()
  }
}

/** Narrow numbers travel as `Int64` and are checked on the way back. */
extend Int8 with Encode, Decode {
  fn encode(self, var encoder: Encoder) {
    encoder.int(Int64.from(self))
  }

  fn decode(var decoder: Decoder): Result<Int8, DecodeError> {
    const wide = decoder.int()?
    Int8.tryFrom(wide).mapError { DecodeError("{wide} does not fit into Int8") }
  }
}

/*
 * Every other number and the `Char`. They carry no `Decode` yet - `Decode` needs a `TryFrom` back, and only `Int8`,
 * `Int32` and `Int64` have one - but `Encode` is what a value has to have to be *looked at*: `describe(value)` renders
 * one, a quotation hands its captures on as `Encode` values (gap 36), and a SQL driver binds them as parameters. Without
 * these, a `Float64` field would make a whole syntax tree unshowable.
 */
extend Int16 with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.int(Int64.from(self))
  }
}

extend Int32 with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.int(Int64.from(self))
  }
}

extend UInt8 with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.int(Int64.from(self))
  }
}

extend UInt16 with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.int(Int64.from(self))
  }
}

extend UInt32 with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.int(Int64.from(self))
  }
}

extend UInt64 with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.unsigned(self)
  }
}

extend Float32 with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.float(Float64.from(self))
  }
}

extend Float64 with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.float(self)
  }
}

extend Decimal with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.decimal(self)
  }
}

/** A `Char` travels as a text of one character: the formats of the language have no character of their own. */
extend Char with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.string(show())
  }
}

extend String with Encode, Decode {
  fn encode(self, var encoder: Encoder) {
    encoder.string(self)
  }

  fn decode(var decoder: Decoder): Result<String, DecodeError> {
    decoder.string()
  }
}

extend<Value: Encode> Option<Value> with Encode {
  fn encode(self, var encoder: Encoder) {
    match self {
      Some(value) => value.encode(encoder)
      .None => encoder.nothing()
    }
  }
}

extend<Value: Decode> Option<Value> with Decode {
  fn decode(var decoder: Decoder): Result<Value?, DecodeError> {
    if decoder.nothing() {
      return Ok(None)
    }
    Ok(Some(Value.decode(decoder)?))
  }
}

/** Lists and sets are sequences. A `Set` stays a `Set`: the target type decides on the way back. */
extend<Item: Encode> List<Item> with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.sequence(Some(length())) { items =>
      for value in self {
        items.item(value)
      }
    }
  }
}

extend<Item: Encode> Set<Item> with Encode {
  fn encode(self, var encoder: Encoder) {
    toList().encode(encoder)
  }
}

extend<Key: Encode, Value: Encode> Map<Key, Value> with Encode {
  fn encode(self, var encoder: Encoder) {
    encoder.map(Some(length())) { entries =>
      for (key, value) in self {
        entries.entry(key, value)
      }
    }
  }
}

extend<Item: Decode> List<Item> with Decode {
  fn decode(var decoder: Decoder): Result<List<Item>, DecodeError> {
    decoder.sequence { items =>
      var result: List<Item> = []
      while const Some(value) = items.next()? {
        result.add(value)
      }
      Ok(result)
    }
  }
}

extend<Item: Decode & Hash> Set<Item> with Decode {
  fn decode(var decoder: Decoder): Result<Set<Item>, DecodeError> {
    Ok((List<Item>.decode(decoder)?).toSet())
  }
}

extend<Key: Decode & Hash, Value: Decode> Map<Key, Value> with Decode {
  fn decode(var decoder: Decoder): Result<Map<Key, Value>, DecodeError> {
    decoder.map { entries =>
      var result: Map<Key, Value> = [:]
      while const Some((key, value)) = entries.next()? {
        result[key] = value
      }
      Ok(result)
    }
  }
}
