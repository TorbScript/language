/**
 * UTF-8 text and the Unicode scalar value it is made of: [Char], one Unicode scalar value, and [String], a sequence
 * of them stored as UTF-8. `Bool` belongs to `std/core`, not here - it is a primitive of the language, not a fact
 * about text.
 */

use Equals, Compare, Ordering, Hash, Show, From, TryFrom, Add from "std/core"
use Int64, NumberRangeError from "std/number"
use Iterate, Length, concatenated from "std/iteration"

/**
 * A Unicode scalar value: one character, decoded from UTF-8.
 *
 * # Examples
 *
 *     const letter = 'A'
 *     print letter.toLowerCase()
 *
 * # Related
 *
 * - [String] - text made of many of them.
 */
public native type Char with Equals, Compare, Hash, Show {
  /** Whether the character is a decimal digit: `0` to `9`, and nothing else. */
  native fn isDigit(): Bool
  /** Whether the character is a letter. Exact for ASCII, and by the division Latin-1 itself makes above it. */
  native fn isLetter(): Bool
  /** Whether the character is whitespace: the ASCII ones, plus the `White_Space` code points a text really carries. */
  native fn isWhitespace(): Bool

  /** The number of bytes of the character in UTF-8 (1 to 4): what it adds to an offset into a `String`. */
  native fn byteLength(): Int
  /**
   * The same character in upper case, or itself where there is no single upper-case code point for it.
   *
   * This is the **simple** case mapping: one code point in, one code point out, over ASCII, over the letters of
   * Latin-1 and over the one pair that reaches out of it (`ÿ` to `Ÿ`). So `ß` is answered unchanged - its upper case is
   * `SS`, which is two code points and does not fit a `Char` - and so is every code point the mapping does not cover.
   *
   * # Pitfalls
   *
   * Upper-casing a text character by character is therefore not the same as a full Unicode mapping, and is what
   * [String.toUpperCase] does today.
   */
  native fn toUpperCase(): Self
  /** The same character in lower case, or itself where there is none. The mirror of [Char.toUpperCase]. */
  native fn toLowerCase(): Self

  /** `'A'`: inside of another value a character is written in single quotes, with escapes. */
  native fn showNested(): String
}

/**
 * A position in one text: before one of its characters, or at its end. Only a text hands one out - its searches, its
 * [String.start] and [String.end], [String.indexAfter] - so a position inside of a character cannot be written, and
 * `text[at..]` with an `at` that `text.indexOf` answered cannot panic (docs/design/PANICS.md section 4). `text[3..]` is
 * a compile error: a number counted by eye is exactly what lands inside of a character.
 *
 * It holds a byte offset, which is what makes slicing at one O(1) and lets the slice share the storage. There is no
 * arithmetic on it - `at + 1` is the mistake the type exists to prevent, and [String.indexAfter] is what it means. A
 * number from outside - a file format, an editor - becomes one through [String.indexAt], which checks it, and one goes
 * back to a number through [String.byteOffset].
 *
 * A position of one text used on another is a broken promise of the program, as an index of one list used on another
 * is: slicing there panics where it is past the end or inside of a character of the text it is used on.
 *
 * # Examples
 *
 *     const text = "Grüße 👋"
 *     match text.indexOf("ß") {
 *       Some(at) => print text[at..]
 *       None => print "no ß"
 *     }
 *
 * # Related
 *
 * - [String.indexOf] - where most of them come from.
 * - [String.dropping] - a number of characters instead of a position.
 */
public type TextIndex with Equals, Compare, Hash, Show {
  private offset: Int

  /** The order of two positions in one text: the earlier one first. */
  fn compare(other: Self): Ordering {
    offset.compare other.offset
  }

  /** The byte offset, which is what a position is and what a message about one names. */
  fn show(): String {
    "{offset}"
  }
}

/**
 * UTF-8 text. There is no `length()` and no `text[i]` on purpose: say what you count (`chars()`, `bytes()`).
 * Positions come from searching and are a [TextIndex]: only the text hands them out, so slicing at one is O(1), shares
 * the storage and cannot land inside of a character. The byte-level members - `byteLength`, `byteAt`, `sliceBytes`,
 * `byteOffsetOf` - are for a format that counts bytes.
 *
 * **A `String` is always valid UTF-8.** The only ways in are literals, slices at character boundaries,
 * `String.from(Iterate<Char>)` and runtime functions that validate - so reading a file whose bytes are not UTF-8 is
 * an `IoError`, and there is no replacement character anywhere in the language.
 *
 * # Examples
 *
 *     const greeting = "Hello, World!"
 *     print greeting.toUpperCase()
 *     print greeting.split(", ")
 *
 * # Related
 *
 * - [Char] - one Unicode scalar value of the text.
 * - [Show] - `show()` is the text unquoted, `showNested()` is quoted with escapes.
 */
public native type String
  with Equals, Compare, Hash, Show, Add, Slice<TextIndex>, From<Iterate<Char>>
{
  /**
   * `String.from(characters)`, `characters.to<String>()`.
   *
   * Ordinary TorbScript, and it **cannot** be a function of the runtime for the same reason `ArrayList.from` cannot be
   * one: `value` is a trait-typed `Iterate` of the *program*, so reading it means calling `iterate` and `next` through
   * a witness table, which C code cannot do. So it collects the characters and hands them to [concatenated]: a `String`
   * is a value, so appending to one in a loop copies everything that is already in it, which is `O(n²)` in the bytes.
   */
  static fn from(value: Iterate<Char>): Self {
    var pieces: List<Self> = []
    for character in value {
      pieces.append character.show()
    }
    concatenated pieces, ""
  }

  /** The characters, decoded one at a time: `for character in text.chars()`. Ordinary TorbScript, see [Characters]. */
  fn chars(): Iterate<Char> {
    Characters self
  }

  /**
   * The bytes of the UTF-8, in order, as a list of their own: `Bytes`, which is what a sink, a socket, a file and a
   * digest take. One allocation and one copy of the storage, never a byte at a time; changing the list changes
   * nothing of the text.
   *
   * It is a list and not a lazy view like [String.chars], because almost every caller wants the list. A loop that only
   * reads and must not allocate walks [String.byteAt] up to [String.byteLength] instead.
   *
   * # Examples
   *
   *     const bytes = "hé".bytes()
   *     print bytes
   */
  fn bytes(): Bytes {
    var result: ArrayList<UInt8> = ArrayList.withCapacity byteLength()
    copyBytes result
    result
  }

  /** The character that begins at `at`, or `None` at the end. A position is never inside of a character. */
  fn charAt(at: TextIndex): Char? {
    charAtByte at.offset
  }

  /**
   * The character that begins at this byte offset, or `None` at and past the end: the byte-level form of [String.charAt]
   * for a format that counts bytes. An offset *inside* a character panics like every other bad offset.
   */
  native fn charAtByte(offset: Int): Char?

  /** The position before the first character. */
  fn start(): TextIndex {
    TextIndex 0
  }

  /** The position after the last character. */
  fn end(): TextIndex {
    TextIndex byteLength()
  }

  /** The position after the character that begins at `at`, or `None` at the end. O(1). */
  fn indexAfter(at: TextIndex): TextIndex? {
    const found = charAtByte(at.offset)?
    TextIndex(at.offset + found.byteLength())
  }

  /** The position before the character that ends at `at`, or `None` at the start. O(1): at most four bytes back. */
  fn indexBefore(at: TextIndex): TextIndex? {
    if at.offset <= 0 || at.offset > byteLength() {
      return None
    }
    var offset = at.offset - 1
    while offset > 0 && isContinuation(byteAt(offset) ?? 0) {
      offset = offset - 1
    }
    TextIndex offset
  }

  /**
   * The position at a byte offset, or `None` where the offset is past the end or inside of a character: how a number
   * from outside - a file format, an editor, a span of a lexer - becomes a position, checked.
   */
  fn indexAt(byteOffset: Int): TextIndex? {
    if byteOffset < 0 || !isBoundary(self, byteOffset) {
      return None
    }
    TextIndex byteOffset
  }

  /** The byte offset of a position: for arithmetic on lines and columns, and for a format that counts bytes. */
  fn byteOffset(of: TextIndex): Int {
    of.offset
  }

  /** Every character with the position it begins at: what a scanner walks. */
  fn indexedChars(): Iterate<(index: TextIndex, character: Char)> {
    IndexedCharacters self
  }

  /** The byte at this offset, or `None` at and past the end. A byte is never inside anything, so this never panics. */
  native fn byteAt(offset: Int): UInt8?

  /**
   * Appends the bytes of the UTF-8 to `into` in one copy: what [String.bytes] answers its list with. A native because it
   * reads raw storage, and because a loop over [String.byteAt] would pay a call and an `Option` per byte. The storage
   * itself cannot become the list's: a text's and a list's are laid out differently (`torb_bytes` has neither the
   * element descriptor nor the length a list's storage starts with).
   */
  private native fn copyBytes(var into: ArrayList<UInt8>)

  /** How many bytes the text takes up in UTF-8. There is no shortcut for the number of characters: that means decoding. */
  native fn byteLength(): Int
  /** Whether the text has no bytes at all. [String.isBlank] also treats pure whitespace as empty. */
  native fn isEmpty(): Bool

  /** `"a\nb"`: inside of another value a string is quoted, with escapes. `show()` is the text itself. */
  native fn showNested(): Self

  /**
   * `text[from..to]` between two positions of this text. A position of another text that is past the end of this one
   * or inside one of its characters panics, and so does a start after the end.
   *
   * What an **open end** means is the receiver's decision (`std/core`'s `Bounds` says so), and for a text it is its
   * start and its end. An inclusive range (`from..=to`) takes the character that begins at `to` as well.
   */
  fn slice(range: Bounds<TextIndex>): Self {
    const from = range.lowest()?.offset ?? 0
    const written = range.highest()?.offset ?? byteLength()
    const to = if range.includesHighest() { endOfCharacter self, written } else { written }
    sliceBytes(from, to)
  }

  /**
   * The text the range covers, or `None` where it would panic - a position past the end or inside of a character,
   * which only a position of another text can be, or a start after the end: the total twin of `text[from..to]`.
   *
   * # Examples
   *
   *     const text = "Grüße"
   *     const at = text.indexOf("ß") ?? text.end()
   *     print text.part(text.start()..at)
   */
  fn part(range: Bounds<TextIndex>): Self? {
    const from = range.lowest()?.offset ?? 0
    const written = range.highest()?.offset ?? byteLength()
    if range.includesHighest() && written >= byteLength() {
      return None
    }
    if !isBoundary(self, from) || !isBoundary(self, written) {
      return None
    }
    const to = if range.includesHighest() { endOfCharacter self, written } else { written }
    if from > to {
      return None
    }
    sliceBytes(from, to)
  }

  /** The bytes from one offset to another. The one form the runtime has, and what `slice` decides its offsets for. */
  native fn sliceBytes(from: Int, to: Int): Self

  /** Whether `part` occurs anywhere in the text. */
  native fn contains(part: Self): Bool
  /** Whether the text begins with `prefix`. */
  native fn startsWith(prefix: Self): Bool
  /** Whether the text ends with `suffix`. */
  native fn endsWith(suffix: Self): Bool
  /**
   * Where the first occurrence of `part` begins, or `None` if it does not occur. An empty part is at the start.
   *
   * # Examples
   *
   *     const path = "a/b/c"
   *     if const Some(at) = path.indexOf("/") {
   *       print path[..at]
   *     }
   */
  fn indexOf(part: Self): TextIndex? {
    byteOffsetOf(part).map { TextIndex _ }
  }

  /**
   * Where the **last** occurrence of `part` begins, or `None` if it does not occur. An empty part is at the end of the
   * text, which is where a search backwards finds it first.
   *
   * # Related
   *
   * - [String.indexOf] - the same search from the front.
   */
  fn lastIndexOf(part: Self): TextIndex? {
    lastByteOffsetOf(part).map { TextIndex _ }
  }

  /** The byte offset of the first occurrence of `part`: [String.indexOf] for a format that counts bytes. */
  native fn byteOffsetOf(part: Self): Int?

  /** The byte offset of the last occurrence of `part`: [String.lastIndexOf] for a format that counts bytes. */
  native fn lastByteOffsetOf(part: Self): Int?

  /** Everything before the first occurrence of `part`, or `None` if it does not occur. */
  fn substringBefore(part: Self): Self? {
    byteOffsetOf(part).map { sliceBytes 0, _ }
  }

  /** Everything after the first occurrence of `part`, or `None` if it does not occur. */
  fn substringAfter(part: Self): Self? {
    byteOffsetOf(part).map { sliceBytes(_ + part.byteLength(), byteLength()) }
  }

  /**
   * The text without `part` at its start, or `None` where it does not start with it. It cannot panic: what it cuts off
   * is a whole text, so the cut is at a character boundary whatever the text holds.
   *
   * # Examples
   *
   *     print("--verbose".withoutPrefix("--") ?? "not an option")
   *
   * # Related
   *
   * - [String.withoutSuffix] - the same at the end.
   * - [String.dropping] - a number of characters instead of a text.
   */
  fn withoutPrefix(part: Self): Self? {
    if !startsWith(part) {
      return None
    }
    sliceBytes part.byteLength(), byteLength()
  }

  /**
   * The text without `part` at its end, or `None` where it does not end with it.
   *
   * # Examples
   *
   *     print("main.trb".withoutSuffix(".trb") ?? "main")
   */
  fn withoutSuffix(part: Self): Self? {
    if !endsWith(part) {
      return None
    }
    sliceBytes(0, byteLength() - part.byteLength())
  }

  /**
   * The text before and after the first occurrence of `separator`, which is dropped, or `None` where it does not
   * occur. One search, and no offset to get wrong - Go's `strings.Cut`.
   *
   * # Examples
   *
   *     match "name: Ada".splitOnce(": ") {
   *       Some(parts) => print "{parts.before} is {parts.after}"
   *       None => print "no field"
   *     }
   *
   * # Related
   *
   * - [String.split] - at every occurrence.
   * - [String.substringBefore], [String.substringAfter] - one of the two halves.
   */
  fn splitOnce(separator: Self): (before: Self, after: Self)? {
    const at = byteOffsetOf(separator)?
    const before = sliceBytes 0, at
    const after = sliceBytes(at + separator.byteLength(), byteLength())
    (before, after)
  }

  /**
   * The text without its first `characters` characters. Total: a text with fewer characters answers the empty text,
   * and a count of zero or less the whole one, as `skip` of an `Iterate` does. O(n) in the count, not in the text.
   *
   * A character is a Unicode scalar value, a [Char] of `chars()`.
   *
   * # Examples
   *
   *     print "Grüße".dropping(characters: 3)
   *
   * # Related
   *
   * - [String.prefix] - the characters this drops.
   * - [String.droppingLast] - the same at the end.
   */
  fn dropping(characters: Int): Self {
    sliceBytes offsetAfter(self, characters), byteLength()
  }

  /**
   * The text without its last `characters` characters: the empty text where it has fewer, the whole one for a count of
   * zero or less. O(n) in the count.
   *
   * # Examples
   *
   *     print "Grüße".droppingLast(characters: 2)
   */
  fn droppingLast(characters: Int): Self {
    sliceBytes 0, offsetBefore(self, characters)
  }

  /**
   * The first `characters` characters of the text: the whole text where it has fewer, the empty one for a count of zero
   * or less, as `take` of an `Iterate` does. O(n) in the count.
   *
   * # Examples
   *
   *     print "Grüße".prefix(characters: 3)
   *
   * # Related
   *
   * - [String.suffix] - the last ones.
   */
  fn prefix(characters: Int): Self {
    sliceBytes 0, offsetAfter(self, characters)
  }

  /**
   * The last `characters` characters of the text: the whole text where it has fewer, the empty one for a count of zero
   * or less. O(n) in the count.
   *
   * # Examples
   *
   *     print "Grüße".suffix(characters: 2)
   */
  fn suffix(characters: Int): Self {
    sliceBytes offsetBefore(self, characters), byteLength()
  }

  /** The text with leading and trailing whitespace removed. */
  native fn trim(): Self
  /**
   * The text in upper case: [Char.toUpperCase] for every character, and nothing more.
   *
   * Every pair of that mapping needs as many bytes as the character it came from, so the result is exactly as long as
   * the text. A full Unicode mapping may make a text *longer* (`ß` becomes `SS`), and this one therefore leaves such a
   * character alone.
   */
  native fn toUpperCase(): Self
  /** The text in lower case: [Char.toLowerCase] for every character. The mirror of [String.toUpperCase]. */
  native fn toLowerCase(): Self
  /** Every occurrence of `part`, replaced with `replacement`. */
  native fn replace(part: Self, replacement: Self): Self
  /** The text cut apart at every occurrence of `separator`, which is dropped. */
  native fn split(separator: Self): List<Self>
  /**
   * The text, written after itself `times` times: `"ab".repeat(3)` is `"ababab"`.
   *
   * # Panics
   *
   * When `times` is negative, and with `a text longer than 4 GiB is not supported` when the result would be longer
   * than a text can be.
   */
  native fn repeat(times: Int): Self

  /** Whether the text is empty or holds nothing but whitespace. */
  fn isBlank(): Bool {
    trim().isEmpty()
  }

  /** The text cut apart at every `\n`. */
  fn lines(): List<Self> {
    split "\n"
  }
}

/** The byte offset after the first `count` characters of `text`, or its end where it has fewer. */
fn offsetAfter(text: String, count: Int): Int {
  var offset = 0
  var remaining = count
  while remaining > 0 {
    const found = text.charAtByte offset
    if const Some(character) = found {
      offset = offset + character.byteLength()
    } else {
      return offset
    }
    remaining = remaining - 1
  }
  offset
}

/**
 * The byte offset before the last `count` characters of `text`, or `0` where it has fewer. A character begins at the
 * first byte walking backwards that is not a continuation byte (`10xxxxxx`, 128 to 191), which a valid text always has.
 */
fn offsetBefore(text: String, count: Int): Int {
  var offset = text.byteLength()
  var remaining = count
  while remaining > 0 && offset > 0 {
    offset = offset - 1
    while offset > 0 && isContinuation(text.byteAt(offset) ?? 0) {
      offset = offset - 1
    }
    remaining = remaining - 1
  }
  offset
}

/** The offset after the character that begins at `offset`: where an inclusive range of positions ends. */
fn endOfCharacter(text: String, offset: Int): Int {
  match text.charAtByte(offset) {
    Some(character) => offset + character.byteLength()
    None => offset + 1
  }
}

/** Whether a character begins at `offset`, or it is the end of the text: where a text may be cut. */
fn isBoundary(text: String, offset: Int): Bool {
  match text.byteAt(offset) {
    Some(byte) => !isContinuation(byte)
    None => offset == text.byteLength()
  }
}

fn isContinuation(byte: UInt8): Bool {
  byte >= 128 && byte < 192
}

/**
 * The characters of a text, and the cursor that walks them: a stage plus an iterator, the shape every `Iterate` of the
 * standard library has (`ListIterator`, and the stages of `std/iteration`).
 *
 * Neither is exported, exactly as the stages of a pipeline are not: `chars()` answers an `Iterate<Char>` and which type
 * carries it is nobody's business. The cursor holds the text **by value** and a byte offset, so a copy of it forks it and
 * nothing can move it from outside; `charAtByte` decodes the character at the offset and `Char.byteLength()` says how far to
 * move, so walking a text is O(1) per character and never a re-scan.
 */
type Characters with Iterate<Char> {
  text: String

  fn iterate(): Iterator<Char> {
    CharacterIterator text
  }
}

type CharacterIterator with Iterator<Char> {
  text: String
  var offset: Int = 0

  var fn next(): Char? {
    const found = text.charAtByte offset
    if const Some(character) = found {
      offset = offset + character.byteLength()
      return character
    }
    None
  }
}

/** The characters of a text with the position each begins at: [String.indexedChars]. */
type IndexedCharacters with Iterate<(index: TextIndex, character: Char)> {
  text: String

  fn iterate(): Iterator<(index: TextIndex, character: Char)> {
    IndexedCharacterIterator text
  }
}

type IndexedCharacterIterator with Iterator<(index: TextIndex, character: Char)> {
  text: String
  var offset: Int = 0

  var fn next(): (index: TextIndex, character: Char)? {
    const found = text.charAtByte offset
    if const Some(character) = found {
      const at = TextIndex offset
      offset = offset + character.byteLength()
      return (at, character)
    }
    None
  }
}

// `Int.from('A')` is the other direction and belongs to `std/number`, which owns `Int64`: an implementation belongs to
// the package of the type or to the package of the trait, and neither is this one.

/** Not every number is a Unicode scalar value (surrogates, everything above 0x10FFFF). */
extend Char with TryFrom<Int64, NumberRangeError> {
  native static fn tryFrom(value: Int64): Result<Self, NumberRangeError>
}
