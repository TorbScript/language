/**
 * The system questions in a web browser, where the playground runs `torb` as WebAssembly (docs/design/RELEASE.md
 * section 6). A page cannot ask the machine anything, so there are no natives here: what a browser knows is answered
 * in TorbScript, and the rest is `Unsupported`.
 */

use OperatingSystem, Architecture from "std/core"
use OsError from "../error"
use SystemVersion from "../system"

/** A page learns nothing about the system it runs on. */
public fn version(): Result<SystemVersion, OsError> {
  Fail OsError.Unsupported("the version", OperatingSystem.Browser)
}

/** A page has no host name of its own. */
public fn hostName(): Result<String, OsError> {
  Fail OsError.Unsupported("the host name", OperatingSystem.Browser)
}

/** A page does not know when the machine started. */
public fn uptime(): Result<Duration, OsError> {
  Fail OsError.Unsupported("the uptime", OperatingSystem.Browser)
}

/** The page of WebAssembly's memory: 64 KiB, whatever the machine's own page is. */
public fn pageSize(): Int {
  65536
}

/** The machine a WebAssembly program runs on is WebAssembly's. */
public fn machineArchitecture(): Result<Architecture, OsError> {
  Architecture.Wasm64
}
