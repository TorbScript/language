/**
 * The directories in a web browser. The file system of the playground is in memory and belongs to no user, so a
 * browser has no home and none of the bases below it; the temporary directory is `/tmp` of that memory.
 */

use OperatingSystem from "std/core"
use Path from "std/path"
use OsError from "../error"

/** No user owns the file system of a page. */
public fn unsupported(question: String): Result<Path, OsError> {
  Fail OsError.Unsupported(question, OperatingSystem.Browser)
}

/** `/tmp` of the file system in memory. */
public fn temporary(): Path {
  Path.from "/tmp"
}
