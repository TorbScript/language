/**
 * The raw layer of macOS: the natives of `runtime/os/macos.c`, which exist in a macOS build only. The manifest says so
 * (`availableOn`), and a call that the build for another system reaches is a compile error there - reach it from a
 * `.MacOs` arm of `match OperatingSystem.current`. What macOS shares with FreeBSD is `../bsd/native`, and what it
 * shares with every POSIX system is `../posix/native`.
 *
 * It is not the documented surface of `std/os`: the OS-neutral modules call it from their macOS arm.
 */

/** The natives only macOS has. */
public native type MacOs {
  /**
   * The per-user temporary directory (`confstr(_CS_DARWIN_USER_TEMP_DIR)`), which is what `TMPDIR` is set to in a
   * login session and what a program started without that variable still has.
   */
  native static fn userTemporaryDirectory(var path: String, var failure: String): Int
}
