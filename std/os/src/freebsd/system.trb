/** The system questions on FreeBSD that are its own: the version is what `uname` says. */

use OsError from "../error"
use SystemVersion from "../system"
use systemNames from "../posix/system"

/** `uname`: the release is `14.1-RELEASE`, and the product's version is the part before the dash. */
public fn version(): Result<SystemVersion, OsError> {
  const names = systemNames()?
  Ok versionOf(names.release)
}

/** The version a FreeBSD release names: `14.1-RELEASE-p5` is `FreeBSD 14.1-RELEASE-p5`, release `14.1`. */
public fn versionOf(kernel: String): SystemVersion {
  SystemVersion("FreeBSD {kernel}", "freebsd", kernel.substringBefore("-") ?? kernel, None, kernel)
}
