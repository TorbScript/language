/** The system questions macOS and FreeBSD answer the same way, through `sysctl`. */

use OsError, outcome from "../error"
use Bsd from "./native"

/** A text `sysctl` by name. */
public fn sysctlText(name: String): Result<String, OsError> {
  var text = ""
  var failure = ""
  outcome(Bsd.sysctlText(name, text, failure), name, failure)?
  Ok text
}

/** An integer `sysctl` by name. */
public fn sysctlInteger(name: String): Result<Int64, OsError> {
  var number: Int64 = 0
  var failure = ""
  outcome(Bsd.sysctlInteger(name, number, failure), name, failure)?
  Ok number
}

/** `kern.boottime` against the wall clock. */
public fn uptime(): Result<Duration, OsError> {
  var milliseconds: Int64 = 0
  var failure = ""
  outcome(Bsd.uptime(milliseconds, failure), "the uptime", failure)?
  Ok milliseconds.milliseconds()
}
