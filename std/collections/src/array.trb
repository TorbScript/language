use Equals, Hash, combineHashes from "std/core"
use MutableIndexed from "std/core"
use Iterable, Length from "std/iteration"

/**
 * A fixed number of items, and the number is part of the type: `Array<Float, 16>`.
 *
 * An Array is a small value with a fixed layout. It lives inline (in a binding, in a field, in another Array), has no
 * storage on the heap and no reference count, and copying it copies its items. This is the type for vectors and
 * matrices, colors, hashes and foreign structs. Everything that grows is a `List`.
 *
 *     var identity: Array<Float, 4> = Array.filled(0.0)
 *     identity[0] = 1.0
 *     identity[4] = 1.0                 // Compile error: the index is known to be out of bounds
 *
 * `Size` is a const parameter: a literal, a named `const` or another const parameter. There is no arithmetic in types.
 */
public native type Array<Item, const Size: Int>
  with Iterable<Item>, Length, MutableIndexed<Int, Item>
{
  /** The length comes from the expected type: `const zeros: Array<Int, 8> = Array.filled(0)` */
  native fn filled(value: Item): Array<Item, Size>

  /**
   * `Array.of(1, 2, 3, 4)` is an `Array<Int, 4>`: the number of arguments is the `Size`, and the compiler works it out
   * (there is no way to *write* that link down, and the language gets none). It is `native` and not
   * `Array.from(items).expect(...)` because the items are written straight into the inline slots: no list is built, no
   * iterator runs, and nothing can fail. `...items` may only be spread from another `Array`, whose size is known too.
   */
  native fn of(...items: Item): Array<Item, Size>

  /** `None` if the number of items is not `Size`. */
  native fn from(items: Iterable<Item>): Array<Item, Size>?

  native fn length(self): Int
  native fn get(self, index: Int): Item?
  native fn iterator(self): Iterator<Item>

  native fn set(var self, index: Int, value: Item)
  native fn fill(var self, value: Item)

  /** Same length, so the result is an Array again. */
  native fn mapped<Output>(self, transform: (value: Item) => Output): Array<Output, Size>
}

/**
 * Equal when the items at the same index are equal. The length is part of the type, so two arrays that compare at all
 * have the same one and there is nothing to test about it.
 *
 * A collection is `Equals` when its items are, exactly as a tuple is - and an `Array` is the collection that is most
 * like a tuple: inline storage of a fixed width.
 */
extend<Item: Equals, const Size: Int> Array<Item, Size> with Equals {
  fn equals(self, other: Self): Bool {
    zip(other).all { pair => pair.0 == pair.1 }
  }
}

/** Order-dependent, like [List.hash]: an `Array` is an ordered sequence. */
extend<Item: Hash, const Size: Int> Array<Item, Size> with Hash {
  fn hash(self): Int {
    fold 0 { seed, item => combineHashes seed, item.hash() }
  }
}
