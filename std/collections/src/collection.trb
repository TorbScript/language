/**
 * The collection traits. These are the types that signatures, fields and bindings talk about:
 *
 *     Iterable<Item>   Length
 *     └──────────────────┘
 *     Collection<Item>                 a finite number of values that can be filled
 *        ├─ List<Item>                 ArrayList (literal `[1, 2]`), TrieList
 *        ├─ Set<Item>                  TrieSet, HashSet
 *        ├─ Map<Key, Value>            TrieMap (literal `["a": 1]`), HashMap
 *        ├─ Stack<Item>                ArrayStack
 *        └─ Queue<Item>                ArrayQueue
 *
 * Collections are values like every other `type`. There is one trait per kind and the binding decides:
 *
 *     const numbers = [1, 2, 3]     // Never changes
 *     var buffer = numbers          // A copy (the storage is shared until one of them is written to)
 *     buffer.add(4)                 // `numbers` is still [1, 2, 3]
 *
 * Verbs change the collection in place and need a `var` path (`add`, `remove`, `sort`). Their participles return a
 * changed copy and work everywhere (`added`, `removed`, `sorted`).
 *
 * The implementations are named after their data structure. They only show up where something is constructed.
 */

use Equals from "std/core"
use Iterable, Length from "std/iteration"

/**
 * A finite number of values that can be filled. Only `add`, `clear`, `length` and `iterator` are required; `addAll`,
 * `added`, `addedAll`, `contains`, `containsAll`, `count` and `compact` are defaults built on top of them.
 *
 * **A collection is not an [Accumulator] and abstracts nothing about taking values.** It has no `finish()` and no
 * `isDone()`, and there is no trait for "something with `add`": where a *run* has to be filled and then read back,
 * that run is an [Accumulator] of its own, an ordinary type beside the collection (`ListAccumulator`,
 * `into<Target>()`).
 *
 * It is not the bound to reach for. A signature asks for the smallest thing it uses: `Iterable<Item>` to read,
 * `Iterable<Item> & Length` to read and to size, and `Collection<Item>` where it really needs to fill as well.
 *
 * # Examples
 *
 *     var numbers: List<Int> = []
 *     numbers.addAll([1, 2, 3])
 *     print numbers.contains(2)
 *
 * # Related
 *
 * - [List], [Map], [Set], [Stack], [Queue] - the traits built on top of it, one per kind.
 * - [Iterable] - the pipeline vocabulary (`map`, `filter`, `fold`, ...) every `Collection` inherits.
 * - [Accumulator] - the state of one run of a pipeline, which is a type of its own and never a collection.
 */
public trait Collection<Item>
  with Iterable<Item>, Length
{
  /** Adds a value, in place. Where the value goes is the structure's business - the end, a bucket, the top. */
  var fn add(value: Item)

  /** Removes every value, in place. */
  var fn clear()

  /**
   * Gives the value storage of its own, sized exactly to its length. For the small part of something big that is
   * kept for a long time: `var header = file[0..64]`, then `header.compact()`.
   *
   * The default does nothing, which is the honest answer for a storage that keeps no spare room; an implementation
   * that holds capacity beyond its length - a growable buffer, a ring - hands it back here.
   */
  var fn compact() {}

  /**
   * How many values there are. A collection knows its size, so counting it does not walk it: this is [Length.length],
   * under the word a pipeline uses.
   */
  fn count(): Int {
    length()
  }

  /** Adds every value of `values`, in order. The default for a collection that only implements `add`. */
  var fn addAll(values: Iterable<Item>) {
    for value in values {
      add value
    }
  }

  /** Adds a value and answers a changed copy: the participle of [Collection.add], for a `const` binding. */
  fn added(value: Item): Self {
    var result = self
    result.add value
    result
  }

  /** Adds every value of `values` and answers a changed copy: the participle of [Collection.addAll]. */
  fn addedAll(values: Iterable<Item>): Self {
    var result = self
    result.addAll values
    result
  }

  /**
   * Whether the value is present. Linear by default - a scan of every value - but a [Set] or a [Map] key answers
   * this without searching.
   */
  fn contains(value: Item): Bool where Item: Equals {
    any { item => item == value }
  }

  /** Whether every value of `values` is present. */
  fn containsAll(values: Iterable<Item>): Bool where Item: Equals {
    values.all contains
  }
}

