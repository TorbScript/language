/**
 * The collections. The traits are what signatures, fields and bindings talk about; an implementation is only named
 * where something is constructed (see "Collections and Iteration" in CONCEPT.md).
 */

public use Collection from "./collection"
public use List, ArrayList, TrieList from "./list"
public use Map, TrieMap, HashMap from "./map"
public use Set, TrieSet, HashSet from "./set"
public use Stack, ArrayStack from "./stack"
public use Queue, ArrayQueue from "./queue"
public use Array from "./array"
