/**
 * The ordered, indexable sequence: [List], its default implementation [ArrayList], and the trie-backed [TrieList].
 *
 * `List<Item>` is the type of the literal `[1, 2, 3]`. Every change has a verb that needs a `var` path plus a
 * participle that answers a changed copy and works on a `const` list too, so the same operation is written the same
 * way regardless of which kind of binding holds the list.
 *
 * # Related
 *
 * - [Array] - the fixed-size sibling; everything that grows is a `List` instead.
 */

use Equals, Compare, Hash, combineHashes from "std/core"
use MutableIndexed, MutableSlice from "std/core"
use From, Show from "std/core"
use Iterate, Length from "std/iteration"

/**
 * An ordered sequence, addressable by index. This is the type of the literal `[1, 2, 3]`.
 *
 * Every change has a verb that changes the list in place through a `var` path, and a participle that answers a
 * changed copy and works on a `const` list too: `append`/`appended`, `insert`/`inserted`, `remove`/`removed`,
 * `removeAt`/`removedAt`, `sort`/`sorted`, `reverse`/`reversed`.
 *
 * # Examples
 *
 *     var numbers = [3, 1, 2]
 *     numbers.append 4
 *     numbers[0] = 5
 *     for number in numbers {
 *       print number
 *     }
 *
 * A verb needs a `var` path; its participle answers a changed copy and works on a `const` list too:
 *
 *     const numbers = [3, 1, 2]
 *     const more = numbers.appended 6
 *     print more
 *
 * `list[index]` is itself a `var` path, so an element is changed in place without reading it out first:
 *
 *     type Counter {
 *       var count: Int = 0
 *       var fn increment() {
 *         count = count + 1
 *       }
 *     }
 *
 *     var counters = [Counter(), Counter()]
 *     counters[0].increment()
 *     print counters[0].count
 *
 * # Pitfalls
 *
 * - A binding read out of the list copies the value there and then: `var first = counters[0]` takes a copy of the
 *   element above, so changing `first` afterward never touches `counters`. See [MutableIndexed] for the rule.
 *
 * # Related
 *
 * - [Iterate] - the pipeline vocabulary (`map`, `filter`, `fold`, ...) every list has.
 * - [Slice] and [MutableSlice] - `list[from..to]`, a `List` again, as a value and as a `var` path.
 */
public trait List<Item>
  with Iterate<Item>, Length, MutableIndexed<Int, Item>, MutableSlice
{
  /**
   * Builds a list from its arguments: `List.of(1, 2, 3)`, or with a spread, `List.of(...anyIterate)`.
   *
   * It answers `Self`, so `TrieList.of(1, 2)` is a `TrieList` and not somebody else's list. The requirement is on
   * the member and not on the trait, because an implementation may need more of `Item` than `List` does.
   */
  static fn of(...items: Item): Self where Self: From<Iterate<Item>> {
    Self.from items
  }

  /** Builds a list of `count` copies of `value`: `List.filled(3, "-")` is `["-", "-", "-"]`. */
  static fn filled(count: Int, value: Item): Self where Self: From<Iterate<Item>> {
    Self.from((0..count).map({ position => value }))
  }

  // --- In place ------------------------------------------------------------------------------------

  /** Appends `value` at the end, in place. */
  var fn append(value: Item)

  /** Appends every value of `values`, in order, in place. */
  var fn appendAll(values: Iterate<Item>) {
    for value in values {
      append value
    }
  }

  /** Inserts `value` at `index`, in place; shifts everything at or after it one position on. */
  var fn insert(index: Int, value: Item)

  /** Removes the item at `index` and answers it, or `None` if `index` is out of range. */
  var fn removeAt(index: Int): Item?

  /** Reverses the order, in place. */
  var fn reverse()

  /** Removes every item, in place. */
  var fn clear()

  /**
   * Gives the list storage of its own, sized exactly to its length. For the small part of something big that is kept
   * for a long time: `var header = file[0..64]`, then `header.compact()`.
   *
   * The default does nothing, which is the honest answer for a storage that keeps no spare room; an implementation
   * that holds capacity beyond its length hands it back here.
   */
  var fn compact() {}

  /**
   * Sorts in place, by a key: `names.sort { _.length() }`. Stable - two values with the same key keep their order.
   *
   * It is a **default and not a required member**, and it is written here and not in an implementation, because the
   * comparison is a closure of the program: a C function cannot call one, so `torb_list_sort` could only be reached with a
   * convention for handing a closure to the runtime - and one implementation of a sort that every list shares is worth
   * more than that convention. A member with generic parameters of its own is no slot of a witness table either (its
   * witnesses would have to be appended), so writing it as a default is also what makes `sort` reachable on a `List<Item>`
   * value at all: a default nothing overrides is dispatched with `Self` bound to the trait type.
   *
   * Bottom-up merge sort: `n log n` comparisons, stable, no recursion, and one buffer that is copied once.
   *
   * # Examples
   *
   *     var names = ["Grace", "Ada", "Alan"]
   *     names.sort { name => name.byteLength() }
   *     print names
   */
  var fn sort<Key: Compare>(by: Transform<Item, Key>) {
    const count = length()
    if count < 2 {
      return
    }
    // A copy, whose storage is shared with this list until the first write into it
    var buffer = self
    var width = 1
    while width < count {
      var start = 0
      while start < count {
        const middle = (start + width).min(count)
        const end = (start + width + width).min(count)
        var left = start
        var right = middle
        var at = start
        while at < end {
          // `compare` and not `<=`: only the total order is an order at all, and a float is the type where the two
          // differ - `<=` is IEEE-754 and is `false` next to a `nan`, which would leave a `nan` where it started.
          // "Not greater" and not "less" is what makes the sort stable: a tie goes to the left run, the earlier one
          const takesLeft = if left >= middle {
            false
          } else if right >= end {
            true
          } else {
            by(self[left]).compare(by(self[right])) != .Greater
          }
          if takesLeft {
            buffer[at] = self[left]
            left = left + 1
          } else {
            buffer[at] = self[right]
            right = right + 1
          }
          at = at + 1
        }
        start = end
      }
      // The merged runs are in the buffer, so that the next round reads them from `self` again
      var index = 0
      while index < count {
        self[index] = buffer[index]
        index = index + 1
      }
      width = width + width
    }
  }

  /**
   * The participle of [List.sort]: a list of the same kind, sorted by the key, with this one left alone.
   *
   * It overrides [Iterate.sorted], which is a lazy stage answering `Iterate<Item>`. A participle answers `Self`, so
   * on a list it answers a list and `const ordered: List<Int> = numbers.sorted({ _ })` needs no `toList()` after it.
   *
   * # Examples
   *
   *     const names = ["Grace", "Ada", "Alan"]
   *     print names.sorted({ name => name.byteLength() })
   */
  fn sorted<Key: Compare>(by: Transform<Item, Key>): Self {
    var result = self
    result.sort(by)
    result
  }

  /**
   * Removes the first `value` and answers whether one was found, in place.
   *
   * # Examples
   *
   *     var numbers = [1, 2, 3, 2]
   *     numbers.remove 2
   *     print numbers
   */
  var fn remove(value: Item): Bool where Item: Equals {
    match indexOf(value) {
      Some(index) => {
        removeAt index
        true
      }
      None => false
    }
  }

  /**
   * `numbers[1..3]`: the items of that part, as a list of the same kind.
   *
   * `ArrayList` answers it **natively**, where it is O(1) and shares the storage - which is what a slice of a concrete
   * list is. This default is what a **trait-typed** `List<Item>` reaches, because a member whose result is `Self` is in no
   * witness table: the thunk of one would have to box that result, and it cannot know the other bounds of the value it was
   * called on (`List<Item> & Show` would need a table the thunk has erased). So the shared default runs there, and it
   * costs one copy of the part - which is the price of not knowing the implementation, and not a different answer.
   *
   * # Examples
   *
   *     const numbers = [1, 2, 3, 4, 5]
   *     print numbers[1..3]
   *
   * # Panics
   *
   * When the range reaches outside the list, or starts after it ends. The two messages are the runtime's, word for
   * word: a back end may not disagree with the other about them.
   */
  fn slice(range: Bounds<Int>): Self {
    const (start, end) = windowOf range, length()
    // A copy of the receiver, emptied: the only way a default can build a `Self` it does not know the type of
    var result = self
    result.clear()
    var index = start
    while index < end {
      result.append self[index]
      index = index + 1
    }
    result
  }

  /**
   * `numbers[1..3] = values`: the items of that part replaced by `values`, in place. The two need not be the same
   * length, so the list grows or shrinks by the difference.
   *
   * It is also what puts a window back: `numbers[1..4].sort()` sorts the slice and then writes it back through this
   * member, which is how a `var` path goes through `a[from..to]` ([MutableSlice]).
   *
   * `ArrayList` answers it natively. This default is what a **trait-typed** `List<Item>` reaches, for the reason
   * [List.slice] gives: `values` is a `Self`, so the member is in no witness table. It writes the overlapping items in
   * place and inserts or removes the rest.
   *
   * # Examples
   *
   *     var numbers = [5, 3, 9, 1, 7]
   *     numbers[1..3] = [0]
   *     print numbers
   *
   * # Panics
   *
   * When the range reaches outside the list, or starts after it ends, with the messages of [List.slice].
   */
  var fn replace(range: Bounds<Int>, values: Self) {
    const (start, end) = windowOf range, length()
    const added = values.length()
    const kept = (end - start).min(added)
    var index = 0
    while index < kept {
      self[start + index] = values[index]
      index = index + 1
    }
    while index < added {
      insert(start + index, values[index])
      index = index + 1
    }
    var surplus = end - start - kept
    while surplus > 0 {
      removeAt(start + kept)
      surplus = surplus - 1
    }
  }

  /** Swaps the items at `first` and `second`, in place. */
  var fn swapAt(first: Int, second: Int) {
    const value = self[first]
    self[first] = self[second]
    self[second] = value
  }

  /** Changes one element in place: `enemies.update(0) { enemy => enemy.health = 0 }` */
  var fn update(index: Int, change: (var element: Item) => Void) {
    change self[index]
  }

  // --- Changed copies --------------------------------------------------------------------------------

  /** The participle of [List.append]: a changed copy with `value` at the end, for a `const` binding. */
  fn appended(value: Item): Self {
    var result = self
    result.append value
    result
  }

  /** The participle of [List.appendAll]: a changed copy with every value of `values` at the end. */
  fn appendedAll(values: Iterate<Item>): Self {
    var result = self
    result.appendAll values
    result
  }

  /** The participle of [List.insert]: a changed copy with `value` inserted at `index`. */
  fn inserted(index: Int, value: Item): Self {
    var result = self
    result.insert index, value
    result
  }

  /** The participle of `list[index] = value`: a changed copy with the item at `index` replaced. */
  fn updated(index: Int, value: Item): Self {
    var result = self
    result[index] = value
    result
  }

  /** The participle of [List.removeAt]: a changed copy with the item at `index` gone. */
  fn removedAt(index: Int): Self {
    var result = self
    result.removeAt index
    result
  }

  /** The participle of [List.remove]: a changed copy with the first `value` gone. */
  fn removed(value: Item): Self where Item: Equals {
    var result = self
    result.remove value
    result
  }

  /** The participle of [List.reverse]: a reversed copy. */
  fn reversed(): Self {
    var result = self
    result.reverse()
    result
  }

  // --- Reading -----------------------------------------------------------------------------------------

  /** How many items there are. A list knows its length, so counting it does not walk it. */
  fn count(): Int {
    length()
  }

  /** Whether `value` is present: a scan of every item. */
  fn contains(value: Item): Bool where Item: Equals {
    any { item => item == value }
  }

  /** The first item, or `None` if the list is empty. */
  fn first(): Item? {
    get 0
  }

  /** The last item, or `None` if the list is empty. */
  fn last(): Item? {
    get(length() - 1)
  }

  /** The index of the first `value`, or `None` if it is not present. */
  fn indexOf(value: Item): Int? where Item: Equals {
    indexed().find { pair => pair.item == value }.map { _.index }
  }
}

/** The factory picks the default implementation. This is also what makes `toList()` and `to<List<Item>>()` work. */
extend<Item> List<Item> with From<Iterate<Item>> {
  static fn from(items: Iterate<Item>): List<Item> {
    ArrayList.from items
  }
}

/** `[1, 2, 3]`, and `[]` when it is empty - the format of the literal. */
extend<Item: Show> List<Item> with Show {
  fn show(): String {
    const parts = map { _.showNested() }
    "[{parts.joined(separator: ", ")}]"
  }
}

/** Equal when they have the same length and equal items in the same order. */
extend<Item: Equals> List<Item> with Equals {
  fn equals(other: Self): Bool {
    length() == other.length() && indexed().all { pair => pair.item == other[pair.index] }
  }
}

/**
 * Order-dependent, unlike [Set.hash] and [Map.hash]: two lists with the same items in a different order differ.
 *
 * `Hash` requires `Equals`, and the `Equals` implementation above satisfies that: `Item: Hash` implies `Item: Equals`.
 */
extend<Item: Hash> List<Item> with Hash {
  fn hash(): Int {
    fold 0 { seed, item => combineHashes seed, item.hash() }
  }
}

/**
 * Where the part of a list of `count` items that `range` covers starts, and where it ends (exclusive). An open end is
 * the start or the end of the list, which is the receiver's decision and not the range's ([Slice]).
 *
 * Every slice and every replacement of this file goes through it, so all of them panic with the same two messages.
 *
 * # Panics
 *
 * When the range reaches outside the list, with `index <index> is out of bounds for a length of <count>`, or starts
 * after it ends, with `the range <from>..<to> starts after it ends`.
 */
fn windowOf(range: Bounds<Int>, count: Int): (start: Int, end: Int) {
  const from = range.lowest() ?? 0
  const written = range.highest() ?? count
  const to = if range.includesHighest() { written + 1 } else { written }
  if from < 0 || to > count {
    const shown = if from < 0 { from } else { to }
    panic "index {shown} is out of bounds for a length of {count}"
  }
  if from > to {
    panic "the range {from}..{to} starts after it ends"
  }
  (from, to)
}

// --- Implementations -----------------------------------------------------------------------------------

/**
 * The cursor over a [TrieList]: the same twenty lines as [ListIterator], because `TrieList` and `ArrayList` are two
 * `native type`s and a value of one is not a value of the other. It disappears with the trie, not before.
 */
public type TrieListIterator<Item> with Iterator<Item> {
  /** The list this cursor walks. Held by value, so a later change to the original list is never seen here. */
  items: TrieList<Item>
  /** The index of the next item to answer. */
  var index: Int = 0

  /** The item at `index`, or `None` once it reaches the end. */
  var fn next(): Item? {
    const found = items.get index
    index = index + 1
    found
  }
}

/**
 * The cursor over a contiguous list: the list it was made from, and the index of the next element.
 *
 * It is **TorbScript and not a runtime function**, because everything it needs already is one: `get` answers the element
 * or `None` past the end, so `next` is two lines and the runtime keeps one function fewer (the rule of
 * `compiler/CONTRIBUTING.md`, "natives stay few"). It holds the list by value, so changing the list while iterating it
 * does not change what the cursor walks - which is what a value is.
 */
public type ListIterator<Item> with Iterator<Item> {
  /** The list this cursor walks. Held by value, so a later change to the original list is never seen here. */
  items: ArrayList<Item>
  /** The index of the next item to answer. */
  var index: Int = 0

  /** The item at `index`, or `None` once it reaches the end. */
  var fn next(): Item? {
    const found = items.get index
    index = index + 1
    found
  }
}

/**
 * Contiguous, growable buffer - the default. The buffer is shared between copies and slices and only copied when
 * somebody writes to it while it is shared. Nobody can observe the difference.
 */
public native type ArrayList<Item>
  with List<Item>, From<Iterate<Item>>
{
  /**
   * Ordinary TorbScript, and it **cannot** be a function of the runtime: `items` is a trait-typed value of the
   * *program*, so reading it means calling `iterate` and `next` through a witness table, which C code cannot do.
   * `withCapacity` is what builds the empty buffer, and it is the one native the lowering answers itself - the element
   * descriptor a buffer needs is a function of the language and no declaration can name one.
   */
  static fn from(items: Iterate<Item>): ArrayList<Item> {
    var result: ArrayList<Item> = ArrayList.withCapacity 0
    result.appendAll items
    result
  }

  /** An empty list, with room for `capacity` items before it has to grow again. */
  native static fn withCapacity(capacity: Int): ArrayList<Item>

  /** How many items there are. */
  native fn length(): Int

  /** The item at `index`, or `None` if it is out of bounds. `list[index]` panics instead; see [Indexed.at]. */
  native fn get(index: Int): Item?

  /**
   * The O(1) slice: it shares storage with the receiver until one of the two is written. See [List.slice] for the
   * shared default a trait-typed `List` reaches instead.
   *
   * A list whose items may hold an object with a destructor gets a copy instead, so that an item the slice left out
   * closes when the list it came from is gone (docs/design/DESTRUCTORS.md 2a).
   *
   * # Panics
   *
   * When the range reaches outside the list, or starts after it ends, with the messages of [List.slice].
   */
  fn slice(range: Bounds<Int>): ArrayList<Item> {
    const (start, end) = windowOf range, length()
    sliceBetween start, end
  }

  /**
   * The items from `from` up to `to` (exclusive), sharing the storage: what [ArrayList.slice] is built on, once the
   * range is two numbers. The runtime checks both ends again.
   */
  private native fn sliceBetween(from: Int, to: Int): ArrayList<Item>

  /** Ordinary TorbScript over `get`: see [ListIterator]. */
  fn iterate(): Iterator<Item> {
    ListIterator self
  }

  /** Appends an item at the end, in place. */
  native var fn append(value: Item)

  /** Changes the item at `index` in place. `list[index] = value` goes through this; see [MutableIndexed.set]. */
  native var fn set(index: Int, value: Item)

  /** Inserts `value` at `index`, in place; shifts everything at or after it one position on. */
  native var fn insert(index: Int, value: Item)

  /** Removes the item at `index` and answers it, or `None` if `index` is out of range. */
  native var fn removeAt(index: Int): Item?

  /**
   * Replaces the items of `range` with `values`, in place; the two need not be the same length. What
   * `list[from..to] = values` goes through, and what puts a window back after `list[1..4].sort()`; see
   * [MutableSlice.replace].
   *
   * # Panics
   *
   * When the range reaches outside the list, or starts after it ends, with the messages of [List.slice].
   */
  var fn replace(range: Bounds<Int>, values: ArrayList<Item>) {
    const (start, end) = windowOf range, length()
    replaceBetween start, end, values
  }

  /** The items from `from` up to `to` (exclusive) replaced by `values`: what [ArrayList.replace] is built on. */
  private native var fn replaceBetween(from: Int, to: Int, values: ArrayList<Item>)

  /** Reverses the order, in place. */
  native var fn reverse()

  /** Removes every item, in place. */
  native var fn clear()

  /** Gives the list storage of its own, sized exactly to its length; see [List.compact]. */
  native var fn compact()
}

/**
 * Bit-partitioned trie. A write to a shared list copies one path (O(log n)) instead of the whole buffer:
 * the one for big lists that are kept in many versions (undo, history, snapshots).
 *
 * Until the trie exists, this name is a documented alias of [ArrayList]. Only performance differs: iteration order
 * and `Show` are the same either way.
 */
public native type TrieList<Item>
  with List<Item>, From<Iterate<Item>>
{
  /** Ordinary TorbScript, for the reason [ArrayList.from] gives: `items` is a trait-typed value of the program. */
  static fn from(items: Iterate<Item>): TrieList<Item> {
    var result: TrieList<Item> = TrieList.withCapacity 0
    result.appendAll items
    result
  }

  /** An empty list, with room for `capacity` items before it has to grow again. */
  native static fn withCapacity(capacity: Int): TrieList<Item>

  /** Same as [ArrayList.length]. */
  native fn length(): Int

  /** Same as [ArrayList.get]. */
  native fn get(index: Int): Item?

  /** Ordinary TorbScript over `get`, exactly as [ArrayList.iterate] is: see [TrieListIterator]. */
  fn iterate(): Iterator<Item> {
    TrieListIterator self
  }

  /** Same as [ArrayList.slice]. */
  fn slice(range: Bounds<Int>): TrieList<Item> {
    const (start, end) = windowOf range, length()
    sliceBetween start, end
  }

  /** Same as [ArrayList.sliceBetween]. */
  private native fn sliceBetween(from: Int, to: Int): TrieList<Item>

  /** Same as [ArrayList.append]. */
  native var fn append(value: Item)

  /** Same as [ArrayList.set]. */
  native var fn set(index: Int, value: Item)

  /** Same as [ArrayList.insert]. */
  native var fn insert(index: Int, value: Item)

  /** Same as [ArrayList.removeAt]. */
  native var fn removeAt(index: Int): Item?

  /** Same as [ArrayList.replace]. */
  var fn replace(range: Bounds<Int>, values: TrieList<Item>) {
    const (start, end) = windowOf range, length()
    replaceBetween start, end, values
  }

  /** Same as [ArrayList.replaceBetween]. */
  private native var fn replaceBetween(from: Int, to: Int, values: TrieList<Item>)

  /** Same as [ArrayList.reverse]. */
  native var fn reverse()

  /** Same as [ArrayList.clear]. */
  native var fn clear()

  /** Same as [ArrayList.compact]. */
  native var fn compact()
}
