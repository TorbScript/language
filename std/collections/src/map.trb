use Equals, Hash, combineHashes from "std/core"
use MutableIndexed from "std/core"
use From, Show from "std/core"
use Collection from "./collection"

/**
 * Mapping from keys to values. This is the type of the literal `["a": 1, "b": 2]`.
 * As a collection it consists of `(key, value)` tuples, `add((key, value))` is `set(key, value)`.
 *
 *     var ages = ["Ada": 36]
 *     ages["Grace"] = 45                          // In place, needs `var`
 *     ages["Ada"].increment()                     // Values are changed through the path, not through a copy
 *     const older = ages.updated("Ada", 37)       // The participle returns a changed copy
 *
 * The trait asks nothing of `Key`. What a key has to be able to do is a matter of the implementation
 * (`TrieMap` and `HashMap` need `Hash`, a sorted map needs `Compare`), so only the factories carry a bound.
 *
 * **Every implementation iterates in insertion order,** and removing an entry does not reorder the rest. The order
 * reaches the output through `Show` (an empty map shows as `[:]`), so it is a rule of the language and not of the
 * implementation.
 */
public trait Map<Key, Value>
  with Collection<(key: Key, value: Value)>, MutableIndexed<Key, Value>
{
  /** `Map.of(("a", 1), ("b", 2))` */
  fn of(...entries: (Key, Value)): Map<Key, Value> where Key: Hash {
    TrieMap.from entries
  }

  // --- In place ------------------------------------------------------------------------------------

  fn remove(var self, key: Key): Value?

  fn add(var self, entry: (key: Key, value: Value)) {
    set entry.key, entry.value
  }

  fn merge(var self, other: Iterable<(Key, Value)>) {
    addAll other
  }

  /** `cache.getOrSet(key) { expensive(key) }` */
  fn getOrSet(var self, key: Key, create: () => Value): Value {
    if const Some(existing) = get(key) {
      return existing
    }
    const value = create()
    set key, value
    value
  }

  // --- Changed copies --------------------------------------------------------------------------------

  /** The participle of `set` is `set`, so this one is called `updated`. */
  fn updated(self, key: Key, value: Value): Self {
    var result = self
    result.set key, value
    result
  }

  fn removed(self, key: Key): Self {
    var result = self
    result.remove key
    result
  }

  fn merged(self, other: Iterable<(Key, Value)>): Self {
    var result = self
    result.merge other
    result
  }

  // --- Reading -----------------------------------------------------------------------------------------

  fn containsKey(self, key: Key): Bool {
    get(key).isSome()
  }

  fn keys(self): Iterable<Key> {
    map { entry => entry.key }
  }

  fn values(self): Iterable<Value> {
    map { entry => entry.value }
  }

  fn mapValues<Output>(self, transform: (value: Value) => Output): Map<Key, Output> where Key: Hash {
    Map.from(map { entry => (entry.key, transform(entry.value)) })
  }
}

extend<Key: Hash, Value> Map<Key, Value> with From<Iterable<(Key, Value)>> {
  fn from(entries: Iterable<(Key, Value)>): Map<Key, Value> {
    TrieMap.from entries
  }
}

/** `["a": 1, "b": 2]`, and `[:]` when it is empty - the format of the literal. */
extend<Key: Show, Value: Show> Map<Key, Value> with Show {
  fn show(self): String {
    if isEmpty() {
      return "[:]"
    }
    const parts = map { entry => "{entry.key.showNested()}: {entry.value.showNested()}" }
    "[{parts.joined(separator: ", ")}]"
  }
}

/** Equal when they hold the same entries, regardless of insertion order. */
extend<Key, Value: Equals> Map<Key, Value> with Equals {
  fn equals(self, other: Self): Bool {
    length() == other.length() && all { entry =>
      match other.get(entry.key) {
        Some(value) => value == entry.value
        None => false
      }
    }
  }
}

/**
 * Order-independent, unlike [List.hash]: entries are combined with `bitwiseExclusiveOr`, so insertion order never
 * changes the hash of equal maps.
 *
 * `Hash` requires `Equals`, and the `Equals` implementation above satisfies that: `Value: Hash` implies
 * `Value: Equals`.
 */
extend<Key: Hash, Value: Hash> Map<Key, Value> with Hash {
  fn hash(self): Int {
    fold 0 { seed, entry => seed.bitwiseExclusiveOr combineHashes(entry.key.hash(), entry.value.hash()) }
  }
}

// --- Implementations -----------------------------------------------------------------------------------

/**
 * The cursor of the ordered hash table: the entries in insertion order, tombstones skipped.
 *
 * `entryAfter` is the **one** thing the table needs that `std/` cannot write, and this type is what keeps it one: a
 * position is an index into the storage's own entry vector, and a removal leaves a hole in it - so nothing written over
 * `length` and `get` can walk a table that has been removed from.
 *
 * It holds the map **by value**, so changing the map while iterating it does not change what the cursor walks, which is
 * what a value is. [HashMapIterator] is the same twenty lines for the other name of the same table: two `native type`s
 * name it until the trie exists (gap 18), and a value of one is not a value of the other.
 */
public type MapIterator<Key: Hash, Value> with Iterator<(key: Key, value: Value)> {
  entries: TrieMap<Key, Value>
  var position: Int = 0

  fn next(var self): (key: Key, value: Value)? {
    // The position travels through a local because stage 0 takes a `var` argument before it evaluates the receiver
    var found = position
    const entry = entries.entryAfter found
    position = found
    entry
  }
}

/** The cursor of [HashMap]: see [MapIterator]. */
public type HashMapIterator<Key: Hash, Value> with Iterator<(key: Key, value: Value)> {
  entries: HashMap<Key, Value>
  var position: Int = 0

  fn next(var self): (key: Key, value: Value)? {
    var found = position
    const entry = entries.entryAfter found
    position = found
    entry
  }
}

/**
 * Hash array mapped trie - the default. A write to a shared map copies one path (O(log n)), so keeping many
 * versions of a big map is cheap. Iterates in insertion order.
 *
 * Until the trie exists, this name is a documented alias of [HashMap]. Only performance differs: iteration order
 * and `Show` are the same either way.
 */
public native type TrieMap<Key: Hash, Value>
  with Map<Key, Value>, From<Iterable<(Key, Value)>>
{
  /**
   * Ordinary TorbScript, and it **cannot** be a function of the runtime: `entries` is a trait-typed value of the
   * *program*, so reading it means calling `iterator` and `next` through a witness table. `withCapacity` builds the empty
   * table, and it is the one native the lowering answers itself - the element descriptors a table needs are a function of
   * the language and no declaration can name one.
   */
  fn from(entries: Iterable<(Key, Value)>): TrieMap<Key, Value> {
    var result: TrieMap<Key, Value> = TrieMap.withCapacity 0
    result.addAll entries
    result
  }

  native fn withCapacity(capacity: Int): TrieMap<Key, Value>

  native fn length(self): Int
  native fn get(self, key: Key): Value?

  /** Ordinary TorbScript over `entryAfter`: see [MapIterator]. */
  fn iterator(self): Iterator<(key: Key, value: Value)> {
    MapIterator self
  }

  /**
   * The entry at or after `cursor` in the storage's own insertion order, with `cursor` left one past it. The one native a
   * table needs beyond `get` and `set`: the tombstones a removal leaves are the storage's business and nothing else can
   * skip them.
   */
  native fn entryAfter(self, var cursor: Int): (key: Key, value: Value)?

  native fn set(var self, key: Key, value: Value)
  native fn remove(var self, key: Key): Value?
  native fn clear(var self)
}

/**
 * Flat hash table: the fastest lookups and writes, but a write to a shared table copies all of it.
 * The one for caches and indexes that are never copied. Iterates in insertion order.
 */
public native type HashMap<Key: Hash, Value>
  with Map<Key, Value>, From<Iterable<(Key, Value)>>
{
  fn from(entries: Iterable<(Key, Value)>): HashMap<Key, Value> {
    var result: HashMap<Key, Value> = HashMap.withCapacity 0
    result.addAll entries
    result
  }

  native fn withCapacity(capacity: Int): HashMap<Key, Value>

  native fn length(self): Int
  native fn get(self, key: Key): Value?

  fn iterator(self): Iterator<(key: Key, value: Value)> {
    HashMapIterator self
  }

  native fn entryAfter(self, var cursor: Int): (key: Key, value: Value)?

  native fn set(var self, key: Key, value: Value)
  native fn remove(var self, key: Key): Value?
  native fn clear(var self)
}
