/**
 * Keys mapped to values: [Map], its default implementation [TrieMap], and the flat [HashMap].
 *
 * `Map<Key, Value>` is the type of the literal `["a": 1, "b": 2]`; a [Set] is the same idea with no value at all.
 * Both iterate in insertion order and compare regardless of it.
 *
 * # Related
 *
 * - [Set] - the same idea without a value, and no literal of its own.
 */

use Equals, Hash, combineHashes from "std/core"
use MutableIndexed from "std/core"
use From, Show from "std/core"
use Iterate, Length from "std/iteration"

/**
 * Mapping from keys to values. This is the type of the literal `["a": 1, "b": 2]`.
 *
 * Iterated, it consists of `(key, value)` tuples. The trait asks nothing of `Key` - what a key has to be able to do is a matter of the implementation (`TrieMap` and `HashMap` need
 * `Hash`, a sorted map would need `Compare`), so only the factories carry a bound.
 *
 * **Every implementation iterates in insertion order,** and removing an entry does not reorder the rest. The order
 * reaches the output through `Show` (an empty map shows as `[:]`), so it is a rule of the language and not of the
 * implementation.
 *
 * # Examples
 *
 *     var ages = ["Ada": 36]
 *     ages["Grace"] = 45
 *     for (name, age) in ages {
 *       print "{name} is {age}"
 *     }
 *
 * A verb needs a `var` path; its participle answers a changed copy and works on a `const` map too:
 *
 *     const ages: Map<String, Int> = ["Ada": 36]
 *     const older = ages.updated "Ada", 37
 *     print older
 *
 * `map[key]` is itself a `var` path, so a value is changed in place without reading it out first:
 *
 *     type Counter {
 *       var count: Int = 0
 *       var fn increment() {
 *         count = count + 1
 *       }
 *     }
 *
 *     var scores: Map<String, Counter> = ["Ada": Counter()]
 *     scores["Ada"].increment()
 *     print scores["Ada"].count
 *
 * # Pitfalls
 *
 * - A binding read out of the map copies the value there and then: `var mine = scores["Ada"]` takes a copy of the
 *   counter above, so changing `mine` afterward never touches `scores`. See [MutableIndexed] for the rule.
 * - `map[key]` panics if the key is absent; `map.get(key)` answers an `Option` instead.
 *
 * # Related
 *
 * - [Set] - the same idea without a value.
 * - [Iterate] - the pipeline vocabulary (`map`, `filter`, `fold`, ...) every map has, over its entries.
 */
public trait Map<Key, Value>
  with Iterate<(key: Key, value: Value)>, Length, MutableIndexed<Key, Value>
{
  /** Builds a map from its arguments: `Map.of(("a", 1), ("b", 2))`. Answers `Self`. */
  static fn of(...entries: (Key, Value)): Self where Self: From<Iterate<(Key, Value)>>, Key: Hash {
    Self.from entries
  }

  // --- In place ------------------------------------------------------------------------------------

  /** Removes the entry for `key` and answers its value, or `None` if there was none. */
  var fn remove(key: Key): Value?

  /** Removes every entry, in place. */
  var fn clear()

  /**
   * The value for `key`, storing `fallback` first where there is none. The fallback is `lazy`, so a value that costs
   * something is only built on a miss.
   *
   * This is what other languages spell `entry().or_default()`, with the replacement **written out**: there is no
   * `Default` trait, so what an absent key becomes stands at the call.
   *
   * # Examples
   *
   *     var counts: Map<String, Int> = [:]
   *     print counts.getOrInsert("a", 0)
   *
   * # Pitfalls
   *
   * - The answer is a **copy**, as every value is. `groups.getOrInsert(city, []).append(user)` changes nothing and the
   *   compiler says so ("a temporary is not a `var` path"): a method cannot answer a place, because a place is a path
   *   and not a value. [Map.update] is the one that changes what is stored.
   *
   * # Related
   *
   * - [Map.update] - the same insert, with the stored value changed in place.
   */
  var fn getOrInsert(key: Key, fallback: lazy Value): Value {
    if const Some(existing) = get(key) {
      return existing
    }
    const value = fallback
    set key, value
    value
  }

  /**
   * Changes the value for `key` in place, storing `fallback` first where there is none. This is the grouping loop:
   *
   *     var groups: Map<String, List<String>> = [:]
   *     groups.update("north", []) { names => names.append("Ada") }
   *     print groups
   *
   * The fallback is `lazy`, so it is only built on a miss.
   *
   * # Related
   *
   * - [Map.getOrInsert] - the same insert, answering the value instead of changing it.
   */
  var fn update(key: Key, fallback: lazy Value, change: (var Value) => Void) {
    var value = get(key) ?? fallback
    change value
    set key, value
  }

  // --- Changed copies --------------------------------------------------------------------------------

  /** The participle of `set` is `set`, so this one is called `updated`. */
  fn updated(key: Key, value: Value): Self {
    var result = self
    result.set key, value
    result
  }

  /** The participle of [Map.remove]: a changed copy with the entry for `key` gone. */
  fn removed(key: Key): Self {
    var result = self
    result.remove key
    result
  }

  // --- Reading -----------------------------------------------------------------------------------------

  /** How many entries there are. A map knows its size, so counting it does not walk it. */
  fn count(): Int {
    length()
  }

  /** Whether there is an entry for `key`. */
  fn containsKey(key: Key): Bool {
    get(key).isSome()
  }

  /** Every key, in insertion order. */
  fn keys(): Iterate<Key> {
    map { entry => entry.key }
  }

  /** Every value, in insertion order. */
  fn values(): Iterate<Value> {
    map { entry => entry.value }
  }

  /** Transforms every value, keeping the keys: `ages.mapValues { age => age + 1 }`. */
  fn mapValues<Output>(transform: Transform<Value, Output>): Map<Key, Output> where Key: Hash {
    Map.from(map { entry => (entry.key, transform(entry.value)) })
  }
}

/** The factory picks the default implementation. This is what makes `Map.from` and the literal `["a": 1]` work. */
extend<Key: Hash, Value> Map<Key, Value> with From<Iterate<(Key, Value)>> {
  static fn from(entries: Iterate<(Key, Value)>): Self {
    TrieMap.from entries
  }
}

/** `["a": 1, "b": 2]`, and `[:]` when it is empty - the format of the literal. */
extend<Key: Show, Value: Show> Map<Key, Value> with Show {
  fn show(): String {
    if isEmpty() {
      return "[:]"
    }
    const parts = map { entry => "{entry.key.showNested()}: {entry.value.showNested()}" }
    "[{parts.joined(separator: ", ")}]"
  }
}

/** Equal when they hold the same entries, regardless of insertion order. */
extend<Key, Value: Equals> Map<Key, Value> with Equals {
  fn equals(other: Self): Bool {
    length() == other.length() && all { entry =>
      match other.get(entry.key) {
        Some(value) => value == entry.value
        None => false
      }
    }
  }
}

/**
 * Order-independent, unlike [List.hash]: entries are combined with `bitwiseExclusiveOr`, so insertion order never
 * changes the hash of equal maps.
 *
 * `Hash` requires `Equals`, and the `Equals` implementation above satisfies that: `Value: Hash` implies
 * `Value: Equals`.
 */
extend<Key: Hash, Value: Hash> Map<Key, Value> with Hash {
  fn hash(): Int {
    fold 0 { seed, entry => seed ^ combineHashes(entry.key.hash(), entry.value.hash()) }
  }
}

// --- Implementations -----------------------------------------------------------------------------------

/**
 * The cursor of the ordered hash table: the entries in insertion order, tombstones skipped.
 *
 * `entryAfter` is the **one** thing the table needs that `std/` cannot write, and this type is what keeps it one: a
 * position is an index into the storage's own entry vector, and a removal leaves a hole in it - so nothing written over
 * `length` and `get` can walk a table that has been removed from.
 *
 * It holds the map **by value**, so changing the map while iterating it does not change what the cursor walks, which is
 * what a value is. [HashMapIterator] is the same twenty lines for the other name of the same table: two `native type`s
 * name it while the trie does not exist, and a value of one is not a value of the other.
 */
public type MapIterator<Key: Hash, Value> with Iterator<(key: Key, value: Value)> {
  /** The map this cursor walks. Held by value, so a later change to the original map is never seen here. */
  entries: TrieMap<Key, Value>
  /** The next position to read from the table's own storage. */
  var position: Int = 0

  /** The next entry, or `None` once the table is exhausted. */
  var fn next(): (key: Key, value: Value)? {
    entries.entryAfter position
  }
}

/** The cursor of [HashMap]: see [MapIterator]. */
public type HashMapIterator<Key: Hash, Value> with Iterator<(key: Key, value: Value)> {
  /** Same as [MapIterator.entries]. */
  entries: HashMap<Key, Value>
  /** Same as [MapIterator.position]. */
  var position: Int = 0

  /** Same as [MapIterator.next]. */
  var fn next(): (key: Key, value: Value)? {
    entries.entryAfter position
  }
}

/**
 * `the key "Alan"`: a key as the message of a missing one names it - what `map[key]` panics with.
 *
 * The key is shown as it shows inside of another value (`showNested`, so a text is quoted), cut after 60 characters.
 * Whether its type has `Show` is a question about the type and not about the value, and a generic `Key` has no
 * bound that answers it: so **the compiler writes this call** where it knows the type of the key, as
 * [describedShownKey] of the shown key, and the body below is what is left for a key whose type has no `Show` - the
 * words `the key` alone.
 */
public fn describedKey<Key>(key: Key): String {
  "the key"
}

/** `the key "Alan"` for the text a key shows as, with everything after its 60th character cut off as `...`. */
public fn describedShownKey(shown: String): String {
  const limit = 60
  const kept = shown.prefix characters: limit
  if kept.byteLength() == shown.byteLength() {
    return "the key {shown}"
  }
  "the key {kept}..."
}

/**
 * Hash array mapped trie - the default. A write to a shared map copies one path (O(log n)), so keeping many
 * versions of a big map is cheap. Iterates in insertion order.
 *
 * Until the trie exists, this name is a documented alias of [HashMap]. Only performance differs: iteration order
 * and `Show` are the same either way.
 */
public native type TrieMap<Key: Hash, Value>
  with Map<Key, Value>, From<Iterate<(Key, Value)>>
{
  /**
   * Ordinary TorbScript, and it **cannot** be a function of the runtime: `entries` is a trait-typed value of the
   * *program*, so reading it means calling `iterate` and `next` through a witness table. `withCapacity` builds the empty
   * table, and it is the one native the lowering answers itself - the element descriptors a table needs are a function of
   * the language and no declaration can name one.
   */
  static fn from(entries: Iterate<(Key, Value)>): Self {
    var result: Self = TrieMap.withCapacity 0
    for (key, value) in entries {
      result.set key, value
    }
    result
  }

  /** The empty table, with room for `capacity` entries before it has to grow again. */
  native static fn withCapacity(capacity: Int): Self

  /** How many entries there are. */
  native fn length(): Int

  /** The value for `key`, or `None` if there is none. `map[key]` panics instead; see [TrieMap.at]. */
  native fn get(key: Key): Value?

  /**
   * The value for `key`. This is `map[key]`.
   *
   * # Panics
   *
   * When there is no entry for `key`, with `the key "Alan" is not in the map`: the key as it shows inside of another
   * value, cut after 60 characters, or `the key` alone where its type has no `Show` ([describedKey]). [TrieMap.get]
   * is the same question with an `Option` for an answer.
   */
  fn at(key: Key): Value {
    match get(key) {
      Some(value) => value
      None => panic "{describedKey(key)} is not in the map"
    }
  }

  /** Ordinary TorbScript over `entryAfter`: see [MapIterator]. */
  fn iterate(): Iterator<(key: Key, value: Value)> {
    MapIterator self
  }

  /**
   * The entry at or after `cursor` in the storage's own insertion order, with `cursor` left one past it. The one native a
   * table needs beyond `get` and `set`: the tombstones a removal leaves are the storage's business and nothing else can
   * skip them.
   */
  native fn entryAfter(var cursor: Int): (key: Key, value: Value)?

  /**
   * Changes the value for `key`, or adds a new entry if there was none, in place. `map[key] = value` goes through
   * this; see [MutableIndexed.set].
   */
  native var fn set(key: Key, value: Value)

  /** Removes the entry for `key` and answers its value, or `None` if there was none. */
  native var fn remove(key: Key): Value?

  /** Removes every entry, in place. */
  native var fn clear()
}

/**
 * Flat hash table: the fastest lookups and writes, but a write to a shared table copies all of it.
 * The one for caches and indexes that are never copied. Iterates in insertion order.
 */
public native type HashMap<Key: Hash, Value>
  with Map<Key, Value>, From<Iterate<(Key, Value)>>
{
  /** Same as [TrieMap.from]. */
  static fn from(entries: Iterate<(Key, Value)>): Self {
    var result: Self = HashMap.withCapacity 0
    for (key, value) in entries {
      result.set key, value
    }
    result
  }

  /** Same as [TrieMap.withCapacity]. */
  native static fn withCapacity(capacity: Int): Self

  /** Same as [TrieMap.length]. */
  native fn length(): Int

  /** Same as [TrieMap.get]. */
  native fn get(key: Key): Value?

  /**
   * Same as [TrieMap.at].
   *
   * # Panics
   *
   * When there is no entry for `key`, with the message of [TrieMap.at].
   */
  fn at(key: Key): Value {
    match get(key) {
      Some(value) => value
      None => panic "{describedKey(key)} is not in the map"
    }
  }

  /** A cursor over the entries, in insertion order; see [HashMapIterator]. */
  fn iterate(): Iterator<(key: Key, value: Value)> {
    HashMapIterator self
  }

  /** Same as [TrieMap.entryAfter]. */
  native fn entryAfter(var cursor: Int): (key: Key, value: Value)?

  /** Same as [TrieMap.set]. */
  native var fn set(key: Key, value: Value)

  /** Same as [TrieMap.remove]. */
  native var fn remove(key: Key): Value?

  /** Same as [TrieMap.clear]. */
  native var fn clear()
}
