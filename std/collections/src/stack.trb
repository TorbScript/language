/**
 * LIFO: [Stack], with [ArrayStack] as its only implementation.
 *
 * `push`, `pop` and `peek` all work on the top. There is no index: the only way to see an item below the top is to pop
 * down to it or to iterate the whole stack.
 *
 * # Related
 *
 * - [Queue] - the FIFO sibling, with `enqueue`, `dequeue` and `peek` at its two ends.
 */

use Equals, Hash, combineHashes from "std/core"
use From from "std/core"
use Iterate, Length from "std/iteration"

/**
 * LIFO stack. Iterates from top to bottom, which is the order it hands items out in.
 *
 * The words everybody knows for a stack: `push` puts an item on top, `pop` takes the top one off, and `peek` looks at it
 * without taking it.
 *
 * # Examples
 *
 *     var pending = Stack.of 1, 2, 3
 *     pending.push 4
 *     print pending.pop()
 *     print pending.peek()
 *     print pending.toList()
 *
 * # Related
 *
 * - [Queue] - the FIFO sibling.
 * - [Iterate] - the pipeline vocabulary (`map`, `filter`, `fold`, ...), from the top down.
 */
public trait Stack<Item>
  with Iterate<Item>, Length
{
  /** Builds a stack from its arguments. The last item ends up on top. Answers `Self`. */
  static fn of(...items: Item): Self where Self: From<Iterate<Item>> {
    Self.from items
  }

  // --- In place ------------------------------------------------------------------------------------

  /** Puts `value` on top, in place. */
  var fn push(value: Item)

  /** Takes the top item off and answers it, or `None` if the stack is empty. */
  var fn pop(): Item?

  /** Removes every item, in place. */
  var fn clear()

  /** Hands back storage held beyond the length. The default does nothing: a storage without spare room has none. */
  var fn compact() {}

  // --- Reading -----------------------------------------------------------------------------------------

  /** The item `pop` would take, without taking it, or `None` if the stack is empty. */
  fn peek(): Item? {
    first()
  }

  /** How many items there are. A stack knows its size, so counting it does not walk it. */
  fn count(): Int {
    length()
  }
}

/** The factory picks the default implementation: what `Stack.of` and a pipeline's `to<Stack<Item>>()` build. */
extend<Item> Stack<Item> with From<Iterate<Item>> {
  static fn from(items: Iterate<Item>): Self {
    ArrayStack.from items
  }
}

/**
 * Equal when they hold the same items in the same order, which for a stack is from the top down - the order it
 * iterates in, and the only order a reader of one can see.
 *
 * A collection is `Equals` when its items are, exactly as a tuple is: values compare structurally, and which
 * implementation carries the items is nobody's business.
 */
extend<Item: Equals> Stack<Item> with Equals {
  fn equals(other: Self): Bool {
    length() == other.length() && zip(other).all { pair => pair.0 == pair.1 }
  }
}

/**
 * Order-dependent, like [List.hash] and unlike [Set.hash]: two stacks with the same items in a different order are
 * not equal, so they need not hash alike.
 *
 * `Hash` requires `Equals`, and the `Equals` implementation above satisfies that: `Item: Hash` implies `Item: Equals`.
 */
extend<Item: Hash> Stack<Item> with Hash {
  fn hash(): Int {
    fold 0 { seed, item => combineHashes seed, item.hash() }
  }
}

// --- Implementation, written in plain TorbScript ----------------------------------------------------------

/**
 * The only implementation of [Stack]: a `List` used from the end. A value, because it consists of values - nothing
 * had to be done for that.
 */
public type ArrayStack<Item> with Stack<Item>, From<Iterate<Item>> {
  private var items: List<Item> = []

  /** Builds the stack from `items`, with the last one on top. */
  static fn from(items: Iterate<Item>): Self {
    Self items.toList()
  }

  /** Puts `value` on top, in place. */
  var fn push(value: Item) {
    items.append value
  }

  /** Takes the top item off and answers it, or `None` if empty. */
  var fn pop(): Item? {
    const last = items.length() - 1
    items.removeAt last
  }

  /** The top item, or `None` if empty: the end of the list underneath, without walking it. */
  fn peek(): Item? {
    items.last()
  }

  /** Removes every item, in place. */
  var fn clear() {
    items.clear()
  }

  /** Hands back what the list underneath holds beyond its length; see [List.compact]. */
  var fn compact() {
    items.compact()
  }

  /** How many items there are. */
  fn length(): Int {
    items.length()
  }

  /** A cursor from top to bottom: the reverse of insertion order. */
  fn iterate(): Iterator<Item> {
    items.reversed().iterate()
  }
}
