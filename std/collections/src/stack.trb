/**
 * LIFO: [Stack], with [ArrayStack] as its only implementation.
 *
 * `add` and `remove` both work on the top, and `add` is [Collection.add] - so `addAll`, a collector or a channel fill
 * a `Stack` from that same end. There is no index: the only way to see an item is to remove it or to iterate the
 * whole stack.
 *
 * # Related
 *
 * - [Queue] - the FIFO sibling; `add` and `remove` reach the front instead of the top.
 */

use Equals, Hash, combineHashes from "std/core"
use From from "std/core"
use Collection from "./collection"

/**
 * LIFO stack. Iterates from top to bottom, which is the order it hands items out in.
 *
 * Two words, and the type name carries which end they mean: `add` puts an item on top, `remove` takes the top one
 * off. `add` and its participle `added` come from [Collection]; looking without taking is [Iterable.first].
 *
 * # Examples
 *
 *     var pending = Stack.of 1, 2, 3
 *     pending.add 4
 *     print pending.remove()
 *     print pending.toList()
 *
 * A `const` stack, or one whose old version is still needed, uses the participles instead:
 *
 *     const stack = Stack.of(1, 2).added(3)
 *     if const Some((top, rest)) = stack.removed() {
 *       print "top: {top}, remaining: {rest.length()}"
 *     }
 *
 * # Related
 *
 * - [Queue] - the FIFO sibling, with the same two words at the other end.
 * - [Collection] - `add`, `added`, `contains`, `length`, `iterator`, which `Stack` builds on.
 */
public trait Stack<Item>
  with Collection<Item>
{
  /** Builds a stack from its arguments. The last item ends up on top. Answers `Self`. */
  static fn of(...items: Item): Self where Self: From<Iterable<Item>> {
    Self.from items
  }

  // --- In place ------------------------------------------------------------------------------------

  /** Removes the item the stack gives next - the top one - and answers it, or `None` if the stack is empty. */
  var fn remove(): Item?

  // --- Changed copies --------------------------------------------------------------------------------

  /**
   * The participle of [Stack.remove]: the top item and the rest, or `None` if the stack is empty.
   *
   * It answers the pair and not `Self` alone, because a stack has no index: the item is gone once the copy is made,
   * so the copy has to carry it.
   */
  fn removed(): (Item, Self)? {
    var rest = self
    const top = rest.remove()?
    Some((top, rest))
  }
}

/** The factory picks the default implementation: what `Stack.of` and a pipeline's `to<Stack<Item>>()` build. */
extend<Item> Stack<Item> with From<Iterable<Item>> {
  static fn from(items: Iterable<Item>): Stack<Item> {
    ArrayStack.from items
  }
}

/**
 * Equal when they hold the same items in the same order, which for a stack is from the top down - the order it
 * iterates in, and the only order a reader of one can see.
 *
 * A collection is `Equals` when its items are, exactly as a tuple is: values compare structurally, and which
 * implementation carries the items is nobody's business.
 */
extend<Item: Equals> Stack<Item> with Equals {
  fn equals(other: Self): Bool {
    length() == other.length() && zip(other).all { pair => pair.0 == pair.1 }
  }
}

/**
 * Order-dependent, like [List.hash] and unlike [Set.hash]: two stacks with the same items in a different order are
 * not equal, so they need not hash alike.
 *
 * `Hash` requires `Equals`, and the `Equals` implementation above satisfies that: `Item: Hash` implies `Item: Equals`.
 */
extend<Item: Hash> Stack<Item> with Hash {
  fn hash(): Int {
    fold 0 { seed, item => combineHashes seed, item.hash() }
  }
}

// --- Implementation, written in plain TorbScript ----------------------------------------------------------

/**
 * The only implementation of [Stack]: a `List` used from the end. A value, because it consists of values - nothing
 * had to be done for that.
 */
public type ArrayStack<Item> with Stack<Item>, From<Iterable<Item>> {
  private var items: List<Item> = []

  /** Builds the stack from `items`, with the last one on top. */
  static fn from(items: Iterable<Item>): ArrayStack<Item> {
    Self items.toList()
  }

  /** Adds `value` on top, in place. */
  var fn add(value: Item) {
    items.add value
  }

  /** Removes and answers the top item, or `None` if empty. */
  var fn remove(): Item? {
    const last = items.length() - 1
    items.removeAt last
  }

  /** Removes every item, in place. */
  var fn clear() {
    items.clear()
  }

  /** Hands back what the list underneath holds beyond its length; see [Collection.compact]. */
  var fn compact() {
    items.compact()
  }

  /** How many items there are. */
  fn length(): Int {
    items.length()
  }

  /** A cursor from top to bottom: the reverse of insertion order. */
  fn iterator(): Iterator<Item> {
    items.reversed().iterator()
  }
}
