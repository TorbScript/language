/**
 * FIFO: [Queue], with [ArrayQueue] as its only implementation.
 *
 * `enqueue` puts an item at the back, `dequeue` takes the one at the front, and `peek` looks at the front without
 * taking it. There is no index: the only way to see an item behind the front is to dequeue up to it or to iterate the
 * whole queue.
 *
 * # Related
 *
 * - [Stack] - the LIFO sibling, with `push`, `pop` and `peek` at its top.
 */

use Equals, Hash, combineHashes from "std/core"
use From from "std/core"
use Iterate, Length from "std/iteration"

/**
 * FIFO queue. Iterates from front to back, which is the order it hands items out in.
 *
 * The words everybody knows for a queue: `enqueue` puts an item at the back, `dequeue` takes the one at the front off,
 * and `peek` looks at the front without taking it.
 *
 * # Examples
 *
 *     var pending = Queue.of 1, 2, 3
 *     pending.enqueue 4
 *     print pending.dequeue()
 *     print pending.peek()
 *     print pending.toList()
 *
 * # Related
 *
 * - [Stack] - the LIFO sibling.
 * - [Iterate] - the pipeline vocabulary (`map`, `filter`, `fold`, ...), from the front to the back.
 */
public trait Queue<Item>
  with Iterate<Item>, Length
{
  /** Builds a queue from its arguments. The first item ends up at the front. Answers `Self`. */
  static fn of(...items: Item): Self where Self: From<Iterate<Item>> {
    Self.from items
  }

  // --- In place ------------------------------------------------------------------------------------

  /** Puts `value` at the back, in place. */
  var fn enqueue(value: Item)

  /** Takes the item at the front off and answers it, or `None` if the queue is empty. */
  var fn dequeue(): Item?

  /** Removes every item, in place. */
  var fn clear()

  /** Hands back storage held beyond the length. The default does nothing: a storage without spare room has none. */
  var fn compact() {}

  // --- Reading -----------------------------------------------------------------------------------------

  /** The item `dequeue` would take, without taking it, or `None` if the queue is empty. */
  fn peek(): Item? {
    first()
  }

  /** How many items there are. A queue knows its size, so counting it does not walk it. */
  fn count(): Int {
    length()
  }
}

/** The factory picks the default implementation: what `Queue.of` and a pipeline's `to<Queue<Item>>()` build. */
extend<Item> Queue<Item> with From<Iterate<Item>> {
  static fn from(items: Iterate<Item>): Queue<Item> {
    ArrayQueue.from items
  }
}

/**
 * Equal when they hold the same items in the same order, which for a queue is the order of `dequeue`.
 *
 * A collection is `Equals` when its items are, exactly as a tuple is: values compare structurally, and which
 * implementation carries the items is nobody's business.
 */
extend<Item: Equals> Queue<Item> with Equals {
  fn equals(other: Self): Bool {
    length() == other.length() && zip(other).all { pair => pair.0 == pair.1 }
  }
}

/**
 * Order-dependent, like [List.hash] and unlike [Set.hash]: two queues with the same items in a different order are
 * not equal, so they need not hash alike.
 *
 * `Hash` requires `Equals`, and the `Equals` implementation above satisfies that: `Item: Hash` implies `Item: Equals`.
 */
extend<Item: Hash> Queue<Item> with Hash {
  fn hash(): Int {
    fold 0 { seed, item => combineHashes seed, item.hash() }
  }
}

// --- Implementation, written in plain TorbScript ----------------------------------------------------------

/** Ring buffer on top of a `List`. Nothing is moved and nothing is allocated until the buffer is full. */
public type ArrayQueue<Item> with Queue<Item>, From<Iterate<Item>> {
  private var slots: List<Item?> = List.filled 16, None
  private var head: Int = 0
  private var storedLength: Int = 0

  /** Builds the queue from `items`, with the first one at the front. */
  static fn from(items: Iterate<Item>): ArrayQueue<Item> {
    var queue = Self()
    for item in items {
      queue.enqueue item
    }
    queue
  }

  /** Puts `value` at the back, in place; grows the buffer first if it is full. */
  var fn enqueue(value: Item) {
    if storedLength == slots.length() {
      grow()
    }
    slots[slot(storedLength)] = Some value
    storedLength = storedLength + 1
  }

  /** Takes the item at the front off and answers it, or `None` if empty. */
  var fn dequeue(): Item? {
    const next = slots[head]?            // Empty queue: the slot is `None`
    slots[head] = None                   // Release the value
    head = slot 1
    storedLength = storedLength - 1
    Some next
  }

  /** The item at the front, or `None` if empty: one slot, without walking the ring. */
  fn peek(): Item? {
    slots[head]
  }

  /** Removes every item, in place. */
  var fn clear() {
    slots = List.filled 16, None
    head = 0
    storedLength = 0
  }

  /** How many items there are. */
  fn length(): Int {
    storedLength
  }

  /** A cursor from front to back: the order the queue hands items out in. */
  fn iterate(): Iterator<Item> {
    (0..storedLength).filterMap { slots[slot(_)] }.iterate()
  }

  /** Shrinks the ring to the items it holds; see [Queue.compact]. */
  var fn compact() {
    // At least one slot, because every index goes through `% slots.length()`
    var tight: List<Item?> = List.filled storedLength.max(1), None
    for offset in 0..storedLength {
      tight[offset] = slots[slot(offset)]
    }
    slots = tight
    head = 0
  }

  private fn slot(offset: Int): Int {
    (head + offset) % slots.length()
  }

  private var fn grow() {
    var larger: List<Item?> = List.filled(slots.length() * 2, None)
    for offset in 0..storedLength {
      larger[offset] = slots[slot(offset)]
    }
    slots = larger
    head = 0
  }
}
