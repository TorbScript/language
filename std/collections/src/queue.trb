use From from "std/core"
use Collection from "./collection"

/**
 * FIFO queue. Iterates in the order of `dequeue`. `add` is `enqueue`.
 *
 *     var pending = Queue.of(firstJob)
 *     while const Some(job) = pending.dequeue() {
 *       pending.addAll(job.run())
 *     }
 */
public trait Queue<Item>
  with Collection<Item>
{
  fn of(...items: Item): Queue<Item> {
    ArrayQueue.from(items)
  }

  // --- In place ------------------------------------------------------------------------------------

  fn enqueue(var self, value: Item)
  fn dequeue(var self): Item?

  fn add(var self, value: Item) {
    enqueue(value)
  }

  // --- Changed copies --------------------------------------------------------------------------------

  fn enqueued(self, value: Item): Self {
    added(value)
  }

  /** The next element and the remaining queue, or `None` if the queue is empty. */
  fn dequeued(self): (Item, Self)? {
    var rest = self
    const next = rest.dequeue()?
    Some((next, rest))
  }

  fn peek(self): Item? {
    first()
  }
}

extend<Item> Queue<Item> with From<Iterable<Item>> {
  fn from(items: Iterable<Item>): Queue<Item> {
    ArrayQueue.from(items)
  }
}

// --- Implementation, written in plain TorbScript ----------------------------------------------------------

/** Ring buffer on top of a `List`. Nothing is moved and nothing is allocated until the buffer is full. */
public type ArrayQueue<Item> with Queue<Item>, From<Iterable<Item>> {
  private var slots: List<Item?> = List.filled(16, None)
  private var head: Int = 0
  private var count: Int = 0

  fn from(items: Iterable<Item>): ArrayQueue<Item> {
    var queue = Self()
    queue.addAll(items)
    queue
  }

  fn enqueue(var self, value: Item) {
    if count == slots.length() {
      grow()
    }
    slots[slot(count)] = Some(value)
    count = count + 1
  }

  fn dequeue(var self): Item? {
    const next = slots[head]?            // Empty queue: the slot is `None`
    slots[head] = None                   // Release the value
    head = slot(1)
    count = count - 1
    Some(next)
  }

  fn clear(var self) {
    slots = List.filled(16, None)
    head = 0
    count = 0
  }

  fn length(self): Int {
    count
  }

  fn iterator(self): Iterator<Item> {
    (0..count).filterMap { slots[slot(_)] }.iterator()
  }

  private fn slot(self, offset: Int): Int {
    (head + offset) % slots.length()
  }

  private fn grow(var self) {
    var larger: List<Item?> = List.filled(slots.length() * 2, None)
    for offset in 0..count {
      larger[offset] = slots[slot(offset)]
    }
    slots = larger
    head = 0
  }
}
