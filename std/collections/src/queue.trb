/**
 * FIFO: [Queue], with [ArrayQueue] as its only implementation.
 *
 * `add` puts an item at the back and `remove` takes the one at the front, and `add` is [Collection.add] - so `addAll`,
 * a collector or a channel fill a `Queue` at the back. There is no index: the only way to see an item is to remove it
 * or to iterate the whole queue.
 *
 * # Related
 *
 * - [Stack] - the LIFO sibling; `add` and `remove` reach the top instead of the two ends.
 */

use Equals, Hash, combineHashes from "std/core"
use From from "std/core"
use Collection from "./collection"

/**
 * FIFO queue. Iterates from front to back, which is the order it hands items out in.
 *
 * Two words, and the type name carries which end they mean: `add` puts an item at the back, `remove` takes the one
 * at the front off. `add` and its participle `added` come from [Collection]; looking without taking is
 * [Iterable.first].
 *
 * # Examples
 *
 *     var pending = Queue.of 1, 2, 3
 *     pending.add 4
 *     print pending.remove()
 *     print pending.toList()
 *
 * A `const` queue, or one whose old version is still needed, uses the participles instead:
 *
 *     const queue = Queue.of(1, 2).added(3)
 *     if const Some((next, rest)) = queue.removed() {
 *       print "next: {next}, remaining: {rest.length()}"
 *     }
 *
 * # Related
 *
 * - [Stack] - the LIFO sibling, with the same two words at one end.
 * - [Collection] - `add`, `added`, `contains`, `length`, `iterator`, which `Queue` builds on.
 */
public trait Queue<Item>
  with Collection<Item>
{
  /** Builds a queue from its arguments. The first item ends up at the front. */
  static fn of(...items: Item): Queue<Item> {
    ArrayQueue.from items
  }

  // --- In place ------------------------------------------------------------------------------------

  /** Removes the item the queue gives next - the one at the front - and answers it, or `None` if it is empty. */
  var fn remove(): Item?

  // --- Changed copies --------------------------------------------------------------------------------

  /**
   * The participle of [Queue.remove]: the item at the front and the rest, or `None` if the queue is empty.
   *
   * It answers the pair and not `Self` alone, because a queue has no index: the item is gone once the copy is made,
   * so the copy has to carry it.
   */
  fn removed(): (Item, Self)? {
    var rest = self
    const next = rest.remove()?
    Some((next, rest))
  }
}

/** The factory picks the default implementation: what `Queue.of` and a pipeline's `to<Queue<Item>>()` build. */
extend<Item> Queue<Item> with From<Iterable<Item>> {
  static fn from(items: Iterable<Item>): Queue<Item> {
    ArrayQueue.from items
  }
}

/**
 * Equal when they hold the same items in the same order, which for a queue is the order of `dequeue`.
 *
 * A collection is `Equals` when its items are, exactly as a tuple is: values compare structurally, and which
 * implementation carries the items is nobody's business.
 */
extend<Item: Equals> Queue<Item> with Equals {
  fn equals(other: Self): Bool {
    length() == other.length() && zip(other).all { pair => pair.0 == pair.1 }
  }
}

/**
 * Order-dependent, like [List.hash] and unlike [Set.hash]: two queues with the same items in a different order are
 * not equal, so they need not hash alike.
 *
 * `Hash` requires `Equals`, and the `Equals` implementation above satisfies that: `Item: Hash` implies `Item: Equals`.
 */
extend<Item: Hash> Queue<Item> with Hash {
  fn hash(): Int {
    fold 0 { seed, item => combineHashes seed, item.hash() }
  }
}

// --- Implementation, written in plain TorbScript ----------------------------------------------------------

/** Ring buffer on top of a `List`. Nothing is moved and nothing is allocated until the buffer is full. */
public type ArrayQueue<Item> with Queue<Item>, From<Iterable<Item>> {
  private var slots: List<Item?> = List.filled 16, None
  private var head: Int = 0
  private var storedLength: Int = 0

  /** Builds the queue from `items`, with the first one at the front. */
  static fn from(items: Iterable<Item>): ArrayQueue<Item> {
    var queue = Self()
    queue.addAll items
    queue
  }

  /** Adds `value` at the back, in place; grows the buffer first if it is full. */
  var fn add(value: Item) {
    if storedLength == slots.length() {
      grow()
    }
    slots[slot(storedLength)] = Some value
    storedLength = storedLength + 1
  }

  /** Removes and answers the item at the front, or `None` if empty. */
  var fn remove(): Item? {
    const next = slots[head]?            // Empty queue: the slot is `None`
    slots[head] = None                   // Release the value
    head = slot 1
    storedLength = storedLength - 1
    Some next
  }

  /** Removes every item, in place. */
  var fn clear() {
    slots = List.filled 16, None
    head = 0
    storedLength = 0
  }

  /** How many items there are. */
  fn length(): Int {
    storedLength
  }

  /** A cursor from front to back: the order the queue hands items out in. */
  fn iterator(): Iterator<Item> {
    (0..storedLength).filterMap { slots[slot(_)] }.iterator()
  }

  /** Shrinks the ring to the items it holds; see [Collection.compact]. */
  var fn compact() {
    // At least one slot, because every index goes through `% slots.length()`
    var tight: List<Item?> = List.filled storedLength.max(1), None
    for offset in 0..storedLength {
      tight[offset] = slots[slot(offset)]
    }
    slots = tight
    head = 0
  }

  private fn slot(offset: Int): Int {
    (head + offset) % slots.length()
  }

  private var fn grow() {
    var larger: List<Item?> = List.filled(slots.length() * 2, None)
    for offset in 0..storedLength {
      larger[offset] = slots[slot(offset)]
    }
    slots = larger
    head = 0
  }
}
