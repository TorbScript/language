/**
 * Collectors decide where the values of a pipeline end up:
 *
 *     employees.collect(groupingBy { _.department }.then(averaging { _.salary }))
 *     words.collect(joining(", "))
 *
 * A `Collector` is a description. `start()` creates a fresh `Accumulator` for one run (held in a `var`),
 * values are pushed into it one by one, `finish()` produces the result. Because values are pushed, `Collector` and
 * `Accumulator` are the synchronous counterpart of [Sink], which pushes the same way but may have to wait for the
 * other end to keep up.
 *
 * # Examples
 *
 *     const words = ["pear", "kiwi", "plum", "fig"]
 *     print words.collect(groupingBy { _.byteLength() })
 */

use Compare, Hash from "std/core"
use From from "std/core"
use Add from "std/core"

/**
 * The push-based state of one run of a [Collector]: values arrive one at a time through `add`, and `finish` produces
 * the result once they have all arrived. A `Collection` (`List`, `Set`, `Map`, `Stack`, `Queue`) is already an
 * `Accumulator`, because `add` is the same verb and `finish` answers `self`.
 *
 * # Examples
 *
 *     var total = summing { value: Int => value }.start()
 *     total.add 3
 *     total.add 4
 *     print total.finish()
 *
 * # Related
 *
 * - [Collector] - the reusable description that makes a fresh `Accumulator` for every run.
 */
public trait Accumulator<Item, Output> {
  /** Pushes one more value in. */
  fn add(var self, value: Item)
  /** The result, once every value has been pushed in. Called exactly once, after the last `add`. */
  fn finish(self): Output

  /**
   * Whether more values would change the result. A driver asks before it pulls the first value and after every `add`,
   * and stops as soon as the answer is `true` - which is what lets `taking`, `first` and `find` end a pipeline over an
   * infinite or expensive source instead of reading to the end and throwing the rest away.
   *
   * The default is `false`: an accumulator that sums, counts or collects is never done. A wrapper (`std/iteration`'s
   * stages) answers what the accumulator below it answers, plus whatever it knows itself.
   */
  fn isDone(self): Bool {
    false
  }
}

/**
 * What to do with the values of a pipeline: reusable and stateless, it only describes a run. `collect(collector)` is
 * the general terminal operation of [Iterable] - `toList`, `count`, `fold` and the rest are all written on top of it.
 *
 * # Examples
 *
 *     const numbers = [1, 2, 3, 4, 5]
 *     print numbers.collect(summing { value: Int => value })
 *
 * # Related
 *
 * - [Accumulator] - the state one run makes, through `start()`.
 * - [groupingBy] - the one collector with a `then(downstream)` for a collector per group.
 */
public trait Collector<Item, Output> {
  /** A fresh `Accumulator` for one run. Called once per `collect`. */
  fn start(self): Accumulator<Item, Output>
}

// --- Collecting into collections ------------------------------------------------------------------

/**
 * Collects into any type that can be created from an Iterable (`From<Iterable<Item>>`). `Target` can be given on its
 * own, the rest is inferred.
 *
 * # Examples
 *
 *     const numbers = [3, 1, 2, 1]
 *     print numbers.collect(into<Set<Int>>())
 */
public fn into<Target: From<Iterable<Item>>, Item>(): Collector<Item, Target> {
  IntoCollector<Item, Target>()
}

/** Shorthand for `into<List<Item>>()`. */
public fn listing<Item>(): Collector<Item, List<Item>> {
  into<List<Item>>()
}

type IntoCollector<Item, Target: From<Iterable<Item>>> with Collector<Item, Target> {
  fn start(self): Accumulator<Item, Target> {
    IntoAccumulator<Item, Target>()
  }
}

/** Buffers in a List and converts once at the end. */
type IntoAccumulator<Item, Target: From<Iterable<Item>>> with Accumulator<Item, Target> {
  private var items: List<Item> = []

  fn add(var self, value: Item) {
    items.add value
  }

  fn finish(self): Target {
    Target.from items
  }
}

// --- Writing collectors the functional way: a fold with a final step -------------------------------

/**
 * `State` is the starting point of every run. Every run works on its own copy.
 *
 *     fn counting<Item>(): Collector<Item, Int> {
 *       collector(0, finish: { _ }) { count, _ => count + 1 }
 *     }
 */
public fn collector<Item, State, Output>(
  initial: State,
  finish: (State) => Output,
  step: (State, Item) => State,
): Collector<Item, Output> {
  FoldCollector initial, step, finish
}

type FoldCollector<Item, State, Output> with Collector<Item, Output> {
  initial: State
  step: (State, Item) => State
  complete: (State) => Output

  fn start(self): Accumulator<Item, Output> {
    FoldAccumulator initial, step, complete
  }
}

type FoldAccumulator<Item, State, Output> with Accumulator<Item, Output> {
  var state: State
  step: (State, Item) => State
  complete: (State) => Output

  fn add(var self, value: Item) {
    state = step(state, value)
  }

  fn finish(self): Output {
    complete(state)
  }
}

// --- Aggregates ------------------------------------------------------------------------------------------

/** How many values there are. */
public fn counting<Item>(): Collector<Item, Int> {
  collector(0, finish: { _ }) { count, _ => count + 1 }
}

/** Every value, added together, starting from zero. */
public fn summing<Item, Total: Add & From<Int>>(value: (value: Item) => Total): Collector<Item, Total> {
  collector(Total.from(0), finish: { _ }) { sum, item => sum + value(item) }
}

/** `None` for an empty pipeline. */
public fn averaging<Item>(value: (value: Item) => Float): Collector<Item, Float?> {
  collector((0.0, 0), finish: { state => if state.1 == 0 { None } else { Some(state.0 / Float.from(state.1)) } }) {
    state, item => (state.0 + value(item), state.1 + 1)
  }
}

/** The value with the smallest key, or `None` for an empty pipeline. Keeps the earlier of two equal keys. */
public fn minBy<Item, Key: Compare>(key: (value: Item) => Key): Collector<Item, Item?> {
  const initial: Item? = None
  collector(initial, finish: { _ }) { best, item =>
    match best {
      Some(current) if key(current) <= key(item) => best
      _ => Some item
    }
  }
}

/** The value with the largest key, or `None` for an empty pipeline. Keeps the earlier of two equal keys. */
public fn maxBy<Item, Key: Compare>(key: (value: Item) => Key): Collector<Item, Item?> {
  const initial: Item? = None
  collector(initial, finish: { _ }) { best, item =>
    match best {
      Some(current) if key(current) >= key(item) => best
      _ => Some item
    }
  }
}

/** Every value, joined into one `String`, with `separator` between values and `prefix`/`suffix` around all of them. */
public fn joining(separator: String = "", prefix: String = "", suffix: String = ""): Collector<String, String> {
  const initial: String? = None
  collector(initial, finish: { text => prefix + (text ?? "") + suffix }) { text, part =>
    match text {
      Some(existing) => Some(existing + separator + part)
      None => Some part
    }
  }
}

/** `(matching, rest)` */
public fn partitioningBy<Item>(predicate: (value: Item) => Bool): Collector<Item, (List<Item>, List<Item>)> {
  const initial: (List<Item>, List<Item>) = ([], [])
  collector(initial, finish: { _ }) { lists, item =>
    if predicate(item) { (lists.0.added(item), lists.1) } else { (lists.0, lists.1.added(item)) }
  }
}

// --- Grouping, with a downstream collector per group -----------------------------------------------------------

/**
 *     groupingBy { _.department }                              // Map<String, List<Employee>>
 *     groupingBy { _.department }.then(counting())             // Map<String, Int>
 *     groupingBy { _.department }.then(maxBy { _.salary }) // Map<String, Employee?>
 */
public fn groupingBy<Item, Key: Hash>(key: (value: Item) => Key): Grouping<Item, Key> {
  Grouping key
}

/**
 * The result of [groupingBy] before a downstream collector is chosen: a `Collector` on its own, into
 * `Map<Key, List<Item>>`, and the place `then(downstream)` sits to collect each group differently.
 */
public type Grouping<Item, Key: Hash> with Collector<Item, Map<Key, List<Item>>> {
  /** Picks the group a value belongs to. */
  key: (value: Item) => Key

  /** Groups into a `List` per key, same as `then(listing())`. */
  fn start(self): Accumulator<Item, Map<Key, List<Item>>> {
    then(listing()).start()
  }

  /** Runs `downstream` once per group instead of collecting each one into a `List`. */
  fn then<Output>(self, downstream: Collector<Item, Output>): Collector<Item, Map<Key, Output>> {
    GroupingInto key, downstream
  }
}

type GroupingInto<Item, Key: Hash, Output> with Collector<Item, Map<Key, Output>> {
  key: (value: Item) => Key
  downstream: Collector<Item, Output>

  fn start(self): Accumulator<Item, Map<Key, Output>> {
    GroupingAccumulator key, downstream
  }
}

/** A collector that is more than a fold is written as a type with `var` fields: here one accumulator per group. */
type GroupingAccumulator<Item, Key: Hash, Output> with Accumulator<Item, Map<Key, Output>> {
  key: (value: Item) => Key
  downstream: Collector<Item, Output>
  var groups: Map<Key, Accumulator<Item, Output>> = [:]

  fn add(var self, value: Item) {
    const group = key(value)
    if !groups.containsKey(group) {
      groups[group] = downstream.start()
    }
    groups[group].add(value)           // Through the path. `var copy = groups[group]` would fill a copy.
  }

  fn finish(self): Map<Key, Output> {
    groups.map { entry => (entry.key, entry.value.finish()) }.to<Map<Key, Output>>()
  }
}
