/**
 * Collectors decide where the values of a pipeline end up:
 *
 *     employees.collect(groupingBy { _.department }.then(averaging { _.salary }))
 *     words.collect(joining(", "))
 *
 * An [Accumulator] is both: the description of a run and the state of one. Values are pushed into it one at a time
 * through `add`, and `finish()` produces the result. Because it is a **value**, a copy of it is a run of its own -
 * which is why `collect` may be called twice with the same accumulator and why `groupingBy(...).then(downstream)`
 * copies the downstream per group. Because values are pushed, an `Accumulator` is the synchronous counterpart of
 * [Sink], which pushes the same way but may have to wait for the other end to keep up.
 *
 * A collection is **not** one, and there is no trait for "something with `add`" either: an accumulator is a type of
 * its own beside the collections, the way `Collector`/`Collectors.toList()` are in Java. `ListAccumulator` is the one
 * this package ships; a package that owns a collection may ship its own beside it, and a caller names it.
 *
 * # Examples
 *
 *     const words = ["pear", "kiwi", "plum", "fig"]
 *     print words.collect(groupingBy { _.byteLength() })
 */

use Compare, Hash from "std/core"
use From from "std/core"
use Add from "std/core"
use concatenated from "./concatenate"

/**
 * What to do with the values of a pipeline, and the state of doing it: values arrive one at a time through `add`, and
 * `finish` produces the result once they have all arrived. `collect(accumulator)` is the general terminal operation of
 * [Iterate] - `toList`, `count`, `fold` and the rest are all written on top of it.
 *
 * **A description and a run are one type, because a value is a copy.** `collect` fills a copy of what it was given, so
 * one accumulator may be collected with twice and the two runs never see each other, and `then(downstream)` needs no
 * factory: it keeps the downstream and copies it per group.
 *
 * It stands alone. A collection does not implement it: a container that is merely filled has no result of a run to
 * give and no `isDone()` to answer, so what gathers into one is a type beside it ([ListAccumulator], [into]).
 *
 * # Examples
 *
 *     const numbers = [1, 2, 3, 4, 5]
 *     print numbers.collect(summing { value: Int => value })
 *
 * # Pitfalls
 *
 * - A description and a half-filled run have the same type, so an accumulator that has already been `add`ed to and is
 *   then handed to `collect` or to `then` starts every run from what is in it. Build one where it is used
 *   (`collect(listing())`), the way every collector of this package answers a fresh value.
 *
 * # Related
 *
 * - [ListAccumulator] - the one this package ships, and the shape a package writes for its own collection.
 * - [groupingBy] - the one accumulator with a `then(downstream)` for a different one per group.
 */
public trait Accumulator<Item, Output> {
  /** Pushes one more value in. */
  var fn add(value: Item)

  /** The result, once every value has been pushed in. Called exactly once, after the last `add`. */
  fn finish(): Output

  /**
   * Whether more values would change the result. A driver asks before it pulls the first value and after every `add`,
   * and stops as soon as the answer is `true` - which is what lets `taking`, `first` and `find` end a pipeline over an
   * infinite or expensive source instead of reading to the end and throwing the rest away.
   *
   * The default is `false`: an accumulator that sums, counts or collects is never done. A wrapper (`std/iteration`'s
   * stages) answers what the accumulator below it answers, plus whatever it knows itself.
   */
  fn isDone(): Bool {
    false
  }
}

/**
 * Two partial results of one accumulator, joined: what lets an accumulator run over pieces of its input - the chunks of
 * `parallel()`, a divide-and-conquer fold, a map-reduce over the parts of a file - and still answer what one run over the
 * whole input answers.
 *
 * The contract is three lines. **`merge` is associative**: `merge(merge(a, b), c)` is `merge(a, merge(b, c))`. It need
 * not be commutative, because **it is called in the order of the pieces**, left to right. And **it is never called with
 * the output of a piece that received no value**: such a piece is skipped, and an input without any value takes the
 * accumulator's own `finish()` instead. That third line is what makes `joining(separator:, prefix:, suffix:)` mergeable
 * at all - without it every merge would have to decide whether a separator belongs between two pieces one of which is
 * not there.
 *
 * It joins two **outputs** and not two accumulators: two trait-typed accumulators need not have the same type, and the
 * output is what comes back from wherever a piece ran anyway. A collector whose output lost what a merge would need -
 * [averaging], whose count is gone once it divided - has none; the shape of the workaround is a [mergingCollector] whose
 * output keeps it.
 *
 * # Examples
 *
 *     const counter = counting<Int>()
 *     print counter.merge([1, 2].collect(counter), [3].collect(counter))
 *
 * # Related
 *
 * - [mergingCollector] - a fold with a final step and a merge, the way to write one.
 * - [Accumulator] - what it adds the merge to.
 */
public trait Merge<Item, Output> with Accumulator<Item, Output> {
  /** The output of the pieces before and the output of the piece after them, joined. */
  fn merge(first: Output, second: Output): Output
}

// --- Collecting into collections ------------------------------------------------------------------

/**
 * Collects into anything a pipeline can be turned into (`From<Iterate<Item>>`), which every collection is.
 * `Target` can be given on its own, the rest is inferred.
 *
 * It gathers into a `List` and calls `Target.from` once at the end, which is the answer that works for every target.
 * A package that owns a collection may ship an accumulator that writes straight into it - [ListAccumulator] is the
 * shape - and a caller who wants that one **names** it (`collect(ListAccumulator<Int>())`). Nothing picks it up
 * automatically: which run a pipeline makes is written at the call, not inferred from the target.
 *
 * # Examples
 *
 *     const numbers = [3, 1, 2, 1]
 *     print numbers.collect(into<Set<Int>>())
 */
public fn into<Target: From<Iterate<Item>>, Item>(): Accumulator<Item, Target> {
  IntoAccumulator<Item, Target>()
}

/** Shorthand for `ListAccumulator<Item>()`, which is what a pipeline ends in most often. Two lists merge by concatenation. */
public fn listing<Item>(): Merge<Item, List<Item>> {
  ListAccumulator<Item>()
}

/**
 * Gathers the values into a `List` and answers it: the specialised accumulator this package ships, and the shape a
 * package that owns a collection writes for its own (`HashSetAccumulator` writing straight into a set).
 *
 * # Examples
 *
 *     print([3, 1, 2].collect(ListAccumulator<Int>()))
 */
public type ListAccumulator<Item> with Merge<Item, List<Item>> {
  private var items: List<Item> = []

  /** Appends to the list that is being gathered. */
  var fn add(value: Item) {
    items.append value
  }

  /** The list, as it stands after the last `add`. */
  fn finish(): List<Item> {
    items
  }

  /** The two lists one after the other. */
  fn merge(first: List<Item>, second: List<Item>): List<Item> {
    first.appendedAll second
  }
}

/** The general one: gathers into a `List` and converts once at the end, for a target that ships none of its own. */
type IntoAccumulator<Item, Target: From<Iterate<Item>>> with Accumulator<Item, Target> {
  private var items: List<Item> = []

  var fn add(value: Item) {
    items.append value
  }

  fn finish(): Target {
    Target.from items
  }
}

// --- Writing collectors the functional way: a fold with a final step -------------------------------

/**
 * `State` is the starting point of every run. Every run works on its own copy.
 *
 *     fn counting<Item>(): Accumulator<Item, Int> {
 *       collector(0, finish: { _ }) { count, _ => count + 1 }
 *     }
 */
public fn collector<Item, State, Output>(
  initial: State,
  finish: (State) => Output,
  step: (State, Item) => State,
): Accumulator<Item, Output> {
  FoldAccumulator initial, step, finish
}

type FoldAccumulator<Item, State, Output> with Accumulator<Item, Output> {
  var state: State
  step: (State, Item) => State
  complete: (State) => Output

  var fn add(value: Item) {
    state = step(state, value)
  }

  fn finish(): Output {
    complete(state)
  }
}

/**
 * [collector] with a [Merge]: `merge` joins the outputs of two pieces of the input, in their order, and is never handed
 * the output of a piece that received no value. It has to be associative, so that the answer does not depend on where
 * the pieces were cut.
 *
 * An average merges once its output keeps the count:
 *
 *     const averaged = mergingCollector((0.0, 0), finish: { _ }, merge: { first, second =>
 *       (first.0 + second.0, first.1 + second.1)
 *     }) { state, value: Float => (state.0 + value, state.1 + 1) }
 *     const total = [1.0, 2.0, 6.0].collect(averaged)
 *     print(total.0 / Float.from(total.1))
 */
public fn mergingCollector<Item, State, Output>(
  initial: State,
  finish: (State) => Output,
  merge: (Output, Output) => Output,
  step: (State, Item) => State,
): Merge<Item, Output> {
  MergingFoldAccumulator initial, step, finish, merge
}

type MergingFoldAccumulator<Item, State, Output> with Merge<Item, Output> {
  var state: State
  step: (State, Item) => State
  complete: (State) => Output
  combine: (Output, Output) => Output

  var fn add(value: Item) {
    state = step(state, value)
  }

  fn finish(): Output {
    complete(state)
  }

  fn merge(first: Output, second: Output): Output {
    combine(first, second)
  }
}

// --- Aggregates ------------------------------------------------------------------------------------------

/** How many values there are. Two counts merge by `+`. */
public fn counting<Item>(): Merge<Item, Int> {
  mergingCollector(0, finish: { _ }, merge: { first, second => first + second }) { count, _ => count + 1 }
}

/** Every value, added together, starting from zero. Two sums merge by `+`. */
public fn summing<Item, Total: Add & From<Int>>(value: Transform<Item, Total>): Merge<Item, Total> {
  mergingCollector(Total.from(0), finish: { _ }, merge: { first, second => first + second }) { sum, item =>
    sum + value(item)
  }
}

/** `None` for an empty pipeline. */
public fn averaging<Item>(value: Transform<Item, Float>): Accumulator<Item, Float?> {
  collector((0.0, 0), finish: { state => if state.1 == 0 { None } else { Some(state.0 / Float.from(state.1)) } }) {
    state, item => (state.0 + value(item), state.1 + 1)
  }
}

/**
 * The value with the smallest key, or `None` for an empty pipeline. Keeps the earlier of two equal keys, and so does
 * its merge: the second piece's value wins only with a smaller key.
 */
public fn minBy<Item, Key: Compare>(key: Transform<Item, Key>): Merge<Item, Item?> {
  const initial: Item? = None
  const earlier = { best: Item?, item: Item =>
    match best {
      Some(current) if key(current).compare(key(item)) != .Greater => best
      _ => Some item
    }
  }
  mergingCollector(initial, finish: { _ }, merge: { first, second => keptOf first, second, earlier }, step: earlier)
}

/**
 * The value with the largest key, or `None` for an empty pipeline. Keeps the earlier of two equal keys, and so does
 * its merge: the second piece's value wins only with a larger key.
 */
public fn maxBy<Item, Key: Compare>(key: Transform<Item, Key>): Merge<Item, Item?> {
  const initial: Item? = None
  const earlier = { best: Item?, item: Item =>
    match best {
      Some(current) if key(current).compare(key(item)) != .Less => best
      _ => Some item
    }
  }
  mergingCollector(initial, finish: { _ }, merge: { first, second => keptOf first, second, earlier }, step: earlier)
}

/** The merge of [minBy] and [maxBy]: the second piece's value, stepped into the first piece's best. */
fn keptOf<Item>(first: Item?, second: Item?, step: (Item?, Item) => Item?): Item? {
  match second {
    Some(item) => step first, item
    None => first
  }
}

/**
 * Every value, joined into one `String`, with `separator` between values and `prefix`/`suffix` around all of them.
 *
 * It buffers the pieces and concatenates once at the end, for the reason `concatenated` gives: a `String` is a value, so
 * appending to one copies everything that is already in it.
 */
public fn joining(separator: String = "", prefix: String = "", suffix: String = ""): Merge<String, String> {
  const initial: List<String> = []
  const finish = { parts: List<String> => prefix + concatenated(parts, separator) + suffix }
  const merge = { first: String, second: String => joinedPieces first, second, separator, prefix, suffix }
  mergingCollector initial, finish: finish, merge: merge { parts, part =>
    parts.appended part
  }
}

/**
 * The merge of [joining]: the suffix of the first piece and the prefix of the second one come off, the separator goes
 * between them, and the whole is wrapped once. Neither piece is empty, so the separator always belongs there.
 */
fn joinedPieces(first: String, second: String, separator: String, prefix: String, suffix: String): String {
  const head = first.sliceBytes(0, first.byteLength() - suffix.byteLength())
  const tail = second.sliceBytes prefix.byteLength(), second.byteLength()
  head + separator + tail
}

/** `(matching, rest)`. Two pairs merge list by list. */
public fn partitioningBy<Item>(predicate: Predicate<Item>): Merge<Item, (List<Item>, List<Item>)> {
  const initial: (List<Item>, List<Item>) = ([], [])
  mergingCollector(initial, finish: { _ }, merge: { mergedPairs _, _2 }) { lists, item =>
    if predicate(item) { (lists.0.appended(item), lists.1) } else { (lists.0, lists.1.appended(item)) }
  }
}

/** The merge of [partitioningBy]: the matching lists concatenated, and the rest. */
fn mergedPairs<Item>(first: (List<Item>, List<Item>), second: (List<Item>, List<Item>)): (List<Item>, List<Item>) {
  (first.0.appendedAll(second.0), first.1.appendedAll(second.1))
}

// --- Grouping, with a downstream collector per group -----------------------------------------------------------

/**
 *     groupingBy { _.department }                              // Map<String, List<Employee>>
 *     groupingBy { _.department }.then(counting())             // Map<String, Int>
 *     groupingBy { _.department }.then(maxBy { _.salary }) // Map<String, Employee?>
 */
public fn groupingBy<Item, Key: Hash>(key: Transform<Item, Key>): Grouping<Item, Key> {
  Grouping key, GroupingAccumulator(key, listing())
}

/**
 * The result of [groupingBy] before a downstream accumulator is chosen: an `Accumulator` on its own, into
 * `Map<Key, List<Item>>`, and the place `then(downstream)` sits to collect each group differently.
 *
 * Two maps of it merge key by key: the lists of a key both pieces saw are concatenated, and a key only the second piece
 * saw comes after the first piece's keys - the order of first sight a single run has. What `then(downstream)` answers
 * has no merge, because the downstream it keeps is an `Accumulator` and not necessarily one with a [Merge].
 */
public type Grouping<Item, Key: Hash> with Merge<Item, Map<Key, List<Item>>> {
  /** Picks the group a value belongs to. */
  key: Transform<Item, Key>
  private var lists: GroupingAccumulator<Item, Key, List<Item>>

  /** Groups into a `List` per key, same as `then(listing())`. */
  var fn add(value: Item) {
    lists.add value
  }

  /** A `List` per key, in the order the keys were first seen. */
  fn finish(): Map<Key, List<Item>> {
    lists.finish()
  }

  /** The groups of the second map appended to those of the first one, key by key. */
  fn merge(first: Map<Key, List<Item>>, second: Map<Key, List<Item>>): Map<Key, List<Item>> {
    var merged = first
    for entry in second {
      if merged.containsKey(entry.key) {
        merged[entry.key].appendAll(entry.value)
      } else {
        merged[entry.key] = entry.value
      }
    }
    merged
  }

  /** Runs `downstream` once per group instead of collecting each one into a `List`. */
  fn then<Output>(downstream: Accumulator<Item, Output>): Accumulator<Item, Map<Key, Output>> {
    GroupingAccumulator key, downstream
  }
}

/**
 * An accumulator that is more than a fold is written as a type with `var` fields: here one run of `downstream` per
 * group. There is no factory to call, because a value is a copy: the group that is seen first takes the downstream as
 * it was given, and every further group takes another copy of the same starting state.
 */
type GroupingAccumulator<Item, Key: Hash, Output> with Accumulator<Item, Map<Key, Output>> {
  key: Transform<Item, Key>
  downstream: Accumulator<Item, Output>
  var groups: Map<Key, Accumulator<Item, Output>> = [:]

  var fn add(value: Item) {
    const group = key(value)
    if !groups.containsKey(group) {
      groups[group] = downstream    // A copy, which is a run of its own: that is what `start()` used to be.
    }
    groups[group].add(value)           // Through the path. `var copy = groups[group]` would fill a copy.
  }

  fn finish(): Map<Key, Output> {
    groups.map { entry => (entry.key, entry.value.finish()) }.to<Map<Key, Output>>()
  }
}
