/**
 * Lazy pipelines: the two traits everything is pulled through, the stages between them, and the collectors that end
 * one. The stage types themselves are not exported - `map` and `filter` answer an `Iterable<Item>`, and which type
 * carries it is nobody's business.
 *
 * `Stage` is the same middle piece written once for the pull side here and the push side of `std/stream`
 * (see `docs/STREAMS.md`). It lives here and not there because it is synchronous and because what it turns into what
 * is an `Accumulator` - both words of this package - which also keeps the dependency one-way.
 */

public use Iterator, Iterable, Length from "./iteration"
public use concatenated from "./concatenate"
public use Accumulator, ListAccumulator, collector, into, listing from "./collectors"
public use counting, summing, averaging, minBy, maxBy, joining, partitioningBy, groupingBy from "./collectors"
public use Stage from "./stage"
public use mapping, filtering, filterMapping, mappingWhile, flatMapping from "./stage"
public use taking, takingWhile, skipping, indexing, chunking from "./stage"
public use Queueing from "./staged"
