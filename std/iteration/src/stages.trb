/**
 * The lazy stages behind `Iterate.map`, `filter`, `take`, ...
 *
 * Every stage is a pair: a `type` that describes the stage (and is an `Iterate` again), and an iterator with
 * `var` fields that does the work while somebody pulls values. Both are values: copying an iterator forks it.
 */

use Compare from "std/core"
use Iterate, Iterator from "./iteration"

// --- map --------------------------------------------------------------------------------------

/** The stage behind `Iterate.map`: one `transform`ed value out for every value of `source`. */
public type Mapped<Item, Output> with Iterate<Output> {
  /** The values before the transform. */
  source: Iterate<Item>
  /** Applied to every value of `source`, in order. */
  transform: Transform<Item, Output>

  /** A cursor that pulls one value from `source` and answers it transformed. */
  fn iterate(): Iterator<Output> {
    MappedIterator source.iterate(), transform
  }
}

type MappedIterator<Item, Output> with Iterator<Output> {
  var source: Iterator<Item>
  transform: Transform<Item, Output>

  var fn next(): Output? {
    source.next().map(transform)
  }
}

// --- filter ------------------------------------------------------------------------------------

/** The stage behind `Iterate.filter`: only the values of `source` that answer `predicate`. */
public type Filtered<Item> with Iterate<Item> {
  /** The values before the predicate is applied. */
  source: Iterate<Item>
  /** Kept when it answers `true`. */
  predicate: Predicate<Item>

  /** A cursor that reads from `source` until it finds a value `predicate` keeps, or `source` is exhausted. */
  fn iterate(): Iterator<Item> {
    FilteredIterator source.iterate(), predicate
  }
}

type FilteredIterator<Item> with Iterator<Item> {
  var source: Iterator<Item>
  predicate: Predicate<Item>

  var fn next(): Item? {
    while const Some(value) = source.next() {
      if predicate(value) {
        return value
      }
    }
    None
  }
}

// --- filterMap, mapWhile ----------------------------------------------------------------------------

/** The stage behind `Iterate.filterMap`: the value of every `Some` that `transform` answers for `source`. */
public type FilterMapped<Item, Output> with Iterate<Output> {
  /** The values before the transform. */
  source: Iterate<Item>
  /** Answers `None` to drop a value, `Some(output)` to keep one. */
  transform: Transform<Item, Output?>

  /** A cursor that reads from `source` until `transform` answers `Some`, or `source` is exhausted. */
  fn iterate(): Iterator<Output> {
    FilterMappedIterator source.iterate(), transform
  }
}

type FilterMappedIterator<Item, Output> with Iterator<Output> {
  var source: Iterator<Item>
  transform: Transform<Item, Output?>

  var fn next(): Output? {
    while const Some(value) = source.next() {
      if const Some(result) = transform(value) {
        return result
      }
    }
    None
  }
}

/** The stage behind `Iterate.mapWhile`: values from `transform`, up to and not including its first `None`. */
public type MappedWhile<Item, Output> with Iterate<Output> {
  /** The values before the transform. */
  source: Iterate<Item>
  /** The first `None` ends the pipeline; `source` is never asked for a value again. */
  transform: Transform<Item, Output?>

  /** A cursor that stops for good the moment `transform` answers `None`. */
  fn iterate(): Iterator<Output> {
    MappedWhileIterator source.iterate(), transform
  }
}

type MappedWhileIterator<Item, Output> with Iterator<Output> {
  var source: Iterator<Item>
  transform: Transform<Item, Output?>
  var done: Bool = false

  var fn next(): Output? {
    if done {
      return None
    }
    const result = transform(source.next()?)
    done = result.isNone()
    result
  }
}

// --- flatMap -----------------------------------------------------------------------------------

/** The stage behind `Iterate.flatMap`: every value of every Iterate `transform` answers, one after another. */
public type FlatMapped<Item, Output> with Iterate<Output> {
  /** The values before the transform. */
  source: Iterate<Item>
  /** Turns one value of `source` into an Iterate of its own, which is flattened into the result. */
  transform: Transform<Item, Iterate<Output>>

  /** A cursor that walks the Iterate `transform` produced for the current value, then moves to the next one. */
  fn iterate(): Iterator<Output> {
    FlatMappedIterator source.iterate(), transform
  }
}

type FlatMappedIterator<Item, Output> with Iterator<Output> {
  var source: Iterator<Item>
  transform: Transform<Item, Iterate<Output>>
  var current: Iterator<Output>? = None

  var fn next(): Output? {
    loop {
      if var Some(inner) = current {
        if const Some(value) = inner.next() {
          return value
        }
      }
      // `?` on an Option: the source is exhausted, so are we
      current = transform(source.next()?).iterate()
    }
  }
}

// --- take, skip, takeWhile -----------------------------------------------------------------------

/** The stage behind `Iterate.take`: the first `amount` values of `source`, and nothing behind them. */
public type Taken<Item> with Iterate<Item> {
  /** The values `amount` counts into. */
  source: Iterate<Item>
  /** How many values to answer before ending the pipeline. */
  amount: Int

  /** A cursor that never reads `source` again once `amount` values have come out - `source` can be infinite. */
  fn iterate(): Iterator<Item> {
    TakenIterator source.iterate(), remaining: amount
  }
}

type TakenIterator<Item> with Iterator<Item> {
  var source: Iterator<Item>
  var remaining: Int

  var fn next(): Item? {
    if remaining <= 0 {
      return None                        // Does not touch the source again: `take` ends infinite sources
    }
    remaining = remaining - 1
    source.next()
  }
}

/** The stage behind `Iterate.skip`: every value of `source` after the first `amount`. */
public type Skipped<Item> with Iterate<Item> {
  /** The values `amount` are read from and thrown away. */
  source: Iterate<Item>
  /** How many values to read and discard before answering the rest. */
  amount: Int

  /** A cursor already advanced past the first `amount` values of `source`. */
  fn iterate(): Iterator<Item> {
    var iterator = source.iterate()
    for _ in 0..amount {
      iterator.next()
    }
    iterator
  }
}

/** The stage behind `Iterate.takeWhile`: values of `source` up to, not including, the first one `predicate` rejects. */
public type TakenWhile<Item> with Iterate<Item> {
  /** The values before the predicate is applied. */
  source: Iterate<Item>
  /** The first value that answers `false` ends the pipeline. */
  predicate: Predicate<Item>

  /** A cursor that stops for good the moment `predicate` answers `false`. */
  fn iterate(): Iterator<Item> {
    TakenWhileIterator source.iterate(), predicate
  }
}

type TakenWhileIterator<Item> with Iterator<Item> {
  var source: Iterator<Item>
  predicate: Predicate<Item>
  var done: Bool = false

  var fn next(): Item? {
    if done {
      return None
    }
    const value = source.next()?
    if predicate(value) {
      return value
    }
    done = true
    None
  }
}

// --- zip -------------------------------------------------------------------------------------------

/** The stage behind `Iterate.zip`: pairs of values at the same position, one from `left` and one from `right`. */
public type Zipped<Item, Output> with Iterate<(Item, Output)> {
  /** The first half of every pair. */
  left: Iterate<Item>
  /** The second half of every pair. */
  right: Iterate<Output>

  /** A cursor that reads one value from each side and stops as soon as either one runs out. */
  fn iterate(): Iterator<(Item, Output)> {
    ZippedIterator left.iterate(), right.iterate()
  }
}

type ZippedIterator<Item, Output> with Iterator<(Item, Output)> {
  var left: Iterator<Item>
  var right: Iterator<Output>

  var fn next(): (Item, Output)? {
    (left.next()?, right.next()?)
  }
}

// --- sorted ------------------------------------------------------------------------------------------

/**
 * The stage behind `Iterate.sorted`: `source`'s values, ordered by `key`. Lazy as a stage, but has to buffer every
 * value the moment it is iterated - there is no first value before the last one has arrived.
 */
public type Sorted<Item, Key: Compare> with Iterate<Item> {
  /** The values to sort. */
  source: Iterate<Item>
  /** What to compare two values by. */
  key: Transform<Item, Key>

  /** Sorting needs all values: the buffer is filled when the iteration starts, not when the stage is created. */
  fn iterate(): Iterator<Item> {
    var buffer = source.toList()
    buffer.sort by: key
    buffer.iterate()
  }
}
