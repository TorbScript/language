/**
 * The lazy stages behind `Iterable.map`, `filter`, `take`, ...
 *
 * Every stage is a pair: a `type` that describes the stage (and is an `Iterable` again), and an iterator with
 * `var` fields that does the work while somebody pulls values. Both are values: copying an iterator forks it.
 */

use Compare from "std/core"
use Iterable, Iterator from "./iteration"

// --- map --------------------------------------------------------------------------------------

public type Mapped<Item, Output> with Iterable<Output> {
  source: Iterable<Item>
  transform: (value: Item) => Output

  fn iterator(self): Iterator<Output> {
    MappedIterator source.iterator(), transform
  }
}

type MappedIterator<Item, Output> with Iterator<Output> {
  var source: Iterator<Item>
  transform: (value: Item) => Output

  fn next(var self): Output? {
    source.next().map(transform)
  }
}

// --- filter ------------------------------------------------------------------------------------

public type Filtered<Item> with Iterable<Item> {
  source: Iterable<Item>
  predicate: (value: Item) => Bool

  fn iterator(self): Iterator<Item> {
    FilteredIterator source.iterator(), predicate
  }
}

type FilteredIterator<Item> with Iterator<Item> {
  var source: Iterator<Item>
  predicate: (value: Item) => Bool

  fn next(var self): Item? {
    while const Some(value) = source.next() {
      if predicate(value) {
        return Some value
      }
    }
    None
  }
}

// --- filterMap, mapWhile ----------------------------------------------------------------------------

public type FilterMapped<Item, Output> with Iterable<Output> {
  source: Iterable<Item>
  transform: (value: Item) => Output?

  fn iterator(self): Iterator<Output> {
    FilterMappedIterator source.iterator(), transform
  }
}

type FilterMappedIterator<Item, Output> with Iterator<Output> {
  var source: Iterator<Item>
  transform: (value: Item) => Output?

  fn next(var self): Output? {
    while const Some(value) = source.next() {
      if const Some(result) = transform(value) {
        return Some result
      }
    }
    None
  }
}

public type MappedWhile<Item, Output> with Iterable<Output> {
  source: Iterable<Item>
  transform: (value: Item) => Output?

  fn iterator(self): Iterator<Output> {
    MappedWhileIterator source.iterator(), transform
  }
}

type MappedWhileIterator<Item, Output> with Iterator<Output> {
  var source: Iterator<Item>
  transform: (value: Item) => Output?
  var done: Bool = false

  fn next(var self): Output? {
    if done {
      return None
    }
    const result = transform(source.next()?)
    done = result.isNone()
    result
  }
}

// --- flatMap -----------------------------------------------------------------------------------

public type FlatMapped<Item, Output> with Iterable<Output> {
  source: Iterable<Item>
  transform: (value: Item) => Iterable<Output>

  fn iterator(self): Iterator<Output> {
    FlatMappedIterator source.iterator(), transform
  }
}

type FlatMappedIterator<Item, Output> with Iterator<Output> {
  var source: Iterator<Item>
  transform: (value: Item) => Iterable<Output>
  var current: Iterator<Output>? = None

  fn next(var self): Output? {
    while true {
      if var Some(inner) = current {
        if const Some(value) = inner.next() {
          return Some value
        }
      }
      // `?` on an Option: the source is exhausted, so are we
      current = Some transform(source.next()?).iterator()
    }
  }
}

// --- take, skip, takeWhile -----------------------------------------------------------------------

public type Taken<Item> with Iterable<Item> {
  source: Iterable<Item>
  amount: Int

  fn iterator(self): Iterator<Item> {
    TakenIterator source.iterator(), remaining: amount
  }
}

type TakenIterator<Item> with Iterator<Item> {
  var source: Iterator<Item>
  var remaining: Int

  fn next(var self): Item? {
    if remaining <= 0 {
      return None                        // Does not touch the source again: `take` ends infinite sources
    }
    remaining = remaining - 1
    source.next()
  }
}

public type Skipped<Item> with Iterable<Item> {
  source: Iterable<Item>
  amount: Int

  fn iterator(self): Iterator<Item> {
    var iterator = source.iterator()
    for _ in 0..amount {
      iterator.next()
    }
    iterator
  }
}

public type TakenWhile<Item> with Iterable<Item> {
  source: Iterable<Item>
  predicate: (value: Item) => Bool

  fn iterator(self): Iterator<Item> {
    TakenWhileIterator source.iterator(), predicate
  }
}

type TakenWhileIterator<Item> with Iterator<Item> {
  var source: Iterator<Item>
  predicate: (value: Item) => Bool
  var done: Bool = false

  fn next(var self): Item? {
    if done {
      return None
    }
    const value = source.next()?
    if predicate(value) {
      return Some value
    }
    done = true
    None
  }
}

// --- zip -------------------------------------------------------------------------------------------

public type Zipped<Item, Output> with Iterable<(Item, Output)> {
  left: Iterable<Item>
  right: Iterable<Output>

  fn iterator(self): Iterator<(Item, Output)> {
    ZippedIterator left.iterator(), right.iterator()
  }
}

type ZippedIterator<Item, Output> with Iterator<(Item, Output)> {
  var left: Iterator<Item>
  var right: Iterator<Output>

  fn next(var self): (Item, Output)? {
    Some((left.next()?, right.next()?))
  }
}

// --- sorted ------------------------------------------------------------------------------------------

public type Sorted<Item, Key: Compare> with Iterable<Item> {
  source: Iterable<Item>
  key: (value: Item) => Key

  /** Sorting needs all values: the buffer is filled when the iteration starts, not when the stage is created. */
  fn iterator(self): Iterator<Item> {
    var buffer = source.toList()
    buffer.sort by: key
    buffer.iterator()
  }
}
