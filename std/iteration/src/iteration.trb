/**
 * The pull side of a pipeline: [Iterator], a cursor with one method, and [Iterate], anything that can hand one out.
 * `for`, the spread operator (`...`) and every lazy stage (`map`, `filter`, `take`, ...) are built on these two
 * traits alone - a type takes part simply by implementing [Iterate].
 *
 * [Iterator] and [Iterate] are the synchronous half of the pipeline vocabulary: a [Collector] describes where the
 * values of a pipeline end up, and a [Stage] is the reusable middle a pipeline is built from. [Source] and [Sink]
 * carry the same two verbs (`next`, `add`/`finish`) asynchronously, for values that arrive over time instead of all
 * being there already.
 *
 * # Related
 *
 * - [Length] - the `length()`/`isEmpty()` pair a sized collection carries next to `Iterate`.
 * - [Source] - the asynchronous sibling of `Iterator`, for values that are not all there yet.
 */

use Compare, Hash from "std/core"
use From, Show from "std/core"
use Add from "std/core"
use Accumulator, groupingBy from "./collectors"
use concatenated from "./concatenate"
use Stage from "./stage"
use Staged from "./staged"
use Mapped, Filtered, FilterMapped, MappedWhile, FlatMapped, Taken, Skipped, TakenWhile, Zipped, Sorted from "./stages"

/**
 * A cursor over a sequence, with one method: `next`. Iterators are stateful values, so whoever pulls from one holds
 * it in a `var` - copying one forks it into two independent cursors over the same remaining values.
 *
 * # Examples
 *
 *     var digits = [1, 2, 3].iterate()
 *     print digits.next()
 *     print digits.next()
 *
 * # Related
 *
 * - [Iterate] - anything that can hand out a fresh one.
 */
public trait Iterator<Item> {
  /** The next value, or `None` once there is nothing left. */
  var fn next(): Item?
}

/**
 * The size of a collection, and the two questions built on it. Every collection type implements it, so
 * `isEmpty()`/`isNotEmpty()` read the same everywhere.
 *
 * # Examples
 *
 *     const numbers: List<Int> = []
 *     print numbers.isEmpty()
 */
public trait Length {
  /** How many elements there are. */
  fn length(): Int

  /** Whether there are no elements. */
  fn isEmpty(): Bool {
    length() == 0
  }

  /** Whether there is at least one element. */
  fn isNotEmpty(): Bool {
    !isEmpty()
  }
}

/**
 * Everything that works with `for ... in` and the spread operator (`...`). Only `iterate` is required.
 *
 * A pipeline has three parts, like in Java and Rust:
 *
 *     source            .filter { ... }.map { ... }.take(10)          .toList()
 *     any Iterate      lazy stages: nothing runs, nothing is stored   terminal operation: pulls the values through
 *
 * Stages are values (an `Iterate` again), so a pipeline can be passed around, extended and iterated more than once.
 * Where the values end up is decided by the terminal operation alone - usually `collect` with a `Collector`.
 *
 * # Examples
 *
 *     const numbers = [1, 2, 3, 4, 5, 6]
 *     const evenSquares = numbers.filter { _ % 2 == 0 }.map { _ * _ }
 *     print evenSquares.toList()
 *
 * # Related
 *
 * - [Length] - `length()`/`isEmpty()`, for a collection that knows its size up front.
 * - [Collector] - what `collect()` describes; every other terminal operation is written in terms of it.
 * - [Stage] - the reusable middle a `through(...)` puts in front of the values.
 */
public trait Iterate<Item> {
  /** A fresh cursor over the values, positioned before the first one. */
  fn iterate(): Iterator<Item>

  // --- Lazy stages -----------------------------------------------------------------------------

  /** Transforms every value into another one, in order. */
  fn map<Output>(transform: (value: Item) => Output): Iterate<Output> {
    Mapped self, transform
  }

  /** Keeps every value that answers the predicate, and drops the rest. */
  fn filter(predicate: (value: Item) => Bool): Iterate<Item> {
    Filtered self, predicate
  }

  /** Transforms every value into its own Iterate, and flattens all of them into one sequence. */
  fn flatMap<Output>(transform: (value: Item) => Iterate<Output>): Iterate<Output> {
    FlatMapped self, transform
  }

  /** `map` and `filter` in one: keeps the values of all `Some`. The bridge for functions that return an Option. */
  fn filterMap<Output>(transform: (value: Item) => Output?): Iterate<Output> {
    FilterMapped self, transform
  }

  /** Like `filterMap`, but ends the pipeline at the first `None`. */
  fn mapWhile<Output>(transform: (value: Item) => Output?): Iterate<Output> {
    MappedWhile self, transform
  }

  /** The first `amount` values. Ends the pipeline there, so a source that never runs out still finishes. */
  fn take(amount: Int): Iterate<Item> {
    Taken self, amount
  }

  /** Every value after the first `amount`, which are read and thrown away. */
  fn skip(amount: Int): Iterate<Item> {
    Skipped self, amount
  }

  /** Values up to, but not including, the first one that fails the predicate. */
  fn takeWhile(predicate: (value: Item) => Bool): Iterate<Item> {
    TakenWhile self, predicate
  }

  /** Pairs each value with the one at the same position of `other`; stops at the shorter of the two. */
  fn zip<Output>(other: Iterate<Output>): Iterate<(Item, Output)> {
    Zipped self, other
  }

  /**
   * `(0, first), (1, second), ...`, with the two halves named: `pair.index` and `pair.item` read better than
   * `pair.0` and `pair.1` wherever the pair is held instead of destructured.
   *
   * # Examples
   *
   *     for pair in ["a", "b"].indexed() {
   *       print "{pair.index}: {pair.item}"
   *     }
   */
  fn indexed(): Iterate<(index: Int, item: Item)> {
    Zipped(0.., self)
  }

  /** Lazy as a stage, but has to buffer all values as soon as it is iterated. */
  fn sorted<Key: Compare>(by: (value: Item) => Key): Iterate<Item> {
    Sorted self, by
  }

  /**
   * Puts a `Stage` in front of the values: the one stage that is written once and works on a `Source` of `std/stream`
   * just as well (`body.through(Json.items<User>())`). Everything above is the same stage with a name of its own.
   */
  fn through<Output>(stage: Stage<Item, Output>): Iterate<Output> {
    Staged self, stage
  }

  // --- Terminal operations ------------------------------------------------------------------------

  /**
   * The general terminal operation: pulls the values into an [Accumulator].
   *
   * The accumulator is taken by value, so what it fills is a copy and the caller's own value is untouched: collecting
   * twice with one accumulator is two independent runs. `isDone()` is asked before the first value and after every
   * `add`, so an accumulator that has seen enough (`taking`, `first`) stops the pull instead of reading a source to
   * its end.
   */
  fn collect<Output>(into: Accumulator<Item, Output>): Output {
    var accumulator = into
    if accumulator.isDone() {
      return accumulator.finish()
    }
    for value in self {
      accumulator.add value
      if accumulator.isDone() {
        break
      }
    }
    accumulator.finish()
  }

  /**
   * Collects into whatever can be created from an Iterate: `.to<Set<Int>>()`, or
   * `const names: List<String> = pipeline.to()`. No special trait needed, this is plain `From<Iterate<Item>>`.
   */
  fn to<Target: From<Iterate<Item>>>(): Target {
    Target.from self
  }

  /** The values, collected into a `List`. */
  fn toList(): List<Item> {
    to<List<Item>>()
  }

  /** The values, collected into a `Set`, which drops the duplicates. */
  fn toSet(): Set<Item> where Item: Hash {
    to<Set<Item>>()
  }

  /**
   * `["a", "b"].joined(separator: ", ")` is `"a, b"`. For `String` items, `show()` is the text itself.
   *
   * # Pitfalls
   *
   * It costs one pass over the pieces and `log n` passes over the bytes, and it holds the pieces and one merged level at
   * the same time - so joining a gigabyte needs two of them. `concatenated` says why appending to one accumulator would
   * be worse.
   */
  fn joined(separator: String = ""): String where Item: Show {
    var pieces: List<String> = []
    for item in self {
      pieces.append item.show()
    }
    concatenated pieces, separator
  }

  /** Runs `action` once for every value, for a step that produces nothing itself. */
  fn forEach(action: (value: Item) => Void) {
    for value in self {
      action value
    }
  }

  /** Combines every value into one, left to right, starting from `initial`. */
  fn fold<State>(initial: State, combine: (State, Item) => State): State {
    var state = initial
    for value in self {
      state = combine state, value
    }
    state
  }

  /** The first value that answers the predicate, or `None`. Stops pulling as soon as one is found. */
  fn find(predicate: (value: Item) => Bool): Item? {
    for value in self {
      if predicate(value) {
        return Some value
      }
    }
    None
  }

  /** The first value, or `None` when there is none. */
  fn first(): Item? {
    var cursor = iterate()              // `next` needs a `var` path, a temporary is not one
    cursor.next()
  }

  /** Whether at least one value answers the predicate. Stops at the first one that does. */
  fn any(predicate: (value: Item) => Bool): Bool {
    find(predicate).isSome()
  }

  /** Whether every value answers the predicate. Stops at the first one that does not. */
  fn all(predicate: (value: Item) => Bool): Bool {
    !any { !predicate(_) }
  }

  /** How many values there are. Reads every one, even where nothing about them is kept. */
  fn count(): Int {
    fold 0 { total, _ => total + 1 }
  }

  /** Every value, added together, starting from zero. */
  fn sum(): Item where Item: Add & From<Int> {
    fold Item.from(0) { a, b => a + b }
  }

  /** Shorthand for `collect(groupingBy(key))` */
  fn groupBy<Key: Hash>(key: (value: Item) => Key): Map<Key, List<Item>> {
    collect groupingBy(key)
  }
}
