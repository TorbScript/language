/**
 * Loads `.trb` files as sandboxed receiver closures - the mechanism behind `project.trb` and configuration scripts
 * (see "Receiver Scripts and the Sandbox" in CONCEPT.md, and docs/design/SCRIPTS.md).
 *
 * A script runs in the VM, always: the step and time limits and the panic that does not end the caller are properties
 * of an interpreter (docs/design/SCRIPTS.md section 1). A program `torb run` runs in the VM loads one, from a path it
 * was compiled with or from any other, and so does a native binary `torb build --embed-vm` built, which embeds the VM.
 * A native binary `torb build` compiled loads one through the front end and the VM it embeds (slice 8): the script
 * is checked against `Value` and run in that VM, and the value crosses as text in both directions, through the
 * derived `Encode` and `Decode` of `Value`, every field included - so a receiver of such a program is
 * `Encode & Decode`, which a type of plain settings is by derivation.
 */

use Duration from "std/time"
use Encode, Decode, EncodedValue, ValueDecoder from "std/encoding"
use crossingTextOf, crossingValueOf from "./crossing"

/**
 * What went wrong loading a script: a syntax or type error against the receiver type, or a capability it does not
 * have. `line` is 0 when the problem is not about one place in the script (e.g. the file could not be read).
 */
public type SandboxError with Show, Error {
  /** `0` when the problem is not about one place in the script, such as the file not being readable at all. */
  line: Int
  /** What went wrong, without the line number. */
  message: String

  /** `"{line}: {message}"`, or just `message` when there is no line. */
  fn show(): String {
    if line == 0 {
      return message
    }
    "{line}: {message}"
  }
}

/** The byte unit [SandboxCapabilities.limits] is written in. */
extend Int64 {
  /** Bytes, for `SandboxCapabilities.limits`: `64.megabytes()`. */
  fn megabytes(): Self {
    self * 1_000_000
  }
}

/**
 * What a script may do, granted at the call site of `Sandbox.load` - never in the script or its project file
 * (a script that could grant itself capabilities would not be a sandbox). Left at the defaults, a script has no
 * IO, no network, no clock, no environment and no foreign functions.
 */
public type SandboxCapabilities {
  /** The modules [SandboxCapabilities.modules] granted, which the script's imports are held against. */
  protected var moduleNames: List<String> = []
  protected var readOnlyRoots: List<String> = []
  protected var readWriteRoots: List<String> = []
  protected var variablePatterns: List<String> = []
  protected var stepLimit: Int = 1_000_000
  protected var memoryLimit: Int = 64_000_000
  /** Milliseconds: a `Duration` is no constant a default could be. */
  protected var timeLimit: Int = 2000
  protected var workerLimit: Int = 1

  /** Additional parts of the standard library the script may `use`, e.g. `"std/text"`. */
  var fn modules(...names: String) {
    moduleNames.appendAll names
  }

  /** File system roots the script may reach. A side that is left out stays closed. */
  var fn files(readOnly: String = "", readWrite: String = "") {
    if !readOnly.isEmpty() {
      readOnlyRoots.append readOnly
    }
    if !readWrite.isEmpty() {
      readWriteRoots.append readWrite
    }
  }

  /** Environment variable name patterns the script may read, e.g. `"APP_*"`. */
  var fn environment(...patterns: String) {
    variablePatterns.appendAll patterns
  }

  /**
   * Guards against runaway scripts (`loop {}`). `workers` is the most workers the script's tasks may run on at once
   * (docs/design/CONCURRENCY.md section 3): a script that could fan out over the host's cores would be a denial of
   * service its grant does not show. The VM runs the tasks of a script on the thread of its sandbox, so a script never
   * uses more than one whatever the number says.
   */
  var fn limits(steps: Int = 1_000_000, memory: Int = 64.megabytes(), time: Duration = 2.seconds(), workers: Int = 1) {
    stepLimit = steps
    memoryLimit = memory
    timeLimit = time.nanoseconds() / 1_000_000
    workerLimit = workers
  }

  /**
   * The grant as the VM's runtime reads it (docs/design/SCRIPTS.md section 4): one setting per line, a tab between the
   * word and the value. A relative root is read against the working directory, which is where the program runs.
   */
  private fn grantText(): String {
    var lines = [
      "base\t.",
      "memory\t{memoryLimit}",
      "steps\t{stepLimit}",
      "milliseconds\t{timeLimit}",
      "workers\t{workerLimit}",
    ]
    for root in readOnlyRoots {
      lines.append "read\t{root}"
    }
    for root in readWriteRoots {
      lines.append "write\t{root}"
    }
    for pattern in variablePatterns {
      lines.append "variable\t{pattern}"
    }
    lines.joined separator: "\n"
  }
}

/**
 * A loaded script, ready to run against a `Value` of the caller's own. It is not a closure, because the body of the
 * script runs inside the sandbox and can still fail there: a step, memory or time limit, or a panic - the only panic
 * in the language that is recoverable, because the VM is interpreting it and the script has a heap of its own.
 */
public type Script<Value> {
  /** The body of a script the program was compiled with; `None` for one loaded while it runs. */
  private body: ((var self: Value) => Void)?
  /** The body of a script the program loaded while it runs: what the VM knows it by. */
  private loaded: Int
  private granted: SandboxCapabilities
  /** In a native binary, the program of its VM the script runs in, as the text of its bytecode; empty elsewhere. */
  private program: String

  /** Runs the body of the script against `value`, configuring it in place. */
  fn apply(var value: Value): Result<Void, SandboxError> {
    var stopped = ""
    if !program.isEmpty() {
      stopped = runCrossed program, value, granted.grantText()
    } else {
      stopped = match body {
        Some(compiled) => runScript compiled, value, granted.grantText()
        None => runLoadedScript loaded, value, granted.grantText()
      }
    }
    if stopped.isEmpty() {
      return Ok(void)
    }
    Fail errorOf(stopped)
  }
}

/** Sandboxes and type checks `.trb` files against a receiver type. */
public native type Sandbox {
  /**
   * Type checks `path` against `Value` and returns it as a [Script], ready to run against a `Value` of the caller's
   * own. What is wrong with the file (syntax, types, a module the script may not import) is reported here; what goes
   * wrong while it runs is reported by [Script.apply] instead. The trailing block grants capabilities beyond the
   * defaults.
   *
   * A path the program was compiled with - a literal of a `Sandbox.load` - names a script the program carries, which
   * `torb check` checked with it. Any other path is read, checked against `Value` and lowered when the program asks for
   * it, relative to the working directory (docs/design/SCRIPTS.md slice 7); `Value` is then a type without type
   * arguments.
   *
   * # Examples
   *
   *     // check a native program that loads a script links the script host, which a doc test does not build
   *     type ServerConfig {
   *       var port: Int = 8080
   *     }
   *
   *     const loaded = Sandbox.load<ServerConfig>("./config.trb") {
   *       files readOnly: "./config"
   *       limits steps: 1_000_000, memory: 16.megabytes()
   *     }
   *     print loaded.isOk()
   */
  static fn load<Value>(
    path: String,
    capabilities: (var self: SandboxCapabilities) => Void = {},
  ): Result<Script<Value>, SandboxError> {
    var granted = SandboxCapabilities()
    capabilities granted
    const written = relativeScriptPath path
    var body: ((var self: Value) => Void)? = None
    var loaded = 0 - 1
    var imports = ""
    var program = ""
    const sources = scriptSources<Value>()
    if !sources.isEmpty() {
      // A native binary: the front end it embeds checks the file against `Value` and lowers it for its VM
      const answer = hostLoadScript sources, path, written, scriptReceiver<Value>()
      if answer.startsWith("!") {
        return Fail errorOf(answer.sliceBytes(1, answer.byteLength()))
      }
      imports = answer.substringBefore("\n\n") ?? ""
      program = answer.substringAfter("\n\n") ?? ""
    } else if const Some(found) = scriptBody<Value>(written) {
      body = found
      imports = scriptImports<Value>(written)
    } else {
      // A path the program was not compiled with: the running `torb` checks and lowers the file now
      const answer = loadScript<Value>(path, scriptReceiver<Value>())
      if const Some(stopped) = answer.substringAfter("!") {
        if answer.startsWith("!") {
          return Fail errorOf(stopped)
        }
      }
      loaded = Int.tryFrom(answer.substringBefore("\n") ?? answer).ok() ?? (0 - 1)
      imports = answer.substringAfter("\n") ?? ""
    }
    for line in imports.split("\n") {
      const (module, at) = match line.split("\t").toList() {
        [name, number] => (name, Int.tryFrom(number).ok() ?? 0)
        _ => {
          continue
        }
      }
      if !isGranted(granted.moduleNames, module) {
        return Fail(SandboxError(
          at,
          "The script may not import `{module}`: the caller grants it with `modules \"{module}\"`",
        ))
      }
    }
    Ok Script(body, loaded, granted, program)
  }
}

/**
 * Whether an import is granted: the grant names its module, or the package the module is in - `modules "std/os"` grants
 * `std/os/environment` and every other module of the package.
 */
fn isGranted(grants: List<String>, module: String): Bool {
  grants.contains(module) || grants.any({ module.startsWith "{_}/" })
}

/** `./config/../config.trb` is `config.trb`: the path as the table of the program's scripts spells it. */
fn relativeScriptPath(path: String): String {
  var segments: List<String> = []
  for segment in path.replace("\\", "/").split("/") {
    if segment.isEmpty() || segment == "." {
      continue
    }
    if segment == ".." && !segments.isEmpty() {
      segments.removeAt(segments.length() - 1)
      continue
    }
    segments.append segment
  }
  segments.joined separator: "/"
}

/** `"3\tthe message"`, which is how the VM reports a stop, as the error it is. */
fn errorOf(stopped: String): SandboxError {
  const line = Int.tryFrom(stopped.substringBefore("\t") ?? "0").ok() ?? 0
  SandboxError(line, stopped.substringAfter("\t") ?? stopped)
}

/**
 * The body of the script at `path` that was checked against `Value`, from the table of scripts the program was compiled
 * with; `None` for a path it was not. Generated by the lowering, one table per receiver type.
 */
native fn scriptBody<Value>(path: String): ((var self: Value) => Void)?

/** The modules the script at `path` imports, each with the line of its `use`: `"std/fs\t3"`, one per line. */
native fn scriptImports<Value>(path: String): String

/**
 * Runs `body` against `value` inside a sandbox of `grant` (docs/design/SCRIPTS.md section 4). Answers `""` where the
 * body ran to its end, and otherwise the line of the script and what stopped it, a tab between the two. Only the VM
 * runs it.
 */
native fn runScript<Value>(body: (var self: Value) => Void, var value: Value, grant: String): String

/**
 * Where the receiver `Value` is declared, `"<module path>\t<name>"`, which the running `torb` finds it by again when the
 * program loads a script from a path only known while it runs; empty for a type with type arguments. Generated by the
 * lowering, one per receiver type.
 */
native fn scriptReceiver<Value>(): String

/**
 * The file at `path` read, checked against the receiver `receiver` names and lowered into the running program by the
 * `torb` that runs it (docs/design/SCRIPTS.md slice 7). Answers what the VM knows the script's body by on the first line
 * and the modules it imports below it, as [scriptImports] spells them - or `!` and why it did not load, as
 * [runScript] answers a stop. Only the VM runs it.
 */
native fn loadScript<Value>(path: String, receiver: String): String

/** [runScript] for the body of a script [loadScript] loaded. Only the VM runs it. */
native fn runLoadedScript<Value>(body: Int, var value: Value, grant: String): String

// --- A native binary (docs/design/SCRIPTS.md slice 8) ----------------------------------------------------------------

/**
 * In a native binary, the files of the program as the front end it embeds checks them again, with the script as one
 * more module; empty in the VM, which is how [Sandbox.load] tells the two apart. Generated by the lowering.
 */
native fn scriptSources<Value>(): String

/**
 * The file at `path` - or the script the program was compiled with whose path below its package is `written` - checked
 * against the receiver `receiver` names and lowered, by the front end the binary embeds: the modules it imports as
 * [scriptImports] spells them, an empty line, and the program of the VM it runs in - or `!` and why it did not load.
 */
native fn hostLoadScript(sources: String, path: String, written: String, receiver: String): String

/**
 * Runs the program [hostLoadScript] answered in a sandbox of `grant`, on the value `input` holds as crossing text:
 * the configured value as crossing text, or `!` and the line and the message of the stop, a tab between the two.
 */
native fn hostRunScript(program: String, input: String, grant: String): String

/**
 * [Script.apply] in a native binary: [crossedApply] for the `Value` of the call, which the lowering holds to
 * `Encode & Decode` - the bound [Script] cannot carry, because the VM needs neither.
 */
native fn runCrossed<Value>(program: String, var value: Value, grant: String): String

/**
 * The value crosses into the VM as text and comes back configured, every field of it (docs/design/SCRIPTS.md section
 * 5). Answers `""` or a stop as [runScript] does.
 */
fn crossedApply<Value: Encode & Decode>(program: String, var value: Value, grant: String): String {
  const input = crossingTextOf EncodedValue.of(value, privateFields: true)
  const answer = hostRunScript program, input, grant
  if answer.startsWith("!") {
    return answer.sliceBytes 1, answer.byteLength()
  }
  const encoded = match crossingValueOf(answer) {
    Some(found) => found
    None => {
      return "0\tinternal error: the value the script configured came back unreadable"
    }
  }
  var source = ValueDecoder.of encoded, privateFields: true
  match Value.decode(source) {
    Ok(configured) => {
      value = configured
    }
    Fail(problem) => {
      return "0\tinternal error: the value the script configured does not decode: {problem}"
    }
  }
  ""
}

/**
 * In the VM of a native binary, the value read back from the text it crossed in as - before the script runs, and
 * outside its budget, so a limit counts the script alone, as it does in a program the VM runs.
 */
fn crossedIn<Value: Decode>(input: String): Value {
  const encoded = match crossingValueOf(input) {
    Some(found) => found
    None => panic "internal error: the value to configure arrived unreadable"
  }
  var source = ValueDecoder.of encoded, privateFields: true
  match Value.decode(source) {
    Ok(found) => found
    Fail(problem) => panic "internal error: the value to configure does not decode: {problem}"
  }
}

/** The configured value written out again the same way, once the script is done. */
fn crossedOut<Value: Encode>(value: Value): String {
  crossingTextOf EncodedValue.of(value, privateFields: true)
}
