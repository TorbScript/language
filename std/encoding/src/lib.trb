/**
 * Encoding and decoding: what other languages need reflection for (serialization, config mapping, database rows).
 *
 *     const text = Json.encode(user)
 *     const user = Json.decode<User>(text)?
 *
 * A type describes itself to an `Encoder` and reads itself from a `Decoder`. A format (`Json`, `Toml`, a database
 * driver) is an implementation of these two traits and never sees a type. There is no tree in between: values are
 * written while the type describes itself, and nothing is lost on the way.
 *
 * `Encode` is generated for every type whose fields are all `Encode`. `Decode` is generated if, in addition, the
 * constructor is usable from outside. The generated code is exactly what one would write by hand:
 *
 *     extend User with Encode, Decode {
 *       fn encode(var encoder: Encoder) {
 *         encoder.record("User") { fields =>
 *           fields.field("name", name)
 *           fields.field("tags", tags)
 *         }
 *       }
 *
 *       static fn decode(var decoder: Decoder): Result<User, DecodeError> {
 *         decoder.record("User") { fields =>
 *           Ok(User(
 *             name: fields.field("name")?,
 *             tags: fields.fieldOr("tags", [])?,        // Fields with a default value may be missing
 *           ))
 *         }
 *       }
 *     }
 */

use Hash from "std/core"
use Show from "std/core"
use Error from "std/core"
use Stage from "std/iteration"
use Bytes from "std/stream"

public trait Encode {
  fn encode(var encoder: Encoder)
}

/**
 * What a whole format is, once: bytes in both directions, and the two `Stage`s that make it work on a stream.
 *
 * `Encode`/`Decode` and `Encoder`/`Decoder` stay exactly as they are - **synchronous**, and that is the point. A
 * decoder that could wait would have to be written differently for every source, every derived implementation would
 * have to change with it, and the whole standard library would be coloured by it. Streaming happens one level up, at
 * the level it happens in practice: the **element**.
 *
 *     body.through(Json.items<User>()).checked()          // bytes in, one `User` at a time out, memory = one user
 *     Source.from(users).through(Json.encoded<User>())    // and back
 *
 * `items` is a resumable **framer**: it finds where one element ends in whatever bytes have arrived - across chunk
 * borders - and decodes that element synchronously, through the ordinary `Decode`. So the memory a stream of a million
 * records needs is one record, and no decoder had to learn anything new.
 *
 * A single huge *value* is deliberately not streamed into a type. It would colour every decoder (see above) and buy
 * almost nothing: the value itself is in memory either way, so all that is saved is the text it came from. What that
 * case needs is an **event level** (`Json.events`, SAX-like), and it is named in `docs/STREAMS.md` as later work.
 *
 * `Failure` is the second type parameter because the language has no associated types: `Json` is a
 * `Format<JsonError>`, and a function that works for any format says `fn load<Chosen: Format<Problem>, Problem>(...)`.
 */
public trait Format<Failure> {
  /** The whole value, as the bytes that go into a file or onto a wire. */
  static fn encodeAll(value: Encode): Bytes

  /** One whole value out of all of its bytes. */
  static fn decodeAll<Value: Decode>(bytes: Bytes): Result<Value, Failure>

  /**
   * Bytes to items. Fallible, so the items are `Result`s - a `Stage` is synchronous and knows nothing about the
   * failure of the stream around it; `source.checked()` is where they become one.
   */
  static fn items<Item: Decode>(): Stage<Bytes, Result<Item, Failure>>

  /** Items to bytes: the other direction, and the one that never fails. */
  static fn encoded<Item: Encode>(): Stage<Item, Bytes>
}

public trait Decode {
  static fn decode(var decoder: Decoder): Result<Self, DecodeError>
}

public type DecodeError with Show, Error {
  message: String
  path: List<String> = []

  /** `error.inside("email")`: errors collect the path on their way out. */
  fn inside(segment: String): DecodeError {
    copy path: path.inserted(0, segment)
  }

  fn show(): String {
    if path.isEmpty() {
      return message
    }
    const location = path.joined separator: "."
    "{location}: {message}"
  }
}

// --- What a format implements: writing --------------------------------------------------------------------------

/** The methods are named after the types of the language. Narrow numbers are widened, so nothing is lost. */
public trait Encoder {
  var fn nothing()
  var fn bool(value: Bool)
  var fn int(value: Int64)
  var fn unsigned(value: UInt64)
  var fn float(value: Float64)
  var fn decimal(value: Decimal)
  var fn string(value: String)
  var fn bytes(value: List<UInt8>)

  /** `length` is known for collections and unknown for pipelines. Items are written one by one: this streams. */
  var fn sequence(length: Int?, write: (var items: SequenceEncoder) => Void)
  var fn map(length: Int?, write: (var entries: MapEncoder) => Void)
  var fn record(typeName: String, write: (var fields: RecordEncoder) => Void)
  var fn variant(typeName: String, name: String, write: (var fields: RecordEncoder) => Void)
}

public trait SequenceEncoder {
  var fn item(value: Encode)
}

public trait MapEncoder {
  var fn entry(key: Encode, value: Encode)
}

public trait RecordEncoder {
  var fn field(name: String, value: Encode)
}

// --- What a format implements: reading ---------------------------------------------------------------------------

/**
 * Reading is driven by the type: it asks for what it expects and gets an error if something else is there.
 * (A format with unordered fields, like JSON, buffers one record at a time. Sequences are streamed.)
 */
public trait Decoder {
  /** Consumes a "nothing" if there is one. This is how `Option` decides between `None` and `Some`. */
  var fn nothing(): Bool

  var fn bool(): Result<Bool, DecodeError>
  var fn int(): Result<Int64, DecodeError>
  var fn unsigned(): Result<UInt64, DecodeError>
  var fn float(): Result<Float64, DecodeError>
  var fn decimal(): Result<Decimal, DecodeError>
  var fn string(): Result<String, DecodeError>
  var fn bytes(): Result<List<UInt8>, DecodeError>

  var fn sequence<Output>(
    read: (var items: SequenceDecoder) => Result<Output, DecodeError>,
  ): Result<Output, DecodeError>

  var fn map<Output>(
    read: (var entries: MapDecoder) => Result<Output, DecodeError>,
  ): Result<Output, DecodeError>

  var fn record<Output>(
    typeName: String,
    read: (var fields: RecordDecoder) => Result<Output, DecodeError>,
  ): Result<Output, DecodeError>

  var fn variant<Output>(
    typeName: String,
    read: (name: String, var fields: RecordDecoder) => Result<Output, DecodeError>,
  ): Result<Output, DecodeError>
}

public trait SequenceDecoder {
  /** `None` at the end of the sequence. */
  var fn next<Item: Decode>(): Result<Item?, DecodeError>
}

public trait MapDecoder {
  var fn next<Key: Decode, Value: Decode>(): Result<(Key, Value)?, DecodeError>
}

public trait RecordDecoder {
  var fn field<Value: Decode>(name: String): Result<Value, DecodeError>
  var fn fieldOr<Value: Decode>(name: String, default: lazy Value): Result<Value, DecodeError>
}

/** Any `Encode` value as readable text, for messages and debugging: `User(name: "Ada", tags: ["math"])` */
public native fn describe(value: Encode): String

// --- The standard library describes itself, too --------------------------------------------------------------------

extend Bool with Encode, Decode {
  fn encode(var encoder: Encoder) {
    encoder.bool self
  }

  static fn decode(var decoder: Decoder): Result<Bool, DecodeError> {
    decoder.bool()
  }
}

extend Int64 with Encode, Decode {
  fn encode(var encoder: Encoder) {
    encoder.int self
  }

  static fn decode(var decoder: Decoder): Result<Int64, DecodeError> {
    decoder.int()
  }
}

/** Narrow numbers travel as `Int64` and are checked on the way back. */
extend Int8 with Encode, Decode {
  fn encode(var encoder: Encoder) {
    encoder.int Int64.from(self)
  }

  static fn decode(var decoder: Decoder): Result<Int8, DecodeError> {
    const wide = decoder.int()?
    Int8.tryFrom(wide).mapError { DecodeError "{wide} does not fit into Int8" }
  }
}

/*
 * Every other number and the `Char`. They carry no `Decode` yet - `Decode` needs a `TryFrom` back, and only `Int8`,
 * `Int32` and `Int64` have one - but `Encode` is what a value has to have to be *looked at*: `describe(value)` renders
 * one, a quotation hands its captures on as `Encode` values (gap 36), and a SQL driver binds them as parameters. Without
 * these, a `Float64` field would make a whole syntax tree unshowable.
 */
extend Int16 with Encode {
  fn encode(var encoder: Encoder) {
    encoder.int Int64.from(self)
  }
}

extend Int32 with Encode {
  fn encode(var encoder: Encoder) {
    encoder.int Int64.from(self)
  }
}

extend UInt8 with Encode {
  fn encode(var encoder: Encoder) {
    encoder.int Int64.from(self)
  }
}

extend UInt16 with Encode {
  fn encode(var encoder: Encoder) {
    encoder.int Int64.from(self)
  }
}

extend UInt32 with Encode {
  fn encode(var encoder: Encoder) {
    encoder.int Int64.from(self)
  }
}

extend UInt64 with Encode {
  fn encode(var encoder: Encoder) {
    encoder.unsigned self
  }
}

extend Float32 with Encode {
  fn encode(var encoder: Encoder) {
    encoder.float Float64.from(self)
  }
}

extend Float64 with Encode {
  fn encode(var encoder: Encoder) {
    encoder.float self
  }
}

extend Decimal with Encode {
  fn encode(var encoder: Encoder) {
    encoder.decimal self
  }
}

/** A `Char` travels as a text of one character: the formats of the language have no character of their own. */
extend Char with Encode {
  fn encode(var encoder: Encoder) {
    encoder.string show()
  }
}

extend String with Encode, Decode {
  fn encode(var encoder: Encoder) {
    encoder.string self
  }

  static fn decode(var decoder: Decoder): Result<String, DecodeError> {
    decoder.string()
  }
}

extend<Value: Encode> Option<Value> with Encode {
  fn encode(var encoder: Encoder) {
    match self {
      Some(value) => value.encode encoder
      None => encoder.nothing()
    }
  }
}

extend<Value: Decode> Option<Value> with Decode {
  static fn decode(var decoder: Decoder): Result<Value?, DecodeError> {
    if decoder.nothing() {
      return Ok None
    }
    Ok Some(Value.decode(decoder)?)
  }
}

/** Lists and sets are sequences. A `Set` stays a `Set`: the target type decides on the way back. */
extend<Item: Encode> List<Item> with Encode {
  fn encode(var encoder: Encoder) {
    encoder.sequence Some(length()) { items =>
      for value in self {
        items.item value
      }
    }
  }
}

extend<Item: Encode> Set<Item> with Encode {
  fn encode(var encoder: Encoder) {
    toList().encode(encoder)
  }
}

extend<Key: Encode, Value: Encode> Map<Key, Value> with Encode {
  fn encode(var encoder: Encoder) {
    encoder.map Some(length()) { entries =>
      for (key, value) in self {
        entries.entry key, value
      }
    }
  }
}

extend<Item: Decode> List<Item> with Decode {
  static fn decode(var decoder: Decoder): Result<List<Item>, DecodeError> {
    decoder.sequence { items =>
      var result: List<Item> = []
      while const Some(value) = items.next()? {
        result.append value
      }
      Ok result
    }
  }
}

extend<Item: Decode & Hash> Set<Item> with Decode {
  static fn decode(var decoder: Decoder): Result<Set<Item>, DecodeError> {
    Ok((List<Item>.decode(decoder)?).toSet())
  }
}

extend<Key: Decode & Hash, Value: Decode> Map<Key, Value> with Decode {
  static fn decode(var decoder: Decoder): Result<Map<Key, Value>, DecodeError> {
    decoder.map { entries =>
      var result: Map<Key, Value> = [:]
      while const Some((key, value)) = entries.next()? {
        result[key] = value
      }
      Ok result
    }
  }
}
