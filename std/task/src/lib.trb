use Source, Sink from "std/stream"

/**
 * A computation that finishes later. Asynchrony lives in the type: a function that returns `Task<Value>` may call
 * `await()`, and its body produces the `Value` - the same way a function that returns `Result` may use `?`.
 *
 * A task starts running when it is created (`spawn { ... }`, or calling a function that returns one).
 * `Task` and `Channel` are the two shared types that connect tasks; everything else is copied into a task.
 */
public native shared type Task<Value> {
  /**
   * Waits for the value. Allowed in functions that return a `Task`, in closures passed to `spawn` and at the top
   * level of entry files and scripts.
   */
  native fn await(self): Value

  native fn map<Output>(self, transform: (value: Value) => Output): Task<Output>
  native fn flatMap<Output>(self, transform: (value: Value) => Task<Output>): Task<Output>

  /** A task for every item, running at the same time. The values arrive in the order of the tasks. */
  native fn all(tasks: Iterable<Task<Value>>): Task<List<Value>>
}

/** Runs the closure as a new task, in parallel. It gets copies of what it captures and cannot capture a `var`. */
public native fn spawn<Value>(body: () => Value): Task<Value>

/** Waits for two tasks of different types at once: `const (user, posts) = all(fetchUser(1), fetchPosts(1)).await()` */
public native fn all<First, Second>(first: Task<First>, second: Task<Second>): Task<(First, Second)>

/**
 * A stream in memory, of which one holder has both ends: a queue between two tasks.
 *
 *     const channel = Channel<Report>(capacity: 8)
 *     const writer = spawn { channel.sink().fill(reports).await() }
 *     const total = channel.source().count().await()
 *
 * `channel.source()` and `channel.sink()` are ordinary `Source` and `Sink` values and can be handed out separately, so
 * a producer never sees the reading end and a consumer never sees the writing one. They are methods and not fields
 * because they are computed, and because a field would have to be passed to the constructor.
 *
 * The reading end cannot fail (`Never`): a closed channel is the end of the stream, not a failure. The writing end
 * fails with `ChannelClosed` once the reader is gone, which is how a producer learns that nobody wants its items any
 * more - the cancellation signal of `Source.produce`.
 */
public native shared type Channel<Item> {
  /** `0` hands every item over directly: `add` waits until somebody pulls. */
  capacity: Int = 0

  /** Pulls items in the order they were added, and ends when the writing end is finished or closed. */
  native fn source(self): Source<Item, Never>

  /** `add` waits while the channel is full, `finish()` tells the reading end that the stream ended. */
  native fn sink(self): Sink<Item, ChannelClosed>
}

/**
 * Nobody is reading any more: the reading end of the channel was closed. The only way a `Channel`'s writing end fails,
 * and a value rather than a panic because a producer that is no longer needed should stop, not crash.
 */
public type ChannelClosed with Show, Error {
  fn show(self): String {
    "the channel is closed"
  }
}
