/**
 * The vocabulary of `project.trb`: [Project], [Dependencies], [Program], [Profile], [Test], [Tasks], [Workspace],
 * [Registry] and [Source]. A project file is a receiver script against [Project], so everything a project can say about
 * itself is a `var` field or a method of the types here - and nothing else is needed to write one, because a setting is
 * written `name = "acme/shop"` and a section `tasks { ... }`.
 *
 * The types are ordinary data, not `native`: a project file is deterministic and has no IO, so evaluating it is
 * nothing but running these members. This is what makes a `project.trb` *type check* against a real sandbox, with the
 * same vocabulary the toolchain's own static reading of the file understands.
 */

/** An owner bound to a registry, so a public package can never take the place of a private one. */
public type Registry {
  /** The `owner` part of every `owner/name` this registry answers for. */
  owner: String
  /** Where the registry is reached. */
  url: String
}

/**
 * Where one package comes from instead of the registry its owner is bound to (docs/design/PROJECT.md section 7): a
 * directory (`path`), a git repository at a revision (`git`, `revision`), or an archive with its hash (`archive`,
 * `hash`). Exactly one of `path`, `git` and `archive` is set.
 */
public type Source {
  /** The `owner/name` whose location this is. */
  package: String
  path: String = ""
  git: String = ""
  revision: String = ""
  archive: String = ""
  hash: String = ""
}

/**
 * What a project depends on. A requirement is written as it is published - `"acme/http:^1.2.3"` - because the version
 * is the business of the package manager and the project file only names what it wants.
 */
public type Dependencies {
  /** What dependents get too. */
  private(var) runtimeRequirements: List<String> = []
  /** Tests and tools. Never part of what dependents get. */
  private(var) developmentRequirements: List<String> = []

  /** Adds requirements that dependents get as well: `dependencies { runtime "acme/http:^1.2.3" }`. */
  var fn runtime(...requirements: String) {
    runtimeRequirements.appendAll requirements
  }

  /** Adds requirements for tests and tools only, never part of what a dependent gets. */
  var fn development(...requirements: String) {
    developmentRequirements.appendAll requirements
  }
}

/**
 * A program of the package beyond the `src/main.trb` that needs no line (docs/design/PROJECT.md section 4):
 * `program "migrate", entry: "tools/migrate.trb"`. A line without an `entry` renames that default program:
 * `program "torb"`.
 */
public type Program {
  /** The name of the program, of its binary, and of the argument to `torb run` and `torb build`. */
  name: String
  /** The file whose top-level code the program is, relative to the project. Empty renames `src/main.trb`. */
  entry: String = ""
  /** Where the binary goes, relative to the project and taken literally. Empty is `build/<profile>/<name>`. */
  output: String = ""
}

/**
 * How one of the two profiles builds (docs/design/PROJECT.md section 5): `profile "release" { optimize = 3 }`. The
 * profiles are `dev` and `release` and there is no third; a setting the back end does not have yet is read and ignored.
 */
public type Profile {
  /** `dev` or `release`. */
  name: String
  /** How hard the C compiler optimizes, 0 to 3: `1` in `dev`, `2` in `release`. */
  var optimize: Int = 1
  /** Whether the binary carries debug information for a debugger: in neither profile unless a block says so. */
  var debugInformation: Bool = false
  /** Whether a panic prints the frames that led to it: in `dev`, not in `release`. Read, and ignored for now. */
  var panicFrames: Bool = true

  /** The profile where no block says otherwise. */
  static fn named(name: String): Self {
    if name == "release" {
      return Self name, optimize: 2, panicFrames: false
    }
    Self name
  }
}

/**
 * Deprecated: nothing reads it. A file called `src/main.trb` is the program and `src/lib.trb` the library, another
 * program is a [Project.program] line, and where a binary goes is its `output` (docs/design/PROJECT.md section 4).
 */
public type Build {
  /** `"dev"` or `"release"`. */
  var target: String = "dev"
  /** The entry file. */
  var input: String = "src/main.trb"
  /** Where the built program goes, interpolated eagerly against `target` and the script's own bindings. */
  var output: String = ""
}

/** What `torb test` runs: every file called `*.test.trb` in the package. */
public type Test {
  /** Deprecated: nothing reads it, because a file called `*.test.trb` is a test wherever it lies in the package. */
  var input: String = "tests"
  /** The share of lines a test run has to cover, in percent. `0` asks for nothing. */
  var coverageThreshold: Int = 0
}

/**
 * How the program's tasks run (docs/design/CONCURRENCY.md section 3): `workers` threads run tasks, the core count where
 * the line is left out, and `blocking` threads run what blocks (`offload`), 4 where it is left out. `TORB_WORKERS` and
 * `TORB_BLOCKING` override both where the program runs. `0` is "not said"; a number the toolchain reads has to be 1 to
 * 1024.
 */
public type Tasks {
  var workers: Int = 0
  var blocking: Int = 0
}

/**
 * A project that consists of several projects. Every member is an ordinary project with a `project.trb` of its own;
 * a pattern is a directory or `directory/*` for every project directly below it.
 */
public type Workspace {
  /** The patterns [Workspace.members] added. */
  private(var) memberPatterns: List<String> = []

  /** Adds member patterns: `workspace { members "packages/*" }`. */
  var fn members(...patterns: String) {
    memberPatterns.appendAll patterns
  }
}

/**
 * The receiver of `project.trb`. A setting is a `var` field (`name = "acme/shop"` writes it), a section is a field
 * that is configured in place (`build { ... }`), and only what is more than that is a method (`authors`, `registry`).
 *
 * The fields are readable, which is what lets a project file compute from what it has already said:
 * `const binary = name.substringAfter("/") ?? name`.
 */
public type Project {
  /** `owner/name`. Owners are verified namespaces of a registry, so a bare name is not publishable. */
  var name: String = ""
  /** The published version, in the package manager's format. */
  var version: String = ""
  /** The oldest version of the language the project needs: `language = "0.3.0"`. */
  var language: String = ""
  /** One sentence about the package: required to publish it. */
  var description: String = ""
  /** The license, as an SPDX expression (`"MIT"`, `"MIT OR Apache-2.0"`): required to publish it. */
  var license: String = ""
  /** Where its source is read: `"https://github.com/acme/shop"`. */
  var repository: String = ""
  /** The package whose public names are in scope in every file of the project. */
  var prelude: String = "std/prelude"
  /** What the project needs, split into what dependents get and what stays inside the project. */
  var dependencies: Dependencies = Dependencies()
  /** Deprecated and read by nobody: see [Build]. */
  var build: Build = Build()
  /** What `torb test` runs. */
  var test: Test = Test()
  /** How the program's tasks run: the workers of its pool and the threads of its blocking pool. */
  var tasks: Tasks = Tasks()
  /** The other projects this one is a workspace of, if any. */
  var workspace: Workspace = Workspace()
  /** The names [Project.authors] added. */
  private(var) authorNames: List<String> = []
  /** The bindings [Project.registry] added. */
  private(var) registries: List<Registry> = []
  /** The locations [Project.source] added. */
  private(var) sources: List<Source> = []
  /** The programs [Project.program] declared, in order. */
  private(var) programs: List<Program> = []
  /** The profiles [Project.profile] configured, in order. */
  private(var) profiles: List<Profile> = []

  /** Names the people or organizations behind the project: `authors "Ada Lovelace"`. */
  var fn authors(...names: String) {
    authorNames.appendAll names
  }

  /** Binds an owner to the registry its packages come from: `registry "acme", url: "https://packages.acme.test"`. */
  var fn registry(owner: String, url: String) {
    registries.append Registry(owner, url)
  }

  /**
   * Says where a package comes from instead of its owner's registry: `source "acme/y", path: "../y"`,
   * `source "acme/x", git: "https://git.acme.test/x", revision: "v1.2.3"`, or
   * `source "acme/z", archive: "https://files.acme.test/z-1.0.tar.gz", hash: "sha256:..."`.
   */
  var fn source(
    package: String,
    path: String = "",
    git: String = "",
    revision: String = "",
    archive: String = "",
    hash: String = "",
  ) {
    sources.append Source(package, path, git, revision, archive, hash)
  }

  /**
   * Declares a program beyond `src/main.trb`: `program "migrate", entry: "tools/migrate.trb"`, or renames that one:
   * `program "torb"`. The three are read before anything runs, so they are plain strings.
   */
  var fn program(name: String, entry: String = "", output: String = "") {
    programs.append Program(name, entry, output)
  }

  /** Configures one of the two profiles: `profile "release" { optimize = 3 }`. */
  var fn profile(name: String, configure: (var self: Profile) => Void) {
    var configured = Profile.named name
    configure configured
    profiles.append configured
  }

  /**
   * The settings as the literal statements that would produce them, one per line, in the order of this type: the
   * `settings` block of the locked manifest (docs/design/PROJECT.md section 8), and the text the toolchain reads back
   * from an evaluated `project.trb` (docs/design/SCRIPTS.md section 7). A setting at its default is left out, because
   * the reader has defaults of its own: a workspace without a `test` section has no test directory.
   *
   * A field is printed back with `=` (`name = "acme/shop"`); a method - `runtime`, `development`, `members`,
   * `authors`, `registry` - is printed back as the command call that reaches it.
   */
  fn settings(): String {
    var lines: List<String> = []
    if !name.isEmpty() {
      lines.append "name = {quoted(name)}"
    }
    if !version.isEmpty() {
      lines.append "version = {quoted(version)}"
    }
    if !language.isEmpty() {
      lines.append "language = {quoted(language)}"
    }
    for (field, text) in [("description", description), ("license", license), ("repository", repository)] {
      if !text.isEmpty() {
        lines.append "{field} = {quoted(text)}"
      }
    }
    if prelude != "std/prelude" {
      lines.append "prelude = {quoted(prelude)}"
    }
    var needs: List<String> = []
    if !dependencies.runtimeRequirements.isEmpty() {
      needs.append "  runtime {quotedList(dependencies.runtimeRequirements)}"
    }
    if !dependencies.developmentRequirements.isEmpty() {
      needs.append "  development {quotedList(dependencies.developmentRequirements)}"
    }
    appendSection lines, "dependencies", needs
    var builds: List<String> = []
    if build.target != "dev" {
      builds.append "  target = {quoted(build.target)}"
    }
    if build.input != "src/main.trb" {
      builds.append "  input = {quoted(build.input)}"
    }
    if !build.output.isEmpty() {
      builds.append "  output = {quoted(build.output)}"
    }
    appendSection lines, "build", builds
    var tests: List<String> = []
    if test.input != "tests" {
      tests.append "  input = {quoted(test.input)}"
    }
    if test.coverageThreshold != 0 {
      tests.append "  coverageThreshold = {test.coverageThreshold}"
    }
    appendSection lines, "test", tests
    var pool: List<String> = []
    if tasks.workers != 0 {
      pool.append "  workers = {tasks.workers}"
    }
    if tasks.blocking != 0 {
      pool.append "  blocking = {tasks.blocking}"
    }
    appendSection lines, "tasks", pool
    if !workspace.memberPatterns.isEmpty() {
      appendSection lines, "workspace", ["  members {quotedList(workspace.memberPatterns)}"]
    }
    if !authorNames.isEmpty() {
      lines.append "authors {quotedList(authorNames)}"
    }
    for bound in registries {
      lines.append "registry {quoted(bound.owner)}, url: {quoted(bound.url)}"
    }
    for located in sources {
      var arguments = [quoted(located.package)]
      for (label, text) in [
        ("path", located.path),
        ("git", located.git),
        ("revision", located.revision),
        ("archive", located.archive),
        ("hash", located.hash),
      ] {
        if !text.isEmpty() {
          arguments.append "{label}: {quoted(text)}"
        }
      }
      lines.append "source {arguments.joined(separator: ", ")}"
    }
    for declared in programs {
      var arguments = [quoted(declared.name)]
      if !declared.entry.isEmpty() {
        arguments.append "entry: {quoted(declared.entry)}"
      }
      if !declared.output.isEmpty() {
        arguments.append "output: {quoted(declared.output)}"
      }
      lines.append "program {arguments.joined(separator: ", ")}"
    }
    for configured in profiles {
      appendProfile lines, configured
    }
    lines.map({ "{_}\n" }).toList().joined(separator: "")
  }
}

/**
 * What the toolchain runs to evaluate a `project.trb` (docs/design/SCRIPTS.md section 7): a fresh [Project], configured
 * by the script, printed back as its settings. It is the host of the script inside the VM's sandbox, and nothing a
 * program needs.
 */
public fn evaluated(script: (var self: Project) => Void): String {
  var project = Project()
  script project
  project.settings()
}

/**
 * `profile "release" {`, what differs from the profile's defaults, `}` - written even where nothing differs, because
 * the block is what the file said.
 */
fn appendProfile(var lines: List<String>, configured: Profile) {
  const standard = Profile.named configured.name
  var inside: List<String> = []
  if configured.optimize != standard.optimize {
    inside.append "  optimize = {configured.optimize}"
  }
  if configured.debugInformation != standard.debugInformation {
    inside.append "  debugInformation = {configured.debugInformation}"
  }
  if configured.panicFrames != standard.panicFrames {
    inside.append "  panicFrames = {configured.panicFrames}"
  }
  lines.append "profile {quoted(configured.name)} \{"
  lines.appendAll inside
  lines.append "\}"
}

/** `word {`, the lines, `}` - and nothing at all where there are no lines. */
fn appendSection(var lines: List<String>, word: String, inside: List<String>) {
  if inside.isEmpty() {
    return
  }
  lines.append "{word} \{"
  lines.appendAll inside
  lines.append "\}"
}

/** A string literal that reads back as `text`: the escapes of the lexer, and `\{` so nothing is interpolated. */
fn quoted(text: String): String {
  const escaped = text
    .replace("\\", "\\\\")
    .replace("\"", "\\\"")
    .replace("\{", "\\\{")
    .replace("\}", "\\\}")
    .replace("\n", "\\n")
    .replace("\r", "\\r")
    .replace("\t", "\\t")
  "\"{escaped}\""
}

/** `"a", "b"`: the arguments of a variadic setting. */
fn quotedList(texts: List<String>): String {
  texts.map(quoted).toList().joined(separator: ", ")
}
