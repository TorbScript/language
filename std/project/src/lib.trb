/**
 * The vocabulary of `project.trb`: [Project], [Dependencies], [Build], [Test], [Workspace] and [Registry]. A project
 * file is a receiver script against [Project], so everything a project can say about itself is a `var` field or a
 * method of the types here - and nothing else is needed to write one, because a setting is written `name "acme/shop"`
 * and a section `build { ... }`.
 *
 * The types are ordinary data, not `native`: a project file is deterministic and has no IO, so evaluating it is
 * nothing but running these members. This is what makes a `project.trb` *type check* against a real sandbox, with the
 * same vocabulary the toolchain's own static reading of the file understands.
 */

/** An owner bound to a registry, so a public package can never take the place of a private one. */
public type Registry {
  /** The `owner` part of every `owner/name` this registry answers for. */
  owner: String
  /** Where the registry is reached. */
  url: String
}

/**
 * What a project depends on. A requirement is written as it is published - `"acme/http:^1.2.3"` - because the version
 * is the business of the package manager and the project file only names what it wants.
 */
public type Dependencies {
  /** What dependents get too. */
  private(var) runtimeRequirements: List<String> = []
  /** Tests and tools. Never part of what dependents get. */
  private(var) developmentRequirements: List<String> = []

  /** Adds requirements that dependents get as well: `dependencies { runtime "acme/http:^1.2.3" }`. */
  var fn runtime(...requirements: String) {
    runtimeRequirements.addAll requirements
  }

  /** Adds requirements for tests and tools only, never part of what a dependent gets. */
  var fn development(...requirements: String) {
    developmentRequirements.addAll requirements
  }
}

/** What `torb build` produces. `output` is interpolated eagerly, so it reads `target` and the script's own bindings. */
public type Build {
  /** `"dev"` or `"release"`. */
  var target: String = "dev"
  /** The entry file. */
  var input: String = "src/main.trb"
  /** Where the built program goes, interpolated eagerly against `target` and the script's own bindings. */
  var output: String = ""
}

/** What `torb test` runs. */
public type Test {
  /** Where the tests are. */
  var input: String = "tests"
  /** The share of lines a test run has to cover, in percent. `0` asks for nothing. */
  var coverageThreshold: Int = 0
}

/**
 * A project that consists of several projects. Every member is an ordinary project with a `project.trb` of its own;
 * a pattern is a directory or `directory/*` for every project directly below it.
 */
public type Workspace {
  /** The patterns [Workspace.members] added. */
  private(var) memberPatterns: List<String> = []

  /** Adds member patterns: `workspace { members "packages/*" }`. */
  var fn members(...patterns: String) {
    memberPatterns.addAll patterns
  }
}

/**
 * The receiver of `project.trb`. A setting is a `var` field (`name "acme/shop"` writes it), a section is a field that
 * is configured in place (`build { ... }`), and only what is more than that is a method (`authors`, `registry`).
 *
 * The fields are readable, which is what lets a project file compute from what it has already said:
 * `const binary = name.substringAfter("/") ?? name`.
 */
public type Project {
  /** `owner/name`. Owners are verified namespaces of a registry, so a bare name is not publishable. */
  var name: String = ""
  /** The published version, in the package manager's format. */
  var version: String = ""
  /** The package whose public names are in scope in every file of the project. */
  var prelude: String = "std/prelude"
  /** What the project needs, split into what dependents get and what stays inside the project. */
  var dependencies: Dependencies = Dependencies()
  /** What `torb build` produces. */
  var build: Build = Build()
  /** What `torb test` runs. */
  var test: Test = Test()
  /** The other projects this one is a workspace of, if any. */
  var workspace: Workspace = Workspace()
  /** The names [Project.authors] added. */
  private(var) authorNames: List<String> = []
  /** The bindings [Project.registry] added. */
  private(var) registries: List<Registry> = []

  /** Names the people or organizations behind the project: `authors "Ada Lovelace"`. */
  var fn authors(...names: String) {
    authorNames.addAll names
  }

  /** Binds an owner to the registry its packages come from: `registry "acme", url: "https://packages.acme.test"`. */
  var fn registry(owner: String, url: String) {
    registries.add Registry(owner, url)
  }
}
