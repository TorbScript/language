/**
 * HMAC against RFC 2202 (HMAC-MD5, HMAC-SHA-1) and RFC 4231 (HMAC-SHA-256), including both algorithms' cases for a key
 * longer than a block - the one path that hashes the key before folding it into the pads.
 */

use test, group from "std/test"
use HmacSha256, HmacSha1, HmacMd5 from "../src/lib"

/** `count` copies of `byte`: the repeated-byte keys and data RFC 2202 and RFC 4231 use. */
fn repeatedByte(byte: Int, count: Int): List<UInt8> {
  var bytes: List<UInt8> = []
  for _ in 0..count {
    bytes.append(UInt8.tryFrom(byte).ok() ?? 0)
  }
  bytes
}

const key4: List<UInt8> = [
  0x01,
  0x02,
  0x03,
  0x04,
  0x05,
  0x06,
  0x07,
  0x08,
  0x09,
  0x0a,
  0x0b,
  0x0c,
  0x0d,
  0x0e,
  0x0f,
  0x10,
  0x11,
  0x12,
  0x13,
  0x14,
  0x15,
  0x16,
  0x17,
  0x18,
  0x19,
]

group "HMAC-MD5 (RFC 2202)" {
  test "the seven cases" {
    assert(HmacMd5.of(repeatedByte(0x0b, 16), "Hi There".bytes()).hex() == "9294727a3638bb1c13f48ef8158bfc9d")
    const jefe = HmacMd5.of "Jefe".bytes(), "what do ya want for nothing?".bytes()
    assert(jefe.hex() == "750c783e6ab0b503eaa86e310a5db738")
    const dd = HmacMd5.of repeatedByte(0xaa, 16), repeatedByte(0xdd, 50)
    assert(dd.hex() == "56be34521d144c88dbb8c733f0e8b3f6")
    const cd = HmacMd5.of key4, repeatedByte(0xcd, 50)
    assert(cd.hex() == "697eaf0aca3a3aea3a75164746ffaa79")
    const truncation = HmacMd5.of repeatedByte(0x0c, 16), "Test With Truncation".bytes()
    assert(truncation.hex() == "56461ef2342edc00f9bab995690efd4c")
    const longKeyText = "Test Using Larger Than Block-Size Key - Hash Key First"
    const longKey = HmacMd5.of repeatedByte(0xaa, 80), longKeyText.bytes()
    assert(longKey.hex() == "6b1ab7fe4bd7bf8f0b62e6ce61b9d0cd")
    const longBoth = "Test Using Larger Than Block-Size Key and Larger Than One Block-Size Data"
    const longBothDigest = HmacMd5.of repeatedByte(0xaa, 80), longBoth.bytes()
    assert(longBothDigest.hex() == "6f630fad67cda0ee1fb1f562db3aa53e")
  }
}

group "HMAC-SHA-1 (RFC 2202)" {
  test "the seven cases" {
    const first = HmacSha1.of repeatedByte(0x0b, 20), "Hi There".bytes()
    assert(first.hex() == "b617318655057264e28bc0b6fb378c8ef146be00")
    const jefe = HmacSha1.of "Jefe".bytes(), "what do ya want for nothing?".bytes()
    assert(jefe.hex() == "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    const dd = HmacSha1.of repeatedByte(0xaa, 20), repeatedByte(0xdd, 50)
    assert(dd.hex() == "125d7342b9ac11cd91a39af48aa17b4f63f175d3")
    const cd = HmacSha1.of key4, repeatedByte(0xcd, 50)
    assert(cd.hex() == "4c9007f4026250c6bc8414f9bf50c86c2d7235da")
    const truncation = HmacSha1.of repeatedByte(0x0c, 20), "Test With Truncation".bytes()
    assert(truncation.hex() == "4c1a03424b55e07fe7f27be1d58bb9324a9a5a04")
    const longKeyText = "Test Using Larger Than Block-Size Key - Hash Key First"
    const longKey = HmacSha1.of repeatedByte(0xaa, 80), longKeyText.bytes()
    assert(longKey.hex() == "aa4ae5e15272d00e95705637ce8a3b55ed402112")
    const longBoth = "Test Using Larger Than Block-Size Key and Larger Than One Block-Size Data"
    const longBothDigest = HmacSha1.of repeatedByte(0xaa, 80), longBoth.bytes()
    assert(longBothDigest.hex() == "e8e99d0f45237d786d6bbaa7965c7808bbff1a91")
  }
}

group "HMAC-SHA-256 (RFC 4231)" {
  test "the cases up to a key the size of a block" {
    const case1 = HmacSha256.of repeatedByte(0x0b, 20), "Hi There".bytes()
    assert(case1.hex() == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    const jefe = HmacSha256.of "Jefe".bytes(), "what do ya want for nothing?".bytes()
    assert(jefe.hex() == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    const case3 = HmacSha256.of repeatedByte(0xaa, 20), repeatedByte(0xdd, 50)
    assert(case3.hex() == "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
    const case4 = HmacSha256.of key4, repeatedByte(0xcd, 50)
    assert(case4.hex() == "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
  }

  test "a key longer than the block, hashed before it is folded into the pads" {
    const longKeyText = "Test Using Larger Than Block-Size Key - Hash Key First"
    const case6 = HmacSha256.of repeatedByte(0xaa, 131), longKeyText.bytes()
    assert(case6.hex() == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
    const longBoth =
      "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."
    const case7 = HmacSha256.of repeatedByte(0xaa, 131), longBoth.bytes()
    assert(case7.hex() == "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")
  }

  test "fed in pieces, it answers what it answers at once" {
    var hmac = HmacSha256.keyed "key".bytes()
    hmac.add "mess".bytes()
    hmac.add "age".bytes()
    assert(hmac.finished() == HmacSha256.of("key".bytes(), "message".bytes()))
  }

  test "finishing does not change the hasher" {
    var hmac = HmacSha256.keyed "key".bytes()
    hmac.add "one".bytes()
    const early = hmac.finished()
    hmac.add "two".bytes()
    assert(early == HmacSha256.of("key".bytes(), "one".bytes()))
    assert(hmac.finished() == HmacSha256.of("key".bytes(), "onetwo".bytes()))
  }
}
