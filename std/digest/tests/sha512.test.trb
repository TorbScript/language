/**
 * SHA-512 against the examples of FIPS 180-4 and digests Node's `crypto` computed for the lengths around the 112 bytes
 * where the padding needs a second block, fed at once and in pieces that cross the 128-byte blocks.
 */

use test, group from "std/test"
use Sha512 from "../src/lib"

fn hexOf(text: String): String {
  Sha512.of(text.bytes()).hex()
}

group "SHA-512" {
  test "the examples of FIPS 180-4" {
    const empty = "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
    assert(hexOf("") == empty)
    const abc = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    assert(hexOf("abc") == abc)
    const short = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    const shortDigest = "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445"
    assert(hexOf(short) == shortDigest)
    const long = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    const longDigest = "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"
    assert(hexOf(long) == longDigest)
  }

  test "the lengths on either side of a second block of padding" {
    const below = "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2"
    assert(hexOf("a".repeat(111)) == below)
    const above = "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca"
    assert(hexOf("a".repeat(112)) == above)
  }

  test "a thousand bytes" {
    const digest = "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97"
    assert(hexOf("a".repeat(1000)) == digest)
  }

  test "fed in pieces, it answers what it answers at once" {
    const bytes = "The quick brown fox jumps over the lazy dog, again and again and again.".repeat(5).bytes()
    const whole = Sha512.of(bytes).hex()
    for size in [1, 3, 111, 112, 127, 128, 129, 256] {
      var hasher = Sha512()
      var at = 0
      while at < bytes.length() {
        const end = if at + size < bytes.length() { at + size } else { bytes.length() }
        hasher.add bytes[at..end]
        at = end
      }
      assert(hasher.finished().hex() == whole)
    }
  }

  test "finishing does not change the hasher" {
    var hasher = Sha512()
    hasher.add "ab".bytes()
    const early = hasher.finished()
    hasher.add "c".bytes()
    assert(early.hex() == hexOf("ab"))
    assert(hasher.finished() == Sha512.of("abc".bytes()))
  }

  test "a digest is 64 bytes" {
    assert(Sha512.of([]).bytes.length() == 64)
  }
}
