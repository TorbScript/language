/**
 * SHA-256 against the examples of FIPS 180-4 and NIST's short-message vectors, fed at once and in pieces that cross the
 * 64-byte blocks at every boundary that matters.
 */

use test, group from "std/test"
use Sha256, Digest from "../src/lib"

fn hexOf(text: String): String {
  Sha256.of(text.bytes().toList()).hex()
}

group "SHA-256" {
  test "the examples of FIPS 180-4" {
    assert(hexOf("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert(hexOf("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    const long = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    assert(hexOf(long) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
  }

  test "a message whose padding needs a second block" {
    const text = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    assert(hexOf(text) == "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")
  }

  test "a thousand bytes" {
    assert(hexOf("a".repeat(1000)) == "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3")
  }

  test "fed in pieces, it answers what it answers at once" {
    const bytes = "The quick brown fox jumps over the lazy dog, again and again and again.".repeat(5).bytes().toList()
    const whole = Sha256.of(bytes).hex()
    for size in [1, 3, 55, 56, 63, 64, 65, 128] {
      var hasher = Sha256()
      var at = 0
      while at < bytes.length() {
        const end = if at + size < bytes.length() { at + size } else { bytes.length() }
        hasher.add bytes[at..end]
        at = end
      }
      assert(hasher.finished().hex() == whole)
    }
  }

  test "finishing does not change the hasher" {
    var hasher = Sha256()
    hasher.add "ab".bytes().toList()
    const early = hasher.finished()
    hasher.add "c".bytes().toList()
    assert(early.hex() == hexOf("ab"))
    assert(hasher.finished() == Sha256.of("abc".bytes().toList()))
  }

  test "a digest shows as its hexadecimal" {
    const digest = Digest([0, 15, 16, 255])
    assert(digest.show() == "000f10ff")
  }
}
