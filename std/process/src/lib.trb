/**
 * The process itself, and the child processes it starts: [Process] for arguments and exiting, [Process.run] for a
 * program run to its end, [Child] for a running program's pipes, and [ProcessOutput] for what a finished one left behind.
 *
 * A child process's three pipes are the same [Source] and [Sink] a file or a socket has, so a pipeline between two
 * programs is `first.output().into(second.input())`.
 */

use IoError from "std/fs"
use ArrayList from "std/collections"
use Source, Sink, Bytes from "std/stream"
use offload from "std/task"

/** What a program run with [Process.run] or [Process.runBlocking] left behind. */
public type ProcessOutput {
  /** `0` for success, anything else for the code the program exited with. */
  exitCode: Int
  /** Everything the program wrote to its standard output. */
  standardOutput: String
  /** Everything the program wrote to its standard error, kept apart from [ProcessOutput.standardOutput]. */
  standardError: String

  /** The usual question about a child process: did it do what it was asked. */
  fn isSuccess(): Bool {
    exitCode == 0
  }
}

/**
 * A child process that is still running, started with [Process.start]. Its three pipes are the same [Source] and
 * [Sink] a file or a socket has, so a pipeline between two programs is `first.output().into(second.input())`.
 *
 * # Examples
 *
 *     fn sortTwo(): Task<Result<Void, IoError>> {
 *       using child = Process.start("sort", ["-u"])?
 *       var input = child.input()
 *       input.addLine("banana").await()?
 *       input.addLine("apple").await()?
 *       input.end().await()?
 *       const chunks = child.output().toList().await()?
 *       const code = child.wait().await()?
 *       print "{chunks.length()} chunks, exit code {code}"
 *       Ok void
 *     }
 *
 * Every line is `.await()?`: the `?` is the failure of the pipe, and a cancellation needs nothing - it stops the task
 * at the `await()` it meets, and the `using` closes the child's pipes on the way out. A program whose whole input is
 * known up front needs no pipe at all: [Process.run] feeds it.
 *
 * # Pitfalls
 *
 * [Child.close] releases the pipes and stops waiting for the child; it does not kill it, because ending somebody
 * else's program is a decision and not a cleanup.
 */
public shared type Child with Close {
  private handle: Int
  private program: String

  /** A child over a handle the runtime answered. */
  static fn of(handle: Int, program: String): Child {
    Child handle, program
  }

  /** What the child reads. `end()` closes its standard input, which is how most filters learn that they are done. */
  fn input(): Sink<Bytes, IoError> {
    ChildInput.of self
  }

  /** What the child writes to standard output. */
  fn output(): Source<Bytes, IoError> {
    ChildOutput.of self, 1
  }

  /** What the child writes to standard error, kept apart from [Child.output]. */
  fn errors(): Source<Bytes, IoError> {
    ChildOutput.of self, 2
  }

  /** The exit code, once the program has ended; the child is waited for on a thread of the blocking pool. */
  fn wait(): Task<Result<Int, IoError>> {
    const code = childWait(handle).await()
    if code <= failureBound {
      return Fail IoError(program, processFailureText(code))
    }
    Ok code
  }

  /** Releases the three pipes and stops waiting for the child; see the type's own pitfall about killing it. */
  var fn close() {
    childClose handle
  }

  /** At most `maximum` bytes of one of its two outputs: `None` at its end. */
  fn read(which: Int, maximum: Int): Task<Result<Bytes?, IoError>> {
    const count = childRead(handle, which, maximum).await()
    if count < 0 {
      return Fail IoError(program, processFailureText(count))
    }
    if count == 0 {
      return Ok None
    }
    var bytes: ArrayList<UInt8> = ArrayList.withCapacity count
    childTakeRead handle, which, bytes
    Ok Some(bytes)
  }

  /** All of `bytes` into its input. */
  fn write(bytes: Bytes): Task<Result<Void, IoError>> {
    const buffer: ArrayList<UInt8> = ArrayList.from bytes
    var from = 0
    while from < buffer.length() {
      const written = childWrite(handle, buffer, from).await()
      if written < 0 {
        return Fail IoError(program, processFailureText(written))
      }
      from = from + written
    }
    Ok void
  }

  /** Closes its input: the child reads the end of it. */
  fn endInput(): Result<Void, IoError> {
    const ended = childEndInput handle
    if ended < 0 {
      return Fail IoError(program, processFailureText(ended))
    }
    Ok void
  }
}

/** The input of a [Child]: a `Sink<Bytes, IoError>` whose `end()` closes it. */
shared type ChildInput with Sink<Bytes, IoError> {
  private child: Child

  static fn of(child: Child): ChildInput {
    ChildInput child
  }

  var fn add(item: Bytes): Task<Result<Void, IoError>> {
    child.write(item).await()
  }

  var fn end(): Task<Result<Void, IoError>> {
    child.endInput()
  }

  /** Nothing of its own: the child's pipes close once its last holder is gone. */
  var fn close() {}
}

/** One of the two outputs of a [Child] (1 standard output, 2 standard error): a `Source<Bytes, IoError>`. */
shared type ChildOutput with Source<Bytes, IoError> {
  private child: Child
  private which: Int

  static fn of(child: Child, which: Int): ChildOutput {
    ChildOutput child, which
  }

  var fn next(): Task<Result<Bytes?, IoError>> {
    child.read(which, 65536).await()
  }

  /** Nothing of its own: the child's pipes close once its last holder is gone. */
  var fn close() {}
}

/**
 * What an exit code is above and a failure of a wait below: a failure of the operating system is answered as minus its
 * code minus 2^40 (runtime/stream.c), and no exit code of any system is that far down.
 */
const failureBound = 0 - 1099511627776

/** The running program: its command line, how it exits, and the child processes it starts. */
public native type Process {
  /** The command line arguments, without the program itself. */
  native static fn arguments(): List<String>

  /** Ends the program. Open resources are not closed: prefer to return from the entry file. */
  native static fn exit(code: Int): Never

  /**
   * The absolute path of the running program's own executable, with `/` between its parts, or `None` where the
   * operating system does not say. It is native because only the operating system knows it, and it is how a program
   * finds the files it was installed beside - `torb` finds its `std/` and `runtime/` this way.
   *
   * # Examples
   *
   *     if const Some(path) = Process.executablePath() {
   *       print path
   *     }
   *
   * # Pitfalls
   *
   * Windows and Linux answer; an operating system without a way to ask (macOS, a BSD without `/proc`) answers `None`
   * rather than a guess from the command line, which names whatever the caller typed.
   */
  native static fn executablePath(): String?

  /**
   * Runs a program to its end as a task: feeds it `input` as the whole of its standard input, and collects its exit
   * code and the two streams it wrote into a [ProcessOutput]. The arguments are passed as they are: nothing about them
   * is interpreted and nothing has to be quoted.
   *
   *     fn sorted(): Task<Result<String, IoError>> {
   *       const output = Process.run("sort", [], input: "banana\napple\n").await()?
   *       Ok output.standardOutput
   *     }
   *
   * A program that could not be started at all is an `IoError`; a program that ran and failed is an exit code, which
   * is how a caller tells "there is no such program" from "the program said no".
   *
   * # Pitfalls
   *
   * - The input ends after `input`, and an empty one ends at once: the program never reads the terminal this program
   *   was started from, so a program that would ask a question gets the end of its input instead of hanging.
   * - The two streams arrive apart, so the order in which the program interleaved them is lost: a line of
   *   [ProcessOutput.standardError] cannot be placed between two lines of [ProcessOutput.standardOutput]. A caller that
   *   needs the output while it arrives reaches for [Process.start] instead, which hands out real pipes.
   * - The wait for the program runs on the blocking pool where the arguments may move there ([offload]), and blocks the
   *   worker that asked where they may not. Cancelling the task does not stop the program: it runs to its end, and what
   *   it wrote is thrown away.
   *
   * # Related
   *
   * - [Process.runBlocking] - the same run for code that is not a task, without an input.
   * - [Process.start] - a program whose output is read while it runs.
   */
  static fn run(program: String, arguments: List<String>, input: String = ""): Task<Result<ProcessOutput, IoError>> {
    offload({ Process.fed program, arguments, input }).await()
  }

  /** The body of [Process.run], on the thread `offload` hands it. */
  private static fn fed(program: String, arguments: List<String>, input: String): Result<ProcessOutput, IoError> {
    var output = ""
    var failure = ""
    const collected: ArrayList<String> = ArrayList.from arguments
    const code = Process.runFeeding program, collected, input, output, failure
    if code < 0 {
      return Fail IoError(program, failure)
    }
    Ok ProcessOutput(code, output, failure)
  }

  /**
   * Runs a program to its end and collects everything about it, blocking the thread that asks - the form for code that
   * is not a task, such as a driver that runs the C compiler. The child reads this program's own standard input. The
   * arguments are passed as they are, like [Process.run]'s.
   *
   * A program that could not be started at all is an `IoError`; a program that ran and failed is an exit code, which
   * is why `torb build` can tell "there is no C compiler" from "the C compiler said no".
   *
   * # Pitfalls
   *
   * - Inside a task it stalls every other task of the worker that runs it until the program ends: a task writes
   *   `Process.run(program, arguments).await()?`.
   * - The two streams arrive apart, as they do for [Process.run].
   */
  static fn runBlocking(program: String, arguments: List<String>): Result<ProcessOutput, IoError> {
    var output = ""
    var failure = ""
    // The runtime has one list, and it takes it as the buffer it is: a trait-typed `List<String>` says nothing about
    // which implementation carries it, so the concrete one is what crosses the boundary
    const collected: ArrayList<String> = ArrayList.from arguments
    const code = Process.runCollecting program, collected, output, failure
    if code < 0 {
      return Fail IoError(program, failure)
    }
    Ok ProcessOutput(code, output, failure)
  }

  /**
   * [Process.runCollecting] with `input` as all the child reads: the one shape a runtime function can have for
   * [Process.run], for the same reasons.
   */
  native static fn runFeeding(
    command: String,
    arguments: ArrayList<String>,
    input: String,
    var output: String,
    var failure: String,
  ): Int

  /**
   * The exit code of the program, with what it wrote to standard output in `output` and what it wrote to standard
   * error in `failure` - or **-1** where it could not be started at all, and then `failure` says why. The one shape a runtime function can have for this: a `Result` and a
   * `ProcessOutput` are types of the program, and starting a process is the operating system.
   */
  native static fn runCollecting(
    command: String,
    arguments: ArrayList<String>,
    var output: String,
    var failure: String,
  ): Int

  /**
   * Runs a program to its end with **this program's own three streams**, and answers its exit code. The arguments are
   * passed as they are, like [Process.run]'s.
   *
   * This is what a driver runs a program with: nothing is collected, so what the child writes appears where this
   * program's output appears *while* it writes it, its two streams stay apart and in their order, and a program that
   * reads standard input reads the one the user is typing into. [Process.run] answers what a program wrote, which is
   * the other question and needs a pipe for it.
   *
   * A program that could not be started at all is an `IoError`; a program that ran and failed is an exit code.
   *
   * # Examples
   *
   *     // check
   *     const code = Process.runPassingThrough("git", ["status", "--short"])?
   *     Process.exit code
   *
   * # Errors
   *
   * - The program is not on `PATH`, or it is not a program at all.
   *
   * # Related
   *
   * - [Process.run] - the same run with everything it wrote collected into a [ProcessOutput].
   */
  static fn runPassingThrough(program: String, arguments: List<String>): Result<Int, IoError> {
    var failure = ""
    const collected: ArrayList<String> = ArrayList.from arguments
    const code = Process.runInheriting program, collected, failure
    if code < 0 {
      return Fail IoError(program, failure)
    }
    Ok code
  }

  /**
   * The exit code of the program, or **-1** where it could not be started at all, and then `failure` says why. The
   * same shape [Process.runCollecting] has, without the output: there is none to answer with.
   */
  native static fn runInheriting(command: String, arguments: ArrayList<String>, var failure: String): Int

  /**
   * Starts a program and hands back its pipes, for output that is too big to collect or that has to be read while it
   * arrives. [Process.run] is the short form for everything else. The program is started through no shell, and a
   * program that cannot be started at all is the failure.
   */
  static fn start(program: String, arguments: List<String>): Result<Child, IoError> {
    var failure = ""
    const handle = childStart program, ArrayList.from(arguments), failure
    if handle < 0 {
      return Fail IoError(program, failure)
    }
    Ok Child.of(handle, program)
  }
}

// --- the natives of runtime/stream.c ---------------------------------------------------------------------------------

/** A child with three pipes, through no shell: its handle, or -1 with why in `failure`. */
native fn childStart(program: String, arguments: ArrayList<String>, var failure: String): Int

/** At most `maximum` bytes of its output (1) or errors (2), on a thread of the blocking pool: how many, or a failure. */
native fn childRead(child: Int, which: Int, maximum: Int): Task<Int>

/** What the last [childRead] of that output got, appended to `into`. */
native fn childTakeRead(child: Int, which: Int, var into: ArrayList<UInt8>)

/** The bytes of `bytes` from `from` on into its input: how many, or a failure. */
native fn childWrite(child: Int, bytes: ArrayList<UInt8>, from: Int): Task<Int>

/** Closes its input: 0, or a failure. */
native fn childEndInput(child: Int): Int

/** Waits for it to end, on a thread of the blocking pool: its exit code, or a failure below [failureBound]. */
native fn childWait(child: Int): Task<Int>

/** Lets go of its handle and its pipes; the child runs on. */
native fn childClose(child: Int)

/** A failure a native answered, in the operating system's own words. */
native fn processFailureText(failure: Int): String

