use IoError from "std/fs"
use Source, Sink, Bytes from "std/stream"

/** What a program that was run to its end left behind. */
public type ProcessOutput {
  exitCode: Int
  standardOutput: String
  standardError: String

  /** The usual question about a child process: did it do what it was asked. */
  fn isSuccess(self): Bool {
    exitCode == 0
  }
}

/**
 * A child process that is still running. Its three pipes are the same `Source` and `Sink` a file or a socket has, so
 * a pipeline between two programs is `first.output().into(second.input())`.
 *
 *     var child = Process.start("sort", ["-u"])?
 *     using child { running =>
 *       running.input().fill(Source.from(words)).await()?
 *       const sorted = running.output().lines().toList().await()?
 *       running.wait().await()
 *     }
 *
 * `close()` releases the pipes and stops waiting for the child; it does not kill it, because ending somebody else's
 * program is a decision and not a cleanup.
 */
public native shared type Child with Close {
  /** What the child reads. `finish()` closes its standard input, which is how most filters learn that they are done. */
  native fn input(self): Sink<Bytes, IoError>

  native fn output(self): Source<Bytes, IoError>
  native fn errors(self): Source<Bytes, IoError>

  /** The exit code, once the program has ended. */
  native fn wait(self): Task<Result<Int, IoError>>

  native fn close(var self)
}

/** The running program. */
public native type Process {
  /** The command line arguments, without the program itself. */
  native fn arguments(): List<String>

  /** Ends the program. Open resources are not closed: prefer to return from the entry file. */
  native fn exit(code: Int): Never

  /**
   * Runs a program to its end and collects everything about it. The arguments are passed as they are - there is no
   * shell, so nothing about them is interpreted and nothing has to be quoted.
   *
   * A program that could not be started at all is an `IoError`; a program that ran and failed is an exit code, which
   * is why `torb build` can tell "there is no C compiler" from "the C compiler said no".
   */
  native fn run(command: String, arguments: List<String>): Result<ProcessOutput, IoError>

  /**
   * Starts a program and hands back its pipes, for output that is too big to collect or that has to be read while it
   * arrives. `run` is the short form for everything else.
   */
  native fn start(command: String, arguments: List<String>): Result<Child, IoError>
}
