/**
 * The usual functions on `Float` that are not already methods, under a namespace import:
 *
 *     use * as math from "std/math"
 *
 *     const circumference = 2.0 * math.pi * radius
 *     const hypotenuse = math.power(a, 2.0) + math.power(b, 2.0)
 *
 * `Float`'s own methods (`squareRoot`, `floor`, `ceiling`, `round`, `absolute`, `min`, `max`, ...) cover what reads
 * naturally as "a number's own operation". What is here instead reads as a function of a value: exponentiation,
 * logarithms, trigonometry - and the two constants everything else is expressed in terms of.
 */

/** The ratio of a circle's circumference to its diameter. */
public const pi: Float64 = 3.141592653589793

/** The base of the natural logarithm. */
public const e: Float64 = 2.718281828459045

/** `base` raised to the power of `exponent`. */
public native fn power(base: Float64, exponent: Float64): Float64

/** `e` raised to the power of `value`. */
public native fn exponential(value: Float64): Float64

/** The logarithm base `e`. */
public native fn naturalLog(value: Float64): Float64

/** The logarithm of `value` in the given `base`: `math.logarithm(8.0, base: 2.0)` is `3.0`. */
public native fn logarithm(value: Float64, base: Float64): Float64

/** `value` in radians. */
public native fn sine(value: Float64): Float64

/** `value` in radians. */
public native fn cosine(value: Float64): Float64

/** `value` in radians. */
public native fn tangent(value: Float64): Float64

/** In radians. */
public native fn arcSine(value: Float64): Float64

/** In radians. */
public native fn arcCosine(value: Float64): Float64

/** In radians. */
public native fn arcTangent(value: Float64): Float64

/** `arcTangent(y / x)`, using the sign of both to pick the correct quadrant. */
public native fn arcTangent2(y: Float64, x: Float64): Float64
