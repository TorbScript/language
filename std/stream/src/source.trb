/**
 * The reading end of a stream: `Source`, the stages built from it (`map`, `take`, `through`, ...), the terminal
 * operations that read it to a value (`toList`, `fold`, `into`, ...), and its three ways to make one (`from`,
 * `pulling`, `produce`).
 */

use Shared from "std/core"
use Stage, Collector, Accumulator, Queueing, collector, counting, listing from "std/iteration"
use mapping, filtering, filterMapping, mappingWhile, taking, takingWhile, skipping, indexing, chunking from "std/iteration"
use ChannelClosed from "std/task"
use Sink from "./sink"

/**
 * The reading end of a stream: the asynchronous sibling of `Iterator`, with the same verb and the same `var self`.
 *
 *     var lines = file.lines()
 *     while const Some(line) = lines.next().await()? {
 *       print line
 *     }
 *
 * A source has an identity and is consumed once, so it is a `shared type` - and `next` changes it, so it takes
 * `var self` exactly as `Iterator.next` does. **A source that is read from sits in a `var` binding**, and a `const`
 * handle is the read-only view every shared object has ("Identity" in CONCEPT.md). That a `var self` method may answer a
 * `Task` is what the `shared` in `shared type` buys: for a value a `var` is an exclusive in-out access that ends with
 * the call, for an object it is a permission to change the one object, and a permission survives an `await`.
 *
 * - **A failure ends the stream.** After `Fail(problem)` a source answers nothing useful any more; it may keep
 *   answering the same failure, and it never goes back to delivering items.
 * - **`None` ends the stream too,** and it is final: after `Ok(None)` every further `next()` answers `Ok(None)`.
 * - **One puller at a time.** `next()` must not be called again before the task it answered has finished; two
 *   overlapping pulls are a bug, not a race the source has to defend against. A source may only be pulled by the task
 *   that made it - shared objects are confined to their task (CONCEPT, "Concurrency"), which is why nothing here spawns.
 * - **Backpressure is the pull.** Nothing is read before somebody asks for it.
 * - **Whoever reads needs the permission - now or later.** Reading takes `var self`, and so does wrapping (`map`,
 *   `filter`, `through`, `then`, `checked`), because a wrapper keeps the source in a `var` field and pulls from it
 *   afterwards. So a `const` source cannot be consumed by wrapping it either, which is what a read-only view
 *   promised. A chain still reads as one expression, because a **freshly produced object is a `var` path**: nothing
 *   is thrown away where there is no copy, and nobody else holds a view of something that was just made.
 * - **`close()` releases what is above.** A reader that stops early (`take`, an abandoned loop, a failure it handles)
 *   closes the source, and every source built here closes the one it reads from. `using` is the form that does not
 *   forget it. `close()` is synchronous, cannot fail and may be called after the stream ended; `finish()` on the other
 *   end is the graceful counterpart that can.
 *
 * # Related
 *
 * - [Sink] - the writing end, and `into`/`fill`'s other side.
 * - [Stage] - what `through` wraps a source with.
 */
public shared trait Source<Item, Failure> with Close {
  /** `Ok(Some(item))` for the next item, `Ok(None)` at the end, `Fail(problem)` for a failure that ends the stream. */
  fn next(var self): Task<Result<Item?, Failure>>

  // --- Stages: wrapping, which hands the pulling on -------------------------------------------------------------

  /**
   * The one place where a stage meets a stream. Everything below is this call with a name, and `Json.items<User>()`
   * or `lines()` are the same stage values an `Iterable` takes.
   */
  fn through<Output>(var self, stage: Stage<Item, Output>): Source<Output, Failure> {
    Staged.of self, stage
  }

  /** Transforms every item as it is read. */
  fn map<Output>(var self, transform: (value: Item) => Output): Source<Output, Failure> {
    through mapping(transform)
  }

  /** Reads only the items that answer the question. */
  fn filter(var self, predicate: (value: Item) => Bool): Source<Item, Failure> {
    through filtering(predicate)
  }

  /** Transforms every item and drops the ones that answer `None`. */
  fn filterMap<Output>(var self, transform: (value: Item) => Output?): Source<Output, Failure> {
    through filterMapping(transform)
  }

  /** Transforms items until one answers `None`, and ends the stream there. */
  fn mapWhile<Output>(var self, transform: (value: Item) => Output?): Source<Output, Failure> {
    through mappingWhile(transform)
  }

  /** Reads at most `amount` items, then ends the stream. */
  fn take(var self, amount: Int): Source<Item, Failure> {
    through taking(amount)
  }

  /** Reads items while they answer the question, then ends the stream at the first one that does not. */
  fn takeWhile(var self, predicate: (value: Item) => Bool): Source<Item, Failure> {
    through takingWhile(predicate)
  }

  /** Drops the first `amount` items, then reads the rest as they come. */
  fn skip(var self, amount: Int): Source<Item, Failure> {
    through skipping(amount)
  }

  /** `(0, first), (1, second), ...` */
  fn indexed(var self): Source<(Int, Item), Failure> {
    through indexing()
  }

  /** Groups items into lists of at most `size`; the last group is what is left. */
  fn chunked(var self, size: Int): Source<List<Item>, Failure> {
    through chunking(size)
  }

  /**
   * The only asynchronous stage there is: a step that has to wait for each item (a lookup, a request, a write). A
   * `Stage` cannot do this - it computes and never waits - so this is a method and not a stage value.
   */
  fn then<Output>(var self, step: (value: Item) => Task<Result<Output, Failure>>): Source<Output, Failure> {
    Stepping.of self, step
  }

  /** A stream of the same items with a failure of another type: what `mapError` is on a `Result`. */
  fn mapFailure<Other>(var self, transform: (failure: Failure) => Other): Source<Item, Other> {
    Remapped.of self, transform
  }

  // --- Terminal operations: reading the items -------------------------------------------------------------------

  /**
   * The same `Collector`s the pull side uses, so every terminal operation is written once. The values are pushed into
   * the accumulator as they arrive, and `isDone()` ends the pull as soon as the collector has seen enough.
   */
  fn collect<Output>(var self, collector: Collector<Item, Output>): Task<Result<Output, Failure>> {
    var accumulator = collector.start()
    if accumulator.isDone() {
      return Ok accumulator.finish()
    }
    while const Some(item) = next().await()? {
      accumulator.add item
      if accumulator.isDone() {
        break
      }
    }
    Ok accumulator.finish()
  }

  /** Every item, collected into a list. */
  fn toList(var self): Task<Result<List<Item>, Failure>> {
    collect listing()
  }

  /** How many items the stream delivers. */
  fn count(var self): Task<Result<Int, Failure>> {
    collect counting()
  }

  /** Combines every item into a running state, left to right, starting from `initial`. */
  fn fold<State>(var self, initial: State, combine: (State, Item) => State): Task<Result<State, Failure>> {
    collect(collector(initial, finish: { _ }, step: combine))
  }

  /** Runs `action` on every item as it arrives. */
  fn forEach(var self, action: (value: Item) => Void): Task<Result<Void, Failure>> {
    while const Some(item) = next().await()? {
      action item
    }
    Ok void
  }

  /** Stops at the first item that matches, which leaves the rest of the stream unread. */
  fn find(var self, predicate: (value: Item) => Bool): Task<Result<Item?, Failure>> {
    while const Some(item) = next().await()? {
      if predicate(item) {
        return Ok Some(item)
      }
    }
    Ok None
  }

  /**
   * Hands everything to `sink` and finishes it. Both ends carry the same `Failure` on purpose: a pump that silently
   * converted one into the other would hide which end broke. Use `mapFailure` on either side to say it.
   */
  fn into(var self, var sink: Sink<Item, Failure>): Task<Result<Void, Failure>> {
    while const Some(item) = next().await()? {
      sink.add(item).await()?
    }
    sink.finish().await()
  }

  // --- Making one -----------------------------------------------------------------------------------------------

  /**
   * Everything an `Iterable` has, as a stream that never waits. `Failure` is whatever the caller needs: a source over
   * a list cannot fail, and saying so as `Never` would make it unusable where a failing stream is expected.
   */
  fn from(items: Iterable<Item>): Source<Item, Failure> {
    Iterating.of items
  }

  /**
   * The closure *is* `next`: the escape hatch for anything that already knows how to answer one item and has no state
   * worth a type of its own. With state, write an ordinary `shared type` with `var` fields - that is what the traits
   * here are for.
   */
  fn pulling(step: () => Task<Result<Item?, Failure>>): Source<Item, Failure> {
    Pulling.of step
  }

  /**
   * A producer that pushes instead of being pulled, without generators: `body` runs as a task of its own and writes
   * into `sink`, and the items travel through a channel of `capacity`. The default `0` hands every item over directly,
   * so the producer runs in lock-step with the consumer - which is what a generator does.
   *
   *     Source.produce { sink =>
   *       for row in query.rows() {
   *         sink.add(Report.of(row)).await()?
   *       }
   *       Ok void
   *     }
   *
   * `Failure: From<ChannelClosed>` because a consumer that stops pulling ends the producer, and that end needs a name
   * in the producer's own failure type.
   */
  fn produce(
    capacity: Int = 0,
    body: (var sink: Sink<Item, Failure>) => Result<Void, Failure>,
  ): Source<Item, Failure> where Failure: From<ChannelClosed> {
    const relay = Channel<Item>(capacity: capacity)
    Produced.of(relay, spawn({ produceInto relay, body }))
  }

  /** A stream that ends immediately, without reading anything. */
  fn empty(): Source<Item, Failure> {
    const nothing: List<Item> = []
    Iterating.of nothing
  }
}

/** The body of a produced source, inside the task: the sink is made here, so no shared object crosses the boundary. */
fn produceInto<Item, Failure: From<ChannelClosed>>(
  relay: Channel<Item>,
  body: (var sink: Sink<Item, Failure>) => Result<Void, Failure>,
): Result<Void, Failure> {
  var writing = relay.sink().mapFailure(Failure.from)
  body writing
}

// --- A closure as a source --------------------------------------------------------------------------------------

/** `Source.pulling { ... }`: one closure for `next`, and the thing above it that has to be released. */
public shared type Pulling<Item, Failure> with Source<Item, Failure> {
  private step: () => Task<Result<Item?, Failure>>
  private var above: Close? = None

  /** Wraps `step` as a source, and `above` as what `close()` releases. */
  fn of(step: () => Task<Result<Item?, Failure>>, above: Close? = None): Pulling<Item, Failure> {
    Pulling step, above
  }

  /** Calls `step` for the next item. */
  fn next(var self): Task<Result<Item?, Failure>> {
    step().await()
  }

  /** Releases `above`, if there is one. */
  fn close(var self) {
    if var Some(upstream) = above {
      upstream.close()
    }
  }
}

/** `Source.from(items)`: the cursor of the iterable, in a `var` field. */
shared type Iterating<Item, Failure> with Source<Item, Failure> {
  private var cursor: Iterator<Item>

  fn of(items: Iterable<Item>): Iterating<Item, Failure> {
    Iterating items.iterator()
  }

  fn next(var self): Task<Result<Item?, Failure>> {
    Ok cursor.next()
  }

  /** Nothing was opened, so there is nothing to release - and every source has to be closable. */
  fn close(var self) {}
}

// --- The asynchronous step, and a failure of another type ---------------------------------------------------------

/** `source.then { ... }`: one item in, one item out, with a wait in between. */
shared type Stepping<Input, Item, Failure> with Source<Item, Failure> {
  private var upstream: Source<Input, Failure>
  private step: (value: Input) => Task<Result<Item, Failure>>

  fn of(
    var upstream: Source<Input, Failure>,
    step: (value: Input) => Task<Result<Item, Failure>>,
  ): Stepping<Input, Item, Failure> {
    Stepping upstream, step
  }

  fn next(var self): Task<Result<Item?, Failure>> {
    const found = upstream.next().await()?
    if const Some(value) = found {
      return Ok Some(step(value).await()?)
    }
    Ok None
  }

  fn close(var self) {
    upstream.close()
  }
}

/** `source.mapFailure(transform)`. */
shared type Remapped<Item, Failure, Other> with Source<Item, Other> {
  private var upstream: Source<Item, Failure>
  private transform: (failure: Failure) => Other

  fn of(var upstream: Source<Item, Failure>, transform: (failure: Failure) => Other): Remapped<Item, Failure, Other> {
    Remapped upstream, transform
  }

  fn next(var self): Task<Result<Item?, Other>> {
    Ok(upstream.next().await().mapError(transform)?)
  }

  fn close(var self) {
    upstream.close()
  }
}

// --- A stage in front of a source --------------------------------------------------------------------------------

/**
 * `source.through(stage)`. Two paths, like the synchronous `Staged` of `std/iteration`:
 *
 * - `collect` is **fused**: the stage wraps the collector's accumulator, no queue, one push per item.
 * - `next()` needs a queue, because one item pushed in can become none or many coming out while the caller asks for
 *   exactly one. It holds what one item produced and is emptied before the next item is pulled.
 *
 * The queue is a `Shared<List<Item>>` and not a plain field because an `Accumulator` is a **value**: the chain the
 * stage built holds a copy of whatever it was given, so the only way to read what it pushed is a box both hold.
 *
 * `through` on a staged source composes instead of stacking, so `source.through(a).through(b)` is one driver over
 * `a.then(b)` and stays fused all the way down.
 */
public shared type Staged<Input, Item, Failure> with Source<Item, Failure> {
  private var upstream: Source<Input, Failure>
  private stage: Stage<Input, Item>
  private var queue: Shared<List<Item>>
  private var pushing: Accumulator<Input, Void>
  private var finished: Bool = false

  /** Wraps `upstream` with `stage`, and sets up the queue `next()` reads from. */
  fn of(var upstream: Source<Input, Failure>, stage: Stage<Input, Item>): Staged<Input, Item, Failure> {
    var box: Shared<List<Item>> = Shared([])
    Staged upstream, stage, box, stage.onto(Queueing(box))
  }

  /** Pulls from `upstream` and pushes into the stage until the queue holds an item or the stage is done. */
  fn next(var self): Task<Result<Item?, Failure>> {
    loop {
      var waiting = queue.value
      if !waiting.isEmpty() {
        const ready = waiting.removeAt 0
        queue.value = waiting
        return Ok ready
      }
      if finished {
        return Ok None
      }
      // `finish()` of the last stage may still push values (the short last group of `chunking`), so the queue is
      // looked at once more before `None` is the answer
      if pushing.isDone() {
        pushing.finish()
        finished = true
        continue
      }
      match upstream.next().await()? {
        Some(value) => pushing.add value
        None => {
          pushing.finish()
          finished = true
        }
      }
    }
  }

  /** Composes `other` onto this stage instead of stacking a second `Staged` on top. */
  fn through<Output>(var self, other: Stage<Item, Output>): Source<Output, Failure> {
    upstream.through stage.then(other)
  }

  /** Fused: no queue, and `isDone()` from the collector reaches the source through the stage. */
  fn collect<Output>(var self, collector: Collector<Item, Output>): Task<Result<Output, Failure>> {
    var accumulator = stage.onto collector.start()
    if accumulator.isDone() {
      return Ok accumulator.finish()
    }
    while const Some(value) = upstream.next().await()? {
      accumulator.add value
      if accumulator.isDone() {
        break
      }
    }
    Ok accumulator.finish()
  }

  /** Releases `upstream`. */
  fn close(var self) {
    upstream.close()
  }
}

// --- A produced source ------------------------------------------------------------------------------------------

/** What `Source.produce` answers: the receiving end of the channel, plus the task that fills it. */
shared type Produced<Item, Failure> with Source<Item, Failure> {
  private relay: Channel<Item>
  private var reading: Source<Item, Never>
  private var writing: Sink<Item, ChannelClosed>
  private producer: Task<Result<Void, Failure>>

  fn of(relay: Channel<Item>, producer: Task<Result<Void, Failure>>): Produced<Item, Failure> {
    Produced relay, relay.source(), relay.sink(), producer
  }

  /**
   * The channel ends before the producer does, so the producer's own failure is delivered after the last item - which
   * is what makes a failing producer a failing stream and not a stream that simply stopped.
   */
  fn next(var self): Task<Result<Item?, Failure>> {
    if const Some(item) = reading.next().await()? {
      return Ok Some(item)
    }
    producer.await()?
    Ok None
  }

  /** Closing the channel makes the producer's next `add` fail with `ChannelClosed`, which ends its body. */
  fn close(var self) {
    writing.close()
  }
}

// --- Fallible stages --------------------------------------------------------------------------------------------

/**
 * A stage that can fail answers `Result` items (`Json.items<User>()`, `lines()`), because a `Stage` is synchronous and
 * knows nothing about the stream's failure. `checked()` is where those items become the stream's failure and end it -
 * the streaming counterpart of collecting an `Iterable<Result<...>>` into a `Result<List<...>, ...>`.
 *
 *     const all = body.through(Json.items<User>()).checked().toList().await()?
 */
extend<Item, Problem, Failure: From<Problem>> Source<Result<Item, Problem>, Failure> {
  /** Turns every item's own failure into the stream's failure, and ends the stream at the first one. */
  fn checked(var self): Source<Item, Failure> {
    Checked.of self
  }
}

shared type Checked<Item, Problem, Failure: From<Problem>> with Source<Item, Failure> {
  private var upstream: Source<Result<Item, Problem>, Failure>

  fn of(var upstream: Source<Result<Item, Problem>, Failure>): Checked<Item, Problem, Failure> {
    Checked upstream
  }

  fn next(var self): Task<Result<Item?, Failure>> {
    const found = upstream.next().await()?
    if const Some(item) = found {
      return Ok Some(item?)
    }
    Ok None
  }

  fn close(var self) {
    upstream.close()
  }
}
