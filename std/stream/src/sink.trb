/**
 * The writing end of a stream: the asynchronous sibling of `Accumulator`, with the same two verbs and the same
 * `var self`.
 */

use Source from "./source"

/**
 *     var file = File.create(path)?
 *     using file { target =>
 *       target.addLine("first").await()?
 *       target.end().await()
 *     }
 *
 * A sink has an identity and is ended once, so it is a `shared type`, and `add` and `end` change it: they take
 * `var self`, exactly as `Accumulator.add` does. **A sink that is written to sits in a `var` binding**, and a `const`
 * handle is the read-only view every shared object has. A `var fn` method may answer a `Task` because for an object
 * `var` is a permission and not an exclusive access that ends with the call (CONCEPT, "Identity").
 *
 * - **Backpressure is the `await` on `add`.** The task finishes when the target has taken the item, not before, so a
 *   writer that is faster than its target waits by itself and nothing piles up.
 * - **Order is the order of the calls.** `add` must not be called again before the task it answered has finished.
 * - **`end()` is the graceful end:** everything buffered is written, the target learns that no more is coming, and
 *   whatever went wrong on the way is reported here at the latest. After `end()`, `add` fails. The word is not
 *   `finish`, which belongs to [Accumulator] and answers a *result*: the end of a stream is not a value.
 * - **A failure ends the stream.** After a failure neither `add` nor `end` will succeed again.
 * - **`close()` is the abrupt end:** it releases the target and cannot fail, which is what `Close` and `using` need.
 *   A sink that is closed without `end()` may have written less than it was given - that is the point of the two.
 * - **Buffering is never implicit.** `sink.buffered(capacity:)` says it, and `Buffered.flush()` is where it is forced.
 * - **Whoever writes needs the permission - now or later.** `mapFailure` and `buffered` take `var self` as well,
 *   because the wrapper keeps the sink in a `var` field and writes into it afterwards. A chain is still one
 *   expression, because a freshly produced object is a `var` path.
 *
 * # Related
 *
 * - [Source] - the reading end, and `into`/`fill`'s other side.
 * - [Buffered] - what `buffered(capacity:)` answers.
 */
public shared trait Sink<Item, Failure> with Close {
  /** Finishes when the target has taken the item. */
  var fn add(item: Item): Task<Result<Void, Failure>>

  /** No more items. Flushes, reports what is left to report, and makes every further `add` fail. */
  var fn end(): Task<Result<Void, Failure>>

  /** Everything an `Iterate` holds, in order. Does not end the sink: a sink may be filled from several places. */
  var fn addAll(items: Iterate<Item>): Task<Result<Void, Failure>> {
    for item in items {
      add(item).await()?
    }
    Ok void
  }

  /** Reads `source` empty into this sink and ends it: the same pump as `source.into(sink)`, from this side. */
  var fn fill(var source: Source<Item, Failure>): Task<Result<Void, Failure>> {
    // `self` is the object itself and never goes to a `var` parameter, which could replace it: a binding of it can be
    // replaced and the object stays
    var target = self
    source.into(target).await()
  }

  /** A sink for the same items with a failure of another type: what `mapError` is on a `Result`. */
  var fn mapFailure<Other>(transform: (failure: Failure) => Other): Sink<Item, Other> {
    var downstream = self
    Remapped.of downstream, transform
  }

  /**
   * Collects items and hands them on in groups of `capacity`, which is what makes many small writes one big one.
   * The answer is a `Buffered`, not a `Sink`, so that `flush()` stays reachable; `finish()` flushes.
   */
  var fn buffered(capacity: Int = 64): Buffered<Item, Failure> {
    var downstream = self
    Buffered.of downstream, capacity: capacity
  }

  /**
   * Two closures instead of a type: the escape hatch for a sink with no state worth a type of its own. With state,
   * write an ordinary `shared type` with `var` fields.
   */
  static fn pushing(
    accept: (item: Item) => Task<Result<Void, Failure>>,
    complete: () => Task<Result<Void, Failure>>,
  ): Sink<Item, Failure> {
    Pushing.of accept, complete
  }

  /** Everything written into it is dropped. What `/dev/null` is, and what a test writes into. */
  static fn discarding(): Sink<Item, Failure> {
    Discarding<Item, Failure>()
  }
}

// --- Closures as a sink, and a sink that drops -----------------------------------------------------------------------

/** `Sink.pushing(accept, complete)`: one closure per verb, and the thing below it that has to be released. */
public shared type Pushing<Item, Failure> with Sink<Item, Failure> {
  private accept: (item: Item) => Task<Result<Void, Failure>>
  private complete: () => Task<Result<Void, Failure>>
  private var below: Close? = None

  /** Wraps `accept` and `complete` as a sink, and `below` as what `close()` releases. */
  static fn of(
    accept: (item: Item) => Task<Result<Void, Failure>>,
    complete: () => Task<Result<Void, Failure>>,
    below: Close? = None,
  ): Pushing<Item, Failure> {
    Pushing accept, complete, below
  }

  /** Calls `accept` with the item. */
  var fn add(item: Item): Task<Result<Void, Failure>> {
    accept(item).await()
  }

  /** Calls `complete`. */
  var fn end(): Task<Result<Void, Failure>> {
    complete().await()
  }

  /** Releases `below`, if there is one. */
  var fn close() {
    if var Some(target) = below {
      target.close()
    }
  }
}

shared type Discarding<Item, Failure> with Sink<Item, Failure> {
  var fn add(item: Item): Task<Result<Void, Failure>> {
    Ok void
  }

  var fn end(): Task<Result<Void, Failure>> {
    Ok void
  }

  var fn close() {}
}

/** `sink.mapFailure(transform)`. */
shared type Remapped<Item, Failure, Other> with Sink<Item, Other> {
  private var downstream: Sink<Item, Failure>
  private transform: (failure: Failure) => Other

  static fn of(var downstream: Sink<Item, Failure>, transform: (failure: Failure) => Other): Remapped<Item, Failure, Other> {
    Remapped downstream, transform
  }

  var fn add(item: Item): Task<Result<Void, Other>> {
    Ok(downstream.add(item).await().mapError(transform)?)
  }

  var fn end(): Task<Result<Void, Other>> {
    Ok(downstream.end().await().mapError(transform)?)
  }

  var fn close() {
    downstream.close()
  }
}

// --- Buffering ---------------------------------------------------------------------------------------------------

/**
 * A sink in front of another one that hands items on in groups. Buffering is a wrapper and never a hidden property of
 * a sink, because "when was it actually written" is the one question a writer has to be able to answer:
 *
 *     var out = standardOutput().buffered(capacity: 4096)
 *     out.addLine(report).await()?
 *     out.flush().await()?                   // now it is on the screen
 *     out.end().await()?                     // ... and this flushes too
 *
 * `close()` does **not** flush: it releases, and what was buffered is lost. That is the difference between abandoning
 * a sink and ending it.
 *
 * # Pitfalls
 *
 * - If a write below fails partway through a flush, the items after it are dropped, not kept for a retry: a failed
 *   sink is over, so there is nothing left to retry into.
 *
 * # Related
 *
 * - [Sink.buffered] - what answers a `Buffered`.
 */
public shared type Buffered<Item, Failure> with Sink<Item, Failure> {
  private var downstream: Sink<Item, Failure>
  private capacity: Int = 64
  private var pending: List<Item> = []

  /** Wraps `downstream` and buffers up to `capacity` items before writing a group. */
  static fn of(var downstream: Sink<Item, Failure>, capacity: Int = 64): Buffered<Item, Failure> {
    Buffered downstream, capacity.max(1)
  }

  /** Adds to the buffer, and flushes once it reaches `capacity`. */
  var fn add(item: Item): Task<Result<Void, Failure>> {
    pending.append item
    if pending.length() < capacity {
      return Ok void
    }
    flush().await()
  }

  /** Writes everything that is buffered, and finishes when it has arrived below. */
  var fn flush(): Task<Result<Void, Failure>> {
    const ready = pending
    pending = []
    for one in ready {
      downstream.add(one).await()?
    }
    Ok void
  }

  /** Flushes, then ends `downstream`. */
  var fn end(): Task<Result<Void, Failure>> {
    flush().await()?
    downstream.end().await()
  }

  /** Releases `downstream` without flushing - whatever is still buffered is lost. */
  var fn close() {
    downstream.close()
  }
}
