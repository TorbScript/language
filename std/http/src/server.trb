/**
 * The HTTP/1.1 server: a listener, a handler that is a function from a request to a task of a response, an accept loop
 * per worker on the one listening socket, and one task per connection that serves its requests one after another
 * (docs/design/NETWORK.md sections 4 and 8).
 */

use ArrayList from "std/collections"
use TcpListener, TcpAcceptor, TcpStream, SocketAddress from "std/network"
use Workers from "std/task"
use TlsStream, ServerIdentity from "std/tls"
use Duration from "std/time"
use Body, Method, Request, Response, Status from "./message"
use Connection, FixedReader, ChunkedReader from "./connection"
use Framing, headLines, requestLineOf, fieldsOf, requestFraming, keepsAlive from "./parse"
use writeResponse from "./write"
use HttpError from "./error"
use Transport from "./transport"

/** What serves a request: a function from the request to a task of the response. A web framework is one of these. */
public type Handler = (request: Request) => Task<Result<Response, HttpError>>

/**
 * What a server allows a client, each against an attack of its own. Times are milliseconds, because a field's default
 * is a constant and a `Duration` is none.
 */
public type ServerLimits {
  /** The request line and every field together: nginx allows 8 KiB a line and 32 KiB in all; a browser with many cookies needs more. */
  headBytes: Int = 65536
  /** Fields of one head: the count Go and Node refuse above. */
  headFields: Int = 100
  /** The time from the first byte of a request to the end of its head: a client that sends it a byte a minute (slowloris) is cut off. */
  headMilliseconds: Int = 10000
  /** How long a kept-alive connection may wait for its next request. */
  idleMilliseconds: Int = 60000
  /** What of a request's body the handler did not read is read and dropped up to this; more closes the connection. */
  drainBytes: Int = 65536
}

/**
 * An HTTP/1.1 server. It listens as soon as it is made; [Server.serve] accepts connections until the server is shut
 * down or closed - with an accept loop on every worker, all of them on the one listening socket - and every connection
 * is a task of its own, on the worker whose loop accepted it.
 *
 *     fn hello(request: Request): Task<Result<Response, HttpError>> {
 *       Ok Response.text("hello from {request.path()}")
 *     }
 *
 *     var server = Server.listen(SocketAddress(IpAddress.loopback, 8080), hello)?
 *     var serving = server.serve()
 *     // ... and when the program is to stop:
 *     server.shutdown().await()
 *
 * A handler that fails is answered with the status its failure names where it names one - the body it read was cut
 * short, not UTF-8 or not the JSON asked for - and `500 Internal Server Error` otherwise; the failure itself is not sent
 * to the client. A request the parser refuses is answered with the status its failure names
 * ([HttpError.answerStatus]), and the connection is closed. The server writes no `Server` field: a product name on the
 * wire tells an attacker what to try first, and a handler that wants one sets it.
 */
public shared type Server with Close {
  private listener: TcpListener
  private handler: Handler
  private limits: ServerLimits
  private state: ServerState
  /** What the server proves itself with where it speaks TLS; `None` for plain HTTP. */
  private identity: ServerIdentity?
  /** The accept loops [Server.serve] started, one per worker. */
  private var loops: List<Task<Result<Void, HttpError>>> = []

  /**
   * A server listening on `address`; port 0 asks the system for a free one, which [Server.localAddress] then says. With
   * `tls`, every connection is HTTPS: the TLS handshake comes first, within the head time of the limits.
   */
  static fn listen(
    address: SocketAddress,
    handler: Handler,
    limits: ServerLimits = ServerLimits(),
    tls: ServerIdentity? = None,
  ): Result<Server, HttpError> {
    const listener = TcpListener.listen(address)?
    Server listener, handler, limits, ServerState(), tls
  }

  /** Where it listens. */
  fn localAddress(): SocketAddress {
    listener.localAddress()
  }

  /**
   * Accepts connections and serves each in a task of its own, until the server is shut down or closed - then it
   * answers `Ok` - or the listening socket fails.
   *
   * It starts one accept loop per worker (`Workers.count()`), each accepting on the same listening socket, so the
   * connections spread over every core: a loop holds nothing but the socket's handle, the handler and the limits, so an
   * idle worker takes it before its first run, and a connection stays on the worker whose loop accepted it. A loop stays
   * on this task's worker where the handler holds an object that cannot move, and a server that speaks TLS runs one
   * loop, because its identity is such an object - correct either way, and parallel where it can be.
   */
  var fn serve(): Task<Result<Void, HttpError>> {
    if state.closing {
      return Ok void
    }
    var started: List<Task<Result<Void, HttpError>>> = []
    match identity {
      Some(proof) => {
        started.append serveAccepted(listener.acceptor(), handler, limits, proof)
      }
      None => {
        const count = if Workers.count() < 1 { 1 } else { Workers.count() }
        for _ in 0..count {
          started.append(acceptLoop(
            listener.acceptor(),
            handler,
            limits.headBytes,
            limits.headFields,
            limits.headMilliseconds,
            limits.idleMilliseconds,
            limits.drainBytes,
          ))
        }
      }
    }
    loops = started
    // Every loop ends `Ok` once the server stopped listening; the first that failed is the server's failure
    var outcome: Result<Void, HttpError> = Ok void
    for running in started {
      if const Ok(Fail(problem)) = running.result() {
        if outcome.isOk() {
          outcome = Fail problem
        }
      }
    }
    outcome
  }

  /** Accepts one connection and serves it to its end: what a test wants. */
  var fn serveOne(): Task<Result<Void, HttpError>> {
    const stream = listener.accept().await()?
    const serving = Serving()
    serveConnection(stream, handler, limits, state, serving, identity).await()
  }

  /**
   * Stops gracefully: no connection is accepted any more, a connection that waits for its next request is closed at
   * once, a request in progress is finished and answered with `Connection: close`, and what still runs once `grace`
   * has passed is cancelled. Finishes when every connection has ended.
   */
  var fn shutdown(grace: Duration = 10.seconds()): Task<Void> {
    state.closing = true
    // Every loop's accept fails with a closed socket, and each loop then shuts its own connections down gently
    listener.stop()
    var finishing = waitForAll loops
    const inTime = finishing.within(grace).await()
    if !inTime.isOk() {
      for running in loops {
        cancelConnection running
      }
    }
    loops = []
  }

  /**
   * Stops at once: the listener closes and every accept loop is cancelled, and with it every connection it serves. What
   * the release of a server runs.
   */
  var fn close() {
    state.closing = true
    listener.stop()
    for running in loops {
      cancelConnection running
    }
    loops = []
  }
}

/** What a server shares with the tasks of its connections: whether it shuts down. */
shared type ServerState {
  var closing: Bool = false
}

/** One connection a server serves: its task, whether a request is in progress on it, and whether it ended. */
shared type Serving {
  var task: Task<Result<Void, HttpError>>? = None
  var busy: Bool = false
  var done: Bool = false
}

/** Cancels a connection's task. */
fn cancelConnection(task: Task<Result<Void, HttpError>>) {
  var stopping = task
  stopping.cancel()
}

/** Waits for every task, whatever it ends with. */
fn waitForAll(tasks: List<Task<Result<Void, HttpError>>>): Task<Void> {
  for task in tasks {
    const _ = task.result()
  }
}

/**
 * One accept loop of [Server.serve] without TLS: a task whose frame holds a handle, a handler and numbers, so an idle
 * worker may take it before it first runs. The limits arrive one number each, because a record of five of them is a
 * block of this worker's heap, and a frame that holds one stays where it was made (docs/design/CONCURRENCY.md section
 * 16, "What crosses a worker").
 */
fn acceptLoop(
  acceptor: TcpAcceptor,
  handler: Handler,
  headBytes: Int,
  headFields: Int,
  headMilliseconds: Int,
  idleMilliseconds: Int,
  drainBytes: Int,
): Task<Result<Void, HttpError>> {
  const limits = ServerLimits headBytes, headFields, headMilliseconds, idleMilliseconds, drainBytes
  serveAccepted(acceptor, handler, limits, None).await()
}

/**
 * Accepts connections on `acceptor` and serves each in a task of its own, until the listening socket is closed - then
 * the connections that wait for their next request are closed, the requests in progress are finished and answered with
 * `Connection: close`, and the loop answers `Ok` once the last connection ended. The connections are this loop's
 * children, so cancelling the loop cancels them.
 */
fn serveAccepted(
  acceptor: TcpAcceptor,
  handler: Handler,
  limits: ServerLimits,
  identity: ServerIdentity?,
): Task<Result<Void, HttpError>> {
  const state = ServerState()
  var connections: List<Serving> = []
  loop {
    const stream = match acceptor.accept().await() {
      Ok(accepted) => accepted
      Fail(problem) => {
        if !problem.isClosed() {
          return Fail HttpError.network(problem)
        }
        // The server stopped listening: what waits is closed, what runs finishes
        state.closing = true
        var busy: List<Task<Result<Void, HttpError>>> = []
        for serving in connections {
          if const Some(task) = serving.task {
            if serving.busy {
              busy.append task
            } else {
              cancelConnection task
            }
          }
        }
        waitForAll(busy).await()
        return Ok void
      }
    }
    const serving = Serving()
    serving.task = serveTracked stream, handler, limits, state, serving, identity
    var kept: List<Serving> = []
    for known in connections {
      if !known.done {
        kept.append known
      }
    }
    kept.append serving
    connections = kept
  }
}

/** Serves a connection and marks it done, so its loop forgets it at its next accept. */
fn serveTracked(
  stream: TcpStream,
  handler: Handler,
  limits: ServerLimits,
  state: ServerState,
  serving: Serving,
  identity: ServerIdentity?,
): Task<Result<Void, HttpError>> {
  const outcome = serveConnection(stream, handler, limits, state, serving, identity).result()
  serving.done = true
  match outcome {
    Ok(result) => result
    Fail(_) => Ok void
  }
}

/**
 * Serves the requests of one connection, one after another, until the client closes it, a response closes it, the
 * server shuts down, or the connection waits longer than the limits allow.
 */
fn serveConnection(
  stream: TcpStream,
  handler: Handler,
  limits: ServerLimits,
  state: ServerState,
  serving: Serving,
  identity: ServerIdentity?,
): Task<Result<Void, HttpError>> {
  const remote = stream.remoteAddress().ok()
  var transport = Transport.plain stream
  if const Some(proof) = identity {
    // The handshake is part of the head: a client that starts one and never finishes it is cut off the same way
    var handshake = TlsStream.accept stream, proof
    match handshake.within(limits.headMilliseconds.milliseconds()).await() {
      Ok(Ok(session)) => {
        transport = Transport.encrypted stream, session
      }
      _ => {
        return Ok void
      }
    }
  }
  var connection = Connection.of transport
  loop {
    serving.busy = false
    if state.closing {
      closeGently(connection).await()?
      return Ok void
    }
    // The next request's first byte, within the idle time
    if !connection.hasBuffered() {
      var waiting = connection.fill()
      match waiting.within(limits.idleMilliseconds.milliseconds()).await() {
        Ok(Ok(true)) => {}
        Ok(Ok(false)) => {
          return Ok void
        }
        Ok(Fail(_)) => {
          return Ok void
        }
        Fail(_) => {
          connection.finish().await()
          return Ok void
        }
      }
    }
    serving.busy = true
    // The whole head, within the head time
    var reading = connection.head limits.headBytes
    const head = match reading.within(limits.headMilliseconds.milliseconds()).await() {
      Ok(Ok(Some(found))) => found
      Ok(Ok(None)) => {
        return Ok void
      }
      Ok(Fail(problem)) => {
        refuse(connection, problem).await()?
        return Ok void
      }
      Fail(_) => {
        refuse(connection, HttpError.timeout()).await()?
        return Ok void
      }
    }
    const request = match requestOf(head, connection, remote, limits, identity.isSome()) {
      Ok(read) => read
      Fail(problem) => {
        refuse(connection, problem).await()?
        return Ok void
      }
    }
    const keepAlive = keepsAlive request.headers, request.version
    // A request without a body leaves the connection idle while its handler runs: it is read beside the handler, so a
    // client that goes away cancels its handler (WEB.md's fourth request)
    const watched = request.body.length() == 0 && !connection.hasBuffered()
    var running = handler request
    var watching: Task<Void>? = None
    if watched {
      watching = watchPeer connection, running
    }
    const outcome = running.result()
    if const Some(watcher) = watching {
      var stopping = watcher
      stopping.cancel()
      const _ = watcher.result()
    }
    const response = match outcome {
      Ok(Ok(answer)) => answer
      Ok(Fail(problem)) => failureResponse problem
      Fail(_) => {
        // The client went away while its handler ran, which was cancelled for it: there is nobody left to answer
        return Ok void
      }
    }
    // What the handler did not read of the body is read here, up to a limit; more than that closes the connection
    const drained = request.body.bytes(limit: limits.drainBytes).await().isOk()
    const closing = !keepAlive || !drained || state.closing
    const keepOpen = writeResponse(connection, response, request.method, request.version, closing).await()?
    if !keepOpen {
      closeGently(connection).await()?
      return Ok void
    }
  }
}

/**
 * Reads the connection while the handler of a request runs: the end of the stream or a broken connection means the
 * client went away, and cancels the handler with every task it started. Bytes that arrive instead are the client's next
 * request, kept in the connection's buffer for its turn, and the watch ends there. The connection task cancels the watch
 * once the handler answered, and a receive that is cancelled loses nothing.
 */
fn watchPeer(connection: Connection, handler: Task<Result<Response, HttpError>>): Task<Void> {
  var reading = connection
  match reading.fill().await() {
    Ok(true) => {}
    _ => {
      var stopping = handler
      stopping.cancel()
    }
  }
}

/** The request a head describes, with a body that reads from the connection as its framing says. */
fn requestOf(
  head: ArrayList<UInt8>,
  connection: Connection,
  remote: SocketAddress?,
  limits: ServerLimits,
  secure: Bool,
): Result<Request, HttpError> {
  const lines = headLines(head)?
  const line = requestLineOf(lines[0])?
  const headers = fieldsOf(lines[1..lines.length()], limits.headFields)?
  if line.version == "HTTP/1.1" && headers.all("Host").length() != 1 {
    return Fail HttpError.malformed("an HTTP/1.1 request has exactly one `Host`")
  }
  const body = match requestFraming(headers, line.version)? {
    .Fixed(length) => Body.of FixedReader.of(connection, length), length: length
    .Chunked => Body.of ChunkedReader.of(connection)
    .Empty => Body.empty()
    .UntilEnd => Body.empty()
  }
  const uri = targetUriOf(line.target, headers.get("Host") ?? "", secure)?
  Request line.method, line.target, uri, headers, body, remote: remote, version: line.version
}

/**
 * RFC 9112 section 3.3, the target URI: the scheme of the connection, then the authority of an absolute-form or
 * authority-form target or else the `Host` field, then the path and query of an origin-form target. A target and a host
 * that make no URI are a malformed request, which the server answers with `400`.
 */
fn targetUriOf(target: String, host: String, secure: Bool): Result<Uri, HttpError> {
  const scheme = if secure { "https" } else { "http" }
  for mark in ["/", "?", "#", "@"] {
    if host.contains(mark) {
      return Fail HttpError.malformed("`{host}` is not a host and a port (RFC 9110 section 7.2)")
    }
  }
  var text = "{scheme}://{host}"
  if target.startsWith("/") {
    text = text + target
  } else if target != "*" {
    // The absolute form names its own authority, and the authority form of `CONNECT` is nothing but one
    text = if target.contains("://") { target } else { "{scheme}://{target}" }
  }
  match Uri.tryFrom(text) {
    Ok(uri) => {
      if uri.scheme() != "http" && uri.scheme() != "https" {
        return Fail HttpError.malformed("the target `{target}` is not an HTTP URI")
      }
      uri
    }
    Fail(problem) => Fail HttpError.malformed("the target `{target}` and the host `{host}` make no URI: {problem}")
  }
}

/**
 * What a client is answered where the handler failed: the status the failure names - the request was malformed, its
 * body cut short or not the JSON asked for - and `500` otherwise, with the phrase of the status as the whole body. The
 * failure itself is the server's business and never sent: it may name a file, a query or a secret.
 */
fn failureResponse(problem: HttpError): Response {
  const status = Status.of(problem.answerStatus() ?? 500).ok() ?? Status.internalServerError
  Response.text "{status}\n", status: status
}

/**
 * Answers a request the server could not read with the status its failure names, and ends the connection. Where the
 * failure names none - the connection broke - there is nobody to answer.
 */
fn refuse(var connection: Connection, problem: HttpError): Task<Result<Void, HttpError>> {
  if const Some(code) = problem.answerStatus() {
    const status = Status.of(code)?
    const answer = Response.text "{problem}\n", status: status
    const _ = writeResponse(connection, answer, Method.Get, "HTTP/1.1", true).await()
  }
  closeGently(connection).await()
}

/**
 * Ends the writing half, then reads and drops what the client still sends - for a second at most, and 256 KiB at most -
 * before the connection closes. A socket closed with bytes unread is reset by the system, and a reset can destroy the
 * answer on its way before the client read it: the lingering close every server does.
 */
fn closeGently(var connection: Connection): Task<Result<Void, HttpError>> {
  connection.finish().await()
  var lingering = discardRest connection, 262144
  const _ = lingering.within(1000.milliseconds()).await()
  Ok void
}

/** Reads and drops at most `limit` bytes, until the peer ends its half. */
fn discardRest(var connection: Connection, limit: Int): Task<Result<Void, HttpError>> {
  var discarded = 0
  while discarded < limit {
    match connection.take(65536).await()? {
      Some(chunk) => {
        discarded = discarded + chunk.length()
      }
      None => {
        return Ok void
      }
    }
  }
  Ok void
}
