/**
 * A minimal HTTP client: [get], [post] and [request] answer a [Task] of a [Response], whose [Body] is a stream.
 *
 * A body is a stream: [Body] is a `Source<Bytes, HttpError>`, so a response of any size can be piped into a file or
 * read item by item, and the convenience that covers nine cases out of ten sits on top of it (`body.text()`,
 * `body.json<User>()`, all with a size limit).
 *
 * Needs the network capability inside a sandboxed script.
 *
 * # Examples
 *
 *     use * as http from "std/http"
 *
 *     type User {
 *       id: Int
 *       name: String
 *     }
 *
 *     fn fetchUser(id: Int): Task<Result<User, HttpError>> {
 *       var response = http.get("https://example.test/users/{id}").outcome()?
 *       response.json<User>().outcome()
 *     }
 */

use Json, JsonError from "std/json"
use Source, Bytes, Utf8Error, textOf from "std/stream"
use lines as streamLines from "std/stream"

/** One HTTP request, for `request()`. `get` and `post` build one of these for the common cases. */
public type Request {
  /** `"GET"`, `"POST"`, or any other HTTP method. */
  method: String
  /** The full URL, including its scheme. */
  url: String
  /** Additional request headers. */
  headers: Map<String, String> = [:]
  /** What is sent, or `None` for a request without a body, such as a `GET`. */
  var body: Body? = None
}

/**
 * What came back. A `shared type` and not a value: it owns one end of a stream that is read once, and a copy would
 * promise a second read of a body that is already gone. So a response that is read from sits in a `var` binding, for
 * the same reason a `File` does.
 */
public shared type Response {
  /** The HTTP status code, e.g. `200` or `404`. */
  status: Int
  /** The response headers. */
  headers: Map<String, String> = [:]
  /** `var`, because reading a body changes it: whoever reads one needs a `var` path to it. */
  var body: Body

  /**
   * Decodes the body as JSON. A `Task`, because the body arrives over the network and decoding it means reading it.
   */
  var fn json<Value: Decode>(limit: Int = Body.defaultLimit): Task<Result<Value, HttpError>> {
    body.json<Value>(limit: limit).outcome()
  }
}

/**
 * The bytes of a request or a response, as a stream that is read once.
 *
 *     const all = response.body.through(Json.items<User>()).checked().toList().outcome()?   // one at a time
 *     const text = response.body.text().outcome()?                                          // or all of it
 *     File.write(path, response.body.mapFailure(IoError.from)).outcome()?  // or straight to disk
 *
 * The convenience methods come first on purpose - that is the lesson of `fetch` and Bun, where `await response.json()`
 * is what almost every program wants - and every one of them takes a `limit`, because a server that decides how much
 * memory a client allocates is a denial of service.
 */
public shared type Body with Source<Bytes, HttpError> {
  /**
   * 16 MiB: large enough for any document a program means to hold in one piece, small enough that a response nobody
   * expected is refused instead of filling the machine. Streaming is the way past it, not a bigger number.
   */
  static defaultLimit: Int = 16777216

  private var reading: Source<Bytes, HttpError>

  /** The next chunk, or `None` at the end of the body. Most callers reach for [Body.bytes] or [Body.text] instead. */
  var fn next(): Task<Result<Bytes?, HttpError>> {
    reading.next().outcome()
  }

  /**
   * Nothing of its own: `reading` is a field, and the release of the body releases it - and with it the underlying
   * connection - right after this, without reading the rest.
   */
  var fn close() {}

  /** The whole body. More than `limit` bytes is an `HttpError` and the rest is not read. */
  var fn bytes(limit: Int = Body.defaultLimit): Task<Result<Bytes, HttpError>> {
    var collected: Bytes = []
    while const Some(chunk) = next().outcome()? {
      if collected.length() + chunk.length() > limit {
        return Fail HttpError.tooLarge(limit)
      }
      collected.appendAll chunk
    }
    Ok collected
  }

  /** The whole body as text. Bytes that are not UTF-8 are an `HttpError`, never a replacement character. */
  var fn text(limit: Int = Body.defaultLimit): Task<Result<String, HttpError>> {
    const raw = bytes(limit: limit).outcome()?
    textOf(raw).mapError(HttpError.invalidText)
  }

  /** The whole body, decoded as JSON: `response.body.json<User>().outcome()?` */
  var fn json<Value: Decode>(limit: Int = Body.defaultLimit): Task<Result<Value, HttpError>> {
    const document = text(limit: limit).outcome()?
    Json.decode<Value>(document).mapError(HttpError.decodeFailed)
  }

  /** Lines of text, as a stream: a log, an event stream, a CSV of any size. */
  var fn lines(): Source<String, HttpError> {
    through(streamLines()).checked()
  }

  /**
   * A body of any size - what an upload or a proxy hands on. Not `Body.from(source)`: `From.from` takes its argument by
   * value, and handing a stream over needs the permission to read it (`var`), because the `Body` reads it from now on.
   */
  static fn of(var source: Source<Bytes, HttpError>): Body {
    Body source
  }

  /** A body with nothing in it, e.g. for a `GET` request. */
  static fn empty(): Body {
    const nothing: List<Bytes> = []
    Body Source.from(nothing)
  }

  /**
   * An `Encode` value as a JSON body. Not `Body.json(value)`: a type has one namespace for its members, and `json` is
   * taken by the reading side, where it matters more (`body.json<User>()`).
   */
  static fn jsonOf(value: Encode): Body {
    Body.from Json.encode(value)
  }
}

/** `Body.from("hello")` - the text as UTF-8. */
extend Body with From<String> {
  static fn from(value: String): Body {
    Body.from value.bytes().toList()
  }
}

/** `Body.from(bytes)` - one chunk, already in memory. */
extend Body with From<Bytes> {
  static fn from(value: Bytes): Body {
    Body Source.from([value])
  }
}



/**
 * What went wrong making a request. A single wrapper type, so new kinds of failure are never a breaking change
 * (see "Algebraic Data Types and Pattern Matching" in CONCEPT.md).
 */
public type HttpError with Show, Error {
  private kind: HttpErrorKind

  /** The server did not respond in time. */
  static fn timeout(): HttpError {
    Self kind: .Timeout
  }

  /** The request never reached a server (DNS, refused connection, broken transport, ...). */
  static fn connectionFailed(message: String): HttpError {
    Self kind: .ConnectionFailed(message)
  }

  /** The server responded, but not with success. */
  static fn status(code: Int, message: String): HttpError {
    Self kind: .Status(code, message)
  }

  /** `url` could not be parsed as a request at all. */
  static fn invalidUrl(message: String): HttpError {
    Self kind: .InvalidUrl(message)
  }

  /** `Response.json` failed: the body was not the JSON `Value` expected. */
  static fn decodeFailed(cause: JsonError): HttpError {
    Self kind: .Decode(cause)
  }

  /** A body that was read in one piece was longer than the limit that was given. */
  static fn tooLarge(limit: Int): HttpError {
    Self kind: .TooLarge(limit)
  }

  /** The bytes of the body are not UTF-8, so they are not a `String`. */
  static fn invalidText(cause: Utf8Error): HttpError {
    Self kind: .InvalidText(cause)
  }

  /** Whether the server did not respond in time. */
  fn isTimeout(): Bool {
    match kind {
      .Timeout => true
      _ => false
    }
  }

  /** Worth trying again unchanged: timeouts, connection failures, `5xx` responses. */
  fn isRetryable(): Bool {
    match kind {
      .Timeout => true
      .ConnectionFailed(_) => true
      .Status(code, _) => code >= 500
      _ => false
    }
  }

  /** The status code, if the request reached the server at all. */
  fn statusCode(): Int? {
    match kind {
      .Status(code, _) => Some code
      _ => None
    }
  }

  /** A message naming what went wrong, e.g. `"404: Not Found"` or `"request timed out"`. */
  fn show(): String {
    match kind {
      .Timeout => "request timed out"
      .ConnectionFailed(message) => "connection failed: {message}"
      .Status(code, message) => "{code}: {message}"
      .InvalidUrl(message) => "invalid URL: {message}"
      .Decode(cause) => "{cause}"
      .TooLarge(limit) => "the body is longer than {limit} bytes"
      .InvalidText(cause) => "{cause}"
      .Cancelled => "the request was cancelled"
    }
  }

  /** The failure a rejected body carries, so a report can unwind the chain down to the field or the byte. */
  fn cause(): Error? {
    match kind {
      .Decode(problem) => Some problem
      .InvalidText(problem) => Some problem
      _ => None
    }
  }
}

type HttpErrorKind {
  case Timeout
  case ConnectionFailed(message: String)
  case Status(code: Int, message: String)
  case InvalidUrl(message: String)
  case Decode(cause: JsonError)
  case TooLarge(limit: Int)
  case InvalidText(cause: Utf8Error)
  case Cancelled
}

/** What makes `body.lines()` work: a stage over bytes, so it needs nothing of HTTP. */
extend HttpError with From<Utf8Error> {
  static fn from(value: Utf8Error): HttpError {
    HttpError.invalidText value
  }
}

/** A request whose task was cancelled did not complete: the failure every stream's failure type converts from. */
extend HttpError with From<Cancelled> {
  static fn from(value: Cancelled): HttpError {
    HttpError kind: .Cancelled
  }
}

/** ...and what makes `body.through(Json.items<User>()).checked()` work without naming a second failure type. */
extend HttpError with From<JsonError> {
  static fn from(value: JsonError): HttpError {
    HttpError.decodeFailed value
  }
}

/** `http.get(url).outcome()?` */
public native fn get(url: String, headers: Map<String, String> = [:]): Task<Result<Response, HttpError>>

/** `http.post(url, Body.from(text)).outcome()?` - the body may be a stream, so an upload is not held in memory. */
public native fn post(
  url: String,
  body: Body,
  headers: Map<String, String> = [:],
): Task<Result<Response, HttpError>>

/** For methods and headers `get`/`post` do not cover. */
public native fn request(request: Request): Task<Result<Response, HttpError>>
