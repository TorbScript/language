/**
 * HTTP/1.1, client and server, in TorbScript over `std/network` (docs/design/NETWORK.md sections 6 to 9).
 *
 * The client: [get], [post] and [send] take the `Uri` to reach and answer a task of a [Response], whose [Body] is a stream - a response of any
 * size can be piped into a file or read chunk by chunk, and the convenience that covers nine cases out of ten sits on
 * top of it (`body.text()`, `body.json<User>()`, each with a limit).
 *
 * The server: [Server.listen] with a [Handler], a function from a [Request] to a task of a [Response]; every connection
 * is a task, and the parser is strict about everything request smuggling lives on.
 *
 * Needs the network capability inside a sandboxed script; `https` is TLS over `std/tls`.
 *
 * # Examples
 *
 *     use * as http from "std/http"
 *
 *     type User {
 *       id: Int
 *       name: String
 *     }
 *
 *     fn fetchUser(api: Uri, id: Int): Task<Result<User, HttpError>> {
 *       var response = http.get(api.joined("users/{id}")).await()?
 *       response.json<User>().await()
 *     }
 */

public use HttpError from "./error"
public use Method, Status, Headers, Body, Request, Response from "./message"
public use Server, ServerLimits, Handler from "./server"
public use get, post, send from "./client"
public use Client, RedirectPolicy from "./pool"
