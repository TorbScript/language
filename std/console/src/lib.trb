/**
 * Writing to the two standard streams. `panic` is not here but in `std/core`: half of `std/core` calls it
 * (`Result.expect`, every out-of-bounds index), and a package that everything depends on must not depend on this one.
 */

use Show from "std/core"

/** Writes the values to standard output, separated by spaces, followed by a line break. */
public native fn print(...values: Show)

/** The same for standard error: diagnostics, progress, everything that is not the result of the program. */
public native fn printError(...values: Show)
