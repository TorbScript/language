/**
 * [Fixed], the deterministic scalar: a whole number of `1/65536` parts, with every operation - the square root and the
 * trigonometry included - computed in integer arithmetic alone.
 *
 * It exists for the one thing a `Float` cannot promise: the same bits everywhere. `sine` on a `Float64` is whatever the
 * platform's mathematics library computes, and that differs between machines, between C libraries and between back
 * ends. A lockstep simulation, a replay and a checksum over a world state all need two machines to agree exactly, so
 * they run on a `Fixed` instead, and everything in `std/linear` and `std/geometry` that is generic over a [Real] scalar
 * works unchanged with one.
 */

use Numeric, Signed, Real, NumberParseError from "std/number"
use Add, Subtract, Multiply, Divide, Remainder, Power, Negate from "std/core"
use Equals, Compare, Ordering, Hash, From, TryFrom, Show from "std/core"

/**
 * A number held as a whole number of `1/65536` parts: the Q16.16 fixed-point scalar, and the only [Real] whose answers
 * are the same bits on every platform and out of every back end.
 *
 * The field is the raw count, so `Fixed(65536)` is one and `Fixed(1)` is the smallest step there is. Build a value
 * with [Fixed.from], [Fixed.approximating] or [Fixed.tryFrom] rather than by counting parts.
 *
 * `Fixed` carries [Real], so `Vector2<Fixed>`, `Rectangle<Fixed>` and every intersection test of `std/geometry` accept
 * it in place of `Float` with no other change to the code.
 *
 * # Examples
 *
 *     const half = Fixed.tryFrom("0.5").expect("half parses")
 *     const three = Fixed.from 3
 *     print "{three * half} {three.squareRoot()}"
 *
 * # Pitfalls
 *
 * - The range of a product is the real limit, not the range of the type. `multiply` forms `parts * other.parts`
 *   before it scales back down, so two values above about 46341 overflow and the multiplication panics, although both
 *   operands are far inside [Fixed.largest].
 * - `squareRoot` scales up before it takes the root, so it panics above about 2147483648 for the same reason.
 * - Division and the remainder truncate towards zero, exactly as they do on `Int`.
 * - [Fixed.smallest] cannot be shown or negated. Its count of parts is the smallest `Int` there is, and that one has no
 *   positive counterpart - so `absolute` on it overflows, here as everywhere.
 * - Every step is a multiple of `1/65536`, so a value that a decimal writes exactly is usually not one a `Fixed`
 *   holds exactly: `Fixed.tryFrom("0.1")` is `0.100006103515625`, and [Fixed.show] writes that, because that is the
 *   number.
 *
 * # Related
 *
 * - [Real] - the trait that makes this and `Float64` interchangeable.
 * - [Fixed.parts] - the raw count, for a checksum or a wire format.
 */
public type Fixed with Signed, Real, Power, Hash, Show, TryFrom<String, NumberParseError> {
  /** The value counted in `1/65536` parts. `Fixed(65536)` is one, and `Fixed(1)` is the smallest step. */
  parts: Int64

  /** How many parts one whole is: `65536`, which is what makes this Q16.16. */
  static partsPerWhole: Int64 = 65536

  /** The largest value the type holds. Arithmetic on it overflows long before this. */
  static largest: Fixed = Fixed 9223372036854775807

  /** The smallest value the type holds. */
  static smallest: Fixed = Fixed(-9223372036854775807 - 1)

  /** The smallest step between two values: `1/65536`. */
  static step: Fixed = Fixed 1

  /** The value nothing: no parts at all. */
  static zero: Fixed = Fixed 0

  /** The whole, which is 65536 parts. */
  static one: Fixed = Fixed 65536

  /** The ratio of a circle's circumference to its diameter, to the nearest part. */
  static pi: Fixed = Fixed 205887

  /** A full turn in radians, to the nearest part. */
  static tau: Fixed = Fixed 411775

  /** One part, the same value as [Fixed.step]: the [Real.epsilon] of a fixed-point number. */
  static epsilon: Fixed = Fixed 1

  /** The base of the natural logarithm, to the nearest part: the [Real.e] of a fixed-point number. */
  static e: Fixed = Fixed 178145

  /**
   * The value a `Float64` is closest to, rounded to the nearest part.
   *
   * This is the bridge out of floating point, and it is deliberately not a [From]: it loses information, and a
   * conversion that loses information says so at the call.
   *
   *     print Fixed.approximating 0.5
   *
   * # Panics
   *
   * When the value is not a number, or when its magnitude is above about `140737488355327` - the overflow of the
   * multiplication by `65536`, which is an overflow like any other.
   */
  static fn approximating(value: Float64): Fixed {
    const scaled = value * 65536.0
    match Int64.tryFrom(scaled.round()) {
      Ok(parts) => Fixed parts
      Fail(_) => panic "the Float {value} is outside the range of a Fixed"
    }
  }

  /** The value as the nearest `Float64`. Exact for every `Fixed` whose magnitude is below `2^37`. */
  fn toFloat(): Float64 {
    Float64.from(parts) / 65536.0
  }

  /** The whole part, truncated towards zero: what `Int` this value is, ignoring everything after the point. */
  fn toInt(): Int64 {
    parts / partsPerWhole
  }

  /** The sum: two counts of parts added, exactly. */
  fn add(other: Fixed): Fixed {
    Fixed(parts + other.parts)
  }

  /** The difference: two counts of parts subtracted, exactly. */
  fn subtract(other: Fixed): Fixed {
    Fixed(parts - other.parts)
  }

  /** The product, scaled back down. Panics where the intermediate `parts * other.parts` leaves the range of an `Int`. */
  fn multiply(other: Fixed): Fixed {
    Fixed(parts * other.parts / partsPerWhole)
  }

  /** The quotient, truncated towards zero. Panics on a division by zero and where `parts * 65536` overflows. */
  fn divide(other: Fixed): Fixed {
    Fixed(parts * partsPerWhole / other.parts)
  }

  /** What is left after dividing out as many of the other as fit, with the sign of this value. */
  fn remainder(other: Fixed): Fixed {
    Fixed(parts % other.parts)
  }

  /** The value with its sign flipped. */
  fn negate(): Fixed {
    Fixed(-parts)
  }

  /** The value without its sign. */
  fn absolute(): Fixed {
    Fixed parts.absolute()
  }

  /** Whether the two hold the same count of parts, which is exact equality. */
  fn equals(other: Fixed): Bool {
    parts == other.parts
  }

  /** Which of the two is the smaller, as a total order with no value like a `nan` in it. */
  fn compare(other: Fixed): Ordering {
    parts.compare other.parts
  }

  /** The count of parts itself: two values that are equal hold the same count. */
  fn hash(): Int {
    parts
  }

  /**
   * The exact decimal the value is, with at least one digit after the point. A `Fixed` is a multiple of `1/65536`, so
   * the expansion always ends, after at most sixteen digits.
   *
   *     print Fixed.tryFrom("0.1").expect("a tenth parses")
   */
  fn show(): String {
    const whole = parts.absolute() / partsPerWhole
    var fraction = parts.absolute() % partsPerWhole
    var digits = ""
    loop {
      if fraction == 0 {
        break
      }
      const carried = fraction * 10
      digits = "{digits}{carried / partsPerWhole}"
      fraction = carried % partsPerWhole
    }
    const written = if digits.isEmpty() { "{whole}.0" } else { "{whole}.{digits}" }
    if parts < 0 { "-{written}" } else { written }
  }

  /**
   * Reads a decimal, rounding to the nearest part. At most nine digits after the point are read; what follows them is
   * below the resolution of the type anyway.
   *
   *     print Fixed.tryFrom("-2.25")
   *
   * # Errors
   *
   * - [NumberParseError] where the text is not a decimal, or where its whole part does not fit.
   */
  static fn tryFrom(text: String): Result<Fixed, NumberParseError> {
    const trimmed = text.trim()
    const negative = trimmed.startsWith "-"
    const unsigned = if negative { trimmed.substringAfter("-") ?? "" } else { trimmed }
    const pieces = unsigned.split "."
    if unsigned.isEmpty() || pieces.length() > 2 {
      return Fail NumberParseError(text)
    }
    const whole = match Int64.tryFrom(pieces[0]) {
      Ok(found) => found
      Fail(_) => {
        return Fail NumberParseError(text)
      }
    }
    if whole > 140737488355327 {
      return Fail NumberParseError(text)
    }
    const digits = if pieces.length() == 2 { pieces[1] } else { "" }
    match fractionParts(digits) {
      Some(fraction) => {
        const total = whole * Fixed.partsPerWhole + fraction
        Ok Fixed(if negative { -total } else { total })
      }
      None => Fail NumberParseError(text)
    }
  }

  /** The non-negative square root, to the nearest part below the true one. Negative input answers zero. */
  fn squareRoot(): Fixed {
    if parts <= 0 {
      return Fixed 0
    }
    Fixed integerSquareRoot(parts * partsPerWhole)
  }

  /** The sine of this many radians, within about two parts of the true value. */
  fn sine(): Fixed {
    Fixed circular(parts).sine
  }

  /** The cosine of this many radians, within about two parts of the true value. */
  fn cosine(): Fixed {
    Fixed circular(parts).cosine
  }

  /**
   * The sine over the cosine.
   *
   * # Panics
   *
   * At a quarter turn and at three quarters, where the cosine is zero - a division by zero like any other.
   */
  fn tangent(): Fixed {
    const turned = circular parts
    Fixed(turned.sine * partsPerWhole / turned.cosine)
  }

  /**
   * The angle whose sine this is.
   *
   * # Panics
   *
   * Outside `[-1, 1]`, where there is no such angle. `Float64.arcSine` answers `nan` there, because that is what the
   * platform's mathematics library answers; the two implementors of [Real] differ here and `docs/design/LINEAR.md` records it.
   */
  fn arcSine(): Fixed {
    if parts.absolute() > partsPerWhole {
      panic "the arc sine of {show()} does not exist: the sine of an angle is between -1 and 1"
    }
    const cosine = integerSquareRoot(partsPerWhole * partsPerWhole - parts * parts)
    Fixed direction(cosine, parts)
  }

  /**
   * The angle whose cosine this is.
   *
   * # Panics
   *
   * Outside `[-1, 1]`, where there is no such angle, through [Fixed.arcSine].
   */
  fn arcCosine(): Fixed {
    Fixed(102944 - arcSine().parts)
  }

  /** The angle in radians whose tangent this is. */
  fn arcTangent(): Fixed {
    Fixed direction(partsPerWhole, parts)
  }

  /** The angle in radians of the point `(by, self)`, in `(-pi, pi]`. */
  fn arcTangentDivided(by: Fixed): Fixed {
    Fixed direction(by.parts, parts)
  }

  /**
   * `e` raised to this value, to within a part or two of the true value.
   *
   * # Panics
   *
   * Above about `33.5`, where the result no longer fits a `Fixed`. Far below zero the answer is zero, because that is
   * the nearest part.
   */
  fn exponential(): Fixed {
    Fixed exponentialOfWide(parts * widePartsPerPart)
  }

  /**
   * The logarithm to the base `e`, to within a part or two of the true value.
   *
   * # Panics
   *
   * At zero and below, where there is no logarithm. `Float64.naturalLogarithm` answers an infinity or `nan` there,
   * because that is what the platform's mathematics library answers.
   */
  fn naturalLogarithm(): Fixed {
    if parts <= 0 {
      panic "the logarithm of {show()} does not exist: only a positive number has one"
    }
    Fixed scaledDown(logarithmWide(parts), widePartsPerPart)
  }

  /**
   * This value raised to a `Fixed` power: `e ** (exponent * ln self)`, computed with fourteen more bits than a `Fixed`
   * holds so that the logarithm does not lose them before the exponential needs them.
   *
   * # Panics
   *
   * - Where the base is negative and the exponent is not whole: there is no real power then. A whole exponent of a
   *   negative base is `Power<Int64>`'s answer with its sign.
   * - Where the base is zero and the exponent negative, which is a division by zero.
   * - Where the result does not fit a `Fixed`.
   */
  fn power(exponent: Fixed): Fixed {
    if exponent.parts % partsPerWhole == 0 {
      return self ** (exponent.parts / partsPerWhole)
    }
    if parts < 0 {
      panic "{show()} ** {exponent.show()} is not a real number: a negative base has only whole powers"
    }
    if parts == 0 {
      if exponent.parts < 0 {
        panic "0.0 ** {exponent.show()} divides by zero"
      }
      return Fixed 0
    }
    const logarithm = logarithmWide parts
    // Far enough out that the result overflows or is zero whatever the exact product is
    if logarithm != 0 && exponent.parts.absolute() > Int64.maximum / logarithm.absolute() {
      if (logarithm > 0) == (exponent.parts > 0) {
        panic "{show()} ** {exponent.show()} does not fit a Fixed"
      }
      return Fixed 0
    }
    Fixed exponentialOfWide(scaledDown(logarithm * exponent.parts, partsPerWhole))
  }

  /** The value rounded towards negative infinity. */
  fn floor(): Fixed {
    const left = parts % partsPerWhole
    if left == 0 || parts > 0 { Fixed(parts - left) } else { Fixed(parts - left - partsPerWhole) }
  }

  /** The value rounded towards positive infinity. */
  fn ceiling(): Fixed {
    const left = parts % partsPerWhole
    if left == 0 || parts < 0 { Fixed(parts - left) } else { Fixed(parts - left + partsPerWhole) }
  }

  /** The value rounded to the nearest whole number, halves away from zero. */
  fn round(): Fixed {
    const half = partsPerWhole / 2
    if parts >= 0 {
      Fixed((parts + half) / partsPerWhole * partsPerWhole)
    } else {
      Fixed(-((half - parts) / partsPerWhole * partsPerWhole))
    }
  }

  /** Half the value, rounded towards zero by the last part. */
  fn halved(): Fixed {
    Fixed(parts / 2)
  }

  /** The angle in radians that this many degrees is, rounded to the nearest part. */
  fn radiansOfDegrees(): Fixed {
    Fixed(parts * 205887 / 180 / 65536)
  }

  /** The angle in degrees that this many radians is, rounded to the nearest part. */
  fn degreesOfRadians(): Fixed {
    Fixed(parts * 180 * 65536 / 205887)
  }

  /** Twice the value. */
  fn doubled(): Fixed {
    Fixed(parts + parts)
  }

  /** Whether the two values are within `tolerance` of each other. The default is about `0.001`. */
  fn isCloseTo(other: Fixed, tolerance: Fixed = Fixed(66)): Bool {
    (parts - other.parts).absolute() <= tolerance.parts
  }
}

/**
 * A whole power, by squaring: every step is a multiplication of `Fixed` values, so the result is the same bits
 * everywhere, and a negative exponent is one over the positive power.
 *
 * # Panics
 *
 * Where a step leaves the range a multiplication of two `Fixed` values has, and at zero to a negative power, which is a
 * division by zero.
 */
extend Fixed with Power<Int64> {
  fn power(exponent: Int64): Fixed {
    if exponent < 0 {
      if exponent == Int64.minimum {
        panic "{show()} ** {exponent} does not fit a Fixed"
      }
      return Fixed.one / self ** -exponent
    }
    var result = Fixed.one
    var factor = self
    var left = exponent
    while left > 0 {
      if left % 2 == 1 {
        result = result * factor
      }
      left = left / 2
      if left > 0 {
        factor = factor * factor
      }
    }
    result
  }
}

/** A whole number is exact as a `Fixed` while its magnitude stays below `2^47`; above that the multiplication panics. */
extend Fixed with From<Int64> {
  static fn from(value: Int64): Fixed {
    Fixed(value * 65536)
  }
}

/**
 * The digits after the point as a count of parts, rounded to the nearest one, or `None` where a character is not a
 * digit. At most nine digits are read: ten would overflow the intermediate, and the tenth is already far below
 * `1/65536`.
 */
fn fractionParts(digits: String): Int64? {
  var index = 0
  var numerator: Int64 = 0
  var scale: Int64 = 1
  loop {
    if index >= digits.byteLength() || index >= 9 {
      break
    }
    const character = digits.charAtByte(index) ?? ' '
    if !character.isDigit() {
      return None
    }
    numerator = numerator * 10 + Int64.from(character) - 48
    scale = scale * 10
    index = index + 1
  }
  Some((numerator * 65536 + scale / 2) / scale)
}

/**
 * The largest whole number whose square is at most `value`, by Newton's method on integers. Every step is an integer
 * division, so the answer is the same on every platform.
 */
fn integerSquareRoot(value: Int64): Int64 {
  if value <= 0 {
    return 0
  }
  var guess = value
  var next = (guess + value / guess) / 2
  loop {
    if next >= guess {
      break
    }
    guess = next
    next = (guess + value / guess) / 2
  }
  guess
}

/**
 * `value / divisor`, rounded to the nearest whole number instead of towards zero. A rotation step that always
 * truncates pulls every vector towards the origin, and sixteen of them add up to a visible error.
 */
fn scaledDown(value: Int64, divisor: Int64): Int64 {
  const half = divisor / 2
  if value >= 0 { (value + half) / divisor } else { (value - half) / divisor }
}

/** `2 ** index` for the sixteen steps of the rotation, as a divisor: a shift written as the division it is. */
fn halvings(index: Int): Int64 {
  2 ** index
}

/** `arcTangent(2^-index)` in parts, the angle one rotation step turns by. */
fn stepAngle(index: Int): Int64 {
  const angles = [51472, 30386, 16055, 8150, 4091, 2047, 1024, 512, 256, 128, 64, 32, 16, 8, 4, 2]
  angles[index]
}

/**
 * The sine and the cosine of an angle in parts, by CORDIC: sixteen rotations by a fixed angle each, where every
 * rotation is an addition and a division by a power of two. No table of sines, no series, no floating point - which is
 * what makes the answer the same everywhere.
 */
fn circular(angle: Int64): (sine: Int64, cosine: Int64) {
  const halfTurn: Int64 = 205887
  const fullTurn: Int64 = 411775
  const quarterTurn: Int64 = 102944
  var reduced = angle % fullTurn
  if reduced > halfTurn {
    reduced = reduced - fullTurn
  }
  if reduced < -halfTurn {
    reduced = reduced + fullTurn
  }
  var opposite = false
  if reduced > quarterTurn {
    reduced = halfTurn - reduced
    opposite = true
  }
  if reduced < -quarterTurn {
    reduced = -halfTurn - reduced
    opposite = true
  }
  // The rotation shrinks every vector by the same factor, so it starts at the reciprocal of that factor and ends at one
  var horizontal: Int64 = 39797
  var vertical: Int64 = 0
  var left = reduced
  var index = 0
  loop {
    if index >= 16 {
      break
    }
    const divisor = halvings index
    const sideways = scaledDown vertical, divisor
    const upwards = scaledDown horizontal, divisor
    if left >= 0 {
      horizontal = horizontal - sideways
      vertical = vertical + upwards
      left = left - stepAngle(index)
    } else {
      horizontal = horizontal + sideways
      vertical = vertical - upwards
      left = left + stepAngle(index)
    }
    index = index + 1
  }
  (sine: vertical, cosine: if opposite { -horizontal } else { horizontal })
}

/**
 * The angle in parts of the point `(horizontal, vertical)`, in `(-pi, pi]`, by CORDIC in the other direction: the
 * rotations that drive the vertical component to zero add up to the angle.
 */
fn direction(horizontal: Int64, vertical: Int64): Int64 {
  const halfTurn: Int64 = 205887
  const quarterTurn: Int64 = 102944
  if horizontal == 0 {
    if vertical > 0 {
      return quarterTurn
    }
    if vertical < 0 {
      return -quarterTurn
    }
    return 0
  }
  const flipped = horizontal < 0
  var across = if flipped { -horizontal } else { horizontal }
  var upwards = if flipped { -vertical } else { vertical }
  var turned: Int64 = 0
  var index = 0
  loop {
    if index >= 16 {
      break
    }
    const divisor = halvings index
    const sideways = scaledDown upwards, divisor
    const downwards = scaledDown across, divisor
    if upwards > 0 {
      across = across + sideways
      upwards = upwards - downwards
      turned = turned + stepAngle(index)
    } else {
      across = across - sideways
      upwards = upwards + downwards
      turned = turned - stepAngle(index)
    }
    index = index + 1
  }
  if !flipped {
    return turned
  }
  if vertical >= 0 { turned + halfTurn } else { turned - halfTurn }
}

/**
 * How many parts of the wide scale one part of a `Fixed` is: the exponential and the logarithm compute with fourteen
 * bits more than a `Fixed` holds (Q30), so that the rounding of every step stays below the last part of the result.
 */
const widePartsPerPart: Int64 = 16384

/** One whole on the wide scale: `2^30`. */
const wideWhole: Int64 = 1073741824

/** The natural logarithm of two on the wide scale, to the nearest wide part. */
const wideLogarithmOfTwo: Int64 = 744261118

/**
 * `e` raised to a value on the wide scale, as the parts of a `Fixed`. The value is split into a multiple of `ln 2` and a
 * rest below half of it; the rest is a Taylor series that ends where its terms are below one wide part, and the
 * multiple is a shift. Every step is integer arithmetic, so the answer is the same bits everywhere.
 */
fn exponentialOfWide(value: Int64): Int64 {
  if value > 33 * wideWhole {
    panic "the exponential of {Float64.from(value) / 1073741824.0} does not fit a Fixed"
  }
  if value < -20 * wideWhole {
    return 0
  }
  const multiple = scaledDown value, wideLogarithmOfTwo
  const rest = value - multiple * wideLogarithmOfTwo
  var sum = wideWhole
  var term = wideWhole
  var index: Int64 = 1
  loop {
    term = term * rest / wideWhole / index
    if term == 0 {
      break
    }
    sum = sum + term
    index = index + 1
  }
  // `sum` is `e ** rest` on the wide scale, between about 0.7 and 1.4; the parts are it times `2 ** multiple`
  const shift = multiple - 14
  if shift >= 0 {
    if sum > Int64.maximum / 2 ** shift {
      panic "the exponential of {Float64.from(value) / 1073741824.0} does not fit a Fixed"
    }
    return sum * 2 ** shift
  }
  if shift < -62 {
    return 0
  }
  scaledDown(sum, 2 ** -shift)
}

/**
 * The natural logarithm of a positive count of parts, on the wide scale. The value is brought into `[1, 2)` by halving
 * or doubling, which counts `ln 2`s; the logarithm of what is left is `2 * atanh((y - 1) / (y + 1))`, a series in odd
 * powers of a number below a third that ends where its terms are below one wide part.
 */
fn logarithmWide(parts: Int64): Int64 {
  var halvings: Int64 = 0
  var count = parts
  // Past `2^48` the multiplication onto the wide scale would overflow; the bits dropped here are far below a part
  while count >= 281474976710656 {
    count = count / 2
    halvings = halvings + 1
  }
  var mantissa = count * widePartsPerPart
  while mantissa >= 2 * wideWhole {
    mantissa = scaledDown mantissa, 2
    halvings = halvings + 1
  }
  while mantissa < wideWhole {
    mantissa = mantissa * 2
    halvings = halvings - 1
  }
  const ratio = (mantissa - wideWhole) * wideWhole / (mantissa + wideWhole)
  const square = ratio * ratio / wideWhole
  var power = ratio
  var sum = ratio
  var divisor: Int64 = 3
  loop {
    power = power * square / wideWhole
    const term = power / divisor
    if term == 0 {
      break
    }
    sum = sum + term
    divisor = divisor + 2
  }
  2 * sum + halvings * wideLogarithmOfTwo
}
