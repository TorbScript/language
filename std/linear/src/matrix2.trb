/**
 * [Matrix2], the 2x2 matrix: the linear part of a transformation in the plane - rotation, scale, shear - without a
 * translation.
 *
 * The fields are the *columns*, and a column is where a basis vector lands. That is the whole of what a matrix is, so
 * reading one is reading two vectors, and `xAxis` is `matrix * unitX`.
 */

use Numeric, Signed, Real from "std/number"
use zeroOf from "./scalar"
use Add, Subtract, Multiply, Negate from "std/core"
use Fixed from "./fixed"
use Angle from "./angle"
use Vector2 from "./vector2"

/**
 * A linear transformation of the plane, held as the two vectors its basis lands on.
 *
 * Vectors are columns and a transformation is applied on the left (`matrix * vector`), which is the convention of
 * mathematics and of every graphics API that says "column-major": composing `a` after `b` is `a * b`.
 *
 * # Examples
 *
 *     const turn = Matrix2.rotation by: Angle.degrees(90.0)
 *     print turn.applied(to: Vector2(1.0, 0.0)).isCloseTo(Vector2(0.0, 1.0), tolerance: 0.0001)
 *
 * # Open
 *
 * - [Matrix2.identity] needs its scalar written out: `Matrix2<Float>.identity`.
 *
 * # Related
 *
 * - `Matrix3` - the same with a translation, for the plane.
 * - [Vector2.rotated] - a rotation of one vector, without building a matrix for it.
 */
public type Matrix2<Scalar: Numeric = Float> with Add, Subtract, Multiply {
  /** Where the first basis vector lands. */
  xAxis: Vector2<Scalar>
  /** Where the second basis vector lands. */
  yAxis: Vector2<Scalar>

  /** A diagonal matrix: each axis scaled on its own, and nothing mixed. */
  fn scaling(by: Vector2<Scalar>): Matrix2<Scalar> {
    const nothing = zeroOf(by.x)
    Matrix2 Vector2(by.x, nothing), Vector2(nothing, by.y)
  }

  /** The two rows read as columns: the inverse of a rotation, and half of the inverse of anything else. */
  fn transposed(self): Matrix2<Scalar> {
    Matrix2 Vector2(xAxis.x, yAxis.x), Vector2(xAxis.y, yAxis.y)
  }

  /** The factor the transformation multiplies an area by. Zero exactly where it collapses the plane onto a line. */
  fn determinant(self): Scalar {
    xAxis.x * yAxis.y - yAxis.x * xAxis.y
  }

  /** The cell in that row and that column. Panics outside `0..2`. */
  fn at(self, row: Int, column: Int): Scalar {
    const axis = if column == 0 { xAxis } else { yAxis }
    if row == 0 { axis.x } else { axis.y }
  }

  /** Cell by cell. Adding two transformations is not composing them; `multiply` is. */
  fn add(self, other: Matrix2<Scalar>): Matrix2<Scalar> {
    Matrix2 xAxis.add(other.xAxis), yAxis.add(other.yAxis)
  }

  /** Cell by cell. */
  fn subtract(self, other: Matrix2<Scalar>): Matrix2<Scalar> {
    Matrix2 xAxis.subtract(other.xAxis), yAxis.subtract(other.yAxis)
  }

  /** The composition: `self` after `other`. */
  fn multiply(self, other: Matrix2<Scalar>): Matrix2<Scalar> {
    Matrix2 applied(to: other.xAxis), applied(to: other.yAxis)
  }

  /**
   * The vector transformed: the column combination `x * xAxis + y * yAxis`.
   *
   * It is a method and not `matrix * vector`, because a type has one namespace of members and `multiply` is already the
   * composition of two matrices.
   */
  fn applied(self, to: Vector2<Scalar>): Vector2<Scalar> {
    xAxis.multiply(to.x).add(yAxis.multiply(to.y))
  }
}

/** Every cell turned around. */
extend<Scalar: Signed> Matrix2<Scalar> with Negate {
  /** Every cell with its sign flipped. */
  fn negate(self): Matrix2<Scalar> {
    Matrix2 xAxis.negate(), yAxis.negate()
  }
}

/** What an angle and a division buy: rotations and the way back. */
extend<Scalar: Real> Matrix2<Scalar> {
  /** The rotation by that angle, from the first axis towards the second. */
  fn rotation(by: Angle<Scalar>): Matrix2<Scalar> {
    const sine = by.sine()
    const cosine = by.cosine()
    Matrix2 Vector2(cosine, sine), Vector2(-sine, cosine)
  }

  /**
   * The transformation that undoes this one, or `None` where there is none - which is exactly where the determinant is
   * zero and the plane has been collapsed onto a line.
   */
  fn inverse(self): Matrix2<Scalar>? {
    const scale: Scalar = self.determinant()
    if scale == zeroOf(scale) {
      return None
    }
    Some Matrix2(Vector2(yAxis.y / scale, -xAxis.y / scale), Vector2(-yAxis.x / scale, xAxis.x / scale))
  }

  /** Whether every cell is within `tolerance` of the other matrix's. */
  fn isCloseTo(self, other: Matrix2<Scalar>, tolerance: Scalar): Bool {
    xAxis.isCloseTo(other.xAxis, tolerance: tolerance) && yAxis.isCloseTo(other.yAxis, tolerance: tolerance)
  }
}

/** The float matrix's identity. */
extend Matrix2<Float> {
  /** The transformation that changes nothing. */
  const identity: Matrix2<Float> = Matrix2 Vector2(1.0, 0.0), Vector2(0.0, 1.0)
}

/** The grid matrix's identity. */
extend Matrix2<Int> {
  /** The transformation that changes nothing. */
  const identity: Matrix2<Int> = Matrix2 Vector2(1, 0), Vector2(0, 1)
}

/** The deterministic matrix's identity. */
extend Matrix2<Fixed> {
  /** The transformation that changes nothing. */
  const identity: Matrix2<Fixed> = Matrix2 Vector2(Fixed(65536), Fixed(0)), Vector2(Fixed(0), Fixed(65536))
}
