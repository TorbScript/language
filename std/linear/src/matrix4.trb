/**
 * [Matrix4], the 4x4 matrix: the affine transformation of space - rotation, scale, shear and a translation - that a
 * scene graph is built out of.
 *
 * The fields are the columns, and a column is where a basis vector lands; the fourth column is the translation. What is
 * deliberately absent is a projection: a projection matrix depends on the clip space of the API that consumes it - how
 * deep it is and which way it points - and this package knows nothing about an API. Those belong where that convention
 * is known.
 */

use Numeric, Signed, Real from "std/number"
use Add, Subtract, Multiply, Power, Negate from "std/core"
use Vector3 from "./vector3"
use Vector4 from "./vector4"
use Matrix3 from "./matrix3"

/**
 * An affine transformation of space, held as the four vectors its homogeneous basis lands on.
 *
 * Vectors are columns and a transformation is applied on the left, so composing `a` after `b` is `a * b` and a chain
 * reads right to left, the way it does in mathematics.
 *
 * # Examples
 *
 *     const move = Matrix4.translation of: Vector3(1.0, 2.0, 3.0)
 *     print move.transformedPoint(Vector3(0.0, 0.0, 0.0))
 *
 * # Related
 *
 * - [Matrix3] - the linear part on its own, and the affine form for the plane.
 * - `Quaternion` - a rotation that interpolates without shearing.
 */
public type Matrix4<Scalar: Numeric = Float> with Add, Subtract, Multiply {
  /** Where the first basis vector lands. */
  xAxis: Vector4<Scalar>
  /** Where the second basis vector lands. */
  yAxis: Vector4<Scalar>
  /** Where the third basis vector lands. */
  zAxis: Vector4<Scalar>
  /** Where the origin lands: the translation, with a one in its fourth component. */
  wAxis: Vector4<Scalar>

  /** The transformation that changes nothing, over whichever scalar is asked for: `Matrix4<Int>.identity`. */
  static identity: Matrix4<Scalar> = Matrix4(
    Vector4(Scalar.one, Scalar.zero, Scalar.zero, Scalar.zero),
    Vector4(Scalar.zero, Scalar.one, Scalar.zero, Scalar.zero),
    Vector4(Scalar.zero, Scalar.zero, Scalar.one, Scalar.zero),
    Vector4(Scalar.zero, Scalar.zero, Scalar.zero, Scalar.one),
  )

  /** The three rows and columns that are the linear part: the rotation, the scale and the shear, without the move. */
  fn linearPart(): Matrix3<Scalar> {
    Matrix3 xAxis.toVector3(), yAxis.toVector3(), zAxis.toVector3()
  }

  /** The translation the transformation carries. */
  fn translationPart(): Vector3<Scalar> {
    wAxis.toVector3()
  }

  /** The rows read as columns. */
  fn transposed(): Matrix4<Scalar> {
    Matrix4(
      Vector4(xAxis.x, yAxis.x, zAxis.x, wAxis.x),
      Vector4(xAxis.y, yAxis.y, zAxis.y, wAxis.y),
      Vector4(xAxis.z, yAxis.z, zAxis.z, wAxis.z),
      Vector4(xAxis.w, yAxis.w, zAxis.w, wAxis.w),
    )
  }

  /** The column at that index. Panics outside `0..4`. */
  fn column(index: Int): Vector4<Scalar> {
    if index == 0 {
      return xAxis
    }
    if index == 1 {
      return yAxis
    }
    if index == 2 { zAxis } else { wAxis }
  }

  /** The cell in that row and that column. Panics outside `0..4`. */
  fn at(row: Int, index: Int): Scalar {
    const axis = column index
    if row == 0 {
      return axis.x
    }
    if row == 1 {
      return axis.y
    }
    if row == 2 { axis.z } else { axis.w }
  }

  /** The row at that index. Panics outside `0..4`. */
  fn row(index: Int): Vector4<Scalar> {
    Vector4 at(index, 0), at(index, 1), at(index, 2), at(index, 3)
  }

  /** Cell by cell. Adding two transformations is not composing them; `multiply` is. */
  fn add(other: Matrix4<Scalar>): Matrix4<Scalar> {
    Matrix4 xAxis.add(other.xAxis), yAxis.add(other.yAxis), zAxis.add(other.zAxis), wAxis.add(other.wAxis)
  }

  /** Cell by cell. */
  fn subtract(other: Matrix4<Scalar>): Matrix4<Scalar> {
    Matrix4(
      xAxis.subtract(other.xAxis),
      yAxis.subtract(other.yAxis),
      zAxis.subtract(other.zAxis),
      wAxis.subtract(other.wAxis),
    )
  }

  /** The composition: `self` after `other`. */
  fn multiply(other: Matrix4<Scalar>): Matrix4<Scalar> {
    Matrix4 applied(to: other.xAxis), applied(to: other.yAxis), applied(to: other.zAxis), applied(to: other.wAxis)
  }

  /**
   * The homogeneous vector transformed: the combination of the four columns.
   *
   * It is a method and not `matrix * vector`, because a type has one namespace of members and `multiply` is already the
   * composition of two matrices.
   */
  fn applied(to: Vector4<Scalar>): Vector4<Scalar> {
    xAxis.multiply(to.x).add(yAxis.multiply(to.y)).add(zAxis.multiply(to.z)).add(wAxis.multiply(to.w))
  }

  /** A direction, turned by the transformation: the translation is not applied. */
  fn transformedDirection(direction: Vector3<Scalar>): Vector3<Scalar> {
    const turned = applied to: Vector4.of(direction, Scalar.zero)
    turned.toVector3()
  }

  /**
   * The factor by which the transformation scales a volume of the homogeneous space, negative where it turns space
   * inside out and zero exactly where it flattens one - which is where [Matrix4.inverse] answers `None`.
   *
   *     print Matrix4.scaling(by: Vector3(2.0, 3.0, 4.0)).determinant()
   */
  fn determinant(): Scalar {
    minorsOf(self).determinant()
  }

  /** A diagonal matrix: each axis scaled on its own, and the translation left at the origin. */
  static fn scaling(by: Vector3<Scalar>): Matrix4<Scalar> {
    const nothing = Scalar.zero
    Matrix4(
      Vector4(by.x, nothing, nothing, nothing),
      Vector4(nothing, by.y, nothing, nothing),
      Vector4(nothing, nothing, by.z, nothing),
      Vector4(nothing, nothing, nothing, Scalar.one),
    )
  }

  /**
   * The transformation that moves everything by that much and changes nothing else.
   *
   *     const move = Matrix4.translation of: Vector3(1.0, 0.0, 0.0)
   *     print move.translationPart()
   */
  static fn translation(of: Vector3<Scalar>): Matrix4<Scalar> {
    const nothing = Scalar.zero
    const whole = Scalar.one
    Matrix4(
      Vector4(whole, nothing, nothing, nothing),
      Vector4(nothing, whole, nothing, nothing),
      Vector4(nothing, nothing, whole, nothing),
      Vector4(of.x, of.y, of.z, whole),
    )
  }

  /** The affine transformation that applies the linear part and then moves by `by`. */
  static fn affine(linear: Matrix3<Scalar>, by: Vector3<Scalar>): Matrix4<Scalar> {
    const nothing = Scalar.zero
    Matrix4(
      Vector4.of(linear.xAxis, nothing),
      Vector4.of(linear.yAxis, nothing),
      Vector4.of(linear.zAxis, nothing),
      Vector4.of(by, Scalar.one),
    )
  }

  /** A point, moved by the transformation: the translation is applied. */
  fn transformedPoint(point: Vector3<Scalar>): Vector3<Scalar> {
    const moved = applied to: Vector4.of(point, Scalar.one)
    moved.toVector3()
  }
}

/**
 * The twelve two-by-two determinants that a four-by-four determinant and its adjugate are both made of: six from the
 * first two columns and six from the last two. Each name says which two rows its block is taken from, so `firstXY` is
 * rows `x` and `y` of the first two columns and `lastZW` is rows `z` and `w` of the last two.
 *
 * They are one value because the determinant is the first thing an inverse asks for, and asking the matrix separately
 * would do half of the work twice.
 */
type Minors<Scalar: Numeric> {
  /** Rows `x` and `y` of the first two columns. */
  firstXY: Scalar
  /** Rows `x` and `z` of the first two columns. */
  firstXZ: Scalar
  /** Rows `x` and `w` of the first two columns. */
  firstXW: Scalar
  /** Rows `y` and `z` of the first two columns. */
  firstYZ: Scalar
  /** Rows `y` and `w` of the first two columns. */
  firstYW: Scalar
  /** Rows `z` and `w` of the first two columns. */
  firstZW: Scalar
  /** Rows `x` and `y` of the last two columns. */
  lastXY: Scalar
  /** Rows `x` and `z` of the last two columns. */
  lastXZ: Scalar
  /** Rows `x` and `w` of the last two columns. */
  lastXW: Scalar
  /** Rows `y` and `z` of the last two columns. */
  lastYZ: Scalar
  /** Rows `y` and `w` of the last two columns. */
  lastYW: Scalar
  /** Rows `z` and `w` of the last two columns. */
  lastZW: Scalar

  /** The determinant of the whole matrix: each block of the first two columns against its complement in the last two. */
  fn determinant(): Scalar {
    firstXY * lastZW - firstXZ * lastYW + firstXW * lastYZ + firstYZ * lastXW - firstYW * lastXZ + firstZW * lastXY
  }
}

/** The twelve blocks of one matrix, in the order the type declares them. */
fn minorsOf<Scalar: Numeric>(matrix: Matrix4<Scalar>): Minors<Scalar> {
  const first = matrix.xAxis
  const second = matrix.yAxis
  const third = matrix.zAxis
  const fourth = matrix.wAxis
  Minors(
    first.x * second.y - second.x * first.y,
    first.x * second.z - second.x * first.z,
    first.x * second.w - second.x * first.w,
    first.y * second.z - second.y * first.z,
    first.y * second.w - second.y * first.w,
    first.z * second.w - second.z * first.w,
    third.x * fourth.y - fourth.x * third.y,
    third.x * fourth.z - fourth.x * third.z,
    third.x * fourth.w - fourth.x * third.w,
    third.y * fourth.z - fourth.y * third.z,
    third.y * fourth.w - fourth.y * third.w,
    third.z * fourth.w - fourth.z * third.w,
  )
}

/** Every cell turned around. */
extend<Scalar: Signed> Matrix4<Scalar> with Negate {
  /** Every cell with its sign flipped. */
  fn negate(): Matrix4<Scalar> {
    Matrix4 xAxis.negate(), yAxis.negate(), zAxis.negate(), wAxis.negate()
  }
}

/** What a division buys: the inverse of an affine transformation, and the general one. */
extend<Scalar: Real> Matrix4<Scalar> {
  /**
   * The transformation that undoes this one, read as an affine transformation: the linear part is inverted and the
   * translation is carried back through it. `None` where the linear part has no inverse.
   *
   * It answers nothing about the bottom row, which an affine transformation has as `(0, 0, 0, 1)` by construction.
   */
  fn inverseAffine(): Matrix4<Scalar>? {
    const linear = linearPart()
    match linear.inverse() {
      Some(undone) => {
        const back = undone.applied to: translationPart().negate()
        Matrix4.affine undone, by: back
      }
      None => None
    }
  }

  /**
   * The transformation that undoes this one, for a matrix of **any** shape: the adjugate - the transpose of the
   * sixteen cofactors - divided by the determinant. `None` where the determinant is zero, which is exactly where the
   * transformation flattens space and nothing can undo it.
   *
   * [Matrix4.inverseAffine] is the short way for the matrices a scene graph is made of, and the two answer the same
   * transformation for one whose bottom row is `(0, 0, 0, 1)`. Reach for this one where the bottom row is not that -
   * which in practice means a projection.
   *
   *     const move = Matrix4.translation of: Vector3(1.0, 2.0, 3.0)
   *     print move.inverse()?.translationPart()
   */
  fn inverse(): Matrix4<Scalar>? {
    const blocks = minorsOf self
    const scale = blocks.determinant()
    if scale == Scalar.zero {
      return None
    }
    const first = xAxis
    const second = yAxis
    const third = zAxis
    const fourth = wAxis
    const undoneX = Vector4(
      second.y * blocks.lastZW - second.z * blocks.lastYW + second.w * blocks.lastYZ,
      first.z * blocks.lastYW - first.y * blocks.lastZW - first.w * blocks.lastYZ,
      fourth.y * blocks.firstZW - fourth.z * blocks.firstYW + fourth.w * blocks.firstYZ,
      third.z * blocks.firstYW - third.y * blocks.firstZW - third.w * blocks.firstYZ,
    )
    const undoneY = Vector4(
      second.z * blocks.lastXW - second.x * blocks.lastZW - second.w * blocks.lastXZ,
      first.x * blocks.lastZW - first.z * blocks.lastXW + first.w * blocks.lastXZ,
      fourth.z * blocks.firstXW - fourth.x * blocks.firstZW - fourth.w * blocks.firstXZ,
      third.x * blocks.firstZW - third.z * blocks.firstXW + third.w * blocks.firstXZ,
    )
    const undoneZ = Vector4(
      second.x * blocks.lastYW - second.y * blocks.lastXW + second.w * blocks.lastXY,
      first.y * blocks.lastXW - first.x * blocks.lastYW - first.w * blocks.lastXY,
      fourth.x * blocks.firstYW - fourth.y * blocks.firstXW + fourth.w * blocks.firstXY,
      third.y * blocks.firstXW - third.x * blocks.firstYW - third.w * blocks.firstXY,
    )
    const undoneW = Vector4(
      second.y * blocks.lastXZ - second.x * blocks.lastYZ - second.z * blocks.lastXY,
      first.x * blocks.lastYZ - first.y * blocks.lastXZ + first.z * blocks.lastXY,
      fourth.y * blocks.firstXZ - fourth.x * blocks.firstYZ - fourth.z * blocks.firstXY,
      third.x * blocks.firstYZ - third.y * blocks.firstXZ + third.z * blocks.firstXY,
    )
    Some Matrix4(undoneX.divide(scale), undoneY.divide(scale), undoneZ.divide(scale), undoneW.divide(scale))
  }

  /** Whether every cell is within `tolerance` of the other matrix's. */
  fn isCloseTo(other: Matrix4<Scalar>, tolerance: Scalar): Bool {
    xAxis.isCloseTo(other.xAxis, tolerance: tolerance)
      && yAxis.isCloseTo(other.yAxis, tolerance: tolerance)
      && zAxis.isCloseTo(other.zAxis, tolerance: tolerance)
      && wAxis.isCloseTo(other.wAxis, tolerance: tolerance)
  }
}

/** A whole power: the transformation applied that many times over. */
extend<Scalar: Numeric> Matrix4<Scalar> with Power<Int64> {
  /**
   * `turn ** 3` is `turn * turn * turn`, by squaring, and `matrix ** 0` is the identity.
   *
   * # Panics
   *
   * On a negative exponent, which is a power of the inverse: a matrix has one only over a `Real` scalar and only where
   * its determinant is not zero, so the caller asks for `inverse()` and raises that.
   */
  fn power(exponent: Int64): Matrix4<Scalar> {
    if exponent < 0 {
      panic "a matrix to the power of {exponent} is a power of its inverse: raise `inverse()` instead"
    }
    var result = Matrix4<Scalar>.identity
    var factor = self
    var left = exponent
    while left > 0 {
      if left % 2 == 1 {
        result = result * factor
      }
      left = left / 2
      if left > 0 {
        factor = factor * factor
      }
    }
    result
  }
}
