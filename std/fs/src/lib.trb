/**
 * The file system: `File`, which is both a stream's reading end and its writing end, and `IoError`, what every
 * operation here fails with. The whole-file helpers (`readText`, `writeText`) are for what fits in memory; `chunks()`,
 * `lines()` and the `Sink` side are for everything else (`docs/STREAMS.md`).
 */

use Source, Sink, Bytes, Utf8Error from "std/stream"
use lines as streamLines from "std/stream"

/** What went wrong with which path. */
public type IoError with Show, Error {
  /** The path the operation was about. */
  path: String
  /** What went wrong, in the operating system's or the decoder's own words. */
  message: String

  /** `{path}: {message}`. */
  fn show(self): String {
    "{path}: {message}"
  }
}

/** Bytes off a disk are not always UTF-8, and a `String` always is - so decoding is one of the ways reading fails. */
extend IoError with From<Utf8Error> {
  fn from(value: Utf8Error): IoError {
    IoError "", value.show()
  }
}

/**
 * A file that is open. It has an identity (the handle of the operating system), so it is a `shared type`:
 *
 *     const text = using File.open(path)? { file => file.readAll() }
 *
 *     var file = File.create(path)?
 *     using file { target =>
 *       target.fill(response.body.mapFailure(IoError.from)).await()
 *     }
 *
 * An open file is both ends of a stream: `chunks()`/`lines()` read it, and the file *is* a `Sink<Bytes, IoError>` for
 * writing, so everything that writes into a sink writes into a file. Most code needs neither: the functions without
 * `self` read and write whole files.
 *
 * # Related
 *
 * - [Source] - what `chunks()` and `lines()` answer.
 * - [Sink] - the trait a `File` implements for writing.
 */
public native shared type File with Close, Sink<Bytes, IoError> {
  /** Opens an existing file for reading. */
  native fn open(path: String): Result<File, IoError>

  /** Creates the file, or empties it if it is there. The counterpart of `open`, for the writing side. */
  native fn create(path: String): Result<File, IoError>

  /** The rest of the file as text, from wherever the cursor is. Fails if the bytes are not UTF-8. */
  native fn readAll(var self): Result<String, IoError>

  /** Releases the operating system handle. Synchronous and cannot fail, as every `Close` promises. */
  native fn close(var self)

  /**
   * The file as a stream of byte chunks of at most `size`. The one native of the reading side: everything above it
   * (`lines`, framing, decoding) is a `Stage` and therefore ordinary TorbScript.
   */
  native fn chunks(var self, size: Int = 65536): Source<Bytes, IoError>

  /**
   * The lines of the file, as a stream. A read failure ends the stream and the reader sees it, because it is in the
   * type - it can never be swallowed halfway through.
   */
  fn lines(var self): Source<String, IoError> {
    chunks().through(streamLines()).checked()
  }

  /** The writing end. A `File` is a `Sink<Bytes, IoError>`, so `addText`, `addLine` and `fill` are all there. */
  native fn add(var self, item: Bytes): Task<Result<Void, IoError>>

  /** Flushes to the operating system and reports what a buffered write could only report now. */
  native fn finish(var self): Task<Result<Void, IoError>>

  /** A `String` is always valid UTF-8, so bytes that are not are an `IoError` and never a replacement character. */
  native fn readText(path: String): Result<String, IoError>

  /** Creates or empties `path` and writes `text` into it in one call - the writing counterpart of `readText`. */
  native fn writeText(path: String, text: String): Result<Void, IoError>

  /**
   * Creates `path` and writes everything `source` delivers into it, of any size and without holding it in memory:
   * `File.write(path, response.body.mapFailure(IoError.from)).await()?`
   */
  fn write(path: String, var source: Source<Bytes, IoError>): Task<Result<Void, IoError>> {
    var target = File.create(path)?
    const outcome = target.fill(source).await()
    target.close()
    outcome
  }

  /**
   * The path as an absolute path, with `.` and `..` resolved against the working directory. The file does not have
   * to exist: this is text arithmetic, not a lookup, so it does not follow links either.
   */
  native fn absolutePath(path: String): Result<String, IoError>

  /** Whether something exists at `path`, file or directory. */
  native fn exists(path: String): Bool

  /** Whether `path` is a directory rather than a file. */
  native fn isDirectory(path: String): Bool

  /**
   * Creates the directory and every directory above it that is missing, and does nothing where it is already there -
   * so a caller that only wants a place to write does not have to ask first.
   */
  native fn createDirectory(path: String): Result<Void, IoError>

  /** The names of the entries of a directory, sorted. */
  native fn list(path: String): Result<List<String>, IoError>
}
