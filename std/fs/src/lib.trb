/**
 * The file system: `File`, which is both a stream's reading end and its writing end, and `IoError`, what every
 * operation here fails with. The whole-file helpers (`readText`, `writeText`) are for what fits in memory; `chunks()`,
 * `lines()` and the `Sink` side are for everything else (`docs/design/STREAMS.md`).
 */

use Source, Sink, Bytes, Utf8Error from "std/stream"
use ArrayList from "std/collections"
use lines as streamLines from "std/stream"

/** What went wrong with which path. */
public type IoError with Show, Error {
  /** The path the operation was about. */
  path: String
  /** What went wrong, in the operating system's or the decoder's own words. */
  message: String

  /** `{path}: {message}`. */
  fn show(): String {
    "{path}: {message}"
  }
}

/** Bytes off a disk are not always UTF-8, and a `String` always is - so decoding is one of the ways reading fails. */
extend IoError with From<Utf8Error> {
  static fn from(value: Utf8Error): IoError {
    IoError "", value.show()
  }
}

/**
 * A file that is open. It has an identity (the handle of the operating system), so it is a `shared type`:
 *
 *     fn firstText(path: String): Result<String, IoError> {
 *       using file = File.open(path)?
 *       file.readAll()
 *     }
 *
 * The file closes when the last reference to it goes away - here at the end of `firstText`, because `using` keeps
 * the name inside its block. Nothing calls `close()` by hand.
 *
 * An open file is both ends of a stream: `chunks()`/`lines()` read it, and the file *is* a `Sink<Bytes, IoError>` for
 * writing, so everything that writes into a sink writes into a file. Most code needs neither: the functions without
 * `self` read and write whole files.
 *
 * # Related
 *
 * - [Source] - what `chunks()` and `lines()` answer.
 * - [Sink] - the trait a `File` implements for writing.
 */
public native shared type File with Close, Sink<Bytes, IoError> {
  /** Opens an existing file for reading. */
  native static fn open(path: String): Result<File, IoError>

  /** Creates the file, or empties it if it is there. The counterpart of `open`, for the writing side. */
  native static fn create(path: String): Result<File, IoError>

  /** The rest of the file as text, from wherever the cursor is. Fails if the bytes are not UTF-8. */
  native var fn readAll(): Result<String, IoError>

  /** Releases the operating system handle. Synchronous and cannot fail, as every `Close` promises. */
  native var fn close()

  /**
   * The file as a stream of byte chunks of at most `size`, each read on a thread of the blocking pool so the worker goes
   * on meanwhile. Everything above it (`lines`, framing, decoding) is a `Stage` and therefore ordinary TorbScript.
   */
  var fn chunks(size: Int = 65536): Source<Bytes, IoError> {
    FileChunks.of self, size
  }

  /**
   * The lines of the file, as a stream. A read failure ends the stream and the reader sees it, because it is in the
   * type - it can never be swallowed halfway through.
   */
  var fn lines(): Source<String, IoError> {
    chunks().through(streamLines()).checked()
  }

  /** The writing end. A `File` is a `Sink<Bytes, IoError>`, so `addText`, `addLine` and `fill` are all there. */
  var fn add(item: Bytes): Task<Result<Void, IoError>> {
    const buffer: ArrayList<UInt8> = ArrayList.from item
    var from = 0
    while from < buffer.length() {
      const written = fileWrite(self, buffer, from).await()
      if written < 0 {
        return Fail IoError(filePath(self), fileFailureText(written))
      }
      from = from + written
    }
    Ok void
  }

  /** Flushes to the operating system and reports what a buffered write could only report now. */
  var fn end(): Task<Result<Void, IoError>> {
    const flushed = fileFlush(self).await()
    if flushed < 0 {
      return Fail IoError(filePath(self), fileFailureText(flushed))
    }
    Ok void
  }

  /** A `String` is always valid UTF-8, so bytes that are not are an `IoError` and never a replacement character. */
  native static fn readText(path: String): Result<String, IoError>

  /** Creates or empties `path` and writes `text` into it in one call - the writing counterpart of `readText`. */
  native static fn writeText(path: String, text: String): Result<Void, IoError>

  /**
   * Creates `path` and writes everything `source` delivers into it, of any size and without holding it in memory:
   * `File.write(path, response.body.mapFailure(IoError.from)).await()?`
   */
  static fn write(path: String, var source: Source<Bytes, IoError>): Task<Result<Void, IoError>> {
    var target = File.create(path)?
    target.fill(source).await()
  }

  /**
   * The path as an absolute path, with `.` and `..` resolved against the working directory. The file does not have
   * to exist: this is text arithmetic, not a lookup, so it does not follow links either.
   */
  native static fn absolutePath(path: String): Result<String, IoError>

  /** Whether something exists at `path`, file or directory. */
  native static fn exists(path: String): Bool

  /** Whether `path` is a directory rather than a file. */
  native static fn isDirectory(path: String): Bool

  /**
   * Creates the directory and every directory above it that is missing, and does nothing where it is already there -
   * so a caller that only wants a place to write does not have to ask first.
   */
  native static fn createDirectory(path: String): Result<Void, IoError>

  /**
   * The names of the entries of a directory, sorted.
   *
   * # Errors
   *
   * - The directory cannot be read, or the name of one of its entries is not valid UTF-8. A `String` is always UTF-8,
   *   so such an entry has no name to answer: the message shows its bytes, and no replacement character is invented.
   */
  native static fn list(path: String): Result<List<String>, IoError>
}

/** The reading direction of a [File]: a `Source<Bytes, IoError>` of chunks of at most `size` bytes. */
shared type FileChunks with Source<Bytes, IoError> {
  private file: File
  private size: Int

  /** The chunks of `file`: what [File.chunks] answers. */
  static fn of(file: File, size: Int): FileChunks {
    FileChunks file, size
  }

  var fn next(): Task<Result<Bytes?, IoError>> {
    const count = fileRead(file, size).await()
    if count < 0 {
      return Fail IoError(filePath(file), fileFailureText(count))
    }
    if count == 0 {
      return Ok None
    }
    var bytes: ArrayList<UInt8> = ArrayList.withCapacity count
    fileTakeRead file, bytes
    Ok Some(bytes)
  }

  /** Nothing of its own: the file closes once its last holder is gone. */
  var fn close() {}
}

// --- the natives of runtime/stream.c ---------------------------------------------------------------------------------

/** At most `maximum` bytes of the file on a thread of the blocking pool: how many (0 at the end), or a failure. */
native fn fileRead(file: File, maximum: Int): Task<Int>

/** What the last [fileRead] got, appended to `into`. */
native fn fileTakeRead(file: File, var into: ArrayList<UInt8>)

/** The bytes of `bytes` from `from` on, written on a thread of the blocking pool: how many, or a failure. */
native fn fileWrite(file: File, bytes: ArrayList<UInt8>, from: Int): Task<Int>

/** Flushes the file on a thread of the blocking pool: 0, or a failure. */
native fn fileFlush(file: File): Task<Int>

/** The path the file was opened or created with, for the `IoError` of a stream. */
native fn filePath(file: File): String

/** A failure a native answered, in the operating system's own words. */
native fn fileFailureText(failure: Int): String
