/**
 * Wall-clock time: points in time (`Instant`) and the spans between them (`Duration`).
 */

/** A point in time. Only differences between two `Instant`s are meaningful, never the value on its own. */
public native type Instant with Compare, Subtract<Instant, Duration> {}

/** The span between two `Instant`s, or a length of time asked for on its own (`2.seconds()`). */
public native type Duration with Compare, Show {
  /** As a fractional number of seconds: `(Clock.now() - start).seconds()`. */
  native fn seconds(self): Float64
}

extend Int64 {
  /** A `Duration` of this many seconds: `2.seconds()`. Mainly for sandbox and task limits. */
  native fn seconds(self): Duration
}

/** The wall clock. Needs the `std/time` capability inside a sandboxed script. */
public native type Clock {
  native fn now(): Instant
}

/** Suspends the running task for this many seconds. Needs `.await()`, like every `Task`. */
public native fn sleep(seconds: Float64): Task<Void>
