/**
 * Wall-clock time: points in time (`Instant`) and the spans between them (`Duration`).
 *
 * Both are a count of nanoseconds in an `Int64` and nothing else, so they cost what the number costs: comparing and
 * subtracting them is integer arithmetic, and only reading the clock goes to the operating system.
 */

/**
 * A point in time. Only differences between two `Instant`s are meaningful, never the value on its own: it is a
 * monotonic reading whose origin is chosen by the process.
 *
 * # Examples
 *
 *     const start = Clock.now()
 *     const later = start + 2.seconds()
 *     print(later - start)
 *
 * # Related
 *
 * - [Clock.now] - where an `Instant` comes from.
 * - [Duration] - what the difference of two of them is.
 */
public type Instant with Compare, Subtract<Instant, Duration>, Add<Duration, Instant> {
  /** In nanoseconds, from the origin the process chooses. */
  private value: Int64

  /** Which of the two readings came first. */
  fn compare(other: Instant): Ordering {
    value.compare other.value
  }

  /** The span from `other` to this reading: negative where `other` is the later one. */
  fn subtract(other: Instant): Duration {
    Duration(value - other.value)
  }

  /** The point in time `other` after this one: a deadline, `Clock.now() + 2.seconds()`. */
  fn add(other: Duration): Instant {
    Instant(value + other.nanoseconds())
  }
}

/**
 * The span between two `Instant`s, or a length of time asked for on its own (`2.seconds()`). It is signed: the
 * difference of two readings taken the wrong way round is negative.
 *
 * # Examples
 *
 *     const wait = 2.seconds() + 500.milliseconds()
 *     print wait
 *     print(wait > 2.seconds())
 *
 * # Related
 *
 * - [Int64.seconds] - the short way to write one.
 * - [Instant] - whose difference it is.
 */
public type Duration with Compare, Show, Add, Subtract {
  /** In nanoseconds. */
  private value: Int64

  /** As a fractional number of seconds: `(Clock.now() - start).seconds()`. */
  fn seconds(): Float64 {
    Float64.from(value) / 1_000_000_000.0
  }

  /** As a whole number of nanoseconds, which is exactly what it holds. */
  fn nanoseconds(): Int64 {
    value
  }

  /** Which of the two spans is the shorter one. */
  fn compare(other: Duration): Ordering {
    value.compare other.value
  }

  /** The two spans one after the other. Panics where the sum does not fit, as every `Int64` addition does. */
  fn add(other: Duration): Duration {
    Duration(value + other.value)
  }

  /** How much longer this span is than `other`: negative where it is shorter. */
  fn subtract(other: Duration): Duration {
    Duration(value - other.value)
  }

  /** The seconds with an `s` behind them: `2.5s`. */
  fn show(): String {
    "{seconds()}s"
  }
}

/**
 * A point on the wall clock: nanoseconds since 1970-01-01 00:00:00 UTC. It means something on its own - when a file
 * was last written - where an [Instant] only means something against another reading; and it can jump, because the
 * clock of a machine is set.
 *
 * # Examples
 *
 *     const written = Timestamp.fromUnixNanoseconds 1_790_000_000_500_000_000
 *     print written
 *     print(written + 2.seconds())
 *     // prints 2026-09-21T14:13:20.5Z
 *     // prints 2026-09-21T14:13:22.5Z
 *
 * # Related
 *
 * - [Instant] - the monotonic reading, for measuring.
 * - [Duration] - what the difference of two of them is.
 */
public type Timestamp with Compare, Equals, Hash, Show, Subtract<Timestamp, Duration>, Add<Duration, Timestamp> {
  /** Nanoseconds since 1970-01-01 00:00:00 UTC, negative before it. */
  private value: Int64

  /** The point in time `nanoseconds` after 1970-01-01 00:00:00 UTC - before it, where the number is negative. */
  static fn fromUnixNanoseconds(nanoseconds: Int64): Self {
    Self nanoseconds
  }

  /** Nanoseconds since 1970-01-01 00:00:00 UTC, which is exactly what it holds. */
  fn unixNanoseconds(): Int64 {
    value
  }

  /** Which of the two points in time came first. */
  fn compare(other: Self): Ordering {
    value.compare other.value
  }

  /** The span from `other` to this one: negative where `other` is the later one. */
  fn subtract(other: Self): Duration {
    Duration(value - other.value)
  }

  /** The point in time `other` after this one. */
  fn add(other: Duration): Self {
    Self(value + other.nanoseconds())
  }

  /**
   * RFC 3339 in UTC: `2026-09-27T08:15:00Z`, with as many digits of the second's fraction as it has and none where it
   * has none (`08:15:00.25Z`).
   */
  fn show(): String {
    const second: Int64 = 1_000_000_000
    const seconds = floorDivided value, second
    const fraction = value - seconds * second
    const days = floorDivided seconds, 86_400
    const ofDay = seconds - days * 86_400
    const (year, month, day) = civilDate days
    const hour = ofDay / 3_600
    const minute = (ofDay % 3_600) / 60
    const rest = ofDay % 60
    const date = "{padded(year, 4)}-{padded(month, 2)}-{padded(day, 2)}"
    const time = "{padded(hour, 2)}:{padded(minute, 2)}:{padded(rest, 2)}"
    if fraction == 0 {
      return "{date}T{time}Z"
    }
    var digits = padded fraction, 9
    while digits.endsWith("0") {
      digits = digits.sliceBytes(0, digits.byteLength() - 1)
    }
    "{date}T{time}.{digits}Z"
  }
}

/** `value / divisor` rounded towards negative infinity, where `/` rounds towards zero. */
fn floorDivided(value: Int64, divisor: Int64): Int64 {
  const quotient = value / divisor
  if value % divisor != 0 && (value < 0) != (divisor < 0) {
    quotient - 1
  } else {
    quotient
  }
}

/**
 * The year, month and day of the day `days` after 1970-01-01 in the proleptic Gregorian calendar: Howard Hinnant's
 * `civil_from_days`, which counts in eras of 400 years from 0000-03-01 so that the leap day is the last day of a year.
 */
fn civilDate(days: Int64): (Int64, Int64, Int64) {
  const shifted = days + 719_468
  const era = floorDivided shifted, 146_097
  const ofEra = shifted - era * 146_097
  const yearOfEra = (ofEra - ofEra / 1_460 + ofEra / 36_524 - ofEra / 146_096) / 365
  const ofYear = ofEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
  const shiftedMonth = (5 * ofYear + 2) / 153
  const day = ofYear - (153 * shiftedMonth + 2) / 5 + 1
  const month = if shiftedMonth < 10 { shiftedMonth + 3 } else { shiftedMonth - 9 }
  const year = yearOfEra + era * 400 + (if month <= 2 { 1 } else { 0 })
  (year, month, day)
}

/** The number with zeros in front, to at least `width` digits; a negative year keeps its sign in front of them. */
fn padded(value: Int64, width: Int): String {
  const digits = if value < 0 { "{0 - value}" } else { "{value}" }
  var zeros = ""
  var count = digits.byteLength()
  while count < width {
    zeros = zeros + "0"
    count = count + 1
  }
  if value < 0 {
    "-{zeros}{digits}"
  } else {
    "{zeros}{digits}"
  }
}

/** The short way to write a [Duration]: `2.seconds()` instead of a constructor. */
extend Int64 {
  /**
   * A `Duration` of this many seconds: `2.seconds()`. Mainly for sandbox and task limits. More than about 292 years
   * either way do not fit into the nanoseconds, and the `Int64` multiplication under it panics then.
   */
  fn seconds(): Duration {
    Duration(self * 1_000_000_000)
  }

  /**
   * A `Duration` of this many milliseconds: `250.milliseconds()`. The `Int64` multiplication under it panics where
   * they do not fit into the nanoseconds.
   */
  fn milliseconds(): Duration {
    Duration(self * 1_000_000)
  }
}

/** The wall clock. Needs the `std/time` capability inside a sandboxed script. */
public native type Clock {
  /** The current point in time. */
  static fn now(): Instant {
    Instant monotonicNanoseconds()
  }

  /**
   * Monotonic milliseconds, counted from the first reading. Only differences between two readings are meaningful, as
   * for an `Instant` - this is the form a tool that measures its own work wants (`torb check --timings`), where a
   * reading in milliseconds is the unit it prints.
   */
  native static fn milliseconds(): Int64
}

/**
 * The monotonic clock of the operating system in nanoseconds, from an origin the process chooses. The one reading
 * [Clock.now] cannot write in TorbScript.
 */
native fn monotonicNanoseconds(): Int64

/** Suspends the running task for this many seconds. Needs `.await()`, like every `Task`. */
public native fn sleep(seconds: Float64): Task<Void>
