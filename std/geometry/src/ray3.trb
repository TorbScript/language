/**
 * [Ray3], the half-line in space, and the hit tests written against it: a pick, a line of sight, a shot, a shadow.
 */

use Real from "std/number"
use Vector3 from "std/linear/vector3"
use Box from "./box"
use Sphere from "./sphere"
use Plane from "./plane"
use Triangle3 from "./triangle3"

/**
 * A half-line in space: where it starts and which way it points.
 *
 * As in the plane, every hit test answers **how far along the ray** the hit is, measured in the length of `direction`,
 * and not the point: that is what a caller compares to find the nearest of several hits. [Ray3.at] turns a distance back
 * into a point.
 *
 * # Examples
 *
 *     const shot = Ray3 Vector3(0.0, 0.0, 0.0), Vector3(0.0, 0.0, 1.0)
 *     print shot.hits(Sphere(Vector3(0.0, 0.0, 5.0), 1.0))
 *
 * # Pitfalls
 *
 * - A `direction` of zero has no hits at all, and every test answers `None` for it rather than panicking.
 * - A ray that starts inside a shape answers `0`.
 *
 * # Related
 *
 * - `Ray2` - the same in the plane.
 * - [Triangle3.weightsOf] - what [Ray3.hitsTriangle] uses to tell the plane from the face.
 */
public type Ray3<Scalar: Real = Float> {
  /** Where the ray starts. */
  origin: Vector3<Scalar>
  /** Which way it points. The hit distances are measured in this vector's length. */
  direction: Vector3<Scalar>

  /** The ray from one point towards another, with a direction of length one. */
  static fn towards(from: Vector3<Scalar>, to: Vector3<Scalar>): Self {
    Ray3(from, to.subtract(from).normalized())
  }

  /** The point that far along the ray. A negative distance reads backwards, behind the origin. */
  fn at(distance: Scalar): Vector3<Scalar> {
    origin.add direction.multiply(distance)
  }

  /** How far along the ray the ball is first met, or `None` where the ray misses it. Inside answers zero. */
  fn hits(sphere: Sphere<Scalar>): Scalar? {
    const along: Scalar = direction.lengthSquared()
    if along == Scalar.zero {
      return None
    }
    const nothing = Scalar.zero
    const gap = origin.subtract sphere.center
    const half = direction.dot gap
    const outside = gap.lengthSquared() - sphere.radius * sphere.radius
    const under = half * half - along * outside
    if under < nothing {
      return None
    }
    const root = under.squareRoot()
    const near = (-half - root) / along
    if near >= nothing {
      return near
    }
    // The near crossing is behind the origin, so the origin is either inside the shape or past it altogether
    const far = (-half + root) / along
    if far >= nothing { nothing } else { None }
  }

  /** How far along the ray the plane is crossed, or `None` where the ray runs parallel to it or points away from it. */
  fn hitsPlane(plane: Plane<Scalar>): Scalar? {
    const towards: Scalar = plane.normal.dot direction
    if towards == Scalar.zero {
      return None
    }
    const nothing = Scalar.zero
    const found = (plane.distance - plane.normal.dot(origin)) / towards
    if found >= nothing { found } else { None }
  }

  /** How far along the ray the box is first met, or `None` where the ray misses it. This is the slab test in space. */
  fn hitsBox(box: Box<Scalar>): Scalar? {
    const reach: Scalar = direction.lengthSquared()
    if box.isEmpty() || reach == Scalar.zero {
      return None
    }
    const nothing = Scalar.zero
    const low = box.minimum()
    const high = box.maximum()
    var entering = nothing
    var leaving = nothing
    var bounded = false
    var axis = 0
    loop {
      if axis >= 3 {
        break
      }
      const start = componentOf origin, axis
      const step = componentOf direction, axis
      const near = componentOf low, axis
      const far = componentOf high, axis
      if step == nothing {
        // The ray never moves on this axis, so it is either inside the slab for its whole length or never in it
        if start < near || start >= far {
          return None
        }
      } else {
        const first = (near - start) / step
        const second = (far - start) / step
        if bounded {
          entering = entering.max first.min(second)
          leaving = leaving.min first.max(second)
        } else {
          entering = first.min second
          leaving = first.max second
          bounded = true
        }
      }
      axis = axis + 1
    }
    if !bounded {
      return None
    }
    const first = entering.max nothing
    if first > leaving { None } else { first }
  }

  /**
   * How far along the ray the triangle is met, or `None` where the ray misses the face.
   *
   * It crosses the triangle's plane first and then asks the triangle whether that point is inside it, which is the same
   * two steps every ray-triangle test takes.
   */
  fn hitsTriangle(triangle: Triangle3<Scalar>): Scalar? {
    match hitsPlane(triangle.plane()) {
      Some(found) => {
        if triangle.contains(at(found)) { found } else { None }
      }
      None => None
    }
  }
}

/** The component of a vector at an axis index: `0` is `x`, `1` is `y`, and anything else is `z`. */
fn componentOf<Scalar: Real>(value: Vector3<Scalar>, axis: Int): Scalar {
  if axis == 0 {
    return value.x
  }
  if axis == 1 { value.y } else { value.z }
}
