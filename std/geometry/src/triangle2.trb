/**
 * [Triangle2], the triangle in the plane: the smallest shape that has an inside, and the one every mesh and every
 * tessellation is made of.
 */

use Numeric, Signed, Real from "std/number"
use Vector2 from "../../linear/src/vector2"
use Rectangle from "./rectangle"
use Segment2 from "./segment2"

/**
 * Three corners in the plane.
 *
 * The winding is not fixed: [Triangle2.signedArea] is positive where the corners run from the first axis towards the
 * second and negative where they run the other way, and every other member works for both.
 *
 * # Examples
 *
 *     const face = Triangle2 Vector2(0, 0), Vector2(4, 0), Vector2(0, 4)
 *     print "{face.contains(Vector2(1, 1))} {face.signedArea()}"
 *
 * # Related
 *
 * - `Polygon` - more than three corners.
 * - `Triangle3` - the same in space, which additionally has a normal.
 */
public type Triangle2<Scalar: Numeric = Float> {
  /** The first corner. */
  first: Vector2<Scalar>
  /** The second corner. */
  second: Vector2<Scalar>
  /** The third corner. */
  third: Vector2<Scalar>

  /** Twice the area, with a sign that says which way the corners run. Zero where the three lie on one line. */
  fn signedArea(): Scalar {
    second.subtract(first).cross(third.subtract(first))
  }

  /** The smallest rectangle that holds the triangle. */
  fn bounds(): Rectangle<Scalar> {
    const low = first.min(second).min(third)
    Rectangle low, first.max(second).max(third).subtract(low)
  }

  /** The three edges, in the order the corners are written. */
  fn edges(): List<Segment2<Scalar>> {
    [Segment2(first, second), Segment2(second, third), Segment2(third, first)]
  }

  /**
   * Whether the point is inside the triangle, an edge included.
   *
   * The test is the sign of the three edge cross products: a point is inside where it is on the same side of all three,
   * whichever way the corners run.
   */
  fn contains(point: Vector2<Scalar>): Bool {
    const nothing = Scalar.zero
    const along = second.subtract(first).cross(point.subtract(first))
    const across = third.subtract(second).cross(point.subtract(second))
    const back = first.subtract(third).cross(point.subtract(third))
    const anyNegative = along < nothing || across < nothing || back < nothing
    const anyPositive = along > nothing || across > nothing || back > nothing
    !anyNegative || !anyPositive
  }

  /** The same triangle moved. */
  fn translated(by: Vector2<Scalar>): Triangle2<Scalar> {
    Triangle2 first.add(by), second.add(by), third.add(by)
  }
}

/** What a sign buys: the area without its sign. */
extend<Scalar: Signed> Triangle2<Scalar> {
  /** Twice the area, without a sign: the whole number a whole-number triangle has instead of a halved one. */
  fn doubledArea(): Scalar {
    signedArea().absolute()
  }
}

/** What a halving and a root buy: the area, the midpoint and the nearest point. */
extend<Scalar: Real> Triangle2<Scalar> {
  /** How much of the plane the triangle covers. */
  fn area(): Scalar {
    signedArea().absolute().halved()
  }

  /** The midpoint of the three corners, which is where the triangle balances. */
  fn center(): Vector2<Scalar> {
    const three = first.x.unit() + first.x.unit() + first.x.unit()
    first.add(second).add(third).divide(three)
  }

  /** The point of the triangle that is nearest to the one given. */
  fn closestPoint(to: Vector2<Scalar>): Vector2<Scalar> {
    if contains(to) {
      return to
    }
    var nearest = Segment2(first, second).closestPoint(to: to)
    var best: Scalar = nearest.distanceSquaredTo to
    for edge in [Segment2(second, third), Segment2(third, first)] {
      const candidate = edge.closestPoint to: to
      const gap: Scalar = candidate.distanceSquaredTo to
      if gap < best {
        nearest = candidate
        best = gap
      }
    }
    nearest
  }

  /** The distance from the point to the nearest point of the triangle. Zero where it is inside. */
  fn distanceTo(point: Vector2<Scalar>): Scalar {
    point.distanceTo closestPoint(to: point)
  }
}
