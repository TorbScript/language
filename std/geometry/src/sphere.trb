/**
 * [Sphere], the ball in space: the bounding volume whose overlap test is one subtraction, one dot product and one
 * comparison, and which a rotation does not change at all.
 */

use Real from "std/number"
use zeroOf from "./scalar"
use Vector3 from "../../linear/src/vector3"
use Box from "./box"

/**
 * A ball: a midpoint and a radius. The surface is inside it, exactly as a `Circle`'s boundary is.
 *
 * # Examples
 *
 *     const ball = Sphere Vector3(0.0, 0.0, 0.0), 1.0
 *     print "{ball.contains(Vector3(1.0, 0.0, 0.0))} {ball.contains(Vector3(1.1, 0.0, 0.0))}"
 *
 * # Related
 *
 * - `Circle` - the same in the plane.
 * - [Box] - what [Sphere.bounds] answers.
 */
public type Sphere<Scalar: Real = Float> {
  /** The midpoint. */
  center: Vector3<Scalar>
  /** How far the ball reaches from its midpoint. */
  radius: Scalar

  /**
   * The ball through the corners of the box.
   *
   * The radius is a square root, so a scalar of limited resolution rounds it down and a corner can fall one step
   * outside. A broad phase that must not lose a corner grows the answer by one step.
   */
  static fn around(box: Box<Scalar>): Sphere<Scalar> {
    const middle = box.center()
    Sphere middle, middle.distanceTo(box.maximum())
  }

  /** Whether the radius is negative, in which case the ball describes no points. */
  fn isEmpty(): Bool {
    radius < zeroOf(radius)
  }

  /** Whether the point is in the ball, surface included. */
  fn contains(point: Vector3<Scalar>): Bool {
    center.distanceSquaredTo(point) <= radius * radius
  }

  /** Whether the other ball is inside this one, surface included. */
  fn encloses(other: Sphere<Scalar>): Bool {
    if other.isEmpty() {
      return true
    }
    const gap = radius - other.radius
    gap >= zeroOf(gap) && center.distanceSquaredTo(other.center) <= gap * gap
  }

  /** Whether the two balls share a point, touching included. */
  fn intersects(other: Sphere<Scalar>): Bool {
    const reach = radius + other.radius
    center.distanceSquaredTo(other.center) <= reach * reach
  }

  /** Whether the ball shares a point with the box, which is a test against the nearest point of the box. */
  fn intersectsBox(other: Box<Scalar>): Bool {
    if other.isEmpty() {
      return false
    }
    other.distanceSquaredTo(center) <= radius * radius
  }

  /** The point of the ball that is nearest to the one given, which is the point itself where it is inside. */
  fn closestPoint(to: Vector3<Scalar>): Vector3<Scalar> {
    const step = to.subtract center
    if step.lengthSquared() <= radius * radius {
      return to
    }
    center.add step.withLength(radius)
  }

  /** The distance from the point to the nearest point of the ball. Zero where it is inside. */
  fn distanceTo(point: Vector3<Scalar>): Scalar {
    const gap = center.distanceTo(point) - radius
    gap.max zeroOf(gap)
  }

  /** The same ball moved. */
  fn translated(by: Vector3<Scalar>): Sphere<Scalar> {
    Sphere center.add(by), radius
  }

  /** The same ball with the radius grown by that much. A negative amount shrinks it. */
  fn grown(by: Scalar): Sphere<Scalar> {
    Sphere(center, radius + by)
  }

  /** The smallest box that holds the ball. */
  fn bounds(): Box<Scalar> {
    const reach = Vector3 radius, radius, radius
    Box center.subtract(reach), reach.add(reach)
  }

  /** The smallest ball that holds both. */
  fn combined(other: Sphere<Scalar>): Sphere<Scalar> {
    if isEmpty() {
      return other
    }
    if other.isEmpty() {
      return self
    }
    const apart = center.distanceTo other.center
    if apart + other.radius <= radius {
      return self
    }
    if apart + radius <= other.radius {
      return other
    }
    const reach = (apart + radius + other.radius).halved()
    const factor = (reach - radius) / apart
    Sphere center.interpolated(toward: other.center, by: factor), reach
  }
}
