/**
 * [Ray2], the half-line in the plane, and the hit tests written against it: the shape a pick, a line of sight and a
 * one-step sweep are all asked in terms of.
 */

use Real from "std/number"
use Vector2 from "../../linear/src/vector2"
use Rectangle from "./rectangle"
use Circle from "./circle"
use Segment2 from "./segment2"

/**
 * A half-line: where it starts and which way it points.
 *
 * Every hit test answers **how far along the ray** the hit is, as a distance in the length of `direction`, and not the
 * point itself: a caller that wants the nearest of several hits compares those numbers, and a caller that wants the
 * point asks [Ray2.at] for it. A `direction` of length one therefore makes every answer a distance.
 *
 * # Examples
 *
 *     const look = Ray2 Vector2(0.0, 0.0), Vector2(1.0, 0.0)
 *     print look.hits(Circle(Vector2(5.0, 0.0), 1.0))
 *
 * # Pitfalls
 *
 * - A `direction` of zero has no hits at all, and every test answers `None` for it rather than panicking.
 * - A ray that starts inside a shape answers `0`, not the exit distance. A caller that wants the exit asks the shape.
 *
 * # Related
 *
 * - [Segment2] - the piece of line with two ends.
 * - `Ray3` - the same in space.
 */
public type Ray2<Scalar: Real = Float> {
  /** Where the ray starts. */
  origin: Vector2<Scalar>
  /** Which way it points. The hit distances are measured in this vector's length. */
  direction: Vector2<Scalar>

  /** The ray from one point towards another, with a direction of length one. */
  static fn towards(from: Vector2<Scalar>, to: Vector2<Scalar>): Ray2<Scalar> {
    Ray2(from, to.subtract(from).normalized())
  }

  /** The point that far along the ray. A negative distance reads backwards, behind the origin. */
  fn at(distance: Scalar): Vector2<Scalar> {
    origin.add direction.multiply(distance)
  }

  /**
   * How far along the ray the disc is first met, or `None` where the ray misses it. A ray that starts inside answers
   * zero.
   */
  fn hits(circle: Circle<Scalar>): Scalar? {
    const along: Scalar = direction.lengthSquared()
    if along == Scalar.zero {
      return None
    }
    const nothing = Scalar.zero
    const gap = origin.subtract circle.center
    const half = direction.dot gap
    const outside = gap.lengthSquared() - circle.radius * circle.radius
    const under = half * half - along * outside
    if under < nothing {
      return None
    }
    const root = under.squareRoot()
    const near = (-half - root) / along
    if near >= nothing {
      return Some near
    }
    // The near crossing is behind the origin, so the origin is either inside the shape or past it altogether
    const far = (-half + root) / along
    if far >= nothing { Some nothing } else { None }
  }

  /**
   * How far along the ray the rectangle is first met, or `None` where the ray misses it. This is the slab test: the ray
   * enters the rectangle where the last axis lets it in and leaves where the first axis shuts it out.
   */
  fn hitsRectangle(rectangle: Rectangle<Scalar>): Scalar? {
    const reach: Scalar = direction.lengthSquared()
    if rectangle.isEmpty() || reach == Scalar.zero {
      return None
    }
    const nothing = Scalar.zero
    const low = rectangle.minimum()
    const high = rectangle.maximum()
    var entering = nothing
    var leaving = nothing
    var bounded = false
    var axis = 0
    loop {
      if axis >= 2 {
        break
      }
      const start = if axis == 0 { origin.x } else { origin.y }
      const step = if axis == 0 { direction.x } else { direction.y }
      const near = if axis == 0 { low.x } else { low.y }
      const far = if axis == 0 { high.x } else { high.y }
      if step == nothing {
        // The ray never moves on this axis, so it is either inside the slab for its whole length or never in it
        if start < near || start >= far {
          return None
        }
      } else {
        const first = (near - start) / step
        const second = (far - start) / step
        if bounded {
          entering = entering.max first.min(second)
          leaving = leaving.min first.max(second)
        } else {
          entering = first.min second
          leaving = first.max second
          bounded = true
        }
      }
      axis = axis + 1
    }
    if !bounded {
      return None
    }
    const first = entering.max nothing
    if first > leaving { None } else { Some first }
  }

  /** How far along the ray the segment is met, or `None` where the ray misses it. */
  fn hitsSegment(segment: Segment2<Scalar>): Scalar? {
    const across = segment.step()
    const twist: Scalar = direction.cross across
    if twist == Scalar.zero {
      return None
    }
    const nothing = Scalar.zero
    const whole = Scalar.one
    const gap = segment.from.subtract origin
    const along = gap.cross(across) / twist
    const over = gap.cross(direction) / twist
    if along < nothing || over < nothing || over > whole {
      return None
    }
    Some along
  }
}
