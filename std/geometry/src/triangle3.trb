/**
 * [Triangle3], the triangle in space: one face of a mesh, and what a ray is tested against once the broad phase has
 * narrowed the search.
 */

use Numeric, Signed, Real from "std/number"
use zeroOf from "./scalar"
use Vector3 from "../../linear/src/vector3"
use Box from "./box"
use Plane from "./plane"

/**
 * Three corners in space.
 *
 * The normal follows the right-handed order of the corners: `(second - first) x (third - first)`. A mesh that wants the
 * other side writes its corners the other way round.
 *
 * # Examples
 *
 *     const face = Triangle3 Vector3(0.0, 0.0, 0.0), Vector3(1.0, 0.0, 0.0), Vector3(0.0, 1.0, 0.0)
 *     print "{face.normal()} {face.area()}"
 *
 * # Related
 *
 * - `Triangle2` - the same in the plane.
 * - [Plane] - what [Triangle3.plane] answers, and what a clipping test needs.
 */
public type Triangle3<Scalar: Numeric = Float> {
  /** The first corner. */
  first: Vector3<Scalar>
  /** The second corner. */
  second: Vector3<Scalar>
  /** The third corner. */
  third: Vector3<Scalar>

  /** The step from the first corner to the second. */
  fn firstEdge(): Vector3<Scalar> {
    second.subtract first
  }

  /** The step from the first corner to the third. */
  fn secondEdge(): Vector3<Scalar> {
    third.subtract first
  }

  /**
   * The cross product of the two edges: a vector perpendicular to the triangle whose length is twice the area. Zero
   * where the three corners lie on one line.
   */
  fn doubledAreaVector(): Vector3<Scalar> {
    firstEdge().cross(secondEdge())
  }

  /** The smallest box that holds the triangle. */
  fn bounds(): Box<Scalar> {
    const low = first.min(second).min(third)
    Box low, first.max(second).max(third).subtract(low)
  }

  /** The same triangle moved. */
  fn translated(by: Vector3<Scalar>): Triangle3<Scalar> {
    Triangle3 first.add(by), second.add(by), third.add(by)
  }
}

/** What a root and a halving buy: the normal, the area, the plane and the nearest point. */
extend<Scalar: Real> Triangle3<Scalar> {
  /** The direction perpendicular to the triangle, with length one, in the right-handed order of the corners. */
  fn normal(): Vector3<Scalar> {
    doubledAreaVector().normalized()
  }

  /** How much surface the triangle covers. */
  fn area(): Scalar {
    doubledAreaVector().length().halved()
  }

  /** The plane the triangle lies in. */
  fn plane(): Plane<Scalar> {
    Plane.ofPoints first, second, third
  }

  /** The midpoint of the three corners, which is where the triangle balances. */
  fn center(): Vector3<Scalar> {
    const whole = first.x.unit()
    first.add(second).add(third).divide(whole + whole + whole)
  }

  /**
   * How the point is written as a mix of the three corners: the three weights add up to one, and all three are between
   * zero and one exactly where the point is inside the triangle.
   *
   * Every hit test against a triangle ends here, because this is what says whether a crossing of the plane is a
   * crossing of the *face*.
   */
  fn weightsOf(point: Vector3<Scalar>): (first: Scalar, second: Scalar, third: Scalar) {
    const along = firstEdge()
    const across = secondEdge()
    const gap = point.subtract first
    const alongAlong = along.dot along
    const alongAcross = along.dot across
    const acrossAcross = across.dot across
    const alongGap = along.dot gap
    const acrossGap = across.dot gap
    const twist = alongAlong * acrossAcross - alongAcross * alongAcross
    if twist == zeroOf(twist) {
      const nothing = zeroOf twist
      return (first: nothing, second: nothing, third: nothing)
    }
    const second = (acrossAcross * alongGap - alongAcross * acrossGap) / twist
    const third = (alongAlong * acrossGap - alongAcross * alongGap) / twist
    (first: twist.unit() - second - third, second: second, third: third)
  }

  /** Whether the point lies in the triangle, which for a point off the plane means its shadow on the plane does. */
  fn contains(point: Vector3<Scalar>): Bool {
    const weights = weightsOf point
    const nothing = zeroOf weights.first
    weights.first >= nothing && weights.second >= nothing && weights.third >= nothing
  }
}
