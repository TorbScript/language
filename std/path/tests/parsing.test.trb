/**
 * Every row of `docs/PATH.md` section 2's parse table, each checked by the root and the components it produced and by
 * what it shows as, plus the `normalized()` rules that resolve `..` as text. `Path` is a capsule, so a row is read
 * back through `root()` and `components()` instead of being compared with a constructor call. The imports are
 * relative, because the interpreter resolves no package import at all and reads a module of `std/` only by its path.
 */

use test, group from "std/test"
use Path from "../src/path"
use Root from "../src/root"

group "Path.from" {
  test "the empty string and a single dot both parse to the empty relative path" {
    const empty = Path.from ""
    const dot = Path.from "."
    assert(empty.root() == None)
    assert(empty.components() == [])
    assert(dot == empty)
    assert(empty.show() == ".")
    assert(dot.show() == ".")
  }

  test "a trailing separator is dropped" {
    const parsed = Path.from "src/"
    assert(parsed.root() == None)
    assert(parsed.components() == ["src"])
    assert(parsed.show() == "src")
  }

  test "a doubled separator collapses to one component boundary" {
    const parsed = Path.from "src//main.trb"
    assert(parsed.root() == None)
    assert(parsed.components() == ["src", "main.trb"])
    assert(parsed.show() == "src/main.trb")
  }

  test "'.' components are dropped wherever they occur" {
    const parsed = Path.from "./src/./x"
    assert(parsed.root() == None)
    assert(parsed.components() == ["src", "x"])
    assert(parsed.show() == "src/x")
  }

  test "a leading '..' is kept, because dropping it would be a guess" {
    const parsed = Path.from "../src"
    assert(parsed.root() == None)
    assert(parsed.components() == ["..", "src"])
    assert(parsed.show() == "../src")
  }

  test "a lone slash is the Unix root with no components" {
    const parsed = Path.from "/"
    assert(parsed.root() == Some(Root.Unix))
    assert(parsed.components() == [])
    assert(parsed.show() == "/")
  }

  test "an absolute Unix path" {
    const parsed = Path.from "/usr/bin"
    assert(parsed.root() == Some(Root.Unix))
    assert(parsed.components() == ["usr", "bin"])
    assert(parsed.show() == "/usr/bin")
  }

  test "a backslash separates exactly like a forward slash, and the drive letter is upper-cased" {
    const parsed = Path.from "c:\\x"
    assert(parsed.root() == Some(Root.Drive('C')))
    assert(parsed.components() == ["x"])
    assert(parsed.show() == "C:/x")
  }

  test "a bare drive has no components and shows with its trailing separator" {
    const parsed = Path.from "C:"
    assert(parsed.root() == Some(Root.Drive('C')))
    assert(parsed.components() == [])
    assert(parsed.show() == "C:/")
  }

  test "drive-relative reads as absolute on that drive, which is the one form Path cannot hold" {
    const parsed = Path.from "C:foo"
    assert(parsed.root() == Some(Root.Drive('C')))
    assert(parsed.components() == ["foo"])
    assert(parsed.show() == "C:/foo")
  }

  test "a UNC share names its server and its share as the root, and everything after it as components" {
    const parsed = Path.from "//server/share/x"
    assert(parsed.root() == Some(Root.Share("server", "share")))
    assert(parsed.components() == ["x"])
    assert(parsed.show() == "//server/share/x")
  }
}

group "Path.normalized" {
  test "'..' against the root vanishes, because no file system has a parent of its root" {
    assert(Path.from("/../a").normalized() == Path.from("/a"))
    assert(Path.from("/a/../b").normalized() == Path.from("/b"))
  }

  test "a leading '..' of a relative path stays, because there is nothing to resolve it against" {
    assert(Path.from("../a").normalized() == Path.from("../a"))
    assert(Path.from("a/../../b").normalized() == Path.from("../b"))
  }

  test "a path that came out of the parse has nothing left for normalized() to drop" {
    const parsed = Path.from "a//./b"
    assert(parsed.components() == ["a", "b"])
    assert(parsed.normalized() == parsed)
  }

  test "a drive and a share root behave exactly like the Unix root" {
    assert(Path.from("C:/../x").normalized() == Path.from("C:/x"))
    assert(Path.from("//server/share/../x").normalized() == Path.from("//server/share/x"))
  }
}

/** Both halves of the pair, asked through the bound: this only type checks while `String` has `From<Value>`. */
fn textOf<Value>(value: Value): String where String: From<Value> {
  String.from value
}

group "the conversion pair" {
  test "the way in is Path.from and the way out is String.from, and together they round-trip" {
    const text = "/usr/local/bin"
    assert(textOf(Path.from(text)) == text)
    assert(Path.from(textOf(Path.from(text))) == Path.from(text))
  }

  test "the way out is the same text as show(), on a relative path and on a share" {
    assert(textOf(Path.from("a/b")) == "a/b")
    assert(textOf(Path.from("//server/share/x")) == "//server/share/x")
  }
}
