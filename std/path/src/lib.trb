/**
 * `Path`: a root and a list of components, and never a string. `joined` cannot be given a root, `parent` cannot
 * fall off the top, `..` is only resolved on purpose, and `show()` is the one text form every platform agrees on.
 *
 * `std/path` is pure value arithmetic over text. It reads no disk and touches no file system - `std/fs` is where a
 * `Path` meets the operating system, and where the capability to read or write one lives.
 */

public use Path from "./path"
public use Root from "./root"
public use PathError from "./error"
