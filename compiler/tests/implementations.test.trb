/**
 * What an implementation is, and every rule about one: coherence, overlap, the members it has to provide, the
 * supertraits it drags in, `by field`, the derived ones, and the visibility of an `extend`.
 *
 * What an implementation means for an *expression* is `traits.test.trb`.
 */

use test, group from "std/test"
use probe, problems, notes, problemsAt, workspaceWith from "./harness"
use check from "../src/semantics/check"

/** The source inside of a `fn probe()` body, so that an expression can be looked at without a declaration around it. */
fn inBody(body: String): String {
  "fn probe() \{\n{body}\n\}"
}

/** Everything that is wrong in a workspace of several files, in file order. */
fn problemsIn(files: Map<String, String>): List<String> {
  var found: List<String> = []
  for file in check(workspaceWith(files), ["app"]).files {
    for diagnostic in file.diagnostics {
      found.append diagnostic.message
    }
  }
  found
}

/** The notes of all of them, in the same order. */
fn notesIn(files: Map<String, String>): List<String> {
  var found: List<String> = []
  for file in check(workspaceWith(files), ["app"]).files {
    for diagnostic in file.diagnostics {
      found.appendAll diagnostic.notes
    }
  }
  found
}

/**
 * A second package, so that "this package attached it" and "another package attached it" can be told apart. The
 * `extend` goes into `other/src/lib.trb`, which is `"other/library"` in a `use`.
 */
fn withOtherPackage(library: String, main: String): Map<String, String> {
  [
    "project.trb": "name \"acme/all\"\nworkspace \{ members \"std/*\", \"app\", \"other\" \}\n",
    "other/project.trb": "name \"other/library\"\n",
    "other/src/lib.trb": library,
    "app/project.trb": "name \"acme/app\"\ndependencies \{ runtime \"other/library\" \}\n",
    "app/src/main.trb": main,
  ]
}

group "What an implementation has to provide" {
  test "a required member that is nowhere is named, together with the signature the trait asks for" {
    const source = "trait Shape \{\n  fn name(): String\n\}\n\ntype Square with Shape \{\n  side: Int\n\}"
    assert(problems(source) == ["`Square` implements `Shape` but has no `name`"])
    assert(notes(source) == ["`Shape` requires `fn name(): String`"])
  }

  test "a default member is no requirement, and neither is a member with a `where` clause (gap 9)" {
    const source = "trait Shape \{\n  fn area(): Int\n\n  fn describe(): String \{\n    \"shape\"\n  \}\n\n"
      + "  fn sorted<Key: Compare>(by: Key): Int where Key: Show \{\n    0\n  \}\n\}\n\n"
      + "type Square with Shape \{\n  fn area(): Int \{\n    1\n  \}\n\}"
    assert problems(source).isEmpty()
  }

  test "a member an `extend` of the type provides counts, wherever it is written" {
    const source = "trait Shape \{\n  fn area(): Int\n\}\n\ntype Square with Shape \{\n  side: Int\n\}\n\n"
      + "extend Square \{\n  fn area(): Int \{\n    side * side\n  \}\n\}"
    assert problems(source).isEmpty()
  }

  test "a signature that does not match the trait is a mistake" {
    const source = "trait Shape \{\n  fn name(): String\n\}\n\n"
      + "type Square with Shape \{\n  fn name(): Int \{\n    1\n  \}\n\}"
    assert(problems(source) == ["`Square.name` does not match `Shape`"])
    assert(notes(source) == ["`Shape` requires `fn name(): String`"])
  }

  /** The requirement takes the format as a bound, and a member that takes a trait-typed value is another member. */
  test "a generic requirement is met only by a member with as many type parameters of its own" {
    const source = "trait Writer \{\n  var fn put(value: Int)\n\}\n\n"
      + "trait Saved \{\n  fn save<Target: Writer>(var target: Target)\n\}\n\n"
      + "type Money with Saved \{\n  cents: Int\n\n  fn save(var target: Writer) \{\n    target.put cents\n  \}\n\}"
    assert(problems(source) == ["`Money.save` does not match `Saved`"])
    assert(notes(source) == ["`Saved` requires `fn save<Target: Writer>(var target: Target)`"])
  }

  test "the type parameters of a member may have other names than the requirement's" {
    const source = "trait Writer \{\n  var fn put(value: Int)\n\}\n\n"
      + "trait Saved \{\n  fn save<Target: Writer>(var target: Target)\n\}\n\n"
      + "type Money with Saved \{\n  cents: Int\n\n"
      + "  fn save<Output: Writer>(var output: Output) \{\n    output.put cents\n  \}\n\}"
    assert problems(source).isEmpty()
  }

  /** A caller through the trait knows only that the format is a `Writer`, so a member may not ask for more. */
  test "a member whose type parameter asks for more than the requirement promises does not match" {
    const source = "trait Writer \{\n  var fn put(value: Int)\n\}\n\n"
      + "trait Saved \{\n  fn save<Target: Writer>(var target: Target)\n\}\n\n"
      + "type Money with Saved \{\n  cents: Int\n\n"
      + "  fn save<Output: Writer & Show>(var output: Output) \{\n    output.put cents\n  \}\n\}"
    assert(problems(source) == ["`Money.save` does not match `Saved`"])
  }

  test "a supertrait is a requirement on the implementing type, and the message says who asked" {
    const source = "trait Named \{\n  fn name(): String\n\}\n\ntrait Shape with Named \{\n  fn area(): Int\n\}\n\n"
      + "type Square with Shape \{\n  fn area(): Int \{\n    1\n  \}\n\}"
    assert(problems(source) == ["`Shape` requires `Named`, and `Square` has no `name`"])
    assert(
      notes(source)
        == [
          "`Named` requires `fn name(): String`. A supertrait is a requirement on the implementing type",
        ]
    )
  }

  test "a default of the trait in between satisfies the requirement of its supertrait" {
    const source = "trait Named \{\n  fn name(): String\n\}\n\n"
      + "trait Shape with Named \{\n  fn area(): Int\n\n  fn name(): String \{\n    \"shape\"\n  \}\n\}\n\n"
      + "type Square with Shape \{\n  fn area(): Int \{\n    1\n  \}\n\}"
    assert problems(source).isEmpty()
  }

  test "a `native` type provides the members of its traits through a row of the manifest, or a body" {
    // Only a package of the standard library may declare `native`, so the types live in one. `Char.show` is a row of
    // the manifest of natives, and `Char` is the name it is looked up under
    const provided = [
      "std/graphics/project.trb": "name \"std/graphics\"\n",
      "std/graphics/src/lib.trb": "trait Named \{\n  fn show(): String\n\}\n\npublic native type Char with Named \{\}\n\n"
        + "trait Shape \{\n  fn area(): Int\n\}\n\npublic native type Pixel with Shape \{\n  fn area(): Int \{\n    1\n  \}\n\}\n",
    ]
    assert problemsAt(provided, ["std/graphics"]).isEmpty()
  }

  test "a `native` type whose requirement neither the manifest nor a body provides is named" {
    const files = [
      "std/graphics/project.trb": "name \"std/graphics\"\n",
      "std/graphics/src/lib.trb": "trait Shape \{\n  fn area(): Int\n\}\n\npublic native type Pixel with Shape \{\}\n",
    ]
    assert(problemsAt(files, ["std/graphics"]) == ["`Pixel` implements `Shape`, and nothing provides its `area`"])
  }

  test "a trait as the target of an implementation asks nothing of the trait itself" {
    const source = "trait Shape \{\n  fn area(): Int\n\}\n\n"
      + "extend Shape with Show \{\n  fn show(): String \{\n    \"shape\"\n  \}\n\}"
    assert problems(source).isEmpty()
  }
}

group "Coherence" {
  test "`extend X with Trait` needs the package to own `X` or `Trait`" {
    const source = "extend String with Show \{\n  fn show(): String \{\n    self\n  \}\n\}"
    assert(problems(source) == ["`extend String with Show`: neither `String` nor `Show` belongs to this package"])
    assert(
      notes(source)
        == [
          "An implementation belongs to the package of the type or to the package of the trait, so that no two"
            + " packages can write the same one",
        ]
    )
  }

  test "owning either side is enough" {
    const own = "trait Loud \{\n  fn shout(): String\n\}\n\n"
      + "extend String with Loud \{\n  fn shout(): String \{\n    self\n  \}\n\}"
    assert problems(own).isEmpty()
    const other = "type Amount \{\n  value: Int\n\}\n\n"
      + "extend Amount with Show \{\n  fn show(): String \{\n    \"amount\"\n  \}\n\}"
    assert problems(other).isEmpty()
  }

  test "an `extend` without a trait has no orphan rule: it only adds members" {
    assert problems("extend String \{\n  fn shout(): String \{\n    self\n  \}\n\}").isEmpty()
  }

  test "an implementation for a trait overlaps with the one a type of that trait writes itself" {
    const declarations = "trait Shape \{\n  fn area(): Int\n\}\n\ntrait Describe \{\n  fn describe(): String\n\}\n\n"
      + "extend Shape with Describe \{\n  fn describe(): String \{\n    \"some shape\"\n  \}\n\}\n\n"
      + "type Square with Shape, Describe \{\n  fn area(): Int \{\n    1\n  \}\n\n"
      + "  fn describe(): String \{\n    \"a square\"\n  \}\n\}\n\n"
      + "fn viaBound<Value: Describe>(value: Value): String \{\n  value.describe()\n\}\n\n"
    // The type's own implementation stays the answer, so the bound holds and there is one message, at the `extend`
    const source = declarations + "fn probe(): String \{\n  viaBound(Square())\n\}"
    assert(problems(source) == ["`Square` implements `Describe` itself, and it is a `Shape`"])
    assert(
      notes(source)
        == [
          "A `Square` would answer differently when it is seen as a `Shape`: what a call does may not depend on the"
            + " type it is made through. Implement `Describe` in one of the two places",
        ]
    )
  }

  test "a type of the trait that does not write the member itself takes the one of the trait's implementation" {
    const source = "trait Shape \{\n  fn area(): Int\n\}\n\ntrait Describe \{\n  fn describe(): String\n\}\n\n"
      + "extend Shape with Describe \{\n  fn describe(): String \{\n    \"some shape\"\n  \}\n\}\n\n"
      + "type Square with Shape \{\n  fn area(): Int \{\n    1\n  \}\n\}\n\n"
      + "fn viaBound<Value: Describe>(value: Value): String \{\n  value.describe()\n\}\n\n"
      + "fn probe(): String \{\n  const shape: Shape = Square()\n  viaBound(Square()) + shape.describe()\n\}"
    assert problems(source).isEmpty()
  }

  test "two implementations of one trait for one type overlap" {
    const source = "trait Loud \{\n  fn shout(): String\n\}\n\ntype Amount \{\n  value: Int\n\}\n\n"
      + "extend Amount with Loud \{\n  fn shout(): String \{\n    \"a\"\n  \}\n\}\n\n"
      + "extend Amount with Loud \{\n  fn shout(): String \{\n    \"b\"\n  \}\n\}"
    assert(problems(source) == ["`Amount` already implements `Loud` (in `app/src/main.trb`)"])
    assert(
      notes(source)
        == ["Two implementations of one trait may not overlap: only different target types tell them apart"]
    )
  }

  test "two arguments of the same trait are two implementations and do not overlap" {
    const source = "type Wide \{\n  value: Int\n\}\n\n"
      + "extend Wide with From<Int8> \{\n  static fn from(value: Int8): Wide \{\n    Wide(1)\n  \}\n\}\n\n"
      + "extend Wide with From<UInt8> \{\n  static fn from(value: UInt8): Wide \{\n    Wide(2)\n  \}\n\}"
    assert problems(source).isEmpty()
  }

  test "a type of this package as an argument of the trait is the third way in" {
    const source = "type Celsius \{\n  degrees: Float\n\}\n\n"
      + "extend Float64 with From<Celsius> \{\n  static fn from(value: Celsius): Float64 \{\n    value.degrees\n  \}\n\}"
    assert problems(source).isEmpty()
  }

  test "an argument that only *contains* a type of this package is not enough" {
    const source = "type Celsius \{\n  degrees: Float\n\}\n\n"
      + "extend Float64 with From<List<Celsius>> \{\n"
      + "  static fn from(value: List<Celsius>): Float64 \{\n    1.0\n  \}\n\}"
    assert(
      problems(source)
        == ["`extend Float64 with From<List<Celsius>>`: neither `Float64` nor `From<List<Celsius>>` belongs to this"
          + " package"]
    )
  }

  test "a package that owns none of the three is still refused, and the note names all three ways" {
    const source = "extend Float64 with From<Int8> \{\n  static fn from(value: Int8): Float64 \{\n    1.0\n  \}\n\}"
    assert(
      problems(source) == ["`extend Float64 with From<Int8>`: neither `Float64` nor `From<Int8>` belongs to this package"]
    )
    assert(
      notes(source)
        == [
          "An implementation belongs to the package of the type or to the package of the trait, so that no two"
            + " packages can write the same one, or to the package of a type named as an argument of the trait",
        ]
    )
  }

  test "a trait without arguments keeps the note it had, because there is no third way" {
    const source = "extend String with Show \{\n  fn show(): String \{\n    self\n  \}\n\}"
    assert(
      notes(source)
        == [
          "An implementation belongs to the package of the type or to the package of the trait, so that no two"
            + " packages can write the same one",
        ]
    )
  }

  test "a trait that has a blanket implementation says which trait to implement instead" {
    const source = "type Celsius \{\n  degrees: Float\n\}\n\n"
      + "extend Celsius with Into<Float64> \{\n  fn into(): Float64 \{\n    degrees\n  \}\n\}"
    assert(problems(source) == ["`Into` comes from `From` for every type"])
    assert(
      notes(source)
        == [
          "Write `extend Float64 with From<Celsius>`: the blanket implementation in `std/prelude` makes"
            + " `Celsius.into()` out of that",
        ]
    )
  }

  test "the line it names is coherent, because the argument of the trait is a type of this package" {
    const source = "type Celsius \{\n  degrees: Float\n\}\n\n"
      + "extend Float64 with From<Celsius> \{\n  static fn from(value: Celsius): Float64 \{\n    value.degrees\n  \}\n\}\n\n"
      + inBody("  const degrees: Float64 = Celsius(100.0).into()")
    assert problems(source).isEmpty()
  }

  test "a blanket whose condition is not one trait bound keeps the plain overlap message" {
    const source = "trait Loud \{\n  fn shout(): String\n\}\n\n"
      + "extend<Value> Value with Loud \{\n  fn shout(): String \{\n    \"any\"\n  \}\n\}\n\n"
      + "type Amount \{\n  value: Int\n\}\n\n"
      + "extend Amount with Loud \{\n  fn shout(): String \{\n    \"a\"\n  \}\n\}"
    assert(problems(source) == ["`Amount` already implements `Loud` (in `app/src/main.trb`)"])
  }

  test "a blanket implementation covers every type, so it needs the trait" {
    const source = "extend<Source> Source with Show \{\n  fn show(): String \{\n    \"any\"\n  \}\n\}"
    assert(problems(source) == ["`extend Source with Show`: neither `Source` nor `Show` belongs to this package"])
  }
}

/**
 * A trait's own `with` list is a promise about **every** instantiation, because it is what member lookup reads. An
 * implementation of that supertrait for the trait type may therefore not be narrower than the promise: the rest of the
 * instantiations would have the supertrait and nothing behind it.
 */
group "A supertrait a trait promises for itself" {
  /** A trait, an implementor and an implementation for the trait type, with the bounds written where `bounds` says. */
  fn mound(onTrait: String, onHeap: String, onExtension: String): String {
    "trait Mound<Item{onTrait}> with From<Iterate<Item>> \{\n  fn size(): Int\n\}\n\n"
      + "type Heap<Item{onHeap}> with Mound<Item>, From<Iterate<Item>> \{\n  stored: Int\n\n"
      + "  static fn from(values: Iterate<Item>): Heap<Item> \{\n    Self(0)\n  \}\n\n"
      + "  fn size(): Int \{\n    stored\n  \}\n\}\n\n"
      + "extend<Item{onExtension}> Mound<Item> with From<Iterate<Item>> \{\n"
      + "  static fn from(values: Iterate<Item>): Mound<Item> \{\n    Heap.from(values)\n  \}\n\}\n"
  }

  test "an implementation for the trait type that holds only under bounds is refused" {
    const source = mound "", ": Hash", ": Hash"
    assert(
      problems(source)
        == ["`Mound` comes with `From` for every instantiation, and this implementation holds only for some"]
    )
    assert(
      notes(source) == [
        "A trait's own `with` list is what member lookup reads, so `From` resolves on every `Mound` while nothing"
          + " implements it for the rest: drop the bounds of this `extend`, or take `From` out of `trait Mound`'s"
          + " `with` list and ask for it at the member (`where Self: From<...>`)",
      ]
    )
  }

  test "the same implementation without bounds keeps the promise" {
    assert problems(mound("", "", "")).isEmpty()
  }

  test "a trait that bounds its own parameter said the same thing where the promise is read" {
    assert problems(mound(": Hash", ": Hash", ": Hash")).isEmpty()
  }

  test "a supertrait the trait does not name is an implementation like any other" {
    const source = "trait Mound<Item> \{\n  fn size(): Int\n\}\n\n"
      + "type Heap<Item: Hash> with Mound<Item>, From<Iterate<Item>> \{\n  stored: Int\n\n"
      + "  static fn from(values: Iterate<Item>): Heap<Item> \{\n    Self(0)\n  \}\n\n"
      + "  fn size(): Int \{\n    stored\n  \}\n\}\n\n"
      + "extend<Item: Hash> Mound<Item> with From<Iterate<Item>> \{\n"
      + "  static fn from(values: Iterate<Item>): Mound<Item> \{\n    Heap.from(values)\n  \}\n\}\n"
    assert problems(source).isEmpty()
  }
}

group "Delegation with `by`" {
  test "`by field` forwards every required member, and the default members come from the trait (gap 14)" {
    const source = "type Meters with Add<Meters, Meters> & Compare by value \{\n  value: Float\n\}\n\n"
      + inBody("  const sum = Meters(1.0) + Meters(2.0)\n  const longer = Meters(1.0).max(Meters(2.0))")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Meters(1.0) + Meters(2.0)") == "Meters")
    assert(found.typeOf("Meters(1.0).max(Meters(2.0))") == "Meters")
  }

  test "a required member that is forwarded records the field it goes through" {
    const source = "type Meters with Add<Meters, Meters> by value \{\n  value: Float\n\}\n\n"
      + inBody("  const sum = Meters(1.0) + Meters(2.0)")
    const found = probe source
    assert(found.adaptationsOf("Meters(1.0) + Meters(2.0)") == ["delegate value"])
  }

  test "a default member is not forwarded: it comes from the trait, over the delegated ones" {
    const source = "type Meters with Compare by value \{\n  value: Float\n\}\n\n"
      + inBody("  const same = Meters(1.0).max(Meters(2.0))")
    const found = probe source
    assert(found.adaptationsOf("Meters(1.0).max") == [])
  }

  test "a trait that is not listed is not available" {
    const source = "type Meters with Add<Meters, Meters> by value \{\n  value: Float\n\}\n\n"
      + inBody("  const area = Meters(1.0) * Meters(2.0)")
    assert(problems(source) == ["`Meters` does not implement `Multiply`, so `a * b` has no meaning for it"])
  }

  test "`by` binds to one element of the `with` list: derived, a delegated group, a delegated trait alone, and a hand-written one all coexist" {
    const source = "trait Named \{\n  fn name(): String\n\}\n\n"
      + "type Seconds with Show, Add<Seconds, Seconds> & Subtract<Seconds, Seconds> by value, Compare by value, Named \{\n"
      + "  value: Int\n\n  fn name(): String \{\n    \"seconds\"\n  \}\n\}\n\n"
      + inBody(
        "  const sum = Seconds(1) + Seconds(2)\n"
          + "  const difference = Seconds(3) - Seconds(1)\n"
          + "  const longer = Seconds(1).max(Seconds(2))\n"
          + "  const named = Seconds(1).name()"
      )
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Seconds(1) + Seconds(2)") == "Seconds")
    assert(found.typeOf("Seconds(3) - Seconds(1)") == "Seconds")
    assert(found.adaptationsOf("Seconds(1) + Seconds(2)") == ["delegate value"])
    assert(found.adaptationsOf("Seconds(3) - Seconds(1)") == ["delegate value"])
    // `max` is a default member of `Compare`: not forwarded, so it is not `delegate value`
    assert(found.adaptationsOf("Seconds(1).max(Seconds(2))") == [])
    // `Named` is not delegated: `name` is the hand-written one, so it is not `delegate value` either
    assert(found.adaptationsOf("Seconds(1).name()") == [])
  }

  test "`by` needs a type with a single field" {
    const source = "type Money with Show by amount \{\n  amount: Int\n  currency: String\n\n"
      + "  fn show(): String \{\n    \"money\"\n  \}\n\}"
    assert(problems(source) == ["`by` needs a type with a single field: `Money` has `amount` and `currency`"])
  }

  test "`by` names the field of the type" {
    const source = "type Seconds with Show by amount \{\n  value: Int\n\n  fn show(): String \{\n    \"seconds\"\n  \}\n\}"
    assert(problems(source) == ["`by` names the field of the type: `Seconds` has `value`, not `amount`"])
  }

  test "a type with cases cannot delegate" {
    const source = "type Shape with Show by value \{\n  case Circle(value: Int)\n  case Empty\n\n"
      + "  fn show(): String \{\n    \"shape\"\n  \}\n\}"
    assert(problems(source) == ["`by` needs a type with a single field: `Shape` has cases, not fields"])
  }

  test "a `by` that names no usable field still says where the members come from: one message, not a missing `add`" {
    const source = "type Money with Add<Money, Money> by amount \{\n  amount: Int\n  currency: String\n\}"
    assert(problems(source) == ["`by` needs a type with a single field: `Money` has `amount` and `currency`"])
  }
}

group "Derived implementations" {
  test "a generated member is a member: `equals` and `hash` are there before anything asked for the trait" {
    const source = "type Point \{\n  x: Int\n\}\n\n"
      + inBody("  const same = Point(1).equals(Point(1))\n  const code = Point(1).hash()\n  print same, code")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Point(1).equals(Point(1))") == "Bool")
  }

  test "a type the trait cannot be generated for has no such member" {
    const source = "type Holder \{\n  run: () => Void\n\}\n\n" + inBody("  print Holder(\{ \}).hash()")
    assert(problems(source) == ["`Holder` has no member `hash`"])
  }

  test "`Show` is generated for a type all of whose fields have it" {
    const source = "type Amount \{\n  value: Int\n  label: String\n\}\n\n"
      + inBody("  const shown = \"\{Amount(1, \"a\")\}\"")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.adaptationsOf("Amount(1, \"a\")") == ["show through Amount: Show"])
  }

  test "a field that is not `Show` stops the derivation, and then nothing is generated" {
    const source = "type Opaque \{\n  value: Int\n\}\n\ntype Holder \{\n  inner: Opaque\n\}\n\n"
      + "fn describe(value: Show): String \{\n  value.show()\n\}\n\n"
      + inBody("  print describe(Holder(Opaque(1)))")
    // `Opaque` is `Show` itself by derivation, so `Holder` is too - a field without it is what would stop this
    assert problems(source).isEmpty()
  }

  test "a hand-written member wins over the derived one, per member" {
    const source = "type Amount with Show \{\n  value: Int\n\n"
      + "  fn show(): String \{\n    \"amount\"\n  \}\n\}\n\n"
      + inBody("  const shown = \"\{Amount(1)\}\"")
    const found = probe source
    assert(found.adaptationsOf("Amount(1)") == ["show through Amount: Show"])
    assert(found.dispatchOf("Amount(1)") == "none")
  }

  test "`Equals` and `Hash` are generated, and a `shared type` gets neither" {
    const source = "type Amount \{\n  value: Int\n\}\n\n"
      + "fn hashed(value: Hash): Int \{\n  value.hash()\n\}\n\n"
      + inBody("  print hashed(Amount(1))")
    assert problems(source).isEmpty()
    const identity = "public shared type Counter \{\n  var value: Int = 0\n\}\n\n"
      + "fn hashed(value: Hash): Int \{\n  value.hash()\n\}\n\n"
      + inBody("  print hashed(Counter())")
    assert(problems(identity) == ["`Counter` does not implement `Hash`"])
  }

  test "a `From` is generated for a case that wraps exactly one value of a type no other case wraps" {
    const source = "type IoError \{\n  path: String\n\}\n\ntype AppError \{\n  case Io(error: IoError)\n"
      + "  case Other(message: String)\n\}\n\n"
      + "fn wrap(value: From<IoError>): Int \{\n  0\n\}"
    assert problems(source).isEmpty()
  }

  /**
   * An implementation is generated the first time somebody asks for it, which is **after** "every trait this type
   * has" and "everything this type has" were already answered for the same type. Both answers are kept, and both are
   * closed-world, so adding one has to throw them away: without that, the interpolation below derives `Show` and the
   * `show()` after it is still told that the type has no such member.
   */
  test "member lookup is not served an answer from before a derived implementation existed" {
    const source = "type Amount \{\n  value: Int\n\}\n\n"
      + "fn probe(amount: Amount): String \{\n  const text = \"\{amount\}\"\n  text + amount.show()\n\}"
    assert problems(source).isEmpty()
  }

  test "and neither is the trait closure the lookup walks" {
    const source = "type Amount \{\n  value: Int\n\}\n\n"
      + "fn shown(value: Show): String \{\n  value.show()\n\}\n\n"
      + "fn probe(amount: Amount): String \{\n  const text = shown(amount)\n  text + amount.show()\n\}"
    assert problems(source).isEmpty()
  }
}

/**
 * A **capsule** is a type whose generated constructor is closed from outside, because a `private` field has no
 * default. There is no field list a caller could be handed, so `Encode` and `Decode` are derived through the type's one
 * conversion pair: the `Source` it is read from and written as. Without a pair the way in is refused and the way out
 * stays the fields, exactly as `Show` does.
 */
group "A capsule's `Encode` and `Decode`" {
  /** The one thing that needs a `Decode`, so that the derivation is asked for where a test can see the answer. */
  const reader = "fn read<Value: Decode>(): Int \{\n  1\n\}\n\n"

  const writer = "fn write(value: Encode): Int \{\n  1\n\}\n\n"

  test "the pair may be written with `TryFrom`, and then `Decode` is derived" {
    const source = "type Email with TryFrom<String, String> \{\n  private storedAddress: String\n\n"
      + "  static fn tryFrom(value: String): Result<Email, String> \{\n    Ok Self(value)\n  \}\n\n"
      + "  fn address(): String \{\n    storedAddress\n  \}\n\}\n\n"
      + "extend String with From<Email> \{\n"
      + "  static fn from(value: Email): String \{\n    value.address()\n  \}\n\}\n\n"
      + reader + inBody("  print read<Email>()\n  const _ = Email.decode(\"ada@example.test\")")
    assert problems(source).isEmpty()
  }

  test "the pair may be written with `From`, and then `Decode` is derived too" {
    const source = "type Title \{\n  text: String\n\}\n\ntype Slug \{\n  private storedText: String\n\n"
      + "  fn text(): String \{\n    storedText\n  \}\n\}\n\n"
      + "extend Slug with From<Title> \{\n"
      + "  static fn from(value: Title): Slug \{\n    Self value.text\n  \}\n\}\n\n"
      + "extend Title with From<Slug> \{\n"
      + "  static fn from(value: Slug): Title \{\n    Title value.text()\n  \}\n\}\n\n"
      + reader + inBody("  print read<Slug>()")
    assert problems(source).isEmpty()
  }

  /** One direction is not a pair: the way out has to exist as well, or nothing can be written. */
  test "a way in without a way back is no pair, and the reflexive `From<Self>` never counts as one" {
    const source = "type Email with TryFrom<String, String> \{\n  private storedAddress: String\n\n"
      + "  static fn tryFrom(value: String): Result<Email, String> \{\n    Ok Self(value)\n  \}\n\}\n\n"
      + reader + inBody("  print read<Email>()")
    assert(problems(source) == ["`Email` does not implement `Decode`"])
    assert(
      notes(source) == [
        "`read` asks for it",
        "`Email` is a capsule: `storedAddress` is private and has no default, so nothing outside can call the"
          + " constructor and `Decode` comes from `Email`'s one conversion pair instead of from its fields",
        "`Email` has no pair. Write `From<Source>` or `TryFrom<Source, Failure>` for `Email`, and `From<Email>` for"
          + " that `Source`",
      ]
    )
  }

  /** The chain goes down the first field that fails, to the type that is the root cause, and that type says why. */
  test "a record without `Decode` names the chain of fields down to the type that has none" {
    const source = "type Image \{\n  private pixels: List<Int>\n\}\n\n"
      + "type Avatar \{\n  image: Image\n\}\n\n"
      + "type User \{\n  name: String\n  avatar: Avatar\n\}\n\n"
      + reader + inBody("  print read<User>()")
    assert(problems(source) == ["`User` does not implement `Decode`"])
    assert(
      notes(source) == [
        "`read` asks for it",
        "its field `avatar: Avatar` is not `Decode`: `User.avatar -> Avatar.image -> Image`",
        "`Image` is a capsule: `pixels` is private and has no default, so nothing outside can call the"
          + " constructor and `Decode` comes from `Image`'s one conversion pair instead of from its fields",
        "`Image` has no pair. Write `From<Source>` or `TryFrom<Source, Failure>` for `Image`, and `From<Image>` for"
          + " that `Source`",
      ]
    )
  }

  test "two types that convert both ways are two pairs, and the message lists them" {
    const source = "type Title \{\n  text: String\n\}\n\ntype Slug \{\n  private storedText: String\n\n"
      + "  fn text(): String \{\n    storedText\n  \}\n\}\n\n"
      + "extend Slug with From<Title> \{\n"
      + "  static fn from(value: Title): Slug \{\n    Self value.text\n  \}\n\}\n\n"
      + "extend Title with From<Slug> \{\n"
      + "  static fn from(value: Slug): Title \{\n    Title value.text()\n  \}\n\}\n\n"
      + "extend Slug with TryFrom<String, String> \{\n"
      + "  static fn tryFrom(value: String): Result<Slug, String> \{\n    Ok Self(value)\n  \}\n\}\n\n"
      + "extend String with From<Slug> \{\n"
      + "  static fn from(value: Slug): String \{\n    value.text()\n  \}\n\}\n\n"
      + reader + inBody("  print read<Slug>()")
    assert(problems(source) == ["`Slug` does not implement `Decode`"])
    assert(
      notes(source)[2] == "`Slug` converts both ways with `String` and `Title`. Exactly one type may"
    )
  }

  /** The generated body reads the `Source` and nothing else, so a `Source` without the trait is no pair either. */
  test "a pair whose source is not `Decode` itself derives nothing, and the message names it" {
    const source = "type Weight \{\n  private storedGrams: Float\n\}\n\n"
      + "extend Weight with From<Float> \{\n"
      + "  static fn from(value: Float): Weight \{\n    Self value\n  \}\n\}\n\n"
      + "extend Float with From<Weight> \{\n"
      + "  static fn from(value: Weight): Float \{\n    0.0\n  \}\n\}\n\n"
      + reader + inBody("  print read<Weight>()")
    assert(problems(source) == ["`Weight` does not implement `Decode`"])
    assert(
      notes(source)[2] == "`Weight` pairs with `Float64` through `from`, and that type is not `Decode` itself"
    )
  }

  /** The way out cannot break an invariant, so a capsule without a pair is still a value a message can show. */
  test "without a pair the way out stays the fields, because that is what `Show` does as well" {
    const source = "type Email with TryFrom<String, String> \{\n  private storedAddress: String\n\n"
      + "  static fn tryFrom(value: String): Result<Email, String> \{\n    Ok Self(value)\n  \}\n\}\n\n"
      + writer + "fn probe(address: Email): Int \{\n  write address\n\}"
    assert problems(source).isEmpty()
  }

  test "a type whose fields are all public is unchanged: `Decode` comes from the fields" {
    const source = "type Amount \{\n  value: Int\n  label: String = \"\"\n\}\n\n"
      + reader + inBody("  print read<Amount>()")
    assert problems(source).isEmpty()
  }

  test "a `private` field with a default leaves the constructor open, so the fields decide as before" {
    const source = "type Session \{\n  token: String\n  private hits: Int = 0\n\}\n\n"
      + reader + inBody("  print read<Session>()")
    assert problems(source).isEmpty()
  }

  /** The forms are over the constructor's parameters, and a `private` field with a default is none of them. */
  test "a `private` field with a default is no parameter, so a type it has does not have to be `Decode`" {
    const source = "type Session \{\n  token: String\n  private ratio: Float = 0.5\n\}\n\n"
      + reader + inBody("  print read<Session>()")
    assert problems(source).isEmpty()
  }

  test "the same field without `private` is a parameter, and then its type decides" {
    const source = "type Session \{\n  token: String\n  ratio: Float = 0.5\n\}\n\n"
      + reader + inBody("  print read<Session>()")
    assert(problems(source) == ["`Session` does not implement `Decode`"])
  }
}

/**
 * A bound on `Never` holds whatever the trait is: no value of `Never` exists, so nothing can ever ask the table for a
 * member. `Source<Item, Never>` - the reading end of a channel, which cannot fail - is what needs it: the generated
 * `Show` of a `Result` asks its `Failure` for one.
 */
group "A bound on `Never`" {
  test "a `Result` that cannot fail is showable" {
    const source = "fn probe(value: Result<Int, Never>): String \{\n  \"\{value\}\"\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(
      found.lastAdaptationsOf("value") == ["show through Result<Value, Failure>: Show [Int64: Signed, object Never: Show]"]
    )
  }

  test "and it holds for a bound of a call, too" {
    const source = "fn render<Value: Show>(value: Value): String \{\n  \"\{value\}\"\n\}\n\n"
      + "fn probe(value: Result<Int, Never>): String \{\n  render value\n\}"
    assert problems(source).isEmpty()
  }

  test "a type that really has nothing is still reported" {
    const source = "type Holder \{\n  item: Equals\n\}\n\n"
      + "fn probe(value: Result<Int, Holder>): String \{\n  \"\{value\}\"\n\}"
    assert(problems(source) == ["`Result<Int64, Holder>` does not implement `Show`, so it cannot be interpolated"])
  }
}

group "The visibility of an `extend`" {
  test "an extension of a type of your own package is part of the type everywhere" {
    const files = [
      "app/src/text.trb": "public fn unused(): Int \{\n  0\n\}\n\n"
        + "extend Amount \{\n  fn doubled(): Int \{\n    value * 2\n  \}\n\}\n\n"
        + "public type Amount \{\n  value: Int\n\}",
      "app/src/main.trb": "use Amount from \"./text\"\n\nfn probe() \{\n  print Amount(1).doubled()\n\}",
    ]
    assert problemsIn(files).isEmpty()
  }

  test "an extension of a foreign type is named where it is used, and the message is the line to write" {
    const files = withOtherPackage(
      "extend String \{\n  fn shout(): String \{\n    self\n  \}\n\}",
      "fn probe() \{\n  print \"a\".shout()\n\}",
    )
    assert(problemsIn(files) == ["`other/library` adds `shout` to `String`, and this file does not name it"])
    assert(notesIn(files) == ["Write `use String.shout from \"other/library\"` at the top of the file"])
    const named = withOtherPackage(
      "extend String \{\n  fn shout(): String \{\n    self\n  \}\n\}",
      "use String.shout from \"other/library\"\n\nfn probe() \{\n  print \"a\".shout()\n\}",
    )
    assert problemsIn(named).isEmpty()
  }

  test "two members of one name for one type are an ambiguity at the use, and `as` is the fix" {
    const files = [
      "app/src/one.trb": "extend String \{\n  fn shout(): String \{\n    self\n  \}\n\}",
      "app/src/two.trb": "extend String \{\n  fn shout(): String \{\n    self\n  \}\n\}",
      "app/src/main.trb": "fn probe() \{\n  print \"a\".shout()\n\}",
    ]
    assert(problemsIn(files) == ["`shout` comes from `acme/app/one` and from `acme/app/two`"])
    assert(
      notesIn(files)
        == ["A member is renamed where it is imported: `use ... as another from \"acme/app/two\"`"]
    )
  }

  test "`as` renames a member of this package too, so a conflict has a way out" {
    const files = [
      "app/src/one.trb": "extend String \{\n  fn shout(): String \{\n    self\n  \}\n\}",
      "app/src/main.trb": "use String.shout as yell from \"./one\"\n\nfn probe() \{\n  print \"a\".yell()\n\}",
    ]
    assert problemsIn(files).isEmpty()
  }

  test "what a trait puts on a type it does not own needs the trait to be a name of the file" {
    const library = "public trait Slug \{\n  fn slug(): String\n\}\n\n"
      + "extend String with Slug \{\n  fn slug(): String \{\n    self\n  \}\n\}"
    const files = withOtherPackage library, "fn probe() \{\n  print \"a\".slug()\n\}"
    assert(problemsIn(files) == ["`slug` comes from `Slug`, which is not a name in this file"])
    assert(
      notesIn(files)
        == ["Write `use Slug from \"other/library\"`: the members a trait puts on a foreign type need the trait"]
    )
    const named = withOtherPackage library, "use Slug from \"other/library\"\n\nfn probe() \{\n  print \"a\".slug()\n\}"
    assert problemsIn(named).isEmpty()
    // A bound is the trait, so the member is reachable on a type parameter without a second thought
    const bounded = withOtherPackage(
      library,
      "use Slug from \"other/library\"\n\npublic fn shown<Value: Slug>(value: Value): String \{\n  value.slug()\n\}",
    )
    assert problemsIn(bounded).isEmpty()
  }
}

/**
 * A blanket implementation - one whose **target** is a bare type parameter - covers every type whose bound it holds
 * for, so its members are members of that type. CONCEPT allows one "when the package owns the trait", which is also
 * why there is no inherent blanket: without a trait there is nothing to own and nothing a using file could name.
 */
group "Member lookup through a blanket implementation" {
  const query = "trait Query \{\n  fn size(): Int\n\}\n\n"
    + "trait Pairs \{\n  fn doubled(): Int\n\}\n\n"
    + "type Game with Query \{\n  count: Int\n\n  fn size(): Int \{\n    count\n  \}\n\}\n\n"

  test "a concrete type that satisfies the bound has the member" {
    const source = "{query}extend<World: Query> World with Pairs \{\n"
      + "  fn doubled(): Int \{\n    size() * 2\n  \}\n\}\n\n"
      + "fn probe() \{\n  const game = Game(2)\n  print game.doubled()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("game.doubled()") == "Int64")
  }

  test "a type that does not satisfy it does not" {
    const source = "{query}extend<World: Query> World with Pairs \{\n"
      + "  fn doubled(): Int \{\n    size() * 2\n  \}\n\}\n\n"
      + "type Other \{\n  count: Int\n\}\n\n"
      + "fn probe() \{\n  const other = Other(2)\n  print other.doubled()\n\}"
    assert(problems(source) == ["`Other` has no member `doubled`"])
  }

  test "an inherent blanket `extend` is not a form of the language" {
    const source = "{query}extend<World: Query> World \{\n"
      + "  fn doubled(): Int \{\n    size() * 2\n  \}\n\}\n\n"
      + "fn probe() \{\n  const game = Game(2)\n  print game.doubled()\n\}"
    assert(problems(source) == ["`World` is a type parameter, so this `extend` needs a trait"])
    assert(
      notes(source) == [
        "An `extend` over every type is a blanket implementation, and a blanket implementation is allowed because its "
          + "package owns the trait: write `extend<...> World with SomeTrait \{ ... \}`",
      ]
    )
  }

  /**
   * A `where` clause whose *subject* is a concrete type reaches a conversion through the bound it spells: `Path.from
   * path` with a `Source` in hand is the `from` of `From<Source>`, and which implementation that is is decided where
   * `open` is instantiated - not the `From<String>` that is written, which a `Source` is not.
   */
  test "a `where` clause whose subject is a concrete type reaches the conversion it promises" {
    const source = "type Path \{\n  text: String\n\}\n\n"
      + "extend Path with From<String> \{\n  static fn from(value: String): Path \{\n    Path(value)\n  \}\n\}\n\n"
      + "fn open<Source>(path: Source): Path where Path: From<Source> \{\n  Path.from path\n\}\n\n"
      + "fn probe() \{\n  print open(\"a\").text\n\}"
    assert problems(source).isEmpty()
  }

  /**
   * `Type.from(value)` of a type that implements no `From` of its own finds the `From<Never>` every type has, and a
   * value is no `Never`: the call is the same conversion `into()` makes, and it is reported the same way.
   */
  test "`Type.from` of a value the type is made from in no way is reported" {
    const source = "type Point \{\n  x: Int\n\}\n\ntype Name \{\n  text: String\n\}\n\n"
      + "fn probe() \{\n  print Point.from(Name(\"a\"))\n\}"
    assert(problems(source) == ["`Name` does not convert into `Point`"])
    assert(notes(source) == ["Add a case that wraps it, or `extend Point with From<Name>`"])
  }

  test "`Type.from` of the value a case wraps is the generated conversion" {
    const source = "type ConfigError \{\n  message: String\n\}\n\n"
      + "type AppError \{\n  case Config(cause: ConfigError)\n  case Startup(message: String)\n\}\n\n"
      + "fn probe() \{\n  print AppError.from(ConfigError(\"a\"))\n\}"
    assert problems(source).isEmpty()
  }
}
