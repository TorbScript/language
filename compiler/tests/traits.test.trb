use test, group from "std/test"
use probe, problems, notes from "./harness"

/**
 * What a trait means for an expression: which member a name reaches, which implementation carries it, and what the
 * operators, `for`, indexing and string interpolation resolve to.
 *
 * Bound resolution itself - the index, coherence, overlap, derivation, delegation - is `implementations.test.trb`, and
 * `?`, `??`, `?.` and `into()` are `conversions.test.trb`.
 */

/** The source inside of a `fn probe()` body, so that an expression can be looked at without a declaration around it. */
fn inBody(body: String): String {
  "fn probe() \{\n{body}\n\}"
}

group "Members through traits" {
  test "a required member of a trait the type comes with" {
    const source = "type Amount with Equals \{\n  value: Int\n\n  fn equals(self, other: Amount): Bool \{\n"
      + "    value == other.value\n  \}\n\}\n\n"
      + inBody("  const a = Amount(1)\n  print a.equals(Amount(2))")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("a.equals(Amount(2))") == "Bool")
    assert(found.resolutionOf("a.equals") == "call equals")
  }

  test "a default member of a trait, with `Self` standing for the type that reached it" {
    const source = "trait Grow \{\n  fn step(self): Int\n\n  fn twice(self): Int \{\n    step() + step()\n  \}\n\}\n\n"
      + "type Amount with Grow \{\n  fn step(self): Int \{\n    1\n  \}\n\}\n\n"
      + inBody("  const a = Amount()\n  print a.twice()")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("a.twice()") == "Int64")
  }

  test "a member of a supertrait, which a type that meets it implements" {
    const source = "type Amount with Compare \{\n  value: Int\n\n"
      + "  fn compare(self, other: Amount): Int \{\n    0\n  \}\n\n"
      + "  fn equals(self, other: Amount): Bool \{\n    true\n  \}\n\}\n\n"
      + inBody("  const a = Amount(1)\n  print a.equals(Amount(2))")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("a.equals(Amount(2))") == "Bool")
  }

  test "the dispatch says which implementation carries a member that comes from a trait" {
    const source = "trait Grow \{\n  fn step(self): Int\n\n  fn twice(self): Int \{\n    step() + step()\n  \}\n\}\n\n"
      + "type Amount with Grow \{\n  fn step(self): Int \{\n    1\n  \}\n\}\n\n"
      + inBody("  const a = Amount()\n  print a.twice()\n  print a.step()")
    const found = probe source
    assert(found.dispatchOf("a.twice") == "implementation Amount: Grow")
    // A member the type writes in its own body is an ordinary member and is reached directly
    assert(found.dispatchOf("a.step") == "direct")
  }

  test "a member of a trait-typed value is taken from its witness table" {
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + inBody("  fn draw(shape: Shape): Int \{\n    shape.area()\n  \}")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("shape.area()") == "Int64")
    assert(found.dispatchOf("shape.area") == "object Shape")
  }

  test "a member of a generic parameter comes from its bounds, and the caller passes the witness" {
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + "fn total<Item: Shape>(value: Item): Int \{\n  value.area()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("value.area()") == "Int64")
    assert(found.dispatchOf("value.area") == "forwarded Shape")
  }

  test "a member that no trait and no extension has is a mistake, with the nearest name as a note" {
    const source = "type Amount \{\n  value: Int\n\}\n\n" + inBody("  const a = Amount(1)\n  print a.valu")
    assert(problems(source) == ["`Amount` has no member `valu`"])
    assert(notes(source) == ["Did you mean `value`?"])
  }

  test "a member of a trait whose own parameters the receiver fills in" {
    const source = inBody "  const texts: List<String> = [\"a\"]\n  print texts.length()"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("texts.length()") == "Int64")
  }

  /** `Wide` is `From<Int8>` and `From<UInt8>`, so `Wide.from` is one name with two signatures. */
  const overloaded = "type Wide \{\n  value: Int\n\}\n\n"
    + "extend Wide with From<Int8> \{\n  fn from(value: Int8): Wide \{\n    Wide(1)\n  \}\n\}\n\n"
    + "extend Wide with From<UInt8> \{\n  fn from(value: UInt8): Wide \{\n    Wide(2)\n  \}\n\}\n\n"

  test "one name with several signatures is decided by the argument" {
    const source = overloaded + inBody("  const small: Int8 = 1\n  print Wide.from(small)")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Wide.from(small)") == "Wide")
  }

  test "an argument that none of the signatures takes says which ones exist" {
    const source = overloaded + inBody("  print Wide.from(\"a\")")
    assert(problems(source) == ["`from` takes none of these from a `String`"])
    assert(notes(source) == ["`from` exists for Int8, UInt8"])
  }
}

group "Traits as a namespace" {
  test "`Trait.member` reads the trait's own members first" {
    const source = "trait Shape \{\n  fn area(self): Int\n\n  fn unit(): Int \{\n    1\n  \}\n\}\n\n"
      + inBody("  print Shape.unit()")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Shape.unit()") == "Int64")
  }

  test "`Trait.member` reads the members of an implementation whose target is the trait itself" {
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + "type Square with Shape \{\n  fn area(self): Int \{\n    1\n  \}\n\}\n\n"
      + "extend Shape \{\n  fn unit(): Square \{\n    Square()\n  \}\n\}\n\n"
      + inBody("  print Shape.unit().area()")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Shape.unit()") == "Square")
  }
}

/**
 * An `extend` whose *target* is a trait type makes the trait-typed value the implementer (gap 53). Its **instance**
 * members reach a concrete implementer through the coercion of the receiver - that is what `extend<Item: Show>
 * List<Item> with Show` means by "every list is showable" - but it is not a blanket implementation *for* every
 * implementer: a member without `self` that answers `Self` would answer "some `List`" where an `ArrayList` is asked for.
 */
group "An `extend` of a trait type" {
  test "a static member that answers `Self` stays the trait's own: `ArrayList` has one candidate for `From`" {
    const source = "fn probe(numbers: List<Int>): ArrayList<Int> \{\n  numbers.to<ArrayList<Int>>()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.witnessesOf("numbers.to<ArrayList<Int>>()") == ["ArrayList<Item>: From<Iterable<Item>>"])
  }

  test "the trait itself is the one the extension implements" {
    const source = "fn probe(numbers: List<Int>): List<Int> \{\n  numbers.to<List<Int>>()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.witnessesOf("numbers.to<List<Int>>()") == ["List<Item>: From<Iterable<Item>>"])
  }

  test "a trait target with a bound of its own is reached the same way, and brings its inner witness" {
    const source = "fn probe(numbers: List<Int>): Set<Int> \{\n  numbers.to<Set<Int>>()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.witnessesOf("numbers.to<Set<Int>>()") == ["Set<Item>: From<Iterable<Item>> [Int64: Hash]"])
  }

  test "a concrete implementer of such a trait uses its own implementation, not the extension" {
    const source = "fn probe(numbers: List<Int>): TrieSet<Int> \{\n  numbers.to<TrieSet<Int>>()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.witnessesOf("numbers.to<TrieSet<Int>>()") == ["TrieSet<Item>: From<Iterable<Item>> [Int64: Hash]"])
  }

  test "an instance member of a trait-type extension still reaches a concrete receiver" {
    const source = "fn probe(numbers: ArrayList<Int>): String \{\n  numbers.show()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.dispatchOf("numbers.show()") == "implementation List<Item>: Show")
  }

  test "a type that implements neither is still told so" {
    const source = "fn probe(numbers: List<Int>): Int \{\n  numbers.to<Int>()\n\}"
    assert(problems(source) == ["`Int64` does not implement `From<Iterable<Int64>>`"])
  }

  test "`From` is the one trait a type implements several times, and `From<Never>` never hides another one" {
    // `String` has `From<Iterable<Char>>` of its own and the blanket `From<Never>` of gap 50: "the argument of `From`
    // for a `String`" has two answers, and "which of them takes an `Iterable`" has one
    const source = "fn probe(): String \{\n  const text: String = ['a', 'b']\n  text\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.collectionOf("['a', 'b']") == "from String of Char through String: From<Iterable<Char>>")
  }
}

group "Operators through their traits" {
  test "arithmetic takes `Other` and `Output` from the trait the left operand implements" {
    const source = "type Meters with Add<Meters, Meters> \{\n  value: Float\n\n"
      + "  fn add(self, other: Meters): Meters \{\n    Meters(value + other.value)\n  \}\n\}\n\n"
      + inBody("  const sum = Meters(1.0) + Meters(2.0)")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Meters(1.0) + Meters(2.0)") == "Meters")
    assert(found.dispatchOf("Meters(1.0) + Meters(2.0)") == "implementation Meters: Add<Meters, Meters>")
  }

  test "a type that does not implement the operator is told so" {
    const source = "type Meters \{\n  value: Float\n\}\n\n" + inBody("  const sum = Meters(1.0) + Meters(2.0)")
    assert(problems(source) == ["`Meters` does not implement `Add`, so `a + b` has no meaning for it"])
    assert(notes(source) == ["Operators are traits: a type has the ones it comes `with`, and nothing else"])
  }

  test "the right operand is checked against `Other`, so `Meters + Float` is a mistake" {
    const source = "type Meters with Add<Meters, Meters> \{\n  value: Float\n\n"
      + "  fn add(self, other: Meters): Meters \{\n    self\n  \}\n\}\n\n"
      + inBody("  const sum = Meters(1.0) + 2.0")
    assert(problems(source) == ["Expected `Meters`, found `Float64`"])
  }

  test "the arithmetic of the built-in numbers goes through `Signed`, `Numeric` and `Add<Self, Self>`" {
    const found = probe inBody("  const sum = 1 + 2\n  const share = 1.0 / 60.0")
    assert(found.typeOf("1 + 2") == "Int64")
    assert(found.typeOf("1.0 / 60.0") == "Float64")
  }

  test "`-a` is `Negate.negate`, and a type without it is told so" {
    const found = probe inBody("  const value = 1\n  const other = -value")
    assert(found.typeOf("-value") == "Int64")
    const source = "type Meters \{\n  value: Float\n\}\n\n"
      + inBody("  const distance = Meters(1.0)\n  const back = -distance")
    assert(problems(source) == ["`Meters` does not implement `Negate`, so `-a` has no meaning for it"])
  }

  test "a comparison is a `Bool`, and it records the `equals` or `compare` that runs" {
    const source = "type Amount with Equals, Compare \{\n  value: Int\n\n"
      + "  fn compare(self, other: Amount): Int \{\n    0\n  \}\n\n"
      + "  fn equals(self, other: Amount): Bool \{\n    true\n  \}\n\}\n\n"
      + inBody("  const same = Amount(1) == Amount(2)\n  const order = Amount(1) < Amount(2)")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Amount(1) == Amount(2)") == "Bool")
    assert(found.dispatchOf("Amount(1) == Amount(2)") == "implementation Amount: Equals")
    assert(found.dispatchOf("Amount(1) < Amount(2)") == "implementation Amount: Compare")
  }

  test "`&&`, `||` and `!` stay built in on `Bool` and are not traits (gap 21)" {
    const found = probe inBody("  const flag = true && !false\n  const other = flag || true")
    assert(found.typeOf("true && !false") == "Bool")
    assert(found.typeOf("!false") == "Bool")
    assert(found.typeOf("flag || true") == "Bool")
  }

  test "`a[key]` is `Indexed.at` and `a[from..to]` is `Slice.slice`" {
    const source = inBody "  const texts: List<String> = [\"a\"]\n  print texts[0]\n  print \"abc\"[0..2]"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("texts[0]") == "String")
    assert(found.typeOf("\"abc\"[0..2]") == "String")
  }

  test "a type that is not `Indexed` cannot be indexed" {
    const source = "type Amount \{\n  value: Int\n\}\n\n" + inBody("  const a = Amount(1)\n  print a[0]")
    assert(problems(source) == ["`Amount` does not implement `Indexed`, so `a[key]` has no meaning for it"])
  }

  test "a comparison asks for its trait like every other operator" {
    // 4.3 recorded the witness and said nothing where it found none, because the prelude had no `Equals` for its
    // collections; `std/collections` carries `Equals`, `Hash` and `Show` for `List`, `Set` and `Map` now
    const source = "type Button \{\n  handler: (Int) => Int\n\}\n\n"
      + "fn probe(a: Button, b: Button): Bool \{\n  a == b\n\}"
    assert(problems(source) == ["`Button` does not implement `Equals`, so `a == b` has no meaning for it"])
    assert(notes(source) == ["Operators are traits: a type has the ones it comes `with`, and nothing else"])
  }

  test "an order is a decision, so no `type` gets a derived `Compare`" {
    const source = "type Amount \{\n  value: Int\n\}\n\n"
      + "fn probe(a: Amount, b: Amount): Bool \{\n  a < b\n\}"
    assert(problems(source) == ["`Amount` does not implement `Compare`, so `a < b` has no meaning for it"])
  }

  test "a derived `Equals` is enough, and every spelling of the comparison finds it" {
    const source = "type Amount \{\n  value: Int\n\}\n\n"
      + "fn probe(a: Amount, b: Amount): Bool \{\n  a == b || a != b\n\}"
    assert problems(source).isEmpty()
  }

  test "a `shared type` has no derived `Equals`, so it has to write one" {
    const source = "shared type Session \{\n  var name: String = \"\"\n\}\n\n"
      + "fn probe(a: Session, b: Session): Bool \{\n  a == b\n\}"
    assert(problems(source) == ["`Session` does not implement `Equals`, so `a == b` has no meaning for it"])
  }
}

group "Interpolation and iteration" {
  test "every interpolated part records the `Show` implementation that renders it" {
    const source = "type Amount with Show \{\n  fn show(self): String \{\n    \"a\"\n  \}\n\}\n\n"
      + inBody("  const shown = \"value \{Amount()\}\"")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("\"value \{Amount()\}\"") == "String")
    assert(found.adaptationsOf("Amount()") == ["show through Amount: Show"])
  }

  test "a built-in number reaches `Show` through its supertraits, and the witness names the route" {
    const found = probe inBody("  const shown = \"value \{1 + 1\}\"")
    // `Int64 with Signed`, `Signed with Numeric`, `Numeric with Show`: the implementation that carries it is the one
    // the type wrote down, and the trait it satisfies is reached from there
    assert(found.adaptationsOf("1 + 1") == ["show through Int64: Signed"])
  }

  test "a `Show` that is generated for a type of the file is recorded as the implementation that was derived" {
    const source = "type Amount \{\n  value: Int\n\}\n\n" + inBody("  const shown = \"value \{Amount(2)\}\"")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.adaptationsOf("Amount(2)") == ["show through Amount: Show"])
  }

  test "`for` walks everything that implements `Iterable`, through an `extend` as well" {
    const source = inBody(
      "  const texts: List<String> = [\"a\"]\n  for part in texts \{\n    print (part)\n  \}\n"
        + "  for index in 0..2 \{\n    print (index)\n  \}"
    )
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.patternTypeOf("part") == "String")
    assert(found.patternTypeOf("index") == "Int64")
  }

  test "a subject that is not `Iterable` cannot be looped over" {
    const source = "type Amount \{\n  value: Int\n\}\n\n"
      + inBody("  const a = Amount(1)\n  for part in a \{\n    print (part)\n  \}")
    assert(problems(source) == ["`Amount` is not `Iterable`, so `for` cannot walk it"])
  }

  test "an interpolated part has to be `Show`" {
    // `Show` is derived for every type all of whose fields are `Show`, and a field that is a trait-typed value of
    // another trait is not one: nothing about an `Equals` says how to render it
    const source = "type Holder \{\n  item: Equals\n\}\n\n"
      + "fn probe(holder: Holder): String \{\n  \"\{holder\}\"\n\}"
    assert(problems(source) == ["`Holder` does not implement `Show`, so it cannot be interpolated"])
    assert(
      notes(source) == ["`with Show` on the declaration derives it for a type all of whose fields are `Show`"]
    )
  }
}

group "Coercion to a trait type" {
  test "a value becomes a trait-typed value, and every bound records its witness (gap 8)" {
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + "type Square with Shape \{\n  fn area(self): Int \{\n    1\n  \}\n\}\n\n"
      + inBody("  const shape: Shape = Square()")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.adaptationsOf("Square()") == ["trait value Shape"])
  }

  test "a value that does not implement the bound is told which one" {
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + "type Square \{\n  side: Int\n\}\n\n"
      + inBody("  const shape: Shape = Square(1)")
    assert(problems(source) == ["`Square` does not implement `Shape`"])
  }

  test "a trait value coerces to fewer bounds and to a supertrait" {
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + "fn narrow(value: Shape & Show): Shape \{\n  value\n\}"
    assert problems(source).isEmpty()
  }

  test "there is no variance: a `List<Square>` is not a `List<Shape>`" {
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + "type Square with Shape \{\n  fn area(self): Int \{\n    1\n  \}\n\}\n\n"
      + "fn widen(squares: List<Square>): List<Shape> \{\n  squares\n\}"
    assert(problems(source) == ["`List<Square>` does not implement `List<Shape>`"])
  }

  test "`Never` fits everywhere" {
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + "fn broken(): Shape \{\n  panic \"none\"\n\}"
    assert problems(source).isEmpty()
  }

  test "the coercion runs one way only: a trait value is not a concrete type" {
    // There is no coercion from a trait to a concrete type - the value behind a `Shape` may be a `Circle` - and a trait
    // type is a *decided* type, so this is an ordinary mismatch and not something the checker may stay quiet about
    const source = "trait Shape \{\n  fn area(self): Int\n\}\n\n"
      + "type Square with Shape \{\n  side: Int\n\n  fn area(self): Int \{\n    side\n  \}\n\}\n\n"
      + "fn wantsSquare(square: Square): Int \{\n  square.side\n\}\n\n"
      + "fn probe(shape: Shape): Int \{\n  wantsSquare shape\n\}"
    assert(problems(source) == ["Expected `Square`, found `Shape`"])
  }

  test "a collection where a scalar is expected is the same mismatch, because `List<Item>` is a trait" {
    const source = "fn takesInt(value: Int): Int \{\n  value\n\}\n\n"
      + "fn probe(numbers: List<Int>): Int \{\n  takesInt numbers\n\}"
    assert(problems(source) == ["Expected `Int64`, found `List<Int64>`"])
  }

  test "a map where a scalar is expected, too" {
    const source = "fn takesInt(value: Int): Int \{\n  value\n\}\n\n"
      + "fn probe(counts: Map<String, Int>): Int \{\n  takesInt counts\n\}"
    assert(problems(source) == ["Expected `Int64`, found `Map<String, Int64>`"])
  }

  test "a closure that produces a `List` where an `Iterable` is wanted still coerces inside its body" {
    // The closure's own result is the type that was asked for, because the body is what coerced: a function type has no
    // variance, so reading the body's `List<Int64>` back out here would report the closure a second time
    const source = "fn each<Item, Output>(items: List<Item>, transform: (value: Item) => Iterable<Output>): Int \{\n"
      + "  1\n\}\n\nfn probe(numbers: List<Int>): Int \{\n  each(numbers, \{ [_, _] \})\n\}"
    assert problems(source).isEmpty()
    assert(probe(source).typeOf("\{ [_, _] \}") == "(value: Int64) => Iterable<Int64>")
  }
}

/**
 * A trait-typed value carries a witness table per bound, so it satisfies a bound on any trait of the supertrait closure
 * of its own traits - not only when it is *coerced* to that trait, but also as the witness of a bound an implementation
 * asks for. `Result<Void, Error>` needs both: `Failure: Show` through `trait Error with Show`, and `Value: Show` from
 * the declaration of `Void`.
 */
const witnessSource = "trait Problem with Show \{\n  fn code(self): Int\n\}\n\n"
  + "fn render<Value: Show>(value: Value): String \{\n  \"\{value\}\"\n\}\n\n"
  + "fn one(problem: Problem): String \{\n  render(problem)\n\}\n\n"
  + "fn two(failed: Result<Int, Problem>): String \{\n  render(failed)\n\}\n\n"
  + "fn three(pair: Result<Int, Show & Hash>): String \{\n  render(pair)\n\}\n\n"
  + "fn four(nothing: Void): String \{\n  render(nothing)\n\}\n\n"
  + "fn five(done: Result<Void, Problem>): String \{\n  render(done)\n\}"

group "A bound a trait-typed value witnesses" {
  test "a value of a trait satisfies a bound on a trait its own trait requires" {
    assert problems(witnessSource).isEmpty()
    // The witness is the value's own table, which is what a back end reads at the call instead of a static one
    assert(probe(witnessSource).witnessesOf("render(problem)") == ["object Problem: Show"])
  }

  test "and it does so as the bound of an implementation, which is what `Result<_, Error>` needs" {
    // `extend<Value: Show, Failure: Show> Result<Value, Failure> with Show`: the inner witness for `Failure` is the
    // table the trait-typed value brings, so the whole tree is usable even though its root is a static implementation
    assert(
      probe(witnessSource).witnessesOf("render(failed)")
        == ["Result<Value, Failure>: Show [Int64: Signed, object Problem: Show]"]
    )
  }

  test "an `&` intersection witnesses the bound its parts cover" {
    assert(
      probe(witnessSource).witnessesOf("render(pair)")
        == ["Result<Value, Failure>: Show [Int64: Signed, object Show & Hash: Show]"]
    )
  }

  test "`Void` implements what its declaration in the standard library says" {
    // A signature says `Void` as the type of the language, and the traits it comes with are declared on the
    // `native type Void` of `std/core`: resolution asks about that one, so `Void` is `Show` like every other type
    const found = probe witnessSource
    assert(found.witnessesOf("render(nothing)") == ["Void: Show"])
    assert(found.witnessesOf("render(done)") == ["Result<Value, Failure>: Show [Void: Show, object Problem: Show]"])
  }

  test "a bound no trait of the value covers is still reported" {
    const source = "trait Problem \{\n  fn code(self): Int\n\}\n\n"
      + "fn render<Value: Show>(value: Value): String \{\n  \"\{value\}\"\n\}\n\n"
      + "fn report(problem: Problem): String \{\n  render(problem)\n\}"
    assert(problems(source) == ["`Problem` does not implement `Show`"])
    assert(notes(source) == ["`render` asks for it"])
  }
}
