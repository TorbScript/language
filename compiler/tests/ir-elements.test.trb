/**
 * Element descriptors and `ContainerNew`: what the one C list and the one C hash table know about their items, and
 * the one instruction the containers need of their own.
 *
 * The IR here is built by hand, because reaching a container literal from source needs the whole witness table of
 * `List<Item>` and that table's `Iterate` stages need closures of their own. What is pinned is therefore exactly the
 * two pieces this part of the lowering added: the descriptor as static data with its four function pointers, and the
 * instruction that makes a container over it.
 */

use test, group from "std/test"
use IrProgram, IrType, IrTypeId, IrSignature, IrParameter, Ownership, RuntimeKind from "../src/ir/ir"
use Slot, Instruction, Terminator, ElementDescriptor, WitnessTable, borrowed, owned from "../src/ir/ir"
use finishProgram from "../src/ir/layout"
use newFunction, addSlot, emit, terminate, finishFunction from "../src/ir/build"
use SlotRole from "../src/ir/ir"
use verifyProgram, verifyFunction from "../src/ir/verify"
use printFunction, printProgram from "../src/ir/print"
use emittedProgramText from "../src/backend/c/emit"
use elementName from "../src/ir/mangle"

/** A program with one function that makes an empty `ArrayList<Int>` and answers it. */
fn listProgram(): IrProgram {
  var program = IrProgram()
  const int64 = program.internType IrType.Integer(64, signed: true)
  const list = program.internType IrType.Runtime(RuntimeKind.ListStorage, [int64])
  const element = program.addElement ElementDescriptor(elementName(program, int64), int64, 0, 0)
  var builder = newFunction "t_main_numbers", None, IrSignature([], list), "body"
  const target = addSlot builder, list, SlotRole.Temporary, ""
  emit builder, Instruction.ContainerNew(target, RuntimeKind.ListStorage, [element])
  terminate builder, Terminator.Return(owned(target))
  const _ = finishFunction program, builder
  finishProgram program
  program
}

/** The same with a `Text` element, whose descriptor really retains and releases. */
fn textListProgram(): IrProgram {
  var program = IrProgram()
  const text = program.internType IrType.Text
  const list = program.internType IrType.Runtime(RuntimeKind.ListStorage, [text])
  const element = program.addElement ElementDescriptor(elementName(program, text), text, 0, 0)
  var builder = newFunction "t_main_texts", None, IrSignature([], list), "body"
  const target = addSlot builder, list, SlotRole.Temporary, ""
  emit builder, Instruction.ContainerNew(target, RuntimeKind.ListStorage, [element])
  terminate builder, Terminator.Return(owned(target))
  const _ = finishFunction program, builder
  finishProgram program
  program
}

group "an element descriptor" {
  test "is named after its element type alone and `finishProgram` fills in its size" {
    var program = listProgram()
    const descriptor = program.elements[0]
    assert(descriptor.name == "d_Int64")
    assert(descriptor.size == 8)
    assert(descriptor.alignment == 8)
    // `retain` and `release` are the emitter's, so the IR leaves them out
    assert(descriptor.retain == None)
    assert(descriptor.release == None)
  }

  test "one descriptor serves every container with that element" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const first = program.addElement ElementDescriptor(elementName(program, int64), int64, 0, 0)
    assert(program.elementNamed("d_Int64") == first)
    assert(program.elements.length() == 1)
  }

  test "a trivial element has no retain and no release in the C, and a counted one has both" {
    const trivial = emittedProgramText listProgram(), "t_main_numbers"
    assert trivial.contains("static const torb_element d_Int64 = \{ 8, 8, NULL, NULL, NULL, NULL \};")
    const counted = emittedProgramText textListProgram(), "t_main_texts"
    assert counted.contains("static void dR_String(void *element) \{")
    assert counted.contains("  *(torb_text *)element = torb_text_retained(*(torb_text *)element);")
    assert counted.contains("static void dD_String(void *element) \{")
    assert counted.contains("static const torb_element d_String = \{ 16, 8, dR_String, dD_String, NULL, NULL \};")
  }
}

group "`ContainerNew`" {
  test "is printed as the container it makes and the descriptors it makes it over" {
    var program = listProgram()
    const shown = printFunction program, program.functions[0]
    assert shown.contains("  %0 = new List(d_Int64)")
  }

  test "passes the verifier, and a descriptor of the wrong element type does not" {
    var program = listProgram()
    assert verifyProgram(program).isEmpty()
    var wrong = IrProgram()
    const int64 = wrong.internType IrType.Integer(64, signed: true)
    const text = wrong.internType IrType.Text
    const list = wrong.internType IrType.Runtime(RuntimeKind.ListStorage, [int64])
    const element = wrong.addElement ElementDescriptor(elementName(wrong, text), text, 0, 0)
    var builder = newFunction "t_main_numbers", None, IrSignature([], list), "body"
    const target = addSlot builder, list, SlotRole.Temporary, ""
    emit builder, Instruction.ContainerNew(target, RuntimeKind.ListStorage, [element])
    terminate builder, Terminator.Return(owned(target))
    const _ = finishFunction wrong, builder
    finishProgram wrong
    assert(verifyProgram(wrong) == ["t_main_numbers b0: the descriptor `d_String` is not the one of `Int64`"])
  }

  test "is one call of the runtime with the address of the static descriptor" {
    const shown = emittedProgramText listProgram(), "t_main_numbers"
    assert shown.contains("  s0 = torb_list_new(&d_Int64);")
  }
}
