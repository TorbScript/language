use test, group from "std/test"
use probe, problems, notes, problemsOf, notesOf from "./harness"

/**
 * Statements and blocks: bindings with irrefutable patterns, scopes and shadowing, assignment, the loops, `return`
 * and definite return, `break`/`continue`, and the rule that an expression statement has to have the type `Void` or
 * `Never` (gap 18).
 */
fn inBody(body: String): String {
  "fn probe() \{\n{body}\n\}"
}

group "Bindings" {
  test "the annotation decides, and without one the initializer does" {
    const found = probe inBody("  const inferred = 2\n  const annotated: Float = 3\n  const value = (annotated)")
    assert(found.typeOf("2") == "Int64")
    assert(found.typeOf("(annotated)") == "Float64")
  }

  test "the initializer is checked against the annotation" {
    assert(problems(inBody("  const value: Int = \"text\"")) == ["Expected `Int64`, found `String`"])
  }

  test "a wildcard discards on purpose and binds nothing" {
    assert(problems(inBody("  const _ = 1 + 2\n  const value = _")) == ["Cannot find `_` here"])
  }

  test "a tuple pattern binds every position with its own type" {
    const found = probe inBody("  const (first, second) = (1, \"one\")\n  const text = (second)")
    assert(found.typeOf("(second)") == "String")
    assert(found.patternTypeOf("(first, second)") == "(Int64, String)")
  }

  test "a tuple pattern with the wrong number of positions" {
    assert(
      problems(inBody("  const (first, second, third) = (1, \"one\")"))
        == ["This pattern has 3 positions, `(Int64, String)` has 2"]
    )
  }

  test "a type with fields is destructured by its own name" {
    const source = "type Point \{\n  x: Int\n  y: Int\n\}\n\n"
      + "fn probe(place: Point) \{\n  const Point(across, down) = place\n  const value = (down)\n\}"
    const found = probe source
    assert(found.typeOf("(down)") == "Int64")
    assert problems(source).isEmpty()
  }

  test "a destructuring binding at the top level of a file declares every name it binds" {
    // `checkTopLevelBinding` only looked at a plain name, so a top-level pattern declared nothing at all and the only
    // symptom was "Cannot find `quotient`" wherever it was read - inside a function body it always worked
    const source = "type Point \{\n  x: Int\n  y: Int\n\}\n\nconst Point(across, down) = Point(3, 4)\n"
      + "const (quotient, remainder) = divide(7, 2)\n\n"
      + "fn divide(a: Int, b: Int): (Int, Int) \{\n  (a / b, a % b)\n\}\n\n"
      + "fn fromAFunction(): Int \{\n  across + down\n\}\n\nconst shown = (quotient)\n"
      + "print shown, remainder, fromAFunction()"
    assert problems(source).isEmpty()
    const found = probe source
    // The names are declarations of the file and not locals of its statement sequence, which is what lets a function
    // of the module read one
    assert(found.patternTypeOf("(quotient, remainder)") == "(Int64, Int64)")
    assert(found.typeOf("(quotient)") == "Int64")
    assert(found.resolutionOf("(quotient)") == "constant quotient")
    assert(found.typeOf("across + down") == "Int64")
  }

  test "a top-level `var` pattern binds mutable names" {
    const source = "var (left, right) = (1, 2)\nleft = left + right\nprint left"
    assert problems(source).isEmpty()
  }

  test "a module's `const` binds one name, because it is folded and it is exported by name" {
    const files = [
      "app/src/helper.trb": "const (first, second) = (1, 2)\n\npublic fn total(): Int \{\n  first + second\n\}",
      "app/src/main.trb": "use total from \"./helper\"\n\nprint total()",
    ]
    assert(problemsOf(files) == ["A module's `const` binds one name"])
    assert(
      notesOf(files)
        == [
          "Bind the value and take it apart afterwards (`const shape = size()`, `const rows = shape.0`): a compile-time"
            + " constant is folded, and one that is exported is a name of the module",
        ]
    )
  }

  test "and neither does an exported one, wherever it stands" {
    const source = "public const (first, second) = (1, 2)\n\nprint first, second"
    assert(problems(source) == ["An exported `const` binds one name"])
  }

  test "a label in a pattern has to name the field at that position" {
    const source = "type Point \{\n  x: Int\n  y: Int\n\}\n\n"
      + "fn probe(place: Point) \{\n  const Point(y: across, x: down) = place\n\}"
    assert(
      problems(source) == ["This position is `x`, not `y`", "This position is `y`, not `x`"]
    )
    assert(
      notes(source)
        == ["The fields of a case are matched by position; a label has to name the field at that position"]
    )
  }

  test "a case of a type that is not there" {
    const source = "type Shape \{\n  case Circle(radius: Int)\n\}\n\n"
      + "fn probe(shape: Shape) \{\n  match shape \{\n    .Square(_) => print \"square\"\n  \}\n\}"
    assert(problems(source) == ["`Shape` has no case `Square`"])
  }

  test "a case that is given the wrong number of patterns" {
    const source = "type Shape \{\n  case Circle(radius: Int)\n\}\n\n"
      + "fn probe(shape: Shape) \{\n  match shape \{\n    .Circle(_, _) => print \"circle\"\n  \}\n\}"
    assert(problems(source) == ["`Circle` has 1 field, 2 patterns were given"])
  }

  test "an imported case is bare in a pattern, with fields and without" {
    const found = probe inBody("  const text = match Some(2) \{\n    Some(_) => \"one\"\n    None => \"none\"\n  \}")
    assert(found.patternTypeOf("None") == "Option<Int64>")
    assert problems(inBody("  const text = match Some(2) \{\n    Some(_) => \"one\"\n    None => \"none\"\n  \}")).isEmpty()
  }

  test "an aliased case works in an expression and in a pattern (`use Option.Some as Present`)" {
    // The local name is the alias and the case is declared under its own, and both positions looked it up by the name
    // that was *written*: an expression said "The checker did not work out the type of this expression" and a pattern
    // said "`Option<Int64>` has no case `Present`"
    const source = "use Option.Some as Present, Option.None as Nothing\n\n"
      + "fn one(): Int? \{\n  Present(1)\n\}\n\nfn empty(): Int? \{\n  Nothing\n\}\n\n"
      + "fn read(value: Int?): Int \{\n  match value \{\n    Present(number) => number\n    Nothing => 0\n  \}\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Present(1)") == "Option<Int64>")
    assert(found.resolutionOf("Present(1)") == "case Option<Int64>.Some")
    assert(found.patternTypeOf("Present(number)") == "Option<Int64>")
  }

  test "and it counts for exhaustiveness exactly as the declared name does" {
    const source = "use Option.Some as Present, Option.None as Nothing\n\n"
      + "fn read(value: Int?): Int \{\n  match value \{\n    Present(number) => number\n  \}\n\}"
    assert(problems(source) == ["`match` does not handle `.None`"])
  }

  test "an uppercase name that is no case in scope, instead of a catch-all binding" {
    const source = inBody "  const text = match Some(2) \{\n    Some(_) => \"one\"\n    Nome => \"none\"\n  \}"
    assert(problems(source) == ["`Nome` is not a case in scope"])
    const rule = "A name that starts with an uppercase letter is a case, never a binding: a binding starts lowercase"
    assert(notes(source)[0] == rule)
    // A case of the matched type that is close enough is offered, with the dot it would need if it is not imported
    const shapes = "type Shape \{\n  case Circle(radius: Int)\n  case Empty\n\}\n\n"
      + "fn probe(shape: Shape): Int \{\n  match shape \{\n    Cirle => 1\n    _ => 0\n  \}\n\}"
    assert(problems(shapes) == ["`Cirle` is not a case in scope"])
    assert(notes(shapes) == [rule, "Did you mean `.Circle`?"])
  }

  test "a bare case has to be a case of the matched type, not just of the same name" {
    const source = "type Node \{\n  case Leaf\n  case Fail\n\}\n\n"
      + "fn probe(node: Node): Int \{\n  match node \{\n    Fail => 1\n    _ => 0\n  \}\n\}"
    assert(problems(source) == ["`Fail` is the case `Result.Fail`, and the value matched is a `Node`"])
    assert(notes(source) == ["Write `.Fail` for the case of `Node`"])
    // With the dot it is the case of `Node` and there is nothing to report
    const dotted = "type Node \{\n  case Leaf\n  case Fail\n\}\n\n"
      + "fn probe(node: Node): Int \{\n  match node \{\n    .Fail => 1\n    _ => 0\n  \}\n\}"
    assert problems(dotted).isEmpty()
  }

  test "a bare case of another type that the matched type does not have at all keeps the older message" {
    const source = "type Node \{\n  case Leaf\n\}\n\n"
      + "fn probe(node: Node): Int \{\n  match node \{\n    Fail => 1\n    _ => 0\n  \}\n\}"
    assert(problems(source) == ["`Node` has no case `Fail`"])
  }

  test "a binding starts with a lowercase letter, and an underscore keeps its own rule" {
    // `found` is read, because a binding of an arm nobody reads is an error of its own (milestone 4.10)
    assert problems(inBody("  const text = match 1 \{\n    found => found\n  \}")).isEmpty()
    assert problems(inBody("  const text = match 1 \{\n    _found => \"one\"\n  \}")).isEmpty()
    // Even where nothing about the subject has cases, an uppercase name is not a binding
    assert(
      problems(inBody("  const text = match 1 \{\n    Found => \"one\"\n  \}"))
        == ["`Found` is not a case in scope"]
    )
  }
}

group "Scopes" {
  test "a nested scope may shadow a name" {
    const source = inBody "  const value = 1\n  if true \{\n    const value = \"text\"\n    print value\n  \}"
    assert problems(source).isEmpty()
  }

  test "the same scope may not declare a name twice" {
    assert(
      problems(inBody("  const value = 1\n  const value = 2")) == ["`value` is already declared in this scope"]
    )
  }

  test "the parameters and the top level of the body are one scope (milestone 4.9)" {
    assert(
      problems("fn probe(value: Int) \{\n  const value = 2\n  print value\n\}")
        == ["`value` is already a parameter of this function"]
    )
  }

  test "a name a block binds is gone after it" {
    const source = inBody "  if true \{\n    const inner = 1\n  \}\n  const value = inner"
    assert(problems(source) == ["Cannot find `inner` here"])
  }

  test "the pattern of an `if const` binds for the body of the `if` only" {
    const source = inBody(
      "  const maybe: Int? = None\n  if const Some(found) = maybe \{\n    print found\n  \}\n  const value = found"
    )
    assert(problems(source) == ["Cannot find `found` here"])
  }

  test "a `match` arm binds for its own body only" {
    const source = "type Shape \{\n  case Circle(radius: Int)\n  case Empty\n\}\n\n"
      + "fn probe(shape: Shape) \{\n  match shape \{\n    .Circle(radius) => print radius\n    .Empty => print \"none\"\n  \}\n  const value = radius\n\}"
    assert(problems(source) == ["Cannot find `radius` here"])
  }
}

group "Assignment" {
  test "the value is checked against the type of the place" {
    const source = "type Counter \{\n  var value: Int\n\n  fn reset(var self) \{\n    value = \"none\"\n  \}\n\}"
    assert(problems(source) == ["Expected `Int64`, found `String`"])
  }

  test "assigning to a local of the same type is fine" {
    assert problems(inBody("  var total = 0\n  total = total + 1\n  print total")).isEmpty()
  }
}

group "Loops" {
  test "`for` over a `Range<Int>` binds an `Int64`" {
    const found = probe inBody("  for position in 0..10 \{\n    const shown = (position)\n    print shown\n  \}")
    assert(found.patternTypeOf("position") == "Int64")
    assert(found.typeOf("(position)") == "Int64")
  }

  test "`for` over a `List<Item>` binds the item type its `Iterable` says" {
    const found = probe inBody("  const texts: List<String> = [\"a\"]\n  for part in texts \{\n    print (part)\n  \}")
    assert(found.patternTypeOf("part") == "String")
  }

  test "the condition of a `while` has to be a `Bool`" {
    assert(problems(inBody("  while 1 \{\n    print \"loop\"\n  \}")) == ["Expected `Bool`, found `Int64`"])
  }

  test "`break` and `continue` need an enclosing loop" {
    const source = inBody "  break"
    assert(problems(source) == ["`break` is only allowed inside of a `for` or a `while`"])
    assert(
      notes(source)
        == ["A closure is a function, not a block: `break` cannot leave one, and `do \{ \}` is not a loop either"]
    )
    assert(problems(inBody("  continue")) == ["`continue` is only allowed inside of a `for` or a `while`"])
    assert problems(inBody("  for index in 0..2 \{\n    break\n  \}")).isEmpty()
  }
}

group "Returning" {
  test "`return` is checked against the declared result" {
    assert(problems("fn probe(): Int \{\n  return \"text\"\n\}") == ["Expected `Int64`, found `String`"])
  }

  test "a body whose last statement is not an expression at all" {
    assert(
      problems("fn probe(): Float \{\n  const value = 1\n\}") == ["This function has to return a `Float64`"]
    )
  }

  test "a body that ends in an expression of the wrong type is told about that expression" {
    assert(problems("fn probe(): Float \{\n  print \"nothing\"\n\}") == ["Expected `Float64`, found `Void`"])
  }

  test "a body that returns on every path is fine, and so is one that panics" {
    assert problems("fn probe(value: Bool): Int \{\n  if value \{\n    return 1\n  \}\n  2\n\}").isEmpty()
    assert problems("fn probe(): Int \{\n  panic \"never\"\n\}").isEmpty()
  }

  test "`while true` without a `break` never ends, so nothing has to follow it" {
    assert problems("fn probe(): Int \{\n  while true \{\n    print \"forever\"\n  \}\n\}").isEmpty()
  }

  test "a `return` without a value in a function that has a result" {
    assert(problems("fn probe(): Int \{\n  return\n\}") == ["This function has to return a `Int64`"])
  }

  test "a bare `return` makes an inferred result `Void`, even out of a loop that never ends" {
    // The block of `while true` without a `break` is `Never`, and the `return` inside it does leave the function -
    // so what the function produces is nothing, not "it never returns"
    const body = "fn recover(var flag: Bool) \{\n  while true \{\n    if flag \{\n      return\n    \}\n    flag = true\n  \}\n\}\n\n"
    assert(problems(body + "fn caller(var flag: Bool): Int \{\n  const nothing: Int = recover(flag)\n  1\n\}") == ["Expected `Int64`, found `Void`"])
    // As a statement it is fine, which is what an inferred `Never` allowed as well
    assert problems(body + "fn caller(var flag: Bool): Int \{\n  recover(flag)\n  1\n\}").isEmpty()
  }
}

group "Discarded values" {
  const holder = "type Holder \{\n  var value: Int\n\n  fn add(var self, more: Int) \{\n    value = value + more\n  \}\n\n  fn added(self, more: Int): Int \{\n    value + more\n  \}\n\}\n\n"

  test "a call whose result is dropped and that changes nothing" {
    const source = "{holder}fn probe(box: Holder) \{\n  box.added(1)\n  print \"done\"\n\}"
    assert(problems(source) == ["The result of `added` is not used"])
    assert(notes(source) == ["Did you mean `add`? Discard it on purpose with `const _ = ...`"])
  }

  test "a call with a `var` receiver stays a statement: the change is the effect" {
    assert problems("{holder}fn probe(var box: Holder) \{\n  box.add(1)\n  print \"done\"\n\}").isEmpty()
  }

  test "a value that is not a call at all" {
    const source = inBody "  1 + 2\n  print \"done\""
    assert(problems(source) == ["This value is not used"])
    assert(notes(source) == ["Discard it on purpose with `const _ = ...`"])
  }

  test "`const _ = ...` discards on purpose" {
    assert problems("{holder}fn probe(box: Holder) \{\n  const _ = box.added(1)\n\}").isEmpty()
  }

  test "every arm of a `match` that is used as a statement is checked as one" {
    const source = "{holder}fn probe(box: Holder, value: Bool): Void \{\n"
      + "  match value \{\n    true => box.added(1)\n    false => print \"no\"\n  \}\n\}"
    assert(problems(source) == ["The result of `added` is not used"])
  }
}
