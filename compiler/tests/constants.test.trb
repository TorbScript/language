/**
 * Top-level constants of a module. Their initializers have to be **compile-time evaluable**, which is what removes
 * module initialization order and makes a cyclic import harmless: literals, the arithmetic, comparison and logical
 * operators of the built-in number types and of `Bool`, interpolation, tuple, list and map literals of such,
 * constructor and case-constructor calls whose arguments are such, and other compile-time constants.
 *
 * Because the checker evaluates those operators anyway, overflow and a division by zero are compile errors at the
 * expression that does them, instead of a program that cannot start.
 *
 * In an entry file a top-level `const` is ordinary code, so every source here is a module that `main.trb` imports.
 */

use test, group from "std/test"
use problemsOf, notesOf from "./harness"

const importsHelper = raw"""
  use value from "./helper"

  fn probe(): Int {
    1
  }
  """

fn withHelper(helper: String): Map<String, String> {
  ["app/src/helper.trb": "public const value = 1\n{helper}", "app/src/main.trb": importsHelper]
}

group "What is compile-time evaluable" {
  test "literals of every kind" {
    const files = withHelper(raw"""
      const answer = 42
      const hex = 0xFF
      const ratio = 1.5
      const negative = -7
      const letter = 'A'
      const flag = true
      const name = "world"
      """)
    assert problemsOf(files).isEmpty()
  }

  test "the arithmetic, comparison and logical operators of the number types and of `Bool`" {
    const files = withHelper(raw"""
      const frameTime = 1.0 / 60.0
      const half = 10 / 2
      const rest = 10 % 3
      const total = 2 * 3 + 1
      const isLarge = total > 6
      const both = isLarge && true
      const other = !both
      """)
    assert problemsOf(files).isEmpty()
  }

  test "interpolation, because it is not a function call" {
    const files = withHelper(raw"""
      const version = 1
      const tag = "v{version}"
      """)
    assert problemsOf(files).isEmpty()
  }

  test "tuple, list and map literals of such" {
    const files = withHelper(raw"""
      const pair = (1, "one")
      const items = [1, 2, 3]
      const table = ["a": 1, "b": 2]
      const nested = [(1, "one")]
      """)
    assert problemsOf(files).isEmpty()
  }

  test "a constructor call and a case constructor call" {
    const files = withHelper(raw"""
      const origin = Point(0, 0)
      const nothing: Int? = None
      const some = Some(1)

      type Point {
        x: Int
        y: Int
      }
      """)
    assert problemsOf(files).isEmpty()
  }

  test "another compile-time constant, of this module or of another one" {
    const files = [
      "app/src/first.trb": raw"""
        public const base = 10
        """,
      "app/src/helper.trb": raw"""
        use base from "./first"

        public const value = base * 2
        """,
      "app/src/main.trb": importsHelper,
    ]
    assert problemsOf(files).isEmpty()
  }

  test "a `UInt64` above the largest `Int64`, and what the operators make of one" {
    const files = withHelper(raw"""
      const offset: UInt64 = 0xcbbb9d5dc1059ed8
      const largest: UInt64 = 18446744073709551615
      const all: UInt64 = ~0
      const high: UInt64 = 1 << 63
      const mixed: UInt64 = offset ^ 1
      const sum: UInt64 = high + 1
      const isHigh = offset > high
      const both = isHigh && true
      """)
    assert problemsOf(files).isEmpty()
  }

  test "a `UInt64` folds in its own range, across the largest `Int64` and back" {
    const files = withHelper(raw"""
      const top: UInt64 = 9223372036854775807 + 1
      const largest: UInt64 = 18446744073709551615
      const below: UInt64 = largest - 1
      const half: UInt64 = largest / 2 + 1
      const rest: UInt64 = largest % 10
      const power: UInt64 = 2 ** 63 + (2 ** 63 - 1)
      const product: UInt64 = 4294967296 * 4294967295
      const logical: UInt64 = largest >> 60
      const isLarger = largest > top
      const isSame = half == top
      """)
    assert problemsOf(files).isEmpty()
  }

  test "a field default of a `UInt64` above the largest `Int64`" {
    const files = withHelper(raw"""
      type Hasher {
        state: UInt64 = 0xcbbb9d5dc1059ed8
        mask: UInt64 = ~0
      }
      """)
    assert problemsOf(files).isEmpty()
  }
}

group "What is not" {
  test "a function call" {
    const files = withHelper(raw"""
      const answer = twice(21)

      fn twice(number: Int): Int {
        number * 2
      }
      """)
    assert(problemsOf(files) == ["The initializer of a top-level `const` has to be known at compile time"])
    assert(
      notesOf(files)
        == [
          "A module has no initialization order: literals, the operators of the number types and of `Bool`,"
            + " interpolation, tuple, list and map literals, constructor calls of such, and other compile-time"
            + " constants. `Point(0, 0)` is one, `Point.origin()` is a call and is not",
        ],
    )
  }

  test "a `native` call, which `+` on a `String` is one of" {
    const files = withHelper(raw"""
      const greeting = "hello" + " world"
      """)
    assert(problemsOf(files) == ["The initializer of a top-level `const` has to be known at compile time"])
  }

  test "a static function of a type" {
    const files = withHelper(raw"""
      const origin = Point.zero()

      type Point {
        x: Int
        y: Int

        static fn zero(): Point {
          Point(0, 0)
        }
      }
      """)
    assert(problemsOf(files) == ["The initializer of a top-level `const` has to be known at compile time"])
  }

  test "a constant that is defined through a call" {
    const files = withHelper(raw"""
      const answer = twice(21)
      const doubled = answer

      fn twice(number: Int): Int {
        number * 2
      }
      """)
    assert(
      problemsOf(files)
        == [
          "The initializer of a top-level `const` has to be known at compile time",
          "The initializer of a top-level `const` has to be known at compile time",
        ],
    )
  }

  test "a `copy` of a constant, which is a call like any other" {
    const files = withHelper(raw"""
      const origin = Point(0, 0)
      const moved = origin.copy(x: 1)

      type Point {
        x: Int
        y: Int
      }
      """)
    assert(problemsOf(files) == ["The initializer of a top-level `const` has to be known at compile time"])
  }

  test "an entry file is ordinary code, and asks none of this" {
    const files = [
      "app/src/main.trb": raw"""
        const answer = twice(21)

        fn twice(number: Int): Int {
          number * 2
        }

        print answer
        """,
    ]
    assert problemsOf(files).isEmpty()
  }
}

group "Overflow and a division by zero are caught where they are written (BACKEND gap 11)" {
  test "an addition that leaves `Int64`" {
    const files = withHelper(raw"""
      const tooLarge = 9223372036854775807 + 1
      """)
    assert(problemsOf(files) == ["This does not fit into an `Int64`"])
    assert(
      notesOf(files)
        == [
          "A compile-time constant is evaluated while the program is compiled, so an overflow it is written with is"
            + " caught here",
        ],
    )
  }

  test "a subtraction that leaves it at the other end" {
    const files = withHelper(raw"""
      const tooSmall = -9223372036854775807 - 2
      """)
    assert(problemsOf(files) == ["This does not fit into an `Int64`"])
  }

  test "a multiplication that leaves it" {
    const files = withHelper(raw"""
      const tooLarge = 4294967296 * 4294967296
      """)
    assert(problemsOf(files) == ["This does not fit into an `Int64`"])
  }

  test "a power folds, up to the smallest `Int64` and no further" {
    const files = withHelper(raw"""
      const kilobyte = 2 ** 10
      const tower = 2 ** 3 ** 2
      const smallest = (-2) ** 63
      const largest = 3 ** 39
      const one = 0 ** 0
      """)
    assert problemsOf(files).isEmpty()
  }

  test "a power that leaves it" {
    const files = withHelper(raw"""
      const tooLarge = 2 ** 63
      """)
    assert(problemsOf(files) == ["This does not fit into an `Int64`"])
  }

  test "an integer raised to a negative power" {
    const files = withHelper(raw"""
      const broken = 2 ** -1
      """)
    assert(problemsOf(files) == ["This raises an integer to a negative power, which is not a whole number"])
  }

  test "the bit operators fold, in the width of their type" {
    const files = withHelper(raw"""
      const bit = 1 << 4
      const mask = 0xFF & 0x0F | 0x30
      const flipped = 5 ^ 3
      const all: UInt8 = ~0
      const high: Int8 = 1 << 7
      const back = -16 >> 2
      """)
    assert problemsOf(files).isEmpty()
  }

  test "a shift by the width or more" {
    const files = withHelper(raw"""
      const broken = 1 << 64
      """)
    assert(problemsOf(files) == ["This shifts by 64, which is not between 0 and 63"])
  }

  test "a power of a float is no compile-time constant: its last bit is the C library's" {
    const files = withHelper(raw"""
      const root = 2.0 ** 0.5
      """)
    assert(problemsOf(files) == ["The initializer of a top-level `const` has to be known at compile time"])
  }

  test "the negation of the smallest `Int64`" {
    const files = withHelper(raw"""
      const smallest = -9223372036854775807 - 1
      const flipped = 0 - smallest
      """)
    assert(problemsOf(files) == ["This does not fit into an `Int64`"])
  }

  test "the smallest `Int64` itself is fine, and so is the largest" {
    const files = withHelper(raw"""
      const smallest = -9223372036854775807 - 1
      const largest = 9223372036854775807
      const sum = smallest + largest
      """)
    assert problemsOf(files).isEmpty()
  }

  test "an integer division by zero" {
    const files = withHelper(raw"""
      const broken = 1 / 0
      """)
    assert(problemsOf(files) == ["This divides by zero"])
    assert(
      notesOf(files)
        == [
          "A compile-time constant is evaluated while the program is compiled, so a program that cannot start does"
            + " not compile",
        ],
    )
  }

  test "a remainder by zero" {
    const files = withHelper(raw"""
      const broken = 1 % 0
      """)
    assert(problemsOf(files) == ["This divides by zero"])
  }

  test "a floating point division by zero, which would be an infinity" {
    const files = withHelper(raw"""
      const broken = 1.0 / 0.0
      """)
    assert(problemsOf(files) == ["This divides by zero"])
  }

  test "the division that is written through a constant is caught too" {
    const files = withHelper(raw"""
      const zero = 3 - 3
      const broken = 60 / zero
      """)
    assert(problemsOf(files) == ["This divides by zero"])
  }

  test "a `UInt64` that leaves its range above the largest `Int64` is caught here, not at run time" {
    const files = withHelper(raw"""
      const past: UInt64 = 18446744073709551615 + 1
      """)
    assert(problemsOf(files) == ["This does not fit into a `UInt64`"])
    assert(
      notesOf(files)
        == [
          "A compile-time constant is evaluated while the program is compiled, so an overflow it is written with is"
            + " caught here",
        ],
    )
  }

  test "every operator of a `UInt64` is held to its range, below zero as well" {
    const files = withHelper(raw"""
      const doubled: UInt64 = 9223372036854775808 * 2
      const both: UInt64 = 9223372036854775808 + 9223372036854775808
      const tooHigh: UInt64 = 2 ** 64
      const belowZero: UInt64 = 1 - 2
      """)
    assert(
      problemsOf(files)
        == [
          "This does not fit into a `UInt64`",
          "This does not fit into a `UInt64`",
          "This does not fit into a `UInt64`",
          "This does not fit into a `UInt64`",
        ],
    )
  }

  test "a `UInt64` above the largest `Int64` is still held to a divisor of zero and to the width of a shift" {
    const files = withHelper(raw"""
      const broken: UInt64 = 0xcbbb9d5dc1059ed8 / 0
      const shifted: UInt64 = 0xcbbb9d5dc1059ed8 << 64
      """)
    assert(problemsOf(files) == ["This divides by zero", "This shifts by 64, which is not between 0 and 63"])
  }
}
