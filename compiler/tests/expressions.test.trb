/**
 * The type of every expression the checker understands on its own: literals with their adaptation, names, members,
 * operators, `if` and `match` as expressions. What needs traits, generics or a closure body is `unchecked` here and
 * stays free of messages - `torb check --statistics` counts those, and the last group of this file asserts that it
 * does.
 */

use test, group from "std/test"
use probe, problems, notes from "./harness"

/** The source inside of a `fn probe()` body, so that an expression can be looked at without a declaration around it. */
fn inBody(body: String): String {
  "fn probe() \{\n{body}\n\}"
}

group "Literals" {
  test "an integer is `Int64` and a decimal is `Float64` without an expectation" {
    const found = probe inBody("  const number = 42\n  const fraction = 1.5")
    assert(found.typeOf("42") == "Int64")
    assert(found.typeOf("1.5") == "Float64")
  }

  test "a literal adapts to the type that is expected of it" {
    const found = probe inBody("  const small: Int8 = 7\n  const exact: Float32 = 9\n  const wide: Float64 = 1.5")
    assert(found.typeOf("7") == "Int8")
    assert(found.typeOf("9") == "Float32")
    assert(found.typeOf("1.5") == "Float64")
  }

  test "every literal records what it became, because a back end must not decide what `1` is" {
    const found = probe inBody("  const small: Int8 = 7")
    assert(found.adaptationsOf("7") == ["literal Int8"])
  }

  test "a hexadecimal or binary literal is an integer, and a floating-point type does not take one" {
    assert(
      problems(inBody("  const mask: Float64 = 0xFF"))
        == ["`0xFF` is written in another base, and only an integer type takes it: `Float64` is not one"],
    )
    assert(problems(inBody("  const flags: Float32 = 0b1010")).length() == 1)
    assert problems(inBody("  const byte: UInt8 = 0xFF\n  const wide: Float64 = 255")).isEmpty()
  }

  test "a literal that does not fit the type it adapts to is an error" {
    assert(problems(inBody("  const small: Int8 = 300")) == ["`300` does not fit into `Int8`"])
    assert(problems(inBody("  const byte: UInt8 = -1")) == ["`-1` does not fit into `UInt8`"])
    assert(problems(inBody("  const wide: Int32 = 2147483648")) == ["`2147483648` does not fit into `Int32`"])
  }

  /**
   * The literal is read in the expected type, never as an `Int64` first: a `UInt64` takes the upper half an `Int64`
   * lacks (`tests/conformance/unsigned-literal.trb`, since the miniature prelude has no `UInt64`), and everywhere else
   * such a literal names the type it does not fit.
   */
  test "a literal above the largest `Int64` names the type it was expected as" {
    const wide = "`9223372036854775808` does not fit into `Int64`"
    assert(problems(inBody("  const wide = 9223372036854775808")) == [wide])
    const narrow = "`0xFFFFFFFFFFFFFFFF` does not fit into `Int32`"
    assert(problems(inBody("  const narrow: Int32 = 0xFFFFFFFFFFFFFFFF")) == [narrow])
    const over = "`18446744073709551616` does not fit into any integer type"
    assert(problems(inBody("  const over = 18446744073709551616")) == [over])
  }

  test "an integer literal in a base keeps the way it was written in the message" {
    assert(problems(inBody("  const small: Int8 = 0xFFF")) == ["`0xFFF` does not fit into `Int8`"])
  }

  test "`true`, `'a'` and a text are their own types" {
    const found = probe inBody("  const yes = true\n  const letter = 'a'\n  const text = \"hello\"")
    assert(found.typeOf("true") == "Bool")
    assert(found.typeOf("'a'") == "Char")
    assert(found.typeOf("\"hello\"") == "String")
  }

  test "a literal adapts to a literal type that contains it, and not to one that does not" {
    const source = inBody "  const state: \"on\" | \"off\" = (\"on\")"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("(\"on\")") == "\"off\" | \"on\"")
    assert(
      problems(inBody("  const state: \"on\" | \"off\" = \"idle\"")) == ["Expected `\"off\" | \"on\"`, found `String`"],
    )
  }

  test "an interpolated text is a `String`, and every part of it is looked at" {
    const found = probe inBody("  const greeting = \"hello \{(1 + 2)\}\"")
    assert(found.typeOf("\"hello \{(1 + 2)\}\"") == "String")
    assert(found.typeOf("(1 + 2)") == "Int64")
  }

  test "a tuple is the types of its parts, with the labels that were written" {
    const found = probe inBody("  const pair = (1, \"one\")\n  const bounds = (lowest: 1, highest: 9)")
    assert(found.typeOf("(1, \"one\")") == "(Int64, String)")
    assert(found.typeOf("(lowest: 1, highest: 9)") == "(lowest: Int64, highest: Int64)")
  }

  test "the labels of a tuple survive inference, which is what lets `indexed()` answer `(index:, item:)`" {
    const source = "fn paired<Item>(value: Item): (index: Int, item: Item) \{\n  (index: 0, item: value)\n\}\n\n"
      + inBody("  const pair = paired(\"a\")\n  const shown = pair.item")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("paired(\"a\")") == "(index: Int64, item: String)")
    assert(found.typeOf("pair.item") == "String")
  }

  test "a label at a position that has another name is an error, so a swap cannot happen silently" {
    const source = inBody "  const bounds: (lowest: Int, highest: Int) = (highest: 1, lowest: 9)"
    assert(problems(source) == ["This position is `lowest`, not `highest`", "This position is `highest`, not `lowest`"])
    assert(notes(source) == ["A label is a name for a position of a tuple: the positions have to line up"])
  }

  test "a list literal is a `List<Item>`, and the first item decides what `Item` is" {
    const found = probe inBody("  const numbers = [1, 2, 3]")
    assert(found.typeOf("[1, 2, 3]") == "List<Int64>")
  }

  test "the items of a list are checked against the type that is expected of the whole" {
    assert(problems(inBody("  const numbers: List<Int> = [1, \"two\"]")) == ["Expected `Int64`, found `String`"])
  }

  test "`0..10` is a `Range<Int64>`" {
    const found = probe inBody("  const range = 0..10")
    assert(found.typeOf("0..10") == "Range<Int64>")
  }

  test "`void` is the one value of `Void`, and `Void` in an expression teaches that" {
    const found = probe inBody("  const nothing: Void = (void)")
    assert(found.typeOf("(void)") == "Void")
    assert problems(inBody("  const nothing: Void = (void)")).isEmpty()
    const wrong = inBody "  const nothing: Void = Void"
    assert(problems(wrong) == ["`Void` is a type, not a value: its one value is written `void`"])
    assert(notes(wrong) == ["`void` is to `Void` what `true` and `false` are to `Bool`"])
  }
}

group "Names" {
  test "a local wins over everything, and what it resolved to is recorded" {
    const found = probe inBody("  const value = 1\n  const other = (value)")
    assert(found.typeOf("(value)") == "Int64")
    assert(found.resolutionOf("(value)") == "local value")
  }

  test "a name that is nowhere" {
    assert(problems(inBody("  const value = missing")) == ["Cannot find `missing` here"])
  }

  test "a top-level `const` without an annotation takes the type of its initializer" {
    const found = probe "const size = 8\n\nfn probe(): Int \{\n  (size)\n\}"
    assert(found.typeOf("(size)") == "Int64")
    assert(found.resolutionOf("(size)") == "constant size")
  }

  test "a `const` that is defined in terms of itself" {
    assert(
      problems("const first = second\nconst second = first")
        == ["The type of `first` cannot be inferred: its value is defined in terms of itself"],
    )
  }

  test "a function without a declared result takes the type of its body" {
    const found = probe "fn eight() \{\n  8\n\}\n\nfn probe(): Int \{\n  (eight())\n\}"
    assert(found.typeOf("(eight())") == "Int64")
  }

  test "a recursive function whose body produces a value has to annotate its result" {
    const source = "fn count(value: Int) \{\n  if value <= 0 \{\n    return 0\n  \}\n  count(value - 1)\n\}"
    assert(problems(source) == ["The return type of `count` cannot be inferred: it calls itself. Annotate it"])
  }

  test "a recursive function that returns nothing needs no annotation" {
    assert problems("fn walk(value: Int) \{\n  if value > 0 \{\n    walk(value - 1)\n  \}\n\}").isEmpty()
  }
}

group "Members" {
  const point = "type Point \{\n  x: Int\n  var y: Int\n\n  fn area(): Int \{\n    (x) * y\n  \}\n\}\n\n"

  test "a field of a value, and what the access resolved to" {
    const found = probe "{point}fn probe(place: Point): Int \{\n  place.x\n\}"
    assert(found.typeOf("place.x") == "Int64")
    assert(found.resolutionOf("place.x") == "field Point.x")
  }

  test "a method read without a call is the member bound to its receiver" {
    const found = probe "{point}fn probe(place: Point) \{\n  const size = place.area\n\}"
    assert(found.typeOf("place.area") == "() => Int64")
  }

  /** A function value is shown as its type, which is never what `"{place.area}"` meant (bug batch 7). */
  test "a method read without a call where it is shown is the forgotten call, with the call to write" {
    const source = "{point}fn probe(place: Point): String \{\n  \"size \{place.area\}\"\n\}"
    assert(problems(source) == ["`area` is a method, and this shows the method instead of its answer"])
    const note = "Did you mean `place.area()`? Without the call the text would be its type, `() => Int64`"
    assert(notes(source) == [note])
  }

  test "and so is one handed to `print`, while a function value in a binding is shown as its type" {
    const shown = "{point}fn probe(place: Point) \{\n  print place.area\n\}"
    assert(problems(shown) == ["`area` is a method, and this shows the method instead of its answer"])
    const bound = "{point}fn probe(place: Point) \{\n  const size = place.area\n  print \"\{size\} \{Point.area\}\"\n\}"
    assert problems(bound).isEmpty()
  }

  test "a method read through its type is the member itself" {
    const found = probe "{point}fn probe() \{\n  const size = Point.area\n\}"
    assert(found.typeOf("Point.area") == "(self: Point) => Int64")
  }

  /**
   * `Void` is the type with exactly one value, so a member it has not is an ordinary mistake. It used to say nothing at
   * all, which left the expression untyped and the reader with "this is a bug of the compiler" (LINEAR gap 13).
   */
  test "a member `Void` has not is named, with the command-call trap the line usually is" {
    const source = "fn probe() \{\n  print(1).round()\n\}"
    assert(problems(source) == ["`Void` has no member `round`"])
    assert(
      notes(source) == [
        "A call that produces nothing has the type `Void`. A `(` right after the name of a call is its argument list, "
          + "whatever whitespace stands in between, so `f (x).round()` reads as `f(x).round()`: write "
          + "`f((x).round())`, or bind the value first",
      ],
    )
  }

  test "and the spelling with a space says the same thing, because whitespace decides nothing" {
    const source = "fn probe() \{\n  print (0..4).length()\n\}"
    assert(problems(source) == ["`Void` has no member `length`"])
  }

  test "the way to write it checks" {
    const source = "{point}fn probe() \{\n  print((Point(1, 2)).area())\n\}"
    assert problems(source).isEmpty()
  }

  test "a field of `self` is reachable by its bare name, and the receiver is recorded" {
    const found = probe point
    assert(found.typeOf("(x) * y") == "Int64")
    assert(found.typeOf("(x)") == "Int64")
    assert(found.resolutionOf("(x)") == "field Point.x")
    assert(found.adaptationsOf("(x)") == ["self self"])
  }

  test "a member that is not there, with the nearest one as a note" {
    const source = "{point}fn probe(place: Point): Int \{\n  place.aera\n\}"
    assert(problems(source) == ["`Point` has no member `aera`"])
    assert(notes(source) == ["Did you mean `area`?"])
  }

  test "the positions and the labels of a tuple" {
    const found = probe(
      inBody("  const bounds = (lowest: 1, highest: 9)\n  const low = bounds.lowest\n  const first = bounds.0"),
    )
    assert(found.typeOf("bounds.lowest") == "Int64")
    assert(found.typeOf("bounds.0") == "Int64")
    assert(found.resolutionOf("bounds.0") == "tuple 0")
  }

  test "a case of a type, through the type" {
    const source = "type Shape \{\n  case Circle(radius: Int)\n  case Empty\n\}\n\nfn probe(): Shape \{\n  Shape.Empty\n\}"
    const found = probe source
    assert(found.typeOf("Shape.Empty") == "Shape")
    assert(found.resolutionOf("Shape.Empty") == "case Shape.Empty")
  }

  test "a case of the type that is expected here, written with a leading dot" {
    const source = "type Shape \{\n  case Circle(radius: Int)\n  case Empty\n\}\n\nfn probe(): Shape \{\n  .Empty\n\}"
    const found = probe source
    assert(found.typeOf(".Empty") == "Shape")
    assert problems(source).isEmpty()
  }

  test "a case that is written bare, where the expected type has one of that name" {
    const source = "type Shape \{\n  case Circle(radius: Int)\n  case Empty\n\}\n\nfn probe(): Shape \{\n  Empty\n\}"
    assert(
      problems(source)
        == ["`Empty` alone is a type, a function or a variable. A case is written `.Empty` or `Shape.Empty`"],
    )
  }
}

group "Operators" {
  test "the arithmetic of a numeric type takes `Other` and `Output` from the trait it declares" {
    const found = probe inBody("  const sum = 1 + 2\n  const quotient = 1.0 / 60.0")
    assert(found.typeOf("1 + 2") == "Int64")
    assert(found.typeOf("1.0 / 60.0") == "Float64")
  }

  test "there are no implicit conversions between the numeric types" {
    const source = inBody "  const value: Float64 = 2.0\n  const sum = 1 + value"
    assert(problems(source) == ["Expected `Int64`, found `Float64`"])
    assert(notes(source) == ["There are no implicit conversions: `Int64.tryFrom(value)?`"])
  }

  test "`+` on `String` is the `Add` the type declares" {
    const found = probe inBody("  const joined = \"a\" + \"b\"")
    assert(found.typeOf("\"a\" + \"b\"") == "String")
  }

  test "a comparison always produces a `Bool`, whatever implements it" {
    const found = probe inBody("  const smaller = 1 < 2\n  const same = \"a\" == \"b\"")
    assert(found.typeOf("1 < 2") == "Bool")
    assert(found.typeOf("\"a\" == \"b\"") == "Bool")
  }

  test "both sides of a comparison have to be the same type" {
    assert(problems(inBody("  const wrong = 1 == \"a\"")) == ["Expected `Int64`, found `String`"])
  }

  test "`&&`, `||` and `!` are built in on `Bool` and ask for one" {
    const found = probe inBody("  const both = true && false\n  const negated = !true")
    assert(found.typeOf("true && false") == "Bool")
    assert(found.typeOf("!true") == "Bool")
    assert(problems(inBody("  const wrong = 1 && true")) == ["Expected `Bool`, found `Int64`"])
  }

  test "`-a` gives back the type of its operand" {
    const found = probe inBody("  const negated = -3")
    assert(found.typeOf("-3") == "Int64")
  }

  test "an expected numeric type flows through the arithmetic into the literals in it" {
    const found = probe inBody("  const size: Int8 = 3 + 4\n  const scaled: Float32 = 1 / 2 * 3")
    assert(found.typeOf("3 + 4") == "Int8")
    assert(found.typeOf("3") == "Int8")
    assert(found.typeOf("4") == "Int8")
    assert(found.adaptationsOf("3") == ["literal Int8"])
    assert(found.typeOf("1 / 2 * 3") == "Float32")
    assert(found.typeOf("1 / 2") == "Float32")
  }

  test "a literal of an arithmetic expression that does not fit is reported at the literal itself" {
    assert(problems(inBody("  const size: Int8 = 300 + 1")) == ["`300` does not fit into `Int8`"])
  }

  test "only a literal adapts: a name keeps the type it has, so the mistake stays where it is" {
    const source = inBody "  const value: Float64 = 2.0\n  const sum: Int8 = value + 1"
    assert(problems(source) == ["Expected `Int8`, found `Float64`"])
  }

  test "`a[key]` is the `Value` of the `Indexed` the type declares" {
    const found = probe inBody("  const numbers: List<Int> = [1, 2]\n  const first = numbers[0]")
    assert(found.typeOf("numbers[0]") == "Int64")
  }

  test "`a[from..to]` gives back a value of the same type" {
    const found = probe inBody("  const text = \"hello\"\n  const part = text[0..2]")
    assert(found.typeOf("text[0..2]") == "String")
  }
}

group "`if`, `match` and blocks" {
  test "an `if` with an `else` is an expression, and its arms decide its type" {
    const found = probe inBody("  const value = if true \{ 1 \} else \{ 2 \}")
    assert(found.typeOf("if true \{ 1 \} else \{ 2 \}") == "Int64")
  }

  test "an `if` without an `else` has the type `Void`" {
    const found = probe inBody("  const nothing = if true \{ print \"yes\" \}")
    assert(found.typeOf("if true \{ print \"yes\" \}") == "Void")
  }

  test "the condition of an `if` has to be a `Bool`" {
    assert(problems(inBody("  const value = if 1 \{ 1 \} else \{ 2 \}")) == ["Expected `Bool`, found `Int64`"])
  }

  test "the arms of an `if` are checked against what is expected of the whole" {
    assert(
      problems(inBody("  const value: Int = if true \{ 1 \} else \{ \"two\" \}"))
        == ["Expected `Int64`, found `String`"],
    )
  }

  test "a branch that diverges fits into every type" {
    assert problems(inBody("  const value: Int = if true \{ 1 \} else \{ panic \"no\" \}")).isEmpty()
  }

  test "a `match` binds the names of its patterns and its arms decide its type" {
    const source = "type Shape \{\n  case Circle(radius: Int)\n  case Empty\n\}\n\n"
      + "fn probe(shape: Shape): Int \{\n  match shape \{\n    .Circle(radius) => radius + 0\n    .Empty => 0\n  \}\n\}"
    const found = probe source
    assert(found.typeOf("radius + 0") == "Int64")
    assert(found.patternTypeOf(".Circle(radius)") == "Shape")
    assert problems(source).isEmpty()
  }

  test "a block is an expression and the last statement of it is its value" {
    const found = probe inBody("  const value = if true \{\n    const inner = 2\n    inner + 1\n  \} else \{ 0 \}")
    assert(found.typeOf("inner + 1") == "Int64")
  }
}

group "What waits for a later sub-milestone" {
  test "a trait member of a known type and a generic call both have a type" {
    const source = "fn wrap<Value>(value: Value): Value \{\n  value\n\}\n\n"
      + inBody("  const numbers: List<Int> = [1, 2]\n  print numbers.length()\n  print wrap(1)")
    assert problems(source).isEmpty()
    const found = probe source
    // `length` comes from the `List` trait, `wrap` is instantiated at the call
    assert(found.typeOf("numbers.length()") == "Int64")
    assert(found.typeOf("wrap(1)") == "Int64")
  }

  test "the statistics count what is typed and what waits" {
    const found = probe inBody("  const number = 42")
    const statistics = found.statistics()
    assert(statistics.typed > 0)
    assert(statistics.total() == statistics.typed + statistics.deferred)
  }

  test "a closure body is checked like any other body (milestone 4.4)" {
    assert(problems(inBody("  const double = \{ value: Int => value * missing \}")) == ["Cannot find `missing` here"])
  }
}

/**
 * Every mistake of a user gets the message about it, and only that one: "The checker did not work out the type of this
 * expression" is the checker's own hole and never stands in for one, and what follows from a mistake says nothing more.
 */
group "One root cause, one message" {
  test "a command whose first argument starts with `-` is a subtraction from a function, and the message says so" {
    const source = inBody "  print -0.0"
    assert(problems(source) == ["`print` is a function, and `print -0.0` subtracts from it"])
    assert(
      notes(source)
        == ["The first argument of a command may not start with `-`, so this reads as a subtraction: write `print(-0.0)`"],
    )
  }

  test "a missing member of a collection whose element is a type parameter is reported" {
    const source = "type Bag<Item> \{\n  var items: List<Item> = []\n\n  var fn put(value: Item) \{\n    items.add value\n  \}\n\}"
    assert(problems(source) == ["`List<Item>` has no member `add`"])
  }

  test "the argument of a call that could not be resolved is still read: no second message about the binding" {
    const source = "fn collect<Value>(item: Value?): List<Value> \{\n  var found: List<Value> = []\n"
      + "  if const Some(x) = item \{\n    found.add x\n  \}\n  found\n\}"
    assert(problems(source) == ["`List<Value>` has no member `add`"])
  }

  test "a keyword as the name of a function is the parser's message, and the checker adds none" {
    assert(
      problems("fn if(value: Int): Int \{\n  value\n\}") == ["`if` is a keyword and cannot be used as a name here"],
    )
  }

  test "a field, a method and a case field may be named after a keyword, and are reached after a `.` and as a label" {
    const source = "type Event \{\n  type: String\n  var in: Int = 0\n\n"
      + "  fn match(pattern: String): Bool \{\n    self.type == pattern\n  \}\n\n"
      + "  var fn for(count: Int) \{\n    self.in = self.in + count\n  \}\n\n"
      + "  static fn if(kind: String): Self \{\n    Self(type: kind)\n  \}\n\}\n\n"
      + "type Signal \{\n  case Click(type: String)\n\}\n\n"
      + "fn probe(): Bool \{\n  var event = Event.if(\"click\")\n  event.for 2\n"
      + "  const same = match Signal.Click(type: \"click\") \{\n    .Click(type: kind) => kind == event.type\n  \}\n"
      + "  same && event.match(\"click\") && event.copy(type: \"x\").in == 2\n\}"
    assert problems(source).isEmpty()
  }

  test "a modifier is a field's name where a `:` follows it, `public` as much as the others" {
    const source = "type Symbol \{\n  public: Bool\n  private: Bool\n  native: Bool\n  shared: Bool\n\n"
      + "  fn exported(): Bool \{\n    self.public && !self.private\n  \}\n\}\n\n"
      + "fn probe(): Bool \{\n  const symbol = Symbol(public: true, private: false, native: false, shared: false)\n"
      + "  symbol.exported() && symbol.public\n\}"
    assert problems(source).isEmpty()
    assert(problems("type Point \{\n  public x: Int\n\}") == ["`public` is what a member is without it"])
  }

  test "a bare keyword stays the keyword: a field named after one is assigned through `self`" {
    const source = "type Event \{\n  var type: String\n\n  var fn reset() \{\n    type = \"\"\n  \}\n\}"
    assert(problems(source) == ["`type` is a keyword and cannot be assigned bare"])
  }

  test "a parameter, a binding and a free function still cannot be named after a keyword" {
    assert(problems("fn move(where: Int) \{\n\}") == ["`where` is a keyword and cannot be used as a name here"])
    assert(problems("fn probe() \{\n  const in = 1\n\}").first() == "Expected a pattern, found a keyword")
  }

  test "arguments beyond what the callee takes are not matched against its parameters" {
    const source = "fn apply(value: Int, body: (Int) => Int): Int \{\n  body(value)\n\}\n\n"
      + inBody("  print apply(1, 2, \{ x => x \})")
    assert(problems(source) == ["`apply` takes 2 arguments, 3 were given"])
  }

  test "an assignment to something that did not resolve is not also an assignment to a temporary" {
    assert(problems(inBody("  let answer = 42")) == ["Cannot find `let` here"])
  }

  test "a string the lexer could not close is still a string: its statement is not a value nobody used" {
    // At the top level: the search for the end of the interpolation runs to the end of the file here
    const message = "This `\{` inside of a string is never closed. A literal brace is written `\\\{`"
    assert(problems("print \"price: \{\{19.99\}\"") == [message])
    assert(problems("print \"total: \{value\nprint 1") == [message])
  }

  test "`?` in a field default is refused: a construction has no failure it could return" {
    const source = "fn parse(text: String): Int? \{\n  None\n\}\n\ntype Probe \{\n  count: Int = parse(\"1\")?\n\}"
    assert(problems(source) == ["`?` cannot stand in a field default: building a value never fails"])
    assert(
      notes(source)
        == [
          "A default stands in for an argument the caller left out, and a constructor has no failure."
            + " A value that has to be checked first is made by a factory: a `static fn` that answers a `Result`",
        ],
    )
    // A closure in a default is a function of its own, and its `?` returns from it
    const closure = "fn parse(text: String): Int? \{\n  None\n\}\n\n"
      + "type Probe \{\n  read: () => Int? = \{ Some(parse(\"1\")? + 1) \}\n\}"
    assert problems(closure).isEmpty()
  }
}
