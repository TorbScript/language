/**
 * `var` paths: a `var` parameter, a `var fn` receiver, an interior projection, and what a write through one of them
 * does with the count.
 *
 * The two questions these tests exist for are the ones a reader of a call has to be able to answer: **which storage** a
 * position works on - `&%0.from.x` and never a copy - and **when it is made unique**, which is once per counted owner of
 * the path and before the call, because that is where the `var` access begins.
 *
 * Every snapshot of the final IR goes through `verifyOwnedProgram`, so a text that matches and a body that leaks a count
 * cannot pass together; the C snapshots are the same programs one step further, and that the C really runs is
 * `tests/conformance/places.trb` and `place-counted.trb`.
 */

use test, group from "std/test"
use lowered, irOf, ownedIrOf, unsupportedIn from "./lower-harness"
use insertOwnership from "../src/ir/ownership"
use emitProgram, emittedProgramText, ProgramEntry from "../src/backend/c/emit"
use IrProgram, IrType, IrSignature, IrParameter, Ownership from "../src/ir/ir"
use Slot, Instruction, Terminator, Argument, Reference, borrowed, referenced from "../src/ir/ir"
use finishProgram from "../src/ir/layout"
use newFunction, emit, terminate, finishFunction from "../src/ir/build"
use verifyFunction from "../src/ir/verify"

/** The entry function of `app/src/main.trb`, which is what the `main` of the program calls. */
const entryName = "t_acme_x2f_app_main"

/** The emitted C of one function, from its comment to its closing brace, after the ownership pass. */
fn functionOf(source: String, name: String): String {
  var found = lowered source
  insertOwnership found.program
  const text = emittedProgramText found.program, entryName
  var lines: List<String> = []
  var isInside = false
  for line in text.lines() {
    if line == "/* {name} */" {
      isInside = true
      continue
    }
    if !isInside {
      continue
    }
    lines.append line
    if line == "\}" {
      break
    }
  }
  lines.joined separator: "\n"
}

/** What the C back end could not emit, after the ownership pass: a release of a `shared type` object is one. */
fn emitterFindingsOf(source: String): List<String> {
  var found = lowered source
  insertOwnership found.program
  emitProgram(found.program, [ProgramEntry(entryName)]).unsupported
}

/** A resource with an identity, handed to a generic `var` parameter as a temporary. */
const resources = raw"""
  shared type Connection with Close {
    fn send(text: String) {
      print text
    }

    var fn close() {}
  }

  fn opened(): Int {
    applied(Connection(), { connection =>
      connection.send "hello"
      1
    })
  }

  fn applied<Resource: Close, Value>(var resource: Resource, body: (Resource) => Value): Value {
    body(resource)
  }
  """

const counters = raw"""
  type Counter {
    var hits: Int

    var fn increment() {
      hits = hits + 1
    }
  }

  fn grow(var total: Int, by: Int) {
    total = total + by
  }

  fn growTwice(var total: Int, by: Int) {
    grow(total, by)
    grow(total, by)
  }

  fn countTwice(var counter: Counter) {
    counter.increment()
    counter.increment()
  }

  fn run(): Int {
    var total = 1
    growTwice(total, 2)
    var counter = Counter(0)
    countTwice(counter)
    total + counter.hits
  }
  """

group "A `var` parameter" {
  test "is a reference in the signature, and an assignment through it is a write" {
    assert(
      irOf(counters, "t_acme_x2f_app_main_grow") == raw"""
        fn t_acme_x2f_app_main_grow(var total: Int64 borrowed, by: Int64 borrowed) -> Void {
          slot %0 parameter total: Int64
          slot %1 parameter by: Int64
          slot %2 temporary: Int64
        b0: # acme/app/src/main.trb:9 body
          %2 = intrinsic add.i64 %0, %1 at acme/app/src/main.trb:10:11
          write %0 = %2 borrowed
          return
        }"""
    )
  }

  test "is handed on as the place it already is, and never as a copy of the value" {
    assert(
      irOf(counters, "t_acme_x2f_app_main_growTwice") == raw"""
        fn t_acme_x2f_app_main_growTwice(var total: Int64 borrowed, by: Int64 borrowed) -> Void {
          slot %0 parameter total: Int64
          slot %1 parameter by: Int64
          slot %2 temporary: Void
        b0: # acme/app/src/main.trb:13 body
          call t_acme_x2f_app_main_grow(&%0 borrowed, %1 borrowed) at acme/app/src/main.trb:14:3
          call t_acme_x2f_app_main_grow(&%0 borrowed, %1 borrowed) at acme/app/src/main.trb:15:3
          return
        }"""
    )
  }

  test "the call site passes the address of the local the value lives in" {
    assert(
      irOf(counters, "t_acme_x2f_app_main_run") == raw"""
        fn t_acme_x2f_app_main_run() -> Int64 {
          slot %0 local total: Int64
          slot %1 temporary: Int64
          slot %2 temporary: Void
          slot %3 local counter: Record(T_acme_x2f_app_main_Counter)
          slot %4 temporary: Int64
          slot %5 temporary: Int64
          slot %6 temporary: Int64
        b0: # acme/app/src/main.trb:23 body
          %0 = constant s_literal__Int64_1
          %1 = constant s_literal__Int64_2
          call t_acme_x2f_app_main_growTwice(&%0 borrowed, %1 borrowed) at acme/app/src/main.trb:25:3
          %4 = constant s_literal__Int64_0
          %3 = construct T_acme_x2f_app_main_Counter (%4 borrowed)
          call t_acme_x2f_app_main_countTwice(&%3 borrowed) at acme/app/src/main.trb:27:3
          %5 = read %3.hits
          %6 = intrinsic add.i64 %0, %5 at acme/app/src/main.trb:28:3
          return %6 borrowed
        }"""
    )
  }

  test "a `var self` receiver is the first parameter, and a field of it is one step from it" {
    assert(
      irOf(counters, "t_acme_x2f_app_main_Counter_increment")
        == raw"""
          fn t_acme_x2f_app_main_Counter_increment(var self: Record(T_acme_x2f_app_main_Counter) borrowed) -> Void {
            slot %0 parameter self: Record(T_acme_x2f_app_main_Counter)
            slot %1 temporary: Int64
            slot %2 temporary: Int64
            slot %3 temporary: Int64
          b0: # acme/app/src/main.trb:4 body
            %1 = read %0.hits
            %2 = constant s_literal__Int64_1
            %3 = intrinsic add.i64 %1, %2 at acme/app/src/main.trb:5:12
            write %0.hits = %3 borrowed
            return
          }"""
    )
  }

  test "in C it is a pointer, and every read through it one dereference" {
    assert(
      functionOf(counters, "t_acme_x2f_app_main_Counter_increment")
        == raw"""
          static void t_acme_x2f_app_main_Counter_increment(T_acme_x2f_app_main_Counter *s0_self) {
            int64_t s1 = { 0 };
            int64_t s2 = { 0 };
            int64_t s3 = { 0 };
          #line 4 "acme/app/src/main.trb"
            /* body */
            s1 = (*s0_self).f_hits;
            s2 = s_literal__Int64_1;
          #line 5 "acme/app/src/main.trb"
            s3 = torb_add_i64(s1, s2, TORB_LOCATION("acme/app/src/main.trb", 5, 12));
            (*s0_self).f_hits = s3;
            return;
          }"""
    )
  }

  test "in C a place that is already a pointer is passed on as it is, never as `&*p`" {
    assert(
      functionOf(counters, "t_acme_x2f_app_main_growTwice")
        == raw"""
          static void t_acme_x2f_app_main_growTwice(int64_t *s0_total, int64_t s1_by) {
            TORB_CHECK_STACK(TORB_LOCATION("acme/app/src/main.trb", 13, 39));
            torb_void s2 = { 0 };
            (void)s2;
          #line 13 "acme/app/src/main.trb"
            /* body */
            t_acme_x2f_app_main_grow(s0_total, s1_by);
            t_acme_x2f_app_main_grow(s0_total, s1_by);
            return;
          }"""
    )
  }
}

const lines = raw"""
  type Point {
    var x: Int
    var y: Int
  }

  type Line {
    var from: Point
    var to: Point
  }

  fn move(var point: Point, by: Int) {
    point.x = point.x + by
  }

  fn stretch(var line: Line, by: Int) {
    line.to.x = line.to.x + by
    move(line.from, by)
  }
  """

group "An interior projection" {
  test "is one `Reference` of several steps, and not a read followed by a write" {
    assert(
      irOf(lines, "t_acme_x2f_app_main_stretch") == raw"""
        fn t_acme_x2f_app_main_stretch(var line: Record(T_acme_x2f_app_main_Line) borrowed, by: Int64 borrowed) -> Void {
          slot %0 parameter line: Record(T_acme_x2f_app_main_Line)
          slot %1 parameter by: Int64
          slot %2 temporary: Record(T_acme_x2f_app_main_Point)
          slot %3 temporary: Int64
          slot %4 temporary: Int64
          slot %5 temporary: Void
        b0: # acme/app/src/main.trb:15 body
          %2 = read %0.to
          %3 = read %2.x
          %4 = intrinsic add.i64 %3, %1 at acme/app/src/main.trb:16:15
          write %0.to.x = %4 borrowed
          call t_acme_x2f_app_main_move(&%0.from borrowed, %1 borrowed) at acme/app/src/main.trb:17:3
          return
        }"""
    )
  }

  test "in C it is a member path, and a field of it the address of that member" {
    assert(
      functionOf(lines, "t_acme_x2f_app_main_stretch")
        == raw"""
          static void t_acme_x2f_app_main_stretch(T_acme_x2f_app_main_Line *s0_line, int64_t s1_by) {
            TORB_CHECK_STACK(TORB_LOCATION("acme/app/src/main.trb", 15, 37));
            T_acme_x2f_app_main_Point s2 = { 0 };
            int64_t s3 = { 0 };
            int64_t s4 = { 0 };
            torb_void s5 = { 0 };
            (void)s5;
          #line 15 "acme/app/src/main.trb"
            /* body */
            s2 = (*s0_line).f_to;
            s3 = s2.f_x;
          #line 16 "acme/app/src/main.trb"
            s4 = torb_add_i64(s3, s1_by, TORB_LOCATION("acme/app/src/main.trb", 16, 15));
            (*s0_line).f_to.f_x = s4;
            t_acme_x2f_app_main_move(&(*s0_line).f_from, s1_by);
            return;
          }"""
    )
  }
}

const bundles = raw"""
  type Bundle {
    var first: String
    var second: String
    var third: String
    var weight: Int
    var extra: Int
  }

  type Holder {
    var bundle: Bundle
    var count: Int
  }

  fn rename(var bundle: Bundle, name: String) {
    bundle.first = name
  }

  fn renameInside(var holder: Holder, name: String) {
    holder.bundle.second = name
  }

  fn renameOnce(var holder: Holder, name: String) {
    rename(holder.bundle, name)
  }
  """

group "Copy on write on the path" {
  test "a write through a counted owner makes it unique first, and releases what was there" {
    assert(
      ownedIrOf(bundles, "t_acme_x2f_app_main_rename")
        == raw"""
          fn t_acme_x2f_app_main_rename(var bundle: Record(T_acme_x2f_app_main_Bundle) borrowed, name: String owned) -> Void {
            slot %0 parameter bundle: Record(T_acme_x2f_app_main_Bundle)
            slot %1 parameter name: String
          b0: # acme/app/src/main.trb:14 body
            makeUnique %0
            write %0.first = %1 owned last
            return
          }"""
    )
  }

  test "the owner that is made unique is the counted one on the path, not the base" {
    assert(
      ownedIrOf(bundles, "t_acme_x2f_app_main_renameInside")
        == raw"""
          fn t_acme_x2f_app_main_renameInside(var holder: Record(T_acme_x2f_app_main_Holder) borrowed, name: String owned) -> Void {
            slot %0 parameter holder: Record(T_acme_x2f_app_main_Holder)
            slot %1 parameter name: String
          b0: # acme/app/src/main.trb:18 body
            makeUnique %0.bundle
            write %0.bundle.second = %1 owned last
            return
          }"""
    )
  }

  test "a place the callee writes through needs no `MakeUnique` here: the callee makes it unique itself" {
    assert(
      ownedIrOf(bundles, "t_acme_x2f_app_main_renameOnce")
        == raw"""
          fn t_acme_x2f_app_main_renameOnce(var holder: Record(T_acme_x2f_app_main_Holder) borrowed, name: String owned) -> Void {
            slot %0 parameter holder: Record(T_acme_x2f_app_main_Holder)
            slot %1 parameter name: String
            slot %2 temporary: Void
          b0: # acme/app/src/main.trb:22 body
            call t_acme_x2f_app_main_rename(&%0.bundle borrowed, %1 owned last) at acme/app/src/main.trb:23:3
            return
          }"""
    )
  }

  test "in C make-unique writes the new block back through the caller's pointer" {
    assert(
      functionOf(bundles, "t_acme_x2f_app_main_renameInside")
        == raw"""
          static void t_acme_x2f_app_main_renameInside(T_acme_x2f_app_main_Holder *s0_holder, torb_text s1_name) {
          #line 18 "acme/app/src/main.trb"
            /* body */
            (*s0_holder).f_bundle = (T_acme_x2f_app_main_Bundle *)torb_make_unique((*s0_holder).f_bundle, sizeof(T_acme_x2f_app_main_Bundle), R_T_acme_x2f_app_main_Bundle, D_T_acme_x2f_app_main_Bundle);
            torb_text_release((*s0_holder).f_bundle->f_second);
            (*s0_holder).f_bundle->f_second = s1_name;
            return;
          }"""
    )
  }
}

group "Places the source writes another way" {
  test "a temporary is a valid argument of a `var` parameter: the callee is its only owner" {
    const source = raw"""
      type Counter {
        var hits: Int
      }

      fn grow(var counter: Counter) {
        counter.hits = counter.hits + 1
      }

      fn run(): Int {
        grow(Counter(1))
        2
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_run") == raw"""
        fn t_acme_x2f_app_main_run() -> Int64 {
          slot %0 temporary: Record(T_acme_x2f_app_main_Counter)
          slot %1 temporary: Int64
          slot %2 temporary: Void
          slot %3 temporary: Int64
        b0: # acme/app/src/main.trb:9 body
          %1 = constant s_literal__Int64_1
          %0 = construct T_acme_x2f_app_main_Counter (%1 borrowed)
          call t_acme_x2f_app_main_grow(&%0 borrowed) at acme/app/src/main.trb:10:3
          %3 = constant s_literal__Int64_2
          return %3 borrowed
        }"""
    )
  }

  test "a property command writes the field it names, through the place the checker recorded" {
    const source = raw"""
      type Server {
        var port: Int = 0
      }

      fn configure(var server: Server) {
        server.port 8080
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_configure")
        == raw"""
          fn t_acme_x2f_app_main_configure(var server: Record(T_acme_x2f_app_main_Server) borrowed) -> Void {
            slot %0 parameter server: Record(T_acme_x2f_app_main_Server)
            slot %1 temporary: Int64
            slot %2 temporary: Void
          b0: # acme/app/src/main.trb:5 body
            %1 = constant s_literal__Int64_8080
            write %0.port = %1 borrowed
            return
          }"""
    )
  }

  test "a call whose result would land in the base of its own place writes the result instead" {
    const source = raw"""
      type Counter {
        var hits: Int
      }

      fn grown(var counter: Counter): Counter {
        counter.hits = counter.hits + 1
        Counter(counter.hits)
      }

      fn run(): Int {
        var counter = Counter(1)
        counter = grown(counter)
        counter.hits
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_run") == raw"""
        fn t_acme_x2f_app_main_run() -> Int64 {
          slot %0 local counter: Record(T_acme_x2f_app_main_Counter)
          slot %1 temporary: Int64
          slot %2 temporary: Record(T_acme_x2f_app_main_Counter)
          slot %3 temporary: Int64
        b0: # acme/app/src/main.trb:10 body
          %1 = constant s_literal__Int64_1
          %0 = construct T_acme_x2f_app_main_Counter (%1 borrowed)
          %2 = call t_acme_x2f_app_main_grown(&%0 borrowed) at acme/app/src/main.trb:12:13
          write %0 = %2 borrowed
          %3 = read %0.hits
          return %3 borrowed
        }"""
    )
  }
}

group "What a place cannot be yet" {
  /**
   * An index is a path of its own (`lower-collections.test.trb`): it takes the element out and puts it back. A
   * **slice** is the same round trip over a window: `Slice.slice` takes the part out and `MutableSlice.replace` puts it
   * back, so an assignment to one and a `var fn` on one both lower.
   */
  test "a slice is a window, and a path through one takes the part out and puts it back" {
    assert(
      unsupportedIn(
        "fn part(var items: ArrayList<Int>, var other: ArrayList<Int>) \{\n  items[0..1] = other\n\}"
      )
        == []
    )
  }

  test "a `var` receiver of a `native fn` is a place through the runtime's own pointer convention" {
    assert(unsupportedIn("fn push(var items: ArrayList<Int>) \{\n  items.append(1)\n\}") == [])
  }

  test "a `var` parameter that takes its default has no place to work on" {
    assert(
      unsupportedIn("fn grow(var total: Int = 0) \{\n  total = total + 1\n\}\n\nfn run() \{\n  grow()\n\}")
        == ["a `var` parameter that takes its default is not supported by the native back end yet"]
    )
  }
}

/**
 * The invariants of a place, against IR that was built wrong on purpose. They are what keeps a lowering on an untyped
 * interpreter from handing a back end a pointer to the wrong storage.
 */
group "What the verifier demands of a place" {
  test "the argument of a `var` parameter is a place, and a value is not one" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, true)
    const voidType = program.internType IrType.VoidType
    const grow = IrSignature([IrParameter("total", int64, true)], voidType)
    var calleeBuilder = newFunction "t_main_grow", None, grow, ""
    terminate calleeBuilder, Terminator.Return(None)
    const callee = finishFunction program, calleeBuilder
    var builder = newFunction "t_main_caller", None, IrSignature([IrParameter("value", int64)], voidType), "body"
    emit builder, Instruction.Call(None, callee, [borrowed(Slot(0))], [])
    terminate builder, Terminator.Return(None)
    const identifier = finishFunction program, builder
    finishProgram program
    assert(
      verifyFunction(program, program.functionAt(identifier))
        == ["t_main_caller b0: parameter 0 of `t_main_grow` is a `var` parameter, so argument 0 has to be a place"]
    )
  }

  test "the place of a `var` parameter ends in the type the parameter declares" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, true)
    const boolean = program.internType IrType.Boolean
    const voidType = program.internType IrType.VoidType
    const grow = IrSignature([IrParameter("total", int64, true)], voidType)
    var calleeBuilder = newFunction "t_main_grow", None, grow, ""
    terminate calleeBuilder, Terminator.Return(None)
    const callee = finishFunction program, calleeBuilder
    var builder = newFunction "t_main_caller", None, IrSignature([IrParameter("flag", boolean)], voidType), "body"
    emit builder, Instruction.Call(None, callee, [referenced(Reference(Slot(0)))], [])
    terminate builder, Terminator.Return(None)
    const identifier = finishFunction program, builder
    finishProgram program
    assert(
      verifyFunction(program, program.functionAt(identifier))
        == ["t_main_caller b0: parameter 0 of `t_main_grow` is `Int64` and its place is `Bool`"]
    )
  }

  test "a place carries no count, so its position is borrowed and never a last use" {
    var program = IrProgram()
    const strings = program.internType IrType.Text
    const voidType = program.internType IrType.VoidType
    const rename = IrSignature([IrParameter("name", strings, true)], voidType)
    var calleeBuilder = newFunction "t_main_rename", None, rename, ""
    terminate calleeBuilder, Terminator.Return(None)
    const callee = finishFunction program, calleeBuilder
    var builder = newFunction "t_main_caller", None, IrSignature([IrParameter("name", strings)], voidType), "body"
    const given = Argument Slot(0), Ownership.Owned, true, Some(Reference(Slot(0)))
    emit builder, Instruction.Call(None, callee, [given], [])
    terminate builder, Terminator.Return(None)
    const identifier = finishFunction program, builder
    finishProgram program
    assert(
      verifyFunction(program, program.functionAt(identifier))
        == [
          "t_main_caller b0: argument 0 of `t_main_rename` is a place, which carries no count and is therefore borrowed",
        ]
    )
  }

  test "a parameter that takes a value gets no place" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, true)
    const voidType = program.internType IrType.VoidType
    var calleeBuilder = newFunction "t_main_note", None, IrSignature([IrParameter("value", int64)], voidType), ""
    terminate calleeBuilder, Terminator.Return(None)
    const callee = finishFunction program, calleeBuilder
    var builder = newFunction "t_main_caller", None, IrSignature([IrParameter("value", int64)], voidType), "body"
    emit builder, Instruction.Call(None, callee, [referenced(Reference(Slot(0)))], [])
    terminate builder, Terminator.Return(None)
    const identifier = finishFunction program, builder
    finishProgram program
    assert(
      verifyFunction(program, program.functionAt(identifier))
        == ["t_main_caller b0: parameter 0 of `t_main_note` takes a value, so argument 0 carries no place"]
    )
  }

  test "the slot an argument names is the base of its place, because every pass reads that slot" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, true)
    const voidType = program.internType IrType.VoidType
    const grow = IrSignature([IrParameter("total", int64, true)], voidType)
    var calleeBuilder = newFunction "t_main_grow", None, grow, ""
    terminate calleeBuilder, Terminator.Return(None)
    const callee = finishFunction program, calleeBuilder
    const signature = IrSignature([IrParameter("first", int64), IrParameter("second", int64)], voidType)
    var builder = newFunction "t_main_caller", None, signature, "body"
    const given = Argument Slot(1), Ownership.Borrowed, false, Some(Reference(Slot(0)))
    emit builder, Instruction.Call(None, callee, [given], [])
    terminate builder, Terminator.Return(None)
    const identifier = finishFunction program, builder
    finishProgram program
    assert(
      verifyFunction(program, program.functionAt(identifier))
        == ["t_main_caller b0: argument 0 of `t_main_grow` names %1 and its place starts at %0"]
    )
  }
}

/**
 * A `var` parameter of a **generic** declaration. `applied<Resource: Close, Value>(var resource: Resource, ...)` is
 * one, and the type of the place a call forms for it is the *callee's* parameter type with the
 * callee's own instance arguments filled in - never the caller's substitution, which does not know `Resource` at all.
 * Reading it with the caller's made three internal errors out of one line: the parameter reached the back end
 * unsubstituted, the temporary the place was formed over became a `Void` slot, and the call passed a place of the
 * wrong type.
 */
group "A `var` argument of a generic callee" {
  test "the temporary of a `var` argument has the type the callee declares, for this instance" {
    assert(
      ownedIrOf(resources, "t_acme_x2f_app_main_opened") == raw"""
        fn t_acme_x2f_app_main_opened() -> Int64 {
          slot %0 temporary: Shared(T_acme_x2f_app_main_Connection)
