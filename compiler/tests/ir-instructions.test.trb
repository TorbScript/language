/**
 * Every instruction, every terminator and every kind of static data at least once: what it prints as, what slots it
 * reads and writes, and that a function made of all of them passes the verifier. A line that is never executed is a
 * line that was never checked - so every arm of every match here is reached.
 */

use test, group from "std/test"
use SymbolId from "../src/semantics/symbols"
use LiteralValue from "../src/semantics/checker/type"
use IrProgram, IrType, IrTypeId, IrTrait, IrSignature, IrParameter, Ownership from "../src/ir/ir"
use Slot, SlotRole, BlockId, LayoutId, Location, LocationId, Instruction, Terminator from "../src/ir/ir"
use FunctionKind, FunctionId, StaticId from "../src/ir/ir"
use Argument, Reference, PathStep, Intrinsic, IntrinsicOperation, NumericKind, RuntimeKind from "../src/ir/ir"
use StaticValue, StaticContents, ElementDescriptor, WitnessTable, WitnessSource, WitnessRoot from "../src/ir/ir"
use Capture, borrowed, owned from "../src/ir/ir"
use LayoutKind, FieldLayout, VariantLayout, finishProgram from "../src/ir/layout"
use newFunction, addSlot, addTemporary, addBlock, openBlock, switchTo from "../src/ir/build"
use emit, terminate, terminateBlock, setFunctionKind, finishFunction from "../src/ir/build"
use printFunction, printProgram, describeIntrinsic, describeRuntimeKind, describeIrType from "../src/ir/print"
use verifyFunction, verifyProgram, usedSlots, definedSlot, usedByTerminator from "../src/ir/verify"
use SymbolPath from "../src/ir/mangle"

fn environmentLayout(var program: IrProgram, name: String, fields: List<FieldLayout>): LayoutId {
  const reserved = program.reserveLayout name, LayoutKind.Environment
  const layout = program.layoutAt reserved.layout
  program.setLayout reserved.layout, layout.copy(fields: fields, isBuilt: true)
  reserved.layout
}

fn recordLayout(var program: IrProgram, name: String, fields: List<FieldLayout>): LayoutId {
  const reserved = program.reserveLayout name, LayoutKind.Record
  const layout = program.layoutAt reserved.layout
  program.setLayout reserved.layout, layout.copy(fields: fields, isBuilt: true)
  reserved.layout
}

fn tupleLayout(var program: IrProgram, name: String, annotations: List<IrTypeId>): LayoutId {
  var fields: List<FieldLayout> = []
  for index in 0..annotations.length() {
    fields.append FieldLayout("{index}", annotations[index])
  }
  const reserved = program.reserveLayout name, LayoutKind.Tuple
  const layout = program.layoutAt reserved.layout
  program.setLayout reserved.layout, layout.copy(fields: fields, isBuilt: true)
  reserved.layout
}

fn variantLayout(var program: IrProgram, name: String, names: List<String>, cases: List<List<FieldLayout>>): LayoutId {
  const reserved = program.reserveLayout name, LayoutKind.Variant
  var fields: List<FieldLayout> = []
  var variants: List<VariantLayout> = []
  for index in 0..cases.length() {
    const first = fields.length()
    fields.appendAll cases[index]
    variants.append VariantLayout(names[index], first, cases[index].length())
  }
  const layout = program.layoutAt reserved.layout
  program.setLayout reserved.layout, layout.copy(fields: fields, variants: variants, isBuilt: true)
  reserved.layout
}

group "A function that uses every instruction" {
  test "it passes the verifier, and every instruction has the line the format says" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, true)
    const int32 = program.internType IrType.Integer(32, true)
    const float64 = program.internType IrType.Floating(64)
    const boolean = program.internType IrType.Boolean
    const voidType = program.internType IrType.VoidType
    const strings = program.internType IrType.Text
    const listOfInteger = program.internType IrType.Runtime(RuntimeKind.ListStorage, [int64])
    const mapping = program.internType IrType.Runtime(RuntimeKind.MapStorage, [strings, int64])
    const box = program.internType IrType.Box(int64)
    const cellType = program.internType IrType.Lazy(int64)
    const holder = recordLayout program, "T_main_Holder", [FieldLayout("items", listOfInteger)]
    const holderType = program.internType IrType.Record(holder)
    const shape = variantLayout program, "T_main_Shape", ["Empty", "Circle"], [[], [FieldLayout("radius", int64)]]
    const shapeType = program.internType IrType.Variant(shape)
    const pairLayout = tupleLayout program, "T_tuple__Int64_String", [int64, strings]
    const pairType = program.internType IrType.Tuple(pairLayout)
    const show = program.internTrait IrTrait(SymbolId(1), SymbolPath("std/prelude", "convert", [], "Show"), [])
    const objectType = program.internType IrType.Object([show])
    const closureShape = program.internSignature IrSignature([IrParameter("value", int64)], voidType)
    const closureType = program.internType IrType.Closure(closureShape)
    const at = program.internLocation Location("src/all.trb", 12, 5)

    var doubleBuilder = newFunction(
      "t_main_double",
      None,
      IrSignature([IrParameter("value", int64)], int64),
      "body",
    )
    terminate doubleBuilder, Terminator.Return(Some(owned(Slot(0))))
    const double = finishFunction program, doubleBuilder
    // A closure body takes its environment first, and the environment holds one field per capture (BACKEND 5.8)
    const environment = environmentLayout(
      program,
      "T_environment__t_main_inner",
      [FieldLayout("value", int64), FieldLayout("counter", box), FieldLayout("items", listOfInteger)],
    )
    const environmentType = program.internType IrType.Record(environment)
    var innerBuilder = newFunction(
      "t_main_inner",
      None,
      IrSignature([IrParameter("environment", environmentType), IrParameter("value", int64)], voidType),
      "body",
    )
    terminate innerBuilder, Terminator.Return(None)
    const inner = finishFunction program, innerBuilder
    const showTable = program.addWitnessTable WitnessTable("w_show__Int64", show, int64, [double], [])
    const element = program.addElement ElementDescriptor("d_Int64", int64, 0, 0, Some(double))
    const greeting = program.addStatic(
      StaticValue("s_main_greeting", strings, StaticContents.Literal(LiteralValue.Text("hi")))
    )
    const number = program.addStatic(
      StaticValue("s_main_number", int64, StaticContents.Literal(LiteralValue.Integer(7)))
    )
    const ratio = program.addStatic StaticValue("s_main_ratio", float64, StaticContents.Floating(0.5))
    const nothing = program.addStatic StaticValue("s_main_nothing", voidType, StaticContents.VoidValue)
    const origin = program.addStatic(
      StaticValue("s_main_origin", pairType, StaticContents.Aggregate(pairLayout, 0, [number, greeting]))
    )
    const cells = program.addStatic(
      StaticValue("s_main_cells", listOfInteger, StaticContents.Items(int64, [number, number]))
    )

    const signature = IrSignature(
      [
        IrParameter("holder", holderType, true, Ownership.Borrowed),
        IrParameter("table", mapping),
        IrParameter("text", strings),
        IrParameter("value", int64),
        IrParameter("flag", boolean),
      ],
      voidType,
      [show],
    )
    var builder = newFunction "t_main_everything", Some(SymbolId(9)), signature, "body"
    const firstText = addTemporary builder, strings
    const secondText = addTemporary builder, strings
    const total = addTemporary builder, int64
    const boxed = addTemporary builder, box
    const cell = addTemporary builder, cellType
    const made = addTemporary builder, closureType
    const circle = addTemporary builder, shapeType
    const tagValue = addTemporary builder, int64
    const items = addTemporary builder, listOfInteger
    const element0 = addTemporary builder, int64
    const taken = addTemporary builder, int64
    const forced = addTemporary builder, int64
    const asObject = addTemporary builder, objectType
    const isEqual = addTemporary builder, boolean
    const isNot = addTemporary builder, boolean
    const narrow = addTemporary builder, int32
    const joined = addTemporary builder, strings
    const byteLength = addTemporary builder, int64
    const order = addTemporary builder, int64
    const shifted = addTemporary builder, int64
    const pair = addTemporary builder, pairType
    const fromTuple = addTemporary builder, int64
    const contents = addTemporary builder, int64
    const radius = addTemporary builder, int64
    const itemsPlace = Reference Slot(0), [PathStep.Field(holder, 0)]
    const add = Intrinsic IntrinsicOperation.Add, Some(NumericKind.Signed(64))
    emit builder, Instruction.Constant(firstText, greeting)
    emit builder, Instruction.Copy(secondText, firstText)
    emit builder, Instruction.Move(firstText, secondText)
    emit builder, Instruction.Retain(firstText)
    emit builder, Instruction.Release(secondText)
    emit builder, Instruction.MakeUnique(itemsPlace)
    emit builder, Instruction.Call(Some(total), double, [borrowed(Slot(3))], [])
    emit builder, Instruction.BoxNew(boxed, owned(Slot(3)))
    emit builder, Instruction.BoxNew(cell, owned(Slot(3)))
    emit(
      builder,
      Instruction.Closure(made, inner, [Capture.Value(Slot(3)), Capture.Boxed(boxed), Capture.Place(itemsPlace)], true),
    )
    emit builder, Instruction.CallClosure(None, made, [borrowed(Slot(3))])
    emit builder, Instruction.Intrinsic(Some(total), add, [Slot(3), total], at)
    emit builder, Instruction.Construct(circle, shape, 1, [owned(Slot(3))])
    emit builder, Instruction.Tag(tagValue, circle)
    emit builder, Instruction.Read(items, itemsPlace)
    emit builder, Instruction.Write(itemsPlace, Argument(items, Ownership.Owned, true))
    emit builder, Instruction.Read(element0, Reference(Slot(0), [PathStep.Field(holder, 0), PathStep.Element(int64, Slot(3), greeting, at)]))
    emit builder, Instruction.TakeOut(taken, Reference(Slot(1)), Slot(2), RuntimeKind.MapStorage)
    emit builder, Instruction.PutBack(Reference(Slot(1)), Slot(2), taken, RuntimeKind.MapStorage)
    emit builder, Instruction.Intrinsic(Some(forced), Intrinsic(IntrinsicOperation.LazyForce, None), [cell], at)
    emit builder, Instruction.TraitValue(asObject, owned(Slot(3)), [WitnessSource(WitnessRoot.Table(showTable))])
    emit builder, Instruction.CallWitness(None, WitnessSource(WitnessRoot.Value(Reference(asObject, []), 0)), 0, [borrowed(asObject)])
    emit builder, Instruction.CallWitness(None, WitnessSource(WitnessRoot.Parameter(0), [1, 2]), 3, [])
    emit builder, Instruction.Intrinsic(Some(isEqual), Intrinsic(IntrinsicOperation.Equal, Some(NumericKind.Signed(64))), [Slot(3), total], at)
    emit builder, Instruction.Intrinsic(Some(isNot), Intrinsic(IntrinsicOperation.BooleanNot, None), [isEqual], at)
    emit(
      builder,
      Instruction.Intrinsic(
        Some(narrow),
        Intrinsic(IntrinsicOperation.Convert(NumericKind.Signed(32)), Some(NumericKind.Signed(64))),
        [Slot(3)],
        at,
      ),
    )
    emit builder, Instruction.Intrinsic(Some(joined), Intrinsic(IntrinsicOperation.TextConcat, None), [firstText, secondText], at)
    emit builder, Instruction.Intrinsic(Some(byteLength), Intrinsic(IntrinsicOperation.TextByteLength, None), [firstText], at)
    emit builder, Instruction.Intrinsic(Some(order), Intrinsic(IntrinsicOperation.TextCompare, None), [firstText, secondText], at)
    emit(
      builder,
      Instruction.Intrinsic(Some(shifted), Intrinsic(IntrinsicOperation.ShiftedLeft, Some(NumericKind.Signed(64))), [Slot(3), total], at),
    )
    emit builder, Instruction.Construct(pair, pairLayout, 0, [owned(Slot(3)), owned(firstText)])
    emit builder, Instruction.Read(fromTuple, Reference(pair, [PathStep.TupleField(pairLayout, 0)]))
    emit builder, Instruction.Read(contents, Reference(boxed, [PathStep.Contents(int64)]))
    emit builder, Instruction.Read(radius, Reference(circle, [PathStep.Variant(shape, 1, 0)]))
    emit builder, Instruction.Panic(owned(firstText), at)
    terminate builder, Terminator.Unreachable
    const identifier = finishFunction program, builder
    finishProgram program

    assert verifyFunction(program, program.functionAt(identifier)).isEmpty()
    assert verifyProgram(program).isEmpty()
    const printed = printFunction program, program.functionAt(identifier)
    assert(
      printed.startsWith(
        "fn t_main_everything(var holder: Record(T_main_Holder) borrowed, table: Map(String, Int64) borrowed, text: String borrowed, value: Int64 borrowed, flag: Bool borrowed, witness 0: Show) -> Void \{"
      )
    )
    assert printed.contains("\n  %5 = constant s_main_greeting\n")
    assert printed.contains("\n  %6 = copy %5\n")
    assert printed.contains("\n  %5 = move %6\n")
    assert printed.contains("\n  retain %5\n")
    assert printed.contains("\n  release %6\n")
    assert printed.contains("\n  makeUnique %0.items\n")
    assert printed.contains("\n  %7 = call t_main_double(%3 borrowed)\n")
    assert printed.contains("\n  %8 = boxNew %3 owned\n")
    assert printed.contains("\n  %10 = closure t_main_inner captures(%3 value, %8 boxed, %0.items place) escaping\n")
    assert printed.contains("\n  callClosure %10(%3 borrowed)\n")
    assert printed.contains("\n  %7 = intrinsic add.i64 %3, %7 at src/all.trb:12:5\n")
    assert printed.contains("\n  %11 = construct T_main_Shape.Circle (%3 owned)\n")
    assert printed.contains("\n  %12 = tag %11\n")
    assert printed.contains("\n  %13 = read %0.items\n")
    assert printed.contains("\n  write %0.items = %13 owned last\n")
    assert printed.contains("\n  %14 = read %0.items[%3]\n")
    assert printed.contains("\n  %15 = takeOut %1[%2] Map\n")
    assert printed.contains("\n  putBack %1[%2] = %15 Map\n")
    assert printed.contains("\n  %16 = intrinsic lazyForce %9 at src/all.trb:12:5\n")
    assert printed.contains("\n  %17 = traitValue %3 owned tables(table w_show__Int64)\n")
    assert printed.contains("\n  callWitness value %17 bound 0 member 0(%17 borrowed)\n")
    assert printed.contains("\n  callWitness parameter 0.1.2 member 3()\n")
    assert printed.contains("\n  %19 = intrinsic booleanNot %18 at src/all.trb:12:5\n")
    assert printed.contains("\n  %20 = intrinsic convert.i64.i32 %3 at src/all.trb:12:5\n")
    assert printed.contains("\n  %21 = intrinsic textConcat %5, %6 at src/all.trb:12:5\n")
    assert printed.contains("\n  %22 = intrinsic textByteLength %5 at src/all.trb:12:5\n")
    assert printed.contains("\n  %23 = intrinsic textCompare %5, %6 at src/all.trb:12:5\n")
    assert printed.contains("\n  %24 = intrinsic shiftedLeft.i64 %3, %7 at src/all.trb:12:5\n")
    assert printed.contains("\n  %26 = read %25.0\n")
    assert printed.contains("\n  %27 = read %8.*\n")
    assert printed.contains("\n  %28 = read %11.Circle.radius\n")
    assert printed.contains("\n  panic %5 owned at src/all.trb:12:5\n")
    assert printed.contains("\n  unreachable\n\}")

    const whole = printProgram program
    assert whole.contains("element d_Int64 Int64 size 8 align 8 retain t_main_double")
    assert whole.contains("witness w_show__Int64 Show for Int64 members(t_main_double) nested()")
    assert whole.contains("static s_main_greeting: String = \"hi\"")
    assert whole.contains("static s_main_number: Int64 = 7")
    assert whole.contains("static s_main_ratio: Float64 = 0.5")
    assert whole.contains("static s_main_nothing: Void = void")
    assert whole.contains("static s_main_origin: Tuple(T_tuple__Int64_String) = T_tuple__Int64_String(s_main_number, s_main_greeting)")
    assert whole.contains("static s_main_cells: List(Int64) = Int64[s_main_number, s_main_number]")
  }

  test "a task body says that it is one, and only it suspends" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, true)
    const voidType = program.internType IrType.VoidType
    var builder = newFunction "t_main_wait", None, IrSignature([IrParameter("state", int64)], voidType), "entry"
    setFunctionKind builder, FunctionKind.TaskResume
    const resumed = openBlock builder, "resumed", None
    terminateBlock builder, BlockId(0), Terminator.Jump(resumed)
    emit builder, Instruction.Suspend(2, Slot(0))
    terminate builder, Terminator.Return(None)
    const identifier = finishFunction program, builder
    finishProgram program
    assert verifyFunction(program, program.functionAt(identifier)).isEmpty()
    const printed = printFunction program, program.functionAt(identifier)
    assert printed.startsWith("task fn t_main_wait(state: Int64 borrowed) -> Void \{")
    assert printed.contains("\n  suspend state 2 %0\n")
  }

  test "a result the model calls too big to return in registers is written through a pointer" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, true)
    const wide = program.internType IrType.FixedArray(int64, 9)
    var builder = newFunction "t_main_wide", None, IrSignature([], wide), "body"
    const target = addSlot builder, wide, SlotRole.ResultPointer, "result"
    const captured = addSlot builder, int64, SlotRole.Environment, "counter"
    terminate builder, Terminator.Return(Some(owned(target)))
    const identifier = finishFunction program, builder
    finishProgram program
    const printed = printFunction program, program.functionAt(identifier)
    assert printed.startsWith("fn t_main_wide() -> Array(Int64, 9) byPointer \{")
    assert printed.contains("\n  slot %0 result result: Array(Int64, 9)\n")
    assert printed.contains("\n  slot %1 environment counter: Int64\n")
  }
}

group "What an instruction reads and writes" {
  test "every form says which slots it reads, in evaluation order, and which one it writes" {
    const first = Slot 1
    const second = Slot 2
    const third = Slot 3
    const place = Reference first, [PathStep.Element(IrTypeId(0), second, StaticId(0), LocationId(0))]
    const witness = WitnessSource WitnessRoot.Value(Reference(third, []), 0)
    assert(usedSlots(Instruction.Constant(first, StaticId(0))) == [])
    assert(usedSlots(Instruction.Move(first, second)) == [second])
    assert(usedSlots(Instruction.Copy(first, second)) == [second])
    assert(usedSlots(Instruction.Retain(first)) == [first])
    assert(usedSlots(Instruction.Release(first)) == [first])
    assert(usedSlots(Instruction.MakeUnique(place)) == [first, second])
    assert(usedSlots(Instruction.Call(Some(first), FunctionId(0), [borrowed(second)], [witness])) == [second, third])
    assert(usedSlots(Instruction.CallClosure(None, first, [borrowed(second)])) == [first, second])
    assert(usedSlots(Instruction.CallWitness(None, witness, 0, [borrowed(second)])) == [third, second])
    assert(usedSlots(Instruction.Intrinsic(None, Intrinsic(IntrinsicOperation.TextConcat, None), [first, second], LocationId(0))) == [first, second])
    assert(usedSlots(Instruction.Construct(first, LayoutId(0), 0, [owned(second)])) == [second])
    assert(usedSlots(Instruction.Read(third, place)) == [first, second])
    assert(usedSlots(Instruction.Write(place, owned(third))) == [first, second, third])
    assert(usedSlots(Instruction.Tag(first, second)) == [second])
    assert(
      usedSlots(Instruction.Closure(first, FunctionId(0), [Capture.Value(second), Capture.Boxed(third), Capture.Place(place)], false))
        == [second, third, first, second]
    )
    assert(usedSlots(Instruction.BoxNew(first, owned(second))) == [second])
    assert(usedSlots(Instruction.TraitValue(first, owned(second), [witness])) == [second, third])
    assert(usedSlots(Instruction.TakeOut(first, Reference(second), third, RuntimeKind.MapStorage)) == [second, third])
    assert(usedSlots(Instruction.PutBack(Reference(first), second, third, RuntimeKind.MapStorage)) == [first, second, third])
    assert(usedSlots(Instruction.Panic(owned(first), LocationId(0))) == [first])
    assert(usedSlots(Instruction.Suspend(0, first)) == [first])

    assert(definedSlot(Instruction.Constant(first, StaticId(0))) == Some(first))
    assert(definedSlot(Instruction.Move(first, second)) == Some(first))
    assert(definedSlot(Instruction.Copy(first, second)) == Some(first))
    assert(definedSlot(Instruction.Call(Some(first), FunctionId(0), [], [])) == Some(first))
    assert(definedSlot(Instruction.Call(None, FunctionId(0), [], [])) == None)
    assert(definedSlot(Instruction.CallClosure(Some(first), second, [])) == Some(first))
    assert(definedSlot(Instruction.CallWitness(Some(first), witness, 0, [])) == Some(first))
    assert(definedSlot(Instruction.Intrinsic(Some(first), Intrinsic(IntrinsicOperation.TextConcat, None), [], LocationId(0))) == Some(first))
    assert(definedSlot(Instruction.Construct(first, LayoutId(0), 0, [])) == Some(first))
    assert(definedSlot(Instruction.Read(first, place)) == Some(first))
    assert(definedSlot(Instruction.Tag(first, second)) == Some(first))
    assert(definedSlot(Instruction.Closure(first, FunctionId(0), [], false)) == Some(first))
    assert(definedSlot(Instruction.BoxNew(first, owned(second))) == Some(first))
    assert(definedSlot(Instruction.TraitValue(first, owned(second), [])) == Some(first))
    assert(definedSlot(Instruction.TakeOut(first, Reference(second), third, RuntimeKind.MapStorage)) == Some(first))
    assert(definedSlot(Instruction.Retain(first)) == None)
    assert(definedSlot(Instruction.Release(first)) == None)
    assert(definedSlot(Instruction.MakeUnique(place)) == None)
    assert(definedSlot(Instruction.Write(place, owned(third))) == None)
    assert(definedSlot(Instruction.PutBack(Reference(first), second, third, RuntimeKind.MapStorage)) == None)
    assert(definedSlot(Instruction.Panic(owned(first), LocationId(0))) == None)
    assert(definedSlot(Instruction.Suspend(0, first)) == None)

    assert(usedByTerminator(Terminator.Jump(BlockId(0))) == [])
    assert(usedByTerminator(Terminator.Branch(first, BlockId(0), BlockId(1))) == [first])
    assert(usedByTerminator(Terminator.Switch(first, [], [], BlockId(0))) == [first])
    assert(usedByTerminator(Terminator.Return(Some(owned(first)))) == [first])
    assert(usedByTerminator(Terminator.Return(None)) == [])
    assert(usedByTerminator(Terminator.Unreachable) == [])
  }
}

group "Names of intrinsics and of the runtime's types" {
  test "every operation has a name, and a numeric one carries its width" {
    const signed = Some NumericKind.Signed(64)
    const unsigned = Some NumericKind.Unsigned(8)
    const floating = Some NumericKind.Floating(32)
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Add, signed)) == "add.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Subtract, unsigned)) == "subtract.u8")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Multiply, floating)) == "multiply.f32")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Divide, signed)) == "divide.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Remainder, signed)) == "remainder.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Negate, signed)) == "negate.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.BitwiseAnd, signed)) == "bitwiseAnd.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.BitwiseOr, signed)) == "bitwiseOr.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.BitwiseExclusiveOr, signed)) == "bitwiseExclusiveOr.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.BitwiseNot, signed)) == "bitwiseNot.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.ShiftedLeft, signed)) == "shiftedLeft.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.ShiftedRight, signed)) == "shiftedRight.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Equal, signed)) == "equal.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.NotEqual, signed)) == "notEqual.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Less, signed)) == "less.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.LessOrEqual, signed)) == "lessOrEqual.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.Greater, signed)) == "greater.i64")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.GreaterOrEqual, signed)) == "greaterOrEqual.i64")
    assert(
      describeIntrinsic(Intrinsic(IntrinsicOperation.Convert(NumericKind.Floating(64)), signed)) == "convert.i64.f64"
    )
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.BooleanNot, None)) == "booleanNot")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.TextConcat, None)) == "textConcat")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.TextEqual, None)) == "textEqual")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.TextCompare, None)) == "textCompare")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.TextByteLength, None)) == "textByteLength")
    assert(describeIntrinsic(Intrinsic(IntrinsicOperation.LazyForce, None)) == "lazyForce")
  }

  test "every type the runtime owns has a name, and interning tells them apart" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, true)
    const kinds = [
      RuntimeKind.ListStorage,
      RuntimeKind.MapStorage,
      RuntimeKind.SetStorage,
      RuntimeKind.TaskObject,
      RuntimeKind.ChannelObject,
      RuntimeKind.ExpressionTree,
      RuntimeKind.DecimalNumber,
    ]
    const names = ["List", "Map", "Set", "Task", "Channel", "Expression", "Decimal"]
    var built: List<IrTypeId> = []
    for index in 0..kinds.length() {
      assert(describeRuntimeKind(kinds[index]) == names[index])
      const one = program.internType IrType.Runtime(kinds[index], [int64])
      assert(describeIrType(program, one) == "{names[index]}(Int64)")
      assert(!built.contains(one))
      built.append one
    }
    // Interning is by the whole form, so asking again gives the very same id back
    assert(program.internType(IrType.Runtime(RuntimeKind.SetStorage, [int64])) == built[2])
  }
}
