/**
 * Inference: unification variables that live inside one statement, the literal defaults, the empty literals, `.Case`
 * against the expected type, and the arms of an `if` and a `match` that have to agree.
 *
 * Every test here is about a *statement*: a variable is made for one and gone at its end, so what one line cannot
 * decide is an error that names the annotation to write instead.
 */

use test, group from "std/test"
use probe, problems, notes from "./harness"

fn inBody(body: String): String {
  "fn probe() \{\n{body}\n\}"
}

group "Unification variables" {
  test "a generic call solves its parameter from the argument, and records what it was instantiated with" {
    const source = "fn identity<Value>(value: Value): Value \{\n  value\n\}\n\n" + inBody("  const found = identity(3)")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("identity(3)") == "Int64")
    assert(found.typeArgumentsOf("identity(3)") == ["Int64"])
    assert(found.resolutionOf("identity(3)") == "call identity")
  }

  test "the same variable in two positions has to agree" {
    const source = "fn pair<Value>(first: Value, second: Value): Value \{\n  first\n\}\n\n"
      + inBody("  const found = pair(1, \"two\")")
    assert(problems(source) == ["Expected `Int64`, found `String`"])
  }

  test "a parameter that nothing decides names the annotation to write" {
    const source = "fn make<Value>(): Value \{\n  panic \"no\"\n\}\n\n" + inBody("  const found = make()")
    assert(problems(source) == ["Cannot infer `Value` of `make`"])
    assert(
      notes(source) == ["Annotate the closure parameter or the result, or write the type argument: `make<Value>(...)`"],
    )
  }

  /**
   * `shout` has a type of its own, and it disagrees with the parameter in the part an earlier argument decided already:
   * that is the message, and not the `Output` that nothing could solve after it.
   */
  test "a function of the wrong shape names the mismatch, not the parameter it left open" {
    const convert = "fn convert<Input, Output>(value: Input, transform: (value: Input) => Output): Output \{\n"
      + "  transform(value)\n\}\n\n"
    const shout = "fn shout(text: String): String \{\n  text\n\}\n\n"
    const bound = convert + shout + inBody("  const number: Int = 3\n  const found = convert(number, shout)")
    assert(problems(bound) == ["Expected `(value: Int64) => _`, found `(text: String) => String`"])
    const printed = convert + shout + inBody("  print convert(3, shout)")
    assert(problems(printed) == ["Expected `(value: Int64) => _`, found `(text: String) => String`"])
  }

  test "a function that fits where it is decided still waits for the rest" {
    const convert = "fn convert<Input, Output>(value: Input, transform: (value: Input) => Output): Output \{\n"
      + "  transform(value)\n\}\n\n"
    const shout = "fn shout(text: String): String \{\n  text\n\}\n\n"
    assert problems(convert + shout + inBody("  const found = convert(\"loud\", shout)")).isEmpty()
  }

  test "a note about a later parameter spells every parameter in order, the earlier ones already filled" {
    // Explicit type arguments fill parameters from the left, so a note that only named `Output` would send the
    // reader to write `convert<Output>(...)` - which fills `Input`, not `Output`
    const source = "fn convert<Input, Output>(value: Input): Output \{\n  panic \"no\"\n\}\n\n"
      + inBody("  const found = convert(3)")
    assert(problems(source) == ["Cannot infer `Output` of `convert`"])
    assert(
      notes(source)
        == ["Annotate the closure parameter or the result, or write the type argument: `convert<Int64, Output>(...)`"],
    )
  }

  test "the expected type of the binding decides what a call produces" {
    const source = "fn make<Value>(): Value \{\n  panic \"no\"\n\}\n\n" + inBody("  const found: Int = make()")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeArgumentsOf("make()") == ["Int64"])
  }

  test "an explicit type argument fills the parameters from the left" {
    const source = "fn make<Value>(): Value \{\n  panic \"no\"\n\}\n\n" + inBody("  const found = make<String>()")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("make<String>()") == "String")
    assert(found.typeArgumentsOf("make<String>()") == ["String"])
  }

  test "more type arguments than the callee has parameters is an error" {
    const source = "fn make<Value>(): Value \{\n  panic \"no\"\n\}\n\n" + inBody("  const found = make<String, Int>()")
    assert(problems(source) == ["`make` takes 1 type argument, 2 were given"])
  }

  test "a variable never leaves its statement: what one line cannot decide, the next one may not" {
    const source = inBody "  var items = []\n  items.append(1)\n  print items.length()"
    assert(problems(source) == ["Cannot infer the type of this collection"])
    assert(notes(source) == ["An empty literal needs a type: annotate the binding (`const items: List<Int> = []`)"])
  }

  /**
   * `take(clicked)` solves the variable `first` left open one statement earlier, so `before[1]` resolves to a type that
   * nothing had interned yet. The check of an index read the type table before it resolved the receiver, and a table
   * read before the intern does not have the new type in it: the checker panicked instead of reporting.
   */
  test "a variable an earlier statement left open and a later one solved does not break a later index" {
    const declarations = "fn make<Message>(): List<Message> \{\n  []\n\}\n\n"
      + "fn first<Message>(box: List<Message>): Message \{\n  box[0]\n\}\n\n"
      + "fn take(message: Int): Int \{\n  message\n\}\n\n"
    const statements = "  const before = make()\n  const clicked = first(before[0])\n"
      + "  const _taken = take(clicked)\n  const _renamed = first(before[1])"
    assert(
      problems(declarations + inBody(statements))
        == ["Cannot infer `Message` of `make`", "Cannot infer `Message` of `first`"],
    )
  }
}

group "Literals through a variable" {
  test "a literal that arrives at a variable solves it with its own type" {
    const source = "fn fold<State>(initial: State, combine: (State) => State): State \{\n  combine(initial)\n\}\n\n"
      + inBody("  const total = fold(0) \{ _ + 1 \}")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("fold(0) \{ _ + 1 \}") == "Int64")
    assert(found.typeArgumentsOf("fold(0) \{ _ + 1 \}") == ["Int64"])
  }

  test "a literal that arrives at a known numeric type adapts to it, and records what it became" {
    const source = "fn take<Value>(value: Value): Value \{\n  value\n\}\n\n" + inBody("  const small: Int8 = take(1)")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.adaptationsOf("1") == ["literal Int8"])
    assert(found.typeArgumentsOf("take(1)") == ["Int8"])
  }

  test "a decimal literal is a `Float64` where nothing else says so" {
    const source = "fn take<Value>(value: Value): Value \{\n  value\n\}\n\n" + inBody("  const found = take(1.5)")
    const probed = probe source
    assert(probed.typeArgumentsOf("take(1.5)") == ["Float64"])
  }
}

group "Empty and inferred collection literals" {
  test "an empty list takes its item type from the annotation, and the literal is recorded as that list" {
    const source = inBody "  const items: List<Int> = []"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("[]") == "List<Int64>")
  }

  test "an empty map takes both of its item types from the annotation" {
    const source = inBody "  const index: Map<String, Int> = [:]"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("[:]") == "Map<String, Int64>")
  }

  test "an empty list without an annotation says what to annotate" {
    assert(problems(inBody("  const items = []")) == ["Cannot infer the type of this collection"])
  }

  test "without an expectation the first item decides the item type" {
    const found = probe inBody("  const items = [1, 2, 3]")
    assert(found.typeOf("[1, 2, 3]") == "List<Int64>")
  }

  test "the items of a list are checked against the item type of the expected one" {
    assert(problems(inBody("  const items: List<Int> = [1, \"two\"]")) == ["Expected `Int64`, found `String`"])
  }

  test "a `List<Trait>` coerces every item, and the witness of every bound is recorded (gap 8)" {
    const source = "type Square \{\n  size: Int\n\}\n\nextend Square with Show \{\n"
      + "  fn show(): String \{\n    \"square\"\n  \}\n\}\n\n"
      + inBody("  const shapes: List<Show> = [Square(2)]")
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.adaptationsOf("Square(2)") == ["trait value Show"])
  }

  test "an empty list inside a generic call is solved by another argument of the same call" {
    const source = "fn build<State>(initial: State, also: State): State \{\n  initial\n\}\n\n"
      + inBody("  const found = build([], [1])")
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("[]") == "List<Int64>")
  }
}

group "`.Case` against the expected type" {
  test "the expected type names the type a case belongs to" {
    const source = inBody "  const found: Int? = .Some(1)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf(".Some(1)") == "Option<Int64>")
    assert(probed.resolutionOf(".Some(1)") == "case Option<Int64>.Some")
  }

  test "a case without fields is the value itself" {
    const source = inBody "  const found: Int? = .None"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf(".None") == "Option<Int64>")
  }

  test "`.Case` without an expectation says what to write instead" {
    const source = inBody "  const found = .None"
    assert(problems(source) == ["`.None` needs a type, and nothing here says which one"])
    assert(notes(source) == ["Write it out: `Shape.None(...)`, or annotate what the value goes into"])
  }

  test "a case the expected type does not have is a mistake" {
    assert(problems(inBody("  const found: Int? = .Nothing")) == ["`Option<Int64>` has no case `Nothing`"])
  }

  test "a bare case constructor takes the arguments of the expected type" {
    const source = "fn probe(): Int? \{\n  Some(1)\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("Some(1)") == "Option<Int64>")
  }

  test "a bare case constructor without an expectation infers from its argument" {
    const source = inBody "  const found = Some(1)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("Some(1)") == "Option<Int64>")
  }
}

group "The arms of an `if` and a `match`" {
  test "the arms are unified, so one arm learns the type from the other" {
    const source = "fn probe(flag: Bool): Int? \{\n  const found = if flag \{ None \} else \{ Some(1) \}\n  found\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("None") == "Option<Int64>")
    assert(probed.typeOf("if flag \{ None \} else \{ Some(1) \}") == "Option<Int64>")
  }

  test "an empty literal in one arm is solved by the other" {
    const source = "fn probe(flag: Bool): List<Int> \{\n  if flag \{ [] \} else \{ [1] \}\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("[]") == "List<Int64>")
  }

  test "arms that do not agree and are expected of nothing are statements, and the whole is `Void`" {
    const source = "fn one(): Int \{\n  1\n\}\n\nfn other() \{\n\}\n\n"
      + "fn probe(flag: Bool) \{\n  match flag \{\n    true => one()\n    false => other()\n  \}\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("match flag \{\n    true => one()\n    false => other()\n  \}") == "Void")
  }

  test "with an expectation every arm is checked against it" {
    const source = "fn probe(flag: Bool): Int \{\n  if flag \{ 1 \} else \{ \"two\" \}\n\}"
    assert(problems(source) == ["Expected `Int64`, found `String`"])
  }

  test "an arm that diverges decides nothing" {
    const source = "fn probe(flag: Bool): Int \{\n  const found = if flag \{ 1 \} else \{ panic \"no\" \}\n  found\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("if flag \{ 1 \} else \{ panic \"no\" \}") == "Int64")
  }
}

group "What the expected type reaches" {
  test "the result of the callee is matched against the expected type before its arguments are read" {
    const source = "fn first<Item>(items: List<Item>): Item? \{\n  .None\n\}\n\n"
      + inBody("  const found: Int? = first([])")
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeArgumentsOf("first([])") == ["Int64"])
    // The empty literal is checked *after* the result told the call what `Item` is
    assert(probed.typeOf("[]") == "List<Int64>")
  }

  test "a coercion never solves a variable: the value stays what it is (design 2.5)" {
    const source = "fn identity<Value>(value: Value): Value \{\n  value\n\}\n\n"
      + inBody("  const shown: Show = identity(1)")
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeArgumentsOf("identity(1)") == ["Int64"])
    assert(probed.adaptationsOf("identity(1)") == ["trait value Show"])
  }

  test "a function whose result is a `Task` has a body that produces the value" {
    const source = "fn probe(): Task<Int> \{\n  1\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("1") == "Int64")
  }

  test "`?` decides the failure type of a subject that nothing else does" {
    const source = "type ConfigError \{\n  case Missing(key: String)\n\}\n\n"
      + "fn probe(value: Int?): Result<Int, ConfigError> \{\n"
      + "  const found = value.okOr(ConfigError.Missing(\"port\"))?\n  Ok(found)\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("value.okOr(ConfigError.Missing(\"port\"))?") == "Int64")
  }

  /**
   * The short form cannot be used there, though: the failure type is still open when the argument is read, and only the
   * `?` around the call would decide it.
   */
  test "a `.Case` whose type only the `?` would decide is an error, not an inference" {
    const source = "type ConfigError \{\n  case Missing(key: String)\n\}\n\n"
      + "fn probe(value: Int?): Result<Int, ConfigError> \{\n"
      + "  const found = value.okOr(.Missing(\"port\"))?\n  Ok(found)\n\}"
    assert(problems(source) == ["`.Missing` needs its type here: nothing expects one before the `?`"])
    assert(
      notes(source)
        == [
          "Write it out: `ConfigError.Missing(...)`. The `?` only decides the failure type once the argument has been"
            + " read",
        ],
    )
  }
}

/** A trait with an argument, and a function whose parameter `Message` only its bound mentions. */
fn liveSource(): String {
  "trait Live<Message> \{\n  fn update(message: Message): Int\n\}\n\n"
    + "fn render<Model: Live<Message>, Message>(model: Model): List<Message> \{\n  []\n\}\n\n"
}

/** A type that implements `Live` twice, with two different arguments: one `extend` per instantiation. */
fn twiceLiveSource(): String {
  "type Both \{\n  name: String = \"both\"\n\}\n\n"
    + "extend Both with Live<Int> \{\n  fn update(message: Int): Int \{\n    message\n  \}\n\}\n\n"
    + "extend Both with Live<String> \{\n  fn update(message: String): Int \{\n    0\n  \}\n\}\n\n"
}

/**
 * `fn render<Model: Live<Message>, Message>(model: Model)`: the argument decides `Model`, and nothing the call writes
 * mentions `Message`. The one implementation of `Live` the model has does.
 */
group "A parameter only a bound mentions" {
  test "the one implementation of the bounded trait solves it" {
    const counter = "type Counter with Live<Int> \{\n  fn update(message: Int): Int \{\n    message\n  \}\n\}\n\n"
    const source = liveSource() + counter + inBody("  const found = render(Counter())")
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeArgumentsOf("render(Counter())") == ["Counter", "Int64"])
    assert(probed.typeOf("render(Counter())") == "List<Int64>")
  }

  test "a type parameter bounded by the trait solves it from its own bound" {
    const source = liveSource() + "fn outer<Model: Live<String>>(model: Model) \{\n  const found = render(model)\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeArgumentsOf("render(model)") == ["Model", "String"])
  }

  test "a type that implements the trait twice decides nothing, and the note spells the argument to write" {
    const source = liveSource() + twiceLiveSource() + inBody("  const found = render(Both())")
    assert(problems(source) == ["Cannot infer `Message` of `render`"])
    assert(
      notes(source)
        == ["Annotate the closure parameter or the result, or write the type argument: `render<Both, Message>(...)`"],
    )
  }

  test "the expected type still decides where the implementations do not" {
    const source = liveSource() + twiceLiveSource() + inBody("  const found: List<String> = render(Both())")
    assert problems(source).isEmpty()
  }

  test "a type that does not implement the trait at all says so, and not that a type argument is missing" {
    const source = liveSource() + inBody("  const found = render(3)")
    assert(problems(source) == ["`Int64` does not implement `Live<_>`"])
    assert(notes(source) == ["`render` asks for it"])
  }
}
