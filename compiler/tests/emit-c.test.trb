use test, group from "std/test"
use lowered from "./lower-harness"
use IrProgram, IrType, IrSignature, IrParameter from "../src/ir/ir"
use emitProgram, emittedProgramText from "../src/backend/c/emit"
use readPrototype, matchPrototype from "../src/backend/c/prototype"

/**
 * From the typed IR to one C11 translation unit: the type of every layout, the static data, the functions with their
 * slots and labels, `#line`, and `main`.
 *
 * Every program here is the in-memory workspace of `harness.trb`, lowered by the real lowering - so what is asserted is
 * the C of an IR that was built the way `torb build` builds it, and never of an IR a test wrote by hand. The assertions
 * are on the piece of the output that is under test (one function, one type, one constant), because a whole-file
 * snapshot would change with every unrelated addition; one test compares a whole small program, which is what pins the
 * shape of the file itself.
 *
 * That the C **compiles and runs** is the end-to-end test `bootstrap/crates/torb-cli/tests/native.rs`, over the
 * programs in `bootstrap/tests/native/`: it builds every one of them with a real C compiler and compares the binary
 * with stage 0.
 */

/** The entry function of `app/src/main.trb`, which is what the `main` of the program calls. */
const entryName = "t_acme_x2f_app_main"

fn cOf(source: String): String {
  var found = lowered(source)
  emittedProgramText(found.program, entryName)
}

/** What the C back end could not emit, in the order it was found. */
fn findingsOf(source: String): List<String> {
  var found = lowered(source)
  emitProgram(found.program, entryName).unsupported
}

/** One emitted function, from its comment to its closing brace: what a test about a body compares. */
fn functionOf(source: String, name: String): String {
  const text = cOf(source)
  var lines: List<String> = []
  var isInside = false
  for line in text.lines() {
    if line == "/* {name} */" {
      isInside = true
      continue
    }
    if !isInside {
      continue
    }
    lines.add(line)
    if line == "\}" {
      break
    }
  }
  String.join(lines, separator: "\n")
}

/** One type definition, `struct ... {` to `};`. */
fn typeDefinitionOf(source: String, name: String): String {
  const text = cOf(source)
  var lines: List<String> = []
  var isInside = false
  for line in text.lines() {
    if line == "struct {name} \{" {
      isInside = true
    }
    if !isInside {
      continue
    }
    lines.add(line)
    if line == "\};" {
      break
    }
  }
  String.join(lines, separator: "\n")
}

group "The translation unit" {
  test "a small program is one file of includes, constants, prototypes, bodies and `main`" {
    const source = r"""
fn double(value: Int): Int {
  value * 2
}

const _ = double(21)
"""
    assert(
      cOf(source) == r"""/*
 * Generated by the TorbScript compiler. Do not edit.
 *
 * One translation unit for the whole program (docs/BACKEND.md 3.6). Everything here talks to the runtime through
 * runtime/include/torb.h and nothing else, and it is a pure function of the typed IR: no path of this machine,
 * no time and no build id is in it, so two runs of the compiler write the same bytes.
 */

#include "torb.h"
#include "torb_natives.h"

/* The compile-time constants of the program. */
static const int64_t s_literal__Int64_2 = 2;
static const int64_t s_literal__Int64_21 = 21;

/* Every function of the program, sorted by its mangled name. */
static void t_acme_x2f_app_main(void);
static int64_t t_acme_x2f_app_main_double(int64_t s0_value);

/* t_acme_x2f_app_main: the top-level code of the entry file */
static void t_acme_x2f_app_main(void) {
  int64_t s0 = { 0 };
  int64_t s1 = { 0 };
  (void)s1;
#line 6 "acme/app/src/main.trb"
  /* entry */
  s0 = s_literal__Int64_21;
  s1 = t_acme_x2f_app_main_double(s0);
  return;
}

/* t_acme_x2f_app_main_double */
static int64_t t_acme_x2f_app_main_double(int64_t s0_value) {
  int64_t s1 = { 0 };
  int64_t s2 = { 0 };
#line 2 "acme/app/src/main.trb"
  /* body */
  s1 = s_literal__Int64_2;
#line 3 "acme/app/src/main.trb"
  s2 = torb_multiply_i64(s0_value, s1, TORB_LOCATION("acme/app/src/main.trb", 3, 3));
  return s2;
}

int main(int argument_count, char **argument_values) {
  torb_process_start(argument_count, argument_values);
  t_acme_x2f_app_main();
  return 0;
}
"""
    )
  }

  test "the output is a pure function of the program: emitting twice is byte identical" {
    const source = r"""
type Point {
  x: Int
  y: Int
}

fn moved(point: Point, by: Int): Point {
  Point(point.x + by, point.y)
}

const _ = moved(Point(1, 2), 3)
"""
    assert(cOf(source) == cOf(source))
  }

  test "no path of a machine reaches the output: every location is relative to the workspace root" {
    const source = r"""
fn twice(value: Int): Int {
  value + value
}

const _ = twice(21)
"""
    const text = cOf(source)
    assert(text.contains("#line 3 \"acme/app/src/main.trb\""))
    assert(text.contains("TORB_LOCATION(\"acme/app/src/main.trb\", 3, 3)"))
    assert(!text.contains(":/"))
    assert(!text.contains("\\"))
  }
}

group "Types" {
  test "a record is a struct whose members are its fields, and a field read is a member read" {
    const source = r"""
type Point {
  x: Int
  y: Int = 0

  fn sum(self): Int {
    x + y
  }
}

const _ = Point(1, 2).sum()
"""
    assert(
      typeDefinitionOf(source, "T_acme_x2f_app_main_Point") == r"""struct T_acme_x2f_app_main_Point {
  int64_t f_x;
  int64_t f_y;
};"""
    )
    const text = functionOf(source, "t_acme_x2f_app_main_Point_sum")
    assert(text.contains("static int64_t t_acme_x2f_app_main_Point_sum(T_acme_x2f_app_main_Point s0_self)"))
    assert(text.contains("s1 = s0_self.f_x;"))
    assert(text.contains("s2 = s0_self.f_y;"))
  }

  test "a tuple is a struct of its positions, which a field name cannot collide with" {
    const source = r"""
fn first(pair: (Int, Bool)): Int {
  const (number, flag) = pair
  if flag {
    return number
  }
  0
}

const _ = first((1, true))
"""
    assert(
      typeDefinitionOf(source, "T_tuple__Int64_Bool") == r"""struct T_tuple__Int64_Bool {
  int64_t f_0;
  bool f_1;
};"""
    )
  }

  test "a layout the size model calls too big is a counted block, and a construction allocates one" {
    const source = r"""
type Wide {
  a: Int
  b: Int
  c: Int
  d: Int
  e: Int
}

fn widen(): Wide {
  Wide(1, 2, 3, 4, 5)
}

const _ = widen()
"""
    assert(
      typeDefinitionOf(source, "T_acme_x2f_app_main_Wide") == r"""struct T_acme_x2f_app_main_Wide {
  torb_header header;
  int64_t f_a;
  int64_t f_b;
  int64_t f_c;
  int64_t f_d;
  int64_t f_e;
};"""
    )
    const text = functionOf(source, "t_acme_x2f_app_main_widen")
    assert(text.contains("static T_acme_x2f_app_main_Wide *t_acme_x2f_app_main_widen(void) \{"))
    assert(text.contains("  T_acme_x2f_app_main_Wide *s5 = \{ 0 \};"))
    assert(
      text.contains(
        "s5 = (T_acme_x2f_app_main_Wide *)torb_allocate(sizeof(T_acme_x2f_app_main_Wide), TORB_BLOCK_RECORD);"
      )
    )
    assert(text.contains("s5->f_a = s0;"))
    assert(text.contains("s5->f_e = s4;"))
  }

  test "a variant layout is a tag and a union of the groups, and an empty case has no member" {
    const source = r"""
fn keep(value: Int?): Int? {
  value
}

const _ = keep(None)
"""
    assert(
      typeDefinitionOf(source, "T_std_x2f_prelude_types_Option__Int64") == r"""struct T_std_x2f_prelude_types_Option__Int64 {
  uint32_t tag;
  union {
    struct {
      int64_t f_value;
    } v0;
  } payload;
};"""
    )
  }
}

group "Bodies" {
  test "the blocks are labels and `goto`, and a label nothing jumps to is left out" {
    const source = r"""
fn pick(flag: Bool, value: Int): Int {
  if flag {
    return value
  }
  0
}

const _ = pick(true, 1)
"""
    assert(
      functionOf(source, "t_acme_x2f_app_main_pick") == r"""static int64_t t_acme_x2f_app_main_pick(bool s0_flag, int64_t s1_value) {
  torb_void s2 = { 0 };
  int64_t s3 = { 0 };
  (void)s2;
#line 2 "acme/app/src/main.trb"
  /* body */
  if (s0_flag) { goto L1; }
  goto L2;
#line 3 "acme/app/src/main.trb"
L1:  /* then */
  return s1_value;
#line 3 "acme/app/src/main.trb"
L2:  /* join */
  s3 = s_literal__Int64_0;
  return s3;
}"""
    )
  }

  test "a loop is a `goto` back to the head, and every slot is declared at the top" {
    const source = r"""
fn halved(value: Int): Int {
  var total = value
  while total > 1 {
    total = total / 2
  }
  total
}

const _ = halved(8)
"""
    const text = functionOf(source, "t_acme_x2f_app_main_halved")
    assert(text.contains("  int64_t s1_total = \{ 0 \};"))
    assert(text.contains("  s1_total = s0_value;"))
    assert(text.contains("  goto L1;"))
    assert(text.contains("L1:  /* while */"))
    assert(text.contains("  if (s3) \{ goto L2; \}"))
    assert(text.contains("s1_total = torb_divide_i64(s1_total, s4, TORB_LOCATION(\"acme/app/src/main.trb\", 5, 13));"))
  }

  test "every checked operation carries its source location, and a float operation is a C operator" {
    const source = r"""
fn mixed(first: Int, second: Int, value: Float): Bool {
  const sum = first + second
  const product = first * second
  const rest = first % second
  const negated = 0 - first
  const scaled = value * 2.0
  sum < product && rest == negated && scaled > 1.0
}

const _ = mixed(1, 2, 3.0)
"""
    const text = functionOf(source, "t_acme_x2f_app_main_mixed")
    assert(text.contains("s3_sum = torb_add_i64(s0_first, s1_second, TORB_LOCATION(\"acme/app/src/main.trb\", 3, 15));"))
    assert(text.contains("s4_product = torb_multiply_i64(s0_first, s1_second,"))
    assert(text.contains("s5_rest = torb_remainder_i64(s0_first, s1_second,"))
    assert(text.contains("s6_negated = torb_subtract_i64(s7, s0_first,"))
    assert(text.contains("s8_scaled = s2_value * s9;"))
    assert(text.contains("s10 = s3_sum < s4_product;"))
  }

  test "a function that does not return is `_Noreturn`, and a panic is the runtime's" {
    const source = r"""
fn stop(): Never {
  panic "no"
}

const _ = stop()
"""
    assert(
      functionOf(source, "t_acme_x2f_app_main_stop") == r"""static TORB_NORETURN void t_acme_x2f_app_main_stop(void) {
  torb_text s0 = { 0 };
  torb_void s1 = { 0 };
  (void)s1;
#line 2 "acme/app/src/main.trb"
  /* body */
  s0 = s_literal__String_no;
#line 3 "acme/app/src/main.trb"
  torb_panic(s0, TORB_LOCATION("acme/app/src/main.trb", 3, 3));
  TORB_UNREACHABLE();
}"""
    )
  }

  test "an interpolation is one concatenation of all its parts" {
    const source = r"""
fn joined(first: String, second: String): Int {
  (first + second).byteLength()
}

const _ = joined("a", "b")
"""
    const text = functionOf(source, "t_acme_x2f_app_main_joined")
    assert(text.contains("    const torb_text parts[2] = \{ s0_first, s1_second \};"))
    assert(text.contains("    s2 = torb_text_concat(parts, 2);"))
    assert(text.contains("s3 = torb_text_byte_length(s2);"))
  }

  test "a comparison of two strings is the runtime's, never a C operator" {
    const source = r"""
fn same(first: String, second: String): Bool {
  first == second
}

const _ = same("a", "b")
"""
    assert(functionOf(source, "t_acme_x2f_app_main_same").contains("s2 = torb_text_equal(s0_first, s1_second);"))
  }
}

group "Static data" {
  test "a string literal is an immortal `torb_bytes` with a `torb_text` slice over it" {
    const source = r"""
const greeting = "hi"

fn length(): Int {
  greeting.byteLength()
}

const _ = length()
"""
    const text = cOf(source)
    assert(
      text.contains(
        "static struct \{ torb_header header; uint32_t capacity; uint8_t data[2]; \}\n"
          + "  s_acme_x2f_app_main_greeting_storage = \{ TORB_IMMORTAL_HEADER(TORB_BLOCK_BYTES), 2, \{ 0x68, 0x69 \} \};"
      )
    )
    assert(
      text.contains(
        "static const torb_text s_acme_x2f_app_main_greeting ="
          + " \{ (torb_bytes *)&s_acme_x2f_app_main_greeting_storage, 0, 2 \};"
      )
    )
  }

  test "the constants are sorted by name, and a constant nothing names is not emitted" {
    const source = r"""
const unused = 7

fn sum(): Int {
  1 + 2
}

const _ = sum()
"""
    const text = cOf(source)
    assert(text.contains("static const int64_t s_literal__Int64_1 = 1;\nstatic const int64_t s_literal__Int64_2 = 2;"))
    assert(!text.contains("s_acme_x2f_app_main_unused"))
  }

  test "a `Bool` and a `Char` constant are the C spellings of their values" {
    const source = r"""
fn flags(): Bool {
  const yes = true
  const letter = 'A'
  yes && letter == 'A'
}

const _ = flags()
"""
    const text = cOf(source)
    assert(text.contains("static const bool s_literal__Bool_true = true;"))
    assert(text.contains("static const torb_char s_literal__Char_A = 0x000041;"))
  }
}

group "What the C back end does not emit yet" {
  test "a type the back end has no C spelling for is a finding that names its milestone" {
    const source = r"""
fn describeIt(value: Show): String {
  value.show()
}

const _ = describeIt(1)
"""
    assert(findingsOf(source) == ["a trait-typed value (milestone 5.6)"])
  }

  /**
   * The manifest's prototype is what says whether a native can be called as the lowering wrote it: a native whose
   * result is an `Option` answers `bool` and writes its payload through an out parameter, which needs a wrapper that
   * does not exist yet. Asked of the matcher directly, because the prelude of these tests declares no such native.
   */
  test "a native whose result the lowering still has to wrap is a finding that names it" {
    const prototype = readPrototype("bool torb_text_index_of(torb_text text, torb_text part, int64_t *out);")
      .expect("a prototype")
    assert(prototype.result == "bool")
    assert(prototype.parameters == ["torb_text", "torb_text", "int64_t *"])
    var program = IrProgram()
    const text = program.internType(IrType.Text)
    const found = program.internType(IrType.Integer(64, true))
    const signature = IrSignature([IrParameter("text", text), IrParameter("part", text)], found)
    const shown = match matchPrototype(program, signature, prototype, "torb_text_index_of") {
      .Direct => "direct"
      .WithLocation => "with the location"
      .Mismatch(what) => what
    }
    assert(shown == "`torb_text_index_of`: the runtime answers `bool` where the lowering expects `int64_t`,"
      + " so the wrapper of a later sub-milestone is still missing")
  }

  test "a native that takes the source location of the call cannot be written yet" {
    const prototype = readPrototype("torb_text torb_text_repeat(torb_text text, int64_t times, torb_location at);")
      .expect("a prototype")
    var program = IrProgram()
    const text = program.internType(IrType.Text)
    const count = program.internType(IrType.Integer(64, true))
    const signature = IrSignature([IrParameter("text", text), IrParameter("times", count)], text)
    const shown = match matchPrototype(program, signature, prototype, "torb_text_repeat") {
      .Direct => "direct"
      .WithLocation => "with the location"
      .Mismatch(what) => what
    }
    assert(shown == "with the location")
  }

  test "a program the back end can emit completely has no findings at all" {
    const source = r"""
type Point {
  x: Int
  y: Int
}

fn sum(point: Point): Int {
  point.x + point.y
}

const _ = sum(Point(1, 2))
"""
    assert(findingsOf(source) == [])
  }
}
