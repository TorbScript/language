/**
 * Visibility. Members are public unless marked `private`, because a value *is* its data and reading a field cannot
 * break anything; what needs protection is mutation and invariants, and both have a modifier.
 *
 * `private` reaches exactly as far as the file that declares it: the body of the declaration, every `extend` of it in
 * that file - an `extend` without a trait *is* part of the type - and the functions of that file. `protected var` reads
 * as "write-protected": everybody reads the field, only the file of its type writes it.
 *
 * `Account` lives in a module of its own in most of these, so that `main.trb` is outside of it in every sense.
 */

use test, group from "std/test"
use problems, notes, problemsOf, notesOf from "./harness"

const account = raw"""
  public type Account {
    owner: String
    protected var balance: Int = 0
    private var history: String = ""

    var fn deposit(amount: Int): Void {
      balance = balance + amount
      history = history + "deposit"
    }

    fn spent(): String {
      history
    }
  }
  """

const importsAccount = raw"""
  use Account from "./account"

  """

fn withAccount(body: String): Map<String, String> {
  ["app/src/account.trb": account, "app/src/main.trb": importsAccount + body]
}

/** A second package, so that "the package is the unit of privacy" has something to be measured against. */
const otherPackage = [
  "project.trb": raw"""
    name "acme/all"
    workspace { members "std/*", "app", "other" }
    """,
  "other/project.trb": raw"""
    name "acme/other"
    """,
  "other/src/lib.trb": raw"""
    public type Thing {
      label: String = ""
      private hidden: Int = 0

      fn peek(): Int {
        hidden
      }
    }
    """,
  "app/project.trb": raw"""
    name "acme/app"
    dependencies { runtime "acme/other" }
    """,
]

const importsThing = raw"""
  use Thing from "acme/other"

  """

fn withOtherPackage(body: String): Map<String, String> {
  var files = otherPackage
  files.set("app/src/main.trb", importsThing + body)
  files
}

/**
 * One declaration in a file of its own, and a `main.trb` that imports it. `private` reaches as far as the file that
 * writes it, so every rule about what code *outside* may do needs a second file to stand in.
 */
fn outside(name: String, declaration: String, body: String): Map<String, String> {
  ["app/src/declared.trb": declaration, "app/src/main.trb": "use {name} from \"./declared\"\n\n" + body]
}

group "A `private` member" {
  test "is visible in the body of its own type" {
    const files = withAccount(raw"""
      fn probe(account: Account): String {
        account.spent()
      }
      """)
    assert problemsOf(files).isEmpty()
  }

  test "is invisible outside of it" {
    const files = withAccount(raw"""
      fn probe(account: Account): String {
        account.history
      }
      """)
    assert(problemsOf(files) == ["`history` is private to `Account`"])
    assert(
      notesOf(files)
        == [
          "A private member is visible in the file that declares `Account` - its body, an `extend` of it there, and"
            + " the functions of that file - and nowhere else",
        ],
    )
  }

  /**
   * One rule, and this is it: what is private is visible in its file. An `extend` there is part of the type, and so
   * is a free function of the same file - the same reach a `private` top-level declaration has.
   */
  test "is visible in an `extend` and in a free function of the file that declares it" {
    const files = [
      "app/src/account.trb": account
        + raw"""

          extend Account {
            fn shown(): String {
              history
            }
          }

          public fn spentOf(account: Account): String {
            account.history
          }
          """,
      "app/src/main.trb": raw"""
        use Account, spentOf from "./account"

        fn probe(account: Account): String {
          account.shown() + spentOf(account)
        }
        """,
    ]
    assert problemsOf(files).isEmpty()
  }

  test "is invisible in an `extend` in another file of the same package" {
    const files = [
      "app/src/account.trb": account,
      "app/src/extra.trb": raw"""
        use Account from "./account"

        extend Account {
          fn shown(): String {
            history
          }
        }
        """,
      "app/src/main.trb": raw"""
        use Account from "./account"

        fn probe(account: Account): String {
          account.shown()
        }
        """,
    ]
    assert(problemsOf(files) == ["`history` is private to `Account`"])
  }

  test "is invisible in an `extend` of another package" {
    const files = withOtherPackage(raw"""
      extend Thing {
        fn peeked(): Int {
          hidden
        }
      }
      """)
    assert(problemsOf(files) == ["`hidden` is private to `Thing`"])
  }

  test "is invisible in an ordinary function of another package" {
    const files = withOtherPackage(raw"""
      fn probe(thing: Thing): Int {
        thing.hidden
      }
      """)
    assert(problemsOf(files) == ["`hidden` is private to `Thing`"])
  }

  test "a public field of a foreign type stays readable" {
    const files = withOtherPackage(raw"""
      fn probe(thing: Thing): String {
        thing.label
      }
      """)
    assert problemsOf(files).isEmpty()
  }

  const counter = raw"""
    public type Counter {
      var value: Int = 0

      private fn step(): Int {
        value + offset
      }

      private static offset: Int = 1
    }
    """

  test "a `private` method is hidden the same way" {
    const files = outside(
      "Counter",
      counter,
      raw"""
        fn probe(counter: Counter): Int {
          counter.step()
        }
        """,
    )
    assert(problemsOf(files) == ["`step` is private to `Counter`"])
  }

  test "and so is a `private` constant, read through the type" {
    const files = outside(
      "Counter",
      counter,
      raw"""
        fn probe(): Int {
          Counter.offset
        }
        """,
    )
    assert(problemsOf(files) == ["`offset` is private to `Counter`"])
  }
}

group "`protected var`" {
  test "is readable from everywhere" {
    const files = withAccount(raw"""
      fn probe(account: Account): Int {
        account.balance
      }
      """)
    assert problemsOf(files).isEmpty()
  }

  test "is written only in the file that declares its type" {
    const files = withAccount(raw"""
      fn probe(var account: Account): Void {
        account.balance = 1000
      }
      """)
    assert(problemsOf(files) == ["`balance` is write-protected: only the file that declares `Account` writes it"])
    assert(
      notesOf(files)
        == [
          "A `protected var` field is read everywhere and written in its own file alone: a `var fn` of the type"
            + " changes it",
        ],
    )
  }

  test "is written by a method of its type" {
    const files = withAccount(raw"""
      fn probe(var account: Account): Void {
        account.deposit(5)
      }
      """)
    assert problemsOf(files).isEmpty()
  }

  test "is written by an `extend` and by a function of the file that declares the type" {
    const source = raw"""
      type Account {
        protected var balance: Int = 0
      }

      extend Account {
        var fn raise() {
          balance = balance + 1
        }
      }

      fn reset(var account: Account) {
        account.balance = 0
      }
      """
    assert problems(source).isEmpty()
  }

  test "is not written by an `extend` in another file" {
    const files = withAccount(raw"""
      extend Account {
        var fn raise() {
          balance = balance + 1
        }
      }
      """)
    assert(problemsOf(files) == ["`balance` is write-protected: only the file that declares `Account` writes it"])
  }

  test "is passed to the constructor and to `copy` from another file, like every field that is not `private`" {
    const files = withAccount(raw"""
      fn probe(): Account {
        const opened = Account(owner: "Ada", balance: 10)
        opened.copy(balance: 20)
      }
      """)
    assert problemsOf(files).isEmpty()
  }

  test "`private(var)`, the spelling it replaces, is an error and still means the same" {
    const files = outside(
      "Wallet",
      raw"""
        public type Wallet {
          private(var) coins: Int = 0

          var fn add() {
            coins = coins + 1
          }
        }
        """,
      raw"""
        fn probe(var wallet: Wallet): Int {
          wallet.add()
          wallet.coins = 3
          wallet.coins
        }
        """,
    )
    const found = problemsOf files
    assert(found.length() == 2)
    assert found.contains("`private(var)` is written `protected var`")
    assert found.contains("`coins` is write-protected: only the file that declares `Wallet` writes it")
  }

  test "`protected` is a word only in front of a member: everywhere else it is a name" {
    const source = raw"""
      type Guard {
        protected: Bool
        var level: Int = 0

        fn locked(): Bool {
          self.protected && protected
        }
      }

      type Vault {
        protected var protected: Int = 0

        var fn seal() {
          protected = protected + 1
        }
      }

      type Lock {
        fn protected(): Int {
          1
        }
      }

      fn probe(): Bool {
        const protected = Guard(protected: true)
        var vault = Vault()
        vault.seal()
        protected.locked() && protected.protected && vault.protected > Lock().protected()
      }
      """
    assert problems(source).isEmpty()
  }

  test "a field written inside a receiver closure is refused from outside, too" {
    const files = outside(
      "Options",
      raw"""
        public type Options {
          protected var port: Int = 80
        }
        """,
      raw"""
        fn probe(): Options {
          serve {
            port = 9000
          }
        }

        fn serve(configure: (var self: Options) => Void): Options {
          var found = Options()
          configure(found)
          found
        }
        """,
    )
    assert(problemsOf(files) == ["`port` is write-protected: only the file that declares `Options` writes it"])
  }
}

group "The constructor and `copy` (gap 24)" {
  test "a private field without a default makes the constructor unusable from outside" {
    const files = outside(
      "Email",
      "public type Email \{\n  private value: String\n\}\n",
      raw"""
        fn probe(): Email {
          Email("info@example.test")
        }
        """,
    )
    assert(problemsOf(files) == ["`Email` cannot be constructed here: `value` is private and has no default"])
    assert(
      notesOf(files)
        == [
          "Only `Email` itself can pass a private field. What a caller gets is a factory of the type, a"
            + " `static fn` that makes one (`Email.tryFrom(...)`)",
        ],
    )
  }

  test "inside the type `Self(...)` passes every field" {
    const source = raw"""
      type Email {
        private value: String

        static fn of(text: String): Email {
          Self(text)
        }
      }
      """
    assert problems(source).isEmpty()
  }

  const token = "public type Token \{\n  private value: String = \"\"\n\}\n"

  test "a private field with a default may be omitted but not passed" {
    const files = outside(
      "Token",
      token,
      raw"""
        fn probe(): Token {
          Token(value: "secret")
        }
        """,
    )
    assert(problemsOf(files) == ["`value` is private to `Token`, so it cannot be passed from here"])
    assert(
      notesOf(files)
        == [
          "A private field is set in the file that declares `Token`: in its body, in an `extend` of it there, or in a"
            + " function of that file",
        ],
    )
  }

  test "omitting it is fine" {
    const source = raw"""
      fn probe(): Token {
        Token()
      }

      type Token {
        private value: String = ""
      }
      """
    assert problems(source).isEmpty()
  }

  test "a positional argument for a private field is refused as well" {
    const files = outside(
      "Pair",
      "public type Pair \{\n  first: Int = 0\n  private second: Int = 0\n\}\n",
      raw"""
        fn probe(): Pair {
          Pair(1, 2)
        }
        """,
    )
    assert(problemsOf(files) == ["`second` is private to `Pair`, so it cannot be passed from here"])
  }

  test "`copy` follows the constructor: a private field is not passable from outside" {
    const files = outside(
      "Token",
      token,
      raw"""
        fn probe(token: Token): Token {
          token.copy(value: "other")
        }
        """,
    )
    assert(problemsOf(files) == ["`value` is private to `Token`, so it cannot be passed from here"])
  }

  test "`copy` of a public field is fine, private field without a default and all" {
    const source = raw"""
      fn probe(token: Token): Token {
        token.copy(label: "other")
      }

      type Token {
        var label: String = ""
        private value: String
      }
      """
    assert problems(source).isEmpty()
  }
}

group "Patterns read fields, so `private` reaches them" {
  test "a pattern over a type with a private field is refused from outside" {
    const files = outside(
      "Point",
      "public type Point \{\n  x: Int\n  private y: Int = 0\n\}\n",
      raw"""
        fn probe(point: Point): Int {
          match point {
            Point(a, b) => a + b
          }
        }
        """,
    )
    assert(problemsOf(files) == ["`y` is private to `Point`, so this pattern cannot read it"])
    assert(
      notesOf(files)
        == [
          "A pattern reads the fields of a value: outside the file that declares `Point` a type with a private field"
            + " is taken apart by its own members",
        ],
    )
  }

  test "inside the type it is ordinary" {
    const source = raw"""
      type Point {
        x: Int
        private y: Int = 0

        fn sum(): Int {
          match self {
            Point(a, b) => a + b
          }
        }
      }
      """
    assert problems(source).isEmpty()
  }
}

group "What `public` promises about its types" {
  test "a `public fn` cannot name a type that is private to its file" {
    const source = raw"""
      public fn make(): Helper {
        Helper(1)
      }

      type Helper {
        value: Int
      }
      """
    assert(problems(source) == ["`make` is `public` and names `Helper`, which is private to this file"])
    assert(
      notes(source)
        == ["Whoever can use a `public` function has to be able to name its types: mark `Helper` as `public` too"],
    )
  }

  test "a parameter is part of the promise, however deeply the type is buried" {
    const source = raw"""
      public fn take(values: List<Helper>): Int {
        values.length()
      }

      type Helper {
        value: Int
      }
      """
    assert(problems(source) == ["`take` is `public` and names `Helper`, which is private to this file"])
  }

  test "a field of a `public type` is part of it" {
    const source = raw"""
      public type Report {
        helper: Helper
      }

      type Helper {
        value: Int
      }
      """
    assert(problems(source) == ["`Report` is `public` and names `Helper`, which is private to this file"])
  }

  test "a `private` field is not: nobody outside can read it, so its type is nobody's business there" {
    const source = raw"""
      public type Report {
        private helper: Helper

        fn total(): Int {
          helper.value
        }
      }

      type Helper {
        value: Int
      }
      """
    assert problems(source).isEmpty()
  }

  test "a `protected var` field is part of it, because everybody reads it" {
    const source = raw"""
      public type Report {
        protected var helper: Helper = Helper(0)
      }

      type Helper {
        value: Int
      }
      """
    assert(problems(source) == ["`Report` is `public` and names `Helper`, which is private to this file"])
  }

  test "a `public const` is part of it" {
    const source = raw"""
      public const fallback: Helper = Helper(1)

      type Helper {
        value: Int
      }
      """
    assert(problems(source) == ["`fallback` is `public` and names `Helper`, which is private to this file"])
  }

  test "marking the type `public` settles it" {
    const source = raw"""
      public fn make(): Helper {
        Helper(1)
      }

      public type Helper {
        value: Int
      }
      """
    assert problems(source).isEmpty()
  }

  test "a private type inside the body of a `public fn` is nobody's business" {
    const source = raw"""
      public fn make(): Int {
        const helper = Helper(1)
        helper.value
      }

      type Helper {
        value: Int
      }
      """
    assert problems(source).isEmpty()
  }
}
