use workspaceWith from "./harness"
use check from "../src/semantics/check"
use printFunction from "../src/ir/print"
use verifyProgram from "../src/ir/verify"
use insertOwnership from "../src/ir/ownership"
use verifyOwnedProgram from "../src/ir/ownership-verify"
use Lowering from "../src/ir/lower/context"
use lowerChecked, loweredText from "../src/ir/lower/lower"

/**
 * What the three tests of the lowering ask of one in-memory program: the IR text of one function, the text of the whole
 * program, and which constructs blocked a function.
 *
 * Every program is checked first and has to be clean unless the test says which messages it expects (`loweredWith`) -
 * the lowering reads the checker's tables, so an unexpected mistake in a program would be a test about the wrong thing
 * - and every function that comes out is run through the verifier by the same question that pins its text. A snapshot
 * that matches and a body that is malformed would otherwise pass together, which is exactly the bug a lowering makes on
 * an untyped interpreter.
 */
public fn lowered(source: String, extra: Map<String, String> = [:]): Lowering {
  loweredWith(source, [], extra)
}

/**
 * The same for a program the checker has something to say about: `expected` are its messages, in the order it gives
 * them. A test needs this where the construct under test *is* a mistake the checker reports - a constant in terms of
 * itself, say - and the question is what the lowering then does with it.
 *
 * `extra` are further files of the workspace, for a program that needs a declaration `acme/app` may not write itself:
 * only the standard library may claim a `native` (gap 22), so a test about lowering one puts it in `std/prelude`.
 */
public fn loweredWith(source: String, expected: List<String>, extra: Map<String, String> = [:]): Lowering {
  var files = extra
  files.set("app/src/main.trb", source)
  const tree = workspaceWith(files)
  const checked = check(tree, ["app"])
  var found: List<String> = []
  for file in checked.files {
    for diagnostic in file.diagnostics {
      // A mistake the test did not ask for has to fail it, with the message in the output
      if !expected.contains(diagnostic.message) {
        assert(diagnostic.message == file.path)
      }
      found.add(diagnostic.message)
    }
  }
  assert(found == expected)
  lowerChecked(checked)
}

/** One function of the program, with the verifier's findings in its place if it has any. */
public fn irOf(source: String, name: String, extra: Map<String, String> = [:]): String {
  var found = lowered(source, extra)
  const problems = verifyProgram(found.program)
  if !problems.isEmpty() {
    return String.join(problems, separator: "\n")
  }
  if !found.program.problems.isEmpty() {
    return String.join(found.program.problems, separator: "\n")
  }
  for function in found.program.functions {
    if function.name == name {
      return printFunction(found.program, function)
    }
  }
  "there is no function `{name}`"
}

/** The whole program: the layouts and the static values as well as the functions. */
public fn textOf(source: String): String {
  var found = lowered(source)
  loweredText(found)
}

/**
 * One function of the **final** IR: after the ownership pass of 5.4, which is what both back ends read. The extended
 * verifier runs over it as well, so a snapshot that matches and a body that leaks a count cannot pass together - which
 * is the whole reason these snapshots are worth writing down.
 */
public fn ownedIrOf(source: String, name: String): String {
  var found = lowered(source)
  insertOwnership(found.program)
  const problems = verifyOwnedProgram(found.program)
  if !problems.isEmpty() {
    return String.join(problems, separator: "\n")
  }
  if !found.program.problems.isEmpty() {
    return String.join(found.program.problems, separator: "\n")
  }
  for function in found.program.functions {
    if function.name == name {
      return printFunction(found.program, function)
    }
  }
  "there is no function `{name}`"
}

/** Which constructs blocked a function, in the order they were first seen. */
public fn unsupportedIn(source: String, extra: Map<String, String> = [:]): List<String> {
  var found = lowered(source, extra)
  var shown: List<String> = []
  for entry in found.unsupported {
    shown.add(entry.what)
  }
  shown
}

/** How many functions of the program got a body, and how many stayed an `unreachable` stub. */
public fn countsOf(source: String): (Int, Int) {
  var found = lowered(source)
  (found.lowered, found.stubbed)
}
