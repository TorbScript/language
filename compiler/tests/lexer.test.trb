/**
 * The lexer: every token kind it produces, the diagnostics of a malformed one, and the parts a text literal
 * interpolates into.
 */

use test, group from "std/test"
use SourceText, LineIndex, Span from "../src/syntax/source"
use TokenKind, TextPart, Keyword from "../src/syntax/token"
use lex, lexRange from "../src/syntax/lexer"

fn kinds(text: String): List<TokenKind> {
  const lexed = lex SourceText.of(text)
  assert lexed.diagnostics.isEmpty()
  lexed.tokens.map({ _.kind }).toList()
}

/** The kinds of a text that has problems: what the lexer made of the broken tokens. */
fn tokensOf(text: String): List<TokenKind> {
  lex(SourceText.of(text)).tokens.map({ _.kind }).toList()
}

fn messages(text: String): List<String> {
  lex(SourceText.of(text)).diagnostics.map({ _.message }).toList()
}

group "Lexer" {
  test "numbers, ranges and tuple indices" {
    assert(kinds("1..5") == [.IntegerLiteral, .DotDot, .IntegerLiteral, .EndOfFile])
    assert(kinds("1.5e3") == [.FloatLiteral, .EndOfFile])
    assert(kinds("16.megabytes") == [.IntegerLiteral, .Dot, .Identifier, .EndOfFile])
    assert(kinds("0xFF 1_000") == [.IntegerLiteral, .IntegerLiteral, .EndOfFile])
    assert(kinds("pair.0.1").length() == 6)
  }

  test "keywords are reserved, `from` is not" {
    assert(kinds("const from") == [.Reserved(Keyword.Const), .Identifier, .EndOfFile])
    // `void` is a keyword like `true` and `false`, because it is the one value of `Void`
    assert(kinds("void true") == [.Reserved(Keyword.Void), .Reserved(Keyword.True), .EndOfFile])
  }

  test "interpolation may contain strings" {
    const tokens = kinds "\"a: \{map[\"a\"]\} \\\{literal\}\""
    const expected = [
      TextPart.Literal("a: "),
      TextPart.Expression(Span(5, 13)),
      TextPart.Literal(" \{literal\}"),
    ]
    assert(tokens[0] == TokenKind.TextLiteral(expected))
  }

  test "a byte order mark in front of the first character is skipped, and only there" {
    assert(kinds("\u{FEFF}const x") == [.Reserved(Keyword.Const), .Identifier, .EndOfFile])
    assert(!messages("const \u{FEFF}x").isEmpty())
  }

  test "escapes" {
    assert(kinds("'\\n'")[0] == TokenKind.CharLiteral('\n'))
    assert(kinds("'\\u\{1F44B\}'")[0] == TokenKind.CharLiteral('👋'))
    assert(messages("'\\q'") == ["Unknown escape sequence `\\q`"])
  }

  test "line breaks that do not end a statement are removed" {
    assert(kinds("a\nb").length() == 4)
    assert(kinds("a +\nb").length() == 4)
    assert(kinds("a &\nb").length() == 4)
    assert(kinds("a\n  .b").length() == 4)
    assert(kinds("f(\na,\nb\n)").length() == 7)
    assert(kinds("/* a /* not nested */ x // y") == [.Identifier, .EndOfFile])
  }

  test "`&` is its own token, `&&` still lexes as one" {
    assert(kinds("&") == [.Ampersand, .EndOfFile])
    assert(kinds("&&") == [.AndAnd, .EndOfFile])
    assert(kinds("A & B") == [.Identifier, .Ampersand, .Identifier, .EndOfFile])
  }

  test "a part of a file keeps the offsets of the file" {
    const source = SourceText.of "print \"ß \{name\}\""
    const lexed = lexRange source, Span(11, 15)
    assert(lexed.tokens[0].span == Span(11, 15))
    assert(lexed.tokens.length() == 2)
  }

  test "problems are reported and skipped" {
    assert(messages("a; b") == ["There are no semicolons. A statement ends at the end of its line"])
    assert(messages("\"open") == ["This string is never closed"])
    assert(messages("§") == ["Unexpected character `§`"])
  }

  test "a broken token still stands for what it meant, so the parser has nothing to add" {
    // `;` is the line break it stands for, `^` the `*` it is read as
    assert(tokensOf("a; b") == [.Identifier, .Newline, .Identifier, .EndOfFile])
    assert(tokensOf("a ^ b") == [.Identifier, .Star, .Identifier, .EndOfFile])
    // `'ab'` ends at its quote and is its first character
    assert(tokensOf("'ab'") == [.CharLiteral('a'), .EndOfFile])
    assert(messages("'ab'") == ["A character literal contains exactly one character and ends with `'`"])
    // An unclosed string or interpolation is the string as far as it was read
    assert(tokensOf("print \"open") == [.Identifier, .TextLiteral([TextPart.Literal("open")]), .EndOfFile])
    const interpolated = tokensOf "print \"total: \{value"
    assert(interpolated.length() == 3)
    assert(interpolated[1] == TokenKind.TextLiteral([TextPart.Literal("total: ")]))
  }

  test "a name is written in ASCII letters, digits and `_`" {
    const nameRule = "A name is written in ASCII letters, digits and `_`"
    assert(messages("const größe = 1") == [nameRule])
    // One diagnostic for the whole run, whatever the letters are and wherever they stand in the name
    assert(messages("const Ünïcödé = 1") == [nameRule])
    // A digit from another script counts too, and a name cannot begin with one anyway
    assert(messages("const count٣ = 1") == [nameRule])
    // ...and the token stays a name, so nothing else is reported about the line
    const lexed = lex SourceText.of("größe")
    assert(lexed.tokens.map({ _.kind }).toList() == [.Identifier, .EndOfFile])
    assert(lexed.diagnostics[0].span == Span(0, 7))
    assert(lexed.diagnostics[0].notes == ["Text is not: a string, a character literal and a comment may contain anything"])
    // Text, characters and comments stay full Unicode
    assert(messages("\"Grüße 👋\" // Übrigens") == [])
    assert(messages("'ß'") == [])
  }
}

group "Multi-line strings" {
  test "the line break right after the opening `\"\"\"` is not part of the string" {
    assert(kinds("\"\"\"\ncontent\n\"\"\"")[0] == TokenKind.TextLiteral([TextPart.Literal("content\n")]))
    // A one-line triple-quoted string is unchanged, leading and trailing spaces included.
    assert(kinds("\"\"\" content \"\"\"")[0] == TokenKind.TextLiteral([TextPart.Literal(" content ")]))
  }

  test "a multi-line string is dedented by the indentation of its first line" {
    const source = "\"\"\"\n  first\n  second\n  \"\"\""
    assert(kinds(source)[0] == TokenKind.TextLiteral([TextPart.Literal("first\nsecond\n")]))
  }

  test "more indentation than the reference is kept, and blank or whitespace-only lines become empty" {
    const source = "\"\"\"\n  first\n    nested\n\n  \t \n  last\n  \"\"\""
    assert(kinds(source)[0] == TokenKind.TextLiteral([TextPart.Literal("first\n  nested\n\n\nlast\n")]))
  }

  test "the closing `\"\"\"` need not be indented at all" {
    const source = "\"\"\"\n  first\n  second\n\"\"\""
    assert(kinds(source)[0] == TokenKind.TextLiteral([TextPart.Literal("first\nsecond\n")]))
  }

  test "a line indented less than the reference is a lexer error, and the string still lexes unchanged" {
    const source = "\"\"\"\n  first\nsecond\n  \"\"\""
    const lexed = lex SourceText.of(source)
    assert(lexed.diagnostics.map({ _.message }).toList() == ["This line is indented less than the first line of the string"])
    assert(lexed.tokens[0].kind == TokenKind.TextLiteral([TextPart.Literal("first\nsecond\n")]))
  }

  test "a tab does not match a reference of spaces, even at the same or greater width" {
    const source = "\"\"\"\n  first\n\tsecond\n  \"\"\""
    assert(messages(source) == ["This line is indented less than the first line of the string"])
  }

  test "raw multi-line strings are dedented too" {
    const source = "r\"\"\"\n  first\n  \"\"\""
    assert(kinds(source)[0] == TokenKind.TextLiteral([TextPart.Literal("first\n")]))
  }

  test "`raw` is the current spelling of the raw-string prefix, `r` the older one, both decode the same way" {
    const expected = [TextPart.Literal("a\\\{b\}")]
    assert(kinds("raw\"a\\\{b\}\"")[0] == TokenKind.TextLiteral(expected))
    assert(kinds("r\"a\\\{b\}\"")[0] == TokenKind.TextLiteral(expected))
    const block = [TextPart.Literal("first\n")]
    assert(kinds("raw\"\"\"\n  first\n  \"\"\"")[0] == TokenKind.TextLiteral(block))
  }

  test "`raw` directly in front of `\"` is the prefix, and an ordinary name everywhere else" {
    // No space between `raw` and the quote: still the prefix
    assert(kinds("raw\"x\"") == [TokenKind.TextLiteral([TextPart.Literal("x")]), .EndOfFile])
    // `raw` followed by anything but `\"` is a plain identifier
    assert(kinds("raw") == [.Identifier, .EndOfFile])
    assert(kinds("const raw = 1") == [.Reserved(Keyword.Const), .Identifier, .Equal, .IntegerLiteral, .EndOfFile])
    assert(kinds("raw.length()").length() == 6)
    // A name that merely starts with `raw` is unaffected
    assert(kinds("rawText") == [.Identifier, .EndOfFile])
  }

  test "an interpolation counts as content, and its value is never dedented" {
    const source = "\"\"\"\n  a\{1\}\n  b\{2\}\n  \"\"\""
    const expected = [
      TextPart.Literal("a"),
      TextPart.Expression(Span(8, 9)),
      TextPart.Literal("\nb"),
      TextPart.Expression(Span(15, 16)),
      TextPart.Literal("\n"),
    ]
    assert(kinds(source)[0] == TokenKind.TextLiteral(expected))
  }
}

group "LineIndex" {
  test "counts characters, not bytes" {
    const lines = LineIndex.of "äö = 1\nb = 2"
    assert(lines.lineAndColumn(0) == (line: 1, column: 1))
    assert(lines.lineAndColumn(4) == (line: 1, column: 3))
    assert(lines.lineAndColumn(9) == (line: 2, column: 1))
    assert(lines.lineAndColumn(999) == (line: 2, column: 6))
  }
}
