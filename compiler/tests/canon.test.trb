/**
 * Text in, text out for every condition of the canon, in both directions of every rule.
 */

use test, group from "std/test"
use rewrite, Rule from "../src/canon/command"
use SourceText from "../src/syntax/source"
use lex from "../src/syntax/lexer"
use Token, TokenKind, TextPart from "../src/syntax/token"

/** What the default rules (`calls` and `strings`) make of a source, and what a second run makes of that: the canon is idempotent, so the two are the same. */
fn defaultCanon(source: String): String {
  applied source, [Rule.Calls, Rule.Strings]
}

fn applied(source: String, rules: List<Rule>): String {
  const once = rewrite source, rules
  assert once.dropped.isEmpty()
  const twice = rewrite once.text, rules
  assert(twice.text == once.text)
  once.text
}

/** The source is already in the canon: nothing changes, and nothing is reported. */
fn unchanged(source: String) {
  assert(defaultCanon(source) == source)
}

/** The literal parts of the single string literal of a source, exactly as the lexer read them - an interpolation is a range of the source and moves with it, so it only counts as a part that is there. */
fn textPartsOf(source: String): List<String> {
  const lexed = lex SourceText.of(source)
  assert lexed.diagnostics.isEmpty()
  const token = lexed.tokens.find({ isTextLiteral _ }).expect("a string")
  match token.kind {
    .TextLiteral(parts) => parts.map({ describeTextPart _ }).toList()
    _ => []
  }
}

fn isTextLiteral(token: Token): Bool {
  match token.kind {
    .TextLiteral(_) => true
    _ => false
  }
}

fn describeTextPart(part: TextPart): String {
  match part {
    .Literal(text) => "literal {text}"
    .Expression(_) => "an interpolation"
  }
}

group "The calls that become commands" {
  test "a call in command position loses its parentheses" {
    assert(defaultCanon("print(\"Hello\")") == "print \"Hello\"")
    assert(defaultCanon("fn f() \{\n  return Fail(problem)\n\}") == "fn f() \{\n  return Fail problem\n\}")
    assert(defaultCanon("const role = Role(name)") == "const role = Role name")
    assert(defaultCanon("var role = Role(name)") == "var role = Role name")
    assert(defaultCanon("public const role = Role(name)") == "public const role = Role name")
    assert(defaultCanon("fn f() \{\n  role = Role(name)\n\}") == "fn f() \{\n  role = Role name\n\}")
    assert(defaultCanon("const email = Email.tryFrom(text)") == "const email = Email.tryFrom text")
    assert(defaultCanon("names.map(Role)") == "names.map Role")
    assert(defaultCanon("builder.add(CStatement.Break)") == "builder.add CStatement.Break")
    assert(defaultCanon("self.builder.add(item)") == "self.builder.add item")
    assert(defaultCanon("route(\"/health\", to: \"health\")") == "route \"/health\", to: \"health\"")
  }

  test "a call nested in an argument keeps its parentheses" {
    assert(defaultCanon("fn f() \{\n  return Ok(Some(x))\n\}") == "fn f() \{\n  return Ok Some(x)\n\}")
    assert(defaultCanon("const x = f(g(h(1)))\n") == "const x = f g(h(1))\n")
    unchanged "const x = [f(1), g(2)]"
    unchanged "const x = (f(1), g(2))"
    unchanged "const x = [\"a\": f(1)]"
    unchanged "const x = \"value: \{f(1)\}\""
    unchanged "const x = f(1) + g(2)"
    unchanged "const x = -f(1)"
    unchanged "const x = f(1).length()"
    unchanged "const x = f(1)[0]"
    unchanged "const x = f(1)?"
    unchanged "const x = f(1)(2)"
  }

  test "a call in the head of a statement keeps its parentheses" {
    unchanged "fn f() \{\n  if ready(now) \{\n    stop()\n  \}\n\}"
    unchanged "fn f() \{\n  while ready(now) \{\n    stop()\n  \}\n\}"
    unchanged "fn f() \{\n  for item in items(of: list) \{\n    stop()\n  \}\n\}"
    unchanged "fn f() \{\n  match kind(of: item) \{\n    _ => 0\n  \}\n\}"
    unchanged "fn f() \{\n  if const Some(x) = lookup(id) \{\n    stop()\n  \}\n\}"
  }

  test "a call without arguments keeps its parentheses" {
    unchanged "const length = list.length()"
    unchanged "fn f() \{\n  stop()\n\}"
  }

  test "a first argument that cannot start a command keeps the parentheses" {
    unchanged "const x = f((a, b))"
    unchanged "const x = f([1, 2])"
    unchanged "const x = f(-1)"
    unchanged "const x = f(!ready)"
    unchanged "const x = f(.Case)"
    unchanged "const x = f(...items)"
    unchanged "const x = f(from)"
    unchanged "const x = f(as)"
    assert(defaultCanon("const x = f(from: a)") == "const x = f from: a")
  }

  test "an operator at the top level of an argument keeps the parentheses" {
    unchanged "fn f() \{\n  assert(sum == 3)\n\}"
    unchanged "fn f() \{\n  print(count + 1)\n\}"
    unchanged "const x = f(a ?? b)"
    unchanged "const x = f(a?)"
    unchanged "const x = f(0..10)"
    unchanged "const x = f(a && b)"
    unchanged "const x = f(a, b > c)"
    unchanged "const x = f(a as: b)"
    assert(defaultCanon("const x = f(g(a + b))") == "const x = f g(a + b)")
  }

  test "arguments over several lines keep the parentheses" {
    unchanged "const x = f(\n  a,\n  b,\n)"
    unchanged "const x = f(a,\n  b)"
  }

  test "a brace between the parentheses keeps them" {
    unchanged "fn f() \{\n  print(numbers.map(\{ _ * 2 \}))\n\}"
    unchanged "const x = f(if ready \{ 1 \} else \{ 2 \})"
    unchanged "fn f() \{\n  print(match x \{\n    _ => 1\n  \})\n\}"
  }

  test "a trailing closure comes along" {
    assert(defaultCanon("test(\"adds\") \{\n  stop()\n\}") == "test \"adds\" \{\n  stop()\n\}")
    unchanged "html \{\n  stop()\n\}"
    unchanged "f() \{\n  stop()\n\}"
  }

  test "a callee that is not a path keeps the parentheses" {
    unchanged "const x = load<Config>(path)"
    unchanged "const x = pair.0(a)"
    unchanged "const x = maybe?.run(a)"
    unchanged "const x = items[0](a)"
    unchanged "const x = (a).b(c)"
  }

  test "a command in front of a comma keeps its parentheses" {
    unchanged "fn f() \{\n  match x \{\n    .A => print(1), .B => print(2)\n  \}\n\}"
    unchanged "type Shape \{\n  case Circle(radius: Float = scaled(1.0), color: Int = 0)\n\}"
  }

  test "a default of a parameter is not command position but a field is" {
    unchanged "fn f(limit: Int = maximum(1)) \{\}"
    assert(
      defaultCanon("type Config \{\n  limit: Int = maximum(1)\n\}") == "type Config \{\n  limit: Int = maximum 1\n\}",
    )
  }

  test "the body of a match arm and of a closure are command positions" {
    assert(
      defaultCanon("fn f() \{\n  match x \{\n    .A => Ok(x)\n  \}\n\}")
        == "fn f() \{\n  match x \{\n    .A => Ok x\n  \}\n\}",
    )
    assert(defaultCanon("const f = \{ x =>\n  Ok(x)\n\}") == "const f = \{ x =>\n  Ok x\n\}")
    unchanged "fn f() \{\n  match x \{\n    a if ready(a) => 0\n  \}\n\}"
  }

  test "a call of a field of the enclosing type is left exactly as it is" {
    unchanged "type Fold \{\n  step: (Int) => Int\n  var fn add() \{\n    state = step(1)\n  \}\n\}"
    unchanged "type Fold \{\n  step: (Int) => Int\n  var fn add() \{\n    state = self.step(1)\n  \}\n\}"
    unchanged "type Config \{\n  port: Int\n  var fn fill() \{\n    port 8080\n  \}\n\}"
    unchanged "type Config \{\n  port: Int\n  var fn fill() \{\n    port port + 1\n  \}\n\}"
    assert(
      defaultCanon("type Config \{\n  port: Int\n  var fn fill() \{\n    log(port)\n  \}\n\}")
        == "type Config \{\n  port: Int\n  var fn fill() \{\n    log port\n  \}\n\}",
    )
    assert(defaultCanon("type Config \{\n  port: Int\n\}\nport(8080)") == "type Config \{\n  port: Int\n\}\nport 8080")
  }

  test "a space or a comment in front of the parentheses keeps them" {
    unchanged "const x = f (a)"
    unchanged "const x = f/* why */(a)"
    unchanged "const x = f(a )"
    unchanged "const x = f(a,)"
  }

  test "an example in a doc comment is left exactly as it is written, even where it looks like a command call" {
    // A doc comment is not part of the tree `walk` reads, so nothing inside of `/** ... */` is ever a call site - the
    // parentheses of the example stay exactly as written, whatever the real code around it does
    const source = "/**\n"
      + " * Where the two segments cross.\n"
      + " *\n"
      + " *     print Segment2(Vector2(-1.0, 0.0), Vector2(1.0, 0.0)).intersection(across)\n"
      + " */\n"
      + "fn f() \{\n"
      + "  print(Vector2(1.0, 0.0))\n"
      + "\}"
    const after = "/**\n"
      + " * Where the two segments cross.\n"
      + " *\n"
      + " *     print Segment2(Vector2(-1.0, 0.0), Vector2(1.0, 0.0)).intersection(across)\n"
      + " */\n"
      + "fn f() \{\n"
      + "  print Vector2(1.0, 0.0)\n"
      + "\}"
    assert(defaultCanon(source) == after)
  }
}

group "The commands that get parentheses" {
  test "a command with an operator in an argument gets parentheses" {
    assert(defaultCanon("fn f() \{\n  print count + 1\n\}") == "fn f() \{\n  print(count + 1)\n\}")
    assert(defaultCanon("fn f() \{\n  print a, b == c\n\}") == "fn f() \{\n  print(a, b == c)\n\}")
    assert(defaultCanon("fn f() \{\n  print value?\n\}") == "fn f() \{\n  print(value?)\n\}")
    assert(defaultCanon("fn f() \{\n  print 0..10\n\}") == "fn f() \{\n  print(0..10)\n\}")
    assert(defaultCanon("fn f() \{\n  print a ?? b\n\}") == "fn f() \{\n  print(a ?? b)\n\}")
  }

  test "a command over several lines gets parentheses" {
    assert(defaultCanon("fn f() \{\n  print a,\n    b\n\}") == "fn f() \{\n  print(a,\n    b)\n\}")
  }

  test "a command keeps its trailing closure outside of the parentheses" {
    assert(
      defaultCanon("fn f() \{\n  retry 3 + 1 \{\n    stop()\n  \}\n\}")
        == "fn f() \{\n  retry(3 + 1) \{\n    stop()\n  \}\n\}",
    )
  }

  test "a command in a default of a case field gets parentheses" {
    assert(
      defaultCanon("type Shape \{\n  case Circle(radius: Float = scaled 1.0)\n\}")
        == "type Shape \{\n  case Circle(radius: Float = scaled(1.0))\n\}",
    )
  }
}

group "Multi-line strings" {
  test "a flush left string is indented" {
    assert(
      defaultCanon("fn f() \{\n  const source = \"\"\"\nfn main() \\\{\n  print \"x\"\n\\\}\n\"\"\"\n\}")
        == "fn f() \{\n  const source = \"\"\"\n    fn main() \\\{\n      print \"x\"\n    \\\}\n    \"\"\"\n\}",
    )
  }

  test "an over-indented string is brought back" {
    assert(
      defaultCanon("const text = \"\"\"\n        first\n          nested\n        \"\"\"")
        == "const text = \"\"\"\n  first\n    nested\n  \"\"\"",
    )
  }

  test "a string that is already in the form is left alone" {
    unchanged "const text = \"\"\"\n  first\n  second\n  \"\"\""
    unchanged "fn f() \{\n  const text = \"\"\"\n    first\n    \"\"\"\n\}"
  }

  test "a blank line inside a string becomes empty" {
    assert(
      defaultCanon("const text = \"\"\"\n  first\n   \t \n  last\n  \"\"\"")
        == "const text = \"\"\"\n  first\n\n  last\n  \"\"\"",
    )
  }

  test "a raw string and an interpolated one are indented too" {
    assert(defaultCanon("const text = raw\"\"\"\nfirst\\n\n\"\"\"") == "const text = raw\"\"\"\n  first\\n\n  \"\"\"")
    assert(defaultCanon("const text = \"\"\"\na\{1\}\nb\n\"\"\"") == "const text = \"\"\"\n  a\{1\}\n  b\n  \"\"\"")
    assert(
      defaultCanon("const text = \"\"\"\n\\\{literal\}\n\"\"\"") == "const text = \"\"\"\n  \\\{literal\}\n  \"\"\"",
    )
  }

  test "a one-line string is left alone" {
    unchanged "const text = \"\"\" content \"\"\""
    unchanged "const text = \"one line\""
  }

  test "content on the line of the opening quotes moves to the next line" {
    assert(
      defaultCanon("const text = \"\"\"first\nsecond\n\"\"\"") == "const text = \"\"\"\n  first\n  second\n  \"\"\"",
    )
    assert(
      defaultCanon("const text = raw\"\"\"  first\n    nested\n  last\"\"\"")
        == "const text = raw\"\"\"\n  first\n    nested\n  last\"\"\"",
    )
  }

  test "a line indented less than the reference is a lexer error, so that file never reaches the rule at all" {
    const source = "const text = raw\"\"\"  first\nflush\n  \"\"\""
    const outcome = rewrite source, [Rule.Strings]
    assert(outcome.text == source)
    assert(outcome.skipped == ["it does not parse"])
  }

  test "the closing quotes may sit on the last content line" {
    assert(defaultCanon("const text = \"\"\"\nfirst\nlast\"\"\"") == "const text = \"\"\"\n  first\n  last\"\"\"")
  }

  test "the value of every rewritten string is the one from before" {
    const sources = [
      "const text = \"\"\"\nfn main() \\\{\n  print \"x\"\n\\\}\n\"\"\"",
      "const text = \"\"\"\n        first\n          nested\n\n        last\n        \"\"\"",
      "const text = raw\"\"\"\nfirst\\n\n\{ignored\}\n\"\"\"",
      "const text = \"\"\"\na\{1\}\n  b\{2\}\n\"\"\"",
      "const text = raw\"\"\"  const found = 1\n    .Circle(radius) => radius\n  print found\"\"\"",
      "const text = raw\"\"\"static void f(void) \\\{\n  goto L1;\n\\\}\"\"\"",
    ]
    for source in sources {
      const rewritten = defaultCanon source
      assert(rewritten != source)
      assert(textPartsOf(rewritten) == textPartsOf(source))
    }
  }
}

group "The rule that is not part of the default run: imported-case-patterns" {
  test "imported case patterns are off by default" {
    unchanged "use Option.None from \"std/core\"\nfn f() \{\n  match x \{\n    .None => 0\n    _ => 1\n  \}\n\}"
  }

  test "an imported payload-less case loses its dot" {
    const rules = [Rule.ImportedCasePatterns]
    assert(
      applied("use Option.None from \"std/core\"\nfn f() \{\n  match x \{\n    .None => 0\n    _ => 1\n  \}\n\}", rules)
        == "use Option.None from \"std/core\"\nfn f() \{\n  match x \{\n    None => 0\n    _ => 1\n  \}\n\}",
    )
    // Without `from` the path is resolved in the file's own scope, and a case out of it counts the same way
    assert(
      applied("use Shape.Empty\nfn f() \{\n  match x \{\n    .Empty => 0\n    _ => 1\n  \}\n\}", rules)
        == "use Shape.Empty\nfn f() \{\n  match x \{\n    Empty => 0\n    _ => 1\n  \}\n\}",
    )
    // A single name is a whole export and not a case, so it shadows instead of importing one
    assert(
      applied("use Empty from \"./shape\"\nfn f() \{\n  match x \{\n    .Empty => 0\n    _ => 1\n  \}\n\}", rules)
        == "use Empty from \"./shape\"\nfn f() \{\n  match x \{\n    .Empty => 0\n    _ => 1\n  \}\n\}",
    )
    // The prelude's own is imported everywhere
    assert(
      applied("fn f() \{\n  match x \{\n    .None => 0\n    _ => 1\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    None => 0\n    _ => 1\n  \}\n\}",
    )
    // A case with a payload is written the way the parser reads it already
    assert(
      applied("fn f() \{\n  match x \{\n    .Some(value) => value\n    _ => 0\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    .Some(value) => value\n    _ => 0\n  \}\n\}",
    )
    // A case that is not imported keeps its dot
    assert(
      applied("fn f() \{\n  match x \{\n    .Dot => 0\n    _ => 1\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    .Dot => 0\n    _ => 1\n  \}\n\}",
    )
    // A file that declares a name of the prelude shadows it
    assert(
      applied("type None \{\}\nfn f() \{\n  match x \{\n    .None => 0\n    _ => 1\n  \}\n\}", rules)
        == "type None \{\}\nfn f() \{\n  match x \{\n    .None => 0\n    _ => 1\n  \}\n\}",
    )
  }
}

group "The rule that is not part of the default run: unused-bindings" {
  test "unused bindings are off by default" {
    unchanged "fn f() \{\n  match x \{\n    Some(value) => true\n    _ => false\n  \}\n\}"
  }

  test "a binding of a refutable pattern that is nowhere in the arm becomes a wildcard" {
    const rules = [Rule.UnusedBindings]
    assert(
      applied("fn f() \{\n  match x \{\n    Some(value) => true\n    _ => false\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    Some(_) => true\n    _ => false\n  \}\n\}",
    )
    // A bare name binds and matches everything, which is the arm the rule is really about
    assert(
      applied("fn f() \{\n  match x \{\n    1 => 0\n    limit => 2\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    1 => 0\n    _ => 2\n  \}\n\}",
    )
    // Every position of a tuple, a list and a case, as deep as they go
    assert(
      applied("fn f() \{\n  match x \{\n    (a, [b, Some(c)]) => 0\n    _ => 1\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    (_, [_, Some(_)]) => 0\n    _ => 1\n  \}\n\}",
    )
  }

  test "a binding the arm uses is left exactly as it is" {
    const rules = [Rule.UnusedBindings]
    const leaves = { source: String => assert(applied(source, rules) == source) }
    // In the body, in a guard, and in the body of the arm a guard belongs to
    leaves "fn f() \{\n  match x \{\n    Some(value) => value\n    _ => 0\n  \}\n\}"
    leaves "fn f() \{\n  match x \{\n    Some(value) if value > 1 => 0\n    _ => 1\n  \}\n\}"
    leaves "fn f() \{\n  match x \{\n    Some(value) if ready() => value\n    _ => 0\n  \}\n\}"
    // The use may be anywhere in the body, however deep
    leaves "fn f() \{\n  match x \{\n    Some(value) => \{\n      print \"got \{value\}\"\n    \}\n    _ => \{\}\n  \}\n\}"
    // `_reason` is the documented form and is never rewritten
    leaves "fn f() \{\n  match x \{\n    Some(_reason) => true\n    _ => false\n  \}\n\}"
    // A name that stands in a comment or a string counts as a use: the rule sees text, and the checker says the rest
    leaves "fn f() \{\n  match x \{\n    Some(value) => \{\n      // value is ignored here\n      0\n    \}\n    _ => 1\n  \}\n\}"
    // A longer name that only contains the binding's name is not a use of it
    assert(
      applied("fn f() \{\n  match x \{\n    Some(value) => values\n    _ => 0\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    Some(_) => values\n    _ => 0\n  \}\n\}",
    )
  }

  test "every alternative of a pattern is rewritten together" {
    const rules = [Rule.UnusedBindings]
    // The language requires every alternative to bind the same names, so all of them have to change or none
    assert(
      applied("fn f() \{\n  match x \{\n    Some(value) | Ok(value) => true\n    _ => false\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    Some(_) | Ok(_) => true\n    _ => false\n  \}\n\}",
    )
    assert(
      applied("fn f() \{\n  match x \{\n    Some(value) | Ok(value) => value\n    _ => 0\n  \}\n\}", rules)
        == "fn f() \{\n  match x \{\n    Some(value) | Ok(value) => value\n    _ => 0\n  \}\n\}",
    )
  }

  test "the head of an if and of a while are refutable too" {
    const rules = [Rule.UnusedBindings]
    assert(
      applied("fn f() \{\n  if const Some(user) = lookup() \{\n    stop()\n  \}\n\}", rules)
        == "fn f() \{\n  if const Some(_) = lookup() \{\n    stop()\n  \}\n\}",
    )
    assert(
      applied("fn f() \{\n  if var Some(user) = lookup() \{\n    user.stop()\n  \}\n\}", rules)
        == "fn f() \{\n  if var Some(user) = lookup() \{\n    user.stop()\n  \}\n\}",
    )
    // The `else` is outside the binding's scope, so a name that only stands there is no use of it
    assert(
      applied(
        "fn f() \{\n  const x = if const Some(user) = lookup() \{\n    1\n  \} else \{\n    user\n  \}\n\}",
        rules,
      )
        == "fn f() \{\n  const x = if const Some(_) = lookup() \{\n    1\n  \} else \{\n    user\n  \}\n\}",
    )
    assert(
      applied("fn f() \{\n  while const Some(item) = next() \{\n    count()\n  \}\n\}", rules)
        == "fn f() \{\n  while const Some(_) = next() \{\n    count()\n  \}\n\}",
    )
    assert(
      applied("fn f() \{\n  while const Some(item) = next() \{\n    count(item)\n  \}\n\}", rules)
        == "fn f() \{\n  while const Some(item) = next() \{\n    count(item)\n  \}\n\}",
    )
  }

  test "an irrefutable binding is not part of the rule" {
    const rules = [Rule.UnusedBindings]
    const leaves = { source: String => assert(applied(source, rules) == source) }
    leaves "fn f() \{\n  const value = 1\n\}"
    leaves "fn f() \{\n  const (first, second) = pair\n\}"
    leaves "fn f() \{\n  for item in items \{\n    stop()\n  \}\n\}"
    leaves "fn f() \{\n  items.each(\{ item => stop() \})\n\}"
    leaves "fn f(value: Int) \{\n  stop()\n\}"
  }
}

group "`while true` becomes `loop`" {
  test "an endless while becomes a loop" {
    const rules = [Rule.Loops]
    assert(
      applied("fn f() \{\n  while true \{\n    step()\n  \}\n\}", rules)
        == "fn f() \{\n  loop \{\n    step()\n  \}\n\}",
    )
    // The body is rewritten too, however deep it sits
    assert(
      applied("fn f() \{\n  loop \{\n    while true \{\n      step()\n    \}\n  \}\n\}", rules)
        == "fn f() \{\n  loop \{\n    loop \{\n      step()\n    \}\n  \}\n\}",
    )
    // Everything from the `{` on stays byte-identical, comments and line endings included
    assert(
      applied("fn f() \{\n  while true \{ // forever\n    step()\n  \}\n\}\n", rules)
        == "fn f() \{\n  loop \{ // forever\n    step()\n  \}\n\}\n",
    )
  }

  test "every other loop is left alone" {
    const rules = [Rule.Loops]
    const leaves = { source: String => assert(applied(source, rules) == source) }
    leaves "fn f() \{\n  while false \{\n    step()\n  \}\n\}"
    leaves "fn f() \{\n  while goes_on \{\n    step()\n  \}\n\}"
    leaves "fn f() \{\n  while const Some(item) = next() \{\n    step(item)\n  \}\n\}"
    leaves "fn f() \{\n  loop \{\n    step()\n  \}\n\}"
  }
}

group "`raw\"...\"` is the only spelling the canon ever sees" {
  test "the older `r\"...\"` is a lexer diagnostic now, so the whole file is left alone like any other that does not parse" {
    const outcome = rewrite "const x = r\"a\"", [Rule.Calls, Rule.Strings]
    assert(outcome.text == "const x = r\"a\"")
    assert(outcome.skipped == ["it does not parse"])
  }

  test "`raw` alone, in front of anything but `\"`, is an ordinary name and never rewritten" {
    unchanged "const raw = 1"
    unchanged "fn raw(): Int \{\n  1\n\}"
  }
}

group "The safety net" {
  test "a file that does not parse is left alone" {
    const source = "fn f( \{\n"
    const outcome = rewrite source, [Rule.Calls, Rule.Strings]
    assert(outcome.text == source)
    assert(outcome.skipped == ["it does not parse"])
  }

  test "line endings and everything around an edit stay as they are" {
    assert(
      defaultCanon("// a comment\r\nconst role = Role(name)\r\n\r\n// and another\r\n")
        == "// a comment\r\nconst role = Role name\r\n\r\n// and another\r\n",
    )
  }

  test "the canon of the examples of the decision is what the decision says" {
    assert(defaultCanon("fn f() \{\n  items.add(Item(name, 2))\n\}") == "fn f() \{\n  items.add Item(name, 2)\n\}")
    assert(defaultCanon("fn f() \{\n  return Ok(value)\n\}") == "fn f() \{\n  return Ok value\n\}")
  }
}
