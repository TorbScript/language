/**
 * The manifest of natives is the contract between the lowering and the runtime, so what is tested here is that it is a
 * *table*: every name in it exactly once, every ready runtime symbol spelled `torb_`, every ready runtime entry
 * carrying the prototype the generated header prints, and the header itself a pure function of the table.
 *
 * The C side of the check is `runtime/tests/natives_header_test.c`, which includes the generated header after
 * `torb.h` so the C compiler compares the two declarations of every symbol. `torb natives --header` writes
 * `runtime/include/torb_natives.h` from the same table, and reading that checked-in file back and comparing it
 * byte-for-byte is what keeps the two sides from drifting without a C compiler error.
 */

use test, group from "std/test"
use NativeEntry, NativeState, NativeTarget from "../src/backend/c/natives"
use nativeEntries, findNative, renderNativesHeader, countNatives from "../src/backend/c/natives"
use File from "std/fs"
use normalizePath, parentPath, pathDepth, joinPath from "../src/project/path"

fn readyEntries(): List<NativeEntry> {
  var found: List<NativeEntry> = []
  for entry in nativeEntries() {
    if const .Planned(_) = entry.state {
      continue
    }
    found.add entry
  }
  found
}

fn headerLines(): List<String> {
  renderNativesHeader(nativeEntries()).split("\n")
}

/** The parameters the callee stores, or an empty list when the name is not in the table. */
fn ownedOf(name: String): List<Int> {
  if const Some(entry) = findNative(nativeEntries(), name) {
    return entry.ownedParameters
  }
  []
}

/** The C prototype a name carries, or an empty string when the name is not in the table. */
fn prototypeOf(name: String): String {
  if const Some(entry) = findNative(nativeEntries(), name) {
    return entry.prototype
  }
  ""
}

/** The runtime symbol a name maps to, or an empty string when it maps to an intrinsic or a derived body. */
fn symbolOf(name: String): String {
  if const Some(entry) = findNative(nativeEntries(), name) {
    if const .Runtime(function) = entry.target {
      return function
    }
  }
  ""
}

group "the manifest of natives" {
  test "every name is in the table exactly once" {
    var seen: Map<String, Int> = [:]
    for entry in nativeEntries() {
      const known = (seen.get(entry.name) ?? 0) + 1
      seen.set entry.name, known
    }
    var repeated: List<String> = []
    for (name, count) in seen {
      if count > 1 {
        repeated.add name
      }
    }
    assert(repeated == [])
    assert(seen.length() == nativeEntries().length())
  }

  test "a name that is not in the table is not found" {
    const entries = nativeEntries()
    assert(findNative(entries, "String.thereIsNoSuchMethod") == None)
    assert(findNative(entries, "String.trim") != None)
    assert(findNative(entries, "ArrayList.add") != None)
    assert(findNative(entries, "Decimal.add") != None)
  }

  test "every runtime symbol is prefixed and every ready one carries its prototype" {
    for entry in nativeEntries() {
      if const .Runtime(function) = entry.target {
        assert function.startsWith("torb_")
      }
    }
    for entry in readyEntries() {
      if const .Runtime(function) = entry.target {
        assert(!entry.prototype.isEmpty())
        assert entry.prototype.contains(function)
        assert entry.prototype.endsWith(";")
      }
    }
  }

  test "a planned entry names its milestone and carries no prototype" {
    var planned = 0
    for entry in nativeEntries() {
      if const .Planned(milestone) = entry.state {
        planned = planned + 1
        assert(!milestone.isEmpty())
        assert entry.prototype.isEmpty()
      }
    }
    assert(planned > 0)
  }

  test "the parameters a native stores are recorded" {
    assert(ownedOf("ArrayList.add") == [1])
    assert(ownedOf("HashMap.set") == [1, 2])
    assert(ownedOf("TrieMap.set") == [1, 2])
    assert(ownedOf("HashSet.add") == [1])
    assert(ownedOf("ArrayList.length") == [])
  }

  test "the trie names are the array and hash implementations" {
    const entries = nativeEntries()
    assert(entries.length() > 0)
    for member in ["add", "get", "length", "removeAt", "slice"] {
      assert(symbolOf("ArrayList.{member}") == symbolOf("TrieList.{member}"))
      assert symbolOf("ArrayList.{member}").startsWith("torb_list_")
    }
    for member in ["get", "set", "remove", "length"] {
      assert(symbolOf("HashMap.{member}") == symbolOf("TrieMap.{member}"))
      assert(symbolOf("HashSet.{member}") == symbolOf("TrieSet.{member}"))
    }
  }

  test "every integer width has every member of Numeric, Signed, Bits and Hash" {
    const entries = nativeEntries()
    const signedMembers = [
      "add", "subtract", "multiply", "divide", "remainder", "equals", "compare", "show", "parse", "negate",
      "absolute", "hash", "bitwiseAnd", "bitwiseOr", "bitwiseExclusiveOr", "bitwiseNot", "shiftedLeft",
      "shiftedRight",
    ]
    for width in [8, 16, 32, 64] {
      for member in signedMembers {
        assert(findNative(entries, "Int{width}.{member}") != None)
      }
    }
    const unsignedMembers = [
      "add", "subtract", "multiply", "divide", "remainder", "equals", "compare", "show", "parse", "hash",
      "bitwiseAnd", "bitwiseOr", "bitwiseExclusiveOr", "bitwiseNot", "shiftedLeft", "shiftedRight",
    ]
    for width in [8, 16, 32, 64] {
      for member in unsignedMembers {
        assert(findNative(entries, "UInt{width}.{member}") != None)
      }
    }
  }

  /**
   * A comparison the **runtime** owns answers a sign and not an `Ordering`, which is a variant type of the program that no
   * function of `runtime/` could build. There are exactly three: the total order over the floats with `nan` above
   * everything (decided gap 5), and the two of `std/time`, whose `Instant` and `Duration` are both `int64_t` nanoseconds.
   * Every other `compare` is `.Derived` and gets its two comparisons from the layout.
   */
  test "every comparison of the runtime answers a sign, and only those three do" {
    var ordered: List<String> = []
    for entry in nativeEntries() {
      if const .Ordering = entry.result {
        ordered.add entry.name
      }
    }
    assert(ordered == ["Float64.compare", "Instant.compare", "Duration.compare"])
    for name in ordered {
      // The prototype is what the emitter compares the wrapper's call against, so the sign has to be spelled in it
      assert prototypeOf(name).startsWith("int32_t ")
    }
  }

  test "the counts of the table" {
    const counts = countNatives nativeEntries()
    assert(counts.ready == 296)
    assert(counts.planned == 73)
    assert(counts.symbols == 113)
    assert(counts.ready + counts.planned == nativeEntries().length())
  }
}

group "the generated header" {
  /** The root of the repository, found from wherever the test runner was started. */
  fn repositoryRoot(): String? {
    var current = normalizePath File.absolutePath(".").expect("the working directory")
    while pathDepth(current) >= 1 {
      if File.exists(joinPath(current, "compiler/project.trb")) {
        return Some current
      }
      const parent = parentPath current
      if parent == current {
        return None
      }
      current = parent
    }
    None
  }

  /**
   * The checked-in header is what the manifest renders, byte for byte. `torb natives --header` writes it, and this is
   * the other half of that contract: a manifest entry that is added without running the command fails here instead of
   * failing at a link step with a mangled name in the message.
   */
  test "the file on disk is what the manifest renders" {
    const root = repositoryRoot().expect("the root of the repository above the working directory")
    const path = joinPath root, "runtime/include/torb_natives.h"
    const written = File.readText(path).expect("the generated header")
    assert(written == renderNativesHeader(nativeEntries()))
  }

  test "it is a header with a guard and includes torb.h" {
    const lines = headerLines()
    assert(lines[0] == "/*")
    assert lines.contains("#ifndef TORB_NATIVES_H")
    assert lines.contains("#define TORB_NATIVES_H")
    assert lines.contains("#include \"torb.h\"")
    assert(lines[lines.length() - 2] == "#endif /* TORB_NATIVES_H */")
  }

  test "every ready runtime symbol is declared exactly once" {
    const header = renderNativesHeader nativeEntries()
    const counts = countNatives nativeEntries()
    var declared = 0
    for line in header.split("\n") {
      if line.endsWith(";") {
        declared = declared + 1
      }
    }
    assert(declared == counts.symbols)
    for entry in readyEntries() {
      if const .Runtime(_) = entry.target {
        assert header.contains(entry.prototype)
      }
    }
  }

  test "the natives that share a symbol are listed above it, sorted" {
    const header = renderNativesHeader nativeEntries()
    assert header.contains("/* ArrayList.add, TrieList.add */\nvoid torb_list_add(torb_list *list, const void *value);")
    assert header.contains("/* String.trim */\ntorb_text torb_text_trim(torb_text text);")
  }

  test "it never depends on the order the entries were built in" {
    var flipped = nativeEntries()
    flipped.reverse()
    assert(renderNativesHeader(flipped) == renderNativesHeader(nativeEntries()))
  }
}
