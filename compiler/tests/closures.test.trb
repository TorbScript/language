/**
 * Closures, read from the type that is expected of them: the parameters the function type names, the implicit `_` and
 * `_2`, the result that comes out of the body, and the bindings the body reads from the scope around it.
 *
 * The captures are the reason this is recorded and not only checked: a captured `var` binding is a shared box and not a
 * copy, and every back end has to build one.
 *
 * The declaration comes *after* the body in most of these sources, so that a name of the closure is the first
 * occurrence of its text and the span the probe asks about is the one in the closure.
 */

use test, group from "std/test"
use probe, problems, notes from "./harness"

/** A function that takes a closure of a known type, which is what every test here reads its closure from. */
const apply = "\nfn apply(transform: (value: Int) => String): String \{\n  transform(1)\n\}\n"

const twice = "\nfn twice(combine: (first: Int, second: Int) => Int): Int \{\n  combine(1, 2)\n\}\n"

const run = "\nfn run(action: () => Int): Int \{\n  action()\n\}\n"

fn inBody(body: String): String {
  "fn probe() \{\n{body}\n\}\n{apply}"
}

group "Parameters from the expected function type" {
  test "a named parameter takes the type the function type gives it" {
    const source = inBody "  const found = apply \{ item => \"\{item\}\" \}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("\{ item => \"\{item\}\" \}") == "(item: Int64) => String")
  }

  test "the result of a closure is what its body produces" {
    const source = "fn probe() \{\n  const found = run \{ 7 \}\n\}\n{run}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("\{ 7 \}") == "() => Int64")
  }

  test "an annotation that disagrees with the expected function type is a mistake" {
    const source = inBody "  const found = apply \{ item: String => item \}"
    assert(problems(source) == ["This parameter is a `Int64`, not a `String`"])
  }

  test "an annotation that agrees is fine" {
    assert problems(inBody("  const found = apply \{ item: Int => \"\{item\}\" \}")).isEmpty()
  }

  test "a closure that writes a different number of parameters says so" {
    const source = inBody "  const found = apply \{ first, second => \"a\" \}"
    assert(problems(source) == ["This closure takes 1 parameter, 2 were written"])
  }

  test "a pattern works as a parameter" {
    const source = "fn probe() \{\n  const found = onPair \{ (a, b) => a + b \}\n\}\n\n"
      + "fn onPair(action: (pair: (Int, Int)) => Int): Int \{\n  action((1, 2))\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.patternTypeOf("(a, b)") == "(Int64, Int64)")
  }

  test "a `var` parameter of the expected function type stays a `var` parameter of the closure" {
    const source = "fn probe() \{\n  step \{ counter => counter.count = 1 \}\n\}\n\n"
      + "type Counter \{\n  var count: Int = 0\n\}\n\n"
      + "fn step(action: (var it: Counter) => Void) \{\n  var counter = Counter()\n  action(counter)\n  print counter.count\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("\{ counter => counter.count = 1 \}") == "(var counter: Counter) => Void")
  }

  test "without an expected function type every parameter needs an annotation" {
    const source = "fn probe() \{\n  const found = take(\{ item => item \})\n\}\n\n"
      + "fn take<Value>(value: Value): Value \{\n  value\n\}"
    assert problems(source).contains("The parameters of this closure need types: `\{ value: Int => ... \}`")
  }

  test "an annotated parameter needs no expected type" {
    const source = "fn probe() \{\n  const found = take(\{ item: Int => item \})\n\}\n\n"
      + "fn take<Value>(value: Value): Value \{\n  value\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("\{ item: Int => item \}") == "(item: Int64) => Int64")
  }
}

group "Implicit parameters" {
  test "`_` is the first parameter of the expected function type" {
    const source = "fn probe() \{\n  const found = increase \{ _ \}\n\}\n\n"
      + "fn increase(transform: (amount: Int) => Int): Int \{\n  transform(1)\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.adaptationsOf("_") == ["parameter 0"])
    assert(probed.typeOf("_") == "Int64")
  }

  test "`_2` is the second one" {
    const source = "fn probe() \{\n  const found = twice \{ _ + _2 \}\n\}\n{twice}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.adaptationsOf("_2") == ["parameter 1"])
  }

  /** The parameter gets its meaning from the one it fills (CONCEPT, "No overloading"), whether it is named or not. */
  test "`_` is a `var` where the expected function type takes the parameter as `var`, as a named one is" {
    const source = "fn probe() \{\n  step \{ _.count = 1 \}\n  step \{ counter => counter.count = 2 \}\n\}\n\n"
      + "type Counter \{\n  var count: Int = 0\n\}\n\n"
      + "fn step(action: (var it: Counter) => Void) \{\n  var counter = Counter()\n  action(counter)\n  print counter.count\n\}"
    assert problems(source).isEmpty()
  }

  test "`_` of a parameter that is not `var` stays a `const`" {
    const source = "fn probe() \{\n  look \{ _.count = 1 \}\n\}\n\n"
      + "type Counter \{\n  var count: Int = 0\n\}\n\n"
      + "fn look(action: (it: Counter) => Void) \{\n  action(Counter())\n\}"
    assert problems(source).any({ _.contains "`_` is a `const`" })
  }

  test "fewer implicit parameters than the function type has is allowed" {
    const source = "fn probe() \{\n  const found = twice \{ _ + 1 \}\n\}\n{twice}"
    assert problems(source).isEmpty()
  }

  test "a closure that wrote its parameters has no implicit ones" {
    const source = inBody "  const found = apply \{ item => \"\{_\}\" \}"
    assert problems(source).contains("The parameters of this closure need types: `\{ value: Int => ... \}`")
  }

  test "`_` without an expected function type asks for the annotation" {
    const source = "fn probe() \{\n  const found = take(\{ _ + 1 \})\n\}\n\n"
      + "fn take<Value>(value: Value): Value \{\n  value\n\}"
    assert problems(source).contains("The parameters of this closure need types: `\{ value: Int => ... \}`")
  }

  test "a bare name is never read against the expected function type (CONCEPT, Trailing Closures)" {
    // The name is not in scope at all: reading it against the function type acted at a distance, and renaming a
    // library's parameter would silently break every caller that relied on it (owner decision, 2026-09-24)
    const source = "fn probe(): Int \{\n  increase \{ amount + 1 \}\n\}\n\n"
      + "fn increase(transform: (amount: Int) => Int): Int \{\n  transform(1)\n\}"
    assert(problems(source) == ["Cannot find `amount` here"])
    assert(notes(source) == ["The parameter of this closure is `_`; to name it, write `\{ amount => ... \}`"])
  }

  test "the note only fires when the name matches a parameter of the expected function type" {
    const source = "fn probe(): Int \{\n  increase \{ nothingNamesThis + 1 \}\n\}\n\n"
      + "fn increase(transform: (amount: Int) => Int): Int \{\n  transform(1)\n\}"
    assert(problems(source) == ["Cannot find `nothingNamesThis` here"])
    assert(notes(source) == [])
  }

  test "a local of the same name as the parameter wins, and nothing is reported" {
    // There is no silent-shadowing error any more, because the bare name never reads the function type at all - it
    // always means the local, exactly like anywhere else a name resolves
    const source = "fn probe(amount: Int): Int \{\n  increase \{ amount + 1 \}\n\}\n\n"
      + "fn increase(transform: (amount: Int) => Int): Int \{\n  transform(1)\n\}"
    assert problems(source).isEmpty()
  }

  test "naming the parameter of the closure is how a caller reads the value" {
    const source = "fn probe(amount: Int): Int \{\n  increase \{ item => item + amount \}\n\}\n\n"
      + "fn increase(transform: (amount: Int) => Int): Int \{\n  transform(1)\n\}"
    assert problems(source).isEmpty()
  }

  test "`_` reads it just as well" {
    const source = "fn probe(amount: Int): Int \{\n  increase \{ _ + amount \}\n\}\n\n"
      + "fn increase(transform: (other: Int) => Int): Int \{\n  transform(1)\n\}"
    assert problems(source).isEmpty()
  }

  test "a top-level declaration of the same name as the parameter is found, and nothing is reported" {
    const source = "const amount = 2\n\nfn probe(): Int \{\n  increase \{ amount + 1 \}\n\}\n\n"
      + "fn increase(transform: (amount: Int) => Int): Int \{\n  transform(1)\n\}"
    assert problems(source).isEmpty()
    assert(probe(source).adaptationsOf("amount + 1") == [])
  }
}

group "Captures" {
  test "a binding of the scope around the closure is recorded as a capture" {
    const source = inBody "  const factor = 3\n  const found = apply \{ \"\{_ * factor\}\" \}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.capturesOf("\{ \"\{_ * factor\}\" \}") == ["factor"])
  }

  test "a captured `var` binding is recorded as one, because it is a shared box and not a copy (gap 19)" {
    const source = inBody "  var seen = 0\n  const found = apply \{ \"\{seen + _\}\" \}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.capturesOf("\{ \"\{seen + _\}\" \}") == ["var seen"])
  }

  test "the closure's own parameters are not captures" {
    const source = inBody "  const found = apply \{ item => \"\{item\}\" \}"
    const probed = probe source
    assert(probed.capturesOf("\{ item => \"\{item\}\" \}") == [])
  }

  test "a parameter of the enclosing function is a capture like any other binding" {
    const source = "fn probe(offset: Int) \{\n  const found = apply \{ \"\{_ + offset\}\" \}\n\}\n{apply}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.capturesOf("\{ \"\{_ + offset\}\" \}") == ["offset"])
  }

  test "a nested closure captures what it reads from further out, and so does the one around it" {
    const source = "fn probe() \{\n  const base = 1\n  const found = run \{ run \{ base \} \}\n\}\n{run}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.capturesOf("\{ base \}") == ["base"])
    assert(probed.capturesOf("\{ run \{ base \} \}") == ["base"])
  }
}

/**
 * A task gets copies of everything, and a captured `var` binding is the one value of the language that is shared
 * (CONCEPT, "Concurrency"). So the capture itself is the error: one `spawn` is already too many, and two that read the
 * same variable are two messages, one at each closure.
 */
group "`spawn` takes no `var` binding with it" {
  test "one `spawn` that captures a `var` is already the error" {
    const source = "fn probe(): Task<Int> \{\n  var total = 0\n  total = 1\n"
      + "  const first = spawn \{ total + 1 \}\n  first.await()\n\}"
    assert(problems(source) == ["`spawn` cannot take the `var` binding `total` with it"])
    assert(
      notes(source) == [
        "A task gets copies, so there is nothing to race for - and a captured `var` binding is the one value the "
          + "language shares. Read it into a `const` before the closure (`const totalNow = total`), or pass the "
          + "changes through a `Channel`",
      ],
    )
  }

  test "two `spawn`s that read the same `var` are two messages, one per capture site" {
    const source = "fn probe(): Task<Int> \{\n  var total = 0\n  total = 1\n"
      + "  const first = spawn \{ total + 1 \}\n  const second = spawn \{ total + 2 \}\n"
      + "  first.await() + second.await()\n\}"
    assert(
      problems(source) == [
        "`spawn` cannot take the `var` binding `total` with it",
        "`spawn` cannot take the `var` binding `total` with it",
      ],
    )
  }

  test "a `const` capture is a copy and is what the rule asks for" {
    const source = "fn probe(): Task<Int> \{\n  const total = 1\n"
      + "  const first = spawn \{ total + 1 \}\n  const second = spawn \{ total + 2 \}\n"
      + "  first.await() + second.await()\n\}"
    assert problems(source).isEmpty()
  }

  test "a `var` parameter of the enclosing function is a reference, and `spawn` names it too" {
    // The second message is the older rule about a `var` parameter and a `Task` result, and both are about this line
    const source = "fn probe(var total: Int): Task<Int> \{\n  total = 1\n"
      + "  const first = spawn \{ total + 1 \}\n  first.await()\n\}"
    assert(
      problems(source) == [
        "`probe` changes `total` and answers a `Task`, and `Int64` is a value",
        "`spawn` cannot take the `var` binding `total` with it",
      ],
    )
  }

  test "a closure that is not handed to `spawn` keeps its shared box" {
    const source = "fn probe() \{\n  var seen = 0\n  const found = apply \{ \"\{seen + _\}\" \}\n\}\n{apply}"
    assert problems(source).isEmpty()
  }

  /**
   * A top-level `var` is not captured at all - it is one place the whole file shares and nothing copies it - so the
   * capture list says nothing about it, and the rule has to ask the declarations the body read instead. This is the
   * four-line data race of `docs/design/CONCURRENCY.md` section 12, written exactly as it stands there.
   */
  test "a top-level `var` is the same race, although it is a declaration and not a capture" {
    const source = "var total = 0\nconst first = spawn \{ total = total + 1 \}\n"
      + "const second = spawn \{ total = total + 1 \}\nprint first.await()\nprint second.await()"
    assert(
      problems(source) == [
        "`spawn` cannot take the `var` binding `total` with it",
        "`spawn` cannot take the `var` binding `total` with it",
      ],
    )
  }

  test "a top-level `const` is a copy like any other" {
    const source = "const total = 1\nconst first = spawn \{ total + 1 \}\nprint first.await()"
    assert problems(source).isEmpty()
  }
}

/**
 * **A `shared type` is confined to the task that made it** (CONCEPT, "Concurrency"): a task gets copies, and an
 * object is not copied - both tasks would hold the same one. `Task` and `Channel` are the two exceptions, because
 * they are what a value crosses *through*.
 */
group "`spawn` takes no object with it" {
  const counter = "shared type Counter \{\n  var count: Int = 0\n\n"
    + "  static fn open(): Self \{\n    Self()\n  \}\n\n  fn value(): Int \{\n    count\n  \}\n\}\n\n"

  test "an object that is captured is named, with what it is" {
    const source = "{counter}fn probe(): Task<Int> \{\n  const counter = Counter.open()\n"
      + "  spawn(\{ counter.value() \}).await()\n\}"
    assert(problems(source) == ["`spawn` cannot take `counter` with it: a `Counter` has an identity"])
    assert(
      notes(source) == [
        "A task gets copies, and an object is not copied. `Task` and `Channel` are what crosses between tasks: make "
          + "the object inside the closure, or send what it holds through a `Channel`",
      ],
    )
  }

  test "a value that holds one anywhere inside it is the same crossing" {
    const source = "{counter}type Holder \{\n  counters: List<Counter>\n\}\n\n"
      + "fn probe(): Task<Int> \{\n  const holder = Holder([Counter.open()])\n"
      + "  spawn(\{ holder.counters.length() \}).await()\n\}"
    assert(problems(source) == ["`spawn` cannot take `holder` with it: a `Holder` holds an object"])
  }

  test "a `Task` and a `Channel` are the two that may cross" {
    const source = "fn probe(later: Task<Int>, relay: Channel<Int>): Task<Int> \{\n"
      + "  spawn(\{ later.await() + relay.capacity \}).await()\n\}"
    assert problems(source).isEmpty()
  }

  test "an object that is made inside the closure never crosses" {
    const source = "{counter}fn probe(): Task<Int> \{\n" + "  spawn(\{ Counter.open().value() \}).await()\n\}"
    assert problems(source).isEmpty()
  }
}

/**
 * A value of an ordinary trait may cross into a task, so it may not hide an object either (CONCURRENCY section 17,
 * option b): the conversion is refused where the value's type holds an object that the trait type does not show.
 */
group "A trait value hides no object" {
  const counter = "shared type Counter \{\n  var count: Int = 0\n\n"
    + "  static fn open(): Self \{\n    Self()\n  \}\n\}\n\n"
  const action = "trait Action \{\n  fn run(): Int\n\}\n\n"
    + "type Bumper with Action, Show \{\n  counter: Counter\n\n  fn run(): Int \{\n    counter.count\n  \}\n\}\n\n"

  test "a value whose type holds an object does not become a value of an ordinary trait" {
    const source = "{counter}{action}fn probe(): Int \{\n  const action: Action = Bumper(Counter.open())\n"
      + "  action.run()\n\}"
    assert(problems(source) == ["`Bumper` holds an object, and a value of `Action` would hide it"])
    assert(
      notes(source) == [
        "A value of an ordinary trait is a value, and `spawn` lets one cross into another task - the object would go "
          + "with it, hidden. Declare the trait a `shared trait`, or keep the value as what it is",
      ],
    )
  }

  test "a `shared trait` is an object itself, and a trait type that names the object shows it" {
    const source = "{counter}shared trait Labelled \{\n  fn label(): String\n\}\n\n"
      + "type Tag with Labelled \{\n  counter: Counter\n\n  fn label(): String \{\n    \"tag\"\n  \}\n\}\n\n"
      + "fn probe(): String \{\n  const labelled: Labelled = Tag(Counter.open())\n"
      + "  const _: Iterate<Counter> = [Counter.open()]\n  labelled.label()\n\}"
    assert problems(source).isEmpty()
  }

  test "a closure is not looked into: what it captured is the pinning's" {
    const source = "{counter}{action}type Deferred with Action \{\n  read: () => Int\n\n"
      + "  fn run(): Int \{\n    read()\n  \}\n\}\n\n"
      + "fn probe(): Int \{\n  const counter = Counter.open()\n"
      + "  const action: Action = Deferred(\{ counter.count \})\n  action.run()\n\}"
    assert problems(source).isEmpty()
  }
}

/**
 * The item of a `Channel` crosses from one task to another, so it may not have an identity either. It is asked where
 * `Channel<Item>` is written - a signature, an annotation, a construction - and not at `sink().add`, which would be
 * a message per call instead of one per item type.
 */
group "A `Channel` carries no object" {
  const counter = "shared type Counter \{\n  var count: Int = 0\n\n"
    + "  static fn open(): Self \{\n    Self()\n  \}\n\}\n\n"

  test "a construction names the item type, and that is where it is checked" {
    const source = "{counter}fn probe(): Int \{\n  const relay = Channel<Counter>()\n  relay.capacity\n\}"
    assert(problems(source) == ["A `Channel` cannot carry a `Counter`: it has an identity"])
    assert(
      notes(source) == [
        "An item of a channel crosses from one task to another, and an object is never copied. Send what the object "
          + "holds instead, or hand over a `Task` or a `Channel` - the two that may cross",
      ],
    )
  }

  test "a signature that writes one is checked as well" {
    const source = "{counter}fn probe(relay: Channel<Counter>): Int \{\n  relay.capacity\n\}"
    assert(problems(source) == ["A `Channel` cannot carry a `Counter`: it has an identity"])
  }

  test "a value that holds an object is refused for the same reason" {
    const source = "{counter}type Holder \{\n  counter: Counter\n\}\n\n"
      + "fn probe(relay: Channel<Holder>): Int \{\n  relay.capacity\n\}"
    assert(problems(source) == ["A `Channel` cannot carry a `Holder`: it holds an object"])
  }

  test "a channel of values, and one of the two objects that may cross, are fine" {
    const source = "fn probe(relay: Channel<Int>, nested: Channel<Task<Int>>): Int \{\n"
      + "  relay.capacity + nested.capacity\n\}"
    assert problems(source).isEmpty()
  }
}

group "Control flow inside a closure" {
  test "`return` returns from the closure and decides its result" {
    const source = "fn probe() \{\n  const found = run \{ return 1 \}\n\}\n{run}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("\{ return 1 \}") == "() => Int64")
  }

  test "a `return` and a last expression have to agree, and one solves the other" {
    const source = "fn probe(flag: Bool) \{\n  const found = maybe \{\n    if flag \{\n      return Some(1)\n"
      + "    \}\n    None\n  \}\n\}\n\n"
      + "fn maybe(action: () => Int?): Int? \{\n  action()\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("None") == "Option<Int64>")
  }

  test "`break` cannot leave a closure" {
    const source = "fn probe(items: List<Int>) \{\n  for item in items \{\n    const found = run \{ break \}\n  \}\n\}\n"
      + run
    assert(problems(source) == ["`break` cannot leave a closure"])
    assert(notes(source) == ["A closure is a function, not a block: `do \{ \}` is not a loop either"])
  }

  test "the body of a closure is checked against the result of the expected function type" {
    const source = inBody "  const found = apply \{ 1 \}"
    assert(problems(source) == ["Expected `String`, found `Int64`"])
  }
}

group "Closures at a generic call" {
  test "a non-closure argument is checked first, so the closure is read from what it decided (design 2.6)" {
    const source = "fn probe(numbers: List<Int>) \{\n  const total = fold(0, numbers) \{ sum, number => sum + number \}\n\}\n\n"
      + "fn fold<State, Item>(initial: State, items: List<Item>, combine: (State, Item) => State): State \{\n"
      + "  initial\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("\{ sum, number => sum + number \}") == "(sum: Int64, number: Int64) => Int64")
  }

  test "the result of the closure solves the parameter it stands for" {
    const source = "fn probe(numbers: List<Int>) \{\n  const shown = convert(numbers) \{ \"\{_\}\" \}\n\}\n\n"
      + "fn convert<Item, Output>(items: List<Item>, transform: (value: Item) => Output): List<Output> \{\n"
      + "  []\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("convert(numbers) \{ \"\{_\}\" \}") == "List<String>")
    assert(probed.typeArgumentsOf("convert(numbers) \{ \"\{_\}\" \}") == ["Int64", "String"])
    // The trailing closure is recorded at the closure, which is where the lowering has to move it from
    assert(probed.adaptationsOf("\{ \"\{_\}\" \}") == ["trailing 1"])
  }

  test "`do` is an ordinary generic function that takes a closure" {
    const source = "fn probe() \{\n  const found = do \{ 1 + 2 \}\n\}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("do \{ 1 + 2 \}") == "Int64")
    assert(probed.typeArgumentsOf("do \{ 1 + 2 \}") == ["Int64"])
  }
}
