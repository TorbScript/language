/**
 * The parser, from source text to the syntax tree: statements, expressions with their precedence, literals, patterns
 * and `use` items, plus the diagnostics of a malformed one.
 */

use test, group from "std/test"
use SourceText from "../src/syntax/source"
use Statement, StatementKind, Expression, ExpressionKind, CallStyle, InfixOperator, TypeKind, PatternKind from "../src/syntax/ast"
use TraitClause from "../src/syntax/ast"
use Visibility, UseItem, Member from "../src/syntax/ast"
use parse from "../src/syntax/parser/parser"

fn statements(text: String): List<Statement> {
  const parsed = parse SourceText.of(text)
  assert parsed.diagnostics.isEmpty()
  parsed.file.statements
}

/** The expression of a file that consists of one expression statement. */
fn expression(text: String): ExpressionKind {
  match statements(text)[0].kind {
    .Evaluate(expression) => expression.kind
    other => panic "Expected an expression statement, found {other}"
  }
}

/** The value of `const name = ...` */
fn bound(text: String): ExpressionKind {
  match statements(text)[0].kind {
    .Bind(binding) => binding.value.kind
    other => panic "Expected a binding, found {other}"
  }
}

fn messages(text: String): List<String> {
  parse(SourceText.of(text)).diagnostics.map({ _.message }).toList()
}

/** The notes of every diagnostic, flattened: what a message offers instead of what it refused. */
fn noteMessages(text: String): List<String> {
  var found: List<String> = []
  for diagnostic in parse(SourceText.of(text)).diagnostics {
    found.appendAll diagnostic.notes
  }
  found
}

/** The members of `type Probe { ... }`, whose body is the text. */
fn membersOf(body: String): List<Member> {
  match statements("type Probe \{\n{body}\n\}")[0].kind {
    .Declare(declaration) => match declaration.kind {
      .Type(declared) => declared.members
      other => panic "Expected a type, found {other}"
    }
    other => panic "Unexpected tree: {other}"
  }
}

/** The parameters of the one function such a body declares, each with `var` in front where it carries one. */
fn memberParameters(body: String): List<String> {
  match membersOf(body)[0].kind {
    .Function(function) => function.parameters.map({ if _.isVar { "var {_.name.text}" } else { _.name.text } }).toList()
    other => panic "Expected a function, found {other}"
  }
}

/** The items of a file that consists of one `use` with a list of names. */
fn useItems(text: String): List<UseItem> {
  match statements(text)[0].kind {
    .Declare(declaration) => match declaration.kind {
      .Use(usage) => match usage.items {
        .Names(items) => items
        other => panic "Expected a list of names, found {other}"
      }
      other => panic "Expected a `use`, found {other}"
    }
    other => panic "Expected a declaration, found {other}"
  }
}

group "Literals" {
  test "`void` is a literal, in an expression and in a pattern" {
    match expression("void") {
      .VoidLiteral => {}
      other => panic "Unexpected tree: {other}"
    }
    match bound("const text = match nothing \{ void => 1 \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .Literal(value) => match value.kind {
          .VoidLiteral => {}
          other => panic "Unexpected literal: {other}"
        }
        other => panic "Unexpected pattern: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
    // A keyword cannot be a name, so nothing can be called `void` anymore
    assert(messages("fn void() \{\}") == ["`void` is a keyword and cannot be used as a name here"])
  }
}

/** Source text of the node, to say what a tree looks like without spelling out spans. */
fn source(text: String, expression: Expression): String {
  text[expression.span.start..expression.span.end]
}

group "Operators" {
  test "multiplication binds tighter than addition" {
    const text = "1 + 2 * 3"
    match expression(text) {
      .Binary(InfixOperator.Add, left, right) => {
        assert(source(text, left) == "1")
        assert(source(text, right) == "2 * 3")
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "`??` groups to the right, `-` to the left" {
    const coalesce = "a ?? b ?? c"
    match expression(coalesce) {
      .Binary(InfixOperator.Coalesce, _, right) => assert(source(coalesce, right) == "b ?? c")
      other => panic "Unexpected tree: {other}"
    }
    const subtract = "a - b - c"
    match expression(subtract) {
      .Binary(InfixOperator.Subtract, left, _) => assert(source(subtract, left) == "a - b")
      other => panic "Unexpected tree: {other}"
    }
  }

  test "comparisons do not chain" {
    assert(messages("const x = a < b > c") == ["Comparisons do not chain. Use `&&`: `a < b && b < c`"])
  }

  test "`**` binds tighter than `*` and groups to the right" {
    const product = "a * b ** c"
    match expression(product) {
      .Binary(InfixOperator.Multiply, left, right) => {
        assert(source(product, left) == "a")
        assert(source(product, right) == "b ** c")
      }
      other => panic "Unexpected tree: {other}"
    }
    const tower = "2 ** 3 ** 2"
    match expression(tower) {
      .Binary(InfixOperator.Power, left, right) => {
        assert(source(tower, left) == "2")
        assert(source(tower, right) == "3 ** 2")
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "the exponent may start with a `-`, and a parenthesized base may too" {
    const inverse = "x ** -2"
    match expression(inverse) {
      .Binary(InfixOperator.Power, _, right) => assert(source(inverse, right) == "-2")
      other => panic "Unexpected tree: {other}"
    }
    assert(messages("const a = (-x) ** 2") == [])
    assert(messages("const b = -(x ** 2)") == [])
    assert(messages("const c = y - x ** 2") == [])
    assert(messages("const d = y * -x") == [])
  }

  test "a prefix operator directly in front of the base of `**` is ambiguous" {
    const ambiguous = "A unary `-` directly in front of the base of `**` is ambiguous"
    assert(messages("const x = -x ** 2") == [ambiguous])
    assert(noteMessages("const x = -x ** 2") == [
      "Write `-(x ** 2)` to negate the power, or `(-x) ** 2` to raise the negative number",
    ])
    // Wherever the power stands, and in the exponent of another power as well
    assert(messages("const x = 2 * -a.b ** 2") == [ambiguous])
    assert(messages("const x = y ** -z ** 2") == [ambiguous])
    assert(messages("const x = !flag ** 2") == ["A `!` directly in front of the base of `**` is ambiguous"])
  }

  test "`&` binds like `*`, `|` and `^` like `+`, so a mask compares without parentheses" {
    const masked = "x & 1 == 0"
    match expression(masked) {
      .Binary(InfixOperator.Equal, left, _) => assert(source(masked, left) == "x & 1")
      other => panic "Unexpected tree: {other}"
    }
    const mixed = "a | b & c"
    match expression(mixed) {
      .Binary(InfixOperator.BitwiseOr, _, right) => assert(source(mixed, right) == "b & c")
      other => panic "Unexpected tree: {other}"
    }
    const exclusive = "a ^ b + c"
    match expression(exclusive) {
      .Binary(InfixOperator.Add, left, _) => assert(source(exclusive, left) == "a ^ b")
      other => panic "Unexpected tree: {other}"
    }
  }

  test "a shift binds tighter than `*` and looser than `**`" {
    const scaled = "1 << 2 * 3"
    match expression(scaled) {
      .Binary(InfixOperator.Multiply, left, _) => assert(source(scaled, left) == "1 << 2")
      other => panic "Unexpected tree: {other}"
    }
    const raised = "1 << 2 ** 3"
    match expression(raised) {
      .Binary(InfixOperator.ShiftLeft, _, right) => assert(source(raised, right) == "2 ** 3")
      other => panic "Unexpected tree: {other}"
    }
    const right = "a >> 4 & 15"
    match expression(right) {
      .Binary(InfixOperator.BitwiseAnd, left, _) => assert(source(right, left) == "a >> 4")
      other => panic "Unexpected tree: {other}"
    }
  }

  test "`>>` is two `>` with nothing between them, and `> >` is a comparison that does not chain" {
    match expression("a >> b") {
      .Binary(InfixOperator.ShiftRight, _, _) => {}
      other => panic "Unexpected tree: {other}"
    }
    assert(messages("const x = a > > b") != [])
    assert(messages("const x = a < b >> c") == [])
  }

  test "a prefix binds tighter than every binary operator, and `~` on the base of `**` is ambiguous" {
    const complement = "~a & b"
    match expression(complement) {
      .Binary(InfixOperator.BitwiseAnd, left, _) => assert(source(complement, left) == "~a")
      other => panic "Unexpected tree: {other}"
    }
    assert(messages("const x = -a << 2") == [])
    assert(messages("const x = ~a ** 2") == ["A `~` directly in front of the base of `**` is ambiguous"])
  }

  test "`&` and `|` keep their meaning in a type" {
    assert(messages("fn show(value: Show & Hash): String \{\n  value.show()\n\}") == [])
    assert(messages("const protocol: \"tcp\" | \"udp\" = \"tcp\"") == [])
    assert(messages("const nested: List<List<Int>> = []") == [])
    match bound("const both = mask & flags | extra") {
      .Binary(InfixOperator.BitwiseOr, _, _) => {}
      other => panic "Unexpected tree: {other}"
    }
  }
}

group "Generics or less than" {
  test "type arguments in front of a call" {
    match bound("const config = load<Config>(path)") {
      .Call(callee, _, _) => match callee.kind {
        .Generic(_, arguments) => assert(arguments.length() == 1)
        other => panic "Unexpected callee: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "comparisons stay comparisons" {
    match bound("const inside = 0 < index && index < 16") {
      .Binary(InfixOperator.And, _, _) => {}
      other => panic "Unexpected tree: {other}"
    }
  }
}

group "Command calls" {
  test "arguments, labels and the trailing closure" {
    match expression("route \"/health\", to: handler \{ respond() \}") {
      .Call(_, arguments, CallStyle.Command) => {
        assert(arguments.length() == 3)
        assert(arguments[1].label?.text == Some("to"))
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "a name followed by `[` is always indexing" {
    match expression("values [0]") {
      .Index(_, _) => {}
      other => panic "Unexpected tree: {other}"
    }
  }

  /**
   * An index in the middle of a member path is still a member path: `mounted[index].process elapsed` is the command
   * form of `mounted[index].process(elapsed)`. The index joins the path only when a `.name` follows it, which is what
   * leaves the rule above untouched.
   */
  test "an index in the middle of a member path is part of it" {
    match expression("mounted[index].process elapsed") {
      .Call(callee, arguments, CallStyle.Command) => {
        assert(arguments.length() == 1)
        match callee.kind {
          .Member(inner, name, _) => {
            assert(name.text == "process")
            match inner.kind {
              .Index(_, _) => {}
              other => panic "Unexpected base: {other}"
            }
          }
          other => panic "Unexpected callee: {other}"
        }
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "several indexes in one path, and a nested one" {
    match expression("grid[row][column].fill value") {
      .Call(_, arguments, CallStyle.Command) => assert(arguments.length() == 1)
      other => panic "Unexpected tree: {other}"
    }
    match expression("rows[at(index)].fill value") {
      .Call(_, arguments, CallStyle.Command) => assert(arguments.length() == 1)
      other => panic "Unexpected tree: {other}"
    }
  }

  test "an index with no member after it is not a command, and a list argument still needs parentheses" {
    assert(messages("mounted[index] elapsed").length() == 1)
    assert(messages("print [1, 2]").length() == 1)
  }

  test "the closure belongs to the command, not to its argument" {
    assert(messages("print numbers.map \{ _ * 2 \}.toList()").length() == 1)
    assert messages("print(numbers.map \{ _ * 2 \}.toList())").isEmpty()
  }

  test "positional arguments come first" {
    assert(messages("connect(host: \"a\", 5432)").length() == 1)
    assert messages("connect(\"a\", port: 5432)").isEmpty()
  }
}

group "Closures" {
  test "parameters are found by trying" {
    match bound("const add = \{ a: Int, b: Int => a + b \}") {
      .Closure(closure) => assert(closure.parameters.length() == 2)
      other => panic "Unexpected tree: {other}"
    }
    match bound("const double = \{ _ * 2 \}") {
      .Closure(closure) => assert closure.parameters.isEmpty()
      other => panic "Unexpected tree: {other}"
    }
  }

  test "a `\{` in the head of an `if` starts the body" {
    assert(statements("if list.isEmpty() \{ print 1 \}").length() == 1)
  }
}

group "Strings" {
  test "interpolations are parsed, with the offsets of the file" {
    const text = "print \"sum: \{a + b\}\""
    match expression(text) {
      .Call(_, arguments, _) => match arguments[0].value.kind {
        .TextLiteral([.Literal(prefix), .Interpolated(inner)]) => {
          assert(prefix == "sum: ")
          assert(source(text, inner) == "a + b")
        }
        other => panic "Unexpected argument: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }
}

group "Types and patterns" {
  test "literal types, but no unions of types" {
    assert messages("const status: \"online\" | \"offline\" = \"online\"").isEmpty()
    assert(messages("const value: Int | String = 1").length() == 1)
  }

  test "`true` and `false` are literal types, a float never is" {
    assert messages("type Toggle<const Flag: Bool> \{\n  var enabled: Toggle<true>\n  var disabled: Toggle<false>\n\}").isEmpty()
    assert(messages("const rate: 1.5 = 1.5")[0] == "A float cannot be a literal type")
  }

  test "several traits are one type, combined with `&`" {
    match statements("fn audit(entry: Show & Encode) \{\}")[0].kind {
      .Declare(declaration) => match declaration.kind {
        .Function(function) => match function.parameters[0].annotation {
          Some(reference) => match reference.kind {
            .Intersection(members) => assert(members.length() == 2)
            other => panic "Unexpected annotation: {other}"
          }
          None => panic "Expected an annotation"
        }
        other => panic "Unexpected declaration: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "`+` in a type position recovers as `&`, with one diagnostic" {
    assert(messages("fn audit(entry: Show + Encode + Hash) \{\}") == ["Traits are combined with `&`: `Compare & Show`"])
    assert(messages("fn sorted<Item: Compare + Show>(item: Item): Item \{ item \}")
      == ["Traits are combined with `&`: `Compare & Show`"])
  }

  test "rest patterns know their position" {
    match bound("const first = match items \{ [head, ...tail] => head \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .ListPattern(items, Some(rest)) => {
          assert(items.length() == 1)
          assert(rest.position == 1)
        }
        other => panic "Unexpected pattern: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }
}

group "Recovery" {
  test "a broken statement does not take the next one with it" {
    const parsed = parse SourceText.of("const a = )\nconst b = 2")
    assert(parsed.diagnostics.length() == 1)
    assert(parsed.file.statements.length() == 2)
  }
}

group "Cases" {
  test "a case is `.Case` or `Type.Case`, a bare name binds" {
    match bound("const area = match shape \{\n  .Circle(radius) => radius\n  Shape.Empty => 0.0\n  other => other.area()\n\}") {
      .Match(_, arms) => {
        assert(arms.length() == 3)
        match arms[0].pattern.kind {
          .ImplicitVariant(name, fields, ...) => {
            assert(name.text == "Circle")
            assert(fields.length() == 1)
          }
          other => panic "Unexpected pattern: {other}"
        }
        match arms[2].pattern.kind {
          .Binding(name) => assert(name == "other")
          other => panic "Unexpected pattern: {other}"
        }
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "inside of a match a leading dot starts an arm, elsewhere it continues the line" {
    match bound("const names = users\n  .map(\{ _.name \})\n  .toList()") {
      .Call(_, _, _) => {}
      other => panic "Unexpected tree: {other}"
    }
    assert messages("const x = match y \{\n  .A => list\n    .first()\n  .B => 2\n\}").isNotEmpty()
    assert messages("const x = match y \{\n  .A => \{\n    list\n      .first()\n  \}\n  .B => 2\n\}").isEmpty()
  }

  test "in expressions, where the type is known" {
    match bound("const kind: TokenKind = .Dot") {
      .ImplicitMember(name) => assert(name.text == "Dot")
      other => panic "Unexpected tree: {other}"
    }
  }

  test "cases are imported by their path" {
    assert messages("use Option, Option.Some, Option.None from \"./option\"").isEmpty()
    // A `use` without names is gone, and the message says what to write instead
    assert(messages("use \"./text-extensions\"") == ["A `use` names what it imports"])
    const items = useItems "use Option, Option.Some from \"./option\""
    assert(items[0].path.map({ _.text }).toList() == ["Option"])
    assert(items[1].path.map({ _.text }).toList() == ["Option", "Some"])
    // The name that is imported is the last segment, and it is what binds unless an alias says otherwise
    assert(items[1].name().text == "Some")
    assert(items[1].localName().text == "Some")
  }

  test "without `from` the path is resolved in the file's own scope" {
    assert messages("use Shape.Circle, Shape.Empty").isEmpty()
    match statements("use Shape.Circle")[0].kind {
      .Declare(declaration) => match declaration.kind {
        .Use(usage) => match usage.source {
          .Local => {}
          other => panic "Expected a local source, found {other}"
        }
        other => panic "Expected a `use`, found {other}"
      }
      other => panic "Expected a declaration, found {other}"
    }
    // One bare name would rebind what is in scope already, so a path of one segment still needs a module
    assert(messages("use Shape") == ["Expected `from \"...\"`"])
  }

  test "`use Names from Type` is gone, and the message teaches the path form" {
    assert(
      messages("use Some, None from Option")
        == ["`from` takes a module in quotes, not the type `Option`: a case is imported by its path,"
          + " `use Option.Some from \"...\"`"]
    )
    // A namespace import of a type never existed, so nothing is offered for it
    assert(messages("use * as maybe from Option") == ["`from` takes a module in quotes, not the type `Option`"])
  }

  test "any name of a use list may get a local name of its own" {
    const items = useItems "public use IoError as FileProblem, File from \"std/fs\""
    assert(items[0].name().text == "IoError")
    assert(items[0].alias.map({ _.text }) == Some("FileProblem"))
    assert(items[1].name().text == "File")
    assert items[1].alias.isNone()
    // The spans of both names are kept: a message about the export points at it, one about the local name at the alias
    assert(items[0].name().span.start == 11)
    assert(items[0].alias.map({ _.span.start }) == Some(22))
    // A case is aliased the same way
    const cases = useItems "use Option.None as Nothing from \"./option\""
    assert(cases[0].alias.map({ _.text }) == Some("Nothing"))
    assert(cases[0].localName().text == "Nothing")
  }

  test "in a pattern the first letter decides: uppercase is a case, lowercase binds" {
    match bound("const area = match shape \{ None => 0 \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .Variant(path, fields, ...) => {
          assert(path.map({ _.text }).toList() == ["None"])
          assert fields.isEmpty()
        }
        other => panic "Expected a variant, found {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
    // A lowercase name binds, and so does one that starts with an underscore
    match bound("const area = match shape \{ found => 0 \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .Binding(name) => assert(name == "found")
        other => panic "Expected a binding, found {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
    match bound("const area = match shape \{ _Found => 0 \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .Binding(name) => assert(name == "_Found")
        other => panic "Expected a binding, found {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "a label in a variant pattern is kept, not discarded" {
    match bound("const area = match shape \{ Point(x: 0, y: 0) => 0 \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .Variant(_, fields, ...) => {
          assert(fields.length() == 2)
          assert(fields[0].label.map({ _.text }) == Some("x"))
          assert(fields[1].label.map({ _.text }) == Some("y"))
        }
        other => panic "Unexpected pattern: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
    // Without a label, fields are still matched by position
    match bound("const area = match shape \{ .Circle(radius) => radius \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .ImplicitVariant(_, fields, ...) => {
          assert(fields.length() == 1)
          assert fields[0].label.isNone()
        }
        other => panic "Unexpected pattern: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  /** `Config(host, ...)`: the `...` stands for the fields the pattern does not name, and it comes last and once. */
  test "a `...` at the end of a constructor pattern" {
    match bound("const found = match config \{ Config(host, ...) => host \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .Variant(_, fields, hasRest) => {
          assert(fields.length() == 1)
          assert hasRest
        }
        other => panic "Unexpected pattern: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
    match bound("const found = match shape \{ .Rectangle(...) => 0 \}") {
      .Match(_, arms) => match arms[0].pattern.kind {
        .ImplicitVariant(_, fields, hasRest) => {
          assert fields.isEmpty()
          assert hasRest
        }
        other => panic "Unexpected pattern: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "a `...` that is not last, and one that is written twice" {
    assert(
      messages("const found = match config \{ Config(..., host) => host \}")
        == ["A `...` comes last in a pattern: it stands for every field behind it"]
    )
    assert(
      messages("const found = match config \{ Config(host, ..., ...) => host \}")
        == ["A pattern can only have one `...`"]
    )
  }
}

group "Constants at top level" {
  test "`public const` is a declaration, a plain `const` stays a binding" {
    match statements("public const pi = 3.14")[0].kind {
      .Declare(declaration) => {
        assert(declaration.modifiers.visibility == Visibility.Public)
        match declaration.kind {
          .Constant(binding) => assert(!binding.isVar)
          other => panic "Unexpected declaration: {other}"
        }
      }
      other => panic "Unexpected tree: {other}"
    }
    match statements("const pi = 3.14")[0].kind {
      .Bind(_) => {}
      other => panic "Unexpected tree: {other}"
    }
  }

  test "`private const` is accepted, it is the default anyway" {
    assert messages("private const secret = 1").isEmpty()
  }

  test "`public var` at top level is an error: a module has no mutable state" {
    assert(messages("public var mutable = 1") == ["A module has no mutable state: only `const` can be public"])
  }

  test "the doc comment of a top-level `const` is attached, with or without modifiers" {
    match statements("/** Pi. */\npublic const pi = 3.14")[0].kind {
      .Declare(declaration) => {
        assert(declaration.doc == Some("Pi."))
        match declaration.kind {
          .Constant(binding) => assert(binding.doc == None)
          other => panic "Unexpected declaration: {other}"
        }
      }
      other => panic "Unexpected tree: {other}"
    }
    match statements("/** Pi. */\nconst pi = 3.14")[0].kind {
      .Bind(binding) => assert(binding.doc == Some("Pi."))
      other => panic "Unexpected tree: {other}"
    }
  }
}

group "Doc comments" {
  test "belong to what follows them, down to parameters" {
    const text = "/**\n * Connects.\n *\n *     example()\n */\nfn connect(/** Host name */ host: String) \{ \}"
    match statements(text)[0].kind {
      .Declare(declaration) => {
        assert(declaration.doc == Some("Connects.\n\n    example()"))
        match declaration.kind {
          .Function(function) => assert(function.parameters[0].doc == Some("Host name"))
          other => panic "Unexpected declaration: {other}"
        }
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "an ordinary comment in between is fine, code is not" {
    const parsed = statements "/** Lost */\nconst between = 1\nfn later() \{ \}"
    match parsed[1].kind {
      .Declare(declaration) => assert(declaration.doc == None)
      other => panic "Unexpected tree: {other}"
    }
  }
}

group "Trait lists" {
  /** The `traits` of the one `type` declaration a source consists of. */
  fn traitsOf(text: String): List<TraitClause> {
    match statements(text)[0].kind {
      .Declare(declaration) => match declaration.kind {
        .Type(typeDeclaration) => typeDeclaration.traits
        other => panic "Unexpected declaration: {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "`by` binds to the one element of the `with` list directly in front of it" {
    const traits = traitsOf "type Seconds with Show, (Add, Subtract) by value, Compare by value \{\n  value: Int\n\}"
    assert(traits.length() == 3)
    assert(traits[0].delegate == None)
    assert(traits[1].delegate.map({ _.text }) == Some("value"))
    assert(traits[2].delegate.map({ _.text }) == Some("value"))
    match traits[1].capability.kind {
      .Intersection(members) => assert(members.length() == 2)
      other => panic "Expected an intersection, found {other}"
    }
  }

  test "a group of one trait delegates the same as writing it alone" {
    const traits = traitsOf "type Seconds with (Show) by value \{\n  value: Int\n\}"
    assert(traits.length() == 1)
    assert(traits[0].delegate.map({ _.text }) == Some("value"))
    match traits[0].capability.kind {
      .Named(path, _) => assert(path.last().map({ _.text }) == Some("Show"))
      other => panic "Expected a named type, found {other}"
    }
  }

  test "a group without `by` is an error" {
    assert(
      messages("type Seconds with (Show, Add) \{\n  value: Int\n\}")
        == ["A group without `by` is an error: write the traits without parentheses"]
    )
  }

  test "a parenthesised group in a `trait`'s supertraits is the same error - there is no `by` to bind to" {
    assert(
      messages("trait Numeric with (Show, Add) \{\n\}")
        == ["A group without `by` is an error: write the traits without parentheses"]
    )
  }

  test "a parenthesised group in an `extend` is the same error - there is no field to delegate to" {
    assert(
      messages("extend Meters with (Show, Add) \{\n\}")
        == ["A group without `by` is an error: write the traits without parentheses"]
    )
  }

  test "`&` in a `with` list is an error: write commas" {
    assert(
      messages("type Seconds with Show & Add \{\n  value: Int\n\}")
        == ["A `with` list separates entries with commas, not `&`: write `with Show, Add`"]
    )
  }

  test "`&` in front of `by` is an error: group with parentheses instead" {
    assert(
      messages("type Seconds with Show & Add by value \{\n  value: Int\n\}")
        == ["Traits delegated to the same field are grouped with parentheses, not `&`: write `(Show, Add) by value`"]
    )
  }

  test "`&` between plain traits of a `trait`'s supertraits is an error" {
    assert(
      messages("trait Numeric with Show & Add \{\n\}")
        == ["A `with` list separates entries with commas, not `&`: write `with Show, Add`"]
    )
  }

  test "`extend` has no field of its own to delegate to: a stray `by` is rejected" {
    assert(
      messages("extend Meters with Add by value \{\n  fn add(other: Self): Self \{\n    self\n  \}\n\}")
        == ["`by` delegates to a field: only a `type` has fields to name"]
    )
  }

  test "a `trait`'s supertraits have no field either" {
    assert(messages("trait Numeric with Add by value \{\n\}") == ["`by` delegates to a field: only a `type` has fields to name"])
  }
}

/**
 * A member says what it is with two words: `static` belongs to the type, `var` may change. The receiver of a method
 * is not written, so the parser puts it back - which is why every test here looks at the parameters.
 */
group "The members of a type" {
  test "a method gets the receiver it does not write, at the span of its own name" {
    assert(memberParameters("  fn area(): Int \{\n    1\n  \}") == ["self"])
    match membersOf("  fn area(): Int \{\n    1\n  \}")[0].kind {
      .Function(function) => assert(function.parameters[0].name.span == function.name.span)
      other => panic "Expected a function, found {other}"
    }
  }

  test "a `var fn` gets a `var` receiver" {
    assert(memberParameters("  var fn translate(deltaX: Int) \{\n  \}") == ["var self", "deltaX"])
  }

  test "a `static fn` gets none" {
    assert(memberParameters("  static fn square(size: Int): Self \{\n    Probe(size)\n  \}") == ["size"])
  }

  test "`static name = value` is a constant of the type, and `static const` says the default out loud" {
    match membersOf("  static origin = Probe(0)")[0].kind {
      .Constant(binding) => assert(!binding.isVar)
      other => panic "Expected a constant, found {other}"
    }
    const written = "type Probe \{\n  static const origin = Probe(0)\n\}"
    assert(messages(written) == ["`const` is what a `static` member is without it"])
    assert(noteMessages(written) == ["What belongs to the type is a constant of it: write `static name = ...`"])
  }

  test "a field is `const` without the word, so `const x: Int` is refused and still read as the field" {
    match membersOf("  x: Int = 0")[0].kind {
      .Field(field) => {
        assert(field.name.text == "x")
        assert(!field.isVar)
      }
      other => panic "Expected a field, found {other}"
    }
    const written = "type Probe \{\n  const x: Int = 0\n\}"
    assert(messages(written) == ["`const` is what a field is without it"])
    assert(noteMessages(written) == ["A field is `const` unless it is `var`: write `x: ...`"])
    match parse(SourceText.of(written)).file.statements[0].kind {
      .Declare(declaration) => match declaration.kind {
        .Type(declared) => match declared.members[0].kind {
          .Field(field) => assert(field.name.text == "x" && !field.isVar)
          other => panic "Expected a field, found {other}"
        }
        other => panic "Expected a type, found {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "a member is public without the word, so `public` on one is refused" {
    const written = "type Probe \{\n  public label: String\n\n  public fn shout(): String \{\n    label\n  \}\n\}"
    assert(messages(written) == ["`public` is what a member is without it", "`public` is what a member is without it"])
    assert(noteMessages(written)[0] == "Members are public by default: drop `public`, or write `private` to hide one")
  }

  test "`Int??` is an optional of an optional: the lexer's `??` is two `?` in a type" {
    match statements("fn probe(value: Int??) \{\}")[0].kind {
      .Declare(declaration) => match declaration.kind {
        .Function(function) => {
          const annotation = function.parameters[0].annotation ?? panic("Expected an annotation")
          match annotation.kind {
            .Optional(inner) => match inner.kind {
              .Optional(innermost) => match innermost.kind {
                .Named(path, _) => assert(path[0].text == "Int")
                other => panic "Expected `Int`, found {other}"
              }
              other => panic "Expected an optional, found {other}"
            }
            other => panic "Expected an optional, found {other}"
          }
        }
        other => panic "Expected a function, found {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "a chain of comparisons is one message, and the rest of the chain is dropped" {
    assert(messages("print a < b > c") == ["Comparisons do not chain. Use `&&`: `a < b && b < c`"])
    assert(messages("print a < b > c < d") == ["Comparisons do not chain. Use `&&`: `a < b && b < c`"])
  }

  test "an expression where a type argument goes is one message" {
    assert(messages("var buffer: Array<Float, size + 1> = x") == ["A type argument is a type or the name of a constant, never an expression"])
    assert(messages("fn probe(value: Compare + Show) \{\}") == ["Traits are combined with `&`: `Compare & Show`"])
  }

  test "`use Option.*` is named, and the `use` still reads its source" {
    assert(messages("use Option.* from \"std/core\"") == ["There is no `use Option.*`"])
    assert(messages("use Some from \"\"") == ["A `use` needs the path of a module: `use Name from \"std/core\"`"])
  }

  test "a `foreign` block declares free functions, so its `fn` gets no receiver" {
    const text = "foreign \"sqlite3\" \{\n  fn sqlite3_close(database: Int): Int32\n\}"
    match statements(text)[0].kind {
      .Declare(declaration) => match declaration.kind {
        .Foreign(library) => match library.members[0].kind {
          .Function(function) => assert(function.parameters.map({ _.name.text }).toList() == ["database"])
          other => panic "Expected a function, found {other}"
        }
        other => panic "Expected a foreign block, found {other}"
      }
      other => panic "Unexpected tree: {other}"
    }
  }

  test "a written `self` says what to write instead" {
    const text = "type Probe \{\n  fn area(self): Int \{\n    1\n  \}\n\}"
    assert(messages(text) == ["A method does not list `self`"])
    assert(noteMessages(text) == ["Write `fn name(...)`: what stands in the parentheses is what the caller writes"])
  }

  test "a written `var self` says the other form" {
    const text = "type Probe \{\n  fn grow(var self) \{\n  \}\n\}"
    assert(noteMessages(text) == ["Write `var fn name(...)`: `var` says the method may change its receiver"])
  }

  test "`static var` does not exist: a type has no mutable state" {
    const text = "type Probe \{\n  static var total = 0\n\}"
    assert(messages(text)[0] == "`static var` does not exist")
    assert(noteMessages(text)[0] == "A type has no mutable state: what belongs to the type is a constant of it")
  }

  test "`const x = 0` in a type body names neither reading, and the message offers both" {
    const text = "type Probe \{\n  const x = 0\n\}"
    assert(messages(text) == ["`x` is neither a field nor a constant of the type"])
    assert(noteMessages(text) == ["A field is `x: Type`, a constant of the type is `static x = ...`"])
  }

  test "a constant with a type and without a value parses as a requirement, and the checker says where it may stand" {
    assert messages("trait Zero \{\n  static zero: Self\n\}").isEmpty()
    const members = membersOf "  static zero: Int"
    match members[0].kind {
      .Constant(binding) => assert binding.required
      other => panic "Expected a constant, found {other}"
    }
  }

  test "a constant without a type and without a value is still a binding without a value" {
    const found = messages "type Probe \{\n  static zero\n\}"
    assert found.contains("A binding needs a value: there are no uninitialized bindings and no default values")
  }
}
