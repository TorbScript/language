/**
 * `?`, `??`, `?.`, `into()` and `tryInto()`: the constructs that are nothing but calls, and whose meaning comes out of
 * `From`, `TryFrom`, `Option` and `Result` instead of out of a node of the syntax tree.
 */

use test, group from "std/test"
use probe, problems, notes from "./harness"

/** A body that returns a `Result<Int, AppError>`, with the two error types every test here uses. */
fn inFunction(result: String, body: String): String {
  "type IoError \{\n  path: String\n\}\n\ntype AppError \{\n  case Io(error: IoError)\n"
    + "  case Broken(message: String)\n\}\n\n"
    + "fn read(): Result<Int, IoError> \{\n  Ok(1)\n\}\n\n"
    + "fn probe(): {result} \{\n{body}\n\}"
}

group "`?` on a `Result`" {
  test "the same error type needs no conversion" {
    const source = "fn read(): Result<Int, String> \{\n  Ok(1)\n\}\n\n"
      + "fn probe(): Result<Int, String> \{\n  const value = read()?\n  Ok(value)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("read()?") == "Int64")
    assert(found.adaptationsOf("read()?") == [])
  }

  test "a different error type is converted through `From`, and the generated one of a wrapper case is enough" {
    const source = inFunction "Result<Int, AppError>", "  const value = read()?\n  Ok(value)"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("read()?") == "Int64")
    assert(found.adaptationsOf("read()?") == ["convert from through AppError: From<IoError>"])
  }

  test "an error that does not convert says what to write instead" {
    const source = "type IoError \{\n  path: String\n\}\n\ntype AppError \{\n  message: String\n\}\n\n"
      + "fn read(): Result<Int, IoError> \{\n  Ok(1)\n\}\n\n"
      + "fn probe(): Result<Int, AppError> \{\n  const value = read()?\n  Ok(value)\n\}"
    assert(problems(source) == ["`IoError` does not convert into `AppError`"])
    assert(notes(source) == ["Add a case that wraps it, or `extend AppError with From<IoError>`"])
  }

  /**
   * `fn main(): Result<Void, Error>` of the standard library: the failure is a trait-typed value, and no `From` can
   * ever apply to one, because nobody extends a trait type. So `?` falls back to the coercion of a value to a
   * trait-typed value, which is what makes a precise error type fit a signature that only reports.
   */
  const withTrait = "trait Problem with Show \{\n  fn cause(): Problem? \{\n    None\n  \}\n\}\n\n"
    + "type IoError with Show, Problem \{\n  path: String\n\n  fn show(): String \{\n    path\n  \}\n\}\n\n"
    + "fn read(): Result<Int, IoError> \{\n  Ok(1)\n\}\n\n"

  test "a trait-typed failure takes a concrete error through the trait-value coercion" {
    const source = withTrait + "fn probe(): Result<Int, Problem> \{\n  const value = read()?\n  Ok(value)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("read()?") == "Int64")
    assert(found.adaptationsOf("read()?") == ["trait value Problem"])
  }

  test "an error that does not carry the trait is reported like any failed coercion" {
    const source = "trait Problem with Show \{\n  fn cause(): Problem? \{\n    None\n  \}\n\}\n\n"
      + "type IoError with Show \{\n  path: String\n\n  fn show(): String \{\n    path\n  \}\n\}\n\n"
      + "fn read(): Result<Int, IoError> \{\n  Ok(1)\n\}\n\n"
      + "fn probe(): Result<Int, Problem> \{\n  const value = read()?\n  Ok(value)\n\}"
    assert(problems(source) == ["`IoError` does not implement `Problem`"])
  }

  test "a failure that is already the trait value needs no adaptation" {
    const source = withTrait + "fn hand(): Result<Int, Problem> \{\n  Ok(1)\n\}\n\n"
      + "fn probe(): Result<Int, Problem> \{\n  const value = hand()?\n  Ok(value)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.adaptationsOf("hand()?") == [])
  }

  test "a hand-written `From` is found like any other implementation" {
    const source = "type IoError \{\n  path: String\n\}\n\ntype AppError \{\n  message: String\n\}\n\n"
      + "extend AppError with From<IoError> \{\n  static fn from(value: IoError): AppError \{\n    AppError(value.path)\n  \}\n\}\n\n"
      + "fn read(): Result<Int, IoError> \{\n  Ok(1)\n\}\n\n"
      + "fn probe(): Result<Int, AppError> \{\n  const value = read()?\n  Ok(value)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.adaptationsOf("read()?") == ["convert from through AppError: From<IoError>"])
  }
}

/**
 * Two targets a failure cannot be converted into, and both of them type checked until this rule. Without them
 * `Failure: From<Cancelled>` is documentation rather than something the checker asks for.
 */
group "`?` and a failure type that carries nothing" {
  const alpha = "type Alpha \{\n  message: String\n\}\n\nfn read(): Result<Int, Alpha> \{\n  Ok(1)\n\}\n\n"

  test "`Never` is not a conversion target: it has no values" {
    const source = alpha + "fn probe(): Result<Int, Never> \{\n  Ok(read()?)\n\}"
    assert(problems(source) == ["`Alpha` does not convert into `Never`"])
    assert(
      notes(source)
        == [
          "`Never` has no values, so nothing converts into it: a result of `Result<Value, Never>` says that this"
            + " function cannot fail. Answer with a failure type, or handle the error here",
        ]
    )
  }

  test "a bare type parameter is not one either: what it can do is what its bounds say" {
    const source = alpha + "fn probe<Failure>(): Result<Int, Failure> \{\n  Ok(read()?)\n\}"
    assert(problems(source) == ["`Alpha` does not convert into `Failure`"])
    assert(
      notes(source)
        == [
          "What a type parameter can do is what its bounds say. Write the conversion down at the declaration:"
            + " `where Failure: From<Alpha>`",
        ]
    )
  }

  test "with the bound written down it is an ordinary conversion" {
    const source = alpha
      + "fn probe<Failure: From<Alpha>>(): Result<Int, Failure> \{\n  Ok(read()?)\n\}"
    assert problems(source).isEmpty()
  }

  test "a `Result<Value, Never>` without a `?` in it is fine: the promise is kept" {
    const source = "fn probe(): Result<Int, Never> \{\n  Ok(1)\n\}"
    assert problems(source).isEmpty()
  }
}

group "`?` on an `Option`" {
  test "an `Option` in a function that returns one unwraps without a conversion" {
    const source = "fn find(): Int? \{\n  Some(1)\n\}\n\nfn probe(): Int? \{\n  const value = find()?\n  Some(value)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("find()?") == "Int64")
  }

  test "an `Option` in a function that returns a `Result` has no error to return" {
    const source = "fn find(): Int? \{\n  Some(1)\n\}\n\n"
      + "fn probe(): Result<Int, String> \{\n  const value = find()?\n  Ok(value)\n\}"
    assert(problems(source) == ["`?` on an `Option` in a function that returns `Result<Int64, String>`"])
    assert(
      notes(source)
        == ["There is no error to return. Turn it into one first: `okOr(...)` gives the `Option` an error"]
    )
  }

  test "`?` on something that is neither is a mistake" {
    const source = "fn probe(): Int? \{\n  const value = 1?\n  Some(value)\n\}"
    assert(problems(source) == ["`?` needs an `Option` or a `Result`, and `Int64` is not one"])
  }
}

/**
 * `?` hands the failure back to the caller, so the enclosing function has to have a place for one, and a `Task` is the
 * one exemption: `fetchUser(id).await()?` stands in a function that answers a `Task`, and where `await()` itself is
 * allowed is a rule of its own, not part of this one.
 */
group "`?` needs a function that can carry the failure" {
  test "a declared result that is neither an `Option` nor a `Result` is a mistake" {
    const source = "fn read(): Result<Int, String> \{\n  Ok(1)\n\}\n\n"
      + "fn probe(): List<Int> \{\n  const value = read()?\n  [value]\n\}"
    assert(
      problems(source)
        == ["`?` needs a function that returns an `Option` or a `Result`, and this one returns `List<Int64>`"]
    )
    assert(notes(source) == ["`?` hands the failure back to the caller, so there has to be somewhere for it to go"])
  }

  test "an `Option` subject in such a function is the same mistake" {
    const source = "fn find(): Int? \{\n  Some(1)\n\}\n\nfn probe(): String \{\n  const value = find()?\n  \"\{value\}\"\n\}"
    assert(
      problems(source)
        == ["`?` needs a function that returns an `Option` or a `Result`, and this one returns `String`"]
    )
  }

  test "a `Task` of a `Result` is exempt: where `await()` is allowed is milestone 7's rule" {
    const source = "fn read(): Result<Int, String> \{\n  Ok(1)\n\}\n\n"
      + "fn probe(): Task<Result<Int, String>> \{\n  const value = read()?\n  Ok(value)\n\}"
    assert problems(source).isEmpty()
  }

  test "the top level of an entry file is exempt: the program ends with the error" {
    const source = "fn read(): Result<Int, String> \{\n  Ok(1)\n\}\n\nconst value = read()?\nprint value"
    assert problems(source).isEmpty()
  }
}

group "`??`" {
  test "the fallback is checked against the `Value`, and it is `lazy` (gap 13)" {
    const source = "fn find(): Int? \{\n  Some(1)\n\}\n\nfn probe() \{\n  const value = find() ?? 0\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("find() ?? 0") == "Int64")
    assert(found.adaptationsOf("0") == ["lazy", "literal Int64"])
    assert(found.resolutionOf("find() ?? 0") == "call orElse")
  }

  test "it works on a `Result` as well" {
    const source = "fn read(): Result<Int, String> \{\n  Ok(1)\n\}\n\nfn probe() \{\n  const value = read() ?? 0\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("read() ?? 0") == "Int64")
  }

  test "a fallback of the wrong type is a mistake" {
    const source = "fn find(): Int? \{\n  Some(1)\n\}\n\nfn probe() \{\n  const value = find() ?? \"none\"\n\}"
    assert(problems(source) == ["Expected `Int64`, found `String`"])
  }

  test "`??` asks for its trait, like every other operator" {
    const source = "fn probe() \{\n  const value = 1 ?? 0\n\}"
    assert(problems(source) == ["`Int64` does not implement `OrElse`, so `a ?? b` has no meaning for it"])
    assert(notes(source) == ["Operators are traits: a type has the ones it comes `with`, and nothing else"])
    // A type of a program that says `with OrElse<Value>` gets `??`, and the fallback is its `Value`
    const own = "type Box \{\n  value: Int\n\}\n\nextend Box with OrElse<Int> \{\n  fn orElse(fallback: lazy Int): Int \{\n    value\n  \}\n\}\n\n"
      + "fn probe(box: Box) \{\n  const found = box ?? 0\n\}"
    assert problems(own).isEmpty()
    assert(probe(own).typeOf("box ?? 0") == "Int64")
  }

  test "an unbound type parameter is told to add the bound, not to change the type" {
    const source = "fn probe<Value>(value: Value) \{\n  const found = value ?? value\n\}"
    assert(problems(source) == ["`Value` is not `OrElse`, so `a ?? b` has no meaning for it"])
    assert(notes(source) == ["Add the bound to the declaration: `where Value: OrElse`"])
  }
}

group "`?.`" {
  test "a member that gives back an ordinary value becomes an `Option` of it: `map`" {
    const source = "type User \{\n  name: String\n\n  fn label(): String \{\n    name\n  \}\n\}\n\n"
      + "fn find(): User? \{\n  None\n\}\n\nfn probe() \{\n  const shown = find()?.label()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("find()?.label()") == "Option<String>")
    // The one record the lowering needs: the wrapping is inside the function type, so nothing else says `map` or `flatMap`
    assert(!found.flattensOptional("label"))
  }

  test "a member that gives back an `Option` is flattened, never nested (gap 12)" {
    const source = "type User \{\n  name: String\n\n  fn nickname(): String? \{\n    Some(name)\n  \}\n\}\n\n"
      + "fn find(): User? \{\n  None\n\}\n\nfn probe() \{\n  const shown = find()?.nickname()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("find()?.nickname()") == "Option<String>")
    assert found.flattensOptional("nickname")
  }

  test "a field behind `?.` becomes optional, too" {
    const source = "type User \{\n  name: String\n\}\n\nfn find(): User? \{\n  None\n\}\n\n"
      + "fn probe() \{\n  const shown = find()?.name\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("find()?.name") == "Option<String>")
    assert(!found.flattensOptional("name"))
  }

  test "a field that is itself optional is flattened, too" {
    const source = "type User \{\n  nickname: String?\n\}\n\nfn find(): User? \{\n  None\n\}\n\n"
      + "fn probe() \{\n  const shown = find()?.nickname\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("find()?.nickname") == "Option<String>")
    assert found.flattensOptional("nickname")
  }

  test "`?.` is not defined on a `Result`" {
    const source = "type User \{\n  name: String\n\}\n\nfn read(): Result<User, String> \{\n  Fail(\"no\")\n\}\n\n"
      + "fn probe() \{\n  const shown = read()?.name\n\}"
    assert(problems(source) == ["`?.` needs an `Option`, and `Result<User, String>` is not one"])
    assert(
      notes(source)
        == ["`a?.m` is `Option.map`. On a `Result` it has no meaning: take the `Option` first (`ok()`)"]
    )
  }

  test "a member that is not there behind `?.` is reported on the value, not on the `Option`" {
    const source = "type User \{\n  name: String\n\}\n\nfn find(): User? \{\n  None\n\}\n\n"
      + "fn probe() \{\n  const shown = find()?.nam\n\}"
    assert(problems(source) == ["`User` has no member `nam`"])
  }
}

group "`into()`, `tryInto()` and their traits" {
  test "the target comes from the expectation, and the conversion is the `From` of that target" {
    const source = "type Celsius \{\n  degrees: Float\n\}\n\ntype Fahrenheit \{\n  degrees: Float\n\}\n\n"
      + "extend Celsius with From<Fahrenheit> \{\n"
      + "  fn from(value: Fahrenheit): Celsius \{\n    Celsius(value.degrees)\n  \}\n\}\n\n"
      + "fn probe() \{\n  const warm: Celsius = Fahrenheit(100.0).into()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Fahrenheit(100.0).into()") == "Celsius")
    assert(found.adaptationsOf("Fahrenheit(100.0).into()") == ["convert from through Celsius: From<Fahrenheit>"])
    assert(found.resolutionOf("Fahrenheit(100.0).into()") == "call from")
  }

  test "a target that cannot be converted into says how to provide it" {
    const source = "type Celsius \{\n  degrees: Float\n\}\n\ntype Fahrenheit \{\n  degrees: Float\n\}\n\n"
      + "fn probe() \{\n  const warm: Celsius = Fahrenheit(100.0).into()\n\}"
    assert(problems(source) == ["`Fahrenheit` does not convert into `Celsius`"])
    assert(
      notes(source)
        == ["`into()` is the `From` of the target: `extend Celsius with From<Fahrenheit>` provides it"]
    )
  }

  test "`Target.from(value)` is the ordinary static member of the implementation" {
    const source = "type Celsius \{\n  degrees: Float\n\}\n\ntype Fahrenheit \{\n  degrees: Float\n\}\n\n"
      + "extend Celsius with From<Fahrenheit> \{\n"
      + "  fn from(value: Fahrenheit): Celsius \{\n    Celsius(value.degrees)\n  \}\n\}\n\n"
      + "fn probe() \{\n  const warm = Celsius.from(Fahrenheit(100.0))\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Celsius.from(Fahrenheit(100.0))") == "Celsius")
  }

  test "`TryFrom` gives back a `Result`, and it is an ordinary implementation as well" {
    const source = "type Port \{\n  value: Int\n\}\n\n"
      + "extend Port with TryFrom<Int, String> \{\n"
      + "  fn tryFrom(value: Int): Result<Port, String> \{\n    Ok(Port(value))\n  \}\n\}\n\n"
      + "fn probe() \{\n  const port = Port.tryFrom(8080)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("Port.tryFrom(8080)") == "Result<Port, String>")
  }

  test "`tryInto()` reads its target and its failure out of the `Result` that is expected of it" {
    const source = "type Port \{\n  value: Int\n\}\n\n"
      + "extend Port with TryFrom<Int, String> \{\n"
      + "  fn tryFrom(value: Int): Result<Port, String> \{\n    Ok(Port(value))\n  \}\n\}\n\n"
      + "fn probe() \{\n  const port: Result<Port, String> = 8080.tryInto()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("8080.tryInto()") == "Result<Port, String>")
    assert(found.adaptationsOf("8080.tryInto()") == ["convert tryFrom through Port: TryFrom<Int64, String>"])
    assert(found.resolutionOf("8080.tryInto()") == "call tryFrom")
  }

  test "a target that has no `TryFrom` from this source says how to provide it" {
    const source = "type Port \{\n  value: Int\n\}\n\n"
      + "fn probe() \{\n  const port: Result<Port, String> = 8080.tryInto()\n\}"
    assert(problems(source) == ["`Int64` does not convert into `Port`"])
    assert(
      notes(source)
        == [
          "`tryInto()` is the `TryFrom` of the target: `extend Port with TryFrom<Int64, String>` provides it",
        ]
    )
  }

  test "nothing that says the target is a message of its own" {
    const source = "type Port \{\n  value: Int\n\}\n\n"
      + "extend Port with TryFrom<Int, String> \{\n"
      + "  fn tryFrom(value: Int): Result<Port, String> \{\n    Ok(Port(value))\n  \}\n\}\n\n"
      + "fn probe() \{\n  const port = 8080.tryInto()\n\}"
    assert(problems(source) == ["The target of `tryInto()` is not known here"])
    assert(
      notes(source)
        == [
          "It comes from the `Result<Target, Failure>` that is expected of the call, or from the type a `?` on it"
            + " unwraps to: annotate one of the two, or write `Target.tryFrom(value)` - the source is `Int64`",
        ]
    )
  }

  test "writing `TryInto` by hand names the `TryFrom` to write instead" {
    const source = "type Port \{\n  value: Int\n\}\n\n"
      + "extend Port with TryInto<Int, String> \{\n"
      + "  fn tryInto(): Result<Int, String> \{\n    Ok(value)\n  \}\n\}"
    assert(problems(source) == ["`TryInto` comes from `TryFrom` for every type"])
    assert(
      notes(source)
        == [
          "Write `extend Int64 with TryFrom<Port, String>`: the blanket implementation in `std/prelude` makes"
            + " `Port.tryInto()` out of that",
        ]
    )
  }

  test "a receiver of the trait type `Into<Target>` has `into` already, and the call is an ordinary one" {
    const source = "type Path \{\n  text: String\n\}\n\n"
      + "fn open(path: Into<Path>): Path \{\n  const target: Path = path.into()\n  target\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("path.into()") == "Path")
  }

  test "the same for `tryInto` on a receiver of the trait type `TryInto<Target, Failure>`" {
    const source = "type Path \{\n  text: String\n\}\n\n"
      + "fn open(path: TryInto<Path, String>): Result<Path, String> \{\n  path.tryInto()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("path.tryInto()") == "Result<Path, String>")
  }

  test "a concrete receiver still goes through the `From` of the target, once" {
    const source = "type Celsius \{\n  degrees: Float\n\}\n\ntype Fahrenheit \{\n  degrees: Float\n\}\n\n"
      + "extend Celsius with From<Fahrenheit> \{\n"
      + "  fn from(value: Fahrenheit): Celsius \{\n    Celsius(value.degrees)\n  \}\n\}\n\n"
      + "fn cool(): Fahrenheit \{\n  Fahrenheit(32.0)\n\}\n\n"
      + "fn probe() \{\n  const warm: Celsius = cool().into()\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("cool().into()") == "Celsius")
    assert(found.adaptationsOf("cool().into()") == ["convert from through Celsius: From<Fahrenheit>"])
  }

  /** There is no implicit `Some`: wrapping a value into an `Option` is written, the four coercions do not include it. */
  test "a value does not wrap itself into an `Option`" {
    const source = "fn probe() \{\n  const maybe: Int? = 1\n\}"
    assert(problems(source) == ["Expected `Option<Int64>`, found `Int64`"])
  }

  test "`Some` is what wraps it, and `None` takes its type from what is expected" {
    const source = "fn probe() \{\n  const maybe: Int? = Some(1)\n  const empty: Int? = None\n\}"
    assert problems(source).isEmpty()
  }
}

/**
 * `const port: Int = text.tryInto()?`: the `?` says the target and nothing about the failure, so the failure comes out
 * of the one `TryFrom` the target has for this source. This is how text becomes a value, so every position that says a
 * type is pinned here.
 */
group "`tryInto()` under a `?`" {
  /** `Port` from text, and from a number with a failure of its own, for the "more than one way" message. */
  const fromText = "type Port \{\n  number: Int\n\}\n\n"
    + "extend Port with TryFrom<String, String> \{\n"
    + "  fn tryFrom(value: String): Result<Port, String> \{\n    Ok(Port(1))\n  \}\n\}\n\n"

  const alsoFromNumber = fromText
    + "extend Port with TryFrom<Int64, Int64> \{\n"
    + "  fn tryFrom(value: Int64): Result<Port, Int64> \{\n    Ok(Port(value))\n  \}\n\}\n\n"

  const twiceFromText = fromText
    + "extend Port with TryFrom<String, Int64> \{\n"
    + "  fn tryFrom(value: String): Result<Port, Int64> \{\n    Ok(Port(2))\n  \}\n\}\n\n"

  test "an annotated binding says the target, and the failure is the one implementation" {
    const source = fromText
      + "fn probe(): Result<Void, String> \{\n  const port: Port = \"80\".tryInto()?\n  print(port)\n  Ok(void)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("\"80\".tryInto()") == "Result<Port, String>")
    assert(found.adaptationsOf("\"80\".tryInto()") == ["convert tryFrom through Port: TryFrom<String, String>"])
  }

  test "the parameter of a call says it" {
    const source = fromText + "fn open(port: Port) \{\n  print(port)\n\}\n\n"
      + "fn probe(): Result<Void, String> \{\n  open(\"80\".tryInto()?)\n  Ok(void)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("\"80\".tryInto()") == "Result<Port, String>")
  }

  test "the result of the function says it at a `return`" {
    const source = fromText
      + "fn probe(): Result<Port, String> \{\n  return Ok(\"80\".tryInto()?)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("\"80\".tryInto()") == "Result<Port, String>")
  }

  test "a field of a constructor call says it" {
    const source = fromText + "type Setting \{\n  port: Port\n\}\n\n"
      + "fn probe(): Result<Setting, String> \{\n  Ok(Setting(\"80\".tryInto()?))\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.typeOf("\"80\".tryInto()") == "Result<Port, String>")
  }

  /** The other source is beside it and is not confused with it: the failure is picked by the receiver's type. */
  test "another `TryFrom` from another source changes nothing" {
    const source = alsoFromNumber
      + "fn probe(): Result<Void, String> \{\n  const port: Port = \"80\".tryInto()?\n  print(port)\n  Ok(void)\n\}"
    assert problems(source).isEmpty()
    const found = probe source
    assert(found.adaptationsOf("\"80\".tryInto()") == ["convert tryFrom through Port: TryFrom<String, String>"])
  }

  test "two failures from one source leave the call without a meaning, and the message says which" {
    const source = twiceFromText
      + "fn probe(): Result<Void, String> \{\n  const port: Port = \"80\".tryInto()?\n  print(port)\n  Ok(void)\n\}"
    assert(problems(source) == ["`String` converts into `Port` in more than one way"])
    assert(
      notes(source)
        == [
          "A `?` says the target and not the failure, and there are several: `String`, `Int64`."
            + " Annotate the `Result<Port, Failure>` that is meant",
        ]
    )
  }

  test "no implementation from this source says how to provide one" {
    const source = fromText
      + "fn probe(): Result<Void, String> \{\n  const port: Port = 80.tryInto()?\n  print(port)\n  Ok(void)\n\}"
    assert(problems(source) == ["`Int64` does not convert into `Port`"])
    assert(
      notes(source)
        == [
          "`tryInto()` is the `TryFrom` of the target: `extend Port with TryFrom<Int64, Failure>` provides it",
        ]
    )
  }

  /** Nothing above the `?` says a type, so the `?` has nothing to pass down and the open-target message stands. */
  test "a `?` with nothing above it still says the target is not known" {
    const source = fromText
      + "fn probe(): Result<Void, String> \{\n  const port = \"80\".tryInto()?\n  print(port)\n  Ok(void)\n\}"
    assert(problems(source) == ["The target of `tryInto()` is not known here"])
  }
}
