/**
 * Layouts and names, built by hand: what a type costs, how it is represented, and what it is called. Both are pure
 * functions of the type, which is the property the fixpoint rests on - so both are pinned by a table.
 */

use test, group from "std/test"
use SymbolId from "../src/semantics/symbols"
use LiteralValue from "../src/semantics/checker/type"
use IrProgram, IrType, IrTypeId, IrTrait, IrSignature, IrParameter, Ownership from "../src/ir/ir"
use LayoutId, RuntimeKind, Instance, FunctionId, WitnessTableId from "../src/ir/ir"
use LayoutKind, FieldLayout, VariantLayout, Layout, finishProgram from "../src/ir/layout"
use sizeOfType, alignmentOfType, isManagedType, isNichePayload from "../src/ir/layout"
use SymbolPath, escapedComponent, hexDigits, nameHash, mangledName from "../src/ir/mangle"
use canonicalType, canonicalTypes, canonicalTrait, canonicalSignature from "../src/ir/mangle"
use functionName, layoutName, tupleLayoutName, staticName, elementName, witnessTableName from "../src/ir/mangle"
use instanceKey, instanceLengthLimit from "../src/ir/mangle"
use printLayout, describeIrType from "../src/ir/print"

fn recordLayout(var program: IrProgram, name: String, fields: List<FieldLayout>): LayoutId {
  const reserved = program.reserveLayout name, LayoutKind.Record
  const layout = program.layoutAt reserved.layout
  program.setLayout reserved.layout, layout.copy(fields: fields, built: true)
  reserved.layout
}

fn tupleLayout(var program: IrProgram, name: String, annotations: List<IrTypeId>): LayoutId {
  var fields: List<FieldLayout> = []
  for index in 0..annotations.length() {
    fields.append FieldLayout("{index}", annotations[index])
  }
  const reserved = program.reserveLayout name, LayoutKind.Tuple
  const layout = program.layoutAt reserved.layout
  program.setLayout reserved.layout, layout.copy(fields: fields, built: true)
  reserved.layout
}

fn variantLayout(var program: IrProgram, name: String, names: List<String>, cases: List<List<FieldLayout>>): LayoutId {
  const reserved = program.reserveLayout name, LayoutKind.Variant
  var fields: List<FieldLayout> = []
  var variants: List<VariantLayout> = []
  for index in 0..cases.length() {
    const first = fields.length()
    fields.appendAll cases[index]
    variants.append VariantLayout(names[index], first, cases[index].length())
  }
  const layout = program.layoutAt reserved.layout
  program.setLayout reserved.layout, layout.copy(fields: fields, variants: variants, built: true)
  reserved.layout
}

/** An `Option`-shaped layout over one payload type: the shape the niche is about. */
fn optionLayout(var program: IrProgram, name: String, payload: IrTypeId): LayoutId {
  variantLayout program, name, ["None", "Some"], [[], [FieldLayout("value", payload)]]
}

fn shown(program: IrProgram, layout: LayoutId): String {
  printLayout program, program.layoutAt(layout)
}

group "Layouts" {
  test "a record of small values is inline, and its size follows the model" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const int8 = program.internType IrType.Integer(8, signed: true)
    const boolean = program.internType IrType.Boolean
    const point = recordLayout program, "T_main_Point", [FieldLayout("x", int64), FieldLayout("y", int64)]
    const padded = recordLayout program, "T_main_Padded", [FieldLayout("flag", boolean), FieldLayout("value", int64)]
    const tiny = recordLayout program, "T_main_Tiny", [FieldLayout("first", int8), FieldLayout("second", int8)]
    finishProgram program
    assert(shown(program, point) == "layout T_main_Point inline size 16 align 8 fields(x: Int64, y: Int64)")
    assert(shown(program, padded) == "layout T_main_Padded inline size 16 align 8 fields(flag: Bool, value: Int64)")
    assert(shown(program, tiny) == "layout T_main_Tiny inline size 2 align 1 fields(first: Int8, second: Int8)")
  }

  test "a record that holds storage is counted, and a big one is boxed" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const strings = program.internType IrType.Text
    const named = recordLayout program, "T_main_Named", [FieldLayout("name", strings), FieldLayout("age", int64)]
    var many: List<FieldLayout> = []
    for index in 0..5 {
      many.append FieldLayout("field{index}", int64)
    }
    const big = recordLayout program, "T_main_Big", many
    finishProgram program
    assert(
      shown(program, named) == "layout T_main_Named inline size 24 align 8 counted fields(name: String, age: Int64)",
    )
    assert(
      shown(program, big)
        == "layout T_main_Big boxed size 40 align 8 fields(field0: Int64, field1: Int64, field2: Int64, field3: Int64, field4: Int64)",
    )
  }

  test "a record that contains a boxed one holds a pointer, so it is inline again" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    var many: List<FieldLayout> = []
    for index in 0..5 {
      many.append FieldLayout("field{index}", int64)
    }
    const big = recordLayout program, "T_main_Big", many
    const bigType = program.internType IrType.Record(big)
    const pair = recordLayout program, "T_main_Pair", [FieldLayout("first", bigType), FieldLayout("second", bigType)]
    finishProgram program
    assert(
      shown(program, pair)
        == "layout T_main_Pair inline size 16 align 8 counted fields(first: Record(T_main_Big), second: Record(T_main_Big))",
    )
  }

  test "`Option` of something pointer-like uses the niche, `Option<Int64>` carries a tag" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const strings = program.internType IrType.Text
    const listOfInteger = program.internType IrType.Runtime(RuntimeKind.ListStorage, [int64])
    const ofText = optionLayout program, "T_Option__String", strings
    const ofList = optionLayout program, "T_Option__List_Int64", listOfInteger
    const ofInteger = optionLayout program, "T_Option__Int64", int64
    finishProgram program
    assert(
      shown(program, ofText)
        == "layout T_Option__String niche(1, 0) size 16 align 8 counted variants(None, Some(value: String))",
    )
    assert(
      shown(program, ofList)
        == "layout T_Option__List_Int64 niche(1, 0) size 16 align 8 counted variants(None, Some(value: List(Int64)))",
    )
    assert(
      shown(program, ofInteger) == "layout T_Option__Int64 inline size 16 align 8 variants(None, Some(value: Int64))",
    )
  }

  test "a nested `Option` cannot use the same null twice and falls back to a tag" {
    var program = IrProgram()
    const strings = program.internType IrType.Text
    const inner = optionLayout program, "T_Option__String", strings
    const innerType = program.internType IrType.Variant(inner)
    const outer = optionLayout program, "T_Option__T_Option__String", innerType
    finishProgram program
    assert(
      shown(program, outer)
        == "layout T_Option__T_Option__String inline size 24 align 8 counted variants(None, Some(value: Variant(T_Option__String)))",
    )
  }

  test "a type that contains itself is boxed, and so is every other layout of the cycle" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const reserved = program.reserveLayout "T_main_Node", LayoutKind.Variant
    const nodeType = program.internType IrType.Variant(reserved.layout)
    const filled = program.layoutAt reserved.layout
    program.setLayout(
      reserved.layout,
      filled.copy(
        fields: [FieldLayout("value", int64), FieldLayout("left", nodeType), FieldLayout("right", nodeType)],
        variants: [VariantLayout("Leaf", 0, 1), VariantLayout("Branch", 1, 2)],
        built: true,
      ),
    )
    finishProgram program
    assert(
      shown(program, reserved.layout)
        == "layout T_main_Node boxed recursive size 24 align 8 counted variants(Leaf(value: Int64), Branch(left: Variant(T_main_Node), right: Variant(T_main_Node)))",
    )
    assert isManagedType(program, nodeType)
  }

  test "a tuple has numbered fields and no labels" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const strings = program.internType IrType.Text
    const pair = tupleLayout program, "T_tuple__Int64_String", [int64, strings]
    finishProgram program
    assert(
      shown(program, pair) == "layout T_tuple__Int64_String inline size 24 align 8 counted fields(0: Int64, 1: String)",
    )
  }

  test "`Array<Item, Size>` lives inline until it grows past the limit" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const four = program.internType IrType.FixedArray(int64, 4)
    const five = program.internType IrType.FixedArray(int64, 5)
    const small = recordLayout program, "T_main_Small", [FieldLayout("cells", four)]
    const large = recordLayout program, "T_main_Large", [FieldLayout("cells", five)]
    finishProgram program
    assert(shown(program, small) == "layout T_main_Small inline size 32 align 8 fields(cells: Array(Int64, 4))")
    assert(shown(program, large) == "layout T_main_Large boxed size 40 align 8 fields(cells: Array(Int64, 5))")
    assert(sizeOfType(program, four) == 32)
    assert(alignmentOfType(program, four) == 8)
  }

  test "a field that can reach a `shared` object or a `Box` is what a trace function is emitted for" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const cell = recordLayout program, "T_main_Cell", [FieldLayout("value", int64)]
    const cellType = program.internType IrType.SharedObject(cell)
    const holder = recordLayout program, "T_main_Holder", [FieldLayout("cell", cellType)]
    const holderType = program.internType IrType.Record(holder)
    const outer = recordLayout program, "T_main_Outer", [FieldLayout("holder", holderType)]
    const plain = recordLayout program, "T_main_Plain", [FieldLayout("value", int64)]
    finishProgram program
    assert program.layoutAt(holder).containsShared
    assert program.layoutAt(outer).containsShared
    assert(!program.layoutAt(plain).containsShared)
    assert(!program.layoutAt(plain).containsCounted)
  }

  test "a type with fields of its own and cases keeps the common fields in front of every group" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const strings = program.internType IrType.Text
    const reserved = program.reserveLayout "T_main_Event", LayoutKind.Variant
    const layout = program.layoutAt reserved.layout
    program.setLayout(
      reserved.layout,
      layout.copy(
        fields: [FieldLayout("name", strings), FieldLayout("code", int64)],
        variants: [VariantLayout("Started", 1, 0), VariantLayout("Stopped", 1, 1)],
        commonFieldCount: 1,
        built: true,
      ),
    )
    finishProgram program
    assert(
      shown(program, reserved.layout)
        == "layout T_main_Event inline size 32 align 8 counted common(name: String) variants(Started, Stopped(code: Int64))",
    )
  }

  test "only a pointer that is never null can carry a niche" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const strings = program.internType IrType.Text
    const listOfInteger = program.internType IrType.Runtime(RuntimeKind.ListStorage, [int64])
    const box = program.internType IrType.Box(int64)
    const boolean = program.internType IrType.Boolean
    finishProgram program
    assert isNichePayload(program, strings)
    assert isNichePayload(program, listOfInteger)
    assert isNichePayload(program, box)
    assert(!isNichePayload(program, int64))
    assert(!isNichePayload(program, boolean))
  }
}

group "Mangling" {
  test "a name is the source path plus the arguments, and nothing else" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const list = SymbolPath "std/prelude", "collections/list", ["ArrayList"], "append"
    assert(functionName(program, list, [int64]) == "t_std_x2f_prelude_collections_x2f_list_ArrayList_append__Int64")
    assert(functionName(program, SymbolPath("", "main", [], "translated"), []) == "t_main_translated")
    assert(layoutName(program, SymbolPath("", "main", [], "Point"), []) == "T_main_Point")
    assert(staticName(program, SymbolPath("", "main", [], "greeting"), []) == "s_main_greeting")
  }

  test "a generic instance, and a generic instance of a generic instance" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const listOfInteger = program.internType IrType.Runtime(RuntimeKind.ListStorage, [int64])
    const option = SymbolPath "std/prelude", "option", [], "Option"
    assert(layoutName(program, option, [int64]) == "T_std_x2f_prelude_option_Option__Int64")
    const innerName = layoutName program, option, [listOfInteger]
    assert(innerName == "T_std_x2f_prelude_option_Option__List_Int64")
    const reserved = program.reserveLayout innerName, LayoutKind.Variant
    const inner = program.internType IrType.Variant(reserved.layout)
    assert(
      layoutName(program, option, [inner])
        == "T_std_x2f_prelude_option_Option__T_std_x2f_prelude_option_Option__List_Int64",
    )
  }

  test "a tuple, a function type and a trait-typed value are spelled from their parts" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const boolean = program.internType IrType.Boolean
    const strings = program.internType IrType.Text
    assert(tupleLayoutName(program, [int64, strings]) == "T_tuple__Int64_String")
    const plain = program.internSignature IrSignature([IrParameter("value", int64)], boolean)
    const reference = program.internSignature(IrSignature(
      [IrParameter("counter", int64, true, Ownership.Borrowed)],
      boolean,
    ))
    assert(canonicalSignature(program, plain) == "Function_Int64_to_Bool")
    assert(canonicalSignature(program, reference) == "Function_ref_Int64_to_Bool")
    const show = program.internTrait IrTrait(SymbolId(3), SymbolPath("std/prelude", "convert", [], "Show"), [])
    const iterable = program.internTrait(IrTrait(
      SymbolId(4),
      SymbolPath("std/prelude", "iteration", [], "Iterate"),
      [int64],
    ))
    assert(canonicalTrait(program, show) == "std_x2f_prelude_convert_Show")
    assert(canonicalTrait(program, iterable) == "std_x2f_prelude_iteration_Iterate_Int64")
    const object = program.internType IrType.Object([show, iterable])
    assert(
      canonicalType(program, object) == "Object_std_x2f_prelude_convert_Show_std_x2f_prelude_iteration_Iterate_Int64",
    )
    const target = program.internType IrType.Integer(32, signed: true)
    assert(witnessTableName(program, show, target) == "w_std_x2f_prelude_convert_Show__Int32")
    assert(witnessTableName(program, iterable, target) == "w_std_x2f_prelude_iteration_Iterate__Int32_Int64")
  }

  test "a const argument is part of the name, and so is its sign" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const float64 = program.internType IrType.Floating(64)
    const cells = program.internType IrType.FixedArray(float64, 16)
    assert(canonicalType(program, cells) == "Array_Float64_16")
    const sixteen = program.internType IrType.ConstantValue(LiteralValue.Integer(16), int64)
    const negative = program.internType IrType.ConstantValue(LiteralValue.Integer(0 - 3), int64)
    const yes = program.internType IrType.ConstantValue(LiteralValue.Boolean(true), int64)
    const word = program.internType IrType.ConstantValue(LiteralValue.Text("north west"), int64)
    assert(canonicalType(program, sixteen) == "16")
    assert(canonicalType(program, negative) == "minus3")
    assert(canonicalType(program, yes) == "true")
    assert(canonicalType(program, word) == "north_x20_west")
    const matrix = SymbolPath "", "main", [], "Matrix"
    assert(layoutName(program, matrix, [float64, sixteen]) == "T_main_Matrix__Float64_16")
  }

  test "the smallest `Int64` as a const argument is spelled without negating it" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const smallest = 0 - 9223372036854775807 - 1
    const argument = program.internType IrType.ConstantValue(LiteralValue.Integer(smallest), int64)
    assert(canonicalType(program, argument) == "minus9223372036854775808")
  }

  test "a name that is not a C identifier becomes one, byte by byte" {
    assert(escapedComponent("Größe") == "Gr_xc3__xb6__xc3__x9f_e")
    assert(escapedComponent("plain99") == "plain99")
    assert(escapedComponent("a-b.c") == "a_x2d_b_x2e_c")
    assert(escapedComponent("_") == "_x5f_")
    assert(hexDigits(255, 2) == "ff")
    assert(hexDigits(0, 4) == "0000")
    var program = IrProgram()
    assert(layoutName(program, SymbolPath("", "modell", [], "Größe"), []) == "T_modell_Gr_xc3__xb6__xc3__x9f_e")
  }

  test "names that would collide without escaping do not" {
    var program = IrProgram()
    // An underscore of the source is always escaped, so no component can ever be read as two
    const joined = layoutName program, SymbolPath("", "a", [], "b_c"), []
    const separate = layoutName program, SymbolPath("", "a", ["b"], "c"), []
    const inModule = layoutName program, SymbolPath("", "a_b", [], "c"), []
    assert(joined == "T_a_b_x5f_c")
    assert(separate == "T_a_b_c")
    assert(inModule == "T_a_x5f_b_c")
    assert(joined != separate)
    assert(separate != inModule)
    // The same names, one level deeper: a package that spells what a module below it spells
    const first = layoutName program, SymbolPath("acme/one", "two", [], "Value"), []
    const second = layoutName program, SymbolPath("acme", "one/two", [], "Value"), []
    assert(first == "T_acme_x2f_one_two_Value")
    assert(second == "T_acme_one_x2f_two_Value")
    assert(first != second)
  }

  test "an instance spelling that is too long is cut and carries a hash of the whole of it" {
    const long = "X".repeat(200)
    const name = mangledName "t", ["main", "f"], long
    assert(name.byteLength() == 10 + instanceLengthLimit + 2 + 16)
    assert name.startsWith("t_main_f__XXX")
    assert name.contains("_h")
    const other = mangledName("t", ["main", "f"], "X".repeat(199) + "Y")
    assert(name != other)
    assert(name.sliceBytes(0, 170) == other.sliceBytes(0, 170))
    assert(nameHash("a") != nameHash("b"))
    assert(nameHash("abc") == nameHash("abc"))
    assert(nameHash("abc").byteLength() == 16)
  }

  test "an instance key tells two instances apart, and is the same for one instance" {
    const first = Instance SymbolId(7), [IrTypeId(2), IrTypeId(3)], []
    const again = Instance SymbolId(7), [IrTypeId(2), IrTypeId(3)], []
    const other = Instance SymbolId(7), [IrTypeId(3), IrTypeId(2)], []
    const withWitness = Instance SymbolId(7), [IrTypeId(2), IrTypeId(3)], [WitnessTableId(1)]
    assert(instanceKey(first) == instanceKey(again))
    assert(instanceKey(first) != instanceKey(other))
    assert(instanceKey(first) != instanceKey(withWitness))
  }

  test "every form of a type has a spelling of its own" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const unsigned = program.internType IrType.Integer(8, signed: false)
    const boolean = program.internType IrType.Boolean
    const character = program.internType IrType.Character
    const voidType = program.internType IrType.VoidType
    const never = program.internType IrType.NeverType
    const strings = program.internType IrType.Text
    const box = program.internType IrType.Box(int64)
    const cell = program.internType IrType.Lazy(strings)
    assert(canonicalType(program, int64) == "Int64")
    assert(canonicalType(program, unsigned) == "UInt8")
    assert(canonicalType(program, boolean) == "Bool")
    assert(canonicalType(program, character) == "Char")
    assert(canonicalType(program, voidType) == "Void")
    assert(canonicalType(program, never) == "Never")
    assert(canonicalType(program, strings) == "String")
    assert(canonicalType(program, box) == "Box_Int64")
    assert(canonicalType(program, cell) == "Lazy_String")
    const kinds = [
      RuntimeKind.ListStorage,
      RuntimeKind.MapStorage,
      RuntimeKind.SetStorage,
      RuntimeKind.TaskObject,
      RuntimeKind.ChannelObject,
      RuntimeKind.ExpressionTree,
    ]
    const names = ["List_Int64", "Map_Int64", "Set_Int64", "Task_Int64", "Channel_Int64", "Expression_Int64"]
    for index in 0..kinds.length() {
      const one = program.internType IrType.Runtime(kinds[index], [int64])
      assert(canonicalType(program, one) == names[index])
    }
    const decimal = program.internType IrType.Runtime(RuntimeKind.DecimalNumber, [])
    assert(canonicalType(program, decimal) == "Decimal")
    const letter = program.internType IrType.ConstantValue(LiteralValue.Character('x'), character)
    assert(canonicalType(program, letter) == "x")
    const cellLayout = recordLayout program, "T_main_Cell", [FieldLayout("value", int64)]
    const sharedType = program.internType IrType.SharedObject(cellLayout)
    assert(canonicalType(program, sharedType) == "T_main_Cell")
  }

  test "a parameter that the callee stores is part of the shape it is called with" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const boolean = program.internType IrType.Boolean
    const borrows = program.internSignature IrSignature([IrParameter("value", int64)], boolean)
    const takes = program.internSignature IrSignature([IrParameter("value", int64, false, Ownership.Owned)], boolean)
    assert(borrows != takes)
    assert(canonicalSignature(program, takes) == "Function_owned_Int64_to_Bool")
    const show = program.internTrait IrTrait(SymbolId(3), SymbolPath("std/prelude", "convert", [], "Show"), [])
    const generic = program.internSignature IrSignature([IrParameter("value", int64)], boolean, [show])
    assert(canonicalSignature(program, generic) == "Function_Int64_witness_std_x2f_prelude_convert_Show_to_Bool")
  }

  test "an element descriptor is named after its element type alone" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, signed: true)
    const point = recordLayout program, "T_main_Point", [FieldLayout("x", int64)]
    const pointType = program.internType IrType.Record(point)
    assert(elementName(program, int64) == "d_Int64")
    assert(elementName(program, pointType) == "d_T_main_Point")
  }
}
