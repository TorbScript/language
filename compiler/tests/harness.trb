/**
 * One in-memory workspace for the tests of the type checker, and the questions they ask about it.
 *
 * The prelude here is a small one of its own: the checker looks the declarations the *language* refers to up in
 * `std/prelude` by name (`Option` for `Item?`, `Int64` for an integer literal, `Add` for `+`, `List` for `[1, 2]`),
 * so a test that talks about one of them has to bring it. It is the same shape as the real prelude and a fraction of
 * its size, which is what keeps these tests fast and readable.
 */

use Span from "../src/syntax/source"
use SourceTree from "../src/project/source-tree"
use ModuleId from "../src/semantics/module"
use check from "../src/semantics/check"
use Checker, Resolution, Adaptation, Dispatch, Statistics, ReceiverClosure from "../src/semantics/checker/context"
use Place, PlaceRoot, PlaceStep, ClosureKind, CollectionLiteral from "../src/semantics/checker/context"
use TypeId, Witness, describeLiteral from "../src/semantics/checker/type"
use MatchPlan, MatchArmPlan, PatternBranch, PatternTest, PatternCheck from "../src/semantics/checker/exhaustive"
use PatternLiteral, PatternStep from "../src/semantics/checker/exhaustive"

public const preludeSource = raw"""
  public trait Show {
    fn show(): String
  }

  public trait Equals {
    fn equals(other: Self): Bool
  }

  public trait Compare with Equals {
    fn compare(other: Self): Int

    /** A default member: written in terms of the required one, and not forwarded by `by field` (gap 14). */
    fn max(other: Self): Self {
      if compare(other) > 0 { self } else { other }
    }
  }

  public trait Hash {
    fn hash(): Int
  }

  public trait Add<Other = Self, Output = Self> {
    fn add(other: Other): Output
  }

  public trait Subtract<Other = Self, Output = Self> {
    fn subtract(other: Other): Output
  }

  public trait Multiply<Other = Self, Output = Self> {
    fn multiply(other: Other): Output
  }

  public trait Divide<Other = Self, Output = Self> {
    fn divide(other: Other): Output
  }

  public trait Remainder<Other = Self, Output = Self> {
    fn remainder(other: Other): Output
  }

  public trait Negate {
    fn negate(): Self
  }

  public trait Indexed<Key, Value> {
    fn at(key: Key): Value
  }

  /** `a[key] = v`, and what makes `a[key]` a `var` path at all (milestone 4.6). */
  public trait MutableIndexed<Key, Value> with Indexed<Key, Value> {
    var fn set(key: Key, value: Value)
  }

  public trait Slice {
    fn slice(range: Bounds<Int>): Self
  }

  /** `samples[0..100].sort()`: a window into the original, which is what a range as a `var` path is. */
  public trait MutableSlice with Slice {
    var fn replace(range: Bounds<Int>, values: Self)
  }

  public trait Iterate<Item> {
    fn iterate(): Iterator<Item>
  }

  public trait Iterator<Item> {
    var fn next(): Item?
  }

  public trait From<Source> {
    static fn from(value: Source): Self
  }

  public trait Into<Target> {
    fn into(): Target
  }

  extend<Source, Target> Source with Into<Target> where Target: From<Source> {
    fn into(): Target {
      Target.from(self)
    }
  }

  public trait TryFrom<Source, Failure> {
    static fn tryFrom(value: Source): Result<Self, Failure>
  }

  public trait Encode {
    fn encode(): String
  }

  /**
   * `Expression<Value>` quotes what arrives at it: the argument is checked as an ordinary `Value` and handed over with its
   * tree. Everything it captures has to be `Encode`, which is why the numbers and the collections below have it.
   */
  public native type Expression<Value> {
    source: String

    native fn value(): Value
    native fn captures(): List<Encode>
  }

  /** The one quotation every test file of the language is full of. */
  public native fn assert(condition: Expression<Bool>)

  /** `nameOf(user.email)` is `"email"`: an ordinary function over a quotation, not an intrinsic. */
  public native fn nameOf<Value>(expression: Expression<Value>): String

  public trait Length {
    fn length(): Int

    fn isEmpty(): Bool {
      length() == 0
    }
  }

  public trait Numeric with Add, Subtract, Multiply, Divide, Remainder, Equals, Compare, Show {}

  public trait Signed with Numeric, Negate {}

  public native type Int8 with Signed, Hash, Encode, Power<Int64>, Bits {}
  public native type Int32 with Signed, Hash, Encode, Power<Int64>, Bits {}
  public native type Int64 with Signed, Hash, Encode, Power<Int64>, Bits {}
  public native type UInt8 with Numeric, Hash, Encode, Power<Int64>, Bits {}
  public native type Float32 with Signed, Encode {}
  public native type Float64 with Signed, Encode, Power {}
  public native type Bool with Equals, Hash, Show, Encode {}

  /** As in `std/core`: the traits of `Void` are declared here, not on the name the language provides. */
  public native type Void with Equals, Hash, Show {}
  public native type Char with Equals, Compare, Hash, Show, Encode {}

  public native type String with Equals, Compare, Hash, Show, Add, Slice, Encode {
    native fn byteLength(): Int64
    native fn isEmpty(): Bool
    /** The one native of the harness whose result is an `Option`: `bool` plus an out parameter in the runtime. */
    native fn byteOffsetOf(part: String): Int?
  }

  public type Int = Int64
  public type Float = Float64

  public type Option<Value> with OrElse<Value> {
    case Some(value: Value)
    case None

    fn isSome(): Bool {
      match self {
        Some(_) => true
        .None => false
      }
    }

    /** What `a[key]` panics through, which is why the lists below reach it: the message is the caller's, not a rule. */
    fn expect(message: String): Value {
      match self {
        Some(value) => value
        .None => panic message
      }
    }

    fn orElse(fallback: lazy Value): Value {
      match self {
        Some(value) => value
        .None => fallback
      }
    }

    fn okOr<Failure>(error: lazy Failure): Result<Value, Failure> {
      match self {
        Some(value) => Ok(value)
        .None => Fail(error)
      }
    }
  }

  public type Result<Value, Failure> with OrElse<Value> {
    case Ok(value: Value)
    case Fail(error: Failure)

    fn ok(): Value? {
      match self {
        Ok(value) => Some(value)
        Fail(_) => None
      }
    }

    fn orElse(fallback: lazy Value): Value {
      match self {
        Ok(value) => value
        Fail(_) => fallback
      }
    }
  }

  /** One type per pair of ends, exactly as `std/core` declares them. */
  public type Range<Value> {
    start: Value
    end: Value
    inclusive: Bool = false
  }

  public type RangeFrom<Value> {
    start: Value
  }

  public type RangeTo<Value> {
    end: Value
    inclusive: Bool = false
  }

  /** What all three are, and what `Slice.slice` takes. */
  public trait Bounds<Value: Compare> {
    fn lowest(): Value?
    fn highest(): Value?
    fn includesHighest(): Bool
  }

  extend<Value: Compare> Range<Value> with Bounds<Value> {
    fn lowest(): Value? {
      Some(start)
    }

    fn highest(): Value? {
      Some(end)
    }

    fn includesHighest(): Bool {
      inclusive
    }
  }

  extend<Value: Compare> RangeFrom<Value> with Bounds<Value> {
    fn lowest(): Value? {
      Some(start)
    }

    fn highest(): Value? {
      None
    }

    fn includesHighest(): Bool {
      false
    }
  }

  extend<Value: Compare> RangeTo<Value> with Bounds<Value> {
    fn lowest(): Value? {
      None
    }

    fn highest(): Value? {
      Some(end)
    }

    fn includesHighest(): Bool {
      inclusive
    }
  }

  extend Range<Int> with Iterate<Int> {
    native fn iterate(): Iterator<Int>
  }

  extend RangeFrom<Int> with Iterate<Int> {
    native fn iterate(): Iterator<Int>
  }

  public trait List<Item> with Iterate<Item>, MutableIndexed<Int, Item>, MutableSlice {
    fn length(): Int
    var fn append(value: Item)
    fn appended(value: Item): Self
    var fn removeAt(index: Int): Item?

    /** A body, because the real one is a default of `std/collections` as well: a sort is TorbScript over `a[key]`. */
    var fn sort(by: (value: Item) => Int) {}

    /** `List.of(1, 2)`: a factory of the trait itself, which is what a trait as a namespace means (gap 31). */
    static fn of(...items: Item): List<Item> {
      ArrayList.from(items)
    }
  }

  /** What makes `List.from(...)` and `toList()` work: an implementation whose target is the trait. */
  extend<Item> List<Item> with From<Iterate<Item>> {
    static fn from(items: Iterate<Item>): List<Item> {
      ArrayList.from(items)
    }
  }

  public trait Map<Key, Value> with MutableIndexed<Key, Value> {
    fn length(): Int
    fn isEmpty(): Bool
  }

  /** Every list is showable: an implementation whose target is the *trait* covers every type that implements it. */
  extend<Item: Show> List<Item> with Show {
    fn show(): String {
      "a list"
    }
  }

  /** A quotation may capture a list or an option, so both carry `Encode` exactly as they do in the real prelude. */
  extend<Item: Encode> List<Item> with Encode {
    fn encode(): String {
      "a list"
    }
  }

  extend<Value: Encode> Option<Value> with Encode {
    fn encode(): String {
      "an option"
    }
  }

  /** As in `std/core`: what makes a `Result` showable, and the bound every trait-typed failure has to witness. */
  extend<Value: Show, Failure: Show> Result<Value, Failure> with Show {
    fn show(): String {
      "a result"
    }
  }

  extend<Key: Encode, Value: Encode> Map<Key, Value> with Encode {
    fn encode(): String {
      "a map"
    }
  }

  /**
   * `get` and `at` are written out here as in `std/collections`: this prelude declares `at` as required, and the body
   * is what matters to the tests - `a[key]` out of range panics at the site of the one `panic` of `at`, which is what
   * the `Element` path step of `ir/elements.trb` carries over when it replaces the round trip.
   */
  public native type ArrayList<Item> with List<Item>, From<Iterate<Item>> {
    native static fn from(items: Iterate<Item>): ArrayList<Item>
    native fn get(index: Int): Item?
    native fn length(): Int

    fn at(key: Int): Item {
      match get(key) {
        Some(item) => item
        None => panic "index {key} is out of bounds for a length of {length()}"
      }
    }

    /** `list[from..to]`, over the native that takes two numbers, as in `std/collections`. */
    fn slice(range: Bounds<Int>): ArrayList<Item> {
      sliceBetween(range.lowest() ?? 0, range.highest() ?? length())
    }

    /** `list[from..to] = values`, and what puts a window back. */
    var fn replace(range: Bounds<Int>, values: ArrayList<Item>) {
      replaceBetween(range.lowest() ?? 0, range.highest() ?? length(), values)
    }

    private native fn sliceBetween(start: Int, end: Int): ArrayList<Item>
    private native var fn replaceBetween(start: Int, end: Int, values: ArrayList<Item>)
  }

  /** The trie, whose `from` waits for milestone 8: what a **planned** native looks like to the back end. */
  public native type TrieList<Item> with List<Item>, From<Iterate<Item>> {
    native static fn from(items: Iterate<Item>): TrieList<Item>
    native fn get(index: Int): Item?
    native fn length(): Int

    fn at(key: Int): Item {
      match get(key) {
        Some(item) => item
        None => panic "index {key} is out of bounds for a length of {length()}"
      }
    }
  }

  /**
   * The hash table, for the sake of its **cursor**: `entryAfter` is the one native of the manifest whose runtime function
   * answers `bool` plus *two* out parameters, one per half of the entry it found (`NativeResult.OptionalParts`).
   */
  public native type TrieMap<Key: Hash, Value> with Map<Key, Value> {
    native fn length(): Int
    native fn get(key: Key): Value?
    native var fn set(key: Key, value: Value)
    native fn entryAfter(var cursor: Int): (Key, Value)?
  }

  /** A set, so that a literal can be tested against a collection target that is not a `List` (gap 51). */
  public trait Set<Item>
    with Iterate<Item>, Length
  {
    fn contains(value: Item): Bool
  }

  extend<Item: Hash> Set<Item> with From<Iterate<Item>> {
    static fn from(items: Iterate<Item>): Set<Item> {
      TrieSet.from items
    }
  }

  public native type TrieSet<Item: Hash> with Set<Item>, From<Iterate<Item>> {
    native static fn from(items: Iterate<Item>): TrieSet<Item>

    native fn length(): Int
    native fn iterate(): Iterator<Item>
    native fn contains(value: Item): Bool
  }

  /**
   * `[1, 2]` against an `Array<Int, 2>` writes the items into the inline slots, and the checker counts them. `get`,
   * `at` and `set` are TorbScript over the two storage natives, as in `std/core`, so `values[index]` becomes one
   * `Element` step.
   */
  public native type Array<Item, const Size: Int>
    with Iterate<Item>, Length, MutableIndexed<Int, Item>
  {
    native static fn filled(value: Item): Array<Item, Size>
    native static fn generated(produce: (index: Int) => Item): Array<Item, Size>
    native static fn from(items: Iterate<Item>): Array<Item, Size>?

    native fn length(): Int
    native fn iterate(): Iterator<Item>

    fn get(index: Int): Item? {
      if index < 0 || index >= Size {
        return None
      }
      Some load(index)
    }

    fn at(key: Int): Item {
      if key < 0 || key >= Size {
        panic "index {key} is out of bounds for a length of {Size}"
      }
      load key
    }

    var fn set(index: Int, value: Item) {
      store index, value
    }

    private native fn load(index: Int): Item
    private native var fn store(index: Int, value: Item)
  }

  public native fn print(...values: Show): Void

  public native fn printError(...values: Show): Void

  public native fn panic(message: String): Never

  /** Only a `shared type` has an identity, so this is callable on one and on nothing else (BACKEND gap 15). */
  public native fn isSame<Object>(first: Object, second: Object): Bool

  /** The destructor: only a `shared type` implements it, and nothing calls it but the last release. */
  public shared trait Close {
    var fn close()
  }

  public fn do<Value>(body: () => Value): Value {
    body()
  }

  /** A function that returns a `Task<Value>` has a body that produces the `Value`. */
  public native shared type Task<Value> {
    native fn await(): Value
  }

  // Everything below is at the end on purpose: the tests of the IR name lines of this file, so a declaration that is
  // added in the middle moves them all.

  /** As in `std/iteration`: the one collection target the language has, and what gap 53 is about. */
  extend<Item> Iterate<Item> {
    fn to<Target: From<Iterate<Item>>>(): Target {
      Target.from self
    }
  }

  /** As in `std/text`: a `String` is built from its characters, and it is not `Iterate<Char>` itself. */
  extend String with From<Iterate<Char>> {
    native static fn from(value: Iterate<Char>): String
  }

  /**
   * As in `std/core` (gap 50): `Never` coerces to everything, so the conversion is total and forced. It is also what
   * makes `From` the one trait a type implements several times, which is what gap 53 is about.
   */
  extend<Target> Target with From<Never> {
    static fn from(value: Never): Target {
      value
    }
  }

  /** As in `std/core`: the blanket that gives every `TryFrom` its `TryInto`, which nothing implements by hand. */
  public trait TryInto<Target, Failure> {
    fn tryInto(): Result<Target, Failure>
  }

  extend<Source, Target, Failure> Source with TryInto<Target, Failure> where Target: TryFrom<Source, Failure> {
    fn tryInto(): Result<Target, Failure> {
      Target.tryFrom self
    }
  }

  /** As in `std/core`: `a ?? b` is `a.orElse(b)`, so it is a trait like every other operator. */
  public trait OrElse<Value> {
    fn orElse(fallback: lazy Value): Value
  }

  /** As in `std/task`: the closure it takes may capture no `var` binding (CONCEPT, "Concurrency"). */
  public native fn spawn<Value>(body: () => Value): Task<Value>

  /**
   * As in `std/encoding`: the way back in, shortened to the one thing derivation looks at, which is its name. The real
   * one takes a `var decoder: Decoder` and fails with a `DecodeError`, and neither is a question the checker asks.
   */
  public trait Decode {
    static fn decode(text: String): Result<Self, String>
  }

  /** The two scalars a test of derivation reads back, so that a field of one of them does not stop it. */
  extend Int64 with Decode {
    static fn decode(text: String): Result<Int64, String> {
      Fail text
    }
  }

  extend String with Decode {
    static fn decode(text: String): Result<String, String> {
      Ok text
    }
  }

  /** As in `std/core`: the trait-typed failure a top-level `?` walks with `cause()` (`ir/lower/match.trb`). */
  public trait Error with Show {
    fn cause(): Error? {
      None
    }
  }

  /** As in `std/task`: the second shared type a value may be held by more than one task through. */
  public native shared type Channel<Item> {
    capacity: Int = 0
  }

  /** `a ** b`. Last in this file, so that adding it moved no line a test of the lowering names. */
  public trait Power<Exponent = Self, Output = Self> {
    fn power(exponent: Exponent): Output
  }

  /** As in `std/number`: a whole exponent of a float has a body, and a float one is the runtime's. */
  extend Float64 with Power<Int64> {
    fn power(exponent: Int64): Float64 {
      self
    }
  }

  /** `&`, `|`, `^`, `~`, `<<` and `>>`. */
  public trait Bits {
    fn bitwiseAnd(other: Self): Self
    fn bitwiseOr(other: Self): Self
    fn bitwiseExclusiveOr(other: Self): Self
    fn bitwiseNot(): Self
    fn shiftedLeft(by: Int64): Self
    fn shiftedRight(by: Int64): Self
  }

  /** A number the runtime owns end to end and the C back end has no spelling for yet: last, so no line above moves. */
  public native type Decimal {}
  """

public const workspace = [
  "project.trb": raw"""
    name = "acme/all"
    workspace { members "std/*", "app" }
    """,
  "std/prelude/project.trb": raw"""
    name = "std/prelude"
    """,
  "std/prelude/src/types.trb": preludeSource,
  "std/prelude/src/lib.trb": raw"""
    public use Show, Equals, Compare, Hash, Negate, Iterate, Iterator from "./types"
    public use Add, Subtract, Multiply, Divide, Remainder, Power, Bits, Indexed, Slice from "./types"
    public use MutableIndexed, MutableSlice, OrElse from "./types"
    public use Numeric, Signed, Int8, Int32, Int64, UInt8, Float32, Float64, Decimal from "./types"
    public use Bool, Char, String, Int, Float, Option, Result, List, ArrayList, Map, Array from "./types"
    public use Range, RangeFrom, RangeTo, Bounds from "./types"
    public use Set, TrieSet, TrieMap, TrieList from "./types"
    public use From, Into, TryFrom, TryInto, Encode, Decode, Length, Close, Task, Channel from "./types"
    public use Error from "./types"
    public use print, printError, panic, do, assert, nameOf, Expression, spawn from "./types"
    public use Void from "./types"
    public use isSame from "./types"
    public use Option.Some, Option.None from "./types"
    public use Result.Ok, Result.Fail from "./types"
    """,
  "app/project.trb": raw"""
    name = "acme/app"
    """,
]

public fn workspaceWith(files: Map<String, String>): SourceTree {
  var all = workspace
  for (path, text) in files {
    all.set path, text
  }
  SourceTree.of all
}

/** One checked `app/src/main.trb`, and everything a test asks about it. */
public type Probed {
  source: String
  var checker: Checker
  module: ModuleId

  /**
   * The span of `written` in the source. It has to appear exactly once, which is what makes the span known without
   * parsing the file a second time.
   */
  fn spanOf(written: String): Span {
    const start = source.byteOffsetOf(written).expect("`{written}` in the source")
    Span(start, start + written.byteLength())
  }

  /**
   * The span of the **last** occurrence of `written`. A parameter is declared before its body reads it, so a test about
   * a read of a parameter cannot use the first occurrence the way everything else does.
   */
  fn lastSpanOf(written: String): Span {
    const length = source.byteLength()
    var start = -1
    var from = 0
    while from < length {
      const rest = source.sliceBytes(from, length)
      const found = match rest.byteOffsetOf(written) {
        Some(index) => index
        None => {
          from = length
          continue
        }
      }
      start = from + found
      from = start + 1
    }
    if start < 0 {
      panic "`{written}` is not in the source"
    }
    Span(start, start + written.byteLength())
  }

  /** The adaptations of the last expression that is written exactly like this, in the order they apply. */
  fn lastAdaptationsOf(written: String): List<String> {
    const at = lastSpanOf written
    var found: List<String> = []
    for adaptation in checker.adaptationsAt(module, at) {
      found.append describeAdaptation(checker, adaptation)
    }
    found
  }

  /** The type of the expression that is written exactly like this, as a message would show it. */
  fn typeOf(written: String): String {
    const at = spanOf written
    const found = checker.expressionType(module, at).expect("an expression at `{written}`")
    checker.describe found
  }

  /** The type of the pattern that is written exactly like this. */
  fn patternTypeOf(written: String): String {
    const at = spanOf written
    const found = checker.patternType(module, at).expect("a pattern at `{written}`")
    checker.describe found
  }

  /** What the expression at `written` resolved to, in the shape a test can compare. */
  fn resolutionOf(written: String): String {
    const at = spanOf written
    const found = checker.resolutionAt(module, at).expect("a resolution at `{written}`")
    describeResolution checker, found
  }

  /** How the call or the operator at `written` reaches its target. */
  fn dispatchOf(written: String): String {
    const at = spanOf written
    dispatchAt checker, module, at
  }

  /**
   * Whether the `?.` whose member is written at the **last** occurrence of `written` answers an `Option` of its own:
   * `flatMap` then, and `map` otherwise. The last occurrence, because a member is declared before it is used.
   */
  fn flattensOptional(written: String): Bool {
    const at = lastSpanOf written
    checker.flattenedOptionalAt(module, at).expect("a `?.` whose member is `{written}`")
  }

  /** The adaptations of the expression at `written`, in the order they apply. */
  fn adaptationsOf(written: String): List<String> {
    const at = spanOf written
    var found: List<String> = []
    for adaptation in checker.adaptationsAt(module, at) {
      found.append describeAdaptation(checker, adaptation)
    }
    found
  }

  /** Which parameter every written argument of the call at `written` fills. */
  fn argumentsOf(written: String): List<Int> {
    const at = spanOf written
    checker.argumentTargetsAt(module, at).expect("a call at `{written}`")
  }

  /** The type arguments the generic call at `written` was instantiated with, in declaration order. */
  fn typeArgumentsOf(written: String): List<String> {
    const at = spanOf written
    const found = checker.typeArgumentsAt(module, at) ?? []
    var shown: List<String> = []
    for argument in found {
      shown.append checker.describe(argument)
    }
    shown
  }

  /** One witness per trait of every bound of the callee at `written`, in the order of the signature. */
  fn witnessesOf(written: String): List<String> {
    const at = spanOf written
    var shown: List<String> = []
    for witness in checker.witnessesAt(module, at) ?? [] {
      shown.append describeWitness(checker, witness)
    }
    shown
  }

  /** Which bindings the closure at `written` captures, and which of them are `var`. */
  fn capturesOf(written: String): List<String> {
    const at = spanOf written
    var shown: List<String> = []
    for capture in checker.capturesAt(module, at) ?? [] {
      const name = checker.binding(capture.binding).name
      shown.append(if capture.isVar { "var {name}" } else { name })
    }
    shown
  }

  /**
   * The quotation at `written`, in a fixed order so that the lines are comparable: the type of the quoted expression,
   * the captures in the order `Expression.captures()` returns them, then the quoted closures and the names inside - both
   * named by the text that was written there, which is what a test can read.
   */
  fn quotationOf(written: String): List<String> {
    const at = spanOf written
    const found = checker.quotationAt(module, at).expect("a quotation at `{written}`")
    var lines = ["value {checker.describe(found.annotation)}"]
    for index in 0..found.captures.length() {
      const capture = found.captures[index]
      const shown = checker.describe capture.annotation
      const witness = describeWitness checker, capture.witness
      lines.append "capture {index} {capture.name}: {shown} through {witness}"
    }
    var inside: List<(Span, String)> = []
    for (span, parameters) in found.lambdas {
      var parts: List<String> = []
      for parameter in parameters {
        parts.append "{parameter.name}: {checker.describe(parameter.annotation)}"
      }
      inside.append((span, "lambda `{textAt(span)}` ({parts.joined(separator: ", ")})"))
    }
    for (span, node) in found.names {
      const shown = match node {
        .Parameter(index) => "parameter {index}"
        .Captured(index) => "capture {index}"
      }
      inside.append((span, "name `{textAt(span)}` {shown}"))
    }
    inside.sort({ (_.0.start, _.0.end) })
    lines.appendedAll(inside.map({ _.1 }).toList())
  }

  /** The text of one span of the source, which is how a test recognizes a node of a quotation. */
  fn textAt(at: Span): String {
    source.sliceBytes at.start, at.end
  }

  /** The receiver of the receiver closure at `written`. `Span(0, 0)` is the body of a receiver script. */
  fn receiverOf(written: String): String {
    const at = if written.isEmpty() { Span 0, 0 } else { spanOf written }
    const found = checker.receiverAt(module, at).expect("a receiver closure at `{written}`")
    describeReceiver checker, found
  }

  /**
   * The plan of the `match` at `written`, one line per arm: what it tests, where, and what it binds. An `if const` and
   * a `while const` are recorded under the span of their pattern.
   */
  fn matchPlanOf(written: String): List<String> {
    const at = spanOf written
    const plan = checker.matchAt(module, at).expect("a match at `{written}`")
    describeArms checker, plan
  }

  /** Whether the `match` at `written` covers every value, and the values it does not. */
  fn witnessesOfMatch(written: String): List<String> {
    const at = spanOf written
    checker.matchAt(module, at).expect("a match at `{written}`").witnesses
  }

  fn isExhaustive(written: String): Bool {
    const at = spanOf written
    checker.matchAt(module, at).expect("a match at `{written}`").isExhaustive
  }

  /** The place the assignment, `var` argument, `var fn` receiver or `if var` subject at `written` names. */
  fn placeOf(written: String): String {
    const at = spanOf written
    const found = checker.placeAt(module, at).expect("a place at `{written}`")
    describePlace checker, found
  }

  /** Whether a place was recorded at all, which is the question a test about a rejected path asks. */
  fn hasPlaceAt(written: String): Bool {
    const at = spanOf written
    checker.placeAt(module, at).isSome()
  }

  /** What the collection literal at `written` became: the default collection, inline array slots, or `Target.from`. */
  fn collectionOf(written: String): String {
    const at = spanOf written
    const found = checker.collectionLiteralAt(module, at).expect("a collection literal at `{written}`")
    describeCollectionLiteral checker, found
  }

  /** Whether the literal at `written` was recorded at all, which is the question a test about a rejected one asks. */
  fn hasCollectionAt(written: String): Bool {
    const at = spanOf written
    checker.collectionLiteralAt(module, at).isSome()
  }

  /** Whether the closure at `written` may outlive the call it stands in. */
  fn closureKindOf(written: String): String {
    const at = spanOf written
    match checker.closureKindAt(module, at) {
      Some(.Local) => "local"
      Some(.Escaping) => "escaping"
      None => "none"
    }
  }

  fn statistics(): Statistics {
    checker.statisticsOf module
  }
}

/** One line per arm of a `MatchPlan`, in the order the lowering lowers them. */
public fn describeArms(checker: Checker, plan: MatchPlan): List<String> {
  var lines: List<String> = []
  for arm in plan.arms {
    var branches: List<String> = []
    for branch in arm.branches {
      branches.append describeBranch(checker, branch)
    }
    var line = branches.joined separator: " | "
    if arm.hasGuard {
      line = "{line} guarded"
    }
    if !arm.isReachable {
      line = "{line} unreachable"
    }
    lines.append line
  }
  lines
}

/** One alternative: the tests it makes in order, then the names it binds with the path to each of them. */
fn describeBranch(checker: Checker, branch: PatternBranch): String {
  var parts: List<String> = []
  for probed in branch.tests {
    const place = describePath checker, probed.path
    parts.append "{place} {describeCheck(checker, probed.check)}"
  }
  for bound in branch.bindings {
    const place = describePath checker, bound.path
    const name = if bound.isVar { "var {bound.name}" } else { bound.name }
    parts.append "{name}={place}"
  }
  if parts.isEmpty() {
    return "anything"
  }
  parts.joined separator: " "
}

fn describeCheck(checker: Checker, check: PatternCheck): String {
  match check {
    .IsCase(_, variant) => "is .{checker.symbolAt(variant).name}"
    .IsLiteral(literal) => "is {describePatternLiteral(literal)}"
    .IsInRange(low, high, isInclusive) => {
      const between = if isInclusive { "..=" } else { ".." }
      "in {describePatternLiteral(low)}{between}{describePatternLiteral(high)}"
    }
    .HasLength(length) => "hasLength {length}"
    .HasAtLeast(length) => "hasAtLeast {length}"
  }
}

fn describePatternLiteral(literal: PatternLiteral): String {
  match literal.value {
    Some(found) => describeLiteral found
    None => "?"
  }
}

/** `subject`, `subject.radius`, `subject.0`, `subject[1]`, `subject[1...]`: how the lowering reaches one value. */
fn describePath(checker: Checker, path: List<PatternStep>): String {
  var shown = "subject"
  for step in path {
    shown = shown + describeStep(checker, step)
  }
  shown
}

fn describeStep(checker: Checker, step: PatternStep): String {
  match step {
    .CaseField(_, _, _, field) => ".{checker.symbolAt(field).name}"
    .Field(_, _, field) => ".{checker.symbolAt(field).name}"
    .TupleField(_, index) => ".{index}"
    .Item(index) => "[{index}]"
    .ItemFromEnd(index) => "[-{index}]"
    .Rest(index) => "[{index}...]"
  }
}

/**
 * A place as a test writes it: where the path starts, then one step per field, index, window or tuple position. An
 * index shows the key it was written as, or `?` where it is not a literal - which is exactly what decides whether two
 * of them can be told apart.
 */
public fn describePlace(checker: Checker, place: Place): String {
  var shown = match place.root {
    .Local(binding) => "local {checker.binding(binding).name}"
    .Declared(symbol) => "declared {checker.symbolAt(symbol).name}"
    .Temporary => "temporary"
    .Unknown => "unknown"
  }
  for step in place.steps {
    match step {
      .Field(_, field) => {
        shown = "{shown}.{checker.symbolAt(field).name}"
      }
      .Index(_, _, literal) => {
        const key = if literal.isEmpty() { "?" } else { literal }
        shown = "{shown}[{key}]"
      }
      .Range(_, _) => {
        shown = "{shown}[..]"
      }
      .TupleField(_, index) => {
        shown = "{shown}.{index}"
      }
    }
  }
  shown
}

public fn probe(source: String): Probed {
  const checked = check workspaceWith(["app/src/main.trb": source]), ["app"]
  const module = checked.program.graph.moduleAt("app/src/main.trb").expect("the module of the file")
  Probed source, checked.checker, module
}

/**
 * One file of `app` that is not its entry file. `app/src/main.trb` is the build input of the package, so everything
 * about a *module* - top-level code, a compile-time constant, what `public` promises - needs a second file that the
 * entry file imports.
 */
public fn probeModule(files: Map<String, String>, path: String): Probed {
  const checked = check workspaceWith(files), ["app"]
  const module = checked.program.graph.moduleAt(path).expect("the module of the file")
  Probed(files.get(path) ?? "", checked.checker, module)
}

/** Everything that is wrong in `app`, in the order the compiler reports it. */
public fn problems(source: String): List<String> {
  var found: List<String> = []
  for file in check(workspaceWith(["app/src/main.trb": source]), ["app"]).files {
    for diagnostic in file.diagnostics {
      found.append diagnostic.message
    }
  }
  found
}

/** Everything that is wrong in `app`, for a workspace of more than one file. */
public fn problemsOf(files: Map<String, String>): List<String> {
  var found: List<String> = []
  for file in check(workspaceWith(files), ["app"]).files {
    for diagnostic in file.diagnostics {
      found.append diagnostic.message
    }
  }
  found
}

/** Everything that is wrong in the given paths: for a rule that is about a package of the standard library. */
public fn problemsAt(files: Map<String, String>, paths: List<String>): List<String> {
  var found: List<String> = []
  for file in check(workspaceWith(files), paths).files {
    for diagnostic in file.diagnostics {
      found.append diagnostic.message
    }
  }
  found
}

/** The notes of the first problem of such a workspace. */
public fn notesOf(files: Map<String, String>): List<String> {
  for file in check(workspaceWith(files), ["app"]).files {
    if const Some(first) = file.diagnostics.first() {
      return first.notes
    }
  }
  []
}

/** The notes of the first problem of `app`. */
public fn notes(source: String): List<String> {
  for file in check(workspaceWith(["app/src/main.trb": source]), ["app"]).files {
    if const Some(first) = file.diagnostics.first() {
      return first.notes
    }
  }
  []
}

/** A resolution as a test writes it: the kind, and the name of what it points at. */
public fn describeResolution(checker: Checker, resolution: Resolution): String {
  match resolution {
    .Local(binding) => "local {checker.binding(binding).name}"
    .Callable(symbol, _, _) => "call {checker.symbolAt(symbol).name}"
    .Field(owner, field) => "field {checker.describe(owner)}.{checker.symbolAt(field).name}"
    .Constant(symbol, _) => "constant {checker.symbolAt(symbol).name}"
    .Construct(owner) => "construct {checker.describe(owner)}"
    .CopyOf(owner) => "copy {checker.describe(owner)}"
    .CaseOf(owner, variant) => "case {checker.describe(owner)}.{checker.symbolAt(variant).name}"
    .TupleField(_, index) => "tuple {index}"
    .Namespace(_) => "namespace"
    .TypeOf(owner) => "type {checker.describe(owner)}"
    .PropertyWrite(owner, field) => "configure {checker.describe(owner)}.{checker.symbolAt(field).name}"
    .Deferred => "deferred"
  }
}

/** The receiver of the receiver closure at `written`, as a test compares it: the binding, its type, and how it got it. */
public fn describeReceiver(checker: Checker, found: ReceiverClosure): String {
  const name = checker.binding(found.binding).name
  const shown = checker.describe found.annotation
  const how = if found.isImplicit { "implicit" } else { "named" }
  const mode = if found.isVar { "var " } else { "" }
  "{how} {mode}{name}: {shown}"
}

/** An adaptation as a test writes it. */
public fn describeAdaptation(checker: Checker, adaptation: Adaptation): String {
  match adaptation {
    .Literal(annotation) => "literal {checker.describe(annotation)}"
    .DefaultArgument(parameter) => "default {parameter}"
    .Reorder(order) => "reorder {order}"
    .Variadic(element, from) => "variadic {checker.describe(element)} from {from}"
    .Spread => "spread"
    .Lazy => "lazy"
    .Force => "force"
    // The quotation is recorded under the span of the expression itself, which is the span this adaptation sits at
    .Quote(_) => "quote"
    .TrailingClosure(parameter) => "trailing {parameter}"
    .ImplicitSelf(receiver) => "self {checker.binding(receiver).name}"
    .ImplicitParameter(index) => "parameter {index}"
    .ToTraitValue(bounds, _) => "trait value {describeBounds(checker, bounds)}"
    .Convert(witness, method) => "convert {checker.symbolAt(method).name} through {describeWitness(checker, witness)}"
    .ShowValue(witness) => "show through {describeWitness(checker, witness)}"
    .Delegate(field) => "delegate {field}"
    .Wrap(annotation) => "wrap into {checker.describe(annotation)}"
  }
}

fn describeBounds(checker: Checker, bounds: List<TypeId>): String {
  var parts: List<String> = []
  for bound in bounds {
    parts.append checker.describe(bound)
  }
  parts.joined separator: " + "
}

/**
 * What a collection literal became, as a test compares it: the default collection of the trait, `Item x Size` slots of
 * an inline array, or the target the list is handed to with the `From<Iterate<Item>>` that does it.
 */
public fn describeCollectionLiteral(checker: Checker, found: CollectionLiteral): String {
  match found {
    .Default => "default"
    .InlineArray(item, size) => "array {checker.describe(item)} x {size}"
    .FromIterate(target, item, witness) => {
      const shown = describeWitness checker, witness
      "from {checker.describe(target)} of {checker.describe(item)} through {shown}"
    }
  }
}

/** A witness as a test writes it: which implementation makes a bound hold, and for which type. */
public fn describeWitness(checker: Checker, witness: Witness): String {
  match witness {
    .Implementation(implementation, _, inner) => {
      const found = checker.implementations.at implementation
      const shown = "{checker.describe(found.target)}: {describeTrait(checker, found.capability)}"
      if inner.isEmpty() {
        return shown
      }
      var parts: List<String> = []
      for nested in inner {
        parts.append describeWitness(checker, nested)
      }
      "{shown} [{parts.joined(separator: ", ")}]"
    }
    .Forwarded(_, bound) => "forwarded {checker.describe(bound)}"
    .Object(annotation, bound) => "object {checker.describe(annotation)}: {checker.describe(bound)}"
    .Derived(index) => "derived {index}"
    .Unresolved => "unresolved"
  }
}

fn describeTrait(checker: Checker, applied: TypeId?): String {
  match applied {
    Some(found) => checker.describe found
    None => "-"
  }
}

/** How a call reaches its target: `.Direct`, or which implementation, bound or parameter carries the member. */
public fn describeDispatch(checker: Checker, dispatch: Dispatch): String {
  match dispatch {
    .Direct => "direct"
    .Implementation(implementation, _) => {
      const found = checker.implementations.at implementation
      const shown = describeTrait checker, found.capability
      "implementation {checker.describe(found.target)}: {shown}"
    }
    .Object(bound, _) => "object {checker.describe(bound)}"
    .Forwarded(_, bound, _) => "forwarded {checker.describe(bound)}"
  }
}

/** The dispatch that was recorded for the expression at `written`, for a test about an operator or a trait member. */
public fn dispatchAt(checker: Checker, module: ModuleId, at: Span): String {
  match checker.resolutionAt(module, at) {
    Some(.Callable(_, _, dispatch)) => describeDispatch checker, dispatch
    _ => "none"
  }
}
