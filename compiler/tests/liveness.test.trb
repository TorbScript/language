/**
 * The analysis under the ownership pass: which slots a frame counts at all, in which order the blocks are walked, and
 * what is live where.
 *
 * Every function here is built by hand, because the point is the *analysis* and not what a particular lowered program
 * happens to look like. Where the answers end up in a body is pinned in `ownership.test.trb`.
 */

use test, group from "std/test"
use IrProgram, IrType, IrTypeId, IrSignature, IrParameter, Ownership, LayoutId from "../src/ir/ir"
use IrFunction, Slot, SlotRole, BlockId, Instruction, Terminator, borrowed from "../src/ir/ir"
use Intrinsic, IntrinsicOperation, Location, LocationId from "../src/ir/ir"
use LayoutKind, FieldLayout, finishProgram from "../src/ir/layout"
use FunctionBuilder, newFunction, addLocal, addTemporary, addBlock, openBlock from "../src/ir/build"
use switchTo, emit, terminate, terminateBlock from "../src/ir/build"
use Counted, LiveSets, countedSlotsOf, livenessOf, postorderOf, filledFlags from "../src/ir/liveness"

fn textType(var program: IrProgram): IrTypeId {
  program.internType IrType.Text
}

fn recordLayout(var program: IrProgram, name: String, fields: List<FieldLayout>): LayoutId {
  const reserved = program.reserveLayout name, LayoutKind.Record
  const layout = program.layoutAt reserved.layout
  program.setLayout reserved.layout, layout.copy(fields: fields, isBuilt: true)
  reserved.layout
}

/** The slots a frame counts, as a reader says them: `%0 %3`, or `-` when there are none. */
fn shownSlots(counted: Counted): String {
  var parts: List<String> = []
  for slot in counted.slots {
    parts.append "%{slot.value}"
  }
  if parts.isEmpty() {
    return "-"
  }
  parts.joined separator: " "
}

/** One live set, in the same spelling. */
fn shownSet(counted: Counted, flags: List<Bool>): String {
  var parts: List<String> = []
  for position in 0..counted.width() {
    if flags[position] {
      parts.append "%{counted.slots[position].value}"
    }
  }
  if parts.isEmpty() {
    return "-"
  }
  parts.joined separator: " "
}

fn textByteLength(): Intrinsic {
  Intrinsic IntrinsicOperation.TextByteLength, kind: None
}

fn someLocation(var program: IrProgram): LocationId {
  program.internLocation Location("live.trb", 1, 1)
}

fn shownOrder(order: List<Int>): String {
  var parts: List<String> = []
  for block in order {
    parts.append "b{block}"
  }
  parts.joined separator: " "
}

group "Which slots a frame counts" {
  /**
   * The four reasons a slot is not in a live set, all in one function: it holds a number, it holds a `Reference`, it is
   * a parameter the caller keeps the count of, or - for `%5` - it is counted after all, because an inline record of a
   * `String` owns the count of that `String` even though it carries none of its own.
   */
  test "a counted slot is one whose value owns a count and whose count is this frame's" {
    var program = IrProgram()
    const text = textType program
    const int64 = program.internType IrType.Integer(64, isSigned: true)
    const small = recordLayout program, "T_Small", [FieldLayout("name", text), FieldLayout("size", int64)]
    const smallType = program.internType IrType.Record(small)
    const signature = IrSignature(
      [
        IrParameter("owned", text, false, Ownership.Owned),
        IrParameter("lent", text, false, Ownership.Borrowed),
        IrParameter("place", text, true, Ownership.Borrowed),
        IrParameter("count", int64, false, Ownership.Borrowed),
      ],
      text,
    )
    var builder = newFunction "t_counts", None, signature, "body"
    const local = addLocal builder, text, "local"
    const record = addLocal builder, smallType, "record"
    const number = addTemporary builder, int64
    finishProgram program
    assert(shownSlots(countedSlotsOf(program, builder.function)) == "%0 %4 %5")
    assert(local == Slot(4))
    assert(record == Slot(5))
    assert(number == Slot(6))
  }

  test "a function over numbers counts nothing, which is what makes the pass free for one" {
    var program = IrProgram()
    const int64 = program.internType IrType.Integer(64, isSigned: true)
    const boolean = program.internType IrType.Boolean
    const signature = IrSignature([IrParameter("first", int64), IrParameter("second", boolean)], int64)
    var builder = newFunction "t_plain", None, signature, "body"
    const _ = addTemporary builder, int64
    finishProgram program
    const counted = countedSlotsOf program, builder.function
    assert counted.isEmpty()
    assert(counted.width() == 0)
    assert(shownSlots(counted) == "-")
  }
}

group "The order the blocks are walked in" {
  /**
   * Postorder over the successors in the order the terminator writes them. The reverse of it is reverse postorder,
   * which is the order a forward analysis wants and the reverse of the one a backward analysis wants.
   */
  test "postorder takes the successors in the order they are written, and never twice" {
    var program = IrProgram()
    const boolean = program.internType IrType.Boolean
    const voidType = program.internType IrType.VoidType
    const signature = IrSignature([IrParameter("flag", boolean)], voidType)
    var builder = newFunction "t_diamond", None, signature, "body"
    const then = addBlock builder, "then", at: None
    const otherwise = addBlock builder, "else", at: None
    const join = addBlock builder, "join", at: None
    terminate builder, Terminator.Branch(Slot(0), then, otherwise)
    terminateBlock builder, then, Terminator.Jump(join)
    terminateBlock builder, otherwise, Terminator.Jump(join)
    terminateBlock builder, join, Terminator.Return(None)
    assert(shownOrder(postorderOf(builder.function)) == "b3 b1 b2 b0")
  }

  test "a block nothing reaches is in no order at all, so nothing is rewritten in it" {
    var program = IrProgram()
    const voidType = program.internType IrType.VoidType
    var builder = newFunction "t_dead", None, IrSignature([], voidType), "body"
    const lost = addBlock builder, "lost", at: None
    terminate builder, Terminator.Return(None)
    terminateBlock builder, lost, Terminator.Unreachable
    assert(shownOrder(postorderOf(builder.function)) == "b0")
  }
}

group "What is live where" {
  test "a straight line: a value is live from where it is made to its last use" {
    var program = IrProgram()
    const text = textType program
    const signature = IrSignature([IrParameter("text", text, false, Ownership.Owned)], text)
    var builder = newFunction "t_straight", None, signature, "body"
    const local = addLocal builder, text, "copied"
    emit builder, Instruction.Copy(local, Slot(0))
    terminate builder, Terminator.Return(borrowed(local))
    finishProgram program
    const counted = countedSlotsOf program, builder.function
    const live = livenessOf program, builder.function, counted
    assert(shownSlots(counted) == "%0 %1")
    assert(shownSet(counted, live.liveIn[0]) == "%0")
    assert(shownSet(counted, live.liveOut[0]) == "-")
    // One round that changes something and one that does not: nothing more is needed without a loop
    assert(live.rounds == 2)
  }

  /**
   * The set that leaves a block is the union over its successors, so a value one arm needs is live at the end of the
   * block that branches - and the *difference* to what the other arm needs is what the ownership pass releases on that
   * edge.
   */
  test "a branch: what leaves a block is the union of what its successors need" {
    var program = IrProgram()
    const text = textType program
    const boolean = program.internType IrType.Boolean
    const signature = IrSignature(
      [
        IrParameter("flag", boolean),
        IrParameter("first", text, false, Ownership.Owned),
        IrParameter("second", text, false, Ownership.Owned),
      ],
      text,
    )
    var builder = newFunction "t_branch", None, signature, "body"
    const then = addBlock builder, "then", at: None
    const otherwise = addBlock builder, "else", at: None
    terminate builder, Terminator.Branch(Slot(0), then, otherwise)
    terminateBlock builder, then, Terminator.Return(borrowed(Slot(1)))
    terminateBlock builder, otherwise, Terminator.Return(borrowed(Slot(2)))
    finishProgram program
    const counted = countedSlotsOf program, builder.function
    const live = livenessOf program, builder.function, counted
    assert(shownSlots(counted) == "%1 %2")
    assert(shownSet(counted, live.liveIn[0]) == "%1 %2")
    assert(shownSet(counted, live.liveOut[0]) == "%1 %2")
    assert(shownSet(counted, live.liveIn[1]) == "%1")
    assert(shownSet(counted, live.liveIn[2]) == "%2")
  }

  /**
   * The back edge is what makes a value the body uses live at the head of the loop, and that is why the value is
   * neither moved nor released inside it. No rule about loops is written anywhere: the fixpoint answers it, and it
   * settles in one round more than the loop nests deep.
   */
  test "a loop: the back edge keeps a value the body uses live at the head" {
    var program = IrProgram()
    const text = textType program
    const int64 = program.internType IrType.Integer(64, isSigned: true)
    const boolean = program.internType IrType.Boolean
    const signature = IrSignature([IrParameter("text", text, false, Ownership.Owned)], int64)
    var builder = newFunction "t_loop", None, signature, "body"
    const total = addLocal builder, int64, "total"
    const condition = addTemporary builder, boolean
    const length = addTemporary builder, int64
    const head = addBlock builder, "while", at: None
    const body = addBlock builder, "body", at: None
    const done = addBlock builder, "done", at: None
    terminate builder, Terminator.Jump(head)
    terminateBlock builder, head, Terminator.Branch(condition, body, done)
    switchTo builder, body
    const at = someLocation program
    emit builder, Instruction.Intrinsic(length, textByteLength(), [Slot(0)], at)
    terminate builder, Terminator.Jump(head)
    terminateBlock builder, done, Terminator.Return(borrowed(total))
    finishProgram program
    const counted = countedSlotsOf program, builder.function
    const live = livenessOf program, builder.function, counted
    assert(shownSlots(counted) == "%0")
    assert(shownSet(counted, live.liveIn[1]) == "%0")
    assert(shownSet(counted, live.liveOut[1]) == "%0")
    assert(shownSet(counted, live.liveIn[2]) == "%0")
    // Dead on the way out of the loop: that difference is the release the ownership pass puts on the edge
    assert(shownSet(counted, live.liveIn[3]) == "-")
    // One loop, so two rounds change something and the third one does not
    assert(live.rounds <= 3)
  }

  test "a value that is defined before it is used in the same block is not live above it" {
    var program = IrProgram()
    const text = textType program
    const signature = IrSignature([IrParameter("text", text, false, Ownership.Borrowed)], text)
    var builder = newFunction "t_made", None, signature, "body"
    const made = addTemporary builder, text
    emit builder, Instruction.Copy(made, Slot(0))
    terminate builder, Terminator.Return(borrowed(made))
    finishProgram program
    const counted = countedSlotsOf program, builder.function
    const live = livenessOf program, builder.function, counted
    // The parameter is borrowed, so the frame counts only what it made itself
    assert(shownSlots(counted) == "%1")
    assert(shownSet(counted, live.liveIn[0]) == "-")
  }
}
