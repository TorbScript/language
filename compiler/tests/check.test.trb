/**
 * The projects of these tests only exist in memory: `check` is a pure function of a `SourceTree`, so nothing here
 * needs a fixture on disk. Every file a test does not bring comes from `workspace`.
 */

use test, group from "std/test"
use Span from "../src/syntax/source"
use SourceTree from "../src/project/source-tree"
use check from "../src/semantics/check"
use counted from "../src/cli/render"

const workspace = [
  "project.trb": r"""
    name "acme/all"
    workspace { members "std/*", "app", "other" }
    """,
  "std/prelude/project.trb": r"""
    name "std/prelude"
    """,
  "std/prelude/src/types.trb": r"""
    public type Int {}
    public type Text {}
    public type Bool {}
    public type List<Item> {}
    public trait Show {}
    public type Option<Value> {
      case Some(value: Value)
      case None
    }
    """,
  "std/prelude/src/lib.trb": r"""
    public use Int, Text, Bool, List, Show, Option from "./types"
    public use Option.Some, Option.None from "./types"
    """,
  "app/project.trb": r"""
    name "acme/app"
    """,
  "other/project.trb": r"""
    name "acme/other"
    """,
  "other/src/lib.trb": r"""
    public type Thing {}
    """,
]

fn workspaceWith(files: Map<String, String>): SourceTree {
  var all = workspace
  for (path, text) in files {
    all.set path, text
  }
  SourceTree.of all
}

/** Everything that is wrong in `app`, in the order the compiler reports it. */
fn messages(files: Map<String, String>): List<String> {
  var found: List<String> = []
  for file in check(workspaceWith(files), ["app"]).files {
    for diagnostic in file.diagnostics {
      found.append diagnostic.message
    }
  }
  found
}

/** The source as the only file of `app`. */
fn problems(source: String): List<String> {
  messages(["app/src/main.trb": source])
}

/** The notes of the first problem of `app`. */
fn notes(files: Map<String, String>): List<String> {
  for file in check(workspaceWith(files), ["app"]).files {
    if const Some(first) = file.diagnostics.first() {
      return first.notes
    }
  }
  []
}

group "Modules" {
  test "a relative import brings the public names of the file next to it" {
    assert(
      messages([
        "app/src/helper.trb": r"""
          public type Helper {
            value: Int
          }
          type Hidden {}
          """,
        "app/src/main.trb": r"""
          use Helper from "./helper"

          fn take(helper: Helper): Int {
            helper.value
          }
          """,
      ]).isEmpty()
    )
  }

  test "a module that is not there" {
    assert(problems("use Helper from \"./helper\"") == ["There is no module `./helper`"])
  }

  test "a package that is not there" {
    assert(problems("use Client from \"acme/http\"") == ["There is no package `acme/http`"])
  }

  test "a package of the workspace that the project did not ask for" {
    assert(
      problems("use Thing from \"acme/other\"") == ["The package `acme/other` is not a dependency of `acme/app`"]
    )
  }

  test "a dependency in project.trb makes it importable" {
    assert(
      messages([
        "app/project.trb": r"""
          name "acme/app"
          dependencies { runtime "acme/other" }
          """,
        "app/src/main.trb": r"""
          use Thing from "acme/other"

          fn take(thing: Thing) {}
          """,
      ]).isEmpty()
    )
  }

  test "the standard library needs no entry in dependencies" {
    assert messages(["app/src/main.trb": "use Int from \"std/prelude\""]).isEmpty()
  }

  test "a module of a package is `src/<path>.trb` of it" {
    assert(
      problems("use Thing from \"std/prelude/deep/nested\"")
        == ["The package `std/prelude` has no module `std/prelude/deep/nested`"]
    )
  }

  test "a name the module does not export, and why" {
    const files = [
      "app/src/helper.trb": r"type Hidden {}",
      "app/src/main.trb": "use Hidden, Missing from \"./helper\"",
    ]
    assert(messages(files) == ["`Hidden` is not exported by `./helper`", "`Missing` is not exported by `./helper`"])
    assert(notes(files) == ["It is declared there, but not `public`"])
  }

  test "imports may be cyclic: nothing runs when a module is imported" {
    assert(
      messages([
        "app/src/first.trb": r"""
          use Second from "./second"

          public type First {
            next: Second
          }
          """,
        "app/src/second.trb": r"""
          use First from "./first"

          public type Second {
            previous: First?
          }
          """,
      ]).isEmpty()
    )
  }

  test "re-exports form chains" {
    assert(
      messages([
        "app/src/deep.trb": r"public type Deep {}",
        "app/src/middle.trb": "public use Deep from \"./deep\"",
        "app/src/surface.trb": "public use Deep from \"./middle\"",
        "app/src/main.trb": r"""
          use Deep from "./surface"

          fn take(value: Deep) {}
          """,
      ]).isEmpty()
    )
  }

  test "a namespace import is a name for the module" {
    assert(
      messages([
        "app/src/shapes.trb": r"public type Circle {}",
        "app/src/main.trb": r"""
          use * as shapes from "./shapes"

          fn take(shape: shapes.Circle) {}
          """,
      ]).isEmpty()
    )
  }

  test "a name that the module behind a namespace does not export" {
    assert(
      messages([
        "app/src/shapes.trb": r"public type Circle {}",
        "app/src/main.trb": r"""
          use * as shapes from "./shapes"

          fn take(shape: shapes.Square) {}
          """,
      ]) == ["`Square` is not exported by the module `shapes`"]
    )
  }

  test "a `use` without names is gone: nothing runs at an import, so it would mean nothing" {
    const files = ["app/src/extra.trb": r"extend Int {}", "app/src/main.trb": "use \"./extra\""]
    assert(messages(files) == ["A `use` names what it imports"])
  }

  test "a member of a foreign type is imported by its path, and `as` renames it" {
    const extension = "extend Text \{\n  fn shout(): Text \{\n    self\n  \}\n\}"
    const named = [
      "app/src/text.trb": extension,
      "app/src/main.trb": "use Text.shout from \"./text\"\n\nfn probe(value: Text): Text \{\n  value.shout()\n\}",
    ]
    assert messages(named).isEmpty()
    const renamed = [
      "app/src/text.trb": extension,
      "app/src/main.trb": "use Text.shout as yell from \"./text\"\n\nfn probe(value: Text): Text \{\n  value.yell()\n\}",
    ]
    assert messages(renamed).isEmpty()
  }

  test "an import of a member the package does not add is reported at the `use` line" {
    const files = [
      "app/src/text.trb": "extend Text \{\n  fn shout(): Text \{\n    self\n  \}\n\}",
      "app/src/main.trb": "use Text.whisper from \"./text\"\n",
    ]
    assert(messages(files) == ["`./text` adds no member `whisper` to `Text`"])
    assert(
      notes(files)
        == ["A path in a `use` names a case of a type or a member an `extend` of that package adds to it"]
    )
  }
}

group "Aliases of an import" {
  test "`as` gives the import a local name, and the exported one is gone" {
    const files = [
      "app/src/helper.trb": r"public type Helper {}",
      "app/src/main.trb": r"""
        use Helper as Assistant from "./helper"

        fn take(value: Assistant) {}
        """,
    ]
    assert messages(files).isEmpty()
    assert(
      messages([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/main.trb": r"""
          use Helper as Assistant from "./helper"

          fn take(value: Helper) {}
          """,
      ]) == ["Unknown type `Helper`"]
    )
  }

  test "a `public use` re-exports under the alias" {
    assert(
      messages([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/middle.trb": "public use Helper as Assistant from \"./helper\"",
        "app/src/main.trb": r"""
          use Assistant from "./middle"

          fn take(value: Assistant) {}
          """,
      ]).isEmpty()
    )
  }

  test "a case is aliased the same way" {
    assert(
      problems(
        r"""
          use Option.Some as Just, Option.None

          fn take(value: Option<Int>) {}
          """
      ).isEmpty()
    )
  }


  test "the message about what a module does not export names the export, not the alias" {
    assert(
      messages([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/main.trb": "use Missing as Present from \"./helper\"",
      ]) == ["`Missing` is not exported by `./helper`"]
    )
    assert(problems("use Option.Maybe as Perhaps") == ["`Option` has no case `Maybe`"])
  }

  test "duplicates are about the local name" {
    // Two aliases of one export are two names, so neither is a duplicate
    assert(
      messages([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/main.trb": "use Helper as First from \"./helper\"\nuse Helper as Second from \"./helper\"",
      ]).isEmpty()
    )
    assert(
      messages([
        "app/src/helper.trb": r"""
          public type Helper {}
          public type Other {}
          """,
        "app/src/main.trb": "use Helper as Same from \"./helper\"\nuse Other as Same from \"./helper\"",
      ]) == ["`Same` is already imported"]
    )
    assert(
      messages([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/main.trb": "type Taken \{\}\nuse Helper as Taken from \"./helper\"",
      ]) == ["`Taken` is already declared in this file"]
    )
  }

  test "the alias is what a did-you-mean note offers" {
    assert(
      messages([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/main.trb": r"""
          use Helper as Assistant from "./helper"

          fn take(value: Assistent) {}
          """,
      ]) == ["Unknown type `Assistent`"]
    )
    assert(
      notes([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/main.trb": r"""
          use Helper as Assistant from "./helper"

          fn take(value: Assistent) {}
          """,
      ]) == ["Did you mean `Assistant`?"]
    )
  }
}

group "Constants of a module" {
  test "a `public const` is exported, a plain one is private to its file" {
    assert(
      messages([
        "app/src/limits.trb": r"""
          public const highest = 100
          const secret = 1
          """,
        "app/src/main.trb": r"""
          use highest from "./limits"

          fn take(value: Int): Int {
            value
          }
          """,
      ]).isEmpty()
    )
    const files = [
      "app/src/limits.trb": "public const highest = 100\nconst secret = 1",
      "app/src/main.trb": "use highest, secret from \"./limits\"",
    ]
    assert(messages(files) == ["`secret` is not exported by `./limits`"])
    assert(notes(files) == ["It is declared there, but not `public`"])
  }
}

group "Names of a file" {
  test "the same name twice" {
    assert(
      problems(
        r"""
          fn point() {}
          const point = 1
          """
      ) == ["`point` is already declared in this file"]
    )
  }

  test "the same name imported twice" {
    assert(
      messages([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/main.trb": "use Helper from \"./helper\"\nuse Helper from \"./helper\"",
      ]) == ["`Helper` is already imported"]
    )
  }

  test "an import cannot bring in a name the file declares itself" {
    assert(
      messages([
        "app/src/helper.trb": r"public type Helper {}",
        "app/src/main.trb": r"""
          type Helper {}
          use Helper from "./helper"
          """,
      ]) == ["`Helper` is already declared in this file"]
    )
  }

  test "a declaration of the file shadows the prelude" {
    assert(
      problems(
        r"""
          type Int {}

          fn take(value: Int): Int {
            value
          }
          """
      ).isEmpty()
    )
  }

  test "a file with a syntax error still contributes its symbols" {
    const found = messages([
      "app/src/helper.trb": r"""
        public type Helper {}
        fn broken( {
        """,
      "app/src/main.trb": r"""
        use Helper from "./helper"

        fn take(value: Helper) {}
        """,
    ])
    assert(!found.contains("`Helper` is not exported by `./helper`"))
    assert found.isNotEmpty()
  }
}

group "Cases" {
  test "a case is imported through the type it belongs to" {
    assert(
      messages([
        "app/src/shapes.trb": r"""
          public type Shape {
            case Circle(radius: Int)
            case Empty
          }
          """,
        "app/src/main.trb": r"""
          use Shape, Shape.Circle, Shape.Empty from "./shapes"

          fn take(shape: Shape): Shape { Circle(1) }
          """,
      ]).isEmpty()
    )
  }

  test "without `from` the path is resolved in the file's own scope" {
    // What a file that declares the type itself writes, and what a name the prelude brings takes as well
    assert(
      problems(
        r"""
          use Option.Some, Option.None

          fn take(value: Option<Int>) {}
          """
      ).isEmpty()
    )
    assert(
      problems(
        r"""
          type Shape {
            case Circle(radius: Int)
          }
          use Shape.Circle

          fn take(shape: Shape): Shape { Circle(1) }
          """
      ).isEmpty()
    )
    assert(problems("use Shapes.Circle") == ["Unknown name `Shapes`"])
  }

  test "a case the type does not have" {
    assert(problems("use Option.Maybe") == ["`Option` has no case `Maybe`"])
  }

  test "only a case can be imported from a type" {
    var files = [
      "app/src/shapes.trb": r"""
        public type Shape {
          case Circle(radius: Int)

          fn area(): Int { 0 }
        }
        public type Point {
          x: Int
          static origin: Int = 0
        }
        """,
      "app/src/main.trb": "use Shape.area from \"./shapes\"",
    ]
    assert(messages(files) == ["Only a case can be imported from a type: `area` is a method of `Shape`"])
    files.set "app/src/main.trb", "use Point.x from \"./shapes\""
    assert(messages(files) == ["Only a case can be imported from a type: `x` is a field of `Point`"])
    files.set "app/src/main.trb", "use Point.origin from \"./shapes\""
    assert(messages(files) == ["Only a case can be imported from a type: `origin` is a constant of `Point`"])
  }

  test "the type may be named through a namespace import" {
    var files = [
      "app/src/shapes.trb": r"""
        public type Shape {
          case Circle(radius: Int)
        }
        """,
      "app/src/main.trb": r"""
        use * as shapes from "./shapes"
        use shapes.Shape.Circle

        fn take(shape: shapes.Shape) {}
        """,
    ]
    assert messages(files).isEmpty()
    files.set "app/src/main.trb", "use * as shapes from \"./shapes\"\nuse shapes.Shape.Square"
    assert(messages(files) == ["`Shape` has no case `Square`"])
    files.set "app/src/main.trb", "use * as shapes from \"./shapes\"\nuse shapes.Missing.Circle"
    assert(messages(files) == ["`Missing` is not exported by `shapes`"])
  }

  test "only a type has cases" {
    assert(
      problems(
        r"""
          fn maker() {}
          use maker.Case
          """
      ) == ["the function `maker` has no cases"]
    )
    assert(
      notes(["app/src/main.trb": "fn maker() \{\}\nuse maker.Case"])
        == ["A path in a `use` names a case of a type: `use Shape.Circle from \"./shape\"`"]
    )
  }

  test "a case is not a type" {
    assert(
      problems(
        r"""
          use Option.Some

          fn take(value: Some) {}
          """
      ) == ["`Some` is a case of `Option`, not a type"]
    )
  }
}

group "Type positions" {
  test "an unknown name, with the name it was probably meant to be" {
    assert(problems(r"fn take(value: Itn) {}") == ["Unknown type `Itn`"])
    assert(notes(["app/src/main.trb": r"fn take(value: Itn) {}"]) == ["Did you mean `Int`?"])
  }

  test "a function is not a type" {
    assert(
      problems(
        r"""
          fn helper() {}

          fn take(value: helper) {}
          """
      ) == ["`helper` is a function, not a type"]
    )
  }

  test "a module is not a type" {
    assert(
      messages([
        "app/src/shapes.trb": r"public type Circle {}",
        "app/src/main.trb": r"""
          use * as shapes from "./shapes"

          fn take(value: shapes) {}
          """,
      ]) == ["`shapes` is a module, not a type"]
    )
  }

  test "generic parameters are in scope in the whole declaration" {
    assert(
      problems(
        r"""
          type Pair<Key, Value = Key> {
            key: Key
            value: Value

            fn mapped<Output>(transform: (value: Value) => Output): Pair<Key, Output> where Output: Show {
              Pair(key, transform(value))
            }
          }
          """
      ).isEmpty()
    )
  }

  test "`Self` is the type, the trait, or the target of an extension" {
    assert(
      problems(
        r"""
          trait Combine {
            fn combine(other: Self): Self
          }

          type Amount with Combine {
            value: Int

            fn combine(other: Self): Self {
              Amount(value)
            }
          }

          extend Int with Combine {
            fn combine(other: Self): Self {
              self
            }
          }
          """
      ).isEmpty()
    )
  }

  test "`Self` needs something around it" {
    assert(
      problems(r"fn take(value: Self) {}") == ["`Self` is only available inside of a type, a trait or an `extend`"]
    )
  }

  test "every type position is walked, also inside of bodies" {
    assert(
      problems(
        r"""
          fn take() {
            const value: Missing1 = 0
            const closure = { parameter: Missing2 => parameter }
            const made = List<Missing3>()
            type Local = Missing4
            fn nested(value: Missing5) {}
          }
          """
      )
        == [
          "Unknown type `Missing1`",
          "Unknown type `Missing2`",
          "Unknown type `Missing3`",
          "Unknown type `Missing4`",
          "Unknown type `Missing5`",
        ]
    )
  }

  test "a declaration inside of a block is a name of that block" {
    assert(
      problems(
        r"""
          fn take() {
            type Local {
              value: Int
            }
            const made: Local = Local(1)
          }
          """
      ).isEmpty()
    )
  }

  test "`Void` and `Never` are names of the language, not of the prelude" {
    assert(
      problems(
        r"""
          fn take(): Void {}

          fn stop(): Never {
            stop()
          }
          """
      ).isEmpty()
    )
  }

  test "cases, fields, aliases, bounds and trait lists" {
    assert(
      problems(
        r"""
          type Shape with Missing1 {
            case Circle(radius: Missing2)
            field: Missing3 = 0
          }

          type Alias<Item: Missing4> = List<Missing5>
          """
      )
        == [
          "Unknown type `Missing1`",
          "Unknown type `Missing2`",
          "Unknown type `Missing3`",
          "Unknown type `Missing4`",
          "Unknown type `Missing5`",
        ]
    )
  }
}

group "Tables" {
  test "what a name in a type position resolved to is kept by module and span" {
    // `type First = Int` is 16 bytes, so the two `Int` are at 13..16 and 31..34
    const source = "type First = Int\ntype Second = Int"
    const checked = check workspaceWith(["app/src/main.trb": source]), ["app"]
    const module = checked.program.graph.moduleAt("app/src/main.trb").expect("the module of the file")
    const resolved = checked.resolutions[module.value]
    const symbol = resolved.get(Span(13, 16)).expect("the symbol the first alias names")
    assert(checked.program.symbols.at(symbol).name == "Int")
    // The same declaration, however often it is named
    assert(resolved.get(Span(31, 34)) == Some(symbol))
    assert resolved.get(Span(0, 4)).isNone()
  }
}

/** A `fn` is not a closure, so the files it reads are a constant of the file and not one of the group. */
const teaching = [
  "project.trb": r"""
    name "acme/all"
    workspace { members "std/*", "app", "other", "teaching" }
    """,
  "teaching/project.trb": "name \"acme/teaching\"",
  "teaching/src/lib.trb": r"public type Number {}",
  "app/project.trb": r"""
    name "acme/app"
    prelude "acme/teaching"
    """,
]

group "Preludes" {
  fn withTeaching(main: String): List<String> {
    var files = teaching
    files.set "app/src/main.trb", main
    messages files
  }

  test "a project can name another prelude" {
    assert withTeaching(r"fn take(value: Number) {}").isEmpty()
  }

  test "with another prelude, the names of the default one are gone" {
    assert(withTeaching(r"fn take(value: Int) {}") == ["Unknown type `Int`"])
  }

  test "a prelude package that is not there is a problem of the project" {
    const checked = check(
      workspaceWith([
        "app/project.trb": "name \"acme/app\"\nprelude \"acme/nothing\"",
        "app/src/main.trb": r"fn take() {}",
      ]),
      ["app"]
    )
    assert(checked.problems == ["The prelude package `acme/nothing` of app was not found"])
  }
}

group "The summary line" {
  test "a count of one takes the singular, every other count the plural" {
    assert(counted(1, "problem") == "1 problem")
    assert(counted(2, "problem") == "2 problems")
    assert(counted(0, "file") == "0 files")
  }
}
