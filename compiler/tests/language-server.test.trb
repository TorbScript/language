/**
 * `torb lsp` without its transport: scripted sessions of JSON-RPC messages fed to [LanguageServer.receive] over a
 * workspace in memory, and the answers compared - the life cycle, the diagnostics of a change and of what imports it,
 * hover, go to definition, completion, semantic tokens and the quick fixes of the lint rules. The framing of the base
 * protocol, the positions in UTF-16 and the translation of URIs are tested on their own.
 *
 * A session over standard input and output is `tests/lsp/`, run by `tools/lsp.sh`.
 */

use test, group from "std/test"
use JsonValue from "std/json"
use workspaceWith from "./harness"
use LanguageServer from "../src/language-server/server"
use encoded, decoded, memberAt, textAt, integerAt, itemsAt from "../src/language-server/json"
use FrameReader, framed from "../src/language-server/protocol"
use LineMap, Position from "../src/language-server/position"
use Locations, absolutePathOf, fileUriOf from "../src/language-server/uri"
use completionContextOf, CompletionContext, withoutMemberAccess from "../src/language-server/completion"
use outlineOf from "../src/language-server/analysis"
use SpanMapping, mappingBetween from "../src/language-server/mapping"
use LineEdit, lineEditsBetween from "../src/language-server/formatting"
use TestItem, testItemsOf, testTreeOf from "../src/language-server/test-tree"
use Span, SourceText from "../src/syntax/source"
use parse from "../src/syntax/parser/parser"

const root = "file:///workspace"
const mainUri = "file:///workspace/app/src/main.trb"

const initialize = raw"""{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"rootUri":"file:///workspace","capabilities":{}}}"""

/** A server over the workspace of the harness plus `files`, initialized. */
fn started(files: Map<String, String> = [:]): LanguageServer {
  var server = LanguageServer.over workspaceWith(files), root
  const _answers = send server, [initialize]
  server
}

/** One batch of messages, and what the server sends for it. */
fn send(var server: LanguageServer, messages: List<String>): List<JsonValue> {
  server.receive messages
}

/** A JSON text for a message, from its method, its parameters and, for a request, its id. */
fn message(method: String, parameters: String, id: Int? = None): String {
  match id {
    Some(number) => "\{\"jsonrpc\":\"2.0\",\"id\":{number},\"method\":\"{method}\",\"params\":{parameters}\}"
    None => "\{\"jsonrpc\":\"2.0\",\"method\":\"{method}\",\"params\":{parameters}\}"
  }
}

/** The JSON text of a string, quoted and escaped, for a document's text inside of a message. */
fn quoted(text: String): String {
  encoded JsonValue.String(text)
}

fn opened(uri: String, text: String): String {
  message(
    "textDocument/didOpen",
    "\{\"textDocument\":\{\"uri\":\"{uri}\",\"languageId\":\"trb\",\"version\":1,\"text\":{quoted(text)}\}\}",
  )
}

fn replaced(uri: String, version: Int, text: String): String {
  const change = "\{\"text\":{quoted(text)}\}"
  message(
    "textDocument/didChange",
    "\{\"textDocument\":\{\"uri\":\"{uri}\",\"version\":{version}\},\"contentChanges\":[{change}]\}",
  )
}

fn at(method: String, id: Int, uri: String, line: Int, character: Int): String {
  const position = "\"position\":\{\"line\":{line},\"character\":{character}\}"
  message method, "\{\"textDocument\":\{\"uri\":\"{uri}\"\},{position}\}", id
}

/** The messages the server sent for these, each as its JSON text. */
fn sent(var server: LanguageServer, messages: List<String>): List<String> {
  server.receive(messages).map(encoded).toList()
}

/** The one message the server sent for these. */
fn only(var server: LanguageServer, messages: List<String>): JsonValue {
  const answers = server.receive messages
  if answers.length() != 1 {
    print "expected one message, got {answers.map(encoded).toList()}"
  }
  assert(answers.length() == 1)
  answers[0]
}

/** The messages of `textDocument/publishDiagnostics` among these, by the URI they are about. */
fn published(answers: List<JsonValue>): Map<String, List<JsonValue>> {
  var found: Map<String, List<JsonValue>> = [:]
  for answer in answers {
    if textAt(answer, ["method"]) == "textDocument/publishDiagnostics" {
      found.set(textAt(answer, ["params", "uri"]) ?? "", itemsAt(answer, ["params", "diagnostics"]))
    }
  }
  found
}

fn messagesOf(diagnostics: List<JsonValue>): List<String> {
  diagnostics.map({ textAt(_, ["message"]) ?? "" }).toList()
}

/** What the reader hands out next, as a text a test compares. */
fn nextOf(var reader: FrameReader): String {
  match reader.next() {
    Ok(Some(body)) => body
    Ok(None) => "nothing yet"
    Fail(problem) => "a problem: {problem.message}"
  }
}

fn expectText(actual: String, expected: String) {
  if actual != expected {
    print "expected:\n{expected}\nactual:\n{actual}"
  }
  assert(actual == expected)
}

fn expectContains(actual: String, part: String) {
  if !actual.contains(part) {
    print "expected to find:\n{part}\nin:\n{actual}"
  }
  assert actual.contains(part)
}

group "The base protocol" {
  test "a message split across chunks is handed out once it is whole" {
    var reader = FrameReader.empty()
    const whole = framed "\{\"jsonrpc\":\"2.0\",\"method\":\"exit\"\}"
    const bytes: List<UInt8> = whole.bytes()
    reader.add bytes[0..10].toList()
    expectText nextOf(reader), "nothing yet"
    reader.add bytes[10..bytes.length()].toList()
    expectText nextOf(reader), "\{\"jsonrpc\":\"2.0\",\"method\":\"exit\"\}"
    expectText nextOf(reader), "nothing yet"
  }

  test "two messages in one chunk, the length counted in bytes" {
    var reader = FrameReader.empty()
    const first = "\{\"text\":\"Grüße\"\}"
    const both = framed(first) + framed("[]")
    reader.add both.bytes()
    expectText nextOf(reader), first
    expectText nextOf(reader), "[]"
    const pending = reader.isPending()
    assert(!pending)
  }

  test "a header without a length is dropped, and the message after it read" {
    var reader = FrameReader.empty()
    const both = "Content-Type: x\r\n\r\n" + framed("1")
    reader.add both.bytes()
    expectText nextOf(reader), "a problem: a header without a `Content-Length`: Content-Type: x"
    expectText nextOf(reader), "1"
  }

  test "a message goes out with the length of its body in bytes" {
    assert(framed("ä") == "Content-Length: 2\r\n\r\nä")
  }
}

group "Positions" {
  test "a character counts UTF-16 code units, and a line is 0-based" {
    const lines = LineMap.of "ab\n😀x\r\nz"
    assert(lines.positionOf(0) == Position(0, 0))
    assert(lines.positionOf(3) == Position(1, 0))
    // The emoji is four bytes and two code units
    assert(lines.positionOf(7) == Position(1, 2))
    assert(lines.offsetOf(Position(1, 2)) == 7)
    assert(lines.offsetOf(Position(2, 0)) == 10)
  }

  test "a position past the end of its line is the end of the line, and a line past the last the end" {
    const lines = LineMap.of "ab\r\ncd"
    assert(lines.offsetOf(Position(0, 9)) == 2)
    assert(lines.offsetOf(Position(7, 0)) == 6)
  }
}

group "URIs" {
  test "a URI of a drive becomes the path `File.absolutePath` spells" {
    assert(absolutePathOf("file:///c%3A/Projekte/a%20b.trb") == "C:/Projekte/a b.trb")
    assert(absolutePathOf("file:///home/ada/main.trb") == "/home/ada/main.trb")
    assert(absolutePathOf("untitled:Untitled-1") == None)
  }

  test "below the root a URI keeps the spelling of the root the client sent" {
    const locations = Locations.of "file:///c%3A/work", "C:/work"
    assert(locations.pathOf("file:///c%3A/work/src/main.trb") == "C:/work/src/main.trb")
    assert(locations.uriOf("C:/work/src/main.trb") == "file:///c%3A/work/src/main.trb")
    assert(locations.uriOf("C:/std/lib.trb") == "file:///C%3A/std/lib.trb")
    assert(fileUriOf("/home/a b/x.trb") == "file:///home/a%20b/x.trb")
  }
}

group "The life cycle" {
  test "a request before `initialize` is refused" {
    var server = LanguageServer.over workspaceWith([:]), root
    const answer = only server, [message("textDocument/hover", "\{\}", 7)]
    assert(integerAt(answer, ["error", "code"]) == (-32002))
    assert(integerAt(answer, ["id"]) == 7)
  }

  test "`initialize` says what the server does" {
    var server = LanguageServer.over workspaceWith([:]), root
    const answer = encoded only(server, [initialize])
    expectContains answer, "\"textDocumentSync\":\{\"openClose\":true,\"change\":2\}"
    expectContains answer, "\"hoverProvider\":true,\"definitionProvider\":true"
    expectContains answer, "\"completionProvider\":\{\"triggerCharacters\":[\".\"],\"resolveProvider\":true\}"
    expectContains answer, "\"signatureHelpProvider\":\{\"triggerCharacters\":[\"(\",\",\"]\}"
    expectContains answer, "\"referencesProvider\":true,\"renameProvider\":\{\"prepareProvider\":true\}"
    expectContains answer, "\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true"
    expectContains answer, "\"documentFormattingProvider\":true,\"documentRangeFormattingProvider\":true"
    expectContains answer, "\"tokenTypes\":[\"type\",\"interface\",\"typeParameter\",\"enumMember\",\"namespace\""
    expectContains answer, "\"codeActionProvider\":\{\"codeActionKinds\":[\"quickfix\"]\}"
  }

  test "`shutdown`, then `exit`, ends with 0" {
    var server = started()
    const answers = sent server, [message("shutdown", "null", 2)]
    assert(answers == ["\{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null\}"])
    const running = !server.hasExited()
    assert running
    const afterExit = sent server, [message("exit", "null")]
    assert afterExit.isEmpty()
    const code = server.exitCode()
    assert(code == 0)
  }

  test "`exit` without `shutdown` ends with 1, and nothing after it is read" {
    var server = started()
    const answers = sent server, [message("exit", "null"), message("shutdown", "null", 3)]
    assert answers.isEmpty()
    const code = server.exitCode()
    assert(code == 1)
  }

  test "a request the server does not know is answered with an error" {
    var server = started()
    const answer = only server, [message("textDocument/moniker", "\{\}", 4)]
    assert(integerAt(answer, ["error", "code"]) == (-32601))
  }

  test "a message that is not JSON is answered with a parse error" {
    var server = started()
    const answer = only server, ["\{nope"]
    assert(integerAt(answer, ["error", "code"]) == (-32700))
  }
}

group "Diagnostics" {
  test "an opened document is checked, and its problems published with their ranges" {
    var server = started()
    const answers = send server, [opened(mainUri, "const total: Int = \"no\"\nprint total\n")]
    const diagnostics = published(answers).get(mainUri) ?? []
    assert(messagesOf(diagnostics) == ["Expected `Int64`, found `String`"])
    expectText(
      encoded(memberAt(diagnostics[0], ["range"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":0,\"character\":19\},\"end\":\{\"line\":0,\"character\":23\}\}",
    )
    assert(integerAt(diagnostics[0], ["severity"]) == 1)
  }

  test "a change that fixes the problem publishes no diagnostics" {
    var server = started()
    const _first = send server, [opened(mainUri, "const total: Int = \"no\"\nprint total\n")]
    const answers = send server, [replaced(mainUri, 2, "const total: Int = 1\nprint total\n")]
    assert(published(answers).get(mainUri) == [])
  }

  test "the changes of one batch are checked once" {
    var server = started()
    const _first = send server, [opened(mainUri, "print 1\n")]
    const answers = send(server, [
      replaced(mainUri, 2, "print 2\n"),
      replaced(mainUri, 3, "print \"three\" + 1\n"),
      replaced(mainUri, 4, "print 4\n"),
    ])
    assert(answers.length() == 1)
    assert(published(answers).get(mainUri) == [])
  }

  test "a change of a module checks the open document that imports it" {
    const helperUri = "file:///workspace/app/src/helper.trb"
    const helper = "public fn double(value: Int): Int \{\n  value * 2\n\}\n"
    const main = "use double from \"./helper\"\n\nprint double(21)\n"
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": main])
    const _first = send server, [opened(mainUri, main), opened(helperUri, helper)]
    const answers = send server, [replaced(helperUri, 2, "public fn double(value: String): String \{\n  value\n\}\n")]
    const found = published answers
    assert(found.get(helperUri) == [])
    assert(messagesOf(found.get(mainUri) ?? []) == ["Expected `String`, found `Int64`"])
  }

  test "a closed document has its diagnostics cleared" {
    var server = started()
    const _first = send server, [opened(mainUri, "print missing\n")]
    const closing = message "textDocument/didClose", "\{\"textDocument\":\{\"uri\":\"{mainUri}\"\}\}"
    const answers = send server, [closing]
    assert(published(answers).get(mainUri) == [])
  }

  test "the findings of the lint rules are hints that name their rule" {
    var server = started()
    const source = "type Point \{\n  x: Int\n\n  static fn origin(): Point \{\n    Point(0)\n  \}\n\}\n\nprint Point.origin()\n"
    const diagnostics = published(server.receive([opened(mainUri, source)])).get(mainUri) ?? []
    assert(diagnostics.length() == 2)
    assert(integerAt(diagnostics[0], ["severity"]) == 4)
    assert(textAt(diagnostics[0], ["code"]) == "self-name")
    assert(textAt(diagnostics[0], ["source"]) == "torb lint")
  }

  test "a use of a deprecated declaration is a warning with the tag an editor strikes it through for" {
    const helperUri = "file:///workspace/app/src/helper.trb"
    const helper = "deprecated(\"why\", replacement: \"fresh\")\npublic fn old(): Int \{\n  1\n\}\n\npublic fn fresh(): Int \{\n  2\n\}\n"
    const main = "use old from \"./helper\"\n\nprint old()\n"
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": main])
    const answers = send server, [opened(mainUri, main), opened(helperUri, helper)]
    const diagnostics = published(answers).get(mainUri) ?? []
    assert(messagesOf(diagnostics) == ["`old` is deprecated: why", "`old` is deprecated: why"])
    for diagnostic in diagnostics {
      assert(integerAt(diagnostic, ["severity"]) == 2)
      assert(textAt(diagnostic, ["code"]) == "deprecated")
      assert(textAt(diagnostic, ["source"]) == "torb")
      expectText encoded(memberAt(diagnostic, ["tags"]) ?? JsonValue.Null), "[2]"
    }
  }

  test "a use inside of a body that a keystroke checked again is still a warning, and one outside of it stays" {
    const helper = "deprecated(\"why\")\npublic fn old(): Int \{\n  1\n\}\n"
    const source = "use old from \"./helper\"\n\nfn one(): Int \{\n  old()\n\}\n\nfn two(): Int \{\n  old()\n\}\n\nprint one() + two()\n"
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": source])
    const first = send server, [opened(mainUri, source)]
    assert(messagesOf(published(first).get(mainUri) ?? []).length() == 2)
    const edited = source.replace(
      "fn one(): Int \{\n  old()\n",
      "fn one(): Int \{\n  const more = old()\n  more + old()\n",
    )
    const answers = send server, [replaced(mainUri, 2, edited)]
    const diagnostics = published(answers).get(mainUri) ?? []
    // The two uses in the changed body, from the check of that body, and the one in the body the keystroke left alone
    assert(messagesOf(diagnostics).length() == 3)
    for diagnostic in diagnostics {
      assert(textAt(diagnostic, ["code"]) == "deprecated")
    }
  }
}

group "A change redoes the front of its file" {
  test "the outline of a file is its declarations and imports, without positions" {
    const before = parse(SourceText.of("use Show from \"std/core\"\n\nfn run() \{\n  print 1\n\}\n")).file
    const moved = parse(SourceText.of("\n\nuse Show from \"std/core\"\n\nfn run() \{\n  print 2\n  print 3\n\}\n")).file
    const renamed = parse(SourceText.of("use Show from \"std/core\"\n\nfn walk() \{\n  print 1\n\}\n")).file
    const outline = outlineOf before
    assert(outline == ["use  Show from std/core", "fn  run"])
    assert(outlineOf(moved) == outline)
    assert(outlineOf(renamed) != outline)
  }

  test "what stands at a position moved by a change is found where it is now" {
    var server = started()
    const _first = send server, [opened(mainUri, "const total = 1\nprint total\n")]
    const _second = send server, [replaced(mainUri, 2, "// the sum\n\nconst total = 1\nprint total\n")]
    const answer = only server, [at("textDocument/definition", 20, mainUri, 3, 7)]
    expectText(
      encoded(memberAt(answer, ["result", "range"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":2,\"character\":6\},\"end\":\{\"line\":2,\"character\":11\}\}",
    )
  }

  test "a declaration added by a change is known to the file at once" {
    var server = started()
    const _first = send server, [opened(mainUri, "print 1\n")]
    const answers = send(
      server,
      [replaced(mainUri, 2, "fn double(value: Int): Int \{\n  value * 2\n\}\n\nprint double(1)\n")],
    )
    assert(published(answers).get(mainUri) == [])
    const answer = only server, [at("textDocument/hover", 21, mainUri, 4, 7)]
    expectText(textAt(answer, ["result", "contents", "value"]) ?? "", "```trb\nfn double(value: Int): Int\n```")
  }
}

/** The URIs of `app/` among what was published. */
fn appUris(found: Map<String, List<JsonValue>>): List<String> {
  found.keys().filter({ _.startsWith "file:///workspace/app/" }).toList()
}

/** `workspace/didChangeWatchedFiles` for one file: 1 created, 2 changed, 3 deleted. */
fn watched(uri: String, kind: Int): String {
  message "workspace/didChangeWatchedFiles", "\{\"changes\":[\{\"uri\":\"{uri}\",\"type\":{kind}\}]\}"
}

group "Diagnostics of the whole workspace" {
  const helperUri = "file:///workspace/app/src/helper.trb"
  const broken = "public fn value(): Int \{\n  \"no\"\n\}\n"
  const fixed = "public fn value(): Int \{\n  1\n\}\n"

  test "after `initialized` the files nobody opened are checked, and only those with a problem are published" {
    var server = started(["app/src/helper.trb": broken])
    const _initialized = send server, [message("initialized", "\{\}")]
    const answers = server.settle()
    const found = published answers
    assert(messagesOf(found.get(helperUri) ?? []) == ["Expected `Int64`, found `String`"])
    // The prelude of the tests is a small one of its own that does not check as a package: only `app/` counts here
    assert(appUris(found) == [helperUri])
  }

  test "a file that changes on disk is checked again, with every file that imports it" {
    const main = "use value from \"./helper\"\n\nconst total: Int = value()\nprint total\n"
    var server = started(["app/src/helper.trb": fixed, "app/src/main.trb": main])
    const _initialized = send server, [message("initialized", "\{\}")]
    const quiet = appUris(published(server.settle())).isEmpty()
    assert quiet
    server.writeMemoryFile "app/src/helper.trb", "public fn value(): String \{\n  \"no\"\n\}\n"
    const _changed = send server, [watched(helperUri, 2)]
    const found = published server.settle()
    assert(messagesOf(found.get(mainUri) ?? []) == ["Expected `Int64`, found `String`"])
  }

  test "an open document that imports a file that changed on disk is checked again" {
    const main = "use value from \"./helper\"\n\nconst total: Int = value()\nprint total\n"
    var server = started(["app/src/helper.trb": fixed, "app/src/main.trb": main])
    const _opened = send server, [opened(mainUri, main)]
    server.writeMemoryFile "app/src/helper.trb", "public fn value(): String \{\n  \"no\"\n\}\n"
    const answers = send server, [watched(helperUri, 2)]
    assert(messagesOf(published(answers).get(mainUri) ?? []) == ["Expected `Int64`, found `String`"])
  }

  test "a deleted file has its diagnostics cleared" {
    var server = started(["app/src/helper.trb": broken])
    const _initialized = send server, [message("initialized", "\{\}")]
    const _first = server.settle()
    server.writeMemoryFile "app/src/helper.trb", text: None
    const answers = send server, [watched(helperUri, 3)]
    assert(published(answers).get(helperUri) == [])
  }

  test "an open document is its view's, and closing it shows what the workspace found again" {
    var server = started(["app/src/helper.trb": broken])
    const _initialized = send server, [message("initialized", "\{\}")]
    const _first = server.settle()
    const _opened = send server, [opened(helperUri, fixed)]
    const closing = message "textDocument/didClose", "\{\"textDocument\":\{\"uri\":\"{helperUri}\"\}\}"
    const answers = send server, [closing]
    assert(messagesOf(published(answers).get(helperUri) ?? []) == ["Expected `Int64`, found `String`"])
  }

  test "turned off, the check clears what it published and checks nothing more" {
    var server = started(["app/src/helper.trb": broken])
    const _initialized = send server, [message("initialized", "\{\}")]
    const _first = server.settle()
    const settings = "\{\"settings\":\{\"torbscript\":\{\"languageServer\":\{\"workspaceDiagnostics\":false\}\}\}\}"
    const answers = send server, [message("workspace/didChangeConfiguration", settings)]
    assert(published(answers).get(helperUri) == [])
    server.writeMemoryFile "app/src/helper.trb", "public fn value(): Int \{\n  missing\n\}\n"
    const _changed = send server, [watched(helperUri, 2)]
    const idle = server.settle().isEmpty()
    assert idle
  }
}

/** The mapping between two texts of one file, parsed. */
fn mappingOf(before: String, after: String): SpanMapping? {
  mappingBetween parse(SourceText.of(before)).file, before, parse(SourceText.of(after)).file, after
}

/** The span of the first `written` in `text`. */
fn spanIn(text: String, written: String): Span {
  const start = text.byteOffsetOf(written) ?? -1
  Span(start, start + written.byteLength())
}

group "A keystroke in a body checks that body" {
  test "two texts that differ inside of one body: the body changed, everything else moved" {
    const before = "fn one(): Int \{\n  1\n\}\n\nfn two(): Int \{\n  2\n\}\n"
    const after = "fn one(): Int \{\n  1 + 10\n\}\n\nfn two(): Int \{\n  2\n\}\n"
    const mapping = mappingOf(before, after) ?? SpanMapping.identity(0)
    assert(mapping.changed.length() == 1)
    assert(mapping.changed[0].earlier == spanIn(before, "\{\n  1\n\}"))
    assert(mapping.changed[0].current == spanIn(after, "\{\n  1 + 10\n\}"))
    assert(mapping.changed[0].name == spanIn(after, "one"))
    assert(mapping.toCurrent(spanIn(before, "two")) == spanIn(after, "two"))
    assert(mapping.toEarlier(spanIn(after, "two")) == spanIn(before, "two"))
    // Inside of the changed body there is no counterpart; its borders are each other's
    assert(mapping.offsetToCurrent(spanIn(before, "1").start) == None)
    assert(mapping.toCurrent(mapping.changed[0].earlier) == mapping.changed[0].current)
    const inside = mapping.isChangedAt spanIn(after, "10").start
    assert inside
  }

  test "a function of a type whose body changed" {
    const before = "type Point \{\n  x: Int\n\n  fn doubled(): Int \{\n    x * 2\n  \}\n\}\n"
    const after = "type Point \{\n  x: Int\n\n  fn doubled(): Int \{\n    x + x\n  \}\n\}\n"
    const mapping = mappingOf(before, after) ?? SpanMapping.identity(0)
    assert(mapping.changed.length() == 1)
    assert(mapping.changed[0].name == spanIn(after, "doubled"))
    assert(mapping.toCurrent(spanIn(before, "x: Int")) == spanIn(after, "x: Int"))
  }

  test "a change of a signature, a field or a declaration has no mapping" {
    const before = "type Point \{\n  x: Int\n\}\n\nfn one(): Int \{\n  1\n\}\n"
    assert(mappingOf(before, "type Point \{\n  x: Int\n\}\n\nfn one(): Float \{\n  1\n\}\n") == None)
    assert(mappingOf(before, "type Point \{\n  y: Int\n\}\n\nfn one(): Int \{\n  1\n\}\n") == None)
    assert(mappingOf(before, "type Point \{\n  x: Int\n\}\n\nfn one(): Int \{\n  1\n\}\n\nfn two() \{\}\n") == None)
    // Comments and blank lines between declarations only move them
    const moved = mappingOf before, "// a point\n\ntype Point \{\n  x: Int\n\}\n\n\nfn one(): Int \{\n  1\n\}\n"
    assert(moved.map({ _.changed.isEmpty() }) == true)
  }

  test "a change inside of a body publishes what a check of the whole document finds" {
    var server = started()
    const source = "fn one(): Int \{\n  1\n\}\n\nfn two(): Int \{\n  2\n\}\n\nprint one() + two()\n"
    const _first = send server, [opened(mainUri, source)]
    const broken = "fn one(): Int \{\n  1\n\}\n\nfn two(): Int \{\n  \"two\"\n\}\n\nprint one() + two()\n"
    const answers = send server, [replaced(mainUri, 2, broken)]
    assert(messagesOf(published(answers).get(mainUri) ?? []) == ["Expected `Int64`, found `String`"])
  }

  test "a change inside of the body of a module's function keeps the check of every other body" {
    const helperUri = "file:///workspace/app/src/helper.trb"
    const helper = "public fn double(value: Int): Int \{\n  value * 2\n\}\n\npublic fn triple(value: Int): Int \{\n  value * 3\n\}\n"
    const main = "use double, triple from \"./helper\"\n\nprint double(21) + triple(1)\n"
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": main])
    const _first = send server, [opened(mainUri, main), opened(helperUri, helper)]
    const edited = "public fn double(value: Int): Int \{\n  value * 2 + missing\n\}\n\npublic fn triple(value: Int): Int \{\n  value * 3\n\}\n"
    const answers = send server, [replaced(helperUri, 2, edited)]
    const found = published answers
    // The body changed and the signature did not: the document that imports it is not checked again
    assert(found.get(mainUri) == None)
    assert(messagesOf(found.get(helperUri) ?? []) == ["Cannot find `missing` here"])
    // What moved behind the changed body is found where it is now
    const answer = only server, [at("textDocument/definition", 30, helperUri, 5, 3)]
    expectText(
      encoded(memberAt(answer, ["result", "range"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":4,\"character\":17\},\"end\":\{\"line\":4,\"character\":22\}\}",
    )
  }

  test "a body whose inferred result changes checks the bodies that call it" {
    var server = started()
    const source = "fn helper() \{\n  1\n\}\n\nfn total(): Int \{\n  helper()\n\}\n\nprint total()\n"
    const _first = send server, [opened(mainUri, source)]
    const changed = "fn helper() \{\n  \"one\"\n\}\n\nfn total(): Int \{\n  helper()\n\}\n\nprint total()\n"
    const answers = send server, [replaced(mainUri, 2, changed)]
    assert(messagesOf(published(answers).get(mainUri) ?? []) == ["Expected `Int64`, found `String`"])
  }

  test "hover and tokens inside and outside of a changed body" {
    var server = started()
    const source = "fn one(): Int \{\n  const a = 1\n  a\n\}\n\nfn two(): Int \{\n  const b = 2\n  b\n\}\n\nprint one() + two()\n"
    const _first = send server, [opened(mainUri, source)]
    const edited = "fn one(): Int \{\n  const a = 1\n  const more = a + 1\n  more\n\}\n\nfn two(): Int \{\n  const b = 2\n  b\n\}\n\nprint one() + two()\n"
    const _second = send server, [replaced(mainUri, 2, edited)]
    const inside = only server, [at("textDocument/hover", 31, mainUri, 3, 3)]
    expectText(textAt(inside, ["result", "contents", "value"]) ?? "", "```trb\nconst more: Int64\n```")
    const outside = only server, [at("textDocument/hover", 32, mainUri, 8, 2)]
    expectText(textAt(outside, ["result", "contents", "value"]) ?? "", "```trb\nconst b: Int64\n```")
    expectText(
      encoded(memberAt(outside, ["result", "range"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":8,\"character\":2\},\"end\":\{\"line\":8,\"character\":3\}\}",
    )
  }
}

group "Hover" {
  test "a local shows its binding and its type" {
    var server = started()
    const _first = send server, [opened(mainUri, "const total = 40 + 2\nprint total\n")]
    const answer = only server, [at("textDocument/hover", 5, mainUri, 1, 8)]
    expectText(textAt(answer, ["result", "contents", "value"]) ?? "", "```trb\nconst total: Int64\n```")
    expectText(
      encoded(memberAt(answer, ["result", "range"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":1,\"character\":6\},\"end\":\{\"line\":1,\"character\":11\}\}",
    )
  }

  test "a function shows its signature and its doc comment" {
    var server = started()
    const source = "/** Twice the value. */\nfn double(value: Int): Int \{\n  value * 2\n\}\n\nprint double(21)\n"
    const _first = send server, [opened(mainUri, source)]
    const answer = only server, [at("textDocument/hover", 6, mainUri, 5, 7)]
    expectText(
      textAt(answer, ["result", "contents", "value"]) ?? "",
      "```trb\nfn double(value: Int): Int\n```\n\nTwice the value.",
    )
  }

  test "a field behind a `.` shows its declaration" {
    var server = started()
    const source = "type Point \{\n  /** Across. */\n  x: Int\n\}\n\nconst point = Point(1)\nprint point.x\n"
    const _first = send server, [opened(mainUri, source)]
    const answer = only server, [at("textDocument/hover", 7, mainUri, 6, 12)]
    expectText(textAt(answer, ["result", "contents", "value"]) ?? "", "```trb\nx: Int\n```\n\nAcross.")
  }

  test "nothing to say is `null`" {
    var server = started()
    const _first = send server, [opened(mainUri, "print 1\n\n\n")]
    const answer = only server, [at("textDocument/hover", 8, mainUri, 2, 0)]
    assert(memberAt(answer, ["result"]) == JsonValue.Null)
  }
}

group "Go to definition" {
  test "a call leads to the function in the module that declares it" {
    const helper = "public fn double(value: Int): Int \{\n  value * 2\n\}\n"
    const main = "use double from \"./helper\"\n\nprint double(21)\n"
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": main])
    const _first = send server, [opened(mainUri, main)]
    const answer = only server, [at("textDocument/definition", 9, mainUri, 2, 8)]
    expectText(
      encoded(memberAt(answer, ["result"]) ?? JsonValue.Null),
      "\{\"uri\":\"file:///workspace/app/src/helper.trb\",\"range\":\{\"start\":\{\"line\":0,\"character\":10\},\"end\":\{\"line\":0,\"character\":16\}\}\}",
    )
  }

  test "a local leads to where it is bound" {
    var server = started()
    const _first = send server, [opened(mainUri, "const total = 1\nprint total\n")]
    const answer = only server, [at("textDocument/definition", 10, mainUri, 1, 7)]
    expectText(
      encoded(memberAt(answer, ["result", "range"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":0,\"character\":6\},\"end\":\{\"line\":0,\"character\":11\}\}",
    )
  }
}

group "Completion" {
  test "where the cursor stands" {
    assert(completionContextOf("point.x", 7) == CompletionContext.Member(5, 5, optional: false))
    assert(completionContextOf("point?.", 7) == CompletionContext.Member(5, 6, optional: true))
    assert(completionContextOf("print to", 8) == CompletionContext.Name(6))
    assert(withoutMemberAccess("print point.xy\n", 11, 14, optional: false) == "print point\n")
  }

  test "behind a `.` the members of the value's type" {
    var server = started()
    const source = "type Point \{\n  x: Int\n  y: Int\n\n  fn sum(): Int \{\n    x + y\n  \}\n\}\n\nconst point = Point(1, 2)\nprint point.x\n"
    const _first = send server, [opened(mainUri, source)]
    const answer = only server, [at("textDocument/completion", 11, mainUri, 10, 12)]
    const labels = itemsAt(answer, ["result", "items"]).map({ textAt(_, ["label"]) ?? "" }).toList()
    assert labels.contains("x")
    assert labels.contains("y")
    assert labels.contains("sum")
  }

  test "behind a `.` of text that does not parse yet, the text without it is asked" {
    var server = started()
    const source = "type Point \{\n  x: Int\n\}\n\nconst point = Point(1)\nprint point.\n"
    const _first = send server, [opened(mainUri, source)]
    const answers = send server, [at("textDocument/completion", 12, mainUri, 5, 12)]
    const answer = answers.find({ integerAt(_, ["id"]) == 12 }) ?? JsonValue.Null
    const labels = itemsAt(answer, ["result", "items"]).map({ textAt(_, ["label"]) ?? "" }).toList()
    assert labels.contains("x")
  }

  test "anywhere else the names in scope, the locals first" {
    var server = started()
    const source = "fn run(limit: Int) \{\n  const doubled = limit * 2\n  print doubled\n\}\n"
    const _first = send server, [opened(mainUri, source)]
    const answer = only server, [at("textDocument/completion", 13, mainUri, 2, 8)]
    const items = itemsAt answer, ["result", "items"]
    const labels = items.map({ textAt(_, ["label"]) ?? "" }).toList()
    assert(labels.take(2).toList() == ["limit", "doubled"])
    assert labels.contains("run")
    assert labels.contains("print")
    assert labels.contains("match")
    assert(textAt(items[1], ["detail"]) == "Int64")
  }
}

group "Semantic tokens" {
  test "five integers per token, positions relative to the token before" {
    var server = started()
    const _first = send server, [opened(mainUri, "const total = 1\nprint total\n")]
    const answer = only(
      server,
      [message("textDocument/semanticTokens/full", "\{\"textDocument\":\{\"uri\":\"{mainUri}\"\}\}", 14)],
    )
    // `total` declared (line 0, character 6, a readonly variable), `print` (a function), `total` used (readonly)
    expectText encoded(memberAt(answer, ["result"]) ?? JsonValue.Null), "\{\"data\":[0,6,5,8,3,1,0,5,5,0,0,6,5,8,2]\}"
  }

  test "a deprecated declaration and every use of it carry the modifier `deprecated`" {
    const source = "deprecated(\"why\")\nfn old(): Int \{\n  1\n\}\n\nprint old()\n"
    var server = started()
    const _first = send server, [opened(mainUri, source)]
    const answer = only(
      server,
      [message("textDocument/semanticTokens/full", "\{\"textDocument\":\{\"uri\":\"{mainUri}\"\}\}", 15)],
    )
    // `old` declared (line 1, a function, `declaration` and `deprecated`: 1 + 32), `Int`, `print`, and `old` called in
    // the file that declares it, which is no use of it and carries no modifier
    expectText(
      encoded(memberAt(answer, ["result"]) ?? JsonValue.Null),
      "\{\"data\":[1,3,3,5,33,0,7,3,0,8,4,0,5,5,0,0,6,3,5,0]\}",
    )
  }
}

/** A request about a whole document. */
fn about(method: String, id: Int, uri: String, rest: String = ""): String {
  message method, "\{\"textDocument\":\{\"uri\":\"{uri}\"\}{rest}\}", id
}

/** The names of the answer to the request with this id among the messages the server sent, `children` below each. */
fn symbolNamesOf(answers: List<JsonValue>, id: Int): List<String> {
  const answer = answers.find({ integerAt(_, ["id"]) == id }) ?? JsonValue.Null
  itemsAt(answer, ["result"]).map({ textAt(_, ["name"]) ?? "" }).toList()
}

group "Symbols" {
  const source = "type Point \{\n  x: Int\n\n  fn doubled(): Int \{\n    x * 2\n  \}\n\}\n\nfn run() \{\n  print 1\n\}\n"

  test "the declarations of a document, with their members inside of them where the client nests them" {
    var server = LanguageServer.over workspaceWith([:]), root
    const capabilities = "\"capabilities\":\{\"textDocument\":\{\"documentSymbol\":\{\"hierarchicalDocumentSymbolSupport\":true\}\}\}"
    const _initialized = send server, [message("initialize", "\{\"rootUri\":\"{root}\",{capabilities}\}", 1)]
    const answers = send server, [opened(mainUri, source), about("textDocument/documentSymbol", 2, mainUri)]
    const answer = answers.find({ integerAt(_, ["id"]) == 2 }) ?? JsonValue.Null
    const symbols = itemsAt answer, ["result"]
    assert(symbolNamesOf(answers, 2) == ["Point", "run"])
    assert(integerAt(symbols[0], ["kind"]) == 23)
    const members = itemsAt symbols[0], ["children"]
    assert(members.map({ textAt(_, ["name"]) ?? "" }).toList() == ["x", "doubled"])
    assert(textAt(members[1], ["detail"]) == "fn doubled(): Int")
    assert(integerAt(members[1], ["kind"]) == 6)
    expectText(
      encoded(memberAt(members[1], ["selectionRange"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":3,\"character\":5\},\"end\":\{\"line\":3,\"character\":12\}\}",
    )
  }

  test "a flat list, each member naming its container, for a client that does not nest them" {
    var server = started()
    const answers = send server, [opened(mainUri, source), about("textDocument/documentSymbol", 3, mainUri)]
    assert(symbolNamesOf(answers, 3) == ["Point", "x", "doubled", "run"])
    const answer = answers.find({ integerAt(_, ["id"]) == 3 }) ?? JsonValue.Null
    assert(textAt(itemsAt(answer, ["result"])[1], ["containerName"]) == "Point")
  }

  test "the declarations of every file of the workspace whose name holds the query, once the index is read" {
    const helper = "public type Doubler \{\}\n\npublic fn doubleIt(value: Int): Int \{\n  value * 2\n\}\n"
    var server = started(["app/src/helper.trb": helper])
    const isWaiting = send(server, [message("workspace/symbol", "\{\"query\":\"doub\"\}", 4)]).isEmpty()
    assert isWaiting
    const answers = server.settle()
    assert(symbolNamesOf(answers, 4) == ["Doubler", "doubleIt"])
    // Read once, the index answers at once
    const again = send server, [message("workspace/symbol", "\{\"query\":\"doubleit\"\}", 5)]
    assert(symbolNamesOf(again, 5) == ["doubleIt"])
  }

  test "a request that takes steps is answered with an error once it is cancelled" {
    var server = started()
    const _asked = send server, [message("workspace/symbol", "\{\"query\":\"x\"\}", 6)]
    const answer = only server, [message("$/cancelRequest", "\{\"id\":6\}")]
    assert(integerAt(answer, ["error", "code"]) == (-32800))
    const idle = server.settle().isEmpty()
    assert idle
  }
}

group "Formatting" {
  test "the edits of the layout of `torb format`, one per run of lines that changes" {
    var server = started()
    const source = "fn run() \{\nprint(1)\n\}\n"
    const answers = send server, [opened(mainUri, source), about("textDocument/formatting", 7, mainUri)]
    const answer = answers.find({ integerAt(_, ["id"]) == 7 }) ?? JsonValue.Null
    expectText(
      encoded(memberAt(answer, ["result"]) ?? JsonValue.Null),
      "[\{\"range\":\{\"start\":\{\"line\":1,\"character\":0\},\"end\":\{\"line\":2,\"character\":0\}\},\"newText\":\"  print 1\\n\"\}]",
    )
  }

  test "a range keeps the edits that touch its lines" {
    var server = started()
    const source = "fn one() \{\nprint(1)\n\}\n\nfn two() \{\nprint(2)\n\}\n"
    const range = ",\"range\":\{\"start\":\{\"line\":5,\"character\":0\},\"end\":\{\"line\":5,\"character\":3\}\}"
    const answers = send server, [opened(mainUri, source), about("textDocument/rangeFormatting", 8, mainUri, range)]
    const answer = answers.find({ integerAt(_, ["id"]) == 8 }) ?? JsonValue.Null
    const edits = itemsAt answer, ["result"]
    assert(edits.length() == 1)
    assert(textAt(edits[0], ["newText"]) == "  print 2\n")
  }

  test "a call of a field that holds a function keeps its parentheses, as `torb format` asks the checker" {
    var server = started()
    const source = "type Button \{\n  action: (Int) => Void\n\}\n\nconst button = Button(\{ print _ \})\nbutton.action(1)\nprint(2)\n"
    const answers = send server, [opened(mainUri, source), about("textDocument/formatting", 10, mainUri)]
    const edits = itemsAt answerOf(answers, 10), ["result"]
    assert(edits.length() == 1)
    assert(textAt(edits[0], ["newText"]) == "print 2\n")
  }

  test "a text that does not parse is left alone" {
    var server = started()
    const answers = send server, [opened(mainUri, "fn run( \{\n"), about("textDocument/formatting", 9, mainUri)]
    const answer = answers.find({ integerAt(_, ["id"]) == 9 }) ?? JsonValue.Null
    assert(memberAt(answer, ["result"]) == JsonValue.Null)
  }

  test "the shortest edits between two lists of lines" {
    const edits = lineEditsBetween(["a\n", "b\n", "c\n", "d\n"], ["a\n", "B\n", "c\n", "d\n", "e\n"])
    assert(edits == [LineEdit(1, 2, 1, 2), LineEdit(4, 4, 4, 5)])
  }
}

/** The answer to the request with this id among the messages the server sent. */
fn answerOf(answers: List<JsonValue>, id: Int): JsonValue {
  answers.find({ integerAt(_, ["id"]) == id }) ?? JsonValue.Null
}

/** Locations as `path line:character-line:character`, one text each, without the root of the workspace. */
fn placesOf(answer: JsonValue): List<String> {
  var found: List<String> = []
  for location in itemsAt(answer, ["result"]) {
    const uri = (textAt(location, ["uri"]) ?? "").withoutPrefix("file:///workspace/") ?? ""
    const start = "{integerAt(location, ["range", "start", "line"]) ?? -1}:{integerAt(location, ["range", "start", "character"]) ?? -1}"
    const end = "{integerAt(location, ["range", "end", "line"]) ?? -1}:{integerAt(location, ["range", "end", "character"]) ?? -1}"
    found.append "{uri} {start}-{end}"
  }
  found
}

/** A request about a position with more parameters behind it. */
fn atWith(method: String, id: Int, uri: String, line: Int, character: Int, rest: String): String {
  const position = "\"position\":\{\"line\":{line},\"character\":{character}\}"
  message method, "\{\"textDocument\":\{\"uri\":\"{uri}\"\},{position}{rest}\}", id
}

group "References" {
  const helper = "public fn double(value: Int): Int \{\n  value * 2\n\}\n"
  const main = "use double from \"./helper\"\nuse quadruple from \"./other\"\n\nprint double(21)\nprint quadruple(1)\n"
  const other = "use double from \"./helper\"\n\npublic fn quadruple(value: Int): Int \{\n  double(double(value))\n\}\n"

  test "a function in the open documents at once, in the files nobody opened once they are checked" {
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": main, "app/src/other.trb": other])
    const _opened = send server, [opened(mainUri, main)]
    const context = ",\"context\":\{\"includeDeclaration\":true\}"
    const isWaiting = send(server, [atWith("textDocument/references", 40, mainUri, 3, 8, context)]).isEmpty()
    assert isWaiting
    const places = placesOf answerOf(server.settle(), 40)
    expectText(
      places.joined(separator: "\n"),
      [
        "app/src/helper.trb 0:10-0:16",
        "app/src/main.trb 0:4-0:10",
        "app/src/main.trb 3:6-3:12",
        "app/src/other.trb 0:4-0:10",
        "app/src/other.trb 3:2-3:8",
        "app/src/other.trb 3:9-3:15",
      ].joined(separator: "\n"),
    )
  }

  test "a local in its body alone, without its declaration where it is not asked for" {
    var server = started()
    const source = "fn run(): Int \{\n  const total = 1\n  total + total\n\}\n\nprint run()\n"
    const context = ",\"context\":\{\"includeDeclaration\":false\}"
    const answers = send(
      server,
      [opened(mainUri, source), atWith("textDocument/references", 41, mainUri, 2, 3, context)],
    )
    assert(placesOf(answerOf(answers, 41)) == ["app/src/main.trb 2:2-2:7", "app/src/main.trb 2:10-2:15"])
  }

  test "a field: its declaration, a member behind a dot, the label of the constructor" {
    var server = started()
    const source = "type Point \{\n  x: Int\n\}\n\nconst point = Point(x: 1)\nprint point.x\n"
    const context = ",\"context\":\{\"includeDeclaration\":true\}"
    const answers = send(
      server,
      [opened(mainUri, source), atWith("textDocument/references", 42, mainUri, 5, 12, context)],
    )
    assert(
      placesOf(answerOf(answers, 42))
        == ["app/src/main.trb 1:2-1:3", "app/src/main.trb 4:20-4:21", "app/src/main.trb 5:12-5:13"],
    )
  }
}

group "Rename" {
  const helperUri = "file:///workspace/app/src/helper.trb"
  const helper = "public fn double(value: Int): Int \{\n  value * 2\n\}\n"
  const main = "use double from \"./helper\"\n\nprint double(21)\n"

  test "`prepareRename` answers the name at the position and its range" {
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": main])
    const answers = send server, [opened(mainUri, main), at("textDocument/prepareRename", 50, mainUri, 2, 8)]
    const answer = answerOf answers, 50
    assert(textAt(answer, ["result", "placeholder"]) == "double")
    expectText(
      encoded(memberAt(answer, ["result", "range"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":2,\"character\":6\},\"end\":\{\"line\":2,\"character\":12\}\}",
    )
  }

  test "a rename edits every place that names it, in every file, once the checks agree" {
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": main])
    const _opened = send server, [opened(mainUri, main)]
    const _asked = send server, [atWith("textDocument/rename", 51, mainUri, 2, 8, ",\"newName\":\"twice\"")]
    const answer = answerOf server.settle(), 51
    const mainEdits = itemsAt(answer, ["result", "changes", mainUri]).map(encoded).toList()
    assert(mainEdits.length() == 2)
    expectContains mainEdits[1], "\"newText\":\"twice\""
    const helperEdits = itemsAt answer, ["result", "changes", helperUri]
    expectText(
      encoded(memberAt(helperEdits[0], ["range"]) ?? JsonValue.Null),
      "\{\"start\":\{\"line\":0,\"character\":10\},\"end\":\{\"line\":0,\"character\":16\}\}",
    )
  }

  test "a name that is no name, a keyword or of the wrong case is refused at once" {
    var server = started(["app/src/helper.trb": helper, "app/src/main.trb": main])
    const _opened = send server, [opened(mainUri, main)]
    for name in ["Twice", "match", "two words", "double"] {
      const answer = only server, [atWith("textDocument/rename", 52, mainUri, 2, 8, ",\"newName\":\"{name}\"")]
      assert(integerAt(answer, ["error", "code"]) == (-32803))
    }
  }

  test "a rename that would change what a name means is refused, and says where" {
    var server = started()
    const source = "fn run(): Int \{\n  const first = 1\n  const second = 2\n  first + second\n\}\n\nprint run()\n"
    const _opened = send server, [opened(mainUri, source)]
    const _asked = send server, [atWith("textDocument/rename", 53, mainUri, 3, 3, ",\"newName\":\"second\"")]
    const answer = answerOf server.settle(), 53
    assert(integerAt(answer, ["error", "code"]) == (-32803))
    expectContains(textAt(answer, ["error", "message"]) ?? "", "renaming `first` to `second`")
  }
}

group "Signature help" {
  test "the signature of what a call calls, the parameter at the cursor marked" {
    var server = started()
    const source = "/** Adds. */\nfn add(first: Int, second: Int): Int \{\n  first + second\n\}\n\nprint add(1, 2)\n"
    const answers = send server, [opened(mainUri, source), at("textDocument/signatureHelp", 60, mainUri, 5, 13)]
    const answer = answerOf answers, 60
    const signature = itemsAt(answer, ["result", "signatures"])[0]
    assert(textAt(signature, ["label"]) == "fn add(first: Int, second: Int): Int")
    assert(textAt(signature, ["documentation", "value"]) == "Adds.")
    expectText(
      encoded(memberAt(signature, ["parameters"]) ?? JsonValue.Null),
      "[\{\"label\":[7,17]\},\{\"label\":[19,30]\}]",
    )
    assert(integerAt(answer, ["result", "activeParameter"]) == 1)
  }

  test "the constructor of a type is called with its fields, and a label names the parameter" {
    var server = started()
    const source = "type Point \{\n  x: Int\n  y: Int\n\}\n\nprint Point(y: 2, x: 1)\n"
    const answers = send server, [opened(mainUri, source), at("textDocument/signatureHelp", 61, mainUri, 5, 13)]
    const answer = answerOf answers, 61
    assert(textAt(itemsAt(answer, ["result", "signatures"])[0], ["label"]) == "Point(x: Int, y: Int)")
    assert(integerAt(answer, ["result", "activeParameter"]) == 1)
  }
}

group "The documentation of a declaration" {
  const source = "/**\n * Twice the value; [triple] is more.\n *\n * # Panics\n *\n * Never.\n */\nfn double(value: Int): Int \{\n  value * 2\n\}\n\n/** Three times the value. */\nfn triple(value: Int): Int \{\n  value * 3\n\}\n\nprint double(1) + triple(1)\n"

  test "a hover renders the doc comment as `torb doc` does, its links leading to what they name" {
    var server = started()
    const answers = send server, [opened(mainUri, source), at("textDocument/hover", 70, mainUri, 16, 7)]
    const markdown = textAt(answerOf(answers, 70), ["result", "contents", "value"]) ?? ""
    expectContains markdown, "```trb\nfn double(value: Int): Int\n```"
    expectContains markdown, "[`triple`](file:///workspace/app/src/main.trb#L13,4) is more."
    expectContains markdown, "**Panics**\n\nNever."
  }

  test "a completion item resolves to the signature and the documentation of its declaration" {
    var server = started()
    const typing = source.replace "print double(1) + triple(1)\n", "print tri\n"
    const answers = send server, [opened(mainUri, typing), at("textDocument/completion", 71, mainUri, 16, 9)]
    const items = itemsAt answerOf(answers, 71), ["result", "items"]
    const item = items.find({ textAt(_, ["label"]) == "triple" }) ?? JsonValue.Null
    const resolved = only server, [message("completionItem/resolve", encoded(item), 72)]
    assert(textAt(resolved, ["result", "detail"]) == "fn triple(value: Int): Int")
    assert(textAt(resolved, ["result", "documentation", "value"]) == "Three times the value.")
  }

  test "a hover over a deprecated declaration says so above its comment, and what to write instead" {
    var server = started()
    const deprecated = "/** One, the old way. */\ndeprecated(\"the name says too little\", replacement: \"one\", since: \"0.4\")\nfn old(): Int \{\n  1\n\}\n\nfn one(): Int \{\n  1\n\}\n\nprint old() + one()\n"
    const answers = send server, [opened(mainUri, deprecated), at("textDocument/hover", 74, mainUri, 10, 7)]
    const markdown = textAt(answerOf(answers, 74), ["result", "contents", "value"]) ?? ""
    expectContains(
      markdown,
      "**Deprecated since 0.4:** the name says too little. Write `one` instead.\n\nOne, the old way.",
    )
  }

  test "a completion item of a deprecated declaration carries the tag an editor strikes it through for" {
    var server = started()
    const typing = "deprecated(\"why\")\nfn older(): Int \{\n  1\n\}\n\nprint old\n"
    const answers = send server, [opened(mainUri, typing), at("textDocument/completion", 75, mainUri, 5, 9)]
    const items = itemsAt answerOf(answers, 75), ["result", "items"]
    const item = items.find({ textAt(_, ["label"]) == "older" }) ?? JsonValue.Null
    expectText encoded(memberAt(item, ["tags"]) ?? JsonValue.Null), "[1]"
  }

  test "a call of a generic function says what its type parameters are there" {
    var server = started()
    const generic = "fn firstOf<Item>(items: List<Item>): Item? \{\n  items.first()\n\}\n\nprint firstOf([1, 2])\n"
    const answers = send server, [opened(mainUri, generic), at("textDocument/hover", 73, mainUri, 4, 8)]
    expectContains(textAt(answerOf(answers, 73), ["result", "contents", "value"]) ?? "", "`Item` is `Int64` here")
  }
}

group "Quick fixes" {
  test "the fix of a lint finding is a code action on its range" {
    var server = started()
    const source = "type Point \{\n  x: Int\n\n  static fn origin(): Point \{\n    Self(0)\n  \}\n\}\n\nprint Point.origin()\n"
    const _first = send server, [opened(mainUri, source)]
    const range = "\"range\":\{\"start\":\{\"line\":3,\"character\":0\},\"end\":\{\"line\":3,\"character\":30\}\}"
    const parameters = "\{\"textDocument\":\{\"uri\":\"{mainUri}\"\},{range},\"context\":\{\"diagnostics\":[]\}\}"
    const answer = only server, [message("textDocument/codeAction", parameters, 15)]
    const actions = itemsAt answer, ["result"]
    assert(actions.length() == 1)
    assert(textAt(actions[0], ["kind"]) == "quickfix")
    const edits = itemsAt actions[0], ["edit", "changes", mainUri]
    expectText(
      encoded(JsonValue.Array(edits)),
      "[\{\"range\":\{\"start\":\{\"line\":3,\"character\":22\},\"end\":\{\"line\":3,\"character\":27\}\},\"newText\":\"Self\"\}]",
    )
  }
}

/** The tests and groups of a text on one line: `group Outer [test adds [], group Inner []]`. */
fn writtenTests(items: List<TestItem>): String {
  items.map({ item => "{item.kind} {item.name} [{writtenTests(item.children)}]" }).toList().joined(separator: ", ")
}

/** A request of `torbscript/tests` for the document at `uri`. */
fn testsRequest(id: Int, uri: String): String {
  message "torbscript/tests", "\{\"textDocument\":\{\"uri\":\"{uri}\"\}\}", id
}

/** The names of the top level of the answer to the request with this id among the messages the server sent. */
fn testNamesOf(answers: List<JsonValue>, id: Int): List<String> {
  const answer = answers.find({ integerAt(_, ["id"]) == id }) ?? JsonValue.Null
  itemsAt(answer, ["result"]).map({ textAt(_, ["name"]) ?? "" }).toList()
}

group "The tests of a file" {
  test "`initialize` says the server answers `torbscript/tests`" {
    var server = LanguageServer.over workspaceWith([:]), root
    expectContains encoded(only(server, [initialize])), "\"experimental\":\{\"tests\":true\}"
  }

  test "every style of call, a group with its children, and a name that is no literal left out" {
    const source = raw"""
      use test, group from "std/test"

      group "Outer" {
        test "adds" {
          assert(1 + 1 == 2)
        }

        group("Inner") {
          test("in parentheses", { assert(true) })
        }

        const count = 2
        test "counted {count}" {
          assert(true)
        }
      }

      for index in [1, 2] {
        if index > 0 {
          test "in a loop" {
            test "inside of a test" { assert(true) }
          }
        }
      }

      fn helper() {
        test "in a function" { assert(true) }
      }

      test "escaped \"quotes\"" { assert(true) }
      """
    const expected = "group Outer [test adds [], group Inner [test in parentheses []]], test in a loop [], test escaped \"quotes\" []"
    expectText writtenTests(testItemsOf(source)), expected
  }

  test "the range is the whole call and the selection its name, both in UTF-16" {
    const source = "group \"Größe\" \{\n  test \"日本 😀\" \{ assert(true) \}\n\}\n"
    const inner = "\{\"kind\":\"test\",\"name\":\"日本 😀\",\"range\":\{\"start\":\{\"line\":1,\"character\":2\},\"end\":\{\"line\":1,\"character\":31\}\},\"selectionRange\":\{\"start\":\{\"line\":1,\"character\":7\},\"end\":\{\"line\":1,\"character\":14\}\},\"children\":[]\}"
    const outer = "\{\"kind\":\"group\",\"name\":\"Größe\",\"range\":\{\"start\":\{\"line\":0,\"character\":0\},\"end\":\{\"line\":2,\"character\":1\}\},\"selectionRange\":\{\"start\":\{\"line\":0,\"character\":6\},\"end\":\{\"line\":0,\"character\":13\}\},\"children\":[{inner}]\}"
    expectText encoded(testTreeOf(source)), "[{outer}]"
  }

  test "the request answers from the open document, from the file otherwise, and `[]` where there is none" {
    const testUri = "file:///workspace/app/tests/math.test.trb"
    const onDisk = "use test from \"std/test\"\n\ntest \"on disk\" \{\n  assert(true)\n\}\n"
    var server = started(["app/tests/math.test.trb": onDisk])
    const fromFile = testNamesOf send(server, [testsRequest(2, testUri)]), 2
    assert(fromFile == ["on disk"])
    const open = "use test from \"std/test\"\n\ntest \"open\" \{\n  assert(true)\n\}\n"
    const fromDocument = testNamesOf send(server, [opened(testUri, open), testsRequest(3, testUri)]), 3
    assert(fromDocument == ["open"])
    const missing = only server, [testsRequest(4, "file:///workspace/app/tests/missing.test.trb")]
    expectText encoded(memberAt(missing, ["result"]) ?? JsonValue.Null), "[]"
    const untitled = only server, [testsRequest(5, "untitled:Untitled-1")]
    expectText encoded(memberAt(untitled, ["result"]) ?? JsonValue.Null), "[]"
  }
}
