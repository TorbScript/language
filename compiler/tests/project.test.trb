/**
 * The pieces a project is built from before any checking starts: path arithmetic (`normalizePath`, `relativePath`,
 * `pathDepth`, ...), a `project.trb` read into a `Manifest`, and a workspace of several packages found from a path
 * inside of it.
 */

use test, group from "std/test"
use normalizePath, parentPath, pathName, joinPath, isInside, pathDepth, relativePath from "../src/project/path"
use embeddedPathOf, commonDirectoryOf from "../src/project/path"
use SourceTree from "../src/project/source-tree"
use Manifest, readManifest, manifestProblemsOf, needsEvaluation from "../src/project/manifest"
use findWorkspace from "../src/project/workspace"
use SourceText from "../src/syntax/source"
use parse from "../src/syntax/parser/parser"

fn manifestOf(text: String): Manifest {
  readManifest parse(SourceText.of(text)).file
}

/** What the static reader refuses in a manifest: the message of every problem. */
fn problemsOf(text: String): List<String> {
  manifestProblemsOf(parse(SourceText.of(text)).file).map({ _.message }).toList()
}

fn evaluates(text: String): Bool {
  needsEvaluation parse(SourceText.of(text)).file
}

/** The name and the files of every package of the workspace a path belongs to, in the order the toolchain sees them. */
fn packagesOf(files: Map<String, String>, path: String): List<String> {
  var described: List<String> = []
  for package in findWorkspace(SourceTree.of(files), path).packages {
    const paths = package.files.joined separator: ", "
    described.append "{package.name}: {paths}"
  }
  described
}

group "Paths" {
  test "normalizing resolves `.`, `..` and backslashes" {
    assert(normalizePath("std\\fs\\src") == "std/fs/src")
    assert(normalizePath("std/fs/../io/./src") == "std/io/src")
    assert(normalizePath("") == ".")
    assert(normalizePath("../..") == "../..")
    assert(normalizePath("/usr/local/../bin") == "/usr/bin")
  }

  test "parent, name and join" {
    assert(parentPath("std/fs/src") == "std/fs")
    assert(parentPath("std") == ".")
    assert(parentPath(".") == "..")
    assert(pathName("std/fs/src/lib.trb") == "lib.trb")
    assert(joinPath("std/fs/src", "../../io") == "std/io")
  }

  test "everything is inside of the working directory" {
    assert isInside("app/src/main.trb", "app")
    assert isInside("app", "app")
    assert(!isInside("application", "app"))
    assert isInside("app/src", ".")
  }

  test "depth orders a directory before what is inside it" {
    assert(pathDepth(".") == 0)
    assert(pathDepth("app") == 1)
    assert(pathDepth("..") == -1)
    assert(pathDepth("../std/fs") == 1)
    // The walk up to the workspace root stops where the depth does: one step further and the path would be relative
    assert(pathDepth("/") == 0)
    assert(pathDepth("C:") == 1)
    assert(pathDepth(parentPath("C:")) == 0)
  }

  test "paths are shown the way they were typed" {
    assert(relativePath("/repository/app", "/repository/std/fs/src/lib.trb") == "../std/fs/src/lib.trb")
    assert(relativePath("/repository", "/repository/compiler") == "compiler")
    assert(relativePath("/repository", "/repository") == ".")
  }

  test "a native binary keys the files it carries below /torb, not below the directory they share" {
    const root = commonDirectoryOf(["C:/work/shop/src", "C:/work/shop", "C:/work/torb/std"])
    assert(root == "C:/work")
    assert(embeddedPathOf(root, "C:/work/shop/src/main.trb") == "/torb/shop/src/main.trb")
    assert(embeddedPathOf(root, "C:/work") == "/torb")
    assert(embeddedPathOf(root, "D:/elsewhere/x.trb") == "D:/elsewhere/x.trb")
    assert(embeddedPathOf("", "C:/work/x.trb") == "C:/work/x.trb")
    assert(commonDirectoryOf(["C:/a", "D:/b"]) == "")
  }
}

group "Manifest" {
  test "settings, blocks and dependencies" {
    const manifest = manifestOf(
      "name \"acme/shop\"\nversion \"1.4.0\"\nprelude \"acme/teaching\"\n"
        + "dependencies \{\n  runtime \"acme/http:^1.2.3\"\n  development \"acme/mock-server:^3.4.5\"\n\}\n"
        + "build \{\n  input \"src/api.trb\"\n  output \"build/api\"\n\}\ntest \{\n  input \"spec\"\n\}\n",
    )
    assert(manifest.name == "acme/shop")
    assert(manifest.version == "1.4.0")
    assert(manifest.prelude == "acme/teaching")
    assert(manifest.runtimeDependencies == ["acme/http"])
    assert(manifest.developmentDependencies == ["acme/mock-server"])
    assert(manifest.buildInput == "src/api.trb")
    assert(manifest.testInput == "spec")
    assert manifest.dependsOn("acme/http")
    assert(!manifest.dependsOn("acme/other"))
  }

  test "the defaults are the layout of a project" {
    const manifest = manifestOf "name \"acme/app\""
    assert(manifest.prelude == "std/prelude")
    assert(manifest.buildInput == "src/main.trb")
    assert(manifest.testInput == "tests")
    assert(!manifest.isWorkspace())
  }

  test "everything the toolchain does not know is ignored silently" {
    const manifest = manifestOf(
      raw"""
        name "acme/app"
        const binary = name.substringAfter("/") ?? name
        authors "Someone"
        registry "acme", url: "https://x.test"
        """,
    )
    assert(manifest.name == "acme/app")
  }

  test "a workspace has no test directory unless it names one" {
    assert(manifestOf("workspace \{ members \"std/*\" \}").testInput == "")
    assert(manifestOf("workspace \{ members \"std/*\" \}\ntest \{ input \".\" \}").testInput == ".")
  }

  test "tasks \{ workers, blocking \} are read as numbers, and one outside 1 to 1024 is a problem" {
    const manifest = manifestOf "tasks \{\n  workers = 4\n  blocking = 1_024\n\}\n"
    assert(manifest.workers == 4)
    assert(manifest.blocking == 1024)
    assert(manifest.pool() == (workers: 4, blocking: 1024))
    assert manifest.poolProblem().isNone()
    assert(manifestOf("name \"acme/app\"").pool() == (workers: 0, blocking: 0))
    assert manifestOf("tasks \{ workers = 0 \}").poolProblem().isSome()
    assert manifestOf("tasks \{ blocking = 2000 \}").poolProblem().isSome()
  }

  test "a name with an interpolation is not a literal, so it is not read" {
    assert(manifestOf("name \"acme/\{suffix\}\"").name == "")
  }

  test "a setting the toolchain reads before it can run anything is refused where it is computed" {
    assert(problemsOf("name = \"acme/\{suffix\}\"") == ["`name` has to be a plain string"])
    assert(problemsOf("prelude = preludeName()") == ["`prelude` has to be a plain string"])
    assert(
      problemsOf("dependencies \{\n  runtime \"acme/\{name\}\"\n\}") == ["`dependencies` has to be a plain string"],
    )
    assert(problemsOf("build \{\n  input = entry\n\}") == ["`build \{ input \}` has to be a plain string"])
    // A setting that may be computed is no problem, and neither is anything else of a block that is not `input`
    assert problemsOf("name = \"acme/app\"\nversion = tag ?? \"0.0.0\"\ntest \{\n  coverageThreshold = threshold\n\}").isEmpty()
    const problem = manifestProblemsOf(parse(SourceText.of("\nname = prefix + \"/app\"")).file)[0]
    assert(problem.span.start == 8)
  }

  test "a manifest is evaluated only where a setting the toolchain uses is computed" {
    assert(!evaluates("name = \"acme/app\"\nversion = \"1.0.0\"\ntasks \{\n  workers = 4\n\}"))
    assert(!evaluates("use File from \"std/fs\"\n\nconst threshold = 80\ndescription = File.readText(\"ABOUT\").ok() ?? \"\""))
    // A computed static setting is refused, not evaluated
    assert(!evaluates("name = \"acme/\{suffix\}\""))
    assert evaluates("version = Environment.get(\"CI_COMMIT_TAG\") ?? \"0.0.0\"")
    assert evaluates("tasks \{\n  workers = cores / 2\n\}")
    assert evaluates("if Environment.get(\"CI\").isSome() \{\n  version = \"ci\"\n\}")
  }
}

group "Workspaces" {
  const workspace = [
    "project.trb": "name \"acme/all\"\nworkspace \{ members \"packages/*\", \"tools/importer\" \}",
    "packages/core/project.trb": "name \"acme/core\"",
    "packages/core/src/lib.trb": "public type Core \{\}",
    "packages/core/tests/core.test.trb": "",
    "packages/api/project.trb": "name \"acme/api\"",
    "packages/api/src/lib.trb": "public type Api \{\}",
    "tools/importer/project.trb": "name \"acme/importer\"",
    "tools/importer/src/main.trb": "",
    "elsewhere/script.trb": "",
  ]

  test "members are globbed, and every member is a package" {
    assert(
      packagesOf(workspace, ".")
        == [
          "acme/all: ",
          "acme/api: packages/api/src/lib.trb",
          "acme/core: packages/core/src/lib.trb, packages/core/tests/core.test.trb",
          "acme/importer: tools/importer/src/main.trb",
        ],
    )
  }

  test "a member brings its whole workspace, because that is where its dependencies are" {
    assert(packagesOf(workspace, "packages/api").length() == 4)
    assert(packagesOf(workspace, "packages/api/src/lib.trb").length() == 4)
  }

  test "a file below no project is a package of its own" {
    const packages = packagesOf(["script.trb": "const answer = 42"], "script.trb")
    assert(packages == [": script.trb"])
  }

  test "a file named on its own is a module of the project around it" {
    const packages = packagesOf workspace, "elsewhere/script.trb"
    assert(packages[0] == "acme/all: elsewhere/script.trb")
  }

  test "a workspace without a standard library gets the toolchain's" {
    const files = [
      "toolchain/std/prelude/project.trb": "name \"std/prelude\"",
      "toolchain/std/prelude/src/lib.trb": "",
      "app/project.trb": "name \"acme/app\"",
      "app/src/main.trb": "",
      "script.trb": "",
    ]
    const tree = SourceTree.of files, ".", "toolchain/std"
    const project = findWorkspace(tree, "app").packages.map({ _.name }).toList()
    assert(project == ["acme/app", "std/prelude"])
    const script = findWorkspace(tree, "script.trb").packages.map({ _.name }).toList()
    assert(script == ["", "std/prelude"])
  }

  test "a pattern that matches nothing is a problem of the workspace" {
    const found = findWorkspace(
      SourceTree.of(["project.trb": "name \"acme/all\"\nworkspace \{ members \"packages/*\" \}"]),
      ".",
    )
    assert(found.problems == ["The workspace member pattern `packages/*` of . matches no project"])
  }

  test "a computed static setting of a manifest is a problem of the workspace, with its place" {
    const found = findWorkspace(
      SourceTree.of(["project.trb": "const suffix = \"shop\"\n\nname = \"acme/\{suffix\}\""]),
      ".",
    )
    const expected = [
      "`name` has to be a plain string\n --> project.trb:3:8\n  = The toolchain reads `name` before it can run anything, so it cannot be computed",
    ]
    assert(found.problems == expected)
  }
}
