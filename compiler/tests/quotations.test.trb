/**
 * `Expression<Value>`: a parameter or a binding of that type takes the expression that was written instead of its value.
 *
 * Three things are checked here. The argument is an ordinary `Value` (`assert(limit > 1)` is a `Bool` and nothing else),
 * it has to be **quotable** - what the concept lists as an expression, and no statement, no `?` and no `match` - and
 * everything it **captures** has to be `Encode`, because a provider hands the captured values on.
 *
 * The declaration of the helpers comes *after* the bodies, so that a name in a quotation is the first occurrence of its
 * text and `spanOf` finds the one the test means.
 */

use test, group from "std/test"
use probe, problems, notes from "./harness"

/** A provider whose parameter is quoted, in the shape of `examples/query-provider`. */
const provider = "\ntype Row \{\n  age: Int\n  name: String\n  nickname: String? = None\n\}\n\n"
  + "fn select(predicate: Expression<(row: Row) => Bool>): String \{\n  predicate.source\n\}\n\n"
  + "fn quoted(condition: Expression<Bool>): String \{\n  condition.source\n\}\n"

fn inBody(body: String): String {
  "fn probe() \{\n{body}\n\}\n{provider}"
}

group "What a quotation records" {
  test "`assert` quotes its condition: the value stays a `Bool` and the tree is recorded at its span" {
    const source = inBody "  const limit = 2\n  assert(limit > 1)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("limit > 1") == "Bool")
    assert(probed.adaptationsOf("limit > 1") == ["quote"])
    assert(probed.quotationOf("limit > 1") == [
      "value Bool",
      "capture 0 limit: Int64 through Int64: Encode",
      "name `limit` capture 0",
    ])
  }

  test "a quotation without captures has none, and the tree is still recorded" {
    const source = inBody "  assert(1 < 2)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.quotationOf("1 < 2") == ["value Bool"])
  }

  test "captures are numbered in the order `captures()` returns them" {
    const source = inBody "  const first = 1\n  const second = 2\n  assert(second > first)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.quotationOf("second > first") == [
      "value Bool",
      "capture 0 second: Int64 through Int64: Encode",
      "capture 1 first: Int64 through Int64: Encode",
      "name `second` capture 0",
      "name `first` capture 1",
    ])
  }

  test "a binding that is read twice is one capture and two names" {
    const source = inBody "  const size = 1\n  assert(size == size)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.quotationOf("size == size") == [
      "value Bool",
      "capture 0 size: Int64 through Int64: Encode",
      "name `size` capture 0",
      "name `size` capture 0",
    ])
  }

  test "a quoted closure records its `Lambda` and the parameter every implicit `_` means" {
    const source = inBody "  const limit = 18\n  const found = select \{ _.age >= limit \}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("\{ _.age >= limit \}") == "(row: Row) => Bool")
    assert(probed.quotationOf("\{ _.age >= limit \}") == [
      "value (row: Row) => Bool",
      "capture 0 limit: Int64 through Int64: Encode",
      "lambda `\{ _.age >= limit \}` (row: Row)",
      "name `_` parameter 0",
      "name `limit` capture 0",
    ])
  }

  test "a closure that writes its parameter down is the same tree under that name" {
    const source = inBody "  const found = select \{ item => item.age >= 1 \}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.quotationOf("\{ item => item.age >= 1 \}") == [
      "value (item: Row) => Bool",
      "lambda `\{ item => item.age >= 1 \}` (item: Row)",
      "name `item` parameter 0",
    ])
  }

  test "a nested closure is a `Lambda` of its own" {
    const source = inBody("  const names = [\"a\"]\n  const found = select \{ anyOf(names, \{ part => part == _.name \}) \}")
      + "\nfn anyOf(values: List<String>, check: (value: String) => Bool): Bool \{\n  true\n\}\n"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.quotationOf("\{ anyOf(names, \{ part => part == _.name \}) \}") == [
      "value (row: Row) => Bool",
      "capture 0 names: List<String> through List<Item>: Encode [String: Encode]",
      "lambda `\{ anyOf(names, \{ part => part == _.name \}) \}` (row: Row)",
      "name `names` capture 0",
      "lambda `\{ part => part == _.name \}` (part: String)",
      "name `part` parameter 0",
      "name `_` parameter 0",
    ])
  }

  test "a binding of type `Expression<Value>` quotes its initializer, exactly as a parameter does (gap 37)" {
    const source = inBody "  const limit = 1\n  const condition: Expression<Bool> = limit > 0"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.adaptationsOf("limit > 0") == ["quote"])
    assert(probed.quotationOf("limit > 0") == [
      "value Bool",
      "capture 0 limit: Int64 through Int64: Encode",
      "name `limit` capture 0",
    ])
  }

  test "a name that already holds a quotation is passed on, not quoted a second time" {
    const source = "fn probe(given: Expression<(row: Row) => Bool>) \{\n  const found = select(given)\n\}\n{provider}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("select(given)") == "String")
    assert(probed.lastAdaptationsOf("given") == [])
  }

  test "the same holds where the `Value` of the parameter is still open, as in `Quoted.of(predicate)`" {
    const source = "fn probe(given: Expression<Bool>) \{\n  const found = hold(given)\n\}\n\n"
      + "fn hold<Value>(expression: Expression<Value>): String \{\n  expression.source\n\}\n{provider}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.lastAdaptationsOf("given") == [])
  }

  test "`nameOf` is an ordinary function over a quotation, so its argument is quoted like any other" {
    const source = inBody "  const limit = 1\n  const found = nameOf(limit)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("nameOf(limit)") == "String")
    assert(probed.lastAdaptationsOf("limit") == ["quote"])
  }
}

group "What is quotable" {
  test "literals, operators, member access, calls and interpolation" {
    const source = inBody "  const limit = 1\n  assert(\"\{limit\}\".isEmpty() == !true)"
    assert problems(source).isEmpty()
  }

  test "`if`/`else`, a list literal, an index and a nested closure" {
    const source = inBody "  const sizes = [1, 2]\n  assert(if true \{ sizes[0] \} else \{ 2 \} == 1)"
    assert problems(source).isEmpty()
  }

  test "a constructor and a case" {
    const source = inBody "  assert(Row(1, \"a\").nickname == None)"
    assert problems(source).isEmpty()
  }

  test "`?.` and `??` are calls on `Option`, so they need no node of their own" {
    const source = inBody "  const row = Row(1, \"a\")\n  assert((row.nickname ?? \"x\").isEmpty() == false)"
    assert problems(source).isEmpty()
  }

  test "a tuple, a map literal and a range are constructions, which the concept lists as quotable" {
    const pairs = "  const pairs = [\"a\": 1]\n"
    const source = inBody "{pairs}  assert((1, 2) == (1, 2))\n  assert(pairs.isEmpty())\n  assert(\"abc\".slice(0..2) == \"ab\")"
    assert problems(source).isEmpty()
  }
}

group "What is not quotable" {
  test "a `const` in a quoted closure" {
    const source = inBody "  const found = select \{ const limit = 1\n    _.age >= limit \}"
    assert(problems(source) == [
      "A `const` cannot appear in a quotation: `Expression<(row: Row) => Bool>` holds a single expression",
    ])
    assert(notes(source) == ["A quotation is one expression, so a quoted closure is one too: `\{ _.age >= minAge \}`"])
  }

  test "a `var`, an assignment and a second statement" {
    const withVar = inBody "  const found = select \{ var limit = 1\n    _.age >= limit \}"
    assert(problems(withVar) == [
      "A `var` cannot appear in a quotation: `Expression<(row: Row) => Bool>` holds a single expression",
    ])
    const assignment = "fn probe() \{\n  var counter = 0\n  const found = select \{ counter = 1\n    _.age >= counter \}\n\}\n{provider}"
    assert(problems(assignment).contains(
      "An assignment cannot appear in a quotation: `Expression<(row: Row) => Bool>` holds a single expression",
    ))
    const twice = inBody "  const found = select \{ _.age >= 1\n    _.age >= 2 \}"
    assert(problems(twice).contains(
      "A second statement cannot appear in a quotation: `Expression<(row: Row) => Bool>` holds a single expression",
    ))
  }

  test "a loop, a `return` and a declaration" {
    const repeated = inBody "  const found = select \{ for part in [1] \{ print part \}\n    _.age >= 1 \}"
    assert(problems(repeated) == [
      "A `for` loop cannot appear in a quotation: `Expression<(row: Row) => Bool>` holds a single expression",
    ])
    const returned = inBody "  const found = select \{ return _.age >= 1 \}"
    assert(problems(returned) == [
      "A `return` cannot appear in a quotation: `Expression<(row: Row) => Bool>` holds a single expression",
    ])
    const declared = inBody "  const found = select \{ fn inner() \{\}\n    _.age >= 1 \}"
    assert(problems(declared) == [
      "A declaration cannot appear in a quotation: `Expression<(row: Row) => Bool>` holds a single expression",
    ])
  }

  test "the early return `?`" {
    const source = "fn probe(): Bool? \{\n  const flag: Bool? = Some(true)\n  assert(flag?)\n  None\n\}\n{provider}"
    assert(problems(source) == ["`?` cannot appear in a quotation: `Expression<Bool>` holds a single expression"])
  }

  test "`match`, which would double the set of nodes" {
    const source = inBody "  assert(match 1 \{\n    1 => true\n    _ => false\n  \})"
    assert(problems(source) == ["`match` cannot be quoted yet"])
    assert(notes(source) == [
      "Patterns would double the set of nodes an `ExpressionNode` has, so the language leaves them out",
    ])
  }

  test "an `if` without an `else` has no value" {
    const source = inBody "  const found = select \{ if _.age > 1 \{ true \} \}"
    assert problems(source).contains("An `if` without an `else` has no value, so it cannot be quoted")
  }

  test "a pattern in an `if` binds a name, which a `Conditional` node cannot" {
    const source = inBody "  const held: Bool? = None\n  const found = quoted(if const Some(flag) = held \{ flag \} else \{ false \})"
    assert(problems(source).contains(
      "A pattern in an `if` cannot appear in a quotation: `Expression<Bool>` holds a single expression",
    ))
  }

  test "a spread and a parameter that destructures have no node in an expression tree" {
    const spread = inBody "  const sizes = [1]\n  assert(count(...sizes) == 1)\n\}\n\nfn count(...values: Int): Int \{\n  1"
    assert(problems(spread) == ["A spread has no node in an expression tree, so `Expression<Bool>` cannot hold it"])
    assert(notes(spread) == [
      "`ExpressionNode` is part of the language standard: a new kind of node needs a new version of it",
    ])
    const pattern = "fn probe() \{\n  const found = onPair \{ (a, b) => a < b \}\n\}\n\n"
      + "fn onPair(check: Expression<(pair: (Int, Int)) => Bool>): String \{\n  check.source\n\}"
    assert(problems(pattern) == [
      "A parameter that destructures has no node in an expression tree,"
        + " so `Expression<(pair: (Int64, Int64)) => Bool>` cannot hold it",
    ])
  }
}

group "Captured variables must be `Encode` (gap 36)" {
  test "a capture that is not `Encode`, with `assert` named as the reason" {
    const source = "fn probe() \{\n  const opaque = Opaque(true, \{ true \})\n  assert(opaque.flag)\n\}\n\ntype Opaque \{\n  flag: Bool\n  read: () => Bool\n\}\n{provider}"
    assert(problems(source) == ["`opaque` is captured here and `Opaque` is not `Encode`"])
    assert(notes(source) == [
      "`assert` quotes its `condition`, so `opaque` has to be `Encode`",
      "A quotation hands the captured values on, so what cannot be `Encode` is compared in a `match`",
    ])
  }

  test "the same capture in a binding names the binding as the reason" {
    const source = "fn probe() \{\n  const opaque = Opaque(true, \{ true \})\n  const condition: Expression<Bool> = opaque.flag\n\}\n\n"
      + "type Opaque \{\n  flag: Bool\n  read: () => Bool\n\}\n{provider}"
    assert(problems(source) == ["`opaque` is captured here and `Opaque` is not `Encode`"])
    assert notes(source).contains("The type of `condition` quotes its value, so `opaque` has to be `Encode`")
  }

  test "the message points at the first read of the capture" {
    const source = "fn probe() \{\n  const opaque = Opaque(true, \{ true \})\n  assert(opaque.flag || opaque.flag)\n\}\n\n"
      + "type Opaque \{\n  flag: Bool\n  read: () => Bool\n\}\n{provider}"
    assert(problems(source).length() == 1)
  }

  test "a capture whose type is a generic parameter is decided where the enclosing function is called" {
    const source = "fn probe<Value>(value: Value, other: Value) \{\n  assert(same(value, other))\n\}\n\n"
      + "fn same<Value>(first: Value, second: Value): Bool \{\n  true\n\}\n{provider}"
    assert problems(source).isEmpty()
  }

  test "a parameter of the quoted closure is not a capture, so it needs no `Encode`" {
    const source = "fn probe() \{\n  const found = onOpaque \{ _.flag \}\n\}\n\n"
      + "fn onOpaque(check: Expression<(value: Opaque) => Bool>): String \{\n  check.source\n\}\n\n"
      + "type Opaque \{\n  flag: Bool\n  read: () => Bool\n\}"
    assert problems(source).isEmpty()
  }
}
