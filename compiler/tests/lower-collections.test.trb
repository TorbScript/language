/**
 * The containers from the source side: `a[key]`, and `for` over a collection.
 *
 * The literals and the element descriptors are pinned by hand-built IR in `ir-elements.test.trb`; what is asked here is
 * the shape a *source* program produces - which member a bracket reaches, in which order its two operands are
 * evaluated, and what a loop over an `Iterator` looks like.
 *
 * `a[key]` on the real `ArrayList` goes through its own `at`, which panics with the index and the length, so what an
 * index out of range does is decided in `std/collections` and is the same in every back end - the back end has no rule
 * of its own for it. The prelude of `harness.trb` declares `at` as required and writes the same body out on its
 * `ArrayList`, and the types of the tests here provide one of their own, which is what makes the `at` in these
 * snapshots the program's and not the standard library's.
 */

use test, group from "std/test"
use irOf, ownedIrOf, unsupportedIn from "./lower-harness"

group "`a[key]`" {
  test "an index is a call of the `at` the type provides, the receiver before the key" {
    const source = raw"""
      type Grid with Indexed<Int, Int> {
        base: Int

        fn at(key: Int): Int {
          base + key
        }
      }

      fn cell(grid: Grid): Int {
        grid[2]
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_cell") == raw"""
        fn t_acme_x2f_app_main_cell(grid: Record(T_acme_x2f_app_main_Grid) borrowed) -> Int64 {
          slot %0 parameter grid: Record(T_acme_x2f_app_main_Grid)
          slot %1 temporary: Int64
          slot %2 temporary: Int64
        b0: # acme/app/src/main.trb:9 body
          %1 = constant s_literal__Int64_2
          %2 = call t_acme_x2f_app_main_Grid_at(%0 borrowed, %1 borrowed) at acme/app/src/main.trb:10:3
          return %2 borrowed
        }""",
    )
  }

  /** `at` mentions `Self` nowhere but as its receiver, so it is an ordinary member of the table of a trait-typed value. */
  test "an index on a trait-typed value goes through the table it carries" {
    const source = raw"""
      type Grid with Indexed<Int, Int> {
        base: Int

        fn at(key: Int): Int {
          base + key
        }
      }

      fn cell(grid: Indexed<Int, Int>): Int {
        grid[2]
      }

      fn used(): Int {
        cell(Grid(1)) + cell(Other())
      }

      type Other with Indexed<Int, Int> {
        fn at(key: Int): Int {
          key
        }
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_cell") == raw"""
        fn t_acme_x2f_app_main_cell(grid: Object(Indexed<Int64, Int64>) borrowed) -> Int64 {
          slot %0 parameter grid: Object(Indexed<Int64, Int64>)
          slot %1 temporary: Int64
          slot %2 temporary: Int64
        b0: # acme/app/src/main.trb:9 body
          %1 = constant s_literal__Int64_2
          %2 = callWitness value %0 bound 0 member 0(%1 borrowed)
          return %2 borrowed
        }""",
    )
  }

  /**
   * `a[key] = value` is a call of `MutableIndexed.set` and no `Write`: what a missing key does is then the container's own
   * answer - a list panics out of range and a map inserts - and no rule of the back end. The key is lowered before the
   * value, because a place's own subexpressions are always lowered before the value that is written through it.
   */
  test "a write through an index is the `set` the container provides, the key before the value" {
    const source = "fn write(var items: ArrayList<Int>) \{\n  items[0] = 1\n\}"
    assert(
      irOf(source, "t_acme_x2f_app_main_write") == raw"""
        fn t_acme_x2f_app_main_write(var items: List(Int64) borrowed) -> Void {
          slot %0 parameter items: List(Int64)
          slot %1 temporary: Int64
          slot %2 temporary: Int64
          slot %3 temporary: Void
        b0: # acme/app/src/main.trb:1 body
          %1 = constant s_literal__Int64_0
          %2 = constant s_literal__Int64_1
          call n_std_x2f_prelude_types_MutableIndexed_set__List_Int64_Int64_Int64_x24_site(&%0 borrowed, %1 borrowed, %2 borrowed) at acme/app/src/main.trb:2:3
          return
        }""",
    )
  }
}

/** The container these tests index into: a type of the program, so the `at` and the `set` in the IR are its own. */
const indexedContainer = raw"""
  type Cell {
    var value: Int
  }

  type Row with MutableIndexed<Int, Cell> {
    var only: Cell

    fn at(key: Int): Cell {
      only
    }

    var fn set(key: Int, value: Cell) {
      only = value
    }
  }
  """

fn indexedProgram(body: String): String {
  "{indexedContainer}\n{body}"
}

/**
 * A `var` path **through** `a[key]`: `points[0].x = 100`, `counters[1].increment()` and `bumped items[0]` all change an
 * element of a container, and the concept's own model of that is "take it out, change it, put it back" (`var` Paths).
 *
 * The two halves are two members the language already has - `Indexed.at` takes the element out and `MutableIndexed.set`
 * puts it back - so nothing about an index path is a decision of the back end, and it works for a **trait-typed**
 * container (`List<Int>`, `Map<String, Int>`), which is what the compiler itself is full of and what no
 * `Instruction.TakeOut` could reach: a witness table says which members a value has and never that it is a `torb_list`.
 */
group "a `var` path through `a[key]`" {
  /**
   * The element is read out of the container into a slot of the frame, written there, and put back - and the **value**
   * of the assignment is lowered before any of that, because the take-out is part of the access and an access begins
   * once everything the assignment needs has been evaluated (BACKEND 2.3).
   */
  test "a field of an element is a write to a slot of the frame, between the `at` and the `set`" {
    const source = indexedProgram(raw"""
      fn writeField(var row: Row) {
        row[0].value = 5
      }
      """)
    assert(
      irOf(source, "t_acme_x2f_app_main_writeField") == raw"""
        fn t_acme_x2f_app_main_writeField(var row: Record(T_acme_x2f_app_main_Row) borrowed) -> Void {
          slot %0 parameter row: Record(T_acme_x2f_app_main_Row)
          slot %1 temporary: Int64
          slot %2 temporary: Int64
          slot %3 temporary: Record(T_acme_x2f_app_main_Row)
          slot %4 temporary: Record(T_acme_x2f_app_main_Cell)
          slot %5 temporary: Void
        b0: # acme/app/src/main.trb:17 body
          %1 = constant s_literal__Int64_0
          %2 = constant s_literal__Int64_5
          %3 = read %0
          %4 = call t_acme_x2f_app_main_Row_at(%3 borrowed, %1 borrowed) at acme/app/src/main.trb:18:3
          write %4.value = %2 borrowed
          call t_acme_x2f_app_main_Row_set(&%0 borrowed, %1 borrowed, %4 borrowed) at acme/app/src/main.trb:18:3
          return
        }""",
    )
  }

  /**
   * A `var` argument through an index: the callee gets the address of the element's own slot, which is what makes
   * `List.update`'s `change self[index]` an ordinary place - and the put-back is what makes the change reach the list.
   */
  test "a `var` argument through an index is the address of the element the frame holds" {
    const source = indexedProgram(raw"""
      fn bumped(var value: Int) {
        value = value + 1
      }

      fn writeArgument(var row: Row) {
        bumped row[0].value
      }
      """)
    assert(
      irOf(source, "t_acme_x2f_app_main_writeArgument") == raw"""
        fn t_acme_x2f_app_main_writeArgument(var row: Record(T_acme_x2f_app_main_Row) borrowed) -> Void {
          slot %0 parameter row: Record(T_acme_x2f_app_main_Row)
          slot %1 temporary: Int64
          slot %2 temporary: Record(T_acme_x2f_app_main_Row)
          slot %3 temporary: Record(T_acme_x2f_app_main_Cell)
          slot %4 temporary: Void
        b0: # acme/app/src/main.trb:21 body
          %1 = constant s_literal__Int64_0
          %2 = read %0
          %3 = call t_acme_x2f_app_main_Row_at(%2 borrowed, %1 borrowed) at acme/app/src/main.trb:22:10
          call t_acme_x2f_app_main_bumped(&%3.value borrowed) at acme/app/src/main.trb:22:3
          call t_acme_x2f_app_main_Row_set(&%0 borrowed, %1 borrowed, %3 borrowed) at acme/app/src/main.trb:22:10
          return
        }""",
    )
  }

  /**
   * `grid[y][x] = v`: **both keys are lowered first**, in source order, then the value, and only then does the access
   * begin - the take-out of the row is part of it (BACKEND 2.3). The put-backs run innermost first: the row has to be
   * back in the sheet after the cell is back in the row, or the change would be lost.
   */
  test "the nested case evaluates every key first and puts the elements back innermost first" {
    const source = raw"""
      type Cell {
        var value: Int
      }

      type Row with MutableIndexed<Int, Cell> {
        var only: Cell

        fn at(key: Int): Cell {
          only
        }

        var fn set(key: Int, value: Cell) {
          only = value
        }
      }

      type Sheet with MutableIndexed<Int, Row> {
        var only: Row

        fn at(key: Int): Row {
          only
        }

        var fn set(key: Int, value: Row) {
          only = value
        }
      }

      fn write(var sheet: Sheet) {
        sheet[1][2] = Cell(3)
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_write") == raw"""
        fn t_acme_x2f_app_main_write(var sheet: Record(T_acme_x2f_app_main_Sheet) borrowed) -> Void {
          slot %0 parameter sheet: Record(T_acme_x2f_app_main_Sheet)
          slot %1 temporary: Int64
          slot %2 temporary: Int64
          slot %3 temporary: Int64
          slot %4 temporary: Record(T_acme_x2f_app_main_Cell)
          slot %5 temporary: Record(T_acme_x2f_app_main_Sheet)
          slot %6 temporary: Record(T_acme_x2f_app_main_Row)
          slot %7 temporary: Void
        b0: # acme/app/src/main.trb:29 body
          %1 = constant s_literal__Int64_1
          %2 = constant s_literal__Int64_2
          %3 = constant s_literal__Int64_3
          %4 = construct T_acme_x2f_app_main_Cell (%3 borrowed)
          %5 = read %0
          %6 = call t_acme_x2f_app_main_Sheet_at(%5 borrowed, %1 borrowed) at acme/app/src/main.trb:30:3
          call t_acme_x2f_app_main_Row_set(&%6 borrowed, %2 borrowed, %4 borrowed) at acme/app/src/main.trb:30:3
          call t_acme_x2f_app_main_Sheet_set(&%0 borrowed, %1 borrowed, %6 borrowed) at acme/app/src/main.trb:30:3
          return
        }""",
    )
  }
}

group "which of the three shapes a literal is" {
  /**
   * The checker decides it and records it at the literal's span, so the back end reads the decision. `Default` - the
   * collection the literal's own type names, item by item - and a list literal built through `from` are lowered; an
   * `Array` says what it waits for instead of building the wrong container. The one built through `from` hands an
   * `ArrayList` over as an `Iterate`, whose table this test prelude cannot build, so the conformance program
   * `literal-through-from.trb` is what pins it.
   */
  test "a literal that fills an `Array` is one `arrayNew` of its items in written order" {
    assert(
      irOf("fn fixed(): Array<Int, 2> \{\n  [1, 2]\n\}", "t_acme_x2f_app_main_fixed") == raw"""
        fn t_acme_x2f_app_main_fixed() -> Array(Int64, 2) {
          slot %0 temporary: Int64
          slot %1 temporary: Int64
          slot %2 temporary: Array(Int64, 2)
        b0: # acme/app/src/main.trb:1 body
          %0 = constant s_literal__Int64_1
          %1 = constant s_literal__Int64_2
          %2 = arrayNew (%0 borrowed, %1 borrowed)
          return %2 borrowed
        }""",
    )
  }
}

group "a range as a value" {
  /**
   * A `Range` is an ordinary record - the one `native type` that declares fields and is no `RuntimeKind` (5.1's note) -
   * so a range literal is one `Construct` of the ends that were written. Nothing is optional: which ends a range has is
   * its type.
   */
  test "a range with both ends is one `Construct` of the two ends and the flag" {
    const source = raw"""
      fn span(): Range<Int> {
        3..7
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_span") == raw"""
        fn t_acme_x2f_app_main_span() -> Record(T_std_x2f_prelude_types_Range__Int64) {
          slot %0 temporary: Int64
          slot %1 temporary: Int64
          slot %2 temporary: Bool
          slot %3 temporary: Record(T_std_x2f_prelude_types_Range__Int64)
        b0: # acme/app/src/main.trb:1 body
          %0 = constant s_literal__Int64_3
          %1 = constant s_literal__Int64_7
          %2 = constant s_literal__Bool_false
          %3 = construct T_std_x2f_prelude_types_Range__Int64 (%0 borrowed, %1 borrowed, %2 borrowed)
          return %3 borrowed
        }""",
    )
  }

  /** `3..` builds a `RangeFrom` of one field, `..=7` a `RangeTo` of an end and the flag. */
  test "the open forms build their own types, with only the fields they have" {
    const open = irOf "fn span(): RangeFrom<Int> \{\n  3..\n\}", "t_acme_x2f_app_main_span"
    assert open.contains("%1 = construct T_std_x2f_prelude_types_RangeFrom__Int64 (%0 borrowed)")
    assert(!open.contains("Bool"))
    const upTo = irOf "fn span(): RangeTo<Int> \{\n  ..=7\n\}", "t_acme_x2f_app_main_span"
    assert upTo.contains("%1 = constant s_literal__Bool_true")
    assert upTo.contains("%2 = construct T_std_x2f_prelude_types_RangeTo__Int64 (%0 borrowed, %1 borrowed)")
  }
}

const walked = raw"""
  type Counting with Iterator<Int> {
    var seen: Int = 0

    var fn next(): Int? {
      seen = seen + 1
      if seen > 3 { None } else { Some(seen) }
    }
  }

  type Three with Iterate<Int> {
    fn iterate(): Iterator<Int> {
      Counting()
    }
  }

  fn total(values: Three): Int {
    var sum = 0
    for value in values {
      sum = sum + value
    }
    sum
  }
  """

group "`for` over a collection" {
  /**
   * The shape of BACKEND 1.6: the subject once into a slot, `iterate()` on it, and a loop head that pulls `next()` and
   * switches on the `Option`. The cursor is a **local of this frame**, because `next(var self)` writes through it - so the
   * receiver is a place and goes through the ordinary place machinery.
   */
  test "the subject is evaluated once, the cursor is a `var` local, and the head switches on the `Option`" {
    assert(unsupportedIn(walked) == [])
    assert(
      irOf(walked, "t_acme_x2f_app_main_total") == raw"""
        fn t_acme_x2f_app_main_total(values: Record(T_acme_x2f_app_main_Three) borrowed) -> Int64 {
          slot %0 parameter values: Record(T_acme_x2f_app_main_Three)
          slot %1 local sum: Int64
          slot %2 local iterator: Record(T_acme_x2f_app_main_Counting)
          slot %3 local value: Int64
          slot %4 temporary: Variant(T_std_x2f_prelude_types_Option__Int64)
          slot %5 temporary: Int64
        b0: # acme/app/src/main.trb:16 body
          %1 = constant s_literal__Int64_0
          %2 = call t_acme_x2f_app_main_Three_iterate(%0 borrowed) at acme/app/src/main.trb:18:3
          jump b1
        b1: # acme/app/src/main.trb:18 for
          %4 = call t_acme_x2f_app_main_Counting_next(&%2 borrowed) at acme/app/src/main.trb:18:3
          %5 = tag %4
          switch %5 case 0 b2, otherwise b3
        b2: # acme/app/src/main.trb:18 body
          %3 = read %4.Some.value
          %1 = intrinsic add.i64 %1, %3 at acme/app/src/main.trb:19:11
          jump b1
        b3: # acme/app/src/main.trb:18 done
          return %1 borrowed
        }""",
    )
  }

  /** `continue` pulls the next value and `break` leaves, so neither needs a step block the way a counter does. */
  test "`continue` jumps to the head and `break` to the block after the loop" {
    const source = raw"""
      type Counting with Iterator<Int> {
        var seen: Int = 0

        var fn next(): Int? {
          seen = seen + 1
          if seen > 3 { None } else { Some(seen) }
        }
      }

      type Three with Iterate<Int> {
        fn iterate(): Iterator<Int> {
          Counting()
        }
      }

      fn total(values: Three): Int {
        var sum = 0
        for value in values {
          if value == 2 {
            continue
          }
          if value == 3 {
            break
          }
          sum = sum + value
        }
        sum
      }
      """
    // `continue` is `jump b1` - the head, where the next value is pulled - and `break` is `jump b3`, the block after it
    assert(
      irOf(source, "t_acme_x2f_app_main_total") == raw"""
        fn t_acme_x2f_app_main_total(values: Record(T_acme_x2f_app_main_Three) borrowed) -> Int64 {
          slot %0 parameter values: Record(T_acme_x2f_app_main_Three)
          slot %1 local sum: Int64
          slot %2 local iterator: Record(T_acme_x2f_app_main_Counting)
          slot %3 local value: Int64
          slot %4 temporary: Variant(T_std_x2f_prelude_types_Option__Int64)
          slot %5 temporary: Int64
          slot %6 temporary: Int64
          slot %7 temporary: Bool
          slot %8 temporary: Void
          slot %9 temporary: Int64
          slot %10 temporary: Bool
        b0: # acme/app/src/main.trb:16 body
          %1 = constant s_literal__Int64_0
          %2 = call t_acme_x2f_app_main_Three_iterate(%0 borrowed) at acme/app/src/main.trb:18:3
          jump b1
        b1: # acme/app/src/main.trb:18 for
          %4 = call t_acme_x2f_app_main_Counting_next(&%2 borrowed) at acme/app/src/main.trb:18:3
          %5 = tag %4
          switch %5 case 0 b2, otherwise b3
        b2: # acme/app/src/main.trb:18 body
          %3 = read %4.Some.value
          %6 = constant s_literal__Int64_2
          %7 = intrinsic equal.i64 %3, %6 at acme/app/src/main.trb:19:8
          branch %7 then b4 else b5
        b3: # acme/app/src/main.trb:18 done
          return %1 borrowed
        b4: # acme/app/src/main.trb:19 then
          jump b1
        b5: # acme/app/src/main.trb:19 join
          %9 = constant s_literal__Int64_3
          %10 = intrinsic equal.i64 %3, %9 at acme/app/src/main.trb:22:8
          branch %10 then b6 else b7
        b6: # acme/app/src/main.trb:22 then
          jump b3
        b7: # acme/app/src/main.trb:22 join
          %1 = intrinsic add.i64 %1, %3 at acme/app/src/main.trb:25:11
          jump b1
        }""",
    )
  }

  /**
   * A counted item is read into the same slot every round, so the round's own value has to die before the next `Read`
   * overwrites it. Nothing in the `for` arranges that: the `Read` *defines* the slot at the head, so the item is not live
   * on the back edge and the drop lands on it like any other edge drop (BACKEND 2.2 step 5).
   */
  test "a counted item is released on the back edge, and the cursor once after the loop" {
    const source = raw"""
      type Texts with Iterator<String> {
        var seen: Int = 0
        var tag: String = "a"

        var fn next(): String? {
          seen = seen + 1
          if seen > 2 { None } else { Some(tag) }
        }
      }

      type Two with Iterate<String> {
        fn iterate(): Iterator<String> {
          Texts()
        }
      }

      fn lengths(values: Two): Int {
        var total = 0
        for text in values {
          total = total + text.byteLength()
        }
        total
      }
      """
    const shown = ownedIrOf source, "t_acme_x2f_app_main_lengths"
    assert shown.contains("b2: # acme/app/src/main.trb:19 body")
    assert shown.contains("release %3")
    assert shown.contains("release %2")
  }
}
