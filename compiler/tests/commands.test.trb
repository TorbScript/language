/**
 * Command calls and property commands. A command on a function is an ordinary call. **A field is written only with
 * `=`** (2026-09-25), everywhere, including inside a receiver closure: a command call that used to write a field
 * (`port 8080`, `onStart { ... }`) is now an error whose fix is reconstructed from what was written. The one command
 * call that still reaches a field is a trailing block on a field whose value is a record, never a function
 * (`database { url = "..." }`): it configures the field's value in place. Parentheses always call.
 *
 * What the surviving property command records is `Resolution.PropertyWrite(owner, field)` at the span of the
 * command, which is what the lowering reads instead of looking at a name a second time.
 *
 * The declaration comes *after* the body in these sources, because `spanOf` finds the first occurrence of a text.
 */

use test, group from "std/test"
use probe, problems, notes, problemsOf, notesOf from "./harness"

/** The vocabulary of the tests: fields of every shape, one method, and a function that takes a receiver closure. */
const options = "\ntype Limits \{\n  var maxConnections: Int = 100\n\}\n\n"
  + "type Level \{\n  case Debug\n  case Info\n\}\n\n"
  + "type Options \{\n  var host: String = \"\"\n  var port: Int = 8080\n  var tls: Bool = false\n"
  + "  var limits: Limits = Limits()\n  limits2: Limits = Limits()\n  var level: Level = .Info\n"
  + "  var onStart: () => Void = \{\}\n  label: String = \"\"\n\n"
  + "  var fn route(path: String, to: String) \{\}\n\n"
  + "  var fn tags(...names: String) \{\}\n\}\n\n"
  + "fn serve(configure: (var self: Options) => Void): Options \{\n"
  + "  var found = Options()\n  configure(found)\n  found\n\}\n"

/** One receiver closure over `Options`, with the body the test is about. */
fn inServe(body: String): String {
  "fn probe() \{\n  const made = serve \{\n{body}\n  \}\n\}\n{options}"
}

group "A command call of a function" {
  test "a method of the receiver is called, with the receiver put back" {
    const source = inServe "    route \"/health\", to: \"health\""
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.resolutionOf("route \"/health\", to: \"health\"") == "call route")
    assert(probed.adaptationsOf("route") == ["self self"])
    assert(probed.typeOf("route \"/health\", to: \"health\"") == "Void")
  }

  test "a variadic method collects the arguments of the command: `authors \"a\", \"b\"`" {
    const source = inServe "    tags \"one\", \"two\""
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.resolutionOf("tags \"one\", \"two\"") == "call tags")
    assert(probed.adaptationsOf("tags \"one\", \"two\"") == ["variadic String from 0"])
  }

  test "a function in a field is called with parentheses and assigned with `=`" {
    const source = inServe "    onStart()"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("onStart()") == "Void")
  }

  test "an `if` may start a command argument, so a value can be computed" {
    const source = inServe "    tags if tls \{ \"secure\" \} else \{ \"open\" \}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.resolutionOf("tags if tls \{ \"secure\" \} else \{ \"open\" \}") == "call tags")
  }
}

group "A field is written only with `=`" {
  test "`port 8080` is an error: the fix is the assignment it used to mean" {
    const source = inServe "    port 9000"
    assert(problems(source) == ["`port` is a field: write `port = 9000`"])
  }

  test "the fix quotes the value exactly as it was written, whatever its type" {
    assert(problems(inServe("    port \"9000\"")) == ["`port` is a field: write `port = \"9000\"`"])
  }

  test "`onStart \{ ... \}` is an error: the fix is `onStart = \{ ... \}`" {
    const source = inServe "    onStart \{ \}"
    assert(problems(source) == ["`onStart` is a field: write `onStart = \{ \}`"])
  }

  test "a misspelled field is an unknown name, not a command" {
    assert(problems(inServe("    prot 9000")) == ["Cannot find `prot` here"])
  }

  test "a field with more than one argument still names the whole write" {
    assert(problems(inServe("    port 1, 2")) == ["`port` is a field: write `port = 1, 2`"])
  }

  test "a field that holds a function is written the same way as any other" {
    assert(problems(inServe("    onStart 1, 2")) == ["`onStart` is a field: write `onStart = 1, 2`"])
  }

  test "a field that is not a `var` is still the removed-write error, not a mutability one" {
    // The write form is gone regardless of whether the field could have been written at all: one root cause
    assert(problems(inServe("    label \"a\"")) == ["`label` is a field: write `label = \"a\"`"])
  }

  test "with `=` the write reaches the field, and a `const` one is rejected the way an assignment is" {
    assert problems(inServe("    port = 9000")).isEmpty()
    assert(problems(inServe("    label = \"a\"")) == ["`label` never changes after construction"])
  }
}

group "Property commands: the block that is left" {
  test "a block on a field whose type is a function is an error, not an assignment" {
    const source = inServe "    onStart \{ print \"started\" \}"
    assert(problems(source) == ["`onStart` is a field: write `onStart = \{ print \"started\" \}`"])
  }

  test "a field is readable where it is written" {
    const source = inServe "    host = \"\{port\}\""
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.resolutionOf("port") == "field Options.port")
  }

  test "a block on a field whose type is a record configures it in place" {
    const source = inServe "    limits \{\n      maxConnections = 500\n    \}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.resolutionOf("limits \{\n      maxConnections = 500\n    \}") == "configure Options.limits")
    assert(probed.typeOf("\{\n      maxConnections = 500\n    \}") == "(var self: Limits) => Void")
    assert(probed.resolutionOf("maxConnections") == "field Limits.maxConnections")
  }

  test "a command through a target instead of the receiver" {
    // `made` is read afterwards: a command is a change, and a change nobody reads is a mistake of its own (design 5.3)
    const source = "fn probe() \{\n  var made = Options()\n  made.limits \{ maxConnections = 500 \}\n  print made.limits\n\}\n{options}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.resolutionOf("made.limits \{ maxConnections = 500 \}") == "configure Options.limits")
    assert(probed.adaptationsOf("limits") == [])
  }

  test "a closure that does not fit the field's configuration is reported against it" {
    assert(problems(inServe("    limits \{ a, b => a \}")) == ["This closure takes 1 parameter, 2 were written"])
  }
}

group "What a property command is not" {
  test "a field without an argument, and parentheses" {
    assert(problems(inServe("    port()")) == ["`port` is a field, and parentheses call a function"])
    assert(notes(inServe("    port()")) == ["A field is read without them: `port`"])
  }

  test "parentheses call, so a field that holds no function is not written by them" {
    const source = inServe "    tls(port == 8443)"
    assert(problems(source) == ["`tls` is a field, and parentheses call a function"])
    assert(notes(source) == ["A field is written with `=`: `tls = port == 8443`"])
    // The value is still read as the field's: one message, and the argument has its type
    const probed = probe source
    assert(probed.typeOf("port == 8443") == "Bool")
    assert problems(inServe("    tls = port == 8443")).isEmpty()
  }

  test "a closure in parentheses is handed to the function the field holds, which takes none" {
    const source = inServe "    onStart(\{ \})"
    assert(problems(source) == ["`onStart` holds a function: `onStart = \{ ... \}` assigns it, `onStart()` calls it"])
    assert problems(inServe("    onStart()")).isEmpty()
  }

  test "a block on a field that has no configuration" {
    assert(
      problems(inServe("    port \{ \}")) == ["`port` is a `Int64`, which has no configuration a block could fill"],
    )
    assert(
      notes(inServe("    port \{ \}"))
        == ["A block on a field applies a receiver closure to its value. Write `port = value` to set it"],
    )
  }

  test "a type with cases is chosen, not configured" {
    assert(
      problems(inServe("    level \{ \}")) == ["`level` is a `Level`, which has no configuration a block could fill"],
    )
  }

  test "a property command still needs a `var` path: a `const` record field cannot be configured" {
    assert(
      problems(inServe("    limits2 \{ maxConnections = 500 \}")) == ["`limits2` never changes after construction"],
    )
    assert(
      notes(inServe("    limits2 \{ maxConnections = 500 \}"))
        == ["`limits2 \{ ... \}` configures the field in place, and only a `var` field can be configured"],
    )
  }

  test "a local `var` called like a function names its type and offers the fix" {
    const source = "fn probe() \{\n  var count = 0\n  count 1\n\}"
    assert(problems(source) == ["`count` is a `Int64`, not a function"])
    assert(notes(source) == ["Did you mean `count = 1`?"])
  }

  test "a local `const` called like a function names its type, without a fix" {
    const source = "fn probe() \{\n  const count = 0\n  count 1\n\}"
    assert(problems(source) == ["`count` is a `Int64`, not a function"])
    assert notes(source).isEmpty()
  }

  test "a top-level `var` called like a function names its type and offers the fix" {
    const source = "var x = 10\nx 15\nprint x\n"
    assert(problems(source) == ["`x` is a `Int64`, not a function"])
    assert(notes(source) == ["Did you mean `x = 15`?"])
  }

  test "a top-level `const` called like a function names its type, without a fix" {
    const source = "const x = 10\nx 15\nprint x\n"
    assert(problems(source) == ["`x` is a `Int64`, not a function"])
    assert notes(source).isEmpty()
  }

  test "the fix is only offered for exactly one argument" {
    const source = "fn probe() \{\n  var count = 0\n  count 1, 2\n\}"
    assert(problems(source) == ["`count` is a `Int64`, not a function"])
    assert notes(source).isEmpty()
  }
}

/**
 * A property command asks `place.trb` the very same question an assignment does: the path has to be one a change may
 * go through, the place is recorded for the lowering, and the change counts for the dead-change rule.
 */
group "A property command is a place that is written" {
  const account = "\npublic type Account \{\n  protected var balance: Int = 0\n\n"
    + "  var fn deposit(amount: Int) \{\n    balance = balance + amount\n  \}\n\}\n"

  test "the place the command writes is recorded under the span of the field" {
    const source = "fn probe() \{\n  var made = Options()\n  made.limits \{ maxConnections = 500 \}\n  print made.limits\n\}\n{options}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.placeOf("made.limits") == "local made.limits")
  }

  test "a command through a `const` binding changes nothing" {
    const source = "fn probe() \{\n  const made = Options()\n  made.limits \{ maxConnections = 500 \}\n  print made.limits\n\}\n{options}"
    assert(problems(source) == ["`made` is a `const`. Only a `var` binding can be changed"])
  }

  test "a `protected var` field is written by `=` in the file of its type and by nobody else" {
    assert problems("{account}fn probe() \{\n  var held = Account()\n  held.deposit(1)\n  print held.balance\n\}").isEmpty()
    // `private` reaches as far as the file that declares it, so "outside" is a second file
    const outside = [
      "app/src/account.trb": account,
      "app/src/main.trb": "use Account from \"./account\"\n\nfn probe(var held: Account) \{\n  held.balance = 10\n\}",
    ]
    assert(problemsOf(outside) == ["`balance` is write-protected: only the file that declares `Account` writes it"])
    assert(
      notesOf(outside)
        == ["A `protected var` field is read everywhere and written in its own file alone: a `var fn` of the type changes it"]
    )
  }

  test "a command nothing reads afterwards is a dead change like any other" {
    const source = "fn probe() \{\n  var made = Options()\n  made.limits \{ maxConnections = 500 \}\n\}\n{options}"
    assert(problems(source) == ["This change has no effect: `made` is never read again"])
  }
}

group "The first argument of a command" {
  test "a case keeps its dot, and `.` is not the start of a command argument (gap 42)" {
    const source = inServe "    level .Debug"
    assert(problems(source) == ["`Level` has no member `Debug`"])
    assert(
      notes(source)
        == [
          "`Debug` is a case of `Level`. The first argument of a command may not start with `.`, so"
            + " `setting .Debug` is the member `setting.Debug`: write `setting = .Debug`",
        ],
    )
  }

  test "with `=` the case is what it looks like, and parentheses call" {
    const source = inServe "    level = .Debug"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf(".Debug") == "Level")
    const called = inServe "    level(.Debug)"
    assert(problems(called) == ["`level` is a field, and parentheses call a function"])
  }

  test "a case after a function is a member of it, and the message is the call to write" {
    const source = inServe "    tags .Debug"
    assert(problems(source) == ["`tags` is a function, and `.Debug` right after it is a member of it"])
    assert(
      notes(source)
        == [
          "The first argument of a command may not start with `.`, whatever whitespace stands before it: write"
            + " `tags(.Debug)`",
        ],
    )
  }

  test "a first argument that starts with `-` or `[` is a subtraction or an index, and the message says so" {
    const negative = "fn probe(var items: List<Int>, amount: Int) \{\n  items.append -amount\n\}"
    assert(problems(negative) == ["`items.append` is a function, and `items.append -amount` subtracts from it"])
    assert(
      notes(negative)
        == [
          "The first argument of a command may not start with `-`, so this reads as a subtraction: write"
            + " `items.append(-amount)`",
        ],
    )
    const indexed = "fn probe(var items: List<List<Int>>) \{\n  items.append [1]\n\}"
    assert(problems(indexed) == ["`items.append` is a function, and `[...]` right after it indexes it"])
    assert(notes(indexed) == ["The first argument of a command may not start with `[`: write `items.append([...])`"])
  }
}
