/**
 * Calls: which function a call reaches, in which order its arguments are evaluated, and where the instance it reaches
 * came from.
 *
 * The two questions these tests exist for are the ones a back end must never decide for itself: **source order**
 * (the receiver first, then the written arguments in the order they are written, then the defaults in declaration
 * order) and **which target** - a function of the program, an intrinsic, or a function of the runtime.
 */

use test, group from "std/test"
use irOf, textOf, countsOf, unsupportedIn from "./lower-harness"
use preludeSource from "./harness"

const declarations = r"""
  fn connect(host: String, port: Int = 5432, retries: Int = 1): Int {
    port + retries
  }

  fn positional(): Int {
    connect("a")
  }

  fn labeled(): Int {
    connect(retries: 3, host: "b")
  }
  """

group "The argument plan" {
  test "a default is evaluated at the call site, after the written arguments" {
    assert(
      irOf(declarations, "t_acme_x2f_app_main_positional") == r"""
        fn t_acme_x2f_app_main_positional() -> Int64 {
          slot %0 temporary: String
          slot %1 temporary: Int64
          slot %2 temporary: Int64
          slot %3 temporary: Int64
        b0: # acme/app/src/main.trb:5 body
          %0 = constant s_literal__String_a
          %1 = constant s_literal__Int64_5432
          %2 = constant s_literal__Int64_1
          %3 = call t_acme_x2f_app_main_connect(%0 borrowed, %1 borrowed, %2 borrowed) at acme/app/src/main.trb:6:3
          return %3 borrowed
        }"""
    )
  }

  test "labeled arguments are evaluated in written order and passed in declaration order" {
    assert(
      irOf(declarations, "t_acme_x2f_app_main_labeled") == r"""
        fn t_acme_x2f_app_main_labeled() -> Int64 {
          slot %0 temporary: Int64
          slot %1 temporary: String
          slot %2 temporary: Int64
          slot %3 temporary: Int64
        b0: # acme/app/src/main.trb:9 body
          %0 = constant s_literal__Int64_3
          %1 = constant s_literal__String_b
          %2 = constant s_literal__Int64_5432
          %3 = call t_acme_x2f_app_main_connect(%1 borrowed, %2 borrowed, %0 borrowed) at acme/app/src/main.trb:10:3
          return %3 borrowed
        }"""
    )
  }

  test "a call whose result is `Void` takes no slot, and the caller still returns" {
    const source = r"""
      fn note(value: Int) {
        const doubled = value + value
      }

      fn caller() {
        note(1)
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_caller") == r"""
        fn t_acme_x2f_app_main_caller() -> Void {
          slot %0 temporary: Int64
          slot %1 temporary: Void
        b0: # acme/app/src/main.trb:5 body
          %0 = constant s_literal__Int64_1
          call t_acme_x2f_app_main_note(%0 borrowed) at acme/app/src/main.trb:6:3
          return
        }"""
    )
  }
}

group "Methods of a concrete type" {
  test "the receiver is the first parameter, and a member of `self` without it puts it back" {
    const source = r"""
      type Counter {
        value: Int

        fn plus(other: Int): Int {
          value + other
        }

        fn twice(): Int {
          plus(value)
        }
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_Counter_twice") == r"""
        fn t_acme_x2f_app_main_Counter_twice(self: Record(T_acme_x2f_app_main_Counter) borrowed) -> Int64 {
          slot %0 parameter self: Record(T_acme_x2f_app_main_Counter)
          slot %1 temporary: Int64
          slot %2 temporary: Int64
        b0: # acme/app/src/main.trb:8 body
          %1 = read %0.value
          %2 = call t_acme_x2f_app_main_Counter_plus(%0 borrowed, %1 borrowed) at acme/app/src/main.trb:9:5
          return %2 borrowed
        }"""
    )
  }

  test "a static function of a type has no receiver" {
    const source = r"""
      type Counter {
        value: Int

        static fn zero(): Counter {
          Counter(0)
        }
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_Counter_zero") == r"""
        fn t_acme_x2f_app_main_Counter_zero() -> Record(T_acme_x2f_app_main_Counter) {
          slot %0 temporary: Int64
          slot %1 temporary: Record(T_acme_x2f_app_main_Counter)
        b0: # acme/app/src/main.trb:4 body
          %0 = constant s_literal__Int64_0
          %1 = construct T_acme_x2f_app_main_Counter (%0 borrowed)
          return %1 borrowed
        }"""
    )
  }

  test "a call of a method reaches the instance, and the receiver is the value in front of the dot" {
    const source = r"""
      type Counter {
        value: Int

        fn double(): Int {
          value + value
        }
      }

      fn use1(counter: Counter): Int {
        counter.double()
      }
      """
    assert irOf(source, "t_acme_x2f_app_main_use1").contains("call t_acme_x2f_app_main_Counter_double(%0 borrowed)")
  }
}

group "The worklist of instances" {
  test "a function that calls itself finds its own instance" {
    const source = r"""
      fn factorial(value: Int): Int {
        if value <= 1 {
          return 1
        }
        value * factorial(value - 1)
      }
      """
    const text = irOf source, "t_acme_x2f_app_main_factorial"
    assert text.contains("%7 = call t_acme_x2f_app_main_factorial(%6 borrowed)")
  }

  test "two routes to the same declaration are one function of the program" {
    const source = r"""
      fn twice(value: Int): Int {
        value + value
      }

      fn first(): Int {
        twice(1)
      }

      fn second(): Int {
        twice(2)
      }
      """
    const text = textOf source
    var found = 0
    for line in text.lines() {
      if line.startsWith("fn t_acme_x2f_app_main_twice(") {
        found = found + 1
      }
    }
    assert(found == 1)
    assert(countsOf(source) == (3, 0))
  }

  test "nothing unreachable stops a reachable function: a stub is still a well typed callee" {
    const source = r"""
      fn broken(value: Int): Int {
        const items = [value]
        items.length()
      }

      fn caller(value: Int): Int {
        broken(value)
      }
      """
    assert irOf(source, "t_acme_x2f_app_main_caller").contains("call t_acme_x2f_app_main_broken(%0 borrowed)")
    const counts = countsOf source
    // `caller` is lowered and `broken` is a stub, plus whatever the witness table of a `List<Int>` brought with it
    assert(counts.0 >= 1)
    assert(counts.1 >= 1)
  }
}

/**
 * A `native` belongs to a package of the standard library, so a test about lowering one puts the declaration in the
 * test prelude instead of in `acme/app`.
 */
const withTrim = [
  "std/prelude/src/types.trb": "{preludeSource}\nextend String \{\n  native fn trim(): String\n\}\n",
]


group "Operators and natives" {
  test "an operator of a type of the program is an ordinary call of the member the implementation provides" {
    const source = r"""
      type Meters with Add {
        size: Int

        fn add(other: Meters): Meters {
          Meters(size + other.size)
        }
      }

      fn total(first: Meters, second: Meters): Meters {
        first + second
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_total") == r"""
        fn t_acme_x2f_app_main_total(first: Record(T_acme_x2f_app_main_Meters) borrowed, second: Record(T_acme_x2f_app_main_Meters) borrowed) -> Record(T_acme_x2f_app_main_Meters) {
          slot %0 parameter first: Record(T_acme_x2f_app_main_Meters)
          slot %1 parameter second: Record(T_acme_x2f_app_main_Meters)
          slot %2 temporary: Record(T_acme_x2f_app_main_Meters)
        b0: # acme/app/src/main.trb:9 body
          %2 = call t_acme_x2f_app_main_Meters_add(%0 borrowed, %1 borrowed) at acme/app/src/main.trb:10:3
          return %2 borrowed
        }"""
    )
  }

  test "a `native` the manifest maps to an intrinsic is one instruction" {
    const source = r"""
      fn sizes(text: String): Int {
        text.byteLength()
      }
      """
    assert irOf(source, "t_acme_x2f_app_main_sizes").contains("intrinsic textByteLength %0 at")
  }

  test "a `native` the runtime provides is a function with a signature and no body" {
    const source = r"""
      fn empty(text: String): Bool {
        text.isEmpty()
      }
      """
    const text = textOf source
    assert(
      text.contains("runtime fn t_std_x2f_prelude_types_String_isEmpty(self: String borrowed) -> Bool = torb_text_is_empty")
    )
    assert irOf(source, "t_acme_x2f_app_main_empty").contains("call t_std_x2f_prelude_types_String_isEmpty(%0 borrowed)")
  }

  test "a chained call finds its target although the checker records the inner one as deferred" {
    const source = r"""
      fn sizes(text: String): Int {
        text.trim().byteLength()
      }
      """
    const text = irOf source, "t_acme_x2f_app_main_sizes", withTrim
    assert text.contains("call t_std_x2f_prelude_types_String_trim(%0 borrowed)")
    assert text.contains("intrinsic textByteLength %1 at")
  }
}

group "What a call cannot reach yet" {

  /** `isSame` waits for the identity of a `shared type` object: a planned entry is a finding and never a link error. */
  test "a native the runtime does not have yet is a finding instead of a link error" {
    const source = r"""
      shared type Counter {
        var count: Int = 0
      }

      fn same(first: Counter, second: Counter): Bool {
        isSame first, second
      }
      """
    assert(
      unsupportedIn(source)
        == ["`isSame` is not supported by the native back end yet: the runtime does not provide it"]
    )
  }

  test "a call of a closure value is lowered, and a call of something that is not one says so" {
    assert(unsupportedIn("fn run(step: (Int) => Int): Int \{\n  step(1)\n\}") == [])
  }
}

group "The callee is an expression" {
  /**
   * `adder(4)(1)`: a closure is an ordinary value, so anything that produces one may stand where a callee stands. The
   * parentheses of the second call belong to the value the first call answered, and asking the checker what the
   * *callee* resolved to would answer for the inner call - which would lower one call with the other's arguments.
   */
  test "a callee that is itself a call is a call of the value it answered" {
    const source = r"""
      fn adder(amount: Int): (Int) => Int {
        { value => value + amount }
      }

      fn raised(start: Int): Int {
        adder(4)(start)
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_raised") == r"""
        fn t_acme_x2f_app_main_raised(start: Int64 borrowed) -> Int64 {
          slot %0 parameter start: Int64
          slot %1 temporary: Int64
          slot %2 temporary: Closure((Int64) -> Int64)
          slot %3 temporary: Int64
        b0: # acme/app/src/main.trb:5 body
          %1 = constant s_literal__Int64_4
          %2 = call t_acme_x2f_app_main_adder(%1 borrowed) at acme/app/src/main.trb:6:3
          %3 = callClosure %2(%0 borrowed)
          return %3 borrowed
        }"""
    )
  }
}
