/**
 * The parts of `torb repl` that read and write text (docs/design/REPL.md sections 2 to 4): when the lines read so far
 * are a whole entry, what an entry is made of, and the module an entry is checked as - with every piece of it traced
 * back to the entry it came from, so that a message names the entry's own line and column.
 *
 * Running entries is `tests/repl/`: a session piped into `torb repl` against its exact output.
 */

use test, group from "std/test"
use Span from "../src/syntax/source"
use isComplete, planEntry from "../src/repl/entry"
use EntrySource, KeptDeclaration, ParameterText, Form, Shown, synthesize, blanked from "../src/repl/synthesis"
use displayedType from "../src/repl/session"
use ReadEvent, ReaderAction, actionFor from "../src/cli/repl"
use generationDisplayName from "../src/ir/lower/derive"

group "A whole entry" {
  test "a line that parses is an entry" {
    assert isComplete("const total = 1 + 2")
    assert isComplete("print total")
  }

  test "an open bracket waits for the lines that close it" {
    assert(!isComplete("fn double(value: Int): Int \{"))
    assert(!isComplete("const items = [1,"))
    assert(!isComplete("names.map(\{ name =>"))
    assert isComplete("fn double(value: Int): Int \{\n  value * 2\n}")
  }

  test "a trailing operator waits for its operand" {
    assert(!isComplete("const total = 1 +"))
    assert(!isComplete("const total ="))
  }

  test "a multi-line string and a block comment wait to be closed, a plain string does not" {
    assert(!isComplete("const text = \"\"\"\n  first"))
    assert(!isComplete("/* a comment"))
    assert isComplete("const text = \"never closed")
  }

  test "a mistake that is not at the end is complete, and the parser reports it" {
    assert isComplete("print 1\n}")
    assert isComplete("")
  }
}

group "An entry taken apart" {
  test "declarations, statements, the names it binds and the value it shows" {
    const plan = planEntry "fn double(value: Int): Int \{\n  value * 2\n}\nconst total = double(4)\nvar (low, high) = (1, 2)\ntotal + low"
    assert plan.diagnostics.isEmpty()
    assert(plan.declarations.length() == 1)
    assert(plan.declarations[0].names == ["double"])
    assert(plan.statements.length() == 3)
    assert(plan.bindings.map({ _.name }).toList() == ["total", "low", "high"])
    assert(plan.bindings.map({ _.isVar }).toList() == [false, true, true])
    assert plan.shown.isSome()
  }

  test "a statement that is not an expression shows nothing, and neither does an `if` without `else`" {
    assert planEntry("const total = 3").shown.isNone()
    assert planEntry("if true \{\n  print 1\n}").shown.isNone()
    assert planEntry("if true \{ 1 } else \{ 2 }").shown.isSome()
  }

  test "the last statement's names are shown where it binds instead of evaluating" {
    assert(planEntry("const total = 3").shownBindings == ["total"])
    assert(planEntry("var (low, high) = (1, 2)").shownBindings == ["low", "high"])
    assert planEntry("const total = 3\ntotal + 1").shownBindings.isEmpty()
    assert planEntry("using file = open()").shownBindings.isEmpty()
  }

  test "a `type` declaration is marked, unlike a `fn` or a `use`" {
    assert planEntry("type Point \{\n  x: Int\n}").declarations[0].isType
    assert(!planEntry("fn double(value: Int): Int \{\n  value * 2\n}").declarations[0].isType)
    assert(!planEntry("use File from \"std/fs\"").declarations[0].isType)
  }

  test "a `using` binding ends with its entry and is not kept" {
    assert planEntry("using file = open()").bindings.isEmpty()
  }

  test "a `use` declares the names it imports, under their aliases" {
    const plan = planEntry "use File, IoError as Problem from \"std/fs\""
    assert(plan.declarations[0].names == ["File", "Problem"])
    assert plan.declarations[0].isImport
  }

  test "a `return` at the top level is found" {
    assert planEntry("return").topLevelReturn.isSome()
  }
}

group "The module of an entry" {
  test "blanking keeps every offset and every line break" {
    const text = "fn f() \{}\nprint ä\nconst x = 1"
    const result = blanked text, [Span(10, 18)]
    assert(result.byteLength() == text.byteLength())
    assert(result == "fn f() \{}\n        \nconst x = 1")
  }

  test "the statements run in `replEntry`, the declarations stand at the top level" {
    const entry = "fn double(value: Int): Int \{\n  value * 2\n}\ndouble total"
    const plan = planEntry entry
    const sources = [EntrySource("<repl>", entry)]
    const parameters = [ParameterText("total", false, "Int")]
    const form = Form outputs: [], shown: Shown.Printed("Int")
    const synthesis = synthesize sources, [], parameters, 0, plan, form
    assert synthesis.text.contains("fn replEntry(total: Int): Void \{")
    assert synthesis.text.contains("const replShown =\ndouble total")
    // The value is shown through a nested interpolation (`"\{replShown}"`), not `replShown.show()` - a structural
    // type such as a tuple has no callable member of that name - so only its two pieces are pinned here.
    assert synthesis.text.contains("\{replShown}")
    assert synthesis.text.contains(": Int\"")
    assert synthesis.text.startsWith("fn double(value: Int): Int \{\n  value * 2\n}\n            \n")
  }

  test "a span of the module is traced back to its entry, offset for offset" {
    const entry = "const total = 3\nprint missing"
    const plan = planEntry entry
    const synthesis = synthesize([EntrySource("<repl>", entry)], [], [], 0, plan, Form())
    const at = synthesis.text.byteOffsetOf("print missing") ?? 0
    assert(synthesis.locate(Span(at + 6, at + 13)) == (0, Span(22, 29), true))
    assert(synthesis.statementOffset(0, 22) == (at + 6))
  }

  test "a declaration the session keeps is copied from its own entry" {
    const first = "type Point \{\n  x: Int\n}"
    const second = "Point(1)"
    const sources = [EntrySource("<repl>", first), EntrySource("<repl>", second)]
    const kept = [KeptDeclaration(["Point"], 0, Span(0, first.byteLength()), false)]
    const synthesis = synthesize sources, kept, [], 1, planEntry(second), Form()
    assert synthesis.text.startsWith(first)
    assert(synthesis.locate(Span(5, 10)) == (0, Span(5, 10), false))
  }

  test "the new bindings are handed out through `var` parameters, in the order they are bound" {
    const entry = "const total = 3\nvar names = [\"a\"]"
    const form = Form outputs: [("total", "Int"), ("names", "List<String>")]
    const synthesis = synthesize([EntrySource("<repl>", entry)], [], [], 0, planEntry(entry), form)
    assert synthesis.text.contains("fn replEntry(var replOut0: Int, var replOut1: List<String>): Void \{")
    assert synthesis.text.contains("replOut0 = total\nreplOut1 = names\n")
    assert(synthesis.outputSpans.map({ _.0 }).toList() == ["total", "names"])
  }

  test "a `?` at the top level makes the statements the body of a function that can fail" {
    const entry = "const text = read()?"
    const form = Form failure: "IoError", outputs: [("text", "String")]
    const synthesis = synthesize([EntrySource("<repl>", entry)], [], [], 0, planEntry(entry), form)
    assert synthesis.text.contains("fn replEntry(var replOut0: String): Bool \{\n  match replBody(replOut0) \{")
    assert synthesis.text.contains("fn replBody(var replOut0: String): Result<Void, IoError> \{")
    assert synthesis.text.contains("replOut0 = text\n}\nOk void\n}")
  }

  test "a `let`/`const`/`var` entry shows its name, before the value is handed to the session" {
    const entry = "const total = 3"
    const form = Form outputs: [("total", "Int")], shownBindings: [("total", Shown.Printed("Int"))]
    const synthesis = synthesize([EntrySource("<repl>", entry)], [], [], 0, planEntry(entry), form)
    assert synthesis.text.contains("print \"total: Int = ")
    assert synthesis.text.contains("\{total}")
    assert synthesis.text.contains("\nreplOut0 = total\n")
  }

  test "a bound value with no `Show` is shown by its type alone, without `= value`" {
    const entry = "const scaled = \{ value: Int => value * 2 }"
    const form = Form shownBindings: [("scaled", Shown.Described("(value: Int64) => Int64"))]
    const synthesis = synthesize([EntrySource("<repl>", entry)], [], [], 0, planEntry(entry), form)
    assert synthesis.text.contains("print \"scaled: (value: Int64) => Int64\"")
  }

  test "a shown type is dimmed only where the session is a terminal" {
    const entry = "1 + 2"
    const plain = synthesize(
      [EntrySource("<repl>", entry)],
      [],
      [],
      0,
      planEntry(entry),
      Form(shown: Shown.Printed("Int64")),
    )
    assert plain.text.contains("\{replShown}")
    assert plain.text.contains(": Int64\"")
    assert(!plain.text.contains("\u{1b}"))
    const colored = Form shown: Shown.Printed("Int64"), colored: true
    const dimmed = synthesize([EntrySource("<repl>", entry)], [], [], 0, planEntry(entry), colored)
    assert dimmed.text.contains("\{replShown}")
    assert dimmed.text.contains(": \u{1b}[2mInt64\u{1b}[0m\"")
  }
}

group "The type of a redeclared binding" {
  test "a generation the session mangled internally is shown with `#`" {
    assert(displayedType("Int64") == "Int64")
    assert(displayedType("Point__1") == "Point#1")
    assert(displayedType("List<Point__2>") == "List<Point#2>")
    assert(displayedType("Map<Point__1, Circle__3>") == "Map<Point#1, Circle#3>")
  }

  test "a generation's own name is what the derived `Show` of its kept declaration opens with" {
    // generationDisplayName is the one place the mangled name a generation's own declaration carries
    // (`type Point__1`) turns into what a person reads: the derived `show()` of the type builds its own literal
    // text with this, so a value never needs a later pass over the finished string - which could not tell a
    // generation's own name from the same text held as somebody's data.
    assert(generationDisplayName("Point") == "Point")
    assert(generationDisplayName("Point__1") == "Point#1")
    assert(generationDisplayName("Point__12") == "Point#12")
    assert(generationDisplayName("Point__") == "Point__")
    assert(generationDisplayName("Point__x") == "Point__x")
    assert(generationDisplayName("__1") == "__1")
  }
}

group "Ctrl+C" {
  test "idle, it gives a fresh prompt once and leaves the second time in a row" {
    assert(actionFor(ReadEvent.Interrupted, true, 0) == ReaderAction.Continue(resetIdle: false, discardPending: false))
    assert(actionFor(ReadEvent.Interrupted, true, 1) == ReaderAction.Leave)
  }

  test "while an entry is open, it discards it and does not count toward leaving" {
    assert(actionFor(ReadEvent.Interrupted, false, 0) == ReaderAction.Continue(resetIdle: true, discardPending: true))
    assert(actionFor(ReadEvent.Interrupted, false, 5) == ReaderAction.Continue(resetIdle: true, discardPending: true))
  }

  test "a line goes to the entry reader; the end of the input always leaves" {
    assert(actionFor(ReadEvent.Line("1 + 2"), true, 0) == ReaderAction.Read("1 + 2"))
    assert(actionFor(ReadEvent.EndOfInput, true, 0) == ReaderAction.Leave)
    assert(actionFor(ReadEvent.EndOfInput, false, 3) == ReaderAction.Leave)
  }
}
