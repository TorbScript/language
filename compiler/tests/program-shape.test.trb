/**
 * The shape of a program: which files may contain code, what a declaration has to say about itself, and the rules of
 * `extend`, `native`, `shared` and `foreign`.
 *
 * The rule behind most of it is the same one: whatever leaves a file has to be readable without the body behind it. A
 * `public` function declares its result type, an imported module consists of declarations only, and an `extend` adds
 * nothing a `match` or a constructor would have to know about.
 *
 * `app/src/main.trb` is the build input of the package, so it is an *entry file*: everything about a module needs a
 * second file that something imports.
 */

use test, group from "std/test"
use problems, notes, problemsOf, notesOf from "./harness"

const importsHelper = r"""
  use value from "./helper"

  fn probe(): Int {
    value
  }
  """

fn withHelper(helper: String): Map<String, String> {
  ["app/src/helper.trb": helper, "app/src/main.trb": importsHelper]
}

group "Top-level code (gap 28)" {
  test "an entry file is ordinary code" {
    const source = r"""
      const greeting = "hello"

      print greeting
      """
    assert problems(source).isEmpty()
  }

  test "a module that something imports consists of declarations only" {
    const files = withHelper(r"""
      public const value = 1

      print value
      """)
    assert(
      problemsOf(files) == ["Top-level code is only allowed in entry files. `app/src/helper.trb` is imported"]
    )
    assert(
      notesOf(files)
        == [
          "An imported module consists of declarations only, so a module has no initialization order and a cyclic"
            + " import is harmless",
        ]
    )
  }

  test "a file nothing imports is a script, whatever else is in the package" {
    const files = [
      "app/src/loose.trb": r"""
        const answer = 42

        print answer
        """,
      "app/src/main.trb": r"""
        fn probe(): Int {
          1
        }
        """,
    ]
    assert problemsOf(files).isEmpty()
  }

  test "`src/lib.trb` is what other packages import, so it is always a module" {
    const files = [
      "app/src/lib.trb": r"""
        public const answer = 42

        print answer
        """,
      "app/src/main.trb": r"""
        fn probe(): Int {
          1
        }
        """,
    ]
    assert(problemsOf(files) == ["Top-level code is only allowed in entry files. `app/src/lib.trb` is imported"])
  }

  test "a module has no mutable state, so it has no top-level `var`" {
    const files = withHelper(r"""
      public const value = 1

      var counter = 0
      """)
    assert(problemsOf(files) == ["A module has no mutable state, so it has no top-level `var`"])
    assert(notesOf(files) == ["A module exports constants. State belongs to a value that somebody owns"])
  }
}

group "A `public fn` and a trait method never infer their result" {
  test "an omitted result type is `Void`, and a body that produces nothing is legal" {
    const source = r"""
      public fn reset(var counter: Counter) {
        counter.value = 0
      }

      public type Counter {
        var value: Int = 0
      }
      """
    assert problems(source).isEmpty()
  }

  test "and it really is `Void`: nothing is inferred from the body" {
    const source = r"""
      public fn probe(): Int {
        answer()
      }

      public fn answer() {
        42
      }
      """
    assert(
      problems(source)
        == [
          "Expected `Int64`, found `Void`",
          "A `public` function does not infer its result: declare it (`: Int64`)",
        ]
    )
  }

  test "the value the body ends in is where the message points" {
    const source = r"""
      public fn answer() {
        42
      }
      """
    assert(problems(source) == ["A `public` function does not infer its result: declare it (`: Int64`)"])
    assert(
      notes(source)
        == ["Without a result type it produces `Void`, and whoever calls it must not have to read the body"]
    )
  }

  test "and so is the value a `return` produces" {
    const source = r"""
      public fn answer(flag: Bool) {
        if flag {
          return "yes"
        }
      }
      """
    assert(problems(source) == ["A `public` function does not infer its result: declare it (`: String`)"])
  }

  test "declaring it settles it" {
    const source = r"""
      public fn answer(): Int {
        42
      }
      """
    assert problems(source).isEmpty()
  }

  test "a function that is not `public` infers it as before" {
    const source = r"""
      fn answer() {
        42
      }

      fn probe(): Int {
        answer()
      }
      """
    assert problems(source).isEmpty()
  }

  test "a trait requirement without a result type produces `Void`, as the concept writes it" {
    const source = r"""
      trait Sink {
        var fn write(text: String)
      }
      """
    assert problems(source).isEmpty()
  }

  test "a default member of a trait does not infer either" {
    const source = r"""
      trait Sink {
        var fn write(text: String)

        var fn writeTwice(text: String) {
          write(text)
          text.byteLength()
        }
      }
      """
    assert(problems(source) == ["A trait method does not infer its result: declare it (`: Int64`)"])
    assert(
      notes(source)
        == ["Without a result type it produces `Void`, and whoever calls it must not have to read the body"]
    )
  }

  test "a member of a `type` still infers it" {
    const source = r"""
      type Counter {
        var value: Int = 0

        var fn step() {
          value = value + 1
        }
      }
      """
    assert problems(source).isEmpty()
  }

  test "a function without a body is a requirement of a trait or a `native` declaration" {
    const source = r"""
      type Counter {
        var fn step(): Void
      }
      """
    assert(problems(source) == ["`step` has no body"])
    assert(notes(source) == ["Only a requirement of a trait and a `native` declaration have none"])
  }
}

group "An `extend` adds constants and functions (gap 39)" {
  test "a field in an `extend` belongs to the declaration of the type" {
    const source = r"""
      extend Counter {
        var extra: Int = 0
      }

      type Counter {
        var value: Int = 0
      }
      """
    assert(problems(source) == ["An `extend` cannot add a field"])
    assert(
      notes(source)
        == ["Fields and cases belong to the declaration of the type: an `extend` adds constants and functions"]
    )
  }

  test "and so does a case" {
    const source = r"""
      extend Shape {
        case Triangle(side: Int)
      }

      type Shape {
        case Empty
      }
      """
    assert(problems(source) == ["An `extend` cannot add a case"])
    assert(
      notes(source)
        == ["Fields and cases belong to the declaration of the type, so that a `match` over it is decidable"]
    )
  }

  test "a constant and a function are what it is for" {
    const source = r"""
      extend Counter {
        static start: Int = 0

        fn doubled(): Int {
          value * 2
        }
      }

      type Counter {
        var value: Int = 0
      }
      """
    assert problems(source).isEmpty()
  }
}

group "What cannot be extended, and what has no default" {
  test "a literal type cannot be extended, with or without a trait" {
    // "That identity is structural, so a literal type has no owner and cannot be extended" (CONCEPT, "Literal Types").
    // It compiled silently, and the member it added was simply unreachable at every use
    const source = r"""
      type Status = "online" | "offline"

      extend Status {
        fn label(): String {
          "a status"
        }
      }
      """
    assert(problems(source) == ["`\"offline\" | \"online\"` cannot be extended"])
    assert(
      notes(source)
        == [
          "A literal type is the same type wherever its members are written, so it has no declaration an `extend`"
            + " could belong to. For behavior, declare a type with cases",
        ]
    )
  }

  test "a type parameter of a `fn` has no default" {
    // "`fn` has no defaults: its type arguments come from the call" (CONCEPT, "Traits"). One was parsed and then never
    // consulted, so the declaration promised something and the call still read "Cannot infer `Item`"
    const source = "fn empty<Item = String>(): Int \{\n  1\n\}"
    assert(problems(source) == ["A type parameter of a `fn` has no default"])
    assert(
      notes(source)
        == [
          "The type arguments of a call come from the call: only a `type` and a `trait` fill a default in"
            + " (`trait Add<Other = Self>`)",
        ]
    )
  }

  test "a `type` and a `trait` keep theirs (gap 6)" {
    assert problems("trait Combine<Other = Self> \{\n  fn combine(other: Other): Self\n\}").isEmpty()
    assert problems("type Holder<Item = Int> \{\n  item: Item\n\}").isEmpty()
  }
}

group "`native` belongs to the standard library (gap 22)" {
  test "a `native` function of an ordinary package" {
    const source = r"""
      native fn clock(): Int
      """
    assert(problems(source) == ["`native` is only allowed in a package of the standard library"])
    assert(
      notes(source)
        == [
          "A `native` declaration is implemented by the compiler and its runtime. Everything else is written in"
            + " TorbScript, on top of `foreign` declarations",
        ]
    )
  }

  test "a `native` type of an ordinary package" {
    const source = r"""
      public native type Handle {}
      """
    assert(problems(source) == ["`native` is only allowed in a package of the standard library"])
  }

  test "a `native` member of an ordinary package" {
    const source = r"""
      type Handle {
        native var fn close(): Void
      }
      """
    assert(problems(source) == ["`native` is only allowed in a package of the standard library"])
  }
}

group "`shared type` and `shared trait`" {
  test "a `shared type` may only implement a `shared trait`" {
    const source = r"""
      shared type Connection with Show {
        url: String

        fn show(): String {
          url
        }
      }
      """
    assert(problems(source) == ["`Connection` is a `shared type`, so it can only implement a `shared trait`"])
    assert(
      notes(source)
        == ["`Show` is not one: write `shared trait Show`, or make `Connection` an ordinary `type`"]
    )
  }

  test "a `shared trait` is what it may implement" {
    const source = r"""
      shared type Connection with Close {
        var url: String

        var fn close(): Void {
          url = ""
        }
      }
      """
    assert problems(source).isEmpty()
  }

  test "an ordinary `type` may implement a `shared trait`: `Show` is one in the real prelude" {
    const source = r"""
      type Handle with Close {
        var fn close(): Void {}
      }
      """
    assert problems(source).isEmpty()
  }

  /**
   * A `var` of a value is copy in, copy out, and the copy back happens when the call returns - before a task it
   * answered has run. For a shared object `var` is a permission and not an exclusive access, which is what lets
   * `Source.next()` answer a `Task` (docs/STREAMS.md).
   */
  test "a `var self` that answers a `Task` needs a shared type" {
    const source = r"""
      type Bag {
        var items: List<Int>

        var fn take(value: Int): Task<Int> {
          items.append(value)
          items.length()
        }
      }
      """
    assert(problems(source) == ["`take` changes `self` and answers a `Task`, and `Bag` is a value"])
    const note = "A `var` of a value is copy in, copy out, and the copy back happens when the call returns"
      + " - before the task has run. Only a `shared type` can be changed by a task"
    assert(notes(source) == [note])
  }

  test "and so does a `var` parameter that answers a `Task`" {
    const source = r"""
      fn fill(var bag: Bag, amount: Int): Task<Int> {
        amount
      }

      type Bag {
        var items: List<Int>
      }
      """
    assert(problems(source) == ["`fill` changes `bag` and answers a `Task`, and `Bag` is a value"])
  }

  test "an ordinary trait is not enough either: a value could implement it" {
    const source = r"""
      trait Counter {
        var fn bump(): Task<Int>
      }
      """
    assert(
      problems(source) == ["`bump` changes `self` and answers a `Task`, and `Counter` is not a `shared trait`"]
    )
    assert(
      notes(source)
        == [
          "An ordinary trait can be implemented by a value, and a value cannot be changed by a task:"
            + " write `shared trait Counter`",
        ]
    )
  }

  test "a `shared trait` and a `shared type` may be changed by a task" {
    const source = r"""
      shared trait Ticking {
        var fn tick(): Task<Int>
      }

      shared type Clockwork with Ticking {
        var ticks: Int

        var fn tick(): Task<Int> {
          ticks = ticks + 1
          ticks
        }
      }

      fn run(var machine: Ticking): Task<Int> {
        machine.tick().await()
      }
      """
    assert problems(source).isEmpty()
  }

  /** Two pulls in a row through one `var` binding: a shared object is never an exclusive access across an `await`. */
  test "exclusivity says nothing about two changes of one shared object in a row" {
    const source = r"""
      shared trait Ticking {
        var fn tick(): Task<Int>
      }

      fn twice(var machine: Ticking): Task<Int> {
        const first = machine.tick().await()
        const second = machine.tick().await()
        first + second
      }

      fn onward(var machine: Ticking): Task<Int> {
        const once = twice(machine).await()
        once + twice(machine).await()
      }
      """
    assert problems(source).isEmpty()
  }

  /** A wrapper pulls from a `var` field across an `await`, which is what every stage of `std/stream` does. */
  test "a `var` field of a shared object may be changed across an `await`" {
    const source = r"""
      shared trait Ticking {
        var fn tick(): Task<Int>
      }

      shared type Doubling with Ticking {
        var upstream: Ticking
        var seen: Int

        var fn tick(): Task<Int> {
          const value = upstream.tick().await()
          seen = seen + 1
          value + value
        }
      }
      """
    assert problems(source).isEmpty()
  }

  /** The shape of `Source.produce`: a closure that takes the end it writes into as a `var` parameter. */
  test "a closure may take a shared object as a `var` parameter" {
    const source = r"""
      shared trait Ticking {
        var fn tick(): Task<Int>
      }

      fn drive(var machine: Ticking, body: (var machine: Ticking) => Result<Int, String>): Task<Int> {
        body(machine).orElse(0)
      }
      """
    assert problems(source).isEmpty()
  }
}

group "`isSame` compares identity (BACKEND gap 15)" {
  test "on a value it has no meaning" {
    const source = r"""
      fn probe(first: Point, second: Point): Bool {
        isSame(first, second)
      }

      type Point {
        x: Int
        y: Int
      }
      """
    assert(problems(source) == ["`isSame` compares identity, and a `Point` is a value"])
    assert(
      notes(source)
        == ["Use `==`: two values are the same when their content is. Only a `shared type` has an identity"]
    )
  }

  test "on a `shared type` it is the whole point" {
    const source = r"""
      fn probe(first: Connection, second: Connection): Bool {
        isSame(first, second)
      }

      shared type Connection {
        url: String
      }
      """
    assert problems(source).isEmpty()
  }
}

group "`private(var)` is a modifier of a field (gap 30)" {
  test "not of a top-level declaration" {
    const source = r"""
      private(var) fn probe(): Int {
        1
      }
      """
    assert(problems(source) == ["`private(var)` is only a modifier of a field"])
    assert(
      notes(source)
        == [
          "It says that the field is readable and its `var` is not. Write `private` to hide the declaration",
        ]
    )
  }

  test "not of a constant of a type" {
    const source = r"""
      type Counter {
        private(var) static start: Int = 0
      }
      """
    assert(problems(source) == ["`private(var)` is only a modifier of a field"])
  }

  test "and it already says `var`, so a second one is a mistake" {
    const source = r"""
      type Account {
        private(var) var balance: Int = 0
      }
      """
    assert(problems(source) == ["`private(var)` already says `var`"])
    assert(
      notes(source)
        == [
          "`private(var) balance: ...` is the whole spelling: the field is readable, its `var` is not",
        ]
    )
  }
}

group "Defaults are evaluated without a receiver (gap 26)" {
  test "a field default cannot read `self`" {
    const source = r"""
      type Box {
        width: Int = 1
        height: Int = self.width
      }
      """
    assert(problems(source) == ["There is no `self` here"])
    assert(
      notes(source)
        == [
          "`self` exists in a method and in a receiver closure. A default is evaluated without one, so that the"
            + " order of the fields is not observable",
        ]
    )
  }

  test "a field default cannot read another field" {
    const source = r"""
      type Box {
        width: Int = 1
        height: Int = width
      }
      """
    assert(problems(source) == ["A field default cannot read the field `width`"])
    assert(
      notes(source)
        == [
          "Every default is evaluated on its own, so the order of the fields is not observable. A value that is"
            + " computed from another field is made by a `static fn` factory",
        ]
    )
  }

  test "a parameter default cannot read another parameter" {
    const source = r"""
      fn connect(host: String, port: Int = host.byteLength()): String {
        host
      }
      """
    assert(problems(source) == ["Cannot find `host` here"])
  }

  test "a default of a literal, of a constructor call and of a constant of the file is fine" {
    const source = r"""
      const standardPort = 5432

      fn connect(host: String = "localhost", port: Int = standardPort, limits: Limits = Limits()): String {
        host
      }

      type Limits {
        var maximum: Int = 10
      }
      """
    assert problems(source).isEmpty()
  }
}

group "The parameters and the top level of a body are one scope" {
  test "a `const` of the body cannot shadow a parameter" {
    const source = r"""
      fn probe(value: Int): Int {
        const value = value + 1
        value
      }
      """
    assert(problems(source) == ["`value` is already a parameter of this function"])
    assert(
      notes(source)
        == [
          "The parameters and the top level of the body are one scope, so nothing there can shadow a parameter",
        ]
    )
  }

  test "a nested block may shadow, as everywhere else" {
    const source = r"""
      fn probe(value: Int): Int {
        if value > 0 {
          const value = 2
          print value
        }
        value
      }
      """
    assert problems(source).isEmpty()
  }

  test "a closure has parameters of its own" {
    const source = r"""
      fn probe(value: Int): Int {
        const step: (Int) => Int = { value => value + 1 }
        step(value)
      }
      """
    assert problems(source).isEmpty()
  }
}

/**
 * "A type has **one namespace** of members" (CONCEPT.md, "Members"): a field, a `const`, a `fn` and a case all live in
 * it. Two of them with one name left the second unreachable - whichever one the lookup order found first won.
 */
group "One namespace of members" {
  test "a field and a method cannot share a name" {
    const source = r"""
      type Report {
        title: String

        fn title(): String {
          "untitled"
        }
      }
      """
    assert(problems(source) == ["`title` is already declared in `Report`"])
    assert(
      notes(source)
        == [
          "A type has one namespace of members: a field, a `const`, a `fn` and a case cannot share a name",
          "That holds for a `private` field as well: making a field private or public must not change what a caller"
            + " writes, so one of the two needs another name",
        ]
    )
  }

  test "two fields cannot either" {
    const source = r"""
      type Report {
        title: String
        title: Int
      }
      """
    assert(problems(source) == ["`title` is already declared in `Report`"])
  }

  test "a `const` and a `fn` cannot either" {
    const source = r"""
      type Report {
        static width = 2

        fn width(): Int {
          3
        }
      }
      """
    assert(problems(source) == ["`width` is already declared in `Report`"])
  }

  test "and neither can two members of a trait" {
    const source = r"""
      trait Sized {
        fn size(): Int

        fn size(unit: String): Int
      }
      """
    assert(problems(source) == ["`size` is already declared in `Sized`"])
  }

  test "a field of a case is not a member of the type, so it may be named like one" {
    const source = r"""
      type Shape {
        case Circle(radius: Int)
        case Square(radius: Int)

        fn radius(): Int {
          match self {
            .Circle(value) => value
            .Square(value) => value
          }
        }
      }
      """
    assert problems(source).isEmpty()
  }
}

group "A `static fn` is reached through the type" {
  const rectangle = r"""
    type Rectangle {
      width: Int
      height: Int

      static fn square(size: Int): Rectangle {
        Rectangle(size, size)
      }
    }
    """

  test "an instance is not a way to it" {
    const source = "{rectangle}\nfn probe(rectangle: Rectangle): Int \{\n  rectangle.square(5).width\n\}"
    assert(problems(source) == ["`square` is `static`: call it as `Rectangle.square(...)`"])
    assert(
      notes(source) == ["A `static` member belongs to the type, and a value of it is not a way to the type"]
    )
  }

  test "the type is" {
    const source = "{rectangle}\nfn probe(): Int \{\n  Rectangle.square(5).width\n\}"
    assert problems(source).isEmpty()
  }

  test "a method is reached through the value" {
    const source = r"""
      type Rectangle {
        width: Int
        height: Int

        fn area(): Int {
          width * height
        }
      }

      fn probe(rectangle: Rectangle): Int {
        rectangle.area()
      }
      """
    assert problems(source).isEmpty()
  }

  test "the type is not a way to a method, and the message names the two ways out" {
    const source = r"""
      type Rectangle {
        width: Int
        height: Int

        fn area(): Int {
          width * height
        }
      }

      fn probe(): Int {
        Rectangle.area()
      }
      """
    assert(problems(source) == ["`area` takes 1 argument, none were given"])
    assert(notes(source) == ["`area` is a method: call it on a value, or declare it `static fn`"])
  }
}

/**
 * "`await()` is allowed in functions that return a `Task`, in closures passed to `spawn`, and at the top level of entry
 * files and scripts. Everywhere else it is a compile error: a function that waits says so in its return type."
 * (CONCEPT, "Concurrency"). A closure answers the same question for itself: the one `spawn` is handed becomes a task,
 * and so does one whose *declared* result is a `Task` - which is how `Source.produce` says that it runs its body as
 * one. Every other closure may not wait, because `tasks.map { _.await() }` would block the worker underneath it.
 */
group "Where `await()` is allowed" {
  const task = "fn later(value: Int): Task<Int> \{\n  panic \"a task\"\n\}\n\n"

  test "a function that does not answer a `Task` may not wait" {
    const source = "{task}fn sum(a: Int, b: Int): Int \{\n  later(a).await() + b\n\}"
    assert(problems(source) == ["`await()` is only allowed in a function that returns a `Task`"])
    assert(
      notes(source)
        == [
          "A function that waits says so in its result type, and this one produces `Int64`. `spawn \{ ... \}` starts"
            + " a task, and the top level of an entry file or a script may wait for one",
        ]
    )
  }

  test "one that does may" {
    const source = "{task}fn sum(a: Int): Task<Int> \{\n  later(a).await()\n\}"
    assert problems(source).isEmpty()
  }

  test "the top level of an entry file may" {
    const source = "{task}const total = later(1).await()\nprint total"
    assert problems(source).isEmpty()
  }

  /**
   * An ordinary closure is not a task: `tasks.map \{ _.await() \}` would block the worker that pulls the pipeline,
   * and the rule is what makes the two forms the note names the way to write it.
   */
  test "an ordinary closure may not wait, and the note names the two ways to write it" {
    const source = "{task}fn run(body: () => Int): Int \{\n  body()\n\}\n\n"
      + "fn sum(a: Int): Int \{\n  run \{ later(a).await() \}\n\}"
    assert(problems(source) == ["`await()` is only allowed in a closure that becomes a task"])
    assert(
      notes(source)
        == [
          "The closure handed to `spawn \{ ... \}` is one, and so is one whose result is declared a `Task`. To wait"
            + " for many at once use `Task.all(tasks).await()`, and to go on when one finishes use"
            + " `task.map \{ ... \}`",
        ]
    )
  }

  test "the closure handed to `spawn` is a task, and so is one whose declared result is a `Task`" {
    const spawned = "{task}fn sum(a: Int): Task<Int> \{\n  spawn(\{ later(a).await() \}).await()\n\}"
    assert problems(spawned).isEmpty()
    const declared = "{task}fn run(body: () => Task<Int>): Task<Int> \{\n  body().await()\n\}\n\n"
      + "fn sum(a: Int): Task<Int> \{\n  run(\{ later(a).await() \}).await()\n\}"
    assert problems(declared).isEmpty()
  }

  test "only the closure `spawn` is handed is the task, not one written inside its body" {
    const source = "{task}fn run(body: () => Int): Int \{\n  body()\n\}\n\n"
      + "fn sum(a: Int): Task<Int> \{\n  spawn(\{ run \{ later(a).await() \} \}).await()\n\}"
    assert(problems(source) == ["`await()` is only allowed in a closure that becomes a task"])
  }

  test "a `const` of a module may not wait: it is folded at compile time" {
    const files = [
      "app/src/helper.trb": "fn later(value: Int): Task<Int> \{\n  panic \"a task\"\n\}\n\n"
        + "public const total = later(1).await()",
      "app/src/main.trb": "use total from \"./helper\"\n\nprint total",
    ]
    assert(
      problemsOf(files).contains("`await()` is only allowed in a function that returns a `Task`")
    )
  }
}

group "`foreign` declares functions of a C library" {
  test "with their result types, because the C ABI is the contract" {
    const source = r"""
      foreign "sqlite3" {
        fn sqlite3_close(database: Int)
      }
      """
    assert(problems(source) == ["A `foreign` function has to declare its result type"])
    assert(notes(source) == ["The C ABI is the contract, so nothing about a `foreign` signature is inferred"])
  }

  test "and without bodies: the library is the implementation" {
    const source = r"""
      foreign "sqlite3" {
        fn sqlite3_close(database: Int): Int32 {
          0
        }
      }
      """
    assert(problems(source) == ["A `foreign` function has no body"])
    assert(
      notes(source)
        == ["The C library is its implementation. `foreign` declares the signature the ABI promises"]
    )
  }

  test "a declaration of a signature is all a block holds" {
    const source = r"""
      foreign "sqlite3" {
        fn sqlite3_close(database: Int): Int32
      }
      """
    assert problems(source).isEmpty()
  }
}
