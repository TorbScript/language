/**
 * The tests of `torb docs site`: the Markdown of a page as the site's HTML, the anchors of its headings, the links
 * between pages rewritten to the files they became, the search index, the three levels, the lessons with their mounts,
 * the languages, and the whole site of a documentation tree held in a `Map` - the command is a pure function of it,
 * so nothing here writes a file.
 */

use test, group from "std/test"
use File from "std/fs"
use normalizePath, parentPath, joinPath, pathDepth from "../src/project/path"
use readPage from "../src/documentation/markdown"
use documentationOf from "../src/documentation/tree"
use SiteLinks, renderedBody, linkUrl, relativeUrl, codeBlockHtml, localized from "../src/documentation/site-html"
use Level, navigationOf, readingOrder, levelOf from "../src/documentation/site-navigation"
use englishWords from "../src/documentation/site-strings"
use SearchPage, IndexedPage, searchIndexOf, termsOf from "../src/documentation/site-search"
use SiteSettings, buildSite, targetOf, brokenLinks, SiteVersions from "../src/documentation/site"
use Json from "std/json"
use brandTokens from "../src/documentation/site-tokens"

const forge = "https://git.torb.dev/torbscript/language/src/branch/main"

/** The body of a page as the site renders it, read the way `torb docs site` reads it. */
fn bodyOf(path: String, text: String, targets: Map<String, String>): String {
  const read = readPage path, text
  const target = targetOf path, "0.2"
  const folder = if path.contains("/") { path.split("/").first() ?? "" } else { "" }
  renderedBody(read.body, read.headings, SiteLinks(target, folder, targets, forge)).html
}

/** A page with the front matter every page has, and this body. */
fn page(title: String, body: String): String {
  "---\ntitle: {title}\nsummary: What this page is about, said in one sentence that is long enough.\nkind: guide\nstatus: stable\n---\n\n{body}"
}

fn tree(): Map<String, String> {
  [
    "index.md": page("The documentation", "The root. Start with [the guide](guide/index.md).\n"),
    "guide/index.md": "---\ntitle: Learn\nsummary: The guide, in order.\nkind: index\nstatus: stable\norder: 10\n---\n\nThe guide.\n",
    "guide/first.md": "---\ntitle: First\nsummary: The first step.\nkind: guide\nstatus: stable\norder: 1\n---\n\n## Goal\n\nSee [the second](second.md).\n",
    "guide/second.md": "---\ntitle: Second\nsummary: The second step.\nkind: guide\nstatus: stable\norder: 2\n---\n\n## Goal\n\nBack to [the first](first.md#goal).\n",
    "site/index.md": "---\ntitle: The website\nsummary: The pages of the site.\nkind: index\nstatus: stable\n---\n\nThe site.\n",
    "site/home.md": "---\ntitle: TorbScript\nsummary: A single-language ecosystem.\nkind: site\nstatus: stable\n---\n\n## Values\n\nText.\n\n```trb\nconst answer = 42\n```\n",
  ]
}

fn settings(): SiteSettings {
  SiteSettings "latest", "<svg class=\"lockup\"></svg>", "<svg class=\"mark\"></svg>"
}

/** The root of the repository, found from wherever the test runner was started. */
fn repositoryRoot(): String {
  var current = normalizePath File.absolutePath(".").expect("the working directory")
  while pathDepth(current) >= 1 {
    if File.exists(joinPath(current, "compiler/project.trb")) {
      return current
    }
    const parent = parentPath current
    if parent == current {
      break
    }
    current = parent
  }
  panic "the root of the repository is not above the working directory"
}

group "the body of a page" {
  test "a heading has the anchor the link check resolves against, and a link to it" {
    const html = bodyOf "guide/a.md", page("A", "## The `var` keyword\n\nText.\n"), [:]
    assert html.contains("<h2 id=\"the-var-keyword\">The <code>var</code> keyword")
    assert html.contains("<a class=\"heading-anchor\" href=\"#the-var-keyword\"")
  }

  test "an anchor written after the heading is its anchor, and is not shown" {
    const html = bodyOf "guide/a.md", page("A", "## A long title \{#short\}\n\nText.\n"), [:]
    assert html.contains("<h2 id=\"short\">A long title<a")
    assert(!html.contains("\{#short\}"))
  }

  test "a table scrolls in its own box and keeps the alignment of its columns" {
    const html = bodyOf "guide/a.md", page("A", "| Left | Right |\n|:-----|------:|\n| a | b |\n"), [:]
    assert html.contains("<div class=\"table-wrap\"><table>")
    assert html.contains("<th class=\"align-left\">Left</th>")
    assert html.contains("<td class=\"align-right\">b</td>")
  }

  test "a trb block is coloured at generation time, and its marker is for the tools" {
    const html = codeBlockHtml "trb run", "const answer = 42\nprint answer\n"
    assert html.contains("<pre class=\"code language-trb\">")
    assert html.contains("<span class=\"t-keyword\">const</span>")
    assert html.contains("<span class=\"t-number\">42</span>")
    assert(!html.contains("run"))
  }

  test "a trb error block says that it does not compile" {
    const html = codeBlockHtml "trb error", "fixed.append 3\n// error: `append` needs a `var`\n"
    assert html.contains("code-block-error")
    const words = englishWords()
    assert localized(html, { words.get(_) ?? _ }).contains("Does not compile")
  }

  test "a var binding is marked as one that can be changed" {
    const html = codeBlockHtml "trb", "var counter = 0\ncounter = 1\n"
    assert html.contains("t-mutable")
  }

  test "a drawing keeps a face that has its box-drawing characters" {
    const html = codeBlockHtml "text", "a ──► b\n"
    assert html.contains("<pre class=\"code language-text drawing\">")
  }

  test "a Planned banner is a callout in the colours of information" {
    const html = bodyOf "guide/a.md", page("A", "> **Planned.** Nothing here works today.\n"), [:]
    assert html.contains("<div class=\"callout callout-info\">")
    assert(!html.contains("<blockquote>"))
  }
}

group "the links" {
  test "a link to a page is a link to the file it became, relative to the page" {
    const targets = ["glossary.md": "docs/0.2/glossary.html", "guide/second.md": "docs/0.2/guide/second.html"]
    const links = SiteLinks "docs/0.2/guide/first.html", "guide", targets, forge
    assert(linkUrl(links, "../glossary.md#binding") == "../glossary.html#binding")
    assert(linkUrl(links, "second.md") == "second.html")
  }

  test "a link out of the documentation goes to the forge" {
    const links = SiteLinks "docs/0.2/index.html", "", [:], forge
    assert(linkUrl(links, "../CONCEPT.md#bindings") == "{forge}/CONCEPT.md#bindings")
    assert(linkUrl(links, "../compiler/src/main.trb") == "{forge}/compiler/src/main.trb")
  }

  test "an external link and an anchor of the same page stay as they are" {
    const links = SiteLinks "docs/0.2/index.html", "", [:], forge
    assert(linkUrl(links, "https://diataxis.fr/") == "https://diataxis.fr/")
    assert(linkUrl(links, "#rules") == "#rules")
  }

  test "a relative URL goes up to what two pages share and down to the target" {
    assert(relativeUrl("docs/0.2/guide/index.html", "docs/0.2/language/index.html") == "../language/index.html")
    assert(relativeUrl("docs/0.2/guide/index.html", "index.html") == "../../../index.html")
    assert(relativeUrl("index.html", "docs/0.2/index.html") == "docs/0.2/index.html")
    assert(relativeUrl("docs/0.2/a.html", "docs/0.2/b.html") == "b.html")
  }

  test "a page of site/ is written at the root, and every other page below its version" {
    assert(targetOf("site/home.md", "0.2") == "index.html")
    assert(targetOf("site/imprint.md", "0.2") == "imprint.html")
    assert(targetOf("site/index.md", "0.2") == "docs/0.2/site/index.html")
    assert(targetOf("guide/index.md", "0.2") == "docs/0.2/guide/index.html")
    assert(targetOf("ARCHITECTURE.md", "0.2") == "docs/0.2/ARCHITECTURE.html")
  }

  test "a link that leads to no file of the site is a problem, and the reference is not asked for" {
    const texts = [
      "index.html": "<a href=\"docs/latest/missing.html\">x</a> <a href=\"docs/latest/reference/index.html\">y</a>",
    ]
    const problems = brokenLinks texts, [], "latest"
    assert(problems.length() == 1)
    assert problems[0].message.contains("docs/latest/missing.html")
  }
}

group "the search" {
  test "the terms of a text are its words, without the short ones and the words of every page" {
    assert(termsOf("The var binding: appendAll, 2026 and x.") == ["var", "binding", "appendall"])
  }

  test "a term keeps its pages, the page that uses it most first, and a term of every page is left out" {
    const pages = [
      IndexedPage(SearchPage("A", "", "a.html", "", [], []), "binding binding shared"),
      IndexedPage(SearchPage("B", "", "b.html", "", [], []), "binding shared"),
      IndexedPage(SearchPage("C", "", "c.html", "", [], []), "orange shared"),
      IndexedPage(SearchPage("D", "", "d.html", "", [], []), "shared"),
      IndexedPage(SearchPage("E", "", "e.html", "", [], []), "shared"),
    ]
    const index = searchIndexOf "0.2", pages
    assert(index.pages.length() == 5)
    assert(index.terms == ["binding", "orange"])
    assert(index.postings == [[0, 1], [2]])
  }
}

group "the site" {
  test "the front page, every page, the search and the assets are written" {
    const site = buildSite documentationOf("docs", tree()), settings()
    assert site.texts.containsKey("index.html")
    assert site.texts.containsKey("docs/latest/index.html")
    assert site.texts.containsKey("docs/latest/guide/first.html")
    assert site.texts.containsKey("docs/latest/search-index.json")
    assert site.texts.containsKey("assets/site.css")
    assert site.texts.containsKey("manifest.webmanifest")
    assert site.texts.containsKey("404.html")
    assert site.texts.containsKey("docs/versions.json")
    const problems = site.problems.map({ _.show() }).toList()
    assert(problems == [])
  }

  test "docs/versions.json names this build's version, once, at the root of the site" {
    const site = buildSite documentationOf("docs", tree()), settings()
    const versions = site.texts.get("docs/versions.json") ?? ""
    assert(versions == Json().encode(SiteVersions("latest", ["latest"])))
    // Not per language: every language shares the one file at the root, which is where site-style.trb's version
    // switcher fetches it from (`siteBase`, not the language-prefixed `siteRoot`)
    assert(!site.texts.containsKey("de/docs/versions.json"))
  }

  test "the front page leads with the line, the install commands and the tour of site/home.md" {
    const site = buildSite documentationOf("docs", tree()), settings()
    const front = site.texts.get("index.html") ?? ""
    assert front.contains("One language, every layer.")
    assert front.contains("curl -fsSL https://torb.dev/install.sh | sh")
    assert front.contains("irm https://torb.dev/install.ps1 | iex")
    assert front.contains("<section class=\"panel\">")
    assert front.contains("button-cta")
  }

  test "the imprint and the privacy notice exist only where their pages do" {
    const withoutImprint = buildSite documentationOf("docs", tree()), settings()
    assert(!withoutImprint.texts.containsKey("imprint.html"))
    assert(!(withoutImprint.texts.get("index.html") ?? "").contains("imprint.html"))
    var files = tree()
    files.set(
      "site/imprint.md",
      "---\ntitle: Imprint\nsummary: Who runs this site.\nkind: site\nstatus: stable\n---\n\nText.\n",
    )
    const withImprint = buildSite documentationOf("docs", files), settings()
    assert withImprint.texts.containsKey("imprint.html")
    const front = withImprint.texts.get("index.html") ?? ""
    assert front.contains("href=\"imprint.html\"")
  }

  test "a page links its neighbours in the order of the navigation, and its source on the forge" {
    const documentation = documentationOf "docs", tree()
    assert(
      readingOrder(navigationOf(documentation)) == ["index.md", "guide/index.md", "guide/first.md", "guide/second.md"],
    )
    const site = buildSite documentation, settings()
    const first = site.texts.get("docs/latest/guide/first.html") ?? ""
    assert first.contains("href=\"index.html\" rel=\"prev\"")
    assert first.contains("href=\"second.html\" rel=\"next\"")
    assert first.contains("{forge}/docs/guide/first.md")
    assert first.contains("<a href=\"second.html\">the second</a>")
  }
}

/** The tree of [tree] with a course of two lessons, a page of the reference, and a German translation of one page. */
fn levelTree(): Map<String, String> {
  var files = tree()
  files.set(
    "start/index.md",
    "---\ntitle: Learn to program\nsummary: The course.\nkind: index\nstatus: stable\norder: 5\n---\n\nThe course.\n",
  )
  files.set "start/first.md", lesson("First lesson", 1)
  files.set "start/second.md", lesson("Second lesson", 2)
  files.set "language/index.md", "---\ntitle: The language\nsummary: Every construct.\nkind: index\nstatus: stable\norder: 20\n---\n\nThe language.\n"
  files.set "language/bindings.md", page("Bindings", "## Rules\n\nOne rule.\n")
  files.set "translations/de/strings.json", "\{\"language\": \"Deutsch\", \"nav.reference\": \"Referenz\"\}"
  files.set(
    "translations/de/guide/first.md",
    "---\ntitle: Erstens\nsummary: Der erste Schritt.\nkind: guide\nstatus: stable\ntranslates: 000000000000\n---\n\n## Ziel\n\nSiehe [den zweiten](second.md).\n",
  )
  files
}

/** A lesson: an example, an exercise with its solution folded, and a recap. */
fn lesson(title: String, order: Int): String {
  const body = [
    "A value has a name.",
    "",
    "```trb run",
    "print 1",
    "// prints 1",
    "```",
    "",
    "## Exercise",
    "",
    "Print 2.",
    "",
    "```trb exercise",
    "print 0",
    "```",
    "",
    "<details>",
    "<summary>Solution</summary>",
    "",
    "```trb run",
    "print 2",
    "// prints 2",
    "```",
    "",
    "</details>",
    "",
    "## Recap",
    "",
    "One line.",
    "",
  ]
  "---\ntitle: {title}\nsummary: What this lesson teaches.\nkind: lesson\nstatus: stable\norder: {order}\n---\n\n{body.joined(separator: "\n")}"
}

group "the levels" {
  test "a page belongs to the level of its folder" {
    assert(levelOf("start/first.md") == Level.Start)
    assert(levelOf("guide/first.md") == Level.Guide)
    assert(levelOf("language/bindings.md") == Level.Reference)
    assert(levelOf("index.md") == Level.Reference)
    assert(levelOf("site/home.md") == Level.Site)
  }

  test "the header has one door per level, and marks the level of the page" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    const guide = site.texts.get("docs/latest/guide/first.html") ?? ""
    assert guide.contains("<a href=\"../start/index.html\">Start</a>")
    assert guide.contains("<a href=\"index.html\" aria-current=\"page\">Guide</a>")
    assert guide.contains("<a href=\"../index.html\">Reference</a>")
    assert guide.contains("<span class=\"level level-guide\">Guide</span>")
  }

  test "the sidebar of a page shows only its level" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    const guide = site.texts.get("docs/latest/guide/first.html") ?? ""
    const sidebar = guide.substringAfter("<aside class=\"sidebar\"").expect("a sidebar").substringBefore("</aside>")
      ?? ""
    assert sidebar.contains("Second")
    assert(!sidebar.contains("Bindings"))
    const reference = site.texts.get("docs/latest/language/bindings.html") ?? ""
    const other = reference.substringAfter("<aside class=\"sidebar\"").expect("a sidebar").substringBefore("</aside>")
      ?? ""
    assert other.contains("Bindings")
    assert(!other.contains("Second"))
  }

  test "the last lesson leads to the guide, and the last page of the guide to the reference" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    const last = site.texts.get("docs/latest/start/second.html") ?? ""
    assert last.contains("Continue with the guide")
    assert last.contains("href=\"../guide/index.html\" rel=\"next\"")
    const guide = site.texts.get("docs/latest/guide/second.html") ?? ""
    assert guide.contains("Go deep: the reference")
  }
}

group "the lessons" {
  test "a lesson shows its number, and its rows put the code beside the text" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    const first = site.texts.get("docs/latest/start/first.html") ?? ""
    assert first.contains("Lesson 1 of 2")
    assert first.contains("<section class=\"lesson-row\"><div class=\"lesson-text\">")
    assert first.contains("<div class=\"lesson-code\"><div class=\"playground\" data-playground=\"run\"")
    assert first.contains("data-lesson=\"start/first.md\"")
  }

  test "an exercise is a mount with its expected output and its solution, and the solution stays folded" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    const first = site.texts.get("docs/latest/start/first.html") ?? ""
    assert first.contains("data-playground=\"exercise\" data-file=\"first.trb\" data-source=\"print 0\"")
    assert first.contains("data-expected-output=\"2\" data-solution=\"print 2\n// prints 2\"")
    assert first.contains("Expected output")
    assert first.contains("<div class=\"lesson-folded\">")
    assert(first.split("data-playground=").length() == 3)
  }

  test "a run block of any page is a mount, and runs locally only in a lesson" {
    const links = SiteLinks "docs/0.2/guide/a.html", "guide", [:], forge
    const html = renderedBody("```trb run\nprint 1\n// prints 1\n```\n", [], links).html
    assert html.contains("<div class=\"playground\" data-playground=\"run\" data-file=\"example.trb\"")
    assert html.contains("data-source=\"print 1\n// prints 1\"")
    assert(!html.contains("playground-local"))
  }

  test "the list of lessons numbers every lesson" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    const course = site.texts.get("docs/latest/start/index.html") ?? ""
    assert course.contains("<span class=\"lesson-number\">2</span><span class=\"lesson-name\">Second lesson</span>")
    assert course.contains("Start with lesson 1")
  }
}

group "the languages" {
  test "every page is written in every language, and one without a translation says so" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    assert site.texts.containsKey("de/index.html")
    assert site.texts.containsKey("de/docs/latest/search-index.json")
    const untranslated = site.texts.get("de/docs/latest/guide/second.html") ?? ""
    assert untranslated.contains("<html lang=\"de\"")
    assert untranslated.contains("This page is not translated yet")
    assert untranslated.contains("<meta name=\"robots\" content=\"noindex\">")
    assert untranslated.contains(">Referenz</a>")
    assert(site.problems.map({ _.show() }).toList() == [])
  }

  test "a translated page is in its language, names its other versions, and is found by the search" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    const translated = site.texts.get("de/docs/latest/guide/first.html") ?? ""
    assert translated.contains("<h1 class=\"page-title\">Erstens</h1>")
    assert translated.contains("<a href=\"second.html\">den zweiten</a>")
    assert translated.contains("hreflang=\"de\" href=\"https://torb.dev/de/docs/latest/guide/first.html\"")
    assert translated.contains("hreflang=\"x-default\" href=\"https://torb.dev/docs/latest/guide/first.html\"")
    assert translated.contains("parts of it may be outdated")
    const english = site.texts.get("docs/latest/guide/first.html") ?? ""
    assert english.contains("hreflang=\"de\"")
    const search = site.texts.get("de/docs/latest/search-index.json") ?? ""
    assert search.contains("Erstens")
  }

  test "the switcher links the same page in every language" {
    const site = buildSite documentationOf("docs", levelTree()), settings()
    const english = site.texts.get("docs/latest/guide/first.html") ?? ""
    assert english.contains("href=\"../../../de/docs/latest/guide/first.html\" hreflang=\"de\" lang=\"de\" data-language=\"de\"")
    assert english.contains(">Deutsch</a>")
    const german = site.texts.get("de/docs/latest/guide/first.html") ?? ""
    assert german.contains("href=\"../../../../docs/latest/guide/first.html\" hreflang=\"en\" lang=\"en\" data-language=\"en\"")
  }

  test "a site in one language has no switcher" {
    const site = buildSite documentationOf("docs", tree()), settings()
    const front = site.texts.get("index.html") ?? ""
    assert(!front.contains("language-menu"))
    assert(!site.texts.containsKey("de/index.html"))
  }
}

group "the brand" {
  test "the tokens the compiler writes are brand/tokens.css" {
    const written = File.readText(joinPath(repositoryRoot(), "brand/tokens.css")).expect("brand/tokens.css")
    assert(written.replace("\r\n", "\n").trim() == brandTokens.trim())
  }
}
