/**
 * From a checked program to the IR text: functions, slots, blocks, literals, locals, the arithmetic intrinsics, `if`,
 * `while`, `for`, `return`/`break`/`continue`, tuples, records and what is not supported yet.
 *
 * What every program here is checked against, and why every function is verified as well as compared, is in
 * `lower-harness.trb`.
 */

use test, group from "std/test"
use File from "std/fs"
use normalizePath, parentPath, pathDepth, joinPath from "../src/project/path"
use readSourceTree from "../src/project/read"
use check from "../src/semantics/check"
use verifyProgram from "../src/ir/verify"
use lowerChecked, loweredText from "../src/ir/lower/lower"
use irOf, textOf, unsupportedIn from "./lower-harness"
use lowered from "./lower-harness"

group "Functions, slots and blocks" {
  test "the parameters are slots in declaration order, and the body is one block" {
    const source = raw"""
      fn double(value: Int): Int {
        value * 2
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_double") == raw"""
        fn t_acme_x2f_app_main_double(value: Int64 borrowed) -> Int64 {
          slot %0 parameter value: Int64
          slot %1 temporary: Int64
          slot %2 temporary: Int64
        b0: # acme/app/src/main.trb:1 body
          %1 = constant s_literal__Int64_2
          %2 = intrinsic multiply.i64 %0, %1 at acme/app/src/main.trb:2:3
          return %2 borrowed
        }""",
    )
  }

  test "a local is a slot the value is computed into, and an assignment writes the same one" {
    const source = raw"""
      fn sum(first: Int, second: Int): Int {
        const doubled = first * 2
        var total = doubled
        total = total + second
        total
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_sum") == raw"""
        fn t_acme_x2f_app_main_sum(first: Int64 borrowed, second: Int64 borrowed) -> Int64 {
          slot %0 parameter first: Int64
          slot %1 parameter second: Int64
          slot %2 local doubled: Int64
          slot %3 temporary: Int64
          slot %4 local total: Int64
        b0: # acme/app/src/main.trb:1 body
          %3 = constant s_literal__Int64_2
          %2 = intrinsic multiply.i64 %0, %3 at acme/app/src/main.trb:2:19
          %4 = copy %2
          %4 = intrinsic add.i64 %4, %1 at acme/app/src/main.trb:4:11
          return %4 borrowed
        }""",
    )
  }

  test "a function that produces nothing returns without a value" {
    const source = raw"""
      fn nothing(value: Int) {
        const doubled = value + value
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_nothing") == raw"""
        fn t_acme_x2f_app_main_nothing(value: Int64 borrowed) -> Void {
          slot %0 parameter value: Int64
          slot %1 local doubled: Int64
        b0: # acme/app/src/main.trb:1 body
          %1 = intrinsic add.i64 %0, %0 at acme/app/src/main.trb:2:19
          return
        }""",
    )
  }

  test "one static value per distinct literal, whatever it is written in" {
    const source = raw"""
      fn twice(): Int {
        const first = 7
        const second = 7
        first + second
      }
      """
    const text = textOf source
    assert text.contains("static s_literal__Int64_7: Int64 = 7")
    assert(!text.contains("s_literal__Int64_7: Int64 = 7\nstatic s_literal__Int64_7"))
  }
}

group "Control flow" {
  test "both arms of an `if` produce into one slot, and an arm that returns does not join" {
    const source = raw"""
      fn pick(flag: Bool, value: Int): Int {
        const found = if flag { value } else { 0 - value }
        if found > 10 {
          return 10
        }
        found
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_pick") == raw"""
        fn t_acme_x2f_app_main_pick(flag: Bool borrowed, value: Int64 borrowed) -> Int64 {
          slot %0 parameter flag: Bool
          slot %1 parameter value: Int64
          slot %2 local found: Int64
          slot %3 temporary: Int64
          slot %4 temporary: Int64
          slot %5 temporary: Bool
          slot %6 temporary: Void
          slot %7 temporary: Int64
        b0: # acme/app/src/main.trb:1 body
          branch %0 then b1 else b2
        b1: # acme/app/src/main.trb:2 then
          %2 = copy %1
          jump b3
        b2: # acme/app/src/main.trb:2 else
          %3 = constant s_literal__Int64_0
          %2 = intrinsic subtract.i64 %3, %1 at acme/app/src/main.trb:2:42
          jump b3
        b3: # acme/app/src/main.trb:2 join
          %4 = constant s_literal__Int64_10
          %5 = intrinsic greater.i64 %2, %4 at acme/app/src/main.trb:3:6
          branch %5 then b4 else b5
        b4: # acme/app/src/main.trb:3 then
          %7 = constant s_literal__Int64_10
          return %7 borrowed
        b5: # acme/app/src/main.trb:3 join
          return %2 borrowed
        }""",
    )
  }

  test "`&&` is control flow: the right side runs only where it decides anything" {
    const source = raw"""
      fn both(first: Bool, second: Bool): Bool {
        first && second
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_both") == raw"""
        fn t_acme_x2f_app_main_both(first: Bool borrowed, second: Bool borrowed) -> Bool {
          slot %0 parameter first: Bool
          slot %1 parameter second: Bool
          slot %2 temporary: Bool
        b0: # acme/app/src/main.trb:1 body
          %2 = copy %0
          branch %2 then b1 else b2
        b1: # acme/app/src/main.trb:2 right
          %2 = copy %1
          jump b2
        b2: # acme/app/src/main.trb:2 join
          return %2 borrowed
        }""",
    )
  }

  test "`||` is the same branch the other way round" {
    const source = raw"""
      fn either(first: Bool, second: Bool): Bool {
        first || second
      }
      """
    assert irOf(source, "t_acme_x2f_app_main_either").contains("branch %2 then b2 else b1")
  }

  /**
   * The increment of the counter is `add.i64.unchecked`: the range analysis reads `index < limit` off the head of the
   * loop, so `index + 1` cannot leave `Int64` and the overflow check of it is not emitted (`ir/ranges.trb`). The
   * `total + index` inside the body keeps its check, because nothing bounds `total`.
   */
  test "`for` over a range is a counter, a comparison and an increment, and `break` leaves it" {
    const source = raw"""
      fn count(limit: Int): Int {
        var total = 0
        for index in 0..limit {
          if index == 3 {
            continue
          }
          total = total + index
        }
        total
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_count") == raw"""
        fn t_acme_x2f_app_main_count(limit: Int64 borrowed) -> Int64 {
          slot %0 parameter limit: Int64
          slot %1 local total: Int64
          slot %2 local index: Int64
          slot %3 temporary: Int64
          slot %4 temporary: Bool
          slot %5 temporary: Int64
          slot %6 temporary: Bool
          slot %7 temporary: Void
          slot %8 temporary: Int64
        b0: # acme/app/src/main.trb:1 body
          %1 = constant s_literal__Int64_0
          %2 = constant s_literal__Int64_0
          %3 = copy %0
          jump b1
        b1: # acme/app/src/main.trb:3 for
          %4 = intrinsic less.i64 %2, %3 at acme/app/src/main.trb:3:3
          branch %4 then b2 else b4
        b2: # acme/app/src/main.trb:3 body
          %5 = constant s_literal__Int64_3
          %6 = intrinsic equal.i64 %2, %5 at acme/app/src/main.trb:4:8
          branch %6 then b5 else b6
        b3: # acme/app/src/main.trb:3 step
          %8 = constant s_literal__Int64_1
          %2 = intrinsic add.i64.unchecked %2, %8 at acme/app/src/main.trb:3:3
          jump b1
        b4: # acme/app/src/main.trb:3 done
          return %1 borrowed
        b5: # acme/app/src/main.trb:4 then
          jump b3
        b6: # acme/app/src/main.trb:4 join
          %1 = intrinsic add.i64 %1, %2 at acme/app/src/main.trb:7:13
          jump b3
        }""",
    )
  }

  test "the end of a `loop` without a `break` is an empty `unreachable` marker" {
    const source = raw"""
      fn forever(): Int {
        loop {
          const _ = 1
        }
      }
      """
    const text = irOf source, "t_acme_x2f_app_main_forever"
    assert text.contains("b2: # acme/app/src/main.trb:2 done\n  unreachable")
  }

  test "a `loop` with a `break` ends in the block the `break` jumps to" {
    const source = raw"""
      fn halve(value: Int): Int {
        var total = value
        loop {
          total = total / 2
          if total == 0 {
            break
          }
        }
        total
      }
      """
    assert irOf(source, "t_acme_x2f_app_main_halve").contains("return %1 borrowed")
  }
}

group "Values" {
  test "a comparison of a built-in type is one intrinsic and never a call" {
    const source = raw"""
      fn compareThem(first: Int, second: Int, text: String, other: String, flag: Bool): Bool {
        first < second && text == other && flag != flag
      }
      """
    const text = irOf source, "t_acme_x2f_app_main_compareThem"
    assert text.contains("intrinsic less.i64 %0, %1")
    assert text.contains("intrinsic textEqual %2, %3")
    assert text.contains("intrinsic notEqual %4, %4")
  }

  test "`+` on two strings is one concatenation, never a call of `String.add`" {
    const source = raw"""
      fn joined(first: String, second: String): String {
        first + second
      }
      """
    assert irOf(source, "t_acme_x2f_app_main_joined").contains("intrinsic textConcat %0, %1")
  }

  test "a tuple is a layout, and a tuple pattern reads its positions" {
    const source = raw"""
      fn parts(pair: (Int, Bool)): Int {
        const (number, flag) = pair
        if flag {
          return number
        }
        0
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_parts") == raw"""
        fn t_acme_x2f_app_main_parts(pair: Tuple(T_tuple__Int64_Bool) borrowed) -> Int64 {
          slot %0 parameter pair: Tuple(T_tuple__Int64_Bool)
          slot %1 local number: Int64
          slot %2 local flag: Bool
          slot %3 temporary: Void
          slot %4 temporary: Int64
        b0: # acme/app/src/main.trb:1 body
          %1 = read %0.0
          %2 = read %0.1
          branch %2 then b1 else b2
        b1: # acme/app/src/main.trb:3 then
          return %1 borrowed
        b2: # acme/app/src/main.trb:3 join
          %4 = constant s_literal__Int64_0
          return %4 borrowed
        }""",
    )
  }

  test "a record is a layout, a field is a `read`, and `copy` builds from the old fields" {
    const source = raw"""
      type Point {
        x: Int
        y: Int = 0

        fn moved(): Point {
          copy(x: 5)
        }
      }
      """
    const text = textOf source
    assert text.contains("layout T_acme_x2f_app_main_Point inline size 16 align 8 fields(x: Int64, y: Int64)")
    assert(
      irOf(source, "t_acme_x2f_app_main_Point_moved") == raw"""
        fn t_acme_x2f_app_main_Point_moved(self: Record(T_acme_x2f_app_main_Point) borrowed) -> Record(T_acme_x2f_app_main_Point) {
          slot %0 parameter self: Record(T_acme_x2f_app_main_Point)
          slot %1 temporary: Int64
          slot %2 temporary: Int64
          slot %3 temporary: Record(T_acme_x2f_app_main_Point)
        b0: # acme/app/src/main.trb:5 body
          %1 = constant s_literal__Int64_5
          %2 = read %0.y
          %3 = construct T_acme_x2f_app_main_Point (%1 borrowed, %2 borrowed)
          return %3 borrowed
        }""",
    )
  }

  test "`panic` is an instruction, and nothing after it in the block is reachable" {
    const source = raw"""
      fn never(): Int {
        panic "no"
      }
      """
    assert(
      irOf(source, "t_acme_x2f_app_main_never") == raw"""
        fn t_acme_x2f_app_main_never() -> Int64 {
          slot %0 temporary: String
          slot %1 temporary: Void
        b0: # acme/app/src/main.trb:1 body
          %0 = constant s_literal__String_no
          panic %0 borrowed at acme/app/src/main.trb:2:3
          unreachable
        }""",
    )
  }
}

group "The top level of a file" {
  test "a top-level `const` is static data with a name, and there is no module initialization" {
    const source = raw"""
      const greeting = "hi"

      fn shout(text: String): String {
        text + greeting
      }
      """
    const text = textOf source
    assert text.contains("static s_acme_x2f_app_main_greeting: String = \"hi\"")
    assert irOf(source, "t_acme_x2f_app_main_shout").contains("%1 = constant s_acme_x2f_app_main_greeting")
  }

  test "the top-level code of an entry file is the entry function, named after the file" {
    const source = raw"""
      fn twice(value: Int): Int {
        value + value
      }

      const _ = twice(21)
      """
    assert(
      irOf(source, "t_acme_x2f_app_main") == raw"""
        fn t_acme_x2f_app_main() -> Void {
          slot %0 temporary: Int64
          slot %1 temporary: Int64
        b0: # acme/app/src/main.trb:5 entry
          %0 = constant s_literal__Int64_21
          %1 = call t_acme_x2f_app_main_twice(%0 borrowed) at acme/app/src/main.trb:5:11
          return
        }""",
    )
  }

  /**
   * The top-level bindings of an entry file are locals of its entry function, which is what makes an assignment to a
   * top-level `var` ordinary code. A `const` of a module that runs nothing stays static data, and the test above pins
   * that half. The `const total = counter` at the end is the read the dead-change rule asks for.
   */
  test "the top-level bindings of an entry file are locals of the entry function, and a `var` can be assigned to" {
    const source = raw"""
      var counter = 0

      const step = 2

      counter = counter + step
      const total = counter
      """
    assert(
      irOf(source, "t_acme_x2f_app_main") == raw"""
        fn t_acme_x2f_app_main() -> Void {
          slot %0 local counter: Int64
          slot %1 local step: Int64
          slot %2 local total: Int64
        b0: # acme/app/src/main.trb:1 entry
          %0 = constant s_literal__Int64_0
          %1 = constant s_literal__Int64_2
          %0 = intrinsic add.i64.unchecked %0, %1 at acme/app/src/main.trb:5:11
          %2 = copy %0
          return
        }""",
    )
    // Nothing of the entry file is static data with a name of its own any more
    assert(!textOf(source).contains("static s_acme_x2f_app_main_counter"))
  }

  /**
   * A top-level `const` of an entry file is evaluated once, by the entry function, and a function of the file reads that
   * value from its entry cell: first the flag the entry sets after the value, a panic where it is not set yet, then the
   * value. There is no immortal accessor that would run the initializer a second time (`ir/lower/cell.trb`).
   */
  test "a top-level `const` a function reads is evaluated once, and the function reads its entry cell" {
    const source = raw"""
      fn loaded(): List<Int> {
        [1, 2]
      }

      const table = loaded()

      fn count(): Int {
        table.length()
      }

      const _ = count()
      """
    const entry = irOf source, "t_acme_x2f_app_main"
    assert(entry.split("call t_acme_x2f_app_main_loaded()").length() == 2)
    assert entry.contains("call t_cellWrite__t_acme_x2f_app_main_table(%0 borrowed)")
    assert entry.contains("call t_cellMark__t_acme_x2f_app_main_table(")
    const reader = irOf source, "t_acme_x2f_app_main_count"
    assert reader.contains("= call t_cellIsSet__t_acme_x2f_app_main_table()")
    assert reader.contains("The_x20_top_x2d_level_x20_const_x20__x60_table_x60__x20_is_x20_read_x20_before")
    assert reader.contains("= call t_cellRead__t_acme_x2f_app_main_table()")
    const text = textOf source
    assert(!text.contains("constant fn t_acme_x2f_app_main_table"))
    assert text.contains("cell fn t_cellRead__t_acme_x2f_app_main_table() -> ")
    assert text.contains(" = Read t_acme_x2f_app_main_table_entry\n")
  }

  test "a top-level `const` that is static data is read as its static, and has no cell" {
    const source = raw"""
      const limit = 64

      fn doubled(): Int {
        limit * 2
      }

      const _ = doubled()
      """
    assert irOf(source, "t_acme_x2f_app_main_doubled").contains("= constant s_acme_x2f_app_main_limit")
    assert(!textOf(source).contains("cellRead"))
  }

  /**
   * `static port: Int? = 80` is the `Some(80)` the checker wraps the value into, and a case is no static data: the
   * constant is built once where it is read, around the value. Answering the payload as the static put an `Int` under
   * the type of an `Option<Int>`, which neither back end could read.
   */
  test "a constant the checker wraps into `Some` is the case, built where it is read" {
    const source = raw"""
      type Defaults {
        static port: Int? = 80
      }

      fn portOrZero(): Int {
        Defaults.port ?? 0
      }

      const _ = portOrZero()
      """
    const text = textOf source
    const option = "T_std_x2f_prelude_types_Option__Int64"
    assert text.contains("constant fn t_acme_x2f_app_main_Defaults_port() -> Variant({option})")
    assert text.contains("%1 = construct {option}.Some (%0 borrowed)")
    assert(!text.contains("static s_acme_x2f_app_main_Defaults_port"))
  }

  test "a top-level `var` a function reads is a clean finding, because it would read the initializer" {
    const source = raw"""
      var counter = 0

      fn read(): Int {
        counter
      }

      counter = counter + 1
      """
    assert(
      unsupportedIn(source) == ["a top-level `var` read from a function is not supported by the native back end yet"],
    )
  }
}

group "What the back end does not lower yet" {
  test "every construct of a later sub-milestone is named, and the function becomes an `unreachable` stub" {
    const source = raw"""
      fn collected(value: Int): Int {
        const items = [value, value]
        items.length()
      }
      """
    assert(unsupportedIn(source)
      == ["`iterate`, which neither the source nor the natives manifest provides is not supported by the native back end yet"])
    assert(
      irOf(source, "t_acme_x2f_app_main_collected") == raw"""
        fn t_acme_x2f_app_main_collected(value: Int64 borrowed) -> Int64 {
          slot %0 parameter value: Int64
        b0: # not supported yet
          unreachable
        }""",
    )
  }

  /**
   * `a[key]` itself is lowered since 5.7 (`lower-collections.test.trb`), and the `ArrayList` of the prelude of
   * `harness.trb` provides no `iterate`, which is what the one that is left reports. Its `at` is written out like
   * the default of `std/core`, because `ir/elements.trb` reads the panic of `a[key]` out of that body - so an index
   * on a list lowers here as it does over the real standard library.
   */
  test "a list literal says which construct it is" {
    assert(
      unsupportedIn("fn items(): Int \{\n  const found = [1, 2]\n  1\n\}")
        == ["`iterate`, which neither the source nor the natives manifest provides is not supported by the native back end yet"],
    )
    assert(unsupportedIn("fn first(items: ArrayList<Int>): Int \{\n  items[0]\n\}") == [])
    // A `?` at the top level of an entry file is lowered to `error: <the error through Show>` and exit code 1
    // (`lower-match.test.trb`, and `tests/conformance/top-level-error.trb`). In a *function* whose result is
    // neither an `Option` nor a `Result` the checker reports it, so no body of one reaches the back end at all
    assert(unsupportedIn("fn read(): Result<Int, String> \{\n  Ok(1)\n\}\n\nconst value = read()?\nprint value") == [])
  }

  test "a place through a slice is a window the back end forms" {
    // A `var` parameter and a path through fields are 5.9a's, an index is 5.7's, a slice is a window and 5.9b's
    assert(
      unsupportedIn("fn part(var items: ArrayList<Int>, var other: ArrayList<Int>) \{\n  items[0..1] = other\n\}")
        == [],
    )
  }

  /**
   * A generic declaration nothing calls has no instance at all: an instance needs the type arguments of a call site, and
   * a declaration that is never called never gets any. It is counted as a declaration the back end cannot build an
   * instance of, which is what keeps the progress bar about declarations rather than about calls.
   */
  /**
   * A generic declaration is a **template and no function of the back end**: monomorphization gives it one instance per
   * argument list, each counted where the worklist reaches it, and none at all where nothing calls it. So asking for its
   * instance without arguments could only fail, and counting that as a construct the back end does not support said
   * "cannot build an instance of" about code it builds a dozen of. It is the same answer 6.1's long tail gave for a
   * `const` whose value is no static data: no declaration of the back end, so neither lowered nor stubbed.
   */
  test "a generic declaration nothing calls is no declaration of the back end at all" {
    const found = unsupportedIn "fn identity<Value>(value: Value): Value \{\n  value\n\}"
    assert found.isEmpty()
  }
}

group "The closed world is the program" {
  /**
   * **A package next to yours in a workspace must not change your binary.** Two questions of the back end are
   * closed-world - "does any implementation override this default", which decides the member list of every witness table,
   * and through it how many instances the worklist reaches - and both were asked over every file the `SourceTree` read.
   * `readSourceTree` reads the whole workspace whatever is being built, so adding `examples/encoding-lab` to the
   * repository took the instance count of `source.trb`'s program from 121 declarations to 192 without a line of that
   * program changing.
   *
   * The lab below is the same shape in miniature: a member called `sort`, which is a **default of `List`** in the
   * miniature prelude. Read as an override it puts `sort` into the table of every `List<Item>` of the program - and
   * `acme/app` does not depend on `acme/lab` at all.
   */
  const lab = [
    "project.trb": raw"""
      name "acme/all"
      workspace { members "std/*", "app", "lab" }
      """,
    "lab/project.trb": raw"""
      name "acme/lab"
      """,
    "lab/src/main.trb": raw"""
      type Rows with Iterate<Int> {
        var items: List<Int> = []

        fn iterate(): Iterator<Int> {
          items.iterate()
        }

        var fn sort(by: (value: Int) => Int) {
          items.sort by
        }
      }
      """,
  ]

  const walking = raw"""
    fn total(numbers: List<Int>): Int {
      var sum = 0
      for value in numbers {
        sum = sum + value
      }
      sum
    }

    fn used(): Int {
      total([1, 2, 3])
    }
    """

  test "an unrelated package of the workspace changes nothing about the program" {
    var alone = lowered walking
    var beside = lowered walking, lab
    assert(alone.lowered + alone.stubbed == beside.lowered + beside.stubbed)
    assert(alone.program.functions.length() == beside.program.functions.length())
    assert(alone.program.witnessTables.length() == beside.program.witnessTables.length())
    assert(alone.program.elements.length() == beside.program.elements.length())
    // The bodies as well, not only how many of them there are: a table with one more slot is a different program
    assert(loweredText(alone) == loweredText(beside))
  }

  test "the lab really is in the workspace, so the test above is not vacuous" {
    const plain = raw"""
      fn used(): Int {
        1
      }
      """
    var beside = lowered plain, lab
    assert beside.problems.isEmpty()
    var names: List<String> = []
    for function in beside.program.functions {
      names.append function.name
    }
    // Nothing of `acme/lab` is lowered - `torb ir` seeds the requested modules - but the checker indexed it
    assert(!names.any({ _.contains "lab" }))
  }
}

group "Real code" {
  /** The root of the repository, found from wherever the test runner was started. */
  fn repositoryRoot(): String? {
    var current = normalizePath File.absolutePath(".").expect("the working directory")
    while pathDepth(current) >= 1 {
      if File.exists(joinPath(current, "compiler/project.trb")) {
        return current
      }
      const parent = parentPath current
      if parent == current {
        return None
      }
      current = parent
    }
    None
  }

  /**
   * Two files of the checker itself, lowered: every function of them, or the construct that blocks each one. This is
   * the progress bar of the lowering - removing one of these constructs from the block list changes the list, and
   * that is exactly what this test is here to notice.
   */
  test "every function of `source.trb` and `diagnostic.trb` is lowered or blocked by a named construct" {
    const root = repositoryRoot().expect("the root of the repository above the working directory")
    const tree = readSourceTree([root]).expect("the sources of the repository")
    const first = joinPath root, "compiler/src/syntax/source.trb"
    const second = joinPath root, "compiler/src/syntax/diagnostic.trb"
    const checked = check tree, [first, second], false, true
    var reported: List<String> = []
    for file in checked.files {
      for diagnostic in file.diagnostics {
        reported.append "{file.path}: {diagnostic.message}"
      }
    }
    assert reported.isEmpty()
    var found = lowerChecked checked
    // A body the verifier rejects is a bug of the lowering, and a stub is a body like any other
    assert verifyProgram(found.program).isEmpty()
    assert found.program.problems.isEmpty()
    assert found.problems.isEmpty()
    // Nine declarations of the two files, plus the instances and the generated members the worklist reaches from
    // them: a text is iterated through `Characters` and `CharacterIterator` of `std/text`, so the two files reach
    // `Iterate<Char>`, `Iterator<Char>` and the payload boxes of both - one set for the whole program.
    //
    // **The closed world is the whole program, not the two files.** "Does any implementation override this default"
    // is asked over every file the `SourceTree` reads, and `readSourceTree` reads the whole workspace - so the
    // examples next to the compiler put members back into the tables of a program that does not depend on them at
    // all. What this asserts is therefore a property of the *program* (`programPackagesOf`, and the test below this
    // one), with `examples/encoding-lab` in the tree. The program is also every package its modules import, whether
    // a manifest names it or not: the overrides of `std/iteration`, which no manifest of `std` lists, are in it.
    //
    // 150 since 2026-09-23 (173 before): `extend Task<Result<Value, Failure>> { fn outcome() }` was an implementation
    // whose target is `Task`, so every member of `Task` - `all` among them - counted as an override, and `Iterate.all`
    // and `Iterate.any` sat in every table of the program. `outcome()` is gone, and with it the twenty-three instances.
    // 145 since `TextIndex`: the two files slice their source through `sliceBytes`, and the instances of `String.slice`
    // and the `Bounds<Int>` it read its ends through are gone.
    //
    // 51 since 2026-09-26 (145 before): "overridden" is asked per trait and per signature (`collectOverriddenMembers`
    // in `ir/witness.trb`). By name alone, every member of every type that implements *some* trait counted as an
    // override of every default of that name, of whatever trait - so a default sat in the tables of its trait wherever
    // an unrelated type of the program wrote a member called like it, and each such slot is an instance per item type.
    // Smaller tables are the point of the fix.
    //
    // 37 since the lexer reads bytes (51 before): `SourceText` keeps the text alone, where it decoded every character
    // into a list and the offset of each into another, and `LineIndex.of` searches the line breaks as bytes - so the two
    // files no longer turn a text into a `List<Char>`, and the instances that took are gone.
    assert(found.lowered + found.stubbed == 37)
    // **The instance-count tripwire.** Monomorphization with `List<Item>` everywhere can multiply, and what
    // multiplies it is the **element type**: a container literal builds the witness table of `List<Item>`, and that
    // table carries only the default members of `Iterate`, `List`, `MutableIndexed`, `Length` and
    // `Accumulator` that some implementation in the program actually overrides - never every default for every item
    // type. They *are* the footprint - the functions, the tables and the descriptors - and they are asserted exactly
    // so that an explosion fails a test instead of being noticed as a build time.
    // Eleven of these are the copies the devirtualization makes of a frozen member a direct call names
    // (`specializeFrozenCallees`): the table keeps the original, the call site gets a body whose result and whose
    // parameters may become concrete. 111 functions and 26 tables since 2026-09-26 (216 and 38 before), for the
    // reason the declaration count above gives; 113 since `charAtByte` names its caller's line, and the copies that take
    // the caller's site came with it (`ir/sites.trb`); 87 functions and 18 tables since the lexer reads bytes, for the
    // reason the declaration count above gives
    assert(found.program.functions.length() == 87)
    assert(found.program.witnessTables.length() == 18)
    assert(found.program.elements.length() == 2)
    var blocked: List<String> = []
    for entry in found.unsupported {
      blocked.append entry.what
    }
    blocked.sort({ _ })
    // A list literal is lowered since 5.7 and a closure since 5.8, the defaults nothing overrides are out of the tables
    // since the fourth round - so `swapAt`, `updated` and `indexed` are not instantiated at all any more - and
    // `ArrayList.from`, `Range.iterate`, `String.chars` and `sort` are all TorbScript now, and the index paths `sort` is
    // written over lower - so **nothing** of these two files is blocked any more, which is what this assertion is for:
    // the next construct that stops being lowered is the next line of this list
    assert blocked.isEmpty()
  }
}
