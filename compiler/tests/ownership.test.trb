/**
 * Where the ownership pass puts every instruction it inserts, pinned as the IR text.
 *
 * Every snapshot here went through the **extended** verifier before it was compared (`ownedIrOf` in
 * `lower-harness.trb`), so a body that matches the text and leaks a count cannot pass. What the verifier itself says
 * about IR that is wrong on purpose is in `ownership-verify.test.trb`, and the analysis underneath is in
 * `liveness.test.trb`.
 */

use test, group from "std/test"
use File from "std/fs"
use normalizePath, parentPath, pathDepth, joinPath from "../src/project/path"
use readSourceTree from "../src/project/read"
use check from "../src/semantics/check"
use lowerChecked from "../src/ir/lower/lower"
use printProgram from "../src/ir/print"
use IrProgram, IrType, IrSignature, IrParameter, RuntimeKind from "../src/ir/ir"
use IrFunction, FunctionKind, FunctionId, Slot, SlotRole, SlotDeclaration from "../src/ir/ir"
use Instruction, Terminator, Reference, borrowed, referenced from "../src/ir/ir"
use finishProgram from "../src/ir/layout"
use newFunction, emit, terminate, finishFunction from "../src/ir/build"
use printFunction from "../src/ir/print"
use insertOwnership from "../src/ir/ownership"
use verifyOwnedProgram from "../src/ir/ownership-verify"
use irOf, ownedIrOf from "./lower-harness"

/**
 * One hand-built program, finished and owned.
 *
 * It takes the program **by value** on purpose: `assert` holds an `Expression<Bool>` and evaluates it a second time to
 * show what the parts of it were, so a question that changed the program it was asked about would answer differently the
 * second time - and a pass that is written to run once would be reported as if it had run twice.
 */
fn ownedProgram(program: IrProgram): IrProgram {
  var built = program
  finishProgram built
  insertOwnership built
  built
}

/** The final IR of one hand-built function, with the verifier's findings in its place if it has any. */
fn ownedTextOfFunction(program: IrProgram, identifier: FunctionId): String {
  const built = ownedProgram program
  const problems = verifyOwnedProgram built
  if !problems.isEmpty() {
    return problems.joined separator: "\n"
  }
  printFunction built, built.functionAt(identifier)
}

group "The summary: which parameters take the count" {
  test "a parameter that is only read stays borrowed, and nothing at all is inserted" {
    const source = raw"""
      fn length(text: String): Int {
        text.byteLength()
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_length") == raw"""
        fn t_acme_x2f_app_main_length(text: String borrowed) -> Int64 {
          slot %0 parameter text: String
          slot %1 temporary: Int64
        b0: # acme/app/src/main.trb:1 body
          %1 = intrinsic textByteLength %0 at acme/app/src/main.trb:2:3
          return %1 borrowed
        }""",
    )
  }

  test "a parameter that is returned is owned, and forwarding it costs nothing" {
    const source = raw"""
      fn same(text: String): String {
        text
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_same") == raw"""
        fn t_acme_x2f_app_main_same(text: String owned) -> String {
          slot %0 parameter text: String
        b0: # acme/app/src/main.trb:1 body
          return %0 owned last
        }""",
    )
  }

  test "a parameter that is built into something is owned" {
    const source = raw"""
      type Holder {
        name: String
        note: String

        fn renamed(other: String): Holder {
          copy(name: other)
        }
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_Holder_renamed") == raw"""
        fn t_acme_x2f_app_main_Holder_renamed(self: Record(T_acme_x2f_app_main_Holder) borrowed, other: String owned) -> Record(T_acme_x2f_app_main_Holder) {
          slot %0 parameter self: Record(T_acme_x2f_app_main_Holder)
          slot %1 parameter other: String
          slot %2 temporary: String
          slot %3 temporary: Record(T_acme_x2f_app_main_Holder)
        b0: # acme/app/src/main.trb:5 body
          %2 = read %0.note
          %3 = construct T_acme_x2f_app_main_Holder (%1 owned last, %2 owned last)
          return %3 owned last
        }""",
    )
  }

  /**
   * The two halves of the same question. Handing a value on to an `Owned` parameter at its last use is a `move` and
   * costs nothing at all; handing it to a `Borrowed` one is a borrow and costs nothing either - and the *caller's* own
   * parameter is `owned` in the first case and `borrowed` in the second, which is the summary propagating.
   */
  test "a parameter handed on to an owned position is moved, and to a borrowed one it is borrowed" {
    const source = raw"""
      fn kept(value: String): String {
        value
      }

      fn size(value: String): Int {
        value.byteLength()
      }

      fn handedOn(text: String): String {
        kept(text)
      }

      fn measured(text: String): Int {
        size(text)
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_handedOn") == raw"""
        fn t_acme_x2f_app_main_handedOn(text: String owned) -> String {
          slot %0 parameter text: String
          slot %1 temporary: String
        b0: # acme/app/src/main.trb:9 body
          %1 = call t_acme_x2f_app_main_kept(%0 owned last) at acme/app/src/main.trb:10:3
          return %1 owned last
        }""",
    )
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_measured") == raw"""
        fn t_acme_x2f_app_main_measured(text: String borrowed) -> Int64 {
          slot %0 parameter text: String
          slot %1 temporary: Int64
        b0: # acme/app/src/main.trb:13 body
          %1 = call t_acme_x2f_app_main_size(%0 borrowed) at acme/app/src/main.trb:14:3
          return %1 borrowed
        }""",
    )
  }

  test "a function that calls itself gets its summary as well: the fixpoint needs no special case" {
    const source = raw"""
      fn wrapped(text: String, depth: Int): String {
        if depth == 0 {
          return text
        }
        wrapped(text, depth - 1)
      }
      """
    const shown = ownedIrOf source, "t_acme_x2f_app_main_wrapped"
    assert shown.contains("fn t_acme_x2f_app_main_wrapped(text: String owned, depth: Int64 borrowed) -> String \{")
    assert shown.contains("  return %0 owned last")
    assert shown.contains("  %7 = call t_acme_x2f_app_main_wrapped(%0 owned last, %6 borrowed)")
  }

  test "a function of the runtime takes the modes of its parameters from the natives manifest" {
    var program = IrProgram()
    const text = program.internType IrType.Text
    const voidType = program.internType IrType.VoidType
    const list = program.internType IrType.Runtime(RuntimeKind.ListStorage, [text])
    const added = IrSignature([IrParameter("self", list, isReference: true), IrParameter("value", text)], voidType)
    var runtime = IrFunction "t_list_add", None, added, [], [], FunctionKind.Runtime("torb_list_add")
    runtime.slots.append SlotDeclaration(list, SlotRole.Parameter(0), "self")
    runtime.slots.append SlotDeclaration(text, SlotRole.Parameter(1), "value")
    const callee = program.addFunction runtime
    const signature = IrSignature([IrParameter("items", list, isReference: true), IrParameter("value", text)], voidType)
    var builder = newFunction "t_use", None, signature, "body"
    // The receiver of `torb_list_add` is a `var self`, so its argument is the place and not a value
    emit builder, Instruction.Call(None, callee, [referenced(Reference(Slot(0))), borrowed(Slot(1))], [])
    terminate builder, Terminator.Return(None)
    const identifier = finishFunction program, builder
    const owned = ownedProgram program
    assert verifyOwnedProgram(owned).isEmpty()
    // `torb_list_add` stores its second argument, so the call site hands its own count over
    assert(
      printFunction(owned, owned.functionAt(callee))
        == "runtime fn t_list_add(var self: List(String) borrowed, value: String owned) -> Void = torb_list_add",
    )
    assert(
      printFunction(owned, owned.functionAt(identifier)) == raw"""
        fn t_use(var items: List(String) borrowed, value: String owned) -> Void {
          slot %0 parameter items: List(String)
          slot %1 parameter value: String
        b0: # body
          call t_list_add(&%0 borrowed, %1 owned last)
          return
        }""",
    )
  }
}

group "Last use is a move" {
  test "a value that is built and returned is moved out, and the operands of an intrinsic are borrowed" {
    const source = raw"""
      fn joined(first: String, second: String): String {
        first + second
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_joined") == raw"""
        fn t_acme_x2f_app_main_joined(first: String borrowed, second: String borrowed) -> String {
          slot %0 parameter first: String
          slot %1 parameter second: String
          slot %2 temporary: String
        b0: # acme/app/src/main.trb:1 body
          %2 = intrinsic textConcat %0, %1 at acme/app/src/main.trb:2:3
          return %2 owned last
        }""",
    )
  }

  /**
   * The participle, which is what the whole memory model is for: `var result = self`, change `result`, answer it.
   * `text` arrives owned and the `copy` of phase one is a `move`. The assignment **defines** `%2` (`definedSlot` of
   * a write with no steps), so what the local held is released at its own last use - the concatenation that read it -
   * and the store keeps the count it is handed. The count never leaves one.
   */
  test "the participle pattern: the copy of a parameter into a local is a move" {
    const source = raw"""
      fn shout(text: String, other: String): String {
        var total = text
        total = total + other
        total
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_shout") == raw"""
        fn t_acme_x2f_app_main_shout(text: String owned, other: String borrowed) -> String {
          slot %0 parameter text: String
          slot %1 parameter other: String
          slot %2 local total: String
          slot %3 temporary: String
        b0: # acme/app/src/main.trb:1 body
          %2 = move %0
          %3 = intrinsic textConcat %2, %1 at acme/app/src/main.trb:3:11
          release %2
          write %2 = %3 owned last
          return %2 owned last
        }""",
    )
  }

  /**
   * `x = f(x)`, which is the participle seen from the call site: `numbers = appended(numbers, value)`.
   *
   * The assignment defines `%1`, so the argument is the **last use** of what the slot held - it is moved into the
   * callee, nothing is retained in front of the call, and the `makeUnique` inside the callee finds a count of one and
   * copies nothing. That is what makes growing a list through a participle amortized O(1) instead of O(length) per
   * step (docs/PERFORMANCE.md, finding 1).
   */
  test "`x = f(x)` moves the old value into the call: no retain in front of it" {
    const source = raw"""
      fn longer(text: String): String {
        var result = text
        result = result + "!"
        result
      }

      fn repeated(start: String, times: Int): String {
        var current = start
        for _index in 0..times {
          current = longer current
        }
        current
      }
      """
    const shown = ownedIrOf source, "t_acme_x2f_app_main_repeated"
    assert shown.contains("fn t_acme_x2f_app_main_repeated(start: String owned, times: Int64 borrowed) -> String \{")
    assert shown.contains("  %6 = call t_acme_x2f_app_main_longer(%2 owned last) at acme/app/src/main.trb:10:15\n  write %2 = %6 owned last")
    assert(!shown.contains("retain"))
    assert(!shown.contains("makeUnique"))
  }

  test "a use that is not the last one is a retain, and only the last one is a move" {
    const source = raw"""
      fn kept(value: String): String {
        value
      }

      fn pair(text: String): String {
        const first = kept(text)
        const second = kept(text)
        first + second
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_pair") == raw"""
        fn t_acme_x2f_app_main_pair(text: String owned) -> String {
          slot %0 parameter text: String
          slot %1 local first: String
          slot %2 local second: String
          slot %3 temporary: String
        b0: # acme/app/src/main.trb:5 body
          retain %0
          %1 = call t_acme_x2f_app_main_kept(%0 owned) at acme/app/src/main.trb:6:17
          %2 = call t_acme_x2f_app_main_kept(%0 owned last) at acme/app/src/main.trb:7:18
          %3 = intrinsic textConcat %1, %2 at acme/app/src/main.trb:8:3
          release %1
          release %2
          return %3 owned last
        }""",
    )
  }

  test "a value borrowed twice by one call is borrowed twice and never retained" {
    const source = raw"""
      fn joined(first: String, second: String): String {
        first + second
      }

      fn twice(text: String): String {
        joined(text, text)
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_twice") == raw"""
        fn t_acme_x2f_app_main_twice(text: String borrowed) -> String {
          slot %0 parameter text: String
          slot %1 temporary: String
        b0: # acme/app/src/main.trb:5 body
          %1 = call t_acme_x2f_app_main_joined(%0 borrowed, %0 borrowed) at acme/app/src/main.trb:6:3
          return %1 owned last
        }""",
    )
  }

  test "a field read hands the frame a count of the field, and returning it moves that count out" {
    const source = raw"""
      type Holder {
        name: String
        note: String
      }

      fn nameOf(holder: Holder): String {
        holder.name
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_nameOf") == raw"""
        fn t_acme_x2f_app_main_nameOf(holder: Record(T_acme_x2f_app_main_Holder) borrowed) -> String {
          slot %0 parameter holder: Record(T_acme_x2f_app_main_Holder)
          slot %1 temporary: String
        b0: # acme/app/src/main.trb:6 body
          %1 = read %0.name
          return %1 owned last
        }""",
    )
  }
}

group "Where a value dies" {
  test "a value nobody takes is released where it is made" {
    const source = raw"""
      fn ignored(text: String, other: String): Int {
        const _ = text + other
        1
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_ignored") == raw"""
        fn t_acme_x2f_app_main_ignored(text: String borrowed, other: String borrowed) -> Int64 {
          slot %0 parameter text: String
          slot %1 parameter other: String
          slot %2 temporary: String
          slot %3 temporary: Int64
        b0: # acme/app/src/main.trb:1 body
          %2 = intrinsic textConcat %0, %1 at acme/app/src/main.trb:2:13
          release %2
          %3 = constant s_literal__Int64_1
          return %3 borrowed
        }""",
    )
  }

  /**
   * Both parameters are owned because both are returned, and on each path the one that is *not* returned dies. The
   * edges carry the releases: `b0` has two successors, so both of its edges are split into a block that holds one
   * release and a `jump`. That is the whole mechanism for every early exit there is.
   */
  test "a value that is dead in one branch is released on that edge, in a block of its own" {
    const source = raw"""
      fn pick(flag: Bool, first: String, second: String): String {
        if flag {
          return first
        }
        second
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_pick") == raw"""
        fn t_acme_x2f_app_main_pick(flag: Bool borrowed, first: String owned, second: String owned) -> String {
          slot %0 parameter flag: Bool
          slot %1 parameter first: String
          slot %2 parameter second: String
          slot %3 temporary: Void
        b0: # acme/app/src/main.trb:1 body
          branch %0 then b3 else b4
        b1: # acme/app/src/main.trb:2 then
          return %1 owned last
        b2: # acme/app/src/main.trb:2 join
          return %2 owned last
        b3: # acme/app/src/main.trb:1 drop
          release %2
          jump b1
        b4: # acme/app/src/main.trb:1 drop
          release %1
          jump b2
        }""",
    )
  }

  test "an early return out of nested blocks releases what that path does not need" {
    const source = raw"""
      fn early(flag: Bool, other: Bool, text: String): String {
        const doubled = text + text
        if flag {
          if other {
            return text
          }
        }
        doubled
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_early") == raw"""
        fn t_acme_x2f_app_main_early(flag: Bool borrowed, other: Bool borrowed, text: String owned) -> String {
          slot %0 parameter flag: Bool
          slot %1 parameter other: Bool
          slot %2 parameter text: String
          slot %3 local doubled: String
          slot %4 temporary: Void
        b0: # acme/app/src/main.trb:1 body
          %3 = intrinsic textConcat %2, %2 at acme/app/src/main.trb:2:19
          branch %0 then b1 else b5
        b1: # acme/app/src/main.trb:3 then
          branch %1 then b6 else b7
        b2: # acme/app/src/main.trb:3 join
          return %3 owned last
        b3: # acme/app/src/main.trb:4 then
          return %2 owned last
        b4: # acme/app/src/main.trb:4 join
          jump b2
        b5: # acme/app/src/main.trb:1 drop
          release %2
          jump b2
        b6: # acme/app/src/main.trb:3 drop
          release %3
          jump b3
        b7: # acme/app/src/main.trb:3 drop
          release %2
          jump b4
        }""",
    )
  }

  /**
   * A value the loop needs in every iteration is live across the back edge, so it is never moved inside the loop and
   * never retained there either - the fixpoint answers that, and no rule about loops is written anywhere. It dies on
   * the one edge that leaves the loop.
   */
  test "a value a loop uses in every iteration is released on the edge out of the loop" {
    const source = raw"""
      fn repeated(text: String, count: Int): Int {
        var total = 0
        const doubled = text + text
        for index in 0..count {
          total = total + doubled.byteLength()
        }
        total
      }
      """
    const shown = ownedIrOf source, "t_acme_x2f_app_main_repeated"
    assert shown.contains("fn t_acme_x2f_app_main_repeated(text: String borrowed, count: Int64 borrowed) -> Int64 \{")
    assert shown.contains("  %3 = intrinsic textConcat %0, %0 at acme/app/src/main.trb:3:19\n")
    assert shown.contains("b1: # acme/app/src/main.trb:4 for\n  %6 = intrinsic less.i64 %4, %5 at acme/app/src/main.trb:4:3\n  branch %6 then b2 else b5")
    assert shown.contains("b2: # acme/app/src/main.trb:4 body\n  %7 = intrinsic textByteLength %3 at")
    assert shown.contains("b5: # acme/app/src/main.trb:4 drop\n  release %3\n  jump b4")
  }

  test "a value a loop replaces every iteration is moved aside, released, and answered after the loop" {
    const source = raw"""
      fn grown(text: String): String {
        var current = text
        loop {
          if current.byteLength() < 3 {
            break
          }
          current = current + "."
        }
        current
      }
      """
    const shown = ownedIrOf source, "t_acme_x2f_app_main_grown"
    assert shown.contains("fn t_acme_x2f_app_main_grown(text: String owned) -> String \{")
    assert shown.contains("b0: # acme/app/src/main.trb:1 body\n  %1 = move %0\n  jump b1")
    assert shown.contains("b2: # acme/app/src/main.trb:3 done\n  return %1 owned last")
    assert shown.contains("  %7 = intrinsic textConcat %1, %6 at acme/app/src/main.trb:7:15\n  release %1\n  write %1 = %7 owned last\n  jump b1")
  }

  /**
   * A static value is immortal, so nothing counts it: no `retain` in front of a position that keeps it, no `release`
   * where it stops being used, and no release of it on an edge. The two calls around it are what says the rule is
   * about the *slot* and not about the type - `%2` is a `String` the frame really owns and is released.
   *
   * It is one call per list index read, per map index read and per `expect` anywhere, because the message of an
   * `expect` is exactly this shape (docs/PERFORMANCE.md, finding 11).
   */
  test "a slot that holds a static value is never retained and never released" {
    const source = raw"""
      fn kept(value: String): String {
        value
      }

      fn labelled(text: String): Int {
        const marker = "!"
        const held = kept(text)
        marker.byteLength() + held.byteLength()
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_labelled") == raw"""
        fn t_acme_x2f_app_main_labelled(text: String owned) -> Int64 {
          slot %0 parameter text: String
          slot %1 local marker: String
          slot %2 local held: String
          slot %3 temporary: Int64
          slot %4 temporary: Int64
          slot %5 temporary: Int64
        b0: # acme/app/src/main.trb:5 body
          %1 = constant s_literal__String__x21_
          %2 = call t_acme_x2f_app_main_kept(%0 owned last) at acme/app/src/main.trb:7:16
          %3 = intrinsic textByteLength %1 at acme/app/src/main.trb:8:3
          %4 = intrinsic textByteLength %2 at acme/app/src/main.trb:8:25
          release %2
          %5 = intrinsic add.i64 %3, %4 at acme/app/src/main.trb:8:3
          return %5 borrowed
        }""",
    )
  }

  test "a panic runs nothing at all: what it read is left behind" {
    const source = raw"""
      fn refused(text: String): Int {
        const doubled = text + text
        panic doubled
      }
      """
    assert(
      ownedIrOf(source, "t_acme_x2f_app_main_refused") == raw"""
        fn t_acme_x2f_app_main_refused(text: String borrowed) -> Int64 {
          slot %0 parameter text: String
          slot %1 local doubled: String
          slot %2 temporary: Void
        b0: # acme/app/src/main.trb:1 body
          %1 = intrinsic textConcat %0, %0 at acme/app/src/main.trb:2:19
          panic %1 borrowed at acme/app/src/main.trb:3:3
          unreachable
        }""",
    )
  }
}

group "Nothing that is not counted is touched" {
  test "a function over numbers comes out of the pass byte for byte as it went in" {
    const source = raw"""
      fn total(first: Int, second: Int): Int {
        var sum = first
        sum = sum + second
        for index in 0..second {
          if index == 3 {
            continue
          }
          sum = sum + index
        }
        sum
      }
      """
    const before = irOf source, "t_acme_x2f_app_main_total"
    assert(before == ownedIrOf(source, "t_acme_x2f_app_main_total"))
    // Not one operand says `owned`, and not one instruction was added: a number has no count to keep
    assert(!before.contains("owned"))
    assert(!before.contains("retain"))
    assert(!before.contains("release"))
  }

  test "a record of numbers is copied and never counted" {
    const source = raw"""
      type Point {
        x: Int
        y: Int

        fn moved(deltaX: Int): Point {
          copy(x: deltaX)
        }
      }
      """
    const before = irOf source, "t_acme_x2f_app_main_Point_moved"
    assert(before == ownedIrOf(source, "t_acme_x2f_app_main_Point_moved"))
    assert before.contains("(self: Record(T_acme_x2f_app_main_Point) borrowed, deltaX: Int64 borrowed)")
  }
}

group "Real code" {
  /** The root of the repository, found from wherever the test runner was started. */
  fn repositoryRoot(): String? {
    var current = normalizePath File.absolutePath(".").expect("the working directory")
    while pathDepth(current) >= 1 {
      if File.exists(joinPath(current, "compiler/project.trb")) {
        return current
      }
      const parent = parentPath current
      if parent == current {
        return None
      }
      current = parent
    }
    None
  }

  /**
   * Two files of the checker itself, lowered and then owned. The extended verifier has to be happy about every one of
   * their bodies, and the whole thing has to answer the same text twice: determinism is what makes the fixpoint a
   * test about the compiler rather than about a `Map` iteration order, and this pass, which appends blocks and slots
   * of its own, is the first thing after the lowering that could break it.
   */
  test "real code passes the extended verifier, and the pass answers the same thing twice" {
    const root = repositoryRoot().expect("the root of the repository above the working directory")
    const tree = readSourceTree([root]).expect("the sources of the repository")
    const first = joinPath root, "compiler/src/syntax/source.trb"
    const second = joinPath root, "compiler/src/syntax/diagnostic.trb"
    const checked = check tree, [first, second], false, checksEveryBody: true
    var reported: List<String> = []
    for file in checked.files {
      for diagnostic in file.diagnostics {
        reported.append "{file.path}: {diagnostic.message}"
      }
    }
    assert reported.isEmpty()
    var owned = lowerChecked checked
    insertOwnership owned.program
    assert verifyOwnedProgram(owned.program).isEmpty()
    assert owned.program.problems.isEmpty()
    // The same declarations as before the pass: ownership changes bodies, never what is lowered. 51 since
    // 2026-09-26 (145 before), because a default is a slot of a table only where an implementation of its trait
    // overrides it, and 37 since the lexer reads bytes (`lower.test.trb` says more about both)
    assert(owned.lowered + owned.stubbed == 37)
    var again = lowerChecked checked
    insertOwnership again.program
    assert(printProgram(owned.program) == printProgram(again.program))
  }
}

/**
 * An object with a destructor, and the functions the group below lowers: its `close()` is the destructor, so a binding
 * of it is released at the end of its block and never at its last use (docs/design/DESTRUCTORS.md 2a).
 */
const probeSource = raw"""
  shared type Probe with Close {
    name: String

    fn touch() {
      print name
    }

    var fn close() {
      print name
    }
  }

  fn twoBindings() {
    const first = Probe "first"
    const second = Probe "second"
    first.touch()
    second.touch()
  }

  fn returned(): Probe {
    const made = Probe "made"
    made.touch()
    made
  }

  fn early(isStopping: Bool) {
    const kept = Probe "kept"
    if isStopping {
      return
    }
    kept.touch()
  }

  fn movedOnOnePath(isStoring: Bool): Probe? {
    const probe = Probe "probe"
    if isStoring {
      return Some(probe)
    }
    None
  }

  fn plain(): Int {
    const text = "{1}"
    text.byteLength()
  }

  fn conditional(isMaking: Bool) {
    print(if isMaking { Probe("arm").name } else { "none" })
  }
  """

/** A `File` as `std/fs` declares it, as far as the test below needs it: a `native shared type` that implements `Close`. */
const fileLibrary = [
  "std/fs/project.trb": raw"""
    name "std/fs"
    """,
  "std/fs/src/lib.trb": raw"""
    public native shared type File with Close {
      native var fn close()
    }
    """,
]

/** Two files held by two bindings of one block. */
const fileSource = raw"""
  use File from "std/fs"

  fn touch(file: File) {
    print "touched"
  }

  fn twoFiles(one: File, other: File) {
    const first = one
    const second = other
    touch first
    touch second
  }
  """

group "The ends of scope: a binding with a destructor is released where its block ends" {
  test "the lowering ends the scope of every such binding, the last declared first" {
    assert(
      irOf(probeSource, "t_acme_x2f_app_main_twoBindings") == raw"""
        fn t_acme_x2f_app_main_twoBindings() -> Void {
          slot %0 local first: Shared(T_acme_x2f_app_main_Probe)
          slot %1 temporary: String
          slot %2 local second: Shared(T_acme_x2f_app_main_Probe)
          slot %3 temporary: String
          slot %4 temporary: Void
        b0: # acme/app/src/main.trb:13 body
          %1 = constant s_literal__String_first
          %0 = construct T_acme_x2f_app_main_Probe (%1 borrowed)
          %3 = constant s_literal__String_second
          %2 = construct T_acme_x2f_app_main_Probe (%3 borrowed)
          call t_acme_x2f_app_main_Probe_touch(%0 borrowed) at acme/app/src/main.trb:16:3
          call t_acme_x2f_app_main_Probe_touch(%2 borrowed) at acme/app/src/main.trb:17:3
          endOfScope %2
          endOfScope %0
          return
        }""",
    )
  }

  /** `first` is used for the last time before `second`, and still released after it. */
  test "the end of a scope becomes the releases, in reverse declaration order" {
    assert(
      ownedIrOf(probeSource, "t_acme_x2f_app_main_twoBindings") == raw"""
        fn t_acme_x2f_app_main_twoBindings() -> Void {
          slot %0 local first: Shared(T_acme_x2f_app_main_Probe)
          slot %1 temporary: String
          slot %2 local second: Shared(T_acme_x2f_app_main_Probe)
          slot %3 temporary: String
          slot %4 temporary: Void
        b0: # acme/app/src/main.trb:13 body
          %1 = constant s_literal__String_first
          %0 = construct T_acme_x2f_app_main_Probe (%1 owned)
          %3 = constant s_literal__String_second
          %2 = construct T_acme_x2f_app_main_Probe (%3 owned)
          call t_acme_x2f_app_main_Probe_touch(%0 borrowed) at acme/app/src/main.trb:16:3
          call t_acme_x2f_app_main_Probe_touch(%2 borrowed) at acme/app/src/main.trb:17:3
          release %2
          release %0
          return
        }""",
    )
  }

  test "a binding that is returned is moved out, and the end of its scope releases nothing" {
    assert(
      ownedIrOf(probeSource, "t_acme_x2f_app_main_returned") == raw"""
        fn t_acme_x2f_app_main_returned() -> Shared(T_acme_x2f_app_main_Probe) {
          slot %0 local made: Shared(T_acme_x2f_app_main_Probe)
          slot %1 temporary: String
          slot %2 temporary: Void
        b0: # acme/app/src/main.trb:20 body
          %1 = constant s_literal__String_made
          %0 = construct T_acme_x2f_app_main_Probe (%1 owned)
          call t_acme_x2f_app_main_Probe_touch(%0 borrowed) at acme/app/src/main.trb:22:3
          return %0 owned last
        }""",
    )
  }

  /** Without the end of its scope `kept` would die on the edge into the `return`, before nothing at all. */
  test "a return in the middle of the block ends the scope there too" {
    assert(
      ownedIrOf(probeSource, "t_acme_x2f_app_main_early") == raw"""
        fn t_acme_x2f_app_main_early(isStopping: Bool borrowed) -> Void {
          slot %0 parameter isStopping: Bool
          slot %1 local kept: Shared(T_acme_x2f_app_main_Probe)
          slot %2 temporary: String
          slot %3 temporary: Void
        b0: # acme/app/src/main.trb:26 body
          %2 = constant s_literal__String_kept
          %1 = construct T_acme_x2f_app_main_Probe (%2 owned)
          branch %0 then b1 else b2
        b1: # acme/app/src/main.trb:28 then
          release %1
          return
        b2: # acme/app/src/main.trb:28 join
          call t_acme_x2f_app_main_Probe_touch(%1 borrowed) at acme/app/src/main.trb:31:3
          release %1
          return
        }""",
    )
  }

  /** The move stays a move on the path that has it, and the other path releases at the end of the scope. */
  test "a binding moved out on one path is released on the other" {
    assert(
      ownedIrOf(probeSource, "t_acme_x2f_app_main_movedOnOnePath") == raw"""
        fn t_acme_x2f_app_main_movedOnOnePath(isStoring: Bool borrowed) -> Variant(T_std_x2f_prelude_types_Option__T_acme_x2f_app_main_Probe) {
          slot %0 parameter isStoring: Bool
          slot %1 local probe: Shared(T_acme_x2f_app_main_Probe)
          slot %2 temporary: String
          slot %3 temporary: Void
          slot %4 temporary: Variant(T_std_x2f_prelude_types_Option__T_acme_x2f_app_main_Probe)
          slot %5 temporary: Variant(T_std_x2f_prelude_types_Option__T_acme_x2f_app_main_Probe)
        b0: # acme/app/src/main.trb:34 body
          %2 = constant s_literal__String_probe
          %1 = construct T_acme_x2f_app_main_Probe (%2 owned)
          branch %0 then b1 else b2
        b1: # acme/app/src/main.trb:36 then
          %4 = construct T_std_x2f_prelude_types_Option__T_acme_x2f_app_main_Probe.Some (%1 owned last)
          return %4 owned last
        b2: # acme/app/src/main.trb:36 join
          %5 = construct T_std_x2f_prelude_types_Option__T_acme_x2f_app_main_Probe.None ()
          release %1
          return %5 owned last
        }""",
    )
  }

  /**
   * Only the `then` arm makes the probe, and the end of the statement still releases it: the slot is cleared where the
   * function begins, so the `else` path reaches the release with nothing in it (docs/design/DESTRUCTORS.md 2a).
   */
  test "a temporary made on one path only is released at the end of its statement through a cleared slot" {
    assert(
      ownedIrOf(probeSource, "t_acme_x2f_app_main_conditional") == raw"""
        fn t_acme_x2f_app_main_conditional(isMaking: Bool borrowed) -> Void {
          slot %0 parameter isMaking: Bool
          slot %1 temporary: String
          slot %2 temporary: String
          slot %3 temporary: Shared(T_acme_x2f_app_main_Probe)
          slot %4 temporary: String
          slot %5 temporary: String
          slot %6 temporary: String
          slot %7 temporary: Void
        b0: # acme/app/src/main.trb:47 body
          %3 = clear
          branch %0 then b4 else b2
        b1: # acme/app/src/main.trb:48 then
          %2 = constant s_literal__String_arm
          %3 = construct T_acme_x2f_app_main_Probe (%2 owned)
          %4 = read %3.name
          %1 = move %4
          jump b3
        b2: # acme/app/src/main.trb:48 else
          %5 = constant s_literal__String_none
          %1 = copy %5
          jump b3
        b3: # acme/app/src/main.trb:48 join
          %6 = call t_std_x2f_prelude_types_Show_show__String(%1 owned last)
          intrinsic printParts %6 at acme/app/src/main.trb:48:3
          release %6
          release %3
          return
        b4: # acme/app/src/main.trb:47 drop
          release %3
          jump b1
        }""",
    )
  }

  /**
   * A `File` is an object of the runtime and no layout of the program, and it closes when it is released: `first` is
   * read for the last time before `second`, and still released after it.
   */
  test "a file is released where its block ends, in reverse declaration order" {
    assert(
      ownedIrOf(fileSource, "t_acme_x2f_app_main_twoFiles", fileLibrary) == raw"""
        fn t_acme_x2f_app_main_twoFiles(one: File owned, other: File owned) -> Void {
          slot %0 parameter one: File
          slot %1 parameter other: File
          slot %2 local first: File
          slot %3 local second: File
          slot %4 temporary: Void
        b0: # acme/app/src/main.trb:7 body
          %2 = move %0
          %3 = move %1
          call t_acme_x2f_app_main_touch(%2 borrowed) at acme/app/src/main.trb:10:3
          call t_acme_x2f_app_main_touch(%3 borrowed) at acme/app/src/main.trb:11:3
          release %3
          release %2
          return
        }""",
    )
  }

  /** A `String` has no destructor to observe, so it keeps the release right after its last use. */
  test "a binding without a destructor is released at its last use, as before" {
    assert(
      ownedIrOf(probeSource, "t_acme_x2f_app_main_plain") == raw"""
        fn t_acme_x2f_app_main_plain() -> Int64 {
          slot %0 local text: String
          slot %1 temporary: Int64
          slot %2 temporary: Int64
        b0: # acme/app/src/main.trb:42 body
          %1 = constant s_literal__Int64_1
          %0 = intrinsic textConcat %1 at acme/app/src/main.trb:43:16
          %2 = intrinsic textByteLength %0 at acme/app/src/main.trb:44:3
          release %0
          return %2 borrowed
        }""",
    )
  }
}
