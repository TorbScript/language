use test, group from "std/test"
use probe, problems, notes from "./harness"

/**
 * `lazy Value`: the argument is not a value but an **expression the callee evaluates at most once, on first use**. That
 * is one parameter mode and no new rule about what may stand there - the argument is checked against the inner type like
 * any other - but it becomes a thunk, and a thunk is a closure: `Adaptation.Lazy` marks the site and the bindings it
 * reads are recorded under the same span, exactly as a closure's captures are.
 *
 * Reading the parameter inside the callee forces the cell (`Adaptation.Force`), which is what milestone 5 emits an
 * `Intrinsic.LazyForce` for. `??` is `orElse(fallback: lazy Value)` and therefore the same thing.
 *
 * `lazy` is the type of a parameter and of nothing else, which `lowering.trb` reports where it is written elsewhere.
 */

/** A control structure with a `lazy` parameter, in the shape of `Option.orElse`. */
const helpers = "\nfn orDefault(value: Int?, fallback: lazy Int): Int \{\n  if value.isSome() \{ 0 \} else \{ fallback \}\n\}\n\n"
  + "fn debug(enabled: Bool, message: lazy String) \{\n  if enabled \{ print message \}\n\}\n"

fn inBody(body: String): String {
  "fn probe() \{\n{body}\n\}\n{helpers}"
}

group "A `lazy` argument is a thunk" {
  test "the argument is recorded as a thunk and keeps the bindings it reads" {
    const source = inBody "  const base = 2\n  const found = orDefault(None, base + 1)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.typeOf("base + 1") == "Int64")
    assert(probed.adaptationsOf("base + 1") == ["lazy"])
    assert(probed.capturesOf("base + 1") == ["base"])
  }

  test "a thunk that reads nothing captures nothing" {
    const source = inBody "  const found = orDefault(None, 7)"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.adaptationsOf("7") == ["lazy", "literal Int64"])
    assert(probed.capturesOf("7") == [])
  }

  test "a captured `var` binding stays a shared box in a thunk, too (gap 19)" {
    const source = inBody "  var total = 1\n  const found = orDefault(None, total + 0)\n  total = 2"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.capturesOf("total + 0") == ["var total"])
  }

  test "the argument is checked against the inner type, and a mismatch says so" {
    const source = inBody "  const found = orDefault(None, \"text\")"
    assert(problems(source) == ["Expected `Int64`, found `String`"])
  }

  test "`??` is `orElse(fallback: lazy Value)`, so its right side is a thunk as well" {
    const source = inBody "  const base = 2\n  const value: Int? = None\n  const found = value ?? base + 1"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.adaptationsOf("base + 1") == ["lazy"])
    assert(probed.capturesOf("base + 1") == ["base"])
  }

  test "a thunk is not a quotation: nothing is quoted and nothing has to be `Encode`" {
    const source = "fn probe() \{\n  const opaque = Opaque(true, \{ true \})\n  const found = orDefault(None, size(opaque))\n\}\n\n"
      + "fn size(value: Opaque): Int \{\n  1\n\}\n\ntype Opaque \{\n  flag: Bool\n  read: () => Bool\n\}\n{helpers}"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.adaptationsOf("size(opaque)") == ["lazy"])
    assert(probed.capturesOf("size(opaque)") == ["opaque"])
  }

  test "a `lazy String` takes an interpolated text, which is what a log line is" {
    const source = inBody "  const name = \"ada\"\n  debug(false, \"hello \{name\}\")"
    assert problems(source).isEmpty()
    const probed = probe source
    assert(probed.adaptationsOf("\"hello \{name\}\"") == ["lazy", "literal String"])
    assert(probed.capturesOf("\"hello \{name\}\"") == ["name"])
  }
}

group "Reading a `lazy` parameter forces it" {
  test "every read of the parameter records the force" {
    const probed = probe inBody("  const found = orDefault(None, 1)")
    assert(probed.lastAdaptationsOf("fallback") == ["force"])
  }

  test "a parameter that is not `lazy` is read without forcing anything" {
    const probed = probe inBody("  const found = orDefault(None, 1)")
    assert(probed.lastAdaptationsOf("enabled") == [])
  }

  test "the parameter holds the inner type, so it is used like an ordinary value" {
    const probed = probe inBody("  const found = orDefault(None, 1)")
    assert(probed.typeOf("print message") == "Void")
  }
}

group "`lazy` is the type of a parameter and of nothing else" {
  test "a field cannot be `lazy`" {
    assert(problems("type Probe \{\n  field: lazy Int\n\}") == ["`lazy` is only the type of a parameter"])
    assert(notes("type Probe \{\n  field: lazy Int\n\}") == [
      "A `lazy` argument is an expression the function evaluates at most once, so only a parameter asks for one",
    ])
  }

  test "a binding and a result cannot be `lazy`" {
    const binding = "fn probe() \{\n  const found: lazy Int = 1\n\}"
    assert(problems(binding) == ["`lazy` is only the type of a parameter"])
    const result = "fn probe(): lazy Int \{\n  1\n\}"
    assert(problems(result) == ["`lazy` is only the type of a parameter"])
  }

  test "a parameter of a function *type* may be `lazy`: that is the type of `orElse` itself" {
    assert problems("fn probe(action: (lazy Int) => Void) \{\n  action(1)\n\}").isEmpty()
  }
}
