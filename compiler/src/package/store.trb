/**
 * What the package manager keeps on disk, and the few operations on files it needs: the cache directory, reading and
 * writing an archive's bytes, and a package unpacked into the cache under its tree hash.
 *
 * **The cache is content-addressed** (docs/design/RELEASE.md section 7.5): `<cache>/packages/<hex of the tree hash>/`
 * holds a package's files, shared by every project on the machine, and a `.complete` file written last says that the
 * directory was unpacked whole and verified. A directory without it is unpacked again. Copies of the index files of a
 * registry on the network are kept in `<cache>/index/<registry>/`, which is what `--offline` resolves from.
 *
 * **Everything here is synchronous**, because `torb` itself cannot wait for a task: an entry file that waits runs its
 * top level as a task, and `torb run` and `torb test` start the VM's scheduler from that top level, which the runtime
 * refuses from inside a task. The one binary file the package manager handles - an archive - is read with
 * `File.readBytes` and written with `File.writeBytesAtomically`, which need no task; every other file of a package is
 * text and goes through `File.readText` and `File.writeText`. Nothing here asks which system it runs on, so the
 * compiler's C stays the same for every target.
 */

use File from "std/fs"
use Environment from "std/os"
use TarEntry from "std/archive"
use textOf from "std/stream"
use joinPath, parentPath from "../project/path"
use torbHome from "../cli/upgrade"

/**
 * `$TORB_CACHE`, or `<torb home>/cache` - `~/.torb/cache` on Linux, macOS and FreeBSD, `%LOCALAPPDATA%\torb\cache` on
 * Windows. `None` where neither can be found.
 */
public fn cacheDirectory(): String? {
  if const Some(given) = Environment.get("TORB_CACHE") {
    if !given.isEmpty() {
      return Some(File.absolutePath(given).ok() ?? given).map({ _.replace "\\", "/" })
    }
  }
  match torbHome() {
    Ok(home) => "{home.replace("\\", "/")}/cache"
    Fail(_) => None
  }
}

/** Where a package with this tree hash is unpacked: `<cache>/packages/<hex>`. */
public fn packageDirectory(cache: String, hash: String): String {
  "{cache}/packages/{hash.withoutPrefix("sha256:") ?? hash}"
}

/** Whether a package with this tree hash is in the cache, unpacked whole. */
public fn isInstalled(cache: String, hash: String): Bool {
  File.exists "{packageDirectory(cache, hash)}/.complete"
}

/**
 * The whole of a file, as bytes: `File.readBytes`, which needs no task. A file that is not there says so in the words
 * the rest of the package manager uses.
 */
public fn readBytes(path: String): Result<List<UInt8>, String> {
  if !File.exists(path) {
    return Fail "{path}: the file does not exist"
  }
  File.readBytes(path).mapError({ _.show() })
}

/**
 * Creates the directories above the file and replaces it whole with the bytes (`File.writeBytesAtomically`): a crash
 * or a second `torb` never finds half an archive under its name, and nothing is left beside it.
 */
public fn writeBytes(path: String, bytes: List<UInt8>): Result<Void, String> {
  if const Fail(problem) = File.createDirectory(parentPath(path)) {
    return Fail problem.show()
  }
  File.writeBytesAtomically(path, bytes).mapError({ _.show() })
}

/** Creates or empties the file and writes the text into it, creating the directories above it. */
public fn writeText(path: String, text: String): Result<Void, String> {
  if const Fail(problem) = File.createDirectory(parentPath(path)) {
    return Fail problem.show()
  }
  File.writeText(path, text).mapError({ _.show() })
}

/**
 * The files of a verified archive written into the cache under its tree hash, the marker last. The paths were checked
 * by `unpacked` already; a directory that was half written before is written over. Every file of a package is text,
 * so a file that is not UTF-8 is refused.
 */
public fn install(cache: String, hash: String, entries: List<TarEntry>): Result<Void, String> {
  const directory = packageDirectory cache, hash
  for entry in entries {
    const text = match textOf(entry.bytes) {
      Ok(found) => found
      Fail(_) => {
        return Fail "`{entry.path}` is not UTF-8, and every file of a package is text"
      }
    }
    writeText(joinPath(directory, entry.path), text)?
  }
  writeText "{directory}/.complete", "{hash}\n"
}
