/**
 * The registry client (docs/design/RELEASE.md sections 7.4 and 7.5): the index file of a package and the archive of a
 * release, from a registry on the network or from a directory.
 *
 *     <registry>/index/<owner>/<name>.trb
 *     <registry>/archives/<owner>/<name>/<version>.tar.gz
 *
 * **A `file:` registry** is a directory of the same files - the registry of a test, of a machine without a network,
 * of a mirror copied onto a disk. Its URL is `file:` and a path, relative to the project that names it.
 *
 * **The network is `curl`, else `wget`**, run to their end (`TORB_FETCH=curl` or `wget` chooses one). Not `std/http`,
 * for two reasons of 2026-09-26: `torb` cannot wait for a task (see `./store`), and every request of `std/http` is one;
 * and its name resolution crashes a native program on Windows for a host that needs a DNS lookup. `curl` ships with
 * Windows 10 and later, macOS and practically every Linux, and `torb upgrade` already relies on it.
 *
 * **`--offline`** never touches the network: an index comes from the copy in the cache, and an archive that is not
 * unpacked in the cache is an error that names the package. A `file:` registry is read either way.
 *
 * **The keys of a registry** ([registryKeysOf]) are what every record of its index has to be signed with
 * (RELEASE.md section 7.4, `./signing`). They come from its `index/config.trb`, and are trusted the way SSH trusts a
 * host: the keys that ship in `torb` for it where there are any, else the keys the machine saw at its first contact,
 * pinned in `<cache>/keys/`; a later key is trusted only when a trusted one endorsed it. A registry that lists no
 * key signs nothing and its records are read as they are - unless this machine has pinned keys of it, which makes a
 * missing list a refusal rather than a way around the check.
 */

use File from "std/fs"
use Environment from "std/os"
use Process from "std/process"
use Ed25519PublicKey from "std/signature"
use joinPath, normalizePath from "../project/path"
use readBytes, writeText from "./store"
use RegistryKey, keyText, keyOfText, readRegistryKeys, renderRegistryKeys, trustedKeys from "./signing"
use shippedKeys from "./registry"

/** Where a registry is. */
public type RegistryLocation {
  /** A `file:` registry: a directory. */
  case Directory(path: String)
  /** `https://...` or `http://...`: the base of the registry's URLs, without a `/` at the end. */
  case Web(url: String)
}

/**
 * The location a `registry` line's URL names; a `file:` path is relative to `projectDirectory`.
 *
 * # Errors
 *
 * - A URL that is neither `file:` nor `http:` or `https:`.
 */
public fn registryLocationOf(url: String, projectDirectory: String): Result<RegistryLocation, String> {
  if const Some(rest) = url.withoutPrefix("file:") {
    const path = rest.withoutPrefix("//") ?? rest
    const absolute = path.startsWith("/") || (path.byteLength() > 1 && path.byteAt(1) == 58)
    return RegistryLocation.Directory(if absolute { normalizePath path } else { joinPath projectDirectory, path })
  }
  if url.startsWith("https://") || url.startsWith("http://") {
    return RegistryLocation.Web(url.withoutSuffix("/") ?? url)
  }
  Fail "`{url}` is not a registry URL: a registry is `https://...`, or `file:` and a directory"
}

/** How a fetch may go: over the network or not, and where the copies of the index are kept. */
public type FetchSettings {
  cache: String
  offline: Bool = false
}

/**
 * The index file of a package, or `None` where the registry has none.
 *
 * # Errors
 *
 * - The registry cannot be reached, answers something other than the file or "not found", or `--offline` and no copy is
 *   in the cache.
 */
public fn fetchIndex(location: RegistryLocation, package: String, settings: FetchSettings): Result<String?, String> {
  const relative = "index/{package}.trb"
  match location {
    .Directory(directory) => {
      const path = joinPath directory, relative
      if !File.exists(path) {
        return Ok None
      }
      match File.readText(path) {
        Ok(text) => Ok Some(text)
        Fail(problem) => Fail problem.show()
      }
    }
    .Web(url) => {
      const copy = "{settings.cache}/index/{keyOf(url)}/{package}.trb"
      if settings.offline {
        return match File.readText(copy) {
          Ok(text) => Ok Some(text)
          Fail(_) => Fail "--offline, and the index of {package} from {url} is not in the cache ({copy})"
        }
      }
      const downloaded = "{settings.cache}/download.part"
      if !fetchUrl("{url}/{relative}", downloaded)? {
        return Ok None
      }
      const text = match File.readText(downloaded) {
        Ok(found) => found
        Fail(_) => {
          return Fail "the index of {package} from {url} is not UTF-8"
        }
      }
      writeText(copy, text)?
      Ok Some(text)
    }
  }
}

/**
 * The keys every record of the registry's index has to be signed with, or none for a registry that signs nothing: its
 * `index/config.trb` checked against the keys this machine trusts for it (the module's comment). A `file:` registry is
 * a directory on this machine, and its list is taken as it stands.
 *
 * # Errors
 *
 * - The list does not read, names no key this machine trusts, has a key a trusted one did not endorse, or is gone
 *   where this machine has pinned keys of the registry; the cache cannot be written.
 */
public fn registryKeysOf(location: RegistryLocation, settings: FetchSettings): Result<List<Ed25519PublicKey>, String> {
  match location {
    .Directory(directory) => {
      const path = joinPath directory, "index/config.trb"
      if !File.exists(path) {
        return []
      }
      const text = File.readText(path).mapError({ _.show() })?
      const listed = readRegistryKeys(text).mapError({ "the keys of the registry {directory}: {_}" })?
      match listed.first() {
        Some(first) => trustedKeys(listed, [first.key]).mapError({ "the keys of the registry {directory}: {_}" })
        None => []
      }
    }
    .Web(url) => webRegistryKeys url, settings
  }
}

/** [registryKeysOf] of a registry on the network: its list fetched, and checked against the shipped or pinned keys. */
fn webRegistryKeys(url: String, settings: FetchSettings): Result<List<Ed25519PublicKey>, String> {
  const pinnedPath = "{settings.cache}/keys/{keyOf(url)}.trb"
  var shipped: List<Ed25519PublicKey> = []
  for entry in shippedKeys {
    if entry.registry == url {
      shipped.append(keyOfText(entry.key)?)
    }
  }
  var pinned: List<Ed25519PublicKey> = []
  if File.exists(pinnedPath) {
    const text = File.readText(pinnedPath).mapError({ _.show() })?
    const read = readRegistryKeys(text).mapError({ "the keys pinned for {url} in {pinnedPath}: {_}" })?
    pinned = read.map({ _.key }).toList()
  }
  const anchors = if shipped.isEmpty() { pinned } else { shipped }
  const copy = "{settings.cache}/index/{keyOf(url)}/config.trb"
  const text: String? = if settings.offline {
    // Without the network the last copy of the list stands in for it, and without one the trusted keys do
    if !File.exists(copy) {
      return anchors
    }
    File.readText(copy).mapError({ _.show() })?
  } else {
    const downloaded = "{settings.cache}/download.part"
    if fetchUrl("{url}/index/config.trb", downloaded)? {
      const found = File.readText(downloaded).mapError({ _ => "the keys of {url} (index/config.trb) are not UTF-8" })?
      writeText(copy, found)?
      found
    } else {
      None
    }
  }
  const listed = match text {
    Some(found) => readRegistryKeys(found).mapError({ "the keys of {url} (index/config.trb): {_}" })?
    None => []
  }
  if listed.isEmpty() {
    if !anchors.isEmpty() {
      return Fail "{url} lists no signing key, and this machine trusts keys of it ({trustedWhere(shipped, pinnedPath)}): its index is refused rather than read unsigned"
    }
    return []
  }
  if anchors.isEmpty() {
    // The first contact: the keys are trusted as the registry lists them, and pinned for every later one
    const trusted = trustedKeys(listed, [listed[0].key]).mapError({ "the keys of {url} (index/config.trb): {_}" })?
    writeText(pinnedPath, renderRegistryKeys(trusted.map({ RegistryKey _ }).toList()))?
    printError "torb: trusting the signing keys of {url} from now on: {trusted.map(keyText).toList().joined(separator: ", ")} (pinned in {pinnedPath})"
    return trusted
  }
  const endorsed = trustedKeys(listed, anchors).mapError({ "the keys of {url} (index/config.trb): {_}; the keys this machine trusts for it are {trustedWhere(shipped, pinnedPath)}" })?
  var trusted = anchors
  for key in endorsed {
    if !trusted.contains(key) {
      trusted.append key
    }
  }
  if shipped.isEmpty() && trusted.length() > pinned.length() {
    writeText(pinnedPath, renderRegistryKeys(trusted.map({ RegistryKey _ }).toList()))?
  }
  trusted
}

/** Where the keys this machine trusts for a registry come from, for a message. */
fn trustedWhere(shipped: List<Ed25519PublicKey>, pinnedPath: String): String {
  if shipped.isEmpty() { "pinned in {pinnedPath}" } else { "the ones torb ships with" }
}

/**
 * The archive of a release.
 *
 * # Errors
 *
 * - The registry has no such archive, cannot be reached, or `--offline`.
 */
public fn fetchArchive(
  location: RegistryLocation,
  package: String,
  version: String,
  settings: FetchSettings,
): Result<List<UInt8>, String> {
  const relative = "archives/{package}/{version}.tar.gz"
  match location {
    .Directory(directory) => {
      const path = joinPath directory, relative
      if !File.exists(path) {
        return Fail "the registry {directory} has no archive of {package} {version}"
      }
      readBytes path
    }
    .Web(url) => {
      if settings.offline {
        return Fail "--offline, and {package} {version} is not unpacked in the cache: it would have to be fetched"
      }
      const downloaded = "{settings.cache}/download.part"
      if !fetchUrl("{url}/{relative}", downloaded)? {
        return Fail "{url} has no archive of {package} {version}"
      }
      readBytes downloaded
    }
  }
}

/**
 * A `GET` of `url` into the file `destination`: `true` where the body is there, `false` for 404 and 410. `curl`, else
 * `wget`, or the one `TORB_FETCH` names.
 */
fn fetchUrl(url: String, destination: String): Result<Bool, String> {
  if const Fail(problem) = File.createDirectory(normalizePath("{destination}/..")) {
    return Fail problem.show()
  }
  const chosen = Environment.get("TORB_FETCH") ?? ""
  const tools = match chosen {
    "" => ["curl", "wget"]
    "curl" | "wget" => [chosen]
    _ => {
      return Fail "TORB_FETCH is `{chosen}`: it can be `curl` or `wget`"
    }
  }
  for tool in tools {
    if const Some(result) = fetchThrough(tool, url, destination) {
      return result
    }
  }
  Fail "fetching {url} needs `curl` or `wget`, and neither could be started"
}

/** One program's `GET`; `None` where the program cannot be started at all, so the next one is tried. */
fn fetchThrough(tool: String, url: String, destination: String): Result<Bool, String>? {
  const arguments = if tool == "curl" {
    ["-sSL", "-o", destination, "-w", "%\{http_code\}", url]
  } else {
    ["-q", "-S", "-O", destination, url]
  }
  const output = match Process.runBlocking(tool, arguments) {
    Ok(found) => found
    Fail(_) => {
      return None
    }
  }
  if tool == "curl" {
    const status = output.standardOutput.trim()
    if status == "404" || status == "410" {
      return Some Ok(false)
    }
    if !status.startsWith("2") {
      return Some Fail("{url}: curl answered {status} {output.standardError.trim()}")
    }
    return Some Ok(true)
  }
  if output.isSuccess() {
    return Some Ok(true)
  }
  const said = output.standardError
  if said.contains(" 404 ") || said.contains(" 410 ") {
    return Some Ok(false)
  }
  Some Fail("{url}: wget failed: {said.trim()}")
}

/** A directory name for a registry: its URL with everything but letters, digits and dots made `-`. */
fn keyOf(url: String): String {
  var characters: List<String> = []
  for character in (url.withoutPrefix("https://") ?? url).chars() {
    const plain = (character >= 'a' && character <= 'z') || (character >= '0' && character <= '9') || character == '.'
    characters.append(if plain { character.show() } else { "-" })
  }
  characters.joined separator: ""
}
