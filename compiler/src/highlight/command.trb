/**
 * `torb highlight`: the semantic tokens of one file, as the one JSON document the editor extension reads.
 *
 *     torb highlight <file>
 *     torb highlight --stdin
 *
 * `--stdin` takes the source from standard input instead of a file, for a buffer that was never saved. Either way
 * this never fails: a file with syntax errors still gets every token the parser could resolve around the damage, a
 * file that cannot be read prints an empty list rather than an error, and the only exit code is `0` - so the
 * extension never has to show one.
 *
 * The document is one line:
 *
 *     {"tokens": [[line, startCharacter, length, "kind", ["modifier", ...]], ...]}
 *
 * `line` and `startCharacter` are 0-based, and `startCharacter` and `length` count **UTF-16 code units**, because a
 * JavaScript string is UTF-16 and that is what the editor's `SemanticTokensBuilder` takes. The tokens are sorted by
 * position, never overlap and never span a line break, which is exactly what pushing them one by one requires.
 *
 * # Related
 *
 * - [resolveFile] - the walk that decides what every name is.
 */

use File, IoError from "std/fs"
use readLine from "std/io"
use SourceText, Span from "../syntax/source"
use parse from "../syntax/parser/parser"
use HighlightToken from "./token"
use resolveFile from "./resolve"

/** A token in the coordinates the editor takes: a 0-based line, a 0-based UTF-16 column, a UTF-16 length. */
type PositionedToken {
  line: Int
  startCharacter: Int
  length: Int
  kind: String
  modifiers: List<String>
}

/**
 * Byte offset to a 0-based line and a 0-based UTF-16 column. The columns differ from character counts exactly where
 * a character takes four bytes in UTF-8, which is the same set of characters UTF-16 writes as two code units.
 */
type Utf16Index {
  text: String
  /** The byte offset every line starts at, the first one included. */
  lineStarts: List<Int>

  static fn of(text: String): Self {
    var lineStarts = [0]
    var offset = 0
    for character in text.chars() {
      offset = offset + character.byteLength()
      if character == '\n' {
        lineStarts.append offset
      }
    }
    Self text, lineStarts
  }

  /** `None` where the span leaves the text or crosses a line break: not a position the editor can be handed. */
  fn locate(span: Span): (line: Int, startCharacter: Int, length: Int)? {
    if span.end < span.start || span.end > text.byteLength() {
      return None
    }
    const line = lineAt span.start
    const lineStart = lineStarts[line]
    const lineEnd = lineStarts.get(line + 1) ?? text.byteLength()
    if span.end > lineEnd {
      return None
    }
    const startCharacter = utf16Units text.sliceBytes(lineStart, span.start)
    const length = utf16Units text.sliceBytes(span.start, span.end)
    (line: line, startCharacter: startCharacter, length: length)
  }

  /** The index of the last line that starts at or before `offset`. */
  fn lineAt(offset: Int): Int {
    var low = 0
    var high = lineStarts.length()
    while low + 1 < high {
      const middle = (low + high) / 2
      if lineStarts[middle] <= offset {
        low = middle
      } else {
        high = middle
      }
    }
    low
  }
}

/**
 * Prints the JSON document of one file's semantic tokens. `None` reads standard input, a path reads that file.
 *
 * # Related
 *
 * - [highlightJson] - the same answer as a `String`, which is what the tests ask for.
 */
public fn runHighlight(path: String?) {
  const source = match path {
    Some(file) => File.readText(file).ok() ?? ""
    None => readStandardInput().ok() ?? ""
  }
  print highlightJson(source)
}

/**
 * The JSON document `torb highlight` prints for `source`, without the line break `print` adds.
 *
 * # Examples
 *
 *     print highlightJson("")
 */
public fn highlightJson(source: String): String {
  const parsed = parse SourceText.of(source)
  const tokens = resolveFile parsed.file
  const positioned = positionTokens source, tokens
  renderJson positioned
}

/**
 * Standard input, line by line. The line breaks of the buffer are not kept, which changes no answer: every position
 * this command prints is a line and a column, and both survive a `\r\n` becoming a `\n`.
 */
fn readStandardInput(): Result<String, IoError> {
  var lines: List<String> = []
  while const Some(line) = readLine()? {
    lines.append line
  }
  lines.joined separator: "\n"
}

/**
 * The tokens in the editor's coordinates: sorted by position, one per span, and none that overlaps the one before
 * it. The resolver may reach the same name twice and its tokens are flat, so both filters are almost always empty -
 * they are what keeps the promise of the protocol true whatever the walk produces.
 */
fn positionTokens(source: String, tokens: List<HighlightToken>): List<PositionedToken> {
  var ordered = tokens
  ordered.sort({ (_.span.start, _.span.end) })
  const index = Utf16Index.of source
  var placed: List<PositionedToken> = []
  var lastStart = -1
  var lastEnd = -1
  for token in ordered {
    if token.span.start == lastStart && token.span.end == lastEnd {
      continue
    }
    lastStart = token.span.start
    lastEnd = token.span.end
    if const Some(at) = index.locate(token.span) {
      placed.append PositionedToken(at.line, at.startCharacter, at.length, token.kind, token.modifiers)
    }
  }
  withoutOverlaps placed
}

fn withoutOverlaps(tokens: List<PositionedToken>): List<PositionedToken> {
  var kept: List<PositionedToken> = []
  for token in tokens {
    if const Some(previous) = kept.last() {
      if overlaps(previous, token) {
        continue
      }
    }
    kept.append token
  }
  kept
}

fn overlaps(previous: PositionedToken, next: PositionedToken): Bool {
  if previous.line != next.line {
    return false
  }
  const previousEnd = previous.startCharacter + previous.length
  const nextEnd = next.startCharacter + next.length
  previous.startCharacter < nextEnd && next.startCharacter < previousEnd
}

fn utf16Units(text: String): Int {
  var units = 0
  for character in text.chars() {
    if character.byteLength() == 4 {
      units = units + 2
    } else {
      units = units + 1
    }
  }
  units
}

/**
 * The document itself. Every kind and modifier this compiler writes is a bare ASCII word, so nothing here needs
 * escaping and the writer stays one join.
 */
fn renderJson(tokens: List<PositionedToken>): String {
  var entries: List<String> = []
  for token in tokens {
    var quoted: List<String> = []
    for modifier in token.modifiers {
      quoted.append "\"{modifier}\""
    }
    const modifiers = quoted.joined separator: ","
    const position = "{token.line},{token.startCharacter},{token.length}"
    entries.append "[{position},\"{token.kind}\",[{modifiers}]]"
  }
  const body = entries.joined separator: ","
  "\{\"tokens\":[{body}]\}"
}
