/**
 * The bytecode of the VM: what one program is once the final IR has been encoded for the interpreter
 * (docs/design/VM.md section 3).
 *
 * A [BytecodeProgram] holds one [Chunk] per function, the program-wide tables a chunk names by index - the constant
 * pool, the shapes that say how a value is retained and released, the witness tables, the element descriptors, the
 * locations and the runtime functions - and nothing that has to be built while the program runs. A chunk is one
 * `List<Int64>` of code: a head word per instruction ([Opcode] in bits 0-7, three operands of sixteen bits) followed by
 * its tail words.
 *
 * Every register operand is a **word offset** into the frame, never a slot number: the emitter laid the frame out once
 * (`./words`), and the interpreter only adds the frame's base.
 *
 * # Related
 *
 * - [Opcode] - every instruction, with the meaning of its operands.
 * - [KernelOperation] - what an instruction hands to the C runtime through the one native of the kernel.
 * - [Shape] - how a value of one type is retained and released, which is what `copy`, `retain` and `release` name.
 */

use Location from "../../ir/ir"

// --- Opcodes --------------------------------------------------------------------------------------------------------

/**
 * One instruction of the VM. `A`, `B` and `C` are the three sixteen-bit operands of the head word, `T0`, `T1`, ... its
 * tail words; a register is a word offset into the frame, and a width counts words.
 *
 * The opcode is its position in [allOpcodes], so a zero word is `Unreachable`: code that was never written stops.
 */
public type Opcode {
  /** A block the IR says nothing reaches. Reaching it is an internal error of the compiler. */
  case Unreachable
  /** `A` = target, `B` = source, `C` = width: the words, no count changes. `Move`, and the words of a `Copy`. */
  case Move
  /** `A` = target, `B` = width, `T0` = the offset of the constant in the pool's words. */
  case Constant
  /** `A` = target, `T0` = the value of the word. */
  case Word
  /** `A` = target, `B` = width: zero words, the empty variant of a niche. */
  case Zero
  /** `A` = target, `B` = place: the words at the place, no count changes. The IR's `Read`, before its retain. */
  case Load
  /** `A` = place, `B` = value: the words to the place. The IR's `Write`, after the release of what was there. */
  case Store
  /** `A` = target, `B` = place: the one reference word of the place, which is what a `var` parameter receives. */
  case Reference
  /** `A` = target, `B` = argument count, `C` = 1 when there is a result; `T0` = chunk, then one register per argument. */
  case Call
  /** `A` = target, `B` = closure, `C` = argument count; `T0` = 1 when there is a result, then the argument registers. */
  case CallClosure
  /**
   * `A` = target, `B` = argument count, `C` = 1 when there is a result; `T0` = witness source, `T1` = member, then the
   * argument registers. The receiver is the payload of the value the source reads its table out of.
   */
  case CallWitness
  /** `A` = target, `B` = witness source: the table (its index plus one) into one word. */
  case WitnessTable
  /** `A` = the number of tail words; the tail is a [KernelOperation] and its operands. */
  case Kernel
  /** `A` = target, `B`, `C` = operands, `T0` = location: `Int64` addition that panics on overflow. */
  case AddInteger
  case SubtractInteger
  case MultiplyInteger
  /** Panics on a zero divisor and on the one quotient that overflows. */
  case DivideInteger
  case RemainderInteger
  /** `A` = target, `B` = operand, `T0` = location. */
  case NegateInteger
  /** `A` = target, `B`, `C` = operands: an `Int64` operation the range analysis proved cannot overflow. */
  case AddUnchecked
  case SubtractUnchecked
  case MultiplyUnchecked
  /** `A` = target, `B`, `C` = operands: one word compared with one word (every integer but `UInt64`, `Bool`, `Char`). */
  case Equal
  case NotEqual
  /** Signed: every signed integer, an unsigned one narrower than 64 bits, `Char` and `Bool` are all sign-correct words. */
  case Less
  case LessOrEqual
  case Greater
  case GreaterOrEqual
  /** `A` = target, `B` = operand. */
  case Not
  /** `A` = target, `B` = source, `C` = word offset of the tag inside an inline variant. */
  case Tag
  /** `A` = target, `B` = source, `C` = the payload variant of a niche: the tag is read off the first word. */
  case TagNiche
  /** `T0` = code offset. */
  case Jump
  /** `A` = condition; `T0` = code offset when true, `T1` when false. */
  case Branch
  /** `A` = scrutinee, `B` = count; then `count` pairs of value and code offset, then the offset of `otherwise`. */
  case Switch
  /** `A` = register, `B` = width (0: no value). */
  case Return
  /** Ends a task as cancelled (the IR's `Stop`), and every stop path of its body. */
  case Stop
  /**
   * `A` = target, `B` = width; `T0` = the cell's first word (a gap of the constant pool: its flag, then its value), `T1` =
   * the chunk of the initializer. The accessor of a module constant that is no static data: the value is built once,
   * inside an immortal region, and every read after the first copies it.
   */
  case Cell
  /**
   * `A` = the answer (a `String`), `B` = the closure of a receiver script, `C` = the reference of its receiver; `T0` =
   * the grant: `runScript` of `std/sandbox`, which only the VM has (docs/design/SCRIPTS.md sections 4 to 6).
   */
  case RunScript
  /** `A` = the task register; `T0` = the code offset of the stop path a cancelled task goes to. A resume point's check. */
  case Cancelled
  /**
   * `A` = the task register, `B` = the task awaited, `C` = the state, `T0` = 1 where the wait only observes the
   * awaited task (`result()`, `torb_task_observe`) and 0 where it takes over its cancellation (`await()`,
   * `torb_task_await`): the IR's `Suspend`. The state is recorded and the task waits; where it was registered, its
   * frame is saved into the task block and the body returns to the scheduler, and where the answer was there already
   * it goes on at the `resume` that follows (docs/design/CONCURRENCY.md sections 8 and 16).
   */
  case Suspend
  /** `A` = the task register, `T0` = the stop path: where the body goes on after a suspension - the check, the outcome. */
  case Resume
  /** `A` = the task register, `B` = the value, `C` = its width: the value into the task block, and the body is done. */
  case Finish
  /**
   * `A` = register, `B` = width, `C` = 0 to read the cell and 1 to write it, `T0` = its first word, a gap of the constant
   * pool: an entry cell, the one value a top-level `const` of the entry file holds for every function that names it.
   */
  case EntryCell
  /**
   * `A` = the answer (a `String`), `B` = the path, `C` = the receiver as `scriptReceiver` of `std/sandbox` names it:
   * `loadScript`, a file only known while the program runs checked and lowered into it by the running `torb`
   * (docs/design/SCRIPTS.md slice 7). The answer is the chunk of its body and its imports, or why it did not load.
   */
  case LoadScript
  /**
   * `A` = the answer (a `String`), `B` = the chunk of a script [LoadScript] loaded, `C` = the reference of its receiver;
   * `T0` = the grant: `runLoadedScript` of `std/sandbox`, which is [RunScript] for such a script.
   */
  case RunLoaded

  /** The number the head word carries. */
  fn number(): Int {
    match self {
      .Unreachable => 0
      .Move => 1
      .Constant => 2
      .Word => 3
      .Zero => 4
      .Load => 5
      .Store => 6
      .Reference => 7
      .Call => 8
      .CallClosure => 9
      .CallWitness => 10
      .WitnessTable => 11
      .Kernel => 12
      .AddInteger => 13
      .SubtractInteger => 14
      .MultiplyInteger => 15
      .DivideInteger => 16
      .RemainderInteger => 17
      .NegateInteger => 18
      .AddUnchecked => 19
      .SubtractUnchecked => 20
      .MultiplyUnchecked => 21
      .Equal => 22
      .NotEqual => 23
      .Less => 24
      .LessOrEqual => 25
      .Greater => 26
      .GreaterOrEqual => 27
      .Not => 28
      .Tag => 29
      .TagNiche => 30
      .Jump => 31
      .Branch => 32
      .Switch => 33
      .Return => 34
      .Stop => 35
      .Cell => 36
      .RunScript => 37
      .Cancelled => 38
      .Suspend => 39
      .Resume => 40
      .Finish => 41
      .EntryCell => 42
      .LoadScript => 43
      .RunLoaded => 44
    }
  }

  /** The name the disassembly writes. */
  fn spelling(): String {
    match self {
      .Unreachable => "unreachable"
      .Move => "move"
      .Constant => "constant"
      .Word => "word"
      .Zero => "zero"
      .Load => "load"
      .Store => "store"
      .Reference => "reference"
      .Call => "call"
      .CallClosure => "call.closure"
      .CallWitness => "call.witness"
      .WitnessTable => "table"
      .Kernel => "kernel"
      .AddInteger => "add.i64"
      .SubtractInteger => "subtract.i64"
      .MultiplyInteger => "multiply.i64"
      .DivideInteger => "divide.i64"
      .RemainderInteger => "remainder.i64"
      .NegateInteger => "negate.i64"
      .AddUnchecked => "add.i64.unchecked"
      .SubtractUnchecked => "subtract.i64.unchecked"
      .MultiplyUnchecked => "multiply.i64.unchecked"
      .Equal => "equal"
      .NotEqual => "not.equal"
      .Less => "less"
      .LessOrEqual => "less.or.equal"
      .Greater => "greater"
      .GreaterOrEqual => "greater.or.equal"
      .Not => "not"
      .Tag => "tag"
      .TagNiche => "tag.niche"
      .Jump => "jump"
      .Branch => "branch"
      .Switch => "switch"
      .Return => "return"
      .Stop => "stop"
      .Cell => "cell"
      .RunScript => "run.script"
      .Cancelled => "cancelled"
      .Suspend => "suspend"
      .Resume => "resume"
      .Finish => "finish"
      .EntryCell => "entry.cell"
      .LoadScript => "load.script"
      .RunLoaded => "run.loaded"
    }
  }
}

/** Every opcode, in the order of [Opcode.number]: the table the interpreter decodes a head word with. */
public const allOpcodes: List<Opcode> = [
  Opcode.Unreachable,
  Opcode.Move,
  Opcode.Constant,
  Opcode.Word,
  Opcode.Zero,
  Opcode.Load,
  Opcode.Store,
  Opcode.Reference,
  Opcode.Call,
  Opcode.CallClosure,
  Opcode.CallWitness,
  Opcode.WitnessTable,
  Opcode.Kernel,
  Opcode.AddInteger,
  Opcode.SubtractInteger,
  Opcode.MultiplyInteger,
  Opcode.DivideInteger,
  Opcode.RemainderInteger,
  Opcode.NegateInteger,
  Opcode.AddUnchecked,
  Opcode.SubtractUnchecked,
  Opcode.MultiplyUnchecked,
  Opcode.Equal,
  Opcode.NotEqual,
  Opcode.Less,
  Opcode.LessOrEqual,
  Opcode.Greater,
  Opcode.GreaterOrEqual,
  Opcode.Not,
  Opcode.Tag,
  Opcode.TagNiche,
  Opcode.Jump,
  Opcode.Branch,
  Opcode.Switch,
  Opcode.Return,
  Opcode.Stop,
  Opcode.Cell,
  Opcode.RunScript,
  Opcode.Cancelled,
  Opcode.Suspend,
  Opcode.Resume,
  Opcode.Finish,
  Opcode.EntryCell,
  Opcode.LoadScript,
  Opcode.RunLoaded,
]

/**
 * The opcode a head word's number names: [allOpcodes] as one `match`, which the loop decodes every instruction with
 * and which a C compiler turns into a jump table. A number no opcode has is `Unreachable`.
 */
public fn opcodeOf(number: Int): Opcode {
  match number {
    1 => Opcode.Move
    2 => Opcode.Constant
    3 => Opcode.Word
    4 => Opcode.Zero
    5 => Opcode.Load
    6 => Opcode.Store
    7 => Opcode.Reference
    8 => Opcode.Call
    9 => Opcode.CallClosure
    10 => Opcode.CallWitness
    11 => Opcode.WitnessTable
    12 => Opcode.Kernel
    13 => Opcode.AddInteger
    14 => Opcode.SubtractInteger
    15 => Opcode.MultiplyInteger
    16 => Opcode.DivideInteger
    17 => Opcode.RemainderInteger
    18 => Opcode.NegateInteger
    19 => Opcode.AddUnchecked
    20 => Opcode.SubtractUnchecked
    21 => Opcode.MultiplyUnchecked
    22 => Opcode.Equal
    23 => Opcode.NotEqual
    24 => Opcode.Less
    25 => Opcode.LessOrEqual
    26 => Opcode.Greater
    27 => Opcode.GreaterOrEqual
    28 => Opcode.Not
    29 => Opcode.Tag
    30 => Opcode.TagNiche
    31 => Opcode.Jump
    32 => Opcode.Branch
    33 => Opcode.Switch
    34 => Opcode.Return
    35 => Opcode.Stop
    36 => Opcode.Cell
    37 => Opcode.RunScript
    38 => Opcode.Cancelled
    39 => Opcode.Suspend
    40 => Opcode.Resume
    41 => Opcode.Finish
    42 => Opcode.EntryCell
    43 => Opcode.LoadScript
    44 => Opcode.RunLoaded
    _ => Opcode.Unreachable
  }
}

// --- The head word --------------------------------------------------------------------------------------------------

/** The largest value a head operand holds. Anything larger is a tail word, or a finding of the emitter. */
public const largestOperand = 65535

/** One head word: the opcode in bits 0-7, then `A`, `B` and `C` in sixteen bits each. */
public fn headWord(opcode: Opcode, a: Int, b: Int, c: Int): Int {
  opcode.number() | a << 8 | b << 24 | c << 40
}

/** The opcode number of a head word. */
public fn opcodeNumberOf(head: Int): Int {
  head & 255
}

/** Operand `A` of a head word. */
public fn operandA(head: Int): Int {
  head >> 8 & largestOperand
}

/** Operand `B` of a head word. */
public fn operandB(head: Int): Int {
  head >> 24 & largestOperand
}

/** Operand `C` of a head word. */
public fn operandC(head: Int): Int {
  head >> 40 & largestOperand
}

/**
 * How many tail words follow the head of an instruction: what the interpreter and the disassembler both step over.
 * `code[at]` is the head.
 */
public fn tailLengthOf(opcode: Opcode, head: Int): Int {
  match opcode {
    .Constant => 1
    .Word => 1
    .Call => 1 + operandB(head)
    .CallClosure => 1 + operandC(head)
    .CallWitness => 2 + operandB(head)
    .Kernel => operandA head
    .AddInteger => 1
    .SubtractInteger => 1
    .MultiplyInteger => 1
    .DivideInteger => 1
    .RemainderInteger => 1
    .NegateInteger => 1
    .Jump => 1
    .Branch => 2
    .Switch => 2 * operandB(head) + 1
    .Cell => 2
    .RunScript => 1
    .Suspend => 1
    .Cancelled => 1
    .Resume => 1
    .EntryCell => 1
    .RunLoaded => 1
    _ => 0
  }
}

// --- Kernel operations ----------------------------------------------------------------------------------------------

/**
 * What a `kernel` instruction asks of the C runtime, and the order of its operands. The number of an operation is its
 * position in [allKernelOperations]; a call of a function of the runtime is operation [kernelNativeBase] plus the
 * function's index among the symbols of the manifest (`nativeSymbols` of `./natives`), so the table of thunks the
 * kernel dispatches through is in the manifest's own order (docs/design/VM.md section 6).
 *
 * A register operand is a word offset from the frame's base, like every other operand of the bytecode.
 */
public type KernelOperation {
  /** `message, location`: `torb_panic`, which does not return. */
  case Panic
  /** `target, first, second, location, operation, kind`: every integer operation but the `Int64` fast ones, every float. */
  case Arithmetic
  /** `target, first, second, operation, kind`: a comparison the interpreter cannot make on one word (floats, `UInt64`). */
  case Compare
  /** `target, source, from, to`: a numeric conversion, the C cast of the C back end. */
  case Convert
  /** `target, count`, then per part `register, part kind`: one concatenation of every part (`torb_text_concat_parts`). */
  case TextConcat
  /** `target, first, second`: `torb_text_equal`. */
  case TextEqual
  /** `target, first, second`: `torb_text_compare`, as a sign. */
  case TextCompare
  /** `target, source`. */
  case TextByteLength
  /** `count`, then the registers of the parts: `torb_print_parts`. */
  case Print
  /** `count`, then the registers of the parts: `torb_print_error_parts`. */
  case PrintError
  /** `code`: `torb_process_exit`, which does not return. */
  case Exit
  /** `target, shape, block kind, words, count`, then per field `offset, register, width`: a new counted block. */
  case BlockNew
  /** `target, kind, count`, then the element descriptors: an empty list (kind 0), map (1) or set (2). */
  case ContainerNew
  /** `target, capacity, element, location`: `torb_channel_new`. */
  case ChannelNew
  /** `register, shape`: one count more of every counted word of the value, as its shape says. */
  case Retain
  /**
   * `register, shape`: one count less of every counted word, in the order of the C back end's drop functions. Answers
   * how many destructors it queued for the interpreter to run (docs/design/VM.md section 7).
   */
  case Release
  /** `target`: the first queued block into the register; answers the chunk of its `close()`, or -1 for none. */
  case TakeCloser
  /** `register`: the fields of a block whose `close()` ran, then the block. Answers how many destructors it queued. */
  case FinishRelease
  /** `register`: lends the block a count while its `close()` runs (`torb_closing_begin`). */
  case ClosingBegin
  /** `register`: takes the lent count back (`torb_closing_end`). */
  case ClosingEnd
  /** `kind, register`: the list (0), map (1) or set (2) the reference in the register points at, made unique. */
  case ContainerUnique
  /** `register`: the block the reference in the register points at, made unique - copied where it is shared. */
  case BlockUnique
  /** `register, index, location`: the address of an element of the list the reference points at. */
  case ElementAddress
  /** `index, path, line, column`: one location of the program, the path a text in a register. */
  case DefineLocation
  /**
   * `index, words, kind, shape, equals, hash`: one element descriptor, trivial (0), a text (1) or counted by a shape (2),
   * and the chunks of the `equals` and the `hash` it is compared and hashed by, -1 where its words decide.
   */
  case DefineElement
  /** `index, width, tag, closer, reversed`, then the common group and one group per variant: one shape. */
  case DefineShape
  /** Answers how many counted blocks are live, for the leak gate of the VM. */
  case LiveBlocks
  /** `register`: the block becomes static data, never counted and never freed. */
  case MakeImmortal
  /** `location`: the runtime's `stack overflow` panic. */
  case StackOverflow
  /** `count`, then the registers of the texts: what `Process.arguments()` answers the program the VM runs. */
  case SetArguments
  /** Opens an immortal region (`torb_begin_immortal`): what a module constant is built in. */
  case BeginImmortal
  /** Closes it (`torb_end_immortal`). */
  case EndImmortal
  /**
   * `grant`: the register of a text, one setting per line (`runtime/sandbox.c`). From here on every operation runs under
   * a recovery point, and one that stops the script answers `stoppedWord` (docs/design/SCRIPTS.md section 4).
   */
  case SandboxOpen
  /** Closes the sandbox, and drops the destructors a stopped script left queued without running them. */
  case SandboxClose
  /** `target`: the stop's location index, the length of its message, then its code points. Answers the stop's kind. */
  case TakeStop
  /** `target, source`: the code points of the text in `source`, one per word from `target` on. Answers how many. */
  case TextOut
  /**
   * `capacity`: storage for that many registers at once, so that they never move while a call of the kernel holds a
   * pointer into them - a call back into the interpreter may grow them in the middle of one.
   */
  case Reserve
  /**
   * `target, chunk, frame words, element, count`, then per argument `register, offset, width`, then the crossing tests:
   * `torb_task_new` over the kernel's resume function with room for the frame of the body `chunk`, the arguments moved
   * into it, and the task started. `element` describes the task's value, -1 for a `Void` task. The tests say whether
   * an idle worker may take the task (docs/design/CONCURRENCY.md section 16, "What crosses a worker"): -1 where a type
   * of the frame never crosses, otherwise how many follow, each a kind (0 a text, 1 a list, 2 a map or a set, 3 a
   * closure's environment) and the register of the value the runtime tests. Then the copy that makes the frame
   * movable while the pool has more than one worker ("The copy at the crossing"): -1 where a value of the frame cannot
   * be copied soundly, otherwise how many follow, each the register of a counted value and its shape.
   */
  case TaskNew
  /** `task`: answers whether the task was cancelled (`torb_task_cancelled`). */
  case TaskCancelled
  /** `task, awaited, state`: records the state and answers `torb_task_await` - 0 registered, 1 ready. */
  case TaskAwait
  /** `task, frame words`: the frame of the body, from the frame's base on, into the task block. */
  case TaskSave
  /** `task`: `torb_task_outcome`, read once after every wait. */
  case TaskOutcome
  /** `task, value, width`: the value moved into the result slot of the task block. */
  case TaskFinish
  /**
   * `chunk, frame words, target`: the entry file's body as the main task, the scheduler until it has completed, and
   * `torb_task_end_main` into the target - 0, or the exit code of a main task that ended cancelled.
   */
  case RunMain
  /** The scheduler, until every task that is queued has run (`torb_scheduler_run(NULL)`). */
  case SchedulerRun
  /** Every task still running cancelled and run to its stop (`torb_scheduler_finish`). */
  case SchedulerFinish
  /** Answers the address of the first word of the list the operation is read from: how the loop reads its code. */
  case ListAddress
  /** Answers the address of the first register, which never moves once the registers are reserved. */
  case RegisterAddress
  /**
   * `target, list, from, to, location`: `torb_list_slice_copied`, what a slice of a list whose items may hold an object
   * with a destructor calls instead of the thunk of `torb_list_slice`, with that thunk's operands.
   */
  case ListSliceCopied
  /**
   * A sandboxed script stopped inside the call back that is answering: the call back passes the stop on to the
   * operation that made the call, which stops as well (`runtime/machine.c`, `torb_machine_call_back`).
   */
  case StopInCallBack
  /**
   * `chunk`: the chunk that gives the entry cells' counts back runs when the program ends in `Process.exit`, which
   * never comes back to the end of the run (`torb_process_on_exit`); -1 takes it back once the run ends normally.
   */
  case OnExit
  /**
   * `kind, number`: the next `Machine.install` is the interpreter of a worker of the pool's ring (kind 0) or of a thread
   * of the blocking pool (kind 1) with that number; kind 2 gives every interpreter but the first back.
   */
  case InstallFor
  /** `flag`: whether a task whose frame may cross is started portable - only while every thread has an interpreter. */
  case Portable
  /** The runtime's lock around the first build of a module constant (`torb_constant_lock`). */
  case ConstantLock
  /** `address, publish`: the lock given back, the cell's flag at the address set with a release first where `publish`. */
  case ConstantUnlock
  /** `register`: the text of a test file, whose tests come next (`torb_test_file`): the line the report prints. */
  case TestFile
  /** The summary of a test run (`torb_test_finish`), answering its exit code. */
  case TestFinish
  /**
   * `target, address, narrow`: an element of narrow storage (a [narrowCodeOf] code) read into the register, widened -
   * sign-extended or zero-extended - to the word a register holds.
   */
  case NarrowLoad
  /** `address, source, narrow`: the register's value written into narrow storage, in the element's own width. */
  case NarrowStore
  /**
   * `reference, narrow`: the word a reference points to, which a function of the runtime wrote the narrow bytes of an
   * element into, widened in place.
   */
  case Widen
  /**
   * `register, count`, then per test a kind and a register as for `TaskNew`: the environment of a closure in the
   * register made shared (`torb_share`) where every capture may cross without a transfer - so the closure may run on
   * several workers at once, and a task that holds it may move.
   */
  case Share
  /** `register`: the path of the entry file, what `Process.executablePath()` answers inside the VM. */
  case SetExecutable
  /**
   * `workers, blocking`: `tasks { ... }` of the program's `project.trb`, which the pool of `torb` starts with where
   * `TORB_WORKERS` and `TORB_BLOCKING` do not say otherwise; 0 for a number the manifest does not name.
   */
  case PoolDefaults
  /** `index, length, location`: the runtime's `index <index> is out of bounds for a length of <length>` panic. */
  case IndexOutOfBounds

  /** The name the disassembly writes. */
  fn spelling(): String {
    match self {
      .Panic => "panic"
      .Arithmetic => "arithmetic"
      .Compare => "compare"
      .Convert => "convert"
      .TextConcat => "text.concat"
      .TextEqual => "text.equal"
      .TextCompare => "text.compare"
      .TextByteLength => "text.byte.length"
      .Print => "print"
      .PrintError => "print.error"
      .Exit => "exit"
      .BlockNew => "block.new"
      .ContainerNew => "container.new"
      .ChannelNew => "channel.new"
      .Retain => "retain"
      .Release => "release"
