  }
}

/** Every kernel operation, in the order of their numbers. */
public const allKernelOperations: List<KernelOperation> = [
  KernelOperation.Panic,
  KernelOperation.Arithmetic,
  KernelOperation.Compare,
  KernelOperation.Convert,
  KernelOperation.TextConcat,
  KernelOperation.TextEqual,
  KernelOperation.TextCompare,
  KernelOperation.TextByteLength,
  KernelOperation.Print,
  KernelOperation.PrintError,
  KernelOperation.Exit,
  KernelOperation.BlockNew,
  KernelOperation.ContainerNew,
  KernelOperation.ChannelNew,
  KernelOperation.Retain,
  KernelOperation.Release,
  KernelOperation.TakeCloser,
  KernelOperation.FinishRelease,
  KernelOperation.ClosingBegin,
  KernelOperation.ClosingEnd,
  KernelOperation.ContainerUnique,
  KernelOperation.BlockUnique,
  KernelOperation.ElementAddress,
  KernelOperation.DefineLocation,
  KernelOperation.DefineElement,
  KernelOperation.DefineShape,
  KernelOperation.LiveBlocks,
  KernelOperation.MakeImmortal,
  KernelOperation.StackOverflow,
  KernelOperation.SetArguments,
  KernelOperation.BeginImmortal,
  KernelOperation.EndImmortal,
  KernelOperation.SandboxOpen,
  KernelOperation.SandboxClose,
  KernelOperation.TakeStop,
  KernelOperation.TextOut,
  KernelOperation.Reserve,
  KernelOperation.TaskNew,
  KernelOperation.TaskCancelled,
  KernelOperation.TaskAwait,
  KernelOperation.TaskSave,
  KernelOperation.TaskOutcome,
  KernelOperation.TaskFinish,
  KernelOperation.RunMain,
  KernelOperation.SchedulerRun,
  KernelOperation.SchedulerFinish,
  KernelOperation.ListAddress,
  KernelOperation.RegisterAddress,
  KernelOperation.ListSliceCopied,
  KernelOperation.StopInCallBack,
  KernelOperation.OnExit,
  KernelOperation.InstallFor,
  KernelOperation.Portable,
  KernelOperation.ConstantLock,
  KernelOperation.ConstantUnlock,
  KernelOperation.TestFile,
  KernelOperation.TestFinish,
  KernelOperation.NarrowLoad,
  KernelOperation.NarrowStore,
  KernelOperation.Widen,
  KernelOperation.Share,
  KernelOperation.SetExecutable,
  KernelOperation.PoolDefaults,
  KernelOperation.IndexOutOfBounds,
]

/**
 * What `Machine.operate` answers instead of its result when the operation stopped a sandboxed script
 * (`TORB_MACHINE_STOPPED` of `runtime/machine.c`). No operation answers it otherwise.
 */
public const stoppedWord = 0 - 9223372036854775807 - 1

/**
 * The number of the first call of a runtime function. The operations of the kernel stay below it, so a kernel that
 * grows by an operation moves no native's number, and a native added to the manifest moves no operation's.
 */
public const kernelNativeBase = 1024

/** The number a `kernel` instruction carries for an operation. */
public fn kernelNumberOf(operation: KernelOperation): Int {
  var index = 0
  for candidate in allKernelOperations {
    if candidate == operation {
      return index
    }
    index = index + 1
  }
  index
}

// --- What the tables hold -------------------------------------------------------------------------------------------

/** How one kind of counted word is retained and released. */
public type CountedKind {
  /** A `torb_text` over two words: its storage block. */
  case TextStorage
  /** A `torb_list` over two words. */
  case ListStorage
  /** A `torb_map`. */
  case MapStorage
  /** A `torb_set`. */
  case SetStorage
  case TaskObject
  case ChannelObject
  /** `torb_file *`, released through the runtime's own drop of a file. */
  case FileHandle
  /** A counted block of the VM whose contents have the shape with this index. */
  case Block(contents: Int)
  /** A closure's environment: a block (or none) whose own shape word says what it holds. */
  case Environment
  /** The payload block of a trait-typed value, which says what it holds in its own shape word as well. */
  case Payload
  /** An inline variant nested at this offset, released by its own shape because it has a tag of its own. */
  case Nested(shape: Int)

  /** The name the disassembly writes. */
  fn spelling(): String {
    match self {
      .TextStorage => "text"
      .ListStorage => "list"
      .MapStorage => "map"
      .SetStorage => "set"
      .TaskObject => "task"
      .ChannelObject => "channel"
      .FileHandle => "file"
      .Block(contents) => "block {contents}"
      .Environment => "environment"
      .Payload => "payload"
      .Nested(shape) => "nested {shape}"
    }
  }
}

/** One counted word of a value: where it is, and what it is. */
public type CountedWord {
  offset: Int
  kind: CountedKind
}

/**
 * How a value of one type is retained and released: its counted words, in the order the C back end's helpers visit
 * them, and for a variant the tag word and the counted words of each group.
 *
 * The shape of a counted block's *contents* is a shape too, with the `close()` of the object where its type implements
 * `Close` - the destructor its release runs before the fields (docs/design/DESTRUCTORS.md 2 and 8).
 */
public type Shape {
  /** What it is the shape of, for the disassembly: the mangled name of the layout, or the type's own word. */
  name: String
  width: Int
  counted: List<CountedWord> = []
  /** The word the tag is in, or `-1` for a value that is no inline variant. */
  tag: Int = -1
  /** The counted words of every variant's group, by variant. */
  groups: List<List<CountedWord>> = []
  /** Fields released in reverse declaration order, the variant's group first: a layout that may hold a `Close` object. */
  isReversed: Bool = false
  /** The chunk of the `close()` a release of this block runs first, or `-1`. */
  closer: Int = -1
}

/** One part of the constant pool: what the interpreter places into its words when it loads the program. */
public type ConstantPart {
  /** One word, placed as it is: an integer, a `Bool`, a `Char`, the tag of an inline variant, a zero of padding. */
  case Word(value: Int)
  /** One word: the bits of the float. */
  case Floating(value: Float)
  /** Two words: an immortal copy of the text. */
  case Text(value: String)
  /** One word: an immortal counted block of the VM, holding these parts, with this shape of its contents. */
  case Block(shape: Int, parts: List<ConstantPart>)
  /**
   * Words the program writes itself, zero when it is loaded: the flag and the value of a module constant's cell, or
   * what a host keeps below every frame (the bindings of a session of `torb repl`, docs/design/REPL.md section 5).
   */
  case Gap(width: Int)
}

/** One step of a compiled place. */
public type PlaceStep {
  /** Move this many words further into the value. */
  case Offset(words: Int)
  /** The word here is the pointer to a counted block: go on at the first word of its contents. */
  case Dereference
  /**
   * An element of the contiguous list here: `torb_list_element_address`, which makes the storage unique and panics
   * with `index <index> is out of bounds for a length of <count>` at `location` for an index out of range.
   */
  case Element(index: Int, location: Int)
  /**
   * An item of the `Array<Item, Size>` here, which holds its items inline: `index` items of `width` words further on,
   * after the index is checked against `size` - out of range it panics as the list does, at `location`.
   */
  case Item(index: Int, size: Int, width: Int, location: Int)
}

/**
 * A place of the IR, compiled: its base register, whether that register holds a reference (a `var` parameter) that
 * the path starts from instead, the steps, and the width of what the place ends in.
 */
public type Place {
  base: Int
  isThroughReference: Bool
  steps: List<PlaceStep>
  width: Int
  /**
   * The [narrowCode] of the element the place ends in, where that is an element of a list stored narrower than a word;
   * 0 otherwise. A load and a store of such a place read and write the element's own width.
   */
  narrow: Int = 0
}

/** Where a witness table comes from at one call site. */
public type WitnessRootEntry {
  /** A static table of the program, by index. */
  case Table(table: Int)
  /** The table word of the trait-typed value at a place of the chunk, for one of its bounds. */
  case Value(place: Int, bound: Int)
}

/** A witness source of the IR, compiled: its root and the nested steps below it. */
public type WitnessEntry {
  root: WitnessRootEntry
  steps: List<Int> = []
}

/** One witness table: the chunk of every member (`-1` where the member is not emitted), and the nested tables. */
public type TableEntry {
  name: String
  members: List<Int>
  /** The index of the table of every direct supertrait, `-1` where there is none. */
  nested: List<Int>
  /** The shape of the contents of the payload block a value of the table's target is boxed in, or `-1`. */
  payload: Int = -1
  /** The word width of the target, which is what a member reads out of the payload block. */
  payloadWidth: Int = 0
}

/** What an element of a runtime container is, for the descriptor the interpreter makes of it when it loads. */
public type ElementKind {
  /** Nothing counted: no callbacks at all. */
  case Trivial
  /** A `String`: the runtime's own `torb_element_text`. */
  case TextElement
  /** Anything else counted: the element's shape, and the chunks of the equality and the hash where it has them. */
  case Counted(shape: Int)
  /**
   * An integer narrower than a word, a `Bool` or a `Char`: stored in its own width, as the C back end stores it, so a
   * function of the runtime that reads a `List<UInt8>` reads bytes. `code` is its [narrowCodeOf].
   */
  case Narrow(code: Int)
}

/**
 * How a value is stored narrower than a word: its bytes times four plus its kind - 1 signed, 2 unsigned (a `Bool` and
 * a `Char` too) - and 0 for a value stored in words. A register always holds the value widened to a word.
 */
public fn narrowCode(bytes: Int, isSigned: Bool): Int {
  bytes * 4 + (if isSigned { 1 } else { 2 })
}

/** Whether a narrow code is of a signed integer, which a read of the storage has to sign-extend. */
public fn isSignedNarrow(code: Int): Bool {
  code % 4 == 1
}

/** One element descriptor, as the interpreter makes it. */
public type ElementEntry {
  name: String
  words: Int
  kind: ElementKind
  /** The chunk of the element's `equals`, or `-1`. */
  equals: Int = -1
  /** The chunk of the element's `hash`, or `-1`. */
  hash: Int = -1
  /**
   * Whether two elements are equal exactly when their words are: nothing counted, no float (whose `==` is IEEE's, so
   * `nan` differs from itself and `-0.0` equals `0.0`). A key of such a type needs no call of its `equals` at all.
   */
  comparesByWords: Bool = false
}

/** One parameter of a chunk: where its words are, and whether it takes a reference word instead of a value. */
public type ParameterEntry {
  offset: Int
  width: Int
  isReference: Bool
  /**
   * The shape the interpreter retains the argument by when the chunk is called through a witness table, where the
   * member takes it owned and the erased convention borrows every operand (the C back end's witness thunk does the
   * same); `-1` where there is nothing to retain.
   */
  retainedThroughWitness: Int = -1
  /**
   * The shape of the value the parameter holds or refers to, plus one, `0` where nothing in it is counted: what a host
   * releases a value it passed in by when it lets go of it. Only an entry chunk of the emission carries it.
   */
  valueShape: Int = 0
  /** The words of that value: what a host reserves for a value a `var` parameter refers to. Only for an entry chunk. */
  valueWidth: Int = 0
}

/** One slot of a frame, for the disassembly: the IR slot, its register and width, and its type. */
public type FrameSlot {
  slot: Int
  offset: Int
  width: Int
  description: String
}

/** One function, encoded. */
public type Chunk {
  /** The mangled name of the function. */
  name: String
  parameters: List<ParameterEntry>
  /** How many words the result has (0: none). */
  resultWidth: Int
  /** Whether the first parameter is an environment, which a closure call fills from the closure value. */
  takesEnvironment: Bool = false
  /** How many words the frame needs, the scratch registers included. */
  frameWords: Int
  /** Where the function begins, as a location index: the site of a `stack overflow` panic on entering it. */
  location: Int
  slots: List<FrameSlot> = []
  var code: ArrayList<Int>
  var places: List<Place> = []
  var witnesses: List<WitnessEntry> = []
  /** The code offset every block of the IR starts at, by block: what the disassembly labels. */
  var blockStarts: List<Int> = []
  /**
   * `(code offset, location index)` of every block and every instruction that carries a location, in code order: where
   * a sandboxed script was when it stopped (docs/design/SCRIPTS.md section 6).
   */
  var sites: List<(Int, Int)> = []
  /** Whether the chunk is the body of a task, which only the scheduler runs, through the kernel. */
  isTask: Bool = false
  /** The register a task's body holds its task in, right after its slots; `-1` for every other chunk. */
  taskRegister: Int = -1
  /** A task's body: the code offset each state goes on at, by state, 0 the entry. */
  resumes: List<Int> = []

  /** How many words of a task's frame a suspension saves: its slots and its task register. */
  fn savedWords(): Int {
    taskRegister + 1
  }
}

/** The whole program, as the interpreter loads it. */
public type BytecodeProgram {
  var chunks: List<Chunk> = []
  /**
   * The chunks the program runs, in order: the top-level code of the entry file, or of every test file - `-1` for a
   * test file that runs nothing, whose name the report prints all the same.
   */
  var entries: List<Int> = []
  /** A test run's file of every entry, by position: what the report prints in front of its tests. Empty otherwise. */
  var entryFiles: List<String> = []
  /**
   * The words below the first frame, in order: the static values, and the gaps a module constant's cell (per cell a
   * flag that says it is built, then its value) or a host keeps its own words in.
   */
  var constants: List<ConstantPart> = []
  /** How many words the constant pool places. The first frame begins after them. */
  var constantWords: Int = 0
  var shapes: List<Shape> = []
  var tables: List<TableEntry> = []
  var elements: List<ElementEntry> = []
  var locations: List<Location> = []
  /** Whether the program starts a task: its run hands the scheduler what is left, and finishes it at the end. */
  var usesTasks: Bool = false
  /** The chunk that gives the count of every entry cell back once the program is done, `-1` where it has none. */
  var entryCellRelease: Int = -1
}

/** The width of the words of a constant part. */
public fn widthOfPart(part: ConstantPart): Int {
  match part {
    .Word(_) => 1
    .Floating(_) => 1
    .Text(_) => 2
    .Block(_, _) => 1
    .Gap(width) => width
  }
}
