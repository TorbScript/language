use LiteralValue from "../../semantics/checker/type"
use IrProgram, IrFunction, IrTypeId, LayoutId, StaticId, StaticValue from "../../ir/ir"
use Slot, Instruction from "../../ir/ir"
use Layout, FieldLayout, containsCountedType from "../../ir/layout"
use typeOfReference from "../../ir/verify"
use hexDigits from "../../ir/mangle"
use nativeEntries from "./natives"
use Emission, add, addAll, addBlank, reportUnsupported, emittedText from "./emission"
use cTypeOf, whyNoCType, hasStructDefinition, memberNameOf, variantMemberNameOf from "./type"
use typeDefinitionLines, layoutDefinitionOrder from "./type"
use bodyOf, emitFunctionBody, signatureHeadOf, valueTypeOf, emptyNicheText, variantInitializerParts from "./body"
use boxedLayoutOf, countedFormOf, inlineCountedLayoutOf from "./body"
use retainStatement, releaseStatement, describeCounted from "./body"

/**
 * One portable C11 translation unit for a whole program (BACKEND 3.6).
 *
 * It is a **pure function of the `IrProgram`**: every table is sorted by its mangled name before it is written and
 * every walk is depth first over that order, so two runs of the compiler produce the same bytes and the fixpoint of
 * milestone 6 is about the compiler and not about a `Map` iteration order. No path of a machine, no time and no build
 * id can reach the output either: a location carries the path the lowering interned, relative to the workspace root.
 *
 * What the back end cannot emit yet is a **finding** and never C that does not compile: `torb build` reports the
 * findings and refuses, exactly as `torb ir` counts what the lowering does not lower yet.
 */

/** Everything one translation unit is: the C, and what the back end could not emit. */
public fn emitProgram(program: IrProgram, entry: String): Emission {
  var emission = Emission()
  const functions = emittedFunctionsOf(program)
  const layouts = usedLayoutsOf(program, functions)
  const prototypes = runtimePrototypes()
  checkProgramTypes(emission, program, functions, layouts)
  emitHeader(emission)
  emitTypeDefinitions(emission, program, layouts)
  emitCountedHelpers(emission, program, functions, layouts)
  emitStaticData(emission, program, functions)
  emitFunctions(emission, program, functions, prototypes)
  emitMain(emission, entry)
  emission
}

/** The whole C of a program, for `--emit-c` and for the snapshot tests. */
public fn emittedProgramText(program: IrProgram, entry: String): String {
  const emission = emitProgram(program, entry)
  emittedText(emission)
}

/**
 * Every function that has a body, sorted by mangled name. A `native fn` the runtime provides is not emitted: it is a
 * symbol the linker finds, declared by `torb_natives.h`.
 */
public fn emittedFunctionsOf(program: IrProgram): List<IrFunction> {
  var found: List<IrFunction> = []
  for function in program.functions {
    if const .Runtime(_) = function.kind {
      continue
    }
    found.add(function)
  }
  found.sort({ _.name })
  found
}

fn emitHeader(var emission: Emission) {
  addAll(emission, [
    "/*",
    " * Generated by the TorbScript compiler. Do not edit.",
    " *",
    " * One translation unit for the whole program (docs/BACKEND.md 3.6). Everything here talks to the runtime through",
    " * runtime/include/torb.h and nothing else, and it is a pure function of the typed IR: no path of this machine,",
    " * no time and no build id is in it, so two runs of the compiler write the same bytes.",
    " */",
    "",
    "#include \"torb.h\"",
    "#include \"torb_natives.h\"",
  ])
}

// --- Are all the types there? ---------------------------------------------------------------------------------------

/**
 * Whether every type the program uses has a C spelling, asked once, before anything is written. That keeps every other
 * part of the emitter free of the question and makes the findings a property of the program instead of of the order in
 * which the emitter happened to walk it.
 */
fn checkProgramTypes(var emission: Emission, program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>) {
  for index in 0..layouts.length() {
    if !layouts[index] {
      continue
    }
    const layout = program.layouts[index]
    for field in layout.fields {
      checkType(emission, program, field.annotation)
    }
  }
  for function in functions {
    checkType(emission, program, function.signature.result)
    for parameter in function.signature.parameters {
      checkType(emission, program, parameter.annotation)
    }
    for slot in function.slots {
      checkType(emission, program, slot.annotation)
    }
    if const .TaskResume = function.kind {
      reportUnsupported(emission, "a function whose body is a state machine over `Task` (milestone 7.3)")
    }
  }
  if !program.elements.isEmpty() {
    reportUnsupported(emission, "an element descriptor of a runtime container (milestone 5.7)")
  }
  if !program.witnessTables.isEmpty() {
    reportUnsupported(emission, "a witness table (milestone 5.6)")
  }
}

fn checkType(var emission: Emission, program: IrProgram, id: IrTypeId) {
  if !cTypeOf(program, id).isEmpty() {
    return
  }
  const what = whyNoCType(program, id)
  reportUnsupported(emission, what)
}

// --- Which layouts are used at all ----------------------------------------------------------------------------------

/**
 * The layouts the emitted functions reach, by index: the type of every slot, parameter and result, everything a
 * `Construct` builds, and then everything those layouts store in their fields.
 *
 * Nothing unreachable is emitted, which is what keeps a type the back end cannot spell yet from refusing a program
 * that never mentions it.
 */
fn usedLayoutsOf(program: IrProgram, functions: List<IrFunction>): List<Bool> {
  var used: List<Bool> = []
  for _ in 0..program.layouts.length() {
    used.add(false)
  }
  var pending: List<Int> = []
  for function in functions {
    markLayoutOfType(program, used, pending, function.signature.result)
    for parameter in function.signature.parameters {
      markLayoutOfType(program, used, pending, parameter.annotation)
    }
    for slot in function.slots {
      markLayoutOfType(program, used, pending, slot.annotation)
    }
    for block in function.blocks {
      for instruction in block.instructions {
        if const .Construct(_, layout, _, _) = instruction {
          markLayout(program, used, pending, layout)
        }
      }
    }
  }
  while !pending.isEmpty() {
    const last = pending.length() - 1
    const current = pending[last]
    pending.removeAt(last)
    for field in program.layouts[current].fields {
      markLayoutOfType(program, used, pending, field.annotation)
    }
  }
  used
}

fn markLayoutOfType(program: IrProgram, var used: List<Bool>, var pending: List<Int>, id: IrTypeId) {
  if !program.hasType(id) {
    return
  }
  match program.typeAt(id) {
    .Record(layout) => markLayout(program, used, pending, layout)
    .Variant(layout) => markLayout(program, used, pending, layout)
    .Tuple(layout) => markLayout(program, used, pending, layout)
    .SharedObject(layout) => markLayout(program, used, pending, layout)
    .FixedArray(item, _) => markLayoutOfType(program, used, pending, item)
    .Box(item) => markLayoutOfType(program, used, pending, item)
    .Lazy(item) => markLayoutOfType(program, used, pending, item)
    .Runtime(_, arguments) => {
      for argument in arguments {
        markLayoutOfType(program, used, pending, argument)
      }
    }
    _ => {}
  }
}

fn markLayout(program: IrProgram, var used: List<Bool>, var pending: List<Int>, id: LayoutId) {
  if !program.hasLayout(id) {
    return
  }
  if used[id.value] {
    return
  }
  used.set(id.value, true)
  pending.add(id.value)
}

// --- Type definitions -----------------------------------------------------------------------------------------------

/**
 * Every layout, forward declared first and then defined in an order in which nothing needs what is not complete yet.
 * A forward declaration for all of them is what makes a pointer to a counted block work whatever the order is.
 */
fn emitTypeDefinitions(var emission: Emission, program: IrProgram, layouts: List<Bool>) {
  const order = layoutDefinitionOrder(program)
  var names: List<String> = []
  for id in order {
    if !layouts[id.value] {
      continue
    }
    const layout = program.layoutAt(id)
    if !hasStructDefinition(layout) {
      continue
    }
    names.add(layout.name)
  }
  if names.isEmpty() {
    return
  }
  addBlank(emission)
  add(emission, "/* The layouts of the program (docs/BACKEND.md 3.1). */")
  var sorted = names
  sorted.sort({ _ })
  for name in sorted {
    add(emission, "typedef struct {name} {name};")
  }
  for id in order {
    if !layouts[id.value] {
      continue
    }
    const layout = program.layoutAt(id)
    if !hasStructDefinition(layout) {
      continue
    }
    addBlank(emission)
    const lines = typeDefinitionLines(program, layout)
    addAll(emission, lines)
  }
}

// --- Retaining and dropping the children of a counted block ---------------------------------------------------------

/**
 * The two functions `torb_release` and `torb_make_unique` take for a counted block of the program: `R_<layout>` retains
 * the counted values inside it after a shallow copy, `D_<layout>` releases them (BACKEND 2.1, 5.R1).
 *
 * The very same pair is what a `Copy`, a `Retain` and a `Release` of an **inline** aggregate are: such a value carries no
 * count of its own and owns one on each of its fields, so both of them mean "per counted field".
 *
 * Each of the two is emitted only where something really calls it, because an unused `static` function is a warning and
 * the generated C compiles with `-Werror` - which is why the demand is two sets and not one. Everything is declared
 * before anything is defined, so a helper may call the helper of a field whatever the order of the names is.
 */
fn emitCountedHelpers(var emission: Emission, program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>) {
  const demand = helperDemandOf(program, functions, layouts)
  if demand.retained.isEmpty() && demand.dropped.isEmpty() {
    return
  }
  addBlank(emission)
  add(emission, "/* Retaining and dropping the counted values inside a layout (docs/BACKEND.md 2.1). */")
  for index in demand.retained {
    add(emission, "static void R_{program.layouts[index].name}(void *block);")
  }
  for index in demand.dropped {
    add(emission, "static void D_{program.layouts[index].name}(void *block);")
  }
  for index in demand.retained {
    const layout = program.layouts[index]
    addBlank(emission)
    add(emission, "static void R_{layout.name}(void *block) \{")
    add(emission, "  {layout.name} *value = ({layout.name} *)block;")
    emitChildLines(emission, program, layout, true)
    add(emission, "\}")
  }
  for index in demand.dropped {
    const layout = program.layouts[index]
    addBlank(emission)
    add(emission, "static void D_{layout.name}(void *block) \{")
    add(emission, "  {layout.name} *value = ({layout.name} *)block;")
    emitChildLines(emission, program, layout, false)
    add(emission, "\}")
  }
}

/**
 * One statement per counted field. A variant layout switches on the tag: the common fields first, then the group of the
 * variant the value really is - which is the whole reason a counted field inside a case had to wait for this
 * sub-milestone.
 */
fn emitChildLines(var emission: Emission, program: IrProgram, layout: Layout, isRetain: Bool) {
  var written = 0
  const common = if layout.variants.isEmpty() { layout.fields } else { layout.commonFields() }
  for field in common {
    const place = "value->{memberNameOf(field)}"
    if childStatement(emission, program, place, field, isRetain).isEmpty() {
      continue
    }
    written = written + 1
  }
  var groups: List<List<String>> = []
  var total = 0
  for index in 0..layout.variants.length() {
    var lines: List<String> = []
    for field in layout.fieldsOfVariant(index) {
      // The group of a variant lives in the union, which is where its fields have to be reached
      const place = "value->payload.{variantMemberNameOf(index)}.{memberNameOf(field)}"
      const statement = childStatementText(emission, program, place, field, isRetain)
      if statement.isEmpty() {
        continue
      }
      lines.add(statement)
    }
    total = total + lines.length()
    groups.add(lines)
  }
  if total > 0 {
    add(emission, "  switch (value->tag) \{")
    for index in 0..groups.length() {
      if groups[index].isEmpty() {
        continue
      }
      add(emission, "    case {index}:")
      for line in groups[index] {
        add(emission, "      {line}")
      }
      add(emission, "      break;")
    }
    add(emission, "    default: break;")
    add(emission, "  \}")
    written = written + total
  }
  if written == 0 {
    add(emission, "  (void)value;")
  }
}

/** One field of the layout itself, written out. Answers the statement so that a caller can count what it wrote. */
fn childStatement(
  var emission: Emission,
  program: IrProgram,
  place: String,
  field: FieldLayout,
  isRetain: Bool,
): String {
  const statement = childStatementText(emission, program, place, field, isRetain)
  if statement.isEmpty() {
    return statement
  }
  add(emission, "  {statement}")
  statement
}

fn childStatementText(
  var emission: Emission,
  program: IrProgram,
  place: String,
  field: FieldLayout,
  isRetain: Bool,
): String {
  if !containsCountedType(program, field.annotation) {
    return ""
  }
  const statement = if isRetain {
    retainStatement(program, field.annotation, place)
  } else {
    releaseStatement(program, field.annotation, place)
  }
  if statement.isEmpty() {
    reportUnsupported(emission, "a counted field that is {describeCounted(program, field.annotation)}")
  }
  statement
}

/** Which layouts need `R_` and which need `D_`. Two sets, because a layout that is only released needs only one. */
type HelperDemand {
  retained: List<Int>
  dropped: List<Int>
}

/**
 * The layouts the emitted C really calls a helper of: every position that retains or releases a value, plus - because a
 * helper walks the fields of its layout - the layouts those fields need one of.
 */
fn helperDemandOf(program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>): HelperDemand {
  const count = program.layouts.length()
  var retains = filledFalse(count)
  var drops = filledFalse(count)
  for function in functions {
    for block in function.blocks {
      for instruction in block.instructions {
        collectHelperDemand(program, function, instruction, retains, drops)
      }
    }
  }
  closeHelperDemand(program, retains, drops)
  HelperDemand(sortedLayouts(program, retains, layouts), sortedLayouts(program, drops, layouts))
}

fn filledFalse(count: Int): List<Bool> {
  var filled: List<Bool> = []
  for _ in 0..count {
    filled.add(false)
  }
  filled
}

fn collectHelperDemand(
  program: IrProgram,
  function: IrFunction,
  instruction: Instruction,
  var retains: List<Bool>,
  var drops: List<Bool>,
) {
  var ignored: List<String> = []
  match instruction {
    .Copy(_, source) => markRetained(program, retains, typeOfSlotOf(function, source))
    .Retain(slot) => markRetained(program, retains, typeOfSlotOf(function, slot))
    .Release(slot) => markDropped(program, drops, typeOfSlotOf(function, slot))
    // The result of a read of a counted field arrives owned, which is one retain of the type that was read
    .Read(target, _) => markRetained(program, retains, typeOfSlotOf(function, target))
    .Write(reference, _) => {
      if const Some(inner) = typeOfReference(program, function, ignored, "", reference) {
        markDropped(program, drops, inner)
      }
    }
    // `torb_make_unique` takes both: it retains the children of the shallow copy and releases the old block
    .MakeUnique(reference) => {
      if const Some(inner) = typeOfReference(program, function, ignored, "", reference) {
        if const Some(layout) = boxedLayoutOf(program, inner) {
          markLayoutFlag(program, retains, layout)
          markLayoutFlag(program, drops, layout)
        }
      }
    }
    _ => {}
  }
}

fn typeOfSlotOf(function: IrFunction, slot: Slot): IrTypeId {
  if !function.hasSlot(slot) {
    return IrTypeId(0 - 1)
  }
  function.typeOfSlot(slot)
}

/** A retain of an inline aggregate is its `R_`; a retain of a pointer, a text or a container calls no helper. */
fn markRetained(program: IrProgram, var retains: List<Bool>, id: IrTypeId) {
  if const Some(layout) = inlineCountedLayoutOf(program, countedFormOf(program, id)) {
    markLayoutFlag(program, retains, layout)
  }
}

fn markDropped(program: IrProgram, var drops: List<Bool>, id: IrTypeId) {
  const inner = countedFormOf(program, id)
  if const Some(layout) = boxedLayoutOf(program, inner) {
    markLayoutFlag(program, drops, layout)
    return
  }
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    markLayoutFlag(program, drops, layout)
  }
}

fn markLayoutFlag(program: IrProgram, var flags: List<Bool>, layout: LayoutId) {
  if !program.hasLayout(layout) {
    return
  }
  if !program.layoutAt(layout).containsCounted {
    return
  }
  flags.set(layout.value, true)
}

/** A helper walks the fields of its layout, and a counted field may need a helper of its own. */
fn closeHelperDemand(program: IrProgram, var retains: List<Bool>, var drops: List<Bool>) {
  const limit = program.layouts.length() + 1
  var rounds = 0
  var isChanged = true
  while isChanged {
    isChanged = false
    rounds = rounds + 1
    if rounds > limit {
      return
    }
    for index in 0..program.layouts.length() {
      const layout = program.layouts[index]
      for field in layout.fields {
        if retains[index] {
          var grown = retains
          markRetained(program, grown, field.annotation)
          if grown != retains {
            retains = grown
            isChanged = true
          }
        }
        if !drops[index] {
          continue
        }
        var found = drops
        markDropped(program, found, field.annotation)
        if found != drops {
          drops = found
          isChanged = true
        }
      }
    }
  }
}

/** The marked layouts that are emitted at all, sorted by name so that the output is a function of the program. */
fn sortedLayouts(program: IrProgram, flags: List<Bool>, layouts: List<Bool>): List<Int> {
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for index in 0..flags.length() {
    if !flags[index] || !layouts[index] {
      continue
    }
    const name = program.layouts[index].name
    if !byName.containsKey(name) {
      byName.set(name, index)
      names.add(name)
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var found: List<Int> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      found.add(index)
    }
  }
  found
}

// --- Static data ----------------------------------------------------------------------------------------------------

/**
 * The compile-time constants, as static data (BACKEND 0): a string literal as an immortal `torb_bytes` with a
 * `torb_text` slice over it, a number as a `static const`, an aggregate as one initializer.
 *
 * A C initializer has to be a constant expression, and the value of another `static const` is not one - so an
 * aggregate spells the *values* of its fields out instead of naming them, and only the constants an instruction really
 * names become objects of their own. That is also what keeps an unused one, which is a warning, out of the output.
 */
fn emitStaticData(var emission: Emission, program: IrProgram, functions: List<IrFunction>) {
  const named = namedStaticsOf(program, functions)
  const all = closedStaticsOf(program, named)
  var storages: List<String> = []
  for id in all {
    const value = program.staticAt(id)
    if textOfStatic(value).isSome() {
      storages.add(value.name)
    }
  }
  if !storages.isEmpty() {
    addBlank(emission)
    add(emission, "/* The storage of every string literal: immortal, so a write through one always copies. */")
    for id in all {
      emitTextStorage(emission, program, id)
    }
  }
  if named.isEmpty() {
    return
  }
  addBlank(emission)
  add(emission, "/* The compile-time constants of the program. */")
  for id in named {
    const value = program.staticAt(id)
    const spelling = valueTypeOf(program, value.annotation)
    const initializer = staticValueText(emission, program, value)
    add(emission, "static const {spelling} {value.name} = {initializer};")
  }
}

/** The statics an instruction names, sorted by name: everything the rest of the program refers to by that name. */
fn namedStaticsOf(program: IrProgram, functions: List<IrFunction>): List<StaticId> {
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for function in functions {
    for block in function.blocks {
      for instruction in block.instructions {
        if const .Constant(_, value) = instruction {
          if program.hasStatic(value) {
            const name = program.staticAt(value).name
            if !byName.containsKey(name) {
              byName.set(name, value.value)
              names.add(name)
            }
          }
        }
      }
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var found: List<StaticId> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      found.add(StaticId(index))
    }
  }
  found
}

/** Those statics plus everything their initializers spell out, so that every storage that is named is there. */
fn closedStaticsOf(program: IrProgram, named: List<StaticId>): List<StaticId> {
  var seen: Map<Int, Bool> = [:]
  var order: List<StaticId> = []
  var pending = named
  while !pending.isEmpty() {
    const last = pending.length() - 1
    const current = pending[last]
    pending.removeAt(last)
    if seen.containsKey(current.value) || !program.hasStatic(current) {
      continue
    }
    seen.set(current.value, true)
    order.add(current)
    for inner in childStaticsOf(program, current) {
      pending.add(inner)
    }
  }
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for id in order {
    const name = program.staticAt(id).name
    if !byName.containsKey(name) {
      byName.set(name, id.value)
      names.add(name)
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var found: List<StaticId> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      found.add(StaticId(index))
    }
  }
  found
}

fn childStaticsOf(program: IrProgram, id: StaticId): List<StaticId> {
  match program.staticAt(id).contents {
    .Aggregate(_, _, fields) => fields
    .Items(_, items) => items
    _ => []
  }
}

/** `None` unless the static is a string literal, in which case it is its text. */
fn textOfStatic(value: StaticValue): String? {
  if const .Literal(literal) = value.contents {
    if const .Text(text) = literal {
      return Some(text)
    }
  }
  None
}

/**
 * The bytes of a string literal, as the immortal `torb_bytes` of the ABI. The array holds at least one byte, because a
 * zero-length array is not C; a text of length zero never looks at it.
 */
fn emitTextStorage(var emission: Emission, program: IrProgram, id: StaticId) {
  const value = program.staticAt(id)
  const text = match textOfStatic(value) {
    Some(found) => found
    .None => {
      return
    }
  }
  var bytes: List<String> = []
  for byte in text.bytes() {
    bytes.add("0x{hexDigits(Int.from(byte), 2)}")
  }
  const count = bytes.length().max(1)
  if bytes.isEmpty() {
    bytes.add("0x00")
  }
  const written = bytes.joined(separator: ", ")
  add(emission, "static struct \{ torb_header header; uint32_t capacity; uint8_t data[{count}]; \}")
  add(emission, "  {storageNameOf(value)} = \{ TORB_IMMORTAL_HEADER(TORB_BLOCK_BYTES), {count}, \{ {written} \} \};")
}

fn storageNameOf(value: StaticValue): String {
  "{value.name}_storage"
}

/** The initializer of one constant. Every part of it is a C constant expression, which a `static` needs. */
fn staticValueText(var emission: Emission, program: IrProgram, value: StaticValue): String {
  match value.contents {
    .Literal(literal) => literalText(value, literal)
    .Floating(number) => floatText(emission, number)
    .VoidValue => "0"
    .Aggregate(layout, variant, fields) => aggregateText(emission, program, layout, variant, fields)
    .Items(_, _) => {
      reportUnsupported(emission, "a static `Array<Item, Size>` (milestone 5.9)")
      "\{ 0 \}"
    }
  }
}

fn literalText(value: StaticValue, literal: LiteralValue): String {
  match literal {
    .Integer(number) => integerText(number)
    .Boolean(flag) => if flag { "true" } else { "false" }
    .Character(character) => "0x{hexDigits(Int.from(character), 6)}"
    .Text(text) => {
      const name = storageNameOf(value)
      "\{ (torb_bytes *)&{name}, 0, {byteCountOf(text)} \}"
    }
  }
}

fn byteCountOf(text: String): Int {
  text.byteLength()
}

/** The smallest signed 64 bit number has no literal in C, because the minus is an operator and the digits overflow. */
fn integerText(number: Int): String {
  if number == 0 - 9223372036854775807 - 1 {
    return "(-9223372036854775807 - 1)"
  }
  "{number}"
}

/**
 * A float constant as the shortest decimal that reads back as the same value, which is what `Show` of a `Float`
 * answers. A value that is not finite cannot be a compile-time constant (decided gap 11), so there is nothing else.
 */
fn floatText(var emission: Emission, number: Float): String {
  const shown = "{number}"
  if shown.contains("n") || shown.contains("N") || shown.contains("i") {
    reportUnsupported(emission, "a constant that is not a finite number")
    return "0.0"
  }
  if shown.contains(".") || shown.contains("e") {
    return shown
  }
  "{shown}.0"
}

fn aggregateText(
  var emission: Emission,
  program: IrProgram,
  layout: LayoutId,
  variant: Int,
  fields: List<StaticId>,
): String {
  if !program.hasLayout(layout) {
    reportUnsupported(emission, "a constant of a layout that is not in the program")
    return "\{ 0 \}"
  }
  const shape = program.layoutAt(layout)
  var written: List<String> = []
  for field in fields {
    const inner = program.staticAt(field)
    const text = staticValueText(emission, program, inner)
    written.add(text)
  }
  match shape.representation {
    .Boxed => {
      reportUnsupported(emission, "a constant of a counted type (milestone 5.4)")
      "\{ 0 \}"
    }
    .Niche(payload, _) => {
      if variant == payload {
        return written.get(0) ?? "\{ 0 \}"
      }
      emptyNicheText(program, shape)
    }
    .Inline => {
      if shape.variants.isEmpty() {
        if written.isEmpty() {
          return "\{ 0 \}"
        }
        return "\{ {written.joined(separator: ", ")} \}"
      }
      variantConstantText(shape, variant, written)
    }
  }
}

fn variantConstantText(shape: Layout, variant: Int, written: List<String>): String {
  "\{ {variantInitializerParts(shape, variant, written).joined(separator: ", ")} \}"
}

// --- Functions and `main` -------------------------------------------------------------------------------------------

fn emitFunctions(
  var emission: Emission,
  program: IrProgram,
  functions: List<IrFunction>,
  prototypes: Map<String, String>,
) {
  if functions.isEmpty() {
    return
  }
  addBlank(emission)
  add(emission, "/* Every function of the program, sorted by its mangled name. */")
  for function in functions {
    const head = signatureHeadOf(program, function)
    add(emission, "{head};")
  }
  for function in functions {
    addBlank(emission)
    const comment = commentOf(program, function)
    add(emission, comment)
    const body = bodyOf(program, function, prototypes)
    emitFunctionBody(emission, program, body)
  }
}

/** One comment per function with the name it has in the source, which a mangled name does not read like. */
fn commentOf(program: IrProgram, function: IrFunction): String {
  match function.origin {
    Some(_) => "/* {function.name} */"
    .None => "/* {function.name}: the top-level code of the entry file */"
  }
}

/**
 * The `main` of the program: the runtime first, then the top-level code of the entry file, then exit code zero. A
 * program that ends in `Process.exit` never reaches the `return`.
 */
fn emitMain(var emission: Emission, entry: String) {
  if entry.isEmpty() {
    return
  }
  addAll(emission, [
    "",
    "int main(int argument_count, char **argument_values) \{",
    "  torb_process_start(argument_count, argument_values);",
    "  {entry}();",
    "  torb_process_finish();",
    "  return 0;",
    "\}",
  ])
}

// --- The prototypes of the runtime ----------------------------------------------------------------------------------

/**
 * The C prototype of every runtime symbol the manifest declares ready, by symbol. A call of a native is checked
 * against it, so the emitter can only ever write a call the runtime really has (BACKEND 3.7).
 */
public fn runtimePrototypes(): Map<String, String> {
  var found: Map<String, String> = [:]
  for entry in nativeEntries() {
    if const .Planned(_) = entry.state {
      continue
    }
    if const .Runtime(symbol) = entry.target {
      if !found.containsKey(symbol) {
        found.set(symbol, entry.prototype)
      }
    }
  }
  found
}
