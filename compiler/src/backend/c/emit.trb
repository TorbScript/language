/**
 * One portable C11 translation unit for a whole program (BACKEND 3.6): [emitProgram] walks the [IrProgram] once and
 * writes every declaration `writer.trb` renders, in the order this file's own functions are listed below.
 *
 * It is a **pure function of the `IrProgram`**: every table is sorted by its mangled name before it is written and
 * every walk is depth first over that order, so two runs of the compiler produce the same bytes and the fixpoint test
 * (BACKEND 3.6, "What 6.2 decided") is about the compiler and not about a `Map` iteration order. No path of a
 * machine, no time and no build id can reach the output either: a location carries the path the lowering interned,
 * relative to the workspace root.
 *
 * What the back end cannot emit yet is a **finding** and never C that does not compile: `torb build` reports the
 * findings and refuses, exactly as `torb ir` counts what the lowering does not lower yet.
 *
 * # Related
 *
 * - [emittedProgramText] - the same walk, as the text `--emit-c` and the snapshot tests compare.
 * - `type.trb`, `body.trb`, `natives.trb`, `prototype.trb` - the other files this one calls into.
 */

use LiteralValue from "../../semantics/checker/type"
use IrProgram, IrFunction, IrTypeId, LayoutId, StaticId, StaticValue, FunctionId from "../../ir/ir"
use Slot, Instruction, WitnessTable, WitnessTableId, Ownership, FunctionKind, CellAccess from "../../ir/ir"
use taskMachineOf from "../../ir/suspension"
use ElementId, ElementDescriptor from "../../ir/ir"
use Layout, FieldLayout, containsCountedType from "../../ir/layout"
use typeOfReference from "../../ir/verify"
use keepingOf from "../../ir/kept"
use referencesOf from "../../ir/elements"
use closingOf from "../../ir/closing"
use hexDigits, objectTypeName, payloadLayoutName from "../../ir/mangle"
use nativeEntries from "./natives"
use CExpression, CStatement, CSwitchCase, CDeclaration, CMember, declarationOf, cStringOf from "./writer"
use Emission, write, reportUnsupported, emittedText, locationExpression, slotNameOf from "./emission"
use cTypeOf, whyNoCType, hasStructDefinition, memberNameOf, variantMemberNameOf from "./type"
use structDeclarationOf, layoutDefinitionOrder, objectDeclarationOf, arrayDeclarationOf from "./type"
use bodyOf, bodyStatements, signatureHeadOf, valueTypeOf, emptyNicheExpression, resultTypeOf from "./body"
use resultPointerName, keptFunctions, frameTypeName from "./body"
use dropFunctionOf, pointerTo, closureThunkNameOf, environmentLayoutOfFunction from "./body"
use retainChildrenFunctionOf from "./body"
use variantInitializerParts, boxedLayoutOf, countedFormOf, inlineCountedLayoutOf from "./body"
use retainStatement, releaseStatement, describeCounted from "./body"
use frameCrossingOf, framePrivateOf, privateHelperOf, privateHelperNameOf, privateHelpersNamedIn from "./crossing"

/**
 * One entry function the generated `main` calls, and what it is called for.
 *
 * An ordinary program has exactly one, whose `file` is empty: `main` runs it and leaves with zero. A **test run** has
 * one per test file - the whole suite is one binary, because every test file imports the harness and through it the
 * whole compiler, so one binary per file would be one C compile of that size per file. `file` is then the name
 * `torb test` prints in front of that file's tests, and `main` ends in the summary of `runtime/test.c` and the exit
 * code it answers instead of in a plain zero.
 */
public type ProgramEntry {
  /** The mangled name of the entry function of one module. */
  name: String
  /** The file the entry is the top-level code of, where the run is a test run. */
  file: String = ""
}

/** Everything one translation unit is: the C, and what the back end could not emit. */
public fn emitProgram(program: IrProgram, entries: List<ProgramEntry>): Emission {
  var emission = Emission()
  const functions = emittedFunctionsOf program
  const layouts = usedLayoutsOf program, functions
  const prototypes = runtimePrototypes()
  checkProgramTypes emission, program, functions, layouts
  emitHeader emission
  // The trait-typed values come first: they are made of the erased pointers of the ABI and of nothing of the program,
  // while a layout may hold one in a field - the environment of a closure over a trait-typed value is one
  emitObjectTypes emission, program, functions, layouts
  emitTypeDefinitions emission, program, functions, layouts
  // The frames of the tasks come after the layouts, because a frame slot is a value of any of them
  emitTaskFrames emission, program, functions
  emitCountedHelpers emission, program, functions, layouts
  emitPrivateHelpers emission, program, functions
  emitStaticData emission, program, functions
  emitConstantCellStorage emission, program, functions
  emitPrototypes emission, program, functions
  // The descriptors and the tables come between the prototypes and the bodies: their initializers name a thunk, and a
  // body names one of them
  emitElementDescriptors emission, program
  emitWitnessTables emission, program
  emitClosureThunks emission, program, functions
  emitDefinitions emission, program, functions, prototypes
  if !entries.isEmpty() {
    emitEntryCellRelease emission, program, functions
  }
  emitMain emission, entries, functions
  emission
}

/** The whole C of a program with one entry and no test report, for `--emit-c` and for the snapshot tests. */
public fn emittedProgramText(program: IrProgram, entry: String): String {
  const emission = emitProgram program, [ProgramEntry(entry)]
  emittedText emission
}

/**
 * Every function that has a body, sorted by mangled name. A `native fn` the runtime provides is not emitted: it is a
 * symbol the linker finds, declared by `torb_natives.h`.
 *
 * A **copy** the devirtualization made and that nothing calls any more is not emitted either ([keptFunctions]): it
 * would be a `static` function no reference reaches, which is an error under `-Wunused-function -Werror` and not
 * merely a wasted body.
 */
public fn emittedFunctionsOf(program: IrProgram): List<IrFunction> {
  const kept = keptWithDestructors program
  var found: List<IrFunction> = []
  for index in 0..program.functions.length() {
    const function = program.functions[index]
    if const .Runtime(_) = function.kind {
      continue
    }
    if !kept[index] {
      continue
    }
    found.append function
  }
  found.sort({ _.name })
  found
}

/**
 * What [keptFunctions] keeps, with the `close()` of every object whose drop function the kept functions need.
 *
 * Nothing calls a destructor but the drop function of its layout, and a drop function is emitted only where something
 * releases such an object - so a `close()` of an object the program never releases would be a `static` function
 * nothing names, which `-Werror` refuses. They start out withheld, and each one whose drop function turns out to be
 * needed joins the roots, until nothing changes: a destructor may release objects of its own.
 */
fn keptWithDestructors(program: IrProgram): List<Bool> {
  var withheld: Set<Int> = Set.of()
  for (_, function) in program.closeFunctions {
    withheld.insert function.value
  }
  var kept = keptFunctions program, withheld
  while !withheld.isEmpty() {
    var functions: List<IrFunction> = []
    for index in 0..program.functions.length() {
      if kept[index] {
        functions.append program.functions[index]
      }
    }
    const demand = demandFlagsOf program, functions
    var isChanged = false
    for (layout, function) in program.closeFunctions {
      if withheld.contains(function.value) && demand.dropped[layout] {
        const _ = withheld.remove function.value
        isChanged = true
      }
    }
    if !isChanged {
      break
    }
    kept = keptFunctions program, withheld
  }
  kept
}

/**
 * The head of the translation unit, which is fixed text and therefore a `"""` block: what a reader of `program.c` sees
 * first, and the one header everything in the file talks to the runtime through.
 */
fn emitHeader(var emission: Emission) {
  write(emission, CDeclaration.Fixed(raw"""
    /*
     * Generated by the TorbScript compiler. Do not edit.
     *
     * One translation unit for the whole program (docs/BACKEND.md 3.6). Everything here talks to the runtime through
     * runtime/include/torb.h and nothing else, and it is a pure function of the typed IR: no path of this machine,
     * no time and no build id is in it, so two runs of the compiler write the same bytes.
     */

    #include "torb.h"
    #include "torb_natives.h"

    /*
     * A witness table: everything about the *target* type that a trait-typed value has erased, then one function
     * pointer per member the ABI can reach, in the order the lowering decided (docs/BACKEND.md 1.4, the notes of 5.6
     * and 5.7).
     *
     * `drop`, `retain_children` and `size` are what `torb_release` and `torb_make_unique` need for the boxed payload.
     * A trait-typed value is a value, so a copy of one must not see a change made through the other: a `var self`
     * member therefore makes the payload block unique first, and the size and the two helpers of that block are a
     * property of the target type, which only the table still knows.
     *
     * `nested` is the table of each supertrait of this one, in declaration order, so that narrowing a trait-typed value
     * to a supertrait is one indirection and needs no knowledge of the erased target.
     *
     * The members are an array of an erased function type and every one of them is a thunk with the erased signature,
     * so a call through a table converts the pointer back to the type the function really has - which is what C allows
     * and what makes a dynamic call need no `void *` cast of an argument anywhere.
     */
    typedef void (*torb_witness_member)(void);

    typedef struct torb_witness_table {
      void (*drop)(void *);
      void (*retain_children)(void *);
      size_t size;
      const struct torb_witness_table *const *nested;
      const torb_witness_member *members;
    } torb_witness_table;
    """))
}

// --- Trait-typed values -----------------------------------------------------------------------------------------------

/** The struct of every trait-typed value the program uses, sorted by name so that the file is a function of the set. */
fn emitObjectTypes(
  var emission: Emission,
  program: IrProgram,
  functions: List<IrFunction>,
  layouts: List<Bool>,
) {
  const found = objectTypesOf program, functions, layouts
  if found.isEmpty() {
    return
  }
  write emission, CDeclaration.Comment("The trait-typed values of the program: a boxed payload and its tables.")
  for id in found {
    const name = cTypeOf program, id
    write emission, CDeclaration.Typedef("struct {name}", name)
  }
  for id in found {
    if const Some(declaration) = objectDeclarationOf(program, id) {
      write emission, declaration
    }
  }
}

/** Every `Object` type the emitted functions and the layouts they reach mention, by its C name, sorted. */
fn objectTypesOf(program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>): List<IrTypeId> {
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for index in 0..layouts.length() {
    if !layouts[index] {
      continue
    }
    for field in program.layouts[index].fields {
      collectObjectType program, names, byName, field.annotation
    }
  }
  for function in functions {
    collectObjectType program, names, byName, function.signature.result
    for parameter in function.signature.parameters {
      collectObjectType program, names, byName, parameter.annotation
    }
    for slot in function.slots {
      collectObjectType program, names, byName, slot.annotation
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var order: List<IrTypeId> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      order.append IrTypeId(index)
    }
  }
  order
}

fn collectObjectType(
  program: IrProgram,
  var names: List<String>,
  var byName: Map<String, Int>,
  id: IrTypeId,
) {
  if !program.hasType(id) {
    return
  }
  if const .Object(bounds) = program.typeAt(id) {
    const name = objectTypeName program, bounds
    if !byName.containsKey(name) {
      byName.set name, id.value
      names.append name
    }
  }
}

// --- Witness tables ---------------------------------------------------------------------------------------------------

/**
 * Every witness table of the program, sorted by name: one thunk per member, one array of them, and the table itself.
 *
 * A **thunk** is what makes a dynamic call well defined C rather than a cast between two function types that do not
 * match: it takes the payload as `const void *`, unwraps it to the concrete type, and calls the real member. So the
 * function the table points at really has the erased signature a call site converts its pointer back to.
 */
fn emitWitnessTables(var emission: Emission, program: IrProgram) {
  const order = witnessTableOrder program
  if order.isEmpty() {
    return
  }
  const names = thunkNamesOf program
  write emission, CDeclaration.Comment("The witness tables: what a trait-typed value and a dynamic call go through.")
  // One thunk per distinct name, however many tables point at it: the name says what the thunk is, so two tables that
  // reach the same member of the same target share the one function
  var written: Map<String, Bool> = [:]
  for id in order {
    const table = program.witnessTableAt id
    for index in 0..table.members.length() {
      const name = thunkNameOf program, table, index, names
      if written.containsKey(name) {
        continue
      }
      written.set name, true
      if const Some(head) = thunkHeadOf(emission, program, table, index, names) {
        write emission, CDeclaration.Prototype(head)
      }
    }
  }
  var defined: Map<String, Bool> = [:]
  for id in order {
    const table = program.witnessTableAt id
    for index in 0..table.members.length() {
      const name = thunkNameOf program, table, index, names
      if defined.containsKey(name) {
        continue
      }
      defined.set name, true
      emitThunk emission, program, table, index, names
    }
  }
  for id in order {
    const table = program.witnessTableAt id
    emitWitnessTable emission, program, table, names
  }
}

/**
 * The tables sorted by their mangled name, so that neither the C nor the thunk order depends on the lowering - except
 * that a table whose `nested` list names another one has to come **after** it: the initializer of a `static const`
 * takes the address of the nested tables, and a tentative definition of a `const` object is not portable C (MSVC
 * refuses one). The supertrait relation is a DAG, so picking the name-smallest table whose nested tables are all placed
 * is a total order and still a pure function of the set.
 */
fn witnessTableOrder(program: IrProgram): List<WitnessTableId> {
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for index in 0..program.witnessTableCount() {
    const name = program.witnessTables[index].name
    if !byName.containsKey(name) {
      byName.set name, index
      names.append name
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var order: List<WitnessTableId> = []
  var placed: Map<Int, Bool> = [:]
  for name in sorted {
    if const Some(index) = byName.get(name) {
      addWitnessTableAfterNested program, order, placed, WitnessTableId(index), 0
    }
  }
  order
}

/** One table and everything its `nested` list names, deepest first. The depth guard is the last resort against a cycle. */
fn addWitnessTableAfterNested(
  program: IrProgram,
  var order: List<WitnessTableId>,
  var placed: Map<Int, Bool>,
  id: WitnessTableId,
  depth: Int,
) {
  if placed.containsKey(id.value) || depth > 12 {
    return
  }
  placed.set id.value, true
  for inner in program.witnessTableAt(id).nested {
    if const Some(found) = inner {
      if program.hasWitnessTable(found) {
        addWitnessTableAfterNested(program, order, placed, found, depth + 1)
      }
    }
  }
  order.append id
}

/**
 * The name of every thunk of the program, by the **key** of what the thunk is: the member it calls and the payload
 * block it unwraps.
 *
 * A thunk is a function of exactly those two things - it casts `void *self` to the payload of the target and calls one
 * function of the program - so the same member of the same target reached through three traits is three copies of one
 * function. `Iterate.iterate` and `List.iterate` of one list type are such a pair, and when this was measured the whole
 * compiler had 16510 thunks of which 8221 are distinct; naming them after what they are instead of after the table they
 * happen to sit in is 11.8% of the translation unit.
 *
 * A name that two keys would share is a **collision and not a merge**: the keys of a base name are sorted and numbered,
 * so which one keeps the bare name is a function of the program and not of the order the tables were built in.
 */
fn thunkNamesOf(program: IrProgram): Map<String, String> {
  var keysOfBase: Map<String, List<String>> = [:]
  var bases: Map<String, String> = [:]
  for index in 0..program.witnessTableCount() {
    const table = program.witnessTables[index]
    for member in 0..table.members.length() {
      const key = thunkKeyOf program, table, member
      if bases.containsKey(key) {
        continue
      }
      const base = thunkBaseNameOf program, table, member
      bases.set key, base
      var keys = keysOfBase.get(base) ?? []
      keys.append key
      keysOfBase.set base, keys
    }
  }
  var names: Map<String, String> = [:]
  for (base, keys) in keysOfBase {
    if keys.length() == 1 {
      if const Some(only) = keys.first() {
        names.set only, base
      }
      continue
    }
    var sorted = keys
    sorted.sort({ _ })
    for position in 0..sorted.length() {
      names.set sorted[position], "{base}_{position}"
    }
  }
  names
}

/** What a thunk is: the function it calls, and the payload layout it casts its receiver to. */
fn thunkKeyOf(program: IrProgram, table: WitnessTable, index: Int): String {
  const payload = match payloadLayoutOfTable(program, table) {
    Some(found) => program.layoutAt(found).name
    None => "void"
  }
  const member = table.members[index]
  if !program.hasFunction(member) {
    return "?{table.name}_{index}|{payload}"
  }
  "{program.functionAt(member).name}|{payload}"
}

/** `W_acme_x2f_app_main_Small_size`: the member's own name under the thunk prefix. */
fn thunkBaseNameOf(program: IrProgram, table: WitnessTable, index: Int): String {
  const member = table.members[index]
  if !program.hasFunction(member) {
    return "W{table.name[1..table.name.byteLength()]}_{index}"
  }
  const name = program.functionAt(member).name
  "W{name[1..name.byteLength()]}"
}

/** The thunk of one member of one table. `W` is no prefix of the mangling, so nothing can collide with it. */
fn thunkNameOf(program: IrProgram, table: WitnessTable, index: Int, names: Map<String, String>): String {
  const key = thunkKeyOf program, table, index
  names.get(key) ?? thunkBaseNameOf(program, table, index)
}

/** The head of one thunk, or `None` where the member it wraps is not a function of the program. */
fn thunkHeadOf(
  var emission: Emission,
  program: IrProgram,
  table: WitnessTable,
  index: Int,
  names: Map<String, String>,
): String? {
  const member = table.members[index]
  if !program.hasFunction(member) {
    reportUnsupported emission, "a witness table member that is not a function of the program"
    return None
  }
  const function = program.functionAt member
  const signature = function.signature
  if signature.parameters.isEmpty() {
    reportUnsupported emission, "a witness table member without a receiver"
    return None
  }
  // The erased receiver is `void *` in **every** thunk, whether the member reads the payload or writes it: a call site
  // knows the member's index and not its declaration, so one spelling is what makes the cast back well defined C. The
  // `const` of a read-only member is kept one line further in, on the box the thunk unwraps.
  var parameters = ["void *self"]
  for position in 1..signature.parameters.length() {
    const spelling = valueTypeOf program, signature.parameters[position].annotation
    const written = if signature.parameters[position].isReference { pointerTo spelling } else { spelling }
    parameters.append declarationOf(written, "a{position}")
  }
  const result = resultTypeOf program, signature.result
  const written = parameters.joined separator: ", "
  const name = thunkNameOf program, table, index, names
  Some "static {declarationOf(result, "{name}({written})")}"
}

/** Whether the member the thunk wraps writes through its receiver, which is what makes the box mutable. */
fn isVarSelfMember(program: IrProgram, table: WitnessTable, index: Int): Bool {
  const member = table.members[index]
  if !program.hasFunction(member) {
    return false
  }
  const parameters = program.functionAt(member).signature.parameters
  match parameters.first() {
    Some(first) => first.isReference
    None => false
  }
}

fn emitThunk(
  var emission: Emission,
  program: IrProgram,
  table: WitnessTable,
  index: Int,
  names: Map<String, String>,
) {
  const head = match thunkHeadOf(emission, program, table, index, names) {
    Some(found) => found
    None => {
      return
    }
  }
  const member = table.members[index]
  const function = program.functionAt member
  const payload = payloadLayoutOfTable program, table
  // A `var fn` member writes through the payload, so neither the box nor the pointer it hands on may be `const`
  const writes = isVarSelfMember program, table, index
  const qualifier = if writes { "" } else { "const " }
  const spelling = match payload {
    Some(found) => "{qualifier}{program.layoutAt(found).name} *"
    None => "{qualifier}void *"
  }
  const unwrapped = match payload {
    Some(found) => payloadFieldOf program, found
    None => CExpression.Name "box"
  }
  var body: List<CStatement> = []
  const cast = CExpression.Cast spelling, CExpression.Name("self")
  body.append CStatement.Declaration(spelling, "box", Some(cast))
  // **The erased ABI borrows every operand**, because a call site knows the member's index and not its declaration:
  // `CallWitness` hands over `value.data` and the arguments as they are and keeps its own counts. A parameter the real
  // member takes **owned** - the `self` of `ArrayList.iterate`, whose `ListIterator` stores the list, and the value of
  // `ArrayList.append`, which the buffer keeps - would consume a count nobody handed over, and the caller's own release
  // would then free the block twice. So the thunk is where the counts are made, which is also the one place that knows
  // both conventions. The payload needs a local of its own because a read-only member's box is `const`; an ordinary
  // parameter is already a local of the thunk and is retained in place
  const receiver = match retainedReceiverOf(program, table, index) {
    Some(statement) => {
      const annotation = valueTypeOf program, function.signature.parameters[0].annotation
      body.append CStatement.Declaration(annotation, receiverName, Some(unwrapped))
      body.append statement
      CExpression.Name receiverName
    }
    None => if writes { CExpression.AddressOf unwrapped } else { unwrapped }
  }
  var given = [receiver]
  for position in 1..function.signature.parameters.length() {
    const argument = CExpression.Name "a{position}"
    if const Some(statement) = retainedArgumentOf(program, function, position, argument) {
      body.append statement
    }
    given.append argument
  }
  const called = CExpression.Call CExpression.Name(function.name), given
  if isVoidResultOf(program, function.signature.result) {
    body.append CStatement.Evaluate(called)
    body.append CStatement.Return()
  } else {
    body.append CStatement.Return(Some(called))
  }
  write emission, CDeclaration.Definition("", head, body)
}

/** The local a thunk hands an **owned** receiver over in. Named once, because the body writes it twice. */
const receiverName = "owned_self"

/**
 * The retain a thunk owes its payload, where the member takes `self` by value and **owned**. `None` for a borrowing
 * member, for a `var self` one (a reference carries no count) and for a payload that is not counted at all.
 */
fn retainedReceiverOf(program: IrProgram, table: WitnessTable, index: Int): CStatement? {
  const function = program.functionAt table.members[index]
  const parameter = function.signature.parameters.first()?
  if parameter.isReference || parameter.ownership != Ownership.Owned {
    return None
  }
  retainStatement program, parameter.annotation, CExpression.Name(receiverName)
}

/**
 * The retain a thunk owes one of its own parameters, where the member takes it **owned**: the thunk's parameter is an
 * ordinary local, so it is retained in place and handed on. `ArrayList.append` is the one that needs it - the buffer
 * keeps the value - and without it `list.append(text)` through a table released the text twice.
 */
fn retainedArgumentOf(
  program: IrProgram,
  function: IrFunction,
  position: Int,
  argument: CExpression,
): CStatement? {
  const parameter = function.signature.parameters[position]
  if parameter.isReference || parameter.ownership != Ownership.Owned {
    return None
  }
  retainStatement program, parameter.annotation, argument
}

/** `box->f_value`: the payload the thunk unwraps out of the block a trait-typed value points at. */
fn payloadFieldOf(program: IrProgram, layout: LayoutId): CExpression {
  const shape = program.layoutAt layout
  if shape.fields.isEmpty() {
    return CExpression.Name "box"
  }
  CExpression.PointerMember CExpression.Name("box"), memberNameOf(shape.fields[0])
}

/** The layout of the box the target of a table is kept in, which the lowering built where the value was boxed. */
fn payloadLayoutOfTable(program: IrProgram, table: WitnessTable): LayoutId? {
  program.layoutNamed payloadLayoutName(program, table.target)
}

fn isVoidResultOf(program: IrProgram, id: IrTypeId): Bool {
  resultTypeOf(program, id) == "void"
}

fn emitWitnessTable(
  var emission: Emission,
  program: IrProgram,
  table: WitnessTable,
  names: Map<String, String>,
) {
  var members: List<CExpression> = []
  for index in 0..table.members.length() {
    const name = thunkNameOf program, table, index, names
    members.append CExpression.Cast("torb_witness_member", CExpression.Name(name))
  }
  const arrayName = "{table.name}_members"
  if !members.isEmpty() {
    const annotation = "static const torb_witness_member"
    const array = "{arrayName}[{members.length()}]"
    write emission, CDeclaration.StaticData(annotation, array, CExpression.Initializer(members))
  }
  var nested: List<CExpression> = []
  for inner in table.nested {
    const one = match inner {
      Some(found) => found
      None => {
        nested.append CExpression.Literal("NULL")
        continue
      }
    }
    if !program.hasWitnessTable(one) {
      nested.append CExpression.Literal("NULL")
      continue
    }
    nested.append CExpression.AddressOf(CExpression.Name(program.witnessTableAt(one).name))
  }
  const nestedName = "{table.name}_nested"
  if !nested.isEmpty() {
    const annotation = "static const torb_witness_table *const"
    const array = "{nestedName}[{nested.length()}]"
    write emission, CDeclaration.StaticData(annotation, array, CExpression.Initializer(nested))
  }
  const payload = payloadLayoutOfTable program, table
  const drop = match payload {
    Some(found) => dropFunctionOf program, found
    None => CExpression.Literal "NULL"
  }
  const retain = match payload {
    Some(found) => retainChildrenFunctionOf program, found
    None => CExpression.Literal "NULL"
  }
  const size = match payload {
    Some(found) => CExpression.Call CExpression.Name("sizeof"), [CExpression.Name(program.layoutAt(found).name)]
    None => CExpression.Literal "0"
  }
  const array = if members.isEmpty() {
    CExpression.Literal "NULL"
  } else {
    CExpression.Name arrayName
  }
  const inner = if nested.isEmpty() {
    CExpression.Literal "NULL"
  } else {
    CExpression.Name nestedName
  }
  const initializer = CExpression.Initializer([drop, retain, size, inner, array])
  // The table itself has **external** linkage while its two arrays are `static`: once the devirtualization has turned
  // the last dispatch through a table into a direct call, nothing in the translation unit names that table any more, and
  // a `static const` nothing reads is an error under `-Wunused-const-variable -Werror`. Its name is mangled and unique,
  // so there is nothing for it to collide with, and the member that nobody calls is what finding 12 removes for real
  write emission, CDeclaration.StaticData("const torb_witness_table", table.name, initializer)
}

// --- The thunks of the closures -------------------------------------------------------------------------------------

/**
 * One thunk per function a closure value points at, sorted by name.
 *
 * A closure value has the type of *every* closure of its shape, so its code pointer cannot have the concrete
 * environment's type in it. The thunk is what closes that gap: it takes `torb_environment *`, casts it to the
 * environment of this one closure, and calls the body - so the function a closure points at really has the signature a
 * call converts its pointer back to, which is what C allows. Casting a function pointer to a signature the function
 * does not have, which is the alternative, is not.
 *
 * The same thunk is what makes a **named function used as a value** free: such a function has no environment parameter,
 * and its thunk simply ignores the one it is handed.
 */
fn emitClosureThunks(var emission: Emission, program: IrProgram, functions: List<IrFunction>) {
  const order = closureTargetsOf program, functions
  if order.isEmpty() {
    return
  }
  write emission, CDeclaration.Comment("The thunks of the closures: the erased environment, cast back to its own type.")
  for function in order {
    if const Some(head) = thunkHeadOfFunction(emission, program, function) {
      write emission, CDeclaration.Prototype(head)
    }
  }
  for function in order {
    emitClosureThunk emission, program, function
  }
}

/** Every function a `Closure` instruction of the program names, sorted by its mangled name. */
fn closureTargetsOf(program: IrProgram, functions: List<IrFunction>): List<IrFunction> {
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for function in functions {
    for block in function.blocks {
      for instruction in block.instructions {
        if const .Closure(_, callee, _, _) = instruction {
          if !program.hasFunction(callee) {
            continue
          }
          const name = program.functionAt(callee).name
          if !byName.containsKey(name) {
            byName.set name, callee.value
            names.append name
          }
        }
      }
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var order: List<IrFunction> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      order.append program.functionAt(FunctionId(index))
    }
  }
  order
}

/** The head of one thunk: the erased environment first, then the parameters the closure type declares. */
fn thunkHeadOfFunction(var emission: Emission, program: IrProgram, function: IrFunction): String? {
  const signature = function.signature
  if const .ByPointer = signature.resultMode {
    reportUnsupported emission, "a closure whose result is written through a pointer"
    return None
  }
  const first = if environmentLayoutOfFunction(program, function).isSome() { 1 } else { 0 }
  var parameters = ["torb_environment *environment"]
  for index in first..signature.parameters.length() {
    const parameter = signature.parameters[index]
    const spelling = valueTypeOf program, parameter.annotation
    const shown = if parameter.isReference { pointerTo spelling } else { spelling }
    parameters.append declarationOf(shown, "a{index}")
  }
  const result = resultTypeOf program, signature.result
  const written = parameters.joined separator: ", "
  Some "static {declarationOf(result, "{closureThunkNameOf(function.name)}({written})")}"
}

fn emitClosureThunk(var emission: Emission, program: IrProgram, function: IrFunction) {
  const head = match thunkHeadOfFunction(emission, program, function) {
    Some(found) => found
    None => {
      return
    }
  }
  const layout = environmentLayoutOfFunction program, function
  const first = if layout.isSome() { 1 } else { 0 }
  var body: List<CStatement> = []
  var given: List<CExpression> = []
  match layout {
    Some(found) => {
      const spelling = "{program.layoutAt(found).name} *"
      given.append CExpression.Cast(spelling, CExpression.Name("environment"))
    }
    None => body.append CStatement.Evaluate(CExpression.Cast("void", CExpression.Name("environment")))
  }
  for index in first..function.signature.parameters.length() {
    given.append CExpression.Name("a{index}")
  }
  const called = CExpression.Call CExpression.Name(function.name), given
  if isVoidResultOf(program, function.signature.result) {
    body.append CStatement.Evaluate(called)
    body.append CStatement.Return()
  } else {
    body.append CStatement.Return(Some(called))
  }
  write emission, CDeclaration.Definition("", head, body)
}

// --- Are all the types there? ---------------------------------------------------------------------------------------

/**
 * Whether every type the program uses has a C spelling, asked once, before anything is written. That keeps every other
 * part of the emitter free of the question and makes the findings a property of the program instead of of the order in
 * which the emitter happened to walk it.
 */
fn checkProgramTypes(var emission: Emission, program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>) {
  for index in 0..layouts.length() {
    if !layouts[index] {
      continue
    }
    const layout = program.layouts[index]
    for field in layout.fields {
      checkType emission, program, field.annotation
    }
  }
  for function in functions {
    checkType emission, program, function.signature.result
    for parameter in function.signature.parameters {
      checkType emission, program, parameter.annotation
    }
    for slot in function.slots {
      checkType emission, program, slot.annotation
    }
  }
  for descriptor in program.elements {
    checkType emission, program, descriptor.item
  }
}

// --- Element descriptors ----------------------------------------------------------------------------------------------

/**
 * One `torb_element` per element type of the program, sorted by name (BACKEND 3.1): the size and the alignment the
 * layout model decided, and the four function pointers the one C list and the one C hash table call through.
 *
 * `retain` and `release` are written here and are not functions of the IR: they act on **one element in place** through a
 * `void *`, which is an ABI shape and not a signature the language has - exactly like the `R_`/`D_` pair of a layout, and
 * they are `NULL` where the element carries no count at all so that the container skips the indirect call. `equals` and
 * `hash` *are* functions of the language and get a thunk over `const void *` around them, so that a key in a map and a
 * `==` in the source can never disagree.
 */
fn emitElementDescriptors(var emission: Emission, program: IrProgram) {
  const order = elementOrder program
  if order.isEmpty() {
    return
  }
  write emission, CDeclaration.Comment("The element descriptors of the runtime containers (docs/BACKEND.md 3.1).")
  for id in order {
    emitElementHelpers emission, program, program.elementAt(id)
  }
  for id in order {
    emitElementDescriptor emission, program, program.elementAt(id)
  }
}

/** The descriptors sorted by their mangled name, so the file is a function of the *set* and never of the lowering. */
fn elementOrder(program: IrProgram): List<ElementId> {
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for index in 0..program.elements.length() {
    const name = program.elements[index].name
    if !byName.containsKey(name) {
      byName.set name, index
      names.append name
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var order: List<ElementId> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      order.append ElementId(index)
    }
  }
  order
}

/** `dR_Int64`, `dD_Int64`, `dE_Int64`, `dH_Int64`: the four helpers of one descriptor, whose name is `d_Int64`. */
fn elementHelperName(prefix: String, descriptor: ElementDescriptor): String {
  "d{prefix}_{descriptor.name[2..descriptor.name.byteLength()]}"
}

fn elementHelperHead(prefix: String, result: String, descriptor: ElementDescriptor, parameters: String): String {
  "static {result} {elementHelperName(prefix, descriptor)}({parameters})"
}

fn emitElementHelpers(var emission: Emission, program: IrProgram, descriptor: ElementDescriptor) {
  const item = descriptor.item
  const spelling = valueTypeOf program, item
  if containsCountedType(program, item) {
    const place = CExpression.Dereference CExpression.Cast("{spelling} *", CExpression.Name("element"))
    if const Some(statement) = retainStatement(program, item, place) {
      const head = elementHelperHead "R", "void", descriptor, "void *element"
      write emission, CDeclaration.Definition("", head, [statement])
    }
    if const Some(statement) = releaseStatement(program, item, place) {
      const head = elementHelperHead "D", "void", descriptor, "void *element"
      write emission, CDeclaration.Definition("", head, [statement])
    }
  }
  if const Some(function) = descriptor.equals {
    if program.hasFunction(function) {
      const head = elementHelperHead "E", "bool", descriptor, "const void *first, const void *second"
      // `{spelling} const *` and not `const {spelling} *`: what the table may not write is the **storage**, and for a
      // boxed item the storage holds a pointer - so the const belongs to that pointer and not to what it points at.
      // Written the other way round, a boxed tuple came out as a `const T * *` and gcc refused the call (`-Werror`)
      const left = CExpression.Dereference CExpression.Cast("{spelling} const *", CExpression.Name("first"))
      const right = CExpression.Dereference CExpression.Cast("{spelling} const *", CExpression.Name("second"))
      const called = CExpression.Call CExpression.Name(program.functionAt(function).name), [left, right]
      write emission, CDeclaration.Definition("", head, [CStatement.Return(Some(called))])
    }
  }
  if const Some(function) = descriptor.hash {
    if program.hasFunction(function) {
      const head = elementHelperHead "H", "uint64_t", descriptor, "const void *element"
      const value = CExpression.Dereference CExpression.Cast("{spelling} const *", CExpression.Name("element"))
      const called = CExpression.Call CExpression.Name(program.functionAt(function).name), [value]
      const converted = CExpression.Cast "uint64_t", called
      write emission, CDeclaration.Definition("", head, [CStatement.Return(Some(converted))])
    }
  }
}

fn emitElementDescriptor(var emission: Emission, program: IrProgram, descriptor: ElementDescriptor) {
  const item = descriptor.item
  var parts = [CExpression.Literal("{descriptor.size}"), CExpression.Literal("{descriptor.alignment}")]
  const counted = containsCountedType program, item
  const retains = counted && retainStatement(program, item, CExpression.Name("element")).isSome()
  const releases = counted && releaseStatement(program, item, CExpression.Name("element")).isSome()
  parts.append elementPointer(retains, "R", descriptor)
  parts.append elementPointer(releases, "D", descriptor)
  parts.append elementPointer(isThere(program, descriptor.equals), "E", descriptor)
  parts.append elementPointer(isThere(program, descriptor.hash), "H", descriptor)
  const annotation = "static const torb_element"
  write emission, CDeclaration.StaticData(annotation, descriptor.name, CExpression.Initializer(parts))
}

fn elementPointer(isThere: Bool, prefix: String, descriptor: ElementDescriptor): CExpression {
  if !isThere {
    return CExpression.Literal "NULL"
  }
  CExpression.Name elementHelperName(prefix, descriptor)
}

fn isThere(program: IrProgram, function: FunctionId?): Bool {
  match function {
    Some(found) => program.hasFunction found
    None => false
  }
}

fn checkType(var emission: Emission, program: IrProgram, id: IrTypeId) {
  if !cTypeOf(program, id).isEmpty() {
    return
  }
  const what = whyNoCType program, id
  reportUnsupported emission, what
}

// --- Which layouts are used at all ----------------------------------------------------------------------------------

/**
 * The layouts the emitted functions reach, by index: the type of every slot, parameter and result, everything a
 * `Construct` builds, and then everything those layouts store in their fields.
 *
 * Nothing unreachable is emitted, which is what keeps a type the back end cannot spell yet from refusing a program
 * that never mentions it.
 */
fn usedLayoutsOf(program: IrProgram, functions: List<IrFunction>): List<Bool> {
  var used: List<Bool> = []
  for _ in 0..program.layouts.length() {
    used.append false
  }
  var pending: List<Int> = []
  for function in functions {
    markLayoutOfType program, used, pending, function.signature.result
    for parameter in function.signature.parameters {
      markLayoutOfType program, used, pending, parameter.annotation
    }
    for slot in function.slots {
      markLayoutOfType program, used, pending, slot.annotation
    }
    for block in function.blocks {
      for instruction in block.instructions {
        if const .Construct(_, layout, _, _) = instruction {
          markLayout program, used, pending, layout
        }
        // The payload of a trait-typed value is boxed in a layout of its own, which the box and its drop helper need
        if const .TraitValue(_, value, _) = instruction {
          markPayloadLayout program, used, pending, typeOfSlotOf(function, value.slot)
        }
      }
    }
  }
  // A table names the drop function of the box its target is kept in, whether or not this program boxes one itself
  for table in program.witnessTables {
    markPayloadLayout program, used, pending, table.target
  }
  while !pending.isEmpty() {
    const last = pending.length() - 1
    const current = pending[last]
    pending.removeAt last
    for field in program.layouts[current].fields {
      markLayoutOfType program, used, pending, field.annotation
    }
  }
  used
}

fn markLayoutOfType(program: IrProgram, var used: List<Bool>, var pending: List<Int>, id: IrTypeId) {
  if !program.hasType(id) {
    return
  }
  match program.typeAt(id) {
    .Record(layout) => markLayout program, used, pending, layout
    .Variant(layout) => markLayout program, used, pending, layout
    .Tuple(layout) => markLayout program, used, pending, layout
    .SharedObject(layout) => markLayout program, used, pending, layout
    .FixedArray(item, _) => markLayoutOfType program, used, pending, item
    .Box(item) => markLayoutOfType program, used, pending, item
    .Lazy(item) => markLayoutOfType program, used, pending, item
    .Runtime(_, arguments) => {
      for argument in arguments {
        markLayoutOfType program, used, pending, argument
      }
    }
    _ => {}
  }
}

fn markPayloadLayout(program: IrProgram, var used: List<Bool>, var pending: List<Int>, item: IrTypeId) {
  if !program.hasType(item) {
    return
  }
  if const Some(found) = program.layoutNamed(payloadLayoutName(program, item)) {
    markLayout program, used, pending, found
  }
}

fn markLayout(program: IrProgram, var used: List<Bool>, var pending: List<Int>, id: LayoutId) {
  if !program.hasLayout(id) {
    return
  }
  if used[id.value] {
    return
  }
  used.set id.value, true
  pending.append id.value
}

// --- Type definitions -----------------------------------------------------------------------------------------------

/**
 * Every layout, forward declared first and then defined in an order in which nothing needs what is not complete yet.
 * A forward declaration for all of them is what makes a pointer to a counted block work whatever the order is.
 */
fn emitTypeDefinitions(var emission: Emission, program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>) {
  const order = layoutDefinitionOrder program
  const arrays = usedArraysOf program, functions, layouts
  var names: List<String> = []
  for id in order {
    if !layouts[id.value] {
      continue
    }
    const layout = program.layoutAt id
    if !hasStructDefinition(layout) {
      continue
    }
    names.append layout.name
  }
  for id in arrays {
    names.append cTypeOf(program, id)
  }
  if names.isEmpty() {
    return
  }
  write emission, CDeclaration.Comment("The layouts of the program (docs/BACKEND.md 3.1).")
  var sorted = names
  sorted.sort({ _ })
  for name in sorted {
    write emission, CDeclaration.Typedef("struct {name}", name)
  }
  // An array a layout stores inline is defined right in front of it: its items were complete before the layout was
  var written: Set<Int> = Set.of()
  for id in order {
    if !layouts[id.value] {
      continue
    }
    const layout = program.layoutAt id
    if !hasStructDefinition(layout) {
      continue
    }
    for field in layout.fields {
      emitArrayDefinition emission, program, arrays, written, field.annotation
    }
    write emission, structDeclarationOf(program, layout)
  }
  for id in arrays {
    emitArrayDefinition emission, program, arrays, written, id
  }
}

/**
 * The struct of an array the program uses, after the struct of every array among its items, and only once. A type that
 * is no array, or one that is not used, writes nothing.
 */
fn emitArrayDefinition(
  var emission: Emission,
  program: IrProgram,
  arrays: List<IrTypeId>,
  var written: Set<Int>,
  id: IrTypeId,
) {
  if !program.hasType(id) || written.contains(id.value) || !arrays.contains(id) {
    return
  }
  const item = match program.typeAt(id) {
    .FixedArray(found, _) => found
    _ => {
      return
    }
  }
  written.insert id.value
  emitArrayDefinition emission, program, arrays, written, item
  if const Some(declaration) = arrayDeclarationOf(program, id) {
    write emission, declaration
  }
}

/**
 * Every `Array<Item, Size>` type the emitted C spells, sorted by its C name: the type of a slot, a parameter or a
 * result, a field of a used layout, an element of a container, and every array among the items of one of those.
 */
fn usedArraysOf(program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>): List<IrTypeId> {
  var found: List<IrTypeId> = []
  for function in functions {
    collectArrays program, found, function.signature.result
    for parameter in function.signature.parameters {
      collectArrays program, found, parameter.annotation
    }
    for slot in function.slots {
      collectArrays program, found, slot.annotation
    }
  }
  for index in 0..layouts.length() {
    if !layouts[index] {
      continue
    }
    for field in program.layouts[index].fields {
      collectArrays program, found, field.annotation
    }
  }
  for descriptor in program.elements {
    collectArrays program, found, descriptor.item
  }
  var byName: Map<String, IrTypeId> = [:]
  var names: List<String> = []
  for id in found {
    const name = cTypeOf program, id
    if name.isEmpty() || byName.containsKey(name) {
      continue
    }
    byName.set name, id
    names.append name
  }
  var sorted = names
  sorted.sort({ _ })
  var ordered: List<IrTypeId> = []
  for name in sorted {
    if const Some(id) = byName.get(name) {
      ordered.append id
    }
  }
  ordered
}

/** The arrays inside one type: the type itself where it is one, and what its items and type arguments hold. */
fn collectArrays(program: IrProgram, var found: List<IrTypeId>, id: IrTypeId) {
  if !program.hasType(id) {
    return
  }
  match program.typeAt(id) {
    .FixedArray(item, _) => {
      if found.contains(id) {
        return
      }
      found.append id
      collectArrays program, found, item
    }
    .Runtime(_, arguments) => {
      for argument in arguments {
        collectArrays program, found, argument
      }
    }
    _ => {}
  }
}

/**
 * The frame of every resume function: one member per frame slot (`ir/suspension.trb` decides which), in slot order, so
 * that the constructor of a task writes its parameters where the machine reads them. A frame nothing lives in still has
 * one member, because an empty struct is not C.
 */
fn emitTaskFrames(var emission: Emission, program: IrProgram, functions: List<IrFunction>) {
  var written = false
  for function in functions {
    if function.kind != FunctionKind.TaskResume {
      continue
    }
    if !written {
      write emission, CDeclaration.Comment("The frames of the tasks: what a task keeps across a suspension (docs/CONCURRENCY.md 16).")
      written = true
    }
    const machine = taskMachineOf program, function
    var members: List<CMember> = []
    for index in 0..function.slots.length() {
      if !machine.isFrameSlot(Slot(index)) {
        continue
      }
      const spelling = valueTypeOf program, function.slots[index].annotation
      members.append CMember.Field(spelling, slotNameOf(function, Slot(index)))
    }
    if members.isEmpty() {
      members.append CMember.Field("unsigned char", "nothing")
    }
    const name = frameTypeName function
    write emission, CDeclaration.Typedef("struct {name}", name)
    write emission, CDeclaration.Struct(name, members)
  }
}

// --- Retaining and dropping the children of a counted block ---------------------------------------------------------

/**
 * The two functions `torb_release` and `torb_make_unique` take for a counted block of the program: `R_<layout>` retains
 * the counted values inside it after a shallow copy, `D_<layout>` releases them (BACKEND 2.1, 5.R1).
 *
 * The very same pair is what a `Copy`, a `Retain` and a `Release` of an **inline** aggregate are: such a value carries no
 * count of its own and owns one on each of its fields, so both of them mean "per counted field".
 *
 * Each of the two is emitted only where something really calls it, because an unused `static` function is a warning and
 * the generated C compiles with `-Werror` - which is why the demand is two sets and not one. Everything is declared
 * before anything is defined, so a helper may call the helper of a field whatever the order of the names is.
 */
fn emitCountedHelpers(var emission: Emission, program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>) {
  const demand = helperDemandOf program, functions, layouts
  if demand.retained.isEmpty() && demand.dropped.isEmpty() {
    return
  }
  const closing = closingOf program
  write emission, CDeclaration.Comment("Retaining and dropping the counted values inside a layout (docs/BACKEND.md 2.1).")
  for index in demand.retained {
    write emission, CDeclaration.Prototype(helperHeadOf("R_", program.layouts[index].name))
  }
  for index in demand.dropped {
    write emission, CDeclaration.Prototype(helperHeadOf("D_", program.layouts[index].name))
  }
  // A drop function calls the destructor of its object, whose definition comes with the other functions further down
  for index in demand.dropped {
    if const Some(function) = program.closeFunctions.get(index) {
      write emission, CDeclaration.Prototype(signatureHeadOf(program, program.functionAt(function)))
    }
  }
  for index in demand.retained {
    emitHelper emission, program, program.layouts[index], "R_", true
  }
  for index in demand.dropped {
    const closer = program.closeFunctions.get index
    const isReversed = closing.holdsLayout LayoutId(index)
    emitDropHelper emission, program, program.layouts[index], closer, isReversed
  }
}

fn helperHeadOf(prefix: String, name: String): String {
  "static void {prefix}{name}(void *block)"
}

/**
 * The `P_<layout>` functions the starts of tasks name: each makes one element of a container private, the element being
 * a record or a tuple (docs/design/CONCURRENCY.md section 16, "The copy at the crossing"). Which ones are named is read
 * off the very expressions the starts are written with ([framePrivateOf]), and then off the bodies of those functions,
 * so exactly the ones called are defined - an unused `static` function is an error under `-Werror`.
 */
fn emitPrivateHelpers(var emission: Emission, program: IrProgram, functions: List<IrFunction>) {
  var names: List<String> = []
  for function in functions {
    for block in function.blocks {
      for instruction in block.instructions {
        if const .TaskNew(_, _, _, arguments) = instruction {
          var places: List<CExpression> = []
          var types: List<IrTypeId> = []
          for argument in arguments {
            places.append CExpression.Name("value")
            types.append typeOfSlotOf(function, argument.slot)
          }
          if const .Always = frameCrossingOf(program, places, types) {
            continue
          }
          if const .When(copy) = framePrivateOf(program, places, types) {
            privateHelpersNamedIn copy, names
          }
        }
      }
    }
  }
  var layouts: List<LayoutId> = []
  var index = 0
  while index < names.length() {
    const name = names[index]
    index = index + 1
    const found = match program.layoutNamed(name[2..]) {
      Some(layout) => layout
      None => {
        continue
      }
    }
    layouts.append found
    if const .When(copy) = privateHelperOf(program, found) {
      privateHelpersNamedIn copy, names
    }
  }
  if layouts.isEmpty() {
    return
  }
  write emission, CDeclaration.Comment("Making one element private at the crossing of a worker (CONCURRENCY.md 16).")
  for layout in layouts {
    write emission, CDeclaration.Prototype(privateHeadOf(program, layout))
  }
  for layout in layouts {
    const name = program.layoutAt(layout).name
    const cast = CExpression.Cast "{name} *", CExpression.Name("block")
    var body = [CStatement.Declaration("{name} *", "value", Some(cast))]
    const answer = match privateHelperOf(program, layout) {
      .When(copy) => copy
      .Always => CExpression.Literal "true"
      .Never => CExpression.Literal "false"
    }
    body.append CStatement.Return(Some(answer))
    write emission, CDeclaration.Definition("", privateHeadOf(program, layout), body)
  }
}

fn privateHeadOf(program: IrProgram, layout: LayoutId): String {
  "static bool {privateHelperNameOf(program, layout)}(void *block)"
}

/** One helper: the block as a pointer to its layout, then one statement per counted field. */
fn emitHelper(var emission: Emission, program: IrProgram, layout: Layout, prefix: String, isRetain: Bool) {
  var body: List<CStatement> = []
  const cast = CExpression.Cast "{layout.name} *", CExpression.Name("block")
  body.append CStatement.Declaration("{layout.name} *", "value", Some(cast))
  const children = childStatements emission, program, layout, isRetain, false
  body.appendAll children
  const declaration = CDeclaration.Definition "", helperHeadOf(prefix, layout.name), body
  write emission, declaration
}

/**
 * The drop function of a layout. An object whose type implements `Close` runs its destructor first, between the two
 * halves that lend it a count while it runs (`torb_closing_begin`), and a layout that may hold such an object releases
 * its fields in reverse declaration order (docs/design/DESTRUCTORS.md 2a and 8). Every other layout is released
 * exactly as before, field by field in declaration order.
 */
fn emitDropHelper(
  var emission: Emission,
  program: IrProgram,
  layout: Layout,
  closer: FunctionId?,
  isReversed: Bool,
) {
  if closer.isNone() && !isReversed {
    emitHelper emission, program, layout, "D_", false
    return
  }
  var body: List<CStatement> = []
  const cast = CExpression.Cast "{layout.name} *", CExpression.Name("block")
  body.append CStatement.Declaration("{layout.name} *", "value", Some(cast))
  var children = childStatements emission, program, layout, false, isReversed
  if const Some(function) = closer {
    body.appendAll closeStatementsOf(program, function)
    // The destructor read `value`, so a layout without a counted field needs no cast to `void` any more
    if !layout.containsCounted {
      children = []
    }
  }
  body.appendAll children
  const declaration = CDeclaration.Definition "", helperHeadOf("D_", layout.name), body
  write emission, declaration
}

/** `torb_closing_begin(block)`, the call of `close()` with the object, and `torb_closing_end(block)`. */
fn closeStatementsOf(program: IrProgram, function: FunctionId): List<CStatement> {
  const callee = program.functionAt function
  const block = CExpression.Name "block"
  var argument = CExpression.Name "value"
  if const Some(parameter) = callee.signature.parameters.first() {
    // `var fn close()` takes the receiver as a place, and the place is this local
    if parameter.isReference {
      argument = CExpression.AddressOf argument
    }
  }
  var statements: List<CStatement> = []
  statements.append CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_closing_begin"), [block]))
  statements.append CStatement.Evaluate(CExpression.Call(CExpression.Name(callee.name), [argument]))
  statements.append CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_closing_end"), [block]))
  statements
}

/**
 * One statement per counted field. A variant layout switches on the tag: the common fields first, then the group of
 * the variant the value really is - which is why a counted field inside a case needs its own `switch` and not a flat
 * list of members.
 *
 * A helper of a layout nothing inside of which the ABI can count yet would have an empty body, and an unused parameter
 * is a warning, so it casts its own value to `void` once.
 */
fn childStatements(
  var emission: Emission,
  program: IrProgram,
  layout: Layout,
  isRetain: Bool,
  isReversed: Bool,
): List<CStatement> {
  var statements: List<CStatement> = []
  const value = CExpression.Name "value"
  var common = if layout.variants.isEmpty() { layout.fields } else { layout.commonFields() }
  if isReversed {
    common = reversedFields common
  }
  var fieldStatements: List<CStatement> = []
  for field in common {
    const place = CExpression.PointerMember value, memberNameOf(field)
    if const Some(statement) = childStatement(emission, program, place, field, isRetain) {
      fieldStatements.append statement
    }
  }
  // Reversed, the fields of a case were declared after the common ones and go first
  if !isReversed {
    statements.appendAll fieldStatements
  }
  var cases: List<CSwitchCase> = []
  for index in 0..layout.variants.length() {
    var found: List<CStatement> = []
    var group = layout.fieldsOfVariant index
    if isReversed {
      group = reversedFields group
    }
    for field in group {
      // The group of a variant lives in the union, which is where its fields have to be reached
      const group = CExpression.Member CExpression.PointerMember(value, "payload"), variantMemberNameOf(index)
      const place = CExpression.Member group, memberNameOf(field)
      if const Some(statement) = childStatement(emission, program, place, field, isRetain) {
        found.append statement
      }
    }
    if found.isEmpty() {
      continue
    }
    found.append CStatement.Break
    cases.append CSwitchCase(index, found)
  }
  if !cases.isEmpty() {
    const tag = CExpression.PointerMember value, "tag"
    statements.append CStatement.Switch(tag, cases, [CStatement.Break])
  }
  if isReversed {
    statements.appendAll fieldStatements
  }
  if statements.isEmpty() {
    statements.append CStatement.Evaluate(CExpression.Cast("void", value))
  }
  statements
}

fn reversedFields(fields: List<FieldLayout>): List<FieldLayout> {
  var reversed: List<FieldLayout> = []
  var index = fields.length() - 1
  while index >= 0 {
    reversed.append fields[index]
    index = index - 1
  }
  reversed
}

/** The retain or the release of one counted field, and `None` for a field that carries no count at all. */
fn childStatement(
  var emission: Emission,
  program: IrProgram,
  place: CExpression,
  field: FieldLayout,
  isRetain: Bool,
): CStatement? {
  if !containsCountedType(program, field.annotation) {
    return None
  }
  const statement = if isRetain {
    retainStatement program, field.annotation, place
  } else {
    releaseStatement program, field.annotation, place
  }
  match statement {
    Some(found) => Some found
    None => {
      reportUnsupported emission, "a counted field that is {describeCounted(program, field.annotation)}"
      None
    }
  }
}

/** Which layouts need `R_` and which need `D_`. Two sets, because a layout that is only released needs only one. */
type HelperDemand {
  retained: List<Int>
  dropped: List<Int>
}

/** The same two sets as flags, by `LayoutId.value`. */
type DemandFlags {
  retained: List<Bool>
  dropped: List<Bool>
}

/**
 * The layouts the emitted C really calls a helper of: every position that retains or releases a value, plus - because a
 * helper walks the fields of its layout - the layouts those fields need one of.
 */
fn helperDemandOf(program: IrProgram, functions: List<IrFunction>, layouts: List<Bool>): HelperDemand {
  const flags = demandFlagsOf program, functions
  HelperDemand sortedLayouts(program, flags.retained, layouts), sortedLayouts(program, flags.dropped, layouts)
}

fn demandFlagsOf(program: IrProgram, functions: List<IrFunction>): DemandFlags {
  const count = program.layouts.length()
  var retains = filledFalse count
  var drops = filledFalse count
  for function in functions {
    for block in function.blocks {
      for instruction in block.instructions {
        collectHelperDemand program, function, instruction, retains, drops
      }
    }
    // A stop path releases what is live where the task stops, which may be a value the body itself only ever moves
    if function.kind == FunctionKind.TaskResume {
      const machine = taskMachineOf program, function
      var released = machine.entry
      for found in machine.resumes {
        released.appendAll found
      }
      for found in machine.backEdgeReleases {
        released.appendAll found
      }
      for slot in released {
        markDropped program, drops, typeOfSlotOf(function, slot)
      }
    }
  }
  // An element descriptor's `retain` and `release` act per element, and for an inline aggregate that is the `R_`/`D_`
  // pair of its layout
  for descriptor in program.elements {
    markLayoutOfHelper program, retains, descriptor.item
    markLayoutOfHelper program, drops, descriptor.item
    markDestructor program, drops, descriptor.item
    // An element that is an array retains and releases item by item, whatever the helper of the item is
    if innermostItemOf(program, descriptor.item) != descriptor.item {
      markRetained program, retains, descriptor.item
      markDropped program, drops, descriptor.item
    }
  }
  // A witness table names **both** helpers of the box its target is kept in: the drop function so that a release of an
  // erased value works, and the retain-children function so that making the payload of one unique works (5.7's note)
  for table in program.witnessTables {
    if const Some(found) = program.layoutNamed(payloadLayoutName(program, table.target)) {
      markLayoutFlag program, drops, found
      markLayoutFlag program, retains, found
    }
    markThunkRetains program, retains, table
  }
  closeHelperDemand program, retains, drops
  DemandFlags retains, drops
}

/**
 * The retains the thunks of one table write ([retainedReceiverOf], [retainedArgumentOf]): every operand the member
 * takes **owned** is retained in the thunk, and for an inline record that is its `R_`. No instruction of the program
 * names it where the member is only ever called through the table - a task member such as
 * `fn around(request: Request, next: Next): Task<...>` keeps its `Next` in its frame, and its `R_T_Next` was named by the
 * thunk and defined nowhere.
 */
fn markThunkRetains(program: IrProgram, var retains: List<Bool>, table: WitnessTable) {
  for member in table.members {
    if !program.hasFunction(member) {
      continue
    }
    for parameter in program.functionAt(member).signature.parameters {
      if parameter.isReference || parameter.ownership != Ownership.Owned {
        continue
      }
      markRetained program, retains, parameter.annotation
    }
  }
}

fn filledFalse(count: Int): List<Bool> {
  var filled: List<Bool> = []
  for _ in 0..count {
    filled.append false
  }
  filled
}

fn collectHelperDemand(
  program: IrProgram,
  function: IrFunction,
  instruction: Instruction,
  var retains: List<Bool>,
  var drops: List<Bool>,
) {
  var ignored: List<String> = []
  match instruction {
    .Copy(_, source) => markRetained program, retains, typeOfSlotOf(function, source)
    .Retain(slot) => markRetained program, retains, typeOfSlotOf(function, slot)
    .Release(slot) => markDropped program, drops, typeOfSlotOf(function, slot)
    // The result of a read of a counted field arrives owned, which is one retain of the type that was read
    .Read(target, _) => markRetained program, retains, typeOfSlotOf(function, target)
    .Write(reference, _) => {
      if const Some(inner) = typeOfReference(program, function, ignored, "", reference) {
        markDropped program, drops, inner
      }
    }
    // The `Closure` instruction names the drop function of the environment it allocates, whether or not anything else does
    .Closure(_, callee, _, _) => {
      if const Some(layout) = environmentLayoutOfCallee(program, callee) {
        markLayoutFlag program, drops, layout
      }
    }
    // `torb_make_unique` takes both: it retains the children of the shallow copy and releases the old block
    .MakeUnique(reference) => {
      if const Some(inner) = typeOfReference(program, function, ignored, "", reference) {
        if const Some(layout) = boxedLayoutOf(program, inner) {
          markLayoutFlag program, retains, layout
          markLayoutFlag program, drops, layout
        }
      }
    }
    _ => {}
  }
}

fn environmentLayoutOfCallee(program: IrProgram, callee: FunctionId): LayoutId? {
  if !program.hasFunction(callee) {
    return None
  }
  environmentLayoutOfFunction program, program.functionAt(callee)
}

fn typeOfSlotOf(function: IrFunction, slot: Slot): IrTypeId {
  if !function.hasSlot(slot) {
    return IrTypeId(0 - 1)
  }
  function.typeOfSlot slot
}

/** A retain of an inline aggregate is its `R_`; a retain of a pointer, a text or a container calls no helper. */
fn markRetained(program: IrProgram, var retains: List<Bool>, id: IrTypeId) {
  if const Some(layout) = inlineCountedLayoutOf(program, countedFormOf(program, innermostItemOf(program, id))) {
    markLayoutFlag program, retains, layout
  }
}

/**
 * The item of an `Array<Item, Size>`, of an array of arrays the item inside all of them, and the type itself otherwise:
 * the retain or the release of an array is a loop over its items (`itemsLoopOf`), so the helper it calls is the item's.
 */
fn innermostItemOf(program: IrProgram, id: IrTypeId): IrTypeId {
  if !program.hasType(id) {
    return id
  }
  if const .FixedArray(item, _) = program.typeAt(id) {
    return innermostItemOf program, item
  }
  id
}

fn markDropped(program: IrProgram, var drops: List<Bool>, id: IrTypeId) {
  const inner = countedFormOf program, innermostItemOf(program, id)
  if const .SharedObject(layout) = program.typeAt(inner) {
    // An object with a destructor has a drop function whether or not a field of it is counted
    if program.closeFunctions.containsKey(layout.value) && program.hasLayout(layout) {
      drops.set layout.value, true
      return
    }
    markLayoutFlag program, drops, layout
    return
  }
  if const Some(layout) = boxedLayoutOf(program, inner) {
    markLayoutFlag program, drops, layout
    return
  }
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    markLayoutFlag program, drops, layout
  }
}

fn markLayoutFlag(program: IrProgram, var flags: List<Bool>, layout: LayoutId) {
  if !program.hasLayout(layout) {
    return
  }
  if !program.layoutAt(layout).containsCounted {
    return
  }
  flags.set layout.value, true
}

/** A helper walks the fields of its layout, and a counted field may need a helper of its own. */
fn closeHelperDemand(program: IrProgram, var retains: List<Bool>, var drops: List<Bool>) {
  const limit = program.layouts.length() + 1
  var rounds = 0
  var isChanged = true
  while isChanged {
    isChanged = false
    rounds = rounds + 1
    if rounds > limit {
      return
    }
    for index in 0..program.layouts.length() {
      const layout = program.layouts[index]
      for field in layout.fields {
        if retains[index] {
          var grown = retains
          markRetained program, grown, field.annotation
          if grown != retains {
            retains = grown
            isChanged = true
          }
        }
        if !drops[index] {
          continue
        }
        var found = drops
        markDropped program, found, field.annotation
        if found != drops {
          drops = found
          isChanged = true
        }
      }
    }
  }
}

/** The marked layouts that are emitted at all, sorted by name so that the output is a function of the program. */
fn sortedLayouts(program: IrProgram, flags: List<Bool>, layouts: List<Bool>): List<Int> {
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for index in 0..flags.length() {
    if !flags[index] || !layouts[index] {
      continue
    }
    const name = program.layouts[index].name
    if !byName.containsKey(name) {
      byName.set name, index
      names.append name
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var found: List<Int> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      found.append index
    }
  }
  found
}

// --- Static data ----------------------------------------------------------------------------------------------------

/**
 * The compile-time constants, as static data (BACKEND 0): a string literal as an immortal `torb_bytes` with a
 * `torb_text` slice over it, a number as a `static const`, an aggregate as one initializer.
 *
 * A C initializer has to be a constant expression, and the value of another `static const` is not one - so an
 * aggregate spells the *values* of its fields out instead of naming them, and only the constants an instruction really
 * names become objects of their own. That is also what keeps an unused one, which is a warning, out of the output.
 */
fn emitStaticData(var emission: Emission, program: IrProgram, functions: List<IrFunction>) {
  const named = namedStaticsOf program, functions
  const all = closedStaticsOf program, named
  var storages: List<String> = []
  for id in all {
    const value = program.staticAt id
    if textOfStatic(value).isSome() {
      storages.append value.name
    }
  }
  if !storages.isEmpty() {
    write emission, CDeclaration.Comment("The storage of every string literal: immortal, so a write through one always copies.")
    for id in all {
      emitTextStorage emission, program, id
    }
  }
  if named.isEmpty() {
    return
  }
  write emission, CDeclaration.Comment("The compile-time constants of the program.")
  for id in named {
    const value = program.staticAt id
    const spelling = valueTypeOf program, value.annotation
    const initializer = staticValueOf emission, program, value
    write emission, CDeclaration.StaticData("static const {spelling}", value.name, initializer)
  }
}

/** The statics an instruction names, sorted by name: everything the rest of the program refers to by that name. */
fn namedStaticsOf(program: IrProgram, functions: List<IrFunction>): List<StaticId> {
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for function in functions {
    for block in function.blocks {
      for instruction in block.instructions {
        var named: List<StaticId> = []
        if const .Constant(_, value) = instruction {
          named.append value
        }
        // An `Element` step panics with the message of the `Indexed.at` it replaced, whose body may not be emitted
        for reference in referencesOf(instruction) {
          for step in reference.steps {
            if const .Element(_, _, missing, _, _) = step {
              named.append missing
            }
          }
        }
        for value in named {
          if program.hasStatic(value) {
            const name = program.staticAt(value).name
            if !byName.containsKey(name) {
              byName.set name, value.value
              names.append name
            }
          }
        }
      }
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var found: List<StaticId> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      found.append StaticId(index)
    }
  }
  found
}

/** Those statics plus everything their initializers spell out, so that every storage that is named is there. */
fn closedStaticsOf(program: IrProgram, named: List<StaticId>): List<StaticId> {
  var seen: Map<Int, Bool> = [:]
  var order: List<StaticId> = []
  var pending = named
  while !pending.isEmpty() {
    const last = pending.length() - 1
    const current = pending[last]
    pending.removeAt last
    if seen.containsKey(current.value) || !program.hasStatic(current) {
      continue
    }
    seen.set current.value, true
    order.append current
    for inner in childStaticsOf(program, current) {
      pending.append inner
    }
  }
  var names: List<String> = []
  var byName: Map<String, Int> = [:]
  for id in order {
    const name = program.staticAt(id).name
    if !byName.containsKey(name) {
      byName.set name, id.value
      names.append name
    }
  }
  var sorted = names
  sorted.sort({ _ })
  var found: List<StaticId> = []
  for name in sorted {
    if const Some(index) = byName.get(name) {
      found.append StaticId(index)
    }
  }
  found
}

fn childStaticsOf(program: IrProgram, id: StaticId): List<StaticId> {
  match program.staticAt(id).contents {
    .Aggregate(_, _, fields) => fields
    .Items(_, items) => items
    _ => []
  }
}

/** `None` unless the static is a string literal, in which case it is its text. */
fn textOfStatic(value: StaticValue): String? {
  if const .Literal(literal) = value.contents {
    if const .Text(text) = literal {
      return Some text
    }
  }
  None
}

/**
 * The bytes of a string literal, as the immortal `torb_bytes` of the ABI. The array holds at least one byte, because a
 * zero-length array is not C; a text of length zero never looks at it.
 */
fn emitTextStorage(var emission: Emission, program: IrProgram, id: StaticId) {
  const value = program.staticAt id
  const text = match textOfStatic(value) {
    Some(found) => found
    None => {
      return
    }
  }
  var bytes: List<CExpression> = []
  for byte in text.bytes() {
    bytes.append CExpression.Literal("0x{hexDigits(Int.from(byte), 2)}")
  }
  const count = bytes.length().max(1)
  if bytes.isEmpty() {
    bytes.append CExpression.Literal("0x00")
  }
  const header = CExpression.Call(CExpression.Name("TORB_IMMORTAL_HEADER"), [
    CExpression.Name("TORB_BLOCK_BYTES"),
  ])
  const initializer = CExpression.Initializer([
    header,
    CExpression.Literal("{count}"),
    CExpression.Initializer(bytes),
  ])
  // The type is a whole anonymous struct, so this one declaration is the only line the emitter breaks
  const annotation = "static struct \{ torb_header header; uint32_t capacity; uint8_t data[{count}]; \}"
  write emission, CDeclaration.StaticData(annotation, storageNameOf(value), initializer, true)
}

fn storageNameOf(value: StaticValue): String {
  "{value.name}_storage"
}

/** The initializer of one constant. Every part of it is a C constant expression, which a `static` needs. */
fn staticValueOf(var emission: Emission, program: IrProgram, value: StaticValue): CExpression {
  match value.contents {
    .Literal(literal) => literalOf value, literal
    .Floating(number) => floatOf emission, number
    .VoidValue => CExpression.Literal "0"
    .Aggregate(layout, variant, fields) => aggregateOf emission, program, layout, variant, fields
    .Items(_, _) => {
      reportUnsupported emission, "a static `Array<Item, Size>`"
      zeroInitializer
    }
  }
}

/** `{ 0 }`, which is what a constant the back end could not spell stands in as. */
const zeroInitializer = CExpression.Initializer([CExpression.Literal("0")])

fn literalOf(value: StaticValue, literal: LiteralValue): CExpression {
  match literal {
    .Integer(number) => integerOf number
    .Boolean(flag) => if flag { CExpression.Literal "true" } else { CExpression.Literal "false" }
    .Character(character) => CExpression.Literal "0x{hexDigits(Int.from(character), 6)}"
    // A text is a slice over its own immortal storage: the pointer, the offset and the length in bytes
    .Text(text) => {
      const storage = CExpression.AddressOf CExpression.Name(storageNameOf(value))
      CExpression.Initializer([
        CExpression.Cast("torb_bytes *", storage),
        CExpression.Literal("0"),
        CExpression.Literal("{text.byteLength()}"),
      ])
    }
  }
}

/** The smallest signed 64 bit number has no literal in C, because the minus is an operator and the digits overflow. */
fn integerOf(number: Int): CExpression {
  if number == 0 - 9223372036854775807 - 1 {
    return CExpression.Literal "(-9223372036854775807 - 1)"
  }
  CExpression.Literal "{number}"
}

/**
 * A float constant as the shortest decimal that reads back as the same value, which is what `Show` of a `Float`
 * answers - except for the three values `Show` spells as words, which C has no literal for either: `nan`, `inf` and
 * `-inf` become the division that IEEE-754 defines them as, exactly the constant evaluator folded in the first place
 * (`ir/constant.trb`, `floatResult` and the named constants of `std/number`, `Float64.nan` among them).
 */
fn floatOf(var emission: Emission, number: Float): CExpression {
  const shown = "{number}"
  if shown == "nan" {
    return CExpression.Literal "(0.0 / 0.0)"
  }
  if shown == "inf" {
    return CExpression.Literal "(1.0 / 0.0)"
  }
  if shown == "-inf" {
    return CExpression.Literal "(-1.0 / 0.0)"
  }
  if shown.contains(".") || shown.contains("e") {
    return CExpression.Literal shown
  }
  CExpression.Literal "{shown}.0"
}

fn aggregateOf(
  var emission: Emission,
  program: IrProgram,
  layout: LayoutId,
  variant: Int,
  fields: List<StaticId>,
): CExpression {
  if !program.hasLayout(layout) {
    reportUnsupported emission, "a constant of a layout that is not in the program"
    return zeroInitializer
  }
  const shape = program.layoutAt layout
  var written: List<CExpression> = []
  for field in fields {
    const inner = program.staticAt field
    const found = staticValueOf emission, program, inner
    written.append found
  }
  match shape.representation {
    .Boxed => {
      reportUnsupported emission, "a constant of a counted type"
      zeroInitializer
    }
    .Niche(payload, _) => {
      if variant == payload {
        return written.get(0) ?? zeroInitializer
      }
      emptyNicheExpression program, shape
    }
    .Inline => {
      if shape.variants.isEmpty() {
        return CExpression.Initializer written
      }
      CExpression.Designated variantInitializerParts(shape, variant, written)
    }
  }
}

// --- Functions and `main` -------------------------------------------------------------------------------------------

fn emitPrototypes(var emission: Emission, program: IrProgram, functions: List<IrFunction>) {
  if functions.isEmpty() {
    return
  }
  write emission, CDeclaration.Comment("Every function of the program, sorted by its mangled name.")
  for function in functions {
    write emission, CDeclaration.Prototype(signatureHeadOf(program, function))
  }
}

fn emitDefinitions(
  var emission: Emission,
  program: IrProgram,
  functions: List<IrFunction>,
  prototypes: Map<String, String>,
) {
  // Which parameters every callee may keep, once for the whole program: it decides where a closure environment lives
  const keeping = keepingOf program
  const closing = closingOf program
  for function in functions {
    if const .ConstantCell(initializer) = function.kind {
      emitConstantCell emission, program, function, initializer
      continue
    }
    if const .EntryCell(cell, access) = function.kind {
      emitEntryCell emission, program, function, cell, access
      continue
    }
    const body = bodyOf program, function, prototypes, keeping, closing
    var statements = bodyStatements emission, program, body
    if callsProgramCode(program, function) {
      var checked = [stackCheckOf(program, function)]
      checked.appendAll statements
      statements = checked
    }
    const declaration = CDeclaration.Definition(
      commentOf(program, function),
      signatureHeadOf(program, function),
      statements,
    )
    write emission, declaration
  }
}

/**
 * `TORB_CHECK_STACK(TORB_LOCATION(...));`, the first statement of a function that calls program code: the panic
 * `stack overflow` where the stack of the thread is nearly used up, instead of the crash the operating system would
 * answer a few frames later (`runtime/include/torb.h`). The location is where the function is written, because that is
 * the call that did not fit.
 */
fn stackCheckOf(program: IrProgram, function: IrFunction): CStatement {
  const location = match function.blocks.first() {
    Some(entry) => {
      match entry.at {
        Some(at) => locationExpression program, at
        None => CExpression.Name "torb_location_unknown"
      }
    }
    None => CExpression.Name "torb_location_unknown"
  }
  CStatement.Evaluate CExpression.Call(CExpression.Name("TORB_CHECK_STACK"), [location])
}

/**
 * Whether a function can be part of a recursion: whether it calls a function of the program, a closure or a member of
 * a witness table. One that only calls the runtime, or nothing, is a leaf - it adds one frame of bounded size, which the
 * reserve of the stack check covers, and it goes without the check. A call of itself in tail position is a jump and no
 * call at all, so the self-recursion the language guarantees costs one check and not one per round.
 */
fn callsProgramCode(program: IrProgram, function: IrFunction): Bool {
  for block in function.blocks {
    for instruction in block.instructions {
      match instruction {
        .CallClosure(_, _, _) | .CallWitness(_, _, _, _) => {
          return true
        }
        .Call(_, callee, _, _, _) => {
          if !program.hasFunction(callee) {
            continue
          }
          if const .Runtime(_) = program.functionAt(callee).kind {
            continue
          }
          return true
        }
        _ => {}
      }
    }
  }
  false
}

/**
 * The accessor of an **immortal counted static**: the cell that holds the value, the flag that says it was built, and a
 * function that builds it on the first call and hands it over on every one.
 *
 * The value is built inside an immortal region, so every block it is made of carries the immortal count: the caller owns
 * what it gets by the ABI, and retaining, releasing and dropping it are all no-ops - which is why the cell is handed over
 * without a retain and why a write to a copy of it makes the copy unique first.
 *
 * # Open
 *
 * The `.ByPointer` half is written and no program reaches it. A constant whose value is no static data is a collection, a
 * boxed record or a text, and all three are one word wide; an **inline** aggregate above the by-pointer limit would need
 * an initializer the purity rule of a module constant does not allow (`Array.filled` is a call). It stays because the
 * result mode is `finishProgram`'s decision and not this function's, so an accessor that reads it wrongly would be a
 * silent miscompilation the day a layout changes.
 */
fn emitConstantCell(
  var emission: Emission,
  program: IrProgram,
  function: IrFunction,
  initializer: FunctionId,
) {
  if !program.hasFunction(initializer) {
    reportUnsupported emission, "a constant whose initializer is not in the program"
    return
  }
  const built = program.functionAt initializer
  const cell = cellNameOf function
  const ready = readyNameOf function
  const isByPointer = match function.signature.resultMode {
    .ByPointer => true
    .ByValue => false
  }
  const call = if isByPointer {
    CExpression.Call CExpression.Name(built.name), [CExpression.AddressOf(CExpression.Name(cell))]
  } else {
    CExpression.Call CExpression.Name(built.name), []
  }
  var building: List<CStatement> = []
  building.append CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_begin_immortal"), []))
  if isByPointer {
    building.append CStatement.Evaluate(call)
  } else {
    building.append CStatement.Assignment(CExpression.Name(cell), call)
  }
  building.append CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_end_immortal"), []))
  const flag = CExpression.AddressOf CExpression.Name(ready)
  building.append CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_constant_publish"), [flag]))
  // Two workers may ask for the constant at once: the first build is under the process's lock, checked again inside it
  var locked: List<CStatement> = []
  locked.append CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_constant_lock"), []))
  locked.append CStatement.If(CExpression.Unary("!", CExpression.Name(ready)), building)
  locked.append CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_constant_unlock"), []))
  const isReady = CExpression.Call CExpression.Name("torb_constant_ready"), [flag]
  var statements: List<CStatement> = []
  statements.append CStatement.If(CExpression.Unary("!", isReady), locked)
  if isByPointer {
    statements.append CStatement.Assignment(CExpression.Dereference(CExpression.Name(resultPointerName)), CExpression.Name(cell))
  } else {
    statements.append CStatement.Return(Some(CExpression.Name(cell)))
  }
  const comment = "{function.name}: built once, immortal, never freed"
  write emission, CDeclaration.Definition(comment, signatureHeadOf(program, function), statements)
}

/**
 * One access to an entry cell (`FunctionKind.EntryCell`): the cell is a file-scope `static` with a count of its own. A
 * read hands out one more count, a write keeps the one it is handed, and [emitEntryCellRelease] gives the cell's back
 * once the program is done.
 */
fn emitEntryCell(var emission: Emission, program: IrProgram, function: IrFunction, cell: String, access: CellAccess) {
  var statements: List<CStatement> = []
  match access {
    .Read => {
      if const Some(retain) = retainStatement(program, function.signature.result, CExpression.Name(cell)) {
        statements.append retain
      }
      statements.append CStatement.Return(Some(CExpression.Name(cell)))
    }
    .Write => {
      const value = CExpression.Name slotNameOf(function, Slot(0))
      statements.append CStatement.Assignment(CExpression.Name(cell), value)
    }
  }
  const comment = "{function.name}: the entry cell {cell}"
  write emission, CDeclaration.Definition(comment, signatureHeadOf(program, function), statements)
}

/** What gives the count of every entry cell back, from `main`. A name no mangled name can be: those start with a prefix. */
const entryCellReleaseName = "entry_cells_release"

/** Every entry cell of the program once, with the type it holds, in the order the functions are emitted. */
fn entryCellsOf(functions: List<IrFunction>): List<(String, IrTypeId)> {
  var found: List<(String, IrTypeId)> = []
  var seen: Set<String> = []
  for function in functions {
    if const .EntryCell(cell, access) = function.kind {
      if seen.contains(cell) {
        continue
      }
      seen.insert cell
      const held = match access {
        .Read => function.signature.result
        .Write => function.signature.parameters[0].annotation
      }
      found.append((cell, held))
    }
  }
  found
}

/**
 * The one function that releases every entry cell, called by `main` once the program is done: the cell's count is the
 * last one, so this is where the value of a top-level `const` of the entry file goes - and an object runs its `close()`,
 * if it has one. A cell whose flag (`{cell}_set`, `ir/lower/cell.trb`) says the top-level code never set it holds no
 * count.
 */
fn emitEntryCellRelease(var emission: Emission, program: IrProgram, functions: List<IrFunction>) {
  const cells = entryCellsOf functions
  if cells.isEmpty() {
    return
  }
  var names: Set<String> = []
  for (cell, _) in cells {
    names.insert cell
  }
  var statements: List<CStatement> = []
  for (cell, held) in cells {
    if const Some(release) = releaseStatement(program, held, CExpression.Name(cell)) {
      const flag = "{cell}_set"
      if names.contains(flag) {
        statements.append CStatement.If(CExpression.Name(flag), [release])
      } else {
        statements.append release
      }
    }
  }
  const comment = "The count every entry cell holds, given back once the program is done"
  write emission, CDeclaration.Definition(comment, "static void {entryCellReleaseName}(void)", statements)
}

fn cellNameOf(function: IrFunction): String {
  "{function.name}_cell"
}

fn readyNameOf(function: IrFunction): String {
  "{function.name}_ready"
}

/**
 * The cell and the flag of every immortal constant, in one section above the prototypes: the value, and whether it has
 * been built. They are the only mutable statics of the translation unit.
 */
fn emitConstantCellStorage(var emission: Emission, program: IrProgram, functions: List<IrFunction>) {
  var written = false
  for function in functions {
    if const .ConstantCell(_) = function.kind {
      if !written {
        write(emission, CDeclaration.Comment(
          "The value of every module constant that is no static data: built once, immortal, never freed."
        ))
        written = true
      }
      const spelling = valueTypeOf program, function.signature.result
      write emission, CDeclaration.Variable("static {spelling}", cellNameOf(function))
      write emission, CDeclaration.Variable("static bool", readyNameOf(function))
    }
  }
  // The entry cells, one per cell however many accesses of it are in the program
  const cells = entryCellsOf functions
  if !cells.isEmpty() {
    write(emission, CDeclaration.Comment(
      "The one value of every top-level const of an entry file a function reads, with a count of its own, and its flag."
    ))
  }
  for (cell, held) in cells {
    write emission, CDeclaration.Variable("static {valueTypeOf(program, held)}", cell)
  }
}

/** One comment per function with the name it has in the source, which a mangled name does not read like. */
fn commentOf(program: IrProgram, function: IrFunction): String {
  match function.origin {
    Some(_) => function.name
    None => "{function.name}: the top-level code of the entry file"
  }
}

/**
 * The `main` of the program: the runtime first, then the top-level code of the entry file, then exit code zero. A
 * program that ends in `Process.exit` never reaches the `return`.
 *
 * A **test run** is the same `main` with one entry per test file: the name of the file goes out in front of its tests
 * through `torb_test_file`, and the tail is `torb_test_finish`, which writes the summary line and answers the exit
 * code. A test that fails or panics is reported by `runtime/test.c` and does not end the process, so the file after it
 * still runs - which is what makes one binary for the whole suite behave like one process per file.
 *
 * An entry file of declarations alone - `const million = 1_000_000`, or a `fn main()` that nothing calls - has no entry
 * function, because nothing in it runs. Its `main` starts and finishes the runtime and calls nothing, so the program
 * is one that does nothing rather than C that names a function it never defines.
 */
fn emitMain(var emission: Emission, entries: List<ProgramEntry>, functions: List<IrFunction>) {
  if entries.isEmpty() {
    return
  }
  var lines = ["torb_process_start(argument_count, argument_values);"]
  const hasCells = !entryCellsOf(functions).isEmpty()
  // A program that ends in `Process.exit` never comes back here, so the runtime gives the cells' counts back there
  if hasCells {
    lines.append "torb_process_on_exit({entryCellReleaseName});"
  }
  var isTestRun = false
  var isNamed = false
  var isMainTask = false
  const isTasked = usesTasks functions
  for entry in entries {
    // A test file that declares things and runs nothing has no entry function; its name is still printed
    if !entry.file.isEmpty() {
      isTestRun = true
      lines.append "torb_test_file({cStringOf(entry.file)}, {entry.file.byteLength()});"
    }
    if entry.name.isEmpty() {
      continue
    }
    isNamed = true
    const found = match functions.find({ _.name == entry.name }) {
      Some(inner) => inner
      None => {
        continue
      }
    }
    // An entry file that waits is the main task: the scheduler runs until it has completed. Where it ended cancelled -
    // a top-level `await()` of a cancelled task - the program says so and ends with `TORB_EXIT_CANCELLED` once the
    // other tasks have stopped (docs/design/CONCURRENCY.md section 8, "The cascade")
    if found.kind == FunctionKind.TaskResume {
      if !isMainTask {
        lines.insert 1, "int ended = 0;"
        isMainTask = true
      }
      const frame = frameTypeName found
      lines.append "\{"
      lines.append "  torb_task *main_task = torb_task_new({entry.name}, sizeof({frame}), &torb_element_void);"
      lines.append "  torb_task_start(main_task);"
      lines.append "  torb_scheduler_run(main_task);"
      lines.append "  if (torb_task_end_main(main_task) != 0) ended = TORB_EXIT_CANCELLED;"
      lines.append "\}"
      continue
    }
    lines.append "{entry.name}();"
    // Tasks it started and did not wait for run once it is done, in the order they were queued
    if isTasked {
      lines.append "torb_scheduler_run(NULL);"
    }
  }
  if lines.length() == 1 && !isNamed {
    return
  }
  // What is still running when the program ends is cancelled and runs to its stop, so every frame is released
  if isTasked {
    lines.append "torb_scheduler_finish();"
  }
  // The entry cells hold a count until nothing can read them any more: after the last task
  if hasCells {
    lines.append "torb_process_on_exit(NULL);"
    lines.append "{entryCellReleaseName}();"
  }
  // The summary of the run is written before the leak report, so the two reports read in the order they happened
  const ending = if isMainTask {
    "ended"
  } else {
    "0"
  }
  if isTestRun {
    lines.append "int code = torb_test_finish();"
    lines.append "torb_process_finish();"
    lines.append "return code != 0 ? code : {ending};"
  } else {
    lines.append "torb_process_finish();"
    lines.append "return {ending};"
  }
  var body = ""
  for line in lines {
    body = body + "  " + line + "\n"
  }
  write emission, CDeclaration.Fixed("int main(int argument_count, char **argument_values) \{\n" + body + "\}")
}

/**
 * Whether the program starts a task anywhere: a resume function, or a call of the runtime that answers a task (`sleep`,
 * `pause`). A program that does not pays nothing - its `main` never touches the scheduler.
 */
public fn usesTasks(functions: List<IrFunction>): Bool {
  for function in functions {
    if function.kind == FunctionKind.TaskResume {
      return true
    }
    for block in function.blocks {
      for instruction in block.instructions {
        if const .TaskNew(_, _, _, _) = instruction {
          return true
        }
      }
    }
  }
  false
}

// --- The prototypes of the runtime ----------------------------------------------------------------------------------

/**
 * The C prototype of every runtime symbol the manifest declares ready, by symbol. A call of a native is checked
 * against it, so the emitter can only ever write a call the runtime really has (BACKEND 3.7).
 */
public fn runtimePrototypes(): Map<String, String> {
  var found: Map<String, String> = [:]
  for entry in nativeEntries() {
    if const .Planned(_) = entry.state {
      continue
    }
    if const .Runtime(symbol) = entry.target {
      if !found.containsKey(symbol) {
        found.set symbol, entry.prototype
      }
    }
  }
  found
}

/** The layout of a type whose `R_`/`D_` pair something outside a function body calls: an element of a container. */
/** An element that is an object with a destructor: its descriptor's release names the object's drop function. */
fn markDestructor(program: IrProgram, var drops: List<Bool>, id: IrTypeId) {
  if !program.hasType(id) {
    return
  }
  if const .SharedObject(layout) = program.typeAt(countedFormOf(program, id)) {
    if program.closeFunctions.containsKey(layout.value) && program.hasLayout(layout) {
      drops.set layout.value, true
    }
  }
}

fn markLayoutOfHelper(program: IrProgram, var flags: List<Bool>, id: IrTypeId) {
  if !program.hasType(id) {
    return
  }
  if const Some(layout) = inlineCountedLayoutOf(program, countedFormOf(program, id)) {
    markLayoutFlag program, flags, layout
  }
}
