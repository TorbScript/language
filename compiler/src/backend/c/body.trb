/**
 * One function body as C: the slots as locals, the blocks as labels and `goto`, and one statement per instruction
 * ([bodyStatements]).
 *
 * Everything here answers **values** of `writer.trb` and never text: an instruction becomes a list of `CStatement`, an
 * operand a `CExpression`. So no part of this file decides a parenthesis or an indentation, and what it does decide -
 * which shape of the ABI a retain is, where the `->` of a place goes - is what it is about.
 *
 * The shape follows BACKEND 3.6: all slots are declared at the top, so no `goto` can cross an initialization; every
 * block carries its label as a comment; a `#line` directive points every statement at the TorbScript source. Every
 * slot is zero initialized, and a slot nothing reads is cast to `void` once - the generated code has to compile with
 * `-Wall -Wextra -Werror`, and an uninitialized or unused variable is a warning there.
 *
 * # Related
 *
 * - [Body] - the reads and the labels [bodyOf] precomputes for one function.
 * - [retainStatement], [releaseStatement] - the ownership half: what the ABI does with a counted value.
 */

use IrProgram, IrFunction, IrSignature, IrTypeId, LayoutId, FunctionId from "../../ir/ir"
use Slot, SlotDeclaration, BlockId, Instruction, Terminator, Argument, WitnessSource from "../../ir/ir"
use Reference, LocationId, RuntimeKind, WitnessRoot, WitnessTableId, Capture from "../../ir/ir"
use ElementId, IrParameter, ElementDescriptor from "../../ir/ir"
use Intrinsic, IntrinsicOperation, NumericKind from "../../ir/ir"
use Keeping, keepingSlotsOf from "../../ir/kept"
use Layout, isManagedType, containsCountedType, TextPartKind, textPartKindOf from "../../ir/layout"
use isEnvironmentLayout from "../../ir/capture"
use suffixOfNumeric from "../../ir/print"
use payloadLayoutName from "../../ir/mangle"
use Emission, reportUnsupported, slotNameOf, locationExpression, lineDirectiveOf from "./emission"
use cTypeOf, whyNoCType, memberNameOf, variantMemberNameOf, witnessMemberNameOf, arrayItemsMember from "./type"
use CExpression, CDesignatedField, CStatement, CSwitchCase, declarationOf from "./writer"
use readPrototype, matchPrototype from "./prototype"
use TaskMachine, taskMachineOf from "../../ir/suspension"
use Crossing, frameCrossingOf, framePrivateOf, environmentCrossingOf from "./crossing"
use environmentCopyOf, environmentCopyNameOf from "./crossing"
use Closing from "../../ir/closing"

/** One function, with which slots are read and which labels are jumped to precomputed once for the whole body. */
public type Body {
  function: IrFunction
  /** The C prototype of every ready runtime symbol, by symbol (BACKEND 3.7). */
  prototypes: Map<String, String>
  /** Whether anything reads the slot. Everything else is cast to `void` once, so no warning is left. */
  readSlots: List<Bool>
  /** Whether any terminator jumps to the block. A label nothing jumps to is a warning, so it is left out. */
  usedLabels: List<Bool>
  /** The result is written through the pointer the caller passes first (BACKEND 3.2). */
  isByPointer: Bool
  /** Per slot: whether the closure a `Closure` writes into it keeps its environment on the frame ([framedClosures]). */
  framedClosures: List<Bool>
  /** The state machine of a resume function (`ir/suspension.trb`), and `None` for every other function. */
  machine: TaskMachine? = None
  /** Which types of the program may hold an object with a destructor: a slice of a list of them copies ([sliceSymbolOf]). */
  closing: Closing = Closing([])
  /** Per slot: whether a `Clear` writes it, so its value may be the zero value of its type ([guardedRelease]). */
  clearedSlots: List<Bool> = []
}

/** The name the caller's result pointer has inside the callee. No mangled name can collide with it. */
public const resultPointerName = "torb_result"

/**
 * Walks every block once to mark which slots are read and which labels are jumped to, so [bodyStatements] never has
 * to ask an instruction twice what it does with a slot.
 */
public fn bodyOf(
  program: IrProgram,
  function: IrFunction,
  prototypes: Map<String, String>,
  keeping: Keeping,
  closing: Closing,
): Body {
  var reads: List<Bool> = []
  for _ in 0..function.slots.length() {
    reads.append false
  }
  var labels: List<Bool> = []
  for _ in 0..function.blocks.length() {
    labels.append false
  }
  var cleared: List<Bool> = []
  for block in function.blocks {
    for instruction in block.instructions {
      markReadSlots program, function, reads, instruction
      if const .Clear(target) = instruction {
        markCleared cleared, function.slots.length(), target
      }
    }
    markTerminator reads, labels, block.terminator
  }
  const framed = framedClosures program, function, keeping
  if const .TaskResume = function.kind {
    // The value goes into the task block and never through a result pointer, whatever its size
    const machine = taskMachineOf program, function
    return Body function, prototypes, reads, labels, false, framed, Some(machine), closing, cleared
  }
  Body function, prototypes, reads, labels, isByPointerResult(function), framed, closing: closing, clearedSlots: cleared
}

/** Marks a slot a `Clear` writes; the list is made on the first one, so a body without any keeps none. */
fn markCleared(var cleared: List<Bool>, count: Int, slot: Slot) {
  if cleared.isEmpty() {
    for _ in 0..count {
      cleared.append false
    }
  }
  if slot.value >= 0 && slot.value < cleared.length() {
    cleared.set slot.value, true
  }
}

/**
 * Which closures of one body may keep their environment on the frame instead of allocating one.
 *
 * Two answers have to agree, and this is the second one. The checker says the closure is **`local`**: it is written
 * straight as the argument of a call, so it cannot outlive that call (`ir/lower/closure.trb`, and BACKEND's decision
 * 14, "A closure that captures a `var` reference may not escape"). The IR says the callee does not **keep** it: the
 * slot the `Closure` wrote is used only as an argument of a call no callee of which may keep that parameter
 * (`keeping`, the summary of `ir/kept.trb`), as the callee of a `CallClosure`, or by the `Release` this frame itself
 * emitted.
 *
 * Both halves are needed, and BACKEND's decision names both: "conservatively, when it is written directly as an
 * argument of a call **and is not stored by the callee**". A closure handed to `Iterate.map` is `local` and is kept -
 * the `Mapped` record it lands in is answered to this frame and may be answered on - so this says no. So does a callee
 * that hands the closure on to a witness call or a closure call, however deep: `holder.keep { ... }` whose body is
 * `actions.add action` on a trait-typed `List` stores it although the ownership summary calls the parameter
 * borrowed. Everything that cannot be proved is proved false: an argument of a witness call whose tables cannot be
 * named, an argument of a `CallClosure`, a place, a `Copy`, a `Return`, a capture, and a store are all a heap
 * environment.
 */
fn framedClosures(program: IrProgram, function: IrFunction, keeping: Keeping): List<Bool> {
  var found: List<Bool> = []
  for _ in 0..function.slots.length() {
    found.append false
  }
  for block in function.blocks {
    for instruction in block.instructions {
      if const .Closure(target, _, _, isEscaping) = instruction {
        if !isEscaping && target.value >= 0 && target.value < found.length() {
          found.set target.value, true
        }
      }
    }
  }
  for block in function.blocks {
    for instruction in block.instructions {
      for slot in keepingSlotsOf(program, keeping, function, instruction) {
        if slot.value >= 0 && slot.value < found.length() {
          found.set slot.value, false
        }
      }
    }
    if const .Return(value) = block.terminator {
      if const Some(argument) = value {
        if argument.slot.value >= 0 && argument.slot.value < found.length() {
          found.set argument.slot.value, false
        }
      }
    }
  }
  found
}

fn isByPointerResult(function: IrFunction): Bool {
  match function.signature.resultMode {
    .ByPointer => true
    .ByValue => false
  }
}

fn markRead(var reads: List<Bool>, slot: Slot) {
  if slot.value >= 0 && slot.value < reads.length() {
    reads.set slot.value, true
  }
}

/** An argument of a `var` parameter reads the whole path it names, base and index alike, and not only its base. */
fn markArguments(var reads: List<Bool>, arguments: List<Argument>) {
  for argument in arguments {
    markRead reads, argument.slot
    if const Some(place) = argument.place {
      markReference reads, place
    }
  }
}

/** A witness that comes out of a value is a read of that value: the payload of the call comes out of the same slot. */
fn markWitness(var reads: List<Bool>, witness: WitnessSource) {
  if const .Value(place, _) = witness.root {
    markReference reads, place
  }
}

fn markReference(var reads: List<Bool>, reference: Reference) {
  markRead reads, reference.base
  for step in reference.steps {
    if const .Element(_, index, _, _) = step {
      markRead reads, index
    }
  }
}

/**
 * Every operand occurrence, which is what "something reads this slot" means. A target is a write and not a read.
 *
 * The one operand that is *not* a read is a `Void` part of a concatenation: `Void` has exactly one value, so the
 * runtime writes `void` from the tag alone and the initializer names no member at all. A slot nothing reads is cast
 * to `void` once, which is what keeps `-Wunused-but-set-variable` quiet about it.
 */
fn markReadSlots(program: IrProgram, function: IrFunction, var reads: List<Bool>, instruction: Instruction) {
  if const .Intrinsic(_, intrinsic, arguments, _) = instruction {
    if const .TextConcat = intrinsic.operation {
      for slot in arguments {
        if !isVoidPart(program, function, slot) {
          markRead reads, slot
        }
      }
      return
    }
  }
  match instruction {
    .Constant(_, _) => {}
    .Move(_, source) => markRead reads, source
    .Copy(_, source) => markRead reads, source
    .Retain(slot) => markRead reads, slot
    .Release(slot) => markRead reads, slot
    .EndOfScope(slot) => markRead reads, slot
    .Clear(_) => {}
    .MakeUnique(reference) => markReference reads, reference
    .Call(_, _, arguments, _, _) => markArguments reads, arguments
    .CallClosure(_, callee, arguments, _) => {
      markRead reads, callee
      markArguments reads, arguments
    }
    .CallWitness(_, witness, _, arguments, _) => {
      markWitness reads, witness
      markArguments reads, arguments
    }
    .Intrinsic(_, _, arguments, _) => {
      for slot in arguments {
        markRead reads, slot
      }
    }
    .Construct(_, _, _, fields) => markArguments reads, fields
    .ArrayNew(_, items) => markArguments reads, items
    .Read(_, reference) => markReference reads, reference
    .Write(reference, value) => {
      markReference reads, reference
      markRead reads, value.slot
    }
    .Tag(_, source) => markRead reads, source
    .Closure(_, _, captures, _) => {
      for capture in captures {
        match capture {
          .Value(slot) => markRead reads, slot
          .Boxed(slot) => markRead reads, slot
          .Place(reference) => markReference reads, reference
        }
      }
    }
    .BoxNew(_, value) => markRead reads, value.slot
    .TraitValue(_, value, tables) => {
      markRead reads, value.slot
      for table in tables {
        markWitness reads, table
      }
    }
    // A fresh container reads nothing: its descriptors are static data
    .ContainerNew(_, _, _) => {}
    .TakeOut(_, container, key, _) => {
      markReference reads, container
      markRead reads, key
    }
    .PutBack(container, key, value, _) => {
      markReference reads, container
      markRead reads, key
      markRead reads, value
    }
    .Panic(message, _) => markRead reads, message.slot
    .Suspend(_, awaited, _) => markRead reads, awaited
    .TaskNew(_, _, _, arguments) => markArguments reads, arguments
    .ChannelNew(_, capacity, _, _) => markRead reads, capacity
  }
}

fn isVoidPart(program: IrProgram, function: IrFunction, slot: Slot): Bool {
  if !function.hasSlot(slot) {
    return false
  }
  if const Some(kind) = textPartKindOf(program, function.typeOfSlot(slot)) {
    if const .VoidPart = kind {
      return true
    }
  }
  false
}

fn markTerminator(var reads: List<Bool>, var labels: List<Bool>, terminator: Terminator) {
  match terminator {
    .Jump(target) => markLabel labels, target
    .Branch(condition, then, otherwise) => {
      markRead reads, condition
      markLabel labels, then
      markLabel labels, otherwise
    }
    .Switch(scrutinee, _, targets, otherwise) => {
      markRead reads, scrutinee
      for target in targets {
        markLabel labels, target
      }
      markLabel labels, otherwise
    }
    .Return(value) => {
      if const Some(argument) = value {
        markRead reads, argument.slot
      }
    }
    .Unreachable => {}
    .Stop => {}
  }
}

fn markLabel(var labels: List<Bool>, block: BlockId) {
  if block.value >= 0 && block.value < labels.length() {
    labels.set block.value, true
  }
}

// --- The head of a function -----------------------------------------------------------------------------------------

/**
 * `static int64_t t_main_double(int64_t s0_value)`: the parameters in declaration order, `self` first, and a `var`
 * parameter as a pointer. A result the layout model calls too big is written through a pointer the caller passes
 * first; a function that does not return is `_Noreturn`.
 *
 * The head stays one spelling and not a value: it is types and a name all the way down, and nothing ever takes one
 * apart again.
 */
public fn signatureHeadOf(program: IrProgram, function: IrFunction): String {
  // A resume function is called by the scheduler alone, with the task whose frame holds its parameters
  if const .TaskResume = function.kind {
    return "static torb_poll {function.name}(torb_task *{taskName})"
  }
  const signature = function.signature
  var parameters: List<String> = []
  if isByPointerResult(function) {
    const spelling = resultTypeOf program, signature.result
    parameters.append declarationOf(pointerTo(spelling), resultPointerName)
  }
  for index in 0..signature.parameters.length() {
    const parameter = signature.parameters[index]
    const spelling = valueTypeOf program, parameter.annotation
    const name = slotNameOf function, Slot(index)
    if parameter.isReference {
      parameters.append declarationOf(pointerTo(spelling), name)
      continue
    }
    parameters.append declarationOf(spelling, name)
  }
  if function.tracksCaller {
    parameters.append "const torb_location *{callerSiteName}"
  }
  const written = if parameters.isEmpty() { "void" } else { parameters.joined separator: ", " }
  const result = returnTypeOf program, function
  "{qualifiersOf(program, function)}{declarationOf(result, "{function.name}({written})")}"
}

/**
 * Which functions the emitter leaves out: a **copy** `specializeFrozenCallees` made that nothing in the program names
 * any more.
 *
 * A copy exists for the direct call sites that could peel its signature, and nothing but a `Call` the devirtualization
 * wrote ever points at one (`ir/devirtualize.trb`). `ir/elements.trb` removes the put-back of every index path it
 * rewrites, and where that was the last call of a copy the copy is dead - and a `static` function a C compiler sees no
 * reference to is an error under `-Wunused-function -Werror`, not merely a wasted body. So it is not emitted at all,
 * which is also what the second ledger of finding 12 asks for.
 *
 * The same holds for the `Indexed.at` instance an index path took an element out with: once the round trip is one
 * `Element` step, a list the program only ever changes through `a[key]` leaves its reader with no call at all - and
 * with it everything only the reader called (the `Option.expect` of its missing key). An array's `a[key]` read is one
 * step as well, and so is the put-back of a path through one - which leaves `Array.set` without a call just as often,
 * so the setters an array path named ([IrProgram.elementWriters]) are left out on the same terms.
 *
 * The answer is a **reachability**: the roots are what nothing calls and is neither a copy nor a reader (the entry, a
 * test, a task body), and every member of a table and of an element descriptor. A `withheld` function is left out
 * like a copy unless something reaches it: the `close()` of an object, which only the drop function of its layout
 * calls. Everything a kept function names is
 * kept, and what is left over is dead - a copy nothing calls, a reader nothing calls, and whatever only those called.
 */
public fn keptFunctions(program: IrProgram, withheld: Set<Int>): List<Bool> {
  const count = program.functions.length()
  var isLeftOut: List<Bool> = []
  var isAnyLeftOut = false
  for index in 0..count {
    // An `Indexed.at` instance an index path asked for is dead once `ir/elements.trb` turned the round trip into one
    // `Element` step, unless something else still calls it
    const isReader = isElementReader program, program.functions[index]
    // A destructor nothing calls: it is kept where something reaches it, or where the drop function that calls it is
    // emitted (`emittedFunctionsOf`)
    // An access to an entry cell nothing calls is no root either: its cell may have no other access at all
    const isCell = isEntryCellAccess program.functions[index]
    const isCopied = program.specializedFunctions.contains(index) || program.callerSiteFunctions.contains(index)
    const leftOut = isCopied || isReader || withheld.contains(index) || isCell
    isLeftOut.append leftOut
    isAnyLeftOut = isAnyLeftOut || leftOut
  }
  var kept: List<Bool> = []
  for _ in 0..count {
    kept.append true
  }
  if !isAnyLeftOut {
    return kept
  }
  var isCalled: List<Bool> = []
  for _ in 0..count {
    isCalled.append false
  }
  for index in 0..count {
    for called in calledFunctionsOf(program.functions[index]) {
      if called.value >= 0 && called.value < count {
        isCalled.set called.value, true
      }
    }
  }
  var pending: List<Int> = []
  for index in 0..count {
    const isRoot = !isCalled[index] && !isLeftOut[index]
    kept.set index, isRoot
    if isRoot {
      pending.append index
    }
  }
  // A table, a descriptor and a constant cell hold a function id the emitter writes out whatever calls it
  for table in program.witnessTables {
    for member in table.members {
      match program.siteCopies.get(member.value) {
        Some(copy) => keepReached kept, pending, FunctionId(copy)
        None => keepReached kept, pending, member
      }
    }
  }
  for descriptor in program.elements {
    for member in descriptorFunctionsOf(descriptor) {
      keepReached kept, pending, member
    }
  }
  while !pending.isEmpty() {
    const last = pending.length() - 1
    const current = pending[last]
    pending.removeAt last
    for called in calledFunctionsOf(program.functions[current]) {
      keepReached kept, pending, called
    }
  }
  kept
}

fn keepReached(var kept: List<Bool>, var pending: List<Int>, callee: FunctionId) {
  if callee.value >= 0 && callee.value < kept.length() && !kept[callee.value] {
    kept.set callee.value, true
    pending.append callee.value
  }
}

fn isEntryCellAccess(function: IrFunction): Bool {
  if const .EntryCell(_, _) = function.kind {
    return true
  }
  false
}

fn isElementReader(program: IrProgram, function: IrFunction): Bool {
  if const Some(origin) = function.origin {
    return program.elementReaders.contains(origin.value) || program.elementWriters.contains(origin.value)
  }
  false
}

/** Every function one body names: what it calls, what a  points at, and a constant cell's initializer. */
fn calledFunctionsOf(function: IrFunction): List<FunctionId> {
  var found: List<FunctionId> = []
  if const .ConstantCell(initializer) = function.kind {
    found.append initializer
  }
  for block in function.blocks {
    for instruction in block.instructions {
      match instruction {
        .Call(_, callee, _, _, _) => found.append callee
        .Closure(_, callee, _, _) => found.append callee
        .TaskNew(_, resume, _, _) => found.append resume
        _ => {}
      }
    }
  }
  found
}

/** The functions an element descriptor names, each of which the emitter may call from the descriptor's helpers. */
fn descriptorFunctionsOf(descriptor: ElementDescriptor): List<FunctionId> {
  var found: List<FunctionId> = []
  for candidate in [descriptor.retain, descriptor.release, descriptor.equals, descriptor.hash] {
    if const Some(function) = candidate {
      found.append function
    }
  }
  found
}

/**
 * A pointer to a value of this type: `T *`, and `T **` where the value is itself a pointer - a `var` parameter of a
 * counted block is one of those, and `T * *` would be the same type spelled worse.
 */
public fn pointerTo(spelling: String): String {
  if spelling.endsWith("*") {
    return "{spelling}*"
  }
  "{spelling} *"
}

/** A function that never returns is `_Noreturn`, which is what keeps a C compiler from asking for a return. */
fn qualifiersOf(program: IrProgram, function: IrFunction): String {
  if isNeverResult(program, function.signature.result) {
    return "static TORB_NORETURN "
  }
  "static "
}

fn returnTypeOf(program: IrProgram, function: IrFunction): String {
  if isByPointerResult(function) {
    return "void"
  }
  resultTypeOf program, function.signature.result
}

/** `Void` and `Never` are `void` as a result; everything else is the type of the value. */
public fn resultTypeOf(program: IrProgram, id: IrTypeId): String {
  if isVoidResult(program, id) {
    return "void"
  }
  valueTypeOf program, id
}

fn isVoidResult(program: IrProgram, id: IrTypeId): Bool {
  if !program.hasType(id) {
    return true
  }
  match program.typeAt(id) {
    .VoidType => true
    .NeverType => true
    _ => false
  }
}

fn isNeverResult(program: IrProgram, id: IrTypeId): Bool {
  if !program.hasType(id) {
    return false
  }
  match program.typeAt(id) {
    .NeverType => true
    _ => false
  }
}

/**
 * The C type of a *value* of this type. Whether the back end has one at all is decided once, before anything is
 * written (`checkProgramTypes`), so this only ever has to stand in for a type that was already reported.
 */
public fn valueTypeOf(program: IrProgram, id: IrTypeId): String {
  const spelling = cTypeOf program, id
  if spelling.isEmpty() || spelling == "void" {
    return "torb_void"
  }
  spelling
}

// --- The body -------------------------------------------------------------------------------------------------------

/** Every statement of one function body, in order: the slots, then every block. */
public fn bodyStatements(var emission: Emission, program: IrProgram, body: Body): List<CStatement> {
  var statements: List<CStatement> = []
  // A machine that keeps nothing across a suspension reads no frame, and an unused local is a warning
  if const Some(machine) = body.machine {
    if machine.frameSlots.contains(true) {
      statements.append frameDeclarationOf(body.function)
    }
  }
  const declarations = slotDeclarationsOf program, body
  statements.appendAll declarations
  if const Some(machine) = body.machine {
    statements.appendAll entryStatements(machine)
  }
  for index in 0..body.function.blocks.length() {
    const found = blockStatements emission, program, body, index
    statements.appendAll found
  }
  if const Some(machine) = body.machine {
    statements.appendAll stopStatements(emission, program, body, machine)
  }
  statements
}

// --- The state machine of a task ------------------------------------------------------------------------------------

/** The parameter of a resume function: the task it runs, whose frame and state it reads. */
const taskName = "task"

/** The local that points at the frame of the task a resume function runs. */
const frameName = "frame"

/** `F_t_resume__t_main_fetch`: the struct of a resume function's frame, whose members are its frame slots. */
public fn frameTypeName(function: IrFunction): String {
  "F_{function.name}"
}

/** `F_x *frame = (F_x *)torb_task_frame(task);`: the frame of this resume, which every frame slot is a member of. */
fn frameDeclarationOf(function: IrFunction): CStatement {
  const spelling = pointerTo frameTypeName(function)
  const frame = CExpression.Call CExpression.Name("torb_task_frame"), [CExpression.Name(taskName)]
  CStatement.Declaration spelling, frameName, Some(CExpression.Cast(spelling, frame))
}

/**
 * The switch over the state a resume goes on at, and the cancellation check of the entry. State 0 is the entry and
 * falls through to the first block; every other state jumps to the label after its suspension point.
 */
fn entryStatements(machine: TaskMachine): List<CStatement> {
  var statements: List<CStatement> = []
  if machine.stateCount() > 0 {
    const state = CExpression.PointerMember CExpression.Name(taskName), "state"
    var cases = [CSwitchCase(0, [CStatement.Break])]
    for index in 1..machine.stateCount() + 1 {
      cases.append CSwitchCase(index, [CStatement.Goto(resumeLabelOf(index))])
    }
    statements.append CStatement.Switch(state, cases, [unreachableStatement])
  }
  statements.append cancellationCheckOf(stopLabelOf(0))
  statements
}

const unreachableStatement = CStatement.Evaluate CExpression.Call(CExpression.Name("TORB_UNREACHABLE"), [])

/** `if (torb_task_cancelled(task)) goto stop_3;`: one load and one branch, at every resume and every back-edge. */
fn cancellationCheckOf(label: String): CStatement {
  const cancelled = CExpression.Call CExpression.Name("torb_task_cancelled"), [CExpression.Name(taskName)]
  CStatement.If cancelled, [CStatement.Goto(label)]
}

fn resumeLabelOf(state: Int): String {
  "resume_{state}"
}

fn stopLabelOf(state: Int): String {
  "stop_{state}"
}

fn backEdgeStopLabelOf(block: Int): String {
  "stop_loop_{block}"
}

/**
 * The stop paths, after the last block: one per state and one per back-edge, each releasing exactly what is live where
 * the machine stops - the same values a `return` there would have let go of - and answering `TORB_POLL_STOPPED`.
 */
fn stopStatements(var emission: Emission, program: IrProgram, body: Body, machine: TaskMachine): List<CStatement> {
  var statements: List<CStatement> = []
  statements.appendAll stopPathOf(emission, program, body, stopLabelOf(0), machine.entry)
  for state in 1..machine.stateCount() + 1 {
    statements.appendAll stopPathOf(emission, program, body, stopLabelOf(state), machine.resumes[state])
  }
  for block in 0..machine.backEdges.length() {
    if machine.isBackEdge(block) {
      const releases = machine.backEdgeReleases[block]
      statements.appendAll stopPathOf(emission, program, body, backEdgeStopLabelOf(block), releases)
    }
  }
  statements
}

fn stopPathOf(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  label: String,
  releases: List<Slot>,
): List<CStatement> {
  var statements = [CStatement.Label(label, "cancelled")]
  for slot in releases {
    const place = slotExpression body, slot
    const released = releaseStatements emission, program, typeOfSlot(body, slot), place
    statements.appendAll guardedRelease(program, body, slot, place, released)
  }
  statements.append CStatement.Return(Some(CExpression.Name("TORB_POLL_STOPPED")))
  statements
}

/**
 * `awaited.await()`, the suspension half: record the state, wait - and return where the wait registered the task - then
 * the label the switch jumps to, the cancellation check, and the outcome the runtime asks to be read once.
 *
 * `torb_task_await` passes a cancellation of `awaited` on: it sets this task's flag, so the check after the label stops
 * the machine through the same stop path a `cancel()` reaches. `result()` `observes` and waits with `torb_task_observe`.
 */
fn suspendStatements(body: Body, state: Int, awaited: Slot, observes: Bool): List<CStatement> {
  const task = CExpression.Name taskName
  const recorded = CStatement.Assignment CExpression.PointerMember(task, "state"), CExpression.Literal("{state}")
  const primitive = if observes {
    "torb_task_observe"
  } else {
    "torb_task_await"
  }
  const waited = CExpression.Call CExpression.Name(primitive), [task, slotExpression(body, awaited)]
  const suspended = CExpression.Binary waited, "==", CExpression.Name("TORB_WAIT_SUSPENDED")
  const returned = CStatement.Return Some(CExpression.Name("TORB_POLL_SUSPENDED"))
  const outcome = CExpression.Call CExpression.Name("torb_task_outcome"), [task]
  [
    recorded,
    CStatement.If(suspended, [returned]),
    CStatement.Label(resumeLabelOf(state), ""),
    cancellationCheckOf(stopLabelOf(state)),
    CStatement.Evaluate(CExpression.Cast("void", outcome)),
  ]
}

/**
 * `TaskNew`: the block, every argument moved into the frame member of its parameter, and the task queued. The frame is
 * zeroed by the runtime, so a member no argument fills starts as every slot does.
 */
fn taskNewStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  resume: FunctionId,
  result: ElementId?,
  arguments: List<Argument>,
): List<CStatement> {
  if !program.hasFunction(resume) {
    return reported emission, "a task over a function that is not in the program"
  }
  const started = program.functionAt resume
  const element = match result {
    Some(found) => {
      if !program.hasElement(found) {
        return reported emission, "a task over an element descriptor that is not in the program"
      }
      CExpression.AddressOf CExpression.Name(program.elementAt(found).name)
    }
    None => CExpression.AddressOf CExpression.Name("torb_element_void")
  }
  const frameType = frameTypeName started
  const place = slotExpression body, target
  const made = CExpression.Call(CExpression.Name("torb_task_new"), [
    CExpression.Name(started.name),
    sizeOf(frameType),
    element,
  ])
  var statements = [CStatement.Assignment(place, made)]
  const frame = CExpression.Cast pointerTo(frameType), CExpression.Call(CExpression.Name("torb_task_frame"), [place])
  var members: List<CExpression> = []
  var types: List<IrTypeId> = []
  for index in 0..arguments.length() {
    const member = CExpression.PointerMember frame, slotNameOf(started, Slot(index))
    statements.append CStatement.Assignment(member, slotExpression(body, arguments[index].slot))
    members.append member
    types.append typeOfSlot(body, arguments[index].slot)
  }
  statements.append startStatementOf(program, place, members, types)
  statements
}

/**
 * The start of a task: pinned to the worker that makes it, or free to be taken by an idle worker before its first run
 * where every value of its frame may cross one ([frameCrossingOf]) - decided here where the types answer it, and by
 * the runtime beside the call where they do not (docs/design/CONCURRENCY.md section 16).
 *
 * Where the test may fail on a value that can be copied soundly, the frame is made private instead while the pool has
 * more than one worker ([framePrivateOf]): `(torb_task_copies() ? <copy> : <test>) ? portable : pinned`. With one worker
 * nothing is copied, because no other worker could take the task.
 */
fn startStatementOf(program: IrProgram, place: CExpression, members: List<CExpression>, types: List<IrTypeId>): CStatement {
  const pinned = CExpression.Name "torb_task_start"
  const portable = CExpression.Name "torb_task_start_portable"
  const crossing = frameCrossingOf program, members, types
  if const .Always = crossing {
    return CStatement.Evaluate CExpression.Call(portable, [place])
  }
  const test = match crossing {
    .When(found) => found
    _ => CExpression.Literal "false"
  }
  // A frame whose copy copies nothing - its closures are tested either way - needs no second branch
  if const .When(copy) = framePrivateOf(program, members, types) {
    if copy != test {
      const copies = CExpression.Call CExpression.Name("torb_task_copies"), []
      const decided = CExpression.Conditional copies, copy, test
      return CStatement.Evaluate CExpression.Call(CExpression.Conditional(decided, portable, pinned), [place])
    }
  }
  const start = match crossing {
    .When(found) => CExpression.Conditional found, portable, pinned
    _ => pinned
  }
  CStatement.Evaluate CExpression.Call(start, [place])
}

/** A resume function finishes by moving its value into the result slot of the task block. */
fn finishedStatements(program: IrProgram, body: Body, value: Argument?): List<CStatement> {
  const finished = CStatement.Return Some(CExpression.Name("TORB_POLL_FINISHED"))
  const found = match value {
    Some(argument) => argument
    None => {
      return [finished]
    }
  }
  if isVoidResult(program, body.function.signature.result) {
    return [finished]
  }
  const spelling = valueTypeOf program, body.function.signature.result
  const slot = CExpression.Call CExpression.Name("torb_task_result_slot"), [CExpression.Name(taskName)]
  const into = CExpression.Dereference CExpression.Cast(pointerTo(spelling), slot)
  [CStatement.Assignment(into, slotExpression(body, found.slot)), finished]
}

/**
 * Every slot as a local, zero initialized, at the top of the function - so that no `goto` crosses an initialization
 * and no path can read a variable a C compiler thinks is uninitialized. A parameter is already a local.
 */
fn slotDeclarationsOf(program: IrProgram, body: Body): List<CStatement> {
  const function = body.function
  var statements: List<CStatement> = []
  var silenced: List<CStatement> = []
  for index in 0..function.slots.length() {
    const declared = function.slots[index]
    const name = slotNameOf function, Slot(index)
    // A member of the frame is no local, and a struct member nothing reads is no warning
    if isFrameSlot(body, Slot(index)) {
      continue
    }
    if !body.readSlots[index] {
      silenced.append CStatement.Evaluate(CExpression.Cast("void", CExpression.Name(name)))
    }
    if isParameterSlot(declared) {
      continue
    }
    const spelling = valueTypeOf program, declared.annotation
    statements.append CStatement.Declaration(spelling, name, Some(zeroInitializer))
  }
  statements.appendAll frameEnvironmentDeclarations(program, body)
  if !silenced.isEmpty() {
    statements.append CStatement.Joined(silenced)
  }
  statements
}

/**
 * The storage of every closure environment this body keeps on the frame ([framedClosures]): one local per `Closure`
 * instruction, beside the slots and zero initialized like them, so no `goto` can cross an initialization.
 *
 * It is named after the slot the closure lands in, which is one per instruction: a closure literal is lowered once,
 * so a loop that makes the same closure a thousand times reuses this one local - which is exactly what "the closure
 * cannot outlive the call it is an argument of" allows.
 */
fn frameEnvironmentDeclarations(program: IrProgram, body: Body): List<CStatement> {
  var statements: List<CStatement> = []
  for block in body.function.blocks {
    for instruction in block.instructions {
      if const .Closure(target, callee, _, _) = instruction {
        if !isFramedClosure(body, target) || !program.hasFunction(callee) {
          continue
        }
        if const Some(layout) = environmentLayoutOfFunction(program, program.functionAt(callee)) {
          const name = frameEnvironmentName body, target
          statements.append CStatement.Declaration(program.layoutAt(layout).name, name, Some(zeroInitializer))
        }
      }
    }
  }
  statements
}

/** The C local that holds the environment of the closure in a slot. */
fn frameEnvironmentName(body: Body, target: Slot): String {
  "{slotNameOf(body.function, target)}_environment"
}

fn isFramedClosure(body: Body, target: Slot): Bool {
  if target.value < 0 || target.value >= body.framedClosures.length() {
    return false
  }
  body.framedClosures[target.value]
}

/** `{ 0 }`, the universal initializer of C11, which is what every slot starts out as. */
const zeroInitializer = CExpression.Initializer([CExpression.Literal("0")])

fn isParameterSlot(declared: SlotDeclaration): Bool {
  match declared.role {
    .Parameter(_) => true
    _ => false
  }
}

fn blockStatements(var emission: Emission, program: IrProgram, body: Body, index: Int): List<CStatement> {
  const block = body.function.blocks[index]
  var statements: List<CStatement> = []
  if const Some(at) = block.at {
    if const Some(directive) = lineDirectiveOf(program, at) {
      statements.append directive
    }
  }
  if body.usedLabels[index] {
    statements.append CStatement.Label("L{index}", block.label)
  } else if !block.label.isEmpty() {
    statements.append CStatement.Comment(block.label)
  }
  for instruction in block.instructions {
    const found = instructionStatements emission, program, body, instruction
    statements.appendAll found
  }
  // Where the loop turns around, a task reads its cancellation flag: every loop of a task is cancellable
  if const Some(machine) = body.machine {
    if machine.isBackEdge(index) {
      statements.append cancellationCheckOf(backEdgeStopLabelOf(index))
    }
  }
  const ending = terminatorStatements emission, program, body, block.terminator
  statements.appendAll ending
  statements
}

// --- Instructions ---------------------------------------------------------------------------------------------------

fn instructionStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  instruction: Instruction,
): List<CStatement> {
  match instruction {
    .Constant(target, value) => {
      const name = program.staticAt(value).name
      const place = slotExpression body, target
      [CStatement.Assignment(place, CExpression.Name(name))]
    }
    .Move(target, source) => moveStatements body, target, source
    .Copy(target, source) => copyStatements emission, program, body, target, source
    .Retain(slot) => {
      const place = slotExpression body, slot
      retainStatements emission, program, typeOfSlot(body, slot), place
    }
    .Release(slot) => {
      const place = slotExpression body, slot
      const released = releaseStatements emission, program, typeOfSlot(body, slot), place
      guardedRelease program, body, slot, place, released
    }
    // The ownership pass removes every one of them, so an emitted body never holds one
    .EndOfScope(_) => []
    .Clear(target) => {
      const place = slotExpression body, target
      const spelling = valueTypeOf program, typeOfSlot(body, target)
      const zero = CExpression.Initializer([CExpression.Literal("0")])
      [CStatement.Assignment(place, CExpression.CompoundLiteral(spelling, zero))]
    }
    .MakeUnique(reference) => makeUniqueStatements emission, program, body, reference
    .Call(target, callee, arguments, witnesses, at) => {
      var statements = frameSiteStatements program, at, isProgramCallee(program, callee)
      statements.appendAll callStatements(emission, program, body, target, callee, arguments, witnesses, at)
      statements
    }
    .Intrinsic(target, intrinsic, arguments, at) => {
      intrinsicStatements emission, program, body, target, intrinsic, arguments, at
    }
    .Construct(target, layout, variant, fields) => {
      constructStatements emission, program, body, target, layout, variant, fields
    }
    .ArrayNew(target, items) => arrayNewStatements emission, program, body, target, items
    // A `Read` of a counted field hands the frame a count of it, which is what makes the target of the read owned
    .Read(target, reference) => {
      var statements: List<CStatement> = []
      const place = placeExpression emission, program, body, reference
      const name = slotExpression body, target
      statements.append CStatement.Assignment(name, place)
      const retains = retainStatements emission, program, typeOfSlot(body, target), name
      statements.appendAll retains
      statements
    }
    // A write through a counted place releases what was there before it stores the new value. A write with **no
    // steps** is the one that does not: it defines its slot (`ir/verify.trb`, `definedSlot`), so the ownership pass
    // released what the slot held at that value's own last use. A `var` parameter is the exception in the exception -
    // its storage is the caller's, no slot of this frame counts what is in it, and the release belongs here
    .Write(reference, value) => {
      var statements: List<CStatement> = []
      const place = placeExpression emission, program, body, reference
      const name = slotExpression body, value.slot
      if reference.steps.isEmpty() && !isReferenceSlot(body, reference.base) {
        statements.append CStatement.Assignment(place, name)
        return statements
      }
      const annotation = placeTypeOf program, body, reference
      const releases = releaseStatements emission, program, annotation, place
      statements.appendAll releases
      statements.append CStatement.Assignment(place, name)
      statements
    }
    .Tag(target, source) => tagStatements emission, program, body, target, source
    .Panic(message, at) => {
      var statements: List<CStatement> = []
      if const Some(directive) = lineDirectiveOf(program, at) {
        statements.append directive
      }
      const name = slotExpression body, message.slot
      const site = siteExpression program, body, at
      statements.append CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_panic"), [name, site]))
      statements
    }
    .CallClosure(target, callee, arguments, at) => {
      var statements = frameSiteStatements program, at, true
      statements.appendAll closureCallStatements(emission, program, body, target, callee, arguments)
      statements
    }
    .CallWitness(target, witness, member, arguments, at) => {
      var statements = frameSiteStatements program, at, true
      statements.appendAll witnessCallStatements(emission, program, body, target, witness, member, arguments, at)
      statements
    }
    .Closure(target, callee, captures, _) => {
      closureStatements emission, program, body, target, callee, captures
    }
    .BoxNew(_, _) => reported emission, "a box built by an instruction instead of by a `construct`"
    .TraitValue(target, value, tables) => {
      traitValueStatements emission, program, body, target, value, tables
    }
    .ContainerNew(target, kind, elements) => {
      containerStatements emission, program, body, target, kind, elements
    }
    .TakeOut(_, _, _, _) => reported emission, "a `var` path through a map"
    .PutBack(_, _, _, _) => reported emission, "a `var` path through a map"
    .Suspend(state, awaited, observes) => {
      if body.machine.isNone() {
        return reported emission, "a suspension outside the body of a task"
      }
      suspendStatements body, state, awaited, observes
    }
    .TaskNew(target, resume, result, arguments) => {
      taskNewStatements emission, program, body, target, resume, result, arguments
    }
    .ChannelNew(target, capacity, item, at) => {
      if !program.hasElement(item) {
        return reported emission, "a channel over an element descriptor that is not in the program"
      }
      const descriptor = CExpression.AddressOf CExpression.Name(program.elementAt(item).name)
      const made = CExpression.Call(CExpression.Name("torb_channel_new"), [
        slotExpression(body, capacity),
        descriptor,
        siteExpression(program, body, at),
      ])
      [CStatement.Assignment(slotExpression(body, target), made)]
    }
  }
}

/** A finding, plus a comment in the C so that a kept `program.c` says where the emitter stopped. */
fn reported(var emission: Emission, what: String): List<CStatement> {
  reportUnsupported emission, what
  [CStatement.Comment("not supported by the C back end yet: {what}")]
}

fn moveStatements(body: Body, target: Slot, source: Slot): List<CStatement> {
  if target == source {
    return []
  }
  const to = slotExpression body, target
  const from = slotExpression body, source
  [CStatement.Assignment(to, from)]
}

/**
 * `Copy` shares ownership: an assignment plus one more count (BACKEND 1.2), which for an inline aggregate means one
 * retain per counted field - that is what the `R_<layout>` helper is. `Move` is the assignment alone.
 */
fn copyStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  source: Slot,
): List<CStatement> {
  var statements: List<CStatement> = []
  const to = slotExpression body, target
  const annotation = typeOfSlot body, source
  if target != source {
    const from = slotExpression body, source
    statements.append CStatement.Assignment(to, from)
  }
  const retains = retainStatements emission, program, annotation, to
  statements.appendAll retains
  statements
}

/**
 * One more count of the value in `place`, or nothing at all where the type carries none.
 *
 * It is the one place that knows every shape the ABI has, and the same answer serves a `Retain`, the retaining half of a
 * `Copy` and the count a `Read` of a counted field hands the frame.
 */
public fn retainStatement(program: IrProgram, id: IrTypeId, place: CExpression): CStatement? {
  const inner = countedFormOf program, id
  if const .FixedArray(item, size) = program.typeAt(inner) {
    return itemsLoopOf program, item, size, place, isRetain: true
  }
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    const helper = retainChildrenFunctionOf program, layout
    return Some CStatement.Evaluate(CExpression.Call(helper, [CExpression.AddressOf(place)]))
  }
  if isCountedPointer(program, inner) {
    return Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_retain"), [place]))
  }
  match program.typeAt(inner) {
    // A trait-typed value owns its boxed payload and borrows its tables, which are static data
    .Object(_) => {
      const data = CExpression.Member place, "data"
      Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_retain"), [data]))
    }
    .Text => Some retainedInto(place, "torb_text_retained")
    // A closure owns its environment and borrows its code pointer, which is static
    .Closure(_) => {
      const held = CExpression.Member place, environmentMemberName
      Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_retain"), [held]))
    }
    .Runtime(kind, _) => {
      match kind {
        .ListStorage => Some retainedInto(place, "torb_list_retained")
        .MapStorage => Some retainedInto(place, "torb_map_retained")
        .SetStorage => Some retainedInto(place, "torb_set_retained")
        // A task and a channel are counted blocks with the header first, so the generic retain is theirs
        .TaskObject => Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_retain"), [place]))
        .ChannelObject => Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_retain"), [place]))
        .FileHandle => Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_retain"), [place]))
        _ => None
      }
    }
    _ => None
  }
}

/** The two members of `torb_closure`: the code pointer the thunks of the program fill in, and the environment. */
public const codeMemberName = "code"

/** The other member of `torb_closure`, alongside [codeMemberName]: the pointer to the closure's own environment. */
public const environmentMemberName = "environment"

/** A slice and a container answer the retained value rather than taking one, so the place is written back. */
fn retainedInto(place: CExpression, symbol: String): CStatement {
  CStatement.Assignment place, CExpression.Call(CExpression.Name(symbol), [place])
}

/** One count less, and the block freed where it was the last one. `None` where the type carries no count. */
public fn releaseStatement(program: IrProgram, id: IrTypeId, place: CExpression): CStatement? {
  const inner = countedFormOf program, id
  if const .FixedArray(item, size) = program.typeAt(inner) {
    return itemsLoopOf program, item, size, place, isRetain: false
  }
  if const Some(layout) = boxedLayoutOf(program, inner) {
    const drop = dropFunctionOf program, layout
    return Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_release"), [place, drop]))
  }
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    const helper = dropFunctionOf program, layout
    return Some CStatement.Evaluate(CExpression.Call(helper, [CExpression.AddressOf(place)]))
  }
  // A `shared type` object is its block, whose drop releases what its fields hold
  if const .SharedObject(layout) = program.typeAt(inner) {
    const drop = dropFunctionOf program, layout
    return Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_release"), [place, drop]))
  }
  match program.typeAt(inner) {
    // The payload is erased, so the drop function comes out of the first table the value carries: it is a function of the
    // *target* type, which is what a table is per, and the payload is that type whichever bound one looks at
    .Object(bounds) => {
      if bounds.isEmpty() {
        return None
      }
      const data = CExpression.Member place, "data"
      const table = CExpression.Member place, witnessMemberNameOf(0)
      const drop = CExpression.PointerMember table, "drop"
      Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_release"), [data, drop]))
    }
    .Text => Some releasedBy(place, "torb_text_release")
    // The environment carries its own drop function, because a closure value has erased which captures are in it
    .Closure(_) => {
      const held = CExpression.Member place, environmentMemberName
      Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_environment_release"), [held]))
    }
    .Runtime(kind, _) => {
      match kind {
        .ListStorage => Some releasedBy(place, "torb_list_release")
        .MapStorage => Some releasedBy(place, "torb_map_release")
        .SetStorage => Some releasedBy(place, "torb_set_release")
        .TaskObject => Some releasedBy(place, "torb_task_release")
        .ChannelObject => Some releasedBy(place, "torb_channel_release")
        // The generic release with the file's own drop, which closes the handle where `close` never ran (torb.h)
        .FileHandle => {
          const drop = CExpression.Name "torb_file_drop"
          Some CStatement.Evaluate(CExpression.Call(CExpression.Name("torb_release"), [place, drop]))
        }
        _ => None
      }
    }
    _ => None
  }
}

/**
 * The release of a trait-typed slot that a `Clear` may have emptied: the zero value has no table, so the drop function
 * the release reads out of the first one is only there when the value is. Every other type releases its zero value
 * through a null pointer, which the runtime passes over, so nothing else needs the test.
 */
fn guardedRelease(
  program: IrProgram,
  body: Body,
  slot: Slot,
  place: CExpression,
  released: List<CStatement>,
): List<CStatement> {
  if released.isEmpty() || !isClearedSlot(body, slot) {
    return released
  }
  if const .Object(_) = program.typeAt(countedFormOf(program, typeOfSlot(body, slot))) {
    const table = CExpression.Member place, witnessMemberNameOf(0)
    return [CStatement.If(CExpression.Binary(table, "!=", CExpression.Literal("NULL")), released)]
  }
  released
}

/** Whether some `Clear` of the body writes the slot: the ones whose value may be the zero value of its type. */
fn isClearedSlot(body: Body, slot: Slot): Bool {
  slot.value >= 0 && slot.value < body.clearedSlots.length() && body.clearedSlots[slot.value]
}

fn releasedBy(place: CExpression, symbol: String): CStatement {
  CStatement.Evaluate CExpression.Call(CExpression.Name(symbol), [place])
}

/**
 * The retain or the release of every item of an `Array<Item, Size>`, as one loop over its slots: an array carries no
 * count of its own and owns one on each item, exactly as an inline record owns one on each field.
 *
 * The counter is named after how deep the item nests arrays, so the loop over an array of arrays does not shadow the
 * counter of the loop around it.
 */
fn itemsLoopOf(program: IrProgram, item: IrTypeId, size: Int, place: CExpression, isRetain: Bool): CStatement? {
  const counter = "torb_item{arrayDepthOf(program, item)}"
  const slot = CExpression.Index CExpression.Member(place, arrayItemsMember), CExpression.Name(counter)
  const inner = if isRetain { retainStatement program, item, slot } else { releaseStatement program, item, slot }
  const found = inner?
  Some CStatement.Loop(counter, size, [found])
}

/** How many arrays a type nests inside of it: 0 for an item that is no array. */
fn arrayDepthOf(program: IrProgram, id: IrTypeId): Int {
  if const .FixedArray(item, _) = program.typeAt(id) {
    return 1 + arrayDepthOf(program, item)
  }
  0
}

/**
 * A niche layout **is** its payload field (BACKEND 3.1), so retaining or releasing one is retaining or releasing that
 * payload - and it never has a struct of its own that a helper could be written against.
 */
public fn countedFormOf(program: IrProgram, id: IrTypeId): IrTypeId {
  if !program.hasType(id) {
    return id
  }
  const layout = match program.typeAt(id) {
    .Variant(found) => found
    _ => {
      return id
    }
  }
  if !program.hasLayout(layout) {
    return id
  }
  const shape = program.layoutAt layout
  if const .Niche(_, field) = shape.representation {
    if field >= 0 && field < shape.fields.length() {
      return shape.fields[field].annotation
    }
  }
  id
}

/** A layout that is stored inline and owns a count on one of its fields: a record of two `String`s, a variant group. */
public fn inlineCountedLayoutOf(program: IrProgram, id: IrTypeId): LayoutId? {
  if !program.hasType(id) {
    return None
  }
  const layout = match program.typeAt(id) {
    .Record(found) => found
    .Variant(found) => found
    .Tuple(found) => found
    _ => {
      return None
    }
  }
  if !program.hasLayout(layout) {
    return None
  }
  const shape = program.layoutAt layout
  if !shape.containsCounted {
    return None
  }
  match shape.representation {
    .Inline => Some layout
    _ => None
  }
}

/** Whether a value of this type *is* the pointer to its counted block, so `torb_retain` takes it directly. */
fn isCountedPointer(program: IrProgram, id: IrTypeId): Bool {
  if !program.hasType(id) {
    return false
  }
  match program.typeAt(id) {
    .SharedObject(_) => true
    .Box(_) => true
    .Lazy(_) => true
    .Record(layout) => isBoxedLayout program, layout
    .Variant(layout) => isBoxedLayout program, layout
    .Tuple(layout) => isBoxedLayout program, layout
    _ => false
  }
}

fn isBoxedLayout(program: IrProgram, id: LayoutId): Bool {
  if !program.hasLayout(id) {
    return false
  }
  match program.layoutAt(id).representation {
    .Boxed => true
    _ => false
  }
}

/** The retain of one place, with a finding where the type carries a count the ABI has no shape for yet. */
fn retainStatements(var emission: Emission, program: IrProgram, id: IrTypeId, place: CExpression): List<CStatement> {
  if !containsCountedType(program, id) {
    return []
  }
  match retainStatement(program, id, place) {
    Some(statement) => [statement]
    None => reported emission, "a retain of {describeCounted(program, id)}"
  }
}

fn releaseStatements(var emission: Emission, program: IrProgram, id: IrTypeId, place: CExpression): List<CStatement> {
  if !containsCountedType(program, id) {
    return []
  }
  match releaseStatement(program, id, place) {
    Some(statement) => [statement]
    None => reported emission, "a release of {describeCounted(program, id)}"
  }
}

/** What kind of counted value this is, in the words [retainStatements] and [releaseStatements] put into a finding. */
public fn describeCounted(program: IrProgram, id: IrTypeId): String {
  match program.typeAt(countedFormOf(program, id)) {
    .SharedObject(_) => "a `shared type` object"
    .Box(_) => "a captured `var` binding"
    .Lazy(_) => "a `lazy` cell"
    .Object(_) => "a trait-typed value without bounds"
    .Closure(_) => "a closure"
    .FixedArray(_, _) => "an `Array<Item, Size>`"
    _ => "a counted value the back end does not know"
  }
}

/** A layout whose representation is boxed - the layout `torb_retain`/`torb_release` reach through a raw pointer. */
public fn boxedLayoutOf(program: IrProgram, id: IrTypeId): LayoutId? {
  if !program.hasType(id) {
    return None
  }
  const layout = match program.typeAt(id) {
    .Record(found) => found
    .Variant(found) => found
    .Tuple(found) => found
    _ => {
      return None
    }
  }
  if !isBoxedLayout(program, layout) {
    return None
  }
  Some layout
}

/**
 * The `torb_drop_function` of a layout: `NULL` where nothing inside it is counted and it runs no destructor, which is
 * most layouts.
 */
public fn dropFunctionOf(program: IrProgram, id: LayoutId): CExpression {
  if !program.hasLayout(id) {
    return nullPointer
  }
  const layout = program.layoutAt id
  if !layout.containsCounted && !program.closeFunctions.containsKey(id.value) {
    return nullPointer
  }
  CExpression.Name "D_{layout.name}"
}

/** The "retain the children" function of a layout, which `torb_make_unique` runs on the shallow copy. */
public fn retainChildrenFunctionOf(program: IrProgram, id: LayoutId): CExpression {
  if !program.hasLayout(id) {
    return nullPointer
  }
  const layout = program.layoutAt id
  if !layout.containsCounted {
    return nullPointer
  }
  CExpression.Name "R_{layout.name}"
}

const nullPointer = CExpression.Literal "NULL"

fn makeUniqueStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  reference: Reference,
): List<CStatement> {
  const place = placeExpression emission, program, body, reference
  const annotation = placeTypeOf program, body, reference
  if const Some(layout) = boxedLayoutOf(program, annotation) {
    const name = program.layoutAt(layout).name
    const retain = retainChildrenFunctionOf program, layout
    const drop = dropFunctionOf program, layout
    const made = CExpression.Call CExpression.Name("torb_make_unique"), [place, sizeOf(name), retain, drop]
    return [CStatement.Assignment(place, CExpression.Cast("{name} *", made))]
  }
  const symbol = containerMadeUniqueSymbol program, annotation
  if !symbol.isEmpty() {
    const made = CExpression.Call CExpression.Name(symbol), [CExpression.AddressOf(place)]
    return [CStatement.Evaluate(made)]
  }
  if isObjectType(program, annotation) {
    return objectMadeUnique emission, program, annotation, place
  }
  if !isManagedType(program, annotation) {
    return []
  }
  // A task, a channel and a `shared type` object have an identity: what a `var` binding of one permits is to act on that
  // one, never on a copy
  if isIdentityRuntime(program, annotation) || isSharedObjectType(program, annotation) {
    return []
  }
  reported emission, "making a value of this type unique"
}

fn isSharedObjectType(program: IrProgram, id: IrTypeId): Bool {
  match program.typeAt(id) {
    .SharedObject(_) => true
    _ => false
  }
}

fn isIdentityRuntime(program: IrProgram, id: IrTypeId): Bool {
  if const .Runtime(kind, _) = program.typeAt(id) {
    return isIdentityKind kind
  }
  false
}

/**
 * A task, a channel and a file: a pointer to a counted block with an identity, where a container is a value around
 * storage.
 */
fn isIdentityKind(kind: RuntimeKind): Bool {
  match kind {
    .TaskObject => true
    .ChannelObject => true
    .FileHandle => true
    _ => false
  }
}

/**
 * Make the boxed payload of a trait-typed value unique. A trait-typed value is a **value**, so a copy of one may not see
 * a change made through the other - and a `Copy` of one retains the box rather than copying it, so a `var fn` member
 * reached through a table has to make that box unique first, exactly as a write through any other counted owner does.
 *
 * The size of the box and its two helpers are a property of the *target* type, which the value has erased: the witness
 * table carries them (`emitHeader`). Every bound of one value describes the same payload, so the first table answers.
 */
fn objectMadeUnique(
  var emission: Emission,
  program: IrProgram,
  annotation: IrTypeId,
  place: CExpression,
): List<CStatement> {
  const bounds = match program.typeAt(annotation) {
    .Object(found) => found
    _ => {
      return reported emission, "making a value of this type unique"
    }
  }
  if bounds.isEmpty() {
    return reported emission, "making a trait-typed value without bounds unique"
  }
  const table = CExpression.Member place, witnessMemberNameOf(0)
  const data = CExpression.Member place, "data"
  const made = CExpression.Call(CExpression.Name("torb_make_unique"), [
    data,
    CExpression.PointerMember(table, "size"),
    CExpression.PointerMember(table, "retain_children"),
    CExpression.PointerMember(table, "drop"),
  ])
  [CStatement.Assignment(data, CExpression.Cast("torb_object *", made))]
}

/**
 * An empty runtime container over its element descriptors. There is one C list and one C hash table for every element
 * type (BACKEND 3.1), so the only thing a fresh container needs is the address of the static descriptor of each of its
 * type arguments - which is what makes this an instruction and not a `native fn` of `std/`.
 */
fn containerStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  kind: RuntimeKind,
  elements: List<ElementId>,
): List<CStatement> {
  var given: List<CExpression> = []
  for element in elements {
    if !program.hasElement(element) {
      return reported emission, "a container over an element descriptor that is not in the program"
    }
    given.append CExpression.AddressOf(CExpression.Name(program.elementAt(element).name))
  }
  const symbol = match kind {
    .ListStorage => "torb_list_new"
    .MapStorage => "torb_map_new"
    .SetStorage => "torb_set_new"
    _ => ""
  }
  if symbol.isEmpty() {
    return reported emission, "an empty container of this kind"
  }
  const place = slotExpression body, target
  [CStatement.Assignment(place, CExpression.Call(CExpression.Name(symbol), given))]
}

fn sizeOf(name: String): CExpression {
  CExpression.Call CExpression.Name("sizeof"), [CExpression.Name(name)]
}

/**
 * The runtime function that makes one container's storage unique, or the empty name for a type that is no container.
 *
 * Every write of a container prepares its own storage, so these are no-ops wherever the write follows immediately; they
 * are what a `MakeUnique` of a container-typed place becomes, and a `var` path that is formed before the write needs
 * exactly them.
 */
fn containerMadeUniqueSymbol(program: IrProgram, id: IrTypeId): String {
  if !program.hasType(id) {
    return ""
  }
  if const .Runtime(kind, _) = program.typeAt(id) {
    match kind {
      .ListStorage => "torb_list_make_unique"
      .MapStorage => "torb_map_make_unique"
      .SetStorage => "torb_set_make_unique"
      _ => ""
    }
  } else {
    ""
  }
}

// --- Calls ----------------------------------------------------------------------------------------------------------

fn callStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot?,
  callee: FunctionId,
  arguments: List<Argument>,
  witnesses: List<WitnessSource>,
  at: LocationId?,
): List<CStatement> {
  if !witnesses.isEmpty() {
    return reported emission, "a call that passes a witness table"
  }
  if !program.hasFunction(callee) {
    return reported emission, "a call of a function that is not in the program"
  }
  const function = program.functionAt callee
  if const .Runtime(symbol) = function.kind {
    return runtimeCallStatements emission, program, body, target, function, symbol, arguments, at
  }
  if const .TaskResume = function.kind {
    return reported emission, "a call of a task"
  }
  var written = argumentsOf emission, program, body, function.signature, arguments
  if function.tracksCaller {
    written.append callerSiteArgument(program, body, at)
  }
  callStatementOf emission, body, target, function, function.name, written, ""
}

/** The hidden parameter of a function that tracks its caller (`ir/sites.trb`): where its panics say they are. */
public const callerSiteName = "torb_site"

/**
 * `TORB_FRAME_SITE(TORB_LOCATION(...));` in front of a call: the line the frame of this function names while the call
 * runs, which only the `dev` profile keeps (`runtime/include/torb.h`) and every other profile compiles to nothing. A
 * call of program code without a location says so, so a panic below it never names the line of an earlier call; a
 * call of the runtime without one sets nothing, because the runtime only calls back into the program where a call
 * has one (a hash, a comparison, a closure it was handed).
 */
fn frameSiteStatements(program: IrProgram, at: LocationId?, isProgramCall: Bool): List<CStatement> {
  const site = match at {
    Some(found) => locationExpression program, found
    None => {
      if !isProgramCall {
        return []
      }
      CExpression.Name "torb_location_unknown"
    }
  }
  [CStatement.Evaluate(CExpression.Call(CExpression.Name("TORB_FRAME_SITE"), [site]))]
}

/** Whether a direct call reaches a function of the program, which has a frame, and not one of the runtime. */
fn isProgramCallee(program: IrProgram, callee: FunctionId): Bool {
  if !program.hasFunction(callee) {
    return false
  }
  match program.functionAt(callee).kind {
    .Runtime(_) => false
    _ => true
  }
}

/**
 * What a call of a function that tracks its caller hands it: the site this function was handed, where it tracks its
 * own caller, and the address of the call's location otherwise - a compound literal of this frame, which outlives the
 * call it is made for, and all the callee ever does with it is hand it on or name it in a panic.
 */
fn callerSiteArgument(program: IrProgram, body: Body, at: LocationId?): CExpression {
  if body.function.tracksCaller {
    return CExpression.Name callerSiteName
  }
  match at {
    Some(found) => CExpression.AddressOf locationExpression(program, found)
    None => CExpression.AddressOf CExpression.Name("torb_location_unknown")
  }
}

/**
 * The site a panic of this function names: `at`, or the site of its caller where the function tracks it - which is
 * every site of such a function, a `panic`, an overflow, a native and an index alike.
 */
fn siteExpression(program: IrProgram, body: Body, at: LocationId): CExpression {
  if body.function.tracksCaller {
    return CExpression.Dereference CExpression.Name(callerSiteName)
  }
  locationExpression program, at
}

/**
 * One call, with the result where it belongs: in the slot, through the pointer the caller passes first, or nowhere.
 */
fn callStatementOf(
  var emission: Emission,
  body: Body,
  target: Slot?,
  function: IrFunction,
  symbol: String,
  written: List<CExpression>,
  conversion: String,
): List<CStatement> {
  var given = written
  const byPointer = isByPointerResult function
  match target {
    Some(slot) => {
      const place = slotExpression body, slot
      if byPointer {
        given.insert 0, CExpression.AddressOf(place)
        return [CStatement.Evaluate(CExpression.Call(CExpression.Name(symbol), given))]
      }
      const called = CExpression.Call CExpression.Name(symbol), given
      const value = if conversion.isEmpty() { called } else { CExpression.Cast conversion, called }
      [CStatement.Assignment(place, value)]
    }
    None => {
      if byPointer {
        return reported emission, "a call whose big result nobody takes"
      }
      [CStatement.Evaluate(CExpression.Call(CExpression.Name(symbol), given))]
    }
  }
}

/** Every argument in declaration order. A `var` parameter takes the address of the place the argument names. */
fn argumentsOf(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  signature: IrSignature,
  arguments: List<Argument>,
): List<CExpression> {
  var written: List<CExpression> = []
  for index in 0..arguments.length() {
    const parameter = signature.parameters.get index
    const isReference = match parameter {
      Some(found) => found.isReference
      None => false
    }
    if isReference {
      written.append referenceExpression(emission, program, body, arguments[index])
      continue
    }
    const place = slotExpression body, arguments[index].slot
    // An element of a container goes over as its address, because one C implementation serves every element type
    if isByAddressParameter(parameter) {
      written.append CExpression.AddressOf(place)
      continue
    }
    written.append place
  }
  written
}

fn isByAddressParameter(parameter: IrParameter?): Bool {
  match parameter {
    Some(found) => found.isByAddress
    None => false
  }
}

/**
 * The pointer a `var` parameter takes: the address of the place its argument names.
 *
 * A place that is a `var` parameter of *this* frame already is that pointer, so nothing is taken of it - `&*p` only
 * spells `p` the long way, and the generated C is read by people.
 */
fn referenceExpression(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  argument: Argument,
): CExpression {
  const place = match argument.place {
    Some(found) => found
    None => {
      reportUnsupported emission, "a `var` parameter whose argument is a value and not a place"
      return CExpression.AddressOf CExpression.Name(slotNameOf(body.function, argument.slot))
    }
  }
  if place.steps.isEmpty() && isReferenceSlot(body, place.base) {
    return CExpression.Name slotNameOf(body.function, place.base)
  }
  CExpression.AddressOf placeExpression(emission, program, body, place)
}

/**
 * A `native fn` the runtime provides. It is called as declared only where the manifest's prototype says exactly that;
 * a native whose result is an `Option` or a `Result`, one that takes a pointer, and one that wants the source location
 * of the call all need something the lowering does not write yet, and each is a finding that names the native.
 */
/**
 * `torb_list_slice` shares the storage of the list it slices, and a slice of a list whose elements may hold an object
 * with a destructor copies instead: shared storage would keep every element of the original alive for as long as the
 * slice lives, so when an element closes would depend on a slice that never mentioned it (docs/design/DESTRUCTORS.md
 * 2a). The copy has the same prototype, and the decision is the program's own `Closing` fact, so a program without
 * such an object emits exactly the C it did.
 */
fn sliceSymbolOf(program: IrProgram, body: Body, function: IrFunction, symbol: String): String {
  if symbol != "torb_list_slice" || body.closing.isEmpty() {
    return symbol
  }
  if const .Runtime(_, arguments) = program.typeAt(function.signature.result) {
    if const Some(item) = arguments.first() {
      if body.closing.holds(item) {
        return "torb_list_slice_copied"
      }
    }
  }
  symbol
}

fn runtimeCallStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot?,
  function: IrFunction,
  symbol: String,
  arguments: List<Argument>,
  at: LocationId?,
): List<CStatement> {
  const text = body.prototypes.get(symbol) ?? ""
  if text.isEmpty() {
    return reported emission, "`{symbol}`, which the natives manifest declares no prototype for"
  }
  const prototype = match readPrototype(text) {
    Some(found) => found
    None => {
      return reported emission, "`{symbol}`, whose prototype the emitter could not read"
    }
  }
  const matched = matchPrototype program, function.signature, prototype, symbol
  match matched {
    .Direct => {
      const written = argumentsOf emission, program, body, function.signature, arguments
      callStatementOf emission, body, target, function, symbol, written, ""
    }
    .WithLocation => {
      const site = match at {
        Some(found) => found
        None => {
          return reported emission, "`{symbol}` takes the source location of the call, and the call carries none"
        }
      }
      var written = argumentsOf emission, program, body, function.signature, arguments
      written.append siteExpression(program, body, site)
      const called = sliceSymbolOf program, body, function, symbol
      callStatementOf emission, body, target, function, called, written, ""
    }
    .Converted(annotation, withLocation) => {
      var written = argumentsOf emission, program, body, function.signature, arguments
      if withLocation {
        const site = match at {
          Some(found) => found
          None => {
            return reported emission, "`{symbol}` takes the source location of the call, and the call carries none"
          }
        }
        written.append siteExpression(program, body, site)
      }
      callStatementOf emission, body, target, function, symbol, written, annotation
    }
    .Mismatch(what) => reported emission, what
  }
}

// --- Closures ---------------------------------------------------------------------------------------------------------

/**
 * `Closure`: the environment as a counted block, then the two members of the closure value.
 *
 * The code pointer is the **thunk** of the target function and never the function itself, which is what makes the cast
 * back at the call site well defined: the thunk really has the erased signature `(torb_environment *, ...)`, and it is
 * what turns a function without an environment - a named function used as a value - into a closure for free.
 *
 * A closure without captures has no environment at all: the null pointer, which `torb_retain` and
 * `torb_environment_release` both treat as nothing.
 */
fn closureStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  callee: FunctionId,
  captures: List<Capture>,
): List<CStatement> {
  if !program.hasFunction(callee) {
    return reported emission, "a closure of a function that is not in the program"
  }
  const function = program.functionAt callee
  const place = slotExpression body, target
  const code = CExpression.Cast closureCodeType, CExpression.Name(closureThunkNameOf(function.name))
  const layout = environmentLayoutOfFunction program, function
  const found = match layout {
    Some(inner) => inner
    None => {
      if !captures.isEmpty() {
        return reported emission, "a closure with captures whose function takes no environment"
      }
      return [
        CStatement.Assignment(CExpression.Member(place, codeMemberName), code),
        CStatement.Assignment(CExpression.Member(place, environmentMemberName), nullPointer),
      ]
    }
  }
  const shape = program.layoutAt found
  if shape.fields.length() != captures.length() {
    return reported emission, "a closure whose environment does not hold exactly its captures"
  }
  // A closure the IR proves cannot leave this frame keeps its environment in a local of it, so nothing is allocated
  if isFramedClosure(body, target) {
    return framedClosureStatements emission, program, body, target, place, code, found, shape, captures
  }
  const spelling = "{shape.name} *"
  var inner: List<CStatement> = []
  const allocated = CExpression.Call(CExpression.Name("torb_allocate"), [
    sizeOf(shape.name),
    CExpression.Name("TORB_BLOCK_ENVIRONMENT"),
  ])
  inner.append CStatement.Declaration(spelling, "environment", Some(CExpression.Cast(spelling, allocated)))
  const drop = CExpression.PointerMember CExpression.Name("environment"), "drop"
  inner.append CStatement.Assignment(drop, dropFunctionOf(program, found))
  const copy = CExpression.PointerMember CExpression.Name("environment"), "privatize"
  inner.append CStatement.Assignment(copy, environmentCopyExpressionOf(program, found))
  var members: List<CExpression> = []
  var types: List<IrTypeId> = []
  for index in 0..captures.length() {
    const member = CExpression.PointerMember CExpression.Name("environment"), memberNameOf(shape.fields[index])
    const value = captureExpression emission, program, body, captures[index]
    inner.append CStatement.Assignment(member, value)
    members.append member
    types.append shape.fields[index].annotation
  }
  // Captures that may all cross to another worker make the environment shared, so the closure may run on several
  const sharing = CStatement.Evaluate CExpression.Call(CExpression.Name("torb_share"), [CExpression.Name("environment")])
  match environmentCrossingOf(program, members, types) {
    .Always => inner.append sharing
    .Never => {}
    .When(test) => inner.append CStatement.If(test, [sharing])
  }
  inner.append CStatement.Assignment(CExpression.Member(place, codeMemberName), code)
  const erased = CExpression.Cast "torb_environment *", CExpression.Name("environment")
  inner.append CStatement.Assignment(CExpression.Member(place, environmentMemberName), erased)
  [CStatement.Block(inner)]
}

/**
 * What an environment of this layout is copied with at the crossing of a worker: its `PE_<layout>` where every
 * capture may be copied (`environmentCopyOf`), `NULL` otherwise.
 */
public fn environmentCopyExpressionOf(program: IrProgram, layout: LayoutId): CExpression {
  if const .Never = environmentCopyOf(program, layout) {
    return nullPointer
  }
  CExpression.Name environmentCopyNameOf(program, layout)
}

/**
 * The same closure with its environment in a local of the frame: `torb_environment_on_frame` writes the header the
 * runtime reads - count one, the kind that says "never freed", and the drop of the layout - and the captures are
 * stored into the local exactly as they would be into a block.
 *
 * Nothing else about the closure changes: the value is the same pair of a code pointer and an `torb_environment *`,
 * a copy of it retains the environment and the last release runs its drop, so every capture is released once.
 */
fn framedClosureStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  place: CExpression,
  code: CExpression,
  layout: LayoutId,
  shape: Layout,
  captures: List<Capture>,
): List<CStatement> {
  const name = CExpression.Name frameEnvironmentName(body, target)
  const erased = CExpression.Cast "torb_environment *", CExpression.AddressOf(name)
  var statements: List<CStatement> = []
  const prepared = CExpression.Call(CExpression.Name("torb_environment_on_frame"), [
    erased,
    dropFunctionOf(program, layout),
  ])
  statements.append CStatement.Evaluate(prepared)
  // A frame environment never crosses a worker: its `privatize` stays the NULL of the local's zero initializer
  for index in 0..captures.length() {
    const member = CExpression.Member name, memberNameOf(shape.fields[index])
    const value = captureExpression emission, program, body, captures[index]
    statements.append CStatement.Assignment(member, value)
  }
  statements.append CStatement.Assignment(CExpression.Member(place, codeMemberName), code)
  statements.append CStatement.Assignment(CExpression.Member(place, environmentMemberName), erased)
  statements
}

/**
 * What one capture puts into the environment: the value, the box, or the pointer of a place.
 *
 * # Open
 *
 * A capture of a `var` parameter (`.Place`) is reported as unsupported and its address is written anyway, so the walk
 * can keep looking for further findings; `torb build` never reaches a C compiler with it, because a program with any
 * finding is refused first.
 */
fn captureExpression(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  capture: Capture,
): CExpression {
  match capture {
    .Value(slot) => slotExpression body, slot
    .Boxed(slot) => slotExpression body, slot
    .Place(reference) => {
      reportUnsupported emission, "a closure that captures a `var` parameter"
      CExpression.AddressOf placeExpression(emission, program, body, reference)
    }
  }
}

/** `void (*)(void)`, the one type a code pointer is stored as. Every call converts it back to the thunk's own. */
const closureCodeType = "void (*)(void)"

/** `F_t_main_run`: the thunk of one function, which is what a closure value points at. */
public fn closureThunkNameOf(name: String): String {
  "F_{name}"
}

/**
 * The environment of a closure body, out of its first parameter. A closure body is the one kind of function whose first
 * parameter is a `LayoutKind.Environment` record, so nothing else has to be recorded about it anywhere.
 */
public fn environmentLayoutOfFunction(program: IrProgram, function: IrFunction): LayoutId? {
  const parameter = function.signature.parameters.first()?
  const layout = match program.typeAt(parameter.annotation) {
    .Record(found) => found
    _ => {
      return None
    }
  }
  if !program.hasLayout(layout) {
    return None
  }
  if !isEnvironmentLayout(program.layoutAt(layout)) {
    return None
  }
  Some layout
}

/**
 * `CallClosure`: the code pointer, converted back to the signature the thunk of the closure really has, applied to the
 * environment and the written arguments.
 */
fn closureCallStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot?,
  callee: Slot,
  arguments: List<Argument>,
): List<CStatement> {
  const annotation = typeOfSlot body, callee
  const identifier = match program.typeAt(annotation) {
    .Closure(found) => found
    _ => {
      return reported emission, "a call of a value that is not a closure"
    }
  }
  const signature = program.signatureAt identifier
  if isByPointerSignature(signature) {
    return reported emission, "a call of a closure whose result is written through a pointer"
  }
  const held = slotExpression body, callee
  var spellings = ["torb_environment *"]
  for parameter in signature.parameters {
    const spelling = valueTypeOf program, parameter.annotation
    spellings.append(if parameter.isReference { pointerTo spelling } else { spelling })
  }
  const result = resultTypeOf program, signature.result
  const shape = "{result} (*)({spellings.joined(separator: ", ")})"
  var given = [CExpression.Member(held, environmentMemberName)]
  given.appendAll argumentsOf(emission, program, body, signature, arguments)
  const code = CExpression.Cast shape, CExpression.Member(held, codeMemberName)
  const called = CExpression.Call code, given
  match target {
    Some(slot) => {
      if result == "void" {
        return [CStatement.Evaluate(called)]
      }
      [CStatement.Assignment(slotExpression(body, slot), called)]
    }
    None => [CStatement.Evaluate(called)]
  }
}

fn isByPointerSignature(signature: IrSignature): Bool {
  match signature.resultMode {
    .ByPointer => true
    .ByValue => false
  }
}

// --- Trait-typed values -----------------------------------------------------------------------------------------------

/**
 * `TraitValue`: the payload goes into a counted block of its own and one witness pointer per bound goes next to it. The
 * box is an ordinary layout, so it is allocated the way every other counted block is - only its kind says what it is.
 */
fn traitValueStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  value: Argument,
  tables: List<WitnessSource>,
): List<CStatement> {
  const place = slotExpression body, target
  const item = typeOfSlot body, value.slot
  // `Show & Hash` narrowed to `Show`: the payload is boxed already, so nothing is boxed twice and only the tables change
  if isObjectType(program, item) {
    var narrowed: List<CStatement> = []
    const data = CExpression.Member slotExpression(body, value.slot), "data"
    narrowed.append CStatement.Assignment(CExpression.Member(place, "data"), data)
    for index in 0..tables.length() {
      const found = witnessExpression emission, program, body, tables[index]
      narrowed.append CStatement.Assignment(CExpression.Member(place, witnessMemberNameOf(index)), found)
    }
    return narrowed
  }
  const layout = match program.layoutNamed(payloadLayoutName(program, item)) {
    Some(found) => found
    None => {
      return reported emission, "a trait-typed value whose payload has no layout"
    }
  }
  const name = program.layoutAt(layout).name
  const spelling = "{name} *"
  var inner: List<CStatement> = []
  const allocated = CExpression.Call(CExpression.Name("torb_allocate"), [
    sizeOf(name),
    CExpression.Name("TORB_BLOCK_OBJECT"),
  ])
  inner.append CStatement.Declaration(spelling, "box", Some(CExpression.Cast(spelling, allocated)))
  const shape = program.layoutAt layout
  if shape.fields.isEmpty() {
    return reported emission, "a trait-typed value whose payload layout has no field"
  }
  const field = CExpression.PointerMember CExpression.Name("box"), memberNameOf(shape.fields[0])
  inner.append CStatement.Assignment(field, slotExpression(body, value.slot))
  const data = CExpression.Member place, "data"
  inner.append CStatement.Assignment(data, CExpression.Cast("torb_object *", CExpression.Name("box")))
  for index in 0..tables.length() {
    const found = witnessExpression emission, program, body, tables[index]
    inner.append CStatement.Assignment(CExpression.Member(place, witnessMemberNameOf(index)), found)
  }
  [CStatement.Block(inner)]
}

/**
 * A call through a witness table. The **receiver is not among the arguments**: it is the boxed payload of the value the
 * witness came from, so both come out of one slot. The member is a thunk with the erased signature, and the pointer is
 * converted back to exactly that signature here - which is what makes the call well defined C.
 */
fn witnessCallStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot?,
  witness: WitnessSource,
  member: Int,
  arguments: List<Argument>,
  at: LocationId?,
): List<CStatement> {
  const receiver = match witness.root {
    .Value(place, _) => place
    _ => {
      return reported emission, "a call through a witness table that does not belong to a value"
    }
  }
  const table = witnessExpression emission, program, body, witness
  const result = match target {
    Some(slot) => valueTypeOf program, typeOfSlot(body, slot)
    None => "void"
  }
  // Every thunk takes `void *self`: a call site knows the member's index and not its declaration, so one spelling is
  // what makes the cast back well defined C (see `thunkHeadOf`)
  var spellings = ["void *"]
  const value = placeExpression emission, program, body, receiver
  var given = [CExpression.Member(value, "data")]
  for argument in arguments {
    spellings.append valueTypeOf(program, typeOfSlot(body, argument.slot))
    given.append slotExpression(body, argument.slot)
  }
  // Every thunk takes the site of the call last (`thunkHeadOf`), for a member that tracks its caller
  spellings.append "const torb_location *"
  given.append callerSiteArgument(program, body, at)
  const annotation = "{result} (*)({spellings.joined(separator: ", ")})"
  const members = CExpression.PointerMember table, "members"
  const entry = CExpression.Index members, CExpression.Literal("{member}")
  const callee = CExpression.Cast annotation, entry
  const called = CExpression.Call callee, given
  match target {
    Some(inner) => [CStatement.Assignment(slotExpression(body, inner), called)]
    None => [CStatement.Evaluate(called)]
  }
}

/**
 * Which table a witness source names: one of the witness pointers of a value, or a static table of the program, and then
 * one `nested[i]` step per supertrait the lowering walked down (`narrowingPathOf`). The indices belong to the trait, so
 * this is the one place where a table of a type the value has erased can be named at all.
 */
fn witnessExpression(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  witness: WitnessSource,
): CExpression {
  var found = rootExpression emission, program, body, witness.root
  for step in witness.steps {
    const list = CExpression.PointerMember found, "nested"
    found = CExpression.Index list, CExpression.Literal("{step}")
  }
  found
}

fn rootExpression(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  root: WitnessRoot,
): CExpression {
  match root {
    .Value(place, bound) => {
      const value = placeExpression emission, program, body, place
      CExpression.Member value, witnessMemberNameOf(bound)
    }
    .Table(table) => {
      if !program.hasWitnessTable(table) {
        reportUnsupported emission, "a witness table that is not in the program"
        return nullPointer
      }
      CExpression.AddressOf CExpression.Name(program.witnessTableAt(table).name)
    }
    .Parameter(_) => {
      reportUnsupported emission, "a witness table the caller passed, which the lowering never builds"
      nullPointer
    }
  }
}

// --- Intrinsics -----------------------------------------------------------------------------------------------------

fn intrinsicStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot?,
  intrinsic: Intrinsic,
  arguments: List<Slot>,
  at: LocationId,
): List<CStatement> {
  var statements: List<CStatement> = []
  if const Some(directive) = lineDirectiveOf(program, at) {
    statements.append directive
  }
  const place = match target {
    Some(slot) => Some slotExpression(body, slot)
    None => None
  }
  if const .TextConcat = intrinsic.operation {
    const concatenated = textConcatStatements emission, program, body, place, arguments
    statements.appendAll concatenated
    return statements
  }
  const printed = printSymbolOf intrinsic.operation
  if !printed.isEmpty() {
    statements.appendAll printPartsStatements(body, printed, arguments)
    return statements
  }
  // `Process.exit` of the runtime, which flushes, reports the live blocks and leaves without running anything else
  if const .ExitWithCode = intrinsic.operation {
    const code = match arguments.first() {
      Some(slot) => slotExpression body, slot
      None => CExpression.Literal "0"
    }
    const call = CExpression.Call CExpression.Name("torb_process_exit"), [code]
    statements.append CStatement.Evaluate(call)
    return statements
  }
  const expression = intrinsicExpression emission, program, body, intrinsic, arguments, at
  const found = match expression {
    Some(inner) => inner
    None => {
      return statements
    }
  }
  match place {
    Some(inner) => statements.append CStatement.Assignment(inner, found)
    None => statements.append CStatement.Evaluate(CExpression.Cast("void", found))
  }
  statements
}

/**
 * One allocation for the whole interpolation, never repeated `String.add` (BACKEND 1.6).
 *
 * Two shapes, and the difference is only which array the runtime is handed. Where every part is already a text it is
 * an array of `torb_text`, which is what a concatenation of literals and shown values is. Where one part is a
 * **primitive the runtime formats itself** (`textPartKindOf`) it is an array of `torb_text_part`: the value goes in
 * as it is, no `String` is built for it, and the whole text still costs one block (docs/PERFORMANCE.md, finding 6).
 */
fn textConcatStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  place: CExpression?,
  arguments: List<Slot>,
): List<CStatement> {
  const into = match place {
    Some(found) => found
    None => {
      return []
    }
  }
  if arguments.isEmpty() {
    const empty = CExpression.Call CExpression.Name("torb_text_empty"), []
    return [CStatement.Assignment(into, empty)]
  }
  if !isTextOnly(program, body, arguments) {
    return mixedConcatStatements emission, program, body, into, arguments
  }
  var parts: List<CExpression> = []
  for slot in arguments {
    parts.append slotExpression(body, slot)
  }
  const count = parts.length()
  const declaration = CStatement.Declaration(
    "const torb_text",
    "parts",
    Some(CExpression.Initializer(parts)),
    count,
  )
  const concatenated = CExpression.Call(CExpression.Name("torb_text_concat"), [
    CExpression.Name("parts"),
    CExpression.Literal("{count}"),
  ])
  // The array of the parts is a temporary of this one statement, so it lives in braces of its own
  [CStatement.Block([declaration, CStatement.Assignment(into, concatenated)])]
}

fn isTextOnly(program: IrProgram, body: Body, arguments: List<Slot>): Bool {
  for slot in arguments {
    if const Some(kind) = textPartKindOf(program, typeOfSlot(body, slot)) {
      if const .TextValue = kind {
        continue
      }
    }
    return false
  }
  true
}

/** The array of `torb_text_part`, one designated initializer per part, and the one call that writes them all. */
fn mixedConcatStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  into: CExpression,
  arguments: List<Slot>,
): List<CStatement> {
  var parts: List<CExpression> = []
  for slot in arguments {
    parts.append textPartExpression(emission, program, body, slot)
  }
  const count = parts.length()
  const declaration = CStatement.Declaration(
    "const torb_text_part",
    "parts",
    Some(CExpression.Initializer(parts)),
    count,
  )
  const concatenated = CExpression.Call(CExpression.Name("torb_text_concat_parts"), [
    CExpression.Name("parts"),
    CExpression.Literal("{count}"),
  ])
  [CStatement.Block([declaration, CStatement.Assignment(into, concatenated)])]
}

/**
 * `{ .kind = TORB_PART_SIGNED, .signed_value = s3 }`: the tag and the one member that holds the value.
 *
 * A designated initializer leaves every other member zeroed, which is what the runtime reads for the kinds that do
 * not use them - and it is the one form of C initializer that `-Wmissing-field-initializers` does not ask about.
 */
fn textPartExpression(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  slot: Slot,
): CExpression {
  const value = slotExpression body, slot
  const kind = match textPartKindOf(program, typeOfSlot(body, slot)) {
    Some(found) => found
    None => {
      reportUnsupported emission, "a part of a text that is neither a string nor a value the runtime shows"
      return CExpression.Designated([CDesignatedField("kind", CExpression.Name("TORB_PART_VOID"))])
    }
  }
  const (tag, member) = match kind {
    .TextValue => ("TORB_PART_TEXT", "text")
    .SignedValue => ("TORB_PART_SIGNED", "signed_value")
    .UnsignedValue => ("TORB_PART_UNSIGNED", "unsigned_value")
    .FloatingValue => ("TORB_PART_FLOATING", "floating")
    .BooleanValue => ("TORB_PART_BOOLEAN", "signed_value")
    .CharacterValue => ("TORB_PART_CHARACTER", "unsigned_value")
    .VoidPart => ("TORB_PART_VOID", "")
  }
  var fields = [CDesignatedField("kind", CExpression.Name(tag))]
  if !member.isEmpty() {
    fields.append CDesignatedField(member, value)
  }
  CExpression.Designated fields
}

/** Which function of the runtime writes the parts, or empty where the operation is not one of the two. */
fn printSymbolOf(operation: IntrinsicOperation): String {
  match operation {
    .PrintParts => "torb_print_parts"
    .PrintErrorParts => "torb_print_error_parts"
    _ => ""
  }
}

/**
 * `print a, b`: the shown parts as one array, handed to the runtime, which joins them with one space and one `\n`.
 *
 * It is the array of `textConcatStatements` and the same reason for it - the parts are a temporary of this one
 * statement - and it is what keeps the *format* of `print` in `runtime/console.c` while the lowering decides what the
 * parts are.
 */
fn printPartsStatements(body: Body, symbol: String, arguments: List<Slot>): List<CStatement> {
  if arguments.isEmpty() {
    const nothing = CExpression.Call(CExpression.Name(symbol), [
      CExpression.Name("NULL"),
      CExpression.Literal("0"),
    ])
    return [CStatement.Evaluate(nothing)]
  }
  var parts: List<CExpression> = []
  for slot in arguments {
    parts.append slotExpression(body, slot)
  }
  const count = parts.length()
  const declaration = CStatement.Declaration(
    "const torb_text",
    "parts",
    Some(CExpression.Initializer(parts)),
    count,
  )
  const written = CExpression.Call(CExpression.Name(symbol), [
    CExpression.Name("parts"),
    CExpression.Literal("{count}"),
  ])
  [CStatement.Block([declaration, CStatement.Evaluate(written)])]
}

/** The expression of one intrinsic, or `None` where it was reported as a finding instead. */
fn intrinsicExpression(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  intrinsic: Intrinsic,
  arguments: List<Slot>,
  at: LocationId,
): CExpression? {
  var operands: List<CExpression> = []
  for slot in arguments {
    operands.append slotExpression(body, slot)
  }
  const first = operands.get(0) ?? CExpression.Literal("0")
  const second = operands.get(1) ?? CExpression.Literal("0")
  const site = siteExpression program, body, at
  match intrinsic.operation {
    .BooleanNot => Some CExpression.Unary("!", first)
    .TextEqual => Some textCall("torb_text_equal", first, second)
    .TextByteLength => Some CExpression.Call(CExpression.Name("torb_text_byte_length"), [first])
    .TextConcat => None
    .TextCompare => {
      Some CExpression.Cast("int64_t", textCall("torb_text_compare", first, second))
    }
    .LazyForce => {
      reportUnsupported emission, "forcing a `lazy` value"
      None
    }
    .Convert(to) => Some CExpression.Cast(numericTypeOf(to), first)
    .Equal => comparisonExpression emission, program, body, arguments, "==", first, second
    .NotEqual => comparisonExpression emission, program, body, arguments, "!=", first, second
    .Less => comparisonExpression emission, program, body, arguments, "<", first, second
    .LessOrEqual => comparisonExpression emission, program, body, arguments, "<=", first, second
    .Greater => comparisonExpression emission, program, body, arguments, ">", first, second
    .GreaterOrEqual => comparisonExpression emission, program, body, arguments, ">=", first, second
    _ => arithmeticExpression emission, intrinsic, first, second, site
  }
}

fn textCall(symbol: String, first: CExpression, second: CExpression): CExpression {
  CExpression.Call CExpression.Name(symbol), [first, second]
}

/**
 * Arithmetic is checked unless the range analysis proved the check cannot fire: every integer operation is the `static
 * inline` helper of `torb_number.h` for its width, with the source location of the operation in it, and an operation
 * the IR marked unchecked is the plain C operator instead (`ir/ranges.trb`, docs/PERFORMANCE.md finding 8). The float
 * operations are the C operators either way, which is what IEEE-754 semantics are.
 */
fn arithmeticExpression(
  var emission: Emission,
  intrinsic: Intrinsic,
  first: CExpression,
  second: CExpression,
  site: CExpression,
): CExpression? {
  const kind = match intrinsic.kind {
    Some(found) => found
    None => {
      reportUnsupported emission, "an arithmetic intrinsic without a numeric type"
      return None
    }
  }
  if isFloatingKind(kind) {
    const suffix = suffixOfNumeric kind
    return floatingExpression emission, intrinsic.operation, first, second, suffix
  }
  if !intrinsic.isChecked {
    if const Some(found) = uncheckedExpression(intrinsic.operation, first, second) {
      return Some found
    }
  }
  if isUnsignedKind(kind) {
    if const .Negate = intrinsic.operation {
      reportUnsupported emission, "the negation of an unsigned number"
      return None
    }
  }
  const name = checkedHelperOf intrinsic.operation
  if name.isEmpty() {
    reportUnsupported emission, "an intrinsic the C back end does not emit yet"
    return None
  }
  const symbol = CExpression.Name "torb_{name}_{suffixOfNumeric(kind)}"
  var given: List<CExpression> = [first]
  if !isUnary(intrinsic.operation) {
    given.append second
  }
  if takesLocation(intrinsic.operation) {
    given.append site
  }
  Some CExpression.Call(symbol, given)
}

/**
 * The four integer operations that can overflow, as the plain C operators. `None` for every other operation, whose
 * check is about something else than the width - a division by zero above all, which no range fact here decides.
 *
 * It is only reached for an operation the IR marked unchecked, and signed overflow is undefined behaviour in C - which
 * is exactly why the analysis that marks one has to be conservative by construction.
 */
fn uncheckedExpression(
  operation: IntrinsicOperation,
  first: CExpression,
  second: CExpression,
): CExpression? {
  match operation {
    .Add => Some CExpression.Binary(first, "+", second)
    .Subtract => Some CExpression.Binary(first, "-", second)
    .Multiply => Some CExpression.Binary(first, "*", second)
    .Negate => Some CExpression.Unary("-", first)
    _ => None
  }
}

fn floatingExpression(
  var emission: Emission,
  operation: IntrinsicOperation,
  first: CExpression,
  second: CExpression,
  suffix: String,
): CExpression? {
  match operation {
    .Add => Some CExpression.Binary(first, "+", second)
    .Subtract => Some CExpression.Binary(first, "-", second)
    .Multiply => Some CExpression.Binary(first, "*", second)
    .Divide => Some CExpression.Binary(first, "/", second)
    .Negate => Some CExpression.Unary("-", first)
    // The one arithmetic operator of a float that is not a C operator. A remainder by zero answers `nan` and never
    // panics, exactly as `a / 0.0` answers an infinity - only the integers panic (BACKEND 3.3)
    .Remainder => Some CExpression.Call(CExpression.Name("torb_remainder_{suffix}"), [first, second])
    _ => {
      reportUnsupported emission, "a bit operation on a float"
      None
    }
  }
}

/** A comparison is a C operator for everything but a `String`, whose order is the runtime's byte comparison. */
fn comparisonExpression(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  arguments: List<Slot>,
  operator: String,
  first: CExpression,
  second: CExpression,
): CExpression? {
  const annotation = match arguments.first() {
    Some(slot) => typeOfSlot body, slot
    None => {
      reportUnsupported emission, "a comparison without operands"
      return None
    }
  }
  if isTextType(program, annotation) {
    if operator == "==" {
      return Some textCall("torb_text_equal", first, second)
    }
    if operator == "!=" {
      return Some CExpression.Unary("!", textCall("torb_text_equal", first, second))
    }
    const compared = textCall "torb_text_compare", first, second
    return Some CExpression.Binary(compared, operator, CExpression.Literal("0"))
  }
  if isComparableInC(program, annotation) {
    return Some CExpression.Binary(first, operator, second)
  }
  reportUnsupported emission, "a comparison of a value the C back end cannot compare directly"
  None
}

fn isObjectType(program: IrProgram, id: IrTypeId): Bool {
  if !program.hasType(id) {
    return false
  }
  match program.typeAt(id) {
    .Object(_) => true
    _ => false
  }
}

fn isTextType(program: IrProgram, id: IrTypeId): Bool {
  if !program.hasType(id) {
    return false
  }
  match program.typeAt(id) {
    .Text => true
    _ => false
  }
}

/** Numbers, `Bool`, `Char` and a pointer compare with a C operator; a record and a variant do not. */
fn isComparableInC(program: IrProgram, id: IrTypeId): Bool {
  if !program.hasType(id) {
    return false
  }
  match program.typeAt(id) {
    .Integer(_, _) => true
    .Floating(_) => true
    .Boolean => true
    .Character => true
    .VoidType => true
    .SharedObject(_) => true
    .Box(_) => true
    .Lazy(_) => true
    .Record(layout) => isBoxedLayout program, layout
    .Variant(layout) => isBoxedLayout program, layout
    .Tuple(layout) => isBoxedLayout program, layout
    _ => false
  }
}

fn isFloatingKind(kind: NumericKind): Bool {
  match kind {
    .Floating(_) => true
    _ => false
  }
}

fn isUnsignedKind(kind: NumericKind): Bool {
  match kind {
    .Unsigned(_) => true
    _ => false
  }
}

fn numericTypeOf(kind: NumericKind): String {
  match kind {
    .Signed(width) => "int{width}_t"
    .Unsigned(width) => "uint{width}_t"
    .Floating(width) => if width == 32 { "float" } else { "double" }
  }
}

/** The name of the checked helper of `torb_number.h`, without its width. Empty for an operation that has none. */
fn checkedHelperOf(operation: IntrinsicOperation): String {
  match operation {
    .Add => "add"
    .Subtract => "subtract"
    .Multiply => "multiply"
    .Divide => "divide"
    .Remainder => "remainder"
    .Negate => "negate"
    .BitwiseAnd => "bitwise_and"
    .BitwiseOr => "bitwise_or"
    .BitwiseExclusiveOr => "bitwise_exclusive_or"
    .BitwiseNot => "bitwise_not"
    .ShiftedLeft => "shifted_left"
    .ShiftedRight => "shifted_right"
    _ => ""
  }
}

fn isUnary(operation: IntrinsicOperation): Bool {
  match operation {
    .Negate => true
    .BitwiseNot => true
    _ => false
  }
}

/** Which operations can panic, and therefore carry the source location of the operation (BACKEND 3.3). */
fn takesLocation(operation: IntrinsicOperation): Bool {
  match operation {
    .BitwiseAnd => false
    .BitwiseOr => false
    .BitwiseExclusiveOr => false
    .BitwiseNot => false
    _ => true
  }
}

// --- Constructing and reading ---------------------------------------------------------------------------------------

fn constructStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  layout: LayoutId,
  variant: Int,
  fields: List<Argument>,
): List<CStatement> {
  if !program.hasLayout(layout) {
    return reported emission, "a construction of a layout that is not in the program"
  }
  const shape = program.layoutAt layout
  const place = slotExpression body, target
  var written: List<CExpression> = []
  for field in fields {
    written.append slotExpression(body, field.slot)
  }
  match shape.representation {
    .Boxed => boxedConstructStatements program, place, shape, variant, written
    .Niche(payload, _) => {
      if variant == payload {
        const value = written.get(0) ?? CExpression.Literal("0")
        return [CStatement.Assignment(place, value)]
      }
      [CStatement.Assignment(place, emptyNicheExpression(program, shape))]
    }
    .Inline => {
      const initializer = inlineInitializerOf shape, variant, written
      [CStatement.Assignment(place, CExpression.CompoundLiteral(shape.name, initializer))]
    }
  }
}

/**
 * An `Array<Item, Size>` as a compound literal of its struct: the items in order inside the braces of the one `items`
 * member, or `{ 0 }` for an array whose slots are all empty - zero bits, which hold no count.
 */
fn arrayNewStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  items: List<Argument>,
): List<CStatement> {
  const annotation = typeOfSlot body, target
  const spelling = cTypeOf program, annotation
  if spelling.isEmpty() {
    return reported emission, whyNoCType(program, annotation)
  }
  const place = slotExpression body, target
  if items.isEmpty() {
    return [CStatement.Assignment(place, CExpression.CompoundLiteral(spelling, zeroInitializer))]
  }
  var written: List<CExpression> = []
  for item in items {
    written.append slotExpression(body, item.slot)
  }
  const initializer = CExpression.Initializer([CExpression.Initializer(written)])
  [CStatement.Assignment(place, CExpression.CompoundLiteral(spelling, initializer))]
}

/**
 * The initializer of an inline value: the fields in order for a record and a tuple, and for a variant layout the
 * common fields, the tag and the group of the variant as a designated member of the union.
 */
fn inlineInitializerOf(shape: Layout, variant: Int, written: List<CExpression>): CExpression {
  if shape.variants.isEmpty() {
    return CExpression.Initializer written
  }
  CExpression.Designated variantInitializerParts(shape, variant, written)
}

/**
 * The parts of the initializer of one variant, every one of them **designated**: the common fields by name, the tag, and
 * the group of this variant inside the union.
 *
 * Designated is not a nicety. A case that carries nothing would otherwise leave the `payload` member out, which
 * `-Wmissing-field-initializers` reports, and naming it with a zero initializer runs into `-Wmissing-braces` as soon as
 * the first group holds a struct of its own. Neither warning is raised for a designated initializer, and what is left
 * out is zero initialized - which is exactly what a case without fields means.
 */
public fn variantInitializerParts(
  shape: Layout,
  variant: Int,
  written: List<CExpression>,
): List<CDesignatedField> {
  var parts: List<CDesignatedField> = []
  var index = 0
  for field in shape.commonFields() {
    const value = written.get(index) ?? CExpression.Literal("0")
    parts.append CDesignatedField(memberNameOf(field), value)
    index = index + 1
  }
  parts.append CDesignatedField("tag", CExpression.Literal("{variant}"))
  var group: List<CExpression> = []
  while index < written.length() {
    group.append written[index]
    index = index + 1
  }
  if !group.isEmpty() {
    const inner = CDesignatedField variantMemberNameOf(variant), CExpression.Initializer(group)
    parts.append CDesignatedField("payload", CExpression.Designated([inner]))
  }
  parts
}

/** A counted block of count one, then one field at a time: an aggregate initializer cannot write through a pointer. */
fn boxedConstructStatements(
  program: IrProgram,
  place: CExpression,
  shape: Layout,
  variant: Int,
  written: List<CExpression>,
): List<CStatement> {
  var statements: List<CStatement> = []
  const allocated = CExpression.Call(CExpression.Name("torb_allocate"), [
    sizeOf(shape.name),
    CExpression.Name("TORB_BLOCK_RECORD"),
  ])
  statements.append CStatement.Assignment(place, CExpression.Cast("{shape.name} *", allocated))
  var index = 0
  if shape.variants.isEmpty() {
    for field in shape.fields {
      const value = written.get(index) ?? CExpression.Literal("0")
      statements.append CStatement.Assignment(CExpression.PointerMember(place, memberNameOf(field)), value)
      index = index + 1
    }
    return statements
  }
  for field in shape.commonFields() {
    const value = written.get(index) ?? CExpression.Literal("0")
    statements.append CStatement.Assignment(CExpression.PointerMember(place, memberNameOf(field)), value)
    index = index + 1
  }
  const tag = CExpression.PointerMember place, "tag"
  statements.append CStatement.Assignment(tag, CExpression.Literal("{variant}"))
  if !shape.hasVariant(variant) {
    return statements
  }
  const group = CExpression.Member CExpression.PointerMember(place, "payload"), variantMemberNameOf(variant)
  for field in shape.fieldsOfVariant(variant) {
    const value = written.get(index) ?? CExpression.Literal("0")
    statements.append CStatement.Assignment(CExpression.Member(group, memberNameOf(field)), value)
    index = index + 1
  }
  statements
}

/** The empty variant of a niche: the null pointer, whichever of the shapes of the ABI carries it. */
public fn emptyNicheExpression(program: IrProgram, shape: Layout): CExpression {
  const payload = nichePayloadTypeOf program, shape
  if !program.hasType(payload) {
    return nullPointer
  }
  match program.typeAt(payload) {
    .Text => emptySlice "torb_text", 3
    // A closure whose code pointer is null is no closure, which is what makes `Option<() => Void>` cost nothing
    .Closure(_) => emptySlice "torb_closure", 2
    .Runtime(kind, _) => {
      match kind {
        .ListStorage => emptySlice "torb_list", 3
        .MapStorage => emptySlice "torb_map", 1
        .SetStorage => emptySlice "torb_set", 1
        _ => nullPointer
      }
    }
    _ => nullPointer
  }
}

/** `(torb_text){ NULL, 0, 0 }`: the null storage pointer, and the offset and the length that go with it. */
fn emptySlice(annotation: String, members: Int): CExpression {
  var values = [nullPointer]
  for _ in 1..members {
    values.append CExpression.Literal("0")
  }
  CExpression.CompoundLiteral annotation, CExpression.Initializer(values)
}

fn nichePayloadTypeOf(program: IrProgram, shape: Layout): IrTypeId {
  if const .Niche(_, field) = shape.representation {
    if field >= 0 && field < shape.fields.length() {
      return shape.fields[field].annotation
    }
  }
  IrTypeId(0 - 1)
}

/** The variant a value of a variant layout is: the tag member, or the null test of a niche. */
fn tagStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  target: Slot,
  source: Slot,
): List<CStatement> {
  const place = slotExpression body, target
  const name = slotExpression body, source
  const annotation = typeOfSlot body, source
  const spelling = valueTypeOf program, typeOfSlot(body, target)
  const layout = variantLayoutOf program, annotation
  const found = match layout {
    Some(inner) => inner
    None => {
      return reported emission, "the tag of a value that is not a variant"
    }
  }
  const shape = program.layoutAt found
  match shape.representation {
    .Niche(payload, _) => {
      const test = nullTestOf program, shape, name
      const empty = if payload == 0 { 1 } else { 0 }
      const question = CExpression.Conditional(
        test,
        CExpression.Literal("{payload}"),
        CExpression.Literal("{empty}"),
      )
      [CStatement.Assignment(place, CExpression.Cast(spelling, question))]
    }
    .Boxed => {
      const tag = CExpression.PointerMember name, "tag"
      [CStatement.Assignment(place, CExpression.Cast(spelling, tag))]
    }
    .Inline => {
      const tag = CExpression.Member name, "tag"
      [CStatement.Assignment(place, CExpression.Cast(spelling, tag))]
    }
  }
}

fn nullTestOf(program: IrProgram, shape: Layout, name: CExpression): CExpression {
  const payload = nichePayloadTypeOf program, shape
  if !program.hasType(payload) {
    return CExpression.Binary name, "!=", nullPointer
  }
  match program.typeAt(payload) {
    .Text => storageTestOf name
    // Every container of the ABI carries its storage in the same first member; a task and a channel are the pointer
    .Runtime(kind, _) => {
      if isIdentityKind(kind) {
        CExpression.Binary name, "!=", nullPointer
      } else {
        storageTestOf name
      }
    }
    .Closure(_) => CExpression.Binary CExpression.Member(name, codeMemberName), "!=", nullPointer
    _ => CExpression.Binary name, "!=", nullPointer
  }
}

fn storageTestOf(name: CExpression): CExpression {
  CExpression.Binary CExpression.Member(name, "storage"), "!=", nullPointer
}

fn variantLayoutOf(program: IrProgram, id: IrTypeId): LayoutId? {
  if !program.hasType(id) {
    return None
  }
  match program.typeAt(id) {
    .Variant(layout) => Some layout
    _ => None
  }
}

// --- Places ---------------------------------------------------------------------------------------------------------

/**
 * A place as a C expression: the slot, then one step per field, variant field, tuple position or dereference. A `var`
 * parameter is a `T *`, so it is dereferenced where the path starts.
 */
public fn placeExpression(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  reference: Reference,
): CExpression {
  var found = slotExpression body, reference.base
  var current = typeOfSlot body, reference.base
  for step in reference.steps {
    const isPointer = isCountedPointer program, current
    match step {
      .Field(layout, index) => {
        const member = fieldMemberOf program, layout, index
        found = memberOf found, member, isPointer
        current = fieldTypeOf program, layout, index
      }
      .TupleField(layout, index) => {
        const member = fieldMemberOf program, layout, index
        found = memberOf found, member, isPointer
        current = fieldTypeOf program, layout, index
      }
      .Variant(layout, variant, index) => {
        found = variantFieldOf program, layout, variant, index, found, isPointer
        current = variantFieldTypeOf program, layout, variant, index
      }
      .Contents(annotation) => {
        found = CExpression.Dereference found
        current = annotation
      }
      .Element(item, index, location, checked) => {
        found = elementReferenceOf emission, program, body, found, current, item, index, location, checked
        current = item
      }
    }
  }
  found
}

/**
 * One `Element` step: the writable interior pointer to an element of a contiguous list, dereferenced, so that the
 * rest of the path steps on from the element itself.
 *
 * `torb_list_element_address` makes the storage unique before it answers, which is what makes the pointer safe to
 * write through, and it panics with `index <index> is out of bounds for a length of <count>` at the site the step
 * carries - the message of the `at` of `ArrayList` it replaced (docs/PERFORMANCE.md, finding 3).
 *
 * # Pitfalls
 *
 * The expression holds a **call**, and a statement that names the same place twice - a write that releases what was
 * there first, a `MakeUnique` of a boxed payload - calls it twice. Both calls answer the same pointer, because the
 * first one already left the storage unique, so it is a cost and never a difference.
 */
fn elementReferenceOf(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  container: CExpression,
  annotation: IrTypeId,
  item: IrTypeId,
  index: Slot,
  location: LocationId,
  checked: Bool,
): CExpression {
  // An array holds its items inline, so the element is a slot of its struct: no call, no uniqueness to arrange - only
  // the bounds, which `torb_array_index` checks against the size the type says, unless `ir/ranges.trb` proved them
  if const .FixedArray(_, size) = program.typeAt(annotation) {
    if !checked {
      return CExpression.Index CExpression.Member(container, arrayItemsMember), slotExpression(body, index)
    }
    const checked = CExpression.Call(CExpression.Name("torb_array_element_index"), [
      slotExpression(body, index),
      CExpression.Literal("{size}"),
      siteExpression(program, body, location),
    ])
    return CExpression.Index CExpression.Member(container, arrayItemsMember), checked
  }
  if !isListStorage(program, annotation) {
    reportUnsupported emission, "an element of a value that is no list as a place"
    return container
  }
  const spelling = valueTypeOf program, item
  // An unchecked step into a list is a read whose index `ir/bounds.trb` proved inside: no comparison, and no copy of a
  // storage somebody else holds, because nothing is written through it
  if !checked {
    const read = CExpression.Call CExpression.Name("torb_list_item"), [container, slotExpression(body, index)]
    return CExpression.Dereference CExpression.Cast(pointerTo(spelling), read)
  }
  const found = CExpression.Call(CExpression.Name("torb_list_element_address"), [
    CExpression.AddressOf(container),
    slotExpression(body, index),
    siteExpression(program, body, location),
  ])
  CExpression.Dereference CExpression.Cast("{spelling} *", found)
}

/** Whether a type is the runtime's contiguous list, which is the one container an `Element` step steps into. */
fn isListStorage(program: IrProgram, annotation: IrTypeId): Bool {
  if !program.hasType(annotation) {
    return false
  }
  if const .Runtime(kind, _) = program.typeAt(annotation) {
    return kind == RuntimeKind.ListStorage
  }
  false
}

/** `->` where the value is the pointer to its counted block, `.` where the value is the block. */
fn memberOf(value: CExpression, member: String, isPointer: Bool): CExpression {
  if isPointer {
    return CExpression.PointerMember value, member
  }
  CExpression.Member value, member
}

/** The type a place ends in, which is what decides how it is made unique and how it is released. */
public fn placeTypeOf(program: IrProgram, body: Body, reference: Reference): IrTypeId {
  var current = typeOfSlot body, reference.base
  for step in reference.steps {
    match step {
      .Field(layout, index) => {
        current = fieldTypeOf program, layout, index
      }
      .TupleField(layout, index) => {
        current = fieldTypeOf program, layout, index
      }
      .Variant(layout, variant, index) => {
        current = variantFieldTypeOf program, layout, variant, index
      }
      .Contents(annotation) => {
        current = annotation
      }
      .Element(item, _, _, _) => {
        current = item
      }
    }
  }
  current
}

/** A niche layout *is* its payload, so a step into the one field of the payload variant changes nothing. */
fn variantFieldOf(
  program: IrProgram,
  layout: LayoutId,
  variant: Int,
  index: Int,
  value: CExpression,
  isPointer: Bool,
): CExpression {
  if !program.hasLayout(layout) {
    return value
  }
  const shape = program.layoutAt layout
  if const .Niche(_, _) = shape.representation {
    return value
  }
  const fields = shape.fieldsOfVariant variant
  if index < 0 || index >= fields.length() {
    return value
  }
  const payload = memberOf value, "payload", isPointer
  const group = CExpression.Member payload, variantMemberNameOf(variant)
  CExpression.Member group, memberNameOf(fields[index])
}

fn fieldMemberOf(program: IrProgram, layout: LayoutId, index: Int): String {
  if !program.hasLayout(layout) {
    return "f_unknown"
  }
  const shape = program.layoutAt layout
  if index < 0 || index >= shape.fields.length() {
    return "f_unknown"
  }
  memberNameOf shape.fields[index]
}

fn fieldTypeOf(program: IrProgram, layout: LayoutId, index: Int): IrTypeId {
  if !program.hasLayout(layout) {
    return IrTypeId(0 - 1)
  }
  const shape = program.layoutAt layout
  if index < 0 || index >= shape.fields.length() {
    return IrTypeId(0 - 1)
  }
  shape.fields[index].annotation
}

fn variantFieldTypeOf(program: IrProgram, layout: LayoutId, variant: Int, index: Int): IrTypeId {
  if !program.hasLayout(layout) {
    return IrTypeId(0 - 1)
  }
  const shape = program.layoutAt layout
  if !shape.hasVariant(variant) {
    return IrTypeId(0 - 1)
  }
  const fields = shape.fieldsOfVariant variant
  if index < 0 || index >= fields.length() {
    return IrTypeId(0 - 1)
  }
  fields[index].annotation
}

// --- Terminators ----------------------------------------------------------------------------------------------------

fn terminatorStatements(
  var emission: Emission,
  program: IrProgram,
  body: Body,
  terminator: Terminator,
): List<CStatement> {
  match terminator {
    .Jump(target) => [CStatement.Goto("L{target.value}")]
    .Branch(condition, then, otherwise) => {
      const name = slotExpression body, condition
      [
        CStatement.If(name, [CStatement.Goto("L{then.value}")]),
        CStatement.Goto("L{otherwise.value}"),
      ]
    }
    .Switch(scrutinee, values, targets, otherwise) => {
      const name = slotExpression body, scrutinee
      var cases: List<CSwitchCase> = []
      const count = values.length().min(targets.length())
      for index in 0..count {
        cases.append CSwitchCase(values[index], [CStatement.Goto("L{targets[index].value}")])
      }
      [CStatement.Switch(name, cases, [CStatement.Goto("L{otherwise.value}")])]
    }
    .Return(value) => {
      if body.machine.isSome() {
        return finishedStatements program, body, value
      }
      returnStatements program, body, value
    }
    .Unreachable => [CStatement.Evaluate(CExpression.Call(CExpression.Name("TORB_UNREACHABLE"), []))]
    .Stop => {
      if body.machine.isNone() {
        return reported emission, "a stop outside the body of a task"
      }
      [CStatement.Return(Some(CExpression.Name("TORB_POLL_STOPPED")))]
    }
  }
}

fn returnStatements(program: IrProgram, body: Body, value: Argument?): List<CStatement> {
  const isVoid = isVoidResult program, body.function.signature.result
  const found = match value {
    Some(argument) => argument
    None => {
      return [CStatement.Return()]
    }
  }
  if isVoid {
    return [CStatement.Return()]
  }
  const name = slotExpression body, found.slot
  if body.isByPointer {
    const into = CExpression.Dereference CExpression.Name(resultPointerName)
    return [CStatement.Assignment(into, name), CStatement.Return()]
  }
  [CStatement.Return(Some(name))]
}

// --- Slots ----------------------------------------------------------------------------------------------------------

/**
 * A slot as an expression. A `var` parameter holds a pointer, so reading it goes through one dereference; a slot of a
 * task's frame is a member of the frame.
 */
public fn slotExpression(body: Body, slot: Slot): CExpression {
  if isFrameSlot(body, slot) {
    return CExpression.PointerMember CExpression.Name(frameName), slotNameOf(body.function, slot)
  }
  const name = CExpression.Name slotNameOf(body.function, slot)
  if isReferenceSlot(body, slot) {
    return CExpression.Dereference name
  }
  name
}

fn isFrameSlot(body: Body, slot: Slot): Bool {
  match body.machine {
    Some(machine) => machine.isFrameSlot slot
    None => false
  }
}

fn isReferenceSlot(body: Body, slot: Slot): Bool {
  if !body.function.hasSlot(slot) {
    return false
  }
  if const .Parameter(index) = body.function.slots[slot.value].role {
    if const Some(parameter) = body.function.signature.parameters.get(index) {
      return parameter.isReference
    }
  }
  false
}

fn typeOfSlot(body: Body, slot: Slot): IrTypeId {
  if !body.function.hasSlot(slot) {
    return IrTypeId(0 - 1)
  }
  body.function.typeOfSlot slot
}
