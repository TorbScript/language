/**
 * Whether a value may cross to another worker of the pool: the test the C back end writes beside the start of a task
 * and beside the environment of a closure (docs/design/CONCURRENCY.md section 16, "What crosses a worker").
 *
 * Counts are plain integers, so a value may be handed to another thread only where no count it reaches can ever be
 * touched by two threads: nothing counted inside it, an immortal block, a shared block (a `Task` or `Channel` of plain
 * data, a closure whose environment is shared) - or, for the frame of a task, which runs once and on one thread, a block
 * that only this value holds and whose elements are plain. The type answers most of it; what it cannot answer is a test
 * of the runtime (`torb_text_may_move`, `torb_list_may_move`, `torb_map_may_move`, `torb_closure_may_move`) on the
 * value itself. A type none of that covers never crosses, and the task that holds one stays on its worker.
 *
 * Where the test fails on a value that may be **copied** soundly - a `String` somebody else holds too, a list of
 * `String`s, a record of those - the frame of a task is made private instead while the pool has more than one worker:
 * each such value is replaced by an equal one that shares no counted block with anything else, on the thread that
 * starts the task, before anybody else can see the frame ([privateOf], docs/design/CONCURRENCY.md section 16, "The
 * copy at the crossing"). What has an identity - a shared object, a task or a channel of counted items, a captured
 * `var`, a trait-typed value whose payload nothing here can walk - is never copied, and neither is a value whose type
 * implements `Close`, which a copy would close twice.
 *
 * # Related
 *
 * - [crossingOf] - the test of one value.
 * - [frameCrossingOf] - the test of every argument of a `TaskNew`, which picks the start that lets a task move.
 * - [framePrivateOf] - the copy that makes a frame movable where the test cannot.
 */

use IrProgram, IrTypeId, LayoutId, RuntimeKind from "../../ir/ir"
use Layout, containsCountedType from "../../ir/layout"
use memberNameOf, variantMemberNameOf from "./type"
use CExpression from "./writer"
use countedFormOf, inlineCountedLayoutOf, environmentMemberName from "./body"

/** What the test of one value comes to: it always crosses, it never does, or the runtime decides with an expression. */
public type Crossing {
  case Always
  case Never
  case When(test: CExpression)
}

/**
 * Whether the value of type `id` in `place` may cross to another worker. With `isTransfer` the value is given up by the
 * thread that hands it over - the frame of a task that has not run - so a block only it holds moves along; without it
 * (the captures of a closure, which may run on several workers at once) only what nobody counts may cross.
 */
public fn crossingOf(program: IrProgram, id: IrTypeId, place: CExpression, isTransfer: Bool): Crossing {
  if !containsCountedType(program, id) {
    return Crossing.Always
  }
  const inner = countedFormOf program, id
  if inner != id {
    return crossingOf program, inner, place, isTransfer
  }
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    // A variant crosses where the fields of the case it is say so: the test switches on its tag
    const shape = program.layoutAt layout
    return layoutCrossingOf(
      shape,
      { CExpression.Member place, _ },
      { annotation, reached => crossingOf program, annotation, reached, isTransfer },
    )
  }
  const transfer = CExpression.Literal(if isTransfer { "true" } else { "false" })
  match program.typeAt(inner) {
    .Text => Crossing.When CExpression.Call(CExpression.Name("torb_text_may_move"), [place, transfer])
    .Closure(_) => {
      const environment = CExpression.Member place, environmentMemberName
      Crossing.When CExpression.Call(CExpression.Name("torb_closure_may_move"), [environment])
    }
    .Runtime(kind, arguments) => runtimeCrossingOf program, kind, arguments, place, transfer
    _ => Crossing.Never
  }
}

/** A container is tested by the runtime; a task and a channel are shared blocks that carry only plain data across. */
fn runtimeCrossingOf(
  program: IrProgram,
  kind: RuntimeKind,
  arguments: List<IrTypeId>,
  place: CExpression,
  transfer: CExpression,
): Crossing {
  match kind {
    .ListStorage => Crossing.When CExpression.Call(CExpression.Name("torb_list_may_move"), [place, transfer])
    .MapStorage => Crossing.When CExpression.Call(CExpression.Name("torb_map_may_move"), [place, transfer])
    .SetStorage => Crossing.When CExpression.Call(CExpression.Name("torb_map_may_move"), [place, transfer])
    .TaskObject => plainArgumentsCrossing program, arguments
    .ChannelObject => plainArgumentsCrossing program, arguments
    _ => Crossing.Never
  }
}

/** A handle of a shared block crosses where what it hands out is plain, so no two workers hold one counted value. */
fn plainArgumentsCrossing(program: IrProgram, arguments: List<IrTypeId>): Crossing {
  for argument in arguments {
    if containsCountedType(program, argument) {
      return Crossing.Never
    }
  }
  Crossing.Always
}

/** Both tests: `Never` wins, `Always` changes nothing, two expressions are joined with `&&`. */
fn bothOf(first: Crossing, second: Crossing): Crossing {
  match first {
    .Never => Crossing.Never
    .Always => second
    .When(left) => {
      match second {
        .Never => Crossing.Never
        .Always => first
        .When(right) => Crossing.When CExpression.Binary(left, "&&", right)
      }
    }
  }
}

/**
 * The test of a whole frame: every argument a `TaskNew` moves into it, each read back out of its member. `Always` and
 * `Never` are decided here; `When` is written beside the start.
 */
public fn frameCrossingOf(program: IrProgram, members: List<CExpression>, types: List<IrTypeId>): Crossing {
  combinedCrossingOf program, members, types, isTransfer: true
}

/**
 * The test of the captures of a closure's environment: where all of them may cross without a transfer, the environment
 * is shared (`torb_share`), so the closure may run on several workers at once.
 */
public fn environmentCrossingOf(program: IrProgram, members: List<CExpression>, types: List<IrTypeId>): Crossing {
  combinedCrossingOf program, members, types, isTransfer: false
}

fn combinedCrossingOf(
  program: IrProgram,
  members: List<CExpression>,
  types: List<IrTypeId>,
  isTransfer: Bool,
): Crossing {
  var combined = Crossing.Always
  for index in 0..members.length() {
    combined = bothOf combined, crossingOf(program, types[index], members[index], isTransfer)
  }
  combined
}

/**
 * The copy that makes the value of type `id` in `place` private, for the frame of a task that has not run: `Always`
 * where nothing needs copying (nothing counted inside), `Never` where it cannot be copied soundly, and otherwise the
 * calls of the runtime that copy what somebody else holds too, in place, joined with `&&` - each answers whether its
 * value could be made private, and a `false` pins the task.
 */
public fn privateOf(program: IrProgram, id: IrTypeId, place: CExpression): Crossing {
  if !containsCountedType(program, id) {
    return Crossing.Always
  }
  const inner = countedFormOf program, id
  if inner != id {
    return privateOf program, inner, place
  }
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    // A type with `close()` is a resource a copy would close twice; a variant is copied by the case it is
    if program.closeFunctions.containsKey(layout.value) {
      return Crossing.Never
    }
    const shape = program.layoutAt layout
    return layoutCrossingOf(
      shape,
      { CExpression.Member place, _ },
      { annotation, reached => privateOf program, annotation, reached },
    )
  }
  match program.typeAt(inner) {
    .Text => Crossing.When CExpression.Call(CExpression.Name("torb_text_privatize"), [CExpression.AddressOf(place)])
    // An environment somebody else holds too is copied by the copy its closure put into it (`environmentCopyOf`)
    .Closure(_) => {
      const environment = CExpression.AddressOf CExpression.Member(place, environmentMemberName)
      Crossing.When CExpression.Call(CExpression.Name("torb_closure_privatize"), [environment])
    }
    .Runtime(kind, arguments) => runtimePrivateOf program, kind, arguments, place
    _ => Crossing.Never
  }
}

/** A container is copied by the runtime, with what makes one element private; a task and a channel never are. */
fn runtimePrivateOf(program: IrProgram, kind: RuntimeKind, arguments: List<IrTypeId>, place: CExpression): Crossing {
  const address = CExpression.AddressOf place
  match kind {
    .ListStorage => {
      match elementPrivateOf(program, arguments, 0) {
        Some(element) => Crossing.When CExpression.Call(CExpression.Name("torb_list_privatize"), [address, element])
        None => Crossing.Never
      }
    }
    .MapStorage => {
      const key = match elementPrivateOf(program, arguments, 0) {
        Some(found) => found
        None => {
          return Crossing.Never
        }
      }
      const value = match elementPrivateOf(program, arguments, 1) {
        Some(found) => found
        None => {
          return Crossing.Never
        }
      }
      Crossing.When CExpression.Call(CExpression.Name("torb_map_privatize"), [address, key, value])
    }
    .SetStorage => {
      match elementPrivateOf(program, arguments, 0) {
        Some(item) => Crossing.When(CExpression.Call(
          CExpression.Name("torb_map_privatize"),
          [address, item, noFunction],
        ))
        None => Crossing.Never
      }
    }
    .TaskObject => plainArgumentsCrossing program, arguments
    .ChannelObject => plainArgumentsCrossing program, arguments
    _ => Crossing.Never
  }
}

/** The function of a plain side of a container: there is nothing in it to copy. */
const noFunction = CExpression.Literal "NULL"

/**
 * What makes one element of a container private, through a `void *`: `NULL` for a plain element, the runtime's own
 * function for a `String`, the `P_<layout>` the emitter writes for a record or a tuple that may be copied
 * ([privateHelperOf]), and `None` for anything else, which leaves the container - and its task - where it is.
 */
fn elementPrivateOf(program: IrProgram, arguments: List<IrTypeId>, index: Int): CExpression? {
  if index >= arguments.length() {
    return None
  }
  const element = arguments[index]
  if !containsCountedType(program, element) {
    return noFunction
  }
  const inner = countedFormOf program, element
  if const .Text = program.typeAt(inner) {
    return CExpression.Name "torb_text_privatize_place"
  }
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    var visiting: List<Int> = []
    if !isCopyableLayout(program, layout, visiting, withoutShared: false) {
      return None
    }
    return CExpression.Name privateHelperNameOf(program, layout)
  }
  None
}

/**
 * Whether the value an entry cell of type `id` holds is an **immortal copy** of the value written into it
 * (docs/BACKEND.md, "The entry cell"): a function of the entry file reads the cell on whatever worker runs it, so no
 * count the cell's value reaches may be one that two workers change. That is so for a value [privateOf] copies whole -
 * texts, lists, maps and sets, and records, tuples and variants of those - which the cell's write copies inside an
 * immortal region, and whose blocks nobody retains or releases from then on. A closure, a task and a channel are left
 * out although the crossing copy takes them: an immortal copy would hold the count of their shared block forever.
 *
 * A cell of any other counted type - a shared object, a trait-typed value, a resource with `close()` - keeps the value
 * it is given, and a program that has one keeps every task on the worker that starts it (`torb_tasks_confine`).
 */
public fn entryCellCopies(program: IrProgram, id: IrTypeId): Bool {
  var visiting: List<Int> = []
  containsCountedType(program, id) && isCopyable(program, id, visiting, withoutShared: true)
}

/**
 * Whether [privateHelperOf] of a layout is anything but `Never`, answered without building it: a layout that holds a
 * list of itself asks about itself, and `visiting` is what ends that - a layout already being asked about is taken to
 * be copyable, because whatever else it holds is asked about on the way. With `withoutShared`, a closure, a task or a
 * channel anywhere inside answers no ([entryCellCopies]).
 */
fn isCopyableLayout(program: IrProgram, layout: LayoutId, var visiting: List<Int>, withoutShared: Bool): Bool {
  if visiting.contains(layout.value) {
    return true
  }
  const shape = program.layoutAt layout
  if program.closeFunctions.containsKey(layout.value) {
    return false
  }
  visiting.append layout.value
  for field in shape.fields {
    if !isCopyable(program, field.type, visiting, withoutShared) {
      return false
    }
  }
  true
}

/** The same question of one type, in the words of [privateOf]. */
fn isCopyable(program: IrProgram, id: IrTypeId, var visiting: List<Int>, withoutShared: Bool): Bool {
  if !containsCountedType(program, id) {
    return true
  }
  const inner = countedFormOf program, id
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    return isCopyableLayout program, layout, visiting, withoutShared
  }
  match program.typeAt(inner) {
    .Text => true
    .Closure(_) => !withoutShared
    .Runtime(kind, arguments) => {
      match kind {
        .ListStorage => isCopyableElement program, arguments, 0, visiting, withoutShared
        .SetStorage => isCopyableElement program, arguments, 0, visiting, withoutShared
        .MapStorage => isCopyableElement(program, arguments, 0, visiting, withoutShared)
          && isCopyableElement(program, arguments, 1, visiting, withoutShared)
        .TaskObject => !withoutShared && !arguments.any({ containsCountedType program, _ })
        .ChannelObject => !withoutShared && !arguments.any({ containsCountedType program, _ })
        _ => false
      }
    }
    _ => false
  }
}

/** An element [elementPrivateOf] has a function for. */
fn isCopyableElement(
  program: IrProgram,
  arguments: List<IrTypeId>,
  index: Int,
  var visiting: List<Int>,
  withoutShared: Bool,
): Bool {
  if index >= arguments.length() {
    return false
  }
  const element = arguments[index]
  if !containsCountedType(program, element) {
    return true
  }
  const inner = countedFormOf program, element
  if const .Text = program.typeAt(inner) {
    return true
  }
  if const Some(layout) = inlineCountedLayoutOf(program, inner) {
    return isCopyableLayout program, layout, visiting, withoutShared
  }
  false
}

/** The name of the copy of an environment at the crossing of a worker (`torb_environment.privatize`). */
public fn environmentCopyNameOf(program: IrProgram, layout: LayoutId): String {
  "PE_{program.layoutAt(layout).name}"
}

/**
 * What the copy of an environment makes private once it has an environment of its own: every capture of `*value`, in
 * place. `Never` where one cannot be copied soundly - a captured `var` is a box with an identity, a shared object has
 * one - and then the closure gets no copy and crosses only where its environment is shared, as before. `Never` as
 * well where no capture holds a count: such an environment is shared from its birth and never needs a copy.
 */
public fn environmentCopyOf(program: IrProgram, layout: LayoutId): Crossing {
  const shape = program.layoutAt layout
  if !shape.fields.any({ containsCountedType program, _.type }) {
    return Crossing.Never
  }
  const value = CExpression.Name "value"
  var combined = Crossing.Always
  for field in shape.fields {
    combined = bothOf combined, privateOf(program, field.type, CExpression.PointerMember(value, memberNameOf(field)))
  }
  combined
}

/** The name of the function that makes one value of an inline layout private through a `void *`. */
public fn privateHelperNameOf(program: IrProgram, layout: LayoutId): String {
  "P_{program.layoutAt(layout).name}"
}

/**
 * What the body of `P_<layout>` answers: the copy of every field of `*value`, where `value` is the `void *` the
 * function was handed, cast to the layout.
 */
public fn privateHelperOf(program: IrProgram, layout: LayoutId): Crossing {
  if program.closeFunctions.containsKey(layout.value) {
    return Crossing.Never
  }
  const shape = program.layoutAt layout
  const value = CExpression.Name "value"
  layoutCrossingOf(
    shape,
    { CExpression.PointerMember value, _ },
    { annotation, reached => privateOf program, annotation, reached },
  )
}

/**
 * The test or the copy of an inline layout, `field` of every field that holds a count: of a record or a tuple all of
 * them, of a variant the common fields and the fields of the case the value is, chosen by its tag -
 * `tag == 0 ? <case 0> : tag == 2 ? <case 2> : true`, where a case whose fields hold nothing counted needs no arm and
 * one that never crosses is `false`. `member` reaches a member of the value, `value.x` or `value->x`.
 */
fn layoutCrossingOf(
  shape: Layout,
  member: (String) => CExpression,
  field: (IrTypeId, CExpression) => Crossing,
): Crossing {
  if shape.variants.isEmpty() {
    var combined = Crossing.Always
    for each in shape.fields {
      combined = bothOf combined, field(each.type, member(memberNameOf(each)))
    }
    return combined
  }
  var combined = Crossing.Always
  for each in shape.commonFields() {
    combined = bothOf combined, field(each.type, member(memberNameOf(each)))
  }
  var arms: List<(Int, CExpression)> = []
  for variant in 0..shape.variants.length() {
    const group = CExpression.Member member("payload"), variantMemberNameOf(variant)
    var chosen = Crossing.Always
    for each in shape.fieldsOfVariant(variant) {
      chosen = bothOf chosen, field(each.type, CExpression.Member(group, memberNameOf(each)))
    }
    match chosen {
      .Always => {}
      .Never => arms.append((variant, CExpression.Literal("false")))
      .When(test) => arms.append((variant, test))
    }
  }
  if arms.isEmpty() {
    return combined
  }
  var switched = CExpression.Literal "true"
  var index = arms.length() - 1
  while index >= 0 {
    const (variant, test) = arms[index]
    const isCase = CExpression.Binary member("tag"), "==", CExpression.Literal("{variant}u")
    switched = CExpression.Conditional isCase, test, switched
    index = index - 1
  }
  bothOf combined, Crossing.When(switched)
}

/**
 * The `P_<layout>` functions an expression the emitter wrote names, by their names: what the emitter has to define
 * before the functions that start tasks.
 */
public fn privateHelpersNamedIn(expression: CExpression, var names: List<String>) {
  match expression {
    .Name(name) => {
      if name.startsWith("P_") && !names.contains(name) {
        names.append name
      }
    }
    .Call(callee, arguments) => {
      privateHelpersNamedIn callee, names
      for argument in arguments {
        privateHelpersNamedIn argument, names
      }
    }
    .Binary(left, _, right) => {
      privateHelpersNamedIn left, names
      privateHelpersNamedIn right, names
    }
    .Conditional(condition, then, otherwise) => {
      privateHelpersNamedIn condition, names
      privateHelpersNamedIn then, names
      privateHelpersNamedIn otherwise, names
    }
    _ => {}
  }
}

/**
 * The copy of a whole frame: every argument a `TaskNew` moves into it, each made private in its member. `Never` where
 * one of them cannot be copied soundly.
 */
public fn framePrivateOf(program: IrProgram, members: List<CExpression>, types: List<IrTypeId>): Crossing {
  var combined = Crossing.Always
  for index in 0..members.length() {
    combined = bothOf combined, privateOf(program, types[index], members[index])
  }
  combined
}
