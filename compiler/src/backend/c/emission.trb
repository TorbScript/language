/**
 * What the C emitter writes into ([Emission]), and the small vocabulary every part of it shares: the C name of a
 * [Slot], the [locationExpression] a checked operation carries, and the `#line` that points a debugger at the source.
 *
 * [write] is the only way a declaration reaches the output, which is what keeps the blank lines of the file out of
 * every part of the emitter that builds one; [reportUnsupported] is the matching way a part of it says it cannot.
 *
 * # Related
 *
 * - [CDeclaration] - what a declaration written here is built out of.
 */

use IrProgram, IrFunction, Slot, LocationId, Location from "../../ir/ir"
use escapedComponent from "../../ir/mangle"
use unsupportedMessage from "../../ir/unsupported"
use CExpression, CStatement, CDeclaration from "./writer"
use declarationLines, needsBlankLine, cStringOf, declarationOf from "./writer"

/**
 * The translation unit as it is written so far, and every construct found on the way that the C back end cannot emit
 * yet.
 *
 * A finding is **not** an internal error: it is a construct of the program the C back end does not support yet,
 * counted and named the same way `torb ir` counts what the lowering does not lower yet. `torb build` refuses a
 * program that has any, so no C that cannot compile is ever written.
 */
public type Emission {
  var lines: List<String> = []
  /**
   * One entry per declaration written, in order: which of the lines it is and where it goes when the program is split
   * into several translation units (`units.trb`). The one-unit text of [emittedText] never reads it.
   */
  var pieces: List<Piece> = []
  /** Deduplicated, in the order they were found: the walk is deterministic, so this list is too. */
  var unsupported: List<String> = []
  var unsupportedIndex: Map<String, Bool> = [:]
}

/**
 * Where a declaration goes when the program is split into several translation units (docs/BACKEND.md 4.1): the header
 * every unit includes, one of the units, or the unit that holds the data.
 *
 * The emitter writes one translation unit whatever the size of the program, with `static` on everything nothing
 * outside it names. That is what lets `units.trb` cut the very same lines into a header and several units afterwards,
 * dropping the `static` of whatever another unit names.
 */
public type Placement {
  /** A type, a typedef, a prototype, a section comment, the fixed head: in the header, as it is written. */
  case Shared
  /** A function: its definition in exactly one unit, its prototype in the header. */
  case Code
  /** Static data that code names: defined in the data unit, declared `extern` in the header. */
  case Data
  /** Static data that only other static data names - the storage of a string literal, the arrays of a witness table. */
  case LocalData
}

/** The lines one declaration was written as, and where they go in a split program. */
public type Piece {
  placement: Placement
  /** The index of its first line in [Emission.lines], after the blank line in front of it. */
  first: Int
  count: Int
  /**
   * Which of its lines carries the storage class: the head of a definition comes after its comment. -1 for a fixed
   * block, which has none.
   */
  headOffset: Int = 0
  /** For [Placement.Data]: the `extern` declaration the header gets. */
  declaration: String = ""
}

/**
 * One declaration of the translation unit, with the blank line in front of it that `writer.trb` says it needs. **This
 * is the only way anything reaches the output**, which is what keeps the paragraphs of the file out of every part of
 * the emitter that builds one.
 */
public fn write(var emission: Emission, declaration: CDeclaration) {
  writePlaced emission, declaration, placementOf(declaration)
}

/**
 * [write], for the few declarations whose place in a split program is not the one their kind implies: `main`, which is
 * a fixed block and still code, and the static data that only other static data names.
 */
public fn writePlaced(var emission: Emission, declaration: CDeclaration, placement: Placement) {
  if needsBlankLine(declaration) && !emission.lines.isEmpty() {
    emission.lines.append ""
  }
  const lines = declarationLines declaration
  const first = emission.lines.length()
  emission.lines.appendAll lines
  const headOffset = match declaration {
    .Definition(comment, _, _) => if comment.isEmpty() { 0 } else { 1 }
    // `main`: nothing names it, so it needs no prototype, and it has no storage class to drop
    .Fixed(_) => -1
    _ => 0
  }
  const external = match placement {
    .Data => externDeclarationOf declaration
    _ => ""
  }
  emission.pieces.append Piece(placement, first, lines.length(), headOffset, external)
}

/** Where a declaration of this kind goes: a definition is code, static data is data, everything else is shared. */
fn placementOf(declaration: CDeclaration): Placement {
  match declaration {
    .Definition(_, _, _) => Placement.Code
    .StaticData(_, _, _, _) => Placement.Data
    .Variable(_, _) => Placement.Data
    _ => Placement.Shared
  }
}

/** `extern const int64_t s_x;`: what the header says about a datum the data unit defines. */
fn externDeclarationOf(declaration: CDeclaration): String {
  match declaration {
    .StaticData(annotation, name, _, _) => "{declarationOf("extern {withoutStorageClass(annotation)}", name)};"
    .Variable(annotation, name) => "{declarationOf("extern {withoutStorageClass(annotation)}", name)};"
    _ => ""
  }
}

/**
 * A line or a type spelling without the `static` in front of it: how a declaration that another unit names is written
 * in a split program, where it needs external linkage.
 */
public fn withoutStorageClass(text: String): String {
  text.withoutPrefix("static ") ?? text
}

/**
 * One construct the C back end does not emit yet. The same construct is recorded once however often it occurs, because
 * one root cause gets one message - the rule the diagnostics follow everywhere.
 *
 * `what` names the construct as a noun phrase and never a plan number: the sentence a user reads is
 * [unsupportedMessage]'s, which is the very one the lowering's own findings go through.
 */
public fn reportUnsupported(var emission: Emission, what: String, because: String = "") {
  const message = unsupportedMessage what, because
  if emission.unsupportedIndex.containsKey(message) {
    return
  }
  emission.unsupportedIndex.set message, true
  emission.unsupported.append message
}

/** The finished translation unit, one line per entry of [Emission.lines]. */
public fn emittedText(emission: Emission): String {
  // Always `\n`, on every platform: the fixpoint test (BACKEND 3.6, "What 6.2 decided") compares two files byte for byte
  emission.lines.joined(separator: "\n") + "\n"
}

// --- The spellings every part of the emitter needs -------------------------------------------------------------------

/**
 * The C variable of a slot: its number, and the name the source gave it where there is one, so that the generated C
 * reads like the program it came from. The number comes first, so two bindings of the same name are two variables.
 */
public fn slotNameOf(function: IrFunction, slot: Slot): String {
  if !function.hasSlot(slot) {
    return "s_unknown{slot.value}"
  }
  const declared = function.slots[slot.value]
  if declared.name.isEmpty() {
    return "s{slot.value}"
  }
  "s{slot.value}_{escapedComponent(declared.name)}"
}

/**
 * `TORB_LOCATION("src/main.trb", 12, 5)`: what every checked operation and every panic carries. The path is the one
 * the lowering interned - relative to the workspace root, with forward slashes - so no path of a machine can reach the
 * output.
 */
public fn locationExpression(program: IrProgram, at: LocationId): CExpression {
  if !program.hasLocation(at) {
    return CExpression.Name "torb_location_unknown"
  }
  const location = program.locationAt at
  CExpression.Call(CExpression.Name("TORB_LOCATION"), [
    CExpression.Literal(cStringOf(location.path)),
    CExpression.Literal("{location.line}"),
    CExpression.Literal("{location.column}"),
  ])
}

/**
 * `#line 12 "src/main.trb"`: what makes a C compiler error and a debugger point into the TorbScript source. `None`
 * where the instruction carries no location, because a wrong line is worse than none.
 */
public fn lineDirectiveOf(program: IrProgram, at: LocationId): CStatement? {
  if !program.hasLocation(at) {
    return None
  }
  const location = program.locationAt at
  CStatement.LineDirective location.line, location.path
}
