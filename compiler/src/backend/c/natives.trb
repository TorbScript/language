/** `runtime/os/posix.c`, `native type Posix`: Linux, macOS and FreeBSD. */
fn posixEntries(var entries: List<NativeEntry>) {
  const posix: List<TargetSystem> = [.Linux, .MacOs, .FreeBsd]
  entries.append(systemRuntimeOf(
    "Posix.effectiveUserIdentifier",
    "torb_os_posix_effective_user_identifier",
    "int64_t torb_os_posix_effective_user_identifier(void);",
    posix,
  ))
  entries.append(systemRuntimeOf(
    "Posix.systemNames",
    "torb_os_posix_system_names",
    "int64_t torb_os_posix_system_names(torb_text *system, torb_text *node, torb_text *release, torb_text *version, torb_text *machine, torb_text *failure);",
    posix,
  ))
  entries.append(systemRuntimeOf(
    "Posix.hostName",
    "torb_os_posix_host_name",
    "int64_t torb_os_posix_host_name(torb_text *name, torb_text *failure);",
    posix,
  ))
  entries.append(systemRuntimeOf(
    "Posix.configuration",
    "torb_os_posix_configuration",
    "int64_t torb_os_posix_configuration(torb_text name);",
    posix,
  ))
  entries.append(systemRuntimeOf(
    "Posix.account",
    "torb_os_posix_account",
    "int64_t torb_os_posix_account(int64_t *identifier, torb_text *name, torb_text *full_name, torb_text *home, torb_text *failure);",
    posix,
  ))
}

fn plannedPackageEntries(var entries: List<NativeEntry>) {
  entries.append plannedRuntimeOf("Expression.value", "torb_expression_value", "5.11")
  entries.append plannedRuntimeOf("Expression.captures", "torb_expression_captures", "5.11")

  // `isSame` compares the identity of a `shared` object, which the checker allows nowhere else.
  entries.append plannedIntrinsicOf("isSame", IntrinsicOperation.Equal, "5.9")

  // `std/sandbox` (docs/design/SCRIPTS.md): `Sandbox.load`, `Script.apply` and `SandboxCapabilities` are TorbScript over
  // the table of the program's scripts and the one operation that runs a script inside the sandbox of the VM
  entries.append NativeEntry(name: "scriptBody", target: NativeTarget.ScriptTable(ScriptTableKind.Body))
  entries.append NativeEntry(name: "scriptImports", target: NativeTarget.ScriptTable(ScriptTableKind.Imports))
  entries.append NativeEntry(name: "runScript", target: NativeTarget.Machine(runScriptFunction))
}

/**
 * `std/network`, over the IO core of `runtime/io.c` (docs/design/NETWORK.md section 2). A socket crosses as a handle, an
 * `Int64` of the runtime's table, an address as numbers, and an answer as an `Int64` whose negative values are packed
 * failures: the runtime builds no `Result`, no `NetworkError` and no address of the program. What waits answers a task of
 * the runtime, and what it delivered is taken afterwards through a `var` list. `std/http` is TorbScript over these and
 * has no native of its own.
 */
/** A function of the TLS part of the runtime (`runtime/tls/`), linked only into a program that calls one. */
fn tlsRuntimeOf(name: String, function: String, prototype: String): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Runtime(function), prototype: prototype, part: tlsPart
}

/**
 * `std/tls`, over mbedTLS (docs/design/NETWORK.md section 5, runtime/include/torb_tls.h): a session is a state machine
 * over bytes the program feeds and takes, so every wait stays a wait of `std/network`. A session and an identity are
 * handles; an answer is an `Int64` whose negative values are packed failures, as the network's are.
 */
fn tlsEntries(var entries: List<NativeEntry>) {
  entries.append(tlsRuntimeOf(
    "tlsClient",
    "torb_tls_client",
    "int64_t torb_tls_client(torb_text server_name, torb_text trusted);",
  ))
  entries.append(tlsRuntimeOf(
    "tlsIdentity",
    "torb_tls_identity",
    "int64_t torb_tls_identity(torb_text certificates, torb_text private_key);",
  ))
  entries.append tlsRuntimeOf("tlsServer", "torb_tls_server", "int64_t torb_tls_server(int64_t identity);")
  entries.append tlsRuntimeOf("tlsFeed", "torb_tls_feed", "void torb_tls_feed(int64_t session, torb_list bytes);")
  entries.append tlsRuntimeOf("tlsHandshake", "torb_tls_handshake", "int64_t torb_tls_handshake(int64_t session);")
  entries.append(tlsRuntimeOf(
    "tlsTakeOutgoing",
    "torb_tls_take_outgoing",
    "void torb_tls_take_outgoing(int64_t session, torb_list *into);",
  ))
  entries.append(tlsRuntimeOf(
    "tlsWrite",
    "torb_tls_write",
    "int64_t torb_tls_write(int64_t session, torb_list bytes, int64_t from);",
  ))
  entries.append(tlsRuntimeOf(
    "tlsRead",
    "torb_tls_read",
    "int64_t torb_tls_read(int64_t session, torb_list *into, int64_t maximum);",
  ))
  entries.append tlsRuntimeOf("tlsNotifyClose", "torb_tls_notify_close", "void torb_tls_notify_close(int64_t session);")
  entries.append tlsRuntimeOf("tlsClose", "torb_tls_close", "void torb_tls_close(int64_t handle);")
  entries.append tlsRuntimeOf("tlsProtocol", "torb_tls_protocol", "torb_text torb_tls_protocol(int64_t session);")
  entries.append(tlsRuntimeOf(
    "tlsErrorText",
    "torb_tls_error_text",
    "torb_text torb_tls_error_text(int64_t failure);",
  ))
}

fn networkEntries(var entries: List<NativeEntry>) {
  entries.append(runtimeOf(
    "networkListen",
    "torb_network_listen",
    "int64_t torb_network_listen(int64_t family, int64_t high, int64_t low, int64_t port, int64_t backlog);",
  ))
  entries.append(runtimeOf(
    "networkAccept",
    "torb_network_accept",
    "torb_task *torb_network_accept(int64_t listener);",
  ))
  entries.append(runtimeOf(
    "networkConnect",
    "torb_network_connect",
    "torb_task *torb_network_connect(int64_t family, int64_t high, int64_t low, int64_t port);",
  ))
  entries.append(runtimeOf(
    "networkReceive",
    "torb_network_receive",
    "torb_task *torb_network_receive(int64_t stream, int64_t maximum);",
  ))
  entries.append(runtimeOf(
    "networkTakeReceived",
    "torb_network_take_received",
    "void torb_network_take_received(int64_t stream, torb_list *into);",
  ))
  entries.append(runtimeOf(
    "networkSend",
    "torb_network_send",
    "torb_task *torb_network_send(int64_t stream, torb_list bytes, int64_t from);",
  ))
  entries.append(runtimeOf(
    "networkShutdown",
    "torb_network_shutdown",
    "int64_t torb_network_shutdown(int64_t stream);",
  ))
  entries.append runtimeOf("networkClose", "torb_network_close", "void torb_network_close(int64_t handle);")
  entries.append(runtimeOf(
    "networkAddress",
    "torb_network_address",
    "int64_t torb_network_address(int64_t handle, bool peer, torb_list *parts);",
  ))
  entries.append(runtimeOf(
    "networkResolve",
    "torb_network_resolve",
    "torb_task *torb_network_resolve(torb_text host);",
  ))
  entries.append(runtimeOf(
    "networkTakeResolved",
    "torb_network_take_resolved",
    "void torb_network_take_resolved(int64_t resolution, torb_list *parts);",
  ))
  entries.append(runtimeOf(
    "networkErrorText",
    "torb_network_error_text",
    "torb_text torb_network_error_text(int64_t failure);",
  ))
}

/** The whole manifest, in the order the sections above build it. */
public fn nativeEntries(): List<NativeEntry> {
  var entries: List<NativeEntry> = []
  integerEntries entries
  floatEntries entries
  decimalEntries entries
  conversionEntries entries
  compareEntries entries
  textEntries entries
  consoleEntries entries
  testEntries entries
  collectionEntries entries
  fileEntries entries
  mathEntries entries
  timeEntries entries
  environmentEntries entries
  targetEntries entries
  systemEntries entries
  taskEntries entries
  networkEntries entries
  tlsEntries entries
  machineEntries entries
  plannedPackageEntries entries
  entries
}

/** The entry for a `native` declaration, or `None` - which is an internal error of the compiler (BACKEND 3.7). */
public fn findNative(entries: List<NativeEntry>, name: String): NativeEntry? {
  for entry in entries {
    if entry.name == name {
      return Some entry
    }
  }
  None
}

// --- The generated header -------------------------------------------------------------------------------------------

/** `a < b` by bytes, spelled out so this file needs nothing from the iteration pipelines. */
fn isBefore(first: String, second: String): Bool {
  first.compare(second) == .Less
}

/** Insertion sort over a small list. Deterministic, and short enough to need no explanation. */
fn sortedNames(names: List<String>): List<String> {
  var result: List<String> = []
  for name in names {
    var index = 0
    while index < result.length() && isBefore(result[index], name) {
      index = index + 1
    }
    result.insert index, name
  }
  result
}

fn hasPrototype(prototypes: Map<String, String>, symbol: String): Bool {
  if const Some(_) = prototypes.get(symbol) {
    return true
  }
  false
}

/**
 * `runtime/include/torb_natives.h`: one prototype per runtime symbol the manifest declares ready, with the natives
 * that map to it above it. Sorted by symbol, so the file is a pure function of the table and never of a traversal.
 */
public fn renderNativesHeader(entries: List<NativeEntry>): String {
  var symbols: List<String> = []
  var prototypes: Map<String, String> = [:]
  var users: Map<String, List<String>> = [:]
  for entry in entries {
    if const .Planned(_) = entry.state {
      continue
    }
    if const .Runtime(function) = entry.target {
      if !hasPrototype(prototypes, function) {
        symbols.append function
        prototypes.set function, entry.prototype
        users.set function, []
      }
      users[function].append(entry.name)
    }
  }

  var lines = [
    "/*",
    " * torb_natives.h - generated from the natives manifest by `torb natives --header`. Do not edit.",
    " *",
    " * One prototype per `native` declaration of `std/` whose target is a function of the runtime and whose state is",
    " * ready. Include it after torb.h: the C compiler then compares the two declarations of every symbol, so the",
    " * manifest (compiler/src/backend/c/natives.trb) and the runtime cannot drift.",
    " */",
    "",
    "#ifndef TORB_NATIVES_H",
    "#define TORB_NATIVES_H",
    "",
    "#include \"torb.h\"",
    "",
  ]
  for symbol in sortedNames(symbols) {
    lines.append "/* {sortedNames(users[symbol]).joined(separator: ", ")} */"
    lines.append prototypes[symbol]
  }
  lines.append ""
  lines.append "#endif /* TORB_NATIVES_H */"
  lines.joined(separator: "\n") + "\n"
}

/** How many entries are ready and how many are planned, for the report of `torb natives`. */
public type NativeCounts {
  ready: Int = 0
  planned: Int = 0
  /** Distinct runtime symbols the generated header declares. */
  symbols: Int = 0
}

/** The [NativeCounts] of the whole manifest: how many entries of each state, and how many distinct symbols. */
public fn countNatives(entries: List<NativeEntry>): NativeCounts {
  var ready = 0
  var planned = 0
  var symbols: Map<String, Bool> = [:]
  for entry in entries {
    if const .Planned(_) = entry.state {
      planned = planned + 1
      continue
    }
    ready = ready + 1
    if const .Runtime(function) = entry.target {
      symbols.set function, true
    }
  }
  NativeCounts ready: ready, planned: planned, symbols: symbols.length()
}
