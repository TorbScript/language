/**
 * The manifest of natives: the contract between the lowering and the runtime (BACKEND 3.7).
 *
 * Every `native` declaration of `std/` is in here exactly once, mapped either to an intrinsic the back ends emit
 * themselves, to a function of `runtime/` called by name, or to a body the lowering generates from the layout. A
 * declaration the runtime does not implement yet is `.Planned(milestone)`, so using it is a clean compile error that
 * names what is missing and never a link error with a mangled name in it.
 *
 *     torb build → `Decimal.add` is not implemented yet
 *
 * `torb natives --header` writes the `.Ready` `.Runtime` entries to `runtime/include/torb_natives.h`. That file is
 * included after `torb.h` by `runtime/tests/natives_header_test.c`, so the C compiler compares the two declarations
 * of every symbol: the manifest and the runtime cannot drift without a compile error.
 *
 * **Two conventions the runtime follows, because a runtime function may not build a type of the program:**
 *
 * - A native whose result is an `Option` or a `Result` becomes a runtime function that answers `bool` and writes the
 *   payload through an out parameter (`torb_list_get`, `torb_text_index_of`, `torb_file_read_text`). The lowering
 *   builds the `Option`, the `Result` and the `IoError` around it.
 * - A native whose result is `Ordering` never answers one: either it is `.Derived`, and the lowering generates the two
 *   comparisons and the `Construct` from the layout, or the runtime owns the order and answers a **sign** that the
 *   wrapper turns into the three cases (`NativeResult.Ordering`). Both exist because `Ordering` is a layout of the
 *   program.
 *
 * # Related
 *
 * - [NativeEntry] - one row of the manifest.
 * - [NativeState.Planned] - what makes a declaration a clean compile error instead of a missing symbol.
 */

use Intrinsic, IntrinsicOperation, NumericKind, RuntimeKind from "../../ir/ir"
use BuildTarget, TargetSystem from "../../project/target"

/** One `native` declaration and what it becomes. */
public type NativeEntry {
  /** `"ArrayList.append"`, `"String.trim"`, `"print"`. The owner is empty for a free function. */
  name: String
  target: NativeTarget
  /** Which parameters the callee stores, so the ownership pass knows (BACKEND 2.1). `self` is index 0. */
  ownedParameters: List<Int> = []
  /**
   * Which parameters the runtime takes **by address**, because there is one C implementation of the list and one of the
   * hash table for every element type: an element is `const void *value` whatever it really is (BACKEND 3.1). `self` is
   * index 0, and a `var self` is by address anyway.
   */
  addressedParameters: List<Int> = []
  /** What the lowering has to build around the result. */
  result: NativeResult = NativeResult.Direct
  /**
   * Whether the collection this native answers is **coerced** by the wrapper: the runtime owns the storage
   * (`torb_list`) while the declaration names the trait type (`List<String>`), and a runtime function can carry no
   * witness table. It is the result of `String.split` and `Process.arguments` and the payload of the out parameter of
   * `File.list`, and nothing else - everywhere else a collection crosses the boundary as an **opaque element** of
   * another container (`addressedParameters`, and the `void *out` of `torb_list_get`), which needs no coercion.
   */
  coercedCollection: Bool = false
  state: NativeState = NativeState.Ready
  /**
   * The C prototype of a `.Ready` `.Runtime` target, exactly as `torb_natives.h` writes it. Empty for every other
   * target. It lives here so that the generated header is a pure function of this table.
   */
  prototype: String = ""
  /**
   * The operating systems the native exists on, empty for every target. A call of one that the lowering reaches while
   * building for another system is an error of the program at that call (`ir/lower/call.trb`), which
   * `torb check --every-target` reports on any machine: its C function is compiled on its own system only
   * (`runtime/os/`), so it is never a link error.
   */
  availableOn: List<TargetSystem> = []
  /**
   * The part of the runtime the native's C function lives in, empty for the runtime every program links. `"tls"` is
   * `runtime/tls/` over the mbedTLS of `runtime/vendor/`, which the driver compiles into a program only where its C
   * calls such a function (docs/design/NETWORK.md section 5): the thunk of the VM for one is guarded by
   * [tlsPartMacro] and panics in a binary without the part.
   */
  part: String = ""
}

/** The name of the TLS part of the runtime, in [NativeEntry.part]. */
public const tlsPart = "tls"

/** The macro the driver defines for a program that links the TLS part. */
public const tlsPartMacro = "TORB_WITH_TLS"

/** The prefix every C function of the TLS part has: what the driver looks for in a program's C. */
public const tlsSymbolPrefix = "torb_tls_"

/**
 * The kernel of the bytecode VM (`std/machine`): a program that calls it - `torb` itself - links the TLS part as well,
 * because the VM calls every function of the runtime through one table of thunks, those of `runtime/tls/` included
 * (docs/design/VM.md section 6).
 */
public const machineKernelSymbol = "torb_machine_operate"


/**
 * Which constant of the build a `.Target` native answers: the three `native fn`s of `std/core/src/target.trb` behind
 * `OperatingSystem.current`, `Architecture.current` and `ByteOrder.current`.
 */
public type TargetDimension {
  case OperatingSystem
  case Architecture
  case ByteOrder
}

/** Whether a native exists on a system: one without `availableOn` exists on every one. */
public fn isAvailableOn(entry: NativeEntry, system: TargetSystem): Bool {
  entry.availableOn.isEmpty() || entry.availableOn.contains(system)
}

/**
 * The constant a `native fn` of `std/core/src/target.trb` answers, by its name: what the checker asks where a
 * top-level `const` reads `OperatingSystem.current`, without building the manifest for one question.
 */
public fn targetDimensionNamed(name: String): TargetDimension? {
  match name {
    "targetOperatingSystem" => Some TargetDimension.OperatingSystem
    "targetArchitecture" => Some TargetDimension.Architecture
    "targetByteOrder" => Some TargetDimension.ByteOrder
    _ => None
  }
}

/** The one question a `.Target` native asks of the build, as the name of the case of `std/core` it answers. */
public fn targetCaseName(target: BuildTarget, dimension: TargetDimension): String {
  match dimension {
    .OperatingSystem => target.system.caseName()
    .Architecture => target.architecture.caseName()
    .ByteOrder => target.byteOrderCaseName()
  }
}

/**
 * What the lowering builds around the result of a function of the runtime, because `runtime/` may not build a layout of
 * the program (BACKEND 5.R1): `Option`, `Result` and `IoError` are types of the *program*.
 *
 * Everything but `.Direct` needs a **wrapper**, which the lowering generates once per instance
 * (`ir/lower/native.trb`) - so the one place that knows the runtime's conventions stays the one place that knows them,
 * and both back ends get the same answer out of the same IR.
 */
public type NativeResult {
  /** The runtime answers exactly what the declaration does, and a call of it is an ordinary `Call`. */
  case Direct
  /**
   * The runtime answers `bool` and writes the payload through an out parameter appended after the declared ones:
   * `Value?` is `Some(out)` where it answered true and `None` otherwise (`torb_list_get`, `torb_text_index_of`).
   */
  case Optional
  /**
   * The same for a declaration that answers a `Result`: `Ok(out)`, and a failure the wrapper builds from the fields of
   * the error type, each taken from the parameter of the **same name** - `Int.tryFrom(text)` fails with
   * `NumberParseError(text)`. An error type whose fields no parameter names is a clean finding.
   */
  case Fallible
  /**
   * `bool` plus **two** out parameters, for a declaration that answers an `Option` of a **tuple** the runtime cannot
   * build: `torb_map_entry_after(map, &cursor, &key, &value)` writes the two halves of one entry, and the wrapper makes
   * the `(Key, Value)` and the `Some` around it. There is no layout of the program in `runtime/` (BACKEND 5.R1), and the
   * two halves of an entry live in two arrays of the table anyway, so nothing could write a tuple in one piece.
   */
  case OptionalParts
  /**
   * The runtime answers a **sign** as an `int32_t` where the declaration answers an `Ordering`: negative is `Less`,
   * positive `Greater`, zero `Equal`. It is the shape of every comparison the runtime owns rather than derives - a total
   * order over the floats with `nan` above everything (runtime/README.md, "Determinism"), and the two of `std/time` -
   * and the three cases are a variant type of the *program*, so `runtime/` could not build one (BACKEND 5.R1).
   */
  case Ordering
}

/** What a `NativeEntry` becomes: an opcode both back ends emit, a call into `runtime/`, or a body generated here. */
public type NativeTarget {
  /** Emitted inline by the C back end, an opcode in the VM. */
  case Intrinsic(intrinsic: Intrinsic)
  /** A function of the runtime, called by name. */
  case Runtime(function: String)
  /** Generated from the layout: derived members of native types. */
  case Derived(derived: DerivedKind)
  /**
   * An **empty container** of one kind, which is `Instruction.ContainerNew` and can be nothing else: the runtime needs
   * one element descriptor per type argument, and no declaration of `std/` can name one. It is the one native whose
   * target the *lowering* knows better than the runtime does, and it is what lets `ArrayList.from` be ordinary
   * TorbScript instead of a function of the runtime that would have to walk a witness table.
   */
  case Container(kind: RuntimeKind)
  /**
   * A native no function could be, which the lowering writes as IR of its own (`ir/lower/task.trb`): `spawn`, whose
   * closure literal becomes the resume function of a task, and `stopAsCancelled`, which ends the machine it runs in.
   */
  case Lowered
  /**
   * The raw storage of an `Array<Item, Size>`: a generated body of one instruction over the inline slots, which is what
   * the rest of `std/core`'s `Array` is written in TorbScript on top of (`ir/lower/derive.trb`, docs/BACKEND.md 5.9b).
   */
  case ArrayStorage(operation: ArrayOperation)
  /**
   * A constant of the build, which is no code at all: the case of `std/core`'s `OperatingSystem`, `Architecture` or
   * `ByteOrder` the build is for. The constant evaluator and the fold of a `match` read it (`ir/fold.trb`), and a call
   * that is lowered anyway - `print(OperatingSystem.current)` - is one `Construct` of that case. The VM answers the
   * machine it runs on, because it compiles a program where it runs it.
   */
  case Target(dimension: TargetDimension)
  /**
   * The table of the receiver scripts the program was compiled with, one per receiver type: a body the lowering
   * generates out of the scripts the checker checked against the type argument (`ir/lower/script.trb`,
   * docs/design/SCRIPTS.md section 3). Ordinary IR, which either back end could run.
   */
  case ScriptTable(kind: ScriptTableKind)
  /**
   * An operation only the VM performs, because it runs a receiver script inside a sandbox: the C back end refuses a
   * program that reaches one, and the bytecode emitter writes an instruction of its own for it (docs/design/SCRIPTS.md
   * section 1). `function` is the name the IR carries it under.
   */
  case Machine(function: String)
}

/** What the table of scripts answers for a path: the body of the script, or the modules its `use` lines name. */
public type ScriptTableKind {
  case Body
  case Imports
}

/** The name a call of `runScript` of `std/sandbox` carries in the IR, which the bytecode emitter turns into its instruction. */
public const runScriptFunction = "torb_machine_run_script"

/**
 * The three things only the storage of an `Array<Item, Size>` can do. Each one is an instruction of the IR, so the VM
 * needs nothing of the runtime for them either.
 */
public type ArrayOperation {
  /** Every slot empty: `ArrayNew` without items, the storage `filled` and `generated` write every slot of. */
  case Unfilled
  /** The item at an index, read through an `Element` step. */
  case Load
  /** The item at an index replaced through an `Element` step, releasing what was there. */
  case Store
}

/** Whether a `native` declaration can be called today, or is still a named, clean compile error where it is used. */
public type NativeState {
  case Ready
  /** `Decimal`, `Float32` arithmetic: a clean compile error naming what is still missing. */
  case Planned(milestone: String)
}

/**
 * Which body the lowering generates. `Compare` and `Absolute` are here rather than among the intrinsics because both
 * are two intrinsics plus something the runtime cannot build: an `Ordering`, and a branch.
 */
public type DerivedKind {
  case Show
  case ShowNested
  case Equals
  case Compare
  case Hash
  /** `if self < 0 { -self } else { self }`, so the overflow of the smallest value falls out of `Negate`. */
  case Absolute
  /** `String.show()` is the text itself, and `Void.equals` is always true. */
  case Identity
  case Copy
}

// --- Building the entries -------------------------------------------------------------------------------------------

fn intrinsicOf(name: String, operation: IntrinsicOperation): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Intrinsic(Intrinsic(operation: operation))
}

fn numericOf(name: String, operation: IntrinsicOperation, kind: NumericKind): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Intrinsic(Intrinsic(operation: operation, kind: Some(kind)))
}

/** An empty container the lowering builds itself, over the element descriptors of the owner's type arguments. */
fn containerOf(name: String, kind: RuntimeKind): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Container(kind)
}

fn runtimeOf(name: String, function: String, prototype: String): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Runtime(function), prototype: prototype
}

/**
 * A comparison of the runtime: the symbol answers a **sign** as an `int32_t` where the declaration answers an `Ordering`,
 * which is a variant type of the program that no function of `runtime/` could build (BACKEND 5.R1). The wrapper turns the
 * sign into the three cases.
 */
fn orderingRuntimeOf(name: String, function: String, prototype: String): NativeEntry {
  NativeEntry(
    name: name,
    target: NativeTarget.Runtime(function),
    result: NativeResult.Ordering,
    prototype: prototype,
  )
}

/**
 * A function of the runtime that builds a **collection** and answers its storage, while the declaration names the trait
 * type: `String.split` and `Process.arguments`. The wrapper coerces it, exactly as a list literal coerces the container
 * it filled itself.
 */
fn collectionRuntimeOf(name: String, function: String, prototype: String): NativeEntry {
  NativeEntry(
    name: name,
    target: NativeTarget.Runtime(function),
    prototype: prototype,
    coercedCollection: true,
  )
}

/** The same for a declaration that answers a `Result` whose payload is the collection (`File.list`). */
fn fallibleCollectionOf(name: String, function: String, prototype: String): NativeEntry {
  NativeEntry(
    name: name,
    target: NativeTarget.Runtime(function),
    result: NativeResult.Fallible,
    prototype: prototype,
    coercedCollection: true,
  )
}

fn ownedRuntimeOf(name: String, function: String, prototype: String, owned: List<Int>): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Runtime(function), ownedParameters: owned, prototype: prototype
}

/** A function of the runtime that answers `bool` and writes the payload of an `Option` through an out parameter. */
fn optionalRuntimeOf(name: String, function: String, prototype: String): NativeEntry {
  NativeEntry(
    name: name,
    target: NativeTarget.Runtime(function),
    result: NativeResult.Optional,
    prototype: prototype,
  )
}

/** The same for a declaration that answers a `Result`, whose failure the wrapper builds from the error's fields. */
fn fallibleRuntimeOf(name: String, function: String, prototype: String): NativeEntry {
  NativeEntry(
    name: name,
    target: NativeTarget.Runtime(function),
    result: NativeResult.Fallible,
    prototype: prototype,
  )
}

/**
 * A member of a runtime container: whatever mix of stored parameters, parameters the one C implementation takes by
 * address, and an `Option` through an out parameter the symbol has.
 */
fn containerRuntimeOf(
  name: String,
  function: String,
  prototype: String,
  owned: List<Int>,
  addressed: List<Int>,
  result: NativeResult,
): NativeEntry {
  NativeEntry(
    name: name,
    target: NativeTarget.Runtime(function),
    ownedParameters: owned,
    addressedParameters: addressed,
    result: result,
    prototype: prototype,
  )
}

fn derivedOf(name: String, derived: DerivedKind): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Derived(derived)
}

/** A native the lowering writes as IR of its own: `spawn`, `stopAsCancelled`. */
fn loweredOf(name: String): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Lowered
}

fn plannedRuntimeOf(name: String, function: String, milestone: String): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Runtime(function), state: NativeState.Planned(milestone)
}

fn plannedIntrinsicOf(name: String, operation: IntrinsicOperation, milestone: String): NativeEntry {
  NativeEntry(
    name: name,
    target: NativeTarget.Intrinsic(Intrinsic(operation: operation)),
    state: NativeState.Planned(milestone),
  )
}

// --- The numeric types ----------------------------------------------------------------------------------------------

/** The suffix of an intrinsic and of a runtime symbol: `i64`, `u8`, `f64`. */
fn numericSuffix(kind: NumericKind): String {
  match kind {
    .Signed(width) => "i{width}"
    .Unsigned(width) => "u{width}"
    .Floating(width) => "f{width}"
  }
}

/**
 * The narrowing conversions of an `Int64` besides `Int32`'s: the type, the suffix of its checked runtime function, and
 * the C type the function writes (`torb_number.h`).
 */
fn narrowingConversions(): List<(String, String, String)> {
  [
    ("Int8", "i8", "int8_t"),
    ("Int16", "i16", "int16_t"),
    ("UInt8", "u8", "uint8_t"),
    ("UInt16", "u16", "uint16_t"),
    ("UInt32", "u32", "uint32_t"),
    ("UInt64", "u64", "uint64_t"),
  ]
}

/**
 * The members of `Numeric` for one width, which every integer and float type comes `with`. Arithmetic is an
 * intrinsic, and `show` and the conversion from text are the runtime's. `compare` is not here: on the integers it is
 * generated, on `Float64` it is a runtime function, because a total order with `nan` in it is not a comparison
 * intrinsic.
 *
 * The conversion is named **with its source**, because a type has one `TryFrom` per source and the member name alone
 * does not say which of them a call means (`Int64.tryFrom` reads text and narrows a `Float64`).
 */
fn numericMembers(var entries: List<NativeEntry>, owner: String, kind: NumericKind, showFunction: String,
                  showPrototype: String, parseFunction: String, parsePrototype: String) {
  entries.append numericOf("{owner}.add", IntrinsicOperation.Add, kind)
  entries.append numericOf("{owner}.subtract", IntrinsicOperation.Subtract, kind)
  entries.append numericOf("{owner}.multiply", IntrinsicOperation.Multiply, kind)
  entries.append numericOf("{owner}.divide", IntrinsicOperation.Divide, kind)
  entries.append numericOf("{owner}.remainder", IntrinsicOperation.Remainder, kind)
  entries.append numericOf("{owner}.equals", IntrinsicOperation.Equal, kind)
  entries.append runtimeOf("{owner}.show", showFunction, showPrototype)
  entries.append fallibleRuntimeOf("{owner}.tryFrom(String)", parseFunction, parsePrototype)
}

/** `Signed` adds `negate` and `absolute` on top of `Numeric`. */
fn signedMembers(var entries: List<NativeEntry>, owner: String, kind: NumericKind) {
  entries.append numericOf("{owner}.negate", IntrinsicOperation.Negate, kind)
  entries.append derivedOf("{owner}.absolute", DerivedKind.Absolute)
}

/** The six methods of `Bits`, one entry per member per width. */
fn bitsMembers(var entries: List<NativeEntry>, owner: String, kind: NumericKind) {
  entries.append numericOf("{owner}.bitwiseAnd", IntrinsicOperation.BitwiseAnd, kind)
  entries.append numericOf("{owner}.bitwiseOr", IntrinsicOperation.BitwiseOr, kind)
  entries.append numericOf("{owner}.bitwiseExclusiveOr", IntrinsicOperation.BitwiseExclusiveOr, kind)
  entries.append numericOf("{owner}.bitwiseNot", IntrinsicOperation.BitwiseNot, kind)
  entries.append numericOf("{owner}.shiftedLeft", IntrinsicOperation.ShiftedLeft, kind)
  entries.append numericOf("{owner}.shiftedRight", IntrinsicOperation.ShiftedRight, kind)
}

fn integerEntries(var entries: List<NativeEntry>) {
  const widths = [8, 16, 32, 64]
  for width in widths {
    const owner = "Int{width}"
    const kind = NumericKind.Signed width
    numericMembers(
      entries,
      owner,
      kind,
      "torb_show_i64",
      "torb_text torb_show_i64(int64_t value);",
      "torb_parse_i64",
      "bool torb_parse_i64(torb_text text, int64_t *out);",
    )
    signedMembers entries, owner, kind
    bitsMembers entries, owner, kind
    entries.append derivedOf("{owner}.compare", DerivedKind.Compare)
    entries.append runtimeOf("{owner}.hash", "torb_hash_i64", "uint64_t torb_hash_i64(int64_t value);")
  }
  for width in widths {
    const owner = "UInt{width}"
    const kind = NumericKind.Unsigned width
    numericMembers(
      entries,
      owner,
      kind,
      "torb_show_u64",
      "torb_text torb_show_u64(uint64_t value);",
      "torb_parse_u64",
      "bool torb_parse_u64(torb_text text, uint64_t *out);",
    )
    bitsMembers entries, owner, kind
    entries.append derivedOf("{owner}.compare", DerivedKind.Compare)
    entries.append runtimeOf("{owner}.hash", "torb_hash_u64", "uint64_t torb_hash_u64(uint64_t value);")
  }
}

fn floatEntries(var entries: List<NativeEntry>) {
  const kind = NumericKind.Floating 64
  numericMembers(
    entries,
    "Float64",
    kind,
    "torb_show_f64",
    "torb_text torb_show_f64(double value);",
    "torb_parse_f64",
    "bool torb_parse_f64(torb_text text, double *out);",
  )
  signedMembers entries, "Float64", kind
  // `compare` is a total order with `nan` above everything (runtime/README.md, "Determinism"), which no comparison
  // intrinsic gives.
  entries.append(orderingRuntimeOf(
    "Float64.compare",
    "torb_compare_f64",
    "int32_t torb_compare_f64(double first, double second);",
  ))
  entries.append runtimeOf("Float64.squareRoot", "torb_square_root_f64", "double torb_square_root_f64(double value);")
  entries.append runtimeOf("Float64.floor", "torb_floor_f64", "double torb_floor_f64(double value);")
  entries.append runtimeOf("Float64.ceiling", "torb_ceiling_f64", "double torb_ceiling_f64(double value);")
  entries.append runtimeOf("Float64.round", "torb_round_f64", "double torb_round_f64(double value);")
  entries.append runtimeOf("Float64.isNaN", "torb_is_nan_f64", "bool torb_is_nan_f64(double value);")

  // `Float32` arithmetic is not implemented: everything narrows to `Float64` for now.
  const float32Members = [
    "add", "subtract", "multiply", "divide", "remainder", "negate", "absolute", "equals", "compare", "show",
  ]
  for member in float32Members {
    entries.append plannedRuntimeOf("Float32.{member}", "torb_{member}_f32", "8")
  }
  entries.append plannedRuntimeOf("Float32.tryFrom(String)", "torb_parse_f32", "8")
}

fn decimalEntries(var entries: List<NativeEntry>) {
  const members = [
    "add", "subtract", "multiply", "divide", "remainder", "negate", "absolute", "equals", "compare", "show", "hash",
  ]
  for member in members {
    entries.append plannedRuntimeOf("Decimal.{member}", "torb_decimal_{member}", "8")
  }
  entries.append plannedRuntimeOf("Decimal.tryFrom(String)", "torb_decimal_parse", "8")
}

fn conversionEntries(var entries: List<NativeEntry>) {
  entries.append numericOf("Int64.from", IntrinsicOperation.Convert(NumericKind.Signed(64)), NumericKind.Signed(32))
  entries.append(numericOf(
    "Float64.from",
    IntrinsicOperation.Convert(NumericKind.Floating(64)),
    NumericKind.Signed(64),
  ))
  entries.append(numericOf(
    "Float64.fromFloat32",
    IntrinsicOperation.Convert(NumericKind.Floating(64)),
    NumericKind.Floating(32),
  ))
  // A `NumberRangeError` carries a `message` and no parameter of `tryFrom` names it, so the runtime writes it through one
  // more out parameter - the `.Fallible` convention, exactly as the `message` of an `IoError` arrives
  entries.append(fallibleRuntimeOf(
    "Int32.tryFrom(Int64)",
    "torb_convert_i64_i32_checked",
    "bool torb_convert_i64_i32_checked(int64_t value, int32_t *out, torb_text *message);",
  ))
  // The other narrowings of an `Int64`, and the one of a `UInt64` into an `Int64`: the runtime checks every one of them
  for (owner, suffix, spelling) in narrowingConversions() {
    entries.append(fallibleRuntimeOf(
      "{owner}.tryFrom(Int64)",
      "torb_convert_i64_{suffix}_checked",
      "bool torb_convert_i64_{suffix}_checked(int64_t value, {spelling} *out, torb_text *message);",
    ))
  }
  entries.append(fallibleRuntimeOf(
    "Int64.tryFrom(UInt64)",
    "torb_convert_u64_i64_checked",
    "bool torb_convert_u64_i64_checked(uint64_t value, int64_t *out, torb_text *message);",
  ))
  entries.append(fallibleRuntimeOf(
    "Int64.tryFrom(Float64)",
    "torb_convert_f64_i64_checked",
    "bool torb_convert_f64_i64_checked(double value, int64_t *out, torb_text *message);",
  ))
  entries.append(fallibleRuntimeOf(
    "Int64.parseDigits",
    "torb_parse_i64_digits",
    "bool torb_parse_i64_digits(torb_text text, int64_t radix, int64_t *out);",
  ))
  entries.append(runtimeOf(
    "UInt64.addedWrapping",
    "torb_added_wrapping_u64",
    "uint64_t torb_added_wrapping_u64(uint64_t first, uint64_t second);",
  ))
  entries.append(runtimeOf(
    "UInt64.multipliedWrapping",
    "torb_multiplied_wrapping_u64",
    "uint64_t torb_multiplied_wrapping_u64(uint64_t first, uint64_t second);",
  ))
}

/**
 * `std/core/src/compare.trb`: the one helper that is not a member of a type. `List.hash` folds its items through it
 * (order-dependent); `Set.hash` and `Map.hash` combine theirs with `bitwiseExclusiveOr` instead, which needs nothing
 * from the runtime.
 */
fn compareEntries(var entries: List<NativeEntry>) {
  entries.append(runtimeOf(
    "combineHashes",
    "torb_hash_combine",
    "uint64_t torb_hash_combine(uint64_t first, uint64_t second);",
  ))
}

// --- Bool, Char, String, Void ---------------------------------------------------------------------------------------

fn textEntries(var entries: List<NativeEntry>) {
  entries.append intrinsicOf("Bool.equals", IntrinsicOperation.Equal)
  entries.append runtimeOf("Bool.hash", "torb_hash_bool", "uint64_t torb_hash_bool(bool value);")
  entries.append runtimeOf("Bool.show", "torb_show_bool", "torb_text torb_show_bool(bool value);")

  entries.append intrinsicOf("Char.equals", IntrinsicOperation.Equal)
  entries.append derivedOf("Char.compare", DerivedKind.Compare)
  entries.append runtimeOf("Char.hash", "torb_hash_char", "uint64_t torb_hash_char(torb_char character);")
  entries.append runtimeOf("Char.show", "torb_show_char", "torb_text torb_show_char(torb_char character);")
  entries.append(runtimeOf(
    "Char.showNested",
    "torb_show_char_nested",
    "torb_text torb_show_char_nested(torb_char character);",
  ))
  entries.append runtimeOf("Char.isDigit", "torb_char_is_digit", "bool torb_char_is_digit(torb_char character);")
  entries.append runtimeOf("Char.isLetter", "torb_char_is_letter", "bool torb_char_is_letter(torb_char character);")
  entries.append(runtimeOf(
    "Char.isWhitespace",
    "torb_char_is_whitespace",
    "bool torb_char_is_whitespace(torb_char character);",
  ))
  entries.append(runtimeOf(
    "Char.byteLength",
    "torb_char_byte_length_of",
    "int64_t torb_char_byte_length_of(torb_char character);",
  ))
  entries.append(runtimeOf(
    "Char.toUpperCase",
    "torb_char_to_upper_case",
    "torb_char torb_char_to_upper_case(torb_char character);",
  ))
  entries.append(runtimeOf(
    "Char.toLowerCase",
    "torb_char_to_lower_case",
    "torb_char torb_char_to_lower_case(torb_char character);",
  ))
  entries.append(fallibleRuntimeOf(
    "Char.tryFrom(Int64)",
    "torb_char_try_from_i64",
    "bool torb_char_try_from_i64(int64_t value, torb_char *out, torb_text *message);",
  ))
  entries.append numericOf("Int64.fromChar", IntrinsicOperation.Convert(NumericKind.Signed(64)), NumericKind.Unsigned(32))

  entries.append intrinsicOf("String.equals", IntrinsicOperation.TextEqual)
  entries.append derivedOf("String.compare", DerivedKind.Compare)
  entries.append runtimeOf("String.hash", "torb_text_hash", "uint64_t torb_text_hash(torb_text text);")
  // `show()` of a `String` is the text itself, which is a copy and not a call.
  entries.append derivedOf("String.show", DerivedKind.Identity)
  entries.append(runtimeOf(
    "String.showNested",
    "torb_text_show_nested",
    "torb_text torb_text_show_nested(torb_text text);",
  ))
  entries.append intrinsicOf("String.add", IntrinsicOperation.TextConcat)
  entries.append intrinsicOf("String.byteLength", IntrinsicOperation.TextByteLength)
  entries.append runtimeOf("String.isEmpty", "torb_text_is_empty", "bool torb_text_is_empty(torb_text text);")
  entries.append(runtimeOf(
    "String.sliceBytes",
    "torb_text_slice",
    "torb_text torb_text_slice(torb_text text, int64_t from, int64_t to, torb_location at);",
  ))
  entries.append(runtimeOf(
    "String.contains",
    "torb_text_contains",
    "bool torb_text_contains(torb_text text, torb_text part);",
  ))
  entries.append(runtimeOf(
    "String.startsWith",
    "torb_text_starts_with",
    "bool torb_text_starts_with(torb_text text, torb_text prefix);",
  ))
  entries.append(runtimeOf(
    "String.endsWith",
    "torb_text_ends_with",
    "bool torb_text_ends_with(torb_text text, torb_text suffix);",
  ))
  entries.append(optionalRuntimeOf(
    "String.indexOf",
    "torb_text_index_of",
    "bool torb_text_index_of(torb_text text, torb_text part, int64_t *out);",
  ))
  entries.append(optionalRuntimeOf(
    "String.lastIndexOf",
    "torb_text_last_index_of",
    "bool torb_text_last_index_of(torb_text text, torb_text part, int64_t *out);",
  ))
  entries.append runtimeOf("String.trim", "torb_text_trim", "torb_text torb_text_trim(torb_text text);")
  entries.append(runtimeOf(
    "String.toUpperCase",
    "torb_text_to_upper_case",
    "torb_text torb_text_to_upper_case(torb_text text);",
  ))
  entries.append(runtimeOf(
    "String.toLowerCase",
    "torb_text_to_lower_case",
    "torb_text torb_text_to_lower_case(torb_text text);",
  ))
  entries.append(runtimeOf(
    "String.replace",
    "torb_text_replace",
    "torb_text torb_text_replace(torb_text text, torb_text part, torb_text replacement);",
  ))
  entries.append(runtimeOf(
    "String.repeat",
    "torb_text_repeat",
    "torb_text torb_text_repeat(torb_text text, int64_t times, torb_location at);",
  ))
  // The runtime builds the list and answers its storage, which the wrapper coerces to the `List<String>` the declaration
  // names: it cannot build a trait-typed value, because that is a boxed payload plus one witness pointer per bound
  entries.append(collectionRuntimeOf(
    "String.split",
    "torb_text_split",
    "torb_list torb_text_split(torb_text text, torb_text separator);",
  ))
  /*
   * `chars()` and `bytes()` are ordinary TorbScript over these two (`Characters` and `TextBytes` in `std/text`), and
   * `String.from(Iterate<Char>)` is TorbScript for the same reason `ArrayList.from` is: it walks a trait-typed value of
   * the *program* through a witness table, which a C function cannot do. So none of the three is a native any more, and
   * what is left is the one thing the language cannot express at all - reading raw storage, because a `String` has no
   * index.
   */
  entries.append(optionalRuntimeOf(
    "String.charAt",
    "torb_text_char_at",
    "bool torb_text_char_at(torb_text text, int64_t offset, torb_char *out);",
  ))
  entries.append(optionalRuntimeOf(
    "String.byteAt",
    "torb_text_byte_at",
    "bool torb_text_byte_at(torb_text text, int64_t offset, uint8_t *out);",
  ))

  entries.append derivedOf("Void.equals", DerivedKind.Identity)
  entries.append derivedOf("Void.hash", DerivedKind.Hash)
  // `show(self)` passes the one value of `Void` like any other receiver, so the runtime takes it and ignores it
  entries.append runtimeOf("Void.show", "torb_show_void", "torb_text torb_show_void(torb_void value);")
}

fn consoleEntries(var entries: List<NativeEntry>) {
  entries.append(runtimeOf(
    "print",
    "torb_print_parts",
    "void torb_print_parts(const torb_text *parts, size_t count);",
  ))
  entries.append(runtimeOf(
    "printError",
    "torb_print_error_parts",
    "void torb_print_error_parts(const torb_text *parts, size_t count);",
  ))
  entries.append runtimeOf("panic", "torb_panic", "void torb_panic(torb_text message, torb_location at);")
}

/**
 * `test` and `group` of `std/test`. Both are functions of the runtime because the runtime can call a closure - a closure
 * value's `code` points at a thunk with an erased environment - and because a test needs a **recovery point**: a body
 * that panics is reported and the next test runs, which `runtime/test.c` sets up around every body.
 *
 * The report is one format for both back ends for the same reason `print` joins its parts in the runtime: two
 * implementations of one format are two chances to disagree, and `torb test` compares the two line by line.
 */
fn testEntries(var entries: List<NativeEntry>) {
  entries.append runtimeOf("test", "torb_test_case", "void torb_test_case(torb_text name, torb_closure body);")
  entries.append runtimeOf("group", "torb_test_group", "void torb_test_group(torb_text name, torb_closure body);")
}

// --- The collections ------------------------------------------------------------------------------------------------

/**
 * `ArrayList` and `TrieList` share this implementation: the persistent variant does not exist yet, so the two are
 * observable apart only through performance - iteration order and `Show` are the same either way.
 */
fn listEntries(var entries: List<NativeEntry>, owner: String) {
  // `from` and `iterate` are in neither list: both are ordinary TorbScript, and `from` cannot be anything else - it
  // walks a trait-typed `Iterate` of the *program* through a witness table, which a C function cannot do.
  // `withCapacity` is the empty container, which is an instruction and no call: `torb_list_with_capacity` takes an
  // element descriptor that no declaration of `std/` can name. The capacity is a hint the first version drops.
  entries.append containerOf("{owner}.withCapacity", RuntimeKind.ListStorage)
  entries.append runtimeOf("{owner}.length", "torb_list_length", "int64_t torb_list_length(torb_list list);")
  entries.append(optionalRuntimeOf(
    "{owner}.get",
    "torb_list_get",
    "bool torb_list_get(torb_list list, int64_t index, void *out);",
  ))
  entries.append(runtimeOf(
    "{owner}.sliceBetween",
    "torb_list_slice",
    "torb_list torb_list_slice(torb_list list, int64_t from, int64_t to, torb_location at);",
  ))
  entries.append(containerRuntimeOf(
    "{owner}.append",
    "torb_list_add",
    "void torb_list_add(torb_list *list, const void *value);",
    [1],
    [1],
    NativeResult.Direct,
  ))
  entries.append(containerRuntimeOf(
    "{owner}.set",
    "torb_list_set",
    "void torb_list_set(torb_list *list, int64_t index, const void *value, torb_location at);",
    [2],
    [2],
    NativeResult.Direct,
  ))
  entries.append(containerRuntimeOf(
    "{owner}.insert",
    "torb_list_insert",
    "void torb_list_insert(torb_list *list, int64_t index, const void *value, torb_location at);",
    [2],
    [2],
    NativeResult.Direct,
  ))
  entries.append(optionalRuntimeOf(
    "{owner}.removeAt",
    "torb_list_remove_at",
    "bool torb_list_remove_at(torb_list *list, int64_t index, void *out);",
  ))
  entries.append(runtimeOf(
    "{owner}.replaceBetween",
    "torb_list_replace",
    "void torb_list_replace(torb_list *list, int64_t from, int64_t to, torb_list values, torb_location at);",
  ))
  entries.append runtimeOf("{owner}.reverse", "torb_list_reverse", "void torb_list_reverse(torb_list *list);")
  entries.append runtimeOf("{owner}.clear", "torb_list_clear", "void torb_list_clear(torb_list *list);")
  entries.append runtimeOf("{owner}.compact", "torb_list_compact", "void torb_list_compact(torb_list *list);")
}

fn mapEntries(var entries: List<NativeEntry>, owner: String) {
  // `from` and `iterate` are ordinary TorbScript, exactly as `ArrayList`'s are: `from` walks a trait-typed `Iterate` of
  // the *program*, which a C function cannot, and the cursor is `MapIterator` over the one native below.
  entries.append containerOf("{owner}.withCapacity", RuntimeKind.MapStorage)
  entries.append runtimeOf("{owner}.length", "torb_map_length", "int64_t torb_map_length(torb_map map);")
  entries.append(containerRuntimeOf(
    "{owner}.entryAfter",
    "torb_map_entry_after",
    "bool torb_map_entry_after(torb_map map, int64_t *cursor, void *key, void *value);",
    [],
    [],
    NativeResult.OptionalParts,
  ))
  entries.append(containerRuntimeOf(
    "{owner}.get",
    "torb_map_get",
    "bool torb_map_get(torb_map map, const void *key, void *out);",
    [],
    [1],
    NativeResult.Optional,
  ))
  entries.append(containerRuntimeOf(
    "{owner}.set",
    "torb_map_set",
    "void torb_map_set(torb_map *map, const void *key, const void *value);",
    [1, 2],
    [1, 2],
    NativeResult.Direct,
  ))
  entries.append(containerRuntimeOf(
    "{owner}.remove",
    "torb_map_remove",
    "bool torb_map_remove(torb_map *map, const void *key, void *out);",
    [],
    [1],
    NativeResult.Optional,
  ))
  entries.append runtimeOf("{owner}.clear", "torb_map_clear", "void torb_map_clear(torb_map *map);")
}

fn setEntries(var entries: List<NativeEntry>, owner: String) {
  entries.append containerOf("{owner}.withCapacity", RuntimeKind.SetStorage)
  entries.append runtimeOf("{owner}.length", "torb_set_length", "int64_t torb_set_length(torb_set set);")
  entries.append(optionalRuntimeOf(
    "{owner}.itemAfter",
    "torb_set_item_after",
    "bool torb_set_item_after(torb_set set, int64_t *cursor, void *item);",
  ))
  entries.append(containerRuntimeOf(
    "{owner}.contains",
    "torb_set_contains",
    "bool torb_set_contains(torb_set set, const void *item);",
    [],
    [1],
    NativeResult.Direct,
  ))
  entries.append(containerRuntimeOf(
    "{owner}.insert",
    "torb_set_add",
    "void torb_set_add(torb_set *set, const void *item);",
    [1],
    [1],
    NativeResult.Direct,
  ))
  entries.append(containerRuntimeOf(
    "{owner}.remove",
    "torb_set_remove",
    "bool torb_set_remove(torb_set *set, const void *item);",
    [],
    [1],
    NativeResult.Direct,
  ))
  entries.append runtimeOf("{owner}.clear", "torb_set_clear", "void torb_set_clear(torb_set *set);")
}

fn collectionEntries(var entries: List<NativeEntry>) {
  listEntries entries, "ArrayList"
  listEntries entries, "TrieList"
  mapEntries entries, "HashMap"
  mapEntries entries, "TrieMap"
  setEntries entries, "HashSet"
  setEntries entries, "TrieSet"

  // `Array<Item, Size>` is inline storage, a struct of the program the emitter writes itself. Three private members are
  // the storage and nothing else, and every public member of `std/core`'s `Array` is TorbScript on top of them
  entries.append NativeEntry(name: "Array.unfilled", target: NativeTarget.ArrayStorage(ArrayOperation.Unfilled))
  entries.append NativeEntry(name: "Array.load", target: NativeTarget.ArrayStorage(ArrayOperation.Load))
  entries.append NativeEntry(name: "Array.store", target: NativeTarget.ArrayStorage(ArrayOperation.Store))

  // A `Range` is an ordinary record; only its iteration is native, and it panics without both ends.
  entries.append derivedOf("Range.equals", DerivedKind.Equals)
  entries.append derivedOf("Range.hash", DerivedKind.Hash)
  // The two ranges with one open end are records as well, and `with Equals, Hash` asks the manifest for both members
  entries.append derivedOf("RangeFrom.equals", DerivedKind.Equals)
  entries.append derivedOf("RangeFrom.hash", DerivedKind.Hash)
  entries.append derivedOf("RangeTo.equals", DerivedKind.Equals)
  entries.append derivedOf("RangeTo.hash", DerivedKind.Hash)
  // `Range.show` writes the source form (`0..10`, `0..=10`), which the derived one cannot, and `iterate` and `length`
  // are ordinary TorbScript over `RangeIterator` - so none of the three is a native any more (`std/core/src/range.trb`)
}

// --- The packages outside the prelude --------------------------------------------------------------------------------

fn fileEntries(var entries: List<NativeEntry>) {
  /*
   * The whole-file half of `std/fs`. Every one of them answers a `Result`, which is the `.Fallible` convention: the
   * symbol answers `bool`, the payload of `Ok` comes through an out parameter (none where it is `Void`), and the
   * `message` of the `IoError` through one more - its `path` *is* the parameter of that name.
   */
  entries.append(fallibleRuntimeOf(
    "File.readText",
    "torb_file_read_text",
    "bool torb_file_read_text(torb_text path, torb_text *out, torb_text *error);",
  ))
  entries.append(fallibleRuntimeOf(
    "File.writeText",
    "torb_file_write_text",
    "bool torb_file_write_text(torb_text path, torb_text text, torb_text *error);",
  ))
  entries.append runtimeOf("File.exists", "torb_file_exists", "bool torb_file_exists(torb_text path);")
  entries.append(runtimeOf(
    "File.isDirectory",
    "torb_file_is_directory",
    "bool torb_file_is_directory(torb_text path);",
  ))
  entries.append(fallibleCollectionOf(
    "File.list",
    "torb_file_list",
    "bool torb_file_list(torb_text path, torb_list *out, torb_text *error);",
  ))
  entries.append(fallibleRuntimeOf(
    "File.absolutePath",
    "torb_file_absolute_path",
    "bool torb_file_absolute_path(torb_text path, torb_text *out, torb_text *error);",
  ))
  // `File` is a `shared type`: the runtime owns its whole representation (`torb_file` in torb.h, header first,
  // retained and released generically like any other counted block, `RuntimeKind.FileHandle` in the IR) and its
  // `torb_drop_function` is `torb_file_drop`, which closes the handle if `close` never ran - so a reference nobody
  // closed does not leak the OS handle either. A `var fn` receiver is its place, `torb_file **`, as for every other
  // type; `readAll` has no parameter named `path`, so the runtime writes that field of the `IoError` too.
  entries.append(fallibleRuntimeOf(
    "File.open",
    "torb_file_open",
    "bool torb_file_open(torb_text path, torb_file **out, torb_text *error);",
  ))
  entries.append(fallibleRuntimeOf(
    "File.readAll",
    "torb_file_read_all",
    "bool torb_file_read_all(torb_file **self, torb_text *out, torb_text *path, torb_text *error);",
  ))
  entries.append runtimeOf("File.close", "torb_file_close", "void torb_file_close(torb_file **self);")
  // The stream side of a file (docs/design/STREAMS.md). `chunks` answers a `Source<Bytes, IoError>` and `add`/`end` are the
  // `Sink` a `File` is, so all three are shared objects the runtime owns; `file.lines()` is TorbScript over `chunks`
  // and needs no native of its own.
  entries.append plannedRuntimeOf("File.create", "torb_file_create", "7.3")
  entries.append plannedRuntimeOf("File.chunks", "torb_file_chunks", "7.3")
  entries.append plannedRuntimeOf("File.add", "torb_file_add", "7.3")
  entries.append plannedRuntimeOf("File.end", "torb_file_end", "7.3")

  entries.append optionalRuntimeOf("readLine", "torb_read_line", "bool torb_read_line(torb_text *out);")
  // The three streams a process is started with, as `Source`/`Sink` objects
  entries.append plannedRuntimeOf("standardInput", "torb_standard_input", "7.3")
  entries.append plannedRuntimeOf("standardOutput", "torb_standard_output", "7.3")
  entries.append plannedRuntimeOf("standardError", "torb_standard_error", "7.3")

  // `mkdir -p`: `torb build` has to create the directory it writes the C and the binary into, and "it is already
  // there" is success - so a caller that only wants a place to write never has to ask first
  entries.append(fallibleRuntimeOf(
    "File.createDirectory",
    "torb_file_create_directory",
    "bool torb_file_create_directory(torb_text path, torb_text *error);",
  ))

  entries.append(collectionRuntimeOf(
    "Process.arguments",
    "torb_process_arguments",
    "torb_list torb_process_arguments(void);",
  ))
  entries.append runtimeOf("Process.exit", "torb_process_exit", "void torb_process_exit(int64_t code);")
  entries.append(optionalRuntimeOf(
    "Process.executablePath",
    "torb_process_executable_path",
    "bool torb_process_executable_path(torb_text *out);",
  ))
  /*
   * The driver runs the C compiler through this. `ProcessOutput` is a record of the *program* with three fields, and the
   * `.Fallible` convention writes the payload of `Ok` through **one** out parameter - so `runBlocking` is TorbScript
   * over `runCollecting`, which answers the exit code and writes the output through a `var` parameter. What is native
   * is starting a process and collecting what it wrote, and nothing else.
   */
  entries.append(runtimeOf(
    "Process.runCollecting",
    "torb_process_run",
    "int64_t torb_process_run(torb_text command, torb_list arguments, torb_text *output, torb_text *failure);",
  ))
  // `Process.run`, the task: the same collection with an input of its own, which is all the child reads
  entries.append(runtimeOf(
    "Process.runFeeding",
    "torb_process_run_feeding",
    "int64_t torb_process_run_feeding(torb_text command, torb_list arguments, torb_text input, torb_text *output, torb_text *failure);",
  ))
  /*
   * And `torb run` runs what it built through this one, which hands the child the three streams this process holds
   * instead of a pipe. Collecting is the wrong shape for a driver: the program would print nothing until it ended,
   * its two streams would arrive merged, and a program that reads standard input would have nothing to read.
   */
  entries.append(runtimeOf(
    "Process.runInheriting",
    "torb_process_run_inheriting",
    "int64_t torb_process_run_inheriting(torb_text command, torb_list arguments, torb_text *failure);",
  ))
  // A child process whose pipes are read and written while it runs: the same `Source`/`Sink` objects a file has
  entries.append plannedRuntimeOf("Process.start", "torb_process_start", "7.3")
  entries.append plannedRuntimeOf("Child.input", "torb_child_input", "7.3")
  entries.append plannedRuntimeOf("Child.output", "torb_child_output", "7.3")
  entries.append plannedRuntimeOf("Child.errors", "torb_child_errors", "7.3")
  entries.append plannedRuntimeOf("Child.wait", "torb_child_wait", "7.3")
  entries.append plannedRuntimeOf("Child.close", "torb_child_close", "7.3")
}

/** `std/math`: everything is a thin wrapper over `<math.h>` in `number.c`, so there is one entry per function. */
fn mathEntries(var entries: List<NativeEntry>) {
  entries.append runtimeOf("power", "torb_math_power", "double torb_math_power(double base, double exponent);")
  entries.append runtimeOf("exponential", "torb_math_exponential", "double torb_math_exponential(double value);")
  entries.append runtimeOf("naturalLog", "torb_math_natural_log", "double torb_math_natural_log(double value);")
  entries.append(runtimeOf(
    "logarithm",
    "torb_math_logarithm",
    "double torb_math_logarithm(double value, double base);",
  ))
  entries.append runtimeOf("sine", "torb_math_sine", "double torb_math_sine(double value);")
  entries.append runtimeOf("cosine", "torb_math_cosine", "double torb_math_cosine(double value);")
  entries.append runtimeOf("tangent", "torb_math_tangent", "double torb_math_tangent(double value);")
  entries.append runtimeOf("arcSine", "torb_math_arc_sine", "double torb_math_arc_sine(double value);")
  entries.append runtimeOf("arcCosine", "torb_math_arc_cosine", "double torb_math_arc_cosine(double value);")
  entries.append runtimeOf("arcTangent", "torb_math_arc_tangent", "double torb_math_arc_tangent(double value);")
  entries.append(runtimeOf(
    "arcTangent2",
    "torb_math_arc_tangent2",
    "double torb_math_arc_tangent2(double y, double x);",
  ))
}

/**
 * `std/time`: `Instant` and `Duration` are records of the program holding an `Int64` of nanoseconds, and everything they
 * do is TorbScript over it. What is native is reading the monotonic clock (`torb_clock_now`, which answers the
 * nanoseconds as an `int64_t`) and waiting.
 */
fn timeEntries(var entries: List<NativeEntry>) {
  entries.append(runtimeOf(
    "monotonicNanoseconds",
    "torb_clock_now",
    "int64_t torb_clock_now(void);",
  ))
  // Monotonic milliseconds from the first reading: the form a tool that measures its own work wants, and two numbers
  // (an `Instant` and a `Duration`) where one does
  entries.append(runtimeOf(
    "Clock.milliseconds",
    "torb_clock_milliseconds",
    "int64_t torb_clock_milliseconds(void);",
  ))
  entries.append runtimeOf("sleep", "torb_sleep", "torb_task *torb_sleep(double seconds);")
}

/**
 * `std/task`, over `runtime/task.c` (docs/CONCURRENCY.md 16). `await()` and `result()` are suspension points the
 * lowering writes in front of the call, and the call reads the answer: both are TorbScript over `finished()`, whose
 * `torb_task_result` is the `.Fallible` convention, and the wrapper builds `Ok(value)` or `Fail(Cancelled())` in the
 * program's layout. `map`, `flatMap`, `Task.all` and `both` are TorbScript over `await()` and `result()`, because the
 * runtime cannot call a closure of a signature it does not know.
 */
fn taskEntries(var entries: List<NativeEntry>) {
  entries.append(fallibleRuntimeOf(
    "Task.finished",
    "torb_task_result",
    "bool torb_task_result(torb_task *task, void *out);",
  ))
  entries.append runtimeOf("cancelTask", "torb_task_cancel", "void torb_task_cancel(torb_task *self);")
  // The pool's size is decided before the first line runs (`TORB_WORKERS`, or the logical processors), so it is read
  entries.append runtimeOf("Workers.count", "torb_workers_count", "int64_t torb_workers_count(void);")
  entries.append runtimeOf("Workers.blocking", "torb_workers_blocking", "int64_t torb_workers_blocking(void);")
  entries.append runtimeOf("pause", "torb_pause", "torb_task *torb_pause(void);")
  // `offload` is TorbScript: this turn to the blocking pool, awaited, and then the body on the thread it moved to
  entries.append runtimeOf("blockingTurn", "torb_blocking_turn", "torb_task *torb_blocking_turn(void);")
  entries.append loweredOf("spawn")
  entries.append loweredOf("stopAsCancelled")
  // `within` is TorbScript over a task of the runtime that says whether the deadline or the task came first
  entries.append(runtimeOf(
    "completedWithin",
    "torb_task_completed_within",
    "torb_task *torb_task_completed_within(torb_task *self, int64_t limit);",
  ))
  // A `Channel` hands out its two ends as `Source`/`Sink` objects, shared types of `std/task` over these four: one task
  // per item each way, because a machine waits for a task and for nothing else
  entries.append(runtimeOf(
    "received",
    "torb_channel_received",
    "torb_task *torb_channel_received(torb_channel *channel);",
  ))
  entries.append(containerRuntimeOf(
    "offered",
    "torb_channel_offered",
    "torb_task *torb_channel_offered(torb_channel *channel, const void *item);",
    [1],
    [1],
    NativeResult.Direct,
  ))
  entries.append runtimeOf("endWriting", "torb_channel_end", "void torb_channel_end(torb_channel *channel);")
  entries.append runtimeOf("closeReading", "torb_channel_close", "void torb_channel_close(torb_channel *channel);")
}

/** `Environment` of `std/os`: the patterns of a sandbox (`environment "APP_*"`) are `runtime/sandbox.c`'s, inside `torb_environment_get`. */
fn environmentEntries(var entries: List<NativeEntry>) {
  entries.append(optionalRuntimeOf(
    "Environment.get",
    "torb_environment_get",
    "bool torb_environment_get(torb_text name, torb_text *out);",
  ))
  // `Environment.variables()` of `std/os` is TorbScript over this: two parallel lists, because the runtime cannot build
  // an `EnvironmentVariables`, and the sandbox filters them the way it filters `get`
  entries.append(runtimeOf(
    "Environment.entries",
    "torb_environment_entries",
    "void torb_environment_entries(torb_list *names, torb_list *values);",
  ))
}

/**
 * The kernel of the bytecode VM (`std/machine`, `runtime/machine.c`, docs/design/VM.md section 6): the functions of the
 * runtime reached with the words of the VM's registers, one word of a counted block, and the constants placed into the
 * registers. Nothing but the VM inside `torb` calls them.
 */
fn machineEntries(var entries: List<NativeEntry>) {
  entries.append(runtimeOf(
    "Machine.operate",
    "torb_machine_operate",
    "int64_t torb_machine_operate(torb_list *words, int64_t base, torb_list code, int64_t at);",
  ))
  entries.append runtimeOf("Machine.load", "torb_machine_load", "int64_t torb_machine_load(int64_t address);")
  entries.append(runtimeOf(
    "Machine.store",
    "torb_machine_store",
    "void torb_machine_store(int64_t address, int64_t value);",
  ))
  entries.append(runtimeOf(
    "Machine.placeText",
    "torb_machine_place_text",
    "void torb_machine_place_text(torb_list *words, int64_t at, torb_text text);",
  ))
  entries.append(runtimeOf(
    "Machine.placeFloat",
    "torb_machine_place_float",
    "void torb_machine_place_float(torb_list *words, int64_t at, double value);",
  ))
  // The kernel keeps the closure until the next one replaces it, so it takes it owned
  entries.append(ownedRuntimeOf(
    "Machine.install",
    "torb_machine_install",
    "void torb_machine_install(torb_closure interpreter);",
    [0],
  ))
}

/** `std/core/src/target.trb`: the three constants of the build, answered by the compiler and never by C. */
fn targetEntries(var entries: List<NativeEntry>) {
  entries.append NativeEntry(name: "targetOperatingSystem", target: NativeTarget.Target(.OperatingSystem))
  entries.append NativeEntry(name: "targetArchitecture", target: NativeTarget.Target(.Architecture))
  entries.append NativeEntry(name: "targetByteOrder", target: NativeTarget.Target(.ByteOrder))
}

/** A function of `runtime/os/<family>.c`, which exists on the operating systems that file is compiled for. */
fn systemRuntimeOf(name: String, function: String, prototype: String, systems: List<TargetSystem>): NativeEntry {
  NativeEntry name: name, target: NativeTarget.Runtime(function), prototype: prototype, availableOn: systems
}

/**
 * The raw layer of `std/os` (docs/design/OS.md section 7): one `native type` per family, each row bound to the systems
 * its C file is compiled on. The prototypes are in `torb_os.h` on every machine, so a signature cannot drift even where
 * the body is not compiled.
 *
 * Every native that can fail answers an outcome (`0` success, `1` failed, `2` denied, `3` missing, `4` unsupported)
 * and writes its answer through `var` parameters, which is the shape `Process.runCollecting` has: `outcome` of
 * `std/os/src/error.trb` turns it into a `Result`, so no row needs a wrapper of the lowering.
 */
fn systemEntries(var entries: List<NativeEntry>) {
  windowsEntries entries
  posixEntries entries
  entries.append(systemRuntimeOf(
    "Linux.readSystemFile",
    "torb_os_linux_read_system_file",
    "int64_t torb_os_linux_read_system_file(torb_text path, torb_text *text, torb_text *failure);",
    [.Linux],
  ))
  entries.append(systemRuntimeOf(
    "Bsd.sysctlText",
    "torb_os_bsd_sysctl_text",
    "int64_t torb_os_bsd_sysctl_text(torb_text name, torb_text *text, torb_text *failure);",
    [.MacOs, .FreeBsd],
  ))
  entries.append(systemRuntimeOf(
    "Bsd.sysctlInteger",
    "torb_os_bsd_sysctl_integer",
    "int64_t torb_os_bsd_sysctl_integer(torb_text name, int64_t *number, torb_text *failure);",
    [.MacOs, .FreeBsd],
  ))
  entries.append(systemRuntimeOf(
    "Bsd.uptime",
    "torb_os_bsd_uptime",
    "int64_t torb_os_bsd_uptime(int64_t *milliseconds, torb_text *failure);",
    [.MacOs, .FreeBsd],
  ))
  entries.append(systemRuntimeOf(
    "MacOs.userTemporaryDirectory",
    "torb_os_macos_user_temporary_directory",
    "int64_t torb_os_macos_user_temporary_directory(torb_text *path, torb_text *failure);",
    [.MacOs],
  ))
}

/** `runtime/os/windows.c`, `native type Windows`. */
fn windowsEntries(var entries: List<NativeEntry>) {
  entries.append(systemRuntimeOf(
    "Windows.tickCount",
    "torb_os_windows_tick_count",
