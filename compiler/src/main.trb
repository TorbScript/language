/**
 * The `torb` command line: one `match` over `Process.arguments()` at the bottom of this file, and one function per
 * subcommand above it - `check`, `build`, `run`, `test`, `new`, `ir`, `natives --header`, `parse`, `tokens`, `ast`,
 * `highlight`, `format`, `lint`, and the `docs` family from `./documentation`. This file has no exported
 * declarations: it is the entry point of the toolchain itself.
 *
 * Compiled, this file **is** `torb`, and `run` and `test` are what make it the driver: a program is built into a cache
 * and started, and a test package is built into one binary and run.
 */

use File, IoError from "std/fs"
use Process from "std/process"
use SourceText, LineIndex from "./syntax/source"
use lex from "./syntax/lexer"
use parse from "./syntax/parser/parser"
use dumpTokens from "./syntax/dump"
use collectSourceFiles from "./cli/files"
use counted, printDiagnostic, printProblem, printErrorMessage, printClean, printProblemCount from "./cli/render"
use printPartialOperations from "./cli/partial"
use readSourceTree, absolutePaths from "./project/read"
use SourceTree from "./project/source-tree"
use check, Checked from "./semantics/check"
use Lowering from "./ir/lower/context"
use lowerChecked, loweredText, loweredProblems, statisticsLines from "./ir/lower/lower"
use BuildOptions, Profile, profileNamed, build, printWarnings from "./cli/build"
use buildEmbedded from "./cli/embed"
use problemsOfEveryTarget from "./cli/targets"
use BuildTarget, everyTarget, targetNamed from "./project/target"
use RunOptions, runProgram from "./cli/run"
use TestOptions, TestShard, TestReport, testShardNamed, runTests, defaultTestPath, testUsage from "./cli/test"
use NewOptions, runNew from "./cli/new"
use InitOptions, runInit from "./cli/init"
use scaffoldChoicesOf from "./cli/template"
use commandUsages, usageOf, colorUsageLines, helpAskedOf from "./cli/usage"
use runManifest from "./cli/manifest"
use runRepl from "./cli/repl"
use insertOwnership from "./ir/ownership"
use entryNameOf from "./ir/lower/function"
use emitBytecode from "./backend/bytecode/emit"
use disassemble from "./backend/bytecode/disassemble"
use renderMachineNatives from "./backend/bytecode/thunks"
use verifyOwnedProgram from "./ir/ownership-verify"
use nativeEntries, renderNativesHeader from "./backend/c/natives"
use runHighlight from "./highlight/command"
use documentationOptionsOf, printDocumentationUsage from "./documentation/command"
use runCheck, runIndex, runSkill, runBundle, runSite, documentationUsageLines from "./documentation/command"
use sourceOptionsOf, runSource from "./documentation/source"
use docOptionsOf, runDoc, printDocUsage, docUsageLines from "./reference/command"
use formatUsage, formatOptionsOf, formatOptionsOfCanon, runFormat from "./format/command"
use lintUsage, lintOptionsOf, runLint from "./lint/command"
use renameUsage, renameOptionsOf, runRename from "./lint/rename-command"
use languageServerUsage, isLanguageServerArguments, startLanguageServer from "./language-server/command"
use debugAdapterUsage, startDebugAdapter from "./debugger/adapter"
use runDebuggee, isDebuggeeArguments from "./debugger/debuggee"
use UpgradeOptions, runUpgrade from "./cli/upgrade"
use packageOptionsOf, runPackageCommand from "./cli/packages"
use languageVersion from "./package/version"
use Role, Stream, colorArguments, paletteFor from "./cli/color"

/** Leaves with the code a command answered, where it is not 0. */
fn exitWith(code: Int) {
  if code != 0 {
    Process.exit code
  }
}

/**
 * Leaves with 2 where an argument that starts with `--` is none of the flags a subcommand takes: read as a path or as the
 * name of a program, it would be looked for and reported as one that does not exist. A path that starts with `--` is
 * written `./--name`.
 */
fn refuseUnknownFlag(arguments: List<String>, known: List<String>) {
  if const Some(flag) = arguments.find({ _.startsWith("--") && !known.contains(_) }) {
    reportUnknownFlag flag
    Process.exit 2
  }
}

fn reportUnknownFlag(flag: String) {
  printErrorMessage "unknown flag {flag}, see `torb --help`"
}

/** What `torb` prints when it is called with no subcommand, or one it does not recognize. */
fn printUsage() {
  printError "torb - the TorbScript toolchain (self-hosted)"
  printError ""
  printError "Usage:"
  for usage in commandUsages() {
    for line in usage.lines {
      printError line
    }
  }
  printError "  torb --version         `torb <version>`: the one number of the toolchain, the language and std"
  printDocUsage()
  printDocumentationUsage()
  printError ""
  for line in colorUsageLines() {
    printError line
  }
}

/**
 * What `torb <command> --help` prints: the usage of that command alone, on standard output, where the command has one
 * - a page of its own, or its block of `torb --help`. `None` for a word that is no command.
 */
fn commandUsageText(command: String): String? {
  match command {
    "test" => testUsage()
    "format" | "canon" => formatUsage()
    "lint" => lintUsage()
    "rename" => renameUsage()
    "lsp" => languageServerUsage()
    "debug" => debugAdapterUsage()
    "doc" => usageText docUsageLines()
    "docs" => usageText documentationUsageLines()
    _ => usageText((usageOf(command)?).lines)
  }
}

/** A block of `torb --help` as the usage of its command, with the flag every command takes. */
fn usageText(lines: List<String>): String {
  var shown = ["Usage:"]
  shown.appendAll lines
  shown.append ""
  shown.appendAll colorUsageLines()
  shown.joined separator: "\n"
}

fn printTokens(path: String): Result<Void, IoError> {
  const text = File.readText(path)?
  for line in dumpTokens(lex(SourceText.of(text))) {
    print line
  }
  Ok(void)
}

/** The generated `Show` of the tree. The bootstrap toolchain prints the same format (`torb ast`). */
fn printTree(path: String): Result<Void, IoError> {
  const text = File.readText(path)?
  const parsed = parse SourceText.of(text)
  print parsed.file
  for diagnostic in parsed.diagnostics {
    print "error {diagnostic.span.start}..{diagnostic.span.end} {diagnostic.message}"
  }
  Ok(void)
}

/** Returns the number of problems. */
fn checkSyntax(paths: List<String>): Result<Int, IoError> {
  const files = collectSourceFiles(paths)?
  var problems = 0
  var filesWithProblems = 0
  for path in files {
    const text = File.readText(path)?
    const parsed = parse SourceText.of(text)
    if parsed.diagnostics.isEmpty() {
      continue
    }
    filesWithProblems = filesWithProblems + 1
    problems = problems + parsed.diagnostics.length()
    const lines = LineIndex.of text
    for diagnostic in parsed.diagnostics {
      printDiagnostic path, lines, diagnostic
      printError ""
    }
  }
  if problems == 0 {
    printClean "{counted(files.length(), "file")}, no problems"
  } else {
    printProblemCount "{counted(problems, "problem")} in {filesWithProblems} of {counted(files.length(), "file")}"
  }
  problems
}

/**
 * Modules, imports, visibility and every name in a type position. Names in expressions are not resolved here: what
 * they mean depends on types, so the type checker resolves and checks them together. Returns the number of problems.
 */
fn checkProjects(
  paths: List<String>,
  withStatistics: Bool,
  withTimings: Bool,
  withEveryTarget: Bool,
  withPartial: Bool = false,
): Result<Int, IoError> {
  const tree = readSourceTree(paths)?
  // Every body is checked where it is lowered afterwards, the imported ones as well
  const checked = check(tree, absolutePaths(paths)?, withTimings, withEveryTarget || withPartial)
  if withTimings {
    printTimings checked
  }
  if withStatistics {
    printStatistics checked, tree
  }
  var problems = checked.problems.length()
  var filesWithProblems = 0
  for problem in checked.problems {
    printProblem problem
  }
  for file in checked.files {
    if file.diagnostics.isEmpty() {
      continue
    }
    filesWithProblems = filesWithProblems + 1
    problems = problems + file.diagnostics.length()
    const lines = LineIndex.of file.text
    for diagnostic in file.diagnostics {
      printDiagnostic file.path, lines, diagnostic
      printError ""
    }
  }
  // A warning is printed after the problems and is none of them: the use of a deprecated declaration checks
  const warnings = printWarnings checked
  const warned = if warnings == 0 { "" } else { ", {counted(warnings, "warning")}" }
  // Nothing checked is not "no problems": a path that reaches no module of any package is a mistake of the command line
  if checked.files.isEmpty() {
    var named: List<String> = []
    for path in paths {
      named.append "`{path}`"
    }
    printErrorMessage "{named.joined(separator: ", ")} holds no TorbScript file to check"
    printError "  a file is checked when it is named, or is one of the files of a project: a `.trb` file below its directory"
    return problems + 1
  }
  if problems == 0 {
    printClean "{counted(checked.files.length(), "file")}, no problems{warned}"
  } else {
    const total = counted checked.files.length(), "file"
    printProblemCount "{counted(problems, "problem")} in {filesWithProblems} of {total}{warned}"
  }
  if withEveryTarget && problems == 0 {
    return checkEveryTarget checked, tree
  }
  // An audit and no error: the partial operations are listed, and the answer is still the problems of the check
  if withPartial && problems == 0 {
    const _ = printPartialOperations checked
  }
  problems
}

/**
 * `--every-target`: the programs and tests of what was checked, lowered once per target and stopped before C. Every
 * error is printed under the target that has it, and the answer is how many there were.
 */
fn checkEveryTarget(checked: Checked, tree: SourceTree): Int {
  const targets = everyTarget()
  var problems = 0
  var failing: List<String> = []
  for found in problemsOfEveryTarget(checked, targets) {
    if found.problems.isEmpty() {
      continue
    }
    failing.append found.target.name()
    printError "{found.target.name()}:"
    for problem in found.problems {
      const module = checked.program.graph.at problem.module
      const lines = LineIndex.of module.source.text
      printDiagnostic tree.display(module.path), lines, problem.diagnostic
      printError ""
      problems = problems + 1
    }
  }
  if problems == 0 {
    printClean "{counted(targets.length(), "target")}, no problems"
  } else {
    const names = failing.joined separator: ", "
    printProblemCount "{counted(problems, "problem")} on {counted(failing.length(), "target")} of {targets.length()}: {names}"
  }
  problems
}

/**
 * How far the type checker has come, per module: how many expressions have a type and how many are still deferred
 * (a generic call, a trait member, a closure body). `--statistics` is what makes "does everything have a type"
 * measurable instead of a feeling.
 */
fn printStatistics(checked: Checked, tree: SourceTree) {
  var typed = 0
  var deferred = 0
  for module in checked.requested {
    const statistics = checked.checker.statisticsOf module
    typed = typed + statistics.typed
    deferred = deferred + statistics.deferred
    const path = tree.display checked.program.graph.at(module).path
    print "{path}: {statistics.typed} typed, {statistics.deferred} deferred"
  }
  const total = typed + deferred
  const share = if total == 0 { 100 } else { typed * 100 / total }
  print "{typed} of {total} expressions typed ({share}%), {deferred} deferred"
}

/**
 * What every pass of the run cost. The checker runs on a tree-walking interpreter, so "which pass got slower" is the
 * question that every change to it raises, and the answer should not need a profiler.
 */
fn printTimings(checked: Checked) {
  var total: Int64 = 0
  for timing in checked.checker.timings {
    total = total + timing.milliseconds
    print "{timing.pass}: {timing.milliseconds} ms"
  }
  print "all passes: {total} ms"
}

/**
 * The typed IR of what the back end lowers today, in the deterministic text format of docs/BACKEND.md 1.7, plus the
 * list of the constructs the back end does not support yet. Returns the number of problems.
 */
fn printIr(
  paths: List<String>,
  onlyStatistics: Bool,
  withOwnership: Bool,
  asBytecode: Bool,
  debugging: Bool = false,
): Result<Int, IoError> {
  const tree = readSourceTree(paths)?
  const checked = check(tree, absolutePaths(paths)?, checksEveryBody: true)
  var problems = checked.problems.length()
  for problem in checked.problems {
    printProblem problem
  }
  for file in checked.files {
    problems = problems + file.diagnostics.length()
    const lines = LineIndex.of file.text
    for diagnostic in file.diagnostics {
      printDiagnostic file.path, lines, diagnostic
      printError ""
    }
  }
  // Nothing is lowered from a program that does not check: every table the lowering reads would be half filled
  if problems > 0 {
    return problems
  }
  var lowering = lowerChecked checked, debugging: debugging
  // Phase one plus ownership is the IR both back ends read; `--no-ownership` shows what the lowering alone writes
  if withOwnership || asBytecode {
    insertOwnership lowering.program
  }
  if asBytecode {
    return printBytecode checked, lowering
  }
  if !onlyStatistics {
    const text = loweredText lowering
    if !text.isEmpty() {
      print text
      print ""
    }
  }
  const found = reportLoweredProblems checked, tree, lowering
  for line in statisticsLines(lowering) {
    print line
  }
  const broken = irProblems lowering, withOwnership
  for line in broken {
    printError "internal error: {line}"
  }
  found + broken.length()
}

/**
 * `torb ir --bytecode`: the final IR encoded for the VM (docs/design/VM.md), disassembled, and every construct the
 * bytecode cannot encode yet on standard error. Returns the number of those.
 */
fn printBytecode(checked: Checked, lowering: Lowering): Int {
  var owned = lowering
  var entries: List<String> = []
  for module in checked.requested {
    entries.append entryNameOf(owned, module)
  }
  const emission = emitBytecode owned.program, entries
  print disassemble(emission.program)
  var found = emission.unsupported.length()
  for blocked in owned.unsupported {
    printErrorMessage "{blocked.what} (at {blocked.at})"
    found = found + blocked.count
  }
  for what in emission.unsupported {
    printErrorMessage "{what}"
  }
  found
}

/** The verifier that fits what was built: the ownership invariants are only checkable once the pass has run. */
fn irProblems(lowering: Lowering, withOwnership: Bool): List<String> {
  if !withOwnership {
    return loweredProblems lowering
  }
  var found = verifyOwnedProgram lowering.program
  for problem in lowering.program.problems {
    found.append problem
  }
  found
}

/** What `--profile` and `--release` said, and every other argument in its order. */
type ProfileChoice {
  profile: Profile
  rest: List<String>
}

/**
 * `--profile dev|release` and its shorthand `--release`, taken off the arguments. `None`, after the error is printed,
 * for a name that is no profile.
 */
fn profileChoiceOf(arguments: List<String>, fallback: Profile): ProfileChoice? {
  var profile = fallback
  var rest: List<String> = []
  var wantsProfile = false
  for argument in arguments {
    if wantsProfile {
      wantsProfile = false
      profile = match profileNamed(argument) {
        Some(named) => named
        None => {
          printErrorMessage "`{argument}` is no profile: the profiles are `dev` and `release`"
          return None
        }
      }
      continue
    }
    if argument == "--profile" {
      wantsProfile = true
      continue
    }
    if argument == "--release" {
      profile = Profile.Release
      continue
    }
    rest.append argument
  }
  if wantsProfile {
    printErrorMessage "`--profile` needs a name: `dev` or `release`"
    return None
  }
  ProfileChoice profile, rest
}

/**
 * Whether an argument of `torb run` or `torb build` is a path rather than the name of a program
 * (docs/design/PROJECT.md section 4): it has a `/` or a `\`, ends in `.trb`, or is `.` or `..`. A program's name
 * is a segment, so the two readings never overlap, and nothing has to be asked of the disk to tell them apart.
 */
fn isPathArgument(argument: String): Bool {
  argument == "." || argument == ".." || argument.contains("/") || argument.contains("\\") || argument.endsWith(".trb")
}

/**
 * `torb build [path | name]... [--profile dev|release] [--emit-c] [--output <file>] [--target <os>-<arch>]`,
 * `release` unless told otherwise: every program below the paths, or the one named.
 */
fn buildOptionsOf(arguments: List<String>): BuildOptions? {
  const choice = profileChoiceOf(arguments, Profile.Release)?
  var paths: List<String> = []
  var onlyC = false
  var embedsMachine = false
  var withTimings = false
  var output = ""
  var wantsOutput = false
  var target: BuildTarget? = None
  var wantsTarget = false
  var program = ""
  for argument in choice.rest {
    if wantsOutput {
      output = argument
      wantsOutput = false
      continue
    }
    if wantsTarget {
      wantsTarget = false
      target = match targetNamed(argument) {
        Some(found) => found
        None => {
          const known = everyTarget().map({ _.name() }).toList().joined(separator: ", ")
          printErrorMessage "`{argument}` is no target: the targets are {known}"
          return None
        }
      }
      continue
    }
    if argument == "--emit-c" {
      onlyC = true
      continue
    }
    if argument == "--embed-vm" {
      embedsMachine = true
      continue
    }
    if argument == "--timings" {
      withTimings = true
      continue
    }
    if argument == "--output" {
      wantsOutput = true
      continue
    }
    if argument == "--target" {
      wantsTarget = true
      continue
    }
    if argument.startsWith("--") {
      reportUnknownFlag argument
      return None
    }
    if isPathArgument(argument) {
      paths.append argument
      continue
    }
    if !program.isEmpty() {
      printErrorMessage "`torb build` builds every program or one of them, and `{program}` and `{argument}` are two"
      printError "  a directory or a file is written as a path: `./{argument}`"
      return None
    }
    program = argument
  }
  if wantsTarget {
    printErrorMessage "`--target` needs a name such as `linux-x64`"
    return None
  }
  const given = if paths.isEmpty() { ["."] } else { paths }
  BuildOptions(
    given,
    onlyC,
    output,
    profile: choice.profile,
    target: target,
    embedsMachine: embedsMachine,
    program: program,
    withTimings: withTimings,
  )
}

/**
 * `torb test [path]... [--native] [--profile dev|release] [--shard k/n | --shards n] [--filter <name>]...
 * [--report json] [--jobs N]`: in the VM unless told otherwise, and a profile says to build natively, because only a
 * binary has one. `--jobs` means nothing here: one program holds every test file, so there is one process whatever the
 * number says. It is accepted and ignored. `--shard 2/4` runs the second of every four files, so several processes can
 * run one suite at once ([TestShard]), and `--shards 4` builds the binary once and runs all four of them at the same
 * time. `--filter` runs the tests of one full name or below it, and `--report json` writes JSON Lines ([TestReport]).
 *
 * The runtime reads `--shard`, `--filter` and `--report` off the command line of the process, each as two arguments -
 * the binary's, and in the VM `torb`'s own - so none of them is taken in the spelling with `=`, and a value is checked
 * here, before anything is built.
 */
fn testOptionsOf(arguments: List<String>): TestOptions? {
  const choice = profileChoiceOf(arguments, Profile.Dev)?
  var paths: List<String> = []
  var wantsJobs = false
  var wantsShard = false
  var wantsShards = false
  var wantsFilter = false
  var wantsReport = false
  var shard: TestShard? = None
  var shards = 1
  var filters: List<String> = []
  var report = TestReport.Human
  var usesMachine = choice.rest.length() == arguments.length()
  for argument in choice.rest {
    if wantsFilter {
      wantsFilter = false
      filters.append argument
      continue
    }
    if wantsReport {
      wantsReport = false
      if argument != "json" {
        printErrorMessage "`--report` takes `json`, the one report besides the human one: `--report json`"
        return None
      }
      report = TestReport.Json
      continue
    }
    if argument == "--filter" {
      wantsFilter = true
      continue
    }
    if argument.startsWith("--filter=") {
      printErrorMessage "the name of a filter is an argument of its own: `--filter \"Group > test\"`"
      return None
    }
    if argument == "--report" {
      wantsReport = true
      continue
    }
    if argument.startsWith("--report=") {
      printErrorMessage "the report is an argument of its own: `--report json`"
      return None
    }
    if wantsJobs {
      wantsJobs = false
      continue
    }
    if wantsShards {
      wantsShards = false
      shards = match Int.tryFrom(argument).ok() {
        Some(count) if count >= 1 => count
        _ => {
          printErrorMessage "`--shards` takes how many processes run the suite, a whole number above zero: `--shards 4`"
          return None
        }
      }
      continue
    }
    if argument == "--shards" {
      wantsShards = true
      continue
    }
    if wantsShard {
      wantsShard = false
      shard = match testShardNamed(argument) {
        Some(found) => found
        None => {
          printErrorMessage "`--shard` takes `<index>/<count>`, an index from 1 to the count: `--shard 2/4`"
          return None
        }
      }
      continue
    }
    if argument == "--shard" {
      wantsShard = true
      continue
    }
    // The runtime reads the shard off the command line as two arguments, the VM inside `torb` as well
    if argument.startsWith("--shard=") {
      printErrorMessage "the shard is an argument of its own: `--shard 2/4`"
      return None
    }
    if argument == "--vm" {
      usesMachine = true
      continue
    }
    if argument == "--native" {
      usesMachine = false
      continue
    }
    if argument == "--jobs" {
      wantsJobs = true
      continue
    }
    if argument.startsWith("--jobs=") {
      continue
    }
    // Not a path: a flag this command does not know, which would otherwise be looked for as a file that does not exist
    if argument.startsWith("--") {
      printErrorMessage "unknown flag {argument}, see `torb test --help`"
      return None
    }
    paths.append argument
  }
  if wantsShard {
    printErrorMessage "`--shard` needs `<index>/<count>`: `--shard 2/4`"
    return None
  }
  if wantsShards {
    printErrorMessage "`--shards` needs how many processes run the suite: `--shards 4`"
    return None
  }
  if wantsFilter {
    printErrorMessage "`--filter` needs the full name of a test or of a group: `--filter \"Group > test\"`"
    return None
  }
  if wantsReport {
    printErrorMessage "`--report` needs what to write: `--report json`"
    return None
  }
  // One stream of events and one summary: the reports of several processes, one after the other, are neither
  if report == TestReport.Json && shards > 1 {
    printErrorMessage "`--report json` runs one process, and `--shards` several: give each process its `--shard k/n`"
    return None
  }
  if shards > 1 && shard.isSome() {
    printErrorMessage "`--shard` runs one shard and `--shards` all of them: give one of the two"
    return None
  }
  // The shards are processes of one binary, and the VM runs inside `torb`
  if shards > 1 && usesMachine {
    printErrorMessage "`--shards` runs a native test binary several times at once: add `--native`"
    return None
  }
  const given = if paths.isEmpty() { [defaultTestPath()] } else { paths }
  TestOptions given, choice.profile, usesMachine, shard, shards, filters: filters, report: report
}

/**
 * `torb run [--vm | --native] [--profile dev|release] [<path> | <name>] [argument]...`: in the VM unless told
 * otherwise; `--native` or a profile builds the program, `dev` unless the profile says `release`. `--vm` with a profile
 * runs the program in the VM in that profile, which decides whether the return trace of `?` is recorded. The flags of
 * `run` come in front of the path, because everything behind it is the program's. Without a path it runs the only
 * program below the working directory, and a name that is no path is a program's (docs/design/PROJECT.md section 4).
 * `None` for a name that is no profile.
 */
fn runOptionsOf(arguments: List<String>): RunOptions? {
  var profile = Profile.Dev
  var usesMachine = true
  // `--vm` or `--native` said where the program runs, and a profile does not say it again
  var chosen = false
  var withTimings = false
  var index = 0
  while index < arguments.length() {
    const argument = arguments[index]
    if argument == "--timings" {
      withTimings = true
      index = index + 1
      continue
    }
    if argument == "--vm" {
      usesMachine = true
      chosen = true
      index = index + 1
      continue
    }
    if argument == "--native" {
      usesMachine = false
      chosen = true
      index = index + 1
      continue
    }
    if argument == "--release" {
      profile = Profile.Release
      if !chosen {
        usesMachine = false
      }
      index = index + 1
      continue
    }
    if argument != "--profile" {
      break
    }
    const name = arguments.get(index + 1) ?? ""
    const choice = profileChoiceOf(["--profile", name], profile)?
    profile = choice.profile
    if !chosen {
      usesMachine = false
    }
    index = index + 2
  }
  const given = arguments.get(index) ?? "."
  // In front of the path every argument is a flag of `run`, behind it the program's own
  if given.startsWith("--") {
    reportUnknownFlag given
    return None
  }
  const rest = arguments.skip(index + 1).toList()
  if isPathArgument(given) {
    return RunOptions given, rest, profile, usesMachine, withTimings
  }
  RunOptions ".", rest, profile, usesMachine, withTimings, program: given
}

/**
 * `torb new <path> [--template <name|url>] [--name ...] [--owner ...] [--ci ...] [--license ...] [--git|--no-git]
 * [--yes] [--offline]`: the path is both the directory `torb new` creates and, unless `--name` says otherwise, the
 * project's name. `None` without a path, or where a flag is wrong - `scaffoldChoicesOf` (`./cli/template`) has
 * already printed why.
 */
fn newOptionsOf(arguments: List<String>): NewOptions? {
  const parsed = match scaffoldChoicesOf(arguments) {
    Ok(found) => found
    Fail(message) => {
      printErrorMessage message
      return None
    }
  }
  refuseUnknownFlag parsed.rest, []
  const path = parsed.rest.first() ?? ""
  if path.isEmpty() {
    printErrorMessage "`torb new` needs a directory to create: `torb new hello`"
    return None
  }
  NewOptions path, parsed.choices
}

/**
 * `torb init [--template <name|url>] [--name ...] [--owner ...] [--ci ...] [--license ...] [--git|--no-git] [--yes]
 * [--offline]`: the same flags as `torb new`, without a path - it fills the current directory.
 */
fn initOptionsOf(arguments: List<String>): InitOptions? {
  const parsed = match scaffoldChoicesOf(arguments) {
    Ok(found) => found
    Fail(message) => {
      printErrorMessage message
      return None
    }
  }
  refuseUnknownFlag parsed.rest, []
  if !parsed.rest.isEmpty() {
    printErrorMessage "`torb init` takes no path: it fills the current directory, `torb new <path>` makes a new one"
    return None
  }
  InitOptions parsed.choices
}

/**
 * `torb upgrade [<version>] [--channel <name>] [--list]`: everything is optional, so `None` only where `--channel`
 * is the last argument and names nothing.
 */
fn upgradeOptionsOf(arguments: List<String>): UpgradeOptions? {
  refuseUnknownFlag arguments, ["--channel", "--list"]
  var version: String? = None
  var channel: String? = None
  var list = false
  var wantsChannel = false
  for argument in arguments {
    if wantsChannel {
      channel = argument
      wantsChannel = false
      continue
    }
    if argument == "--channel" {
      wantsChannel = true
      continue
    }
    if argument == "--list" {
      list = true
      continue
    }
    version = argument
  }
  if wantsChannel {
    return None
  }
  UpgradeOptions version, channel, list
}

/**
 * `torb natives --header [directory]`: the generated half of the contract between the lowering and the runtime
 * (BACKEND 3.7). The header is a pure function of the manifest, so writing it is reading one table and one `writeText` -
 * and `compiler/tests/natives.test.trb` asserts that the file on disk is what this writes, which is what keeps the two
 * sides from drifting without a C compiler error.
 */
fn writeNativesHeader(directory: String): Result<Int, IoError> {
  writeGenerated("{directory}/include/torb_natives.h", renderNativesHeader(nativeEntries()))?
  // The table of thunks the VM calls the runtime through is the same manifest's (docs/design/VM.md section 6)
  writeGenerated("{directory}/machine_natives.c", renderMachineNatives(nativeEntries()))?
  0
}

/** A generated file, written only where it is not what it has to be. */
fn writeGenerated(path: String, rendered: String): Result<Void, IoError> {
  const before = File.readText(path).ok() ?? ""
  if before == rendered {
    print "{path} is current"
    return Ok(void)
  }
  File.writeText(path, rendered)?
  print "wrote {path}"
  Ok(void)
}

/** The errors of the program the lowering found: an overflow or a division by zero in a compile-time constant. */
fn reportLoweredProblems(checked: Checked, tree: SourceTree, lowering: Lowering): Int {
  for problem in lowering.problems {
    const module = checked.program.graph.at problem.module
    const lines = LineIndex.of module.source.text
    printDiagnostic tree.display(module.path), lines, problem.diagnostic
    printError ""
  }
  lowering.problems.length()
}

// `--color` belongs to every command, and `paletteFor` reads it off the command line itself (`./cli/color`): the
// commands match what is left
const arguments = match colorArguments(Process.arguments()) {
  Ok(found) => found.arguments
  Fail(problem) => {
    printErrorMessage problem
    Process.exit 2
  }
}

// `--help` and `-h` belong to every subcommand: its usage, and nothing runs - `torb new --help` made a package called
// `--help`. A path that starts with `-` is written `./-h`
if const Some(command) = helpAskedOf(arguments) {
  if const Some(usage) = commandUsageText(command) {
    print usage
    Process.exit 0
  }
}

match arguments {
  // docs/design/RELEASE.md section 3: one number for the toolchain, the language and the standard library
  ["--version"] => print "{paletteFor(Stream.Output).paint(Role.Emphasis, "torb")} {languageVersion}"
  ["check", ...more] => {
    const flags = ["--statistics", "--timings", "--every-target", "--partial"]
    refuseUnknownFlag more, flags
    const withStatistics = more.contains "--statistics"
    const withTimings = more.contains "--timings"
    const withEveryTarget = more.contains "--every-target"
    const withPartial = more.contains "--partial"
    const given = more.filter({ !flags.contains(_) }).toList()
    const paths = if given.isEmpty() { ["."] } else { given }
    if checkProjects(paths, withStatistics, withTimings, withEveryTarget, withPartial)? > 0 {
      Process.exit 1
    }
  }
  ["build", ...more] => {
    const options = match buildOptionsOf(more) {
      Some(found) => found
      None => Process.exit 2
    }
    const code = if options.embedsMachine { buildEmbedded(options)? } else { build(options)? }
    if code != 0 {
      Process.exit code
    }
  }
  // Everything behind the path is the program's, whatever it looks like: `torb run tool.trb --emit-c` passes
  // `--emit-c` on rather than reading it here
  ["run", ...more] => {
    // Whatever makes the arguments `None` has said what is wrong with them
    const options = match runOptionsOf(more) {
      Some(found) => found
      None => Process.exit 2
    }
    const code = runProgram(options)?
    if code != 0 {
      Process.exit code
    }
  }
  ["test", "help"] => print testUsage()
  ["test", ...more] => {
    const options = match testOptionsOf(more) {
      Some(found) => found
      None => Process.exit 2
    }
    const code = runTests(options)?
    if code != 0 {
      Process.exit code
    }
  }
  // newOptionsOf/initOptionsOf print the specific problem themselves - the usage text changes with every subcommand
  ["new", ...more] => {
    const options = match newOptionsOf(more) {
      Some(found) => found
      None => Process.exit 2
    }
    const code = runNew(options)?
    if code != 0 {
      Process.exit code
    }
  }
  ["init", ...more] => {
    const options = match initOptionsOf(more) {
      Some(found) => found
      None => Process.exit 2
    }
    const code = runInit(options)?
    if code != 0 {
      Process.exit code
    }
  }
  ["upgrade", ...more] => {
    const options = match upgradeOptionsOf(more) {
      Some(found) => found
      None => {
        printUsage()
        Process.exit 2
      }
    }
    const code = runUpgrade options
    if code != 0 {
      Process.exit code
    }
  }
  [command, ...more] if ["add", "remove", "update", "install", "publish", "lock"].contains(command) => {
    const options = match packageOptionsOf(command, more) {
      Ok(found) => found
      Fail(problem) => {
        printErrorMessage "{problem}"
        Process.exit 2
      }
    }
    // Synchronous on purpose: an `await()` anywhere at this top level makes it a task, and the VM that `run` and `test`
    // start refuses to run its scheduler from inside one
    const code = runPackageCommand options
    if code != 0 {
      Process.exit code
    }
  }
  ["repl", ...more] => {
    refuseUnknownFlag more, ["--sandbox"]
    const code = runRepl(more.contains("--sandbox"))?
    if code != 0 {
      Process.exit code
    }
  }
  ["manifest", ...more] => {
    refuseUnknownFlag more, ["--check"]
    const checks = more.contains "--check"
    const given = more.filter({ _ != "--check" }).toList()
    const paths = if given.isEmpty() { ["."] } else { given }
    const code = runManifest(paths, checks)?
    if code != 0 {
      Process.exit code
    }
  }
  ["ir", ...more] => {
    refuseUnknownFlag more, ["--statistics", "--no-ownership", "--bytecode", "--debug"]
    const onlyStatistics = more.contains "--statistics"
    const withOwnership = !more.contains("--no-ownership")
    const asBytecode = more.contains "--bytecode"
    const debugging = more.contains "--debug"
    const given = more.filter({ !_.startsWith("--") }).toList()
    const paths = if given.isEmpty() { ["."] } else { given }
    if printIr(paths, onlyStatistics, withOwnership, asBytecode, debugging)? > 0 {
      Process.exit 1
    }
  }
  ["doc", ...more] => {
    const options = match docOptionsOf(more) {
      Some(found) => found
      None => Process.exit 2
    }
    const code = runDoc(options)?
    if code != 0 {
      Process.exit code
    }
  }
  ["docs", "check", ...more] => {
    if runCheck(documentationOptionsOf(more))? > 0 {
      Process.exit 1
    }
  }
  ["docs", "source", ...more] => {
    if runSource(sourceOptionsOf(more))? > 0 {
      Process.exit 1
    }
  }
  ["docs", "index", ...more] => {
    if runIndex(documentationOptionsOf(more))? > 0 {
      Process.exit 1
    }
  }
  ["docs", "skill", ...more] => {
    if runSkill(documentationOptionsOf(more))? > 0 {
      Process.exit 1
    }
  }
  ["docs", "bundle", ...more] => {
    if runBundle(documentationOptionsOf(more))? > 0 {
      Process.exit 1
    }
  }
  ["docs", "site", ...more] => {
    if runSite(documentationOptionsOf(more))? > 0 {
      Process.exit 1
    }
  }
  ["natives", "--header", ...more] => {
    const given = more.filter({ !_.startsWith("--") }).toList()
    const directory = given.first() ?? "../runtime"
    if writeNativesHeader(directory)? > 0 {
      Process.exit 1
    }
  }
  ["parse", first, ...more] => {
    refuseUnknownFlag([first, ...more], [])
    if checkSyntax([first, ...more])? > 0 {
      Process.exit 1
    }
  }
  ["tokens", path] => printTokens(path)?
  ["ast", path] => printTree(path)?
  ["highlight", "--stdin"] => runHighlight None
  ["highlight", path] => runHighlight path

  ["format", "help"] => print formatUsage()
  ["format", ...more] => {
    match formatOptionsOf(more) {
      Some(options) => exitWith(runFormat(options)?)
      None => {
        printError formatUsage()
        Process.exit 2
      }
    }
  }
  // Retired in milestone 8: every rule it had is a rule of `torb format`, which runs all of them
  ["canon", ...more] => {
    printError "warning: `torb canon` is deprecated: it runs `torb format` now, with every rule of the canon (`--rule` is ignored)"
    match formatOptionsOfCanon(more) {
      Some(options) => exitWith(runFormat(options)?)
      None => {
        printError formatUsage()
        Process.exit 2
      }
    }
  }
  ["debug", "help"] => print debugAdapterUsage()
  // The program's own process, which the adapter starts: `--filter` and `--report` are read by the test runner
  ["debug", "--debuggee", ...more] => {
    if !isDebuggeeArguments(more) {
      printError "error: `torb debug --debuggee` takes `--filter <name>` and `--report json`, see `torb debug --help`"
      Process.exit 2
    }
    exitWith runDebuggee()
  }
  // The adapter runs as tasks once this top level is done, and ends the process itself (`./debugger/adapter`)
  ["debug", ...more] => {
    refuseUnknownFlag more, []
    if !more.isEmpty() {
      printError "error: `torb debug` takes no arguments: a `launch` of the editor names what runs, see `torb debug --help`"
      Process.exit 2
    }
    startDebugAdapter()
  }
  ["lsp", "help"] => print languageServerUsage()
  // The server runs as a task once this top level is done, and ends the process itself (`./language-server/command`)
  ["lsp", ...more] => {
    if !isLanguageServerArguments(more) {
      printError languageServerUsage()
      Process.exit 2
    }
    startLanguageServer()
  }
  ["lint", "help"] => print lintUsage()
  ["lint", ...more] => {
    match lintOptionsOf(more) {
      Some(options) => exitWith(runLint(options)?)
      None => {
        printError lintUsage()
        Process.exit 2
      }
    }
  }
  ["rename", "help"] => print renameUsage()
  ["rename", ...more] => {
    match renameOptionsOf(more) {
      Some(options) => exitWith(runRename(options)?)
      None => {
        printError renameUsage()
        Process.exit 2
      }
    }
  }
  ["--help"] | ["-h"] | ["help"] => printUsage()
  _ => {
    printUsage()
    Process.exit 2
  }
}
