use File, IoError from "std/fs"
use Process from "std/process"
use SourceText, LineIndex from "./syntax/source"
use lex from "./syntax/lexer"
use parse from "./syntax/parser/parser"
use dumpTokens from "./syntax/dump"
use collectSourceFiles from "./cli/files"
use renderDiagnostic from "./cli/render"
use readSourceTree, absolutePaths from "./project/read"
use SourceTree from "./project/source-tree"
use check, Checked from "./semantics/check"
use Lowering from "./ir/lower/context"
use lowerChecked, loweredText, loweredProblems, statisticsLines from "./ir/lower/lower"
use BuildOptions, build from "./cli/build"
use insertOwnership from "./ir/ownership"
use verifyOwnedProgram from "./ir/ownership-verify"

/**
 * The TorbScript toolchain, written in TorbScript. Until it can compile itself it is run by the bootstrap
 * interpreter: `torb run compiler tokens <file>`.
 */
fn printUsage() {
  printError "torb - the TorbScript toolchain (self-hosted)"
  printError ""
  printError "Usage:"
  printError "  torb check [path]...   Check projects, workspaces or single files (default: the current directory)"
  printError "                         --statistics: how many expressions of every file have a type"
  printError "                         --timings: the wall time of every pass, in the order they ran"
  printError "  torb build [path]      Compile an entry file to a native binary through C"
  printError "                         --emit-c: write the C and stop, which needs no C compiler"
  printError "                         --output <file>: where the binary goes (the C is written next to it)"
  printError "  torb ir <path>...      Print the typed IR of what the back end lowers, and what it does not yet"
  printError "                         --statistics: only the counts, without the IR itself"
  printError "                         --no-ownership: the IR the lowering writes, before the ownership pass"
  printError "  torb parse <path>...   Check the syntax of files or directories (recursively, *.trb)"
  printError "  torb tokens <file>     Print the tokens of a file"
  printError "  torb ast <file>        Print the syntax tree of a file"
}

fn printTokens(path: String): Result<Void, IoError> {
  const text = File.readText(path)?
  for line in dumpTokens(lex(SourceText.of(text))) {
    print line
  }
  Ok(Void)
}

/** The generated `Show` of the tree. The bootstrap toolchain prints the same format (`torb ast`). */
fn printTree(path: String): Result<Void, IoError> {
  const text = File.readText(path)?
  const parsed = parse(SourceText.of(text))
  print parsed.file
  for diagnostic in parsed.diagnostics {
    print "error {diagnostic.span.start}..{diagnostic.span.end} {diagnostic.message}"
  }
  Ok(Void)
}

/** Returns the number of problems. */
fn checkSyntax(paths: List<String>): Result<Int, IoError> {
  const files = collectSourceFiles(paths)?
  var problems = 0
  var filesWithProblems = 0
  for path in files {
    const text = File.readText(path)?
    const parsed = parse(SourceText.of(text))
    if parsed.diagnostics.isEmpty() {
      continue
    }
    filesWithProblems = filesWithProblems + 1
    problems = problems + parsed.diagnostics.length()
    const lines = LineIndex.of(text)
    for diagnostic in parsed.diagnostics {
      printError renderDiagnostic(path, lines, diagnostic)
      printError ""
    }
  }
  if problems == 0 {
    print "{files.length()} files, no problems"
  } else {
    printError "{problems} problems in {filesWithProblems} of {files.length()} files"
  }
  Ok(problems)
}

/**
 * Modules, imports, visibility and every name in a type position. Names in expressions are not resolved yet: what
 * they mean depends on types (see docs/ARCHITECTURE.md, milestone 4). Returns the number of problems.
 */
fn checkProjects(paths: List<String>, withStatistics: Bool, withTimings: Bool): Result<Int, IoError> {
  const tree = readSourceTree(paths)?
  const checked = check(tree, absolutePaths(paths)?, withTimings)
  if withTimings {
    printTimings(checked)
  }
  if withStatistics {
    printStatistics(checked, tree)
  }
  var problems = checked.problems.length()
  var filesWithProblems = 0
  for problem in checked.problems {
    printError "error: {problem}"
  }
  for file in checked.files {
    if file.diagnostics.isEmpty() {
      continue
    }
    filesWithProblems = filesWithProblems + 1
    problems = problems + file.diagnostics.length()
    const lines = LineIndex.of(file.text)
    for diagnostic in file.diagnostics {
      printError renderDiagnostic(file.path, lines, diagnostic)
      printError ""
    }
  }
  if problems == 0 {
    print "{checked.files.length()} files, no problems"
  } else {
    printError "{problems} problems in {filesWithProblems} of {checked.files.length()} files"
  }
  Ok(problems)
}

/**
 * How far the type checker has come, per module: how many expressions have a type and how many wait for a later
 * sub-milestone (a generic call, a trait member, a closure body). That is what makes the progress of milestone 4
 * measurable instead of a feeling.
 */
fn printStatistics(checked: Checked, tree: SourceTree) {
  var typed = 0
  var deferred = 0
  for module in checked.requested {
    const statistics = checked.checker.statisticsOf(module)
    typed = typed + statistics.typed
    deferred = deferred + statistics.deferred
    const path = tree.display(checked.program.graph.at(module).path)
    print "{path}: {statistics.typed} typed, {statistics.deferred} deferred"
  }
  const total = typed + deferred
  const share = if total == 0 { 100 } else { typed * 100 / total }
  print "{typed} of {total} expressions typed ({share}%), {deferred} deferred"
}

/**
 * What every pass of the run cost. The checker runs on a tree-walking interpreter, so "which pass got slower" is the
 * question that every change to it raises, and the answer should not need a profiler.
 */
fn printTimings(checked: Checked) {
  var total: Int64 = 0
  for timing in checked.checker.timings {
    total = total + timing.milliseconds
    print "{timing.pass}: {timing.milliseconds} ms"
  }
  print "all passes: {total} ms"
}

/**
 * The typed IR of what the back end lowers today, in the deterministic text format of docs/BACKEND.md 1.7, plus the
 * list of the constructs a later sub-milestone has to replace. Returns the number of problems.
 */
fn printIr(paths: List<String>, onlyStatistics: Bool, withOwnership: Bool): Result<Int, IoError> {
  const tree = readSourceTree(paths)?
  const checked = check(tree, absolutePaths(paths)?)
  var problems = checked.problems.length()
  for problem in checked.problems {
    printError "error: {problem}"
  }
  for file in checked.files {
    problems = problems + file.diagnostics.length()
    const lines = LineIndex.of(file.text)
    for diagnostic in file.diagnostics {
      printError renderDiagnostic(file.path, lines, diagnostic)
      printError ""
    }
  }
  // Nothing is lowered from a program that does not check: every table the lowering reads would be half filled
  if problems > 0 {
    return Ok(problems)
  }
  var lowering = lowerChecked(checked)
  // Phase one plus ownership is the IR both back ends read; `--no-ownership` shows what the lowering alone writes
  if withOwnership {
    insertOwnership(lowering.program)
  }
  if !onlyStatistics {
    const text = loweredText(lowering)
    if !text.isEmpty() {
      print text
      print ""
    }
  }
  const found = reportLoweredProblems(checked, tree, lowering)
  for line in statisticsLines(lowering) {
    print line
  }
  const broken = irProblems(lowering, withOwnership)
  for line in broken {
    printError "internal error: {line}"
  }
  Ok(found + broken.length())
}

/** The verifier that fits what was built: the ownership invariants are only checkable once the pass has run. */
fn irProblems(lowering: Lowering, withOwnership: Bool): List<String> {
  if !withOwnership {
    return loweredProblems(lowering)
  }
  var found = verifyOwnedProgram(lowering.program)
  for problem in lowering.program.problems {
    found.add(problem)
  }
  found
}

/**
 * `torb build [path] [--emit-c] [--output <file>]`. The profiles, the cache and the output path of `project.trb` are
 * milestone 5.13's, so this is the whole command line for now.
 */
fn buildOptionsOf(arguments: List<String>): BuildOptions {
  var paths: List<String> = []
  var onlyC = false
  var output = ""
  var wantsOutput = false
  for argument in arguments {
    if wantsOutput {
      output = argument
      wantsOutput = false
      continue
    }
    if argument == "--emit-c" {
      onlyC = true
      continue
    }
    if argument == "--output" {
      wantsOutput = true
      continue
    }
    paths.add(argument)
  }
  const given = if paths.isEmpty() { ["."] } else { paths }
  BuildOptions(given, onlyC, output)
}

/** The errors of the program the lowering found: an overflow or a division by zero in a compile-time constant. */
fn reportLoweredProblems(checked: Checked, tree: SourceTree, lowering: Lowering): Int {
  for problem in lowering.problems {
    const module = checked.program.graph.at(problem.module)
    const lines = LineIndex.of(module.source.text)
    printError renderDiagnostic(tree.display(module.path), lines, problem.diagnostic)
    printError ""
  }
  lowering.problems.length()
}

match Process.arguments() {
  ["check", ...more] => {
    const withStatistics = more.contains("--statistics")
    const withTimings = more.contains("--timings")
    const given = more.filter({ _ != "--statistics" && _ != "--timings" }).toList()
    const paths = if given.isEmpty() { ["."] } else { given }
    if checkProjects(paths, withStatistics, withTimings)? > 0 {
      Process.exit(1)
    }
  }
  ["build", ...more] => {
    const code = build(buildOptionsOf(more))?
    if code != 0 {
      Process.exit(code)
    }
  }
  ["ir", ...more] => {
    const onlyStatistics = more.contains("--statistics")
    const withOwnership = !more.contains("--no-ownership")
    const given = more.filter({ _ != "--statistics" && _ != "--no-ownership" }).toList()
    const paths = if given.isEmpty() { ["."] } else { given }
    if printIr(paths, onlyStatistics, withOwnership)? > 0 {
      Process.exit(1)
    }
  }
  ["parse", first, ...more] => {
    if checkSyntax([first, ...more])? > 0 {
      Process.exit(1)
    }
  }
  ["tokens", path] => printTokens(path)?
  ["ast", path] => printTree(path)?
  _ => {
    printUsage()
    Process.exit(2)
  }
}
