/**
 * The entry point of the whole front end: [check] walks a `SourceTree` from parsing through name resolution and the
 * type checker, and returns a [Checked] - every requested file with its diagnostics sorted by position, plus the
 * [Checker] itself for a later pass to read.
 */

use Span, SourceText from "../syntax/source"
use Diagnostic from "../syntax/diagnostic"
use parse from "../syntax/parser/parser"
use normalizePath, isInside, joinPath from "../project/path"
use SourceTree from "../project/source-tree"
use Workspace, Package, findWorkspace from "../project/workspace"
use ModuleId from "./module"
use SymbolId from "./symbols"
use Graph, buildGraph, resolveImport, programPackagesOf from "./graph"
use RuntimeScript from "./scripts"
use Program, resolveNames, checkNames from "./scope"
use resolveTypes from "./resolve-types"
use Checker, Timing from "./checker/context"
use checkTypes, Stopwatch from "./checker/check"

/** One file that was checked, with everything that is wrong in it, sorted by position. */
public type CheckedFile {
  /** The path the way it is shown to the user, relative to where the toolchain was started */
  path: String
  text: String
  diagnostics: List<Diagnostic>
}

/** What `torb check` found, and the tables the type checker built while finding it. */
public type Checked {
  program: Program
  /** Sorted by path, and inside of a file by position: the same input always gives the same output */
  files: List<CheckedFile>
  /** Problems that belong to no file, such as a prelude package that is not there */
  problems: List<String>
  /** Every name in a type position, one entry per module of `program.graph`, by the span of the name */
  resolutions: List<Map<Span, SymbolId>>
  /** The modules the paths pointed at, which are the ones that were checked and reported */
  requested: List<ModuleId>
  /** What the type checker knows: every type by id, the type of every type position, and every signature it built */
  checker: Checker
}

/**
 * Checks everything the paths point at: a workspace root (all of its members), a single project, or a script that
 * belongs to no project. Everything around it is loaded as well, because that is where the imports lead, but only
 * what was asked for is reported.
 *
 * This is a pure function of the `SourceTree`, so a test builds a project in memory and checks it.
 *
 * `scripts` are files a program run by the VM loads from paths only known while it runs, each checked against the
 * receiver it names and reported as a requested file (docs/design/SCRIPTS.md slice 7). `onlyReached` parses the packages
 * the program of the paths reaches and nothing else (`buildGraph`), which is what a run needs.
 */
public fn check(
  tree: SourceTree,
  paths: List<String>,
  withTimings: Bool = false,
  checksEveryBody: Bool = false,
  scripts: List<RuntimeScript> = [],
  onlyReached: Bool = false,
): Checked {
  var clock = Stopwatch withTimings
  clock.start()
  var before: List<Timing> = []
  const targets = paths.map(normalizePath).toList()
  var packages: List<Package> = []
  var problems: List<String> = []
  for path in targets {
    const found = findWorkspace tree, path
    problems.appendAll found.problems
    for package in found.packages {
      addPackage packages, package
    }
  }
  const workspace = Workspace packages, listedFiles: tree.listedPaths()
  before.append Timing("finding the workspace", clock.taken())
  // `torb run`: the packages of the program alone, so a scratch file in a checkout does not parse the whole checkout
  const reachedFrom = if onlyReached { Some targets } else { None }
  const graph = buildGraph tree, workspace, scripts, reachedFrom
  before.append Timing("lexing, parsing and the module graph", clock.taken())
  const program = resolveNames graph, workspace
  problems.appendAll program.problems
  before.append Timing("name resolution", clock.taken())

  // Every module, not only the requested ones: the type checker looks a name of an imported module up the same way
  var symbols = program.symbols
  var resolutions: List<Map<Span, SymbolId>> = []
  var unresolved: List<List<Diagnostic>> = []
  var requested: List<ModuleId> = []
  for module in graph.modules {
    const resolved = resolveTypes symbols, program, module.id
    resolutions.append resolved.names
    unresolved.append resolved.diagnostics
    if isRequested(targets, module.path) || scripts.any({ _.path == module.path }) {
      requested.append module.id
    }
  }
  before.append Timing("names in type positions", clock.taken())
  const reported = withRelativeImports graph, workspace, requested
  const resolvedProgram = program.copy symbols: symbols
  // A lowering may reach the body of any module of the program - a default member of a trait of `std/prelude`, a
  // generic function of another package - and a body whose tables were never filled cannot be lowered at all. The
  // program is the packages the lowering itself closes the world over (`programPackagesOf`), never more: a scratch file
  // at the root of a large workspace does not check the bodies of every member. What is *reported* stays what was asked
  // for either way, because `files` below is filtered by the request and not by this
  const bodies = if checksEveryBody { modulesOfProgram graph, workspace, reported } else { reported }
  var checked = checkTypes resolvedProgram, resolutions, bodies, withTimings
  // The passes before the checker existed cannot be recorded on it as they run, so they are put in front here
  if withTimings {
    checked.timings = before.appendedAll checked.timings
  }

  var isReported: Set<Int> = Set.of()
  for module in reported {
    isReported.insert module.value
  }
  var files: List<CheckedFile> = []
  for module in graph.modules {
    if !isReported.contains(module.id.value) {
      continue
    }
    var diagnostics = module.diagnostics
    // What is wrong with the `String` reading of a literal is no problem where the checker read the literal verbatim
    for deferred in module.deferred {
      if !checked.isReadVerbatim(module.id, deferred.literal) {
        diagnostics.append deferred.diagnostic
      }
    }
    diagnostics.appendAll checkNames(resolvedProgram, module.id)
    diagnostics.appendAll unresolved[module.id.value]
    diagnostics.appendAll checked.diagnostics[module.id.value]
    diagnostics.sort({ (_.span.start, _.span.end) })
    files.append CheckedFile(tree.display(module.path), module.source.text, diagnostics)
  }
  // A `project.trb` that is a receiver script is a module and was reported above; without `std/project` there is no
  // type to check it against, and then only what the parser found about it is reported
  for package in packages {
    const manifest = joinPath package.directory, "project.trb"
    if isRequested(targets, manifest) && graph.moduleAt(manifest).isNone() {
      if const Some(text) = tree.text(manifest) {
        const parsed = parse SourceText.of(text)
        const deferred = parsed.deferred.map({ _.diagnostic }).toList()
        files.append CheckedFile(tree.display(manifest), text, parsed.diagnostics.appendedAll(deferred))
      }
    }
  }
  files.sort({ _.path })
  Checked resolvedProgram.copy(symbols: checked.symbols), files, problems, resolutions, requested, checked
}

/**
 * Adds one package `findWorkspace` found to the ones already collected, merging it into an existing package of the
 * same directory rather than dropping it outright.
 *
 * A real project always answers the same [Package] for every path inside it, so merging changes nothing there. A
 * standalone script is different: `findWorkspace` gives every one of them its own single-file package, named "" and
 * rooted at the script's own directory, so two scratch files that sit next to each other - `torb check a.trb b.trb`
 * outside of any project - produce two packages with the very same `directory`. Dropping the second of them, which is
 * what comparing only `directory` used to do, silently stopped checking every named file after the first one that
 * shared a directory with another.
 */
fn addPackage(var packages: List<Package>, package: Package) {
  var index = 0
  while index < packages.length() {
    if packages[index].directory == package.directory {
      var files = packages[index].files
      for file in package.files {
        if !files.contains(file) {
          files.append file
        }
      }
      packages.set index, packages[index].copy(files: files)
      return
    }
    index = index + 1
  }
  packages.append package
}

/**
 * The requested modules plus every module they import through a relative path, transitively: the files of the program
 * itself. `torb check main.trb` checks and reports `./helper.trb` too, because a problem there - top-level code in a
 * file that is imported, a body that does not type check - is a problem of the program that was named. An import of
 * another package, `std/` included, is loaded and not reported: that package is checked on its own.
 */
fn withRelativeImports(graph: Graph, workspace: Workspace, requested: List<ModuleId>): List<ModuleId> {
  var found = requested
  var known: Set<Int> = Set.of()
  for module in requested {
    known.insert module.value
  }
  var index = 0
  while index < found.length() {
    const module = graph.at found[index]
    index = index + 1
    for statement in module.file.statements {
      if const .Declare(declaration) = statement.kind {
        if const .Use(usage) = declaration.kind {
          if const .Module(path) = usage.source {
            if !path.startsWith("./") && !path.startsWith("../") {
              continue
            }
            if const .Found(target) = resolveImport(graph, workspace, module.id, path) {
              if !known.contains(target.value) {
                known.insert target.value
                found.append target
              }
            }
          }
        }
      }
    }
  }
  found
}

/** Every module of the packages the program of `roots` is made of. */
public fn modulesOfProgram(graph: Graph, workspace: Workspace, roots: List<ModuleId>): List<ModuleId> {
  const packages = programPackagesOf graph, workspace, roots
  var found: List<ModuleId> = []
  for module in graph.modules {
    if packages.containsKey(module.package) {
      found.append module.id
    }
  }
  found
}

/** Only what the command line pointed at is reported; the rest is loaded because the imports lead there. */
fn isRequested(targets: List<String>, path: String): Bool {
  targets.any({ isInside path, _ })
}
