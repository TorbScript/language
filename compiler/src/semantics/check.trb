/**
 * The entry point of the whole front end: [check] walks a `SourceTree` from parsing through name resolution and the
 * type checker, and returns a [Checked] - every requested file with its diagnostics sorted by position, plus the
 * [Checker] itself for a later pass to read.
 */

use Span, SourceText from "../syntax/source"
use Diagnostic from "../syntax/diagnostic"
use parse from "../syntax/parser/parser"
use normalizePath, isInside, joinPath from "../project/path"
use SourceTree from "../project/source-tree"
use Workspace, Package, findWorkspace from "../project/workspace"
use ModuleId from "./module"
use SymbolId from "./symbols"
use buildGraph from "./graph"
use Program, resolveNames, checkNames from "./scope"
use resolveTypes from "./resolve-types"
use Checker, Timing from "./checker/context"
use checkTypes, Stopwatch from "./checker/check"

/** One file that was checked, with everything that is wrong in it, sorted by position. */
public type CheckedFile {
  /** The path the way it is shown to the user, relative to where the toolchain was started */
  path: String
  text: String
  diagnostics: List<Diagnostic>
}

/** What `torb check` found, and the tables the type checker built while finding it. */
public type Checked {
  program: Program
  /** Sorted by path, and inside of a file by position: the same input always gives the same output */
  files: List<CheckedFile>
  /** Problems that belong to no file, such as a prelude package that is not there */
  problems: List<String>
  /** Every name in a type position, one entry per module of `program.graph`, by the span of the name */
  resolutions: List<Map<Span, SymbolId>>
  /** The modules the paths pointed at, which are the ones that were checked and reported */
  requested: List<ModuleId>
  /** What the type checker knows: every type by id, the type of every type position, and every signature it built */
  checker: Checker
}

/**
 * Checks everything the paths point at: a workspace root (all of its members), a single project, or a script that
 * belongs to no project. Everything around it is loaded as well, because that is where the imports lead, but only
 * what was asked for is reported.
 *
 * This is a pure function of the `SourceTree`, so a test builds a project in memory and checks it.
 */
public fn check(
  tree: SourceTree,
  paths: List<String>,
  withTimings: Bool = false,
  checksEveryBody: Bool = false,
): Checked {
  var clock = Stopwatch withTimings
  clock.start()
  var before: List<Timing> = []
  const targets = paths.map(normalizePath).toList()
  var packages: List<Package> = []
  var problems: List<String> = []
  for path in targets {
    const found = findWorkspace tree, path
    problems.addAll found.problems
    for package in found.packages {
      if !packages.any({ _.directory == package.directory }) {
        packages.add package
      }
    }
  }
  const workspace = Workspace packages
  before.add Timing("finding the workspace", clock.taken())
  const graph = buildGraph tree, workspace
  before.add Timing("lexing, parsing and the module graph", clock.taken())
  const program = resolveNames graph, workspace
  problems.addAll program.problems
  before.add Timing("name resolution", clock.taken())

  // Every module, not only the requested ones: the type checker looks a name of an imported module up the same way
  var symbols = program.symbols
  var resolutions: List<Map<Span, SymbolId>> = []
  var unresolved: List<List<Diagnostic>> = []
  var requested: List<ModuleId> = []
  var everything: List<ModuleId> = []
  for module in graph.modules {
    const resolved = resolveTypes symbols, program, module.id
    resolutions.add resolved.names
    unresolved.add resolved.diagnostics
    everything.add module.id
    if isRequested(targets, module.path) {
      requested.add module.id
    }
  }
  before.add Timing("names in type positions", clock.taken())
  const resolvedProgram = program.copy symbols: symbols
  // A lowering may reach the body of any module - a default member of a trait of `std/prelude`, a generic function of
  // another package - and a body whose tables were never filled cannot be lowered at all. What is *reported* stays what
  // was asked for either way, because `files` below is filtered by the request and not by this
  const bodies = if checksEveryBody { everything } else { requested }
  var checked = checkTypes resolvedProgram, resolutions, bodies, withTimings
  // The passes before the checker existed cannot be recorded on it as they run, so they are put in front here
  if withTimings {
    checked.timings = before.addedAll checked.timings
  }

  var files: List<CheckedFile> = []
  for module in graph.modules {
    if !isRequested(targets, module.path) {
      continue
    }
    var diagnostics = module.diagnostics
    diagnostics.addAll checkNames(resolvedProgram, module.id)
    diagnostics.addAll unresolved[module.id.value]
    diagnostics.addAll checked.diagnostics[module.id.value]
    diagnostics.sort({ (_.span.start, _.span.end) })
    files.add CheckedFile(tree.display(module.path), module.source.text, diagnostics)
  }
  // A `project.trb` that is a receiver script is a module and was reported above; without `std/project` there is no
  // type to check it against, and then only what the parser found about it is reported
  for package in packages {
    const manifest = joinPath package.directory, "project.trb"
    if isRequested(targets, manifest) && graph.moduleAt(manifest).isNone() {
      if const Some(text) = tree.text(manifest) {
        files.add CheckedFile(tree.display(manifest), text, parse(SourceText.of(text)).diagnostics)
      }
    }
  }
  files.sort({ _.path })
  Checked resolvedProgram.copy(symbols: checked.symbols), files, problems, resolutions, requested, checked
}

/** Only what the command line pointed at is reported; the rest is loaded because the imports lead there. */
fn isRequested(targets: List<String>, path: String): Bool {
  targets.any({ isInside path, _ })
}
