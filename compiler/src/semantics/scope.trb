/**
 * The names of every module of a workspace: [resolveNames] turns declarations and `use`s into a [Program], one
 * [ModuleScope] per module, and [checkNames] reports what is wrong about a file's own top-level names and imports.
 * A [MemberImport] is the special case of `use String.shout from "acme/text"`, a member another package attaches to
 * a type it does not own.
 *
 * Imports are resolved to a fixpoint (`Binder.bindToFixpoint`), because re-export chains and cyclic imports are both
 * legal: nothing runs when a module is imported, so a cycle is a reason not to recurse, never an error.
 */

use Span from "../syntax/source"
use Diagnostic from "../syntax/diagnostic"
use Name, Visibility, UseDeclaration, UseItem, Member from "../syntax/ast"
use Workspace from "../project/workspace"
use joinPath from "../project/path"
use ModuleId, Module from "./module"
use SymbolId, SymbolKind, Symbol, Symbols, Definition, declareModule from "./symbols"
use Graph, resolveImport from "./graph"
use specifierOf from "../package/specifier"

/**
 * `use String.shout from "acme/text"`: a member another package attaches to a type it does not own.
 *
 * Such a member is an import like any other, but it lives in the namespace of its type and not in the file's own - two
 * types may well have a member of the same name - so it is kept apart from `ModuleScope.names`. The **owner** is
 * resolved in the scope of the importing file (`String` comes from the prelude, not from `acme/text`), and the `from`
 * names the package the member has to come from.
 */
public type MemberImport {
  /** The type or trait the member hangs on */
  owner: SymbolId
  /** The name the member is declared under: `use String.shout as yell` imports `shout` under the name `yell` */
  name: String
  /** The package the `from` pointed at */
  package: Int
  /** The path that was written, for the message about a member that is not there */
  path: String
  /** The span of the item, which is what a message about this import points at */
  span: Span
}

/** `"{owner}.{local name}"`: how an imported member is kept, because the name alone belongs to no namespace. */
public fn memberImportKey(owner: SymbolId, name: String): String {
  "{owner.value}.{name}"
}

/** The first letter decides what a segment of a `use` path is: a case starts uppercase, a member lowercase. */
fn startsUpperCase(text: String): Bool {
  match text.chars().first() {
    Some(first) => first >= 'A' && first <= 'Z'
    None => false
  }
}

/** The names of one module: everything it can see, and the part of that other modules may import. */
public type ModuleScope {
  var names: Map<String, SymbolId> = [:]
  /** The `public` declarations and everything a `public use` re-exports */
  var exported: Map<String, SymbolId> = [:]
  /**
   * The members of foreign types this file named, by `memberImportKey`. A list, because two imports of one name for one
   * type are an ambiguity **at the use** and not at the import - which is where `as` is the fix.
   */
  var members: Map<String, List<MemberImport>> = [:]
  /** What a `public use` of a member hands on, so that a prelude can re-export one */
  var exportedMembers: Map<String, List<MemberImport>> = [:]
}

/**
 * A program as the front end knows it. Everything program-wide is here, by id: this is what `torb check` produces and
 * what the type checker starts from.
 */
public type Program {
  workspace: Workspace
  graph: Graph
  symbols: Symbols
  /** One per module, in the order of `graph.modules` */
  scopes: List<ModuleScope>
  /** The names a module declares itself, one list per module, in source order */
  definitions: List<List<Definition>>
  /** The `src/lib.trb` of the prelude of every package, in the order of `workspace.packages` */
  preludeModules: List<ModuleId?>
  /** The names the language provides itself. A file that declares one of them shadows it, like a prelude name. */
  builtins: Map<String, SymbolId>
  /** Problems that belong to no file: a prelude package that is not there */
  problems: List<String>

  /** The names the prelude of the package of this module adds. */
  fn preludeOf(id: ModuleId): Map<String, SymbolId> {
    match preludeModules[graph.at(id).package] {
      Some(prelude) => scopes[prelude.value].exported
      None => [:]
    }
  }

  fn lookUp(id: ModuleId, name: String): SymbolId? {
    if const Some(symbol) = scopes[id.value].names.get(name) {
      return symbol
    }
    builtins.get name
  }

  /** What `use String.shout from "acme/text"` brought into this file for `owner` under the name `name`. */
  fn memberImportsOf(id: ModuleId, owner: SymbolId, name: String): List<MemberImport> {
    scopes[id.value].members.get(memberImportKey(owner, name)) ?? []
  }

  /** Whether this file named any member of `owner` that comes from `package`. */
  fn importsMemberFrom(id: ModuleId, owner: SymbolId, package: Int): Bool {
    for (_, entries) in scopes[id.value].members {
      for entry in entries {
        if entry.owner == owner && entry.package == package {
          return true
        }
      }
    }
    false
  }
}

/**
 * The names of every module: its own declarations, what it imports, and the public names of its prelude.
 *
 * Re-exports form chains (`lib.trb` of a package is usually nothing but `public use`) and imports may be cyclic, so
 * the imports are bound to a fixpoint. That is sound because nothing runs when a module is imported: a cycle is a
 * reason not to recurse, never an error.
 */
public fn resolveNames(graph: Graph, workspace: Workspace): Program {
  var symbols = Symbols()
  var builtins: Map<String, SymbolId> = [:]
  // `Void` has exactly one value, `Never` is the type of what does not return. Everything else a program can name
  // is declared somewhere - `Int`, `String` and `List` are the prelude, not the language.
  for name in ["Void", "Never"] {
    builtins.set name, symbols.add(Symbol(name, SymbolKind.Builtin, public: true, module: None, span: Span(0, 0)))
  }
  var definitions: List<List<Definition>> = []
  var scopes: List<ModuleScope> = []
  for module in graph.modules {
    const declared = declareModule symbols, module
    var scope = ModuleScope()
    for definition in declared {
      if !scope.names.containsKey(definition.name) {
        scope.names.set definition.name, definition.symbol
        if symbols.at(definition.symbol).public {
          scope.exported.set definition.name, definition.symbol
        }
      }
    }
    definitions.append declared
    scopes.append scope
  }

  var problems: List<String> = []
  var preludeModules: List<ModuleId?> = []
  for package in workspace.packages {
    const name = package.manifest.prelude
    var found: ModuleId? = None
    if const Some(prelude) = workspace.packageNamed(name) {
      found = graph.moduleAt joinPath(prelude.directory, "src/lib.trb")
    }
    if found.isNone() && !name.isEmpty() {
      problems.append "The prelude package `{name}` of {package.directory} was not found"
    }
    preludeModules.append found
  }

  var binder = Binder graph, workspace, preludeModules, symbols, scopes
  binder.bindToFixpoint()
  binder.addPreludes()
  Program workspace, graph, binder.symbols, binder.scopes, definitions, preludeModules, builtins, problems
}

/** Binds the imports of every module, over and over until nothing changes anymore. */
type Binder {
  graph: Graph
  workspace: Workspace
  preludeModules: List<ModuleId?>
  var symbols: Symbols
  var scopes: List<ModuleScope>
  var changed: Bool = false

  var fn bindToFixpoint() {
    changed = true
    while changed {
      changed = false
      for index in 0..scopes.length() {
        bindImports ModuleId(index)
      }
    }
  }

  /**
   * The prelude comes last: an import of a name the prelude also has shadows it, and so does a declaration of the
   * file. Adding it during the fixpoint would make the prelude win instead.
   */
  var fn addPreludes() {
    for index in 0..scopes.length() {
      // The fields are read directly: this method already holds `self` by `var`, so a call of a `self` method here
      // would need to hold it again
      const package = graph.at(ModuleId(index)).package
      const source = match preludeModules[package] {
        Some(prelude) => scopes[prelude.value]
        None => {
          continue
        }
      }
      var scope = scopes[index]
      for (name, symbol) in source.exported {
        if !scope.names.containsKey(name) {
          scope.names.set name, symbol
        }
      }
      // `public use Int64.seconds from "std/time"`: what the prelude re-exports is named in every file of the package
      for (key, entries) in source.exportedMembers {
        var here = scope.members.get(key) ?? []
        for entry in entries {
          if !here.any({ _.package == entry.package && _.name == entry.name }) {
            here.append entry
          }
        }
        scope.members.set key, here
      }
      scopes.set index, scope
    }
  }

  fn preludeNamesOf(id: ModuleId): Map<String, SymbolId> {
    match preludeModules[graph.at(id).package] {
      Some(prelude) => scopes[prelude.value].exported
      None => [:]
    }
  }

  /** The name as the module sees it while the imports are being bound: its own names, then those of its prelude. */
  fn visibleName(id: ModuleId, name: String): SymbolId? {
    if const Some(symbol) = scopes[id.value].names.get(name) {
      return symbol
    }
    preludeNamesOf(id).get(name)
  }

  var fn bind(id: ModuleId, name: String, symbol: SymbolId, isPublic: Bool) {
    if name.isEmpty() {
      return
    }
    var scope = scopes[id.value]
    var hasChanged = false
    if !scope.names.containsKey(name) {
      scope.names.set name, symbol
      hasChanged = true
    }
    if isPublic && !scope.exported.containsKey(name) {
      scope.exported.set name, symbol
      hasChanged = true
    }
    if hasChanged {
      scopes.set id.value, scope
      changed = true
    }
  }

  var fn bindImports(id: ModuleId) {
    for statement in graph.at(id).file.statements {
      if const .Declare(declaration) = statement.kind {
        if const .Use(usage) = declaration.kind {
          bindOne(id, usage, declaration.modifiers.visibility == Visibility.Public)
        }
      }
    }
  }

  /** An imported member, if it is not there yet. The key keeps the type apart, so only the pair decides. */
  var fn bindMember(id: ModuleId, key: String, entry: MemberImport, isPublic: Bool) {
    var scope = scopes[id.value]
    var hasChanged = false
    var here = scope.members.get(key) ?? []
    if !here.any({ _.package == entry.package && _.name == entry.name }) {
      here.append entry
      scope.members.set key, here
      hasChanged = true
    }
    if isPublic {
      var exported = scope.exportedMembers.get(key) ?? []
      if !exported.any({ _.package == entry.package && _.name == entry.name }) {
        exported.append entry
        scope.exportedMembers.set key, exported
        hasChanged = true
      }
    }
    if hasChanged {
      scopes.set id.value, scope
      changed = true
    }
  }

  /**
   * `use String.shout from "acme/text"`: the path names no case and no export, so it names a **member** that the
   * package of the module attaches to the type. The type is resolved in the scope of the importing file - `String`
   * comes from the prelude, not from `acme/text` - and a module that re-exports such an import hands its entries on.
   */
  var fn bindMemberImport(id: ModuleId, target: ModuleId, path: String, item: UseItem, isPublic: Bool) {
    if item.path.length() < 2 {
      return
    }
    // The first letter decides which of the two a path names: a case starts uppercase, a member lowercase. So
    // `use Option.Maybe from "std/core"` stays "`Option` has no case `Maybe`" and never becomes a missing member
    if startsUpperCase(item.name().text) {
      return
    }
    const owner = match ownerOfPath(id, item.path) {
      Some(found) => found
      None => {
        return
      }
    }
    const key = memberImportKey owner, item.localName().text
    // A re-export chain: `use Int64.seconds from "std/prelude"` hands on what the prelude itself imported
    const handedOn = scopes[target.value].exportedMembers.get(memberImportKey(owner, item.name().text)) ?? []
    if !handedOn.isEmpty() {
      for entry in handedOn {
        bindMember id, key, entry.copy(span: item.name().span), isPublic
      }
      return
    }
    const package = graph.at(target).package
    bindMember id, key, MemberImport(owner, item.name().text, package, path, item.name().span), isPublic
  }

  var fn bindOne(id: ModuleId, usage: UseDeclaration, isPublic: Bool) {
    match usage.source {
      .Module(path) => {
        if const .Found(target) = resolveImport(graph, workspace, id, path) {
          match usage.items {
            .Names(items) => {
              for item in items {
                const start = scopes[target.value].exported.get(item.path[0].text)
                if const Some(symbol) = walkPath(start, item.path) {
                  bind id, item.localName().text, symbol, isPublic
                  continue
                }
                bindMemberImport id, target, path, item, isPublic
              }
            }
            .All(alias) => {
              if !scopes[id.value].names.containsKey(alias.text) && !alias.text.isEmpty() {
                const symbol = symbols.add Symbol(alias.text, SymbolKind.Namespace(target), isPublic, id, alias.span)
                bind id, alias.text, symbol, isPublic
              }
            }
          }
        }
      }
      // `use Shape.Circle`: no module, so the path starts in this file's own scope
      .Local => {
        if const .Names(items) = usage.items {
          for item in items {
            const start = visibleName id, item.path[0].text
            if const Some(symbol) = walkPath(start, item.path) {
              bind id, item.localName().text, symbol, isPublic
            }
          }
        }
      }
    }
  }

  /**
   * `String` of `use String.shout from "..."`: every segment but the last, resolved in the scope of the importing file.
   * `None` when it does not name a type or a trait, because nothing else has members.
   */
  fn ownerOfPath(id: ModuleId, path: List<Name>): SymbolId? {
    var current = visibleName(id, path[0].text)?
    for index in 1..path.length() - 1 {
      current = stepInto(current, path[index].text)?
    }
    match symbols.at(current).kind {
      .Type | .Trait => current
      _ => None
    }
  }

  /** `Option.Some`, `shapes.Shape.Circle`: the remaining segments of a `use` path, from the symbol the first one named. */
  fn walkPath(start: SymbolId?, path: List<Name>): SymbolId? {
    var current = start?
    for index in 1..path.length() {
      current = stepInto(current, path[index].text)?
    }
    current
  }

  /** One step of a `use` path: a name a namespace exports, or a case of a type. Nothing else has names of its own. */
  fn stepInto(owner: SymbolId, name: String): SymbolId? {
    match symbols.at(owner).kind {
      .Namespace(module) => scopes[module.value].exported.get(name)
      .Type => symbols.caseNamed owner, name
      _ => None
    }
  }
}

/**
 * Everything that can be wrong about the top-level names of a file: a name twice, an import of something that is not
 * there, and a `use` of a module or package that is not there. Names in type positions are `resolve-types.trb`.
 */
public fn checkNames(program: Program, id: ModuleId): List<Diagnostic> {
  var diagnostics: List<Diagnostic> = []
  var declared: Set<String> = Set.of()
  for definition in program.definitions[id.value] {
    if declared.contains(definition.name) {
      diagnostics.append(
        Diagnostic.error("`{definition.name}` is already declared in this file", definition.span)
          .withNote("Two top-level declarations of a file cannot have the same name, even when neither is `public`"),
      )
      continue
    }
    declared.insert definition.name
  }
  var imported: Set<String> = Set.of()
  for statement in program.graph.at(id).file.statements {
    if const .Declare(declaration) = statement.kind {
      if const .Use(usage) = declaration.kind {
        checkImport program, id, usage, declaration.span, declared, imported, diagnostics
      }
    }
  }
  diagnostics
}

fn checkImport(
  program: Program,
  id: ModuleId,
  usage: UseDeclaration,
  at: Span,
  declared: Set<String>,
  var imported: Set<String>,
  var diagnostics: List<Diagnostic>,
) {
  match usage.source {
    .Module(path) => {
      // The parser writes an empty path where the `use` was broken already, and it said so
      if path.isEmpty() {
        return
      }
      const target = match resolveImport(program.graph, program.workspace, id, path) {
        .Found(target) => target
        .NoModule(missing) => {
          // A shape the grammar has a message for says what is wrong with it (docs/design/PROJECT.md section 6)
          if const Fail(message) = specifierOf(path) {
            diagnostics.append Diagnostic.error(message, at)
            return
          }
          diagnostics.append(
            Diagnostic.error("There is no module `{missing}`", at)
              .withNote("A path that starts with `./` or `../` is a file next to this one, without its extension"),
          )
          return
        }
        .NoPackage(name) => {
          if const Fail(message) = specifierOf(path) {
            diagnostics.append Diagnostic.error(message, at)
            return
          }
          diagnostics.append(
            Diagnostic.error("There is no package `{name}`", at)
              .withNote(
                "A package is `owner/name`. The standard library comes with the toolchain; everything else has to be a"
                  + " dependency or a member of the workspace",
              ),
          )
          return
        }
        .NotADependency(name) => {
          const importer = program.workspace.packages[program.graph.at(id).package].name
          diagnostics.append(
            Diagnostic.error("The package `{name}` is not a dependency of `{importer}`", at)
              .withNote("Add it: `dependencies \{ runtime \"{name}\" \}` in project.trb"),
          )
          return
        }
        .NoModuleInPackage(name, missing) => {
          diagnostics.append(
            Diagnostic.error("The package `{name}` has no module `{missing}`", at)
              .withNote("`\"owner/name\"` is `src/lib.trb` of a package, `\"owner/name/path\"` is `src/path.trb` of it"),
          )
          return
        }
        .OutsidePackage(written, package) => {
          diagnostics.append(
            Diagnostic.error("`{written}` leaves `{package}`", at)
              .withNote(
                "A relative path names a file of the same package. Another package is imported by its name:"
                  + " `\"owner/name/path\"`, and it has to be a dependency",
              ),
          )
          return
        }
        .Entry(written, program) => {
          diagnostics.append(
            Diagnostic.error("`{written}` is the entry of the program `{program}`, so nothing can import it", at)
              .withNote(
                "A file that may hold top-level code is never importable. What two programs share belongs in a module"
                  + " of the package, which both import",
              ),
          )
          return
        }
      }
      match usage.items {
        .Names(items) => {
          for item in items {
            // `use String.shout from "acme/text"`: the type is a name of *this* file, so what the module exports says
            // nothing about it. Whether the package really attaches such a member is the checker's question
            if isMemberImport(program, id, path, item) {
              continue
            }
            // What is missing is the *export*, so this message names it and points at it even under an alias
            const first = item.path[0]
            if !program.scopes[target.value].exported.containsKey(first.text) {
              var problem = Diagnostic.error "`{first.text}` is not exported by `{path}`", first.span
              if program.scopes[target.value].names.containsKey(first.text) {
                problem = problem.withNote "It is declared there, but not `public`"
              }
              diagnostics.append problem
              continue
            }
            const start = program.scopes[target.value].exported.get(first.text)
            checkItemPath program, item, start, declared, imported, diagnostics
          }
        }
        .All(alias) => reportDuplicate alias, declared, imported, diagnostics
      }
    }
    // `use Shape.Circle`: the first segment is a name of this file, the rest are steps into it
    .Local => {
      if const .Names(items) = usage.items {
        for item in items {
          const first = item.path[0]
          const start = program.lookUp id, first.text
          if start.isNone() {
            diagnostics.append Diagnostic.error("Unknown name `{first.text}`", first.span)
            continue
          }
          checkItemPath program, item, start, declared, imported, diagnostics
        }
      }
    }
  }
}

/**
 * Whether the binder took this item as a member import: it named a type of this file and the last segment is no case of
 * it. What that member is, and whether the package really has one, is a question about the types and belongs to the
 * checker - here it only says that nothing about the *export* is wrong.
 */
fn isMemberImport(program: Program, id: ModuleId, path: String, item: UseItem): Bool {
  memberImportOf(program.scopes[id.value].members, path, item).isSome()
}

/**
 * The entry the binder recorded for one `use` item. A module's map also holds what its prelude re-exported, whose spans
 * are spans of *another* file, so the written path and the imported name decide along with the span.
 */
public fn memberImportOf(members: Map<String, List<MemberImport>>, path: String, item: UseItem): MemberImport? {
  if item.path.length() < 2 {
    return None
  }
  const at = item.name().span
  const name = item.name().text
  for (_, entries) in members {
    for entry in entries {
      if entry.span == at && entry.path == path && entry.name == name {
        return entry
      }
    }
  }
  None
}

/**
 * The segments after the first one of a `use` item: every one of them is a case of a type or a name a namespace
 * exports. Reports what the step ran into, and otherwise that the local name is free.
 */
fn checkItemPath(
  program: Program,
  item: UseItem,
  start: SymbolId?,
  declared: Set<String>,
  var imported: Set<String>,
  var diagnostics: List<Diagnostic>,
) {
  var current = match start {
    Some(symbol) => symbol
    None => {
      return
    }
  }
  for index in 1..item.path.length() {
    const step = item.path[index]
    match stepOf(program, current, step.text) {
      Some(found) => {
        current = found
      }
      None => {
        reportNoStep program, current, step, diagnostics
        return
      }
    }
  }
  reportDuplicate item.localName(), declared, imported, diagnostics
}

/** One step of a `use` path: a name a namespace exports, or a case of a type. Nothing else has names of its own. */
fn stepOf(program: Program, owner: SymbolId, name: String): SymbolId? {
  match program.symbols.at(owner).kind {
    .Namespace(module) => program.scopes[module.value].exported.get(name)
    .Type => program.symbols.caseNamed owner, name
    _ => None
  }
}

/** Why a step of a `use` path found nothing: the owner decides which of the three messages says it. */
fn reportNoStep(program: Program, owner: SymbolId, step: Name, var diagnostics: List<Diagnostic>) {
  const name = program.symbols.at(owner).name
  match program.symbols.at(owner).kind {
    .Type => {
      // A method, a constant or a field is reached through the type; only a case becomes a name of its own
      if const Some(kind) = memberKindOf(program, owner, step.text) {
        diagnostics.append(Diagnostic.error(
          "Only a case can be imported from a type: `{step.text}` is a {kind} of `{name}`",
          step.span,
        ))
        return
      }
      diagnostics.append Diagnostic.error("`{name}` has no case `{step.text}`", step.span)
    }
    .Namespace(_) => diagnostics.append Diagnostic.error("`{step.text}` is not exported by `{name}`", step.span)
    _ => diagnostics.append(
      Diagnostic.error("{program.symbols.describe(owner)} has no cases", step.span)
        .withNote("A path in a `use` names a case of a type: `use Shape.Circle from \"./shape\"`"),
    )
  }
}

/**
 * What a name is on a type, when it is not a case: "method", "constant" or "field". The type checker has not run when
 * the names of a file are bound, so this reads the declaration itself - and therefore only sees the body of the type,
 * not what an `extend` adds to it.
 */
fn memberKindOf(program: Program, owner: SymbolId, name: String): String? {
  const symbol = program.symbols.at owner
  const module = symbol.module?
  for statement in program.graph.at(module).file.statements {
    if const .Declare(declaration) = statement.kind {
      if const .Type(declared) = declaration.kind {
        if declared.name.span == symbol.span {
          return memberKindIn declared.members, name
        }
      }
    }
  }
  None
}

fn memberKindIn(members: List<Member>, name: String): String? {
  for member in members {
    match member.kind {
      .Function(function) => {
        if function.name.text == name {
          return "method"
        }
      }
      .Constant(binding) => {
        if const .Binding(bound) = binding.pattern.kind {
          if bound == name {
            return "constant"
          }
        }
      }
      .Field(field) => {
        if field.name.text == name {
          return "field"
        }
      }
      .Case(_) => {}
    }
  }
  None
}

fn reportDuplicate(name: Name, declared: Set<String>, var imported: Set<String>, var diagnostics: List<Diagnostic>) {
  if name.text.isEmpty() {
    return
  }
  if declared.contains(name.text) {
    diagnostics.append(
      Diagnostic.error("`{name.text}` is already declared in this file", name.span)
        .withNote("An import cannot bring in a name the file declares itself"),
    )
    return
  }
  if imported.contains(name.text) {
    diagnostics.append Diagnostic.error("`{name.text}` is already imported", name.span)
    return
  }
  imported.insert name.text
}
