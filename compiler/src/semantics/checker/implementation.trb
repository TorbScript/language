/**
 * Traits and implementations: which type implements which trait, and through which implementation.
 *
 * Everything here answers one question - `resolveTrait(type, trait)` - and every operator, every `for`, every
 * interpolated part and every `?` asks it. So the answer is memoized by interned type id and trait symbol, and the
 * index over the implementations is built once from the declarations of the whole program. That is what keeps the pass
 * near-linear although trait resolution is recursive.
 *
 * Two rules of the design shape the code:
 *
 * - A **supertrait is reachable**: `Int64 with Signed`, `Signed with Numeric`, `Numeric with Add<Self, Self>` answers
 *   `1 + 2` with `Int64`. Supertraits are still *requirements* - that a type with `with Compare` also provides
 *   `equals` is what `checkImplementations` verifies - but a type that satisfies them implements them.
 * - There are **no inference variables here**. An implementation's target is a pattern, the type is concrete, and
 *   matching one against the other binds the implementation's own parameters. Nothing else is needed, which is why
 *   trait resolution needs no unification variable of its own even though it runs before a call's own inference does.
 */

use Span from "../../syntax/source"
use staticKeyword from "../../syntax/token"
use Diagnostic from "../../syntax/diagnostic"
use Declaration, ExtendDeclaration, Visibility, UseItem from "../../syntax/ast"
use FunctionDeclaration, TypeReference from "../../syntax/ast"
use ModuleId from "../module"
use SymbolId from "../symbols"
use resolveImport from "../graph"
use memberImportOf from "../scope"
use joinPath from "../../project/path"
use TypeId, TypeForm, ParameterId, FunctionForm, Signature from "./type"
use Implementation, ImplementationId, ImplementationOrigin, TargetShape, DerivedImplementation from "./type"
use Resolved, Witness, describeType from "./type"
use Checker, TypeScope from "./context"
use typeSignatureOf, declareParameters, boundsOf, traitList from "./signature"
use extensionMembers, signatureOf, functionOfSite from "./signature"
use typeFromReference from "./lowering"
use substitute, substituteFunction, sameType, sameFunction, resolveType from "./unify"
use derivableMembers from "./derive"
use nativeEntries from "../../backend/c/natives"
use checkCloseImplementer from "./close"

// --- Building the index ---------------------------------------------------------------------------------------------

/**
 * Every implementation of the program: the `with` list of every `type`, every `extend`, and every `extend` without a
 * trait. This is the only step of the checker that reads the whole program, and it reads declarations only.
 */
public fn buildImplementations(var checker: Checker) {
  if checker.implementations.isBuilt {
    return
  }
  checker.implementations.isBuilt = true
  for module in checker.program.graph.modules {
    const identifier = module.id
    const package = module.package
    for statement in module.file.statements {
      if const .Declare(declaration) = statement.kind {
        collectDeclaration checker, identifier, package, declaration
      }
    }
  }
}

fn collectDeclaration(var checker: Checker, module: ModuleId, package: Int, declaration: Declaration) {
  match declaration.kind {
    // The supertraits of a `trait` are requirements of its implementors, not an implementation of anything
    .Type(typeDeclaration) => {
      const symbol = match checker.resolvedName(module, typeDeclaration.name.span) {
        Some(found) => found
        None => {
          return
        }
      }
      const identifier = typeSignatureOf checker, symbol
      const shape = checker.typeSignature identifier
      const own = shape.own
      const generics = shape.generics
      const bounds = shape.bounds
      const members = shape.members
      const isNative = shape.isNative
      const at = typeDeclaration.name.span
      for bound in shape.traits {
        const origin = if bound.delegate.isSome() {
          ImplementationOrigin.Delegated
        } else {
          ImplementationOrigin.Declared
        }
        addOne(
          checker,
          Implementation(
            Some(bound.capability),
            own,
            generics,
            bounds,
            module,
            package,
            members,
            bound.delegate,
            origin,
            at,
            isNative,
          ),
        )
      }
    }
    .Extend(extension) => collectExtension checker, module, package, extension
    _ => {}
  }
}

/**
 * `extend<Item> List<Item> with Show where Item: Show`. The members get their ids here and nowhere else: building
 * them twice would give the same source two sets of symbols, so `check.trb` reads them back out of the index.
 */
fn collectExtension(var checker: Checker, module: ModuleId, package: Int, extension: ExtendDeclaration) {
  const generics = declareParameters checker, module, None, extension.generics
  const scope = TypeScope module
  const target = typeFromReference checker, extension.target, scope.forType()
  const inner = scope.copy selfType: Some(target)
  const bounds = boundsOf checker, generics, extension.generics, extension.whereClauses, inner
  const traits = traitList checker, extension.traits, target, inner
  const members = extensionMembers checker, module, target, generics, extension.members
  const at = extension.target.span
  const key = "{module.value}:{at.start}"
  if traits.isEmpty() {
    const identifier = addOne(
      checker,
      Implementation(
        None,
        target,
        generics,
        bounds,
        module,
        package,
        members,
        None,
        ImplementationOrigin.Inherent,
        at,
      ),
    )
    checker.implementations.bySpan.set key, identifier.value
    return
  }
  var first = -1
  for bound in traits {
    const identifier = addOne(
      checker,
      Implementation(
        Some(bound),
        target,
        generics,
        bounds,
        module,
        package,
        members,
        None,
        ImplementationOrigin.Declared,
        at,
      ),
    )
    if first < 0 {
      first = identifier.value
    }
  }
  if first >= 0 {
    checker.implementations.bySpan.set key, first
  }
}

fn addOne(var checker: Checker, implementation: Implementation): ImplementationId {
  const shape = targetShapeOf checker, implementation.target
  const capability = capabilitySymbolOf checker, implementation.capability
  checker.implementations.add implementation, shape, capability
}

/** What an `extend` produced, so that checking its members does not declare them a second time. */
public fn extensionAt(checker: Checker, module: ModuleId, at: Span): Implementation? {
  const index = checker.implementations.bySpan.get("{module.value}:{at.start}")?
  Some checker.implementations.all[index]
}

/** What the target of an implementation covers: one head, every implementor of a trait, or every type at all. */
public fn targetShapeOf(checker: Checker, target: TypeId): TargetShape {
  match checker.types.form(target) {
    .Nominal(symbol, _) => TargetShape.Concrete symbol
    .Parameter(_) => TargetShape.Blanket
    .Traits(bounds) => {
      if bounds.length() != 1 {
        return TargetShape.Other
      }
      match checker.types.form(bounds[0]) {
        .Nominal(symbol, _) => TargetShape.Bounded symbol
        _ => TargetShape.Other
      }
    }
    _ => TargetShape.Other
  }
}

/** The trait an implementation names, as a symbol: `Show` of `with Show`. */
fn capabilitySymbolOf(checker: Checker, applied: TypeId?): SymbolId? {
  const bound = applied?
  match checker.types.form(bound) {
    .Nominal(symbol, _) => Some symbol
    _ => None
  }
}

/** The head of a type, for the index: `List` of `List<Int>` and of the trait type `List<Int>` alike. */
public fn headSymbolOf(checker: Checker, annotation: TypeId): SymbolId? {
  match checker.types.form(annotation) {
    .Nominal(symbol, _) => Some symbol
    .Traits(bounds) => {
      if bounds.length() == 1 {
        return headSymbolOf checker, bounds[0]
      }
      None
    }
    _ => None
  }
}

// --- Resolution -----------------------------------------------------------------------------------------------------

/**
 * "Does `annotation` implement `capability`, and with which arguments." The answer is kept, because the same question
 * is asked for every expression that uses an operator, a `for` or an interpolation.
 */
public fn resolveTrait(var checker: Checker, annotation: TypeId, capability: SymbolId): Resolved {
  buildImplementations checker
  const key = (annotation.value, capability.value, false)
  if const Some(known) = checker.traitAnswers.get(key) {
    return known
  }
  if checker.traitDepth > 32 {
    return Resolved.Missing
  }
  checker.traitDepth = checker.traitDepth + 1
  const found = resolveUncached checker, annotation, capability, None
  checker.traitDepth = checker.traitDepth - 1
  checker.traitAnswers.set key, found
  found
}

/** `where Target: From<Source>`: the trait *and* its arguments are given, so the answer is yes or no. */
public fn resolveBound(var checker: Checker, annotation: TypeId, bound: TypeId): Resolved {
  buildImplementations checker
  const capability = match checker.types.form(bound) {
    .Nominal(symbol, _) => symbol
    // `Show & Encode` as a bound: every part of it has to hold
    .Traits(bounds) => {
      return resolveEveryBound checker, annotation, bounds
    }
    _ => {
      return Resolved.Missing
    }
  }
  // The same table answers `resolveTrait`; the flag is what keeps "this trait" and "this applied bound" apart
  const key = (annotation.value, bound.value, true)
  if const Some(known) = checker.traitAnswers.get(key) {
    return known
  }
  if checker.traitDepth > 32 {
    return Resolved.Missing
  }
  checker.traitDepth = checker.traitDepth + 1
  const found = resolveUncached checker, annotation, capability, Some(bound)
  checker.traitDepth = checker.traitDepth - 1
  checker.traitAnswers.set key, found
  found
}

fn resolveEveryBound(var checker: Checker, annotation: TypeId, bounds: List<TypeId>): Resolved {
  var last = Resolved.Missing
  for bound in bounds {
    last = resolveBound checker, annotation, bound
    if !last.isFound() {
      return Resolved.Missing
    }
  }
  last
}

/**
 * Whether a type satisfies a bound. A subject that is not fully concrete - a generic parameter, a unification
 * variable, something not checked yet - is *not* reported here: unifying an argument against a call's parameters is
 * what decides those, with the inference context that knows what the parameter stands for.
 */
public fn implementsBound(var checker: Checker, annotation: TypeId, bound: TypeId): Bool {
  if !isConcrete(checker, annotation) || !isConcrete(checker, bound) {
    return true
  }
  resolveBound(checker, annotation, bound).isFound()
}

/**
 * The witness a call or an adaptation records: which implementation makes the bound hold, and how the bounds of *that*
 * implementation hold in turn. A back end may monomorphize a call whose whole tree holds neither an `Object` nor a
 * `Forwarded`, so the tree and not only its root is what the IR lowering reads.
 */
public fn witnessFor(var checker: Checker, annotation: TypeId, bound: TypeId): Witness {
  // A witness is a pure function of the two interned ids, and every interpolation, every `==` and every generic call
  // asks for one - so the tree is kept, exactly as the trait answers are
  const key = (annotation.value, bound.value)
  if const Some(known) = checker.witnessAnswers.get(key) {
    return known
  }
  const found = witnessDeep checker, annotation, bound, 0
  checker.witnessAnswers.set key, found
  found
}

fn witnessDeep(var checker: Checker, annotation: TypeId, bound: TypeId, depth: Int): Witness {
  match resolveBound(checker, annotation, bound) {
    .Found(implementation, arguments) => {
      if depth > 6 {
        return Witness.Implementation implementation, arguments, []
      }
      const inner = innerWitnesses checker, implementation, annotation, bound, depth
      Witness.Implementation implementation, arguments, inner
    }
    .Bounded(_) => witnessOfBound checker, annotation, bound
    _ => Witness.Unresolved
  }
}

/** `extend<Item: Show> List<Item> with Show`: the `Item: Show` of the implementation, for the type it was matched to. */
fn innerWitnesses(
  var checker: Checker,
  implementation: ImplementationId,
  annotation: TypeId,
  bound: TypeId,
  depth: Int,
): List<Witness> {
  const found = checker.implementations.at implementation
  if found.bounds.isEmpty() {
    return []
  }
  var mapping: Map<ParameterId, TypeId> = [:]
  const _ = matchTarget checker, found, annotation, mapping
  if const Some(applied) = found.capability {
    const _ = matchPattern checker, applied, bound, found.generics, mapping
  }
  var witnesses: List<Witness> = []
  for inner in found.bounds {
    const subject = substitute checker.types, inner.subject, mapping
    for capability in inner.traits {
      const wanted = substitute checker.types, capability, mapping
      witnesses.append witnessDeep(checker, subject, wanted, depth + 1)
    }
  }
  witnesses
}

fn witnessOfBound(checker: Checker, annotation: TypeId, bound: TypeId): Witness {
  if const .Parameter(parameter) = checker.types.form(annotation) {
    return Witness.Forwarded parameter, bound
  }
  Witness.Object annotation, bound
}

/** The arguments of a trait as they are for one type: the `Other` and `Output` of `Add`, the `Item` of `Iterate`. */
public fn traitArgumentsOf(var checker: Checker, annotation: TypeId, capability: SymbolId): List<TypeId>? {
  resolveTrait(checker, annotation, capability).argumentsOf()
}

fn resolveUncached(var checker: Checker, annotation: TypeId, capability: SymbolId, wanted: TypeId?): Resolved {
  // A bound on `Never` holds, whatever the trait is: there is no value of `Never`, so nothing can ever reach
  // the member. That is what makes `Source<Item, Never>` - the reading end of a channel, which cannot fail - printable,
  // because the generated `Show` of a `Result` asks its `Failure` for one. Asked *without* a bound the answer stays
  // `Missing`: which arguments `Add` would have for a `Never` is nothing the question says
  if const Some(bound) = wanted {
    if const .NeverType = checker.types.form(annotation) {
      return Resolved.Bounded appliedArgumentsOf(checker, bound)
    }
  }
  if checker.absorbs(annotation) {
    return Resolved.Missing
  }
  // A literal type **is** its base at run time: `"tcp" | "udp"` is a `String`, so its `Show`, `Equals`, `Hash` and
  // `Compare` are the ones of `String` and not bodies generated for it. The two traits that belong to the literal type
  // itself are the conversion from text, which `directTraitsOf` puts in place of the base's own, and `Decode`, whose
  // body checks what it read against the values the type allows - the base's would let any text in
  if const .Literals(base, _) = checker.types.form(annotation) {
    var isConversion = checker.symbolAt(capability).name == "Decode"
    if const Some(found) = wanted {
      isConversion = isConversion || isTextConversionBound(checker, found)
    }
    if !isConversion {
      return resolveUncached checker, base, capability, wanted
    }
  }
  // Every signature says `Void` as `TypeForm.VoidType`, which no `extend` can name: the question is about the
  // `native type Void` the standard library declares, and that is where its `Show` comes from
  const subject = declaredVoidOf(checker, annotation) ?? annotation
  // A trait-typed value and a generic parameter carry their witness: what their bounds say is the answer
  if const Some(arguments) = boundArgumentsOf(checker, subject, capability, wanted) {
    return Resolved.Bounded arguments
  }
  var first = -1
  var second = -1
  var arguments: List<TypeId> = []
  const head = headSymbolOf checker, subject
  const candidates = checker.implementations.candidatesOf capability, head
  for index in candidates {
    if const Some(given) = applies(checker, index, subject, wanted) {
      if first < 0 {
        first = index
        arguments = given
      } else if index != first {
        second = index
      }
    }
  }
  // Two implementations that both answer are an overlap, which `checkCoherence` reports at the two declarations - so
  // nothing is said here: one root cause, one message. Where one of them is the type's own and the other one reaches it
  // through a trait it implements, the overlap is reported at the second, and the type's own is the answer
  if second >= 0 {
    if const Some(own) = ownOfTwo(checker, first, second) {
      const given = applies(checker, own, subject, wanted) ?? arguments
      return Resolved.Found ImplementationId(own), given
    }
    return Resolved.Ambiguous ImplementationId(first), ImplementationId(second)
  }
  if first >= 0 {
    return Resolved.Found ImplementationId(first), arguments
  }
  // `Int64 with Signed`, `Signed with Numeric`, `Numeric with Add<Self, Self>`
  if const Some(found) = throughSupertraits(checker, subject, capability, wanted) {
    return found
  }
  // `Show`, `Equals`, `Hash`, `Encode`, `Decode` and the `From` of a wrapper case are generated on first use
  deriveFor checker, subject, capability, wanted
}

/**
 * Of two implementations that both answer, the one written for the type itself where the other one is written for a
 * trait it implements (`type Square with Describe` against `extend Shape with Describe`). `None` for any other pair.
 */
fn ownOfTwo(checker: Checker, first: Int, second: Int): Int? {
  const firstShape = targetShapeOf checker, checker.implementations.all[first].target
  const secondShape = targetShapeOf checker, checker.implementations.all[second].target
  match (firstShape, secondShape) {
    (.Concrete(_), .Bounded(_)) => Some first
    (.Bounded(_), .Concrete(_)) => Some second
    _ => None
  }
}

/**
 * The `native type Void` of the standard library, where the type asked about is `Void`. `None` for everything else, and
 * for a workspace whose prelude does not declare it - there `Void` implements nothing, as before.
 */
fn declaredVoidOf(var checker: Checker, annotation: TypeId): TypeId? {
  if const .VoidType = checker.types.form(annotation) {
    const symbol = checker.wellKnown.declaredVoid?
    return Some checker.nominal(symbol, [])
  }
  None
}

/** What the bounds of a trait-typed value or of a generic parameter say about one trait. */
/** The arguments a bound was written with: `From<Iterate<Int>>` gives `[Iterate<Int>]`, a bare `Show` gives `[]`. */
public fn appliedArgumentsOf(checker: Checker, bound: TypeId): List<TypeId> {
  match checker.types.form(bound) {
    .Nominal(_, arguments) => arguments
    _ => []
  }
}

fn boundArgumentsOf(
  var checker: Checker,
  annotation: TypeId,
  capability: SymbolId,
  wanted: TypeId?,
): List<TypeId>? {
  const bounds = match checker.types.form(annotation) {
    .Traits(found) => found
    .Parameter(parameter) => checker.parameterBounds.get(parameter.value) ?? []
    _ => {
      return None
    }
  }
  if bounds.isEmpty() {
    return None
  }
  const found = searchTraits(checker, bounds, capability, annotation, wanted, 0)?
  Some found
}

/**
 * The `Item` of the `Iterate<Item>` a type can be built from, where exactly one of its `From` implementations takes
 * one.
 *
 * `From` is the one trait a type may implement several times - `Int.from` exists for five widths, and
 * `extend<Target> Target with From<Never>` adds one to *every* type - so "what is the argument of `From` for this type"
 * has no single answer and `resolveTrait` rightly says `Ambiguous`. "Which of them takes an `Iterate`" does have one,
 * and that is the collection protocol a literal and `to<Target>()` ask about.
 */
public fn iterateSourceOf(var checker: Checker, annotation: TypeId, iterable: SymbolId): TypeId? {
  buildImplementations checker
  const conversion = checker.wellKnown.from?
  const head = headSymbolOf checker, annotation
  const candidates = checker.implementations.candidatesOf conversion, head
  var found: TypeId? = None
  for index in candidates {
    const given = match applies(checker, index, annotation, None) {
      Some(arguments) => arguments
      None => {
        continue
      }
    }
    if given.length() != 1 {
      continue
    }
    const item = match itemOfIterateBound(checker, given[0], iterable) {
      Some(inner) => inner
      None => {
        continue
      }
    }
    // Two implementations that both take an `Iterate` are an overlap, which `checkCoherence` reports at their
    // declarations - so nothing is said here and nothing is guessed either
    if const Some(other) = found {
      if other != item {
        return None
      }
      continue
    }
    found = Some item
  }
  found
}

/**
 * The `Failure` of every `TryFrom<Source, Failure>` a type has for one source, without duplicates.
 *
 * `TryFrom` is a trait a type may implement several times - `Int64` takes a wider integer and text - so "what are the
 * arguments of `TryFrom` for this type" has no single answer and `resolveTrait` rightly says `Ambiguous`. "Which
 * failure does it have for *this* source" has one wherever the list has one entry, and that is what `tryInto()` under
 * a `?` asks: the `?` says the target and nothing about the failure.
 */
public fn fallibleFailuresOf(var checker: Checker, annotation: TypeId, source: TypeId): List<TypeId> {
  buildImplementations checker
  const conversion = match checker.wellKnown.tryFrom {
    Some(symbol) => symbol
    None => {
      return []
    }
  }
  const head = headSymbolOf checker, annotation
  const candidates = checker.implementations.candidatesOf conversion, head
  var found: List<TypeId> = []
  for index in candidates {
    const given = match applies(checker, index, annotation, None) {
      Some(arguments) => arguments
      None => {
        continue
      }
    }
    if given.length() != 2 {
      continue
    }
    if resolveType(checker, given[0]) != resolveType(checker, source) {
      continue
    }
    const failure = resolveType checker, given[1]
    if !found.contains(failure) {
      found.append failure
    }
  }
  found
}

/** The `Item` of an `Iterate<Item>` in a type position, which is a trait value of one bound. */
fn itemOfIterateBound(var checker: Checker, annotation: TypeId, iterable: SymbolId): TypeId? {
  const bounds = match checker.types.form(annotation) {
    .Traits(found) => found
    _ => [annotation]
  }
  for bound in bounds {
    if const .Nominal(symbol, arguments) = checker.types.form(bound) {
      if symbol == iterable {
        return arguments.first()
      }
    }
  }
  None
}

/**
 * Whether one candidate applies to this type: its target is a pattern, the type is concrete, and matching binds the
 * implementation's own parameters. Every one of them has to be bound, and every bound of the implementation has to
 * hold - which is where resolution recurses.
 */
fn applies(var checker: Checker, index: Int, annotation: TypeId, wanted: TypeId?): List<TypeId>? {
  const implementation = checker.implementations.all[index]
  var mapping: Map<ParameterId, TypeId> = [:]
  if !matchTarget(checker, implementation, annotation, mapping) {
    return None
  }
  const applied = implementation.capability?
  // `where Target: From<Source>`: the arguments of the bound bind the rest of the implementation's parameters
  if const Some(bound) = wanted {
    if !matchPattern(checker, applied, bound, implementation.generics, mapping) {
      return None
    }
  }
  for parameter in implementation.generics {
    if !mapping.containsKey(parameter) {
      return None
    }
  }
  if !boundsHold(checker, implementation, mapping) {
    return None
  }
  const given = substitute checker.types, applied, mapping
  match checker.types.form(given) {
    .Nominal(_, arguments) => Some arguments
    _ => Some([])
  }
}

/**
 * The target of an implementation against a concrete type. `extend<Item> List<Item> with Show` has a *trait* as its
 * target, which means every type that implements it - so the arguments come out of that implementation instead of out
 * of the type's own head.
 */
fn matchTarget(
  var checker: Checker,
  implementation: Implementation,
  annotation: TypeId,
  var mapping: Map<ParameterId, TypeId>,
): Bool {
  const target = implementation.target
  if const .Bounded(head) = targetShapeOf(checker, target) {
    // A value of the trait itself matches it structurally; anything else has to implement it
    if matchPattern(checker, target, annotation, implementation.generics, mapping) {
      return true
    }
    // ...and has to be able to reach what the implementation provides at all
    if !reachesImplementers(checker, implementation.capability) {
      return false
    }
    const pattern = match checker.types.form(target) {
      .Traits(bounds) => bounds[0]
      _ => {
        return false
      }
    }
    const actual = match traitArgumentsOf(checker, annotation, head) {
      Some(found) => found
      None => {
        return false
      }
    }
    const wanted = match checker.types.form(pattern) {
      .Nominal(_, arguments) => arguments
      _ => {
        return false
      }
    }
    if wanted.length() != actual.length() {
      return false
    }
    for position in 0..wanted.length() {
      if !matchPattern(checker, wanted[position], actual[position], implementation.generics, mapping) {
        return false
      }
    }
    return true
  }
  matchPattern checker, target, annotation, implementation.generics, mapping
}

/**
 * Whether an implementation whose target is a *trait type* serves the concrete implementers of that trait as well.
 *
 * `extend<Item: Show> List<Item> with Show` does: `show` takes `self`, so an `ArrayList<Int>` reaches it through the
 * coercion of its receiver - which is exactly what "makes every list showable" means (CONCEPT, "Traits").
 * `extend<Item> List<Item> with From<Iterate<Item>>` does **not**: `From.from` has no `self` and answers `Self`, so for
 * an `ArrayList<Int>` it would answer "some `List`" and not an `ArrayList`. That implementation belongs to the
 * trait-typed value alone, and `List.from(...)` and `to<List<Int>>()` are what reach it.
 *
 * So the rule is: every member of the implemented trait takes `self`, and none of them answers `Self`. A `Self` in a
 * *parameter* is fine - there the concrete value coerces *into* the trait, which is the direction that always holds.
 *
 * The question is asked of the **declaration** of the trait and not of its signatures: bound resolution runs while
 * signatures are still being built, and one that is not ready yet would give a different answer than the same question
 * a moment later. The answer is a property of the trait, so it is kept.
 */
fn reachesImplementers(var checker: Checker, applied: TypeId?): Bool {
  const capability = match capabilitySymbolOf(checker, applied) {
    Some(found) => found
    None => {
      return true
    }
  }
  if const Some(known) = checker.reachingTraits.get(capability.value) {
    return known
  }
  const found = everyMemberReaches checker, capability
  checker.reachingTraits.set capability.value, found
  found
}

fn everyMemberReaches(var checker: Checker, capability: SymbolId): Bool {
  const site = match checker.siteOf(capability) {
    Some(found) => found
    None => {
      return true
    }
  }
  const members = match site.kind {
    .Declared(declaration) => {
      match declaration.kind {
        .Trait(declared) => declared.members
        _ => {
          return true
        }
      }
    }
    _ => {
      return true
    }
  }
  for member in members {
    if const .Function(function) = member.kind {
      if !memberReaches(function) {
        return false
      }
    }
  }
  true
}

/** One member: it has to take `self`, and its result must not name `Self` anywhere. */
fn memberReaches(function: FunctionDeclaration): Bool {
  var takesSelf = false
  for parameter in function.parameters {
    if parameter.name.text == "self" && parameter.annotation.isNone() {
      takesSelf = true
    }
  }
  if !takesSelf {
    return false
  }
  match function.returnType {
    Some(annotation) => !namesSelf(annotation)
    None => true
  }
}

/** Whether a written type names `Self` anywhere inside it. There is no other way to mean it, so this is exact. */
fn namesSelf(reference: TypeReference): Bool {
  match reference.kind {
    .Named(path, arguments) => {
      if path.length() == 1 && path[0].text == "Self" {
        return true
      }
      anyNamesSelf arguments
    }
    .Optional(inner) => namesSelf inner
    .Lazy(inner) => namesSelf inner
    .Intersection(members) => anyNamesSelf members
    .TupleType(fields) => {
      for field in fields {
        if namesSelf(field.annotation) {
          return true
        }
      }
      false
    }
    .FunctionType(parameters, result) => {
      for parameter in parameters {
        if namesSelf(parameter.annotation) {
          return true
        }
      }
      namesSelf result
    }
    _ => false
  }
}

fn anyNamesSelf(references: List<TypeReference>): Bool {
  for reference in references {
    if namesSelf(reference) {
      return true
    }
  }
  false
}

/**
 * One-directional matching: every generic parameter of the implementation binds to what stands at its place, and
 * everything else has to be the same type. This is what lets trait resolution work without inference variables.
 */
fn matchPattern(
  var checker: Checker,
  pattern: TypeId,
  concrete: TypeId,
  generics: List<ParameterId>,
  var mapping: Map<ParameterId, TypeId>,
): Bool {
  if const .Parameter(parameter) = checker.types.form(pattern) {
    if generics.contains(parameter) {
      if const Some(known) = mapping.get(parameter) {
        return sameType checker.types, known, concrete
      }
      mapping.set parameter, concrete
      return true
    }
  }
  if pattern == concrete {
    if !generics.isEmpty() {
      bindOwnParameters checker, pattern, generics, mapping
    }
    return true
  }
  match checker.types.form(pattern) {
    .Nominal(symbol, arguments) => {
      const other = match checker.types.form(concrete) {
        .Nominal(otherSymbol, otherArguments) => {
          if symbol != otherSymbol {
            return false
          }
          otherArguments
        }
        _ => {
          return false
        }
      }
      matchAll checker, arguments, other, generics, mapping
    }
    .Traits(bounds) => {
      const other = match checker.types.form(concrete) {
        .Traits(otherBounds) => otherBounds
        _ => {
          return false
        }
      }
      matchAll checker, bounds, other, generics, mapping
    }
    .Tuple(fields) => {
      const other = match checker.types.form(concrete) {
        .Tuple(otherFields) => otherFields
        _ => {
          return false
        }
      }
      if fields.length() != other.length() {
        return false
      }
      for position in 0..fields.length() {
        if !matchPattern(checker, fields[position].annotation, other[position].annotation, generics, mapping) {
          return false
        }
      }
      true
    }
    .Function(form) => {
      const other = match checker.types.form(concrete) {
        .Function(otherForm) => otherForm
        _ => {
          return false
        }
      }
      if form.parameters.length() != other.parameters.length() {
        return false
      }
      for position in 0..form.parameters.length() {
        const left = form.parameters[position].annotation
        const right = other.parameters[position].annotation
        if !matchPattern(checker, left, right, generics, mapping) {
          return false
        }
      }
      matchPattern checker, form.result, other.result, generics, mapping
    }
    _ => false
  }
}

/**
 * A pattern that is the concrete type itself still binds the parameters it mentions - each to itself. That is the case
 * inside the body of a generic type: `Box<Item>` is matched against `type Box<Item> with Plan`, whose target is the very
 * same interned type, and without the binding `Item` would stay open and the implementation would not apply - so
 * `self`, or a `Box(item)` of the body, handed on as a `Plan` became a trait-typed value nobody built.
 */
fn bindOwnParameters(
  var checker: Checker,
  pattern: TypeId,
  generics: List<ParameterId>,
  var mapping: Map<ParameterId, TypeId>,
) {
  match checker.types.form(pattern) {
    .Parameter(parameter) => {
      if generics.contains(parameter) && !mapping.containsKey(parameter) {
        mapping.set parameter, pattern
      }
    }
    .Nominal(_, arguments) => {
      for argument in arguments {
        bindOwnParameters checker, argument, generics, mapping
      }
    }
    .Traits(bounds) => {
      for bound in bounds {
        bindOwnParameters checker, bound, generics, mapping
      }
    }
    .Tuple(fields) => {
      for field in fields {
        bindOwnParameters checker, field.annotation, generics, mapping
      }
    }
    .Function(form) => {
      for parameter in form.parameters {
        bindOwnParameters checker, parameter.annotation, generics, mapping
      }
      bindOwnParameters checker, form.result, generics, mapping
    }
    _ => {}
  }
}

fn matchAll(
  var checker: Checker,
  patterns: List<TypeId>,
  concretes: List<TypeId>,
  generics: List<ParameterId>,
  var mapping: Map<ParameterId, TypeId>,
): Bool {
  if patterns.length() != concretes.length() {
    return false
  }
  for position in 0..patterns.length() {
    if !matchPattern(checker, patterns[position], concretes[position], generics, mapping) {
      return false
    }
  }
  true
}

/** `extend<Item: Show> List<Item> with Show`: the condition of the implementation, with the match put in. */
fn boundsHold(var checker: Checker, implementation: Implementation, mapping: Map<ParameterId, TypeId>): Bool {
  for bound in implementation.bounds {
    const subject = substitute checker.types, bound.subject, mapping
    for capability in bound.traits {
      const wanted = substitute checker.types, capability, mapping
      if !implementsBound(checker, subject, wanted) {
        return false
      }
    }
  }
  true
}

/**
 * The supertraits of everything the type implements. A supertrait is a requirement on the implementor, and a type that
 * meets it implements it - which is what makes `1 + 2` an `Int64` through `Signed`, `Numeric` and `Add<Self, Self>`.
 */
fn throughSupertraits(
  var checker: Checker,
  annotation: TypeId,
  capability: SymbolId,
  wanted: TypeId?,
): Resolved? {
  const head = headSymbolOf checker, annotation
  const candidates = checker.implementations.declaredFor head
  for index in candidates {
    const implementation = checker.implementations.all[index]
    const declared = match implementation.capability {
      Some(found) => found
      None => {
        continue
      }
    }
    var mapping: Map<ParameterId, TypeId> = [:]
    if !matchTarget(checker, implementation, annotation, mapping) {
      continue
    }
    const applied = substitute checker.types, declared, mapping
    const supertraits = supertraitsOfBound checker, applied, annotation
    if const Some(found) = searchTraits(checker, supertraits, capability, annotation, wanted, 0) {
      return Some Resolved.Found(ImplementationId(index), found)
    }
  }
  None
}

/**
 * `capability` among these traits, or among their supertraits. `own` stays the type the question was asked about all
 * the way down, because `Self` inside a supertrait means that type.
 */
fn searchTraits(
  var checker: Checker,
  traits: List<TypeId>,
  capability: SymbolId,
  own: TypeId,
  wanted: TypeId?,
  depth: Int,
): List<TypeId>? {
  if depth > 8 {
    return None
  }
  for bound in traits {
    if const .Nominal(head, arguments) = checker.types.form(bound) {
      if head == capability && matchesWanted(checker, bound, wanted) {
        return Some arguments
      }
    }
  }
  for bound in traits {
    const inner = supertraitsOfBound checker, bound, own
    if inner.isEmpty() {
      continue
    }
    if const Some(found) = searchTraits(checker, inner, capability, own, wanted, depth + 1) {
      return Some found
    }
  }
  None
}

fn matchesWanted(checker: Checker, bound: TypeId, wanted: TypeId?): Bool {
  match wanted {
    Some(asked) => sameType checker.types, bound, asked
    None => true
  }
}

/** The supertraits of one applied trait, with its arguments and `Self` put in. */
public fn supertraitsOfBound(var checker: Checker, bound: TypeId, own: TypeId): List<TypeId> {
  const (symbol, arguments) = match checker.types.form(bound) {
    .Nominal(found, given) => (found, given)
    _ => {
      return []
    }
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  if shape.traits.isEmpty() {
    return []
  }
  var mapping: Map<ParameterId, TypeId> = [:]
  for position in 0..shape.generics.length().min(arguments.length()) {
    mapping.set shape.generics[position], arguments[position]
  }
  if const .Parameter(parameter) = checker.types.form(shape.own) {
    mapping.set parameter, own
  }
  var found: List<TypeId> = []
  for supertrait in shape.traits {
    found.append substitute(checker.types, supertrait.capability, mapping)
  }
  found
}

/**
 * Whether `supertrait` is one of `bound`'s, transitively - the question member lookup asks when one name is declared
 * by two traits of one receiver.
 *
 * `List<Item>` comes `with Iterate<Item>`, and both `List` and `Iterate` declare
 * `sorted`: the one in `List` answers `Self` and the one in `Iterate` answers a lazy stage. They are not two
 * signatures of one overload set, they are a member and the member it overrides, so the more derived one wins.
 */
public fn isSupertraitOfBound(var checker: Checker, bound: TypeId, supertrait: TypeId, own: TypeId): Bool {
  if bound == supertrait {
    return false
  }
  var closure: List<TypeId> = []
  addClosure checker, closure, bound, own, 0
  closure.contains supertrait
}

/** Every trait a type implements, transitively over supertraits. What member lookup walks. */
public fn traitsOf(var checker: Checker, annotation: TypeId): List<TypeId> {
  buildImplementations checker
  if const Some(known) = checker.traitClosures.get(annotation.value) {
    return known
  }
  // A trait that mentions itself through `Self` would otherwise loop. The guard is its own table, because the answers
  // are thrown away whenever an implementation is generated and the guard must survive that
  if checker.closuresRunning.containsKey(annotation.value) {
    return []
  }
  checker.closuresRunning.set annotation.value, true
  const generation = checker.answerGeneration
  var found: List<TypeId> = []
  const declared = directTraitsOf checker, annotation
  for bound in declared {
    addClosure checker, found, bound, annotation, 0
  }
  addImplementorTraits checker, found, annotation
  found = withoutInheritedTextConversions checker, annotation, found
  checker.closuresRunning.remove annotation.value
  // An implementation was generated while this ran, so what came out may be missing it: answer with it, keep nothing
  if checker.answerGeneration == generation {
    checker.traitClosures.set annotation.value, found
  }
  found
}

/**
 * `extend<Item: Show> List<Item> with Show` makes every list showable, so an implementation whose target is a *trait*
 * applies to every type that has that trait - which the closure above has just decided. One pass: a trait that is
 * gained this way has no supertrait that could bring in another one.
 */
fn addImplementorTraits(var checker: Checker, var found: List<TypeId>, annotation: TypeId) {
  const candidates = checker.implementations.open
  for index in candidates {
    const implementation = checker.implementations.all[index]
    const declared = match implementation.capability {
      Some(inner) => inner
      None => {
        continue
      }
    }
    const head = match targetShapeOf(checker, implementation.target) {
      .Bounded(inner) => inner
      // `extend<World: Query> World with Pairs`: the target is a bare parameter, so it binds nothing on its own - and
      // then the **bound on that parameter** is the whole condition, which is the question `boundsHold` answers
      .Blanket => {
        addBlanketTrait checker, found, index, annotation, declared
        continue
      }
      _ => {
        continue
      }
    }
    const pattern = match checker.types.form(implementation.target) {
      .Traits(bounds) => bounds[0]
      _ => {
        continue
      }
    }
    const wanted = match checker.types.form(pattern) {
      .Nominal(_, arguments) => arguments
      _ => {
        continue
      }
    }
    for bound in found {
      var mapping: Map<ParameterId, TypeId> = [:]
      if !hasHead(checker, bound, head) {
        continue
      }
      const arguments = argumentsOfBound checker, bound
      if !matchAll(checker, wanted, arguments, implementation.generics, mapping) {
        continue
      }
      if !boundsHold(checker, implementation, mapping) {
        continue
      }
      const applied = substitute checker.types, declared, mapping
      if !found.contains(applied) {
        found.append applied
      }
      break
    }
  }
}

/**
 * Whether a value of `given` may stand where `wanted` is asked for - the question `checkValue` answers, asked **without
 * reporting anything**, because a candidate of an overload set that does not fit is not a mistake but the wrong
 * candidate.
 *
 * It is deliberately generous where it cannot see: a generic parameter, a variable or anything not settled yet fits, so
 * a candidate is ruled out only by a type that says so.
 */
public fn fitsType(var checker: Checker, given: TypeId, wanted: TypeId): Bool {
  // `Never` is the one absorbing type that does **not** absorb here: it coerces to everything and nothing coerces to
  // it, so the `From<Never>` every type has must not fit every argument of `Type.from(...)`
  if wanted == checker.neverType {
    return given == checker.neverType
  }
  if checker.absorbs(given) || checker.absorbs(wanted) {
    return true
  }
  if sameType(checker.types, given, wanted) {
    return true
  }
  if !isConcrete(checker, given) || !isConcrete(checker, wanted) {
    return true
  }
  // A value becomes a trait-typed value it implements: `Store<Show>` takes a `Square` like any other parameter does
  if const .Traits(bounds) = checker.types.form(wanted) {
    for bound in bounds {
      if !implementsBound(checker, given, bound) {
        return false
      }
    }
    return true
  }
  false
}

/**
 * Every **applied** bound of one trait a type has: `[Multiply<Scale, Board>, Multiply<Board, Board>]`, in the order
 * they were found. [traitArgumentsOf] answers one of them and says `Ambiguous` for a type that implements the trait
 * more than once; this is the list that the operators and the overload set are decided from, and it is the same list
 * member lookup builds its candidates from.
 */
public fn appliedTraitsOf(var checker: Checker, annotation: TypeId, capability: SymbolId): List<TypeId> {
  var found: List<TypeId> = []
  for bound in traitsOf(checker, annotation) {
    if hasHead(checker, bound, capability) && !found.contains(bound) {
      found.append bound
    }
  }
  found
}

/**
 * Every applied bound of one trait that an implementation **writes** for a type, in declaration order: what
 * `extend Path with From<String>` and `type Path with Compare` say, and nothing the language generated. It is the
 * question the conversion pair of a capsule is decided from, where an answer that depends on which derived
 * implementation happened to exist already would make the pair depend on the order the files were checked in.
 */
public fn writtenTraitsOf(var checker: Checker, annotation: TypeId, capability: SymbolId): List<TypeId> {
  buildImplementations checker
  const head = headSymbolOf checker, annotation
  const candidates = checker.implementations.declaredFor head
  var found: List<TypeId> = []
  for index in candidates {
    const implementation = checker.implementations.all[index]
    if isGenerated(implementation) {
      continue
    }
    const declared = match implementation.capability {
      Some(inner) => inner
      None => {
        continue
      }
    }
    var mapping: Map<ParameterId, TypeId> = [:]
    if !matchTarget(checker, implementation, annotation, mapping) {
      continue
    }
    if !boundsHold(checker, implementation, mapping) {
      continue
    }
    const applied = substitute checker.types, declared, mapping
    if hasHead(checker, applied, capability) && !found.contains(applied) {
      found.append applied
    }
  }
  found
}

/**
 * One blanket implementation, for one type: `extend<World: Query> World with Pairs` gives `Pairs` to every type that
 * has `Query`, so `game.doubled()` is a member of `Game` like any other. A blanket whose own arguments the type does
 * not decide (`extend<Source, Target> Source with Into<Target>`) is **not** added: it would put `Into<Target>` with an
 * open `Target` on every type at all, and what that means is decided at a call and not by the type.
 */
fn addBlanketTrait(
  var checker: Checker,
  var found: List<TypeId>,
  index: Int,
  annotation: TypeId,
  declared: TypeId,
) {
  // Only for a **concrete** type. What a generic parameter has is what its bounds say and nothing else - a blanket
  // would give `Target` of `fn to<Target: From<Iterate<Item>>>` a second `From` (`From<Never>`, which every type has)
  // and turn `Target.from(self)` into an ambiguity that no call site can resolve
  if !isConcrete(checker, annotation) {
    return
  }
  const implementation = checker.implementations.all[index]
  var mapping: Map<ParameterId, TypeId> = [:]
  if !matchTarget(checker, implementation, annotation, mapping) {
    return
  }
  if !boundsHold(checker, implementation, mapping) {
    return
  }
  const applied = substitute checker.types, declared, mapping
  if hasParameter(checker, applied) {
    return
  }
  if !found.contains(applied) {
    found.append applied
  }
}

/** Whether a type still mentions a generic parameter anywhere: what "the type did not decide this" means here. */
public fn hasParameter(checker: Checker, annotation: TypeId): Bool {
  match checker.types.form(annotation) {
    .Parameter(_) => true
    .Nominal(_, arguments) => {
      for argument in arguments {
        if hasParameter(checker, argument) {
          return true
        }
      }
      false
    }
    .Traits(bounds) => {
      for bound in bounds {
        if hasParameter(checker, bound) {
          return true
        }
      }
      false
    }
    _ => false
  }
}

fn hasHead(checker: Checker, bound: TypeId, head: SymbolId): Bool {
  if const .Nominal(symbol, _) = checker.types.form(bound) {
    return symbol == head
  }
  false
}

fn addClosure(var checker: Checker, var found: List<TypeId>, bound: TypeId, own: TypeId, depth: Int) {
  if depth > 8 || found.contains(bound) {
    return
  }
  found.append bound
  const supertraits = supertraitsOfBound checker, bound, own
  for supertrait in supertraits {
    addClosure(checker, found, supertrait, own, depth + 1)
  }
}

/** What a type says about itself: the bounds of a trait value or a parameter, or every implementation that applies. */
fn directTraitsOf(var checker: Checker, annotation: TypeId): List<TypeId> {
  match checker.types.form(annotation) {
    .Traits(bounds) => bounds
    // `Void` carries what its declaration in the standard library says, so `nothing.show()` is a member like any other
    .VoidType => {
      match declaredVoidOf(checker, annotation) {
        Some(declared) => directTraitsOf checker, declared
        None => []
      }
    }
    .Parameter(parameter) => checker.parameterBounds.get(parameter.value) ?? []
    // A literal type has the traits of its base plus the `TryFrom<String, LiteralParseError>` the language generates for
    // it, which replaces the base's own conversion from text: `Status.tryFrom(text)` fails with a `LiteralParseError`
    // and not with a `NumberParseError`. Every other `TryFrom` of the base stays what it is
    .Literals(base, _) => {
      const inherited = directTraitsOf checker, base
      const conversion = literalConversionBound checker
      var found: List<TypeId> = []
      for bound in inherited {
        if conversion.isSome() && isTextConversionBound(checker, bound) {
          continue
        }
        found.append bound
      }
      if const Some(generated) = conversion {
        if !found.contains(generated) {
          found.append generated
        }
      }
      found
    }
    _ => {
      const head = headSymbolOf checker, annotation
      const candidates = checker.implementations.declaredFor head
      var found: List<TypeId> = []
      for index in candidates {
        const implementation = checker.implementations.all[index]
        const declared = match implementation.capability {
          Some(inner) => inner
          None => {
            continue
          }
        }
        var mapping: Map<ParameterId, TypeId> = [:]
        if !matchTarget(checker, implementation, annotation, mapping) {
          continue
        }
        if !boundsHold(checker, implementation, mapping) {
          continue
        }
        const applied = substitute checker.types, declared, mapping
        if !found.contains(applied) {
          found.append applied
        }
      }
      found
    }
  }
}

/**
 * A literal type is read from text by its own conversion and by no other. `directTraitsOf` puts it in place of the
 * base's, but the base can carry one more through a supertrait - `Int64 with Signed` reaches `TryFrom<String,
 * NumberParseError>` through `Numeric` - and `Level.tryFrom("2")` was then two candidates that both take a `String`.
 */
fn withoutInheritedTextConversions(var checker: Checker, annotation: TypeId, found: List<TypeId>): List<TypeId> {
  if const .Literals(_, _) = checker.types.form(annotation) {
    const generated = literalConversionBound checker
    var kept: List<TypeId> = []
    for bound in found {
      if isTextConversionBound(checker, bound) && Some(bound) != generated {
        continue
      }
      kept.append bound
    }
    return kept
  }
  found
}

/**
 * `TryFrom<String, LiteralParseError>`: how a literal type is read from text, which is the one member it has that its
 * base does not. The failure names the text and the members it could have been, which is what `LiteralParseError` is
 * for (concept, Literal Types).
 */
public fn literalConversionBound(var checker: Checker): TypeId? {
  const conversion = checker.wellKnown.tryFrom?
  const text = checker.wellKnown.symbolNamed("String")?
  const failure = checker.wellKnown.symbolNamed("LiteralParseError")?
  Some checker.nominal(conversion, [checker.nominal(text, []), checker.nominal(failure, [])])
}

/** Whether a bound is a `TryFrom` **from text**, which is the one a literal type's generated conversion replaces. */
fn isTextConversionBound(var checker: Checker, bound: TypeId): Bool {
  const (symbol, arguments) = match checker.types.form(bound) {
    .Nominal(found, given) => (found, given)
    _ => {
      return false
    }
  }
  if checker.wellKnown.tryFrom != Some(symbol) || arguments.length() != 2 {
    return false
  }
  match checker.types.form(arguments[0]) {
    .Nominal(source, _) => checker.wellKnown.string == Some(source)
    _ => false
  }
}

/** Whether a type is concrete enough to say "it does not implement that": no parameter, no variable, nothing open. */
public fn isConcrete(checker: Checker, annotation: TypeId): Bool {
  match checker.types.form(annotation) {
    .Parameter(_) | .Variable(_) | .Invalid | .Deferred => false
    .Nominal(_, arguments) => everyConcrete checker, arguments
    .Traits(bounds) => everyConcrete checker, bounds
    .Tuple(fields) => {
      for field in fields {
        if !isConcrete(checker, field.annotation) {
          return false
        }
      }
      true
    }
    .Function(form) => {
      for parameter in form.parameters {
        if !isConcrete(checker, parameter.annotation) {
          return false
        }
      }
      isConcrete checker, form.result
    }
    _ => true
  }
}

fn everyConcrete(checker: Checker, arguments: List<TypeId>): Bool {
  for argument in arguments {
    if !isConcrete(checker, argument) {
      return false
    }
  }
  true
}

// --- Derived implementations ----------------------------------------------------------------------------------------

/**
 * `Show`, `Equals`, `Hash`, `Encode`, `Decode` and the `From` of a wrapper case are generated where they are used, so
 * nothing is generated for a type nobody asks about. A hand-written member always wins, because a declared
 * implementation was already found above.
 */
fn deriveFor(var checker: Checker, annotation: TypeId, capability: SymbolId, wanted: TypeId?): Resolved {
  // The bound is built first and always handed on: the same question must not be asked under two keys, or a type that
  // contains itself would recurse until the depth limit instead of finding the answer it is assuming
  const bound = match wanted {
    Some(found) => found
    None => checker.nominal capability, []
  }
  const members = match derivableMembers(checker, annotation, capability, Some(bound)) {
    Some(found) => found
    None => {
      return Resolved.Missing
    }
  }
  const key = (annotation.value, bound.value)
  if const Some(known) = checker.derivedIndex.get(key) {
    return Resolved.Found ImplementationId(known), argumentsOfBound(checker, bound)
  }
  checker.derived.append DerivedImplementation(annotation, bound, members)
  // A derived implementation is an ordinary one for everything that comes after: it answers, and it is indexed
  const module = checker.module
  const package = checker.program.graph.at(module).package
  const at = checker.symbolAt(capability).span
  const generated = Implementation(
    Some(bound),
    annotation,
    [],
    [],
    module,
    package,
    [:],
    None,
    ImplementationOrigin.Derived,
    at,
  )
  const identifier = addOne checker, generated
  checker.derivedIndex.set key, identifier.value
  forgetClosedAnswers checker
  Resolved.Found identifier, argumentsOfBound(checker, bound)
}

/**
 * **An implementation was added, so every answer that assumed a closed world is stale.** [traitsOf] is "every trait
 * this type has", and member lookup is "everything this type has" built on top of it: both are closed-world answers,
 * and both are memoized. A derived implementation is generated the first time somebody asks for it, which is *after*
 * those answers were already given - so a `Show` that is derived here would otherwise be missing from the closure of
 * the type it was derived for, and the member lookup that walked that closure would keep saying "no such member".
 *
 * It costs nothing to be generous: a derived implementation is generated once per type and trait, so this runs a
 * handful of times over a workspace, and what it throws away is rebuilt lazily by the next question.
 */
fn forgetClosedAnswers(var checker: Checker) {
  checker.answerGeneration = checker.answerGeneration + 1
  checker.traitClosures = [:]
  checker.memberAnswers = [:]
  checker.memberMissing = [:]
}

fn argumentsOfBound(checker: Checker, bound: TypeId): List<TypeId> {
  match checker.types.form(bound) {
    .Nominal(_, arguments) => arguments
    _ => []
  }
}

/** Whether an implementation was generated instead of written, which is what coherence and overlap ignore. */
public fn isGenerated(implementation: Implementation): Bool {
  match implementation.origin {
    .Derived => true
    _ => false
  }
}

// --- The `extend` visibility rule -----------------------------------------------------------------------------------

/**
 * Whether the extensions declared in `declaring` reach `module`. An extension of a type of your own package is part of
 * the type everywhere; an extension of a foreign type is visible in every file that imports the module it is written
 * in, whatever it imports from it (`use "./text-extensions"` imports nothing but the extensions).
 *
 * Re-exports count: `lib.trb` of a package is usually nothing but `public use`, and the prelude reaches every file, so
 * `Int.parseDigits` from `std/number` is visible wherever the prelude is.
 */
public fn isVisibleModule(var checker: Checker, module: ModuleId, declaring: ModuleId): Bool {
  if module == declaring {
    return true
  }
  const known = visibleModulesOf checker, module
  known.containsKey declaring.value
}

fn visibleModulesOf(var checker: Checker, module: ModuleId): Map<Int, Bool> {
  if const Some(known) = checker.visibleModules.get(module.value) {
    return known
  }
  var found: Map<Int, Bool> = [:]
  found.set module.value, true
  const package = checker.program.graph.at(module).package
  if const Some(prelude) = checker.program.preludeModules[package] {
    addVisibleModule checker, found, prelude, 0
  }
  const statements = checker.program.graph.at(module).file.statements
  for statement in statements {
    if const .Declare(declaration) = statement.kind {
      if const .Use(usage) = declaration.kind {
        if const .Module(path) = usage.source {
          if const .Found(target) = resolveImport(checker.program.graph, checker.program.workspace, module, path) {
            addVisibleModule checker, found, target, 0
          }
        }
      }
    }
  }
  checker.visibleModules.set module.value, found
  found
}

/** A module that is visible, plus everything it re-exports from: a `public use` hands the extensions on as well. */
fn addVisibleModule(var checker: Checker, var found: Map<Int, Bool>, module: ModuleId, depth: Int) {
  if depth > 8 || found.containsKey(module.value) {
    return
  }
  found.set module.value, true
  const statements = checker.program.graph.at(module).file.statements
  for statement in statements {
    if const .Declare(declaration) = statement.kind {
      if declaration.modifiers.visibility != Visibility.Public {
        continue
      }
      if const .Use(usage) = declaration.kind {
        if const .Module(path) = usage.source {
          if const .Found(target) = resolveImport(checker.program.graph, checker.program.workspace, module, path) {
            addVisibleModule(checker, found, target, depth + 1)
          }
        }
      }
    }
  }
}

/** The package a type was declared in, which decides whether an extension of it is part of the type everywhere. */
public fn packageOfType(checker: Checker, annotation: TypeId): Int {
  match headSymbolOf(checker, annotation) {
    Some(symbol) => packageOfSymbol checker, symbol
    None => -1
  }
}

/**
 * `use String.shout from "acme/text"` where `acme/text` attaches no such member: an import is a promise about another
 * package, and one that is not kept is reported at the line that made it rather than at every use of the name.
 */
public fn checkMemberImports(var checker: Checker, module: ModuleId) {
  const statements = checker.program.graph.at(module).file.statements
  for statement in statements {
    if const .Declare(declaration) = statement.kind {
      if const .Use(usage) = declaration.kind {
        if const .Module(path) = usage.source {
          if const .Names(items) = usage.items {
            for item in items {
              checkOneMemberImport checker, module, path, item
            }
          }
        }
      }
    }
  }
}

fn checkOneMemberImport(var checker: Checker, module: ModuleId, path: String, item: UseItem) {
  const members = checker.program.scopes[module.value].members
  const entry = match memberImportOf(members, path, item) {
    Some(found) => found
    None => {
      return
    }
  }
  const at = item.name().span
  buildImplementations checker
  const candidates = checker.implementations.inherentOf Some(entry.owner)
  for index in candidates {
    const implementation = checker.implementations.all[index]
    if implementation.package == entry.package && implementation.members.containsKey(entry.name) {
      return
    }
  }
  const owner = checker.symbolAt(entry.owner).name
  checker.report(
    module,
    Diagnostic.error("`{entry.path}` adds no member `{entry.name}` to `{owner}`", at)
      .withNote("A path in a `use` names a case of a type or a member an `extend` of that package adds to it")
  )
}

/**
 * Whether the members a trait puts on a type have to be *named* in the file that uses them.
 *
 * They do when the implementation comes from another package than the type: `extend String with Slug` in `acme` is the
 * trait's package attaching itself to a type it does not own, so `Slug` says where those members come from. What the
 * type's own package attaches - `type Circle with Shape`, `extend Circle with Shape` there - is part of the type
 * everywhere, and so is an implementation this package wrote itself.
 *
 * A type parameter (`Item: Slug`) and a trait-typed value carry the trait in their own type, so they name it already.
 */
public fn requiresTraitName(var checker: Checker, receiver: TypeId, bound: TypeId): Bool {
  if const .Parameter(_) = checker.types.form(receiver) {
    return false
  }
  if const .Traits(_) = checker.types.form(receiver) {
    return false
  }
  const owner = packageOfType checker, receiver
  const here = checker.program.graph.at(checker.module).package
  if const .Found(identifier, _) = resolveBound(checker, receiver, bound) {
    const package = checker.implementations.at(identifier).package
    return package != owner && package != here
  }
  false
}

/** Whether the file being checked has this symbol as a name: its own declarations, its imports and its prelude. */
public fn isNamedHere(var checker: Checker, symbol: SymbolId): Bool {
  const known = visibleSymbolsOf checker, checker.module
  known.containsKey symbol.value
}

fn visibleSymbolsOf(var checker: Checker, module: ModuleId): Map<Int, Bool> {
  if const Some(known) = checker.visibleSymbols.get(module.value) {
    return known
  }
  var found: Map<Int, Bool> = [:]
  for (_, symbol) in checker.program.scopes[module.value].names {
    found.set symbol.value, true
  }
  for (_, symbol) in checker.program.builtins {
    found.set symbol.value, true
  }
  checker.visibleSymbols.set module.value, found
  found
}

/**
 * A trait that puts `name` on this type although the file does not name the trait: the trait's name and where it is
 * declared, which is what the message about it offers as a `use` line.
 */
public fn hiddenTraitMemberOf(var checker: Checker, annotation: TypeId, name: String): (String, ModuleId)? {
  for bound in traitsOf(checker, annotation) {
    const symbol = match checker.types.form(bound) {
      .Nominal(found, _) => found
      _ => {
        continue
      }
    }
    const identifier = typeSignatureOf checker, symbol
    if !checker.typeSignature(identifier).members.containsKey(name) {
      continue
    }
    if isNamedHere(checker, symbol) {
      continue
    }
    if !requiresTraitName(checker, annotation, bound) {
      continue
    }
    const declared = checker.symbolAt symbol
    if const Some(module) = declared.module {
      const found = (declared.name, module)
      return Some found
    }
  }
  None
}

/**
 * How a module is written in a `use`: `"std/time"` for the `src/lib.trb` of that package, `"std/time/zone"` for its
 * `src/zone.trb`. Every message that offers a `use` line needs this - a file path would not be one.
 */
public fn importPathOf(checker: Checker, module: ModuleId): String {
  const found = checker.program.graph.at module
  const package = checker.program.workspace.packages[found.package]
  const prefix = joinPath package.directory, "src"
  var relative = found.path
  relative = relative.withoutPrefix("{prefix}/") ?? relative
  relative = relative.withoutSuffix(".trb") ?? relative
  if relative == "lib" || relative.isEmpty() {
    return package.name
  }
  "{package.name}/{relative}"
}

/** The package a symbol's declaration belongs to, by index into `Workspace.packages`: `-1` for one with no module. */
public fn packageOfSymbol(checker: Checker, symbol: SymbolId): Int {
  match checker.symbolAt(symbol).module {
    Some(module) => checker.program.graph.at(module).package
    None => -1
  }
}

/**
 * The inherent extensions of a type that this file may use.
 *
 * A member is visible everywhere if the package of the **type** attached it - `extend Int64 { ... }` in `std/number` is
 * part of `Int64` for everybody, and so is an `extend` in the package that wrote it, because a file sees what its own
 * package declares. Everything else is *named*: `use Int64.seconds from "std/time"` says where the member comes from,
 * and only the files that write that line have it.
 */
public fn inherentExtensionsOf(var checker: Checker, annotation: TypeId): List<Int> {
  buildImplementations checker
  const key = (checker.module.value, annotation.value)
  if const Some(known) = checker.visibleExtensions.get(key) {
    return known
  }
  const head = headSymbolOf checker, annotation
  const candidates = checker.implementations.inherentOf head
  const owner = packageOfType checker, annotation
  const here = checker.program.graph.at(checker.module).package
  var found: List<Int> = []
  for index in candidates {
    const implementation = checker.implementations.all[index]
    var mapping: Map<ParameterId, TypeId> = [:]
    if !matchTarget(checker, implementation, annotation, mapping) {
      continue
    }
    if !boundsHold(checker, implementation, mapping) {
      continue
    }
    if !isExtensionNamedHere(checker, implementation, owner, here, head) {
      continue
    }
    found.append index
  }
  checker.visibleExtensions.set key, found
  found
}

/**
 * Whether an `extend` reaches this file: the package of the type attached it, this package attached it, or this file
 * named a member that comes from there - of the type itself, or of the trait the `extend` is written on, which is how
 * `use Iterate.parallel from "std/parallel"` reaches a `List`.
 */
fn isExtensionNamedHere(var checker: Checker, implementation: Implementation, owner: Int, here: Int, head: SymbolId?): Bool {
  if implementation.package == owner || implementation.package == here {
    return true
  }
  for symbol in namingHeadsOf(checker, implementation, head) {
    if checker.program.importsMemberFrom(checker.module, symbol, implementation.package) {
      return true
    }
  }
  false
}

/** The symbols a `use Type.member` line may name to reach an extension: the type the member is read on, then its target. */
fn namingHeadsOf(checker: Checker, implementation: Implementation, head: SymbolId?): List<SymbolId> {
  var heads: List<SymbolId> = []
  if const Some(found) = head {
    heads.append found
  }
  if const Some(target) = headSymbolOf(checker, implementation.target) {
    if !heads.contains(target) {
      heads.append target
    }
  }
  heads
}

/**
 * Which member symbol `name` reaches in one extension. For an extension of the type's own package (or of this one) that
 * is the name itself; for a foreign one it is what the `use` line named, which `as` may have renamed
 * (`use String.shout as yell` makes `yell` the member `shout`).
 */
public fn extensionMemberOf(var checker: Checker, index: Int, annotation: TypeId, name: String): SymbolId? {
  const implementation = checker.implementations.all[index]
  const owner = packageOfType checker, annotation
  const here = checker.program.graph.at(checker.module).package
  if implementation.package == owner || implementation.package == here {
    if const Some(found) = implementation.members.get(name) {
      return Some found
    }
  }
  for symbol in namingHeadsOf(checker, implementation, headSymbolOf(checker, annotation)) {
    for entry in checker.program.memberImportsOf(checker.module, symbol, name) {
      if entry.package != implementation.package {
        continue
      }
      if const Some(found) = implementation.members.get(entry.name) {
        return Some found
      }
    }
  }
  None
}

/** The same, but without the import rule: what a "this file does not import it" message needs. */
public fn hiddenExtensionOf(var checker: Checker, annotation: TypeId, name: String): ModuleId? {
  buildImplementations checker
  const head = headSymbolOf checker, annotation
  const candidates = checker.implementations.inherentOf head
  const owner = packageOfType checker, annotation
  const here = checker.program.graph.at(checker.module).package
  for index in candidates {
    const implementation = checker.implementations.all[index]
    if !implementation.members.containsKey(name) {
      continue
    }
    if isExtensionNamedHere(checker, implementation, owner, here, head) {
      continue
    }
    var mapping: Map<ParameterId, TypeId> = [:]
    if matchTarget(checker, implementation, annotation, mapping) {
      return Some implementation.module
    }
  }
  None
}

/** The substitution one implementation needs for this type: its own parameters, filled in from the match. */
public fn mappingOfImplementation(
  var checker: Checker,
  index: Int,
  annotation: TypeId,
): Map<ParameterId, TypeId> {
  const implementation = checker.implementations.all[index]
  var mapping: Map<ParameterId, TypeId> = [:]
  const _ = matchTarget checker, implementation, annotation, mapping
  mapping
}

/**
 * One-directional matching, for the back end: every parameter of `generics` binds to what stands at its place and
 * everything else has to be the same type. The IR lowering builds the substitution of an instance with it - the
 * owner of a member against the type the member was reached on - which is the same question trait resolution asks.
 */
public fn matchTypePattern(
  var checker: Checker,
  pattern: TypeId,
  concrete: TypeId,
  generics: List<ParameterId>,
  var mapping: Map<ParameterId, TypeId>,
): Bool {
  matchPattern checker, pattern, concrete, generics, mapping
}

/**
 * The member an implementation provides under one name: its own, the one the type declares, or the one another
 * implementation of the same target declares - which is how a supertrait is satisfied. The IR lowering builds a
 * witness table from exactly this, so that a table and the checker's own requirement check cannot disagree.
 */
public fn memberOfImplementation(var checker: Checker, implementation: ImplementationId, name: String): SymbolId? {
  providerOf checker, implementation.value, name
}

// --- Coherence ------------------------------------------------------------------------------------------------------

/**
 * The orphan rule and the overlap rule, once for the whole program. Both read the index only, so this runs before any
 * body is checked and cannot depend on the order the modules are walked in.
 */
public fn checkCoherence(var checker: Checker) {
  buildImplementations checker
  const total = checker.implementations.all.length()
  for index in 0..total {
    if isHandWrittenInto(checker, checker.implementations.all[index]) {
      reportHandWrittenInto checker, index
      continue
    }
    checkOrphan checker, index
    checkTraitPromise checker, index
    checkCloseImplementer checker, index
  }
  checkOverlaps checker
}

/**
 * An implementation of `Into` anywhere but in the blanket of the module that declares it. `Into` has exactly one
 * implementation - `extend<Source, Target> Source with Into<Target> where Target: From<Source>` - and a conversion is
 * written as the `From` of its target, which is Rust's `from_over_into` made a rule: the `From` gives the `Into` for
 * free, the other direction gives nothing, and coherence allows the `From` wherever it would allow the `Into`, because
 * the package that owns the source may name it as the argument of `From` ([ownsTraitArgument]).
 */
fn isHandWrittenInto(var checker: Checker, implementation: Implementation): Bool {
  if isGenerated(implementation) {
    return false
  }
  const into = match checker.wellKnown.into {
    Some(found) => found
    None => {
      return false
    }
  }
  if capabilitySymbolOf(checker, implementation.capability) != Some(into) {
    return false
  }
  checker.symbolAt(into).module != Some(implementation.module)
}

/** "Implement `From<Celsius>` for `Float64` instead", with the line to write. One message, and no overlap beside it. */
fn reportHandWrittenInto(var checker: Checker, index: Int) {
  const implementation = checker.implementations.all[index]
  const source = checker.describe implementation.target
  const target = match checker.types.form(implementation.capability ?? checker.invalidType) {
    .Nominal(_, arguments) => {
      match arguments.first() {
        Some(found) => checker.describe found
        None => "Target"
      }
    }
    _ => "Target"
  }
  checker.report(
    implementation.module,
    Diagnostic.error("Implement `From<{source}>` for `{target}` instead; `Into` comes from it", implementation.at)
      .withNote(
        "Write `extend {target} with From<{source}>`: every `From` gives the `Into` of the other direction through"
          + " the one implementation `Into` has, and coherence allows it wherever it allows this one"
      )
  )
}

/**
 * `trait Mound<Item> with From<Iterate<Item>>` promises `From` for **every** `Item`, because a trait's own `with`
 * list is what member lookup reads - so `Mound.from(values)` resolves for any `Item` at all. An implementation of that
 * supertrait for the trait type may therefore not be narrower than the promise:
 * `extend<Item: Hash> Mound<Item> with From<Iterate<Item>>` delivers it for some `Item` and nothing delivers it for
 * the rest, and `Mound.from([Opaque("a")])` type checked with no implementation behind it.
 *
 * Only the plain case is reported: an implementation that carries bounds for a trait whose own generics carry none. A
 * trait that bounds its parameters itself is the author saying the same thing in the place the promise is read.
 */
fn checkTraitPromise(var checker: Checker, index: Int) {
  const implementation = checker.implementations.all[index]
  if isGenerated(implementation) || implementation.bounds.isEmpty() {
    return
  }
  const capability = match capabilitySymbolOf(checker, implementation.capability) {
    Some(found) => found
    None => {
      return
    }
  }
  const head = match headSymbolOf(checker, implementation.target) {
    Some(found) => found
    None => {
      return
    }
  }
  if const .Trait = checker.symbolAt(head).kind {
    const identifier = typeSignatureOf checker, head
    const shape = checker.typeSignature identifier
    if !shape.bounds.isEmpty() {
      return
    }
    var promised = false
    for supertrait in shape.traits {
      if headSymbolOf(checker, supertrait.capability) == Some(capability) {
        promised = true
      }
    }
    if !promised {
      return
    }
    const owner = checker.symbolAt(head).name
    const named = checker.symbolAt(capability).name
    checker.report(
      implementation.module,
      Diagnostic.error(
        "`{owner}` comes with `{named}` for every instantiation, and this implementation holds only for some",
        implementation.at,
      ).withNote(
        "A trait's own `with` list is what member lookup reads, so `{named}` resolves on every `{owner}` while nothing"
          + " implements it for the rest: drop the bounds of this `extend`, or take `{named}` out of"
          + " `trait {owner}`'s `with` list and ask for it at the member (`where Self: {named}<...>`)"
      )
    )
  }
}

/**
 * `extend X with Trait<Arguments...>` needs the current package to declare `X`, or `Trait`, or a type that is named as
 * an argument of the trait.
 */
fn checkOrphan(var checker: Checker, index: Int) {
  const implementation = checker.implementations.all[index]
  if isGenerated(implementation) {
    return
  }
  const declared = match implementation.capability {
    Some(found) => found
    None => {
      return
    }
  }
  const capability = match capabilitySymbolOf(checker, implementation.capability) {
    Some(found) => found
    None => {
      return
    }
  }
  if packageOfSymbol(checker, capability) == implementation.package {
    return
  }
  // A blanket implementation covers every type, so only owning the trait can make it coherent
  if const .Blanket = targetShapeOf(checker, implementation.target) {
    reportOrphan checker, implementation, declared
    return
  }
  // The third way: a type of this package named as an argument of the trait. `extend Float64 with From<Celsius>` is the
  // package of `Celsius` converting its own type into a foreign one, and no other package can write that line
  if ownsTraitArgument(checker, implementation) {
    return
  }
  const head = match headSymbolOf(checker, implementation.target) {
    Some(found) => found
    // A tuple or a function type as the target: nothing owns it
    None => {
      reportOrphan checker, implementation, declared
      return
    }
  }
  if packageOfSymbol(checker, head) == implementation.package {
    return
  }
  reportOrphan checker, implementation, declared
}

/**
 * Whether a type this package declares stands as an argument of the trait: `extend Float64 with From<Celsius>` in the
 * package of `Celsius`. Only the owner of `Celsius` satisfies the rule this way, the owner of `Float64` and the owner
 * of `From` satisfy it through the other two, and a fourth package owns none of the three - so the implementation
 * still has exactly one possible author.
 *
 * Only the **top level** of an argument counts, and only a named type. `From<List<Celsius>>` does not: an argument
 * that merely contains an owned type somewhere inside would let one package claim an implementation through a
 * nesting another package wrote, and the overlap rule proves disjointness by heads alone.
 */
fn ownsTraitArgument(var checker: Checker, implementation: Implementation): Bool {
  const applied = implementation.capability ?? checker.invalidType
  const arguments = match checker.types.form(applied) {
    .Nominal(_, held) => held
    _ => {
      return false
    }
  }
  for argument in arguments {
    if const Some(symbol) = headSymbolOf(checker, argument) {
      if packageOfSymbol(checker, symbol) == implementation.package {
        return true
      }
    }
  }
  false
}

fn reportOrphan(var checker: Checker, implementation: Implementation, applied: TypeId) {
  const target = checker.describe implementation.target
  const capability = checker.describe applied
  const message = "`extend {target} with {capability}`: neither `{target}` nor `{capability}` belongs to this package"
  var note = "An implementation belongs to the package of the type or to the package of the trait,"
    + " so that no two packages can write the same one"
  // With arguments there is a third way in, and a trait that has them is exactly where somebody reaches for it:
  // `extend Float64 with From<Celsius>` converts an owned type into a foreign one
  if hasArguments(checker, applied) {
    note = note + ", or to the package of a type named as an argument of the trait"
  }
  checker.report implementation.module, Diagnostic.error(message, implementation.at).withNote(note)
}

fn hasArguments(checker: Checker, applied: TypeId): Bool {
  if const .Nominal(_, held) = checker.types.form(applied) {
    return !held.isEmpty()
  }
  false
}

/** Two implementations of one trait may not overlap, and disjointness is only proved by different heads. */
fn checkOverlaps(var checker: Checker) {
  var groups: Map<Int, List<Int>> = [:]
  const total = checker.implementations.all.length()
  for index in 0..total {
    const implementation = checker.implementations.all[index]
    if isGenerated(implementation) {
      continue
    }
    if const Some(capability) = capabilitySymbolOf(checker, implementation.capability) {
      var known = groups.get(capability.value) ?? []
      known.append index
      groups.set capability.value, known
    }
  }
  for (_, group) in groups {
    for outer in 0..group.length() {
      for inner in (outer + 1)..group.length() {
        reportOverlap checker, group[outer], group[inner]
      }
    }
  }
}

fn reportOverlap(var checker: Checker, first: Int, second: Int) {
  const left = checker.implementations.all[first]
  const right = checker.implementations.all[second]
  // A hand-written `Into` has its own message already, and the overlap with the blanket is only the same fact again
  if isHandWrittenInto(checker, left) || isHandWrittenInto(checker, right) {
    return
  }
  if reportTraitTargetOverlap(checker, left, right) || reportTraitTargetOverlap(checker, right, left) {
    return
  }
  if !couldUnify(checker, left.target, right.target) {
    return
  }
  const leftTrait = left.capability ?? checker.invalidType
  const rightTrait = right.capability ?? checker.invalidType
  if !couldUnify(checker, leftTrait, rightTrait) {
    return
  }
  // One of the two covers every type: the other one was written by hand against a trait nobody implements directly,
  // and the message that helps is the line to write instead
  if reportBlanketOverlap(checker, left, right) {
    return
  }
  if reportBlanketOverlap(checker, right, left) {
    return
  }
  const target = checker.describe right.target
  const capability = checker.describe rightTrait
  const other = checker.program.graph.at(left.module).path
  checker.report(
    right.module,
    Diagnostic.error("`{target}` already implements `{capability}` (in `{other}`)", right.at)
      .withNote("Two implementations of one trait may not overlap: only different target types tell them apart")
  )
}

/**
 * `extend Shape with Describe` next to `type Square with Shape, Describe`: a `Square` would answer `describe` with its
 * own member, and the same value seen as a `Shape` with the extension's - so what a call does would depend on the
 * static type it was made through. That is an overlap, reported at the implementation for the trait, and the type's own
 * stays the answer ([ownOfTwo]). Answers whether it said anything.
 */
fn reportTraitTargetOverlap(var checker: Checker, forTrait: Implementation, own: Implementation): Bool {
  const traitHead = match targetShapeOf(checker, forTrait.target) {
    .Bounded(found) => found
    _ => {
      return false
    }
  }
  const ownHead = match targetShapeOf(checker, own.target) {
    .Concrete(found) => found
    _ => {
      return false
    }
  }
  // A trait target that only the trait-typed value reaches (`From` answers `Self`) never meets the type's own
  if !reachesImplementers(checker, forTrait.capability) {
    return false
  }
  const leftTrait = forTrait.capability ?? checker.invalidType
  const rightTrait = own.capability ?? checker.invalidType
  if !couldUnify(checker, leftTrait, rightTrait) {
    return false
  }
  if !resolveTrait(checker, own.target, traitHead).isFound() {
    return false
  }
  const typeName = checker.symbolAt(ownHead).name
  const traitName = checker.symbolAt(traitHead).name
  const capability = checker.describe rightTrait
  // Where the type's own implementation is written, when that is another file
  const elsewhere = if own.module == forTrait.module {
    ""
  } else {
    " (in `{importPathOf(checker, own.module)}`)"
  }
  checker.report(
    forTrait.module,
    Diagnostic.error(
      "`{typeName}` implements `{capability}` itself{elsewhere}, and it is a `{traitName}`",
      forTrait.at,
    ).withNote(
      "A `{typeName}` would answer differently when it is seen as a `{traitName}`: what a call does may not depend"
        + " on the type it is made through. Implement `{capability}` in one of the two places"
    )
  )
  true
}

/**
 * `extend Celsius with Into<Float64>`: the trait already has a **blanket** implementation, so nobody implements it
 * directly and the overlap is not the point - the point is which trait to implement instead.
 *
 * Answers whether it said anything. It says something where `blanket` covers every type, where the hand-written one
 * does not, and where the blanket names one bound on one trait in its `where` clause - which is what makes the line to
 * write derivable. Anything else keeps the plain overlap message.
 */
fn reportBlanketOverlap(var checker: Checker, blanket: Implementation, written: Implementation): Bool {
  if written.module == blanket.module {
    return false
  }
  const covered = targetShapeOf checker, blanket.target
  if const .Blanket = targetShapeOf(checker, written.target) {
    return false
  }
  if const .Blanket = covered {
    const advice = match blanketAdviceOf(checker, blanket, written) {
      Some(found) => found
      None => {
        return false
      }
    }
    const capability = nameOfCapability checker, written.capability
    const source = nameOfCapability checker, firstBoundTraitOf(blanket)
    const package = checker.program.workspace.packages[blanket.package].name
    const target = checker.describe written.target
    var note = "Write `{advice}`: the blanket implementation in `{package}` makes it out of that"
    if const Some(member) = onlyMemberOf(blanket) {
      note = "Write `{advice}`: the blanket implementation in `{package}` makes `{target}.{member}()` out of that"
    }
    checker.report(
      written.module,
      Diagnostic.error("`{capability}` comes from `{source}` for every type", written.at).withNote(note)
    )
    return true
  }
  false
}

/**
 * The line to write instead: the blanket's own `where` clause with the concrete types of the hand-written
 * implementation put in. `Target: From<Source>` with `Source` as `Celsius` and `Target` as `Float64` is
 * `extend Float64 with From<Celsius>`.
 */
fn blanketAdviceOf(var checker: Checker, blanket: Implementation, written: Implementation): String? {
  if blanket.bounds.length() != 1 {
    return None
  }
  const bound = blanket.bounds[0]
  if bound.traits.length() != 1 {
    return None
  }
  const generics = blanket.generics
  var mapping: Map<ParameterId, TypeId> = [:]
  const target = written.target
  if !matchTypePattern(checker, blanket.target, target, generics, mapping) {
    return None
  }
  const pattern = blanket.capability ?? checker.invalidType
  const applied = written.capability ?? checker.invalidType
  if !matchTypePattern(checker, pattern, applied, generics, mapping) {
    return None
  }
  const subject = substitute checker.types, bound.subject, mapping
  const capability = substitute checker.types, bound.traits[0], mapping
  if !isConcrete(checker, subject) || !isConcrete(checker, capability) {
    return None
  }
  const shownSubject = checker.describe subject
  const shownCapability = checker.describe capability
  Some "extend {shownSubject} with {shownCapability}"
}

/** The trait of the first bound of an implementation, which for a blanket is where its condition stands. */
fn firstBoundTraitOf(implementation: Implementation): TypeId? {
  const bound = implementation.bounds.first()?
  bound.traits.first()
}

/** `Into` of `Into<Target>`, for a message that talks about the trait and not about one application of it. */
fn nameOfCapability(checker: Checker, applied: TypeId?): String {
  match capabilitySymbolOf(checker, applied) {
    Some(symbol) => checker.symbolAt(symbol).name
    None => "the trait"
  }
}

/** The one member a blanket provides, where it provides exactly one: `into` of the blanket over `From`. */
fn onlyMemberOf(implementation: Implementation): String? {
  if implementation.members.length() != 1 {
    return None
  }
  for (name, _) in implementation.members {
    return Some name
  }
  None
}

/** Conservative: a generic parameter unifies with anything, and only two different heads are provably disjoint. */
fn couldUnify(checker: Checker, left: TypeId, right: TypeId): Bool {
  if left == right {
    return true
  }
  if isOpenType(checker, left) || isOpenType(checker, right) {
    return true
  }
  match checker.types.form(left) {
    .Nominal(symbol, arguments) => {
      if const .Nominal(other, otherArguments) = checker.types.form(right) {
        return symbol == other && couldUnifyAll(checker, arguments, otherArguments)
      }
      false
    }
    .Traits(bounds) => {
      if const .Traits(otherBounds) = checker.types.form(right) {
        return couldUnifyAll checker, bounds, otherBounds
      }
      false
    }
    _ => false
  }
}

fn couldUnifyAll(checker: Checker, left: List<TypeId>, right: List<TypeId>): Bool {
  if left.length() != right.length() {
    return false
  }
  for index in 0..left.length() {
    if !couldUnify(checker, left[index], right[index]) {
      return false
    }
  }
  true
}

fn isOpenType(checker: Checker, annotation: TypeId): Bool {
  match checker.types.form(annotation) {
    .Parameter(_) | .Variable(_) | .Invalid | .Deferred => true
    _ => false
  }
}

// --- What an implementation has to provide --------------------------------------------------------------------------

/**
 * Every required member of every trait an implementation of this module names, and of their supertraits. A `native`
 * type meets a requirement with a member it writes a body for, or with a row of the manifest of natives
 * (`backend/c/natives.trb`) - the runtime's half of the contract, which is checked here like the source's half.
 */
public fn checkImplementations(var checker: Checker, module: ModuleId) {
  buildImplementations checker
  const total = checker.implementations.all.length()
  var rows: Map<String, Bool>? = None
  for index in 0..total {
    const implementation = checker.implementations.all[index]
    if implementation.module != module {
      continue
    }
    // The manifest is only read where a native type implements something, which is a handful of files of `std/`
    if rows.isNone() && isNativeTarget(checker, implementation.target) {
      rows = Some manifestRows()
    }
    checkOneImplementation(checker, index, rows ?? [:])
  }
}

/** `"Int64.add"` for every row of the manifest; `"Int64.tryFrom(String)"` answers for `"Int64.tryFrom"` as well. */
fn manifestRows(): Map<String, Bool> {
  var rows: Map<String, Bool> = [:]
  for entry in nativeEntries() {
    const name = entry.name
    rows.set name, true
    if const Some(bare) = name.substringBefore("(") {
      rows.set bare, true
    }
  }
  rows
}

fn checkOneImplementation(var checker: Checker, index: Int, rows: Map<String, Bool>) {
  const implementation = checker.implementations.all[index]
  if isGenerated(implementation) {
    return
  }
  const declared = match implementation.capability {
    Some(found) => found
    None => {
      return
    }
  }
  const target = implementation.target
  if checker.isBroken(target) || checker.isBroken(declared) {
    return
  }
  // A trait as the target is a blanket over its implementors; a bare parameter covers every type. Neither has members
  // of its own to check against, so the members of the extension are all there is
  if const .Blanket = targetShapeOf(checker, target) {
    return
  }
  var closure: List<TypeId> = []
  addClosure checker, closure, declared, target, 0
  for bound in closure {
    checkRequirements checker, index, declared, bound, closure, rows
  }
}

fn checkRequirements(
  var checker: Checker,
  index: Int,
  declared: TypeId,
  bound: TypeId,
  closure: List<TypeId>,
  rows: Map<String, Bool>,
) {
  const implementation = checker.implementations.all[index]
  const capability = match headSymbolOf(checker, bound) {
    Some(found) => found
    None => {
      return
    }
  }
  const identifier = typeSignatureOf checker, capability
  const shape = checker.typeSignature identifier
  const target = implementation.target
  const isNative = isNativeTarget checker, target
  var mapping: Map<ParameterId, TypeId> = [:]
  const arguments = argumentsOfBound checker, bound
  for position in 0..shape.generics.length().min(arguments.length()) {
    mapping.set shape.generics[position], arguments[position]
  }
  if const .Parameter(parameter) = checker.types.form(shape.own) {
    mapping.set parameter, target
  }
  for (name, member) in shape.members {
    const identifier = signatureOf checker, member
    const signature = checker.signature identifier
    if signature.hasBody || hasConditions(checker, member) {
      continue
    }
    match providerOf(checker, index, name) {
      Some(provider) => {
        // A `native fn` the type declares is the runtime's to implement, so the manifest has to name it
        const identifier = signatureOf checker, provider
        if isNative && !checker.signature(identifier).hasBody {
          if !hasManifestRow(checker, rows, target, name) {
            reportMissingRow checker, index, bound, name
          }
          continue
        }
        compareSignatures checker, index, bound, name, member, provider, mapping
      }
      None => {
        // `trait List<Item> with MutableSlice` writes `slice` itself: a default of any trait in the closure is the
        // implementation of the requirement, and nothing is asked of the type
        if hasDefaultInClosure(checker, closure, name) || isProvidedOtherwise(checker, index, bound) {
          continue
        }
        // `native type Int64 with Signed {}`: `Int64.add` is a row of the manifest and nothing in the source. A constant
        // is never a row: `static zero: Int64 = 0` is written in the source like any other constant of the type
        if isNative && !isConstantSymbol(checker, member) {
          if !hasManifestRow(checker, rows, target, name) {
            reportMissingRow checker, index, bound, name
          }
          continue
        }
        reportMissingMember checker, index, declared, bound, name, member, mapping
      }
    }
  }
}

/** Whether the declaration is a constant: a `static zero = ...` of a type, or the `static zero: Self` a trait requires. */
public fn isConstantSymbol(checker: Checker, symbol: SymbolId): Bool {
  match checker.symbolAt(symbol).kind {
    .Constant => true
    _ => false
  }
}

/** A `native type`: what the runtime provides, in the implementation of its own `with` list and in an `extend` of it. */
fn isNativeTarget(var checker: Checker, target: TypeId): Bool {
  if const .Nominal(symbol, _) = checker.types.form(target) {
    const identifier = typeSignatureOf checker, symbol
    return checker.typeSignature(identifier).isNative
  }
  false
}

/** Whether the manifest of natives has a row for this member of this type: `"Int64.add"`, `"ArrayList.append"`. */
fn hasManifestRow(checker: Checker, rows: Map<String, Bool>, target: TypeId, name: String): Bool {
  const head = match headSymbolOf(checker, target) {
    Some(found) => found
    None => {
      return true
    }
  }
  rows.containsKey "{checker.symbolAt(head).name}.{name}"
}

fn reportMissingRow(var checker: Checker, index: Int, bound: TypeId, name: String) {
  const implementation = checker.implementations.all[index]
  const target = checker.describe implementation.target
  const capability = checker.describe bound
  const owner = match headSymbolOf(checker, implementation.target) {
    Some(head) => checker.symbolAt(head).name
    None => target
  }
  checker.report(
    implementation.module,
    Diagnostic.error("`{target}` implements `{capability}`, and nothing provides its `{name}`", implementation.at)
      .withNote(
        "A native type meets a requirement with a body, or with the row `{owner}.{name}` in the manifest of natives"
          + " (`compiler/src/backend/c/natives.trb`)"
      )
  )
}

/** Whether any trait of the closure writes this member with a body, which makes it no requirement on the type. */
fn hasDefaultInClosure(var checker: Checker, closure: List<TypeId>, name: String): Bool {
  defaultOfClosure(checker, closure, name).isSome()
}

/**
 * The member one of these traits writes with a body. `defaultInClosureOf` and the requirement check ask the same
 * question, so the back end finds the very default that made the program legal.
 */
fn defaultOfClosure(var checker: Checker, closure: List<TypeId>, name: String): SymbolId? {
  for bound in closure {
    const capability = match headSymbolOf(checker, bound) {
      Some(found) => found
      None => {
        continue
      }
    }
    const identifier = typeSignatureOf checker, capability
    const member = match checker.typeSignature(identifier).members.get(name) {
      Some(found) => found
      None => {
        continue
      }
    }
    const signature = signatureOf checker, member
    if checker.signature(signature).hasBody {
      return Some member
    }
  }
  None
}

/**
 * The default that stands in for a member a *supertrait* requires and no implementation writes.
 * `Slice.slice` is required by `Slice` and written with a body by its **subtrait** `List`, and
 * `checkRequirements` accepts exactly that through `hasDefaultInClosure` - so a back end that looked only in the
 * implementation of the requiring trait and in that trait itself would refuse a program the checker approved. The trait
 * closure is walked in the order it was built, nearest the type first.
 */
public fn defaultInClosureOf(var checker: Checker, annotation: TypeId, name: String): SymbolId? {
  const closure = traitsOf checker, annotation
  defaultOfClosure checker, closure, name
}

/** A member with a `where` clause of its own exists only where the clause holds, so it is no requirement. */
fn hasConditions(checker: Checker, member: SymbolId): Bool {
  const site = match checker.siteOf(member) {
    Some(found) => found
    None => {
      return false
    }
  }
  match functionOfSite(site) {
    Some(function) => !function.whereClauses.isEmpty()
    None => false
  }
}

/** `by field` forwards every required member, and a derived implementation generates all of them. */
fn isProvidedOtherwise(var checker: Checker, index: Int, bound: TypeId): Bool {
  const implementation = checker.implementations.all[index]
  if implementation.delegate.isSome() {
    return true
  }
  const capability = match headSymbolOf(checker, bound) {
    Some(found) => found
    None => {
      return true
    }
  }
  // `extend<Item> List<Item> with Cut<Item, ArrayList<Item>>`, where `Cut` requires `Iterate<Item>`: the target is a
  // trait that requires `Iterate<Item>` itself, so every value the implementation applies to has it
  if const .Traits(bounds) = checker.types.form(implementation.target) {
    for own in bounds {
      if sameType(checker.types, own, bound) || isSupertraitOfBound(checker, own, bound, implementation.target) {
        return true
      }
    }
  }
  derivableMembers(checker, implementation.target, capability, Some(bound)).isSome()
}

/** Where a member of the target comes from: the implementation, the body of the type, or another extension of it. */
fn providerOf(var checker: Checker, index: Int, name: String): SymbolId? {
  const implementation = checker.implementations.all[index]
  if const Some(symbol) = implementation.members.get(name) {
    return Some symbol
  }
  const target = implementation.target
  if const .Nominal(symbol, _) = checker.types.form(target) {
    const identifier = typeSignatureOf checker, symbol
    const shape = checker.typeSignature identifier
    if const Some(member) = shape.members.get(name) {
      return Some member
    }
    for field in shape.fields {
      if field.name == name {
        return Some field.symbol
      }
    }
  }
  const head = headSymbolOf checker, target
  const candidates = checker.implementations.declaredFor head
  const extensions = checker.implementations.inherentOf head
  for other in candidates {
    if isSiblingOf(checker, index, other) {
      continue
    }
    if const Some(member) = memberOfSameTarget(checker, other, target, name) {
      return Some member
    }
  }
  for other in extensions {
    if const Some(member) = memberOfSameTarget(checker, other, target, name) {
      return Some member
    }
  }
  // A supertrait is satisfied by *any* implementation of the same target, not only by members of the same `extend`
  // block: `extend<Item: Hash> List<Item> with Hash` leans on `extend<Item: Equals> List<Item> with Equals` for the
  // `equals` that `Hash with Equals` requires. Those targets are a trait type, so they are in `open` and not in `byHead`
  const open = checker.implementations.open
  for other in open {
    if isSiblingOf(checker, index, other) {
      continue
    }
    if const Some(member) = memberOfSameTarget(checker, other, target, name) {
      return Some member
    }
  }
  const openExtensions = checker.implementations.inherentOpen
  for other in openExtensions {
    if const Some(member) = memberOfSameTarget(checker, other, target, name) {
      return Some member
    }
  }
  None
}

/**
 * Whether another implementation implements the **same trait** with other arguments: `Float64` comes `with Power` from
 * the runtime, which writes no member, and `extend Float64 with Power<Int64>` writes `power(exponent: Int64)`. That member
 * is the other implementation's own and never the member of this one, although the name and the count of parameters
 * agree - reading it as one sent `2.0 ** 0.5` to the power by a whole number.
 */
fn isSiblingOf(var checker: Checker, index: Int, other: Int): Bool {
  if index == other {
    return false
  }
  const own = checker.implementations.all[index].capability
  const found = checker.implementations.all[other].capability
  if const Some(first) = own {
    if const Some(second) = found {
      const capability = headSymbolOf checker, first
      return capability.isSome() && capability == headSymbolOf(checker, second)
    }
  }
  false
}

/**
 * Whether one implementation provides a member for this very target. The other implementation's own parameters are
 * bound by matching its target against this one, and its bounds have to hold under that match - `Item: Equals` of the
 * `Equals` implementation holds for the `Item: Hash` of the `Hash` one, because `Hash` requires `Equals`.
 */
fn memberOfSameTarget(var checker: Checker, index: Int, target: TypeId, name: String): SymbolId? {
  const implementation = checker.implementations.all[index]
  const member = implementation.members.get(name)?
  if sameType(checker.types, implementation.target, target) {
    return Some member
  }
  var mapping: Map<ParameterId, TypeId> = [:]
  if !matchTarget(checker, implementation, target, mapping) {
    return None
  }
  if !boundsHold(checker, implementation, mapping) {
    return None
  }
  Some member
}

/**
 * The signature the trait asks for against the one the type provides. Neither may carry anything that is broken or not
 * checked yet: a difference that comes out of a missing piece of the checker is not a mistake in the source.
 *
 * A requirement with type parameters of its own - `fn encode<Target: Encoder>(var target: Target)` - is met only by a
 * member with as many of its own, in the same places and under the same bounds: the requirement's parameters are
 * renamed to the member's, position by position, and then the two forms have to be the same. A member with a different
 * number of them is always a mismatch, `fn encode(var target: Encoder)` for the requirement above too.
 *
 * # Open
 *
 * A member inside of a generic `extend` (`Item` of `extend<Item: Encode> List<Item>`), and a member for a generic trait
 * (`TryFrom<Source, Failure>`), is held to the count of its own parameters and no further: its `Self` is the implementing
 * type while the requirement says the target, a type body may hold one member per instantiation of the trait, and
 * comparing the two forms needs the substitution that tells those apart.
 */
fn compareSignatures(
  var checker: Checker,
  index: Int,
  bound: TypeId,
  name: String,
  member: SymbolId,
  provider: SymbolId,
  mapping: Map<ParameterId, TypeId>,
) {
  if member == provider {
    return
  }
  const wantedSignature = signatureOf checker, member
  const required = checker.signature wantedSignature
  const givenSignature = signatureOf checker, provider
  const given = checker.signature givenSignature
  // `static zero: Self` is read as `Value.zero` and `static fn zero(): Self` is called as `Value.zero()`, so the two
  // never stand in for each other, however alike their forms are
  const isConstant = isConstantSymbol checker, member
  if isConstant != isConstantSymbol(checker, provider) {
    reportMismatch checker, index, bound, name, member, provider, mapping
    return
  }
  const requiredOwn = ownGenericsOf checker, required
  const givenOwn = ownGenericsOf checker, given
  var renamed = mapping
  var isSameShape = requiredOwn.length() == givenOwn.length()
  if isSameShape {
    for position in 0..requiredOwn.length() {
      renamed.set requiredOwn[position], checker.types.intern(TypeForm.Parameter(givenOwn[position]))
    }
  }
  const wanted = substituteFunction checker.types, required.form, renamed
  if !isComparableForm(checker, wanted) || !isComparableForm(checker, given.form) {
    return
  }
  if isSameShape {
    isSameShape = sameOwnBounds checker, required, requiredOwn, given, givenOwn, renamed
  }
  // A member of a generic `extend` or of a generic trait is held to its own parameters and to nothing more, see # Open
  const hasOuterGenerics = given.generics.length() > givenOwn.length()
  const isInsideGeneric = hasOuterGenerics || required.generics.length() > requiredOwn.length()
  if isSameShape && isInsideGeneric {
    return
  }
  if isSameShape && required.takesSelf == given.takesSelf && sameFunction(checker.types, wanted, given.form) {
    return
  }
  reportMismatch checker, index, bound, name, member, provider, mapping
}

/** "`Point.zero` does not match `Zero`", with the requirement written the way the trait writes it. */
fn reportMismatch(
  var checker: Checker,
  index: Int,
  bound: TypeId,
  name: String,
  member: SymbolId,
  provider: SymbolId,
  mapping: Map<ParameterId, TypeId>,
) {
  const identifier = signatureOf checker, member
  const required = checker.signature identifier
  const requiredOwn = ownGenericsOf checker, required
  const implementation = checker.implementations.all[index]
  const target = checker.describe implementation.target
  const capability = checker.describe bound
  const generics = describeOwnGenerics checker, required, requiredOwn, mapping
  const asked = substituteFunction checker.types, required.form, mapping
  const isConstant = isConstantSymbol checker, member
  const shown = describeRequirement(
    checker,
    "{name}{generics}",
    required.takesSelf,
    required.isVarSelf,
    asked,
    isConstant: isConstant,
  )
  const at = checker.symbolAt(provider).span
  checker.report(
    implementation.module,
    Diagnostic.error("`{target}.{name}` does not match `{capability}`", at)
      .withNote("`{capability}` requires `{shown}`")
  )
}

/** The type parameters a function declares itself, in order - not the ones of the `trait`, `type` or `extend` around it. */
fn ownGenericsOf(checker: Checker, signature: Signature): List<ParameterId> {
  var found: List<ParameterId> = []
  for parameter in signature.generics {
    if checker.types.parameter(parameter).owner == Some(signature.symbol) {
      found.append parameter
    }
  }
  found
}

/** The traits one parameter is bounded by in a signature: its inline bounds and its `where` clauses. */
fn boundsOfParameter(var checker: Checker, signature: Signature, parameter: ParameterId): List<TypeId> {
  const subject = checker.types.intern TypeForm.Parameter(parameter)
  var found: List<TypeId> = []
  for bound in signature.bounds {
    if bound.subject == subject {
      found.appendAll bound.traits
    }
  }
  found
}

/**
 * Whether every bound the member puts on a parameter of its own is one the requirement promises for the same position:
 * the same trait, or a supertrait of one of them. A member may ask for less than the requirement promises, never for
 * more, because a caller through the trait only knows what the requirement says.
 */
fn sameOwnBounds(
  var checker: Checker,
  required: Signature,
  requiredOwn: List<ParameterId>,
  given: Signature,
  givenOwn: List<ParameterId>,
  renamed: Map<ParameterId, TypeId>,
): Bool {
  for position in 0..requiredOwn.length() {
    const own = checker.types.intern TypeForm.Parameter(givenOwn[position])
    var promised: List<TypeId> = []
    for bound in boundsOfParameter(checker, required, requiredOwn[position]) {
      promised.append substitute(checker.types, bound, renamed)
    }
    for asked in boundsOfParameter(checker, given, givenOwn[position]) {
      if !isWritten(checker, asked) {
        continue
      }
      var isPromised = false
      for offered in promised {
        if sameType(checker.types, offered, asked) || isSupertraitOfBound(checker, offered, asked, own) {
          isPromised = true
        }
      }
      if !isPromised {
        return false
      }
    }
  }
  true
}

/** `<Target: Encoder>`: the type parameters a requirement declares itself, as its declaration writes them. */
fn describeOwnGenerics(
  var checker: Checker,
  signature: Signature,
  own: List<ParameterId>,
  mapping: Map<ParameterId, TypeId>,
): String {
  if own.isEmpty() {
    return ""
  }
  var parts: List<String> = []
  for parameter in own {
    const name = checker.types.parameter(parameter).name
    var bounds: List<String> = []
    for bound in boundsOfParameter(checker, signature, parameter) {
      bounds.append describeType(checker.types, checker.symbols, substitute(checker.types, bound, mapping))
    }
    if bounds.isEmpty() {
      parts.append name
    } else {
      parts.append "{name}: {bounds.joined(separator: " & ")}"
    }
  }
  "<{parts.joined(separator: ", ")}>"
}

fn isComparableForm(checker: Checker, form: FunctionForm): Bool {
  for parameter in form.parameters {
    if !isWritten(checker, parameter.annotation) {
      return false
    }
  }
  isWritten checker, form.result
}

fn isWritten(checker: Checker, annotation: TypeId): Bool {
  if checker.isBroken(annotation) {
    return false
  }
  match checker.types.form(annotation) {
    .Nominal(_, arguments) => {
      for argument in arguments {
        if !isWritten(checker, argument) {
          return false
        }
      }
      true
    }
    .Traits(bounds) => {
      for argument in bounds {
        if !isWritten(checker, argument) {
          return false
        }
      }
      true
    }
    .Tuple(fields) => {
      for field in fields {
        if !isWritten(checker, field.annotation) {
          return false
        }
      }
      true
    }
    .Function(form) => isComparableForm checker, form
    _ => true
  }
}

fn reportMissingMember(
  var checker: Checker,
  index: Int,
  declared: TypeId,
  bound: TypeId,
  name: String,
  member: SymbolId,
  mapping: Map<ParameterId, TypeId>,
) {
  const implementation = checker.implementations.all[index]
  const wantedSignature = signatureOf checker, member
  const required = checker.signature wantedSignature
  const wanted = substituteFunction checker.types, required.form, mapping
  const target = checker.describe implementation.target
  const capability = checker.describe bound
  const isConstant = isConstantSymbol checker, member
  const shown = describeRequirement checker, name, required.takesSelf, required.isVarSelf, wanted, isConstant: isConstant
  // A supertrait is a requirement like any other, and the message says which trait asked for it
  if !sameType(checker.types, bound, declared) {
    const written = checker.describe declared
    checker.report(
      implementation.module,
      Diagnostic.error("`{written}` requires `{capability}`, and `{target}` has no `{name}`", implementation.at)
        .withNote("`{capability}` requires `{shown}`. A supertrait is a requirement on the implementing type")
    )
    return
  }
  checker.report(
    implementation.module,
    Diagnostic.error("`{target}` implements `{capability}` but has no `{name}`", implementation.at)
      .withNote("`{capability}` requires `{shown}`")
  )
}

/**
 * `fn name(): String`, `var fn name(...)`, `static fn name(...)`, `static zero: Self`: the way the trait writes the
 * requirement down.
 */
fn describeRequirement(
  checker: Checker,
  name: String,
  takesSelf: Bool,
  isVarSelf: Bool,
  form: FunctionForm,
  isConstant: Bool = false,
): String {
  if isConstant {
    return "{staticKeyword} {name}: {describeType(checker.types, checker.symbols, form.result)}"
  }
  const keyword = if !takesSelf {
    "{staticKeyword} fn"
  } else if isVarSelf {
    "var fn"
  } else {
    "fn"
  }
  var parts: List<String> = []
  for parameter in form.parameters {
    const shown = describeType checker.types, checker.symbols, parameter.annotation
    const named = match parameter.name {
      Some(label) => "{label}: {shown}"
      None => shown
    }
    parts.append(match parameter.mode {
      .Var => "var {named}"
      .Lazy => "lazy {named}"
      .Variadic => "...{named}"
      _ => named
    })
  }
  const joined = parts.joined separator: ", "
  const returns = describeType checker.types, checker.symbols, form.result
  if returns == "Void" {
    return "{keyword} {name}({joined})"
  }
  "{keyword} {name}({joined}): {returns}"
}
