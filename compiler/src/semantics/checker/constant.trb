/**
 * What "compile-time evaluable" means for the initializer of a top-level `const` of a module, and the folding
 * that comes with it: the arithmetic, comparison and logical operators of the built-in number types and of `Bool` are
 * part of the set, so [evaluateConstant] evaluates them - and a constant whose evaluation overflows or divides by zero
 * is a compile error at that expression.
 *
 * This evaluator is deliberately self-contained and small. The back end has one of its own that has to agree with it;
 * what they share is the rule, not the code.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Expression, Argument, TextSegment, InfixOperator, PrefixOperator from "../../syntax/ast"
use ModuleId from "../module"
use SymbolId from "../symbols"
use Checker from "./context"
use integerLiteral, unsignedLiteral from "./lowering"
use bindingOfSite, resultOf, signatureOf, isTraitConstant from "./signature"
use targetDimensionNamed from "../../backend/c/natives"
use isSharedType from "./declaration"

/**
 * What a compile-time constant is worth. Only the scalars fold - an aggregate is evaluable exactly when its parts are,
 * and nothing in the language reads one at compile time.
 */
public type ConstantValue {
  case Integer(value: Int)
  case Floating(value: Float)
  case Text(value: String)
  case Character(value: Char)
  case Boolean(value: Bool)
  /** A tuple, a list, a map, a range, a constructor or a case: evaluable, and nothing folds it. */
  case Composite
  /**
   * A number or a `Bool` that is known at compile time and that the checker's own integers do not hold: a `UInt64`
   * above the largest `Int64`, and what an operator makes of one. It is evaluable and nothing here folds it - the back
   * end holds the literal as its bits and folds or computes the rest (`ir/constant.trb`), so an overflow in such an
   * expression is the run time's to report, as it is for every `UInt64` operation [requireCertainArithmetic] skips.
   */
  case Unfolded
}

/** What evaluating an initializer produced. */
public type ConstantResult {
  case Value(value: ConstantValue)
  /** The innermost expression that is not compile-time evaluable, which is where the message points. */
  case NotConstant(at: Span)
  /** Overflow or a division by zero, reported at the expression that did it: nothing follows from it. */
  case Broken
}

/** A constant that names a constant that names a constant: a cycle is reported elsewhere, here it is a limit. */
const constantDepthLimit = 32

/**
 * The initializer of a top-level `const` of a module. It has to be known at compile time, which is what removes module
 * initialization order and makes a cyclic import harmless; in an entry file, a script or a test file a top-level
 * `const` is ordinary code and this is never asked.
 */
public fn checkConstantInitializer(var checker: Checker, module: ModuleId, value: Expression) {
  const found = evaluateConstant checker, module, value, 0
  if const .NotConstant(at) = found {
    checker.report(
      module,
      Diagnostic.error("The initializer of a top-level `const` has to be known at compile time", at)
        .withNote(
          "A module has no initialization order: literals, the operators of the number types and of `Bool`,"
            + " interpolation, tuple, list and map literals, constructor calls of such, and other compile-time"
            + " constants. `Point(0, 0)` is one, `Point.origin()` is a call and is not",
        ),
    )
  }
}

/**
 * The default of a field is a constant: a literal, `None`, a collection literal, a constructor or a case of constants,
 * a named constant, and the compile-time operators on those - what the initializer of a top-level `const` may be -
 * plus a closure that captures nothing, which the constructor only stores. A constructor has no body, so nothing it
 * fills in may run code, and a value that is computed comes from a `static fn` factory. A constant is built once and
 * shared, so it never makes a `shared type`: an object has an identity, and every value needs one of its own.
 *
 * The empty literal the message offers is what the field's type starts from, where there is one.
 */
public fn checkFieldDefaultConstant(var checker: Checker, module: ModuleId, value: Expression, emptyLiteral: String?) {
  // A closure that captures nothing is a function value the constructor only stores: `var onStart: () => Void = {}`
  if const .Closure(_) = value.kind {
    if (checker.capturesAt(module, value.span) ?? []).isEmpty() {
      return
    }
  }
  const found = evaluateConstant checker, module, value, 0
  const at = match found {
    .NotConstant(span) => span
    _ => {
      if const Some(made) = objectMadeIn(checker, module, value) {
        const shown = checker.describe(checker.expressionType(module, made.span) ?? checker.deferredType)
        checker.report(
          module,
          Diagnostic.error(
            "A field default is a constant, and this makes a `{shown}`: every value needs an object of its own - make"
              + " it in a `static fn`",
            made.span,
          )
            .withNote("A constant is built once and shared, and an object has an identity, so it is never shared"),
        )
      }
      return
    }
  }
  const offending = expressionAt(value, at) ?? value
  const instead = match emptyLiteral {
    Some(literal) => "compute it in a `static fn`, or start from `{literal}`"
    None => "compute it in a `static fn`"
  }
  const message = match offending.kind {
    .Call(callee, _, _) => {
      match calleeText(callee) {
        Some(written) => "A field default is a constant: `{written}` is a call - {instead}"
        None => "A field default is a constant, and this is a call - {instead}"
      }
    }
    .Name(text) => "A field default is a constant: `{text}` is not one - {instead}"
    .Binary(operator, _, _) => {
      const spelled = operatorSpelling operator
      "A field default is a constant: `{spelled}` here is a call of its trait - {instead}"
    }
    .Closure(_) => "A field default is a constant, and this closure captures a binding - {instead}"
    _ => "A field default is a constant, and this is computed - {instead}"
  }
  checker.report(
    module,
    Diagnostic.error(message, at)
      .withNote(
        "A constructor has no body: a default is a literal, a collection literal, a constructor or a case of"
          + " constants, a named constant, or an operator on those - so it can be built once and shared",
      ),
  )
}

/** The first constructor or case call in a constant that builds a `shared type`, which has an identity. */
fn objectMadeIn(var checker: Checker, module: ModuleId, expression: Expression): Expression? {
  if const .Call(_, _, _) = expression.kind {
    const resolution = checker.resolutionAt module, expression.span
    const isBuilt = match resolution {
      Some(.Construct(_)) | Some(.CaseOf(_, _)) => true
      _ => false
    }
    if isBuilt {
      if const Some(built) = checker.expressionType(module, expression.span) {
        if isSharedType(checker, built) {
          return expression
        }
      }
    }
  }
  for child in childrenOf(expression) {
    if const Some(found) = objectMadeIn(checker, module, child) {
      return found
    }
  }
  None
}

/** An infix operator as it is written. */
fn operatorSpelling(operator: InfixOperator): String {
  match operator {
    .Add => "+"
    .Subtract => "-"
    .Multiply => "*"
    .Divide => "/"
    .Remainder => "%"
    .Power => "**"
    .BitwiseAnd => "&"
    .BitwiseOr => "|"
    .BitwiseExclusiveOr => "^"
    .ShiftLeft => "<<"
    .ShiftRight => ">>"
    .Equal => "=="
    .NotEqual => "!="
    .Less => "<"
    .LessOrEqual => "<="
    .Greater => ">"
    .GreaterOrEqual => ">="
    .And => "&&"
    .Or => "||"
    .Coalesce => "??"
  }
}

/** The callee of a call as it was written, without type arguments: `List.filled`, `Set.of`, `.max`. */
fn calleeText(callee: Expression): String? {
  match callee.kind {
    .Name(text) => text
    .ImplicitMember(name) => ".{name.text}"
    .Generic(target, _) => calleeText target
    .Member(target, name, _) => {
      match calleeText(target) {
        Some(base) => "{base}.{name.text}"
        None => ".{name.text}"
      }
    }
    _ => None
  }
}

/** The part of `expression` that starts and ends at `at`, which is what [evaluateConstant] names when it gives up. */
fn expressionAt(expression: Expression, at: Span): Expression? {
  if expression.span == at {
    return expression
  }
  for child in childrenOf(expression) {
    if const Some(found) = expressionAt(child, at) {
      return found
    }
  }
  None
}

/** The parts [evaluateConstant] descends into. */
fn childrenOf(expression: Expression): List<Expression> {
  match expression.kind {
    .TextLiteral(segments) => {
      var found: List<Expression> = []
      for segment in segments {
        if const .Interpolated(inner) = segment {
          found.append inner
        }
      }
      found
    }
    .Unary(_, operand) => [operand]
    .Binary(_, left, right) => [left, right]
    .TupleLiteral(items) => valuesOf items
    .ListLiteral(items) => valuesOf items
    .MapLiteral(entries) => {
      var found: List<Expression> = []
      for (key, value) in entries {
        found.append key
        found.append value
      }
      found
    }
    .RangeLiteral(start, end, _) => {
      var found: List<Expression> = []
      if const Some(first) = start {
        found.append first
      }
      if const Some(last) = end {
        found.append last
      }
      found
    }
    .Call(_, arguments, _) => valuesOf arguments
    .Generic(target, _) => [target]
    _ => []
  }
}

fn valuesOf(arguments: List<Argument>): List<Expression> {
  var found: List<Expression> = []
  for argument in arguments {
    found.append argument.value
  }
  found
}

/** Whether an initializer is compile-time evaluable, without saying anything about it. */
public fn isCompileTimeConstant(var checker: Checker, module: ModuleId, value: Expression): Bool {
  isValue evaluateConstant(checker, module, value, 0)
}

fn isValue(result: ConstantResult): Bool {
  match result {
    .Value(_) => true
    _ => false
  }
}

/**
 * One expression, folded as far as the compile-time operators go. Everything the checker already resolved is read out
 * of the tables, which is why this runs after the body of a module was walked: whether `Point(0, 0)` is a constructor
 * call or a function call is a question only the resolution answers.
 */
public fn evaluateConstant(var checker: Checker, module: ModuleId, expression: Expression, depth: Int): ConstantResult {
  if depth > constantDepthLimit {
    return ConstantResult.NotConstant expression.span
  }
  match expression.kind {
    .IntegerLiteral(text) => integerConstant text, false, expression.span
    .FloatLiteral(text) => floatConstant text, false, expression.span
    .BoolLiteral(value) => ConstantResult.Value ConstantValue.Boolean(value)
    .VoidLiteral => ConstantResult.Value ConstantValue.Composite
    .CharLiteral(value) => ConstantResult.Value ConstantValue.Character(value)
    .TextLiteral(segments) => textConstant checker, module, segments, depth
    .Unary(operator, operand) => unaryConstant checker, module, operator, operand, depth, expression.span
    .Binary(operator, left, right) => binaryConstant checker, module, operator, left, right, depth, expression.span
    .TupleLiteral(items) => argumentsConstant checker, module, items, depth
    .ListLiteral(items) => argumentsConstant checker, module, items, depth
    .MapLiteral(entries) => entriesConstant checker, module, entries, depth
    .RangeLiteral(start, end, _) => rangeConstant checker, module, start, end, depth
    .Call(_, arguments, _) => callConstant checker, module, expression, arguments, depth
    // A name, a member path and `.Case` are all "what did this resolve to"
    .Name(_) | .ImplicitMember(_) => namedConstant checker, module, expression, depth
    .Member(_, _, isOptional) => {
      if isOptional {
        return ConstantResult.NotConstant expression.span
      }
      namedConstant checker, module, expression, depth
    }
    // `List<Int>` in front of a call; alone it names a type, and a type never flows as a value
    .Generic(target, _) => evaluateConstant(checker, module, target, depth + 1)
    _ => ConstantResult.NotConstant expression.span
  }
}

/** A literal the lexer kept the base of. One that does not parse at all was reported where it was written. */
fn integerConstant(text: String, isNegative: Bool, at: Span): ConstantResult {
  match integerLiteral(text, isNegative) {
    Some(.Integer(value)) => ConstantResult.Value ConstantValue.Integer(value)
    // A `UInt64` above the largest `Int64` has no value of the checker's own integers, as `wrappedToWidth` says
    _ => {
      if !isNegative && unsignedLiteral(text).isSome() {
        return ConstantResult.Value ConstantValue.Unfolded
      }
      ConstantResult.Broken
    }
  }
}

fn floatConstant(text: String, isNegative: Bool, at: Span): ConstantResult {
  match Float.tryFrom(text).ok() {
    Some(value) => ConstantResult.Value(ConstantValue.Floating(if isNegative { 0.0 - value } else { value }))
    None => ConstantResult.Broken
  }
}

/**
 * Interpolation is not a function call, so a text of compile-time parts is one. A plain literal keeps its
 * value, because that is the only text anything else could read; an interpolated one is an aggregate like any other.
 */
fn textConstant(var checker: Checker, module: ModuleId, segments: List<TextSegment>, depth: Int): ConstantResult {
  var text = ""
  var isPlain = true
  for segment in segments {
    match segment {
      .Literal(part) => {
        text = text + part
      }
      .Interpolated(inner) => {
        isPlain = false
        const found = evaluateConstant(checker, module, inner, depth + 1)
        if !isValue(found) {
          return found
        }
      }
    }
  }
  if isPlain {
    return ConstantResult.Value ConstantValue.Text(text)
  }
  ConstantResult.Value ConstantValue.Composite
}

fn argumentsConstant(var checker: Checker, module: ModuleId, arguments: List<Argument>, depth: Int): ConstantResult {
  for argument in arguments {
    const found = evaluateConstant(checker, module, argument.value, depth + 1)
    if !isValue(found) {
      return found
    }
  }
  ConstantResult.Value ConstantValue.Composite
}

fn entriesConstant(
  var checker: Checker,
  module: ModuleId,
  entries: List<(Expression, Expression)>,
  depth: Int,
): ConstantResult {
  for (key, value) in entries {
    const found = evaluateConstant(checker, module, key, depth + 1)
    if !isValue(found) {
      return found
    }
    const inner = evaluateConstant(checker, module, value, depth + 1)
    if !isValue(inner) {
      return inner
    }
  }
  ConstantResult.Value ConstantValue.Composite
}

fn rangeConstant(
  var checker: Checker,
  module: ModuleId,
  start: Expression?,
  end: Expression?,
  depth: Int,
): ConstantResult {
  if const Some(first) = start {
    const found = evaluateConstant(checker, module, first, depth + 1)
    if !isValue(found) {
      return found
    }
  }
  if const Some(last) = end {
    const found = evaluateConstant(checker, module, last, depth + 1)
    if !isValue(found) {
      return found
    }
  }
  ConstantResult.Value ConstantValue.Composite
}

/**
 * A call is compile-time evaluable exactly when it builds a value out of its arguments: the generated constructor of a
 * type, or a case constructor. Every other call is code, `native` calls included - and `+` on `String` is one of them.
 *
 * The one exception is a parameter of the build: `targetOperatingSystem()` and its two siblings in `std/core`, which
 * the compiler answers without running anything, so `const system = OperatingSystem.current` is a constant.
 */
fn callConstant(
  var checker: Checker,
  module: ModuleId,
  expression: Expression,
  arguments: List<Argument>,
  depth: Int,
): ConstantResult {
  const resolution = match checker.resolutionAt(module, expression.span) {
    Some(found) => found
    None => {
      return ConstantResult.NotConstant expression.span
    }
  }
  match resolution {
    .Construct(_) | .CaseOf(_, _) => argumentsConstant checker, module, arguments, depth
    .Callable(symbol, _, _) => {
      if arguments.isEmpty() && isTargetConstant(checker, symbol) {
        return ConstantResult.Value ConstantValue.Composite
      }
      ConstantResult.NotConstant expression.span
    }
    // A construct that could not be resolved because of an earlier problem: nothing is said about it a second time
    .Deferred => ConstantResult.Value ConstantValue.Composite
    _ => ConstantResult.NotConstant expression.span
  }
}

/** A free `native fn` without a body that the manifest answers with the build's target (`backend/c/natives.trb`). */
fn isTargetConstant(var checker: Checker, symbol: SymbolId): Bool {
  const identifier = signatureOf checker, symbol
  const signature = checker.signature identifier
  if signature.hasBody || signature.takesSelf || signature.owner.isSome() {
    return false
  }
  targetDimensionNamed(checker.symbolAt(symbol).name).isSome()
}

/** A name that stands for a value: another compile-time constant, a case without fields, or `Void`. */
fn namedConstant(var checker: Checker, module: ModuleId, expression: Expression, depth: Int): ConstantResult {
  const resolution = match checker.resolutionAt(module, expression.span) {
    Some(found) => found
    None => {
      return ConstantResult.NotConstant expression.span
    }
  }
  match resolution {
    .Constant(symbol, _) => constantOfSymbol checker, symbol, expression.span, depth
    .CaseOf(_, _) => ConstantResult.Value ConstantValue.Composite
    .Deferred => ConstantResult.Value ConstantValue.Composite
    _ => ConstantResult.NotConstant expression.span
  }
}

/**
 * Another constant, wherever it is declared: its own initializer is the answer. A `const` that is not compile-time
 * evaluable is reported where *it* is written, so a constant that names one only says "this is not a constant".
 */
fn constantOfSymbol(var checker: Checker, symbol: SymbolId, at: Span, depth: Int): ConstantResult {
  // Asking for the type of a `const` is what checks its initializer, and the resolutions it needs come from that
  const _ = resultOf checker, symbol
  const site = match checker.siteOf(symbol) {
    Some(found) => found
    None => {
      return ConstantResult.NotConstant at
    }
  }
  const binding = match bindingOfSite(site) {
    Some(found) => found
    None => {
      return ConstantResult.NotConstant at
    }
  }
  // `Scalar.zero` of `trait Numeric`: the value is the implementation's, and that one is held to the rule where it is
  // written - the trait's own default included, which is a constant of every implementation that writes none
  if isTraitConstant(checker, symbol) {
    return ConstantResult.Value ConstantValue.Composite
  }
  const found = evaluateConstant(checker, site.module, binding.value, depth + 1)
  if const .NotConstant(_) = found {
    return ConstantResult.NotConstant at
  }
  found
}

// --- The operators --------------------------------------------------------------------------------------------------

fn unaryConstant(
  var checker: Checker,
  module: ModuleId,
  operator: PrefixOperator,
  operand: Expression,
  depth: Int,
  at: Span,
): ConstantResult {
  // `-9223372036854775808` only exists as a literal with its sign: the positive half does not fit any integer type
  if const .Negate = operator {
    if const .IntegerLiteral(text) = operand.kind {
      return integerConstant text, true, operand.span
    }
    if const .FloatLiteral(text) = operand.kind {
      return floatConstant text, true, operand.span
    }
  }
  const inner = evaluateConstant(checker, module, operand, depth + 1)
  const value = match inner {
    .Value(found) => found
    _ => {
      return inner
    }
  }
  if const .Unfolded = value {
    return inner
  }
  match operator {
    .Negate => {
      match value {
        .Integer(number) => {
          if number == Int.minimum {
            return reportOverflow checker, module, at
          }
          ConstantResult.Value ConstantValue.Integer(0 - number)
        }
        .Floating(number) => ConstantResult.Value ConstantValue.Floating(0.0 - number)
        _ => ConstantResult.NotConstant at
      }
    }
    .Not => {
      match value {
        .Boolean(flag) => ConstantResult.Value ConstantValue.Boolean(!flag)
        _ => ConstantResult.NotConstant at
      }
    }
    // `~0` is `-1` in an `Int8` and `255` in a `UInt8`: the answer is the width's, so the width is asked for
    .BitwiseNot => {
      const number = match value {
        .Integer(found) => found
        _ => {
          return ConstantResult.NotConstant at
        }
      }
      const (width, isSigned) = match integerWidthAt(checker, module, at) {
        Some(found) => found
        None => {
          return ConstantResult.NotConstant at
        }
      }
      match wrappedToWidth(~number, width, isSigned) {
        Some(found) => ConstantResult.Value ConstantValue.Integer(found)
        // `~0` of a `UInt64` is its largest value, which no `Int64` holds
        None => ConstantResult.Value ConstantValue.Unfolded
      }
    }
  }
}

/**
 * `&`, `|` and `^` of two integers, and the two shifts. The shifts drop what leaves the width of the type, exactly as
 * the runtime does, and a shift by a negative amount or by the width or more is a compile error, where the runtime
 * panics.
 */
fn bitsConstant(
  var checker: Checker,
  module: ModuleId,
  operator: InfixOperator,
  a: ConstantValue,
  b: ConstantValue,
  at: Span,
): ConstantResult {
  const (width, isSigned) = match integerWidthAt(checker, module, at) {
    Some(found) => found
    None => {
      return ConstantResult.NotConstant at
    }
  }
  const isShift = match operator {
    .ShiftLeft | .ShiftRight => true
    _ => false
  }
  // The amount is held to the width whatever it shifts, a value the checker does not hold included
  if const .Integer(amount) = b {
    if isShift && (amount < 0 || amount >= width) {
      checker.report(
        module,
        Diagnostic.error("This shifts by {amount}, which is not between 0 and {width - 1}", at)
          .withNote("A compile-time constant is evaluated while the program is compiled, so a program that cannot start does not compile"),
      )
      return ConstantResult.Broken
    }
  }
  if isUnfoldedInteger(a, b) {
    return ConstantResult.Value ConstantValue.Unfolded
  }
  const left = match a {
    .Integer(found) => found
    _ => {
      return ConstantResult.NotConstant at
    }
  }
  const right = match b {
    .Integer(found) => found
    _ => {
      return ConstantResult.NotConstant at
    }
  }
  const raw = match operator {
    .BitwiseAnd => left & right
    .BitwiseOr => left | right
    .BitwiseExclusiveOr => left ^ right
    .ShiftLeft => left << right
    _ => left >> right
  }
  match wrappedToWidth(raw, width, isSigned) {
    Some(found) => ConstantResult.Value ConstantValue.Integer(found)
    // `1 << 63` of a `UInt64` is above the largest `Int64`
    None => ConstantResult.Value ConstantValue.Unfolded
  }
}

/**
 * Whether an operator of two integers meets a value the checker does not hold, which makes its result one as well: the
 * other operand is an integer or another such value, or the operator would be a call of its trait.
 */
fn isUnfoldedInteger(a: ConstantValue, b: ConstantValue): Bool {
  match (a, b) {
    (.Unfolded, .Unfolded) | (.Unfolded, .Integer(_)) | (.Integer(_), .Unfolded) => true
    _ => false
  }
}

/** The same for `&&`, `||` and the equality of a `Bool`: a comparison of a value the checker does not hold is one. */
fn isUnfoldedBoolean(a: ConstantValue, b: ConstantValue): Bool {
  match (a, b) {
    (.Unfolded, .Unfolded) | (.Unfolded, .Boolean(_)) | (.Boolean(_), .Unfolded) => true
    _ => false
  }
}

/**
 * The width and the signedness of the integer type the checker gave the expression at `at`: what `~` and the shifts
 * need to know, and nothing else of the evaluator does.
 */
fn integerWidthAt(checker: Checker, module: ModuleId, at: Span): (Int, Bool)? {
  const found = checker.expressionType(module, at)?
  if const .Nominal(symbol, arguments) = checker.types.form(found) {
    if arguments.isEmpty() {
      return widthOfInteger(checker.wellKnown.numericNamed(symbol)?)
    }
  }
  None
}

fn widthOfInteger(name: String): (Int, Bool)? {
  match name {
    "Int8" => (8, true)
    "Int16" => (16, true)
    "Int32" => (32, true)
    "Int64" => (64, true)
    "UInt8" => (8, false)
    "UInt16" => (16, false)
    "UInt32" => (32, false)
    "UInt64" => (64, false)
    _ => None
  }
}

/**
 * A value brought into a width: the bits above it dropped, and for a signed type the highest one that is left
 * extended. A `UInt64` above the largest `Int64` has no value of the checker's own integers, so it is `None` - such a
 * constant is not folded here.
 */
fn wrappedToWidth(value: Int, width: Int, isSigned: Bool): Int? {
  if width == 64 {
    if !isSigned && value < 0 {
      return None
    }
    return value
  }
  const modulus = 1 << width
  const low = value & (modulus - 1)
  if isSigned && low >= modulus / 2 {
    return low - modulus
  }
  low
}

fn binaryConstant(
  var checker: Checker,
  module: ModuleId,
  operator: InfixOperator,
  left: Expression,
  right: Expression,
  depth: Int,
  at: Span,
): ConstantResult {
  const first = evaluateConstant(checker, module, left, depth + 1)
  const a = match first {
    .Value(found) => found
    _ => {
      return first
    }
  }
  const second = evaluateConstant(checker, module, right, depth + 1)
  const b = match second {
    .Value(found) => found
    _ => {
      return second
    }
  }
  match operator {
    .Add | .Subtract | .Multiply | .Divide | .Remainder | .Power => arithmeticConstant(
      checker,
      module,
      operator,
      a,
      b,
      at,
    )
    .BitwiseAnd | .BitwiseOr | .BitwiseExclusiveOr | .ShiftLeft | .ShiftRight => {
      bitsConstant checker, module, operator, a, b, at
    }
    .Equal | .NotEqual => equalityConstant operator, a, b, at
    .Less | .LessOrEqual | .Greater | .GreaterOrEqual => orderConstant operator, a, b, at
    .And | .Or => logicalConstant operator, a, b, at
    // `a ?? b` is `orElse`, which is a call like any other
    .Coalesce => ConstantResult.NotConstant at
  }
}

/**
 * The arithmetic of the built-in number types. `+` on a `String` is `Add.add` and therefore a call, so only
 * the numbers fold here - and every result is checked before it is built, because a checker that overflows would take
 * the whole compiler with it instead of reporting the line.
 */
fn arithmeticConstant(
  var checker: Checker,
  module: ModuleId,
  operator: InfixOperator,
  a: ConstantValue,
  b: ConstantValue,
  at: Span,
): ConstantResult {
  if const .Integer(left) = a {
    if const .Integer(right) = b {
      return integerArithmetic checker, module, operator, left, right, at
    }
  }
  if const .Floating(left) = a {
    if const .Floating(right) = b {
      return floatArithmetic checker, module, operator, left, right, at
    }
  }
  if isUnfoldedInteger(a, b) {
    // Whatever it divides, a divisor that is known to be zero is one
    if const .Integer(0) = b {
      match operator {
        .Divide | .Remainder => {
          return reportDivisionByZero checker, module, at
        }
        _ => {}
      }
    }
    return ConstantResult.Value ConstantValue.Unfolded
  }
  ConstantResult.NotConstant at
}

fn integerArithmetic(
  var checker: Checker,
  module: ModuleId,
  operator: InfixOperator,
  left: Int,
  right: Int,
  at: Span,
): ConstantResult {
  const folded = match operator {
    .Add => addedIntegers left, right
    .Subtract => subtractedIntegers left, right
    .Multiply => multipliedIntegers left, right
    .Divide => {
      if right == 0 {
        return reportDivisionByZero checker, module, at
      }
      // `Int.minimum / -1` is the one division whose result does not fit
      if left == Int.minimum && right == -1 {
        return reportOverflow checker, module, at
      }
      Some(left / right)
    }
    .Remainder => {
      if right == 0 {
        return reportDivisionByZero checker, module, at
      }
      // `Int.minimum % -1` is zero, and the division it is defined through would overflow on the way
      if left == Int.minimum && right == -1 {
        Some 0
      } else {
        Some(left % right)
      }
    }
    .Power => {
      if right < 0 {
        return reportNegativeExponent checker, module, at
      }
      poweredIntegers left, right
    }
    _ => None
  }
  match folded {
    Some(value) => ConstantResult.Value ConstantValue.Integer(value)
    None => reportOverflow checker, module, at
  }
}

fn floatArithmetic(
  var checker: Checker,
  module: ModuleId,
  operator: InfixOperator,
  left: Float,
  right: Float,
  at: Span,
): ConstantResult {
  const folded = match operator {
    .Add => left + right
    .Subtract => left - right
    .Multiply => left * right
    .Divide => {
      if right == 0.0 {
        return reportDivisionByZero checker, module, at
      }
      left / right
    }
    .Remainder => {
      if right == 0.0 {
        return reportDivisionByZero checker, module, at
      }
      left % right
    }
    _ => {
      return ConstantResult.NotConstant at
    }
  }
  ConstantResult.Value ConstantValue.Floating(folded)
}

/** `Int.maximum - right` is safe for a positive `right`, and `Int.minimum - right` for a negative one. */
fn addedIntegers(left: Int, right: Int): Int? {
  if right > 0 && left > Int.maximum - right {
    return None
  }
  if right < 0 && left < Int.minimum - right {
    return None
  }
  left + right
}

fn subtractedIntegers(left: Int, right: Int): Int? {
  if right < 0 && left > Int.maximum + right {
    return None
  }
  if right > 0 && left < Int.minimum + right {
    return None
  }
  left - right
}

/**
 * The product, tested by division so that nothing is ever computed that does not fit. `0` and `1` are separate because
 * `Int.minimum` has no positive counterpart, which is what makes `-1` the only interesting factor.
 */
fn multipliedIntegers(left: Int, right: Int): Int? {
  if left == 0 || right == 0 {
    return 0
  }
  if left == 1 {
    return right
  }
  if right == 1 {
    return left
  }
  if left == -1 {
    if right == Int.minimum {
      return None
    }
    return 0 - right
  }
  if right == -1 {
    if left == Int.minimum {
      return None
    }
    return 0 - left
  }
  const fits = if left > 0 && right > 0 {
    left <= Int.maximum / right
  } else if left < 0 && right < 0 {
    left >= Int.maximum / right
  } else if left > 0 {
    right >= Int.minimum / left
  } else {
    left >= Int.minimum / right
  }
  if !fits {
    return None
  }
  left * right
}

/**
 * `base ** exponent` for an exponent that is not negative, by squaring, or `None` where it does not fit. The factor is
 * squared only while a bit of the exponent is left to use it, so no intermediate is larger than the result and nothing
 * overflows that the result would not.
 */
fn poweredIntegers(base: Int, exponent: Int): Int? {
  var result = 1
  var factor = base
  var left = exponent
  while left > 0 {
    if left % 2 == 1 {
      result = multipliedIntegers(result, factor)?
    }
    left = left / 2
    if left > 0 {
      factor = multipliedIntegers(factor, factor)?
    }
  }
  result
}

/** `==` and `!=` on the number types and on `Bool`. Everything else is `Equals.equals` and therefore a call. */
fn equalityConstant(operator: InfixOperator, a: ConstantValue, b: ConstantValue, at: Span): ConstantResult {
  if isUnfoldedInteger(a, b) || isUnfoldedBoolean(a, b) {
    return ConstantResult.Value ConstantValue.Unfolded
  }
  var isEqual = false
  var isKnown = false
  if const .Integer(left) = a {
    if const .Integer(right) = b {
      isEqual = left == right
      isKnown = true
    }
  }
  if const .Floating(left) = a {
    if const .Floating(right) = b {
      isEqual = left == right
      isKnown = true
    }
  }
  if const .Boolean(left) = a {
    if const .Boolean(right) = b {
      isEqual = left == right
      isKnown = true
    }
  }
  if !isKnown {
    return ConstantResult.NotConstant at
  }
  const isNotEqual = match operator {
    .NotEqual => true
    _ => false
  }
  ConstantResult.Value(ConstantValue.Boolean(if isNotEqual { !isEqual } else { isEqual }))
}

/** `<`, `<=`, `>`, `>=` on the number types: `Compare.compare` is a call for everything else. */
fn orderConstant(operator: InfixOperator, a: ConstantValue, b: ConstantValue, at: Span): ConstantResult {
  if isUnfoldedInteger(a, b) {
    return ConstantResult.Value ConstantValue.Unfolded
  }
  var order = 0
  var isKnown = false
  if const .Integer(left) = a {
    if const .Integer(right) = b {
      order = if left < right { -1 } else if left > right { 1 } else { 0 }
      isKnown = true
    }
  }
  if const .Floating(left) = a {
    if const .Floating(right) = b {
      order = if left < right { -1 } else if left > right { 1 } else { 0 }
      isKnown = true
    }
  }
  if !isKnown {
    return ConstantResult.NotConstant at
  }
  const found = match operator {
    .Less => order < 0
    .LessOrEqual => order <= 0
    .Greater => order > 0
    .GreaterOrEqual => order >= 0
    _ => false
  }
  ConstantResult.Value ConstantValue.Boolean(found)
}

fn logicalConstant(operator: InfixOperator, a: ConstantValue, b: ConstantValue, at: Span): ConstantResult {
  if isUnfoldedBoolean(a, b) {
    return ConstantResult.Value ConstantValue.Unfolded
  }
  const left = match a {
    .Boolean(found) => found
    _ => {
      return ConstantResult.NotConstant at
    }
  }
  const right = match b {
    .Boolean(found) => found
    _ => {
      return ConstantResult.NotConstant at
    }
  }
  const isAnd = match operator {
    .And => true
    _ => false
  }
  ConstantResult.Value(ConstantValue.Boolean(if isAnd { left && right } else { left || right }))
}

/**
 * An integer operation of any body whose outcome is known while the program is compiled, and certain to panic:
 * `value / 0`, `Int.maximum + 1`, `Int8.maximum + 1` (docs/design/PANICS.md 5.1, clause 3). The operands are folded
 * as the initializer of a module's `const` is; an operand that is not known leaves the operation alone, except for a
 * divisor that is known to be zero, which panics whatever it divides. `name` is the integer type of the result, which
 * says where its range ends.
 */
public fn requireCertainArithmetic(
  var checker: Checker,
  module: ModuleId,
  operator: InfixOperator,
  left: Expression,
  right: Expression,
  at: Span,
  name: String,
) {
  const (width, isSigned) = match widthOfInteger(name) {
    Some(found) => found
    None => {
      return
    }
  }
  // The initializer of a constant is the evaluator's, which reports what it cannot fold where it is written
  if checker.inInitializer {
    return
  }
  match operator {
    .Add | .Subtract | .Multiply | .Divide | .Remainder => {}
    _ => {
      return
    }
  }
  const divisor = match evaluateConstant(checker, module, right, 0) {
    .Value(.Integer(found)) => found
    _ => {
      return
    }
  }
  const isDivision = match operator {
    .Divide | .Remainder => true
    _ => false
  }
  const dividend = match evaluateConstant(checker, module, left, 0) {
    .Value(.Integer(found)) => found
    _ => {
      // Whatever it divides, a divisor that is known to be zero panics
      if isDivision && divisor == 0 {
        const spelling = operatorSpelling operator
        checker.report(
          module,
          Diagnostic.error("`{spelling}` by zero panics wherever it runs, and this divisor is zero", at)
            .withNote("`dividedChecked` and `remainderChecked` answer an `Option` for a divisor that may be zero"),
        )
      }
      return
    }
  }
  // The checker folds in an `Int64`, which holds no `UInt64` above its own largest value: those are not folded
  if name == "UInt64" {
    return
  }
  const folded = match integerArithmetic(checker, module, operator, dividend, divisor, at) {
    .Value(.Integer(found)) => found
    _ => {
      return
    }
  }
  if width < 64 && wrappedToWidth(folded, width, isSigned) != folded {
    checker.report(
      module,
      Diagnostic.error("This does not fit into an `{name}`, so it panics wherever it runs", at)
        .withNote("Both operands are known here. `addedChecked` and its siblings answer an `Option` instead"),
    )
  }
}

fn reportOverflow(var checker: Checker, module: ModuleId, at: Span): ConstantResult {
  checker.report(
    module,
    Diagnostic.error("This does not fit into an `Int64`", at)
      .withNote("A compile-time constant is evaluated while the program is compiled, so an overflow it is written with is caught here"),
  )
  ConstantResult.Broken
}

fn reportNegativeExponent(var checker: Checker, module: ModuleId, at: Span): ConstantResult {
  checker.report(
    module,
    Diagnostic.error("This raises an integer to a negative power, which is not a whole number", at)
      .withNote("A compile-time constant is evaluated while the program is compiled, so a program that cannot start does not compile"),
  )
  ConstantResult.Broken
}

fn reportDivisionByZero(var checker: Checker, module: ModuleId, at: Span): ConstantResult {
  checker.report(
    module,
    Diagnostic.error("This divides by zero", at)
      .withNote("A compile-time constant is evaluated while the program is compiled, so a program that cannot start does not compile"),
  )
  ConstantResult.Broken
}
