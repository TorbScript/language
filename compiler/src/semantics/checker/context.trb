use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Declaration, Member, Binding from "../../syntax/ast"
use ModuleId from "../module"
use SymbolId, Symbol, Symbols from "../symbols"
use Program from "../scope"
use TypeId, TypeForm, TypeTable, FunctionForm, ParameterId, VariableId, Bound, describeType from "./type"
use Signature, SignatureId, SignatureState, TypeSignature, TypeSignatureId from "./type"
use ImplementationId, ImplementationTable, Resolved, Witness, DerivedImplementation from "./type"
use WellKnown, wellKnownOf from "./wellknown"
use MatchPlan from "./exhaustive"

/** What may stand in a type position: a type, or the value a `const` parameter asks for. */
public type TypePosition {
  /** A field, a result, a bound, the argument of an ordinary type parameter. */
  case Type
  /** `Array<Float, 16>`: the parameter is a `const`, so a value stands here and not a type. */
  case Constant
  /**
   * `Matrix<Rows, Other>()` in an expression: which parameter an argument fills is only known once the callee is
   * resolved, which is milestone 4.2. Until then both are allowed here.
   */
  case Either
}

/**
 * Where a type reference stands, and what may stand there. One small value instead of five parameters, because every
 * position of the language differs in exactly these points.
 */
public type TypeScope {
  module: ModuleId
  /** What `Self` means here. `None` outside of a type, a trait or an `extend`. */
  selfType: TypeId? = None
  position: TypePosition = TypePosition.Type
  /** The subject of the bound that is being built: `with Add` means `Add<Self, Self>` with `Self` the subject. */
  subject: TypeId? = None
  /** A default of a generic parameter is recorded where it is written, not again at every use. */
  records: Bool = true

  /** An ordinary type position: a field, a result, a type argument. */
  fn forType(self): TypeScope {
    copy(position: TypePosition.Type, subject: None)
  }

  /** `with Show`, `where Item: Hash`: the trait, plus what it is asked of. */
  fn forBound(self, of: TypeId): TypeScope {
    copy(position: TypePosition.Type, subject: Some(of))
  }

  /** The argument of a `const` parameter. */
  fn forConstant(self): TypeScope {
    copy(position: TypePosition.Constant, subject: None)
  }

  /** The explicit type arguments of an expression, where the callee is not resolved yet. */
  fn forEither(self): TypeScope {
    copy(position: TypePosition.Either, subject: None)
  }

  /** A const argument is one value. Where the checker does not know yet, a lone literal is taken as one. */
  fn takesConstant(self): Bool {
    match position {
      .Type => false
      _ => true
    }
  }

  fn takesType(self): Bool {
    match position {
      .Constant => false
      _ => true
    }
  }
}

// --- What the checker resolves --------------------------------------------------------------------------------------

/** The index of a local binding in `Checker.bindings`: a `const`, a `var`, a parameter, `self`, a pattern name. */
public type BindingId {
  value: Int
}

/**
 * One local binding. Locals are not symbols: they belong to one body, nothing imports them, and a message about one
 * points at the place it was written. They still get ids, because `Resolution.Local` has to name one.
 */
public type LocalBinding {
  name: String
  annotation: TypeId
  isVar: Bool
  /** The span of the name, which is what a message about the declaration points at. */
  at: Span
  /** `self` and a receiver closure's parameter: the one binding whose members a bare name may mean. */
  isReceiver: Bool = false
  /**
   * A `var` parameter and `var self` write back into the caller's place, so a change to one is never dead (design 5.3)
   * and a closure that may outlive the call may not capture one (BACKEND gap 14).
   */
  isParameter: Bool = false
  /** A `lazy Value` parameter: every read of it forces the cell, which records `Adaptation.Force` (design 3.4). */
  isLazy: Bool = false
}

/** One name in the scope chain. A list instead of a map: a scope has few names, and extending it must not copy one. */
public type Local {
  name: String
  kind: LocalKind
}

public type LocalKind {
  case Bound(binding: BindingId)
  /** A `fn`, `type` or `trait` declared in this block, and a generic parameter that is in scope as a namespace. */
  case Declared(symbol: SymbolId)
}

/**
 * What a name, a member, a call or a constructor in an expression resolved to. Milestone 5 reads this instead of
 * looking at a name a second time.
 */
public type Resolution {
  case Local(binding: BindingId)
  /** A `fn`, a method, a static function of a type, or a field that holds a closure that is being called. */
  case Callable(symbol: SymbolId, arguments: List<TypeId>, dispatch: Dispatch)
  case Field(owner: TypeId, field: SymbolId)
  case Constant(symbol: SymbolId, owner: TypeId?)
  /** The generated constructor of a type: `Point(10, 20)`, `Self(text)`. */
  case Construct(owner: TypeId)
  /** The generated `copy` of a type (gap 24). */
  case CopyOf(owner: TypeId)
  case CaseOf(owner: TypeId, variant: SymbolId)
  /** `.0`, `.1`, `.lowest`: the position a tuple member means. */
  case TupleField(owner: TypeId, index: Int)
  case Namespace(module: ModuleId)
  /** `Void` in an expression: the one name that is both a type and its only value (gap 1). */
  case VoidValue
  /** The type itself, as the target of a static member or of a constructor: `Point` in `Point.origin`. */
  case TypeOf(owner: TypeId)
  /**
   * `port 8080`, `onStart { ... }`, `database { ... }`: a call of a member that is not callable writes it (gap 15).
   * The kind says which of the three the lowering has to emit.
   */
  case PropertyWrite(owner: TypeId, field: SymbolId, kind: PropertyWriteKind)
  /** A construct a later sub-milestone resolves. It is recorded so that the statistics can count it. */
  case Deferred
}

/**
 * Which of the three forms a property command is. There is no case where a line could mean two of them: a command on
 * a field writes it, and a trailing closure on one configures its value in place unless the field holds a function.
 */
public type PropertyWriteKind {
  /** `port 8080`, `tls(port == 8443)`: the argument is the new value of the field. */
  case Assign
  /** `onStart { print "started" }`: the field holds a function, and the closure becomes its value. */
  case AssignClosure
  /** `database { url "..." }`: the receiver closure is applied to the field's value, which changes in place. */
  case Configure
}

/**
 * One receiver closure, by the span of the closure: `(var self: ServerConfig) => Void`. The lowering needs the binding
 * the receiver is reached under, because an implicit one has no node in the tree that could carry it - every name that
 * means a member of it records `Adaptation.ImplicitSelf` with this very binding.
 *
 * The body of a receiver *script* records one of these at `Span(0, 0)`: the file is that closure.
 */
public type ReceiverClosure {
  binding: BindingId
  annotation: TypeId
  /** `(var self: T) => Void` configures its receiver in place, `(self: T) => Value` reads it. */
  isVar: Bool
  /** Whether the closure wrote the parameter itself (`html { root => ... }`) or `self` is the implicit receiver. */
  isImplicit: Bool
}

/**
 * How a call reaches its target. This is what keeps the back ends out of the choice between monomorphizing and
 * passing a witness table: the checker says which one it is, and both back ends have to support both.
 */
public type Dispatch {
  /** Not a trait member: a free function, a member of a concrete type, a field that holds a closure. */
  case Direct
  /** The implementation is known: monomorphize, or call it directly. */
  case Implementation(implementation: ImplementationId, witnesses: List<Witness>)
  /** The receiver is a trait-typed value: take the member from its witness table. */
  case Object(bound: TypeId, witnesses: List<Witness>)
  /** The receiver's type is a generic parameter: the caller passed the witness. */
  case Forwarded(parameter: ParameterId, bound: TypeId, witnesses: List<Witness>)
}

/**
 * One member that was found, with everything a call or a read of it needs. It lives here and not in `member.trb`
 * because the `Checker` keeps the answers: `a.b` is the hottest question of the pass.
 */
public type Candidate {
  kind: CandidateKind
  /** The member as a value: the type of a field, or the function type of a method bound to its receiver. */
  annotation: TypeId
  /** When the member is a function: its form, with the generic parameters of its owner substituted. */
  form: FunctionForm? = None
  takesSelf: Bool = false
  isVarSelf: Bool = false
  /** The generic parameters the member declares itself, which a call site has to solve. */
  generics: List<ParameterId> = []
  /** The bounds of those parameters, with the arguments of the owner already filled in. */
  bounds: List<Bound> = []
  /** A parameter of the member is `Self` itself, which has no meaning on a trait-typed value (gap 7). */
  takesSelfArgument: Bool = false
  /** Several implementations of one trait provide it (`Int.from`), so the arguments decide which one is meant. */
  needsArguments: Bool = false
  /** The candidates of such an overload set, in the order they were found. */
  overloads: List<Candidate> = []
  /** How the member is reached: a member of the type itself, or one of a trait it implements. */
  dispatch: Dispatch = Dispatch.Direct
  /** Where the member is declared, for the ambiguity message about two extensions. */
  module: ModuleId? = None
}

public type CandidateKind {
  case Field(owner: TypeId, field: SymbolId)
  case Constant(owner: TypeId, symbol: SymbolId)
  case Method(owner: TypeId, symbol: SymbolId)
  case CaseConstructor(owner: TypeId, variant: SymbolId)
  /** The generated constructor of a type. */
  case Construct(owner: TypeId)
  /** The generated `copy` (gap 24). */
  case Copy(owner: TypeId)
  case TupleField(owner: TypeId, index: Int)
}

/**
 * One unification variable. It stands for a generic parameter of one call, or for the item type of an empty collection
 * literal, and it lives inside the inference context of one statement.
 */
public type VariableState {
  /** The parameter it stands for: the `Output` of `map`. Empty for the item type of an empty literal. */
  name: String
  /** What the call is called, so a message can say "Cannot infer `Output` of `map`". */
  owner: String
  /** Where a message about it points: the call or the literal that created it. */
  at: Span
  /** What it was solved with. A variable is solved by an exact type only, never by a coercion. */
  var solution: TypeId? = None
  /** One message per variable, however often it is mentioned. */
  var isReported: Bool = false
}

/** One binding a closure reads from the scope around it. The back ends need to know which ones, and which are `var`. */
public type Capture {
  binding: BindingId
  /** A captured `var` binding is a shared box, not a copy (gap 19). */
  isVar: Bool
}

/**
 * One closure that is being checked. `bindings` is where its own bindings begin, which is what makes a name from
 * further out a capture; `implicit` are the parameters its expected function type names, which a body without a
 * parameter list may use as `_`, `_2` or by name.
 */
public type ClosureFrame {
  /** The span of the closure, which is what the captures are recorded under. */
  at: Span
  /** The index in `Checker.bindings` where the closure's own bindings begin. */
  bindings: Int
  /** The names of the implicit parameters, `None` where the function type gives none, in declaration order. */
  implicit: List<String?>
  /** The type of each implicit parameter, in the same order. */
  types: List<TypeId>
  /** The binding of each implicit parameter, created when it is first used. `-1` while it is unused. */
  var used: List<Int>
  var captures: List<Capture>
  /** Whether the closure declared its parameters itself: then no implicit parameter is available. */
  hasParameters: Bool
  /**
   * The position the first entry of `implicit` has in the expected function type. It is `1` inside a receiver closure,
   * whose first parameter is the receiver and not a value, and `0` everywhere else - so `Adaptation.ImplicitParameter`
   * always names the parameter the way the declaration counts them.
   */
  implicitFrom: Int = 0
  /** The loop depth around the closure, so that a `break` in it can say that it cannot leave one (design 3.5). */
  enclosingLoopDepth: Int = 0
}

/** Everything the source does not spell out, in the order in which it applies. */
public type Adaptation {
  /** A literal that adapted to the expected type: `const x: Int8 = 1`. */
  case Literal(annotation: TypeId)
  /** A parameter that was not written and takes its default. The index is the position in the declaration. */
  case DefaultArgument(parameter: Int)
  /** Written order to declaration order: `order[written]` is the parameter the written argument fills. */
  case Reorder(order: List<Int>)
  /** `...rest: Int`: the arguments from `from` on are collected into a `List<element>`. */
  case Variadic(element: TypeId, from: Int)
  /** `...expression` in an argument list. */
  case Spread
  /**
   * The argument of a `lazy` parameter is an expression, not a value: a thunk that is evaluated at most once. The
   * bindings it reads are in `Tables.captures` under the same span, because the thunk *is* a closure.
   */
  case Lazy
  /** A read of a `lazy` parameter, which forces the cell the caller filled in. */
  case Force
  /**
   * The argument of an `Expression<Value>` parameter, or the initializer of such a binding: it is quoted instead of
   * being evaluated, and `Tables.quotations` under this very span says what tree it becomes.
   */
  case Quote(quotation: Span)
  /** The trailing closure fills the last parameter, whatever position it was written in. */
  case TrailingClosure(parameter: Int)
  /** A member of `self` that was written without it: `area()` inside a method of `Point`. */
  case ImplicitSelf(receiver: BindingId)
  /** `_`, `_2` and a name the expected function type gives: the parameter of the closure this stands for. */
  case ImplicitParameter(index: Int)
  /** A value that became a trait-typed value: `const shapes: List<Shape> = [Square(2.0)]` (gap 8). */
  case ToTraitValue(bounds: List<TypeId>, witnesses: List<Witness>)
  /** `?` and `into()`: the error or the value is converted through `From.from`. */
  case Convert(witness: Witness, method: SymbolId)
  /** One interpolated part of a text literal, rendered through `Show.show`. */
  case ShowValue(witness: Witness)
  /** `with Add by value`: unwrap the arguments, wrap the result again. */
  case Delegate(field: String)
}

// --- Places and the mutation rules (milestone 4.6) -------------------------------------------------------------------

/**
 * Where a path starts. The `Receiver` of the design is a `Local` whose binding is `self` - `LocalBinding.isReceiver`
 * says so already - and one case fewer is one case fewer in every walk over a place.
 */
public type PlaceRoot {
  case Local(binding: BindingId)
  /**
   * A top-level `const` or `var` of a module, a script or an entry file. Those are symbols and not locals, because a
   * module exports them, so they need a root of their own.
   */
  case Declared(symbol: SymbolId)
  /** A call result, a literal, a constructor: a value no path of the caller leads to. */
  case Temporary
  /** A construct a later sub-milestone resolves, or one a message was already given about: every rule stays quiet. */
  case Unknown
}

/** One step from the root of a path to the value it names. */
public type PlaceStep {
  case Field(owner: TypeId, field: SymbolId)
  /**
   * `a[key]`: a write through it needs `MutableIndexed`. `literal` is the key where it was written as one, which is
   * what lets `items[0]` and `items[1]` be told apart while `items[i]` and `items[j]` cannot.
   */
  case Index(base: TypeId, at: Span, literal: String)
  /** `a[from..to]`: a window into the base, which `MutableSlice` makes writable. */
  case Range(base: TypeId, at: Span)
  case TupleField(base: TypeId, index: Int)
}

/**
 * A path from a root to one value: what an assignment writes, what a `var` argument hands over, what a `var self` call
 * changes, and what the pattern of an `if var` binds into. Milestone 5 needs nothing else to form the reference.
 */
public type Place {
  root: PlaceRoot
  /** From the root outwards: `counters[0].hits` is an `Index` and then a `Field`. */
  steps: List<PlaceStep> = []
  /** The span of the root, which is where a message about the binding points. */
  at: Span = Span(0, 0)
}

/** Whether a closure may outlive the call it is written in (BACKEND gap 14). */
public type ClosureKind {
  /** Written straight as the argument of a call: its environment fits on the stack, and it may hold a reference. */
  case Local
  /** Stored, returned or built anywhere else: it captures values and shared boxes only. */
  case Escaping
}

/** One `var` access that is running. The stack of them is what the exclusivity rule asks (design 5.2). */
public type Access {
  place: Place
  /** The member or the parameter that is changing it: "`root` is being changed by `div` right now". */
  changedBy: String
  at: Span
  /**
   * Which call opened it. Two accesses of the *same* call conflict wherever they overlap (`swap(a, a)`), because they
   * run at the same time; two accesses of two calls do not, because the inner call has ended before the outer one
   * begins its access.
   */
  call: Int = 0
  /**
   * How many closures were being checked when it was opened. A read or a change from *deeper* in runs while the access
   * runs - that is the closure argument of the same call - and one at the same depth has ended before it begins.
   */
  closureDepth: Int = 0
}

/**
 * One read or one change of a local `var` binding, in source order. This is the whole state the dead-change rule needs
 * (design 5.3): a change is dead when no read follows it and no read shares a loop with it.
 */
public type BindingUse {
  binding: BindingId
  isChange: Bool
  at: Span
  /** A change a loop brings a read back around to is alive, whatever stands after it. */
  var isLive: Bool = false
  /** The member that changed it, `""` for an assignment: the note names the path that was probably meant. */
  changedBy: String = ""
}

/**
 * One quotation site, by the span of the expression that was quoted: everything milestone 5 needs to build the static
 * `ExpressionNode` tree and the list of captured values without resolving a single name again.
 *
 * The tree itself is *not* stored: it is the syntax tree of that very span, and every node of it already has its type
 * in `expressionTypes` and its target in `resolutions`. What cannot be worked out again is which name is a parameter of
 * which quoted closure and which name is a capture, in the order `Expression.captures()` returns them - and that a
 * provider may read the captured values, which is what the `Encode` witness is for.
 */
public type Quotation {
  /** The `Value` of the `Expression<Value>` this quotation fills: the type of the quoted expression itself. */
  annotation: TypeId
  /** The bindings the quotation reads from the scope around it, in the order of their `Captured.index`. */
  captures: List<QuotationCapture>
  /** Every name inside that becomes a `Parameter` or a `Captured` node, by the span that wrote it. */
  names: Map<Span, QuotationName>
  /**
   * The closures inside the quotation, by their span: the parameters their `Lambda` node names, in declaration order.
   * A quotation of `{ _.age >= minAge }` has one entry, one whose expression is not a closure has none.
   */
  lambdas: Map<Span, List<QuotationParameter>>
}

/** One parameter of a quoted closure: `ExpressionNode.Parameter(index, name, of)`. */
public type QuotationParameter {
  /** What the tree calls it. An implicit parameter is called what the expected function type calls it, or `_`. */
  name: String
  annotation: TypeId
}

/** One captured binding: `ExpressionNode.Captured(index, name, of)`, and the value `captures()` has to hold. */
public type QuotationCapture {
  binding: BindingId
  name: String
  annotation: TypeId
  /** `Encode` for the captured value (gap 36). `Unresolved` where the type does not have it and it was reported. */
  witness: Witness
}

/** Which node of the tree a name inside a quotation becomes. */
public type QuotationName {
  /** A parameter of the quoted closure, by its position in the closure's parameter list. */
  case Parameter(index: Int)
  /** A binding from around the quotation, by its position in `Quotation.captures`. */
  case Captured(index: Int)
}

/**
 * Everything milestone 5 reads, one of these per module. Keyed by the `Span` of the node it belongs to, as
 * milestone 3 keys its type positions: no two nodes of the same kind in a file have the same span.
 */
public type Tables {
  var expressionTypes: Map<Span, TypeId> = [:]
  var patternTypes: Map<Span, TypeId> = [:]
  /** What a name, a member, a call or a constructor resolved to, by the span of the expression that names it. */
  var resolutions: Map<Span, Resolution> = [:]
  /** Everything the source does not spell out, by the span of the expression it applies to. */
  var adaptations: Map<Span, List<Adaptation>> = [:]
  /**
   * Per call span: which parameter every written argument fills, in written order. `-1` where an argument could not
   * be matched, which is the case a message was already given for.
   */
  var argumentTargets: Map<Span, List<Int>> = [:]
  /**
   * Per call span: the type arguments the call was instantiated with, in the order of the callee's own generic
   * parameters. Milestone 5 monomorphizes from exactly these.
   */
  var typeArguments: Map<Span, List<TypeId>> = [:]
  /**
   * Per call span: one witness per trait of every bound of the callee, in the order of `Signature.bounds`. The
   * witnesses of a `Dispatch` carry the same list; this table is the one a `.Direct` call has.
   */
  var witnesses: Map<Span, List<Witness>> = [:]
  /**
   * Per closure span: the bindings of the scope around it that its body reads. The argument of a `lazy` parameter has
   * an entry too: the thunk it becomes is a closure, and `Adaptation.Lazy` at the same span is what marks it as one.
   */
  var captures: Map<Span, List<Capture>> = [:]
  /** Per quoted expression span: the tree and the captures milestone 5 has to build (design 4.8). */
  var quotations: Map<Span, Quotation> = [:]
  /** Per receiver closure span, and at `Span(0, 0)` for a receiver script: the binding its receiver is reached under. */
  var receivers: Map<Span, ReceiverClosure> = [:]
  /**
   * Per `match` span, and per pattern span of an `if const` or a `while const`: the decision order of the arms, what
   * every one of them tests, and what it binds. Milestone 5 lowers a `match` to a decision tree from this alone.
   */
  var matches: Map<Span, MatchPlan> = [:]
  /**
   * Per assignment, `var` argument, `var self` receiver and `if var` subject: the place that is changed there. This is
   * the table that tells milestone 5 where a copy is a move and where a path becomes a reference (design 7.1).
   */
  var places: Map<Span, Place> = [:]
  /** Per closure span: whether the closure may outlive the call it stands in (BACKEND gap 14). */
  var closureKinds: Map<Span, ClosureKind> = [:]
}

/** No expected type, a type, or "a value is not wanted here". */
public type Expectation {
  /** Nothing says what the type should be: infer it. */
  case None
  case Type(annotation: TypeId)
  /** The arms of a `match` that is used as a statement, and the body of a `for`: a value is not wanted. */
  case Statement

  /** The type that is expected, if any. */
  fn annotationOf(self): TypeId? {
    match self {
      .Type(annotation) => Some(annotation)
      _ => None
    }
  }

  fn isStatement(self): Bool {
    match self {
      .Statement => true
      _ => false
    }
  }
}

/**
 * Whether the declaration whose body is being checked *infers* its result. A `public` function and a trait method do
 * not: an omitted result type is `Void` there, and a body that produces a value has to say which one (milestone 4.9).
 * Everything else is `Ordinary`, whether its result was written down or is the body's answer.
 */
public type ResultRule {
  case Ordinary
  case PublicFunction
  case TraitMethod

  /** How a message names the declaration that will not infer, `None` where inference is allowed. */
  fn describe(self): String? {
    match self {
      .PublicFunction => Some("A `public` function")
      .TraitMethod => Some("A trait method")
      .Ordinary => None
    }
  }
}

/**
 * Everything the walk over one body holds. A body may start in the middle of another one - asking for the result type
 * of a function that does not declare one checks its body right there - so the outer state is put aside and restored.
 */
public type BodyState {
  module: ModuleId
  locals: List<Local>
  scopeStarts: List<Int>
  resultType: TypeId
  isResultInferred: Bool
  returnTypes: List<TypeId>
  loopDepth: Int
  receiverType: TypeId?
  receiverBinding: BindingId?
  selfType: TypeId?
  /** A body may start in the middle of a statement of another one, so its inference contexts are its own. */
  closureFrames: List<ClosureFrame>
  contextStarts: List<Int>
  pendingSpans: List<Span>
  hasVariables: Bool
  /** The mutation rules are per body: an open access and the uses of a binding never reach out of one (4.6). */
  accesses: List<Access>
  bindingUses: List<BindingUse>
  resultRule: ResultRule
  runningClosures: Int = 0
}

/**
 * One pass and the wall time it took, in milliseconds, in the order the passes ran. `torb check --timings` prints them,
 * and it stays: the checker runs on a tree-walking interpreter, so which pass got slower is a question that comes up
 * with every change.
 */
public type Timing {
  pass: String
  milliseconds: Int64
}

/** How much of a module the checker already understands. `torb check --statistics` prints these. */
public type Statistics {
  typed: Int
  deferred: Int

  fn total(self): Int {
    typed + deferred
  }
}

/** Where the declaration of a symbol is, so its signature can be built when somebody asks for it. */
public type DeclarationSite {
  module: ModuleId
  kind: DeclarationSiteKind
}

public type DeclarationSiteKind {
  /** A `fn`, `type`, `trait` or `type X =`, at the top level of a file or inside of a block. */
  case Declared(declaration: Declaration)
  /**
   * A member of a type, a trait, an `extend` or a `foreign` block. `owner` is what `Self` means in it and `generics`
   * are the parameters of the declaration around it - both `None`/empty inside a `foreign` block.
   */
  case Owned(owner: TypeId?, generics: List<ParameterId>, member: Member)
  /** A top-level `const` of a module. */
  case Constant(binding: Binding)
}

/**
 * Everything the type checker knows, threaded through the pass as `var checker: Checker` - exactly as
 * `var parser: Parser` is threaded through the grammar. Values have no identity, so every program-wide table lives
 * here in a list and is addressed by an id.
 */
public type Checker {
  program: Program
  /** Every name in a type position, by module and span: what milestone 3 resolved. */
  resolutions: List<Map<Span, SymbolId>>
  /** The name of every top-level declaration, by module and span. Milestone 3 has it as a list, the checker looks up. */
  definitions: List<Map<Span, SymbolId>>
  wellKnown: WellKnown
  /**
   * What name resolution produced, plus what the checker adds: fields, cases and members get their ids here.
   * `program.symbols` is the state before that, so everything after milestone 3 reads this one.
   */
  var symbols: Symbols
  var types: TypeTable
  voidType: TypeId
  neverType: TypeId
  invalidType: TypeId
  deferredType: TypeId
  /** Index 0 is the signature of a declaration that could not be built: no parameters, an `Invalid` result. */
  var signatures: List<Signature> = []
  var signatureStates: Map<SymbolId, SignatureState> = [:]
  /** Index 0 is the shape of a type that could not be built. */
  var typeSignatures: List<TypeSignature> = []
  var typeSignatureStates: Map<SymbolId, SignatureState> = [:]
  /** `type Pair<Value> = (Value, Value)`: the target in terms of the alias's own parameters. Index 0 is `Invalid`. */
  var aliasTargets: List<TypeId> = []
  var aliasStates: Map<SymbolId, SignatureState> = [:]
  /** The generic parameters of a declaration. Cheap and separate, because an arity check must not build a signature. */
  var genericParameters: Map<SymbolId, List<ParameterId>> = [:]
  /** What `Self` means inside a declaration: the trait's own parameter, or the type with its own parameters. */
  var selfTypes: Map<SymbolId, TypeId> = [:]
  var sites: Map<SymbolId, DeclarationSite> = [:]
  /** One per module, in the order of `program.graph.modules`: the type of every type position, by its span. */
  var typePositions: List<Map<Span, TypeId>> = []
  /** One per module, in the same order: everything about the expressions of that module (milestone 4.2 on). */
  var tables: List<Tables> = []
  /** One per module, so a message can be rendered with the file it belongs to. */
  var diagnostics: List<List<Diagnostic>> = []
  /** What every pass of the run cost, for `torb check --timings`. Empty unless the flag was given. */
  var timings: List<Timing> = []
  /** Whether the clock is read at all. Two passes run per module and have to add their time up themselves. */
  var withTimings: Bool = false
  /** What the shape pass (4.9) cost, added up over the modules: it runs inside the walk over the bodies. */
  var shapeMilliseconds: Int64 = 0

  // --- The state of the walk over one body ---------------------------------------------------------------------------

  /** The module whose body is being checked. Everything a message or a table needs to know goes through this one. */
  var module: ModuleId = ModuleId(0)
  /** Append-only, addressed by `BindingId`: every local of every body the checker has looked at. */
  var bindings: List<LocalBinding> = []
  /** The scope chain of the body that is being checked, innermost last. */
  var locals: List<Local> = []
  /** Where every open scope begins in `locals`, so leaving one is a truncation. */
  var scopeStarts: List<Int> = []
  /** The declared or inferred result of the function whose body is being checked. */
  var resultType: TypeId
  /** Without a declared result, `return` and the last expression *are* the result, so nothing is checked against it. */
  var isResultInferred: Bool = false
  /** Whether the declaration may infer its result at all: a `public fn` and a trait method may not (milestone 4.9). */
  var resultRule: ResultRule = ResultRule.Ordinary
  /** What every `return` of the body produced, for the result of a function that does not declare one. */
  var returnTypes: List<TypeId> = []
  /** `break` and `continue` need an enclosing `for` or `while` of the same function. */
  var loopDepth: Int = 0
  /** The innermost receiver: the type whose members a bare name may mean. Only one is ever implicit (gap 4). */
  var receiverType: TypeId? = None
  var receiverBinding: BindingId? = None
  /** What `Self` means in the body that is being checked. A static function has one without having a receiver. */
  var selfType: TypeId? = None
  /** The closures that are being checked, innermost last: what a name may capture and what `_` means. */
  var closureFrames: List<ClosureFrame> = []
  /** A body is checked exactly once, whether the walk reached it or a caller asked for its result type first. */
  var checkedBodies: Map<SymbolId, Bool> = [:]

  // --- Places and the mutation rules (milestone 4.6) ------------------------------------------------------------------

  /** The `var` accesses that are running, outermost first: what the exclusivity rule compares against (design 5.2). */
  var accesses: List<Access> = []
  /** One number per call, so that the accesses of one call can be told from the accesses of the call around it. */
  var callSerial: Int = 0
  /** How many closure bodies are being checked. A quotation is not run, so it does not count here (4.8). */
  var runningClosures: Int = 0
  /** Every read and every change of a local `var` binding of the body that is being checked, in source order. */
  var bindingUses: List<BindingUse> = []
  /** Every binding a closure captures, by `BindingId.value`: a captured binding is a shared box and never dead (gap 19). */
  var capturedBindings: Map<Int, Bool> = [:]
  /** The closures that stand straight as the argument of a call, by span: those are the ones that cannot escape. */
  var argumentClosures: Map<Span, Bool> = [:]

  // --- Quotations (milestone 4.8) -------------------------------------------------------------------------------------

  /**
   * What is quoting the expression that is about to be checked: `assert` and `condition` for `assert(x > 1)`, the name
   * of the binding and nothing for `const e: Expression<Bool> = x > 1`. Only the message about a capture that is not
   * `Encode` reads them, and gap 36 asks that message to name the reason - so they are two plain names and not a
   * sentence that would be built for every argument of every call.
   */
  var quotingOwner: String = ""
  var quotingParameter: String = ""

  // --- Inference (milestone 4.4) --------------------------------------------------------------------------------------

  /**
   * Every unification variable the pass ever made, append-only: an interned `Variable` form names one by index, so an
   * id may never be reused. A variable belongs to the inference context that was open when it was made.
   */
  var variables: List<VariableState> = []
  /** Where every open inference context begins in `variables`, outermost first. */
  var contextStarts: List<Int> = []
  /**
   * The spans that were written to while a variable was open. A variable is solved *after* the expression that
   * mentions it was recorded, so the tables of one statement are walked once at the end of it and the solutions put in.
   *
   * One span is usually written two or three times in a row (its type, its resolution, its adaptations) and `pruneAt` is
   * seven map lookups, so a run of duplicates is dropped as it is noted: one comparison here instead of seven lookups
   * later.
   */
  var pendingSpans: List<Span> = []
  /** Whether the open context ever made a variable, which is what makes the walk above worth doing at all. */
  var hasVariables: Bool = false
  /** The declarations whose result is being inferred right now: naming one of them inside its own body is a cycle. */
  var inferringResults: Map<SymbolId, Bool> = [:]
  /**
   * The function type of a signature, by `SignatureId`. Reading a member builds one, interning it builds a key out of
   * every parameter, and the same member is read over and over - so the answer is kept.
   */
  var signatureTypes: Map<Int, TypeId> = [:]

  // --- Traits and implementations (milestone 4.3) ---------------------------------------------------------------------

  /** Every implementation of the program, with the indexes bound resolution needs. Built once. */
  var implementations: ImplementationTable = ImplementationTable()
  /**
   * "Does this type implement that trait, and through which implementation" - by interned type id and trait symbol.
   * This is the memoization the whole pass rests on: every operator, every `for`, every interpolated part asks it.
   */
  var traitAnswers: Map<(Int, Int, Bool), Resolved> = [:]
  /** The whole witness tree of one type and one bound, by their interned ids: `"{type}:{bound}"`. */
  var witnessAnswers: Map<(Int, Int), Witness> = [:]
  /** Bound resolution recurses through the bounds of an implementation; a limit is an answer, never a hang. */
  var traitDepth: Int = 0
  /** Every trait a type implements, transitively over supertraits, by interned type id. */
  var traitClosures: Map<Int, List<TypeId>> = [:]
  /** The traits a generic parameter is bounded by, by `ParameterId.value`: what a member lookup on it may see. */
  var parameterBounds: Map<Int, List<TypeId>> = [:]
  /** Every derived implementation that was generated, which milestone 5 has to emit the members of. */
  var derived: List<DerivedImplementation> = []
  /** `"{target}:{trait}"` to the index in `derived`, so one is generated once. */
  var derivedIndex: Map<(Int, Int), Int> = [:]
  /** What a derived implementation would generate, by target and trait. Two maps, because the answer may be "no". */
  var derivations: Map<(Int, Int, Int), List<String>> = [:]
  var derivationsMissing: Map<(Int, Int, Int), Bool> = [:]
  /** Per module: which modules' extensions of *foreign* types are visible in it. Built on the first question. */
  var visibleModules: Map<Int, Map<Int, Bool>> = [:]
  /**
   * `a.b` for one module, one receiver type and one name. Member lookup is a pure function of those three - the body
   * of the type, the extensions this file can see, the traits the type implements - and it is the hottest question of
   * the whole pass, so the answer is kept. Two maps, because "there is no such member" is an answer too.
   */
  var memberAnswers: Map<(Int, Int, Bool, String), Candidate> = [:]
  var memberMissing: Map<(Int, Int, Bool, String), Bool> = [:]
  /** The inherent extensions of one type that one module may use, by module and type. */
  var visibleExtensions: Map<(Int, Int), List<Int>> = [:]

  // --- Visibility and program shape (milestone 4.9) -------------------------------------------------------------------

  /**
   * Which modules of the workspace some module imports, by `ModuleId.value`. Top-level code is only forbidden where it
   * could create an initialization order, which is exactly a module somebody imports (gap 28).
   */
  var importedModules: Map<Int, Bool> = [:]
  var hasImportedModules: Bool = false

  fn symbolAt(self, id: SymbolId): Symbol {
    symbols.at(id)
  }

  /** What a name in a type position, or the name of a declaration, resolved to. */
  fn resolvedName(self, module: ModuleId, at: Span): SymbolId? {
    if const Some(found) = resolutions[module.value].get(at) {
      return Some(found)
    }
    definitions[module.value].get(at)
  }

  fn describe(self, id: TypeId): String {
    describeType(types, symbols, id)
  }

  fn nominal(var self, symbol: SymbolId, arguments: List<TypeId>): TypeId {
    types.intern(TypeForm.Nominal(symbol, arguments))
  }

  fn signature(self, id: SignatureId): Signature {
    signatures[id.value]
  }

  fn typeSignature(self, id: TypeSignatureId): TypeSignature {
    typeSignatures[id.value]
  }

  fn addSignature(var self, signature: Signature): SignatureId {
    signatures.add(signature)
    SignatureId(signatures.length() - 1)
  }

  fn addTypeSignature(var self, signature: TypeSignature): TypeSignatureId {
    typeSignatures.add(signature)
    TypeSignatureId(typeSignatures.length() - 1)
  }

  /** What every failed lookup returns: `Invalid` everywhere, so nothing after it says anything again. */
  fn brokenSignature(self): SignatureId {
    SignatureId(0)
  }

  fn brokenTypeSignature(self): TypeSignatureId {
    TypeSignatureId(0)
  }

  /** One message per span, as in the parser: a second one at the same position is a consequence of the first. */
  fn report(var self, module: ModuleId, problem: Diagnostic) {
    if diagnostics[module.value].any({ _.span == problem.span }) {
      return
    }
    diagnostics[module.value].add(problem)
  }

  fn recordType(var self, module: ModuleId, at: Span, id: TypeId) {
    typePositions[module.value].set(at, id)
  }

  // --- The tables of one module ---------------------------------------------------------------------------------------

  /** The type of one expression. Every expression the checker looks at lands here, `Deferred` included. */
  fn recordExpression(var self, module: ModuleId, at: Span, id: TypeId) {
    tables[module.value].expressionTypes.set(at, id)
  }

  fn expressionType(self, module: ModuleId, at: Span): TypeId? {
    tables[module.value].expressionTypes.get(at)
  }

  fn recordPattern(var self, module: ModuleId, at: Span, id: TypeId) {
    tables[module.value].patternTypes.set(at, id)
  }

  fn patternType(self, module: ModuleId, at: Span): TypeId? {
    tables[module.value].patternTypes.get(at)
  }

  fn recordResolution(var self, module: ModuleId, at: Span, resolution: Resolution) {
    tables[module.value].resolutions.set(at, resolution)
  }

  fn resolutionAt(self, module: ModuleId, at: Span): Resolution? {
    tables[module.value].resolutions.get(at)
  }

  /** Adaptations apply in the order they were added, which is the order the lowering has to replay them in. */
  fn recordAdaptation(var self, module: ModuleId, at: Span, adaptation: Adaptation) {
    const known = tables[module.value].adaptations.get(at) ?? []
    tables[module.value].adaptations.set(at, known.added(adaptation))
  }

  fn adaptationsAt(self, module: ModuleId, at: Span): List<Adaptation> {
    tables[module.value].adaptations.get(at) ?? []
  }

  fn recordArgumentTargets(var self, module: ModuleId, at: Span, targets: List<Int>) {
    tables[module.value].argumentTargets.set(at, targets)
  }

  fn argumentTargetsAt(self, module: ModuleId, at: Span): List<Int>? {
    tables[module.value].argumentTargets.get(at)
  }

  /** How many expressions of a module are typed, and how many wait for a later sub-milestone. */
  fn statisticsOf(self, module: ModuleId): Statistics {
    var typed = 0
    var deferred = 0
    for (_, id) in tables[module.value].expressionTypes {
      if id == deferredType {
        deferred = deferred + 1
      } else {
        typed = typed + 1
      }
    }
    Statistics(typed, deferred)
  }

  /**
   * The first expression of a module that has no type. `Deferred` is reachable only from a construct a message was
   * already given about, so this is what a module without any message must not have (4.10).
   */
  fn uncheckedSpanOf(self, module: ModuleId): Span? {
    var found: Span? = None
    for (at, id) in tables[module.value].expressionTypes {
      if id != deferredType {
        continue
      }
      const isEarlier = match found {
        Some(known) => at.start < known.start
        .None => true
      }
      if isEarlier {
        found = Some(at)
      }
    }
    found
  }

  // --- The module that is being checked ------------------------------------------------------------------------------

  /**
   * The short forms for the module that is being checked. Every one of them writes through its own path instead of
   * calling the version above: a `var self` method whose argument reads another field of `self` would read a place
   * that has already been taken out, which the interpreter of stage 0 cannot see and cannot report.
   */
  fn reportHere(var self, problem: Diagnostic) {
    if diagnostics[module.value].any({ _.span == problem.span }) {
      return
    }
    diagnostics[module.value].add(problem)
  }

  /** Records the type of an expression and gives it back, which is what every branch of the checker ends with. */
  fn typed(var self, at: Span, id: TypeId): TypeId {
    tables[module.value].expressionTypes.set(at, id)
    if hasVariables && pendingSpans.last() != Some(at) {
      pendingSpans.add(at)
    }
    id
  }

  fn typedPattern(var self, at: Span, id: TypeId) {
    tables[module.value].patternTypes.set(at, id)
    if hasVariables && pendingSpans.last() != Some(at) {
      pendingSpans.add(at)
    }
  }

  fn resolved(var self, at: Span, resolution: Resolution) {
    tables[module.value].resolutions.set(at, resolution)
    if hasVariables && pendingSpans.last() != Some(at) {
      pendingSpans.add(at)
    }
  }

  fn adapted(var self, at: Span, adaptation: Adaptation) {
    const known = tables[module.value].adaptations.get(at) ?? []
    tables[module.value].adaptations.set(at, known.added(adaptation))
    if hasVariables && pendingSpans.last() != Some(at) {
      pendingSpans.add(at)
    }
  }

  /**
   * A literal adapts exactly once, whatever it took to find out to which type - so this one replaces instead of adding.
   * Picking the right `Int.from` reads its argument before it checks it against the parameter, which would otherwise
   * leave two `Literal` adaptations at one span.
   */
  fn adaptedLiteral(var self, at: Span, annotation: TypeId) {
    var kept: List<Adaptation> = []
    for adaptation in tables[module.value].adaptations.get(at) ?? [] {
      if const .Literal(_) = adaptation {
        continue
      }
      kept.add(adaptation)
    }
    kept.add(Adaptation.Literal(annotation))
    tables[module.value].adaptations.set(at, kept)
    if hasVariables && pendingSpans.last() != Some(at) {
      pendingSpans.add(at)
    }
  }

  fn recordArguments(var self, at: Span, targets: List<Int>) {
    tables[module.value].argumentTargets.set(at, targets)
  }

  /** The type arguments one call was instantiated with: what milestone 5 monomorphizes from. */
  fn recordTypeArguments(var self, at: Span, arguments: List<TypeId>) {
    tables[module.value].typeArguments.set(at, arguments)
    if hasVariables && pendingSpans.last() != Some(at) {
      pendingSpans.add(at)
    }
  }

  fn typeArgumentsAt(self, module: ModuleId, at: Span): List<TypeId>? {
    tables[module.value].typeArguments.get(at)
  }

  /** One witness per trait of every bound of the callee, in the order of `Signature.bounds`. */
  fn recordWitnesses(var self, at: Span, found: List<Witness>) {
    tables[module.value].witnesses.set(at, found)
    if hasVariables && pendingSpans.last() != Some(at) {
      pendingSpans.add(at)
    }
  }

  fn witnessesAt(self, module: ModuleId, at: Span): List<Witness>? {
    tables[module.value].witnesses.get(at)
  }

  /** Which bindings of the scope around a closure its body reads, and which of them are `var` (gap 19). */
  fn recordCaptures(var self, at: Span, found: List<Capture>) {
    tables[module.value].captures.set(at, found)
  }

  fn capturesAt(self, module: ModuleId, at: Span): List<Capture>? {
    tables[module.value].captures.get(at)
  }

  /** One quotation site: the tree and the captures milestone 5 builds an `Expression<Value>` from. */
  fn recordQuotation(var self, at: Span, found: Quotation) {
    tables[module.value].quotations.set(at, found)
  }

  fn quotationAt(self, module: ModuleId, at: Span): Quotation? {
    tables[module.value].quotations.get(at)
  }

  /** The receiver of one receiver closure, which is the one binding a bare name in it may look members up on. */
  fn recordReceiver(var self, at: Span, found: ReceiverClosure) {
    tables[module.value].receivers.set(at, found)
  }

  fn receiverAt(self, module: ModuleId, at: Span): ReceiverClosure? {
    tables[module.value].receivers.get(at)
  }

  /** The plan of one `match`, `if const` or `while const`: what milestone 5 builds its decision tree from. */
  fn recordMatch(var self, at: Span, plan: MatchPlan) {
    tables[module.value].matches.set(at, plan)
  }

  fn matchAt(self, module: ModuleId, at: Span): MatchPlan? {
    tables[module.value].matches.get(at)
  }

  /** The place an assignment, a `var` argument, a `var self` receiver or an `if var` subject named (design 7.1). */
  fn recordPlace(var self, at: Span, place: Place) {
    tables[module.value].places.set(at, place)
  }

  fn placeAt(self, module: ModuleId, at: Span): Place? {
    tables[module.value].places.get(at)
  }

  /** Whether a closure may outlive the call it stands in, which decides where its environment lives (BACKEND gap 14). */
  fn recordClosureKind(var self, at: Span, kind: ClosureKind) {
    tables[module.value].closureKinds.set(at, kind)
  }

  fn closureKindAt(self, module: ModuleId, at: Span): ClosureKind? {
    tables[module.value].closureKinds.get(at)
  }

  /** A variable that was solved: every table of the statement is walked once at its end, through these. */
  fn expressionTypeHere(self, at: Span): TypeId? {
    tables[module.value].expressionTypes.get(at)
  }

  fn patternTypeHere(self, at: Span): TypeId? {
    tables[module.value].patternTypes.get(at)
  }

  fn adaptationsHere(self, at: Span): List<Adaptation> {
    tables[module.value].adaptations.get(at) ?? []
  }

  fn setExpressionType(var self, at: Span, id: TypeId) {
    tables[module.value].expressionTypes.set(at, id)
  }

  fn setPatternType(var self, at: Span, id: TypeId) {
    tables[module.value].patternTypes.set(at, id)
  }

  fn setAdaptations(var self, at: Span, found: List<Adaptation>) {
    tables[module.value].adaptations.set(at, found)
  }

  fn setResolution(var self, at: Span, resolution: Resolution) {
    tables[module.value].resolutions.set(at, resolution)
  }

  fn setTypeArguments(var self, at: Span, arguments: List<TypeId>) {
    tables[module.value].typeArguments.set(at, arguments)
  }

  fn setWitnesses(var self, at: Span, found: List<Witness>) {
    tables[module.value].witnesses.set(at, found)
  }

  // --- Unification variables ------------------------------------------------------------------------------------------

  /** A fresh variable for one generic parameter of one call. Ids are never reused: an interned form names one. */
  fn newVariable(var self, name: String, owner: String, at: Span): TypeId {
    variables.add(VariableState(name, owner, at))
    const identifier = VariableId(variables.length() - 1)
    hasVariables = true
    types.intern(TypeForm.Variable(identifier))
  }

  fn variableState(self, variable: VariableId): VariableState {
    variables[variable.value]
  }

  fn solutionOf(self, variable: VariableId): TypeId? {
    variables[variable.value].solution
  }

  fn solveVariable(var self, variable: VariableId, id: TypeId) {
    const solved = variables[variable.value].copy(solution: Some(id))
    variables.set(variable.value, solved)
  }

  fn markReported(var self, variable: VariableId) {
    const reported = variables[variable.value].copy(isReported: true)
    variables.set(variable.value, reported)
  }

  fn resolutionHere(self, at: Span): Resolution? {
    tables[module.value].resolutions.get(at)
  }

  // --- The types of the literals -------------------------------------------------------------------------------------

  /** A workspace without a prelude has no `Int64`; what is missing was reported where the name did not resolve. */
  fn nominalOrInvalid(var self, symbol: SymbolId?): TypeId {
    match symbol {
      Some(found) => types.intern(TypeForm.Nominal(found, []))
      .None => invalidType
    }
  }

  fn integerType(var self): TypeId {
    const symbol = wellKnown.integer
    nominalOrInvalid(symbol)
  }

  fn floatType(var self): TypeId {
    const symbol = wellKnown.float
    nominalOrInvalid(symbol)
  }

  fn stringType(var self): TypeId {
    const symbol = wellKnown.string
    nominalOrInvalid(symbol)
  }

  fn booleanType(var self): TypeId {
    const symbol = wellKnown.boolean
    nominalOrInvalid(symbol)
  }

  fn charType(var self): TypeId {
    const symbol = wellKnown.character
    nominalOrInvalid(symbol)
  }

  // --- Types the checker builds over and over ------------------------------------------------------------------------

  fn isBroken(self, id: TypeId): Bool {
    id == invalidType || id == deferredType
  }

  /** `Never` fits everywhere, and nothing is ever said about what is broken already. */
  fn absorbs(self, id: TypeId): Bool {
    id == invalidType || id == deferredType || id == neverType
  }

  fn functionType(var self, form: FunctionForm): TypeId {
    types.intern(TypeForm.Function(form))
  }

  // --- Scopes --------------------------------------------------------------------------------------------------------

  fn openScope(var self) {
    scopeStarts.add(locals.length())
  }

  fn closeScope(var self) {
    const top = scopeStarts.length() - 1
    const start = scopeStarts.removeAt(top) ?? 0
    while locals.length() > start {
      const last = locals.length() - 1
      const _ = locals.removeAt(last)
    }
  }

  /** A binding gets an id, and the name it is reachable under. */
  fn declareBinding(var self, binding: LocalBinding): BindingId {
    bindings.add(binding)
    const identifier = BindingId(bindings.length() - 1)
    if !binding.name.isEmpty() && binding.name != "_" {
      locals.add(Local(binding.name, LocalKind.Bound(identifier)))
    }
    identifier
  }

  /** A `fn`, `type` or `trait` of a block, and a generic parameter: a name of the scope that is not a value. */
  fn declareLocalSymbol(var self, name: String, symbol: SymbolId) {
    if !name.isEmpty() {
      locals.add(Local(name, LocalKind.Declared(symbol)))
    }
  }

  fn binding(self, identifier: BindingId): LocalBinding {
    bindings[identifier.value]
  }

  /** The innermost hit wins: a nested scope may shadow, the same scope may not redeclare. */
  fn findLocal(self, name: String): LocalKind? {
    var index = locals.length() - 1
    while index >= 0 {
      if locals[index].name == name {
        return Some(locals[index].kind)
      }
      index = index - 1
    }
    None
  }

  // --- One body at a time --------------------------------------------------------------------------------------------

  /** Starts a body from scratch and gives back what was there, so that a nested one can put it back. */
  fn enterBody(
    var self,
    inside: ModuleId,
    result: TypeId,
    isInferred: Bool,
    own: TypeId?,
    rule: ResultRule = ResultRule.Ordinary,
  ): BodyState {
    const saved = BodyState(
      module,
      locals,
      scopeStarts,
      resultType,
      isResultInferred,
      returnTypes,
      loopDepth,
      receiverType,
      receiverBinding,
      selfType,
      closureFrames,
      contextStarts,
      pendingSpans,
      hasVariables,
      accesses,
      bindingUses,
      resultRule,
      runningClosures,
    )
    module = inside
    locals = []
    scopeStarts = []
    resultType = result
    isResultInferred = isInferred
    resultRule = rule
    returnTypes = []
    loopDepth = 0
    receiverType = None
    receiverBinding = None
    selfType = own
    closureFrames = []
    contextStarts = []
    pendingSpans = []
    hasVariables = false
    accesses = []
    bindingUses = []
    runningClosures = 0
    saved
  }

  fn leaveBody(var self, saved: BodyState) {
    module = saved.module
    locals = saved.locals
    scopeStarts = saved.scopeStarts
    resultType = saved.resultType
    isResultInferred = saved.isResultInferred
    resultRule = saved.resultRule
    returnTypes = saved.returnTypes
    loopDepth = saved.loopDepth
    receiverType = saved.receiverType
    receiverBinding = saved.receiverBinding
    selfType = saved.selfType
    closureFrames = saved.closureFrames
    contextStarts = saved.contextStarts
    pendingSpans = saved.pendingSpans
    hasVariables = saved.hasVariables
    accesses = saved.accesses
    bindingUses = saved.bindingUses
    runningClosures = saved.runningClosures
  }

  /** `self` in a method and in a receiver closure: the one binding a bare name may look members up on. */
  fn setReceiver(var self, binding: BindingId) {
    receiverBinding = Some(binding)
    receiverType = Some(bindings[binding.value].annotation)
  }

  /**
   * Whether the name is a parameter of the function whose body is being checked, and this is the top level of that
   * body. `enterBody` clears the scopes, so the parameters are always the first scope of a body and its top level the
   * second: the two are one scope, and a `const` there may not shadow a parameter (milestone 4.9).
   */
  fn shadowsParameter(self, name: String): Bool {
    if scopeStarts.length() != 2 {
      return false
    }
    var index = scopeStarts[1] - 1
    while index >= scopeStarts[0] {
      if locals[index].name == name {
        return true
      }
      index = index - 1
    }
    false
  }

  /** Whether the *innermost* scope already has this name, which is the only redeclaration that is an error. */
  fn isDeclaredHere(self, name: String): Bool {
    const start = scopeStarts.last() ?? 0
    var index = locals.length() - 1
    while index >= start {
      if locals[index].name == name {
        return true
      }
      index = index - 1
    }
    false
  }

  fn siteOf(self, symbol: SymbolId): DeclarationSite? {
    sites.get(symbol)
  }

  fn addSite(var self, symbol: SymbolId, site: DeclarationSite) {
    if !sites.containsKey(symbol) {
      sites.set(symbol, site)
    }
  }
}

/** A checker for one workspace: the tables of milestone 3 plus what it resolved in every type position. */
public fn newChecker(program: Program, resolutions: List<Map<Span, SymbolId>>): Checker {
  var types = TypeTable()
  const void = types.intern(TypeForm.VoidType)
  const never = types.intern(TypeForm.NeverType)
  const invalid = types.intern(TypeForm.Invalid)
  const deferred = types.intern(TypeForm.Deferred)
  var definitions: List<Map<Span, SymbolId>> = []
  var typePositions: List<Map<Span, TypeId>> = []
  var tables: List<Tables> = []
  var diagnostics: List<List<Diagnostic>> = []
  for module in program.graph.modules {
    var bySpan: Map<Span, SymbolId> = [:]
    for definition in program.definitions[module.id.value] {
      bySpan.set(definition.span, definition.symbol)
    }
    definitions.add(bySpan)
    typePositions.add([:])
    tables.add(Tables())
    diagnostics.add([])
  }
  const broken = Signature(SymbolId(0), [], FunctionForm([], invalid), [], None, false, false, false)
  const brokenType = TypeSignature(SymbolId(0), [], invalid, [], [], [], [], [:], None, false, false)
  Checker(
    program,
    resolutions,
    definitions,
    wellKnownOf(program),
    program.symbols,
    types,
    void,
    never,
    invalid,
    deferred,
    signatures: [broken],
    typeSignatures: [brokenType],
    aliasTargets: [invalid],
    typePositions: typePositions,
    tables: tables,
    diagnostics: diagnostics,
    resultType: void,
  )
}
