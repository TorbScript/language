use SymbolId from "../symbols"
use TypeId, LiteralValue, literalKey, describeLiteral from "./type"
use Checker from "./context"
use caseNamed, fieldsOf from "./member"
use typeSignatureOf from "./signature"
use itemOfSubject from "./pattern"

/**
 * The pattern matrix and Maranget's usefulness algorithm, which answers both questions a `match` raises with one
 * walk: whether an arm can ever be reached, and which values no arm covers.
 *
 * A pattern is normalized to "everything, or one constructor applied to arguments" first (`exhaustive.trb`), because
 * that is the only shape the algorithm knows. Alternatives are expanded into rows before it runs, so nothing here
 * has to think about them, and a guarded arm is simply not in the matrix.
 *
 * The three optimizations that keep this out of its exponential worst case are all here: the **default matrix** for a
 * column whose constructors leave values of its type over, **splitting** of integer ranges into a disjoint cover
 * instead of enumerating the values in them, and **stopping at the first witness** where only a yes or a no is wanted.
 */

/** One value pattern, as the matrix sees it: everything, or one constructor with one pattern per argument. */
public type Normal {
  /** `_`, a name that binds, and every pattern of a type that has no constructors. */
  case Anything
  case Applied(constructor: Constructor, arguments: List<Normal>)
}

/**
 * One constructor of the values of a type. The name or the key is what tells two of them apart, `shown` is how a
 * witness of it is written in a message - `.Circle` and `Point` are one shape with two spellings.
 */
public type Constructor {
  /** A case, the one constructor of a type with fields, a tuple, `true`/`false`, `Some`/`None`. */
  case Named(name: String, shown: String, arity: Int)
  /** A `String`, a `Char`, a `Float` or a member of a literal type: one value, told apart by its key. */
  case Literal(key: String, shown: String)
  /** An integer, as the closed interval of the values it stands for. A single literal has `low == high`. */
  case Interval(low: Int, high: Int)
  /** A list of exactly `length` items, or - as a rest pattern and in a split set - of at least that many. */
  case ListOf(length: Int, hasRest: Bool)
  /** A pattern the checker does not model. It covers nothing but itself, so it never decides anything. */
  case Opaque(identifier: Int)
}

/**
 * The constructors one column has to be split by, plus whether values of the column's type are left over.
 * `hasMissing` is what turns a wildcard into one walk over the default matrix instead of one per constructor, and it
 * is what makes `_` the witness there.
 */
public type ConstructorSet {
  constructors: List<Constructor>
  hasMissing: Bool
}

/** The matrix: one type per column, and one `Normal` per column in every row. */
public type Matrix {
  types: List<TypeId>
  rows: List<List<Normal>>
}

// --- The two questions ----------------------------------------------------------------------------------------------

/**
 * Whether one row matches a value that no row of the matrix matches. With the arms above it in the matrix that is
 * "this arm is reachable"; with an empty matrix it is "this pattern does not match every value".
 */
public fn isUseful(var checker: Checker, matrix: Matrix, row: List<Normal>): Bool {
  isUsefulAt checker, matrix, row, 0
}

fn isUsefulAt(var checker: Checker, matrix: Matrix, row: List<Normal>, depth: Int): Bool {
  // A matrix without rows matches nothing, so anything is useful against it. That is not only the answer, it is what
  // keeps the walk finite: a type that contains itself through a `shared type` would otherwise be descended forever
  if matrix.rows.isEmpty() {
    return true
  }
  if matrix.types.isEmpty() {
    return false
  }
  if depth >= depthLimit {
    return true
  }
  // One row of nothing but wildcards already matches everything there is: that is the `_` arm, and looking at the
  // constructors of the column after it would be the whole cost of the algorithm for an answer that is already known
  if hasOpenRow(matrix.rows) {
    return false
  }
  const head = row.get(0) ?? Normal.Anything
  const rest = tailOf row
  const column = columnOf matrix
  const first = matrix.types[0]
  if const .Applied(constructor, _) = head {
    // A case, a single value and a pattern the checker does not model cover exactly themselves however the column is
    // split, so the constructors of the type are not needed at all - which is what keeps a `match` over sixty cases
    // linear in its arms
    if isAtomic(constructor) {
      return isUsefulFor checker, matrix, head, rest, constructor, depth
    }
    // A range and a rest pattern cover several constructors of the split set, and one of them being useful is enough
    const set = splitColumn checker, first, column, [constructor]
    for candidate in set.constructors {
      if !covers(constructor, candidate) {
        continue
      }
      if isUsefulFor(checker, matrix, head, rest, candidate, depth) {
        return true
      }
    }
    return false
  }
  const set = splitColumn checker, first, column, []
  if set.hasMissing {
    return isUsefulAt(checker, defaultMatrix(matrix), rest, depth + 1)
  }
  for candidate in set.constructors {
    if isUsefulFor(checker, matrix, head, rest, candidate, depth) {
      return true
    }
  }
  false
}

fn isUsefulFor(
  var checker: Checker,
  matrix: Matrix,
  head: Normal,
  rest: List<Normal>,
  candidate: Constructor,
  depth: Int,
): Bool {
  const specialized = specializeMatrix checker, matrix, candidate
  const inner = specializeRow(head, candidate) ?? []
  isUsefulAt(checker, specialized, inner.addedAll(rest), depth + 1)
}

/** A type that contains itself through a `shared type` is legal, so the descent needs an end that is an answer. */
const depthLimit = 24

/** Whether one row matches every value of its columns, which is what a `_` arm is. */
fn hasOpenRow(rows: List<List<Normal>>): Bool {
  for row in rows {
    var isOpen = true
    for pattern in row {
      if const .Applied(_, _) = pattern {
        isOpen = false
      }
    }
    if isOpen {
      return true
    }
  }
  false
}

/** Whether a constructor covers exactly itself in every split, so the column never has to be looked at. */
fn isAtomic(constructor: Constructor): Bool {
  match constructor {
    .Interval(low, high) => low == high
    .ListOf(_, _) => false
    _ => true
  }
}

/**
 * Up to `limit` values that no row of the matrix matches, each as one `Normal` per column. Empty means every value is
 * covered, which is exactly what exhaustiveness asks.
 *
 * A column whose constructors leave values over needs nothing but its default matrix: every row that can match such a
 * value has a wildcard there, and a wildcard covers the remaining columns for every other constructor as well. That
 * is what keeps this from ever enumerating `Int64`.
 */
public fn missingValues(var checker: Checker, matrix: Matrix, limit: Int): List<List<Normal>> {
  missingValuesAt checker, matrix, limit, 0
}

fn missingValuesAt(var checker: Checker, matrix: Matrix, limit: Int, depth: Int): List<List<Normal>> {
  if matrix.types.isEmpty() {
    if matrix.rows.isEmpty() {
      return [[]]
    }
    return []
  }
  // Nothing at all is covered here, so `_` per column is the witness. Descending further would only spell it out, and
  // for a type that contains itself through a `shared type` it would never end
  if matrix.rows.isEmpty() && depth > 0 {
    return [wildcards(matrix.types.length())]
  }
  if depth >= depthLimit {
    return []
  }
  // A `_` arm, or a binding: nothing is left over, and the constructors of the type never have to be built
  if hasOpenRow(matrix.rows) {
    return []
  }
  const column = columnOf matrix
  const first = matrix.types[0]
  const set = splitColumn checker, first, column, []
  var found: List<List<Normal>> = []
  if set.hasMissing {
    const inner = missingValuesAt(checker, defaultMatrix(matrix), limit, depth + 1)
    for witness in inner {
      found.add([Normal.Anything].addedAll(witness))
    }
    return found
  }
  for candidate in set.constructors {
    if found.length() >= limit {
      return found
    }
    const specialized = specializeMatrix checker, matrix, candidate
    const room = limit - found.length()
    for witness in missingValuesAt(checker, specialized, room, depth + 1) {
      found.add appliedWitness(candidate, witness)
    }
  }
  found
}

fn wildcards(count: Int): List<Normal> {
  var found: List<Normal> = []
  for _ in 0..count {
    found.add Normal.Anything
  }
  found
}

/** One witness of a specialized matrix, folded back into one of the column it came from. */
fn appliedWitness(candidate: Constructor, witness: List<Normal>): List<Normal> {
  const arity = arityOf candidate
  var arguments: List<Normal> = []
  for index in 0..arity {
    arguments.add(witness.get(index) ?? Normal.Anything)
  }
  var rest: List<Normal> = []
  for index in arity..witness.length() {
    rest.add witness[index]
  }
  [Normal.Applied(candidate, arguments)].addedAll(rest)
}

// --- Specialization and the default matrix --------------------------------------------------------------------------

fn columnOf(matrix: Matrix): List<Normal> {
  var column: List<Normal> = []
  for row in matrix.rows {
    column.add(row.get(0) ?? Normal.Anything)
  }
  column
}

fn tailOf(row: List<Normal>): List<Normal> {
  var rest: List<Normal> = []
  for index in 1..row.length() {
    rest.add row[index]
  }
  rest
}

fn tailOfTypes(types: List<TypeId>): List<TypeId> {
  var rest: List<TypeId> = []
  for index in 1..types.length() {
    rest.add types[index]
  }
  rest
}

/** `S(constructor, matrix)`: the rows that can still match, with the first column replaced by the arguments. */
fn specializeMatrix(var checker: Checker, matrix: Matrix, constructor: Constructor): Matrix {
  const first = matrix.types[0]
  var types = argumentTypesOf checker, first, constructor
  for index in 1..matrix.types.length() {
    types.add matrix.types[index]
  }
  var rows: List<List<Normal>> = []
  for row in matrix.rows {
    const head = row.get(0) ?? Normal.Anything
    if const Some(inner) = specializeRow(head, constructor) {
      rows.add inner.addedAll(tailOf(row))
    }
  }
  Matrix types, rows
}

/** `D(matrix)`: the rows whose first column matches everything, without that column. */
fn defaultMatrix(matrix: Matrix): Matrix {
  var rows: List<List<Normal>> = []
  for row in matrix.rows {
    if const .Anything = row.get(0) ?? Normal.Anything {
      rows.add tailOf(row)
    }
  }
  Matrix tailOfTypes(matrix.types), rows
}

/** What one pattern contributes to the columns of `constructor`, or nothing when it cannot match it at all. */
fn specializeRow(head: Normal, constructor: Constructor): List<Normal>? {
  const arity = arityOf constructor
  match head {
    .Anything => {
      var arguments: List<Normal> = []
      for _ in 0..arity {
        arguments.add Normal.Anything
      }
      Some arguments
    }
    .Applied(own, arguments) => {
      if !covers(own, constructor) {
        return None
      }
      // `[first, ...rest]` against a list of four: the item it names, and a wildcard for every item the rest covers
      if arguments.length() < arity {
        var padded = arguments
        for _ in arguments.length()..arity {
          padded.add Normal.Anything
        }
        return Some padded
      }
      Some arguments
    }
  }
}

public fn arityOf(constructor: Constructor): Int {
  match constructor {
    .Named(_, _, arity) => arity
    .ListOf(length, _) => length
    _ => 0
  }
}

/** Whether every value of `part` is a value of `whole`: a range covers the pieces it was split into. */
public fn covers(whole: Constructor, part: Constructor): Bool {
  match whole {
    .Named(name, _, _) => {
      if const .Named(other, _, _) = part {
        return name == other
      }
      false
    }
    .Literal(key, _) => {
      if const .Literal(other, _) = part {
        return key == other
      }
      false
    }
    .Interval(low, high) => {
      if const .Interval(otherLow, otherHigh) = part {
        return low <= otherLow && otherHigh <= high
      }
      false
    }
    .ListOf(length, hasRest) => {
      if const .ListOf(otherLength, otherRest) = part {
        if hasRest {
          return otherLength >= length
        }
        return !otherRest && otherLength == length
      }
      false
    }
    .Opaque(identifier) => {
      if const .Opaque(other) = part {
        return identifier == other
      }
      false
    }
  }
}

// --- The constructors of one column ---------------------------------------------------------------------------------

/**
 * The disjoint cover of one column: every constructor the column mentions, cut so that no two of them overlap, plus
 * whether values of the type are left over. `extra` holds the constructors of the row that is being tested, which
 * have to take part in the split so that the row can be specialized by the pieces of itself.
 */
fn splitColumn(
  var checker: Checker,
  annotation: TypeId,
  column: List<Normal>,
  extra: List<Constructor>,
): ConstructorSet {
  var written = extra
  var hasOpaque = false
  for pattern in column {
    if const .Applied(constructor, _) = pattern {
      written.add constructor
    }
  }
  for constructor in written {
    if const .Opaque(_) = constructor {
      hasOpaque = true
    }
    if const .ListOf(_, _) = constructor {
      return splitLists written
    }
  }
  // A pattern the checker does not model leaves the type open, and everything written stays its own constructor: that
  // is the safe direction, where nothing is exhaustive by accident and no arm above hides one below
  if hasOpaque {
    return ConstructorSet uniqueConstructors(written), true
  }
  match columnKind(checker, annotation) {
    .Finite(constructors) => {
      if fitsFinite(written, constructors) {
        return ConstructorSet constructors, false
      }
      ConstructorSet uniqueConstructors(written), true
    }
    .Intervals(low, high) => splitIntervals written, low, high
    .Unknown => ConstructorSet uniqueConstructors(written), true
  }
}

/** How the values of a column's type are described: a finite set of constructors, an interval, or nothing at all. */
type ColumnKind {
  case Finite(constructors: List<Constructor>)
  /** The closed range of an integer type whose width the checker knows. */
  case Intervals(low: Int, high: Int)
  /** A type parameter, a trait-typed value, a function, `String`, `Char`, `Int64`: only `_` covers it. */
  case Unknown
}

fn columnKind(var checker: Checker, annotation: TypeId): ColumnKind {
  match checker.types.form(annotation) {
    .Literals(_, values) => {
      var constructors: List<Constructor> = []
      for value in values {
        constructors.add Constructor.Literal(literalKey(value), describeLiteral(value))
      }
      ColumnKind.Finite constructors
    }
    .Tuple(fields) => ColumnKind.Finite([Constructor.Named("", "", fields.length())])
    .Nominal(symbol, _) => nominalKind checker, symbol
    _ => ColumnKind.Unknown
  }
}

fn nominalKind(var checker: Checker, symbol: SymbolId): ColumnKind {
  if checker.wellKnown.boolean == Some(symbol) {
    return ColumnKind.Finite([
      Constructor.Named("false", "false", 0),
      Constructor.Named("true", "true", 0),
    ])
  }
  if const Some(name) = checker.wellKnown.numericNamed(symbol) {
    return integerKind name
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  if !shape.cases.isEmpty() {
    var constructors: List<Constructor> = []
    for variant in shape.cases {
      constructors.add Constructor.Named(variant.name, ".{variant.name}", variant.fields.length())
    }
    return ColumnKind.Finite constructors
  }
  // `Point(x, y)`: a type with fields and without cases has exactly one constructor, which is the type itself
  if !shape.fields.isEmpty() && !shape.isNative {
    const name = checker.symbolAt(symbol).name
    return ColumnKind.Finite([Constructor.Named(name, name, shape.fields.length())])
  }
  ColumnKind.Unknown
}

/**
 * The range of an integer type, read from its name - the only place a width is written down, because the declarations
 * themselves are `native`. `Int64` and `UInt64` are deliberately not in here: their own bounds cannot be written as
 * literals of the language the checker runs in, and a `match` over one of them needs a `_` anyway.
 */
fn integerKind(name: String): ColumnKind {
  match name {
    "Int8" => ColumnKind.Intervals(0 - 128, 127)
    "Int16" => ColumnKind.Intervals(0 - 32768, 32767)
    "Int32" => ColumnKind.Intervals(0 - 2147483648, 2147483647)
    "UInt8" => ColumnKind.Intervals 0, 255
    "UInt16" => ColumnKind.Intervals 0, 65535
    "UInt32" => ColumnKind.Intervals 0, 4294967295
    _ => ColumnKind.Unknown
  }
}

/**
 * Whether every constructor the column wrote is one of the finite set. A range over a literal type is not, and then
 * everything written stands for itself. Through a map, because a column has as many entries as the `match` has arms.
 */
fn fitsFinite(written: List<Constructor>, constructors: List<Constructor>): Bool {
  var known: Map<String, Bool> = [:]
  for one in constructors {
    known.set constructorKey(one), true
  }
  for one in written {
    if !known.containsKey(constructorKey(one)) {
      return false
    }
  }
  true
}

/** What tells two constructors apart, as one string: the key of a map, so no comparison is ever quadratic. */
fn constructorKey(constructor: Constructor): String {
  match constructor {
    .Named(name, _, _) => "n{name}"
    .Literal(key, _) => "l{key}"
    .Interval(low, high) => "i{low}:{high}"
    .ListOf(length, hasRest) => "s{length}:{hasRest}"
    .Opaque(identifier) => "o{identifier}"
  }
}

/**
 * Lists are split by length: every length below `border`, plus one constructor for "at least `border` items" that
 * stands for every longer list. `border` is chosen so that every exact length written lies below it and every rest
 * pattern reaches it, which is what makes `[]`, `[only]` and `[first, ...rest]` a complete cover.
 */
fn splitLists(written: List<Constructor>): ConstructorSet {
  var border = 0
  for constructor in written {
    if const .ListOf(length, hasRest) = constructor {
      const needed = if hasRest { length } else { length + 1 }
      if needed > border {
        border = needed
      }
    }
  }
  var constructors: List<Constructor> = []
  for length in 0..border {
    constructors.add Constructor.ListOf(length, false)
  }
  constructors.add Constructor.ListOf(border, true)
  ConstructorSet constructors, false
}

/**
 * Integer ranges as intervals and not as the values in them: the written intervals are cut at every boundary that
 * appears, so `0`, `1 | 2 | 3`, `4..=9` and `5..=7` all become pieces that no two patterns share. Whether anything is
 * left over is a walk over those pieces, so no range is ever enumerated.
 */
fn splitIntervals(written: List<Constructor>, low: Int, high: Int): ConstructorSet {
  var bounds: List<Int> = []
  for constructor in written {
    if const .Interval(from, to) = constructor {
      if from > to {
        continue
      }
      if !bounds.contains(from) {
        bounds.add(from)
      }
      // The piece behind a written interval begins one past its end, unless that is past the type itself
      if to < high && !bounds.contains(to + 1) {
        bounds.add(to + 1)
      }
    }
  }
  if bounds.isEmpty() {
    return ConstructorSet([], true)
  }
  bounds.sort({ _ })
  var pieces: List<Constructor> = []
  var hasMissing = bounds[0] > low
  for index in 0..bounds.length() {
    const from = bounds[index]
    const to = if index + 1 < bounds.length() { bounds[index + 1] - 1 } else { high }
    if isCovered(written, from, to) {
      pieces.add Constructor.Interval(from, to)
      continue
    }
    hasMissing = true
  }
  ConstructorSet pieces, hasMissing
}

/** Whether some written interval holds the whole piece. A piece lies inside one interval or outside all of them. */
fn isCovered(written: List<Constructor>, from: Int, to: Int): Bool {
  for constructor in written {
    if const .Interval(low, high) = constructor {
      if low <= from && to <= high {
        return true
      }
    }
  }
  false
}

/** The distinct constructors of a column, for a type whose values cannot be covered anyway. */
fn uniqueConstructors(written: List<Constructor>): List<Constructor> {
  var seen: Map<String, Bool> = [:]
  var found: List<Constructor> = []
  for constructor in written {
    const key = constructorKey constructor
    if seen.containsKey(key) {
      continue
    }
    seen.set key, true
    found.add constructor
  }
  found
}

// --- The types behind one constructor -------------------------------------------------------------------------------

/** The type of every argument of one constructor of `annotation`: what specialization puts into the matrix. */
public fn argumentTypesOf(var checker: Checker, annotation: TypeId, constructor: Constructor): List<TypeId> {
  match constructor {
    .ListOf(length, _) => {
      const element = itemOfSubject checker, annotation
      var types: List<TypeId> = []
      for _ in 0..length {
        types.add element
      }
      types
    }
    .Named(name, _, arity) => namedArgumentTypes checker, annotation, name, arity
    _ => []
  }
}

fn namedArgumentTypes(var checker: Checker, annotation: TypeId, name: String, arity: Int): List<TypeId> {
  if const .Tuple(fields) = checker.types.form(annotation) {
    var types: List<TypeId> = []
    for field in fields {
      types.add field.annotation
    }
    return types
  }
  if const Some(variant) = caseNamed(checker, annotation, name) {
    var types: List<TypeId> = []
    for field in variant.fields {
      types.add field.annotation
    }
    return types
  }
  const declared = fieldsOf checker, annotation
  if !declared.isEmpty() {
    var types: List<TypeId> = []
    for field in declared {
      types.add field.annotation
    }
    return types
  }
  var types: List<TypeId> = []
  for _ in 0..arity {
    types.add checker.deferredType
  }
  types
}

// --- Witnesses in a message -----------------------------------------------------------------------------------------

/** `.Rectangle(_, _)`, `[_, _]`, `4..=9`, `"away"`: one value a `match` does not handle, as a message shows it. */
public fn describeNormal(pattern: Normal): String {
  match pattern {
    .Anything => "_"
    .Applied(constructor, arguments) => {
      var parts: List<String> = []
      for argument in arguments {
        parts.add describeNormal(argument)
      }
      describeApplied constructor, parts
    }
  }
}

fn describeApplied(constructor: Constructor, parts: List<String>): String {
  match constructor {
    .Named(_, shown, arity) => {
      if arity == 0 && !shown.isEmpty() {
        return shown
      }
      const inner = parts.joined separator: ", "
      "{shown}({inner})"
    }
    .Literal(_, shown) => shown
    .Interval(low, high) => {
      if low == high {
        return "{low}"
      }
      "{low}..={high}"
    }
    .ListOf(length, hasRest) => {
      var items = parts
      while items.length() < length {
        items.add "_"
      }
      if hasRest {
        items.add "..."
      }
      const inner = items.joined separator: ", "
      "[{inner}]"
    }
    .Opaque(_) => "_"
  }
}
