/**
 * The rule that needs the whole body instead of one expression: a change nobody reads. Where a closure may go is
 * `escape.trb`; the marks it starts from - which closures stand straight as an argument, which bindings are captured
 * and which are references - are set here.
 *
 * **Dead changes** keep the source-ordered reads and changes of every `var` value of one body, plus a mark for the
 * ones a loop brings a read back around to. A change is dead when no read follows it in source order and no read
 * shares a loop with it. There is no fixpoint beyond that: a loop is settled once, when it closes ([settleLoop]). A
 * `var` parameter, `var self` and a captured binding are exempt - the first two write back into the caller's place and
 * the third is a shared box whose read may be anywhere.
 *
 * A change that goes through a *step* (`first.value = 1`, `first.increment()`, `fill(buffer)`) reads the old value as
 * well, so the read the target produced stays. Only `x = value` replaces the whole value, and only there the read
 * becomes the change - which is what makes `var total = 0` followed by `total = 1` and nothing else a dead change while
 * `x = 1` followed by `x.part = 2` and a read of `x` is fine.
 *
 * **A top-level `var` is counted too**, and it is the one value whose body is not the whole story: the statements of
 * the file are one body, but a function of the module, a closure inside one and the initializer of a top-level
 * `const` read the same declaration. So a change of one is dead when no statement after it reads it **and** nothing
 * else in the module does (`Checker.readDeclarations`) **and** the declaration is not exported.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Argument from "../../syntax/ast"
use SymbolId from "../symbols"
use TypeId, SignatureId, SignatureState from "./type"
use Checker, Place, PlaceRoot, BindingId, UseRoot, ValueUse, useKey from "./context"
use isSharedType from "./declaration"
use isDeclaredVar from "./place"

// --- Dead changes ---------------------------------------------------------------------------------------------------

/**
 * Every read of a local `var` binding, in source order. A `const` cannot be changed, and a `var` parameter and the
 * receiver of a `var fn` are exempt from the rule, so none is worth an entry - which keeps the list of one body short
 * even in a pass
 * that names `checker` on every second line.
 */
public fn noteRead(var checker: Checker, binding: BindingId, at: Span) {
  if !isCounted(checker, binding) {
    return
  }
  checker.valueUses.add ValueUse(UseRoot.Local(binding), false, at)
}

/**
 * Every read of a top-level `var`, which is a declaration and not a local. Inside the statements of its own file it is
 * one more use in source order; anywhere else - a function of the module, a closure, the initializer of a top-level
 * `const` - it is the answer "something else reads this", and the rule says nothing more precise about where.
 */
public fn noteDeclaredRead(var checker: Checker, symbol: SymbolId, at: Span) {
  if !isCountedDeclaration(checker, symbol) {
    return
  }
  if !checker.isTopLevel {
    checker.readDeclarations.set symbol.value, true
    return
  }
  checker.valueUses.add ValueUse(UseRoot.Declared(symbol), false, at)
}

/** Whether the dead-change rule has anything to say about this binding at all. */
fn isCounted(var checker: Checker, binding: BindingId): Bool {
  const found = checker.binding binding
  if !found.isVar || found.isParameter || found.isReceiver {
    return false
  }
  // A shared object is not a copy: what is changed through this binding is what everybody else holds as well, so
  // "no read follows it here" says nothing about it (CONCEPT, "Identity")
  !isSharedType(checker, found.annotation)
}

/**
 * The same question for a top-level binding. A `const` is never changed and a shared object is not a copy, so only a
 * top-level `var` of a value type is counted.
 *
 * A `public` one cannot arrive here: `public` makes a binding a `Declaration`, and a declaration gets a `Declared`
 * site rather than the `Constant` site [isDeclaredVar] reads - quite apart from `public var` being a parse error.
 */
fn isCountedDeclaration(var checker: Checker, symbol: SymbolId): Bool {
  if !isDeclaredVar(checker, symbol) {
    return false
  }
  match declaredTypeOf(checker, symbol) {
    Some(held) => !isSharedType(checker, held)
    None => true
  }
}

/**
 * The type of a top-level `var`, where the checker has worked it out already. Every read and every change of one goes
 * through the name first, which is what asks for the signature - so this is a lookup and never starts one, and a
 * declaration whose signature is still running (its own initializer) has no answer and no shared object either.
 */
fn declaredTypeOf(var checker: Checker, symbol: SymbolId): TypeId? {
  if const .Ready(index) = checker.signatureStates.get(symbol) ?? SignatureState.Missing {
    return Some checker.signature(SignatureId(index)).form.result
  }
  None
}

/**
 * One change of the root of a place, at the point the change happens - which for an assignment is *after* its value has
 * been read, so that `total = total + 1` does not count its own right-hand side as the read that keeps it alive.
 */
public fn noteChange(var checker: Checker, place: Place, changedBy: String) {
  const root = match useRootOf(place.root) {
    Some(found) => found
    None => {
      return
    }
  }
  if !isCountedRoot(checker, root) {
    return
  }
  checker.valueUses.add ValueUse(root, true, place.at, changedBy: changedBy)
}

/** A place whose root the rule counts at all: a local or a top-level declaration, never a temporary. */
fn useRootOf(root: PlaceRoot): UseRoot? {
  match root {
    .Local(binding) => Some UseRoot.Local(binding)
    .Declared(symbol) => Some UseRoot.Declared(symbol)
    _ => None
  }
}

fn isCountedRoot(var checker: Checker, root: UseRoot): Bool {
  match root {
    .Local(binding) => isCounted checker, binding
    /**
     * A change to a top-level `var` is only counted in the statements of its own file. Inside a function there is no
     * "after it" to look at, and the statements that read it need not have been checked yet - a function is checked
     * where it is declared, which may be above every line that reads what it wrote.
     */
    .Declared(symbol) => {
      if !checker.isTopLevel {
        return false
      }
      isCountedDeclaration checker, symbol
    }
  }
}

/**
 * `x = value` replaces the whole value, so naming `x` as the target of it is not a read of anything: the read that
 * resolving the target produced goes away again. A change through a *step* (`x.part = value`, `x.increment()`) does read
 * the old value, and there the read stays.
 */
public fn dropRead(var checker: Checker, place: Place) {
  const root = match useRootOf(place.root) {
    Some(found) => found
    None => {
      return
    }
  }
  const key = useKey root
  var index = checker.valueUses.length() - 1
  while index >= 0 {
    const entry = checker.valueUses[index]
    if !entry.isChange && useKey(entry.root) == key && entry.at == place.at {
      const _ = checker.valueUses.removeAt index
      return
    }
    index = index - 1
  }
}

/**
 * A loop that has closed. Every change inside it whose value is read anywhere inside it is alive, whatever stands after
 * the loop: the next round reads what this one wrote. That is the whole of what the design calls "flow-sensitive but
 * simple" - one pass per loop, and no fixpoint.
 */
public fn settleLoop(var checker: Checker, from: Int) {
  var readers: Map<Int, Bool> = [:]
  var index = from
  while index < checker.valueUses.length() {
    const entry = checker.valueUses[index]
    if !entry.isChange {
      readers.set useKey(entry.root), true
    }
    index = index + 1
  }
  if readers.isEmpty() {
    return
  }
  index = from
  while index < checker.valueUses.length() {
    const entry = checker.valueUses[index]
    if entry.isChange && !entry.isLive {
      if readers.containsKey(useKey(entry.root)) {
        const alive = entry.copy isLive: true
        checker.valueUses.set index, alive
      }
    }
    index = index + 1
  }
}

/**
 * Every change of a body that no read follows. The walk is backwards, so "is there a read after this one" is one map
 * that grows as it goes - which keeps the rule linear in the number of uses.
 */
public fn settleChanges(var checker: Checker) {
  var readAfter: Map<Int, Bool> = [:]
  var index = checker.valueUses.length() - 1
  while index >= 0 {
    const entry = checker.valueUses[index]
    if entry.isChange {
      if !entry.isLive && !readAfter.containsKey(useKey(entry.root)) {
        reportDeadChange checker, entry
      }
    } else {
      readAfter.set useKey(entry.root), true
    }
    index = index - 1
  }
  checker.valueUses = []
}

fn reportDeadChange(var checker: Checker, entry: ValueUse) {
  const name = match entry.root {
    .Local(binding) => {
      // A captured `var` binding is a shared box, not a copy: the read can be anywhere the closure is run
      if checker.capturedBindings.containsKey(binding.value) {
        return
      }
      checker.binding(binding).name
    }
    // A function of the module reads the same declaration, and nothing says where it is called
    .Declared(symbol) => {
      if checker.readDeclarations.containsKey(symbol.value) {
        return
      }
      checker.symbolAt(symbol).name
    }
  }
  var problem = Diagnostic.error "This change has no effect: `{name}` is never read again", entry.at
  if const Some(member) = participleHint(entry.changedBy) {
    problem = problem.withNote "`{name}` is a copy. Did you mean the path it came from (`items[0].{member}()`)?"
  } else {
    problem = problem.withNote "With value semantics a change nobody reads is always a mistake"
  }
  checker.reportHere problem
}

/** The member that made the change, where there was one: an assignment has none and reads better without a note. */
fn participleHint(changedBy: String): String? {
  if changedBy.isEmpty() {
    return None
  }
  Some changedBy
}

// --- Closures -------------------------------------------------------------------------------------------------------

/** Which closures stand straight as the argument of a call: exactly those cannot outlive it. */
public fn noteArgumentClosures(var checker: Checker, arguments: List<Argument>) {
  for argument in arguments {
    if const .Closure(_) = argument.value.kind {
      checker.argumentClosures.set argument.value.span, true
    }
  }
}

/** A binding a closure reads is marked, because the closure may run anywhere its call runs it and the read is there. */
public fn noteCapturedBinding(var checker: Checker, binding: BindingId) {
  checker.capturedBindings.set binding.value, true
}

/**
 * The bindings from here on are references into a place of the caller and not copies of it: the parameters a closure
 * declared, and the names an `if var` pattern binds into its subject. Both are exempt from the dead-change rule -
 * the change lands in the place they point at - and neither may be carried off by an escaping closure.
 */
public fn markReferenceBindings(var checker: Checker, from: Int) {
  var index = from
  while index < checker.bindings.length() {
    const found = checker.bindings[index]
    if !found.isParameter {
      const marked = found.copy isParameter: true
      checker.bindings.set index, marked
    }
    index = index + 1
  }
}
