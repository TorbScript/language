/**
 * The implementations the language generates: `Equals`, `Hash`, `Show`, `Encode`, `Decode`, `Describe`, the `From` of a wrapper
 * case, and the members of a literal type. [derivableMembers] generates them *where they are used*, so nothing is
 * generated for a type nobody asks about, and a hand-written member always wins - resolution only gets here when no
 * declared implementation answered.
 *
 * The one thing this file has to get right is the cycle: the syntax tree of the compiler is `Show` although
 * `Expression` contains a `List<Statement>` that contains an `Expression` again. So while the question "can this be
 * derived" is being answered it is *assumed* to hold, which is the only sound reading - a structural implementation of
 * a recursive type is well defined, it just recurses at run time as the value does.
 *
 * The second thing is the **capsule**: a type whose constructor is closed from outside has no field list a caller
 * could be handed, so `Encode`, `Decode` and `Describe` are derived through its one conversion pair instead
 * ([conversionPairOf]). Every other type derives the three over the parameters its constructor takes from outside,
 * which leaves a `private` field with a default out ([isPassable]).
 */

use Visibility from "../../syntax/ast"
use SymbolId from "../symbols"
use TypeId, ParameterId, FieldSignature from "./type"
use Checker from "./context"
use typeSignatureOf from "./signature"
use substitute, sameType from "./unify"
use implementsBound, isConcrete, literalConversionBound, writtenTraitsOf from "./implementation"

/** The members a derived implementation of `capability` for `target` would generate, or `None`. */
public fn derivableMembers(var checker: Checker, target: TypeId, capability: SymbolId, wanted: TypeId?): List<String>? {
  const name = derivedTraitName checker, capability
  if name.isEmpty() {
    return None
  }
  const key = (target.value, capability.value, wantedKey(wanted))
  if checker.derivationsMissing.containsKey(key) {
    return None
  }
  if const Some(known) = checker.derivations.get(key) {
    return known
  }
  const members = membersOf name
  if members.isEmpty() {
    checker.derivationsMissing.set key, true
    return None
  }
  // Assumed while it is being answered: a recursive type is structurally comparable, it just recurses as the value does
  checker.derivations.set key, members
  const isDerivable = canDerive checker, target, name, capability, wanted
  if !isDerivable {
    const _ = checker.derivations.remove key
    checker.derivationsMissing.set key, true
    return None
  }
  members
}

fn wantedKey(wanted: TypeId?): Int {
  match wanted {
    Some(bound) => bound.value
    None => -1
  }
}

/** The name of the trait, but only when the symbol really is the prelude's trait of that name. */
fn derivedTraitName(checker: Checker, capability: SymbolId): String {
  const name = checker.symbolAt(capability).name
  if checker.wellKnown.symbolNamed(name) == capability {
    return name
  }
  ""
}

/** What a derived implementation has to provide. The default members of the trait come from the trait as always. */
fn membersOf(name: String): List<String> {
  if name == "Equals" {
    return ["equals"]
  }
  if name == "Hash" {
    return ["hash"]
  }
  if name == "Show" {
    return ["show"]
  }
  if name == "Encode" {
    return ["encode"]
  }
  if name == "Decode" {
    return ["decode"]
  }
  if name == "Describe" {
    return ["describe"]
  }
  if name == "From" {
    return ["from"]
  }
  if name == "Into" {
    return ["into"]
  }
  // Only for a literal type, see `canDerive`
  if name == "TryFrom" {
    return ["tryFrom"]
  }
  // Only for a tuple, see `canDerive`
  if name == "Compare" {
    return ["compare"]
  }
  // Only for a type whose cases all stand for numbers, see `canDerive`
  if name == "RawValue" {
    return ["rawValue", "fromRawValue"]
  }
  []
}

fn canDerive(var checker: Checker, target: TypeId, name: String, capability: SymbolId, wanted: TypeId?): Bool {
  // `case Read = 1`: a type whose cases all stand for numbers, and nothing else (docs/design/FLAGS.md section 1)
  if name == "RawValue" {
    return hasCaseValues checker, target
  }
  // `From` is generated for a case that wraps exactly one value of a type no other case wraps (design 4.6)
  if name == "From" {
    return wrapsExactlyOnce checker, target, wanted
  }
  if name == "Into" {
    return isIntoBase checker, target, wanted
  }
  // The conversion from text a literal type is given is the one `TryFrom` the language generates, and it is asked for
  // through a bound as well as by name: `decodeLiteral<Value: TryFrom<String, LiteralParseError>>` reads one back
  if name == "TryFrom" {
    if const .Literals(_, _) = checker.types.form(target) {
      return isLiteralTrait checker, name, wanted
    }
    return false
  }
  /*
   * `Compare` is generated for a **tuple** and for nothing else. An order is a decision and not a structure, so no
   * `type` gets one - but a tuple has no declaration anybody could write one in, and sorting by a tuple key
   * (`diagnostics.sort { (_.span.start, _.span.end) }`) is the idiom of the language. Lexicographic by position is the
   * only reading there is.
   */
  if name == "Compare" {
    if const .Tuple(_) = checker.types.form(target) {
      return everyFieldImplements checker, target, capability, wanted
    }
    return false
  }
  match checker.types.form(target) {
    // A literal type has exactly what the concept's "Literal Types" names - `TryFrom<String, LiteralParseError>`, `Show`,
    // `Equals`, `Hash`, `Encode`, `Decode`, and the `Into` of its base above - and nothing else. `Compare` is
    // not among them: an order over three strings is a decision, exactly as it is for a `type`
    .Literals(_, _) => isLiteralTrait checker, name, wanted
    // Tuples and function types cannot be declared, so what a `type` gets generated they get generated too - except a
    // description: a tuple has no name and no field names a schema could hold
    .Tuple(_) => name != "Describe" && everyFieldImplements(checker, target, capability, wanted)
    .Function(_) => name == "Show"
    .Nominal(symbol, _) => {
      const identifier = typeSignatureOf checker, symbol
      const shape = checker.typeSignature identifier
      // A `native` type is what the runtime provides, and a trait it does not declare it does not have
      if shape.native {
        return false
      }
      // A trait is not a type with fields: there is nothing structural to generate
      if isTrait(checker, symbol) {
        return false
      }
      // Only `Show` is generated for a `shared type`: everything else would compare or copy an identity
      if shape.shared && name != "Show" {
        return false
      }
      // A capsule: nothing outside can call the constructor, so there is no field list a caller could be handed, and
      // the one conversion pair takes its place (`docs/language/types/data-or-capsule.md`)
      if isEncoding(name) && !isConstructible(checker, shape.fields) {
        if derivesThroughPair(checker, target, name) {
          return true
        }
        // Without a pair the way **in** is refused, because the closed constructor is what protects the invariant,
        // and so is the description of it. The way **out** stays what it is for every type: the fields, which is the
        // form `Show` takes too
        return name == "Encode" && everyFieldImplements(checker, target, capability, wanted)
      }
      // The three forms of an open constructor are over its parameters: a `private` field with a default is none
      everyFieldImplements checker, target, capability, wanted, passableOnly: isEncoding(name)
    }
    _ => false
  }
}

/**
 * The traits a literal type carries. `TryFrom` is the one whose arguments are fixed: a literal type is read from text
 * and fails with a `LiteralParseError` and with nothing else, so `Status with TryFrom<Int64, NumberRangeError>` is not
 * generated even where the base has one.
 */
fn isLiteralTrait(var checker: Checker, name: String, wanted: TypeId?): Bool {
  if name == "TryFrom" {
    const generated = match literalConversionBound(checker) {
      Some(found) => found
      None => {
        return false
      }
    }
    match wanted {
      Some(asked) => sameType checker.types, asked, generated
      None => true
    }
  } else {
    name == "Show" || name == "Equals" || name == "Hash" || isEncoding(name)
  }
}

/**
 * Whether every case of a type stands for a number - `case Read = 1` - which is what `RawValue` is generated for. The
 * checker holds the values to their rules (`case-value.trb`), and a type that breaks one has a message already.
 */
public fn hasCaseValues(var checker: Checker, target: TypeId): Bool {
  const symbol = match checker.types.form(target) {
    .Nominal(found, _) => found
    _ => {
      return false
    }
  }
  if isTrait(checker, symbol) {
    return false
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  !shape.native
    && !shape.cases.isEmpty()
    && shape.cases.all({ variant => variant.value.isSome() && variant.fields.isEmpty() })
}

fn isTrait(checker: Checker, symbol: SymbolId): Bool {
  match checker.symbolAt(symbol).kind {
    .Trait => true
    _ => false
  }
}

/**
 * Whether the generated constructor can be called from outside the type. A `private` field without a default cannot
 * be left out and cannot be passed, so one of them closes the constructor and makes the type a **capsule**.
 */
public fn isConstructible(checker: Checker, fields: List<FieldSignature>): Bool {
  for field in fields {
    const isHidden = field.visibility == Visibility.Private
    if isHidden && !field.hasDefault {
      return false
    }
  }
  true
}

/** The three traits a capsule derives through its conversion pair instead of through its fields. */
fn isEncoding(name: String): Bool {
  name == "Encode" || name == "Decode" || name == "Describe"
}

/**
 * Whether a field is a parameter of the constructor from outside: everything but a `private` one. `protected var` is
 * publicly readable and publicly constructible, so it is passable.
 */
public fn isPassable(field: FieldSignature): Bool {
  field.visibility != Visibility.Private
}

/**
 * The one conversion pair of a capsule: the type a value of it is read from and written as, and how it is read.
 *
 * `Path` pairs with `String`, because `Path` has `From<String>` and `String` has `From<Path>`. That one type is
 * everything the generated `encode` and `decode` need: they hand the work to it and convert on the way through.
 */
public type ConversionPair {
  /** The `Source` of the pair: `String` for `Path`. */
  source: TypeId
  /** Whether the way in is the fallible `Self.tryFrom(source)` rather than the total `Self.from(source)`. */
  fallible: Bool
}

/** The conversion pair of `target`, and `None` where it has no pair or more than one. */
public fn conversionPairOf(var checker: Checker, target: TypeId): ConversionPair? {
  const found = conversionSourcesOf checker, target
  if found.length() != 1 {
    return None
  }
  found[0]
}

/**
 * Every type `target` converts into **and** back out of, in the order the implementations are written, the fallible
 * way in first. `TryFrom<Source, Failure>` or `From<Source>` is the way in and `From<Self>` on the `Source` is the way
 * out; a type that has both ways to the same `Source` is read through `tryFrom`, which is the one that can refuse.
 *
 * The reflexive `From<Self>` every type has never counts, and neither does `From<Never>`: both hold for every type at
 * all, so a pair made of one would be no decision of the type's own.
 */
public fn conversionSourcesOf(var checker: Checker, target: TypeId): List<ConversionPair> {
  const conversion = match checker.wellKnown.from {
    Some(found) => found
    None => {
      return []
    }
  }
  var pairs: List<ConversionPair> = []
  if const Some(tryFrom) = checker.wellKnown.tryFrom {
    const fallible = writtenTraitsOf checker, target, tryFrom
    for bound in fallible {
      addConversionSource checker, pairs, target, bound, conversion, fallible: true
    }
  }
  const total = writtenTraitsOf checker, target, conversion
  for bound in total {
    addConversionSource checker, pairs, target, bound, conversion, fallible: false
  }
  pairs
}

/** One candidate, kept when the way back exists and the same `Source` is not there already. */
fn addConversionSource(
  var checker: Checker,
  var pairs: List<ConversionPair>,
  target: TypeId,
  bound: TypeId,
  conversion: SymbolId,
  fallible: Bool,
) {
  const arguments = match checker.types.form(bound) {
    .Nominal(_, given) => given
    _ => {
      return
    }
  }
  if arguments.isEmpty() {
    return
  }
  const source = arguments[0]
  if sameType(checker.types, source, target) || source == checker.neverType || !isConcrete(checker, source) {
    return
  }
  for known in pairs {
    if sameType(checker.types, known.source, source) {
      return
    }
  }
  const back = checker.nominal conversion, [target]
  if !implementsBound(checker, source, back) {
    return
  }
  pairs.append ConversionPair(source, fallible)
}

/**
 * Whether a capsule's `Encode` or `Decode` can be generated. It takes exactly one conversion pair, and the `Source`
 * of that pair has to carry the trait itself: the generated body writes and reads that value and nothing else.
 */
fn derivesThroughPair(var checker: Checker, target: TypeId, name: String): Bool {
  const pair = match conversionPairOf(checker, target) {
    Some(found) => found
    None => {
      return false
    }
  }
  const capability = match checker.wellKnown.symbolNamed(name) {
    Some(found) => found
    None => {
      return false
    }
  }
  const bound = checker.nominal capability, []
  implementsBound checker, pair.source, bound
}

/**
 * Every field of the type and of every one of its cases has to have the trait itself. `passableOnly` asks only about
 * the constructor's parameters from outside, which is what the three encoding forms are made of.
 */
fn everyFieldImplements(
  var checker: Checker,
  target: TypeId,
  capability: SymbolId,
  wanted: TypeId?,
  passableOnly: Bool = false,
): Bool {
  const bound = match wanted {
    Some(found) => found
    None => checker.nominal capability, []
  }
  match checker.types.form(target) {
    .Tuple(fields) => {
      for field in fields {
        if !fieldImplements(checker, field.type, target, bound) {
          return false
        }
      }
      true
    }
    .Nominal(symbol, arguments) => {
      const identifier = typeSignatureOf checker, symbol
      const shape = checker.typeSignature identifier
      var mapping: Map<ParameterId, TypeId> = [:]
      for position in 0..shape.generics.length().min(arguments.length()) {
        mapping.set shape.generics[position], arguments[position]
      }
      for field in shape.fields {
        if passableOnly && !isPassable(field) {
          continue
        }
        const annotation = substitute checker.types, field.type, mapping
        if !fieldImplements(checker, annotation, target, bound) {
          return false
        }
      }
      for variant in shape.cases {
        for field in variant.fields {
          const annotation = substitute checker.types, field.type, mapping
          if !fieldImplements(checker, annotation, target, bound) {
            return false
          }
        }
      }
      true
    }
    _ => true
  }
}

/** A field of the type's own type needs nothing: the generated member recurses exactly as the value does. */
fn fieldImplements(var checker: Checker, annotation: TypeId, target: TypeId, bound: TypeId): Bool {
  if sameType(checker.types, annotation, target) {
    return true
  }
  implementsBound checker, annotation, bound
}

/**
 * `type AppError { case Io(error: IoError) ... }` gets `From<IoError>`, which is what makes `?` convert an error
 * without anybody writing the implementation. Exactly one case may wrap exactly one value of that type.
 */
fn wrapsExactlyOnce(var checker: Checker, target: TypeId, wanted: TypeId?): Bool {
  const bound = match wanted {
    Some(found) => found
    None => {
      return false
    }
  }
  const source = match checker.types.form(bound) {
    .Nominal(_, arguments) => {
      if arguments.length() != 1 {
        return false
      }
      arguments[0]
    }
    _ => {
      return false
    }
  }
  // Every type converts from itself, and that conversion is the value. `fn sum(): Item where Item: Add & From<Int>`
  // asks `Int64` for `From<Int64>`, and a reflexive `From` cannot be written down as a blanket implementation because
  // it would overlap with every other one
  if sameType(checker.types, target, source) {
    return true
  }
  const (symbol, arguments) = match checker.types.form(target) {
    .Nominal(found, given) => (found, given)
    _ => {
      return false
    }
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  if shape.cases.isEmpty() {
    return false
  }
  var mapping: Map<ParameterId, TypeId> = [:]
  for position in 0..shape.generics.length().min(arguments.length()) {
    mapping.set shape.generics[position], arguments[position]
  }
  var matches = 0
  for variant in shape.cases {
    if variant.fields.length() != 1 {
      continue
    }
    const annotation = substitute checker.types, variant.fields[0].type, mapping
    if sameType(checker.types, annotation, source) {
      matches = matches + 1
    }
  }
  matches == 1
}

/** `Into<String>` for `"a" | "b"`: a literal type converts into its own base, and into nothing else. */
fn isIntoBase(var checker: Checker, target: TypeId, wanted: TypeId?): Bool {
  const bound = match wanted {
    Some(found) => found
    None => {
      return false
    }
  }
  const into = match checker.types.form(bound) {
    .Nominal(_, arguments) => {
      if arguments.length() != 1 {
        return false
      }
      arguments[0]
    }
    _ => {
      return false
    }
  }
  if const .Literals(base, _) = checker.types.form(target) {
    return sameType checker.types, base, into
  }
  false
}

/**
 * Why a capsule carries no `Decode`, as the notes of the message that asked for one: the rule first, then the one
 * thing that is wrong about this type. Empty for everything else, so a type that lacks the trait for the ordinary
 * reason keeps the ordinary message.
 */
public fn capsuleNotesOf(var checker: Checker, target: TypeId, bound: TypeId): List<String> {
  const name = match capabilityNameOf(checker, bound) {
    Some(found) => found
    None => {
      return []
    }
  }
  if name != "Decode" {
    return []
  }
  const symbol = match checker.types.form(target) {
    .Nominal(found, _) => found
    _ => {
      return []
    }
  }
  if isTrait(checker, symbol) {
    return []
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  if shape.native || shape.shared || isConstructible(checker, shape.fields) {
    return []
  }
  const shown = checker.describe target
  const closing = closedFieldOf shape.fields
  var notes = [
    "`{shown}` is a capsule: `{closing}` is private and has no default, so nothing outside can call the constructor"
      + " and `{name}` comes from `{shown}`'s one conversion pair instead of from its fields",
  ]
  const sources = conversionSourcesOf checker, target
  if sources.isEmpty() {
    notes.append(
      "`{shown}` has no pair. Write `From<Source>` or `TryFrom<Source, Failure>` for `{shown}`, and `From<{shown}>`"
        + " for that `Source`",
    )
    return notes
  }
  if sources.length() > 1 {
    var shownSources: List<String> = []
    for pair in sources {
      shownSources.append "`{checker.describe(pair.source)}`"
    }
    notes.append "`{shown}` converts both ways with {listedNames(shownSources)}. Exactly one type may"
    return notes
  }
  const pair = sources[0]
  const how = if pair.fallible { "tryFrom" } else { "from" }
  const source = checker.describe pair.source
  notes.append "`{shown}` pairs with `{source}` through `{how}`, and that type is not `{name}` itself"
  notes
}

/**
 * Why a type with an open constructor carries none of the three encoding forms, as the notes of the message that asked
 * for one: the chain of fields down to the type that is the root cause, then what is wrong about that type.
 *
 *     its field `avatar: Avatar` is not `Decode`: `User.avatar -> Avatar.image -> Image`
 *
 * The first field that fails is followed, and inside of it again the first, so the chain names one path and not a
 * tree. Where the type at its end is a capsule, the capsule's own notes follow. Empty where the type is no record, or
 * where every field implements the trait - then the ordinary message is all there is to say.
 */
public fn fieldChainNotesOf(var checker: Checker, target: TypeId, bound: TypeId): List<String> {
  const name = match capabilityNameOf(checker, bound) {
    Some(found) => found
    None => {
      return []
    }
  }
  if !isEncoding(name) {
    return []
  }
  var chain: List<String> = []
  var current = target
  var first: String? = None
  var seen: List<TypeId> = []
  // A bound on the depth, for a chain of generic records that never comes back to a type it saw
  for _ in 0..16 {
    if seen.contains(current) {
      break
    }
    seen.append current
    const failing = match failingFieldOf(checker, current, bound) {
      Some(found) => found
      None => {
        break
      }
    }
    chain.append "{describeHead(checker, current)}.{failing.name}"
    if first.isNone() {
      first = "`{failing.name}: {checker.describe(failing.type)}`"
    }
    current = failing.type
  }
  const field = match first {
    Some(found) => found
    None => {
      return []
    }
  }
  chain.append checker.describe(current)
  var notes = ["its field {field} is not `{name}`: `{chain.joined(separator: " -> ")}`"]
  notes.appendAll capsuleNotesOf(checker, current, bound)
  notes
}

/** The name and the type of one field, substituted for the arguments of the type it belongs to. */
type FailingField {
  name: String
  type: TypeId
}

/**
 * The first field of a record with an open constructor whose type does not implement the bound, in the order the three
 * forms visit them: the passable fields, then the fields of every case.
 */
fn failingFieldOf(var checker: Checker, target: TypeId, bound: TypeId): FailingField? {
  const (symbol, arguments) = match checker.types.form(target) {
    .Nominal(found, given) => (found, given)
    _ => {
      return None
    }
  }
  if isTrait(checker, symbol) {
    return None
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  if shape.native || shape.shared || !isConstructible(checker, shape.fields) {
    return None
  }
  var mapping: Map<ParameterId, TypeId> = [:]
  for position in 0..shape.generics.length().min(arguments.length()) {
    mapping.set shape.generics[position], arguments[position]
  }
  var fields: List<FieldSignature> = []
  for field in shape.fields {
    if isPassable(field) {
      fields.append field
    }
  }
  for variant in shape.cases {
    fields.appendAll variant.fields
  }
  for field in fields {
    const annotation = substitute checker.types, field.type, mapping
    if !fieldImplements(checker, annotation, target, bound) {
      return FailingField field.name, annotation
    }
  }
  None
}

/** `User` for `User`, `Page` for `Page<Item>`: the declaration a field belongs to, as the chain writes it. */
fn describeHead(var checker: Checker, target: TypeId): String {
  if const .Nominal(symbol, _) = checker.types.form(target) {
    return checker.symbolAt(symbol).name
  }
  checker.describe target
}

/** `a`, `b` and `c`: a list a sentence can hold, with the last one joined by a word instead of a comma. */
fn listedNames(parts: List<String>): String {
  if parts.length() < 2 {
    return parts.joined separator: ""
  }
  const front = parts.take(parts.length() - 1).toList()
  "{front.joined(separator: ", ")} and {parts[parts.length() - 1]}"
}

/** The first `private` field without a default: the one that closed the constructor, and the one a message names. */
fn closedFieldOf(fields: List<FieldSignature>): String {
  for field in fields {
    if field.visibility == Visibility.Private && !field.hasDefault {
      return field.name
    }
  }
  ""
}

/** The name of the trait a bound asks for, but only where it is the prelude's trait of that name. */
fn capabilityNameOf(var checker: Checker, bound: TypeId): String? {
  const symbol = match checker.types.form(bound) {
    .Nominal(found, _) => found
    _ => {
      return None
    }
  }
  const name = derivedTraitName checker, symbol
  if name.isEmpty() {
    return None
  }
  name
}
