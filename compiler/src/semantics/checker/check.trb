/**
 * [checkTypes] is the entry point of the type checker: it checks the declarations of the given modules and returns
 * the [Checker] that did it, which *is* the result - every type by id, every signature, the type of every type
 * position, and the tables the next pass reads.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Statement, Binding, Declaration, Member from "../../syntax/ast"
use FunctionDeclaration, ExtendDeclaration, Expression from "../../syntax/ast"
use ModuleId from "../module"
use SymbolId, boundNamesOf from "../symbols"
use Program from "../scope"
use Clock from "std/time"
use Checker, TypeScope, Statistics, Timing, newChecker from "./context"
use TypeId from "./type"
use declareSites, declareParameters, genericsOf from "./signature"
use signatureOf, typeSignatureOf, aliasTargetOf from "./signature"
use traitList, boundsOf, resultOf from "./signature"
use typeFromReference from "./lowering"
use checkBodyOf, checkInitializer, checkStatement from "./statement"
use checkPattern from "./pattern"
use requireIrrefutable from "./exhaustive"
use reportTopLevelUsing, checkScopedStatement from "./close"
use deferBlock, emptyLiteralOf from "./expression"
use checkFieldDefaultConstant from "./constant"
use settleChanges from "./mutation"
use settleEscapes from "./escape"
use buildImplementations, checkCoherence, checkImplementations, extensionAt from "./implementation"
use checkMemberImports from "./implementation"
use scriptReceiverOf, checkReceiverScript from "./receiver"
use checkShape, requireInhabitedType, checkTypeArgumentBoundsWithin from "./declaration"
use checkSpelling from "./spelling"

/**
 * Checks the declarations of the given modules: every type position becomes a type, every declaration a signature, and
 * every expression of every body a type. Only what was asked for is checked; the signatures of everything it names are
 * built on demand, which is why `torb check app` does not have to walk the whole standard library.
 *
 * The `Checker` it gives back *is* the result: it holds the types, the signatures, the type of every type position,
 * the tables of every module and the diagnostics.
 */
public fn checkTypes(
  program: Program,
  resolutions: List<Map<Span, SymbolId>>,
  modules: List<ModuleId>,
  withTimings: Bool = false,
): Checker {
  var checker = newChecker program, resolutions
  checker.withTimings = withTimings
  var clock = Stopwatch withTimings
  clock.start()
  // Where every declaration is written, for every module: a signature of one module is built from another's
  for module in program.graph.modules {
    declareSites checker, module.id, module.file.statements
  }
  const sites = clock.taken()
  checker.timings.append Timing("declaration sites", sites)
  // Every implementation of the program, then the two rules that need all of them: the orphan rule and overlap
  buildImplementations checker
  const index = clock.taken()
  checker.timings.append Timing("the implementation index", index)
  checkCoherence checker
  const coherence = clock.taken()
  checker.timings.append Timing("coherence", coherence)
  for module in modules {
    checkImplementations checker, module
  }
  const requirements = clock.taken()
  checker.timings.append Timing("trait requirements", requirements)
  for module in modules {
    checker.checkedModules.set module.value, true
    checkModule checker, module
  }
  // Whether a closure argument may capture a `var` binding is a fact of its callee's body, which is known only now
  settleEscapes checker
  const bodies = clock.taken()
  const shape = checker.shapeMilliseconds
  checker.timings.append Timing("bodies", bodies - shape)
  checker.timings.append Timing("program shape and constant folding", shape)
  checker
}

/**
 * A checker that built the declaration sites and the implementation index of the whole program and checked its
 * coherence - everything [checkTypes] does before its first module - for a caller that checks the modules one at a
 * time with [checkNextModule], answering other work in between (a language server's check of the workspace), and
 * settles the escapes once at the end (`settleEscapes`).
 */
public fn preparedChecker(
  program: Program,
  resolutions: List<Map<Span, SymbolId>>,
  withTimings: Bool = false,
): Checker {
  var checker = newChecker program, resolutions
  checker.withTimings = withTimings
  var clock = Stopwatch withTimings
  clock.start()
  for module in program.graph.modules {
    declareSites checker, module.id, module.file.statements
  }
  checker.timings.append Timing("declaration sites", clock.taken())
  buildImplementations checker
  checker.timings.append Timing("the implementation index", clock.taken())
  checkCoherence checker
  checker.timings.append Timing("coherence", clock.taken())
  checker
}

/**
 * The trait requirements and every body of one module, on a checker [preparedChecker] made: one module of what
 * [checkTypes] checks. A module whose bodies are checked already is left alone.
 */
public fn checkNextModule(var checker: Checker, module: ModuleId) {
  if checker.checkedModules.containsKey(module.value) {
    return
  }
  checker.checkedModules.set module.value, true
  checkImplementations checker, module
  checkModule checker, module
}

/**
 * The bodies of the functions of one module that lie inside of `within`, and nothing else of that module: what a
 * language server checks after a keystroke that changed these bodies and nothing another body can see
 * (docs/design/LANGUAGE-SERVER.md section 6). The declaration sites and the implementation index are built for the
 * whole program as [checkTypes] builds them, because a body may call anything; the spelling of the module's names,
 * the escapes of what the bodies hand on and the bounds of their type positions are checked as a whole module would
 * be. Everything the checker reports outside of `within` - a callee's body checked on demand, a name spelled wrong in
 * a signature - is the business of a check of the whole module, and the caller drops it.
 *
 * A body is a pure function of the signatures (docs/TYPECHECKER.md 7.3), so its tables and diagnostics are what a
 * check of the whole module would have found for it.
 */
public fn checkBodiesWithin(
  program: Program,
  resolutions: List<Map<Span, SymbolId>>,
  module: ModuleId,
  within: List<Span>,
  withTimings: Bool = false,
): Checker {
  var checker = newChecker program, resolutions
  checker.withTimings = withTimings
  var clock = Stopwatch withTimings
  clock.start()
  for each in program.graph.modules {
    declareSites checker, each.id, each.file.statements
  }
  checker.timings.append Timing("declaration sites", clock.taken())
  buildImplementations checker
  checker.timings.append Timing("the implementation index", clock.taken())
  checkSpelling checker, module
  for statement in program.graph.at(module).file.statements {
    if const .Declare(declaration) = statement.kind {
      checkBodiesOfDeclaration checker, module, declaration, within
    }
  }
  settleEscapes checker
  checkTypeArgumentBoundsWithin checker, module, within
  checker.timings.append Timing("bodies", clock.taken())
  checker
}

/** Whether a body lies inside of one of the spans. */
fn isBodyWithin(function: FunctionDeclaration, within: List<Span>): Bool {
  match function.body {
    Some(body) => within.any({ _.start <= body.span.start && body.span.end <= _.end })
    None => false
  }
}

/** The bodies of one declaration that lie inside of `within`: a function's, or those of the members of a type. */
fn checkBodiesOfDeclaration(var checker: Checker, module: ModuleId, declaration: Declaration, within: List<Span>) {
  match declaration.kind {
    .Function(function) => {
      if isBodyWithin(function, within) {
        if const Some(symbol) = checker.resolvedName(module, function.name.span) {
          checkBodyOf checker, symbol
        }
      }
    }
    .Type(written) => checkMemberBodiesWithin checker, module, written.name.span, written.members, within
    .Trait(written) => checkMemberBodiesWithin checker, module, written.name.span, written.members, within
    .Extend(extension) => {
      if const Some(implementation) = extensionAt(checker, module, extension.target.span) {
        checkKnownBodiesWithin checker, implementation.members, extension.members, within
      }
    }
    _ => {}
  }
}

/** The bodies of the members of a `type` or a `trait` named at `at` that lie inside of `within`. */
fn checkMemberBodiesWithin(
  var checker: Checker,
  module: ModuleId,
  at: Span,
  members: List<Member>,
  within: List<Span>,
) {
  if !members.any({ member => functionOfMember(member).map({ isBodyWithin _, within }) ?? false }) {
    return
  }
  if const Some(symbol) = checker.resolvedName(module, at) {
    const identifier = typeSignatureOf checker, symbol
    const known = checker.typeSignature(identifier).members
    checkKnownBodiesWithin checker, known, members, within
  }
}

fn checkKnownBodiesWithin(
  var checker: Checker,
  known: Map<String, SymbolId>,
  members: List<Member>,
  within: List<Span>,
) {
  for member in members {
    if const Some(function) = functionOfMember(member) {
      if isBodyWithin(function, within) {
        if const Some(symbol) = known.get(function.name.text) {
          checkBodyOf checker, symbol
        }
      }
    }
  }
}

/**
 * The symbol of the function whose name is written at `name` in `module`: a function of the file, or a member of one
 * of its types, traits and `extend`s. What a language server compares two runs by, for a function whose body changed.
 */
public fn functionSymbolAt(var checker: Checker, module: ModuleId, name: Span): SymbolId? {
  for statement in checker.program.graph.at(module).file.statements {
    const declaration = match statement.kind {
      .Declare(found) => found
      _ => {
        continue
      }
    }
    match declaration.kind {
      .Function(function) => {
        if function.name.span == name {
          return checker.resolvedName module, name
        }
      }
      .Type(written) => {
        if const Some(text) = memberNamedAt(written.members, name) {
          const owner = checker.resolvedName(module, written.name.span)?
          const identifier = typeSignatureOf checker, owner
          return checker.typeSignature(identifier).members.get(text)
        }
      }
      .Trait(written) => {
        if const Some(text) = memberNamedAt(written.members, name) {
          const owner = checker.resolvedName(module, written.name.span)?
          const identifier = typeSignatureOf checker, owner
          return checker.typeSignature(identifier).members.get(text)
        }
      }
      .Extend(extension) => {
        if const Some(text) = memberNamedAt(extension.members, name) {
          const implementation = extensionAt(checker, module, extension.target.span)?
          return implementation.members.get text
        }
      }
      _ => {}
    }
  }
  None
}

/** The name of the member function named at `at`, where one is. */
fn memberNamedAt(members: List<Member>, at: Span): String? {
  for member in members {
    if const Some(function) = functionOfMember(member) {
      if function.name.span == at {
        return function.name.text
      }
    }
  }
  None
}

fn functionOfMember(member: Member): FunctionDeclaration? {
  if const .Function(function) = member.kind {
    return function
  }
  None
}

/**
 * The bodies of more modules, checked after [checkTypes]: its implementations against their traits, every body, and
 * the facts about closures that its bodies add. A lowering that reaches a module whose bodies were not checked asks
 * for this (`torb run` checks the bodies of the entry and lets the lowering pull in the rest, docs/design/VM.md section
 * 8); a module that is checked already is left alone.
 */
public fn checkBodiesOf(var checker: Checker, modules: List<ModuleId>) {
  var isChecked = false
  for module in modules {
    if checker.checkedModules.containsKey(module.value) {
      continue
    }
    checker.checkedModules.set module.value, true
    checkImplementations checker, module
    checkModule checker, module
    isChecked = true
  }
  if isChecked {
    settleEscapes checker
  }
}

/**
 * The wall time of one pass. It only reads the clock where the flag asked for it, so the measurement never costs a
 * native call in an ordinary run.
 */
public type Stopwatch {
  enabled: Bool
  var last: Int64 = 0

  var fn start() {
    if enabled {
      last = Clock.milliseconds()
    }
  }

  var fn taken(): Int64 {
    if !enabled {
      return 0
    }
    const now = Clock.milliseconds()
    const spent = now - last
    last = now
    spent
  }
}

/**
 * Every declaration of one module, and every expression inside of its bodies. The top level of a file is one body:
 * an entry file, a script and a `tests/*.test.trb` file are ordinary code, and the locals of one statement are in
 * scope in the next.
 */
public fn checkModule(var checker: Checker, module: ModuleId) {
  // How every name of the file is spelled: one walk over its syntax, before anything is resolved, and for a
  // configuration script as well as for a module
  checkSpelling checker, module
  // `project.trb` and a configuration file are bodies, not modules: they are checked against their receiver
  if checker.program.graph.at(module).receiver.isSome() {
    if const Some(receiver) = scriptReceiverOf(checker, module) {
      checkReceiverScript checker, module, receiver
    }
    return
  }
  const statements = checker.program.graph.at(module).file.statements
  const voidType = checker.voidType
  const saved = checker.enterBody module, voidType, isInferred: true, own: None
  // The statements of a file are the one body a top-level `var` lives in, and the dead-change rule needs to know it
  // apart from the bodies of the functions that read the same declaration
  checker.topLevel = true
  checker.writesDeclarations = true
  // `await()` is allowed at the top level of an entry file and of a script (CONCEPT, "Concurrency"). In a module top
  // level code is an error of its own, so nothing is said about it twice
  checker.awaitsTasks = true
  checker.openScope()
  // The sites of the top level are known already, so nothing is collected here
  for statement in statements {
    checkTopLevel checker, TypeScope(module), statement
  }
  // The top level of a file is one body, so its changes are settled like any other's
  settleChanges checker
  checker.closeScope()
  checker.leaveBody saved
  // Visibility and the shape of the declarations, last: folding a top-level `const` reads what its names meant
  const withTimings = checker.withTimings
  var clock = Stopwatch withTimings
  clock.start()
  checkShape checker, module
  // `use String.shout from "acme/text"`: whether that package really adds such a member
  checkMemberImports checker, module
  const spent = clock.taken()
  checker.shapeMilliseconds = checker.shapeMilliseconds + spent
  reportUnchecked checker, module
}

/**
 * Every construct of the language gets a real type, so the only way an expression can still be `Deferred` at the end
 * is one a message was already given about - a parse error, a name that does not resolve, a call that could not be
 * resolved.
 *
 * So a module that has an unchecked expression and **no message at all** - neither the parser's nor the checker's - is
 * a hole in the checker, and it says so
 * instead of leaving the number in `--statistics` for somebody to notice. One message per module: the first span.
 */
fn reportUnchecked(var checker: Checker, module: ModuleId) {
  if !checker.diagnostics[module.value].isEmpty() {
    return
  }
  // A syntax error leaves a tree the checker reads as well as it can: what it could not type is the parser's message
  const parsed = checker.program.graph.at module
  if !parsed.diagnostics.isEmpty() || !parsed.deferred.isEmpty() {
    return
  }
  const unchecked = checker.uncheckedSpanOf module
  if const Some(at) = unchecked {
    checker.report(
      module,
      Diagnostic.error("The checker did not work out the type of this expression", at)
        .withNote("This is a bug of the compiler, not of this file. Please report it with the line it points at"),
    )
  }
}

/** How much of a module the checker already understands, for `torb check --statistics`. */
public fn statisticsOf(checker: Checker, module: ModuleId): Statistics {
  checker.statisticsOf module
}

/**
 * A statement at the top level of a module. Top-level code is only allowed in entry files and scripts; here every one
 * of them is checked, because a script is an ordinary body.
 */
fn checkTopLevel(var checker: Checker, scope: TypeScope, statement: Statement) {
  match statement.kind {
    .Declare(declaration) => checkDeclaration checker, scope, declaration
    .Bind(binding) => {
      reportTopLevelUsing checker, binding
      checkTopLevelBinding checker, scope, binding
    }
    _ => {
      const scopedBefore = checker.scopedBindings.length()
      const _ = checkStatement checker, statement
      // A `using` inside a block of the script: its name may not outlive that block (`close.trb`)
      if checker.scopedBindings.length() > scopedBefore {
        checkScopedStatement checker, statement
      }
    }
  }
}

/** A top-level `const` of a module is a declaration: asking for its type is what checks its initializer. */
fn checkTopLevelBinding(var checker: Checker, scope: TypeScope, binding: Binding) {
  if const .Binding(_) = binding.pattern.kind {
    if const Some(symbol) = checker.resolvedName(scope.module, binding.pattern.span) {
      const _ = resultOf checker, symbol
      return
    }
  } else {
    // `const (quotient, remainder) = divide(7, 2)`: every name the pattern binds is a declaration of the file with a
    // signature of its own, and asking for the first one of them checks the initializer they share
    if const Some(first) = boundNamesOf(binding.pattern).first() {
      if const Some(symbol) = checker.resolvedName(scope.module, first.span) {
        const _ = resultOf checker, symbol
        return
      }
    }
  }
  var annotation: TypeId? = None
  if const Some(reference) = binding.type {
    annotation = typeFromReference checker, reference, scope.forType()
  }
  const found = checkInitializer checker, scope.module, binding.value, scope.selfType, annotation
  // `const None = value`, `const Some(x) = value`: a pattern that names a case declares no name, so nothing above
  // asked for its type - and without this the binding would say nothing at all about a pattern that can fail
  if boundNamesOf(binding.pattern).isEmpty() {
    const bound = annotation ?? found
    checker.openScope()
    checkPattern checker, binding.pattern, bound, binding.var
    requireIrrefutable checker, binding.pattern, bound, "The pattern of a binding", "value"
    checker.closeScope()
  }
}

/** One declaration, wherever it stands: at the top level of a file, in a block, or in the body of a type. */
public fn checkDeclaration(var checker: Checker, scope: TypeScope, declaration: Declaration) {
  match declaration.kind {
    .Function(function) => {
      match checker.resolvedName(scope.module, function.name.span) {
        Some(symbol) => checkBodyOf checker, symbol
        // A declaration without a name is a parse error that was reported; its body still has type positions
        None => checkUnnamedBody checker, scope, function
      }
      checkDefaults checker, scope, function
    }
    .Type(typeDeclaration) => {
      checkTypeBody checker, scope, typeDeclaration.name.span, typeDeclaration.members
      if const Some(symbol) = checker.resolvedName(scope.module, typeDeclaration.name.span) {
        requireInhabitedType checker, symbol, typeDeclaration.name.span
      }
    }
    .Trait(traitDeclaration) => {
      checkTypeBody checker, scope, traitDeclaration.name.span, traitDeclaration.members
    }
    .Alias(alias) => {
      if const Some(symbol) = checker.resolvedName(scope.module, alias.name.span) {
        const _ = aliasTargetOf checker, symbol
        const generics = genericsOf checker, symbol
        const _ = boundsOf checker, generics, alias.generics, [], scope
        return
      }
      const _ = typeFromReference checker, alias.target, scope.forType()
    }
    .Extend(extension) => checkExtension checker, scope, extension
    // The functions of a `foreign` block are functions of the module, so they have signatures like any other
    .Foreign(library) => {
      for member in library.members {
        if const .Function(function) = member.kind {
          if const Some(symbol) = checker.resolvedName(scope.module, function.name.span) {
            const _ = signatureOf checker, symbol
          }
        }
      }
    }
    .Constant(binding) => checkTopLevelBinding checker, scope, binding
    .Use(_) => {}
  }
}

/**
 * A `type` or a `trait`: its own signature covers the parameters, the traits, the fields and the cases, and every
 * member gets its own. The members are built here and not with the shape of the type, so that asking what a type
 * looks like never drags in the signature of everything it calls.
 */
fn checkTypeBody(var checker: Checker, scope: TypeScope, at: Span, members: List<Member>) {
  const symbol = match checker.resolvedName(scope.module, at) {
    Some(found) => found
    // A declaration without a name is a parse error that was reported; its members still have type positions
    None => {
      checkMembers checker, scope, [:], members
      return
    }
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  const inner = scope.copy selfType: shape.own
  checkMembers checker, inner, shape.members, members
}

fn checkMembers(var checker: Checker, scope: TypeScope, known: Map<String, SymbolId>, members: List<Member>) {
  for member in members {
    match member.kind {
      .Field(field) => {
        const annotation = typeFromReference checker, field.type, scope.forType()
        checkFieldDefault checker, scope, field.default, annotation
      }
      // The annotation of a `const` member is its signature; a `const` that got no id keeps the ordinary way
      .Constant(binding) => {
        match constantMember(known, binding) {
          Some(symbol) => {
            const _ = resultOf checker, symbol
          }
          None => checkTopLevelBinding checker, scope, binding
        }
      }
      .Function(function) => {
        match known.get(function.name.text) {
          Some(symbol) => checkBodyOf checker, symbol
          None => checkUnnamedBody checker, scope, function
        }
        checkDefaults checker, scope, function
      }
      .Case(caseDeclaration) => {
        for field in caseDeclaration.fields {
          const annotation = typeFromReference checker, field.type, scope.forType()
          checkFieldDefault checker, scope, field.default, annotation
        }
      }
    }
  }
}

/** The id a `const` of a body got. A pattern that is not a name there is a parse error that was reported. */
fn constantMember(known: Map<String, SymbolId>, binding: Binding): SymbolId? {
  if const .Binding(name) = binding.pattern.kind {
    return known.get name
  }
  None
}

/**
 * An `extend` is one or more implementations, and `buildImplementations` built them - including the ids of its
 * members, which must not be handed out twice. So the target and the members are read back out of the index, and only
 * the bodies are checked here.
 */
fn checkExtension(var checker: Checker, scope: TypeScope, extension: ExtendDeclaration) {
  const implementation = match extensionAt(checker, scope.module, extension.target.span) {
    Some(found) => found
    // A target that did not build a type produced no implementation; its members still have type positions
    None => {
      const generics = declareParameters checker, scope.module, owner: None, declared: extension.generics
      const target = typeFromReference checker, extension.target, scope.forType()
      const inner = scope.copy selfType: target
      const _ = boundsOf checker, generics, extension.generics, extension.whereClauses, inner
      const _ = traitList checker, extension.traits, target, inner
      checkMembers checker, inner, [:], extension.members
      return
    }
  }
  const inner = scope.copy selfType: implementation.target
  const members = implementation.members
  checkMembers checker, inner, members, extension.members
}

/**
 * A default is evaluated at every call and at every construction, in the scope of the declaration - without `self`
 * and without the other parameters or fields.
 */
fn checkDefaults(var checker: Checker, scope: TypeScope, function: FunctionDeclaration) {
  for parameter in function.parameters {
    if parameter.default.isNone() {
      continue
    }
    // The type of the parameter is the one its signature built: a `lazy` one records the type inside of it
    var annotation: TypeId? = None
    if const Some(reference) = parameter.type {
      const known = checker.typePositions[scope.module.value]
      annotation = known.get reference.span
    }
    checkDefault checker, scope, parameter.default, annotation
  }
}

/**
 * The default of a **field**. It is evaluated without `self` and without the other fields, so a name that is a field
 * of the same type is a mistake with a message of its own - which is what `inFieldDefault` is for. And it is a
 * constant ([checkFieldDefaultConstant]), which is asked only of a default that checked without a message: one root
 * cause, one message.
 */
fn checkFieldDefault(var checker: Checker, scope: TypeScope, default: Expression?, annotation: TypeId?) {
  const outer = checker.inFieldDefault
  checker.inFieldDefault = true
  const before = checker.diagnostics[scope.module.value].length()
  checkDefault checker, scope, default, annotation
  checker.inFieldDefault = outer
  if const Some(expression) = default {
    if checker.diagnostics[scope.module.value].length() == before {
      const empty = match annotation {
        Some(declared) => emptyLiteralOf checker, declared
        None => None
      }
      checkFieldDefaultConstant checker, scope.module, expression, empty
    }
  }
}

fn checkDefault(var checker: Checker, scope: TypeScope, default: Expression?, annotation: TypeId?) {
  if const Some(expression) = default {
    const _ = checkInitializer checker, scope.module, expression, scope.selfType, annotation
  }
}

/**
 * A `fn` whose name did not parse, so it has no symbol and no signature. Its types are still built and its body is
 * still walked - nothing in it is checked, because without a signature its parameters have no types and every name in
 * it would look unknown.
 */
fn checkUnnamedBody(var checker: Checker, scope: TypeScope, function: FunctionDeclaration) {
  for parameter in function.parameters {
    if const Some(reference) = parameter.type {
      const _ = typeFromReference checker, reference, scope.forType()
    }
  }
  if const Some(returnType) = function.returnType {
    const _ = typeFromReference checker, returnType, scope.forType()
  }
  if const Some(body) = function.body {
    declareSites checker, scope.module, body.statements
    deferBlock checker, body
  }
}
