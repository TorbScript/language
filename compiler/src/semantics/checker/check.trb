use Span from "../../syntax/source"
use Statement, Block, Binding, Condition, Declaration, Member from "../../syntax/ast"
use FunctionDeclaration, ExtendDeclaration, Expression, Argument from "../../syntax/ast"
use ModuleId from "../module"
use SymbolId from "../symbols"
use Program from "../scope"
use Checker, TypeScope, newChecker from "./context"
use declareSites, declareParameters, genericsOf from "./signature"
use signatureOf, typeSignatureOf, aliasTargetOf, extensionMembers from "./signature"
use traitList, boundsOf from "./signature"
use typeFromReference from "./lowering"

/**
 * Checks the declarations of the given modules: every type position becomes a type, and every declaration a
 * signature. Only what was asked for is checked; the signatures of everything it names are built on demand, which is
 * why `torb check app` does not have to walk the whole standard library.
 *
 * The `Checker` it gives back *is* the result: milestone 4.1 fills `typePositions` (the type of every type position,
 * by module and span, in the shape milestone 3 hands over its name resolutions), the signatures and the diagnostics.
 * The passes after it add the types of expressions, what every name resolved to, and what the source leaves out.
 */
public fn checkTypes(program: Program, resolutions: List<Map<Span, SymbolId>>, modules: List<ModuleId>): Checker {
  var checker = newChecker(program, resolutions)
  // Where every declaration is written, for every module: a signature of one module is built from another's
  for module in program.graph.modules {
    declareSites(checker, module.id, module.file.statements)
  }
  for module in modules {
    checkModule(checker, module)
  }
  checker
}

/** Every declaration of one module, and every type position inside of its bodies. */
public fn checkModule(var checker: Checker, module: ModuleId) {
  const statements = checker.program.graph.at(module).file.statements
  // The sites of the top level are known already, so nothing is collected here
  for statement in statements {
    checkStatement(checker, TypeScope(module), statement)
  }
}

fn checkBlock(var checker: Checker, scope: TypeScope, block: Block) {
  // A declaration is visible in the whole block it is written in, so all of them are found before any is built
  declareSites(checker, scope.module, block.statements)
  for statement in block.statements {
    checkStatement(checker, scope, statement)
  }
}

fn checkStatement(var checker: Checker, scope: TypeScope, statement: Statement) {
  match statement.kind {
    .Declare(declaration) => checkDeclaration(checker, scope, declaration)
    .Bind(binding) => checkBinding(checker, scope, binding)
    .Assign(target, value) => {
      walkExpression(checker, scope, target)
      walkExpression(checker, scope, value)
    }
    .For(_, iterable, body) => {
      walkExpression(checker, scope, iterable)
      checkBlock(checker, scope, body)
    }
    .While(condition, body) => {
      walkCondition(checker, scope, condition)
      checkBlock(checker, scope, body)
    }
    .Return(value) => {
      if const Some(expression) = value {
        walkExpression(checker, scope, expression)
      }
    }
    .Break => {}
    .Continue => {}
    .Evaluate(expression) => walkExpression(checker, scope, expression)
  }
}

/** The annotation of a binding is a type position; what its initializer is worth is milestone 4.2. */
fn checkBinding(var checker: Checker, scope: TypeScope, binding: Binding) {
  if const Some(annotation) = binding.annotation {
    const _ = typeFromReference(checker, annotation, scope.forType())
  }
  walkExpression(checker, scope, binding.value)
}

fn checkDeclaration(var checker: Checker, scope: TypeScope, declaration: Declaration) {
  match declaration.kind {
    .Function(function) => {
      if const Some(symbol) = checker.resolvedName(scope.module, function.name.span) {
        const _ = signatureOf(checker, symbol)
      }
      checkFunctionBody(checker, scope, function)
    }
    .Type(typeDeclaration) => {
      checkTypeBody(checker, scope, typeDeclaration.name.span, typeDeclaration.members)
    }
    .Trait(traitDeclaration) => {
      checkTypeBody(checker, scope, traitDeclaration.name.span, traitDeclaration.members)
    }
    .Alias(alias) => {
      if const Some(symbol) = checker.resolvedName(scope.module, alias.name.span) {
        const _ = aliasTargetOf(checker, symbol)
        const generics = genericsOf(checker, symbol)
        const _ = boundsOf(checker, generics, alias.generics, [], scope)
        return
      }
      const _ = typeFromReference(checker, alias.target, scope.forType())
    }
    .Extend(extension) => checkExtension(checker, scope, extension)
    // The functions of a `foreign` block are functions of the module, so they have signatures like any other
    .Foreign(library) => {
      for member in library.members {
        if const .Function(function) = member.kind {
          if const Some(symbol) = checker.resolvedName(scope.module, function.name.span) {
            const _ = signatureOf(checker, symbol)
          }
        }
      }
    }
    .Constant(binding) => checkBinding(checker, scope, binding)
    .Use(_) => {}
  }
}

/**
 * A `type` or a `trait`: its own signature covers the parameters, the traits, the fields and the cases, and every
 * member gets its own. The members are built here and not with the shape of the type, so that asking what a type
 * looks like never drags in the signature of everything it calls.
 */
fn checkTypeBody(var checker: Checker, scope: TypeScope, at: Span, members: List<Member>) {
  const symbol = match checker.resolvedName(scope.module, at) {
    Some(found) => found
    // A declaration without a name is a parse error that was reported; its members still have type positions
    .None => {
      checkMembers(checker, scope, [:], members)
      return
    }
  }
  const identifier = typeSignatureOf(checker, symbol)
  const signature = checker.typeSignature(identifier)
  checkMembers(checker, scope.copy(selfType: Some(signature.own)), signature.members, members)
}

fn checkMembers(
  var checker: Checker,
  scope: TypeScope,
  known: Map<String, SymbolId>,
  members: List<Member>,
) {
  for member in members {
    match member.kind {
      .Field(field) => walkDefault(checker, scope, field.default)
      // The annotation of a `const` member is its signature; a `const` that got no id keeps the ordinary way
      .Constant(binding) => {
        match constantMember(known, binding) {
          Some(symbol) => {
            const _ = signatureOf(checker, symbol)
            walkExpression(checker, scope, binding.value)
          }
          .None => checkBinding(checker, scope, binding)
        }
      }
      .Function(function) => {
        if const Some(symbol) = known.get(function.name.text) {
          const _ = signatureOf(checker, symbol)
        }
        checkFunctionBody(checker, scope, function)
      }
      .Case(caseDeclaration) => {
        for field in caseDeclaration.fields {
          walkDefault(checker, scope, field.default)
        }
      }
    }
  }
}

/** The id a `const` of a body got. A pattern that is not a name there is a parse error that was reported. */
fn constantMember(known: Map<String, SymbolId>, binding: Binding): SymbolId? {
  if const .Binding(name) = binding.pattern.kind {
    return known.get(name)
  }
  None
}

/**
 * An `extend` has no symbol of its own: milestone 4.3 turns it into an implementation. Here its target, its traits
 * and the signatures of its members are built, which is what finds everything that is wrong in them.
 */
fn checkExtension(var checker: Checker, scope: TypeScope, extension: ExtendDeclaration) {
  const generics = declareParameters(checker, scope.module, None, extension.generics)
  const target = typeFromReference(checker, extension.target, scope.forType())
  const inner = scope.copy(selfType: Some(target))
  const _ = boundsOf(checker, generics, extension.generics, extension.whereClauses, inner)
  const _ = traitList(checker, extension.traits, target, inner)
  const members = extensionMembers(checker, scope.module, target, generics, extension.members)
  checkMembers(checker, inner, members, extension.members)
}

fn checkFunctionBody(var checker: Checker, scope: TypeScope, function: FunctionDeclaration) {
  for parameter in function.parameters {
    walkDefault(checker, scope, parameter.default)
  }
  if const Some(body) = function.body {
    checkBlock(checker, scope, body)
  }
}

fn walkDefault(var checker: Checker, scope: TypeScope, default: Expression?) {
  if const Some(expression) = default {
    walkExpression(checker, scope, expression)
  }
}

// --- Type positions inside of expressions ---------------------------------------------------------------------------

/**
 * Expressions are walked for the type positions inside of them: the annotations of bindings and closure parameters,
 * the arguments of `List<Int>(...)`, and the declarations of nested blocks. What the expressions *mean* is
 * milestone 4.2.
 */
fn walkExpression(var checker: Checker, scope: TypeScope, expression: Expression) {
  match expression.kind {
    // `Matrix<2, 3>()`, `Json.decode<User>(text)`: which parameter an argument fills is milestone 4.2's answer,
    // so a value and a type are both allowed here
    .Generic(target, arguments) => {
      walkExpression(checker, scope, target)
      for argument in arguments {
        const _ = typeFromReference(checker, argument, scope.forEither())
      }
    }
    .Closure(closure) => {
      for parameter in closure.parameters {
        if const Some(annotation) = parameter.annotation {
          const _ = typeFromReference(checker, annotation, scope.forType())
        }
      }
      checkBlock(checker, scope, closure.body)
    }
    .If(condition, then, otherwise) => {
      walkCondition(checker, scope, condition)
      checkBlock(checker, scope, then)
      if const Some(alternative) = otherwise {
        walkExpression(checker, scope, alternative)
      }
    }
    .Match(subject, arms) => {
      walkExpression(checker, scope, subject)
      for arm in arms {
        if const Some(guard) = arm.guard {
          walkExpression(checker, scope, guard)
        }
        walkExpression(checker, scope, arm.body)
      }
    }
    .Block(block) => checkBlock(checker, scope, block)
    .TextLiteral(segments) => {
      for segment in segments {
        if const .Interpolated(inner) = segment {
          walkExpression(checker, scope, inner)
        }
      }
    }
    .TupleLiteral(items) => walkArguments(checker, scope, items)
    .ListLiteral(items) => walkArguments(checker, scope, items)
    .MapLiteral(entries) => {
      for (key, value) in entries {
        walkExpression(checker, scope, key)
        walkExpression(checker, scope, value)
      }
    }
    .Member(target, _, _) => walkExpression(checker, scope, target)
    .Index(target, index) => {
      walkExpression(checker, scope, target)
      walkExpression(checker, scope, index)
    }
    .Call(callee, arguments, _) => {
      walkExpression(checker, scope, callee)
      walkArguments(checker, scope, arguments)
    }
    .Unary(_, operand) => walkExpression(checker, scope, operand)
    .Binary(_, left, right) => {
      walkExpression(checker, scope, left)
      walkExpression(checker, scope, right)
    }
    .RangeLiteral(start, end, _) => {
      if const Some(from) = start {
        walkExpression(checker, scope, from)
      }
      if const Some(to) = end {
        walkExpression(checker, scope, to)
      }
    }
    .Try(inner) => walkExpression(checker, scope, inner)
    _ => {}
  }
}

fn walkArguments(var checker: Checker, scope: TypeScope, arguments: List<Argument>) {
  for argument in arguments {
    walkExpression(checker, scope, argument.value)
  }
}

fn walkCondition(var checker: Checker, scope: TypeScope, condition: Condition) {
  match condition {
    .Test(expression) => walkExpression(checker, scope, expression)
    .Bind(_, _, value) => walkExpression(checker, scope, value)
  }
}
