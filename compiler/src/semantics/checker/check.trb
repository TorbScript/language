use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Statement, Binding, Declaration, Member from "../../syntax/ast"
use FunctionDeclaration, ExtendDeclaration, Expression from "../../syntax/ast"
use ModuleId from "../module"
use SymbolId from "../symbols"
use Program from "../scope"
use Clock from "std/time"
use Checker, TypeScope, Statistics, Timing, newChecker from "./context"
use TypeId from "./type"
use declareSites, declareParameters, genericsOf from "./signature"
use signatureOf, typeSignatureOf, aliasTargetOf from "./signature"
use traitList, boundsOf, resultOf from "./signature"
use typeFromReference from "./lowering"
use checkBodyOf, checkInitializer, checkStatement from "./statement"
use deferBlock from "./expression"
use settleChanges from "./mutation"
use buildImplementations, checkCoherence, checkImplementations, extensionAt from "./implementation"
use scriptReceiverOf, checkReceiverScript from "./receiver"
use checkShape from "./declaration"

/**
 * Checks the declarations of the given modules: every type position becomes a type, every declaration a signature, and
 * every expression of every body a type. Only what was asked for is checked; the signatures of everything it names are
 * built on demand, which is why `torb check app` does not have to walk the whole standard library.
 *
 * The `Checker` it gives back *is* the result: it holds the types, the signatures, the type of every type position,
 * the tables of every module (milestone 4.2 on) and the diagnostics.
 */
public fn checkTypes(
  program: Program,
  resolutions: List<Map<Span, SymbolId>>,
  modules: List<ModuleId>,
  withTimings: Bool = false,
): Checker {
  var checker = newChecker(program, resolutions)
  checker.withTimings = withTimings
  var clock = Stopwatch(withTimings)
  clock.start()
  // Where every declaration is written, for every module: a signature of one module is built from another's
  for module in program.graph.modules {
    declareSites(checker, module.id, module.file.statements)
  }
  const sites = clock.taken()
  checker.timings.add(Timing("declaration sites", sites))
  // Every implementation of the program, then the two rules that need all of them: the orphan rule and overlap
  buildImplementations(checker)
  const index = clock.taken()
  checker.timings.add(Timing("the implementation index", index))
  checkCoherence(checker)
  const coherence = clock.taken()
  checker.timings.add(Timing("coherence", coherence))
  for module in modules {
    checkImplementations(checker, module)
  }
  const requirements = clock.taken()
  checker.timings.add(Timing("trait requirements", requirements))
  for module in modules {
    checkModule(checker, module)
  }
  const bodies = clock.taken()
  const shape = checker.shapeMilliseconds
  checker.timings.add(Timing("bodies", bodies - shape))
  checker.timings.add(Timing("program shape and constant folding", shape))
  checker
}

/**
 * The wall time of one pass. It only reads the clock where the flag asked for it, so the measurement never costs a
 * native call in an ordinary run.
 */
public type Stopwatch {
  isOn: Bool
  var last: Int64 = 0

  fn start(var self) {
    if isOn {
      last = Clock.milliseconds()
    }
  }

  fn taken(var self): Int64 {
    if !isOn {
      return 0
    }
    const now = Clock.milliseconds()
    const spent = now - last
    last = now
    spent
  }
}


/**
 * Every declaration of one module, and every expression inside of its bodies. The top level of a file is one body:
 * an entry file, a script and a `tests/*.test.trb` file are ordinary code, and the locals of one statement are in
 * scope in the next.
 */
public fn checkModule(var checker: Checker, module: ModuleId) {
  // `project.trb` and a configuration file are bodies, not modules: they are checked against their receiver (4.7)
  if checker.program.graph.at(module).receiver.isSome() {
    if const Some(receiver) = scriptReceiverOf(checker, module) {
      checkReceiverScript(checker, module, receiver)
    }
    return
  }
  const statements = checker.program.graph.at(module).file.statements
  const void = checker.voidType
  const saved = checker.enterBody(module, void, true, None)
  checker.openScope()
  // The sites of the top level are known already, so nothing is collected here
  for statement in statements {
    checkTopLevel(checker, TypeScope(module), statement)
  }
  // The top level of a file is one body, so its changes are settled like any other's (design 5.3)
  settleChanges(checker)
  checker.closeScope()
  checker.leaveBody(saved)
  // Visibility and the shape of the declarations (4.9), last: folding a top-level `const` reads what its names meant
  const withTimings = checker.withTimings
  var clock = Stopwatch(withTimings)
  clock.start()
  checkShape(checker, module)
  const spent = clock.taken()
  checker.shapeMilliseconds = checker.shapeMilliseconds + spent
  reportUnchecked(checker, module)
}

/**
 * `Deferred` meant "a later sub-milestone decides" while the checker was being built. There is no later one: every
 * construct of the language is checked now, and the only way an expression can still be without a type is a construct a
 * message was already given about - a parse error, a name that does not resolve, a call that could not be resolved.
 *
 * So a module that has an unchecked expression and **no message at all** is a hole in the checker, and it says so
 * instead of leaving the number in `--statistics` for somebody to notice. One message per module: the first span.
 */
fn reportUnchecked(var checker: Checker, module: ModuleId) {
  if !checker.diagnostics[module.value].isEmpty() {
    return
  }
  const unchecked = checker.uncheckedSpanOf(module)
  if const Some(at) = unchecked {
    checker.report(
      module,
      Diagnostic.error("The checker did not work out the type of this expression", at)
        .withNote("This is a bug of the compiler, not of this file. Please report it with the line it points at")
    )
  }
}

/** How much of a module the checker already understands, for `torb check --statistics`. */
public fn statisticsOf(checker: Checker, module: ModuleId): Statistics {
  checker.statisticsOf(module)
}

/**
 * A statement at the top level of a module. Top-level code is only allowed in entry files and scripts, which is
 * milestone 4.9's rule; here every one of them is checked, because a script is an ordinary body.
 */
fn checkTopLevel(var checker: Checker, scope: TypeScope, statement: Statement) {
  match statement.kind {
    .Declare(declaration) => checkDeclaration(checker, scope, declaration)
    .Bind(binding) => checkTopLevelBinding(checker, scope, binding)
    _ => {
      const _ = checkStatement(checker, statement)
    }
  }
}

/** A top-level `const` of a module is a declaration: asking for its type is what checks its initializer. */
fn checkTopLevelBinding(var checker: Checker, scope: TypeScope, binding: Binding) {
  if const .Binding(_) = binding.pattern.kind {
    if const Some(symbol) = checker.resolvedName(scope.module, binding.pattern.span) {
      const _ = resultOf(checker, symbol)
      return
    }
  }
  var annotation: TypeId? = None
  if const Some(reference) = binding.annotation {
    annotation = Some(typeFromReference(checker, reference, scope.forType()))
  }
  const _ = checkInitializer(checker, scope.module, binding.value, scope.selfType, annotation)
}

/** One declaration, wherever it stands: at the top level of a file, in a block, or in the body of a type. */
public fn checkDeclaration(var checker: Checker, scope: TypeScope, declaration: Declaration) {
  match declaration.kind {
    .Function(function) => {
      match checker.resolvedName(scope.module, function.name.span) {
        Some(symbol) => checkBodyOf(checker, symbol)
        // A declaration without a name is a parse error that was reported; its body still has type positions
        .None => checkUnnamedBody(checker, scope, function)
      }
      checkDefaults(checker, scope, function)
    }
    .Type(typeDeclaration) => {
      checkTypeBody(checker, scope, typeDeclaration.name.span, typeDeclaration.members)
    }
    .Trait(traitDeclaration) => {
      checkTypeBody(checker, scope, traitDeclaration.name.span, traitDeclaration.members)
    }
    .Alias(alias) => {
      if const Some(symbol) = checker.resolvedName(scope.module, alias.name.span) {
        const _ = aliasTargetOf(checker, symbol)
        const generics = genericsOf(checker, symbol)
        const _ = boundsOf(checker, generics, alias.generics, [], scope)
        return
      }
      const _ = typeFromReference(checker, alias.target, scope.forType())
    }
    .Extend(extension) => checkExtension(checker, scope, extension)
    // The functions of a `foreign` block are functions of the module, so they have signatures like any other
    .Foreign(library) => {
      for member in library.members {
        if const .Function(function) = member.kind {
          if const Some(symbol) = checker.resolvedName(scope.module, function.name.span) {
            const _ = signatureOf(checker, symbol)
          }
        }
      }
    }
    .Constant(binding) => checkTopLevelBinding(checker, scope, binding)
    .Use(_) => {}
  }
}

/**
 * A `type` or a `trait`: its own signature covers the parameters, the traits, the fields and the cases, and every
 * member gets its own. The members are built here and not with the shape of the type, so that asking what a type
 * looks like never drags in the signature of everything it calls.
 */
fn checkTypeBody(var checker: Checker, scope: TypeScope, at: Span, members: List<Member>) {
  const symbol = match checker.resolvedName(scope.module, at) {
    Some(found) => found
    // A declaration without a name is a parse error that was reported; its members still have type positions
    .None => {
      checkMembers(checker, scope, [:], members)
      return
    }
  }
  const identifier = typeSignatureOf(checker, symbol)
  const shape = checker.typeSignature(identifier)
  const inner = scope.copy(selfType: Some(shape.own))
  checkMembers(checker, inner, shape.members, members)
}

fn checkMembers(var checker: Checker, scope: TypeScope, known: Map<String, SymbolId>, members: List<Member>) {
  for member in members {
    match member.kind {
      .Field(field) => {
        const annotation = typeFromReference(checker, field.annotation, scope.forType())
        checkDefault(checker, scope, field.default, Some(annotation))
      }
      // The annotation of a `const` member is its signature; a `const` that got no id keeps the ordinary way
      .Constant(binding) => {
        match constantMember(known, binding) {
          Some(symbol) => {
            const _ = resultOf(checker, symbol)
          }
          .None => checkTopLevelBinding(checker, scope, binding)
        }
      }
      .Function(function) => {
        match known.get(function.name.text) {
          Some(symbol) => checkBodyOf(checker, symbol)
          .None => checkUnnamedBody(checker, scope, function)
        }
        checkDefaults(checker, scope, function)
      }
      .Case(caseDeclaration) => {
        for field in caseDeclaration.fields {
          const annotation = typeFromReference(checker, field.annotation, scope.forType())
          checkDefault(checker, scope, field.default, Some(annotation))
        }
      }
    }
  }
}

/** The id a `const` of a body got. A pattern that is not a name there is a parse error that was reported. */
fn constantMember(known: Map<String, SymbolId>, binding: Binding): SymbolId? {
  if const .Binding(name) = binding.pattern.kind {
    return known.get(name)
  }
  None
}

/**
 * An `extend` is one or more implementations, and `buildImplementations` built them - including the ids of its
 * members, which must not be handed out twice. So the target and the members are read back out of the index, and only
 * the bodies are checked here.
 */
fn checkExtension(var checker: Checker, scope: TypeScope, extension: ExtendDeclaration) {
  const implementation = match extensionAt(checker, scope.module, extension.target.span) {
    Some(found) => found
    // A target that did not build a type produced no implementation; its members still have type positions
    .None => {
      const generics = declareParameters(checker, scope.module, None, extension.generics)
      const target = typeFromReference(checker, extension.target, scope.forType())
      const inner = scope.copy(selfType: Some(target))
      const _ = boundsOf(checker, generics, extension.generics, extension.whereClauses, inner)
      const _ = traitList(checker, extension.traits, target, inner)
      checkMembers(checker, inner, [:], extension.members)
      return
    }
  }
  const inner = scope.copy(selfType: Some(implementation.target))
  const members = implementation.members
  checkMembers(checker, inner, members, extension.members)
}

/**
 * A default is evaluated at every call and at every construction, in the scope of the declaration - without `self`
 * and without the other parameters or fields (gap 26).
 */
fn checkDefaults(var checker: Checker, scope: TypeScope, function: FunctionDeclaration) {
  for parameter in function.parameters {
    if parameter.default.isNone() {
      continue
    }
    // The type of the parameter is the one its signature built: a `lazy` one records the type inside of it
    var annotation: TypeId? = None
    if const Some(reference) = parameter.annotation {
      const known = checker.typePositions[scope.module.value]
      annotation = known.get(reference.span)
    }
    checkDefault(checker, scope, parameter.default, annotation)
  }
}

fn checkDefault(var checker: Checker, scope: TypeScope, default: Expression?, annotation: TypeId?) {
  if const Some(expression) = default {
    const _ = checkInitializer(checker, scope.module, expression, scope.selfType, annotation)
  }
}

/**
 * A `fn` whose name did not parse, so it has no symbol and no signature. Its types are still built and its body is
 * still walked - nothing in it is checked, because without a signature its parameters have no types and every name in
 * it would look unknown.
 */
fn checkUnnamedBody(var checker: Checker, scope: TypeScope, function: FunctionDeclaration) {
  for parameter in function.parameters {
    if const Some(reference) = parameter.annotation {
      const _ = typeFromReference(checker, reference, scope.forType())
    }
  }
  if const Some(returnType) = function.returnType {
    const _ = typeFromReference(checker, returnType, scope.forType())
  }
  if const Some(body) = function.body {
    declareSites(checker, scope.module, body.statements)
    deferBlock(checker, body)
  }
}
