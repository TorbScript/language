/**
 * What `a.b` and `Type.b` mean: [lookupMember] and [lookupStaticMember], in this order, for a receiver of type `T`
 * and a name `n`:
 *
 * 1. the fields of `T`
 * 2. the constants and methods of its body
 * 3. the members an `extend T` of the package that declares `T` adds - those are part of the type everywhere
 * 4. the members an `extend T` of another package adds, in every file that imports the module it is written in
 * 5. the members of the traits `T` implements, their defaults and their supertraits
 * 6. the generated members: `copy`, and the members of a derived implementation
 *
 * Steps 3 and 4 are the `extend` visibility rule of the concept, and two visible extensions that bring the same member
 * for the same type are an ambiguity error *at the use*, unless one is more specific than the other - which is why the
 * lookup collects candidates instead of stopping at the first hit.
 */

use Span from "../../syntax/source"
use staticKeyword from "../../syntax/token"
use Diagnostic from "../../syntax/diagnostic"
use ModuleId from "../module"
use SymbolId from "../symbols"
use TypeId, FunctionForm, ParameterForm, ParameterMode, ParameterId from "./type"
use FieldSignature, CaseSignature, TypeSignature, Signature, SignatureId from "./type"
use Checker, Resolution, Dispatch, Adaptation, Candidate, CandidateKind from "./context"
use signatureOf, typeSignatureOf from "./signature"
use substitute, substituteFunction, substituteBounds, sameType, hasVariable from "./unify"
use resolveTrait, resolveBound, traitsOf, traitArgumentsOf, isSupertraitOfBound from "./implementation"
use requiresTraitName, isNamedHere from "./implementation"
use inherentExtensionsOf, extensionMemberOf, mappingOfImplementation, buildImplementations from "./implementation"
use importPathOf, hasParameter, isConcrete, targetShapeOf from "./implementation"
use requireVisibleMember from "./declaration"

/**
 * `type Meters with (Add, Subtract, Compare) by value`: a *required* member of a delegated implementation is forwarded to
 * the field, with `Self` in the parameters unwrapped and `Self` in the result wrapped again. A default member comes from
 * the trait and is not forwarded, so only a member without a body records this.
 */
public fn recordDelegation(var checker: Checker, at: Span, candidate: Candidate) {
  const implementation = match candidate.dispatch {
    .Implementation(identifier, _) => checker.implementations.at identifier
    _ => {
      return
    }
  }
  const field = match implementation.delegate {
    Some(name) => name
    None => {
      return
    }
  }
  const member = match candidate.kind {
    .Method(_, symbol) => symbol
    _ => {
      return
    }
  }
  const identifier = signatureOf checker, member
  if checker.signature(identifier).hasBody {
    return
  }
  checker.adapted at, Adaptation.Delegate(field)
}

/**
 * Object safety, checked **per call and not per type**: a trait may always be used as a type, and what cannot be
 * done with a value of one is call a member that needs a second value of the same concrete type (`equals`, `compare`) or
 * a `static` member (`Type.from`). Everything else keeps its meaning, so `List<Show & Hash>` stays a legal type
 * and `items.appended(x)` stays a legal call - the result is a value of the same trait type.
 *
 * The second half holds for **every** receiver, not only a trait-typed one: a `static fn` is reached through the
 * type and through nothing else (CONCEPT.md, "Types, Values and Reflection", names `Point.tryFrom(...)` as the one
 * bridge), so `rectangle.square(5)` - calling a `static fn` on a value instead of on the type - is reported here too.
 *
 * Using the trait as a *namespace* (`List.from(pairs)`) is a different question and goes through the static lookup,
 * which never reaches this.
 */
public fn requireObjectSafe(var checker: Checker, receiver: TypeId, candidate: Candidate, name: String, at: Span) {
  const shown = checker.describe receiver
  if const .Traits(_) = checker.types.form(receiver) {
    if candidate.takesSelfArgument {
      checker.reportHere(
        Diagnostic.error("`{name}` cannot be called on a `{shown}` value", at)
          .withNote("It takes a second `Self`, and two values of a trait type need not have the same type"),
      )
      return
    }
    if !candidate.takesSelf && isMethod(candidate) {
      checker.reportHere(
        Diagnostic.error("`{name}` is `{staticKeyword}`, so it cannot be called on a `{shown}` value", at)
          .withNote("A `{staticKeyword}` member belongs to a concrete type, and a trait value does not name one"),
      )
    }
    return
  }
  if !candidate.takesSelf && isMethod(candidate) {
    checker.reportHere(
      Diagnostic.error("`{name}` is `{staticKeyword}`: call it as `{shown}.{name}(...)`", at)
        .withNote("A `{staticKeyword}` member belongs to the type, and a value of it is not a way to the type"),
    )
  }
}

fn isMethod(candidate: Candidate): Bool {
  match candidate.kind {
    .Method(_, _) => true
    _ => false
  }
}

/** What a member resolves to for the IR lowering, which is the same question with the answer in the other shape. */
public fn resolutionOfCandidate(candidate: Candidate): Resolution {
  match candidate.kind {
    .Field(owner, field) => Resolution.Field owner, field
    .Constant(owner, symbol) => Resolution.Constant symbol, owner
    .Method(_, symbol) => Resolution.Callable symbol, [], candidate.dispatch
    .CaseConstructor(owner, variant) => Resolution.CaseOf owner, variant
    .Construct(owner) => Resolution.Construct owner
    .Copy(owner) => Resolution.CopyOf owner
    .TupleField(owner, index) => Resolution.TupleField owner, index
  }
}

// --- Instance members -----------------------------------------------------------------------------------------------

/**
 * `a.b` where `a` is a value of `receiver`: the whole order of the design, first hit wins. `at` is only there for the
 * one message the lookup itself can give - two visible extensions that bring the same member.
 */
public fn lookupMember(var checker: Checker, receiver: TypeId, name: String, at: Span? = None): Candidate? {
  lookupMemberAt checker, receiver, name, false, at
}

/** `Type.b`: a constant, a `static fn`, a case, or a static member of a trait the type implements. */
public fn lookupStaticMember(var checker: Checker, owner: TypeId, name: String, at: Span? = None): Candidate? {
  lookupMemberAt checker, owner, name, true, at
}

/**
 * Whether this code may *name* the member it found is asked outside of the memoization below, through
 * [requireVisibleMember]: the memoized answer depends on the module, receiver and name, while visibility depends on
 * the declaration the use stands in.
 */
fn lookupMemberAt(var checker: Checker, receiver: TypeId, name: String, isStatic: Bool, at: Span?): Candidate? {
  const found = findMember checker, receiver, name, isStatic, at
  if const Some(candidate) = found {
    requireVisibleMember checker, candidate, name, at
  }
  found
}

fn findMember(var checker: Checker, receiver: TypeId, name: String, isStatic: Bool, at: Span?): Candidate? {
  if checker.absorbs(receiver) {
    return None
  }
  // A receiver that still holds an unsolved variable is one call's own type and nobody will ever ask about it again, so
  // keeping the answer would only grow the table
  if hasVariable(checker, receiver) {
    return searchMember checker, receiver, name, isStatic, at
  }
  // The answer depends on the module (extensions of a foreign type reach the files that import them), the receiver and
  // the name, and on nothing else - so it is kept. The key is a tuple and not a string: this is the hottest question of
  // the pass, and a text built by interpolating four values into it for every member of every expression would cost
  // seconds over the whole repository
  const key = (checker.module.value, receiver.value, isStatic, name)
  if checker.memberMissing.containsKey(key) {
    return None
  }
  if const Some(known) = checker.memberAnswers.get(key) {
    return known
  }
  const generation = checker.answerGeneration
  const found = searchMember checker, receiver, name, isStatic, at
  // An implementation was generated while the search ran, so this answer was worked out against a world that has
  // changed since: it is given, and it is not kept
  if checker.answerGeneration != generation {
    return found
  }
  match found {
    Some(candidate) => checker.memberAnswers.set key, candidate
    None => checker.memberMissing.set key, true
  }
  found
}

fn searchMember(var checker: Checker, receiver: TypeId, name: String, isStatic: Bool, at: Span?): Candidate? {
  // A tuple has no nominal head, so it has its positions and its labels and nothing else
  if const .Tuple(fields) = checker.types.form(receiver) {
    if isStatic {
      return None
    }
    var index = 0
    for field in fields {
      if field.label == name || name == "{index}" {
        return Candidate CandidateKind.TupleField(receiver, index), field.annotation
      }
      index = index + 1
    }
    return None
  }
  // A literal type has the generated members - `tryFrom`, `show`, `equals`, `hash`, `encode`, `decode` - plus the members
  // of its base (design 4.1). The generated ones come first, because `Status.tryFrom` is the one of the literal type and
  // not the one of `String` or of `Int64`, and its `Self` is the literal type (concept, Literal Types)
  if const .Literals(base, _) = checker.types.form(receiver) {
    if const Some(found) = traitMember(checker, receiver, name, isStatic) {
      return found
    }
    return lookupMemberAt checker, base, name, isStatic, at
  }
  if const .Nominal(symbol, arguments) = checker.types.form(receiver) {
    if const Some(found) = nominalMember(checker, receiver, symbol, arguments, name, isStatic) {
      if isStatic {
        return withTraitOverloads checker, receiver, name, found
      }
      return found
    }
  }
  if const Some(found) = extensionMember(checker, receiver, name, isStatic, at) {
    return found
  }
  if const Some(found) = traitMember(checker, receiver, name, isStatic) {
    return found
  }
  // `a.hash()` before anything asked for `Hash`: a generated implementation is made on first use, and naming its member
  // is a use - so the member is there whenever `==`, a key or an interpolation would find the trait
  if const Some(found) = derivedMember(checker, receiver, name, isStatic) {
    return found
  }
  // `Trait.member`: the members of an implementation whose target is the trait itself, like `List.from`
  if isStatic {
    if const .Traits(_) = checker.types.form(receiver) {
      return lookupTraitNamespace checker, receiver, name
    }
  }
  None
}

fn nominalMember(
  var checker: Checker,
  receiver: TypeId,
  symbol: SymbolId,
  arguments: List<TypeId>,
  name: String,
  isStatic: Bool,
): Candidate? {
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  const mapping = argumentMapping shape.generics, arguments
  const own = shape.generics.length()
  if !isStatic {
    for field in shape.fields {
      if field.name == name {
        const annotation = substitute checker.types, field.annotation, mapping
        return Candidate CandidateKind.Field(receiver, field.symbol), annotation
      }
    }
  }
  if isStatic {
    for variant in shape.cases {
      if variant.name == name {
        return caseCandidate checker, receiver, variant, mapping
      }
    }
  }
  if const Some(member) = shape.members.get(name) {
    return memberCandidate checker, receiver, member, mapping, own, isStatic, Dispatch.Direct
  }
  // `copy` is generated for every `type`, with the shape of the constructor and every field optional
  if !isStatic && name == "copy" && shape.cases.isEmpty() && !shape.isShared {
    const form = constructorForm checker, receiver, shape, mapping, allOptional: true
    return Candidate CandidateKind.Copy(receiver), checker.functionType(form), form: form
  }
  None
}

/**
 * `extend Int64 { ... }`, `extend<Item> List<Item> where Item: Shape { ... }`: a member without a trait. Two visible
 * extensions that bring the same member are an ambiguity, and the fix is to rename one with `as`.
 */
fn extensionMember(var checker: Checker, receiver: TypeId, name: String, isStatic: Bool, at: Span?): Candidate? {
  const extensions = inherentExtensionsOf checker, receiver
  var best = -1
  var bestMember: SymbolId? = None
  var second: ModuleId? = None
  for index in extensions {
    const member = match extensionMemberOf(checker, index, receiver, name) {
      Some(symbol) => symbol
      None => {
        continue
      }
    }
    const module = checker.implementations.all[index].module
    if best >= 0 {
      // The more specific of two extensions is the answer and no ambiguity: see `isMoreSpecificExtension`
      if isMoreSpecificExtension(checker, index, best) {
        best = index
        bestMember = member
        second = None
      } else if !isMoreSpecificExtension(checker, best, index) && checker.implementations.all[best].module != module {
        second = module
      }
      continue
    }
    best = index
    bestMember = member
  }
  const member = bestMember?
  const module = checker.implementations.all[best].module
  if const Some(other) = second {
    if const Some(span) = at {
      reportAmbiguousExtension checker, name, module, other, span
    }
  }
  const mapping = mappingOfImplementation checker, best, receiver
  const own = mapping.length()
  memberCandidate(checker, receiver, member, mapping, own, isStatic, Dispatch.Direct).copy(module: module)
}

/**
 * Whether one `extend` that brings a member is more specific than another that brings the same name: an extension of
 * the receiver's own type beats one of a trait it implements, and an extension of a trait beats one of a trait that
 * every value of the first one has - a supertrait, or a trait implemented for it. So
 * `extend<Item> Iterate<Item> { fn parallel() }` is what every iterable gets, and an `extend<Item> List<Item>` or an
 * `extend<Item, Piece> Cut<Item, Piece>` beside it is what a list or a collection that cuts itself gets instead - the
 * rule `ownOfTwo` states for two implementations of one trait.
 */
fn isMoreSpecificExtension(var checker: Checker, candidate: Int, other: Int): Bool {
  const candidateTarget = checker.implementations.all[candidate].target
  const otherTarget = checker.implementations.all[other].target
  match (targetShapeOf(checker, candidateTarget), targetShapeOf(checker, otherTarget)) {
    (.Concrete(_), .Bounded(_)) => true
    (.Bounded(_), .Bounded(base)) => impliesTrait checker, candidateTarget, base
    _ => false
  }
}

/** Whether every value of a trait type has another trait too: a supertrait of it, or one implemented for it. */
fn impliesTrait(var checker: Checker, target: TypeId, capability: SymbolId): Bool {
  for bound in traitsOf(checker, target) {
    if const .Nominal(symbol, _) = checker.types.form(bound) {
      if symbol == capability {
        return true
      }
    }
  }
  false
}

fn reportAmbiguousExtension(var checker: Checker, name: String, first: ModuleId, second: ModuleId, at: Span) {
  const one = importPathOf checker, first
  const other = importPathOf checker, second
  checker.reportHere(
    Diagnostic.error("`{name}` comes from `{one}` and from `{other}`", at)
      .withNote("A member is renamed where it is imported: `use ... as another from \"{other}\"`"),
  )
}

/**
 * The members of the traits the receiver implements: the requirements, the defaults and the supertraits.
 *
 * `Int64` implements `From<Int32>`, `From<UInt8>`, `From<UInt16>`, `From<UInt32>` and `From<Char>`, so `Int.from` is
 * one name with five signatures. That is the one place where the language has an overload set, and what it means is
 * decided by the argument at the call site, so the member becomes "needs its arguments" here.
 */
fn traitMember(var checker: Checker, receiver: TypeId, name: String, isStatic: Bool): Candidate? {
  const found = traitMembers checker, receiver, name, isStatic
  const first = match found.first() {
    Some(inner) => inner
    None => {
      return None
    }
  }
  if found.length() == 1 {
    return first
  }
  // `Int.from` is one name with five signatures, because `Int64` implements `From<Int32>`, `From<UInt8>` and three
  // more: the argument decides which one is meant, and the call site picks (design 4.3)
  first.copy needsArguments: true, overloads: found
}

/**
 * The member of a trait the language generates, where the type gets that trait generated: `equals`, `hash`, `show`,
 * `encode`, `static decode` and `static describe`. Asking whether the type implements the trait is what generates it, and then the
 * trait's members are the type's like those of a trait it names in its `with` list.
 */
fn derivedMember(var checker: Checker, receiver: TypeId, name: String, isStatic: Bool): Candidate? {
  const traitName = derivedTraitOf(name, isStatic)?
  const capability = checker.wellKnown.symbolNamed(traitName)?
  if !resolveTrait(checker, receiver, capability).isFound() {
    return None
  }
  traitMember checker, receiver, name, isStatic
}

fn derivedTraitOf(name: String, isStatic: Bool): String? {
  if isStatic {
    return match name {
      "decode" => "Decode"
      "describe" => "Describe"
      _ => None
    }
  }
  match name {
    "equals" => "Equals"
    "hash" => "Hash"
    "show" => "Show"
    "encode" => "Encode"
    _ => None
  }
}

/**
 * **A `static fn` the type writes itself is one candidate of the set and not the whole answer.** `String` declares
 * `static fn from(value: Iterate<Char>)` in its own body, as part of `with From<Iterate<Char>>`, and rule 2 of the
 * lookup finds it and stops - so `String.from(path)` picked that one implementation and reported that a `Path` is not
 * an `Iterate<Char>`, while the same conversion through a bound (`where String: From<Value>`) resolved. The two
 * lists are merged here, at the lookup, and the call site decides between them like any other overload set.
 *
 * Only for a `static` member. An instance member is the hottest question of the pass and has no such form: what a
 * type writes in its body is what `a.b` means, and a trait's member of the same name is its default.
 */
fn withTraitOverloads(var checker: Checker, receiver: TypeId, name: String, own: Candidate): Candidate {
  var merged = [own.copy(preferred: true)]
  for candidate in traitMembers(checker, receiver, name, true) {
    var isKnown = false
    for known in merged {
      // The same **declaration**, not only the same shape: `with From<Iterate<Char>>` on the type puts one `static
      // fn from` in its body, and the lookup finds that one symbol twice - once directly and once through the trait
      if known.annotation == candidate.annotation || declarationOf(known) == declarationOf(candidate) {
        isKnown = true
      }
    }
    if !isKnown {
      merged.append candidate
    }
  }
  if merged.length() == 1 {
    return own
  }
  own.copy needsArguments: true, overloads: merged
}

/** Which declaration a candidate is, where it is one: `-1` for the generated members, which have no symbol. */
fn declarationOf(candidate: Candidate): Int {
  match candidate.kind {
    .Method(_, symbol) => symbol.value
    .Constant(_, symbol) => symbol.value
    _ => -1
  }
}

/**
 * The candidates one name has among the traits of a type, one per distinct signature, in the order they were found.
 *
 * Two traits of one receiver that declare one name are an overload set only where neither is the other's supertrait
 * (`From<Int8>` beside `From<Char>`). Where one is - `List.sorted` answering `Self` over `Iterate.sorted` answering a
 * lazy stage - the subtrait's declaration **overrides** the one it inherits, and the inherited one is not a second
 * candidate. `traitsOf` lists a bound before its supertraits, so the overriding one is always the one already found.
 */
fn traitMembers(var checker: Checker, receiver: TypeId, name: String, isStatic: Bool): List<Candidate> {
  const bounds = traitsOf checker, receiver
  var found: List<Candidate> = []
  var through: List<TypeId> = []
  for bound in bounds {
    const candidate = match memberOfTrait(checker, receiver, bound, name, isStatic) {
      Some(inner) => inner
      None => {
        continue
      }
    }
    var isKnown = false
    for known in found {
      if known.annotation == candidate.annotation {
        isKnown = true
      }
    }
    for earlier in through {
      if isSupertraitOfBound(checker, earlier, bound, receiver) {
        isKnown = true
      }
    }
    if !isKnown {
      found.append candidate
      through.append bound
    }
  }
  found
}

/**
 * One member, reached through **one applied bound** and not through the whole overload set: what an operator needs
 * once the type carries its trait more than once (`Board with Multiply<Scale, Board>` next to `Multiply<Board, Board>`)
 * and the expression has decided which one is meant.
 */
public fn boundMember(var checker: Checker, receiver: TypeId, bound: TypeId, name: String): Candidate? {
  memberOfTrait checker, receiver, bound, name, false
}

/** [dispatchOf] for a bound that is already applied: which of the three ways the chosen implementation is reached. */
public fn dispatchOfBound(var checker: Checker, receiver: TypeId, capability: SymbolId, bound: TypeId): Dispatch {
  dispatchOf checker, receiver, capability, bound
}

fn memberOfTrait(var checker: Checker, receiver: TypeId, bound: TypeId, name: String, isStatic: Bool): Candidate? {
  const (symbol, arguments) = match checker.types.form(bound) {
    .Nominal(found, given) => (found, given)
    _ => {
      return None
    }
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  const member = shape.members.get(name)?
  // What the package of a *trait* puts on a type it does not own is visible where the trait is a name of the file
  if !isNamedHere(checker, symbol) {
    if requiresTraitName(checker, receiver, bound) {
      return None
    }
  }
  var mapping = argumentMapping shape.generics, arguments
  // Inside a trait `Self` is its own parameter; here it stands for the type the member was reached through
  if const .Parameter(parameter) = checker.types.form(shape.own) {
    mapping.set parameter, receiver
  }
  const own = shape.generics.length()
  const dispatch = dispatchOf checker, receiver, symbol, bound
  // `Self` of the trait is what makes `equals(self, other: Self)` meaningless on a trait-typed value
  memberCandidate checker, receiver, member, mapping, own, isStatic, dispatch, shape.own
}

/**
 * Which of the three ways to a trait member it is: through a known implementation, through the witness table of a
 * trait-typed value, or forwarded by the caller of a generic function. The back ends never decide this.
 */
fn dispatchOf(var checker: Checker, receiver: TypeId, capability: SymbolId, bound: TypeId): Dispatch {
  if const .Parameter(parameter) = checker.types.form(receiver) {
    return Dispatch.Forwarded parameter, bound, []
  }
  if const .Traits(_) = checker.types.form(receiver) {
    return Dispatch.Object bound, []
  }
  /*
   * A concrete receiver and a bound that names a generic parameter: `String.from value` under `where String:
   * From<Value>`. Which implementation runs is decided by what `Value` turns out to be, so no implementation is named
   * here - naming one would pick `String`'s `From<Iterate<Char>>` for every instance. The bound goes on, and the back
   * end resolves it under the arguments of the instance it lowers.
   */
  if isConcrete(checker, receiver) && hasParameter(checker, bound) {
    return Dispatch.Object bound, []
  }
  match resolveTrait(checker, receiver, capability) {
    .Found(implementation, _) => Dispatch.Implementation implementation, []
    .Bounded(_) => Dispatch.Object bound, []
    /*
     * A type may implement one trait **several times** - `extend Int64 with From<Int8>`, `From<Char>` and three more -
     * and then the trait *symbol* names no implementation and `resolveTrait` answers `Ambiguous`. The applied **bound**
     * does name one, and it is in hand here: every candidate of the overload set `traitMember` builds carries its own
     * (`From<Char>`), so asking `resolveBound` is what tells `Int.from('A')` which implementation it reaches. Without it
     * the call was `Direct` with the *trait's* requirement as its member, which has no body anywhere - and a back end
     * then has nothing to call.
     *
     * This is also why every conversion a type has is a **direct** implementation of it and never one a supertrait
     * requires: `Int64` implements `TryFrom<String, NumberParseError>` itself, although `Numeric` already asks for it,
     * because otherwise `TryFrom` would have exactly one direct implementation on `Int64` and the symbol alone would
     * answer that one for both calls (docs/BACKEND.md, "One conversion, one implementation").
     */
    _ => {
      if const .Found(implementation, _) = resolveBound(checker, receiver, bound) {
        return Dispatch.Implementation implementation, []
      }
      Dispatch.Direct
    }
  }
}

/**
 * How an *operator* reaches its member. A member that the type writes in its own body is an ordinary member and is
 * reached directly - but `a + b` is `Add.add` whatever the type looks like, so the implementation is what an operator
 * records, and the back end knows what to monomorphize.
 */
public fn traitDispatchOf(var checker: Checker, receiver: TypeId, capability: SymbolId): Dispatch {
  const arguments = traitArgumentsOf(checker, receiver, capability) ?? []
  const bound = checker.nominal capability, arguments
  dispatchOf checker, receiver, capability, bound
}

/** The signature of a member, with the parameters of its owner filled in: `Holder<Int>.item` is an `Int`. */
fn memberCandidate(
  var checker: Checker,
  receiver: TypeId,
  member: SymbolId,
  mapping: Map<ParameterId, TypeId>,
  own: Int,
  isStatic: Bool,
  dispatch: Dispatch,
  selfParameter: TypeId? = None,
): Candidate {
  const identifier = signatureOf checker, member
  const signature = checker.signature identifier
  const form = if mapping.isEmpty() {
    signature.form
  } else {
    substituteFunction checker.types, signature.form, mapping
  }
  // The parameters of the owner are filled in; the ones the member declares itself are what a call site solves
  var generics: List<ParameterId> = []
  for index in own..signature.generics.length() {
    generics.append signature.generics[index]
  }
  const bounds = if mapping.isEmpty() {
    signature.bounds
  } else {
    substituteBounds checker.types, signature.bounds, mapping
  }
  const takesSelfArgument = mentionsSelf signature.form, selfParameter
  if signature.takesSelf {
    // `Point.area` is the member itself, `p.area` is the member bound to `p`: the same one, read two ways
    if isStatic {
      const value = withReceiver checker, receiver, form, signature.isVarSelf
      const annotation = checker.functionType value
      return Candidate(
        CandidateKind.Method(receiver, member),
        annotation,
        form: value,
        takesSelf: true,
        isVarSelf: signature.isVarSelf,
        generics: generics,
        bounds: bounds,
        takesSelfArgument: takesSelfArgument,
        dispatch: dispatch,
      )
    }
    const annotation = functionTypeOf checker, identifier, form, mapping
    return Candidate(
      CandidateKind.Method(receiver, member),
      annotation,
      form: form,
      takesSelf: true,
      isVarSelf: signature.isVarSelf,
      generics: generics,
      bounds: bounds,
      takesSelfArgument: takesSelfArgument,
      dispatch: dispatch,
    )
  }
  // A `static` member is a constant of the type: a `static fn`, or a `static` value - with a value, or the requirement
  // of a trait (`static zero: Self`), which has none and is read the same way
  if form.parameters.isEmpty() && isConstantMember(checker, member) {
    // `const perimeter: (self: Rectangle) => Int`: a method *is* a constant that holds a receiver closure, so one that
    // was written that way is read exactly like a `fn` - `Rectangle.perimeter` is it, `rectangle.perimeter` is it bound
    if const Some(held) = receiverFormOf(checker, form.result) {
      const value = if isStatic { held } else { FunctionForm held.parameters.skip(1).toList(), held.result }
      return Candidate(
        CandidateKind.Constant(receiver, member),
        checker.functionType(value),
        form: value,
        takesSelf: true,
        isVarSelf: isVarReceiver(held.parameters[0].mode),
        generics: generics,
        bounds: bounds,
        dispatch: dispatch,
      )
    }
    return Candidate(
      CandidateKind.Constant(receiver, member),
      form.result,
      generics: generics,
      bounds: bounds,
      dispatch: dispatch,
    )
  }
  const annotation = functionTypeOf checker, identifier, form, mapping
  Candidate(
    CandidateKind.Method(receiver, member),
    annotation,
    form: form,
    generics: generics,
    bounds: bounds,
    takesSelfArgument: takesSelfArgument,
    dispatch: dispatch,
  )
}

/**
 * Whether a parameter of the member *is* `Self`. Such a member needs two values of the same type, which a trait-typed
 * value cannot promise, and that is what [requireObjectSafe] rejects.
 */
fn mentionsSelf(form: FunctionForm, selfParameter: TypeId?): Bool {
  const own = match selfParameter {
    Some(found) => found
    None => {
      return false
    }
  }
  for parameter in form.parameters {
    if parameter.annotation == own {
      return true
    }
  }
  false
}

/** Interning a function type builds a key out of every parameter, so the answer for a whole signature is kept. */
fn functionTypeOf(
  var checker: Checker,
  identifier: SignatureId,
  form: FunctionForm,
  mapping: Map<ParameterId, TypeId>,
): TypeId {
  if !mapping.isEmpty() {
    return checker.functionType form
  }
  if const Some(known) = checker.signatureTypes.get(identifier.value) {
    return known
  }
  const built = checker.functionType form
  checker.signatureTypes.set identifier.value, built
  built
}

/** The function type a `static` value holds, whose first parameter is a receiver: that is what a method is. */
fn receiverFormOf(checker: Checker, annotation: TypeId): FunctionForm? {
  if const .Function(form) = checker.types.form(annotation) {
    if const Some(first) = form.parameters.first() {
      if const .Receiver(_) = first.mode {
        return form
      }
    }
  }
  None
}

fn isVarReceiver(mode: ParameterMode): Bool {
  match mode {
    .Receiver(isVar) => isVar
    _ => false
  }
}

/** A `static` value has no parameters and no receiver, which is exactly what `Signature` says about it. */
fn isConstantMember(checker: Checker, member: SymbolId): Bool {
  match checker.symbolAt(member).kind {
    .Constant => true
    _ => false
  }
}

fn caseCandidate(
  var checker: Checker,
  owner: TypeId,
  variant: CaseSignature,
  mapping: Map<ParameterId, TypeId>,
): Candidate {
  const identifier = signatureOf checker, variant.symbol
  const signature = checker.signature identifier
  const form = substituteFunction checker.types, signature.form, mapping
  // A case without fields is the value itself, not a function of no arguments
  if form.parameters.isEmpty() {
    return Candidate CandidateKind.CaseConstructor(owner, variant.symbol), owner, form: None
  }
  Candidate CandidateKind.CaseConstructor(owner, variant.symbol), checker.functionType(form), form: form
}

/** `Point.area` is `(self: Point) => Int`, `p.area` is `() => Int`: the same member, read through a type or a value. */
fn withReceiver(var checker: Checker, receiver: TypeId, form: FunctionForm, isVarSelf: Bool): FunctionForm {
  var parameters = [ParameterForm("self", ParameterMode.Receiver(isVarSelf), receiver)]
  parameters.appendAll form.parameters
  FunctionForm parameters, form.result
}

// --- The generated constructor --------------------------------------------------------------------------------------

/** `Point(10, 20)` and `p.copy(y: 30)`: the fields in declaration order, `copy` with every one of them optional. */
public fn constructorOf(var checker: Checker, owner: TypeId): FunctionForm? {
  const (symbol, arguments) = match checker.types.form(owner) {
    .Nominal(found, given) => (found, given)
    _ => {
      return None
    }
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  // A type with cases is constructed through them, never directly
  if !shape.cases.isEmpty() {
    return None
  }
  const mapping = argumentMapping shape.generics, arguments
  constructorForm checker, owner, shape, mapping, allOptional: false
}

fn constructorForm(
  var checker: Checker,
  owner: TypeId,
  shape: TypeSignature,
  mapping: Map<ParameterId, TypeId>,
  allOptional: Bool,
): FunctionForm {
  var parameters: List<ParameterForm> = []
  for field in shape.fields {
    const annotation = substitute checker.types, field.annotation, mapping
    const hasDefault = allOptional || field.hasDefault
    parameters.append ParameterForm(field.name, ParameterMode.Value, annotation, hasDefault)
  }
  FunctionForm parameters, owner
}

/** The fields of a `type` or of one of its cases, with the arguments of the receiver filled in. */
public fn fieldsOf(var checker: Checker, owner: TypeId): List<FieldSignature> {
  match checker.types.form(owner) {
    .Nominal(symbol, arguments) => {
      const identifier = typeSignatureOf checker, symbol
      const shape = checker.typeSignature identifier
      const mapping = argumentMapping shape.generics, arguments
      var found: List<FieldSignature> = []
      for field in shape.fields {
        found.append field.copy(annotation: substitute(checker.types, field.annotation, mapping))
      }
      found
    }
    _ => []
  }
}

/** The case of `owner` that is written `name`, with its fields. */
public fn caseNamed(var checker: Checker, owner: TypeId, name: String): CaseSignature? {
  match checker.types.form(owner) {
    .Nominal(symbol, arguments) => {
      const identifier = typeSignatureOf checker, symbol
      const shape = checker.typeSignature identifier
      const mapping = argumentMapping shape.generics, arguments
      for variant in shape.cases {
        if variant.name == name {
          var fields: List<FieldSignature> = []
          for field in variant.fields {
            fields.append field.copy(annotation: substitute(checker.types, field.annotation, mapping))
          }
          return variant.copy fields: fields
        }
      }
      None
    }
    _ => None
  }
}

/** The generic parameters of a declaration, bound to the type arguments of a use of it, position by position. */
public fn argumentMapping(generics: List<ParameterId>, arguments: List<TypeId>): Map<ParameterId, TypeId> {
  var mapping: Map<ParameterId, TypeId> = [:]
  for index in 0..generics.length().min(arguments.length()) {
    mapping.set generics[index], arguments[index]
  }
  mapping
}

// --- What a type comes with -----------------------------------------------------------------------------------------

/** Whether a type has cases. They always belong to its declaration - an `extend` can add none. */
public fn hasCases(var checker: Checker, of: TypeId): Bool {
  match checker.types.form(of) {
    .Nominal(symbol, _) => {
      const identifier = typeSignatureOf checker, symbol
      !checker.typeSignature(identifier).cases.isEmpty()
    }
    _ => false
  }
}

/** The names of the cases of a type, in declaration order. What a "did you mean" note about a pattern offers. */
public fn caseNamesOf(var checker: Checker, of: TypeId): List<String> {
  if const .Nominal(symbol, _) = checker.types.form(of) {
    const identifier = typeSignatureOf checker, symbol
    return checker.typeSignature(identifier).cases.map({ _.name }).toList()
  }
  []
}

/** The name a nominal type was declared under, which is what `Point(x, y)` as a pattern has to match. */
public fn typeNameOf(checker: Checker, of: TypeId): String? {
  if const .Nominal(symbol, _) = checker.types.form(of) {
    return checker.symbolAt(symbol).name
  }
  None
}

/**
 * The names a "did you mean" note may offer: everything the lookup above would have found - the body of the type,
 * every visible extension of it, and every trait it implements.
 */
public fn memberNames(var checker: Checker, of: TypeId): List<String> {
  var names: List<String> = []
  if const .Nominal(symbol, _) = checker.types.form(of) {
    const identifier = typeSignatureOf checker, symbol
    const shape = checker.typeSignature identifier
    for field in shape.fields {
      names.append field.name
    }
    for (name, _) in shape.members {
      names.append name
    }
  }
  const extensions = inherentExtensionsOf checker, of
  for index in extensions {
    const members = checker.implementations.all[index].members
    for (name, _) in members {
      // A foreign extension only offers what this file named, so nothing unreachable is suggested
      if extensionMemberOf(checker, index, of, name).isSome() {
        names.append name
      }
    }
  }
  const bounds = traitsOf checker, of
  for bound in bounds {
    if const .Nominal(symbol, _) = checker.types.form(bound) {
      const isVisible = isNamedHere(checker, symbol) || !requiresTraitName(checker, of, bound)
      if isVisible {
        const identifier = typeSignatureOf checker, symbol
        for (name, _) in checker.typeSignature(identifier).members {
          names.append name
        }
      }
    }
  }
  names
}

/** `Trait.member`: the members of an implementation whose target is the trait itself, like `List.from`. */
public fn lookupTraitNamespace(var checker: Checker, owner: TypeId, name: String): Candidate? {
  buildImplementations checker
  var candidates = checker.implementations.open
  candidates.appendAll checker.implementations.inherentOpen
  for index in candidates {
    const implementation = checker.implementations.all[index]
    const member = match implementation.members.get(name) {
      Some(found) => found
      None => {
        continue
      }
    }
    const mapping = mappingOfImplementation checker, index, owner
    const target = checker.implementations.all[index].target
    const applied = substitute checker.types, target, mapping
    if !sameType(checker.types, applied, owner) {
      continue
    }
    return memberCandidate checker, owner, member, mapping, mapping.length(), true, Dispatch.Direct
  }
  None
}
