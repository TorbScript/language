/**
 * [checkExpression] and [inferExpression]: the type of every expression, and what every name in it means. Literals
 * with their adaptation, locals, calls, constructors, field and static member access, `if`, `match` and blocks as
 * expressions, the operators, and everything that reads a closure or a generic parameter.
 *
 * A construct nothing here can resolve becomes `Deferred` - a type that absorbs every further message exactly as
 * `Invalid` does, but that `torb check --statistics` counts apart, because it is reachable only from a construct a
 * message was already given about.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Expression, Argument, CallStyle, TextSegment, Condition, Block, Statement from "../../syntax/ast"
use MatchArm, PrefixOperator, InfixOperator, Closure, TypeReference from "../../syntax/ast"
use SymbolId from "../symbols"
use TypeId, TypeForm, TupleField, LiteralValue, FunctionForm, ParameterForm, ParameterMode, Witness from "./type"
use Checker, Expectation, Resolution, Adaptation, Dispatch, CollectionLiteral, TypeScope from "./context"
use Target, deferredTarget, resolveName, symbolTarget, targetOfCandidate from "./name"
use formOf, reportUnknownMember, isFullyKnown from "./name"
use lookupMember, lookupStaticMember, recordDelegation, traitDispatchOf, requireObjectSafe from "./member"
use boundMember, dispatchOfBound from "./member"
use traitArgumentsOf, witnessFor, isConcrete, implementsBound, iterableSourceOf from "./implementation"
use fallibleFailuresOf, appliedTraitsOf, appliedArgumentsOf, fitsType from "./implementation"
use typeFromReference, integerLiteral from "./lowering"
use typeSignatureOf from "./signature"
use sameType, unify, resolveType, resolveTypes, hasVariable, openVariableOf, suppressVariables from "./unify"
use checkCall, instantiateTarget, checkBounds, withInstantiation from "./call"
use checkClosure from "./closure"
use isQuotation, isQuotationValue, checkQuotation, openThunk, closeThunk from "./quote"
use checkBlock, checkDiscarded, scopeHere, taskValueOf from "./statement"
use checkSubject from "./place"
use markReferenceBindings from "./mutation"
use checkPattern, requireReadBindings from "./pattern"
use MatchArmPlan, armPlanOf, checkExhaustive, checkConditionPattern from "./exhaustive"
use checkDeclaration from "./check"

/** The type of an expression in a position that expects one. Every expression that is looked at is recorded. */
public fn checkExpression(var checker: Checker, expression: Expression, expected: Expectation): TypeId {
  // `Expression<Value>` does not take a value, it takes the expression that was written (design 4.8). One hook covers
  // every position the type can stand in: an argument, a binding, a field default - and a quotation that is already one
  // (`filter(isAdult)`) is passed on as the ordinary value it is
  if const Some(wanted) = expected.annotationOf() {
    if isQuotation(checker, wanted) {
      if !isQuotationValue(checker, expression) {
        return checkQuotation checker, expression, wanted
      }
      // Nothing was quoted here, so what the caller said about the quoting parameter is not about anything
      checker.quotingOwner = ""
      checker.quotingParameter = ""
    }
  }
  const found = evaluateExpression checker, expression, expected
  // A block, an `if` and a `match` handed the expectation down to their parts, which said everything there is to say
  if const Some(annotation) = expected.annotationOf() {
    if !isNested(expression) {
      const _ = checkValue checker, found, annotation, expression.span
    }
  }
  // A value that goes nowhere is a mistake with value semantics, whether it stands as a statement or as the
  // body of an arm of a `match` that is used as one
  if expected.isStatement() {
    if !isNested(expression) {
      checkDiscarded checker, expression, found
    }
  }
  checker.typed expression.span, found
}

/** The type of an expression that nothing says anything about. */
public fn inferExpression(var checker: Checker, expression: Expression): TypeId {
  checkExpression checker, expression, Expectation.None
}

/**
 * Whether an expression hands what is expected of it to its parts. A block, an `if` and a `match` do, so a message
 * about one of their arms must not be given a second time about the whole.
 */
public fn isNested(expression: Expression): Bool {
  match expression.kind {
    .Block(_) | .If(_, _, _) | .Match(_, _) => true
    _ => false
  }
}

fn evaluateExpression(var checker: Checker, expression: Expression, expected: Expectation): TypeId {
  const annotation = expected.annotationOf()
  match expression.kind {
    .IntegerLiteral(text) => integerLiteralType checker, text, false, annotation, expression.span
    .FloatLiteral(_) => floatLiteralType checker, annotation, expression.span
    .BoolLiteral(value) => {
      const base = checker.booleanType()
      adaptedLiteral checker, LiteralValue.Boolean(value), base, annotation, expression.span
    }
    // `void` has one value and therefore no literal type to adapt to: it is always `Void`
    .VoidLiteral => checker.voidType
    .CharLiteral(value) => {
      const base = checker.charType()
      adaptedLiteral checker, LiteralValue.Character(value), base, annotation, expression.span
    }
    .TextLiteral(segments) => textLiteralType checker, segments, annotation, expression.span
    .Name(_) | .Member(_, _, _) => {
      const target = resolveTarget checker, expression, annotation
      checker.resolved expression.span, target.resolution
      valueOfTarget checker, target, expression.span
    }
    // `.Circle(1.0)`, `.None`: the case of the type that is expected here
    .ImplicitMember(name) => implicitMemberType checker, name.text, annotation, expression.span
    // `value.into()` is chosen by the expected type, so it is the one call the callee alone cannot answer
    .Call(callee, arguments, style) if isConversionCall(checker, callee, arguments, annotation) =>
      conversionType checker, expression, callee, arguments, style, expected
    // `value.tryInto()` is the same, with the target and the failure read out of the expected `Result`
    .Call(callee, arguments, style) if isFallibleConversionCall(checker, callee, arguments) =>
      fallibleConversionType checker, expression, callee, arguments, style, expected
    .Call(callee, arguments, style) => checkCall checker, expression, callee, arguments, style, expected
    .Index(target, index) => indexType checker, target, index, expression.span
    .TupleLiteral(items) => tupleLiteralType checker, items, annotation
    .ListLiteral(items) => listLiteralType checker, items, annotation, expression.span
    .MapLiteral(entries) => mapLiteralType checker, entries, annotation, expression.span
    .RangeLiteral(start, end, _) => rangeLiteralType checker, start, end
    // `-300` is one literal, not a negation of `300`: only then can the range of the type it adapts to be checked
    .Unary(.Negate, operand) if isNumberLiteral(operand) => negatedLiteral checker, operand, annotation, expression.span
    .Unary(operator, operand) => unaryType checker, operator, operand, expression.span, annotation
    .Binary(operator, left, right) => binaryType checker, operator, left, right, expression.span, annotation
    .If(condition, then, otherwise) => ifType checker, condition, then, otherwise, expected
    .Match(subject, arms) => matchType checker, subject, arms, expected
    .Block(block) => checkBlock(checker, block, expected).annotation
    // `to<Set<Int>>()`, `Map<String, Int>()`: the explicit type arguments fill the callee's parameters from the left
    .Generic(_, _) => {
      const target = resolveTarget checker, expression, annotation
      checker.resolved expression.span, target.resolution
      valueOfTarget checker, target, expression.span
    }
    .Closure(closure) => checkClosure checker, closure, expression.span, annotation
    .Try(inner) => tryType checker, inner, expression.span, expected
    .Invalid => checker.invalidType
  }
}

// --- Names, members and places they lead to -------------------------------------------------------------------------

/**
 * A name or a member path, read as a value or as the callee of a call. One function for both, because `p.area` and
 * `p.area()` ask the very same question and only do different things with the answer.
 */
public fn resolveTarget(
  var checker: Checker,
  expression: Expression,
  expected: TypeId?,
  explicit: List<TypeId> = [],
): Target {
  match expression.kind {
    .Name(text) => resolveName checker, text, expression.span, expected, explicit
    .Member(target, name, isOptional) => memberTarget checker, target, name.text, name.span, isOptional, explicit
    .ImplicitMember(name) => implicitMemberTarget checker, name.text, expected, expression.span
    // `List<Int>.of(1)`, `value.to<Set<Int>>()`: which parameters the type arguments fill is only known now
    .Generic(inner, references) => {
      const scope = scopeHere checker
      var given: List<TypeId> = []
      for reference in references {
        given.add typeFromReference(checker, reference, scope.forEither())
      }
      const found = resolveTarget checker, inner, expected, given
      const _ = checker.typed inner.span, found.annotation
      found
    }
    _ => {
      const annotation = inferExpression checker, expression
      // `text.trim().replace(a, b)`, `items[0].name`: the inner node resolved itself while it was checked, so its
      // answer is read back instead of being overwritten with `.Deferred` by whoever asked about the part in front
      // of the dot.
      const known = checker.resolutionHere(expression.span) ?? Resolution.Deferred
      Target known, annotation, form: formOf(checker, annotation)
    }
  }
}

/**
 * A target that is read as a value instead of being called. A generic one is instantiated here exactly as a call would,
 * so `numbers.map` without `()` has a known function type and the bounds of the member are checked either way.
 */
public fn valueOfTarget(var checker: Checker, target: Target, at: Span): TypeId {
  if target.generics.isEmpty() {
    return target.annotation
  }
  const form = match target.form {
    Some(found) => found
    None => {
      return target.annotation
    }
  }
  const instantiation = instantiateTarget checker, target, form, at
  const witnesses = checkBounds checker, instantiation.bounds, target.name, at
  const solved = resolveTypes checker, instantiation.arguments
  if !solved.isEmpty() {
    checker.recordTypeArguments at, solved
  }
  if !witnesses.isEmpty() {
    checker.recordWitnesses at, witnesses
  }
  const resolution = withInstantiation target.resolution, solved, witnesses
  checker.resolved at, resolution
  checker.functionType instantiation.form
}

/** `a.b`, `Type.b`, `namespace.b`: which one it is depends on what the part in front of the dot turned out to be. */
fn memberTarget(
  var checker: Checker,
  base: Expression,
  text: String,
  at: Span,
  isOptional: Bool,
  explicit: List<TypeId>,
): Target {
  const owner = resolveTarget checker, base, None
  checker.resolved base.span, owner.resolution
  const _ = checker.typed base.span, owner.annotation
  // `a?.m` is `Option.map`, or `flatMap` when `m` gives back an `Option` itself: it never nests one
  if isOptional {
    return optionalTarget checker, owner.annotation, text, at
  }
  // `namespace.b` from `use * as text from "./text"`: a top-level declaration of that module
  if const .Namespace(target) = owner.resolution {
    match checker.program.scopes[target.value].exported.get(text) {
      Some(symbol) => {
        return symbolTarget checker, symbol, text, at, None, explicit
      }
      None => {
        checker.reportHere(
          Diagnostic.error("`{text}` is not exported by the module `{owner.name}`", at)
        )
        return Target Resolution.Deferred, checker.invalidType, name: text
      }
    }
  }
  // `Point.origin`, `Shape.Circle`, `Email.tryFrom`: a constant, a static function or a case of the type
  if const Some(own) = owner.constructs {
    match lookupStaticMember(checker, own, text, Some(at)) {
      Some(candidate) => {
        const found = targetOfCandidate checker, candidate, text
        return found.copy arguments: explicit
      }
      None => {
        // `Vector2.zero` where `zero` lives in `extend Vector2<Float>`: a bare type name has nothing else to go on, so
        // what the declaration says its parameters are by default is what the name means
        if const Some(defaulted) = withDeclaredDefaults(checker, own) {
          if const Some(candidate) = lookupStaticMember(checker, defaulted, text, Some(at)) {
            const _ = unify checker, own, defaulted
            const found = targetOfCandidate checker, candidate, text
            return found.copy arguments: explicit
          }
        }
        const _ = reportUnknownMember checker, own, text, at, isTypeName: true
        return Target Resolution.Deferred, checker.deferredType, name: text
      }
    }
  }
  const receiver = owner.annotation
  match lookupMember(checker, receiver, text, Some(at)) {
    Some(candidate) => {
      recordDelegation checker, at, candidate
      requireObjectSafe checker, receiver, candidate, text, at
      const found = targetOfCandidate checker, candidate, text
      found.copy arguments: explicit
    }
    None => {
      if reportUnknownMember(checker, receiver, text, at) {
        return Target Resolution.Deferred, checker.invalidType, name: text
      }
      Target Resolution.Deferred, checker.deferredType, name: text
    }
  }
}

/**
 * `first()?.position()`: the member is looked up on the `Value` of the `Option`, and what comes out is an `Option`
 * again - `map` when the member gives back an ordinary value, `flatMap` when it gives back an `Option`, so that `?.`
 * never produces a nested one. It is not defined on a `Result`.
 */
fn optionalTarget(var checker: Checker, receiver: TypeId, text: String, at: Span): Target {
  const inner = match optionValueOf(checker, receiver) {
    Some(found) => found
    None => {
      if isFullyKnown(checker, receiver) && !isOption(checker, receiver) {
        const shown = checker.describe receiver
        checker.reportHere(
          Diagnostic.error("`?.` needs an `Option`, and `{shown}` is not one", at)
            .withNote("`a?.m` is `Option.map`. On a `Result` it has no meaning: take the `Option` first (`ok()`)")
        )
        return Target Resolution.Deferred, checker.invalidType, name: text
      }
      return deferredTarget checker
    }
  }
  const candidate = match lookupMember(checker, inner, text, Some(at)) {
    Some(found) => found
    None => {
      if reportUnknownMember(checker, inner, text, at) {
        return Target Resolution.Deferred, checker.invalidType, name: text
      }
      return Target Resolution.Deferred, checker.deferredType, name: text
    }
  }
  const target = targetOfCandidate checker, candidate, text
  if checker.absorbs(target.annotation) {
    return target
  }
  match target.form {
    Some(form) => {
      // `flatMap` where the member answers an `Option` already, `map` where it does not. The wrapping is inside the
      // function type, so this flag is the only thing that still says which of the two it was, for the lowering of `?.`
      checker.recordFlattenedOptional at, isOption(checker, form.result)
      const wrapped = optionalOf checker, form.result
      const inner = FunctionForm form.parameters, wrapped
      target.copy annotation: checker.functionType(inner), form: Some(inner)
    }
    // A field or a constant behind `?.`: the value itself becomes optional
    None => {
      checker.recordFlattenedOptional at, isOption(checker, target.annotation)
      target.copy annotation: optionalOf(checker, target.annotation)
    }
  }
}

/** `Option<Value>` around a type, unless it is an `Option` already: `?.` never nests one. */
fn optionalOf(var checker: Checker, annotation: TypeId): TypeId {
  if isOption(checker, annotation) {
    return annotation
  }
  match checker.wellKnown.option {
    Some(option) => checker.nominal option, [annotation]
    None => checker.deferredType
  }
}

fn isOption(checker: Checker, annotation: TypeId): Bool {
  if const .Nominal(symbol, arguments) = checker.types.form(annotation) {
    return checker.wellKnown.option == Some(symbol) && arguments.length() == 1
  }
  false
}

/** The `Value` of an `Option<Value>`. */
public fn optionValueOf(checker: Checker, annotation: TypeId): TypeId? {
  if const .Nominal(symbol, arguments) = checker.types.form(annotation) {
    if checker.wellKnown.option == Some(symbol) && arguments.length() == 1 {
      return Some arguments[0]
    }
  }
  None
}

/** The `Value` of a `Result<Value, Failure>`, and its `Failure`. */
public fn resultPartsOf(checker: Checker, annotation: TypeId): (TypeId, TypeId)? {
  if const .Nominal(symbol, arguments) = checker.types.form(annotation) {
    if checker.wellKnown.result == Some(symbol) && arguments.length() == 2 {
      return Some((arguments[0], arguments[1]))
    }
  }
  None
}

/** `.Circle(1.0)`, `.None`: the case of the type that is expected here. */
fn implicitMemberType(var checker: Checker, text: String, expected: TypeId?, at: Span): TypeId {
  const target = implicitMemberTarget checker, text, expected, at
  checker.resolved at, target.resolution
  valueOfTarget checker, target, at
}

/**
 * The expected type is what says which type the case belongs to, so `.Circle` without one is an error - the design's
 * "`.Circle` needs a type. Nothing here says which one". A type that still holds an unsolved variable says nothing:
 * the message about that one is "cannot infer", and one root cause gets one message.
 */
fn implicitMemberTarget(var checker: Checker, text: String, expected: TypeId?, at: Span): Target {
  const annotation = match expected {
    Some(found) => resolveType checker, found
    None => {
      reportCaseWithoutType checker, text, at
      return Target Resolution.Deferred, checker.invalidType, name: text
    }
  }
  if checker.absorbs(annotation) {
    return deferredTarget checker
  }
  // A type that is *nothing but* an open variable names no type at all, and nothing before the `?` ever will: only
  // `matchedFailure` (4.4) decides such a failure type, and it runs after the argument has been read. So the short form
  // is reported here instead of being left unchecked - `Result<Int, Failure>` is a different matter, because the case's
  // owner is `Result` whatever the failure turns out to be
  if openVariableOf(checker, annotation).isSome() {
    reportCaseBeforeTry checker, text, at
    return Target Resolution.Deferred, checker.invalidType, name: text
  }
  if hasVariable(checker, annotation) {
    return deferredTarget checker
  }
  match lookupStaticMember(checker, annotation, text) {
    Some(candidate) => targetOfCandidate checker, candidate, text
    None => {
      const owner = checker.describe annotation
      if isFullyKnown(checker, annotation) {
        checker.reportHere Diagnostic.error("`{owner}` has no case `{text}`", at)
        return Target Resolution.Deferred, checker.invalidType, name: text
      }
      deferredTarget checker
    }
  }
}

/**
 * A type name whose generic arguments the call site did not write, with the **declared defaults** put in where the
 * checker's own variables stand: `type Vector2<Scalar: Numeric = Float>` makes the bare `Vector2` mean
 * `Vector2<Float>`, which is what reaches the members of `extend Vector2<Float>`.
 *
 * `None` where there is nothing to fill in or where one parameter has no default: then the name really says nothing
 * about its arguments, and the message about the member is the right one.
 */
fn withDeclaredDefaults(var checker: Checker, own: TypeId): TypeId? {
  const (symbol, arguments) = match checker.types.form(own) {
    .Nominal(found, given) => (found, given)
    _ => {
      return None
    }
  }
  if arguments.isEmpty() {
    return None
  }
  const shape = checker.typeSignature typeSignatureOf(checker, symbol)
  if shape.generics.length() != arguments.length() {
    return None
  }
  var filled: List<TypeId> = []
  var isChanged = false
  for index in 0..arguments.length() {
    const argument = arguments[index]
    if openVariableOf(checker, argument).isNone() {
      filled.add argument
      continue
    }
    const declaration = checker.types.parameter shape.generics[index]
    const written = match declaration.default {
      Some(found) => found
      None => {
        return None
      }
    }
    const annotation = typeFromReference checker, written, TypeScope(declaration.module).forType()
    if checker.absorbs(annotation) {
      return None
    }
    filled.add annotation
    isChanged = true
  }
  if !isChanged {
    return None
  }
  Some checker.types.intern(TypeForm.Nominal(symbol, filled))
}

fn reportCaseWithoutType(var checker: Checker, text: String, at: Span) {
  checker.reportHere(
    Diagnostic.error("`.{text}` needs a type, and nothing here says which one", at)
      .withNote("Write it out: `Shape.{text}(...)`, or annotate what the value goes into")
  )
}

/**
 * `settings.get("port").okOr(.Missing("port"))?`: the failure type of the subject is open here, and only the `?` around
 * it would say what it is - which happens after this argument has been read. The short form has nothing to take its type
 * from, so it is an error and not an inference the checker could make later.
 */
fn reportCaseBeforeTry(var checker: Checker, text: String, at: Span) {
  checker.reportHere(
    Diagnostic.error("`.{text}` needs its type here: nothing expects one before the `?`", at)
      .withNote("Write it out: `ConfigError.{text}(...)`. The `?` only decides the failure type once the argument"
        + " has been read")
  )
}

/** `a[key]` is `Indexed.at`, `a[from..to]` is `Slice.slice`: both are looked up as implementations of those traits. */
fn indexType(var checker: Checker, target: Expression, index: Expression, at: Span): TypeId {
  const receiver = inferExpression checker, target
  const key = inferExpression checker, index
  if checker.absorbs(receiver) {
    return checker.deferredType
  }
  // A range makes it a slice, which gives back a value of the same type
  if isRange(checker, key) {
    const slice = match checker.wellKnown.slice {
      Some(found) => found
      None => {
        return checker.deferredType
      }
    }
    if traitArgumentsOf(checker, receiver, slice).isSome() {
      // `Slice.slice` takes `Bounds<Int>` and not one of the three range types, so the value in the brackets becomes
      // a trait value here - which is what records the witness the back ends call `lowest`/`highest` through
      coerceToBounds checker, key, index.span
      recordTraitCall checker, at, receiver, slice, "slice"
      return receiver
    }
    reportMissingOperator checker, receiver, "Slice", "a[from..to]", at
    return checker.deferredType
  }
  const indexed = match checker.wellKnown.indexed {
    Some(found) => found
    None => {
      return checker.deferredType
    }
  }
  match traitArgumentsOf(checker, receiver, indexed) {
    Some(arguments) => {
      if arguments.length() != 2 {
        return checker.deferredType
      }
      const _ = checkValue checker, key, arguments[0], index.span
      requireIndexInBounds checker, receiver, index
      recordTraitCall checker, at, receiver, indexed, "at"
      arguments[1]
    }
    None => {
      reportMissingOperator checker, receiver, "Indexed", "a[key]", at
      checker.deferredType
    }
  }
}

/**
 * `identity[4]` on an `Array<Float, 4>`: the size is part of the type and the index was written as a literal, so this is
 * the one bounds check the checker can make - and `std/collections/src/array.trb` documents it as a compile error.
 * Everything else (a `List`, a computed index, a const parameter as the size) is the runtime's.
 */
fn requireIndexInBounds(var checker: Checker, receiver: TypeId, index: Expression) {
  const (symbol, arguments) = match checker.types.form(receiver) {
    .Nominal(found, given) => (found, given)
    _ => {
      return
    }
  }
  if checker.wellKnown.array != Some(symbol) || arguments.length() != 2 {
    return
  }
  const size = match checker.types.form(arguments[1]) {
    .Constant(.Integer(value), _) => value
    _ => {
      return
    }
  }
  const written = match index.kind {
    .IntegerLiteral(text) => text
    _ => {
      return
    }
  }
  const at = match integerLiteral(written, false) {
    Some(.Integer(value)) => value
    _ => {
      return
    }
  }
  if at >= 0 && at < size {
    return
  }
  const shown = checker.describe receiver
  checker.reportHere(
    Diagnostic.error("`{written}` is out of bounds: an `{shown}` has {size} items", index.span)
      .withNote("The size of an `Array` is part of its type, so an index that is written out is checked here")
  )
}

/**
 * Which implementation and which member an operator, an index or an interpolation reached. The lowering reads this
 * instead of looking a trait up again: the choice between monomorphizing and passing a table is made here.
 */
fn recordTraitCall(
  var checker: Checker,
  at: Span,
  receiver: TypeId,
  capability: SymbolId,
  name: String,
  bound: TypeId? = None,
) {
  // Where the type carries the trait more than once, the **applied** bound is what was chosen, and the member and the
  // implementation both have to come from it: `lookupMember` would answer the first of the overload set
  const chosen = match bound {
    Some(applied) => boundMember checker, receiver, applied, name
    None => None
  }
  const found = if chosen.isSome() { chosen } else { lookupMember checker, receiver, name }
  const candidate = match found {
    Some(inner) => inner
    None => {
      return
    }
  }
  const dispatch = match bound {
    Some(applied) => dispatchOfBound checker, receiver, capability, applied
    None => traitDispatchOf checker, receiver, capability
  }
  if const .Method(_, symbol) = candidate.kind {
    checker.resolved at, Resolution.Callable(symbol, [], dispatch)
    recordDelegation checker, at, candidate.copy(dispatch: dispatch)
  }
}

/**
 * `Meters * Meters` and `"a"[0..2]`: the type does not come with the trait the operator needs.
 *
 * An operand whose type is a **generic parameter** gets the message the catalogue gives an unmet bound, because the fix
 * is a bound and not another type: `fn total<Value>(a: Value, b: Value) { a + b }` needs `where Value: Add`, and
 * `a == b` on such a parameter needs `Value: Equals` the same way.
 */
fn reportMissingOperator(var checker: Checker, receiver: TypeId, capability: String, written: String, at: Span) {
  if const .Parameter(_) = checker.types.form(receiver) {
    const name = checker.describe receiver
    checker.reportHere(
      Diagnostic.error("`{name}` is not `{capability}`, so `{written}` has no meaning for it", at)
        .withNote("Add the bound to the declaration: `where {name}: {capability}`")
    )
    return
  }
  if !isFullyKnown(checker, receiver) {
    return
  }
  const shown = checker.describe receiver
  checker.reportHere(
    Diagnostic.error("`{shown}` does not implement `{capability}`, so `{written}` has no meaning for it", at)
      .withNote("Operators are traits: a type has the ones it comes `with`, and nothing else")
  )
}

/**
 * `items[1..3]`, `text[2..]`: the range becomes a `Bounds<Int>` where it is written, because that is what
 * `Slice.slice` declares. A range of something other than `Int` is reported here, at the brackets.
 */
fn coerceToBounds(var checker: Checker, key: TypeId, at: Span) {
  const bounds = match checker.wellKnown.bounds {
    Some(found) => found
    None => {
      return
    }
  }
  const applied = checker.nominal bounds, [checker.integerType()]
  const wanted = checker.types.intern TypeForm.Traits([applied])
  const _ = checkValue checker, key, wanted, at
}

/** Whether the value in the brackets is one of the three ranges, which is what makes `a[...]` a slice. */
public fn isRange(checker: Checker, annotation: TypeId): Bool {
  if const .Nominal(symbol, _) = checker.types.form(annotation) {
    const found = Some symbol
    return checker.wellKnown.range == found
      || checker.wellKnown.rangeFrom == found
      || checker.wellKnown.rangeTo == found
  }
  false
}

// --- Literals -------------------------------------------------------------------------------------------------------

/** `-3` and `-1.5`: the sign belongs to the literal, so the value that is checked against a range is the real one. */
fn isNumberLiteral(operand: Expression): Bool {
  match operand.kind {
    .IntegerLiteral(_) | .FloatLiteral(_) => true
    _ => false
  }
}

fn negatedLiteral(var checker: Checker, operand: Expression, expected: TypeId?, at: Span): TypeId {
  const found = match operand.kind {
    .IntegerLiteral(text) => integerLiteralType checker, text, true, expected, at
    _ => floatLiteralType checker, expected, at
  }
  checker.typed operand.span, found
}

/**
 * An integer literal checks against every integer and floating point type, against a literal type that contains it,
 * and is `Int64` without an expectation. A literal that does not fit the type it adapts to is an error.
 */
fn integerLiteralType(var checker: Checker, text: String, isNegative: Bool, expected: TypeId?, at: Span): TypeId {
  const value = match integerLiteral(text, isNegative) {
    Some(.Integer(found)) => found
    _ => {
      return reportUnparsedInteger checker, text, at
    }
  }
  const fallback = checker.integerType()
  const annotation = match expected {
    Some(found) => found
    None => {
      return adapt checker, at, fallback
    }
  }
  if const Some(name) = numericNameOf(checker, annotation) {
    if !fitsInto(value, name) {
      checker.reportHere Diagnostic.error("`{describeInteger(text, value)}` does not fit into `{name}`", at)
      return checker.invalidType
    }
    return adapt checker, at, annotation
  }
  if isLiteralTypeOf(checker, annotation, LiteralValue.Integer(value)) {
    return adapt checker, at, annotation
  }
  // `0` and `1` adapt to a `Scalar: Numeric` inside a generic body, and the **parameter** is what the literal becomes
  if boundImplies(checker, annotation, "Numeric") {
    return adapt checker, at, annotation
  }
  adapt checker, at, fallback
}

/**
 * Whether a **type parameter**'s bounds imply a trait, by name: what makes a numeric literal adapt to the parameter
 * itself. CONCEPT ("No `default` keyword and no `Default` trait") says the neutral element of an algorithm over a
 * `Scalar: Numeric` is the **literal**, so `0` and `1` have to mean the parameter and not `Int64` - the back end
 * reported *"the function returns `Float64` and `return` carries `Int64`"* for every instance that was not `Int64`.
 *
 * The bounds are read from the declaration and its supertraits, not through `traitsOf`: this runs at every literal of
 * every program, and the closure of "every trait a type has" derives implementations on first use.
 */
fn boundImplies(var checker: Checker, annotation: TypeId, capability: String): Bool {
  const parameter = match checker.types.form(annotation) {
    .Parameter(found) => found
    _ => {
      return false
    }
  }
  // A `const` parameter is a value and not a type: `<const Size: Int>` has `Int` in its bounds, and a literal that
  // stands where `Size` is expected is an ordinary `Int64`
  if checker.types.parameter(parameter).isConst {
    return false
  }
  const wanted = match checker.wellKnown.symbolNamed(capability) {
    Some(found) => found
    None => {
      return false
    }
  }
  for bound in checker.parameterBounds.get(parameter.value) ?? [] {
    if traitImplies(checker, bound, wanted, 0) {
      return true
    }
  }
  false
}

/** Whether an applied bound is a trait, or has it as a supertrait: `Real` implies `Signed` implies `Numeric`. */
fn traitImplies(var checker: Checker, bound: TypeId, capability: SymbolId, depth: Int): Bool {
  if depth > 8 {
    return false
  }
  const symbol = match checker.types.form(bound) {
    .Nominal(found, _) => found
    _ => {
      return false
    }
  }
  if symbol == capability {
    return true
  }
  const shape = checker.typeSignature typeSignatureOf(checker, symbol)
  for supertrait in shape.traits {
    if traitImplies(checker, supertrait.capability, capability, depth + 1) {
      return true
    }
  }
  false
}

/** The text as it was written, unless it was written in another base - then the value says more. */
fn describeInteger(text: String, value: Int): String {
  if text.startsWith("0x") || text.startsWith("0b") {
    return "{text}"
  }
  "{value}"
}

/** A literal that does not parse at all is out of the range of every integer type there is. */
fn reportUnparsedInteger(var checker: Checker, text: String, at: Span): TypeId {
  checker.reportHere Diagnostic.error("`{text}` does not fit into any integer type", at)
  checker.invalidType
}

fn floatLiteralType(var checker: Checker, expected: TypeId?, at: Span): TypeId {
  const fallback = checker.floatType()
  if const Some(annotation) = expected {
    if const Some(name) = numericNameOf(checker, annotation) {
      if name == "Float32" || name == "Float64" || name == "Decimal" {
        return adapt checker, at, annotation
      }
    }
    // A decimal literal needs more of its parameter than an integer one: `Numeric` has no fractions
    if boundImplies(checker, annotation, "Real") {
      return adapt checker, at, annotation
    }
  }
  adapt checker, at, fallback
}

/** A text literal is a `String`; only a literal type of the matching base makes it something else. */
fn textLiteralType(var checker: Checker, segments: List<TextSegment>, expected: TypeId?, at: Span): TypeId {
  var isPlain = true
  var text = ""
  for segment in segments {
    match segment {
      .Literal(part) => {
        text = text + part
      }
      // Every interpolated part is rendered through `Show.show`, and the witness says which implementation runs
      .Interpolated(inner) => {
        isPlain = false
        const found = inferExpression checker, inner
        recordShow checker, found, inner.span
      }
    }
  }
  const fallback = checker.stringType()
  if isPlain {
    if const Some(annotation) = expected {
      if isLiteralTypeOf(checker, annotation, LiteralValue.Text(text)) {
        return adapt checker, at, annotation
      }
    }
  }
  adapt checker, at, fallback
}

/**
 * `"{value}"` is `Show.show` on that part, and the part has to have one. 4.3 recorded the witness and said nothing
 * where it found none, because the standard library had no `Show` for its collections; `std/collections` has it for
 * `List`, `Set` and `Map` now, so the message is the ordinary unmet bound.
 */
fn recordShow(var checker: Checker, found: TypeId, at: Span) {
  if checker.absorbs(found) {
    return
  }
  const show = match checker.wellKnown.show {
    Some(symbol) => symbol
    None => {
      return
    }
  }
  const bound = checker.nominal show, []
  const witness = witnessFor checker, found, bound
  if const .Unresolved = witness {
    reportNotShowable checker, found, at
    return
  }
  checker.adapted at, Adaptation.ShowValue(witness)
}

/** A part of an interpolation that has no `Show`. A generic parameter is missing a bound, everything else the trait. */
fn reportNotShowable(var checker: Checker, found: TypeId, at: Span) {
  if const .Parameter(_) = checker.types.form(found) {
    const name = checker.describe found
    checker.reportHere(
      Diagnostic.error("`{name}` is not `Show`, so it cannot be interpolated", at)
        .withNote("Add the bound to the declaration: `where {name}: Show`")
    )
    return
  }
  if !isFullyKnown(checker, found) {
    return
  }
  const shown = checker.describe found
  checker.reportHere(
    Diagnostic.error("`{shown}` does not implement `Show`, so it cannot be interpolated", at)
      .withNote("`with Show` on the declaration derives it for a type all of whose fields are `Show`")
  )
}

/** A `Bool` or a `Char` literal: only a literal type of the matching base makes it anything but its own type. */
fn adaptedLiteral(var checker: Checker, value: LiteralValue, base: TypeId, expected: TypeId?, at: Span): TypeId {
  if const Some(annotation) = expected {
    if isLiteralTypeOf(checker, annotation, value) {
      return adapt checker, at, annotation
    }
  }
  adapt checker, at, base
}

/** Every literal records what it became, because the back ends must not decide what `1` is. */
fn adapt(var checker: Checker, at: Span, annotation: TypeId): TypeId {
  checker.adaptedLiteral at, annotation
  annotation
}

/** Whether a literal type contains this value. A subset is never assignable, so equality of the value set decides. */
fn isLiteralTypeOf(var checker: Checker, annotation: TypeId, value: LiteralValue): Bool {
  if const .Literals(_, values) = checker.types.form(annotation) {
    return values.contains value
  }
  false
}

/** `Int8`, `UInt64`, `Float32`, `Decimal`: which numeric type of the prelude this is, if it is one. */
fn numericNameOf(checker: Checker, annotation: TypeId): String? {
  if const .Nominal(symbol, arguments) = checker.types.form(annotation) {
    if arguments.isEmpty() {
      return checker.wellKnown.numericNamed symbol
    }
  }
  None
}

/** The range of the integer types. `Int64` and `UInt64` are as wide as the checker's own integers, so they fit. */
fn fitsInto(value: Int, name: String): Bool {
  if name == "Int8" {
    return value >= -128 && value <= 127
  }
  if name == "Int16" {
    return value >= -32768 && value <= 32767
  }
  if name == "Int32" {
    return value >= -2147483648 && value <= 2147483647
  }
  if name == "UInt8" {
    return value >= 0 && value <= 255
  }
  if name == "UInt16" {
    return value >= 0 && value <= 65535
  }
  if name == "UInt32" {
    return value >= 0 && value <= 4294967295
  }
  if name == "UInt64" {
    return value >= 0
  }
  true
}

// --- Collection and tuple literals ----------------------------------------------------------------------------------

fn tupleLiteralType(var checker: Checker, items: List<Argument>, expected: TypeId?): TypeId {
  var wanted: List<TupleField> = []
  if const Some(annotation) = expected {
    if const .Tuple(fields) = checker.types.form(annotation) {
      wanted = fields
    }
  }
  var fields: List<TupleField> = []
  for index in 0..items.length() {
    const item = items[index]
    const label = match item.label {
      Some(name) => Some name.text
      None => None
    }
    const inner = if index < wanted.length() {
      Expectation.Type wanted[index].annotation
    } else {
      Expectation.None
    }
    const annotation = checkExpression checker, item.value, inner
    if index < wanted.length() {
      checkLabel checker, label, wanted[index].label, item.value.span
    }
    fields.add TupleField(label, annotation)
  }
  checker.types.intern TypeForm.Tuple(fields)
}

/** A label is not part of the type of a tuple, but one at a position that has a different name is. */
fn checkLabel(var checker: Checker, written: String?, wanted: String?, at: Span) {
  if const Some(label) = written {
    if const Some(other) = wanted {
      if label != other {
        checker.reportHere(
          Diagnostic.error("This position is `{other}`, not `{label}`", at)
            .withNote("A label is a name for a position of a tuple: the positions have to line up")
        )
      }
    }
  }
}

/**
 * `[1, 2, 3]` adapts to what is expected of it, and what it became is recorded at its span:
 *
 * - nothing expected, or the trait `List<Item>`: the default list. The item type comes from the expected type where
 *   there is one - and then every item is *checked* against it, so
 *   `const shapes: List<Shape> = [Square(2.0), Circle(1.0)]` coerces each one. Without an expectation the first
 *   item decides and the rest are checked against it; an empty literal makes a variable, which the statement has to
 *   solve or the message asks for the annotation.
 * - an `Array<Item, Size>`: the items go straight into the inline slots, and how many of them there are is part of the
 *   type.
 * - anything that is `From<Iterable<Item>>` - `ArrayList<Int>`, `Set<String>`, `ArrayQueue<Int>`, a type of your own -
 *   the default list is built and handed to `Target.from`. These are exactly the targets `.to<Target>()` accepts.
 * - anything else: an error. A literal that silently claims to be a type nobody can build from a list is what no back
 *   end can lower.
 */
fn listLiteralType(var checker: Checker, items: List<Argument>, expected: TypeId?, at: Span): TypeId {
  const list = match checker.wellKnown.list {
    Some(found) => found
    None => {
      deferArguments checker, items
      return checker.deferredType
    }
  }
  const wanted = expectedTarget checker, expected
  // The one target that is not built from a list at all: the items are written into the inline slots (5.9b)
  if const Some(found) = arrayTargetOf(checker, wanted) {
    return arrayLiteralType checker, items, found, at
  }
  var item = itemOfCollection checker, wanted, list, 0
  if item.isNone() {
    if const Some(found) = builtTargetOf(checker, wanted) {
      return builtListType checker, items, found, at
    }
    if const Some(annotation) = wrongTargetOf(checker, wanted) {
      reportWrongTarget checker, annotation, "list", "From<Iterable<Item>>", at
      inferArguments checker, items
      return checker.invalidType
    }
    // A trait type the list only *coerces* to still says what it holds: `const numbers: Iterable<Int> = []`
    item = itemOfIterated checker, wanted
  }
  defaultListType checker, items, item, wanted, list, at
}

/** The default list: `ArrayList`, built item by item. This is what a literal is wherever nothing else is asked for. */
fn defaultListType(
  var checker: Checker,
  items: List<Argument>,
  expectedItem: TypeId?,
  expected: TypeId?,
  capability: SymbolId,
  at: Span,
): TypeId {
  var item = expectedItem
  const isWanted = item.isSome()
  if item.isNone() {
    // Without an expectation the first item decides, and the others are checked against it
    if const Some(first) = items.first() {
      if !first.isSpread {
        item = Some inferExpression(checker, first.value)
      }
    }
  }
  if item.isNone() {
    item = Some checker.newVariable("Item", "", at)
  }
  const element = item ?? checker.deferredType
  const inner = expectationOf checker, element
  var index = 0
  for argument in items {
    if argument.isSpread {
      const _ = inferExpression checker, argument.value
      checker.adapted argument.value.span, Adaptation.Spread
    } else if index > 0 || isWanted {
      const _ = checkExpression checker, argument.value, inner
    }
    index = index + 1
  }
  checker.recordCollectionLiteral at, CollectionLiteral.Default
  const bound = checker.nominal capability, [element]
  const built = checker.types.intern TypeForm.Traits([bound])
  // An expectation that is still open has to learn what the literal is, so the type is built out instead of handed back
  if const Some(annotation) = expected {
    if !hasVariable(checker, annotation) {
      requireCoercion checker, built, annotation, at
      return annotation
    }
  }
  built
}

fn mapLiteralType(
  var checker: Checker,
  entries: List<(Expression, Expression)>,
  expected: TypeId?,
  at: Span,
): TypeId {
  const map = match checker.wellKnown.map {
    Some(found) => found
    None => {
      deferEntries checker, entries
      return checker.deferredType
    }
  }
  const wanted = expectedTarget checker, expected
  var key = itemOfCollection checker, wanted, map, 0
  var value = itemOfCollection checker, wanted, map, 1
  if key.isNone() && value.isNone() {
    // A target of its own takes `Iterable<(Key, Value)>`; one that takes single items is not a map target at all
    if const Some(found) = builtTargetOf(checker, wanted) {
      match entryTypesOf(checker, found.item) {
        Some((first, second)) => {
          return builtMapType checker, entries, found, first, second, at
        }
        None => {
          return wrongMapType checker, entries, found.annotation, at
        }
      }
    }
    if const Some(annotation) = wrongTargetOf(checker, wanted) {
      return wrongMapType checker, entries, annotation, at
    }
  }
  defaultMapType checker, entries, key, value, wanted, map, at
}

/** The default map: `TrieMap`, built entry by entry. */
fn defaultMapType(
  var checker: Checker,
  entries: List<(Expression, Expression)>,
  expectedKey: TypeId?,
  expectedValue: TypeId?,
  expected: TypeId?,
  capability: SymbolId,
  at: Span,
): TypeId {
  var key = expectedKey
  var value = expectedValue
  const isWanted = key.isSome() && value.isSome()
  if !isWanted {
    if const Some((first, second)) = entries.first() {
      key = Some inferExpression(checker, first)
      value = Some inferExpression(checker, second)
    }
  }
  if key.isNone() {
    key = Some checker.newVariable("Key", "", at)
  }
  if value.isNone() {
    value = Some checker.newVariable("Value", "", at)
  }
  const unknown = checker.deferredType
  const keyType = key ?? unknown
  const valueType = value ?? unknown
  const keys = expectationOf checker, keyType
  const values = expectationOf checker, valueType
  var index = 0
  for (written, given) in entries {
    if index > 0 || isWanted {
      const _ = checkExpression checker, written, keys
      const _ = checkExpression checker, given, values
    }
    index = index + 1
  }
  checker.recordCollectionLiteral at, CollectionLiteral.Default
  const bound = checker.nominal capability, [keyType, valueType]
  const built = checker.types.intern TypeForm.Traits([bound])
  if const Some(annotation) = expected {
    if !hasVariable(checker, annotation) {
      requireCoercion checker, built, annotation, at
      return annotation
    }
  }
  built
}

// --- What a collection literal becomes ------------------------------------------------------------------------------

/** An expected `Array<Item, Size>`, taken apart: what a literal that fills its inline slots has to match. */
type ExpectedArray {
  annotation: TypeId
  item: TypeId
  /** The const argument: a number where the annotation wrote one, an open variable where the literal solves it. */
  size: TypeId
}

/** An expected type that has to be *built* from a collection, with the `From<Iterable<Item>>` that does it. */
type BuiltTarget {
  annotation: TypeId
  item: TypeId
  witness: Witness
}

/** The expected type with every solution put in. `None` where nothing is expected, or where a message was given. */
fn expectedTarget(var checker: Checker, expected: TypeId?): TypeId? {
  const annotation = expected?
  if checker.absorbs(annotation) {
    return None
  }
  Some resolveType(checker, annotation)
}

/** `const numbers: Array<Int, 4> = [1, 2, 3, 4]`: the one target a literal builds without a collection in between. */
fn arrayTargetOf(var checker: Checker, expected: TypeId?): ExpectedArray? {
  const array = checker.wellKnown.array?
  const annotation = expected?
  if const .Nominal(symbol, arguments) = checker.types.form(annotation) {
    if symbol == array && arguments.length() == 2 {
      return Some ExpectedArray(annotation, arguments[0], arguments[1])
    }
  }
  None
}

/**
 * The `Item` of an expected `List<Item>`, the `Key` or `Value` of an expected `Map<Key, Value>` - whether the expected
 * type *is* the trait (`List<Int>` as a type is `Traits([List<Int>])`) or implements it (`TrieList<Int>`). Both are
 * built directly: a literal builds the collection that is asked for, and finding the fast path for one is the
 * compiler's job (concept, Decision Log), not a trip through `Target.from`.
 */
fn itemOfCollection(var checker: Checker, expected: TypeId?, capability: SymbolId, position: Int): TypeId? {
  const annotation = expected?
  if const Some(arguments) = traitArgumentsOf(checker, annotation, capability) {
    return arguments.get position
  }
  // The expected type may be the trait itself: `List<Int>` as a type is `Traits([List<Int>])`
  if const .Traits(bounds) = checker.types.form(annotation) {
    for bound in bounds {
      if const .Nominal(symbol, arguments) = checker.types.form(bound) {
        if symbol == capability {
          return arguments.get position
        }
      }
    }
  }
  None
}

/**
 * The expected type as a target of its own. The one protocol is `From<Iterable<Item>>` - there is no `Collectable` and
 * no `FromIterator` (concept, Decision Log) - and `Item` is what the target itself iterates, so a literal accepts
 * exactly the targets `.to<Target>()` accepts.
 */
fn builtTargetOf(var checker: Checker, expected: TypeId?): BuiltTarget? {
  const conversion = checker.wellKnown.from?
  const iterable = checker.wellKnown.iterable?
  const annotation = expected?
  if !isConcrete(checker, annotation) {
    return None
  }
  const item = itemOfTarget(checker, annotation, iterable)?
  const applied = checker.nominal iterable, [item]
  const source = checker.types.intern TypeForm.Traits([applied])
  const bound = checker.nominal conversion, [source]
  const witness = witnessFor checker, annotation, bound
  if const .Unresolved = witness {
    return None
  }
  Some BuiltTarget(annotation, item, witness)
}

/** What a target iterates, which is the `Item` its `From<Iterable<Item>>` takes. */
fn itemOfTarget(var checker: Checker, annotation: TypeId, iterable: SymbolId): TypeId? {
  if const Some(arguments) = traitArgumentsOf(checker, annotation, iterable) {
    if const Some(item) = arguments.first() {
      return Some item
    }
  }
  // A target that is not iterable itself - `String`, a `Histogram with From<Iterable<Int>>` - says it in its own `From`.
  // Which of several `From` implementations that is, is the question `iterableSourceOf` answers: `String` has two
  // (`From<Iterable<Char>>` and the blanket `From<Never>`) and only one of them takes an `Iterable`
  iterableSourceOf checker, annotation, iterable
}

/** The `Item` of an expected type that is merely iterable: `const numbers: Iterable<Int> = []` holds `Int64`s. */
fn itemOfIterated(var checker: Checker, expected: TypeId?): TypeId? {
  const iterable = checker.wellKnown.iterable?
  const annotation = expected?
  const arguments = traitArgumentsOf(checker, annotation, iterable)?
  arguments.first()
}

/** The `Key` and the `Value` of a map target, which takes `Iterable<(Key, Value)>` and nothing else. */
fn entryTypesOf(checker: Checker, item: TypeId): (TypeId, TypeId)? {
  if const .Tuple(fields) = checker.types.form(item) {
    if fields.length() == 2 {
      return Some((fields[0].annotation, fields[1].annotation))
    }
  }
  None
}

/** The expected type where a literal can neither *be* it nor be built into it: `Point`, `Int`, a tuple, `Void`. */
fn wrongTargetOf(var checker: Checker, expected: TypeId?): TypeId? {
  const annotation = expected?
  if !isConcrete(checker, annotation) {
    return None
  }
  // A trait type is a coercion and not a target, and `requireCoercion` is what holds it to that
  if const .Traits(_) = checker.types.form(annotation) {
    return None
  }
  Some annotation
}

/**
 * `const numbers: Array<Int, 4> = [1, 2, 3, 4]`: the items are written into the inline slots of the array, so there is
 * no list and no iterator in between. That is what makes the number of items part of the type: it has to be `Size`, and
 * where `Size` is still open the literal's count is what solves it.
 */
fn arrayLiteralType(var checker: Checker, items: List<Argument>, target: ExpectedArray, at: Span): TypeId {
  const inner = expectationOf checker, target.item
  var count = 0
  var isCounted = true
  for argument in items {
    if !argument.isSpread {
      const _ = checkExpression checker, argument.value, inner
      count = count + 1
      continue
    }
    const given = inferExpression checker, argument.value
    checker.adapted argument.value.span, Adaptation.Spread
    match spreadLengthOf(checker, given, target.item) {
      Some(length) => {
        count = count + length
      }
      None => {
        reportOpenSpread checker, given, argument.value.span
        isCounted = false
      }
    }
  }
  if !isCounted {
    // The message about the spread is the root cause: "cannot infer `Size`" on top of it would say nothing new
    suppressVariables checker, target.size
    return target.annotation
  }
  if !matchArraySize(checker, target.annotation, target.size, count, at) {
    return target.annotation
  }
  const item = resolveType checker, target.item
  checker.recordCollectionLiteral at, CollectionLiteral.InlineArray(item, count)
  resolveType checker, target.annotation
}

/**
 * How many items a `...` contributes to an array. Only an `Array` of a known size has an answer: anything else would
 * make the size of the array depend on a value, and the size is part of its type.
 */
fn spreadLengthOf(var checker: Checker, given: TypeId, item: TypeId): Int? {
  const array = checker.wellKnown.array?
  const (symbol, arguments) = match checker.types.form(given) {
    .Nominal(found, held) => (found, held)
    _ => {
      return None
    }
  }
  if symbol != array || arguments.length() != 2 {
    return None
  }
  const length = constantLengthOf(checker, arguments[1])?
  const _ = unify checker, arguments[0], item
  Some length
}

/** The number a const argument is, where it is one: `Array<Int, 4>` answers 4 and `Array<Int, Size>` answers nothing. */
fn constantLengthOf(checker: Checker, size: TypeId): Int? {
  if const .Constant(value, _) = checker.types.form(size) {
    if const .Integer(number) = value {
      return Some number
    }
  }
  None
}

/**
 * The number of items of a literal against the `Size` of the array. An open `Size` is solved by the count, and a
 * written one has to be exactly it. A `Size` that is a const *parameter* (`Array<Float, Columns>` inside a generic
 * type) says nothing here: what `Columns` is, the caller decides.
 */
fn matchArraySize(var checker: Checker, annotation: TypeId, given: TypeId, count: Int, at: Span): Bool {
  const size = resolveType checker, given
  if const Some(wanted) = constantLengthOf(checker, size) {
    if wanted == count {
      return true
    }
    const shown = resolveType checker, annotation
    reportArraySize checker, shown, wanted, count, at
    return false
  }
  if openVariableOf(checker, size).isNone() {
    return true
  }
  const base = checker.integerType()
  const solved = checker.types.intern TypeForm.Constant(LiteralValue.Integer(count), base)
  unify checker, size, solved
}

/**
 * `const names: Set<String> = ["a", "b"]`: the default list is built and handed to the `from` of the target. Every item
 * is checked against the `Item` that target takes, so a wrong one is reported at the item and not at the whole.
 */
fn builtListType(var checker: Checker, items: List<Argument>, target: BuiltTarget, at: Span): TypeId {
  const inner = expectationOf checker, target.item
  for argument in items {
    if argument.isSpread {
      const _ = inferExpression checker, argument.value
      checker.adapted argument.value.span, Adaptation.Spread
      continue
    }
    const _ = checkExpression checker, argument.value, inner
  }
  recordBuiltLiteral checker, target, at
  target.annotation
}

/** `const index: HashMap<String, Int> = ["a": 1]`: the default map is built and handed to `HashMap.from`. */
fn builtMapType(
  var checker: Checker,
  entries: List<(Expression, Expression)>,
  target: BuiltTarget,
  key: TypeId,
  value: TypeId,
  at: Span,
): TypeId {
  const keys = expectationOf checker, key
  const values = expectationOf checker, value
  for (written, given) in entries {
    const _ = checkExpression checker, written, keys
    const _ = checkExpression checker, given, values
  }
  recordBuiltLiteral checker, target, at
  target.annotation
}

/** A map literal against a type that takes no entries. The entries are still checked: they are ordinary expressions. */
fn wrongMapType(
  var checker: Checker,
  entries: List<(Expression, Expression)>,
  annotation: TypeId,
  at: Span,
): TypeId {
  reportWrongTarget checker, annotation, "map", "From<Iterable<(Key, Value)>>", at
  inferEntries checker, entries
  checker.invalidType
}

fn recordBuiltLiteral(var checker: Checker, target: BuiltTarget, at: Span) {
  const annotation = resolveType checker, target.annotation
  const item = resolveType checker, target.item
  checker.recordCollectionLiteral at, CollectionLiteral.FromIterable(annotation, item, target.witness)
}

/**
 * A trait type the default collection is not, but coerces to: `print [1, 2]`, where the parameter is `...values: Show`.
 * The literal keeps the expected type as its own, as it did before there were targets - but the coercion has to hold, or
 * nothing at all would be said about `const found: Compare = [1, 2]`.
 */
fn requireCoercion(var checker: Checker, built: TypeId, expected: TypeId, at: Span) {
  if !isConcrete(checker, built) || !isConcrete(checker, expected) {
    return
  }
  const bounds = match checker.types.form(expected) {
    .Traits(found) => found
    _ => {
      return
    }
  }
  for bound in bounds {
    if implementsBound(checker, built, bound) {
      continue
    }
    const given = checker.describe built
    const shown = checker.describe bound
    checker.reportHere Diagnostic.error("`{given}` does not implement `{shown}`", at)
    return
  }
}

fn inferArguments(var checker: Checker, items: List<Argument>) {
  for argument in items {
    const _ = inferExpression checker, argument.value
  }
}

fn inferEntries(var checker: Checker, entries: List<(Expression, Expression)>) {
  for (written, given) in entries {
    const _ = inferExpression checker, written
    const _ = inferExpression checker, given
  }
}

// --- The messages of the collection literals ------------------------------------------------------------------------

/**
 * A literal against a type that can neither *be* it nor be built from it. `From<Iterable<Item>>` is the one collection
 * target the language has (concept, Decision Log), so that is what the message names.
 */
fn reportWrongTarget(var checker: Checker, annotation: TypeId, kind: String, protocol: String, at: Span) {
  const shown = checker.describe annotation
  checker.reportHere(
    Diagnostic.error("A {kind} literal cannot become a `{shown}`: `{shown}` is not `{protocol}`", at)
      .withNote("A collection target is `From<Iterable<...>>`, the same one `.to<Target>()` asks for")
  )
}

/**
 * The size of an `Array` is part of its type, so the items of a literal are counted against it where they are
 * written: `[1, 2, 3]` against an `Array<Int, 4>` is as wrong as a field a constructor did not fill.
 */
fn reportArraySize(var checker: Checker, annotation: TypeId, wanted: Int, given: Int, at: Span) {
  const shown = checker.describe annotation
  checker.reportHere(
    Diagnostic.error("`{shown}` has {wanted} items, and this literal has {given}", at)
      .withNote("The size of an `Array` is part of its type, so the number of items is counted where it is written")
  )
}

/** A `...` whose number of items nothing knows, where the size of an `Array` has to come out of it. */
fn reportOpenSpread(var checker: Checker, given: TypeId, at: Span) {
  const shown = checker.describe given
  checker.reportHere(
    Diagnostic.error("`{shown}` does not say how many items it has, so `...` cannot fill an `Array`", at)
      .withNote("The size of an `Array` is part of its type: only an `Array` of a known size can be spread into one")
  )
}

/**
 * `0..10`, `0..`, `..10`: **the ends decide the type**, so a range that has no start has no `start` to read and a
 * range that has no end is not a `Length`. The three types have no field in common and nothing is optional in any of
 * them; what accepts all three takes the `Bounds` trait.
 */
fn rangeLiteralType(var checker: Checker, start: Expression?, end: Expression?): TypeId {
  var value = checker.deferredType
  if const Some(from) = start {
    value = inferExpression checker, from
  }
  if const Some(to) = end {
    const inner = expectationOf checker, value
    const other = checkExpression checker, to, inner
    if checker.absorbs(value) {
      value = other
    }
  }
  const symbol = match (start.isSome(), end.isSome()) {
    (true, true) => checker.wellKnown.range
    (true, false) => checker.wellKnown.rangeFrom
    _ => checker.wellKnown.rangeTo
  }
  match symbol {
    Some(found) => checker.nominal found, [value]
    None => checker.deferredType
  }
}

// --- Operators ------------------------------------------------------------------------------------------------------

/**
 * `!a` is built in on `Bool`, `-a` is `Negate.negate`, resolved through the ordinary implementation lookup rather
 * than the `with`-list walk the arithmetic operators use - so a type that implements `Negate` through a supertrait
 * or an `extend` gets `-a` too, and not only one that declares it directly.
 */
fn unaryType(
  var checker: Checker,
  operator: PrefixOperator,
  operand: Expression,
  at: Span,
  expected: TypeId?,
): TypeId {
  match operator {
    .Not => {
      const boolean = checker.booleanType()
      const _ = checkExpression checker, operand, Expectation.Type(boolean)
      boolean
    }
    .Negate => {
      const inner = literalExpectation checker, expected, operand
      const found = checkExpression checker, operand, inner
      if checker.absorbs(found) {
        return checker.deferredType
      }
      const negate = match checker.wellKnown.negate {
        Some(capability) => capability
        None => {
          return checker.deferredType
        }
      }
      if traitArgumentsOf(checker, found, negate).isSome() {
        recordTraitCall checker, at, found, negate, "negate"
        return found
      }
      reportMissingOperator checker, found, "Negate", "-a", at
      checker.deferredType
    }
  }
}

/**
 * The binary operators. `&&` and `||` are built in on `Bool` and short-circuit; the comparisons always produce a
 * `Bool`, whatever implements them; the arithmetic ones take `Other` and `Output` from the trait the left operand
 * declares, so `Meters + Float` is a mistake and `1.0 / 60.0` is a `Float64`.
 */
fn binaryType(
  var checker: Checker,
  operator: InfixOperator,
  left: Expression,
  right: Expression,
  at: Span,
  expected: TypeId?,
): TypeId {
  const boolean = checker.booleanType()
  match operator {
    .And | .Or => {
      const _ = checkExpression checker, left, Expectation.Type(boolean)
      const _ = checkExpression checker, right, Expectation.Type(boolean)
      boolean
    }
    // `a == b` is `Equals.equals` and `a < b` is `Compare.compare`, and both produce a `Bool` whatever implements them
    .Equal | .NotEqual | .Less | .LessOrEqual | .Greater | .GreaterOrEqual => {
      const found = inferExpression checker, left
      const inner = expectationOf checker, found
      const _ = checkExpression checker, right, inner
      recordComparison checker, operator, found, at
      boolean
    }
    // `a ?? b` is `orElse` on an `Option` and on a `Result` alike, and `b` is `lazy`
    .Coalesce => coalesceType checker, left, right, at
    _ => arithmeticType checker, operator, left, right, at, expected
  }
}

/**
 * What is expected of an operand of an arithmetic operator. A numeric type that is expected of the whole expression
 * flows into the literals inside of it, so `const size: Int8 = 3 + 4` is an `Int8` sum and not an `Int64` one that is
 * then rejected (design 2.3). Only an operand that is *made* of literals adapts: a name keeps the type it has, so
 * `Meters + Float` stays the mistake it is, and whether the sum itself leaves the range is the constant evaluator's
 * question and not one the checker can answer about two literals that each fit.
 */
fn literalExpectation(checker: Checker, expected: TypeId?, operand: Expression): Expectation {
  const annotation = match expected {
    Some(found) => found
    None => {
      return Expectation.None
    }
  }
  if numericNameOf(checker, annotation).isNone() {
    return Expectation.None
  }
  if !isLiteralArithmetic(operand) {
    return Expectation.None
  }
  Expectation.Type annotation
}

/** Whether the expression is built from numeric literals and the arithmetic operators alone, so that it can adapt. */
fn isLiteralArithmetic(operand: Expression): Bool {
  match operand.kind {
    .IntegerLiteral(_) | .FloatLiteral(_) => true
    .Unary(.Negate, inner) => isLiteralArithmetic inner
    .Binary(operator, left, right) =>
      isArithmetic(operator) && isLiteralArithmetic(left) && isLiteralArithmetic(right)
    _ => false
  }
}

fn isArithmetic(operator: InfixOperator): Bool {
  match operator {
    .Add | .Subtract | .Multiply | .Divide | .Remainder => true
    _ => false
  }
}

/**
 * Which `equals` or `compare` a comparison runs, and that the type has one. 4.3 left the second half out because the
 * prelude had no `Equals` and no `Hash` for its collections, which would have made the message one about the standard
 * library; `std/collections` carries all three for `List`, `Set` and `Map` now, so an operator asks for its trait here
 * exactly as `a + b` does.
 */
fn recordComparison(var checker: Checker, operator: InfixOperator, found: TypeId, at: Span) {
  if checker.absorbs(found) {
    return
  }
  const isOrdering = match operator {
    .Equal | .NotEqual => false
    _ => true
  }
  const member = if isOrdering { "compare" } else { "equals" }
  /*
   * `a == b` on two trait-typed values is not reported as an object-safety violation, and deliberately so:
   * `equals(self, other: Self)` takes a second `Self`, and two values of a trait type need not have the same type.
   * Every collection of the language has a trait type (`List<String>` is `List` applied to `String`), so rejecting
   * this would reject `parts == ["a"]` and with it half of every test in the repository. Object safety stays a rule
   * about a member that is *named*, and the operators stay outside it until a literal-type-like "the two sides are
   * the same type here" rule is written down.
   */
  const capability = if isOrdering { checker.wellKnown.compare } else { checker.wellKnown.equals }
  const symbol = match capability {
    Some(inner) => inner
    None => {
      return
    }
  }
  if traitArgumentsOf(checker, found, symbol).isSome() {
    recordTraitCall checker, at, found, symbol, member
    return
  }
  const capabilityName = if isOrdering { "Compare" } else { "Equals" }
  reportMissingOperator checker, found, capabilityName, comparisonOf(operator), at
}

fn comparisonOf(operator: InfixOperator): String {
  match operator {
    .Equal => "a == b"
    .NotEqual => "a != b"
    .Less => "a < b"
    .LessOrEqual => "a <= b"
    .Greater => "a > b"
    _ => "a >= b"
  }
}


/**
 * `a ?? b`: the `Value` the trait `OrElse` names, with the fallback checked against it and evaluated only when needed.
 *
 * An operator is a trait exactly when it is a method call, and `a ?? b` *is* `a.orElse(b)` - so this asks the type for
 * `OrElse<Value>` the way `a + b` asks for `Add`. `Option` and `Result` come with it, and a type of a program that
 * wants `??` says so.
 */
fn coalesceType(var checker: Checker, left: Expression, right: Expression, at: Span): TypeId {
  const found = inferExpression checker, left
  const capability = match checker.wellKnown.orElse {
    Some(inner) => inner
    None => {
      deferExpression checker, right
      return checker.deferredType
    }
  }
  const value = match traitArgumentsOf(checker, found, capability) {
    Some(arguments) => arguments.get(0) ?? checker.deferredType
    None => {
      if isFullyKnown(checker, found) {
        reportMissingOperator checker, found, "OrElse", "a ?? b", at
        deferExpression checker, right
        return checker.invalidType
      }
      deferExpression checker, right
      return checker.deferredType
    }
  }
  const inner = expectationOf checker, value
  // The fallback is a `lazy` argument, so it is recorded before it is checked, exactly as an argument list does it - and
  // it becomes a thunk, which is a closure and needs the bindings it reads (design 4.8)
  checker.adapted right.span, Adaptation.Lazy
  openThunk checker, right.span
  const _ = checkExpression checker, right, inner
  closeThunk checker, right.span
  // `??` reaches `orElse` through `OrElse`, so the implementation is what it records - like every other operator
  recordTraitCall checker, at, found, capability, "orElse"
  value
}

/** The `Value` of an `Option<Value>` or of a `Result<Value, Failure>`: what `?` unwraps. */
fn valueOfOptionOrResult(checker: Checker, annotation: TypeId): TypeId? {
  if const Some(value) = optionValueOf(checker, annotation) {
    return Some value
  }
  if const Some((value, _)) = resultPartsOf(checker, annotation) {
    return Some value
  }
  None
}

fn arithmeticType(
  var checker: Checker,
  operator: InfixOperator,
  left: Expression,
  right: Expression,
  at: Span,
  expected: TypeId?,
): TypeId {
  const outer = literalExpectation checker, expected, left
  const found = checkExpression checker, left, outer
  const capability = match checker.wellKnown.symbolNamed(traitNameOf(operator)) {
    Some(symbol) => symbol
    None => {
      deferExpression checker, right
      return checker.deferredType
    }
  }
  if checker.absorbs(found) {
    deferExpression checker, right
    return checker.deferredType
  }
  // `Other` and `Output` come from the implementation of the trait, so `Meters + Float` is a mistake. A type may carry
  // the trait **several times** - `Board with Multiply<Scale, Board>` next to `Multiply<Board, Board>` - and then the
  // right operand and the expected type say which one is meant, exactly as they do at the named call
  const bound = match operatorBound(checker, found, capability, operator, right, expected, at) {
    Some(inner) => inner
    None => {
      deferExpression checker, right
      return checker.deferredType
    }
  }
  const arguments = appliedArgumentsOf checker, bound
  if arguments.length() != 2 {
    deferExpression checker, right
    return checker.deferredType
  }
  const inner = expectationOf checker, arguments[0]
  const _ = checkExpression checker, right, inner
  recordTraitCall checker, at, found, capability, memberOfOperator(operator), Some(bound)
  arguments[1]
}

/**
 * Which implementation of an operator's trait `a * b` reaches. One is the ordinary answer; several are the overload
 * form the decision log keeps (a trait with a **parameter**), and then the type of the right operand and the type the
 * expression is expected to produce are what tell them apart - the same two questions the named call `a.multiply(b)`
 * asks. None is the missing-operator message.
 */
fn operatorBound(
  var checker: Checker,
  found: TypeId,
  capability: SymbolId,
  operator: InfixOperator,
  right: Expression,
  expected: TypeId?,
  at: Span,
): TypeId? {
  if const Some(given) = traitArgumentsOf(checker, found, capability) {
    return Some checker.nominal(capability, given)
  }
  const candidates = appliedTraitsOf checker, found, capability
  if candidates.isEmpty() {
    reportMissingOperator checker, found, traitNameOf(operator), operatorOf(operator), at
    return None
  }
  // The right operand decides, so it is inferred once here and checked against the chosen `Other` afterwards - the same
  // order an overloaded call reads its arguments in
  const other = inferExpression checker, right
  var fitting: List<TypeId> = []
  for candidate in candidates {
    const arguments = appliedArgumentsOf checker, candidate
    if arguments.length() != 2 {
      continue
    }
    if fitsType(checker, other, arguments[0]) {
      fitting.add candidate
    }
  }
  if fitting.isEmpty() {
    reportNoOperator checker, found, candidates, other, operator, at
    return None
  }
  if fitting.length() == 1 {
    return fitting.first()
  }
  var narrowed: List<TypeId> = []
  if const Some(wanted) = expected {
    for candidate in fitting {
      const arguments = appliedArgumentsOf checker, candidate
      if fitsType(checker, arguments[1], wanted) {
        narrowed.add candidate
      }
    }
  }
  if narrowed.length() == 1 {
    return narrowed.first()
  }
  reportAmbiguousOperator checker, found, fitting, operator, at
  fitting.first()
}

/** `Board * Colour` where `Board` multiplies by a `Scale` and by a `Board`: the operand fits none of them. */
fn reportNoOperator(
  var checker: Checker,
  found: TypeId,
  candidates: List<TypeId>,
  other: TypeId,
  operator: InfixOperator,
  at: Span,
) {
  if !isFullyKnown(checker, found) || !isFullyKnown(checker, other) {
    return
  }
  const receiver = checker.describe found
  const written = checker.describe other
  const shown = describeOperands checker, candidates
  checker.reportHere(
    Diagnostic.error("`{receiver}` does not {operatorNameOf(operator)} a `{written}`", at)
      .withNote("`{operatorOf(operator)}` exists on `{receiver}` for {shown}")
  )
}

/** Two implementations fit, and nothing the expression says tells them apart. */
fn reportAmbiguousOperator(
  var checker: Checker,
  found: TypeId,
  fitting: List<TypeId>,
  operator: InfixOperator,
  at: Span,
) {
  const receiver = checker.describe found
  const shown = describeOperands checker, fitting
  checker.reportHere(
    Diagnostic.error("`{operatorOf(operator)}` fits more than one implementation of `{receiver}`", at)
      .withNote("It exists for {shown}: write the type that is expected of this expression")
  )
}

fn describeOperands(var checker: Checker, candidates: List<TypeId>): String {
  var shown: List<String> = []
  for candidate in candidates {
    const arguments = appliedArgumentsOf checker, candidate
    if const Some(operand) = arguments.first() {
      shown.add checker.describe(operand)
    }
  }
  shown.joined separator: ", "
}

/** The verb of an operator, for a message about an operand it does not take: "`Board` does not multiply a `Colour`". */
fn operatorNameOf(operator: InfixOperator): String {
  match operator {
    .Add => "add"
    .Subtract => "subtract"
    .Multiply => "multiply"
    .Divide => "divide"
    .Remainder => "take the remainder of"
    _ => "combine with"
  }
}

fn operatorOf(operator: InfixOperator): String {
  match operator {
    .Add => "a + b"
    .Subtract => "a - b"
    .Multiply => "a * b"
    .Divide => "a / b"
    .Remainder => "a % b"
    _ => ""
  }
}

fn memberOfOperator(operator: InfixOperator): String {
  match operator {
    .Add => "add"
    .Subtract => "subtract"
    .Multiply => "multiply"
    .Divide => "divide"
    .Remainder => "remainder"
    _ => ""
  }
}

fn traitNameOf(operator: InfixOperator): String {
  match operator {
    .Add => "Add"
    .Subtract => "Subtract"
    .Multiply => "Multiply"
    .Divide => "Divide"
    .Remainder => "Remainder"
    _ => ""
  }
}

/** A type that says nothing is no expectation at all: it must not turn into "expected `unchecked`". */
public fn expectationOf(checker: Checker, annotation: TypeId): Expectation {
  if checker.absorbs(annotation) {
    return Expectation.None
  }
  Expectation.Type annotation
}

// --- `if`, `match` and closures -------------------------------------------------------------------------------------

fn ifType(
  var checker: Checker,
  condition: Condition,
  then: Block,
  otherwise: Expression?,
  expected: Expectation,
): TypeId {
  // `if const Some(user) = lookup()` binds for the body of the `if` and for nothing after it
  checker.openScope()
  checkCondition checker, condition, false
  // What the pattern in the head bound: every one of those names has to be read in the body
  const bound = checker.bindingsHere()
  const alternative = match otherwise {
    Some(found) => found
    // An `if` without an `else` has no value, so its body is checked as a block of statements
    None => {
      const _ = checkBlock checker, then, Expectation.Statement
      requireReadBindings checker, bound
      checker.closeScope()
      return checker.voidType
    }
  }
  const first = checkBlock checker, then, expected
  requireReadBindings checker, bound
  checker.closeScope()
  const second = checkExpression checker, alternative, expected
  if const Some(annotation) = expected.annotationOf() {
    return annotation
  }
  if expected.isStatement() {
    return checker.voidType
  }
  armResult checker, [first.annotation, second]
}

/**
 * The head of an `if` or a `while`. A pattern in it (`if const Some(user) = lookup()`) binds for the body only and has
 * to be able to fail; `isLoop` says which of the two it is, because a pattern that always matches is a `const` in an
 * `if` and an endless loop in a `while`.
 */
public fn checkCondition(var checker: Checker, condition: Condition, isLoop: Bool) {
  match condition {
    .Test(expression) => {
      const boolean = checker.booleanType()
      const _ = checkExpression checker, expression, Expectation.Type(boolean)
    }
    // `if const Some(user) = lookup()`: the pattern is checked against the subject, and it has to be able to fail
    .Bind(isVar, pattern, value) => {
      const found = inferExpression checker, value
      const inner = if checker.absorbs(found) { checker.deferredType } else { found }
      // `if var Some(inner) = current` binds `var` paths *into* the subject, so the subject has to be one and
      // what the pattern binds is a reference into it and not a copy
      if isVar {
        checkSubject checker, value
      }
      const first = checker.bindings.length()
      checkPattern checker, pattern, inner, isVar
      if isVar {
        markReferenceBindings checker, first
      }
      checkConditionPattern checker, pattern, inner, isLoop
    }
  }
}

fn matchType(var checker: Checker, subject: Expression, arms: List<MatchArm>, expected: Expectation): TypeId {
  const found = inferExpression checker, subject
  var produced: List<TypeId> = []
  var plans: List<MatchArmPlan> = []
  for arm in arms {
    checker.openScope()
    checkPattern checker, arm.pattern, found, false
    // The names this arm bound: the guard and the body are where they have to be read
    const bound = checker.bindingsHere()
    const plan = armPlanOf checker, arm, found
    plans.add plan
    if const Some(guard) = arm.guard {
      const boolean = checker.booleanType()
      const _ = checkExpression checker, guard, Expectation.Type(boolean)
    }
    produced.add checkExpression(checker, arm.body, expected)
    requireReadBindings checker, bound
    checker.closeScope()
  }
  const _ = checkExhaustive checker, found, arms, plans, subject.span
  if const Some(annotation) = expected.annotationOf() {
    return annotation
  }
  if expected.isStatement() {
    return checker.voidType
  }
  armResult checker, produced
}

/**
 * The type of an `if` or a `match` that nothing is expected of: the arms are unified under the inference context of the
 * statement, and what they agree on is the value. Where they do not agree the arms are *statements* - a body without a
 * declared result whose last expression is a `match` used for effect is the ordinary case and must not be reported - so
 * the whole has the type `Void`. With an expectation every arm was checked against it and said everything there is.
 */
fn armResult(var checker: Checker, arms: List<TypeId>): TypeId {
  var found: TypeId? = None
  for arm in arms {
    const annotation = resolveType checker, arm
    if checker.absorbs(annotation) {
      continue
    }
    match found {
      Some(known) => {
        if !unify(checker, known, annotation) {
          return checker.voidType
        }
      }
      None => {
        found = Some annotation
      }
    }
  }
  match found {
    Some(annotation) => resolveType checker, annotation
    None => checker.neverType
  }
}

// --- `?` and `into()` ------------------------------------------------------------------------------------------------

/**
 * `e?` unwraps an `Ok` or a `Some` and returns the other case from the enclosing function. Where the error types
 * differ, the error is converted through `From` - which is what makes the generated `From<IoError>` of a wrapper case
 * work without anybody writing it (section 4.6).
 */
fn tryType(var checker: Checker, inner: Expression, at: Span, expected: Expectation): TypeId {
  const subject = checkExpression checker, inner, unwrappedExpectation(expected)
  const found = matchedFailure checker, subject
  if checker.absorbs(found) {
    return checker.deferredType
  }
  const value = match valueOfOptionOrResult(checker, found) {
    Some(given) => given
    None => {
      if isFullyKnown(checker, found) {
        const shown = checker.describe found
        checker.reportHere(
          Diagnostic.error("`?` needs an `Option` or a `Result`, and `{shown}` is not one", at)
        )
        return checker.invalidType
      }
      return checker.deferredType
    }
  }
  // At the top level of an entry file and in a body whose result is inferred there is nothing to convert towards: the
  // program ends with the error, or the enclosing result decides the conversion once it is known
  if checker.isResultInferred {
    return value
  }
  const result = checker.resultType
  if checker.absorbs(result) {
    return value
  }
  const failure = match resultPartsOf(checker, found) {
    Some((_, error)) => Some error
    None => None
  }
  if const Some(error) = failure {
    if const Some((_, wanted)) = resultPartsOf(checker, result) {
      convertError checker, error, wanted, at
      return value
    }
    requireTryResult checker, result, at
    return value
  }
  if resultPartsOf(checker, result).isSome() {
    const shown = checker.describe result
    checker.reportHere(
      Diagnostic.error("`?` on an `Option` in a function that returns `{shown}`", at)
        .withNote("There is no error to return. Turn it into one first: `okOr(...)` gives the `Option` an error")
    )
    return value
  }
  requireTryResult checker, result, at
  value
}

/**
 * What the operand of a `?` is told: the type the `?` itself is expected to have, as [Expectation.Unwrapped].
 *
 * It is not handed down as an expected type, because the operand is an `Option` or a `Result` *of* it and which of
 * the two only the operand says - so a type here would report a mismatch at every `?`. What it is for is the one call
 * whose meaning the expectation decides, `tryInto()`.
 */
fn unwrappedExpectation(expected: Expectation): Expectation {
  match expected.annotationOf() {
    Some(annotation) => Expectation.Unwrapped annotation
    None => Expectation.None
  }
}

/**
 * `?` returns the failure from the enclosing function, so that function has to have a place for one: an `Option` or a
 * `Result` (CONCEPT, "Errors"). The top level of an entry file and a body whose result is inferred are out of this
 * already - there the result is not decided here - and a `Task<Result<...>>` stays exempt: the `?` in
 * `fetchUser(id).await()?` is about the value behind the task, not about the task itself.
 */
fn requireTryResult(var checker: Checker, result: TypeId, at: Span) {
  if optionValueOf(checker, result).isSome() || resultPartsOf(checker, result).isSome() {
    return
  }
  if const Some(inner) = taskValueOf(checker, result) {
    if optionValueOf(checker, inner).isSome() || resultPartsOf(checker, inner).isSome() {
      return
    }
  }
  if !isFullyKnown(checker, result) {
    return
  }
  const shown = checker.describe result
  checker.reportHere(
    Diagnostic.error("`?` needs a function that returns an `Option` or a `Result`, and this one returns `{shown}`", at)
      .withNote("`?` hands the failure back to the caller, so there has to be somewhere for it to go")
  )
}

/**
 * `settings.get("port").okOr(.Missing("port"))?`: nothing but the `?` says what the error of `okOr` is, so where the
 * subject's failure type is still open the enclosing result is what decides it. A failure type that is already known
 * stays what it is and is converted through `From` as always.
 */
fn matchedFailure(var checker: Checker, subject: TypeId): TypeId {
  if !hasVariable(checker, subject) {
    return subject
  }
  const (_, failure) = match resultPartsOf(checker, subject) {
    Some(parts) => parts
    None => {
      return subject
    }
  }
  if checker.isResultInferred {
    return subject
  }
  const result = checker.resultType
  if const Some((_, wanted)) = resultPartsOf(checker, result) {
    const _ = unify checker, failure, wanted
  }
  resolveType checker, subject
}

/**
 * `IoError` into `AppError`: the ordinary `From` lookup, including the one a wrapper case gets generated.
 *
 * Where the wanted failure is a trait-typed value (`fn main(): Result<Void, Error>`) no `From` can apply - nobody
 * extends a trait type - so the error becomes the trait value through the ordinary coercion of a value to a
 * trait-typed one instead, recorded as `ToTraitValue` like every other one.
 */
fn convertError(var checker: Checker, error: TypeId, wanted: TypeId, at: Span) {
  if sameType(checker.types, error, wanted) {
    return
  }
  if !isConcrete(checker, error) {
    return
  }
  const asTraits = match checker.types.form(wanted) {
    .Traits(bounds) => Some bounds
    _ => None
  }
  if !isConcrete(checker, wanted) && asTraits.isNone() {
    return
  }
  const from = match checker.wellKnown.from {
    Some(symbol) => symbol
    None => {
      return
    }
  }
  const bound = checker.nominal(from, [error])
  const witness = witnessFor checker, wanted, bound
  if const .Unresolved = witness {
    if const Some(bounds) = asTraits {
      const _ = coerceToTraits checker, error, bounds, at
      return
    }
    const given = checker.describe error
    const target = checker.describe wanted
    checker.reportHere(
      Diagnostic.error("`{given}` does not convert into `{target}`", at)
        .withNote("Add a case that wraps it, or `extend {target} with From<{given}>`")
    )
    return
  }
  const method = memberSymbolOf checker, wanted, "from"
  if const Some(symbol) = method {
    checker.adapted at, Adaptation.Convert(witness, symbol)
  }
}

/**
 * `value.tryInto()`: the target and the failure are the two arguments of the expected `Result`, and the conversion is
 * the `TryFrom` implementation of that target - which is what the blanket
 * `extend<Source, Target, Failure> Source with TryInto<Target, Failure>` of the prelude says.
 *
 * Unlike `into()`, nothing here can be read from a target alone: the receiver says the `Source`, and the `Result` that
 * is expected says both the `Target` and the `Failure`. Under a `?` there is no such `Result` - `const port: Int =
 * text.tryInto()?` writes only the target - and then the failure is the one the target's single `TryFrom` from this
 * source answers with. Where neither says enough, the message says so and names the call to write instead.
 */
fn isFallibleConversionCall(checker: Checker, callee: Expression, arguments: List<Argument>): Bool {
  if !arguments.isEmpty() {
    return false
  }
  if const .Member(_, name, isOptional) = callee.kind {
    return name.text == "tryInto" && !isOptional
  }
  false
}

fn fallibleConversionType(
  var checker: Checker,
  expression: Expression,
  callee: Expression,
  arguments: List<Argument>,
  style: CallStyle,
  expected: Expectation,
): TypeId {
  const base = match callee.kind {
    .Member(inner, _, _) => inner
    _ => {
      return checker.deferredType
    }
  }
  const source = inferExpression checker, base
  if hasMemberNamed(checker, source, "tryInto") {
    return checkCall checker, expression, callee, arguments, style, expected
  }
  const parts = conversionPartsOf checker, source, expected, expression.span
  const (target, failure) = match parts {
    Some(found) => found
    None => {
      // The message was given where the parts were looked for; the callee still gets a type, so that nothing after
      // this asks about a span that was never written down
      typeFallibleCallee checker, callee, source, checker.invalidType
      return checker.invalidType
    }
  }
  const answer = expected.annotationOf() ?? resultTypeOf(checker, target, failure)
  // `value.tryInto` is `(self: Source) => Result<Target, Failure>`: a fact about this call, so the callee is typed
  typeFallibleCallee checker, callee, source, answer
  if checker.absorbs(source) {
    return answer
  }
  const tryFrom = match checker.wellKnown.tryFrom {
    Some(symbol) => symbol
    None => {
      return answer
    }
  }
  const bound = checker.nominal tryFrom, [source, failure]
  const witness = witnessFor checker, target, bound
  if const .Unresolved = witness {
    const given = checker.describe source
    const wanted = checker.describe target
    const problem = checker.describe failure
    checker.reportHere(
      Diagnostic.error("`{given}` does not convert into `{wanted}`", expression.span)
        .withNote(
          "`tryInto()` is the `TryFrom` of the target: `extend {wanted} with TryFrom<{given}, {problem}>` provides it"
        )
    )
    return checker.invalidType
  }
  if const Some(symbol) = memberSymbolOf(checker, target, "tryFrom") {
    checker.adapted expression.span, Adaptation.Convert(witness, symbol)
    checker.resolved expression.span, Resolution.Callable(symbol, [], Dispatch.Direct)
  }
  answer
}

/**
 * Whether the receiver's own type declares this member. A value of the trait type `Into<Target>` has `into` - it is
 * the trait's one required member - so the call is an ordinary dynamic one and not a conversion through `From`. The
 * conversion is what happens for a receiver whose type has no such member, which is every concrete type: the blanket
 * over `From` cannot be resolved without knowing the target, and the target is what the expected type says.
 */
fn hasMemberNamed(var checker: Checker, receiver: TypeId, name: String): Bool {
  if checker.absorbs(receiver) {
    return false
  }
  lookupMember(checker, receiver, name).isSome()
}

/**
 * The `Target` and the `Failure` of a `tryInto()`: the two arguments of the `Result` that is expected of the call, or
 * - under a `?`, which leaves only the target - the target and the failure of the one `TryFrom` that target has for
 * this source. Answers `None` where neither says enough, and says why where it does.
 */
fn conversionPartsOf(var checker: Checker, source: TypeId, expected: Expectation, at: Span): (TypeId, TypeId)? {
  if const Some(found) = resultArgumentsOf(checker, expected.annotationOf()) {
    return Some found
  }
  if const Some(wanted) = expected.unwrappedOf() {
    const target = resolveType checker, wanted
    if isConcrete(checker, target) {
      return soleConversionFailure checker, source, target, at
    }
  }
  reportOpenConversionTarget checker, source, at
  None
}

/**
 * `const port: Int = text.tryInto()?`: the `?` says the target and nothing about the failure, so the failure is the
 * one the target's single `TryFrom` from this source answers with. None and several are both reported here, because
 * both leave the call without a meaning.
 */
fn soleConversionFailure(var checker: Checker, source: TypeId, target: TypeId, at: Span): (TypeId, TypeId)? {
  const failures = fallibleFailuresOf checker, target, source
  if failures.length() == 1 {
    return Some((target, failures[0]))
  }
  const given = checker.describe source
  const wanted = checker.describe target
  if failures.isEmpty() {
    checker.reportHere(
      Diagnostic.error("`{given}` does not convert into `{wanted}`", at)
        .withNote(
          "`tryInto()` is the `TryFrom` of the target: `extend {wanted} with TryFrom<{given}, Failure>` provides it"
        )
    )
    return None
  }
  var shown: List<String> = []
  for failure in failures {
    shown.add "`{checker.describe(failure)}`"
  }
  const listed = shown.joined separator: ", "
  checker.reportHere(
    Diagnostic.error("`{given}` converts into `{wanted}` in more than one way", at)
      .withNote(
        "A `?` says the target and not the failure, and there are several: {listed}."
          + " Annotate the `Result<{wanted}, Failure>` that is meant"
      )
  )
  None
}

/**
 * `value.tryInto` is `(self: Source) => Result<Target, Failure>`: a fact about this call and not about the member, so
 * the callee's span carries it.
 */
fn typeFallibleCallee(var checker: Checker, callee: Expression, source: TypeId, answer: TypeId) {
  const form = FunctionForm([ParameterForm(Some("self"), ParameterMode.Value, source)], answer)
  const shown = checker.functionType form
  const _ = checker.typed callee.span, shown
}

/** The `Value` and the `Failure` of an expected `Result<Value, Failure>`, where both of them are known. */
fn resultArgumentsOf(var checker: Checker, expected: TypeId?): (TypeId, TypeId)? {
  const result = checker.wellKnown.result?
  const annotation = expected?
  const resolved = resolveType checker, annotation
  if const .Nominal(symbol, arguments) = checker.types.form(resolved) {
    if symbol == result && arguments.length() == 2 {
      if isConcrete(checker, arguments[0]) && isConcrete(checker, arguments[1]) {
        return Some((arguments[0], arguments[1]))
      }
    }
  }
  None
}

/** `Result<Target, Failure>` as a type, for a `tryInto()` whose parts the `?` above it did not write out. */
fn resultTypeOf(var checker: Checker, value: TypeId, failure: TypeId): TypeId {
  const result = match checker.wellKnown.result {
    Some(symbol) => symbol
    None => {
      return checker.invalidType
    }
  }
  checker.nominal result, [value, failure]
}

/**
 * `wide.tryInto()` where nothing says what to convert into. `tryInto()` reads its target out of the `Result` that is
 * expected of it or out of the type a `?` on it unwraps to, so a call whose result goes nowhere annotated has nothing
 * to go on.
 */
fn reportOpenConversionTarget(var checker: Checker, source: TypeId, at: Span) {
  const given = checker.describe source
  checker.reportHere(
    Diagnostic.error("The target of `tryInto()` is not known here", at)
      .withNote(
        "It comes from the `Result<Target, Failure>` that is expected of the call, or from the type a `?` on it"
          + " unwraps to: annotate one of the two, or write `Target.tryFrom(value)` - the source is `{given}`"
      )
  )
}

fn memberSymbolOf(var checker: Checker, owner: TypeId, name: String): SymbolId? {
  const candidate = lookupStaticMember(checker, owner, name)?
  match candidate.kind {
    .Method(_, symbol) => Some symbol
    .Constant(_, symbol) => Some symbol
    _ => None
  }
}

/**
 * `value.into()`: the target is the expected type, and the conversion is the `From` implementation of that target -
 * which is exactly what the blanket `extend<Source, Target> Source with Into<Target>` of the prelude says.
 */
fn isConversionCall(checker: Checker, callee: Expression, arguments: List<Argument>, expected: TypeId?): Bool {
  if expected.isNone() || !arguments.isEmpty() {
    return false
  }
  if const .Member(_, name, isOptional) = callee.kind {
    return name.text == "into" && !isOptional
  }
  false
}

fn conversionType(
  var checker: Checker,
  expression: Expression,
  callee: Expression,
  arguments: List<Argument>,
  style: CallStyle,
  expected: Expectation,
): TypeId {
  const target = expected.annotationOf() ?? checker.deferredType
  const base = match callee.kind {
    .Member(inner, _, _) => inner
    _ => {
      return checker.deferredType
    }
  }
  const source = inferExpression checker, base
  if hasMemberNamed(checker, source, "into") {
    return checkCall checker, expression, callee, arguments, style, expected
  }
  // `value.into` is `(self: Source) => Target` - the one member whose type the expected type decides and the receiver
  // alone cannot. That is a fact and not a construct a later pass looks at, so the callee is typed and not deferred
  const form = FunctionForm([ParameterForm(Some("self"), ParameterMode.Value, source)], target)
  const shown = checker.functionType form
  const _ = checker.typed callee.span, shown
  if checker.absorbs(source) || checker.absorbs(target) {
    return target
  }
  const from = match checker.wellKnown.from {
    Some(symbol) => symbol
    None => {
      return target
    }
  }
  const bound = checker.nominal(from, [source])
  const witness = witnessFor checker, target, bound
  if const .Unresolved = witness {
    if isConcrete(checker, source) && isConcrete(checker, target) {
      const given = checker.describe source
      const wanted = checker.describe target
      checker.reportHere(
        Diagnostic.error("`{given}` does not convert into `{wanted}`", expression.span)
          .withNote("`into()` is the `From` of the target: `extend {wanted} with From<{given}>` provides it")
      )
      return checker.invalidType
    }
    return target
  }
  if const Some(symbol) = memberSymbolOf(checker, target, "from") {
    checker.adapted expression.span, Adaptation.Convert(witness, symbol)
    checker.resolved expression.span, Resolution.Callable(symbol, [], Dispatch.Direct)
  }
  target
}

// --- Checking a value against what is expected ----------------------------------------------------------------------

/**
 * Whether a value of type `found` may stand where `expected` is asked for. Exact type equality, plus the four
 * directed coercions of the design: a value to a trait it implements, a trait value to fewer bounds or to a
 * supertrait, `Never` to anything, and a literal to a literal type that contains it. There is no variance.
 */
public fn checkValue(var checker: Checker, found: TypeId, expected: TypeId, at: Span): Bool {
  if checker.absorbs(found) || checker.isBroken(expected) {
    return true
  }
  // Unification is the exact step: it solves the variables of this statement and nothing else
  if unify(checker, found, expected) {
    return true
  }
  const wanted = resolveType checker, expected
  const given = resolveType checker, found
  if const .Traits(bounds) = checker.types.form(wanted) {
    return coerceToTraits checker, given, bounds, at
  }
  const isTraitForParameter = traitForParameter checker, given, wanted
  if !isTraitForParameter && (isUndecided(checker, given) || isUndecided(checker, wanted)) {
    return true
  }
  const shown = checker.describe wanted
  const written = checker.describe given
  var problem = Diagnostic.error "Expected `{shown}`, found `{written}`", at
  if numericNameOf(checker, given).isSome() && numericNameOf(checker, wanted).isSome() {
    problem = problem.withNote "There are no implicit conversions: `{shown}.tryFrom(value)?`"
  }
  if isTraitForParameter {
    problem = problem.withNote(
      "A type parameter is opaque inside the body that declares it: it stands for one type the call site chose, and a "
        + "trait-typed value is any of them. Take the value as the parameter (`value: Value`) or answer the trait"
    )
  }
  checker.reportHere problem
  false
}

/**
 * A trait-typed value handed to a **type parameter**, anywhere inside the two types. The four coercions of the design
 * all run towards a trait type and none of them runs back: a `Value` inside the body that declares it is one type the
 * call site chose, and an `Area` is any type that implements `Area`, so the one is never the other. Without this the
 * pair would fall into [isUndecided] - a parameter says nothing about what may arrive at it - and `fn bare<Value>(shape:
 * Area): Value { shape }` would check clean and break in the back end's verifier.
 *
 * Where the parameter *was* instantiated with that trait type, substitution has already put the trait type in both
 * places and `unify` answered before this is asked.
 */
fn traitForParameter(var checker: Checker, given: TypeId, wanted: TypeId): Bool {
  traitForParameterDeep checker, given, wanted, 0
}

fn traitForParameterDeep(var checker: Checker, given: TypeId, wanted: TypeId, depth: Int): Bool {
  if depth > 24 {
    return false
  }
  if const .Parameter(_) = checker.types.form(wanted) {
    if const .Traits(_) = checker.types.form(given) {
      return true
    }
    return false
  }
  match checker.types.form(wanted) {
    .Nominal(symbol, arguments) => {
      if const .Nominal(otherSymbol, otherArguments) = checker.types.form(given) {
        if symbol != otherSymbol || arguments.length() != otherArguments.length() {
          return false
        }
        for index in 0..arguments.length() {
          if traitForParameterDeep(checker, otherArguments[index], arguments[index], depth + 1) {
            return true
          }
        }
      }
      false
    }
    .Tuple(fields) => {
      if const .Tuple(otherFields) = checker.types.form(given) {
        if fields.length() != otherFields.length() {
          return false
        }
        for index in 0..fields.length() {
          if traitForParameterDeep(checker, otherFields[index].annotation, fields[index].annotation, depth + 1) {
            return true
          }
        }
      }
      false
    }
    _ => false
  }
}

/**
 * `const shapes: List<Shape> = [Square(2.0)]`: the value becomes a trait-typed value, and the witness of every bound
 * is recorded so that the lowering can build its table. A subject that is not concrete says nothing: what a generic
 * parameter implements is decided by the call site.
 */
fn coerceToTraits(var checker: Checker, found: TypeId, bounds: List<TypeId>, at: Span): Bool {
  var witnesses: List<Witness> = []
  var applied: List<TypeId> = []
  var missing: TypeId? = None
  for wanted in bounds {
    // `fn each<Item>(items: Iterable<Item>)` with a `List<Int64>`: the arguments of the bound come out of the coercion
    const bound = matchedBound checker, found, wanted
    applied.add bound
    const witness = witnessFor checker, found, bound
    if const .Unresolved = witness {
      if missing.isNone() {
        missing = Some bound
      }
      continue
    }
    witnesses.add witness
  }
  if const Some(bound) = missing {
    if !isConcrete(checker, found) || !isConcrete(checker, bound) {
      return true
    }
    const given = checker.describe found
    const wanted = checker.describe bound
    checker.reportHere Diagnostic.error("`{given}` does not implement `{wanted}`", at)
    return false
  }
  checker.adapted at, Adaptation.ToTraitValue(applied, witnesses)
  true
}

/**
 * One bound of the expected trait type, with the arguments a coercion decides. `Iterable<Item>` with an unsolved `Item`
 * is what every collection parameter of the prelude looks like at a call: the type that arrives says what `Item` is, and
 * that is a solution and not a coercion, so it goes through `unify`.
 */
fn matchedBound(var checker: Checker, found: TypeId, wanted: TypeId): TypeId {
  if !hasVariable(checker, wanted) && !hasVariable(checker, found) {
    return wanted
  }
  const (capability, arguments) = match checker.types.form(wanted) {
    .Nominal(symbol, given) => (symbol, given)
    _ => {
      return resolveType checker, wanted
    }
  }
  if const Some(actual) = traitArgumentsOf(checker, found, capability) {
    if actual.length() == arguments.length() {
      for index in 0..arguments.length() {
        const _ = unify checker, arguments[index], actual[index]
      }
    }
  }
  resolveType checker, wanted
}

/**
 * Types that say nothing about what may arrive at them: a generic parameter, an unsolved variable, an error.
 *
 * A **trait type is not one of them.** `Shape` is a decided type: the only thing that may become one is a value that
 * implements its bounds, and `checkValue` has already tried that coercion by the time this is asked. So a `Shape` where
 * a `Square` is wanted, and a `List<Int>` where an `Int64` is, are ordinary mismatches - there is no coercion from a
 * trait to a concrete type and never was one (design 2.5).
 */
fn isUndecided(var checker: Checker, annotation: TypeId): Bool {
  match checker.types.form(annotation) {
    // A **`const`** parameter is a value, not a type: `<const Size: Int>` read as a value is an `Int` that the call
    // site fills in, and `0..Rows` has to keep working. A type parameter is rigid and says exactly one thing
    .Parameter(parameter) => checker.types.parameter(parameter).isConst
    .Variable(_) => true
    // A type that carries one of these anywhere inside of it says as little as the type itself would
    .Invalid => true
    .Deferred => true
    .Nominal(_, arguments) => {
      for argument in arguments {
        if isUndecided(checker, argument) {
          return true
        }
      }
      false
    }
    .Tuple(fields) => {
      for field in fields {
        if isUndecided(checker, field.annotation) {
          return true
        }
      }
      false
    }
    .Function(form) => {
      for parameter in form.parameters {
        if isUndecided(checker, parameter.annotation) {
          return true
        }
      }
      isUndecided checker, form.result
    }
    _ => false
  }
}

// --- Deferring a broken construct ------------------------------------------------------------------------------------

/**
 * Records an expression, and everything in it, as `Deferred`: used where the construct around it could not be
 * resolved, so there is nothing to check its parts against. The type positions inside of it are still built - they
 * do not depend on anything here - and so are the signatures of declarations in nested blocks, so that a deferred
 * closure body still contributes everything a later lookup expects to find.
 */
public fn deferExpression(var checker: Checker, expression: Expression) {
  const deferred = checker.deferredType
  const _ = checker.typed expression.span, deferred
  match expression.kind {
    .Generic(target, arguments) => {
      deferExpression checker, target
      deferTypeArguments checker, arguments
    }
    .Closure(closure) => {
      deferClosureParameters checker, closure
      deferBlock checker, closure.body
    }
    .If(condition, then, otherwise) => {
      deferCondition checker, condition
      deferBlock checker, then
      if const Some(alternative) = otherwise {
        deferExpression checker, alternative
      }
    }
    .Match(subject, arms) => {
      deferExpression checker, subject
      for arm in arms {
        if const Some(guard) = arm.guard {
          deferExpression checker, guard
        }
        deferExpression checker, arm.body
      }
    }
    .Block(block) => deferBlock checker, block
    .TextLiteral(segments) => {
      for segment in segments {
        if const .Interpolated(inner) = segment {
          deferExpression checker, inner
        }
      }
    }
    .TupleLiteral(items) => deferArguments checker, items
    .ListLiteral(items) => deferArguments checker, items
    .MapLiteral(entries) => deferEntries checker, entries
    .Member(target, _, _) => deferExpression checker, target
    .Index(target, index) => {
      deferExpression checker, target
      deferExpression checker, index
    }
    .Call(callee, arguments, _) => {
      deferExpression checker, callee
      deferArguments checker, arguments
    }
    .Unary(_, operand) => deferExpression checker, operand
    .Binary(_, left, right) => {
      deferExpression checker, left
      deferExpression checker, right
    }
    .RangeLiteral(start, end, _) => {
      if const Some(from) = start {
        deferExpression checker, from
      }
      if const Some(to) = end {
        deferExpression checker, to
      }
    }
    .Try(inner) => deferExpression checker, inner
    _ => {}
  }
}

/** Every argument's value, deferred: used for a call whose callee could not be resolved to a function. */
public fn deferArguments(var checker: Checker, arguments: List<Argument>) {
  for argument in arguments {
    deferExpression checker, argument.value
  }
}

/** The explicit type arguments of an expression are still built: which parameter they fill is decided once the callee resolves. */
fn deferTypeArguments(var checker: Checker, arguments: List<TypeReference>) {
  const scope = scopeHere checker
  for argument in arguments {
    const _ = typeFromReference checker, argument, scope.forEither()
  }
}

/** The type of every annotated parameter of a closure whose body is deferred, without checking the body itself. */
public fn deferClosureParameters(var checker: Checker, closure: Closure) {
  const scope = scopeHere checker
  for parameter in closure.parameters {
    if const Some(annotation) = parameter.annotation {
      const _ = typeFromReference checker, annotation, scope.forType()
    }
  }
}

fn deferEntries(var checker: Checker, entries: List<(Expression, Expression)>) {
  for (key, value) in entries {
    deferExpression checker, key
    deferExpression checker, value
  }
}

fn deferCondition(var checker: Checker, condition: Condition) {
  match condition {
    .Test(expression) => deferExpression checker, expression
    .Bind(_, _, value) => deferExpression checker, value
  }
}

/** A block whose statements are not checked: its declarations still get their signatures and its types their ids. */
public fn deferBlock(var checker: Checker, block: Block) {
  for statement in block.statements {
    deferStatement checker, statement
  }
}

fn deferStatement(var checker: Checker, statement: Statement) {
  const scope = scopeHere checker
  match statement.kind {
    .Declare(declaration) => checkDeclaration checker, scope, declaration
    .Bind(binding) => {
      if const Some(annotation) = binding.annotation {
        const _ = typeFromReference checker, annotation, scope.forType()
      }
      deferExpression checker, binding.value
    }
    .Assign(target, value) => {
      deferExpression checker, target
      deferExpression checker, value
    }
    .For(_, iterable, body) => {
      deferExpression checker, iterable
      deferBlock checker, body
    }
    .While(condition, body) => {
      deferCondition checker, condition
      deferBlock checker, body
    }
    .Loop(body) => deferBlock checker, body
    .Return(value) => {
      if const Some(expression) = value {
        deferExpression checker, expression
      }
    }
    .Break => {}
    .Continue => {}
    .Evaluate(expression) => deferExpression checker, expression
  }
}
