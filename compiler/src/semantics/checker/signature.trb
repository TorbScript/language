/**
 * What a declaration is, as a type: builds a [Signature] for a `fn`, a method, a field or a `const`, and a
 * [TypeSignature] for a `type` or a `trait`. A signature is built the first time somebody asks for it and kept
 * afterwards, because building one needs the types of other declarations - and an alias that names itself is the one
 * cycle that can come out of that.
 *
 * Turning the syntax of a type into a type is `lowering.trb`, which this file uses and which uses it back.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Name, Statement, Binding, Declaration, Visibility from "../../syntax/ast"
use TypeReference, GenericParameter, WhereClause, TraitClause from "../../syntax/ast"
use FunctionDeclaration, Parameter, Member, Field, CaseDeclaration from "../../syntax/ast"
use ModuleId from "../module"
use SymbolId, SymbolKind, Symbol, boundNamesOf from "../symbols"
use TypeId, TypeForm, FunctionForm, ParameterForm, ParameterMode from "./type"
use ParameterId, ParameterDeclaration from "./type"
use Bound, Signature, SignatureId, SignatureState, FieldSignature, CaseSignature, DelegatedTrait from "./type"
use TypeSignature, TypeSignatureId from "./type"
use Checker, TypeScope, DeclarationSite, DeclarationSiteKind, ResultRule from "./context"
use typeFromReference, traitsFromReference from "./lowering"
use substituteFunction from "./unify"
use checkFunctionBody, checkInitializer, checkDestructuredBinding, taskValueOf from "./statement"
use isSharedType, isSharedTrait, allowsTopLevelCode from "./declaration"

// --- Generic parameters and `Self` ----------------------------------------------------------------------------------

/**
 * The generic parameters of a declaration, the ones of the declaration around it first. Separate from the signature
 * and cheap on purpose: an arity check must not have to build the whole signature of a type.
 */
public fn genericsOf(var checker: Checker, symbol: SymbolId): List<ParameterId> {
  if const Some(found) = checker.genericParameters.get(symbol) {
    return found
  }
  const site = match checker.siteOf(symbol) {
    Some(found) => found
    None => {
      checker.genericParameters.set symbol, []
      return []
    }
  }
  var parameters = enclosingParameters site
  parameters.appendAll declareParameters(checker, site.module, symbol, declaredParameters(site))
  checker.genericParameters.set symbol, parameters
  parameters
}

/**
 * The parameters of one parameter list. An `extend` has no symbol of its own, so its parameters have no owner - and
 * a parameter without an owner is exactly as good a parameter as any other.
 */
public fn declareParameters(
  var checker: Checker,
  module: ModuleId,
  owner: SymbolId?,
  declared: List<GenericParameter>,
): List<ParameterId> {
  var parameters: List<ParameterId> = []
  for index in 0..declared.length() {
    const parameter = declared[index]
    const symbol = checker.resolvedName module, parameter.name.span
    parameters.append(checker.types.declareParameter(ParameterDeclaration(
      parameter.name.text,
      symbol,
      owner,
      parameter.const,
      index,
      parameter.default,
      module,
    )))
  }
  parameters
}

fn enclosingParameters(site: DeclarationSite): List<ParameterId> {
  match site.kind {
    .Owned(_, generics, _) => generics
    _ => []
  }
}

fn declaredParameters(site: DeclarationSite): List<GenericParameter> {
  match site.kind {
    .Declared(declaration) => {
      match declaration.kind {
        .Function(function) => function.generics
        .Type(typeDeclaration) => typeDeclaration.generics
        .Alias(alias) => alias.generics
        .Trait(traitDeclaration) => traitDeclaration.generics
        _ => []
      }
    }
    .Owned(_, _, member) => {
      if const .Function(function) = member.kind {
        return function.generics
      }
      []
    }
    _ => []
  }
}

/**
 * What `Self` means inside a declaration. In a `trait` it is an ordinary generic parameter whose one bound is the
 * trait itself, which is what makes `fn combine(other: Self): Self` an ordinary signature. In a `type` it is
 * that type with its own parameters as arguments.
 */
public fn selfTypeOf(var checker: Checker, symbol: SymbolId): TypeId {
  if const Some(found) = checker.selfTypes.get(symbol) {
    return found
  }
  const generics = genericsOf checker, symbol
  const module = checker.symbolAt(symbol).module ?? ModuleId(0)
  var built = checker.invalidType
  if const .Trait = checker.symbolAt(symbol).kind {
    const parameter = checker.types.declareParameter(ParameterDeclaration(
      "Self",
      symbol: None,
      owner: symbol,
      const: false,
      index: -1,
      default: None,
      module: module,
    ))
    built = checker.types.intern TypeForm.Parameter(parameter)
    // The one bound of `Self` is the trait itself, which is what makes a member lookup on it find the trait's members
    var arguments: List<TypeId> = []
    for own in generics {
      arguments.append checker.types.intern(TypeForm.Parameter(own))
    }
    const bound = checker.nominal symbol, arguments
    checker.parameterBounds.set parameter.value, [bound]
  } else {
    var arguments: List<TypeId> = []
    for parameter in generics {
      arguments.append checker.types.intern(TypeForm.Parameter(parameter))
    }
    built = checker.nominal symbol, arguments
  }
  checker.selfTypes.set symbol, built
  built
}

// --- Aliases --------------------------------------------------------------------------------------------------------

/**
 * The target of an alias, in terms of the alias's own parameters, built once. An alias that names itself - directly
 * or through another one - is the one cycle the checker can run into while it builds a type.
 */
public fn aliasTargetOf(var checker: Checker, symbol: SymbolId): TypeId {
  match checker.aliasStates.get(symbol) ?? SignatureState.Missing {
    .Ready(index) => {
      return checker.aliasTargets[index]
    }
    .Failed => {
      return checker.invalidType
    }
    .Running => {
      checker.aliasStates.set symbol, SignatureState.Failed
      reportCycle checker, symbol
      return checker.invalidType
    }
    _ => {}
  }
  const site = match checker.siteOf(symbol) {
    Some(found) => found
    None => {
      checker.aliasStates.set symbol, SignatureState.Failed
      return checker.invalidType
    }
  }
  checker.aliasStates.set symbol, SignatureState.Running
  const _ = genericsOf checker, symbol
  var target = checker.invalidType
  if const .Declared(declaration) = site.kind {
    if const .Alias(alias) = declaration.kind {
      target = typeFromReference checker, alias.target, TypeScope(site.module)
    }
  }
  if isFailed(checker.aliasStates.get(symbol)) {
    return checker.invalidType
  }
  checker.aliasTargets.append target
  const index = checker.aliasTargets.length() - 1
  checker.aliasStates.set symbol, SignatureState.Ready(index)
  target
}

fn isFailed(state: SignatureState?): Bool {
  match state {
    Some(.Failed) => true
    _ => false
  }
}

/**
 * The three things that can cycle, each with the fix in the message: an alias that names itself, a function whose
 * result type has to be inferred from a body that calls it, and a `const` that is defined in terms of itself.
 */
fn reportCycle(var checker: Checker, symbol: SymbolId) {
  const declared = checker.symbolAt symbol
  const module = match declared.module {
    Some(found) => found
    None => {
      return
    }
  }
  const problem = match cycleKindOf(checker, symbol) {
    .Result => {
      const message = "The return type of `{declared.name}` cannot be inferred: it calls itself. Annotate it"
      Diagnostic.error message, declared.span
    }
    .Initializer => {
      const message = "The type of `{declared.name}` cannot be inferred: its value is defined in terms of itself"
      Diagnostic.error message, declared.span
    }
    .Alias => {
      const note = "An alias is another name for a type that exists."
        + " For a type of its own, write `type {declared.name} \{ ... \}`"
      Diagnostic.error("`{declared.name}` is a cycle: it names itself", declared.span).withNote(note)
    }
  }
  checker.report module, problem
}

/** Which of the three it is, read from the declaration the symbol came from. */
type CycleKind {
  case Alias
  case Result
  case Initializer
}

fn cycleKindOf(checker: Checker, symbol: SymbolId): CycleKind {
  const site = match checker.siteOf(symbol) {
    Some(found) => found
    None => {
      return CycleKind.Alias
    }
  }
  if const Some(function) = functionOfSite(site) {
    if function.returnType.isNone() && function.body.isSome() {
      return CycleKind.Result
    }
    return CycleKind.Alias
  }
  if const Some(binding) = bindingOfSite(site) {
    if binding.type.isNone() {
      return CycleKind.Initializer
    }
  }
  CycleKind.Alias
}

/** The `fn` a declaration site holds, whether it is a top-level one, a member or a `foreign` declaration. */
public fn functionOfSite(site: DeclarationSite): FunctionDeclaration? {
  match site.kind {
    .Declared(declaration) => {
      if const .Function(function) = declaration.kind {
        return function
      }
      None
    }
    .Owned(_, _, member) => {
      if const .Function(function) = member.kind {
        return function
      }
      None
    }
    _ => None
  }
}

/** The `const` a declaration site holds: a top-level one, or a member of a type. */
public fn bindingOfSite(site: DeclarationSite): Binding? {
  match site.kind {
    .Constant(binding) => binding
    .Declared(declaration) => {
      if const .Constant(binding) = declaration.kind {
        return binding
      }
      None
    }
    .Owned(_, _, member) => {
      if const .Constant(binding) = member.kind {
        return binding
      }
      None
    }
    .Destructured(binding) => binding
  }
}

/**
 * The type a declaration produces: the result of a function, the type of a `const` or of a field. Where it is not
 * annotated it is inferred from the body, which is what `signatureOf` does on the way.
 */
public fn resultOf(var checker: Checker, symbol: SymbolId): TypeId {
  const identifier = signatureOf checker, symbol
  checker.signature(identifier).form.result
}

// --- Signatures -----------------------------------------------------------------------------------------------------

/**
 * The signature of a `fn`, a method, a field, a `const` or a case constructor, built the first time somebody asks
 * and kept afterwards. Building it needs the types of other declarations, which is why it cannot happen up front.
 */
public fn signatureOf(var checker: Checker, symbol: SymbolId): SignatureId {
  // The body of this very declaration is being checked to find out what it returns, and it names itself. The answer
  // it gets is `Void`, which is right for every recursive statement; only if the body turns out to produce something
  // else is the assumption wrong, and `inferredSignature` reports it then.
  if checker.inferringResults.containsKey(symbol) {
    checker.inferringResults.set symbol, true
  }
  match checker.signatureStates.get(symbol) ?? SignatureState.Missing {
    .Ready(index) => {
      return SignatureId index
    }
    .Failed => {
      return checker.brokenSignature()
    }
    .Running => {
      checker.signatureStates.set symbol, SignatureState.Failed
      reportCycle checker, symbol
      return checker.brokenSignature()
    }
    _ => {}
  }
  const site = match checker.siteOf(symbol) {
    Some(found) => found
    None => {
      checker.signatureStates.set symbol, SignatureState.Failed
      return checker.brokenSignature()
    }
  }
  checker.signatureStates.set symbol, SignatureState.Running
  const built = buildSignature checker, symbol, site
  if isFailed(checker.signatureStates.get(symbol)) {
    return checker.brokenSignature()
  }
  // A declaration whose result is inferred registered its own signature before it checked its body, so that a call of
  // it inside of that body still sees the parameters it takes
  if const Some(.Ready(index)) = checker.signatureStates.get(symbol) {
    return SignatureId index
  }
  const identifier = checker.addSignature built
  checker.signatureStates.set symbol, SignatureState.Ready(identifier.value)
  identifier
}

/** A call of a generic signature: `map<Int>` on an `Iterate<String>`. */
public fn instantiate(var checker: Checker, signature: SignatureId, arguments: List<TypeId>): FunctionForm {
  const found = checker.signature signature
  var mapping: Map<ParameterId, TypeId> = [:]
  for index in 0..found.generics.length().min(arguments.length()) {
    mapping.set found.generics[index], arguments[index]
  }
  substituteFunction checker.types, found.form, mapping
}

fn buildSignature(var checker: Checker, symbol: SymbolId, site: DeclarationSite): Signature {
  match site.kind {
    .Declared(declaration) => {
      match declaration.kind {
        .Function(function) => {
          const rule = if declaration.modifiers.visibility == Visibility.Public {
            ResultRule.PublicFunction
          } else {
            ResultRule.Ordinary
          }
          functionSignature checker, symbol, site.module, function, owner: None, rule: rule
        }
        .Constant(binding) => constantSignature checker, symbol, site.module, binding, owner: None
        // A `type`, a `trait` and an alias are not values: `typeSignatureOf` answers for them
        _ => brokenSignatureOf checker, symbol
      }
    }
    .Owned(owner, _, member) => {
      match member.kind {
        .Function(function) => {
          const rule = memberResultRule checker, member, owner
          functionSignature checker, symbol, site.module, function, owner, rule
        }
        .Field(field) => {
          const scope = TypeScope site.module, selfType: owner
          const annotation = typeFromReference checker, field.type, scope.forType()
          Signature(
            symbol,
            genericsOf(checker, symbol),
            FunctionForm([], annotation),
            [],
            owner,
            takesSelf: false,
            takesVarSelf: false,
            hasBody: false,
          )
        }
        .Constant(binding) => constantSignature checker, symbol, site.module, binding, owner
        // `Shape.Circle(1.0)`: a case is a function from its fields to the type it belongs to
        .Case(caseDeclaration) => caseSignature checker, symbol, site.module, caseDeclaration, owner
      }
    }
    .Constant(binding) => constantSignature checker, symbol, site.module, binding, owner: None
    .Destructured(binding) => destructuredSignature checker, symbol, site.module, binding
  }
}

/**
 * One name of a top-level binding that destructures. The names share one initializer, so the binding is checked exactly
 * once - as the statement it is, in a scope of its own that is thrown away again - and every name reads the type
 * `checkPattern` recorded at its own span back out. The names are declarations of the file and not locals of its
 * statement sequence, which is what lets a function of the module read one.
 */
fn destructuredSignature(var checker: Checker, symbol: SymbolId, module: ModuleId, binding: Binding): Signature {
  checkDestructuredBinding checker, module, binding
  const at = checker.symbolAt(symbol).span
  const annotation = checker.patternType(module, at) ?? checker.invalidType
  Signature(
    symbol,
    [],
    FunctionForm([], annotation),
    [],
    owner: None,
    takesSelf: false,
    takesVarSelf: false,
    hasBody: true,
  )
}

/**
 * Which declarations do not infer their result. A member of a `type` still does - members are public unless marked
 * `private`, so the rule is about the `public` *modifier* - and a member of a trait never does, because it is what
 * an implementor writes against.
 */
fn memberResultRule(checker: Checker, member: Member, owner: TypeId?): ResultRule {
  if isTraitOwner(checker, owner) {
    return ResultRule.TraitMethod
  }
  if member.modifiers.visibility == Visibility.Public {
    return ResultRule.PublicFunction
  }
  ResultRule.Ordinary
}

/** Inside a trait, `Self` is the parameter `selfTypeOf` declared for it: the one with no position of its own. */
fn isTraitOwner(checker: Checker, owner: TypeId?): Bool {
  const annotation = match owner {
    Some(found) => found
    None => {
      return false
    }
  }
  if const .Parameter(parameter) = checker.types.form(annotation) {
    return checker.types.parameter(parameter).index == -1
  }
  false
}

/**
 * Whether the declaration is a constant of a trait - `static zero: Self`, or one with a default value. Its `Self` is the
 * trait's own parameter, so what a read of it produces is decided by the type the read reaches it on, and the back end
 * reads the implementation's constant or instantiates the default for that type.
 */
public fn isTraitConstant(var checker: Checker, symbol: SymbolId): Bool {
  if const .Constant = checker.symbolAt(symbol).kind {
    const identifier = signatureOf checker, symbol
    return isTraitOwner checker, checker.signature(identifier).owner
  }
  false
}

fn brokenSignatureOf(checker: Checker, symbol: SymbolId): Signature {
  Signature(
    symbol,
    [],
    FunctionForm([], checker.invalidType),
    [],
    owner: None,
    takesSelf: false,
    takesVarSelf: false,
    hasBody: false,
  )
}

/** Without an annotation the type of a `const` is the type of its initializer, which is checked here and once. */
fn constantSignature(
  var checker: Checker,
  symbol: SymbolId,
  module: ModuleId,
  binding: Binding,
  owner: TypeId?,
): Signature {
  const scope = TypeScope module, selfType: owner
  // `static zero: Self`: the requirement of a trait, whose value every implementation provides. It has a type and no
  // body, like a `fn` a trait requires, and anywhere but in a trait it is a constant that forgot its value
  if binding.required {
    const annotation = match binding.type {
      Some(reference) => typeFromReference checker, reference, scope.forType()
      None => checker.invalidType
    }
    checker.checkedBodies.set symbol, true
    if !isTraitOwner(checker, owner) {
      checker.report(
        module,
        Diagnostic.error("A constant of the type needs a value", binding.pattern.span)
          .withNote("Only a trait requires a constant without one, and every implementation of the trait provides it"),
      )
    }
    return Signature(
      symbol,
      genericsOf(checker, symbol),
      FunctionForm([], annotation),
      [],
      owner,
      takesSelf: false,
      takesVarSelf: false,
      hasBody: false,
    )
  }
  const generics = genericsOf checker, symbol
  // A top-level `const` of an entry file or a script is ordinary code, so `await()` is allowed in its initializer
  const awaits = owner.isNone() && allowsTopLevelCode(checker, module)
  // An annotated initializer is checked here too, and not where the declaration is walked: the annotation *is* the
  // signature, so nobody would ask for the value again - and a `const` that holds a receiver closure
  // (`const perimeter: (self: Rectangle) => Int`) would never have its body looked at
  const annotation = match binding.type {
    Some(reference) => {
      const built = typeFromReference checker, reference, scope.forType()
      checker.checkedBodies.set symbol, true
      const _ = checkInitializer checker, module, binding.value, owner, built, awaitsTasks: awaits, generics: generics
      built
    }
    None => {
      checker.checkedBodies.set symbol, true
      checkInitializer checker, module, binding.value, owner, annotation: None, awaitsTasks: awaits, generics: generics
    }
  }
  Signature(
    symbol,
    generics,
    FunctionForm([], annotation),
    [],
    owner,
    takesSelf: false,
    takesVarSelf: false,
    hasBody: true,
  )
}

fn functionSignature(
  var checker: Checker,
  symbol: SymbolId,
  module: ModuleId,
  function: FunctionDeclaration,
  owner: TypeId?,
  rule: ResultRule,
): Signature {
  const generics = genericsOf checker, symbol
  const scope = TypeScope module, selfType: owner
  var parameters: List<ParameterForm> = []
  var takesSelf = false
  var isVarSelf = false
  for parameter in function.parameters {
    if parameter.name.text == "self" && parameter.type.isNone() {
      takesSelf = true
      isVarSelf = parameter.var
      continue
    }
    parameters.append parameterForm(checker, parameter, scope)
    // `fn find(id: EntityId)`: what a message about an argument of it calls the type (`Checker.parameterAliases`)
    if const Some(reference) = parameter.type {
      if const Some(written) = checker.aliasNameAt(module, reference.span) {
        checker.parameterAliases.set "{symbol.value}:{parameters.length() - 1}", written
      }
    }
  }
  const hasBody = function.body.isSome()
  const bounds = boundsOf checker, generics, function.generics, function.whereClauses, scope
  if const Some(annotation) = function.returnType {
    const result = typeFromReference checker, annotation, scope.forType()
    requireSharedForTaskChanges checker, module, function, parameters, owner, isVarSelf, result
    return Signature symbol, generics, FunctionForm(parameters, result), bounds, owner, takesSelf, isVarSelf, hasBody
  }
  // Without a body there is nothing to infer from, so the result is `Void`
  if !hasBody {
    const voidType = checker.voidType
    return Signature(
      symbol,
      generics,
      FunctionForm(parameters, voidType),
      bounds,
      owner,
      takesSelf,
      isVarSelf,
      hasBody: false,
    )
  }
  inferredSignature checker, symbol, module, function, generics, parameters, bounds, owner, takesSelf, isVarSelf, rule
}

/**
 * A `fn` with a body and no result type: the body is the answer, so it is checked right here. The signature is
 * registered *before* that with an `Invalid` result, so that a call inside of the body still sees the parameters it
 * takes - and asking for that signature while it is being built is the recursion `reportCycle` names.
 *
 * A `public` function and a trait method do not infer: their result stays the `Void` the signature was registered
 * with, and a body that produces a value is reported where the value stands.
 */
fn inferredSignature(
  var checker: Checker,
  symbol: SymbolId,
  module: ModuleId,
  function: FunctionDeclaration,
  generics: List<ParameterId>,
  parameters: List<ParameterForm>,
  bounds: List<Bound>,
  owner: TypeId?,
  takesSelf: Bool,
  isVarSelf: Bool,
  rule: ResultRule,
): Signature {
  const voidType = checker.voidType
  const provisional = Signature(
    symbol,
    generics,
    FunctionForm(parameters, voidType),
    bounds,
    owner,
    takesSelf,
    isVarSelf,
    hasBody: true,
  )
  const identifier = checker.addSignature provisional
  checker.signatureStates.set symbol, SignatureState.Ready(identifier.value)
  checker.inferringResults.set symbol, false
  checker.checkedBodies.set symbol, true
  const result = checkFunctionBody(
    checker,
    module,
    function,
    owner,
    generics,
    parameters,
    takesSelf,
    isVarSelf,
    voidType,
    isInferred: true,
    rule: rule,
    declared: symbol,
  )
  const namedItself = checker.inferringResults.get(symbol) ?? false
  const _ = checker.inferringResults.remove symbol
  // A declaration that does not infer keeps the `Void` it was registered with, whatever its body produced
  if const Some(_) = rule.describe() {
    return provisional
  }
  // The recursion assumed `Void`, and the body produces something else: only an annotation can settle that
  if namedItself && result != voidType && result != checker.neverType {
    reportCycle checker, symbol
  }
  const found = provisional.copy form: FunctionForm(parameters, result)
  checker.signatures.set identifier.value, found
  requireSharedForTaskChanges checker, module, function, parameters, owner, isVarSelf, result
  found
}

/**
 * A function that answers a `Task` and changes a **value** through a `var`. The change would have to be written back
 * when the call returns, which is *before* the task has run, so it would be lost - and losing it silently is worse than
 * saying so here.
 *
 * A `shared type` is the exception this rule exists for. There `var` is a permission to change the one object and not
 * an exclusive access that ends with the call (CONCEPT, "Identity"), which is what lets `Source.next()` answer
 * a `Task` exactly as `Iterator.next()` answers an item.
 */
fn requireSharedForTaskChanges(
  var checker: Checker,
  module: ModuleId,
  function: FunctionDeclaration,
  parameters: List<ParameterForm>,
  owner: TypeId?,
  isVarSelf: Bool,
  result: TypeId,
) {
  if taskValueOf(checker, result).isNone() {
    return
  }
  const name = function.name.text
  if isVarSelf {
    reportValueChangedByTask checker, module, name, "self", owner, function.name.span
  }
  // The parameter list of the signature has no entry for `self`, so the two walk side by side by name
  var index = 0
  for parameter in function.parameters {
    if parameter.name.text == "self" && parameter.type.isNone() {
      continue
    }
    if parameter.var {
      const annotation = match parameters.get(index) {
        Some(form) => Some form.type
        None => None
      }
      reportValueChangedByTask checker, module, name, parameter.name.text, annotation, parameter.name.span
    }
    index = index + 1
  }
}

fn reportValueChangedByTask(
  var checker: Checker,
  module: ModuleId,
  name: String,
  changed: String,
  annotation: TypeId?,
  at: Span,
) {
  const subject = match annotation {
    Some(found) => found
    None => {
      return
    }
  }
  if checker.absorbs(subject) || isSharedType(checker, subject) {
    return
  }
  // `Self` inside a `trait`: the parameter knows the declaration it belongs to, and a `shared trait` is shared
  if const .Parameter(parameter) = checker.types.form(subject) {
    const declared = checker.types.parameter parameter
    if declared.index != -1 {
      return
    }
    const declaring = match declared.owner {
      Some(found) => found
      None => {
        return
      }
    }
    if isSharedTrait(checker, declaring) {
      return
    }
    const traitName = checker.symbolAt(declaring).name
    checker.report(
      module,
      Diagnostic.error(
        "`{name}` changes `{changed}` and answers a `Task`, and `{traitName}` is not a `shared trait`",
        at,
      )
        .withNote("An ordinary trait can be implemented by a value, and a value cannot be changed by a task: write `shared trait {traitName}`"),
    )
    return
  }
  const shown = checker.describe subject
  checker.report(
    module,
    Diagnostic.error("`{name}` changes `{changed}` and answers a `Task`, and `{shown}` is a value", at)
      .withNote("A `var` of a value is copy in, copy out, and the copy back happens when the call returns - before the task has run. Only a `shared type` can be changed by a task"),
  )
}

fn caseSignature(
  var checker: Checker,
  symbol: SymbolId,
  module: ModuleId,
  caseDeclaration: CaseDeclaration,
  owner: TypeId?,
): Signature {
  const generics = genericsOf checker, symbol
  const scope = TypeScope module, selfType: owner
  var parameters: List<ParameterForm> = []
  for field in caseDeclaration.fields {
    const annotation = typeFromReference checker, field.type, scope.forType()
    parameters.append ParameterForm(field.name.text, ParameterMode.Value, annotation, field.default.isSome())
  }
  const result = owner ?? checker.invalidType
  Signature(
    symbol,
    generics,
    FunctionForm(parameters, result),
    [],
    owner,
    takesSelf: false,
    takesVarSelf: false,
    hasBody: false,
  )
}

fn parameterForm(var checker: Checker, parameter: Parameter, scope: TypeScope): ParameterForm {
  var mode = if parameter.var { ParameterMode.Var } else { ParameterMode.Value }
  if parameter.variadic {
    mode = ParameterMode.Variadic
  }
  var annotation = checker.invalidType
  if const Some(reference) = parameter.type {
    if const .Lazy(inner) = reference.kind {
      mode = ParameterMode.Lazy
      annotation = typeFromReference checker, inner, scope.forType()
      checker.recordType scope.module, reference.span, annotation
    } else {
      annotation = typeFromReference checker, reference, scope.forType()
    }
  }
  const name = if parameter.name.text.isEmpty() { None } else { Some parameter.name.text }
  ParameterForm name, mode, annotation, parameter.default.isSome()
}

/** `<Item: Hash>` and `where Item: Hash` are the same thing, so both land here. */
public fn boundsOf(
  var checker: Checker,
  generics: List<ParameterId>,
  declared: List<GenericParameter>,
  clauses: List<WhereClause>,
  scope: TypeScope,
): List<Bound> {
  var bounds: List<Bound> = []
  const offset = generics.length() - declared.length()
  for index in 0..declared.length() {
    const parameter = declared[index]
    // `<Value = Key>`: the default is a type position of the declaration, however a later use of it fills the list
    if const Some(default) = parameter.default {
      const inner = if parameter.const { scope.forConstant() } else { scope.forType() }
      const _ = typeFromReference checker, default, inner
    }
    if parameter.const {
      // `<const Size: Int>`: the single item of `bounds` is the type of the value, not a trait, and it is what
      // `Size` read as a value has
      for bound in parameter.bounds {
        const value = typeFromReference checker, bound, scope.forType()
        checker.constantValueTypes.set generics[offset + index].value, value
      }
      continue
    }
    if parameter.bounds.isEmpty() {
      continue
    }
    const subject = checker.types.intern TypeForm.Parameter(generics[offset + index])
    addBound checker, bounds, subject, parameter.bounds, scope
  }
  for clause in clauses {
    const subject = typeFromReference checker, clause.subject, scope.forType()
    addBound checker, bounds, subject, clause.bounds, scope
  }
  bounds
}

fn addBound(
  var checker: Checker,
  var bounds: List<Bound>,
  subject: TypeId,
  references: List<TypeReference>,
  scope: TypeScope,
) {
  var traits: List<TypeId> = []
  for reference in references {
    traits.appendAll traitsFromReference(checker, reference, subject, scope)
  }
  if traits.isEmpty() {
    return
  }
  bounds.append Bound(subject, traits)
  // `<Item: Hash>` and `where Item: Hash` are what a member lookup on `Item` may see (design 4.1, `Parameter`)
  if const .Parameter(parameter) = checker.types.form(subject) {
    var known = checker.parameterBounds.get(parameter.value) ?? []
    for bound in traits {
      if !known.contains(bound) {
        known.append bound
      }
    }
    checker.parameterBounds.set parameter.value, known
  }
}

// --- Type signatures ------------------------------------------------------------------------------------------------

/** What a `type` or a `trait` declaration says about its instances: its parameters, traits, fields, cases, members. */
public fn typeSignatureOf(var checker: Checker, symbol: SymbolId): TypeSignatureId {
  match checker.typeSignatureStates.get(symbol) ?? SignatureState.Missing {
    .Ready(index) => {
      return TypeSignatureId index
    }
    .Failed => {
      return checker.brokenTypeSignature()
    }
    .Running => {
      checker.typeSignatureStates.set symbol, SignatureState.Failed
      reportCycle checker, symbol
      return checker.brokenTypeSignature()
    }
    _ => {}
  }
  const site = match checker.siteOf(symbol) {
    Some(found) => found
    None => {
      checker.typeSignatureStates.set symbol, SignatureState.Failed
      return checker.brokenTypeSignature()
    }
  }
  checker.typeSignatureStates.set symbol, SignatureState.Running
  const built = buildTypeSignature checker, symbol, site
  if isFailed(checker.typeSignatureStates.get(symbol)) {
    return checker.brokenTypeSignature()
  }
  const identifier = checker.addTypeSignature built
  checker.typeSignatureStates.set symbol, SignatureState.Ready(identifier.value)
  identifier
}

fn buildTypeSignature(var checker: Checker, symbol: SymbolId, site: DeclarationSite): TypeSignature {
  const generics = genericsOf checker, symbol
  const own = selfTypeOf checker, symbol
  const scope = TypeScope site.module, selfType: own
  const declaration = match site.kind {
    .Declared(found) => found
    _ => {
      return TypeSignature symbol, generics, own, [], [], [], [], [:], native: false, shared: false
    }
  }
  match declaration.kind {
    .Type(typeDeclaration) => {
      var body = MemberSet()
      collectMembers checker, body, symbol, site.module, own, generics, typeDeclaration.members, scope
      const traits = delegatedTraitList(
        checker,
        typeDeclaration.traits,
        own,
        scope,
        typeDeclaration.name,
        body.fields,
        !body.cases.isEmpty(),
      )
      const bounds = boundsOf checker, generics, typeDeclaration.generics, typeDeclaration.whereClauses, scope
      TypeSignature(
        symbol,
        generics,
        own,
        traits,
        bounds,
        body.fields,
        body.cases,
        body.members,
        declaration.modifiers.native,
        declaration.modifiers.shared,
      )
    }
    .Trait(traitDeclaration) => {
      const traits = plainTraitList checker, traitDeclaration.supertraits, own, scope
      const bounds = boundsOf checker, generics, traitDeclaration.generics, [], scope
      var body = MemberSet()
      collectMembers checker, body, symbol, site.module, own, generics, traitDeclaration.members, scope
      TypeSignature(
        symbol,
        generics,
        own,
        traits,
        bounds,
        body.fields,
        body.cases,
        body.members,
        declaration.modifiers.native,
        declaration.modifiers.shared,
      )
    }
    _ => TypeSignature symbol, generics, own, [], [], [], [], [:], native: false, shared: false
  }
}

/** `with Show, Encode` of an `extend`, and the supertraits of a trait: every one of them, flattened. */
public fn traitList(var checker: Checker, references: List<TypeReference>, of: TypeId, scope: TypeScope): List<TypeId> {
  var traits: List<TypeId> = []
  for reference in references {
    for bound in traitsFromReference(checker, reference, of, scope) {
      if !traits.contains(bound) {
        traits.append bound
      }
    }
  }
  traits
}

/** The supertraits of a trait, none of them delegated (only a `type` has fields). */
fn plainTraitList(
  var checker: Checker,
  references: List<TypeReference>,
  of: TypeId,
  scope: TypeScope,
): List<DelegatedTrait> {
  traitList(checker, references, of, scope).map { capability => DelegatedTrait capability, delegate: None }.toList()
}

/**
 * `with Show, (Add, Subtract) by value, Compare by value`: one `DelegatedTrait` per trait, `Show` derives or is
 * hand-written, `Add`, `Subtract` and `Compare` are forwarded to `value`. `by` needs a type with exactly one field,
 * named by `by` itself - checked here, once per clause, against the fields this same declaration just collected.
 */
fn delegatedTraitList(
  var checker: Checker,
  clauses: List<TraitClause>,
  of: TypeId,
  scope: TypeScope,
  typeName: Name,
  fields: List<FieldSignature>,
  hasCases: Bool,
): List<DelegatedTrait> {
  var traits: List<DelegatedTrait> = []
  for clause in clauses {
    var delegate: String? = None
    if const Some(name) = clause.delegate {
      // A `by` that names no usable field was reported, and it still says the members come from somewhere: the trait's
      // requirements are not reported a second time as missing
      delegate = delegateFieldOf(checker, scope.module, typeName, name, fields, hasCases) ?? name.text
    }
    for capability in traitsFromReference(checker, clause.trait, of, scope) {
      if !containsCapability(traits, capability) {
        traits.append DelegatedTrait(capability, delegate)
      }
    }
  }
  traits
}

fn containsCapability(traits: List<DelegatedTrait>, capability: TypeId): Bool {
  for existing in traits {
    if existing.trait == capability {
      return true
    }
  }
  false
}

/** The field `by name` names, or `None` with a diagnostic already reported at `name`. */
fn delegateFieldOf(
  var checker: Checker,
  module: ModuleId,
  typeName: Name,
  name: Name,
  fields: List<FieldSignature>,
  hasCases: Bool,
): String? {
  if hasCases {
    checker.report(
      module,
      Diagnostic.error("`by` needs a type with a single field: `{typeName.text}` has cases, not fields", name.span),
    )
    return None
  }
  if fields.length() != 1 {
    checker.report(
      module,
      Diagnostic.error(
        "`by` needs a type with a single field: `{typeName.text}` has {describeFields(fields)}",
        name.span,
      ),
    )
    return None
  }
  const only = fields[0]
  if only.name != name.text {
    checker.report(
      module,
      Diagnostic.error(
        "`by` names the field of the type: `{typeName.text}` has `{only.name}`, not `{name.text}`",
        name.span,
      ),
    )
    return None
  }
  only.name
}

/** `has no fields`, `` has `amount` ``, `` has `amount` and `currency` ``. */
fn describeFields(fields: List<FieldSignature>): String {
  if fields.isEmpty() {
    return "no fields"
  }
  const shown = fields.map { field => "`{field.name}`" }.toList()
  if shown.length() == 1 {
    return shown[0]
  }
  "{shown.slice(0..(shown.length() - 1)).joined(separator: ", ")} and {shown[shown.length() - 1]}"
}

/** What a declaration body contributes, in one value so that one `var` parameter can collect all of it. */
type MemberSet {
  var fields: List<FieldSignature> = []
  var cases: List<CaseSignature> = []
  var members: Map<String, SymbolId> = [:]
}

/**
 * Every field, case, constant and function of a body gets an id here, and where it is written is remembered, so that
 * `signatureOf` can build its type later. That is what makes a member something a message can point at.
 */
fn collectMembers(
  var checker: Checker,
  var body: MemberSet,
  owner: SymbolId,
  module: ModuleId,
  own: TypeId,
  generics: List<ParameterId>,
  members: List<Member>,
  scope: TypeScope,
) {
  for member in members {
    const site = DeclarationSite module, DeclarationSiteKind.Owned(own, generics, member)
    match member.kind {
      .Field(field) => {
        const symbol = defineMember checker, module, field.name, SymbolKind.Field(owner), member
        checker.addSite symbol, site
        body.fields.append fieldSignature(checker, symbol, field, member, scope)
      }
      .Constant(binding) => {
        if const .Binding(name) = binding.pattern.kind {
          const at = Name name, binding.pattern.span
          const symbol = defineMember checker, module, at, SymbolKind.Constant, member
          checker.addSite symbol, site
          body.members.set name, symbol
        }
      }
      .Function(function) => {
        if !function.name.text.isEmpty() {
          const symbol = defineMember checker, module, function.name, SymbolKind.Function, member
          checker.addSite symbol, site
          body.members.set function.name.text, symbol
        }
      }
      // The cases of a type have their ids already: name resolution needed them for `use Option.Some, Option.None`
      .Case(caseDeclaration) => {
        if const Some(symbol) = checker.symbols.caseNamed(owner, caseDeclaration.name.text) {
          checker.addSite symbol, site
          var fields: List<FieldSignature> = []
          for field in caseDeclaration.fields {
            const fieldSymbol = defineMember checker, module, field.name, SymbolKind.Field(symbol), member
            fields.append fieldSignature(checker, fieldSymbol, field, member, scope)
          }
          body.cases.append CaseSignature(symbol, caseDeclaration.name.text, fields)
        }
      }
    }
  }
}

/**
 * The members of an `extend`. It has no symbol of its own - `implementation.trb` turns it into an implementation -
 * so its members only get their ids and where they are written, which is enough to build their types.
 */
public fn extensionMembers(
  var checker: Checker,
  module: ModuleId,
  target: TypeId,
  generics: List<ParameterId>,
  members: List<Member>,
): Map<String, SymbolId> {
  var found: Map<String, SymbolId> = [:]
  const scope = TypeScope module, selfType: target
  for member in members {
    const site = DeclarationSite module, DeclarationSiteKind.Owned(target, generics, member)
    match member.kind {
      .Function(function) => {
        if !function.name.text.isEmpty() {
          const symbol = defineMember checker, module, function.name, SymbolKind.Function, member
          checker.addSite symbol, site
          found.set function.name.text, symbol
        }
      }
      .Constant(binding) => {
        if const .Binding(name) = binding.pattern.kind {
          const symbol = defineMember checker, module, Name(name, binding.pattern.span), SymbolKind.Constant, member
          checker.addSite symbol, site
          found.set name, symbol
        }
      }
      // Fields and cases belong to the declaration of a type; one written on an `extend` is reported elsewhere
      .Field(field) => {
        const _ = typeFromReference checker, field.type, scope.forType()
      }
      .Case(caseDeclaration) => {
        for field in caseDeclaration.fields {
          const _ = typeFromReference checker, field.type, scope.forType()
        }
      }
    }
  }
  found
}

fn fieldSignature(
  var checker: Checker,
  symbol: SymbolId,
  field: Field,
  member: Member,
  scope: TypeScope,
): FieldSignature {
  const annotation = typeFromReference checker, field.type, scope.forType()
  // `private(var) balance: Int = 0` is an error that names `protected var balance: Int = 0`, and it means the same: the
  // field is writable, and only the file of its type may write it. The signature knows one spelling, `Protected`, so
  // nothing else is reported about it
  const visibility = match member.modifiers.visibility {
    .PrivateVar => Visibility.Protected
    other => other
  }
  const isPrivateVar = member.modifiers.visibility == Visibility.PrivateVar
  FieldSignature(symbol, field.name.text, annotation, field.var || isPrivateVar, field.default.isSome(), visibility)
}

/** `private` hides a member, `protected` only its writing: everything else a type has, it has in the open. */
fn defineMember(var checker: Checker, module: ModuleId, name: Name, kind: SymbolKind, member: Member): SymbolId {
  const isPublic = member.modifiers.visibility != Visibility.Private
  checker.symbols.add Symbol(name.text, kind, isPublic, module, name.span)
}

// --- Where a declaration is -----------------------------------------------------------------------------------------

/**
 * Remembers where the declarations of a statement list are written, so a signature can be built when somebody asks
 * for it. Called for the top level of every module and for every block, because a `fn` inside a block is a name of
 * that block and of nothing else.
 */
public fn declareSites(var checker: Checker, module: ModuleId, statements: List<Statement>) {
  for statement in statements {
    match statement.kind {
      .Declare(declaration) => declareSite checker, module, declaration
      // A plain top-level `const` is a statement; `public const` is a `Declaration` and goes through `declareSite`
      .Bind(binding) => declareBindingSites checker, module, binding
      _ => {}
    }
  }
}

/**
 * Where the names of one top-level binding come from. A plain name is a `Constant` site whose whole answer is the
 * initializer; a pattern that destructures gives every name it binds a `Destructured` site, and those share the one
 * initializer that stands in the binding.
 */
fn declareBindingSites(var checker: Checker, module: ModuleId, binding: Binding) {
  if const .Binding(_) = binding.pattern.kind {
    if const Some(symbol) = checker.resolvedName(module, binding.pattern.span) {
      checker.addSite symbol, DeclarationSite(module, DeclarationSiteKind.Constant(binding))
    }
    return
  }
  const site = DeclarationSite module, DeclarationSiteKind.Destructured(binding)
  for name in boundNamesOf(binding.pattern) {
    if const Some(symbol) = checker.resolvedName(module, name.span) {
      checker.addSite symbol, site
    }
  }
}

fn declareSite(var checker: Checker, module: ModuleId, declaration: Declaration) {
  match declaration.kind {
    .Function(function) => declareNamed checker, module, function.name, declaration
    .Type(typeDeclaration) => declareNamed checker, module, typeDeclaration.name, declaration
    .Alias(alias) => declareNamed checker, module, alias.name, declaration
    .Trait(traitDeclaration) => declareNamed checker, module, traitDeclaration.name, declaration
    .Constant(binding) => {
      if const .Binding(name) = binding.pattern.kind {
        declareNamed checker, module, Name(name, binding.pattern.span), declaration
        return
      }
      declareBindingSites checker, module, binding
    }
    // The functions of a `foreign` block are functions of the module, and their bodies are somewhere else entirely
    .Foreign(library) => {
      for member in library.members {
        if const .Function(function) = member.kind {
          if const Some(symbol) = checker.resolvedName(module, function.name.span) {
            checker.addSite(
              symbol,
              DeclarationSite(module, DeclarationSiteKind.Owned(owner: None, generics: [], member: member)),
            )
          }
        }
      }
    }
    _ => {}
  }
}

fn declareNamed(var checker: Checker, module: ModuleId, name: Name, declaration: Declaration) {
  if const Some(symbol) = checker.resolvedName(module, name.span) {
    checker.addSite symbol, DeclarationSite(module, DeclarationSiteKind.Declared(declaration))
  }
}
