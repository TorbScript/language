/**
 * Visibility and the shape of a program: who may name what, which files may contain code, and what a declaration is
 * allowed to look like. This is the part of the checker that reads declarations and not expressions.
 *
 * Two questions, and they are separate:
 *
 * 1. **Visibility** ([requireVisibleMember], [isInsideDeclaration]). `private` reaches exactly as far as the file that
 *    declares it - the body of the type, an `extend` of it in that file, and the functions of that file - and
 *    `protected var` hands out a read-only path instead of hiding the field. Whether the *path* that leads to a member
 *    may be written is a different question (`place.trb`'s mutability rules); whether this code may name the member at
 *    all is this one.
 * 2. **Program shape** ([checkShape]). A `public` function declares its result type, top-level code lives in entry
 *    files and scripts, a top-level `const` of a module is compile-time evaluable, an `extend` adds constants and
 *    functions, `native` belongs to the standard library, and a `shared type` only implements `shared trait`s.
 *
 * The shape pass runs *after* the bodies of a module were checked, because a constant is folded from what the names in
 * it resolved to.
 */

use Span from "../../syntax/source"
use staticKeyword from "../../syntax/token"
use Diagnostic from "../../syntax/diagnostic"
use Name, Modifiers, Visibility, Declaration, Member, Binding, Argument, Expression from "../../syntax/ast"
use FunctionDeclaration, TypeDeclaration, TraitDeclaration, ExtendDeclaration from "../../syntax/ast"
use ForeignDeclaration, TypeReference, TraitClause, Field from "../../syntax/ast"
use joinPath from "../../project/path"
use libraryEntry from "../../project/programs"
use ModuleId from "../module"
use SymbolId from "../symbols"
use resolveImport from "../graph"
use TypeId, FunctionForm, FieldSignature, ParameterId from "./type"
use Checker, Candidate, TypeScope, Unseen from "./context"
use Target from "./name"
use signatureOf, typeSignatureOf, aliasTargetOf, resultOf from "./signature"
use fieldsOf, caseNamed, caseNamesOf from "./member"
use substitute from "./unify"
use typeFromReference from "./lowering"
use implementsBound from "./implementation"
use checkConstantInitializer from "./constant"
use isFieldBecomingMethod from "./deprecation"

// --- Visibility of a member -----------------------------------------------------------------------------------------

/**
 * Whether this code may name the member it just found. Called from the member lookup, and deliberately *not* part of
 * the answer that is memoized there: the lookup depends on the module, this depends on the declaration the use stands
 * in.
 */
public fn requireVisibleMember(var checker: Checker, candidate: Candidate, name: String, at: Span?) {
  const member = match memberSymbolOf(candidate) {
    Some(found) => found
    None => {
      return
    }
  }
  if checker.symbolAt(member).public {
    return
  }
  const owner = ownerOfCandidate candidate
  const declaring = match declaringTypeOf(checker, member, owner) {
    Some(found) => found
    None => {
      return
    }
  }
  if isInsideDeclaration(checker, declaring) {
    return
  }
  const span = match at {
    Some(found) => found
    None => {
      return
    }
  }
  const shown = checker.symbolAt(declaring).name
  checker.reportHere(
    Diagnostic.error("`{name}` is private to `{shown}`", span)
      .withNote(
        "A private member is visible in the file that declares `{shown}` - its body, an `extend` of it there, and the"
          + " functions of that file - and nowhere else",
      ),
  )
}

fn memberSymbolOf(candidate: Candidate): SymbolId? {
  match candidate.kind {
    .Field(_, field) => field
    .Constant(_, symbol) => symbol
    .Method(_, symbol) => symbol
    _ => None
  }
}

fn ownerOfCandidate(candidate: Candidate): TypeId {
  match candidate.kind {
    .Field(owner, _) => owner
    .Constant(owner, _) => owner
    .Method(owner, _) => owner
    .CaseConstructor(owner, _) => owner
    .Construct(owner) => owner
    .Copy(owner) => owner
    .TupleField(owner, _) => owner
  }
}

/**
 * The type a member belongs to. A field knows it (`SymbolKind.Field` carries its owner, and the owner of a field of a
 * case is that case), and everything else is reached through the type it was found on.
 */
fn declaringTypeOf(checker: Checker, member: SymbolId, owner: TypeId): SymbolId? {
  if const .Field(declaring) = checker.symbolAt(member).kind {
    if const .Case(inner) = checker.symbolAt(declaring).kind {
      return inner
    }
    return declaring
  }
  headSymbolOf checker, owner
}

/**
 * **`private` reaches as far as the file that writes it.** What is private is visible in the file that declares it and
 * nowhere else: in the body of the type, in an `extend` of it that stands in the same file, and in a free function of
 * that file - one rule, and the same one a `private` top-level declaration already follows.
 *
 * The package is not the unit here, although it is the unit of coherence: an `extend Path` in another file of
 * `std/path` could otherwise write `Self(rootValue: ..., componentValues: ...)` and walk around the parser that is
 * the only way into the capsule.
 */
public fn isInsideDeclaration(var checker: Checker, declaring: SymbolId): Bool {
  const declared = checker.symbolAt declaring
  match declared.module {
    Some(there) => there == checker.module
    // A name the language provides is declared in no file, and nothing about it is private
    None => true
  }
}

/** Whether the code that is being checked stands inside the type `owner`, or inside an `extend` of it. */
public fn isInsideType(var checker: Checker, owner: TypeId): Bool {
  const declaring = match headSymbolOf(checker, owner) {
    Some(found) => found
    None => {
      return false
    }
  }
  isInsideDeclaration checker, declaring
}

fn headSymbolOf(checker: Checker, annotation: TypeId): SymbolId? {
  if const .Nominal(symbol, _) = checker.types.form(annotation) {
    return symbol
  }
  None
}

fn isPublicField(field: FieldSignature): Bool {
  field.visibility != Visibility.Private
}

// --- The constructor, `copy`, and patterns --------------------------------------------------------------------------

/**
 * Outside of the type a `private` field cannot be passed, so the generated constructor is usable from outside exactly
 * when every private field has a default (CONCEPT.md, "Construction"). The generated `copy` follows the same rule with
 * every field optional, so only the passing is checked for it.
 */
public fn checkConstruction(var checker: Checker, target: Target, arguments: List<Argument>, at: Span) {
  const (owner, isCopy) = match target.resolution {
    .Construct(found) => (found, false)
    .CopyOf(found) => (found, true)
    _ => {
      return
    }
  }
  // `Channel<Report>(capacity: 8)`: the item type is written here too, and the type it builds is what says so
  if const Some(problem) = channelItemProblem(checker, owner, at) {
    checker.reportHere problem
  }
  const fields = fieldsOf checker, owner
  if fields.isEmpty() {
    return
  }
  if isCopy {
    requireLabeledCopy checker, fields, arguments
  }
  if isInsideType(checker, owner) {
    return
  }
  const shown = checker.describe owner
  if !isCopy {
    for field in fields {
      if isPublicField(field) || field.hasDefault {
        continue
      }
      // A `shared type` implements `shared trait`s alone, so `TryFrom` is not among the factories it can have: what a
      // caller of one gets is a `static fn` of the type
      const factory = if isSharedTarget(checker, owner) {
        "`{shown}.open(...)`"
      } else {
        "`{shown}.tryFrom(...)`"
      }
      checker.reportHere(
        Diagnostic.error("`{shown}` cannot be constructed here: `{field.name}` is private and has no default", at)
          .withNote(
            "Only `{shown}` itself can pass a private field. What a caller gets is a factory of the type, a"
              + " `{staticKeyword} fn` that makes one ({factory})",
          ),
      )
      return
    }
  }
  reportPrivateArguments checker, fields, arguments, shown
}

/**
 * `copy` names every field it changes. It has the shape of the constructor with every field optional, so a positional
 * argument would silently fill the first one - and `order.copy(5)` reads as "copy and change something", which is the
 * one thing it must not be allowed to mean.
 */
fn requireLabeledCopy(var checker: Checker, fields: List<FieldSignature>, arguments: List<Argument>) {
  var position = 0
  for argument in arguments {
    if argument.label.isSome() {
      continue
    }
    const name = match fields.get(position) {
      Some(field) => field.name
      None => ""
    }
    position = position + 1
    if name.isEmpty() {
      continue
    }
    checker.reportHere(
      Diagnostic.error("`copy` takes labeled arguments: `copy({name}: ...)`", argument.value.span)
        .withNote("`copy` changes the fields it is given and keeps the rest, so every one of them is named"),
    )
  }
}

fn fieldNamed(fields: List<FieldSignature>, name: String): FieldSignature? {
  for field in fields {
    if field.name == name {
      return field
    }
  }
  None
}

/** A private field with a default is still not passable from outside, positionally or by name. */
fn reportPrivateArguments(
  var checker: Checker,
  fields: List<FieldSignature>,
  arguments: List<Argument>,
  shown: String,
) {
  var position = 0
  for argument in arguments {
    if const Some(label) = argument.label {
      for field in fields {
        if field.name == label.text && !isPublicField(field) {
          reportPrivateField checker, shown, field.name, label.span
        }
      }
      continue
    }
    if argument.spread {
      continue
    }
    if const Some(field) = fields.get(position) {
      if !isPublicField(field) {
        reportPrivateField checker, shown, field.name, argument.value.span
      }
    }
    position = position + 1
  }
}

fn reportPrivateField(var checker: Checker, shown: String, name: String, at: Span) {
  checker.reportHere(
    Diagnostic.error("`{name}` is private to `{shown}`, so it cannot be passed from here", at)
      .withNote(
        "A private field is set in the file that declares `{shown}`: in its body, in an `extend` of it there, or in a"
          + " function of that file",
      ),
  )
}

// --- A type that contains itself --------------------------------------------------------------------------------

/**
 * **A type that contains itself by value has no value.** `type Node { value: Int, next: Node }` needs a `Node` before
 * it can make one, and so does every chain of types that leads back to where it started. Nothing in such a program is
 * wrong at a call site, so it is reported at the declaration that closes the circle.
 *
 * A **case** is what stops a circle: `Option<Node>` contains a `Node` in `Some` and nothing in `None`, so a linked
 * list writes `next: Node?` and a tree writes its recursion through a case. A collection, a function, a `shared type`
 * and a trait type stop it too, because none of them holds its value inside of the record.
 */
public fn requireInhabitedType(var checker: Checker, symbol: SymbolId, at: Span) {
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  if shape.native || shape.shared {
    return
  }
  if isInhabited(checker, shape.own, []) {
    return
  }
  const shown = checker.symbolAt(symbol).name
  var report = Diagnostic.error "`{shown}` contains itself, so no value of it can ever be built", at
  if const Some(field) = circularFieldOf(checker, shape.own) {
    const annotation = checker.describe field.type
    report = report.withNote(
      "`{field.name}: {annotation}` holds another `{shown}`, and that one holds another. Write the step as"
        + " `{annotation}?`, put it in a `List<{annotation}>`, or give `{shown}` a case that holds no `{shown}`",
    )
  }
  checker.reportHere report
}

/** The first field of the type that cannot be filled, which is the one a reader has to change. */
fn circularFieldOf(var checker: Checker, own: TypeId): FieldSignature? {
  const fields = fieldsOf checker, own
  for field in fields {
    if !isInhabited(checker, field.type, []) {
      return field
    }
  }
  None
}

/**
 * Whether a value of this type can be built at all, as the least fixed point over the field graph: a type that is
 * already on the path counts as uninhabited, so a circle that nothing breaks answers `false` and one that a case
 * breaks answers `true`.
 */
fn isInhabited(var checker: Checker, annotation: TypeId, path: List<SymbolId>): Bool {
  const (symbol, _) = match checker.types.form(annotation) {
    .Nominal(found, given) => (found, given)
    .Tuple(items) => {
      for item in items {
        if !isInhabited(checker, item.type, path) {
          return false
        }
      }
      return true
    }
    // A type parameter, a trait type, a function and everything the language provides hold no record of their own
    _ => {
      return true
    }
  }
  for seen in path {
    if seen == symbol {
      return false
    }
  }
  if checker.inhabitedTypes.containsKey(annotation.value) {
    return true
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  // A native type is storage the runtime owns, and a `shared type` is reached through its identity: neither one puts
  // a value of the type it names inside of the record
  if shape.native || shape.shared {
    return true
  }
  var walked = path
  walked.append symbol
  if !shape.cases.isEmpty() {
    const variants = caseNamesOf checker, annotation
    for variant in variants {
      const found = caseNamed checker, annotation, variant
      const fields = match found {
        Some(one) => one.fields
        None => {
          continue
        }
      }
      if allInhabited(checker, fields, walked) {
        checker.inhabitedTypes.set annotation.value, true
        return true
      }
    }
    return false
  }
  const fields = fieldsOf checker, annotation
  const answer = allInhabited checker, fields, walked
  if answer {
    checker.inhabitedTypes.set annotation.value, true
  }
  answer
}

fn allInhabited(var checker: Checker, fields: List<FieldSignature>, path: List<SymbolId>): Bool {
  for field in fields {
    if !isInhabited(checker, field.type, path) {
      return false
    }
  }
  true
}

/**
 * `Point(x, y)` and `.Circle(radius)` as a pattern read every field by position, so a private field cannot be
 * destructured from outside either.
 */
public fn requireVisibleFields(
  var checker: Checker,
  owner: TypeId,
  name: String,
  fields: List<FieldSignature>,
  at: Span,
) {
  if fields.isEmpty() {
    return
  }
  if isInsideType(checker, owner) {
    return
  }
  for field in fields {
    if isPublicField(field) {
      continue
    }
    checker.reportHere(
      Diagnostic.error("`{field.name}` is private to `{name}`, so this pattern cannot read it", at)
        .withNote(
          "A pattern reads the fields of a value: outside the file that declares `{name}` a type with a private field"
            + " is taken apart by its own members",
        ),
    )
    return
  }
}

// --- The shape of a module ------------------------------------------------------------------------------------------

/**
 * Every rule about the declarations of one module. It runs after its bodies were checked, so that folding a constant
 * can read what the names in it resolved to.
 */
public fn checkShape(var checker: Checker, module: ModuleId) {
  const isCode = allowsTopLevelCode checker, module
  const statements = checker.program.graph.at(module).file.statements
  for statement in statements {
    match statement.kind {
      .Declare(declaration) => checkTopLevelDeclaration checker, module, declaration, isCode
      .Bind(binding) => {
        if !isCode {
          checkModuleBinding checker, module, binding
        }
        requireSingleName checker, module, binding, isExported: false
      }
      _ => {
        if !isCode {
          reportTopLevelCode checker, module, statement.span
        }
      }
    }
  }
  checkTypeArgumentBounds checker, module
}

/**
 * `HashMap<Float, String>`: the bound on a *type's* generic parameter (`type HashMap<Key: Hash, Value>`) held for
 * nothing, while the identical bound on a function's parameter was checked at every call. The two are one rule.
 *
 * It runs here, over the type of every type position the module recorded, and not in `lowering.trb` where the arguments
 * are built: bound resolution needs the implementation index and every signature of the program, and building a type is
 * what happens *while* those are still being built. A nested argument is a type position of its own, so
 * `List<HashMap<Float, String>>` is covered by the same walk.
 */
fn checkTypeArgumentBounds(var checker: Checker, module: ModuleId) {
  const positions = checker.typePositions[module.value]
  for (at, annotation) in positions {
    checkAppliedBounds checker, module, annotation, at
  }
}

/**
 * The bounds of [checkTypeArgumentBounds] for the type positions inside of `within` alone: what a language server
 * asks of the bodies it checked again, whose type positions are the only ones that can have changed.
 */
public fn checkTypeArgumentBoundsWithin(var checker: Checker, module: ModuleId, within: List<Span>) {
  const positions = checker.typePositions[module.value]
  for (at, annotation) in positions {
    if within.any({ _.start <= at.start && at.end <= _.end }) {
      checkAppliedBounds checker, module, annotation, at
    }
  }
}

fn checkAppliedBounds(var checker: Checker, module: ModuleId, annotation: TypeId, at: Span) {
  // A trait type is one form around the `Nominal`s of its traits, and those have no span of their own: `Table<Float,
  // String>` as an annotation is `Traits([Table<Float, String>])`, so the walk goes one step in
  if const .Traits(bounds) = checker.types.form(annotation) {
    for bound in bounds {
      checkAppliedBounds checker, module, bound, at
    }
    return
  }
  const (symbol, arguments) = match checker.types.form(annotation) {
    .Nominal(found, given) => (found, given)
    _ => {
      return
    }
  }
  if arguments.isEmpty() {
    return
  }
  const identifier = typeSignatureOf checker, symbol
  const bounds = checker.typeSignature(identifier).bounds
  if bounds.isEmpty() {
    return
  }
  const generics = checker.typeSignature(identifier).generics
  var mapping: Map<ParameterId, TypeId> = [:]
  for index in 0..generics.length().min(arguments.length()) {
    mapping.set generics[index], arguments[index]
  }
  const owner = checker.symbolAt(symbol).name
  for bound in bounds {
    const subject = substitute checker.types, bound.subject, mapping
    for capability in bound.traits {
      const wanted = substitute checker.types, capability, mapping
      if implementsBound(checker, subject, wanted) {
        continue
      }
      const given = checker.describe subject
      const shown = checker.describe wanted
      checker.report(
        module,
        Diagnostic.error("`{given}` does not implement `{shown}`", at)
          .withNote("`{owner}` asks for it: the bound on its type parameter holds wherever the type is named"),
      )
    }
  }
}

/**
 * Where top-level code is allowed: an entry file (`src/main.trb`, or the `entry` of a `program` line), a script, a
 * receiver script and a `*.test.trb` file - and every file that nothing imports, because that is what the rule is
 * *for*: an imported module consists of declarations only, so there is no initialization order and a cyclic import is
 * harmless. The `src/lib.trb` of a named package is always a module, because it is what other packages import, and
 * the names of the files decide both (docs/design/PROJECT.md section 3): nothing a manifest says makes it an entry.
 */
public fn allowsTopLevelCode(var checker: Checker, module: ModuleId): Bool {
  if checker.program.graph.at(module).runnable {
    return true
  }
  if isLibraryModule(checker, module) {
    return false
  }
  !isImported(checker, module)
}

fn isLibraryModule(var checker: Checker, module: ModuleId): Bool {
  const found = checker.program.graph.at module
  const package = checker.program.workspace.packages[found.package]
  !package.name.isEmpty() && found.path == joinPath(package.directory, libraryEntry)
}

fn isImported(var checker: Checker, module: ModuleId): Bool {
  buildImportedModules checker
  checker.importedModules.containsKey module.value
}

/** Which modules of the workspace some module imports. One walk over every `use`, and the answer is kept. */
fn buildImportedModules(var checker: Checker) {
  if checker.hasImportedModules {
    return
  }
  checker.hasImportedModules = true
  const graph = checker.program.graph
  const workspace = checker.program.workspace
  for source in graph.modules {
    for statement in source.file.statements {
      if const .Declare(declaration) = statement.kind {
        if const .Use(usage) = declaration.kind {
          if const .Module(path) = usage.source {
            if const .Found(target) = resolveImport(graph, workspace, source.id, path) {
              checker.importedModules.set target.value, true
            }
          }
        }
      }
    }
  }
}

fn reportTopLevelCode(var checker: Checker, module: ModuleId, at: Span) {
  const path = checker.program.graph.at(module).shownPath
  checker.report(
    module,
    Diagnostic.error("Top-level code is only allowed in entry files. `{path}` is imported", at)
      .withNote(
        "An imported module consists of declarations only, so a module has no initialization order and a cyclic"
          + " import is harmless",
      ),
  )
}

/**
 * A top-level `const` of a module has to be compile-time evaluable, and a module has no top-level `var` at
 * all: a module exports constants, it has no mutable state.
 */
fn checkModuleBinding(var checker: Checker, module: ModuleId, binding: Binding) {
  if binding.var {
    checker.report(
      module,
      Diagnostic.error("A module has no mutable state, so it has no top-level `var`", binding.pattern.span)
        .withNote("A module exports constants. State belongs to a value that somebody owns"),
    )
    return
  }
  checkConstantInitializer checker, module, binding.value
}

// --- One declaration ------------------------------------------------------------------------------------------------

fn checkTopLevelDeclaration(var checker: Checker, module: ModuleId, declaration: Declaration, isCode: Bool) {
  const isPublic = declaration.modifiers.visibility == Visibility.Public
  requireFieldOnlyModifiers checker, module, declaration.modifiers, declaration.span
  requireStandardLibrary checker, module, declaration.modifiers, declaration.span
  match declaration.kind {
    .Function(function) => {
      checkFunctionShape checker, module, declaration.modifiers, function, isTraitMember: false, ownerIsNative: false
      if isPublic {
        checkExposedFunction checker, module, function
      }
    }
    .Type(typeDeclaration) => checkTypeShape checker, module, declaration, typeDeclaration, isPublic
    .Trait(traitDeclaration) => checkTraitShape checker, module, declaration, traitDeclaration, isPublic
    .Extend(extension) => checkExtendShape checker, module, extension
    .Foreign(library) => checkForeignShape checker, module, library
    .Alias(alias) => {
      if isPublic {
        const symbol = symbolAt checker, module, alias.name.span
        const target = aliasTargetOf checker, symbol
        checkExposure checker, module, alias.name, [target], "type alias"
      }
    }
    .Constant(binding) => {
      if !isCode {
        checkModuleBinding checker, module, binding
      }
      requireSingleName checker, module, binding, isExported: isPublic
      if isPublic {
        checkExposedConstant checker, module, binding
      }
    }
    .Use(_) => {}
  }
}

/**
 * Where a top-level binding may destructure. In an entry file, a script or a test file the statements are ordinary code
 * and `const (quotient, remainder) = divide(7, 2)` is the binding CONCEPT writes. A **module** is different twice over:
 * its top-level `const` is a compile-time constant that the lowering *folds*, and a `public` one is a name of its
 * interface - and neither a fold nor an export can be one projection out of a pattern.
 */
public fn requireSingleName(var checker: Checker, module: ModuleId, binding: Binding, isExported: Bool) {
  if const .Binding(_) = binding.pattern.kind {
    return
  }
  const isCode = allowsTopLevelCode checker, module
  const what = if isExported { "An exported" } else { "A module's" }
  if isCode && !isExported {
    return
  }
  checker.report(
    module,
    Diagnostic.error("{what} `const` binds one name", binding.pattern.span)
      .withNote(
        "Bind the value and take it apart afterwards (`const shape = size()`, `const rows = shape.0`): a compile-time"
          + " constant is folded, and one that is exported is a name of the module",
      ),
  )
}

/**
 * `protected` is a modifier of a field and of nothing else: a method, a case and a constant have no `var` to protect.
 * The same holds for `private(var)`, the spelling it replaces.
 */
fn requireFieldOnlyModifiers(var checker: Checker, module: ModuleId, modifiers: Modifiers, at: Span) {
  if !isWriteProtected(modifiers.visibility) {
    return
  }
  checker.report(
    module,
    Diagnostic.error("`{modifiers.visibility.written()}` is only a modifier of a field", modifiers.visibilitySpan ?? at)
      .withNote(
        "It says that everybody reads a field and only the file of its type writes it. Write `private` to hide the"
          + " declaration",
      ),
  )
}

/** `protected`, or `private(var)`, the spelling it replaces: the two mean the same. */
fn isWriteProtected(visibility: Visibility): Bool {
  visibility == Visibility.Protected || visibility == Visibility.PrivateVar
}

/**
 * `native` marks what the compiler and its runtime implement instead of TorbScript code, so only the standard library
 * can use it (CONCEPT.md, "Foreign Functions").
 */
fn requireStandardLibrary(var checker: Checker, module: ModuleId, modifiers: Modifiers, at: Span) {
  if !modifiers.native {
    return
  }
  const package = packageNameOf checker, module
  if package.startsWith("std/") {
    return
  }
  checker.report(
    module,
    Diagnostic.error("`native` is only allowed in a package of the standard library", at)
      .withNote(
        "A `native` declaration is implemented by the compiler and its runtime. Everything else is written in"
          + " TorbScript, on top of `foreign` declarations",
      ),
  )
}

fn packageNameOf(checker: Checker, module: ModuleId): String {
  const found = checker.program.graph.at module
  checker.program.workspace.packages[found.package].name
}

/**
 * The result type of a `public fn` and of a trait method is never **inferred** (CONCEPT.md, "Functions"): an omitted one
 * is `Void`, so `public fn report(...) { ... }` stays legal and the error is at the value a body produces without
 * saying what it is. That check is in the body (`requireDeclaredResult`); what is checked here is that a function has a
 * body at all, unless a trait only requires it or the runtime provides it.
 */
fn checkFunctionShape(
  var checker: Checker,
  module: ModuleId,
  modifiers: Modifiers,
  function: FunctionDeclaration,
  isTraitMember: Bool,
  ownerIsNative: Bool,
) {
  // "`fn` has no defaults: its type arguments come from the call" (CONCEPT, "Traits"). One was parsed and then never
  // consulted, so `fn empty<Item = String>()` promised something and the call still read "Cannot infer `Item`"
  for parameter in function.generics {
    if const Some(default) = parameter.default {
      checker.report(
        module,
        Diagnostic.error("A type parameter of a `fn` has no default", default.span)
          .withNote(
            "The type arguments of a call come from the call: only a `type` and a `trait` fill a default in"
              + " (`trait Add<Other = Self>`)",
          ),
      )
    }
  }
  if function.body.isSome() || function.name.text.isEmpty() {
    return
  }
  if modifiers.native || isTraitMember || ownerIsNative {
    return
  }
  checker.report(
    module,
    Diagnostic.error("`{function.name.text}` has no body", function.name.span)
      .withNote("Only a requirement of a trait and a `native` declaration have none"),
  )
}

/**
 * A `public` function and a trait method do not infer their result: without a result type they produce `Void`, so a body
 * that produces a value has to declare which one. The message points at the value, because that is where the type it
 * has to declare is written, and the ordinary "Expected `Void`" is not given for it - one root cause, one message.
 */
public fn requireDeclaredResult(var checker: Checker, found: TypeId, at: Span) {
  const what = match checker.resultRule.describe() {
    Some(name) => name
    None => {
      return
    }
  }
  // `return` inside a closure returns from the closure, whose result is its own business
  if !checker.closureFrames.isEmpty() {
    return
  }
  if checker.absorbs(found) || found == checker.voidType {
    return
  }
  const shown = checker.describe found
  checker.reportHere(
    Diagnostic.error("{what} does not infer its result: declare it (`: {shown}`)", at)
      .withNote("Without a result type it produces `Void`, and whoever calls it must not have to read the body"),
  )
}

fn checkTypeShape(
  var checker: Checker,
  module: ModuleId,
  declaration: Declaration,
  typeDeclaration: TypeDeclaration,
  isPublic: Bool,
) {
  const isNative = declaration.modifiers.native
  for member in typeDeclaration.members {
    checkMemberShape checker, module, member, isTraitMember: false, ownerIsNative: isNative
  }
  requireOneNamespace(
    checker,
    module,
    typeDeclaration.members,
    typeDeclaration.name.text,
    repeatedTraitOf(typeDeclaration.traits),
  )
  requireOneBodyPerInstantiation checker, module, typeDeclaration
  if declaration.modifiers.shared {
    requireSharedTraits checker, module, typeDeclaration.name, typeDeclaration.traits
  }
  if isPublic {
    checkExposedType checker, module, typeDeclaration
  }
}

fn checkTraitShape(
  var checker: Checker,
  module: ModuleId,
  declaration: Declaration,
  traitDeclaration: TraitDeclaration,
  isPublic: Bool,
) {
  const isNative = declaration.modifiers.native
  for member in traitDeclaration.members {
    checkMemberShape checker, module, member, isTraitMember: true, ownerIsNative: isNative
  }
  requireOneNamespace checker, module, traitDeclaration.members, traitDeclaration.name.text, repeated: None
  if isPublic {
    checkExposedTrait checker, module, traitDeclaration
  }
}

/**
 * **A type has one namespace of members** (CONCEPT.md, "Members"): a field, a `const`, a `fn` and a case all live in it,
 * so two of them may not share a name. Without the rule the first one the lookup order reaches wins and the other is
 * unreachable - `report.title` was the field and `report.title()` was nothing anybody could call.
 */
fn requireOneNamespace(
  var checker: Checker,
  module: ModuleId,
  members: List<Member>,
  owner: String,
  repeated: String?,
) {
  var declared: Map<String, Bool> = [:]
  var fields: Map<String, Bool> = [:]
  for member in members {
    const name = memberNameOf member
    if name.text.isEmpty() {
      continue
    }
    // `deprecated("...", replacement: "x()") x: Int` beside `fn x()`: a field that became a method keeps its callers
    // for as long as it is deprecated, `x` reading the field and `x()` calling the method
    if declared.containsKey(name.text) && sharesNameWithMethod(members, name.text) {
      continue
    }
    if declared.containsKey(name.text) {
      var problem = Diagnostic.error("`{name.text}` is already declared in `{owner}`", name.span)
        .withNote("A type has one namespace of members: a field, a `const`, a `fn` and a case cannot share a name")
      // `private items` next to `fn items()`: the rule holds for a private field too, because making a field public
      // or private is not supposed to break a caller - so the two need two names
      if fields.containsKey(name.text) && isFunctionMember(member) {
        problem = problem.withNote(
          "That holds for a `private` field as well: making a field private or public must not change what a caller"
            + " writes, so one of the two needs another name",
        )
      }
      // `type Sketch with Draw<Paper>, Draw<Screen>` writing two `draw`s: the two members belong to two
      // implementations and not to one body, and the form that has a body per implementation is `extend`
      if const Some(capability) = repeated {
        problem = problem.withNote(
          "`{owner}` comes with `{capability}` more than once, and one body per instantiation is one `extend` per "
            + "instantiation: `extend {owner} with {capability}<...> \{ fn {name.text}(...) \}`",
        )
      }
      checker.report module, problem
      continue
    }
    declared.set name.text, true
    if const .Field(_) = member.kind {
      fields.set name.text, true
    }
  }
}

/**
 * Whether the members of this name are exactly the pair that may share one: a deprecated field whose replacement is the
 * method of its own name, and that method, which takes nothing.
 */
fn sharesNameWithMethod(members: List<Member>, name: String): Bool {
  var named: List<Member> = []
  for member in members {
    if memberNameOf(member).text == name {
      named.append member
    }
  }
  if named.length() != 2 {
    return false
  }
  for member in named {
    if const Some(deprecation) = member.modifiers.deprecation {
      if isFieldBecomingMethod(member, named, deprecation) {
        return true
      }
    }
  }
  false
}

fn isFunctionMember(member: Member): Bool {
  match member.kind {
    .Function(_) => true
    _ => false
  }
}

/**
 * **One body per instantiation.** A type may come `with` one trait more than once - `Multiply<Board, Board>` beside
 * `Multiply<Int, Board>` is how a type overloads an operator over the trait's own argument - but a type has one
 * namespace of members, so the members it writes in its body can be the implementation of one instantiation and of no
 * other. Every further one needs a body of its own, and the form that has one is `extend`.
 *
 * Without the rule the second instantiation is silently satisfied by the first one's body, and afterwards neither of
 * them resolves: `type Twice with Index<Int, Int>, Index<Bounds<Int>, Twice>` writing one `get` was accepted, and
 * then `twice[0]` reported that `Twice` does not implement `Index`.
 *
 * A body that writes the member **twice** is [requireOneNamespace]'s message and not this one, so that the two
 * spellings of one mistake get one root cause each.
 */
fn requireOneBodyPerInstantiation(var checker: Checker, module: ModuleId, typeDeclaration: TypeDeclaration) {
  var written: Map<String, Int> = [:]
  for member in typeDeclaration.members {
    const name = memberNameOf member
    written.set(name.text, (written.get(name.text) ?? 0) + 1)
  }
  var seen: Map<String, Bool> = [:]
  for clause in typeDeclaration.traits {
    for reference in traitReferencesOf(clause.trait) {
      const symbol = match traitSymbolOf(checker, module, reference) {
        Some(found) => found
        None => {
          continue
        }
      }
      const name = checker.symbolAt(symbol).name
      if !seen.containsKey(name) {
        seen.set name, true
        continue
      }
      const identifier = typeSignatureOf checker, symbol
      const shape = checker.typeSignature identifier
      for member in typeDeclaration.members {
        const only = memberNameOf member
        if !shape.members.containsKey(only.text) || (written.get(only.text) ?? 0) > 1 {
          continue
        }
        const owner = typeDeclaration.name.text
        checker.report(
          module,
          Diagnostic.error(
            "`{owner}` comes with `{name}` more than once, and `{only.text}` is the body of the first one",
            reference.span,
          ).withNote(
            "A type has one namespace of members, so one body per instantiation is one `extend` per instantiation:"
              + " `extend {owner} with {name}<...> \{ fn {only.text}(...) \}`",
          ),
        )
        return
      }
    }
  }
}

/** The trait references one `with` element writes: `(Add, Subtract)` is two, `Draw<Paper>` is one. */
fn traitReferencesOf(reference: TypeReference): List<TypeReference> {
  if const .Intersection(parts) = reference.kind {
    var found: List<TypeReference> = []
    for part in parts {
      found.appendAll traitReferencesOf(part)
    }
    return found
  }
  [reference]
}

/** The trait a `with` list names twice with different arguments, if there is one: `Draw<Paper>, Draw<Screen>`. */
fn repeatedTraitOf(traits: List<TraitClause>): String? {
  var seen: Map<String, Bool> = [:]
  for clause in traits {
    for name in traitHeadsOf(clause.trait) {
      if seen.containsKey(name) {
        return name
      }
      seen.set name, true
    }
  }
  None
}

/** The head names one `with` element writes: `(Add, Subtract)` is two, `Draw<Paper>` is one. */
fn traitHeadsOf(reference: TypeReference): List<String> {
  match reference.kind {
    .Named(path, _) => {
      match path.last() {
        Some(name) => [name.text]
        None => []
      }
    }
    .Intersection(parts) => {
      var found: List<String> = []
      for part in parts {
        found.appendAll traitHeadsOf(part)
      }
      found
    }
    _ => []
  }
}

/** The name one member is known under. A `const` whose pattern is not a plain name has none the rule could compare. */
fn memberNameOf(member: Member): Name {
  match member.kind {
    .Field(field) => field.name
    .Constant(binding) => {
      match binding.pattern.kind {
        .Binding(text) => Name text, binding.pattern.span
        _ => Name "", binding.pattern.span
      }
    }
    .Function(function) => function.name
    .Case(declaration) => declaration.name
  }
}

/**
 * One member of a `type`, a `trait` or an `extend`. A `var` field is where `protected` belongs and nowhere else, and
 * the result type of a trait method is mandatory.
 */
fn checkMemberShape(var checker: Checker, module: ModuleId, member: Member, isTraitMember: Bool, ownerIsNative: Bool) {
  requireStandardLibrary checker, module, member.modifiers, member.span
  match member.kind {
    .Field(field) => checkFieldModifiers checker, module, member.modifiers, field
    .Function(function) => {
      requireFieldOnlyModifiers checker, module, member.modifiers, member.span
      checkFunctionShape checker, module, member.modifiers, function, isTraitMember, ownerIsNative
    }
    .Constant(_) => requireFieldOnlyModifiers checker, module, member.modifiers, member.span
    .Case(_) => requireFieldOnlyModifiers checker, module, member.modifiers, member.span
  }
}

/**
 * `protected var connections: Int = 0` is the whole spelling. Without the `var` the word protects nothing, because a
 * const field is written by nobody already. `private(var)`, the spelling it replaces, is refused with the one that
 * replaces it, and `torb lint --fix --rule protected-field` writes that; the field still means what it says, so
 * nothing else about it is reported a second time.
 */
fn checkFieldModifiers(var checker: Checker, module: ModuleId, modifiers: Modifiers, field: Field) {
  const name = field.name.text
  const at = modifiers.visibilitySpan ?? field.name.span
  if modifiers.visibility == Visibility.Protected && !field.var {
    checker.report(
      module,
      Diagnostic.error("`protected` needs `var`: a const field is write-protected already", at)
        .withNote(
          "Write `protected var {name}: ...` for a field only its own file writes, or `{name}: ...` for one nobody"
            + " writes",
        ),
    )
  }
  if modifiers.visibility == Visibility.PrivateVar {
    checker.report(
      module,
      Diagnostic.error("`private(var)` is written `protected var`", at)
        .withNote(
          "`protected var {name}: ...` means the same: everybody reads the field, and only its own file writes it."
            + " `torb lint --fix --rule protected-field` rewrites every one",
        ),
    )
  }
}

/**
 * A `shared type` may only implement a `shared trait` (CONCEPT.md, "Traits"), which is what keeps every value of a
 * non-shared trait type a value: nobody changes it while you hold it, and it can be passed to another task.
 */
fn requireSharedTraits(var checker: Checker, module: ModuleId, name: Name, traits: List<TraitClause>) {
  for clause in traits {
    const reference = clause.trait
    const symbol = match traitSymbolOf(checker, module, reference) {
      Some(found) => found
      None => {
        continue
      }
    }
    if isSharedTrait(checker, symbol) {
      continue
    }
    const shown = checker.symbolAt(symbol).name
    checker.report(
      module,
      Diagnostic.error("`{name.text}` is a `shared type`, so it can only implement a `shared trait`", reference.span)
        .withNote("`{shown}` is not one: write `shared trait {shown}`, or make `{name.text}` an ordinary `type`"),
    )
  }
}

fn traitSymbolOf(checker: Checker, module: ModuleId, reference: TypeReference): SymbolId? {
  if const .Named(path, _) = reference.kind {
    if const Some(last) = path.last() {
      return checker.resolvedName module, last.span
    }
  }
  None
}

/** Whether a trait is a `shared trait`, which is what a `shared type` may implement and what `Self` is then. */
public fn isSharedTrait(var checker: Checker, symbol: SymbolId): Bool {
  if const .Trait = checker.symbolAt(symbol).kind {
    const identifier = typeSignatureOf checker, symbol
    return checker.typeSignature(identifier).shared
  }
  // A supertrait that is not a trait was reported where the name stands; nothing follows from it here
  true
}

/**
 * An `extend` adds constants and functions, nothing else: exhaustiveness and the generated constructor have to
 * be decidable from the declaration of a type alone.
 */
fn checkExtendShape(var checker: Checker, module: ModuleId, extension: ExtendDeclaration) {
  const isNative = false
  requireExtendableTarget checker, module, extension.target
  requireTraitForBlanket checker, module, extension
  for member in extension.members {
    match member.kind {
      .Field(field) => {
        checker.report(
          module,
          Diagnostic.error("An `extend` cannot add a field", field.name.span)
            .withNote("Fields and cases belong to the declaration of the type: an `extend` adds constants and functions"),
        )
      }
      .Case(caseDeclaration) => {
        checker.report(
          module,
          Diagnostic.error("An `extend` cannot add a case", caseDeclaration.name.span)
            .withNote("Fields and cases belong to the declaration of the type, so that a `match` over it is decidable"),
        )
      }
      _ => checkMemberShape checker, module, member, isTraitMember: false, ownerIsNative: isNative
    }
  }
}

/**
 * **A blanket `extend` needs a trait.** CONCEPT ("Traits"): a blanket implementation is one *whose target is a bare
 * type parameter*, it covers every type, and it "is allowed when the package owns the **trait**" - so without a trait
 * there is nothing the rule could license, nothing coherence could keep unique, and nothing a using file could name:
 * an extension member of a foreign type is imported by the head of its target, and a bare parameter has no head.
 *
 * `extend<World: Query> World { fn doubled(): Int { ... } }` checked clean and answered *"cannot extend `World`: it
 * is not a type"* when it ran. The form that means what it was written for is `extend<World: Query> World with Pairs`.
 */
fn requireTraitForBlanket(var checker: Checker, module: ModuleId, extension: ExtendDeclaration) {
  if !extension.traits.isEmpty() {
    return
  }
  const annotation = typeFromReference checker, extension.target, TypeScope(module).forType()
  if const .Parameter(_) = checker.types.form(annotation) {
    const shown = checker.describe annotation
    checker.report(
      module,
      Diagnostic.error("`{shown}` is a type parameter, so this `extend` needs a trait", extension.target.span)
        .withNote(
          "An `extend` over every type is a blanket implementation, and a blanket implementation is allowed because"
            + " its package owns the trait: write `extend<...> {shown} with SomeTrait \{ ... \}`",
        ),
    )
  }
}

/**
 * "A literal type has no owner and **cannot be extended**: `extend "tcp" | "udp"` is an error, with or without a trait.
 * Only the generated members exist." (CONCEPT, "Literal Types"). Its identity is structural, so there is no declaration
 * an `extend` could belong to - and it compiled silently, with the added member simply unreachable at every use.
 */
fn requireExtendableTarget(var checker: Checker, module: ModuleId, target: TypeReference) {
  const annotation = typeFromReference checker, target, TypeScope(module).forType()
  if const .Literals(_, _) = checker.types.form(annotation) {
    const shown = checker.describe annotation
    checker.report(
      module,
      Diagnostic.error("`{shown}` cannot be extended", target.span)
        .withNote(
          "A literal type is the same type wherever its members are written, so it has no declaration an `extend`"
            + " could belong to. For behavior, declare a type with cases",
        ),
    )
  }
}

/**
 * `foreign "sqlite3" { fn ... }` declares functions of a C library. The block holds declarations of functions and
 * nothing else, and they have no bodies: the library is the implementation.
 */
fn checkForeignShape(var checker: Checker, module: ModuleId, library: ForeignDeclaration) {
  for member in library.members {
    match member.kind {
      .Function(function) => {
        if function.body.isSome() {
          checker.report(
            module,
            Diagnostic.error("A `foreign` function has no body", function.name.span)
              .withNote("The C library is its implementation. `foreign` declares the signature the ABI promises"),
          )
        }
        if function.returnType.isNone() && !function.name.text.isEmpty() {
          checker.report(
            module,
            Diagnostic.error("A `foreign` function has to declare its result type", function.name.span)
              .withNote("The C ABI is the contract, so nothing about a `foreign` signature is inferred"),
          )
        }
      }
      _ => {
        checker.report(
          module,
          Diagnostic.error("A `foreign` block declares functions and nothing else", member.span)
            .withNote("Foreign types are `Pointer<Value>`, `CString`, the sized numbers and a `foreign type` struct"),
        )
      }
    }
  }
}

// --- What `public` promises -----------------------------------------------------------------------------------------

/**
 * A `public` declaration is a promise, and a type that is private to the file cannot be part of one: a caller that
 * cannot name the type cannot hold the value either.
 *
 * CONCEPT.md is silent here. Without the rule a `public fn` hands out values of a type its caller has no name for,
 * which is the one thing "top-level declarations are private to their file unless marked `public`" is supposed to make
 * impossible.
 */
fn checkExposure(var checker: Checker, module: ModuleId, name: Name, types: List<TypeId>, what: String) {
  for annotation in types {
    const leaked = match privateTypeIn(checker, module, annotation, 0) {
      Some(found) => found
      None => {
        continue
      }
    }
    const shown = checker.symbolAt(leaked).name
    checker.report(
      module,
      Diagnostic.error("`{name.text}` is `public` and names `{shown}`, which is private to this file", name.span)
        .withNote("Whoever can use a `public` {what} has to be able to name its types: mark `{shown}` as `public` too"),
    )
    return
  }
}

fn checkExposedFunction(var checker: Checker, module: ModuleId, function: FunctionDeclaration) {
  const symbol = symbolAt checker, module, function.name.span
  const identifier = signatureOf checker, symbol
  checkExposure checker, module, function.name, typesOfForm(checker.signature(identifier).form), "function"
}

fn checkExposedConstant(var checker: Checker, module: ModuleId, binding: Binding) {
  if const .Binding(_) = binding.pattern.kind {
    const symbol = symbolAt checker, module, binding.pattern.span
    const annotation = resultOf checker, symbol
    const name = Name checker.symbolAt(symbol).name, binding.pattern.span
    checkExposure checker, module, name, [annotation], "constant"
  }
}

fn checkExposedType(var checker: Checker, module: ModuleId, typeDeclaration: TypeDeclaration) {
  const symbol = symbolAt checker, module, typeDeclaration.name.span
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  var types: List<TypeId> = []
  // A `private` field is not part of the surface: nobody outside can read it, so its type is nobody's business there
  for field in shape.fields {
    if isPublicField(field) {
      types.append field.type
    }
  }
  for variant in shape.cases {
    for field in variant.fields {
      if isPublicField(field) {
        types.append field.type
      }
    }
  }
  checkExposure checker, module, typeDeclaration.name, types, "type"
}

fn checkExposedTrait(var checker: Checker, module: ModuleId, traitDeclaration: TraitDeclaration) {
  const symbol = symbolAt checker, module, traitDeclaration.name.span
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  var types: List<TypeId> = []
  for (_, member) in shape.members {
    if !checker.symbolAt(member).public {
      continue
    }
    const inner = signatureOf checker, member
    const form = checker.signature(inner).form
    types.appendAll typesOfForm(form)
  }
  checkExposure checker, module, traitDeclaration.name, types, "trait"
}

fn typesOfForm(form: FunctionForm): List<TypeId> {
  var types: List<TypeId> = []
  for parameter in form.parameters {
    types.append parameter.type
  }
  types.append form.result
  types
}

/** The first type of the file that is private and stands in a `public` signature, if there is one. */
fn privateTypeIn(var checker: Checker, module: ModuleId, annotation: TypeId, depth: Int): SymbolId? {
  if depth > 16 {
    return None
  }
  match checker.types.form(annotation) {
    .Nominal(symbol, arguments) => {
      if isPrivateType(checker, module, symbol) {
        return symbol
      }
      privateTypeInAll checker, module, arguments, depth
    }
    .Traits(bounds) => privateTypeInAll checker, module, bounds, depth
    .Tuple(fields) => {
      var inner: List<TypeId> = []
      for field in fields {
        inner.append field.type
      }
      privateTypeInAll checker, module, inner, depth
    }
    .Function(form) => privateTypeInAll checker, module, typesOfForm(form), depth
    _ => None
  }
}

fn privateTypeInAll(var checker: Checker, module: ModuleId, types: List<TypeId>, depth: Int): SymbolId? {
  for annotation in types {
    if const Some(found) = privateTypeIn(checker, module, annotation, depth + 1) {
      return found
    }
  }
  None
}

fn isPrivateType(checker: Checker, module: ModuleId, symbol: SymbolId): Bool {
  const declared = checker.symbolAt symbol
  if declared.public {
    return false
  }
  const isNamedType = match declared.kind {
    .Type | .Trait | .Alias => true
    _ => false
  }
  if !isNamedType {
    return false
  }
  match declared.module {
    Some(found) => found == module
    None => false
  }
}

/** The symbol of a declaration of this module, by the span of its name. Index 0 is never one, so it is a safe fallback. */
fn symbolAt(checker: Checker, module: ModuleId, at: Span): SymbolId {
  checker.resolvedName(module, at) ?? SymbolId(0)
}

// --- `isSame` -------------------------------------------------------------------------------------------------------

/**
 * `isSame` compares identity, and only a `shared type` has one: on a value the answer would expose whether the
 * implementation shares storage. The language has no bound that says "shared", so this is a named special case next
 * to object safety.
 */
public fn checkSharedIdentity(var checker: Checker, target: Target, arguments: List<TypeId>, at: Span) {
  const wanted = match checker.wellKnown.symbolNamed("isSame") {
    Some(found) => found
    None => {
      return
    }
  }
  const called = match target.resolution {
    .Callable(symbol, _, _) => symbol
    _ => {
      return
    }
  }
  if called != wanted {
    return
  }
  const annotation = match arguments.first() {
    Some(found) => found
    None => {
      return
    }
  }
  if checker.absorbs(annotation) || hasKnownIdentity(checker, annotation) {
    return
  }
  const shown = checker.describe annotation
  // A type parameter and a value of a `shared trait` may be an object or a value, and on a value the answer would expose
  // storage - so what the checker cannot tell is refused, exactly as `spawn` refuses it from the other side
  const isUnknown = match checker.types.form(annotation) {
    .Parameter(_) => true
    .Traits(_) => isSharedType checker, annotation
    _ => false
  }
  if isUnknown {
    checker.reportHere(
      Diagnostic.error("`isSame` compares identity, and a `{shown}` may be a value", at)
        .withNote(
          "Only a `shared type` has an identity, and a value may stand behind `{shown}`. Take the `shared type` itself,"
            + " or compare with `==`",
        ),
    )
    return
  }
  checker.reportHere(
    Diagnostic.error("`isSame` compares identity, and a `{shown}` is a value", at)
      .withNote("Use `==`: two values are the same when their content is. Only a `shared type` has an identity"),
  )
}

/**
 * Whether a type has an identity: a `shared type`, a trait-typed value whose every trait is a `shared trait`, or a
 * generic parameter one of whose bounds is one (`Self` inside a `shared trait`, `<Chosen: Source<...>>`).
 *
 * **This is the one predicate for it.** "A `var` place may not come from a `const` path to a shared object", the
 * dead-change rule, "only a shared object may be changed by a task" and "a temporary with an identity is a `var` path"
 * all ask the same question, and every one of them reads this function rather than deciding it again on its own.
 *
 * A bare generic parameter answers `false`: it *could* be instantiated with a shared type, but the language has no
 * bound that says "shared", so the checker cannot know and the rules that read this are about what is certain.
 */
public fn isSharedType(var checker: Checker, annotation: TypeId): Bool {
  match checker.types.form(annotation) {
    .Traits(bounds) => {
      if bounds.isEmpty() {
        return false
      }
      for bound in bounds {
        if !isSharedBound(checker, bound) {
          return false
        }
      }
      true
    }
    // One shared bound is enough: whatever fills the parameter carries that trait, so it is an object
    .Parameter(parameter) => {
      for bound in checker.parameterBounds.get(parameter.value) ?? [] {
        if isSharedBound(checker, bound) {
          return true
        }
      }
      false
    }
    .Nominal(symbol, _) => isSharedDeclaration checker, symbol
    _ => false
  }
}

/**
 * Whether a value of this type holds an object anywhere inside it: the type itself, a generic argument, a field, or a
 * field of a case. **A `shared type` is confined to the task that made it** (CONCEPT, "Concurrency"), so this is the
 * question a task boundary asks - the captures of a `spawn` closure, and the item type of a `Channel`.
 *
 * `Task` and `Channel` are the two exceptions, and they are exceptions because they are what a value crosses
 * *through*: what one of them holds is copied or moved by the runtime at the crossing, and is not held here.
 *
 * This is the checker's half of the `containsShared` the layout computes (BACKEND 1.3), and it is memoized the same
 * way. A type that contains itself answers `false` while its own answer is being worked out, and an answer that was
 * reached through such a cycle is given and not kept - until the walk is back at its top: a `false` there is final for
 * every type the walk answered `false` for, because a `true` anywhere below would have made the top `true`. Without it
 * every question about a type of a recursive family - the syntax tree of the compiler - walked the whole family again.
 */
public fn containsShared(var checker: Checker, annotation: TypeId): Bool {
  if const Some(known) = checker.sharedContents.get(annotation.value) {
    return known
  }
  if checker.sharedRunning.containsKey(annotation.value) {
    checker.sharedCycles = checker.sharedCycles + 1
    return false
  }
  const isTop = checker.sharedRunning.isEmpty()
  checker.sharedRunning.set annotation.value, true
  const cycles = checker.sharedCycles
  const found = sharedInside checker, annotation
  checker.sharedRunning.remove annotation.value
  if checker.sharedCycles == cycles {
    checker.sharedContents.set annotation.value, found
  } else if !found {
    checker.sharedEntered.append annotation.value
  }
  if isTop {
    if !found {
      for entered in checker.sharedEntered {
        checker.sharedContents.set entered, false
      }
    }
    checker.sharedEntered = []
  }
  found
}

fn sharedInside(var checker: Checker, annotation: TypeId): Bool {
  const arguments = match checker.types.form(annotation) {
    .Nominal(symbol, given) => {
      if checker.wellKnown.isTaskHandle(symbol) {
        return false
      }
      given
    }
    .Tuple(fields) => {
      for field in fields {
        if containsShared(checker, field.type) {
          return true
        }
      }
      return false
    }
    // `List<Counter>` is a trait-typed value: the trait is not shared, and what it was applied to may be
    .Traits(bounds) => {
      if isSharedType(checker, annotation) {
        return true
      }
      for bound in bounds {
        for argument in argumentsOfType(checker, bound) {
          if containsShared(checker, argument) {
            return true
          }
        }
      }
      return false
    }
    _ => {
      return isSharedType checker, annotation
    }
  }
  if isSharedType(checker, annotation) {
    return true
  }
  for argument in arguments {
    if containsShared(checker, argument) {
      return true
    }
  }
  const fields = fieldsOf checker, annotation
  for field in fields {
    if containsShared(checker, field.type) {
      return true
    }
  }
  const names = caseNamesOf checker, annotation
  for name in names {
    const variant = match caseNamed(checker, annotation, name) {
      Some(found) => found
      None => {
        continue
      }
    }
    for field in variant.fields {
      if containsShared(checker, field.type) {
        return true
      }
    }
  }
  false
}

/**
 * What a task cannot see inside a type: a type parameter, a function value or a value of a `shared trait`, wherever it
 * stands - the type itself, a generic argument, a field, a field of a case. Each of the three may hide an object: a
 * `shared type` may fill the parameter, a function value may have captured one, and one may be behind the trait. A task
 * takes only what it can see is a value (CONCEPT, "Concurrency"), so `spawn` asks this before [containsShared].
 *
 * `Task` and `Channel` are skipped for the reason [containsShared] skips them, and the first thing found is the answer.
 * It is memoized as [containsShared] is: nothing found at the top of a walk is final for every type the walk found
 * nothing in.
 */
public fn unseenInside(var checker: Checker, annotation: TypeId): Unseen {
  if const Some(known) = checker.unseenContents.get(annotation.value) {
    return known
  }
  if checker.unseenRunning.containsKey(annotation.value) {
    checker.unseenCycles = checker.unseenCycles + 1
    return Unseen.Nothing
  }
  const isTop = checker.unseenRunning.isEmpty()
  checker.unseenRunning.set annotation.value, true
  const cycles = checker.unseenCycles
  const found = unseenOf checker, annotation
  checker.unseenRunning.remove annotation.value
  if checker.unseenCycles == cycles {
    checker.unseenContents.set annotation.value, found
  } else if isNothingUnseen(found) {
    checker.unseenEntered.append annotation.value
  }
  if isTop {
    if isNothingUnseen(found) {
      for entered in checker.unseenEntered {
        checker.unseenContents.set entered, Unseen.Nothing
      }
    }
    checker.unseenEntered = []
  }
  found
}

fn unseenOf(var checker: Checker, annotation: TypeId): Unseen {
  const arguments = match checker.types.form(annotation) {
    .Parameter(_) => {
      return Unseen.TypeParameter
    }
    .Function(_) => {
      return Unseen.FunctionValue
    }
    .Tuple(fields) => {
      var parts: List<TypeId> = []
      for field in fields {
        parts.append field.type
      }
      return firstUnseen checker, parts
    }
    .Traits(bounds) => {
      if isSharedType(checker, annotation) {
        return Unseen.SharedTrait
      }
      var parts: List<TypeId> = []
      for bound in bounds {
        parts.appendAll argumentsOfType(checker, bound)
      }
      return firstUnseen checker, parts
    }
    .Nominal(symbol, given) => {
      if checker.wellKnown.isTaskHandle(symbol) {
        return Unseen.Nothing
      }
      given
    }
    _ => {
      return Unseen.Nothing
    }
  }
  var parts = arguments
  for field in fieldsOf(checker, annotation) {
    parts.append field.type
  }
  for name in caseNamesOf(checker, annotation) {
    if const Some(variant) = caseNamed(checker, annotation, name) {
      for field in variant.fields {
        parts.append field.type
      }
    }
  }
  firstUnseen checker, parts
}

/**
 * Why a task cannot take a value of this type, as the end of a sentence (`a Connection has an identity`), or `None`
 * where it can: an object, something that holds one, or something that may ([unseenInside]).
 */
public fn taskProblemOf(var checker: Checker, annotation: TypeId): String? {
  if !isNothingUnseen(unseenInside(checker, annotation)) {
    return "may hold an object"
  }
  if !containsShared(checker, annotation) {
    return None
  }
  if isSharedType(checker, annotation) {
    return "has an identity"
  }
  "holds an object"
}

/** The note under [taskProblemOf]'s message: what the task could take instead. */
public fn taskNoteOf(var checker: Checker, annotation: TypeId): String {
  match unseenInside(checker, annotation) {
    .TypeParameter => {
      "A type parameter may be filled with a `shared type`, and a task only takes what it can see is a value. Give"
        + " the value a concrete type, or build it inside the closure"
    }
    .FunctionValue => {
      "What a function value captured is not part of its type. A closure written right there may cross, and so may a"
        + " function-typed parameter - its callers are checked instead"
    }
    .SharedTrait => {
      "A `shared type` may stand behind a `shared trait`, and a task only takes what it can see is a value. Pass the"
        + " concrete type, or build the value inside the closure"
    }
    .Nothing => {
      "A task gets copies, and an object is not copied. `Task` and `Channel` are what crosses between tasks: make the"
        + " object inside the closure, or send what it holds through a `Channel`"
    }
  }
}

fn firstUnseen(var checker: Checker, parts: List<TypeId>): Unseen {
  for part in parts {
    const found = unseenInside checker, part
    if !isNothingUnseen(found) {
      return found
    }
  }
  Unseen.Nothing
}

fn isNothingUnseen(found: Unseen): Bool {
  match found {
    .Nothing => true
    _ => false
  }
}

/**
 * Whether a type is **known** to have an identity: a `shared type` itself. A type parameter and a value of a `shared
 * trait` may be either an object or a value, so the checker cannot tell - and `isSame`, which exposes storage on a
 * value, takes only what it can tell. `spawn` asks the mirror question ([unseenInside]) and refuses the same two.
 */
public fn hasKnownIdentity(var checker: Checker, annotation: TypeId): Bool {
  match checker.types.form(annotation) {
    .Nominal(symbol, _) => isSharedDeclaration checker, symbol
    _ => false
  }
}

/**
 * **A `Channel` moves items between tasks, so an item may not have an identity.** A `shared type` is confined to the
 * task that made it (CONCEPT, "Concurrency"): an item that held one would hand the same object to the reading end,
 * which is the race the design says cannot happen.
 *
 * It is asked where `Channel<Item>` is **written** - a signature, an annotation, `Channel<Report>(capacity: 8)` - and
 * not at `sink().add`: the item type is written once and the `add` that would carry it is written at every step of a
 * pipeline, so this is one message where the other would be a message per call. `Task` and `Channel` are the two
 * objects that may cross, so a `Channel<Channel<Report>>` is allowed and a `Channel<File>` is not.
 *
 * Answers the diagnostic instead of reporting it, because the two places that ask report into different modules.
 */
public fn channelItemProblem(var checker: Checker, built: TypeId, at: Span): Diagnostic? {
  const channel = match checker.wellKnown.channel {
    Some(found) => found
    None => {
      return None
    }
  }
  const item = match checker.types.form(built) {
    .Nominal(symbol, arguments) => {
      if symbol != channel || arguments.length() != 1 {
        return None
      }
      arguments[0]
    }
    _ => {
      return None
    }
  }
  if !containsShared(checker, item) {
    return None
  }
  const shown = checker.describe item
  const held = if isSharedType(checker, item) { "has an identity" } else { "holds an object" }
  Diagnostic.error("A `Channel` cannot carry a `{shown}`: it {held}", at)
    .withNote(
      "An item of a channel crosses from one task to another, and an object is never copied. Send what the object"
        + " holds instead, or hand over a `Task` or a `Channel` - the two that may cross",
    )
}

/** The arguments a nominal type or a bound was applied to: the `Counter` of `List<Counter>`. */
fn argumentsOfType(checker: Checker, annotation: TypeId): List<TypeId> {
  match checker.types.form(annotation) {
    .Nominal(_, arguments) => arguments
    _ => []
  }
}

/** A bound is shared when the trait it names is a `shared trait`. */
fn isSharedBound(var checker: Checker, bound: TypeId): Bool {
  match headSymbolOf(checker, bound) {
    Some(symbol) => isSharedDeclaration checker, symbol
    None => false
  }
}

/** Whether the type a constructor builds has an identity, which decides which factory a message can suggest. */
fn isSharedTarget(var checker: Checker, owner: TypeId): Bool {
  match headSymbolOf(checker, owner) {
    Some(symbol) => isSharedDeclaration checker, symbol
    None => false
  }
}

/** `shared type X` or `shared trait X`, by the declaration the name stands for. */
fn isSharedDeclaration(var checker: Checker, symbol: SymbolId): Bool {
  match checker.symbolAt(symbol).kind {
    .Type => {
      const identifier = typeSignatureOf checker, symbol
      checker.typeSignature(identifier).shared
    }
    .Trait => {
      const identifier = typeSignatureOf checker, symbol
      checker.typeSignature(identifier).shared
    }
    _ => false
  }
}
