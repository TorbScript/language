/**
 * Receiver scripts: checking a `.trb` file that is the body of a receiver closure instead of an ordinary module.
 * `project.trb` and a configuration file loaded through `Sandbox.load` are the same mechanism with a different
 * receiver type - "`project.trb` and `project.lock.trb` are exactly this mechanism with the receiver `Project`"
 * (CONCEPT.md, "Receiver Scripts and the Sandbox").
 *
 * [scriptReceiverOf] decides the receiver type, [checkReceiverScript] checks the file against it. Which files are
 * receiver scripts is decided before anything here runs (`semantics/scripts.trb`), because a receiver script is a
 * module in its own right and everything the checker keeps is per module.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Statement from "../../syntax/ast"
use joinPath from "../../project/path"
use ModuleId, ScriptReceiver from "../module"
use TypeId from "./type"
use Checker, TypeScope, LocalBinding, ReceiverClosure from "./context"
use typeFromReference from "./lowering"
use checkStatement from "./statement"
use settleChanges from "./mutation"

/**
 * The type a script's body is checked against: `Project` for `project.trb`, or the type argument of the
 * `Sandbox.load` that named the file. `None` where the file is not a receiver script, or nothing says which type.
 */
public fn scriptReceiverOf(var checker: Checker, module: ModuleId): TypeId? {
  const script = checker.program.graph.at(module).receiver?
  match script {
    .ProjectFile => projectType checker
    // The type argument of the `Sandbox.load` that names the file, in a type position of the module that loads it
    .Loaded(from, annotation) => Some typeFromReference(checker, annotation, TypeScope(from))
  }
}

/**
 * The `Project` of `std/project`. It is looked up by package and name, not through the scope of the script: a project
 * file names no imports, and the vocabulary of one is not something a project could redefine.
 */
fn projectType(var checker: Checker): TypeId? {
  const package = checker.program.workspace.packageNamed("std/project")?
  const path = joinPath package.directory, "src/lib.trb"
  const module = checker.program.graph.moduleAt(path)?
  const symbol = checker.program.scopes[module.value].exported.get("Project")?
  Some checker.nominal(symbol, [])
}

/**
 * The file as the body of `(var self: Receiver) => Void`. The top level of a script is ordinary code - bindings,
 * loops, conditions and functions - and the one thing that makes it a script is the receiver: a bare name may mean a
 * member of it, and `self` names it. The file scope is the prelude and nothing else: there is no purity analysis
 * behind that, the prelude has no IO, and what a script may reach beyond it is granted where it is loaded, so a
 * `use` in the file itself is reported by [reportImport] instead of naming a capability the script could give itself.
 */
public fn checkReceiverScript(var checker: Checker, module: ModuleId, receiver: TypeId) {
  const statements = checker.program.graph.at(module).file.statements
  const nothing = checker.voidType
  const saved = checker.enterBody module, nothing, true, None
  // A receiver script is a script, and `await()` is allowed at its top level (CONCEPT, "Concurrency")
  checker.awaitsTasks = true
  checker.openScope()
  const binding = checker.declareBinding(
    LocalBinding("self", receiver, true, Span(0, 0), isReceiver: true)
  )
  checker.setReceiver binding
  // The file *is* the closure, so its receiver is recorded where a closure would record its own: at its own span
  checker.recordReceiver Span(0, 0), ReceiverClosure(binding, receiver, true, true)
  // Every statement is an ordinary one, not a top-level declaration of a module: a `const` of a script is a *local* of
  // the closure, so it may read the receiver (`const binary = name.substringAfter("/") ?? name`) and what came before it
  for statement in statements {
    reportImport checker, statement
    const _ = checkStatement checker, statement
  }
  // The file is a body like any other, so a change in it that nothing reads afterwards is reported the same way
  settleChanges checker
  checker.closeScope()
  checker.leaveBody saved
}

/** Everything beyond the prelude is granted at the call site of `Sandbox.load`, never by the script itself. */
fn reportImport(var checker: Checker, statement: Statement) {
  if const .Declare(declaration) = statement.kind {
    if const .Use(_) = declaration.kind {
      checker.reportHere(
        Diagnostic.error("A receiver script reaches the prelude and nothing else, so it cannot `use` a module", declaration.span)
          .withNote(
            "What a script may reach beyond the prelude is granted where it is loaded:"
              + " `Sandbox.load<Value>(path) \{ modules \"std/text\" \}`"
          )
      )
    }
  }
}
