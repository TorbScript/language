/**
 * Receiver scripts: checking a `.trb` file that is the body of a receiver closure instead of an ordinary module.
 * `project.trb` and a configuration file loaded through `Sandbox.load` are the same mechanism with a different
 * receiver type - "`project.trb` and `project.lock.trb` are exactly this mechanism with the receiver `Project`"
 * (CONCEPT.md, "Receiver Scripts and the Sandbox").
 *
 * [scriptReceiverOf] decides the receiver type, [checkReceiverScript] checks the file against it. Which files are
 * receiver scripts is decided before anything here runs (`semantics/scripts.trb`), because a receiver script is a
 * module in its own right and everything the checker keeps is per module.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Statement from "../../syntax/ast"
use joinPath from "../../project/path"
use ModuleId, ScriptReceiver from "../module"
use TypeId from "./type"
use Checker, TypeScope, LocalBinding, ReceiverClosure from "./context"
use typeFromReference from "./lowering"
use checkStatement from "./statement"
use settleChanges from "./mutation"

/**
 * The type a script's body is checked against: `Project` for `project.trb`, or the type argument of the
 * `Sandbox.load` that named the file. `None` where the file is not a receiver script, or nothing says which type.
 */
public fn scriptReceiverOf(var checker: Checker, module: ModuleId): TypeId? {
  const script = checker.program.graph.at(module).receiver?
  match script {
    .ProjectFile => projectType checker
    // The type argument of the `Sandbox.load` that names the file, in a type position of the module that loads it
    .Loaded(from, annotation) => Some typeFromReference(checker, annotation, TypeScope(from))
  }
}

/**
 * The `Project` of `std/project`. It is looked up by package and name, not through the scope of the script: a project
 * file names no imports, and the vocabulary of one is not something a project could redefine.
 */
fn projectType(var checker: Checker): TypeId? {
  const package = checker.program.workspace.packageNamed("std/project")?
  const path = joinPath package.directory, "src/lib.trb"
  const module = checker.program.graph.moduleAt(path)?
  const symbol = checker.program.scopes[module.value].exported.get("Project")?
  Some checker.nominal(symbol, [])
}

/**
 * The file as the body of `(var self: Receiver) => Void`. The top level of a script is ordinary code - bindings,
 * loops, conditions and functions - and the one thing that makes it a script is the receiver: a bare name may mean a
 * member of it, and `self` names it. The file scope is the prelude, the receiver, and what the script imports - and an
 * import is a capability, so [reportImport] holds it against the grant wherever the grant is known here
 * (docs/design/SCRIPTS.md section 2).
 */
public fn checkReceiverScript(var checker: Checker, module: ModuleId, receiver: TypeId) {
  const statements = checker.program.graph.at(module).file.statements
  const isProjectFile = if const Some(.ProjectFile) = checker.program.graph.at(module).receiver { true } else { false }
  const nothing = checker.voidType
  const saved = checker.enterBody module, nothing, true, None
  // A receiver script is a script, and `await()` is allowed at its top level (CONCEPT, "Concurrency")
  checker.awaitsTasks = true
  checker.openScope()
  const binding = checker.declareBinding(
    LocalBinding("self", receiver, true, Span(0, 0), isReceiver: true)
  )
  checker.setReceiver binding
  // The file *is* the closure, so its receiver is recorded where a closure would record its own: at its own span
  checker.recordReceiver Span(0, 0), ReceiverClosure(binding, receiver, true, true)
  // Every statement is an ordinary one, not a top-level declaration of a module: a `const` of a script is a *local* of
  // the closure, so it may read the receiver (`const binary = name.substringAfter("/") ?? name`) and what came before it
  for statement in statements {
    reportImport checker, statement, isProjectFile
    const _ = checkStatement checker, statement
  }
  // The file is a body like any other, so a change in it that nothing reads afterwards is reported the same way
  settleChanges checker
  checker.closeScope()
  checker.leaveBody saved
}

/**
 * The modules a `project.trb` may import: the toolchain's grant, which never changes (docs/design/SCRIPTS.md section 7
 * and PROJECT.md section 8) - the files of its directory, what to do with their text, and the environment.
 */
public const projectFileModules = ["std/fs", "std/text", "std/os/environment"]

/** What no grant gives a script (docs/design/SCRIPTS.md section 2): the VM's own kernel, and loading scripts itself. */
public const neverGrantedModules = ["std/machine", "std/sandbox"]

/**
 * The directories of `std/os` that hold the raw natives of one operating system, or of one standard several share: no
 * grant gives a script one, because the sandbox grants the OS-neutral questions only (docs/design/OS.md section 8). A
 * granted neutral module still reaches them - that is its implementation, not the script's import.
 */
public const systemModules = [
  "std/os/windows",
  "std/os/linux",
  "std/os/macos",
  "std/os/freebsd",
  "std/os/posix",
  "std/os/bsd",
  "std/os/xdg",
]

/**
 * An import is a capability. What no grant gives is an error in every script; for a `project.trb`, whose grant the
 * toolchain fixes, every other module is held against that grant here. A script a program loads is granted modules at
 * the call site, so its imports are held against them when `Sandbox.load` reads it, not here.
 */
fn reportImport(var checker: Checker, statement: Statement, isProjectFile: Bool) {
  const declaration = match statement.kind {
    .Declare(found) => found
    _ => {
      return
    }
  }
  const path = match declaration.kind {
    .Use(usage) => {
      match usage.source {
        .Module(found) => found
        .Local => {
          return
        }
      }
    }
    _ => {
      return
    }
  }
  const package = packageOfImport path
  const module = moduleOfImport path
  if systemModules.contains(module) {
    checker.reportHere(
      Diagnostic.error("A receiver script cannot import `{module}`", declaration.span)
        .withNote(
          "The directory holds the natives of one system, and a script is granted the modules of `std/os` that ask the"
            + " same question on every system: `std/os/environment`, `std/os/system`, `std/os/directories`"
        )
    )
    return
  }
  if neverGrantedModules.contains(package) {
    checker.reportHere(
      Diagnostic.error("A receiver script cannot import `{package}`", declaration.span)
        .withNote(
          "`std/machine` trusts its operands the way machine code does, and a script that loads scripts is a nesting the"
            + " sandbox does not have: no grant gives either"
        )
    )
    return
  }
  if isProjectFile && !projectFileModules.contains(module) {
    checker.reportHere(
      Diagnostic.error(
        "A project file may import `std/fs`, `std/text` and `std/os/environment`, and not `{path}`",
        declaration.span,
      )
        .withNote("A project file reads its own directory and the environment it was started in, nothing else")
    )
  }
}

/** `std/text` of `"std/text/lines"`: the package an import path names, or the path itself where it is relative. */
public fn packageOfImport(path: String): String {
  if path.startsWith(".") {
    return path
  }
  const segments = path.split("/").toList()
  if segments.length() < 2 {
    return path
  }
  "{segments[0]}/{segments[1]}"
}

/**
 * What a grant names for an import: its package, `std/text` of `"std/text/lines"` - except inside `std/os`, whose modules
 * are granted one at a time (docs/design/OS.md section 8), so `"std/os/environment"` is itself and `"std/os"` the whole
 * package. A relative path is itself.
 */
public fn moduleOfImport(path: String): String {
  const package = packageOfImport path
  if package != "std/os" {
    return package
  }
  const segments = path.split("/").toList()
  if segments.length() < 3 {
    return package
  }
  "std/os/{segments[2]}"
}
