/**
 * Calls: [checkCall] decides which parameter every written argument fills, what the generic parameters of the callee
 * turn out to be, and which implementation makes every bound of it hold.
 *
 * The arguments are checked in **two passes** - everything that is not a closure first, in source order, then the
 * closures. That is what makes `fold(0) { sum, number => sum + number }` work without an annotation: `State` is solved
 * by the `0` before the closure is read from it.
 *
 * Everything the back ends must not work out again is recorded per call span: the parameter of every argument, the type
 * arguments the call was instantiated with, one witness per bound, and everything the source did not spell out.
 */

use Span from "../../syntax/source"
use staticKeyword from "../../syntax/token"
use Diagnostic from "../../syntax/diagnostic"
use Expression, Argument, CallStyle from "../../syntax/ast"
use editDistance from "../resolve-types"
use TypeId, FunctionForm, ParameterForm, ParameterMode, ParameterId, Bound, Witness from "./type"
use Checker, Expectation, Resolution, Adaptation, Dispatch, Candidate from "./context"
use Target, targetOfCandidate from "./name"
use checkExpression, inferExpression, deferExpression, deferArguments from "./expression"
use resolveTarget, expectationOf from "./expression"
use substituteFunction, substituteBounds, sameType, unify, resolveType, resolveTypes, openVariableOf from "./unify"
use witnessFor, isConcrete, traitArgumentsOf, fitsType from "./implementation"
use propertyWrite from "./command"
use openReceiverAccess, openArgumentAccess, closeAccessesTo, checkCallReads from "./place"
use noteArgumentClosures from "./mutation"
use taskValueOf from "./statement"
use isQuotation, openThunk, closeThunk from "./quote"
use checkConstruction, checkSharedIdentity, requireSharedFields from "./declaration"

/** Which parameter every written argument fills, and what the call adds to what was written. */
public type ArgumentPlan {
  /** In written order: the parameter an argument fills, `-1` where nothing matched (a message was given). */
  targets: List<Int>
  /** In declaration order: the parameters that were not written and take their default. */
  defaults: List<Int>
  /** The parameter that collects the rest, and the written argument it starts at. `-1` when there is none. */
  variadic: Int
  variadicFrom: Int
}

/** A generic callee with its parameters filled in: fresh variables where the call site did not write them out. */
public type Instantiation {
  form: FunctionForm
  /** In the order of the callee's own generic parameters. This is what the lowering monomorphizes from. */
  arguments: List<TypeId>
  bounds: List<Bound>
}

/**
 * `f(a, b)`, `f a, b`, `list.map { ... }`: a call, or the property command it turns out to be once the callee
 * resolves to a field instead of a function ([propertyWrite]). Resolves the callee, matches and checks every
 * argument, instantiates the generic parameters, checks the bounds they have to satisfy, and records everything a
 * later pass needs to emit the call without looking at a name again.
 */
public fn checkCall(
  var checker: Checker,
  expression: Expression,
  callee: Expression,
  arguments: List<Argument>,
  style: CallStyle,
  expected: Expectation,
): TypeId {
  // The expected type of the whole call reaches the callee, which is what makes `Some(keyword)` an `Option<Keyword>`
  const wanted = expected.annotationOf()
  var target = resolveTarget checker, callee, wanted
  if !target.overloads.isEmpty() {
    // The chosen one is bound first and assigned after: `chooseOverload` reads the target it is given rather than
    // taking it over, so writing its answer straight back into the same binding would overwrite a value the call is
    // still reading
    const chosen = chooseOverload checker, target, arguments, wanted, expression.span
    target = chosen
  }
  // `port 8080`, `onStart { ... }`, `database { ... }`: a call of a member that is not callable writes it
  if const Some(written) = propertyWrite(checker, expression, callee, target, arguments, style) {
    return written
  }
  const form = match target.form {
    Some(found) => found
    // A call of something that is not a function, which nothing here can resolve
    None => {
      checker.resolved callee.span, target.resolution
      const _ = checker.typed callee.span, target.annotation
      deferArguments checker, arguments
      checker.resolved expression.span, Resolution.Deferred
      return checker.deferredType
    }
  }
  // `await()` says where it stands: a function that waits declares a `Task` result (CONCEPT, "Concurrency")
  requireAwaitAllowed checker, callee, target.name, expression.span
  const instantiation = instantiateTarget checker, target, form, expression.span
  const inner = instantiation.form
  checker.resolved callee.span, target.resolution
  const shown = checker.functionType inner
  const _ = checker.typed callee.span, shown
  // What the whole call has to produce is known before its arguments are: `employees.collect(maxBy { _.age })` learns
  // the `Item` of `maxBy` from the parameter of `collect` and only then reads the closure. Nothing is reported here -
  // the real check happens where the value arrives - and a variable is only ever solved by an exact type
  if const Some(annotation) = wanted {
    matchResult checker, inner.result, annotation
  }
  // A private field cannot be passed from outside the type, which is what makes a constructor usable or not
  checkConstruction checker, target, arguments, expression.span
  // Places and the mutation rules. The receiver of a `var fn` call stays an open access while the
  // arguments are evaluated and while a closure argument runs, which is what makes the DSL rule work; every `var`
  // argument joins it as it is checked; and at the end everything the call *reads* is held against all of them
  const openAccesses = checker.accesses.length()
  checker.callSerial = checker.callSerial + 1
  const call = checker.callSerial
  const isVarReceiver = target.isVarSelf
  // A call that changes something and produces nothing, and a call whose result is thrown away, are changes and nothing
  // else - the only case the dead-change rule has anything to say about (design 5.3). `cursor.next()` hands its value on
  // and is therefore never one, wherever it stands
  const isDiscarded = expected.isStatement() || isEffectOnly(checker, inner.result)
  openReceiverAccess checker, callee, isVarReceiver, target.name, isDiscarded, call
  const plan = matchArguments checker, target, inner, arguments, expression.span
  const calleeName = target.name
  checkArguments checker, inner, arguments, plan, calleeName, isDiscarded, call
  // A `var` field with an identity needs a `var` path, wherever the constructor is called from. After the
  // arguments, because the paths it asks about are the ones checking them recorded
  requireSharedFields checker, target, arguments
  // `spawn { ... }` takes no `var` binding with it, and the captures it would take are recorded by now
  requireTaskCaptures checker, target, arguments
  checkCallReads checker, callee, arguments, plan.targets, inner.parameters, isVarReceiver
  closeAccessesTo checker, openAccesses
  const witnesses = checkBounds checker, instantiation.bounds, target.name, expression.span
  const solved = resolveTypes checker, instantiation.arguments
  // `isSame` compares identity, and only a `shared type` has one
  checkSharedIdentity checker, target, solved, expression.span
  if !solved.isEmpty() {
    checker.recordTypeArguments expression.span, solved
  }
  if !witnesses.isEmpty() {
    checker.recordWitnesses expression.span, witnesses
  }
  const resolution = withInstantiation target.resolution, solved, witnesses
  checker.resolved expression.span, resolution
  recordPlan checker, expression.span, inner, plan
  resolveType checker, inner.result
}

/** A call that produces nothing was written for its effect, whatever position it stands in. */
fn isEffectOnly(checker: Checker, result: TypeId): Bool {
  result == checker.voidType || result == checker.neverType
}

/**
 * A fresh variable for every generic parameter the call site did not write out. Explicit type arguments are taken from
 * the left (`into<Set<Employee>>()`), so a call may pin some of them down and leave the rest to inference.
 */
public fn instantiateTarget(
  var checker: Checker,
  target: Target,
  form: FunctionForm,
  at: Span,
): Instantiation {
  if target.generics.isEmpty() {
    if !target.arguments.isEmpty() {
      reportTypeArity checker, target.name, 0, target.arguments.length(), at
    }
    return Instantiation form, [], target.bounds
  }
  if target.arguments.length() > target.generics.length() {
    reportTypeArity checker, target.name, target.generics.length(), target.arguments.length(), at
  }
  var mapping: Map<ParameterId, TypeId> = [:]
  var solved: List<TypeId> = []
  for index in 0..target.generics.length() {
    const parameter = target.generics[index]
    var argument = checker.deferredType
    if index < target.arguments.length() {
      argument = target.arguments[index]
    } else {
      const declared = checker.types.parameter parameter
      argument = checker.newVariable declared.name, target.name, at, isConst: declared.isConst
    }
    mapping.set parameter, argument
    solved.add argument
  }
  const instantiated = substituteFunction checker.types, form, mapping
  const bounds = substituteBounds checker.types, target.bounds, mapping
  Instantiation instantiated, solved, bounds
}

/**
 * The result of the callee against the type that is expected of the whole call, silently: whatever the two have in
 * common solves a variable. Where the value will have to *coerce* (a concrete type into a trait type) the arguments of
 * the trait are what carries the information, so those are matched as well.
 */
fn matchResult(var checker: Checker, result: TypeId, expected: TypeId) {
  if checker.absorbs(result) || checker.absorbs(expected) {
    return
  }
  const bounds = match checker.types.form(expected) {
    .Traits(found) => found
    _ => {
      const _ = unify checker, result, expected
      return
    }
  }
  // A value *coerces* into a trait type, and a coercion never solves a variable (design 2.5): `print(pipeline.collect(c))`
  // must not decide that the `Output` of `collect` is `Show` itself
  if openVariableOf(checker, result).isSome() {
    return
  }
  if unify(checker, result, expected) {
    return
  }
  for bound in bounds {
    const (capability, arguments) = match checker.types.form(bound) {
      .Nominal(symbol, given) => (symbol, given)
      _ => {
        continue
      }
    }
    const actual = match traitArgumentsOf(checker, result, capability) {
      Some(found) => found
      None => {
        continue
      }
    }
    if actual.length() != arguments.length() {
      continue
    }
    for index in 0..arguments.length() {
      const _ = unify checker, arguments[index], actual[index]
    }
  }
}

/**
 * **The one overload form the language has** (CONCEPT, "No overloading by parameter type"): a trait with a parameter,
 * implemented several times on one type. `Int64` implements `From<Int32>`, `From<UInt8>` and three more, so `Int.from`
 * is one name with five signatures; `Game` implements `Store<Position>` and `Store<Velocity>`, so `attach`, `attachAt`
 * and `valueOf` each are two.
 *
 * Which one is meant is decided by **everything the call says**: every argument that is not a closure, and - where the
 * arguments leave more than one standing - the type the call is expected to produce, which is the only thing that tells
 * `const named: String? = game.valueOf()` from the `Int` one. Exactly one candidate is the answer, several are an
 * ambiguity that names them, and none is the message that lists what exists.
 */
fn chooseOverload(
  var checker: Checker,
  target: Target,
  arguments: List<Argument>,
  expected: TypeId?,
  at: Span,
): Target {
  // What every written argument is, inferred once. A closure and a spread say nothing: a closure is read *from* the
  // parameter it fills, so reading it here would decide the candidate by a guess
  var given: List<TypeId?> = []
  for argument in arguments {
    if argument.isSpread || isClosureArgument(argument) {
      given.add None
      continue
    }
    const found = inferExpression checker, argument.value
    given.add(if checker.absorbs(found) { None } else { Some found })
  }
  var fitting: List<Candidate> = []
  var exact: List<Candidate> = []
  for candidate in target.overloads {
    if fitsArguments(checker, candidate, arguments, given, isExact: false) {
      fitting.add candidate
    }
    if fitsArguments(checker, candidate, arguments, given, isExact: true) {
      exact.add candidate
    }
  }
  // A candidate whose parameters *are* the types that were written beats one that only cannot be ruled out: an argument
  // of a generic parameter's type fits every candidate, and that is not what "it fits" is supposed to mean
  if !exact.isEmpty() {
    fitting = exact
  }
  if fitting.isEmpty() {
    reportNoOverload checker, target, given, at
    // One root cause, one message: the argument is checked against nothing after this, and the call is `Invalid`
    const broken = checker.invalidType
    return target.copy form: Some(FunctionForm([ParameterForm(None, ParameterMode.Value, broken)], broken))
  }
  if fitting.length() == 1 {
    return targetOfCandidate checker, fitting[0], target.name
  }
  const narrowed = narrowByResult checker, fitting, expected
  if narrowed.length() == 1 {
    return targetOfCandidate checker, narrowed[0], target.name
  }
  // Nothing in the call tells them apart, so it is named: taking the first one silently is how a `Store<Position>`
  // answers where a `Store<Velocity>` is meant, and the IR verifier is then what finds it
  reportAmbiguousOverload checker, target, narrowed, at
  targetOfCandidate checker, narrowed[0], target.name
}

/**
 * The candidates whose result may stand where the call is expected to produce one. A call with no expected type, or one
 * whose expectation is still open, narrows nothing - and a filter that leaves nothing standing is no filter at all, so
 * the list comes back unchanged and the ambiguity is reported over all of them.
 */
fn narrowByResult(var checker: Checker, fitting: List<Candidate>, expected: TypeId?): List<Candidate> {
  const wanted = match expected {
    Some(found) => found
    None => {
      return fitting
    }
  }
  if checker.absorbs(wanted) || !isConcrete(checker, wanted) {
    return fitting
  }
  var narrowed: List<Candidate> = []
  for candidate in fitting {
    if const Some(form) = candidate.form {
      if fitsType(checker, form.result, wanted) {
        narrowed.add candidate
      }
    }
  }
  if narrowed.isEmpty() {
    return fitting
  }
  narrowed
}

/**
 * Whether one candidate of the overload set can be what was written: every argument fills a parameter it fits, and the
 * call writes no more arguments than the candidate has parameters. An argument the call says nothing about - a closure,
 * a spread, something already broken - fits every candidate, because it is not what tells them apart.
 */
fn fitsArguments(
  var checker: Checker,
  candidate: Candidate,
  arguments: List<Argument>,
  given: List<TypeId?>,
  isExact: Bool,
): Bool {
  const form = match candidate.form {
    Some(found) => found
    None => {
      return false
    }
  }
  const parameters = form.parameters
  if arguments.length() > parameters.length() {
    return false
  }
  var index = 0
  for argument in arguments {
    const position = match argument.label {
      Some(label) => indexOfParameter parameters, label.text
      None => index
    }
    if position < 0 || position >= parameters.length() {
      return false
    }
    if const Some(found) = given[index] {
      const wanted = parameters[position].annotation
      const fits = if isExact {
        sameType checker.types, found, wanted
      } else {
        fitsType checker, found, wanted
      }
      if !fits {
        return false
      }
    } else if isExact {
      return false
    }
    index = index + 1
  }
  true
}

fn reportNoOverload(var checker: Checker, target: Target, given: List<TypeId?>, at: Span) {
  var offered: List<String> = []
  for candidate in target.overloads {
    if takesNever(checker, candidate) {
      continue
    }
    offered.add describeOverload(checker, candidate)
  }
  const shown = describeWritten checker, given
  checker.reportHere(
    Diagnostic.error("`{target.name}` takes none of these from a `{shown}`", at)
      .withNote("`{target.name}` exists for {offered.joined(separator: ", ")}")
  )
}

fn reportAmbiguousOverload(var checker: Checker, target: Target, fitting: List<Candidate>, at: Span) {
  var offered: List<String> = []
  for candidate in fitting {
    offered.add describeOverload(checker, candidate)
  }
  const shown = offered.joined separator: ", "
  checker.reportHere(
    Diagnostic.error("`{target.name}` fits more than one implementation here", at)
      .withNote(
        "It exists for {shown}: write the type that is expected of this call, or name it with a type argument"
      )
  )
}

/**
 * `extend<Target> Target with From<Never>`: the total conversion every type has, because there is no value of `Never`.
 * Nobody writes it and nobody can call it, so it is left out of the list a message offers.
 */
fn takesNever(checker: Checker, candidate: Candidate): Bool {
  if const Some(form) = candidate.form {
    if const Some(parameter) = form.parameters.first() {
      return parameter.annotation == checker.neverType
    }
  }
  false
}

/** One entry of the list a message shows: the parameters a candidate takes, or its result when it takes none. */
fn describeOverload(var checker: Checker, candidate: Candidate): String {
  const form = match candidate.form {
    Some(found) => found
    None => {
      return checker.describe candidate.annotation
    }
  }
  if const Some(parameter) = form.parameters.first() {
    return checker.describe parameter.annotation
  }
  checker.describe form.result
}

/** What the call wrote, for the message: one type reads as itself, several read as a list. */
fn describeWritten(var checker: Checker, given: List<TypeId?>): String {
  var written: List<String> = []
  for found in given {
    match found {
      Some(annotation) => written.add checker.describe(annotation)
      None => written.add "_"
    }
  }
  written.joined separator: ", "
}

/**
 * Positional arguments fill the parameters from the left, labeled ones follow and match by name, and the trailing
 * closure fills the last parameter whatever position it was written in.
 */
fn matchArguments(
  var checker: Checker,
  target: Target,
  form: FunctionForm,
  arguments: List<Argument>,
  at: Span,
): ArgumentPlan {
  const parameters = form.parameters
  const trailing = trailingClosureAt arguments, at
  var targets: List<Int> = []
  var filled: List<Bool> = []
  for _ in parameters {
    filled.add false
  }
  var variadic = -1
  var variadicFrom = -1
  var next = 0
  var hasSurplus = false
  for index in 0..arguments.length() {
    const argument = arguments[index]
    if index == trailing {
      targets.add(-1)
      continue
    }
    if const Some(label) = argument.label {
      const position = indexOfParameter parameters, label.text
      if position < 0 {
        reportUnknownLabel checker, target.name, parameters, label.text, label.span
        targets.add(-1)
        continue
      }
      if filled[position] {
        checker.reportHere Diagnostic.error("`{label.text}` already has an argument", label.span)
        targets.add(-1)
        continue
      }
      filled.set position, true
      targets.add position
      continue
    }
    // A variadic parameter is last and collects every positional argument from here on
    if variadic >= 0 {
      targets.add variadic
      continue
    }
    while next < parameters.length() && filled[next] {
      next = next + 1
    }
    if next >= parameters.length() {
      hasSurplus = true
      targets.add(-1)
      continue
    }
    if const .Variadic = parameters[next].mode {
      variadic = next
      variadicFrom = index
      filled.set next, true
      targets.add next
      continue
    }
    filled.set next, true
    targets.add next
    next = next + 1
  }
  if trailing >= 0 {
    const closure = arguments[trailing].value.span
    placeTrailingClosure checker, target, parameters, filled, targets, trailing, closure
  }
  var defaults: List<Int> = []
  var isMissing = false
  for position in 0..parameters.length() {
    if filled[position] {
      continue
    }
    if parameters[position].hasDefault {
      defaults.add position
      continue
    }
    // A variadic parameter that collects nothing is an empty list, not a missing argument
    if const .Variadic = parameters[position].mode {
      continue
    }
    isMissing = true
  }
  if hasSurplus || isMissing {
    reportArity checker, target.name, parameters, arguments.length(), at
  }
  ArgumentPlan targets, defaults, variadic, variadicFrom
}

/** The trailing closure fills the last parameter, which is what makes `fold(0) { ... }` and `html { ... }` work. */
fn placeTrailingClosure(
  var checker: Checker,
  target: Target,
  parameters: List<ParameterForm>,
  var filled: List<Bool>,
  var targets: List<Int>,
  trailing: Int,
  at: Span,
) {
  const last = parameters.length() - 1
  if last < 0 {
    reportArity(checker, target.name, parameters, trailing + 1, at)
    return
  }
  if filled[last] {
    const name = parameters[last].name ?? "the last parameter"
    checker.reportHere(
      Diagnostic.error("The trailing closure fills `{name}`, which was already given by name", at)
    )
    return
  }
  filled.set last, true
  targets.set trailing, last
  checker.adapted at, Adaptation.TrailingClosure(last)
}

/**
 * The index of the argument that is a trailing closure: written after the argument list, so its text ends where the
 * whole call ends. A closure inside of the parentheses is an ordinary argument.
 */
public fn trailingClosureAt(arguments: List<Argument>, at: Span): Int {
  const index = arguments.length() - 1
  if index < 0 {
    return -1
  }
  const last = arguments[index]
  if last.label.isSome() || last.isSpread || last.value.span.end != at.end {
    return -1
  }
  if const .Closure(_) = last.value.kind {
    return index
  }
  -1
}

fn indexOfParameter(parameters: List<ParameterForm>, name: String): Int {
  for index in 0..parameters.length() {
    if parameters[index].name == Some(name) {
      return index
    }
  }
  -1
}

// --- Checking the arguments themselves ------------------------------------------------------------------------------

/**
 * Two passes: everything that is not a closure first, so that the generic parameters a closure is read from are solved
 * by then (design 2.6). Within a pass the arguments are checked in source order, which is the order they are written in
 * and not the one they are evaluated in - `Adaptation.Reorder` records that.
 */
fn checkArguments(
  var checker: Checker,
  form: FunctionForm,
  arguments: List<Argument>,
  plan: ArgumentPlan,
  callee: String,
  isDiscarded: Bool,
  /** Which call this is, so that two `var` accesses of it are told from an access of the call around it. */
  call: Int,
) {
  // A closure written straight as an argument cannot outlive the call, which is what lets it hold a reference
  noteArgumentClosures checker, arguments
  // The ordinary arguments first, then the closures: every `var` access of the call is open by the time a closure of it
  // runs, and every read of an ordinary argument has ended before the accesses begin (the Swift model of exclusivity)
  checkArgumentPass checker, form, arguments, plan, false, callee, isDiscarded, call
  checkArgumentPass checker, form, arguments, plan, true, callee, isDiscarded, call
}

fn checkArgumentPass(
  var checker: Checker,
  form: FunctionForm,
  arguments: List<Argument>,
  plan: ArgumentPlan,
  isClosurePass: Bool,
  /** The name of the callee: what the exclusivity message calls the change, and what quotes a quoted argument. */
  callee: String,
  isDiscarded: Bool,
  call: Int,
) {
  const parameters = form.parameters
  for index in 0..arguments.length() {
    const argument = arguments[index]
    if isClosureArgument(argument) != isClosurePass {
      continue
    }
    const position = plan.targets.get(index) ?? -1
    if position < 0 || position >= parameters.length() {
      const _ = inferExpression checker, argument.value
      continue
    }
    const parameter = parameters[position]
    if argument.isSpread {
      checkSpread checker, argument, parameter
      continue
    }
    // What the parameter is may have been learned from an argument to its left, so it is resolved here and not before
    const annotation = resolveType checker, parameter.annotation
    const inner = expectationOf checker, annotation
    const at = argument.value.span
    // `lazy Value`: the argument is a thunk the callee evaluates at most once, so it becomes a closure of its own
    if const .Lazy = parameter.mode {
      checker.adapted at, Adaptation.Lazy
      openThunk checker, at
      const _ = checkExpression checker, argument.value, inner
      closeThunk checker, at
      continue
    }
    // `assert(x > 1)`: the message about a capture that is not `Encode` names what quotes it
    if isQuotation(checker, annotation) {
      checker.quotingOwner = callee
      checker.quotingParameter = parameter.name ?? ""
    }
    const _ = checkExpression checker, argument.value, inner
    // A `var` argument is a path into the caller's value, and it owns that path for the rest of the call
    if isVarArgument(parameter.mode) {
      const named = parameter.name ?? ""
      // A receiver closure changes its receiver through its own body, so `build(inner)` is not a change the dead-change
      // rule can judge: `var inner = Element()  build(inner)` is what every nested block of a DSL is, and calling that
      // change dead would reject it
      const notes = isDiscarded && !isReceiverArgument(parameter.mode)
      openArgumentAccess checker, argument.value, named, callee, notes, call
    }
  }
}

/**
 * Which parameter modes take a `var` path. The receiver of a **receiver closure** is one of them: `configure settings`
 * fills a `(var self: Settings) => Void`, and that argument is a path into the caller's value exactly as the argument of
 * a `var` parameter is - so it needs the same access and the same recorded `Place`, which the lowering forms the
 * reference from.
 */
fn isVarArgument(mode: ParameterMode): Bool {
  match mode {
    .Var => true
    .Receiver(isVar) => isVar
    _ => false
  }
}

fn isReceiverArgument(mode: ParameterMode): Bool {
  match mode {
    .Receiver(_) => true
    _ => false
  }
}

fn isVariadicParameter(mode: ParameterMode): Bool {
  match mode {
    .Variadic => true
    _ => false
  }
}

fn isClosureArgument(argument: Argument): Bool {
  match argument.value.kind {
    .Closure(_) => true
    _ => false
  }
}

/**
 * Where `await()` may stand (CONCEPT, "Concurrency"): in a function that returns a `Task<...>`, in a closure handed to
 * `spawn`, at the top level of an entry file or a script, and inside a closure written in one of those - a closure runs
 * where it stands. Everywhere else it is a mistake, because "a function that waits says so in its return type"; a
 * blocking `await()` anywhere would need a stack per task in every back end.
 *
 * The member is found by its name plus a receiver that is a `Task`, which is the one thing that makes it this call.
 */
fn requireAwaitAllowed(var checker: Checker, callee: Expression, name: String, at: Span) {
  if name != "await" || checker.awaitsTasks {
    return
  }
  const base = match callee.kind {
    .Member(inner, _, _) => inner
    _ => {
      return
    }
  }
  const receiver = match checker.expressionTypeHere(base.span) {
    Some(found) => found
    None => {
      return
    }
  }
  if taskValueOf(checker, receiver).isNone() {
    return
  }
  checker.reportHere(
    Diagnostic.error("`await()` is only allowed in a function that returns a `Task`", at)
      .withNote(
        "A function that waits says so in its result type. `spawn \{ ... \}` starts a task, and the top level of an"
          + " entry file or a script may wait for one"
      )
  )
}

/**
 * What a closure handed to `spawn` may take with it (CONCEPT, "Concurrency"): copies, and nothing else. A `const`
 * binding is captured as a copy, and so is every value; a **captured `var` binding is a shared box** - the one place of
 * the language where a variable is shared - and sharing one between two tasks is the data race the design says cannot
 * happen. So one `spawn` closure that captures one `var` is already the error, and two of them are two errors.
 *
 * The captures of the closure are recorded under its own span while its body is checked, so this asks the same list the
 * lowering builds the environment from.
 */
fn requireTaskCaptures(var checker: Checker, target: Target, arguments: List<Argument>) {
  const spawn = match checker.wellKnown.spawn {
    Some(found) => found
    None => {
      return
    }
  }
  if const .Callable(symbol, _, _) = target.resolution {
    if symbol != spawn {
      return
    }
  } else {
    return
  }
  for argument in arguments {
    if !isClosureArgument(argument) {
      continue
    }
    const captures = checker.capturesAt(checker.module, argument.value.span) ?? []
    for capture in captures {
      if !capture.isVar {
        continue
      }
      const binding = checker.bindings[capture.binding.value]
      checker.reportHere(
        Diagnostic.error(
          "`spawn` cannot take the `var` binding `{binding.name}` with it",
          argument.value.span,
        )
          .withNote(
            "A task gets copies, so there is nothing to race for - and a captured `var` binding is the one value the"
              + " language shares. Read it into a `const` before the closure (`const {binding.name}Now ="
              + " {binding.name}`), or pass the changes through a `Channel`"
          )
      )
    }
  }
}

/** `...expression` spreads any `Iterable<Item>` into a variadic parameter; a collection is never spread implicitly. */
fn checkSpread(var checker: Checker, argument: Argument, parameter: ParameterForm) {
  const given = inferExpression checker, argument.value
  checker.adapted argument.value.span, Adaptation.Spread
  if checker.absorbs(given) {
    return
  }
  // Only a `...rest: Item` parameter takes the items of a collection one by one (design 3.4). Everything else takes one
  // value, and handing it a collection is the mistake the reverse direction has always been
  if !isVariadicParameter(parameter.mode) {
    const named = parameter.name ?? "its parameter"
    checker.reportHere(
      Diagnostic.error("`{named}` is not a variadic parameter, so `...` cannot spread into it", argument.value.span)
        .withNote("A `...` fills a `...rest: Item` parameter, and there is none here")
    )
    return
  }
  const iterable = match checker.wellKnown.iterable {
    Some(found) => found
    None => {
      return
    }
  }
  match traitArgumentsOf(checker, given, iterable) {
    Some(found) => {
      if const Some(item) = found.first() {
        const _ = unify checker, item, parameter.annotation
      }
    }
    None => {
      if isConcrete(checker, given) {
        const shown = checker.describe given
        checker.reportHere(
          Diagnostic.error("`{shown}` is not `Iterable`, so `...` cannot spread it", argument.value.span)
        )
      }
    }
  }
}

// --- Bounds and witnesses -------------------------------------------------------------------------------------------

/**
 * Every bound of the callee, with the solutions put in: one witness per trait, in the order of `Signature.bounds`. This
 * is the list the lowering reads to decide between monomorphizing and passing a table, so it is recorded even where the
 * call itself is `Dispatch.Direct`.
 */
public fn checkBounds(var checker: Checker, bounds: List<Bound>, owner: String, at: Span): List<Witness> {
  var witnesses: List<Witness> = []
  for bound in bounds {
    const subject = resolveType checker, bound.subject
    for capability in bound.traits {
      const wanted = resolveType checker, capability
      const found = witnessFor checker, subject, wanted
      if const .Unresolved = found {
        reportUnmetBound checker, subject, wanted, owner, at
      }
      witnesses.add found
    }
  }
  witnesses
}

/**
 * A bound that does not hold. Nothing is said about a subject that is not concrete: what a generic parameter of the
 * *enclosing* declaration implements is decided where that one is called, and an unsolved variable was already reported
 * as "cannot infer".
 */
fn reportUnmetBound(var checker: Checker, subject: TypeId, wanted: TypeId, owner: String, at: Span) {
  if !isConcrete(checker, wanted) {
    return
  }
  const shown = checker.describe wanted
  if const .Parameter(_) = checker.types.form(subject) {
    const name = checker.describe subject
    checker.reportHere(
      Diagnostic.error("`{name}` is not `{shown}`", at)
        .withNote("Add the bound to the declaration: `where {name}: {shown}`")
    )
    return
  }
  if !isConcrete(checker, subject) {
    return
  }
  const given = checker.describe subject
  var problem = Diagnostic.error "`{given}` does not implement `{shown}`", at
  if !owner.isEmpty() {
    problem = problem.withNote "`{owner}` asks for it"
  }
  checker.reportHere problem
}

/** The resolution of a call, with everything the call site learned: the type arguments and the witnesses. */
public fn withInstantiation(
  resolution: Resolution,
  arguments: List<TypeId>,
  witnesses: List<Witness>,
): Resolution {
  if const .Callable(symbol, _, dispatch) = resolution {
    return Resolution.Callable symbol, arguments, withWitnesses(dispatch, witnesses)
  }
  resolution
}

fn withWitnesses(dispatch: Dispatch, witnesses: List<Witness>): Dispatch {
  match dispatch {
    .Implementation(implementation, _) => Dispatch.Implementation implementation, witnesses
    .Object(bound, _) => Dispatch.Object bound, witnesses
    .Forwarded(parameter, bound, _) => Dispatch.Forwarded parameter, bound, witnesses
    _ => dispatch
  }
}

/** What the source does not spell out, in the order the lowering has to replay it in. */
fn recordPlan(var checker: Checker, at: Span, form: FunctionForm, plan: ArgumentPlan) {
  checker.recordArguments at, plan.targets
  if isReordered(plan.targets) {
    checker.adapted at, Adaptation.Reorder(plan.targets)
  }
  if plan.variadic >= 0 {
    const element = resolveType checker, form.parameters[plan.variadic].annotation
    checker.adapted at, Adaptation.Variadic(element, plan.variadicFrom)
  }
  for position in plan.defaults {
    checker.adapted at, Adaptation.DefaultArgument(position)
  }
}

/** Whether the written order differs from the declaration order, which is the only case worth recording. */
fn isReordered(targets: List<Int>): Bool {
  var highest = -1
  for position in targets {
    if position < 0 {
      continue
    }
    if position < highest {
      return true
    }
    highest = position
  }
  false
}

// --- Messages -------------------------------------------------------------------------------------------------------

fn reportArity(var checker: Checker, name: String, parameters: List<ParameterForm>, given: Int, at: Span) {
  var required = 0
  for parameter in parameters {
    const isOptional = parameter.hasDefault || isVariadic(parameter)
    if !isOptional {
      required = required + 1
    }
  }
  const takes = if required == 1 { "1 argument" } else { "{required} arguments" }
  const was = if given == 0 {
    "none were given"
  } else if given == 1 {
    "1 was given"
  } else {
    "{given} were given"
  }
  var report = Diagnostic.error "`{name}` takes {takes}, {was}", at
  // `Point.area()`: a method read through its type is the unbound function, so its receiver is one of the arguments
  if given == required - 1 && takesReceiver(parameters) {
    report = report.withNote "`{name}` is a method: call it on a value, or declare it `{staticKeyword} fn`"
  }
  checker.reportHere report
}

/** Whether the first parameter is the receiver: what tells a method from a function of the same shape. */
fn takesReceiver(parameters: List<ParameterForm>): Bool {
  if const Some(first) = parameters.get(0) {
    if const .Receiver(_) = first.mode {
      return true
    }
  }
  false
}

fn reportTypeArity(var checker: Checker, name: String, expected: Int, given: Int, at: Span) {
  const wanted = if expected == 0 {
    "no type arguments"
  } else if expected == 1 {
    "1 type argument"
  } else {
    "{expected} type arguments"
  }
  checker.reportHere Diagnostic.error("`{name}` takes {wanted}, {given} were given", at)
}

fn isVariadic(parameter: ParameterForm): Bool {
  match parameter.mode {
    .Variadic => true
    _ => false
  }
}

fn reportUnknownLabel(
  var checker: Checker,
  name: String,
  parameters: List<ParameterForm>,
  label: String,
  at: Span,
) {
  var problem = Diagnostic.error "`{name}` has no parameter `{label}`", at
  if const Some(similar) = nearestParameter(parameters, label) {
    problem = problem.withNote "Did you mean `{similar}`?"
  }
  checker.reportHere problem
}

fn nearestParameter(parameters: List<ParameterForm>, label: String): String? {
  var best: String? = None
  var distance = 3
  for parameter in parameters {
    const name = parameter.name ?? ""
    if name.isEmpty() || name == label {
      continue
    }
    const found = editDistance(name, label, distance - 1)
    if found < distance {
      distance = found
      best = Some name
    }
  }
  best
}
