/**
 * Statements, blocks and the bodies of declarations: what a block is worth ([checkBlock]), whether it returns for
 * certain, and the scope every local lives in.
 *
 * A body is checked exactly once, whether the walk over the module reached it or somebody asked for the result type of
 * a function that does not declare one - which checks its body right there ([checkBodyOf]). That is what makes the
 * result of `fn parse() { ... }` inferable without checking anything twice.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Statement, Block, Binding, Condition, Expression, Pattern from "../../syntax/ast"
use FunctionDeclaration, Parameter, Declaration, Name from "../../syntax/ast"
use ModuleId from "../module"
use SymbolId from "../symbols"
use TypeId, TypeForm, ParameterForm, ParameterId from "./type"
use Checker, Expectation, LocalBinding, TypeScope, ResultRule from "./context"
use checkExpression, inferExpression, checkCondition from "./expression"
use expectationOf, isNested, settleTries from "./expression"
use declareParameterOwners from "./escape"
use isFullyKnown from "./name"
use checkPattern, requireReadBindings from "./pattern"
use requireIrrefutable from "./exhaustive"
use traitArgumentsOf from "./implementation"
use openInference, closeInference, resolveType, unify from "./unify"
use checkAssignment, noteAssignment, requireSharedSource, leavesClosure from "./place"
use settleLoop, settleChanges from "./mutation"
use signatureOf, functionOfSite, declareSites from "./signature"
use typeFromReference from "./lowering"
use isQuotation from "./quote"
use checkDeclaration from "./check"
use requireDeclaredResult, allowsTopLevelCode from "./declaration"

/** What a block is worth: the type of its value, and whether control never reaches its end. */
public type BlockResult {
  annotation: TypeId
  diverges: Bool
  /** Whether the last statement was an expression, which is the only case in which the block produces a value. */
  endsWithValue: Bool = false
}

/**
 * The value of a block is the value of its last statement when that is an expression, and `Void` otherwise. It
 * diverges when its last statement does, or when any statement in it does.
 */
public fn checkBlock(var checker: Checker, block: Block, expected: Expectation): BlockResult {
  checker.openScope()
  // A declaration is visible in the whole block it is written in, so all of them are known before any is checked
  declareSites checker, checker.module, block.statements
  hoistDeclarations checker, block.statements
  var annotation = checker.voidType
  var diverges = false
  var endsWithValue = false
  const last = block.statements.length() - 1
  for index in 0..block.statements.length() {
    const statement = block.statements[index]
    if index == last {
      if const .Evaluate(expression) = statement.kind {
        openInference checker
        annotation = checkExpression checker, expression, expected
        closeInference checker
        annotation = resolveType checker, annotation
        diverges = diverges || annotation == checker.neverType
        endsWithValue = true
        continue
      }
    }
    diverges = checkStatement(checker, statement) || diverges
  }
  checker.closeScope()
  // A block that ends in `return` or `panic` produces no value at all, and `Never` fits wherever one is wanted
  if diverges && annotation == checker.voidType {
    return BlockResult checker.neverType, true, endsWithValue
  }
  BlockResult annotation, diverges, endsWithValue
}

/** A `fn`, `type`, `trait` or alias of a block is a name of that block and of nothing else. */
fn hoistDeclarations(var checker: Checker, statements: List<Statement>) {
  for statement in statements {
    if const .Declare(declaration) = statement.kind {
      if const Some(name) = declaredName(declaration) {
        if const Some(symbol) = checker.resolvedName(checker.module, name.span) {
          checker.declareLocalSymbol name.text, symbol
        }
      }
    }
  }
}

fn declaredName(declaration: Declaration): Name? {
  match declaration.kind {
    .Function(function) => Some function.name
    .Type(typeDeclaration) => Some typeDeclaration.name
    .Alias(alias) => Some alias.name
    .Trait(traitDeclaration) => Some traitDeclaration.name
    _ => None
  }
}

/**
 * Answers whether control never reaches the statement after this one.
 *
 * One statement is one inference context: the unification variables a call in it makes are solved inside of it, and
 * closing it reports the ones that are left and writes the solutions into the tables of this statement.
 */
public fn checkStatement(var checker: Checker, statement: Statement): Bool {
  openInference checker
  const diverges = checkStatementIn checker, statement
  closeInference checker
  diverges
}

fn checkStatementIn(var checker: Checker, statement: Statement): Bool {
  match statement.kind {
    .Declare(declaration) => {
      const scope = scopeHere checker
      checkDeclaration checker, scope, declaration
      false
    }
    .Bind(binding) => {
      checkBinding checker, binding
      false
    }
    // The target has to be a valid place, and the change is noted before the value is read so that the read the target
    // itself produced is the one that becomes the change
    .Assign(target, value) => {
      const annotation = inferExpression checker, target
      const place = checkAssignment checker, target
      const inner = expectationOf checker, annotation
      const _ = checkExpression checker, value, inner
      requireSharedSource checker, value, annotation
      noteAssignment checker, place
      false
    }
    .For(pattern, iterable, body) => {
      checkLoop checker, pattern, iterable, body
      false
    }
    .While(condition, body) => {
      requireLoopKeyword checker, condition, statement.span
      // `while const Some(x) = next()` binds for the body of the loop and for nothing after it
      checker.openScope()
      // The condition runs again after every round, so its reads belong to the loop: `while isChanged` is what keeps
      // the `isChanged = false` at the top of the body alive
      const uses = checker.valueUses.length()
      checkCondition checker, condition, true
      // `while const Some(item) = next()`: what the pattern bound has to be read in the body
      const bound = checker.bindingsHere()
      checker.loopDepth = checker.loopDepth + 1
      const _ = checkBlock checker, body, Expectation.Statement
      checker.loopDepth = checker.loopDepth - 1
      requireReadBindings checker, bound
      // A change the next round reads again is alive, whatever stands after the loop
      settleLoop checker, uses
      checker.closeScope()
      false
    }
    // `loop { ... }` without a `break` never ends, so nothing after it is reached
    .Loop(body) => {
      checker.openScope()
      const uses = checker.valueUses.length()
      checker.loopDepth = checker.loopDepth + 1
      const _ = checkBlock checker, body, Expectation.Statement
      checker.loopDepth = checker.loopDepth - 1
      settleLoop checker, uses
      checker.closeScope()
      !hasBreak(body.statements)
    }
    .Return(value) => {
      checkReturn checker, value, statement.span
      true
    }
    .Break => {
      requireLoop checker, "break", statement.span
      true
    }
    .Continue => {
      requireLoop checker, "continue", statement.span
      true
    }
    .Evaluate(expression) => {
      const annotation = checkExpression checker, expression, Expectation.Statement
      annotation == checker.neverType
    }
  }
}

/** `const x: Int = 1`, `var (a, b) = pair`: the annotation decides, and without one the initializer does. */
fn checkBinding(var checker: Checker, binding: Binding) {
  const scope = scopeHere checker
  var annotation: TypeId? = None
  if const Some(reference) = binding.annotation {
    annotation = Some typeFromReference(checker, reference, scope.forType())
  }
  const found = match annotation {
    Some(wanted) => {
      const inner = expectationOf checker, wanted
      // `const condition: Expression<Bool> = age > 1` quotes its initializer exactly as a parameter does, and
      // the message about a capture that is not `Encode` names the binding as the reason
      if isQuotation(checker, wanted) {
        checker.quotingOwner = nameOfPattern binding.pattern
        checker.quotingParameter = ""
      }
      checkExpression checker, binding.value, inner
    }
    None => inferExpression checker, binding.value
  }
  var bound = annotation ?? found
  // A `var` binding may not be taken from a `const` path to a shared object: there is no copy that would make it a
  // different one, so it would hand out exactly what the `const` withheld
  if binding.isVar {
    requireSharedSource checker, binding.value, bound
  }
  // Nothing is known about a value the checker could not type, so neither is anything about the name it is bound to
  if checker.absorbs(bound) {
    bound = checker.deferredType
  }
  checkPattern checker, binding.pattern, bound, binding.isVar
  // `const Point(x, y) = p` has no second way to go, so the pattern has to match every value
  requireIrrefutable checker, binding.pattern, bound, "The pattern of a binding", "value"
}

/** The name a binding is known under, where its pattern is a plain name: what a message about it calls it. */
fn nameOfPattern(pattern: Pattern): String {
  if const .Binding(name) = pattern.kind {
    return name
  }
  ""
}

/**
 * `for x in xs` evaluates the subject once into a temporary and binds a copy of every item. The item type is the
 * `Item` of the `Iterable<Item>` the subject implements - through its own declaration, through an `extend`
 * (`extend Range<Int> with Iterable<Int>`) or through a supertrait, which is one and the same question.
 */
fn checkLoop(var checker: Checker, pattern: Pattern, iterable: Expression, body: Block) {
  const subject = inferExpression checker, iterable
  const element = iterationItemOf checker, subject, iterable.span
  checker.openScope()
  checkPattern checker, pattern, element, false
  requireIrrefutable checker, pattern, element, "The pattern of a `for`", "item"
  const uses = checker.valueUses.length()
  checker.loopDepth = checker.loopDepth + 1
  const _ = checkBlock checker, body, Expectation.Statement
  checker.loopDepth = checker.loopDepth - 1
  settleLoop checker, uses
  checker.closeScope()
}

fn iterationItemOf(var checker: Checker, subject: TypeId, at: Span): TypeId {
  if checker.absorbs(subject) {
    return checker.deferredType
  }
  const iterable = match checker.wellKnown.iterable {
    Some(found) => found
    None => {
      return checker.deferredType
    }
  }
  match traitArgumentsOf(checker, subject, iterable) {
    Some(arguments) => arguments.get(0) ?? checker.deferredType
    None => {
      reportNotIterable checker, subject, at
      checker.deferredType
    }
  }
}

/** A subject that is not `Iterable` cannot be looped over, and nothing else in the statement can be checked either. */
fn reportNotIterable(var checker: Checker, subject: TypeId, at: Span) {
  if !isFullyKnown(checker, subject) {
    return
  }
  const shown = checker.describe subject
  var problem = Diagnostic.error "`{shown}` is not `Iterable`, so `for` cannot walk it", at
  // A generic parameter iterates what its bounds say it iterates, and the fix stands at its declaration
  if const .Parameter(_) = checker.types.form(subject) {
    problem = problem.withNote "Add the bound to the declaration: `where {shown}: Iterable<Item>`"
  } else if isRangeTo(checker, subject) {
    // The one shape whose *reason* is the type: `..10` has no start, so there is no first value to count from
    problem = problem.withNote "`..10` has no start, so there is no first value to count from: write one (`0..10`)"
  } else {
    problem = problem.withNote(
      "`for x in xs` needs an `Iterable<Item>`: a collection, a range, a pipeline, or a type that implements it"
    )
  }
  checker.reportHere problem
}

/** Whether the type is `RangeTo<Value>`, the one range that is open at the start. */
fn isRangeTo(checker: Checker, annotation: TypeId): Bool {
  if const .Nominal(symbol, _) = checker.types.form(annotation) {
    return checker.wellKnown.rangeTo == Some(symbol)
  }
  false
}

/** `return e` is checked against the declared result; without one it *is* the result, so it is collected. */
fn checkReturn(var checker: Checker, value: Expression?, at: Span) {
  const expression = match value {
    Some(found) => found
    None => {
      // A bare `return` says the function produces nothing, so an inferred result hears `Void` from it:
      // `loop { ... return ... }` would otherwise infer `Never` from the loop that never ends
      if checker.isResultInferred {
        const nothing = checker.voidType
        checker.returnTypes.add nothing
        return
      }
      if checker.resultType != checker.voidType {
        if !checker.absorbs(checker.resultType) {
          const wanted = checker.describe checker.resultType
          checker.reportHere Diagnostic.error("This function has to return a `{wanted}`", at)
        }
      }
      return
    }
  }
  if checker.isResultInferred {
    const found = inferExpression checker, expression
    checker.returnTypes.add found
    // A `public` function and a trait method do not infer: `return e` has to say what `e` is
    requireDeclaredResult checker, found, expression.span
    return
  }
  const wanted = checker.resultType
  const inner = expectationOf checker, wanted
  const _ = checkExpression checker, expression, inner
}

/**
 * `while true` has one spelling in this language, and it is `loop`. An endless loop is then a property of the syntax
 * and not of a condition, which is what lets the checker and the back end see it without evaluating anything.
 */
fn requireLoopKeyword(var checker: Checker, condition: Condition, at: Span) {
  if const .Test(expression) = condition {
    if const .BoolLiteral(true) = expression.kind {
      checker.reportHere(
        Diagnostic.error("A loop that never ends is written `loop`", at)
          .withNote("`loop \{ ... \}` has the type `Never` without a `break` and `Void` with one")
      )
    }
  }
}

/** A `break` of *this* loop: a nested loop and a closure have their own, so neither is walked into. */
fn hasBreak(statements: List<Statement>): Bool {
  for statement in statements {
    match statement.kind {
      .Break => {
        return true
      }
      .Evaluate(expression) => {
        if hasBreakIn(expression) {
          return true
        }
      }
      _ => {}
    }
  }
  false
}

/** `break` is a statement, so only what holds blocks can hold one: an `if`, a `match` and a block. */
fn hasBreakIn(expression: Expression): Bool {
  match expression.kind {
    .Block(block) => hasBreak block.statements
    .If(_, then, otherwise) => {
      if hasBreak(then.statements) {
        return true
      }
      match otherwise {
        Some(alternative) => hasBreakIn alternative
        None => false
      }
    }
    .Match(_, arms) => {
      for arm in arms {
        if hasBreakIn(arm.body) {
          return true
        }
      }
      false
    }
    _ => false
  }
}

fn requireLoop(var checker: Checker, keyword: String, at: Span) {
  if checker.loopDepth > 0 {
    return
  }
  // A closure is a function, so a `break` in one cannot reach the loop around it
  if leavesClosure(checker) {
    checker.reportHere(
      Diagnostic.error("`{keyword}` cannot leave a closure", at)
        .withNote("A closure is a function, not a block: `do \{ \}` is not a loop either")
    )
    return
  }
  checker.reportHere(
    Diagnostic.error("`{keyword}` is only allowed inside of a `for`, a `while` or a `loop`", at)
      .withNote("A closure is a function, not a block: `{keyword}` cannot leave one, and `do \{ \}` is not a loop either")
  )
}

/**
 * An expression statement must have the type `Void` or `Never`, unless the call it consists of changes something
 * through a `var` receiver or a `var` argument - then the mutation is the effect and the result may go.
 */
public fn checkDiscarded(var checker: Checker, expression: Expression, found: TypeId) {
  if checker.absorbs(found) || found == checker.voidType {
    return
  }
  // A block, an `if` and a `match` handed the expectation down to their parts, which said everything there is to say
  if isNested(expression) {
    return
  }
  if hasEffect(checker, expression) {
    return
  }
  const name = calledName checker, expression
  var problem = if name.isEmpty() {
    Diagnostic.error "This value is not used", expression.span
  } else {
    Diagnostic.error "The result of `{name}` is not used", expression.span
  }
  if const Some(verb) = verbOf(name) {
    problem = problem.withNote "Did you mean `{verb}`? Discard it on purpose with `const _ = ...`"
  } else {
    problem = problem.withNote "Discard it on purpose with `const _ = ...`"
  }
  checker.reportHere problem
}

/** Whether the call changes something: a `var` receiver or a `var` parameter is what makes a result droppable. */
fn hasEffect(var checker: Checker, expression: Expression): Bool {
  // Anything that is not a call produces a value and nothing else
  if !isCall(expression) {
    return false
  }
  const resolution = match checker.resolutionHere(expression.span) {
    Some(found) => found
    None => {
      return true
    }
  }
  match resolution {
    .Callable(symbol, _, _) => {
      const identifier = signatureOf checker, symbol
      const signature = checker.signature identifier
      if signature.isVarSelf {
        return true
      }
      for parameter in signature.form.parameters {
        if const .Var = parameter.mode {
          return true
        }
      }
      false
    }
    // A closure in a field or a binding, and everything this pass has not resolved yet: not this rule's business
    .Deferred => true
    .Local(_) => true
    .Field(_, _) => true
    _ => false
  }
}

fn isCall(expression: Expression): Bool {
  match expression.kind {
    .Call(_, _, _) => true
    _ => false
  }
}

/** The name a message about a discarded result points at: `added` in `list.added(4)`. */
fn calledName(checker: Checker, expression: Expression): String {
  if const .Call(callee, _, _) = expression.kind {
    match callee.kind {
      .Name(text) => {
        return text
      }
      .Member(_, name, _) => {
        return name.text
      }
      _ => {}
    }
  }
  ""
}

/** `added` was probably meant as `add`: the participles of the language are the verb plus `ed` or `d`. */
fn verbOf(name: String): String? {
  if name.endsWith("ed") && name.byteLength() > 3 {
    return Some name[0..(name.byteLength() - 2)]
  }
  if name.endsWith("d") && name.byteLength() > 2 {
    return Some name[0..(name.byteLength() - 1)]
  }
  None
}

// --- Bodies ---------------------------------------------------------------------------------------------------------

/** The [TypeScope] a type reference at the current point of the body is resolved in: the module and `Self`, if any. */
public fn scopeHere(checker: Checker): TypeScope {
  TypeScope checker.module, selfType: checker.selfType
}

/**
 * The body of a declaration, checked once. Asking for the result type of a function that declares none checks its
 * body to find out, so the walk over the module has to be able to skip what is done already.
 */
public fn checkBodyOf(var checker: Checker, symbol: SymbolId) {
  if checker.checkedBodies.containsKey(symbol) {
    return
  }
  const identifier = signatureOf checker, symbol
  // Building the signature may have checked the body already: that is how an inferred result is found
  if checker.checkedBodies.containsKey(symbol) {
    return
  }
  const site = match checker.siteOf(symbol) {
    Some(found) => found
    None => {
      return
    }
  }
  const function = match functionOfSite(site) {
    Some(found) => found
    None => {
      return
    }
  }
  const signature = checker.signature identifier
  checker.checkedBodies.set symbol, true
  const _ = checkFunctionBody(
    checker,
    site.module,
    function,
    signature.owner,
    signature.generics,
    signature.form.parameters,
    signature.takesSelf,
    signature.isVarSelf,
    signature.form.result,
    false,
    declared: Some(symbol),
  )
}

/**
 * One function body. `isInferred` says that the declaration has no result type, so the body *is* the answer: then
 * nothing is checked against a result and what comes out is given back.
 */
public fn checkFunctionBody(
  var checker: Checker,
  module: ModuleId,
  function: FunctionDeclaration,
  owner: TypeId?,
  generics: List<ParameterId>,
  parameters: List<ParameterForm>,
  takesSelf: Bool,
  isVarSelf: Bool,
  result: TypeId,
  isInferred: Bool,
  rule: ResultRule = ResultRule.Ordinary,
  /** The function the body belongs to, which a closure handed to one of its parameters asks about (`escape.trb`). */
  declared: SymbolId? = None,
): TypeId {
  const body = match function.body {
    Some(found) => found
    None => {
      return checker.voidType
    }
  }
  // `fn fetch(): Task<User>`: its body produces the `User`, exactly as the body of a `Result` function produces the
  // value and `?` returns the error (concept, Concurrency). Whether `await()` may appear here is `checker.awaitsTasks`,
  // checked where `await()` itself is resolved
  const produced = taskValueOf(checker, result) ?? result
  const saved = checker.enterBody module, produced, isInferred, owner, rule
  // `await()` is allowed in a function that answers a `Task` and says so in its result type (CONCEPT, "Concurrency")
  checker.awaitsTasks = produced != result
  // A `?` returns from the body, and where the result is inferred it is only settled once the result is known
  checker.collectsTries = isInferred
  checker.openScope()
  declareGenerics checker, generics
  const firstParameter = checker.bindings.length()
  declareBindingsFor checker, function.parameters, parameters, takesSelf, isVarSelf, owner
  if const Some(symbol) = declared {
    declareParameterOwners checker, symbol, firstParameter, parameters
  }
  const inner = bodyExpectation checker, produced, isInferred
  const outcome = checkBlock checker, body, inner
  var found = outcome.annotation
  if isInferred {
    found = inferredResult checker, outcome
    settleTries checker, found, isClosure: false
    // A `public` function and a trait method do not infer: the value the body ends in has to be declared
    requireDeclaredEnding checker, body, outcome
  } else {
    requireResult checker, outcome, produced, body.span
  }
  // Every change of this body that no read follows is reported here: the uses are per body and gone with it
  settleChanges checker
  checker.closeScope()
  checker.leaveBody saved
  found
}

/**
 * The value a body ends in, where the declaration does not infer its result. The message points at that value and not
 * at the declaration, because that is where the type it has to declare is written.
 */
fn requireDeclaredEnding(var checker: Checker, body: Block, outcome: BlockResult) {
  if !outcome.endsWithValue {
    return
  }
  const last = match body.statements.last() {
    Some(found) => found
    None => {
      return
    }
  }
  if const .Evaluate(expression) = last.kind {
    const found = outcome.annotation
    requireDeclaredResult checker, found, expression.span
  }
}

/** The `Value` of a `Task<Value>`, which is what the body of such a function produces. */
public fn taskValueOf(checker: Checker, result: TypeId): TypeId? {
  const task = checker.wellKnown.task?
  if const .Nominal(symbol, arguments) = checker.types.form(result) {
    if symbol == task && arguments.length() == 1 {
      return Some arguments[0]
    }
  }
  None
}

/** The initializer of a `const`, and every default: a scope without `self` and without the other fields. */
public fn checkInitializer(
  var checker: Checker,
  module: ModuleId,
  value: Expression,
  owner: TypeId?,
  annotation: TypeId?,
  awaitsTasks: Bool = false,
): TypeId {
  const voidType = checker.voidType
  const saved = checker.enterBody module, voidType, true, owner
  // A top-level `const` of an entry file or a script is ordinary code, so `await()` is allowed in it; a field default
  // and a parameter default are evaluated wherever the value is built and are not
  checker.awaitsTasks = awaitsTasks
  checker.openScope()
  openInference checker
  var found = match annotation {
    Some(wanted) => {
      const inner = expectationOf checker, wanted
      checkExpression checker, value, inner
    }
    None => inferExpression checker, value
  }
  closeInference checker
  found = resolveType checker, found
  settleChanges checker
  checker.closeScope()
  checker.leaveBody saved
  annotation ?? found
}

/**
 * A top-level binding whose pattern destructures (`const (quotient, remainder) = divide(7, 2)`, `const Point(x, y) = p`
 * - CONCEPT's own examples). Every name it binds is a declaration of the file with a signature of its own, and all of
 * them share this one initializer, so it is checked exactly once: `checkDestructured` says whether that has happened.
 *
 * The pattern is checked in a scope that is thrown away again. What has to survive is `patternTypes` - that is where
 * each name reads its own type - while the names themselves must **not** become locals of the statement sequence: they
 * are declarations, and a function of the module reaches them through the file scope like any other.
 */
public fn checkDestructuredBinding(var checker: Checker, module: ModuleId, binding: Binding) {
  const key = (module.value, binding.pattern.span.start)
  if checker.checkedDestructured.containsKey(key) {
    return
  }
  checker.checkedDestructured.set key, true
  const voidType = checker.voidType
  const saved = checker.enterBody module, voidType, true, None
  checker.awaitsTasks = allowsTopLevelCode checker, module
  checker.openScope()
  openInference checker
  var annotation: TypeId? = None
  if const Some(reference) = binding.annotation {
    annotation = Some typeFromReference(checker, reference, TypeScope(module).forType())
  }
  const found = match annotation {
    Some(wanted) => {
      const inner = expectationOf checker, wanted
      checkExpression checker, binding.value, inner
    }
    None => inferExpression checker, binding.value
  }
  var subject = annotation ?? found
  if checker.absorbs(subject) {
    subject = checker.deferredType
  }
  checkPattern checker, binding.pattern, subject, binding.isVar
  requireIrrefutable checker, binding.pattern, subject, "The pattern of a binding", "value"
  closeInference checker
  settleChanges checker
  checker.closeScope()
  checker.leaveBody saved
}

/** The expectation a body's last expression is checked against: none where the result is inferred, `Void` where it is. */
public fn bodyExpectation(checker: Checker, result: TypeId, isInferred: Bool): Expectation {
  if isInferred {
    return Expectation.None
  }
  if result == checker.voidType {
    return Expectation.Statement
  }
  expectationOf checker, result
}

/**
 * Without a declared result the body is the result: the last expression, or the first `return` that has a value. Where
 * both are there they have to agree, and where one of them still holds a variable the other one solves it - which is
 * what makes `{ parser => ... return Some(parsePattern(parser)) ... None }` an `Option<Pattern>`.
 */
public fn inferredResult(var checker: Checker, outcome: BlockResult): TypeId {
  const found = outcome.annotation
  const returns = checker.returnTypes
  if found == checker.voidType || found == checker.neverType || checker.isBroken(found) {
    for candidate in returns {
      if candidate != checker.neverType && !checker.isBroken(candidate) {
        return candidate
      }
    }
    return found
  }
  for candidate in returns {
    if candidate != checker.neverType && !checker.isBroken(candidate) {
      const _ = unify checker, found, candidate
    }
  }
  resolveType checker, found
}

/**
 * A body that neither produces the declared result nor diverges: the message points at the end of the body. A body
 * that *does* end in an expression was already checked against the result, and one root cause gets one message.
 */
fn requireResult(var checker: Checker, outcome: BlockResult, result: TypeId, at: Span) {
  if outcome.diverges || checker.absorbs(result) || result == checker.voidType {
    return
  }
  if outcome.endsWithValue || outcome.annotation != checker.voidType {
    return
  }
  const wanted = checker.describe result
  checker.reportHere Diagnostic.error("This function has to return a `{wanted}`", Span(at.end - 1, at.end))
}

/** The generic parameters of a declaration are names of its body, as a namespace for the members of their bounds. */
fn declareGenerics(var checker: Checker, generics: List<ParameterId>) {
  for parameter in generics {
    const declaration = checker.types.parameter parameter
    if const Some(symbol) = declaration.symbol {
      checker.declareLocalSymbol declaration.name, symbol
    }
  }
}

/**
 * `self` and the parameters. A variadic parameter holds a `List<Item>` although its form carries the item type, which
 * is what checking one argument of it needs.
 */
fn declareBindingsFor(
  var checker: Checker,
  written: List<Parameter>,
  forms: List<ParameterForm>,
  takesSelf: Bool,
  isVarSelf: Bool,
  owner: TypeId?,
) {
  var index = 0
  for parameter in written {
    if parameter.name.text == "self" && parameter.annotation.isNone() {
      if takesSelf {
        const annotation = owner ?? checker.deferredType
        const binding = checker.declareBinding(
          LocalBinding(
            "self",
            annotation,
            isVarSelf,
            parameter.name.span,
            isReceiver: true,
            isParameter: true,
          )
        )
        checker.setReceiver binding
      }
      continue
    }
    const form = match forms.get(index) {
      Some(found) => found
      None => {
        continue
      }
    }
    index = index + 1
    const annotation = bindingTypeOf checker, form
    const isLazy = match form.mode {
      .Lazy => true
      _ => false
    }
    const _ = checker.declareBinding(
      LocalBinding(
        parameter.name.text,
        annotation,
        parameter.isVar,
        parameter.name.span,
        isParameter: true,
        isLazy: isLazy,
      )
    )
  }
}

/** What the parameter holds: a variadic one holds the list, everything else holds what its form says. */
fn bindingTypeOf(var checker: Checker, form: ParameterForm): TypeId {
  if const .Variadic = form.mode {
    match checker.wellKnown.list {
      Some(list) => {
        const bound = checker.nominal list, [form.annotation]
        return checker.types.intern TypeForm.Traits([bound])
      }
      None => {
        return checker.deferredType
      }
    }
  }
  form.annotation
}
