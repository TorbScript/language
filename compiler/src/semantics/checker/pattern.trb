/**
 * Patterns, as far as the names they bind. A name that starts with a lowercase letter binds; an uppercase one is a case
 * the scope knows (`None`) or a type read backwards (`Point(x, y)`), never a binding - a case of the matched type that
 * is not in scope is written `.Circle` or `Shape.Circle`. Every pattern is checked against the type of the value it
 * matches, so that the names it introduces have types.
 *
 * Whether the arms of a `match` cover every value, and whether one of them can never match, is `exhaustive.trb`: one
 * algorithm over a pattern matrix, which needs nothing from here but the types.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Pattern, FieldPattern, Name from "../../syntax/ast"
use SymbolId from "../symbols"
use BindingId from "./context"
use editDistance from "../resolve-types"
use TypeId, TypeForm, FieldSignature from "./type"
use Checker, Expectation, LocalBinding from "./context"
use caseNamed, caseNamesOf, fieldsOf, hasCases, typeNameOf from "./member"
use traitArgumentsOf from "./implementation"
use checkExpression from "./expression"
use requireVisibleFields from "./declaration"

/**
 * Checks a pattern against `subject`, the type of the value it matches, and declares the names it binds. `isVar`
 * makes every binding it declares a `var` path into the subject instead of a copy - the mode `if var` and a `var`
 * binding pass down through every nested pattern.
 */
public fn checkPattern(var checker: Checker, pattern: Pattern, subject: TypeId, isVar: Bool) {
  checker.typedPattern pattern.span, subject
  match pattern.kind {
    .Wildcard => {}
    // A lowercase name always binds, and shadowing in a nested scope is allowed
    .Binding(name) => declareName checker, name, subject, pattern.span, isVar
    .Literal(value) => {
      const inner = expectationFor checker, subject
      const _ = checkExpression checker, value, inner
    }
    .RangePattern(start, end, _) => {
      const inner = expectationFor checker, subject
      const _ = checkExpression checker, start, inner
      const other = expectationFor checker, subject
      const _ = checkExpression checker, end, other
    }
    .TuplePattern(items) => tuplePattern checker, items, subject, pattern.span, isVar
    // `[first, ...rest]`: the item type is the `Item` of the `Iterable<Item>` the subject is, and a rest pattern
    // collects a list of the same items
    .ListPattern(items, rest) => {
      const element = itemOfSubject checker, subject
      for item in items {
        checkPattern checker, item, element, isVar
      }
      if const Some(more) = rest {
        if const Some(name) = more.name {
          const collected = listOfItems checker, element
          declareName checker, name.text, collected, name.span, isVar
        }
      }
    }
    .Variant(path, fields) => {
      const name = path[path.length() - 1]
      // `None`: a bare uppercase name is resolved through the scope, so a misspelled case is not a catch-all
      if path.length() == 1 && fields.isEmpty() {
        if !isNameInScope(checker, name.text) {
          reportUnknownCase checker, name, subject
          return
        }
        // ...and the case the scope found has to belong to the type that is being matched
        if !isCaseOfSubject(checker, name, subject) {
          return
        }
      }
      variantPattern checker, name, fields, subject, pattern.span, isVar
    }
    .ImplicitVariant(name, fields) => variantPattern checker, name, fields, subject, pattern.span, isVar
    // `1 | 2 | 3`: every alternative matches the same value, so every one of them is checked against its type
    .Alternatives(patterns) => alternativePatterns checker, patterns, subject, isVar
    .Invalid => {}
  }
}

/**
 * `.Circle(radius) | .Ring(radius)`: every alternative matches the same value and every one of them has to bind the
 * same names with the same types, because the body sees one set of names whichever one matched. So each alternative
 * binds in a scope of its own, they are compared, and the names of the first one are declared once for the arm - which
 * is also what gives the arm exactly one `BindingId` per name, whatever path the value took to it.
 */
fn alternativePatterns(var checker: Checker, patterns: List<Pattern>, subject: TypeId, isVar: Bool) {
  var first: List<LocalBinding> = []
  for index in 0..patterns.length() {
    checker.openScope()
    const start = checker.bindings.length()
    checkPattern checker, patterns[index], subject, isVar
    const bound = boundSince checker, start
    checker.closeScope()
    if index == 0 {
      first = bound
      continue
    }
    compareAlternatives checker, first, bound, patterns[index].span
  }
  for binding in first {
    declareName checker, binding.name, binding.annotation, binding.at, binding.isVar
  }
}

/** The bindings one alternative declared, in the order it declared them. Ids are never reused, so an index suffices. */
fn boundSince(checker: Checker, start: Int): List<LocalBinding> {
  var found: List<LocalBinding> = []
  for index in start..checker.bindings.length() {
    found.add checker.bindings[index]
  }
  found
}

fn compareAlternatives(
  var checker: Checker,
  first: List<LocalBinding>,
  other: List<LocalBinding>,
  at: Span,
) {
  const note = "Every alternative of a pattern binds the same names, so the body sees one set whichever one matched"
  for binding in first {
    match findBinding(other, binding.name) {
      Some(found) => {
        if found.annotation == binding.annotation {
          continue
        }
        const expected = checker.describe binding.annotation
        const given = checker.describe found.annotation
        checker.reportHere(
          Diagnostic.error("`{binding.name}` is `{expected}` in the first alternative and `{given}` here", found.at)
            .withNote(note)
        )
      }
      None => {
        checker.reportHere(
          Diagnostic.error("`{binding.name}` is bound by the first alternative and not by this one", at)
            .withNote(note)
        )
      }
    }
  }
  for binding in other {
    if findBinding(first, binding.name).isSome() {
      continue
    }
    checker.reportHere(
      Diagnostic.error("`{binding.name}` is bound by this alternative and not by the first one", binding.at)
        .withNote(note)
    )
  }
}

fn findBinding(bindings: List<LocalBinding>, name: String): LocalBinding? {
  for binding in bindings {
    if binding.name == name {
      return Some binding
    }
  }
  None
}

/** A name a pattern binds, with the rule that the same scope may not declare a name twice. */
public fn declareName(var checker: Checker, name: String, annotation: TypeId, at: Span, isVar: Bool) {
  if name == "_" {
    return
  }
  if checker.isDeclaredHere(name) {
    checker.reportHere Diagnostic.error("`{name}` is already declared in this scope", at)
    return
  }
  // The parameters of a function and the top level of its body are one scope
  if checker.shadowsParameter(name) {
    checker.reportHere(
      Diagnostic.error("`{name}` is already a parameter of this function", at)
        .withNote("The parameters and the top level of the body are one scope, so nothing there can shadow a parameter")
    )
    return
  }
  const _ = checker.declareBinding LocalBinding(name, annotation, isVar, at)
}

/**
 * A binding of a **refutable** pattern that nobody reads is an error: an arm of a `match`, an `if const`/`if var`, a
 * `while const`. A lowercase name in a pattern always binds and never compares, so `limit =>` is a catch-all that
 * shadows the constant `limit` - and the only thing that tells a binding somebody meant from that mistake is whether it
 * is read. A name that starts with `_` is exempt: `_reason` keeps the name as documentation.
 *
 * The caller takes `checker.bindingsHere()` right after the pattern was checked and calls this after the guard and the
 * body, because a read anywhere in either counts. Irrefutable positions - `const x = ...`, destructuring, `for`,
 * closure and function parameters - are not part of the rule; `torb lint` takes those.
 */
public fn requireReadBindings(var checker: Checker, bound: List<BindingId>) {
  for binding in bound {
    if checker.isBindingRead(binding) {
      continue
    }
    const found = checker.binding binding
    if found.name.startsWith("_") {
      continue
    }
    checker.reportHere(
      Diagnostic.error("`{found.name}` is never read: write `_`, or `_{found.name}` to keep the name", found.at)
        .withNote(
          "A name in a pattern always binds and never compares, so a binding nobody reads hides what the pattern"
            + " matches"
        )
    )
  }
}

/** The `Item` of the `Iterable<Item>` a list pattern matches, which is also the type of every column it opens. */
public fn itemOfSubject(var checker: Checker, subject: TypeId): TypeId {
  if checker.absorbs(subject) {
    return checker.deferredType
  }
  const iterable = match checker.wellKnown.iterable {
    Some(found) => found
    None => {
      return checker.deferredType
    }
  }
  match traitArgumentsOf(checker, subject, iterable) {
    Some(arguments) => arguments.get(0) ?? checker.deferredType
    None => checker.deferredType
  }
}

fn listOfItems(var checker: Checker, element: TypeId): TypeId {
  const list = match checker.wellKnown.list {
    Some(found) => found
    None => {
      return checker.deferredType
    }
  }
  const bound = checker.nominal list, [element]
  checker.types.intern TypeForm.Traits([bound])
}

fn expectationFor(checker: Checker, subject: TypeId): Expectation {
  if checker.absorbs(subject) {
    return Expectation.None
  }
  Expectation.Type subject
}

fn tuplePattern(var checker: Checker, items: List<Pattern>, subject: TypeId, at: Span, isVar: Bool) {
  var fields: List<TypeId> = []
  if const .Tuple(found) = checker.types.form(subject) {
    for field in found {
      fields.add field.annotation
    }
  }
  if !fields.isEmpty() && fields.length() != items.length() {
    const shown = checker.describe subject
    checker.reportHere(
      Diagnostic.error("This pattern has {items.length()} positions, `{shown}` has {fields.length()}", at)
    )
  }
  for index in 0..items.length() {
    const inner = fields.get(index) ?? checker.deferredType
    checkPattern checker, items[index], inner, isVar
  }
}

/**
 * Whether a bare uppercase pattern name stands for something: an imported case, or a type that is read backwards.
 * A local binding can never be one, because a binding starts with a lowercase letter.
 */
fn isNameInScope(var checker: Checker, text: String): Bool {
  if text == "Self" {
    return checker.selfType.isSome()
  }
  if const Some(found) = checker.findLocal(text) {
    if const .Declared(symbol) = found {
      return namesACase checker, symbol
    }
    return false
  }
  match checker.program.lookUp(checker.module, text) {
    Some(symbol) => namesACase checker, symbol
    None => false
  }
}

/**
 * `Fail =>` against a `DecisionNode` that happens to have a case of that name too: the scope says `Result.Fail`, the
 * matched type says `DecisionNode.Fail`, and matching by name would make the checker agree with an arm that no value
 * can ever reach - stage 0 and both back ends resolve the name, not the name plus the subject. So a bare name has to
 * name a case **of the matched type**, and everything else is written `.Fail`.
 */
fn isCaseOfSubject(var checker: Checker, name: Name, subject: TypeId): Bool {
  if checker.absorbs(subject) {
    return true
  }
  const found = match symbolInScope(checker, name.text) {
    Some(symbol) => symbol
    None => {
      return true
    }
  }
  // Only a case can belong to the wrong type: a type read backwards (`Point(x, y)`) is checked by `variantPattern`
  const owner = match checker.symbolAt(found).kind {
    .Case(declaring) => declaring
    _ => {
      return true
    }
  }
  if const .Nominal(head, _) = checker.types.form(subject) {
    if head == owner {
      return true
    }
  }
  // The matched type has no case of that name at all: "`X` has no case `Fail`" is the clearer message, and
  // `variantPattern` reports it - but only where the matched type has cases at all, because a type without any (an
  // `Int64`, a record) gets no message there and `const None = 1` would then say nothing whatsoever
  const declared = declaredCaseName checker, name.text
  if caseNamed(checker, subject, declared).isNone() && hasCases(checker, subject) {
    return true
  }
  const ownerName = checker.symbolAt(owner).name
  const shown = checker.describe subject
  var problem = Diagnostic.error(
    "`{name.text}` is the case `{ownerName}.{name.text}`, and the value matched is a `{shown}`",
    name.span,
  )
  if hasCases(checker, subject) {
    problem = problem.withNote "Write `.{name.text}` for the case of `{shown}`"
  }
  checker.reportHere problem
  false
}

/**
 * The name the case a bare uppercase pattern name stands for is **declared** under. `use Option.Some as Present` binds
 * the local name `Present`, and CONCEPT says `as` works for a case too - so a pattern has to look the case up by the
 * name it was declared with and not by the one it was written as. Everything that is not an imported case is its own
 * name.
 */
public fn declaredCaseName(var checker: Checker, text: String): String {
  const found = match symbolInScope(checker, text) {
    Some(symbol) => symbol
    None => {
      return text
    }
  }
  if const .Case(_) = checker.symbolAt(found).kind {
    return checker.symbolAt(found).name
  }
  text
}

/** The declaration a bare uppercase pattern name stands for: a local import first, then the module's scope. */
fn symbolInScope(var checker: Checker, text: String): SymbolId? {
  if const Some(local) = checker.findLocal(text) {
    if const .Declared(symbol) = local {
      return Some symbol
    }
    return None
  }
  checker.program.lookUp checker.module, text
}

/** A case, or a type whose one constructor a pattern reads backwards. A function or a constant is neither. */
fn namesACase(var checker: Checker, symbol: SymbolId): Bool {
  match checker.symbolAt(symbol).kind {
    .Case(_) | .Type | .Alias | .Trait | .GenericParameter | .Builtin => true
    _ => false
  }
}

/**
 * `Nome =>`: the whole point of deciding by the first letter is that this is an error and not a catch-all. The note
 * says the rule, and a case of the matched type is offered where one is close enough.
 */
fn reportUnknownCase(var checker: Checker, name: Name, subject: TypeId) {
  var problem = Diagnostic.error("`{name.text}` is not a case in scope", name.span)
    .withNote("A name that starts with an uppercase letter is a case, never a binding: a binding starts lowercase")
  if const Some(similar) = nearestCase(checker, subject, name.text) {
    problem = problem.withNote "Did you mean `.{similar}`?"
  }
  checker.reportHere problem
}

/** A case of the matched type that is at most two edits away from what was written. */
fn nearestCase(var checker: Checker, subject: TypeId, text: String): String? {
  var best: String? = None
  var distance = 3
  for name in caseNamesOf(checker, subject) {
    if name == text || name.isEmpty() {
      continue
    }
    const found = editDistance(name, text, distance - 1)
    if found < distance {
      distance = found
      best = Some name
    }
  }
  best
}

/**
 * `Some(value)`, `.Circle(radius)`, `Point(x, y)`: a case of the type that is being matched, or the fields of that
 * type itself. A case always belongs to the declaration of its type - an `extend` can add none - so a name that is
 * none of them is a mistake.
 */
fn variantPattern(
  var checker: Checker,
  name: Name,
  fields: List<FieldPattern>,
  subject: TypeId,
  at: Span,
  isVar: Bool,
) {
  // `use Option.Some as Present`: the case is looked up by the name it was declared with, and the messages keep the one
  // that was written
  const declared = declaredCaseName checker, name.text
  if const Some(variant) = caseNamed(checker, subject, declared) {
    // A private field cannot be read from outside the type, in a pattern as anywhere else
    requireVisibleFields checker, subject, name.text, variant.fields, at
    checkFieldPatterns checker, name.text, fields, variant.fields, at, isVar
    return
  }
  // `Point(x, y)` and `Self(value)`: the one constructor of the type, read backwards
  if name.text == "Self" || typeNameOf(checker, subject) == Some(name.text) {
    const declared = fieldsOf checker, subject
    requireVisibleFields checker, subject, name.text, declared, at
    checkFieldPatterns checker, name.text, fields, declared, at, isVar
    return
  }
  if hasCases(checker, subject) {
    const shown = checker.describe subject
    checker.reportHere Diagnostic.error("`{shown}` has no case `{name.text}`", name.span)
  }
  for field in fields {
    const inner = checker.deferredType
    checkPattern checker, field.pattern, inner, isVar
  }
}

/**
 * The fields of a case are matched by position; a label that is written has to name the field at that position,
 * because a label that is not checked is worse than none.
 */
fn checkFieldPatterns(
  var checker: Checker,
  name: String,
  written: List<FieldPattern>,
  declared: List<FieldSignature>,
  at: Span,
  isVar: Bool,
) {
  if written.length() != declared.length() {
    const has = if declared.length() == 1 { "1 field" } else { "{declared.length()} fields" }
    const given = if written.length() == 1 { "1 pattern" } else { "{written.length()} patterns" }
    checker.reportHere Diagnostic.error("`{name}` has {has}, {given} were given", at)
  }
  for index in 0..written.length() {
    const field = written[index]
    if index >= declared.length() {
      const inner = checker.deferredType
      checkPattern checker, field.pattern, inner, isVar
      continue
    }
    if const Some(label) = field.label {
      if label.text != declared[index].name {
        checker.reportHere(
          Diagnostic.error("This position is `{declared[index].name}`, not `{label.text}`", label.span)
            .withNote("The fields of a case are matched by position; a label has to name the field at that position")
        )
      }
    }
    checkPattern checker, field.pattern, declared[index].annotation, isVar
  }
}
