/**
 * What a name in an *expression* means. This cannot happen before type checking: what `port` means in
 * `server { port 8080 }` depends on the type of the parameter that closure is passed to, so resolving a name and
 * checking a type are one pass.
 *
 * The order the checker searches in: the local scope chain, then the implicit parameters of the closure that is being
 * checked, then the innermost receiver and only that one, then the file scope, then the prelude.
 */

use Span from "../../syntax/source"
use staticKeyword from "../../syntax/token"
use Diagnostic from "../../syntax/diagnostic"
use SymbolId from "../symbols"
use editDistance from "../resolve-types"
use TypeId, TypeForm, FunctionForm, ParameterId, Bound from "./type"
use Checker, Resolution, Dispatch, Adaptation, LocalKind, Candidate, BindingId, Capture from "./context"
use DefaultSource from "./context"
use lookupMember, lookupStaticMember, resolutionOfCandidate from "./member"
use constructorOf, memberNames, caseNamed, caseNamesOf, fieldsOf, typeNameOf, argumentMapping from "./member"
use typeSignatureOf from "./signature"
use isConcrete, hiddenExtensionOf, hiddenTraitMemberOf, importPathOf from "./implementation"
use signatureOf, aliasTargetOf, genericsOf, resultOf from "./signature"
use substitute, substituteBounds from "./unify"
use implicitParameterTarget, isImplicitName, namesImplicitParameter from "./closure"
use noteRead, noteDeclaredRead, noteCapturedBinding from "./mutation"

/** What a name, a member path or any other callee resolved to. */
public type Target {
  resolution: Resolution
  /** The target read as a value. `Deferred` where this pass has not resolved it yet. */
  annotation: TypeId
  /** When the target can be called: its form, with everything that is known already substituted. */
  form: FunctionForm? = None
  /** For a message: "`connect` takes 2 arguments". */
  name: String = ""
  /** A call through it changes its receiver, which `place.trb` checks the place of. */
  isVarSelf: Bool = false
  /** The name denotes a type, so a call of it is a construction: `Point(10, 20)`, `Self(text)`. */
  constructs: TypeId? = None
  /** The generic parameters the call site has to solve, in declaration order. */
  generics: List<ParameterId> = []
  /** Their bounds, with everything the owner already fixed filled in. */
  bounds: List<Bound> = []
  /** Explicit type arguments (`to<Set<Int>>()`), taken from the left. */
  arguments: List<TypeId> = []
  /** `Int.from`: several implementations provide the member, so the argument decides which one is meant. */
  overloads: List<Candidate> = []
  /** A parameter of the member is `Self`, which has no meaning on a trait-typed value. */
  takesSelfArgument: Bool = false
  takesSelf: Bool = false
}

/** A target nothing is known about yet. Every operation on it yields `Deferred` again and says nothing. */
public fn deferredTarget(checker: Checker): Target {
  Target Resolution.Deferred, checker.deferredType
}

/**
 * A bare name in an expression. `expected` decides where the language lets it: a case of a generic type takes the
 * arguments of the expected type (`Some(keyword)` in a function that returns a `Keyword?`), and the notes of a message
 * about an unknown name read better with it.
 */
public fn resolveName(
  var checker: Checker,
  text: String,
  at: Span,
  expected: TypeId?,
  explicit: List<TypeId> = [],
): Target {
  if text == "self" {
    match checker.receiverBinding {
      Some(receiver) => {
        // A closure that names the receiver captures it, which is what decides whether that closure may escape
        noteCapture checker, receiver
        const annotation = checker.binding(receiver).annotation
        return Target Resolution.Local(receiver), annotation, name: "self"
      }
      // A field default, a parameter default and a `static fn` have no receiver
      None => {
        checker.reportHere(
          Diagnostic.error("There is no `self` here", at)
            .withNote(
              "`self` exists in a method and in a receiver closure. A default is evaluated without one, so that the"
                + " order of the fields is not observable"
            )
        )
        return Target Resolution.Deferred, checker.invalidType, name: text
      }
    }
  }
  if text == "Self" {
    match checker.selfType {
      Some(own) => {
        return typeTarget checker, own, "Self"
      }
      None => {
        return deferredTarget checker
      }
    }
  }
  if const Some(found) = checker.findLocal(text) {
    // The local wins, and that is exactly the silent shadowing CONCEPT forbids: the closure around this name offers an
    // implicit parameter of the same name, and nothing in the source says which of the two is meant
    if namesImplicitParameter(checker, text) {
      checker.reportHere(
        Diagnostic.error("The implicit parameter `{text}` would shadow `{text}`", at)
          .withNote("There is no silent shadowing: name the parameter of the closure (`\{ item => ... \}`)")
      )
    }
    return localTarget checker, found, text, at, expected, explicit
  }
  // `numbers.map { value * 2 }`, `{ _ * 3 }`: the parameters the expected function type names
  if const Some(found) = implicitParameterTarget(checker, text, at) {
    return found
  }
  // The innermost receiver, and only that one: `server { s => s.database { ... } }` names the outer one
  if const Some(receiver) = checker.receiverType {
    if const Some(candidate) = lookupMember(checker, receiver, text, Some(at)) {
      return implicitTarget checker, candidate, text, at
    }
  }
  if const Some(symbol) = checker.program.lookUp(checker.module, text) {
    return symbolTarget checker, symbol, text, at, expected, explicit
  }
  reportUnknownName checker, text, at, expected
  Target Resolution.Deferred, checker.invalidType, name: text
}

fn localTarget(
  var checker: Checker,
  found: LocalKind,
  text: String,
  at: Span,
  expected: TypeId?,
  explicit: List<TypeId>,
): Target {
  match found {
    .Bound(binding) => {
      noteCapture checker, binding
      // Every read of a local `var` binding, in source order: what the dead-change rule counts
      noteRead checker, binding, at
      // ...and every read of any binding at all, which is what a binding of a refutable pattern has to have
      checker.noteBindingRead binding
      const local = checker.binding binding
      // `fn orElse(fallback: lazy Value)`: reading the parameter forces the cell the caller filled in
      if local.isLazy {
        checker.adapted at, Adaptation.Force
      }
      const annotation = local.annotation
      Target Resolution.Local(binding), annotation, form: formOf(checker, annotation), name: text
    }
    // A `fn`, `type` or `trait` of a block, and a generic parameter that is in scope
    .Declared(symbol) => symbolTarget checker, symbol, text, at, expected, explicit
  }
}

/**
 * A binding that was declared outside of the closure that is being checked is captured by it, and by every closure in
 * between. The back ends need the list: a captured `var` binding is a shared box, not a copy.
 */
public fn noteCapture(var checker: Checker, binding: BindingId) {
  if checker.closureFrames.isEmpty() {
    return
  }
  const isVar = checker.binding(binding).isVar
  var index = 0
  while index < checker.closureFrames.length() {
    const frame = checker.closureFrames[index]
    if binding.value >= frame.bindings {
      index = index + 1
      continue
    }
    var captures = frame.captures
    if !captures.any({ _.binding == binding }) {
      captures.append Capture(binding, isVar)
      checker.closureFrames.set index, frame.copy(captures: captures)
      // A captured `var` binding is a shared box, not a copy, so it is exempt from the dead-change rule
      noteCapturedBinding checker, binding
    }
    index = index + 1
  }
}

/**
 * A top-level binding that a closure reads. It is **not** a capture: a declaration is one place the whole file
 * shares, and nothing about it is copied into the closure - which is exactly why a closure that becomes a task may
 * not reach a `var` one, nor one that holds an object. The list is per closure and the rule that reads it is at
 * `spawn`.
 */
fn noteDeclarationCapture(var checker: Checker, symbol: SymbolId) {
  if checker.closureFrames.isEmpty() {
    return
  }
  var index = 0
  while index < checker.closureFrames.length() {
    const frame = checker.closureFrames[index]
    if !frame.declarations.contains(symbol) {
      var declarations = frame.declarations
      declarations.append symbol
      checker.closureFrames.set index, frame.copy(declarations: declarations)
    }
    index = index + 1
  }
}

/**
 * A member of `self` that was written without it. The lowering puts the receiver back, so it is recorded here - and a
 * closure that reads a member of a receiver from further out captures that receiver like any other binding.
 */
fn implicitTarget(var checker: Checker, candidate: Candidate, text: String, at: Span): Target {
  if const Some(receiver) = checker.receiverBinding {
    checker.adapted at, Adaptation.ImplicitSelf(receiver)
    noteCapture checker, receiver
  }
  targetOfCandidate checker, candidate, text
}

/** A member that was found on a type: the same answer in the shape the rest of the checker works with. */
public fn targetOfCandidate(var checker: Checker, candidate: Candidate, text: String): Target {
  const target = Target(
    resolutionOfCandidate(candidate),
    candidate.annotation,
    form: formOfCandidate(checker, candidate),
    name: text,
    isVarSelf: candidate.isVarSelf,
    generics: candidate.generics,
    bounds: candidate.bounds,
    overloads: candidate.overloads,
    takesSelfArgument: candidate.takesSelfArgument,
    takesSelf: candidate.takesSelf,
  )
  noteDefaultSource checker, target
  target
}

/** Whether any parameter of the form has a default, which is the one case a function value has to carry one for. */
fn hasDefaultParameter(form: FunctionForm): Bool {
  for parameter in form.parameters {
    if parameter.hasDefault {
      return true
    }
  }
  false
}

/**
 * Where a **function value** of this target's type would find its defaults. A default belongs to a declaration and not
 * to a type, so `const make = Config` and `names.map User` can only keep theirs while the declaration is known: this
 * is the note the lowering reads when such a value is called with a field left out.
 */
public fn noteDefaultSource(var checker: Checker, target: Target) {
  const form = match target.form {
    Some(found) => found
    None => {
      return
    }
  }
  if !hasDefaultParameter(form) {
    return
  }
  const source = match target.resolution {
    .Construct(owner) => DefaultSource.Constructed owner
    .CaseOf(_, variant) => DefaultSource.Declared variant
    .Callable(symbol, _, _) => DefaultSource.Declared symbol
    _ => {
      return
    }
  }
  checker.noteDefaultSource target.annotation, source
}

/** A name of the file scope, of the prelude, or one the language provides. */
public fn symbolTarget(
  var checker: Checker,
  symbol: SymbolId,
  text: String,
  at: Span,
  expected: TypeId? = None,
  explicit: List<TypeId> = [],
): Target {
  // The values of a built-in type are lowercase literals, so `Void` in an expression teaches the spelling of its one
  // value - whether it is the name of the language or the `native type Void` of the prelude
  if checker.wellKnown.isVoid(symbol) {
    checker.reportHere(
      Diagnostic.error("`Void` is a type, not a value: its one value is written `void`", at)
        .withNote("`void` is to `Void` what `true` and `false` are to `Bool`")
    )
    return Target Resolution.Deferred, checker.invalidType, name: text
  }
  match checker.symbolAt(symbol).kind {
    .Function => callableTarget checker, symbol, text, explicit
    .Constant => {
      const annotation = resultOf checker, symbol
      // A top-level `var` is a declaration and not a local, so its reads are counted here
      noteDeclaredRead checker, symbol, at
      noteDeclarationCapture checker, symbol
      Target Resolution.Constant(symbol, None), annotation, form: formOf(checker, annotation), name: text
    }
    .Type => namedTypeTarget checker, symbol, text, at, expected, explicit
    .Alias => {
      const generics = genericsOf checker, symbol
      const target = aliasTargetOf checker, symbol
      if generics.isEmpty() {
        return typeTarget checker, target, text
      }
      // `type Handles = Map<Int, Handle>` used as a callee: the arguments the alias takes have to be solved first
      const arguments = argumentsFor checker, generics, explicit, None, text, at
      const applied = substituteInto checker, target, generics, arguments
      typeTarget checker, applied, text
    }
    // A trait is a namespace for its own members and for the ones an implementation of it provides
    .Trait => traitNamespaceTarget checker, symbol, text, at, expected, explicit
    .Case(owner) => caseTarget checker, symbol, owner, text, at, expected, explicit
    .Namespace(target) => Target Resolution.Namespace(target), checker.voidType, name: text
    // `Target.from(self)`, `Item.from(0)`: a generic parameter is a namespace for the members of its bounds
    .GenericParameter => parameterNamespaceTarget checker, symbol, text
    .Field(_) => deferredTarget checker
    // `Never` has no value at all, and `Void` was answered above
    .Builtin => deferredTarget checker
  }
}

fn callableTarget(var checker: Checker, symbol: SymbolId, text: String, explicit: List<TypeId>): Target {
  const identifier = signatureOf checker, symbol
  const signature = checker.signature identifier
  Target(
    Resolution.Callable(symbol, [], Dispatch.Direct),
    checker.functionType(signature.form),
    form: Some(signature.form),
    name: text,
    generics: signature.generics,
    bounds: signature.bounds,
    arguments: explicit,
  )
}

/** A case that was imported by its path: `use Option.Some, Option.None`, then `Some(value)`. */
fn caseTarget(
  var checker: Checker,
  variant: SymbolId,
  owner: SymbolId,
  text: String,
  at: Span,
  expected: TypeId?,
  explicit: List<TypeId>,
): Target {
  const generics = genericsOf checker, owner
  const wanted = headOf checker, owner, expected
  const arguments = argumentsFor checker, generics, explicit, wanted, text, at
  const own = checker.nominal owner, arguments
  // `use Option.None as Nothing`: the local name is the alias and the case is declared under its own, so the member is
  // looked up by the declared one. CONCEPT says `as` works for a case too
  match lookupStaticMember(checker, own, checker.symbolAt(variant).name) {
    Some(candidate) => targetOfCandidate checker, candidate, text
    None => deferredTarget checker
  }
}

/** A `type` by name: `Point(10, 20)`, `Holder(value)`, `Map<String, Int>()`. */
fn namedTypeTarget(
  var checker: Checker,
  symbol: SymbolId,
  text: String,
  at: Span,
  expected: TypeId?,
  explicit: List<TypeId>,
): Target {
  const generics = genericsOf checker, symbol
  const wanted = headOf checker, symbol, expected
  const arguments = argumentsFor checker, generics, explicit, wanted, text, at
  const own = checker.nominal symbol, arguments
  typeTarget checker, own, text
}

/** `List.of(1, 2)`, `Map.from(pairs)`: the trait is the namespace, and its own arguments are inferred like any others. */
fn traitNamespaceTarget(
  var checker: Checker,
  symbol: SymbolId,
  text: String,
  at: Span,
  expected: TypeId?,
  explicit: List<TypeId>,
): Target {
  const generics = genericsOf checker, symbol
  const wanted = headOf checker, symbol, expected
  const arguments = argumentsFor checker, generics, explicit, wanted, text, at
  const bound = checker.nominal symbol, arguments
  const own = checker.types.intern TypeForm.Traits([bound])
  Target Resolution.TypeOf(own), own, name: text, constructs: Some(own)
}

/** `Target.from(self)` inside a generic function: the members of the bounds, reached through the caller's witness. */
fn parameterNamespaceTarget(var checker: Checker, symbol: SymbolId, text: String): Target {
  const identifier = match checker.types.parameterOf(symbol) {
    Some(found) => found
    None => {
      return deferredTarget checker
    }
  }
  const own = checker.types.intern TypeForm.Parameter(identifier)
  Target Resolution.TypeOf(own), own, name: text, constructs: Some(own)
}

/**
 * The arguments of a generic declaration at a use in an expression: the explicit ones from the left, then the ones the
 * expected type gives (`Some(keyword)` where a `Keyword?` is wanted), then a fresh variable each.
 */
public fn argumentsFor(
  var checker: Checker,
  generics: List<ParameterId>,
  explicit: List<TypeId>,
  wanted: List<TypeId>?,
  owner: String,
  at: Span,
): List<TypeId> {
  var arguments: List<TypeId> = []
  const known = wanted ?? []
  for index in 0..generics.length() {
    if index < explicit.length() {
      arguments.append explicit[index]
      continue
    }
    if index < known.length() {
      arguments.append known[index]
      continue
    }
    const declared = checker.types.parameter generics[index]
    arguments.append checker.newVariable(declared.name, owner, at, isConst: declared.isConst)
  }
  arguments
}

/** The arguments of the expected type, but only when it is a value of this very declaration. */
fn headOf(checker: Checker, symbol: SymbolId, expected: TypeId?): List<TypeId>? {
  const annotation = expected?
  match checker.types.form(annotation) {
    .Nominal(head, arguments) => {
      if head == symbol {
        return Some arguments
      }
      None
    }
    .Traits(bounds) => {
      for bound in bounds {
        if const .Nominal(head, arguments) = checker.types.form(bound) {
          if head == symbol {
            return Some arguments
          }
        }
      }
      None
    }
    _ => None
  }
}

fn substituteInto(var checker: Checker, target: TypeId, generics: List<ParameterId>, arguments: List<TypeId>): TypeId {
  var mapping: Map<ParameterId, TypeId> = [:]
  for index in 0..generics.length().min(arguments.length()) {
    mapping.set generics[index], arguments[index]
  }
  substitute checker.types, target, mapping
}

/** The type a name stands for, as the target of a constructor call or of a static member. */
public fn typeTarget(var checker: Checker, own: TypeId, text: String): Target {
  const built = match constructorOf(checker, own) {
    Some(found) => Target(
      Resolution.Construct(own),
      checker.functionType(found),
      form: Some(found),
      name: text,
      constructs: Some(own),
      bounds: appliedBoundsOf(checker, own),
    )
    // A type with cases is constructed through them, so the name itself is only a namespace
    None => Target Resolution.TypeOf(own), own, name: text, constructs: Some(own)
  }
  noteDefaultSource checker, built
  built
}

/**
 * The bounds of a type's own generic parameters, with the arguments of this use put in: `type Heavy<Item: Weigh>`
 * called as `Heavy(Feather())` asks for `Weigh` of whatever `Item` turns out to be.
 *
 * A constructor call is the one place where a type argument is *inferred* rather than written, so the walk over the
 * type positions of a module ([checkAppliedBounds]) never sees it. The bounds travel with the target instead, and
 * `checkBounds` holds them against the arguments once the call has solved them.
 */
fn appliedBoundsOf(var checker: Checker, own: TypeId): List<Bound> {
  const (symbol, arguments) = match checker.types.form(own) {
    .Nominal(found, given) => (found, given)
    _ => {
      return []
    }
  }
  if arguments.isEmpty() {
    return []
  }
  const identifier = typeSignatureOf checker, symbol
  const shape = checker.typeSignature identifier
  if shape.bounds.isEmpty() {
    return []
  }
  const mapping = argumentMapping shape.generics, arguments
  substituteBounds checker.types, shape.bounds, mapping
}

/** A function type is what makes a value callable: a binding or a field that holds a closure. */
public fn formOf(checker: Checker, annotation: TypeId): FunctionForm? {
  if const .Function(form) = checker.types.form(annotation) {
    return Some form
  }
  None
}

/**
 * What a member is when it is *called*. A field or a `const` that holds a function is callable with `()` - that is what
 * `state = step(state, value)` and `button.onClick()` are - and only with `()`, because a command on it writes it
 * instead. A receiver closure in a field (`const perimeter: (self: Rectangle) => Int`) applies its receiver.
 */
fn formOfCandidate(checker: Checker, candidate: Candidate): FunctionForm? {
  if const Some(found) = candidate.form {
    return Some found
  }
  const form = formOf(checker, candidate.annotation)?
  for parameter in form.parameters {
    if const .Receiver(_) = parameter.mode {
      return None
    }
  }
  Some form
}

// --- Messages -------------------------------------------------------------------------------------------------------

/**
 * A name that is nowhere. Inside a body with a receiver whose members the checker cannot all see nothing is said: the
 * name may well be a trait member the bounds of a generic parameter decide about.
 */
/** Whether the name is a field of the type a default is being checked inside of, cases included. */
fn namesAFieldOf(var checker: Checker, own: TypeId, text: String): Bool {
  const fields = fieldsOf checker, own
  for field in fields {
    if field.name == text {
      return true
    }
  }
  const variants = caseNamesOf checker, own
  for variant in variants {
    const found = caseNamed checker, own, variant
    if const Some(one) = found {
      for field in one.fields {
        if field.name == text {
          return true
        }
      }
    }
  }
  false
}

fn reportUnknownName(var checker: Checker, text: String, at: Span, expected: TypeId?) {
  // `{ _ * 2 }` where nothing says what the closure takes: the parameters are what is missing, not the name
  if isImplicitName(text) && !checker.closureFrames.isEmpty() {
    checker.reportHere(
      Diagnostic.error("The parameters of this closure need types: `\{ value: Int => ... \}`", at)
        .withNote("`_` is the first parameter of the expected function type, and nothing here expects one")
    )
    return
  }
  // A field default is evaluated without `self` and without the other fields, so the order the fields are declared in
  // is not observable from one. A name that is a field of the same type is that mistake and not a missing declaration
  if checker.isFieldDefault {
    if const Some(own) = checker.selfType {
      if namesAFieldOf(checker, own, text) {
        checker.reportHere(
          Diagnostic.error("A field default cannot read the field `{text}`", at)
            .withNote(
              "Every default is evaluated on its own, so the order of the fields is not observable. A value that is"
                + " computed from another field is made by a `{staticKeyword} fn` factory"
            )
        )
        return
      }
    }
  }
  if const Some(receiver) = checker.receiverType {
    if !isFullyKnown(checker, receiver) {
      return
    }
  }
  if const Some(own) = checker.selfType {
    if !isFullyKnown(checker, own) {
      return
    }
  }
  if const Some(annotation) = expected {
    if caseNamed(checker, annotation, text).isSome() {
      const owner = checker.describe annotation
      checker.reportHere(
        Diagnostic.error(
          "`{text}` alone is a type, a function or a variable. A case is written `.{text}` or `{owner}.{text}`",
          at,
        )
      )
      return
    }
  }
  var problem = Diagnostic.error "Cannot find `{text}` here", at
  if checker.receiverType.isSome() {
    problem = problem.withNote(
      "Only the innermost receiver is implicit: name the parameter to reach an outer one (`report \{ r => r.{text} \}`)"
    )
  }
  checker.reportHere problem
}

/**
 * `a.b` where `b` is not there. Answers whether it said anything: a type that still holds an unsolved variable says
 * nothing about what it has, so nothing is said about it either.
 */
public fn reportUnknownMember(
  var checker: Checker,
  receiver: TypeId,
  text: String,
  at: Span,
  isTypeName: Bool = false,
): Bool {
  // A **static** access is written on a type name, and the variables in `Array<?1, ?2>` are the checker's own: nothing
  // at this call site was ever going to solve them, so "has no member" is the answer and not "cannot infer `Item`"
  if isTypeName {
    if checker.absorbs(receiver) {
      return false
    }
  } else if !isFullyKnown(checker, receiver) {
    return false
  }
  if isTypeName {
    // One root cause, one message: the variables of `Array<?1, ?2>` would each say "Cannot infer" at the end of the
    // statement, about a call that has no meaning anyway
    silenceVariables checker, receiver, 0
  }
  const shown = if isTypeName { writtenNameOf(checker, receiver) ?? checker.describe(receiver) } else {
    checker.describe receiver
  }
  var problem = Diagnostic.error "`{shown}` has no member `{text}`", at
  // A generic parameter has exactly what the traits in its bounds declare, and the bounds stand at its declaration
  if const .Parameter(_) = checker.types.form(receiver) {
    problem = problem.withNote(
      "What a generic parameter has comes from its bounds: add the trait that declares `{text}`"
        + " (`<{shown}: Length>`)"
    )
  }
  // `print (0..4).length()` is `print(0..4)` and then `.length()` on what it produced: a parenthesis right after the
  // callee is a parenthesized call whatever stands before it, so the member access lands on the call's result
  if const .VoidType = checker.types.form(receiver) {
    problem = problem.withNote(
      "A call that produces nothing has the type `Void`. A `(` right after the name of a call is its argument list,"
        + " whatever whitespace stands in between, so `f (x).{text}()` reads as `f(x).{text}()`: write"
        + " `f((x).{text}())`, or bind the value first"
    )
  }
  // `level .Debug` lexes as `level.Debug`: whitespace never changes what a token sequence means, so `.` is one of the
  // tokens a first command argument must not start with
  if caseNamed(checker, receiver, text).isSome() {
    checker.reportHere(
      problem.withNote(
        "`{text}` is a case of `{shown}`. The first argument of a command may not start with `.`, so"
          + " `setting .{text}` is the member `setting.{text}`: write `setting(.{text})` or `setting = .{text}`"
      )
    )
    return true
  }
  // An `extend` of a foreign type is named where it is used, so the message is the `use` line to write
  if const Some(module) = hiddenExtensionOf(checker, receiver, text) {
    const path = importPathOf checker, module
    const owner = typeNameOf(checker, receiver) ?? shown
    checker.reportHere(
      Diagnostic.error("`{path}` adds `{text}` to `{shown}`, and this file does not name it", at)
        .withNote("Write `use {owner}.{text} from \"{path}\"` at the top of the file")
    )
    return true
  }
  // A trait another package puts on a type it does not own reaches the files where the trait itself is a name
  if const Some((capability, module)) = hiddenTraitMemberOf(checker, receiver, text) {
    const path = importPathOf checker, module
    checker.reportHere(
      Diagnostic.error("`{text}` comes from `{capability}`, which is not a name in this file", at)
        .withNote("Write `use {capability} from \"{path}\"`: the members a trait puts on a foreign type need the trait")
    )
    return true
  }
  // `(0..).length()`: the member is missing because of which ends the range has, so the message says that and not
  // the name of a member that looks similar
  if const Some(reason) = openRangeNote(checker, receiver, text) {
    checker.reportHere problem.withNote(reason)
    return true
  }
  if const Some(similar) = nearestMember(checker, receiver, text) {
    problem = problem.withNote "Did you mean `{similar}`?"
  }
  checker.reportHere problem
  true
}

/**
 * The name a **type name** was written under: `Array`, `List`. A trait used as a namespace is a `Traits` form of one
 * bound, and the bound's own name is what stands in the source - `List<_>` is the instantiation and not what anybody
 * wrote.
 */
fn writtenNameOf(checker: Checker, of: TypeId): String? {
  if const .Traits(bounds) = checker.types.form(of) {
    if bounds.length() == 1 {
      return typeNameOf checker, bounds[0]
    }
    return None
  }
  typeNameOf checker, of
}

/** Every unification variable inside a type, marked as reported: their message would be a consequence of this one. */
fn silenceVariables(var checker: Checker, of: TypeId, depth: Int) {
  if depth > 8 {
    return
  }
  match checker.types.form(of) {
    .Variable(variable) => checker.markReported variable
    .Nominal(_, arguments) => {
      for argument in arguments {
        silenceVariables(checker, argument, depth + 1)
      }
    }
    .Traits(bounds) => {
      for bound in bounds {
        silenceVariables(checker, bound, depth + 1)
      }
    }
    _ => {}
  }
}

/**
 * Why a range has no `length` and no `iterate`: which ends it has *is* its type, so an end the range does not have
 * is the whole answer. `(0..).length()` and `(..10).iterate()` are the two the language itself can name.
 */
fn openRangeNote(checker: Checker, receiver: TypeId, text: String): String? {
  const symbol = match checker.types.form(receiver) {
    .Nominal(found, _) => found
    _ => {
      return None
    }
  }
  const named = Some symbol
  if checker.wellKnown.rangeFrom == named && (text == "length" || text == "isEmpty") {
    return Some "`0..` has no end, so it has no length: write one (`0..10`)"
  }
  if checker.wellKnown.rangeTo == named {
    if text == "length" || text == "isEmpty" || text == "iterate" {
      return Some "`..10` has neither a start nor a length: write the start (`0..10`)"
    }
  }
  None
}

/**
 * Whether every member of a type is visible, which is what every message about a missing one asks first. A type that
 * still holds an unsolved variable says nothing, and neither does anything that is broken already.
 *
 * Three forms are fully known:
 *
 * - a **concrete nominal type**, a tuple, and a literal type (which carries `parse`, `show`, `equals`, `hash`,
 *   `encode`, `decode` and `into` without declaring any of them - all seven are generated),
 * - a **trait-typed value**: `Shape` has the members of its bounds, their defaults, their supertraits and every
 *   `extend Shape` visible here, and no call site adds to that list,
 * - a **generic parameter**: what it has is its bounds, and those stand at its declaration.
 *
 * A member of a type that is not fully known - an unbound `Value` inside a generic function, for instance - is
 * silently not checked here: `checkModule`'s closing walk over the module reports "The checker did not work out the
 * type of this expression" for whatever it leaves untyped, which is the message that names a bug of the compiler.
 */
public fn isFullyKnown(var checker: Checker, of: TypeId): Bool {
  if checker.absorbs(of) {
    return false
  }
  match checker.types.form(of) {
    .Parameter(_) => true
    // `Void` is the type with exactly one value, and its members are the ones the standard library declares on it: a
    // member it has not is an ordinary mistake, and saying nothing left `print(x).round()` with no type at all and the
    // reader with "this is a bug of the compiler"
    .VoidType => true
    .Nominal(_, _) | .Tuple(_) | .Literals(_, _) | .Traits(_) => isConcrete checker, of
    _ => false
  }
}

/** A member of the type that is at most two edits away from what was written. */
fn nearestMember(var checker: Checker, receiver: TypeId, text: String): String? {
  var best: String? = None
  var distance = 3
  for name in memberNames(checker, receiver) {
    if name == text || name.isEmpty() {
      continue
    }
    const found = editDistance(name, text, distance - 1)
    if found < distance {
      distance = found
      best = Some name
    }
  }
  best
}
