/**
 * [WellKnown]: the declarations the *language itself* refers to, looked up once per run - `Item?` is an `Option`, a
 * text literal type has `String` as its base, `for`/`?`/`??` go through the traits named here.
 *
 * Everything here is optional. A workspace without `std/prelude` (a script with another prelude, a test that brings
 * its own) has to keep working: what is missing simply yields `Invalid`, and the message about it was already
 * written where the name did not resolve.
 */

use joinPath from "../../project/path"
use SymbolId from "../symbols"
use Program from "../scope"

/**
 * The declarations the *language* refers to, looked up once per run: `Item?` is an `Option`, a text literal type has
 * `String` as its base, `Void` is both a name of the language and a `native type` of the prelude.
 *
 * Everything here is optional. A workspace without `std/prelude` (a script with another prelude, a test that brings
 * its own) has to keep working: what is missing simply yields `Invalid`, and the message about it was already written
 * where the name did not resolve.
 *
 * It is the **exports** of `src/lib.trb` of that package that are looked at, never its files. `std/prelude` declares
 * nothing itself - `Option` lives in `std/core`, `Int64` in `std/number` - and a project with another prelude that
 * re-exports the same names works the same way.
 */
public type WellKnown {
  /** Everything `std/prelude` exports, by name. Empty when the workspace has no such package. */
  names: Map<String, SymbolId> = [:]
  /** Every symbol that means `Void`: the name the language provides, and the `native type Void` of the prelude. */
  voidSymbols: List<SymbolId> = []
  neverSymbols: List<SymbolId> = []
  /**
   * The `native type Void` of the standard library. A signature says `Void` as `TypeForm.VoidType`, but the traits it
   * implements (`Equals`, `Hash`, `Show`) are declared on this one, so trait resolution asks about it instead.
   */
  declaredVoid: SymbolId? = None
  /** `Item?` is sugar for `Option<Item>`, so building a type needs this one. */
  option: SymbolId? = None
  /** `?`, `??` and `.ok()` have to tell an `Option` and a `Result` apart. */
  result: SymbolId? = None
  /** String interpolation is `Show.show` per part, and `?` converts the error through `From.from`. */
  show: SymbolId? = None
  from: SymbolId? = None
  into: SymbolId? = None
  /** `value.tryInto()` is the `TryFrom` of the target, and the target comes from the expected `Result`. */
  tryFrom: SymbolId? = None
  /** The operators that are not built in go through these: `==`, `<`, `-a`, `a ?? b`. */
  equals: SymbolId? = None
  compare: SymbolId? = None
  negate: SymbolId? = None
  /** `a ?? b` is `OrElse.orElse`, with the fallback as a `lazy` argument. */
  orElse: SymbolId? = None
  /** The base types of a literal type and of a const argument. */
  string: SymbolId? = None
  integer: SymbolId? = None
  character: SymbolId? = None
  boolean: SymbolId? = None
  /** The type of a decimal literal. */
  float: SymbolId? = None
  /**
   * The three ranges the syntax writes, one per pair of ends: `a..b` and `a..=b` are a `Range`, `a..` a `RangeFrom`,
   * `..b` and `..=b` a `RangeTo`. [WellKnown.bounds] is what every one of them is, and what `Slice.slice` takes.
   */
  range: SymbolId? = None
  rangeFrom: SymbolId? = None
  rangeTo: SymbolId? = None
  bounds: SymbolId? = None
  /** A function that returns a `Task<Value>` has a body that produces the `Value` (concept, Concurrency). */
  task: SymbolId? = None
  /**
   * `Task` and `Channel` are the two `shared type`s that may be held by more than one task, and therefore the two
   * exceptions to the confinement rule: every other object stays in the task that made it.
   */
  channel: SymbolId? = None
  /**
   * `spawn { ... }` starts a task, and the closure it is handed may capture no `var` binding: a task gets copies, and a
   * captured `var` is the one thing of the language that is shared (concept, Concurrency).
   */
  spawn: SymbolId? = None
  /**
   * `Expression<Value>` quotes what arrives at it instead of evaluating it, and everything a quotation captures has to
   * be `Encode` so that a provider can look at it. Both are asked about at every argument of every call, so they are
   * symbols here and not a lookup by name.
   */
  expression: SymbolId? = None
  encode: SymbolId? = None
  /** `for x in xs` and `...x` ask a type for this one, `a[key]` for `Index`, `a[from..to]` for `Slice`. */
  iterate: SymbolId? = None
  index: SymbolId? = None
  slice: SymbolId? = None
  /** A `var` path through `a[key]` needs `MutableIndex`, one through `a[from..to]` needs `MutableSlice`. */
  mutableIndex: SymbolId? = None
  mutableSlice: SymbolId? = None
  /** The traits the collection literals build, and the ones the operators go through. */
  list: SymbolId? = None
  map: SymbolId? = None
  /**
   * `Array<Item, const Size: Int>`. A list literal builds one inline where one is expected, and its items are counted
   * against `Size` - the one place the checker turns a number of written items into a type.
   */
  array: SymbolId? = None
  /**
   * Every numeric type of the prelude, by `SymbolId.value`, with the name it was declared under. A literal adapts to
   * one of these, and a literal that does not fit the width of the one it adapts to is an error.
   */
  numerics: Map<Int, String> = [:]
  /**
   * `describedKey` of `std/collections`, which `map[key]` names a missing key through: a call of it is lowered as
   * [WellKnown.describedShownKey] of the shown key where the key's type has `Show` (`ir/lower/text.trb`).
   */
  describedKey: SymbolId? = None
  describedShownKey: SymbolId? = None
  /**
   * The closed list of the literal rule (docs/design/URI.md section 9): the types a string literal is read into where
   * one of them is expected, by `SymbolId.value`, with the name they are declared under - `Path`, `Uri`, `Regex`, the
   * resource types. A package of `std` that is not in the workspace adds nothing.
   */
  checked: Map<Int, String> = [:]
  /** The same types by name, for the checker to build `UriTemplate<Value>` and `TemplateCase<Value>` with. */
  checkedSymbols: Map<String, SymbolId> = [:]

  fn symbolNamed(name: String): SymbolId? {
    names.get name
  }

  /** `Uri`, `Regex`, `EmbeddedText`: the name of a type of the literal rule, if this is one. */
  fn checkedNamed(symbol: SymbolId): String? {
    checked.get symbol.value
  }

  /** `Int8`, `UInt64`, `Float32`, `Decimal`: the name a numeric type of the prelude was declared under. */
  fn numericNamed(symbol: SymbolId): String? {
    numerics.get symbol.value
  }

  fn isVoid(symbol: SymbolId): Bool {
    voidSymbols.contains symbol
  }

  fn isNever(symbol: SymbolId): Bool {
    neverSymbols.contains symbol
  }

  /** The two shared types a value may be held by more than one task through: `Task` and `Channel`. */
  fn isTaskHandle(symbol: SymbolId): Bool {
    task == symbol || channel == symbol
  }
}

/**
 * The names the checker knows, from the `std/prelude` of this workspace - not from the prelude of a single package:
 * a project may name another prelude, but `Item?` still means the `Option` of the standard library.
 */
public fn wellKnownOf(program: Program): WellKnown {
  const exports = preludeExports program
  const collections = packageExports program, "std/collections"
  const checked = checkedTypesOf program
  var checkedNames: Map<Int, String> = [:]
  for (name, symbol) in checked {
    checkedNames.set symbol.value, name
  }
  WellKnown(
    exports,
    bothNames(program, exports, "Void"),
    bothNames(program, exports, "Never"),
    declaredVoid: exports.get("Void"),
    option: exports.get("Option"),
    result: exports.get("Result"),
    show: exports.get("Show"),
    from: exports.get("From"),
    into: exports.get("Into"),
    tryFrom: exports.get("TryFrom"),
    equals: exports.get("Equals"),
    compare: exports.get("Compare"),
    negate: exports.get("Negate"),
    orElse: exports.get("OrElse"),
    string: exports.get("String"),
    integer: exports.get("Int64"),
    character: exports.get("Char"),
    boolean: exports.get("Bool"),
    float: exports.get("Float64"),
    range: exports.get("Range"),
    rangeFrom: exports.get("RangeFrom"),
    rangeTo: exports.get("RangeTo"),
    bounds: exports.get("Bounds"),
    task: exports.get("Task"),
    channel: exports.get("Channel"),
    spawn: exports.get("spawn"),
    expression: exports.get("Expression"),
    encode: exports.get("Encode"),
    iterate: exports.get("Iterate"),
    index: exports.get("Index"),
    slice: exports.get("Slice"),
    mutableIndex: exports.get("MutableIndex"),
    mutableSlice: exports.get("MutableSlice"),
    list: exports.get("List"),
    map: exports.get("Map"),
    array: exports.get("Array"),
    numerics: numericNames(exports),
    describedKey: collections.get("describedKey"),
    describedShownKey: collections.get("describedShownKey"),
    checked: checkedNames,
    checkedSymbols: checked,
  )
}

/**
 * The types of the literal rule, from the exports of the packages of `std` that declare them. The list is closed and
 * written here on purpose (docs/design/URI.md section 9): a type joins it by a decision about the language, never by
 * implementing a trait.
 */
fn checkedTypesOf(program: Program): Map<String, SymbolId> {
  const declared = [
    ("std/path", ["Path"]),
    ("std/uri", ["Uri", "UriReference", "UriTemplate", "TemplateCase"]),
    ("std/regex", ["Regex"]),
    ("std/resource", ["Resource", "EmbeddedBytes", "EmbeddedText"]),
  ]
  var found: Map<String, SymbolId> = [:]
  for (packageName, names) in declared {
    const exported = packageExports program, packageName
    for name in names {
      if const Some(symbol) = exported.get(name) {
        found.set name, symbol
      }
    }
  }
  found
}

/**
 * The numeric types by symbol, so that adapting a literal is one map lookup instead of eleven comparisons. The width
 * is read from the name, which is the only place it is written down: the declarations themselves are `native`.
 */
fn numericNames(exports: Map<String, SymbolId>): Map<Int, String> {
  var found: Map<Int, String> = [:]
  const declared = [
    "Int8",
    "Int16",
    "Int32",
    "Int64",
    "UInt8",
    "UInt16",
    "UInt32",
    "UInt64",
    "Float32",
    "Float64",
    "Decimal",
  ]
  for name in declared {
    if const Some(symbol) = exports.get(name) {
      found.set symbol.value, name
    }
  }
  found
}

/**
 * `Void` and `Never` are names of the language *and* declarations of the prelude, and both have to build the same
 * type. Which of the two a file sees depends on its scope, so the checker accepts either.
 */
fn bothNames(program: Program, exports: Map<String, SymbolId>, name: String): List<SymbolId> {
  var found: List<SymbolId> = []
  if const Some(builtin) = program.builtins.get(name) {
    found.append builtin
  }
  if const Some(declared) = exports.get(name) {
    if !found.contains(declared) {
      found.append declared
    }
  }
  found
}

fn preludeExports(program: Program): Map<String, SymbolId> {
  packageExports program, "std/prelude"
}

/** What the `src/lib.trb` of a package of the workspace exports, by name; empty where there is no such package. */
fn packageExports(program: Program, name: String): Map<String, SymbolId> {
  const package = match program.workspace.packageNamed(name) {
    Some(found) => found
    None => {
      return [:]
    }
  }
  match program.graph.moduleAt(joinPath(package.directory, "src/lib.trb")) {
    Some(module) => program.scopes[module.value].exported
    None => [:]
  }
}
