/**
 * Type equality, substitution and unification: `sameType`/`sameFunction` decide whether two [TypeForm]s are the same
 * type, `substitute` replaces a generic parameter by a type, and `unify` solves a unification variable against an
 * exact type. `openInference`/`closeInference` bracket the one statement a variable lives inside of, and the
 * `prune*` functions write a variable's solution back into every table that recorded a type before it was solved.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use TypeId, TypeForm, TypeTable, TupleField, FunctionForm, ParameterForm, ParameterMode, ParameterId, Bound from "./type"
use VariableId, Witness from "./type"
use Checker, Adaptation, Resolution, Dispatch, CollectionLiteral, VariableState from "./context"
use Quotation, QuotationCapture, QuotationParameter from "./context"

/**
 * "The same type" the way the language means it.
 *
 * Types are interned, so this is `==` in almost every case. The one exception is a *name*: a tuple label and the name
 * of a function parameter are documentation for a position, not part of type identity, so `(lowest: Int, highest: Int)`
 * and `(Int, Int)` are one type. That a label at the same position must still be the right one is a rule of argument
 * matching, checked where a call is resolved, which is exactly why the names stay in the form and only this function
 * ignores them.
 */
public fn sameType(types: TypeTable, left: TypeId, right: TypeId): Bool {
  if left == right {
    return true
  }
  match types.form(left) {
    .Nominal(symbol, arguments) => {
      if const .Nominal(otherSymbol, otherArguments) = types.form(right) {
        return symbol == otherSymbol && sameTypes(types, arguments, otherArguments)
      }
      false
    }
    .Traits(bounds) => {
      if const .Traits(otherBounds) = types.form(right) {
        return sameTypes types, bounds, otherBounds
      }
      false
    }
    .Tuple(fields) => {
      if const .Tuple(otherFields) = types.form(right) {
        if fields.length() != otherFields.length() {
          return false
        }
        for index in 0..fields.length() {
          if !sameType(types, fields[index].type, otherFields[index].type) {
            return false
          }
        }
        return true
      }
      false
    }
    .Function(form) => {
      if const .Function(otherForm) = types.form(right) {
        return sameFunction types, form, otherForm
      }
      false
    }
    // Everything else carries no name, so two of them that are not the same id are different types
    _ => false
  }
}

/** [sameType] over two lists, position by position: the generic arguments of a `Nominal`, the bounds of a `Traits`. */
public fn sameTypes(types: TypeTable, left: List<TypeId>, right: List<TypeId>): Bool {
  if left.length() != right.length() {
    return false
  }
  for index in 0..left.length() {
    if !sameType(types, left[index], right[index]) {
      return false
    }
  }
  true
}

/**
 * How a parameter is passed belongs to the type of a function, what it is called does not - and `self` is a name.
 * `Point.area` read as a value is `(self: Point) => Int64`, and that is the same type as `(value: Point) => Int64`, so
 * `[p, q].map(Point.area)` works (design 3.2).
 */
public fn sameMode(left: ParameterMode, right: ParameterMode): Bool {
  isByReference(left) == isByReference(right) && isVariadicMode(left) == isVariadicMode(right)
    && isLazyMode(left) == isLazyMode(right)
}

fn isByReference(mode: ParameterMode): Bool {
  match mode {
    .Var => true
    .Receiver(isVar) => isVar
    _ => false
  }
}

fn isVariadicMode(mode: ParameterMode): Bool {
  match mode {
    .Variadic => true
    _ => false
  }
}

fn isLazyMode(mode: ParameterMode): Bool {
  match mode {
    .Lazy => true
    _ => false
  }
}

/** Modes and defaults belong to the type of a function, the names of its parameters do not. */
public fn sameFunction(types: TypeTable, left: FunctionForm, right: FunctionForm): Bool {
  if left.parameters.length() != right.parameters.length() {
    return false
  }
  for index in 0..left.parameters.length() {
    const parameter = left.parameters[index]
    const other = right.parameters[index]
    if !sameMode(parameter.mode, other.mode) || parameter.hasDefault != other.hasDefault {
      return false
    }
    if !sameType(types, parameter.type, other.type) {
      return false
    }
  }
  sameType types, left.result, right.result
}

/**
 * Replaces generic parameters by types: what a call, an implementation and every use of a generic declaration needs.
 * The result is interned again, so substituting into a type that mentions no parameter gives back the very same id.
 */
public fn substitute(var types: TypeTable, id: TypeId, mapping: Map<ParameterId, TypeId>): TypeId {
  if mapping.isEmpty() {
    return id
  }
  match types.form(id) {
    .Parameter(parameter) => mapping.get(parameter) ?? id
    .Nominal(symbol, arguments) => {
      const replaced = substituteAll types, arguments, mapping
      if replaced == arguments {
        return id
      }
      types.intern TypeForm.Nominal(symbol, replaced)
    }
    .Traits(bounds) => {
      const replaced = substituteAll types, bounds, mapping
      if replaced == bounds {
        return id
      }
      types.intern TypeForm.Traits(replaced)
    }
    .Tuple(fields) => {
      var replaced: List<TupleField> = []
      var isChanged = false
      for field in fields {
        const inner = substitute types, field.type, mapping
        isChanged = isChanged || inner != field.type
        replaced.append TupleField(field.label, inner)
      }
      if !isChanged {
        return id
      }
      types.intern TypeForm.Tuple(replaced)
    }
    .Function(form) => {
      const replaced = substituteFunction types, form, mapping
      if replaced == form {
        return id
      }
      types.intern TypeForm.Function(replaced)
    }
    // A literal type, a const value, `Void`, `Never`, `Invalid` and a variable mention no parameter
    _ => id
  }
}

/** [substitute] over a list of types, such as the generic arguments of a `Nominal`. */
public fn substituteAll(
  var types: TypeTable,
  arguments: List<TypeId>,
  mapping: Map<ParameterId, TypeId>,
): List<TypeId> {
  var replaced: List<TypeId> = []
  for argument in arguments {
    replaced.append substitute(types, argument, mapping)
  }
  replaced
}

/** [substitute] over every parameter type and the result of a [FunctionForm]. */
public fn substituteFunction(
  var types: TypeTable,
  form: FunctionForm,
  mapping: Map<ParameterId, TypeId>,
): FunctionForm {
  var parameters: List<ParameterForm> = []
  for parameter in form.parameters {
    parameters.append parameter.copy(type: substitute(types, parameter.type, mapping))
  }
  FunctionForm parameters, substitute(types, form.result, mapping)
}

/** [substitute] over the subject and the traits of every [Bound] of a `where` clause or an implementation. */
public fn substituteBounds(var types: TypeTable, bounds: List<Bound>, mapping: Map<ParameterId, TypeId>): List<Bound> {
  var replaced: List<Bound> = []
  for bound in bounds {
    replaced.append Bound(substitute(types, bound.subject, mapping), substituteAll(types, bound.traits, mapping))
  }
  replaced
}

// --- Inference contexts ---------------------------------------------------------------------------------------------

/**
 * Inference is bidirectional and local: a context is opened for one statement and closed at its end, and a variable
 * never leaves it. There is no generalization and no propagation across statements, so `var items = []` on one line and
 * `items.append(1)` on the next is an error by design - the annotation is the answer.
 *
 * Closing a context does two things: it reports every variable that is still open, and it walks the tables of the
 * statement once to put the solutions in. That last step is needed because an expression is recorded before the
 * variable in its type is solved: `const items: List<Int> = []` records `List<_>` and learns `Int64` afterwards.
 */
public fn openInference(var checker: Checker) {
  if checker.contextStarts.isEmpty() {
    checker.pendingSpans = []
    checker.hasVariables = false
  }
  const start = checker.variables.length()
  checker.contextStarts.append start
}

/**
 * Closes the innermost inference context: reports every variable of it that is still unsolved, and - once the
 * outermost context of the statement closes - writes every solution into the tables ([pruneAt]). A block nested
 * inside the statement's own expression settles nothing on its own, because the statement around it may still learn
 * a variable's type from another branch (`const x = if c { None } else { Some(1) }`).
 */
public fn closeInference(var checker: Checker) {
  const last = checker.contextStarts.length() - 1
  if last < 0 {
    return
  }
  const start = checker.contextStarts.removeAt(last) ?? 0
  // A block inside an expression has statements of its own, and the last one of them belongs to the statement around
  // it: `const end = if c { None } else { Some(x) }` learns what `None` is from the other branch. So only the outermost
  // context settles and prunes, and every nested one is bookkeeping
  if !checker.contextStarts.isEmpty() {
    return
  }
  settleVariables checker, start
  if checker.hasVariables {
    const pending = checker.pendingSpans
    for at in pending {
      pruneAt checker, at
    }
  }
  checker.pendingSpans = []
  checker.hasVariables = false
}

/** A `Never` met by an open variable that has no fallback yet: `Never` becomes its fallback. */
fn fallsBackToNever(var checker: Checker, never: TypeId, other: TypeId): Bool {
  if never != checker.neverType {
    return false
  }
  const variable = match openVariableOf(checker, other) {
    Some(found) => found
    None => {
      return false
    }
  }
  if checker.variables[variable.value].fallback.isNone() {
    checker.fallBackTo variable, never
  }
  true
}

/** The message for every variable that is still open at the end of the statement that made it. */
fn settleVariables(var checker: Checker, start: Int) {
  var index = start
  while index < checker.variables.length() {
    const state = checker.variables[index]
    // A bare type name that nothing decided means what its declaration says by default
    if state.solution.isNone() {
      if const Some(fallback) = state.fallback {
        checker.solveVariable VariableId(index), fallback
        index = index + 1
        continue
      }
    }
    if state.solution.isNone() && !state.reported {
      checker.markReported VariableId(index)
      reportUnsolved checker, state
    }
    index = index + 1
  }
}

fn reportUnsolved(var checker: Checker, state: VariableState) {
  const name = state.name
  const owner = state.owner
  const at = state.at
  // Only a collection literal makes a variable that belongs to no declaration
  if owner.isEmpty() {
    checker.reportHere(
      Diagnostic.error("Cannot infer the type of this collection", at)
        .withNote("An empty literal needs a type: annotate the binding (`const items: List<Int> = []`)"),
    )
    return
  }
  // A `const` parameter is a *value*, so none of the three ways a type is pinned down applies to it: no argument of
  // the call mentions it, and the note that names them would send the reader looking in the wrong place
  if state.const {
    checker.reportHere(
      Diagnostic.error("Cannot infer `{name}` of `{owner}`", at)
        .withNote(
          "`{name}` is a `const` parameter and is never inferred from an argument: write it in the type that is "
            + "expected of this value",
        ),
    )
    return
  }
  const written = typeArgumentsNote checker, state
  checker.reportHere(
    Diagnostic.error("Cannot infer `{name}` of `{owner}`", at)
      .withNote("Annotate the closure parameter or the result, or write the type argument: `{owner}<{written}>(...)`"),
  )
}

/**
 * The type argument list a "Cannot infer" note spells out for one unsolved variable: every parameter of the call in
 * its declared order, the ones already known written out and this one - and any other still-unsolved sibling - named
 * after its parameter. Explicit type arguments fill parameters from the left, so naming only the one that stayed
 * open would silently ask for the wrong one to be filled in wherever it is not the first.
 */
fn typeArgumentsNote(var checker: Checker, state: VariableState): String {
  if state.siblings.isEmpty() {
    return state.name
  }
  var parts: List<String> = []
  for index in 0..state.siblings.length() {
    if index == state.position {
      parts.append state.name
    } else {
      parts.append describeArgument(checker, state.siblings[index])
    }
  }
  parts.joined separator: ", "
}

/** A sibling type argument as it stands right now: its type where one was found, its own parameter name otherwise. */
fn describeArgument(var checker: Checker, id: TypeId): String {
  const resolved = resolveType checker, id
  match checker.types.form(resolved) {
    .Variable(variable) => checker.variableState(variable).name
    _ => checker.describe resolved
  }
}

/**
 * What a variable was solved with, everywhere inside a type. The result is interned again, so a type that mentions no
 * variable comes back as the very same id and costs nothing.
 */
public fn resolveType(var checker: Checker, id: TypeId): TypeId {
  resolveDeep checker, id, 0
}

fn resolveDeep(var checker: Checker, id: TypeId, depth: Int): TypeId {
  if depth > 24 {
    return id
  }
  match checker.types.form(id) {
    .Variable(variable) => {
      match checker.solutionOf(variable) {
        Some(found) => resolveDeep(checker, found, depth + 1)
        None => id
      }
    }
    .Nominal(symbol, arguments) => {
      const replaced = resolveList checker, arguments, depth
      if replaced == arguments {
        return id
      }
      checker.types.intern TypeForm.Nominal(symbol, replaced)
    }
    .Traits(bounds) => {
      const replaced = resolveList checker, bounds, depth
      if replaced == bounds {
        return id
      }
      checker.types.intern TypeForm.Traits(replaced)
    }
    .Tuple(fields) => {
      var replaced: List<TupleField> = []
      var isChanged = false
      for field in fields {
        const inner = resolveDeep(checker, field.type, depth + 1)
        isChanged = isChanged || inner != field.type
        replaced.append TupleField(field.label, inner)
      }
      if !isChanged {
        return id
      }
      checker.types.intern TypeForm.Tuple(replaced)
    }
    .Function(form) => {
      const replaced = resolveFunction checker, form, depth
      if replaced == form {
        return id
      }
      checker.types.intern TypeForm.Function(replaced)
    }
    _ => id
  }
}

fn resolveList(var checker: Checker, arguments: List<TypeId>, depth: Int): List<TypeId> {
  var replaced: List<TypeId> = []
  for argument in arguments {
    replaced.append resolveDeep(checker, argument, depth + 1)
  }
  replaced
}

fn resolveFunction(var checker: Checker, form: FunctionForm, depth: Int): FunctionForm {
  var parameters: List<ParameterForm> = []
  for parameter in form.parameters {
    parameters.append parameter.copy(type: resolveDeep(checker, parameter.type, depth + 1))
  }
  FunctionForm parameters, resolveDeep(checker, form.result, depth + 1)
}

/** [resolveType] over a list of types, such as the type arguments of a call. */
public fn resolveTypes(var checker: Checker, arguments: List<TypeId>): List<TypeId> {
  resolveList checker, arguments, 0
}

/** Whether a type still mentions an unsolved variable, which is what "not inferred yet" means. */
public fn hasVariable(var checker: Checker, id: TypeId): Bool {
  match checker.types.form(id) {
    .Variable(variable) => {
      match checker.solutionOf(variable) {
        Some(found) => hasVariable checker, found
        None => true
      }
    }
    .Nominal(_, arguments) => anyVariable checker, arguments
    .Traits(bounds) => anyVariable checker, bounds
    .Tuple(fields) => {
      for field in fields {
        if hasVariable(checker, field.type) {
          return true
        }
      }
      false
    }
    .Function(form) => {
      for parameter in form.parameters {
        if hasVariable(checker, parameter.type) {
          return true
        }
      }
      hasVariable checker, form.result
    }
    _ => false
  }
}

fn anyVariable(var checker: Checker, arguments: List<TypeId>): Bool {
  for argument in arguments {
    if hasVariable(checker, argument) {
      return true
    }
  }
  false
}

/**
 * Marks every variable a type still holds as answered, without solving it. A construct that is not type-checked
 * itself (a receiver closure, a quotation) can leave the parameters of its call open, and without this "cannot
 * infer" would then be a message about the checker instead of about the source.
 */
public fn suppressVariables(var checker: Checker, id: TypeId) {
  match checker.types.form(id) {
    .Variable(variable) => {
      match checker.solutionOf(variable) {
        Some(found) => suppressVariables checker, found
        None => checker.markReported variable
      }
    }
    .Nominal(_, arguments) => suppressAll checker, arguments
    .Traits(bounds) => suppressAll checker, bounds
    .Tuple(fields) => {
      for field in fields {
        suppressVariables checker, field.type
      }
    }
    .Function(form) => {
      for parameter in form.parameters {
        suppressVariables checker, parameter.type
      }
      suppressVariables checker, form.result
    }
    _ => {}
  }
}

fn suppressAll(var checker: Checker, arguments: List<TypeId>) {
  for argument in arguments {
    suppressVariables checker, argument
  }
}

/** The variable a type *is*, if it is one and is still open: that is what a literal adapts against. */
public fn openVariableOf(var checker: Checker, id: TypeId): VariableId? {
  if const .Variable(variable) = checker.types.form(id) {
    match checker.solutionOf(variable) {
      Some(found) => {
        return openVariableOf checker, found
      }
      None => {
        return variable
      }
    }
  }
  None
}

// --- Unification ----------------------------------------------------------------------------------------------------

/**
 * First-order unification over `TypeForm`, with an occurs check. The only thing it may do is solve a variable with an
 * exact type: coercion (to a trait value, from a literal) is a separate, directed step applied only in a check
 * position, and never solves a variable, which is why `[Square(2.0), Circle(1.0)]` does not infer `List<Shape>`.
 *
 * A generic parameter is rigid: it unifies with itself and with nothing else. What is broken or not checked yet
 * absorbs, exactly as it does everywhere else in the checker.
 */
public fn unify(var checker: Checker, left: TypeId, right: TypeId): Bool {
  unifyDeep checker, left, right, 0
}

fn unifyDeep(var checker: Checker, left: TypeId, right: TypeId, depth: Int): Bool {
  if left == right || depth > 24 {
    return true
  }
  const one = resolveShallow checker, left
  const other = resolveShallow checker, right
  if one == other {
    return true
  }
  if checker.absorbs(one) || checker.absorbs(other) {
    // `Never` fits everywhere and decides nothing - except where nothing else decides the variable either: then the value
    // that never arrives is all the statement says about it, so `described(nothing)` with `nothing: Never` is
    // `described<Never>`. A fallback and not a solution, so `[fail(), 1]` is still a `List<Int64>`
    if fallsBackToNever(checker, one, other) || fallsBackToNever(checker, other, one) {
      return true
    }
    // A variable that meets something broken is never solved, and its "Cannot infer" would be a second message about
    // what was reported where it broke
    if const Some(variable) = openVariableOf(checker, one) {
      checker.markReported variable
    }
    if const Some(variable) = openVariableOf(checker, other) {
      checker.markReported variable
    }
    return true
  }
  if const Some(variable) = openVariableOf(checker, one) {
    return bindVariable checker, variable, other
  }
  if const Some(variable) = openVariableOf(checker, other) {
    return bindVariable checker, variable, one
  }
  match checker.types.form(one) {
    .Nominal(symbol, arguments) => {
      if const .Nominal(otherSymbol, otherArguments) = checker.types.form(other) {
        return symbol == otherSymbol && unifyAll(checker, arguments, otherArguments, depth)
      }
      false
    }
    .Traits(bounds) => {
      if const .Traits(otherBounds) = checker.types.form(other) {
        return unifyAll checker, bounds, otherBounds, depth
      }
      false
    }
    .Tuple(fields) => {
      if const .Tuple(otherFields) = checker.types.form(other) {
        if fields.length() != otherFields.length() {
          return false
        }
        for index in 0..fields.length() {
          if !unifyDeep(checker, fields[index].type, otherFields[index].type, depth + 1) {
            return false
          }
        }
        return true
      }
      false
    }
    .Function(form) => {
      if const .Function(otherForm) = checker.types.form(other) {
        return unifyFunction checker, form, otherForm, depth
      }
      false
    }
    // A parameter, a literal type, a const value, `Void`: two of them that are not the same id are different types
    _ => false
  }
}

/** One level of "what is this variable now", without rebuilding the type: the hot path of every unification. */
fn resolveShallow(var checker: Checker, id: TypeId): TypeId {
  if const .Variable(variable) = checker.types.form(id) {
    if const Some(found) = checker.solutionOf(variable) {
      return resolveShallow checker, found
    }
  }
  id
}

fn bindVariable(var checker: Checker, variable: VariableId, id: TypeId): Bool {
  const own = checker.types.intern TypeForm.Variable(variable)
  if own == id {
    return true
  }
  if occursIn(checker, variable, id) {
    return false
  }
  checker.solveVariable variable, id
  true
}

/** The occurs check: a variable may not be solved with a type that mentions it, or resolving it would never end. */
fn occursIn(var checker: Checker, variable: VariableId, id: TypeId): Bool {
  match checker.types.form(id) {
    .Variable(other) => {
      if other == variable {
        return true
      }
      match checker.solutionOf(other) {
        Some(found) => occursIn checker, variable, found
        None => false
      }
    }
    .Nominal(_, arguments) => occursInAny checker, variable, arguments
    .Traits(bounds) => occursInAny checker, variable, bounds
    .Tuple(fields) => {
      for field in fields {
        if occursIn(checker, variable, field.type) {
          return true
        }
      }
      false
    }
    .Function(form) => {
      for parameter in form.parameters {
        if occursIn(checker, variable, parameter.type) {
          return true
        }
      }
      occursIn checker, variable, form.result
    }
    _ => false
  }
}

fn occursInAny(var checker: Checker, variable: VariableId, arguments: List<TypeId>): Bool {
  for argument in arguments {
    if occursIn(checker, variable, argument) {
      return true
    }
  }
  false
}

fn unifyAll(var checker: Checker, left: List<TypeId>, right: List<TypeId>, depth: Int): Bool {
  if left.length() != right.length() {
    return false
  }
  for index in 0..left.length() {
    if !unifyDeep(checker, left[index], right[index], depth + 1) {
      return false
    }
  }
  true
}

/** The name of a parameter is not part of type identity, so only the modes and the types have to line up. */
fn unifyFunction(var checker: Checker, left: FunctionForm, right: FunctionForm, depth: Int): Bool {
  if left.parameters.length() != right.parameters.length() {
    return false
  }
  for index in 0..left.parameters.length() {
    const parameter = left.parameters[index]
    const other = right.parameters[index]
    if !sameMode(parameter.mode, other.mode) {
      return false
    }
    if !unifyDeep(checker, parameter.type, other.type, depth + 1) {
      return false
    }
  }
  unifyDeep(checker, left.result, right.result, depth + 1)
}

// --- Putting the solutions into the tables --------------------------------------------------------------------------

/**
 * One span of one statement, after its inference context closed: every table that holds a type at it gets the solved
 * one. Writing the same span twice is harmless, which is what lets the list of pending spans be a plain list.
 */
fn pruneAt(var checker: Checker, at: Span) {
  if const Some(found) = checker.expressionTypeHere(at) {
    const solved = resolveType checker, found
    if solved != found {
      checker.setExpressionType at, solved
    }
  }
  if const Some(found) = checker.patternTypeHere(at) {
    const solved = resolveType checker, found
    if solved != found {
      checker.setPatternType at, solved
    }
  }
  const adaptations = checker.adaptationsHere at
  if !adaptations.isEmpty() {
    var replaced: List<Adaptation> = []
    var isChanged = false
    for adaptation in adaptations {
      const solved = pruneAdaptation checker, adaptation
      isChanged = isChanged || solved != adaptation
      replaced.append solved
    }
    if isChanged {
      checker.setAdaptations at, replaced
    }
  }
  if const Some(found) = checker.resolutionHere(at) {
    const solved = pruneResolution checker, found
    if solved != found {
      checker.setResolution at, solved
    }
  }
  if const Some(found) = checker.typeArgumentsAt(checker.module, at) {
    const solved = resolveTypes checker, found
    if solved != found {
      checker.setTypeArguments at, solved
    }
  }
  if const Some(found) = checker.witnessesAt(checker.module, at) {
    const solved = pruneWitnesses checker, found
    if solved != found {
      checker.setWitnesses at, solved
    }
  }
  // A quotation holds the types of the quoted expression, of its captures and of the parameters of its closures, and
  // `nameOf(limit)` learns its `Value` from the argument - so they are solved here like everything else
  if const Some(found) = checker.quotationAt(checker.module, at) {
    const solved = pruneQuotation checker, found
    checker.recordQuotation at, solved
  }
  // `const items: List<Int> = []` records `List<_>` and learns `Int64` afterwards, and so does what the literal became
  if const Some(found) = checker.collectionLiteralAt(checker.module, at) {
    const solved = pruneCollectionLiteral checker, found
    checker.recordCollectionLiteral at, solved
  }
}

fn pruneCollectionLiteral(var checker: Checker, found: CollectionLiteral): CollectionLiteral {
  match found {
    .Default => found
    .InlineArray(item, size) => CollectionLiteral.InlineArray resolveType(checker, item), size
    .FromIterate(target, item, witness) => CollectionLiteral.FromIterate(
      resolveType(checker, target),
      resolveType(checker, item),
      pruneWitness(checker, witness),
    )
  }
}

fn pruneQuotation(var checker: Checker, quotation: Quotation): Quotation {
  var captures: List<QuotationCapture> = []
  for capture in quotation.captures {
    const annotation = resolveType checker, capture.type
    const witness = pruneWitness checker, capture.witness
    captures.append QuotationCapture(capture.binding, capture.name, annotation, witness)
  }
  var lambdas: Map<Span, List<QuotationParameter>> = [:]
  for (span, parameters) in quotation.lambdas {
    var solved: List<QuotationParameter> = []
    for parameter in parameters {
      const annotation = resolveType checker, parameter.type
      solved.append QuotationParameter(parameter.name, annotation)
    }
    lambdas.set span, solved
  }
  const annotation = resolveType checker, quotation.type
  Quotation annotation, captures, quotation.names, lambdas
}

fn pruneAdaptation(var checker: Checker, adaptation: Adaptation): Adaptation {
  match adaptation {
    .Literal(annotation) => Adaptation.Literal resolveType(checker, annotation)
    .Variadic(element, from) => Adaptation.Variadic resolveType(checker, element), from
    .ToTraitValue(bounds, witnesses) => Adaptation.ToTraitValue(
      resolveTypes(checker, bounds),
      pruneWitnesses(checker, witnesses),
    )
    .Convert(witness, method) => Adaptation.Convert pruneWitness(checker, witness), method
    .ShowValue(witness) => Adaptation.ShowValue pruneWitness(checker, witness)
    .Wrap(annotation) => Adaptation.Wrap resolveType(checker, annotation)
    _ => adaptation
  }
}

fn pruneResolution(var checker: Checker, resolution: Resolution): Resolution {
  match resolution {
    .Callable(symbol, arguments, dispatch) => Resolution.Callable(
      symbol,
      resolveTypes(checker, arguments),
      pruneDispatch(checker, dispatch),
    )
    .Field(owner, field) => Resolution.Field resolveType(checker, owner), field
    .Construct(owner) => Resolution.Construct resolveType(checker, owner)
    .CopyOf(owner) => Resolution.CopyOf resolveType(checker, owner)
    .CaseOf(owner, variant) => Resolution.CaseOf resolveType(checker, owner), variant
    .TupleField(owner, index) => Resolution.TupleField resolveType(checker, owner), index
    .TypeOf(owner) => Resolution.TypeOf resolveType(checker, owner)
    .Constant(symbol, owner) => {
      match owner {
        Some(found) => Resolution.Constant symbol, resolveType(checker, found)
        None => resolution
      }
    }
    _ => resolution
  }
}

fn pruneDispatch(var checker: Checker, dispatch: Dispatch): Dispatch {
  match dispatch {
    .Implementation(implementation, witnesses) => Dispatch.Implementation(
      implementation,
      pruneWitnesses(checker, witnesses),
    )
    .Object(bound, witnesses) => Dispatch.Object resolveType(checker, bound), pruneWitnesses(checker, witnesses)
    .Forwarded(parameter, bound, witnesses) => Dispatch.Forwarded(
      parameter,
      resolveType(checker, bound),
      pruneWitnesses(checker, witnesses),
    )
    _ => dispatch
  }
}

/** [resolveType] over every type a list of [Witness]es carries, recursively through `.Implementation`'s own witnesses. */
public fn pruneWitnesses(var checker: Checker, witnesses: List<Witness>): List<Witness> {
  var replaced: List<Witness> = []
  for witness in witnesses {
    replaced.append pruneWitness(checker, witness)
  }
  replaced
}

fn pruneWitness(var checker: Checker, witness: Witness): Witness {
  match witness {
    .Implementation(implementation, arguments, inner) => Witness.Implementation(
      implementation,
      resolveTypes(checker, arguments),
      pruneWitnesses(checker, inner),
    )
    .Object(annotation, bound) => Witness.Object resolveType(checker, annotation), resolveType(checker, bound)
    .Forwarded(parameter, bound) => Witness.Forwarded parameter, resolveType(checker, bound)
    _ => witness
  }
}
