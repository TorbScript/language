/**
 * A closure is read from the type that is expected of it: the expected function type names its parameters and its
 * result, so `numbers.map { _ * 2 }` needs no annotation anywhere. What the body produces is the result - the expected
 * one flows in, but it never overrides what comes out.
 *
 * Three things are recorded here that the back ends cannot work out again: which parameter an implicit `_` or a name
 * from the function type stands for (`Adaptation.ImplicitParameter`), which bindings of the scope around the closure
 * its body reads and which of those are `var`, and the function type the closure turned out to have.
 *
 * A **receiver closure** (`(var self: Element) => Void`) is the same thing with one parameter that is not a value but
 * the thing names resolve against: inside it, a bare name means a member of the receiver exactly as it does inside a
 * method. Only that one receiver is implicit, so it replaces whatever was implicit around the closure, and
 * naming it (`html { root => ... }`) means nothing is implicit at all.
 */

use Span from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use Closure, ClosureParameter from "../../syntax/ast"
use TypeId, FunctionForm, ParameterForm, ParameterMode from "./type"
use Checker, Expectation, Resolution, Adaptation, LocalBinding, BindingId from "./context"
use ClosureFrame, ReceiverClosure from "./context"
use Target, formOf, noteCapture from "./name"
use resolveType, hasVariable, unify from "./unify"
use checkBlock, bodyExpectation, inferredResult, scopeHere, taskValueOf from "./statement"
use checkPattern from "./pattern"
use requireIrrefutable from "./exhaustive"
use typeFromReference from "./lowering"
use markReferenceBindings from "./mutation"
use noteClosureKind from "./escape"
use settleTries from "./expression"

/** `{ x => x + 1 }`, `{ _ * 2 }`, `{ value: Int => ... }`: the closure, checked against what is expected of it. */
public fn checkClosure(var checker: Checker, closure: Closure, at: Span, expected: TypeId?): TypeId {
  const wanted = match expected {
    Some(found) => resolveType checker, found
    None => checker.deferredType
  }
  const form = formOf checker, wanted
  const hasParameters = !closure.parameters.isEmpty()
  const written = parameterFormsOf checker, closure, form, at
  const parameters = written.forms
  // `(var self: Element) => Void`: the receiver is a parameter, and everything after it is an ordinary one
  const receiver = receiverIndexOf parameters
  var implicit: List<String?> = []
  var types: List<TypeId> = []
  var used: List<Int> = []
  if !hasParameters {
    for index in (receiver + 1)..parameters.length() {
      implicit.append parameters[index].name
      types.append parameters[index].annotation
      used.append(-1)
    }
  }
  // A closure whose parameters do not line up with what was expected of it said so already: its body is checked
  // without an expectation and the closure counts as the type that was asked for, so nothing is reported twice
  var expectedResult: TypeId? = None
  if const Some(found) = form {
    if !written.isBroken {
      expectedResult = found.result
    }
  }
  const frame = ClosureFrame(at, 0, implicit, types, used, [], hasParameters, receiver + 1)
  const result = checkClosureBody checker, closure, at, parameters, frame, receiver, expectedResult
  if written.isBroken {
    return wanted
  }
  checker.functionType FunctionForm(parameters, result)
}

/** `Task<Value>`: what a closure whose body produced the `Value` of a task is, as a type again. */
fn taskOf(var checker: Checker, value: TypeId): TypeId {
  match checker.wellKnown.task {
    Some(task) => checker.nominal task, [value]
    None => value
  }
}

/** The parameter names resolve against, or `-1`: the first one of the expected function type that is a receiver. */
fn receiverIndexOf(parameters: List<ParameterForm>): Int {
  for index in 0..parameters.length() {
    if const .Receiver(_) = parameters[index].mode {
      return index
    }
  }
  -1
}

/** The parameters a closure ends up with, and whether they disagreed with what was expected of it. */
type ClosureParameters {
  forms: List<ParameterForm>
  isBroken: Bool
}

/**
 * The parameters of the closure: the ones it wrote down, with their annotations where it has them and the types of the
 * expected function type otherwise. Without an expected type every parameter needs an annotation (design 2.7).
 */
fn parameterFormsOf(
  var checker: Checker,
  closure: Closure,
  form: FunctionForm?,
  at: Span,
): ClosureParameters {
  const wanted = match form {
    Some(found) => found.parameters
    None => []
  }
  if closure.parameters.isEmpty() {
    return ClosureParameters wanted, false
  }
  const scope = scopeHere checker
  var parameters: List<ParameterForm> = []
  var isBroken = false
  if form.isSome() && closure.parameters.length() != wanted.length() {
    reportArity checker, closure.parameters.length(), wanted.length(), at
    isBroken = true
  }
  for index in 0..closure.parameters.length() {
    const parameter = closure.parameters[index]
    // `commaSeparated(closer, parse: (var Parser) => Item)`: the mode belongs to the expected function type, and a
    // closure that fills it takes its parameter the same way
    var mode = ParameterMode.Value
    if index < wanted.length() {
      mode = wanted[index].mode
    }
    var annotation = checker.deferredType
    match parameter.annotation {
      Some(reference) => {
        annotation = typeFromReference checker, reference, scope.forType()
        // An annotation that disagrees with the expected function type is a mistake in the closure, and the closure
        // keeps the type it was asked for: one root cause gets one message
        if index < wanted.length() {
          if !unify(checker, annotation, wanted[index].annotation) {
            reportParameterMismatch checker, annotation, wanted[index].annotation, reference.span
            isBroken = true
          }
        }
      }
      None => {
        if index < wanted.length() {
          annotation = wanted[index].annotation
        } else if form.isNone() {
          reportMissingParameterTypes checker, parameter.pattern.span
        }
      }
    }
    parameters.append ParameterForm(nameOfParameter(parameter), mode, annotation)
  }
  ClosureParameters parameters, isBroken
}

/** A `var` parameter binds a mutable path into the caller's place, exactly as a `var` parameter of a `fn` does. */
fn isVarMode(mode: ParameterMode): Bool {
  match mode {
    .Var => true
    .Receiver(isVar) => isVar
    _ => false
  }
}

/** The name a written closure parameter is known under, where its pattern is a plain name. */
fn nameOfParameter(parameter: ClosureParameter): String? {
  if const .Binding(name) = parameter.pattern.kind {
    return name
  }
  None
}

/**
 * The body. `return` inside a closure returns from the closure, `break` cannot leave it (design 3.5), and the result is
 * what the body produces - unified with the result of the expected function type, which is usually a variable of the
 * call that takes the closure.
 *
 * **`?` returns from the closure too**, so the closure has to produce an `Option` or a `Result` for it to return. Where
 * the result is pinned down that is checked at the `?`; where it is inferred it is only known at the end, so every `?`
 * waits for it ([settleTries]).
 */
fn checkClosureBody(
  var checker: Checker,
  closure: Closure,
  at: Span,
  parameters: List<ParameterForm>,
  frame: ClosureFrame,
  receiver: Int,
  expectedResult: TypeId?,
): TypeId {
  const hasParameters = frame.hasParameters
  const savedResult = checker.resultType
  const savedInferred = checker.isResultInferred
  const savedReturns = checker.returnTypes
  const savedDepth = checker.loopDepth
  const savedReceiverType = checker.receiverType
  const savedReceiverBinding = checker.receiverBinding
  const savedAwaits = checker.awaitsTasks
  const savedTaskArgument = checker.isTaskArgument
  const savedCollects = checker.collectsTries
  const savedTries = checker.pendingTries
  // The result is inferred whenever the expected one is not pinned down yet, which is the ordinary case at a call. It
  // still flows into the body: `flatMap { _.manager.toList() }` learns its `Output` from the `Iterate<Output>` the
  // closure has to produce, and that is a coercion and not a unification
  var isInferred = true
  var declared = checker.voidType
  var produced = checker.voidType
  var isTask = false
  var inner = Expectation.None
  if const Some(found) = expectedResult {
    if !checker.absorbs(found) {
      declared = found
      // `{ Ok value }` where a `Task<Result<...>>` is expected: the body produces the `Value` of the `Task`, exactly as
      // the body of a `fn` that answers one does (CONCEPT, "Concurrency"), so `await()` and `?` stay visible inside it
      produced = taskValueOf(checker, found) ?? found
      isTask = produced != found
      isInferred = hasVariable checker, produced
      inner = bodyExpectation checker, produced, false
    }
  }
  checker.resultType = produced
  checker.isResultInferred = isInferred
  // A closure is a body of its own, so it answers the placement question of `await()` for itself: a closure that
  // *is* a task may wait - the one handed to `spawn`, and one whose declared result is a `Task<...>` - and every
  // other one may not, because `tasks.map \{ _.await() \}` would block the worker that runs the pipeline
  checker.awaitsTasks = isTask || checker.isTaskArgument
  // Only the closure that fills this very argument is the task; one written inside its body is an ordinary closure
  checker.isTaskArgument = false
  checker.returnTypes = []
  checker.loopDepth = 0
  checker.collectsTries = true
  checker.pendingTries = []
  checker.openScope()
  // A closure argument runs *during* the `var` access of its call, which is the one thing the Swift model of exclusivity
  // still holds a call responsible for once its arguments have been evaluated
  checker.runningClosures = checker.runningClosures + 1
  const start = checker.bindings.length()
  checker.closureFrames.append frame.copy(bindings: start, enclosingLoopDepth: savedDepth)
  if receiver >= 0 {
    declareReceiver checker, closure, at, parameters, receiver, hasParameters
  }
  if hasParameters {
    for index in 0..closure.parameters.length() {
      if index == receiver {
        continue
      }
      const form = parameters.get(index) ?? ParameterForm(None, ParameterMode.Value, checker.deferredType)
      const isVar = isVarMode form.mode
      const own = closure.parameters[index].pattern
      checkPattern checker, own, form.annotation, isVar
      requireIrrefutable checker, own, form.annotation, "The parameter of a closure", "value"
    }
  }
  // A `var` parameter of a closure and a `var fn` receiver are references like any other, so a nested closure may not
  // carry them off
  markReferenceBindings checker, start
  const outcome = checkBlock checker, closure.body, inner
  var result = declared
  if isInferred {
    const value = inferredResult checker, outcome
    settleTries checker, value, isClosure: true
    // What the closure *is* stays the function type that was asked for: the body produced the value inside the `Task`
    result = if isTask { taskOf checker, value } else { value }
  }
  const last = checker.closureFrames.length() - 1
  const captures = checker.closureFrames[last].captures
  const declarations = checker.closureFrames[last].declarations
  const changed = checker.closureFrames[last].changedDeclarations
  const _ = checker.closureFrames.removeAt last
  checker.runningClosures = checker.runningClosures - 1
  checker.closeScope()
  checker.resultType = savedResult
  checker.isResultInferred = savedInferred
  checker.returnTypes = savedReturns
  checker.loopDepth = savedDepth
  checker.receiverType = savedReceiverType
  checker.receiverBinding = savedReceiverBinding
  checker.awaitsTasks = savedAwaits
  checker.isTaskArgument = savedTaskArgument
  checker.collectsTries = savedCollects
  checker.pendingTries = savedTries
  checker.recordCaptures at, captures
  checker.recordDeclarationCaptures at, declarations
  // Whether the closure may outlive the call it stands in, and whether it may hold a reference
  noteClosureKind checker, at, captures, changed
  if const Some(found) = expectedResult {
    if isInferred {
      // The body was checked against the expected result, so where it did not *unify* it either coerced into it
      // (`flatMap { _.toList() }` produces a `List` where an `Iterate<Output>` is wanted, design 2.5) or the body has
      // already said what is wrong with it. Either way what the closure *is* is the type that was asked for: a function
      // type has no variance, so keeping the body's own result here would report the closure a second time
      if !unify(checker, result, found) {
        result = resolveType checker, found
      }
    }
  }
  result
}

// --- Receivers ------------------------------------------------------------------------------------------------------

/**
 * The receiver of a receiver closure. Written down (`html { root => ... }`) it is an ordinary binding and **nothing**
 * is implicit inside the closure any more: naming the receiver is how a nested closure reaches one from further out
 * instead of a second implicit one, and leaving the outer one implicit would be the scope leaking it rules out.
 *
 * Left out, `self` is the implicit receiver, and it replaces whatever was implicit around the closure. Either way the
 * binding is recorded, because an implicit receiver has no node in the tree that could carry it.
 */
fn declareReceiver(
  var checker: Checker,
  closure: Closure,
  at: Span,
  parameters: List<ParameterForm>,
  index: Int,
  hasParameters: Bool,
) {
  const form = parameters[index]
  const isVar = isVarMode form.mode
  // A closure that wrote fewer parameters than the expected type has said so already, and its receiver stays implicit
  if !hasParameters || index >= closure.parameters.length() {
    const binding = checker.declareBinding(
      LocalBinding("self", form.annotation, isVar, at, isReceiver: true)
    )
    checker.setReceiver binding
    checker.recordReceiver at, ReceiverClosure(binding, form.annotation, isVar, true)
    return
  }
  const before = checker.bindings.length()
  checkPattern checker, closure.parameters[index].pattern, form.annotation, isVar
  checker.receiverType = None
  checker.receiverBinding = None
  if checker.bindings.length() > before {
    checker.recordReceiver at, ReceiverClosure(BindingId(before), form.annotation, isVar, false)
  }
}

// --- Implicit parameters --------------------------------------------------------------------------------------------

/** `_`, `_2`, `_3`, ...: the positional names of a closure that declared no parameters. */
public fn isImplicitName(text: String): Bool {
  implicitIndexOf(text) >= 0
}

fn implicitIndexOf(text: String): Int {
  if text == "_" {
    return 0
  }
  const names = ["_2", "_3", "_4", "_5", "_6", "_7", "_8", "_9"]
  for index in 0..names.length() {
    if text == names[index] {
      return index + 1
    }
  }
  -1
}

/**
 * `_`, `_2`, ...: the implicit parameter of the closure that is being checked. Only a closure that declared no
 * parameters of its own has them, and `_` always means the innermost such closure - it never reaches an outer one.
 *
 * A bare name is never resolved against the expected function type's own parameter names (CONCEPT, "Trailing
 * Closures"): that acted at a distance, and renaming a library's parameter would silently break every caller that
 * relied on it. [implicitParameterHint] is the note offered instead, once the name turns out to be nowhere.
 */
public fn implicitParameterTarget(var checker: Checker, text: String, at: Span): Target? {
  const index = implicitIndexOf text
  if index < 0 {
    return None
  }
  var frame = checker.closureFrames.length() - 1
  while frame >= 0 {
    if checker.closureFrames[frame].hasParameters {
      frame = frame - 1
      continue
    }
    if index < checker.closureFrames[frame].types.length() {
      return parameterBindingOf checker, frame, index, text, at
    }
    // `_` belongs to the innermost closure without a parameter list and never reaches an outer one
    return None
  }
  None
}

/**
 * The note for a name that is nowhere, when it is exactly the name the expected function type gives a parameter of
 * the closure that is being checked (`numbers.map { value * 2 }`, where `value` is not in scope): the closure's
 * parameter is implicit under `_` (or `_2`, ...), and naming it explicitly is the fix.
 *
 * A name reaches outward the same way `implicitParameterTarget` used to resolve one: the innermost closure without a
 * parameter list first, then the ones further out.
 */
public fn implicitParameterHint(checker: Checker, text: String): String? {
  if isImplicitName(text) {
    return None
  }
  var frame = checker.closureFrames.length() - 1
  while frame >= 0 {
    if !checker.closureFrames[frame].hasParameters {
      const index = nameIndexOf checker.closureFrames[frame].implicit, text
      if index >= 0 && index < checker.closureFrames[frame].types.length() {
        return hintFor checker, frame, index, text
      }
    }
    frame = frame - 1
  }
  None
}

fn nameIndexOf(implicit: List<String?>, text: String): Int {
  for index in 0..implicit.length() {
    if implicit[index] == text {
      return index
    }
  }
  -1
}

/** `_` at the first parameter, `_2` at the second, and so on - the placeholder that stands at this position. */
fn placeholderNameOf(index: Int): String {
  if index == 0 { "_" } else { "_{index + 1}" }
}

/** `value` for a closure with one parameter, `_, value` once there is more than one to place. */
fn rewriteWith(checker: Checker, frame: Int, index: Int, text: String): String {
  const length = checker.closureFrames[frame].types.length()
  if length == 1 {
    return text
  }
  var parts: List<String> = []
  for position in 0..length {
    parts.append(if position == index { text } else { placeholderNameOf position })
  }
  parts.joined ", "
}

fn hintFor(checker: Checker, frame: Int, index: Int, text: String): String {
  const placeholder = placeholderNameOf index
  const rewritten = rewriteWith checker, frame, index, text
  "The parameter of this closure is `{placeholder}`; to name it, write `\{ {rewritten} => ... \}`"
}

/** The binding of one implicit parameter, made the first time it is used so that the unused ones cost nothing. */
fn parameterBindingOf(var checker: Checker, frame: Int, index: Int, text: String, at: Span): Target {
  const known = checker.closureFrames[frame].used[index]
  var identifier = BindingId known
  if known < 0 {
    const annotation = checker.closureFrames[frame].types[index]
    const span = checker.closureFrames[frame].at
    // The name stays out of the scope chain: an implicit parameter is reached through the frame and nowhere else
    identifier = checker.declareBinding LocalBinding("_", annotation, false, span)
    var used = checker.closureFrames[frame].used
    used.set index, identifier.value
    const updated = checker.closureFrames[frame].copy(used: used)
    checker.closureFrames.set frame, updated
  }
  const position = checker.closureFrames[frame].implicitFrom + index
  checker.adapted at, Adaptation.ImplicitParameter(position)
  noteCapture checker, identifier
  const annotation = checker.binding(identifier).annotation
  Target Resolution.Local(identifier), annotation, form: formOf(checker, annotation), name: text
}

// --- Messages -------------------------------------------------------------------------------------------------------

fn reportArity(var checker: Checker, given: Int, wanted: Int, at: Span) {
  const takes = if wanted == 1 { "1 parameter" } else { "{wanted} parameters" }
  const was = if given == 1 { "1 was written" } else { "{given} were written" }
  checker.reportHere Diagnostic.error("This closure takes {takes}, {was}", at)
}

fn reportParameterMismatch(var checker: Checker, given: TypeId, wanted: TypeId, at: Span) {
  const shown = checker.describe wanted
  const found = checker.describe given
  checker.reportHere Diagnostic.error("This parameter is a `{shown}`, not a `{found}`", at)
}

fn reportMissingParameterTypes(var checker: Checker, at: Span) {
  checker.reportHere(
    Diagnostic.error("The parameters of this closure need types: `\{ value: Int => ... \}`", at)
      .withNote("Nothing here says what the closure is called with, so the annotation is the answer")
  )
}
