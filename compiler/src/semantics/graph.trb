/**
 * Parses every file of every package into a [Graph], and resolves a `use "..."` path against it: [resolveImport]
 * turns a written path into an [Import], which is the module it names or the reason it names none.
 */

use normalizePath, parentPath, joinPath, isInside from "../project/path"
use SourceText from "../syntax/source"
use Parsed from "../syntax/parser/parser"
use SourceFile from "../syntax/ast"
use SourceTree from "../project/source-tree"
use Workspace, Package from "../project/workspace"
use defaultEntry, shortNameOf from "../project/programs"
use ModuleId, Module, ScriptReceiver from "./module"
use scriptLoadsOf, RuntimeScript from "./scripts"

/** Every module of every package, and the index that turns an import path into a module. */
public type Graph {
  modules: List<Module>
  private byPath: Map<String, Int>

  static fn of(modules: List<Module>): Self {
    var byPath: Map<String, Int> = [:]
    for module in modules {
      byPath.set module.path, module.id.value
    }
    Self modules, byPath
  }

  fn at(id: ModuleId): Module {
    modules[id.value]
  }

  fn moduleAt(path: String): ModuleId? {
    byPath.get(normalizePath(path)).map(ModuleId)
  }
}

/**
 * Parses every file of every package. This is the only place the syntax trees of a program come from. `scripts` are the
 * files a running program loads from paths only known while it runs, each with its receiver.
 */
public fn buildGraph(
  tree: SourceTree,
  workspace: Workspace,
  scripts: List<RuntimeScript> = [],
  reachedFrom: List<String>? = None,
): Graph {
  const reached = match reachedFrom {
    Some(roots) => Some reachedFilesOf(tree, workspace, roots, scripts)
    None => None
  }
  var modules: List<Module> = []
  for index in 0..workspace.packages.length() {
    const package = workspace.packages[index]
    for path in package.files {
      const kept = match reached {
        Some(found) => found.get path
        None => Some tree.parsedAt(path)
      }
      const (source, syntax) = match kept {
        Some(found) => found
        None => {
          continue
        }
      }
      const id = ModuleId modules.length()
      const entry = isEntryFile package, path
      const shown = tree.display path
      const deferred = syntax.deferred
      modules.append Module(id, index, path, source, syntax.file, syntax.diagnostics, entry, shown, deferred: deferred)
    }
  }
  addReceiverScripts tree, workspace, modules, reached.isNone()
  addRuntimeScripts tree, modules, scripts
  Graph.of modules
}

/**
 * The files of the **program** of `roots` - the packages `programPackagesOf` closes the world over, reached here before
 * a module exists - each parsed once: every file below a root, every file of the package of one (its `tests/` only
 * where a root is inside them), every file of a package that one of them imports, depends on or names as its prelude,
 * and a file a relative `use` names. What no import reaches is neither parsed nor checked: a program that prints one
 * line in a checkout parses the packages of `std` its prelude reaches and not the compiler next to it.
 */
fn reachedFilesOf(
  tree: SourceTree,
  workspace: Workspace,
  roots: List<String>,
  scripts: List<RuntimeScript>,
): Map<String, (SourceText, Parsed)> {
  var files: Map<String, (SourceText, Parsed)> = [:]
  var reachedPackages: Map<Int, Bool> = [:]
  var pending: List<String> = []
  var packages: List<Int> = []
  for index in 0..workspace.packages.length() {
    const package = workspace.packages[index]
    for path in package.files {
      if roots.any({ path == _ || isInside(path, _) }) {
        pending.append path
        packages.append index
      }
    }
  }
  // A script loaded while the program runs imports what it imports, and its receiver is a type of the program's
  for script in scripts {
    packages.append packageIndexOfPath(workspace, script.module)
    if tree.exists(script.path) {
      const (_, syntax) = tree.parsedAt script.path
      noteImports workspace, script.path, syntax.file, pending, packages
    }
  }
  var at = 0
  loop {
    // A package reached: every file of it that is no test, what it depends on, and its prelude
    while !packages.isEmpty() {
      const index = packages.removeAt(packages.length() - 1) ?? (0 - 1)
      if index < 0 || reachedPackages.containsKey(index) {
        continue
      }
      reachedPackages.set index, true
      const package = workspace.packages[index]
      const tests = joinPath package.directory, "tests"
      for path in package.files {
        if package.directory.isEmpty() || !isInside(path, tests) {
          pending.append path
        }
      }
      var names = package.manifest.runtimeDependencies
      names.appendAll package.manifest.developmentDependencies
      names.append package.manifest.prelude
      for name in names {
        packages.append packageIndexNamed(workspace, name)
      }
    }
    if at >= pending.length() {
      break
    }
    const path = pending[at]
    at = at + 1
    if files.containsKey(path) {
      continue
    }
    const parsed = tree.parsedAt path
    files.set path, parsed
    const (_, syntax) = parsed
    noteImports workspace, path, syntax.file, pending, packages
    // A script the file loads by a literal path is a module of the program, and what it imports is reached as well
    const directory = match workspace.packages.get(packageIndexOfPath(workspace, path)) {
      Some(package) => package.directory
      None => parentPath path
    }
    for load in scriptLoadsOf(syntax.file) {
      const script = joinPath directory, load.path
      if tree.exists(script) {
        const (_, loaded) = tree.parsedAt script
        var nothing: List<String> = []
        noteImports workspace, script, loaded.file, nothing, packages
      }
    }
  }
  files
}

/** What the `use` declarations of a file reach: a file next to it, or a package by its name. */
fn noteImports(
  workspace: Workspace,
  path: String,
  file: SourceFile,
  var pending: List<String>,
  var packages: List<Int>,
) {
  for statement in file.statements {
    if const .Declare(declaration) = statement.kind {
      if const .Use(usage) = declaration.kind {
        if const .Module(written) = usage.source {
          if written.startsWith("./") || written.startsWith("../") {
            pending.append "{joinPath(parentPath(path), written)}.trb"
          } else {
            const segments = written.split("/").toList()
            if segments.length() >= 2 {
              packages.append packageIndexNamed(workspace, "{segments[0]}/{segments[1]}")
            }
          }
        }
      }
    }
  }
}

/** The package whose directory holds the file, the innermost one; -1 for none. */
fn packageIndexOfPath(workspace: Workspace, path: String): Int {
  var found = 0 - 1
  var depth = 0 - 1
  for index in 0..workspace.packages.length() {
    const directory = workspace.packages[index].directory
    if !directory.isEmpty() && isInside(path, directory) && directory.byteLength() > depth {
      found = index
      depth = directory.byteLength()
    }
  }
  found
}

/**
 * The files a running program loads from paths only known while it runs (docs/design/SCRIPTS.md slice 7), after every
 * other module: each is a script of the package of the module that declares its receiver, and a file that is a module
 * already - a file of a package, or one a literal `Sandbox.load` named - gets the receiver it is loaded with now.
 */
fn addRuntimeScripts(tree: SourceTree, var modules: List<Module>, scripts: List<RuntimeScript>) {
  for script in scripts {
    if !tree.exists(script.path) {
      continue
    }
    var declaring: Module? = None
    for module in modules {
      if module.path == script.module {
        declaring = module
      }
    }
    const owner = match declaring {
      Some(found) => found
      None => {
        continue
      }
    }
    const receiver = ScriptReceiver.Declared owner.id, script.name
    var existing = false
    for position in 0..modules.length() {
      if modules[position].path == script.path {
        modules[position] = modules[position].copy(receiver: receiver)
        existing = true
      }
    }
    if !existing {
      addScript tree, modules, owner.package, script.path, receiver
    }
  }
}

/**
 * Whether a file may hold top-level code because of what it is (docs/design/PROJECT.md section 3): a script that
 * belongs to no project - nobody imports it - the default program `src/main.trb`, the `entry` of a `program` line,
 * and a test. The names of the files decide and the manifest adds only the entries it declares: `src/lib.trb` is the
 * library, and never an entry.
 */
fn isEntryFile(package: Package, path: String): Bool {
  package.name.isEmpty() || path.endsWith(".test.trb") || programOfEntry(package, path).isSome()
}

/**
 * The program whose entry the file is: `src/main.trb` of the package, named after it or after the `program` line
 * that renames it, or the `entry` of one of its `program` lines. `None` for every other file.
 */
public fn programOfEntry(package: Package, path: String): String? {
  if package.directory.isEmpty() {
    return None
  }
  if path == joinPath(package.directory, defaultEntry) {
    const renamed = package.manifest.programs.find({ _.renamesDefault() })
    return renamed.map({ _.name }) ?? shortNameOf(package.name, package.directory)
  }
  const line = package.manifest.programs.find({ !_.renamesDefault() && joinPath(package.directory, _.entry) == path })?
  line.name
}

/**
 * The receiver scripts of the workspace, after its ordinary modules: the `project.trb` of every project, and every
 * file a `Sandbox.load<Value>("./path")` names with a literal path. They are modules because everything the
 * checker keeps - a scope, the tables, the diagnostics - is per module; they are not importable, because their scope
 * is "the prelude, and nothing else" and nothing they declare belongs to the package.
 *
 * A `project.trb` is only one of them where the workspace has `std/project`: without the package that declares
 * `Project` there is no type to check it against, and reading it statically (`project/manifest.trb`) keeps working.
 */
fn addReceiverScripts(tree: SourceTree, workspace: Workspace, var modules: List<Module>, withManifests: Bool) {
  const ordinary = modules.length()
  var known: Set<String> = Set.of()
  for module in modules {
    known.insert module.path
  }
  if withManifests && workspace.packageNamed("std/project").isSome() {
    for index in 0..workspace.packages.length() {
      const path = joinPath workspace.packages[index].directory, "project.trb"
      if !tree.exists(path) || known.contains(path) {
        continue
      }
      known.insert path
      addScript tree, modules, index, path, ScriptReceiver.ProjectFile
    }
  }
  for index in 0..ordinary {
    const package = modules[index].package
    const directory = workspace.packages[package].directory
    const loads = scriptLoadsOf modules[index].file
    const from = modules[index].id
    for load in loads {
      const path = joinPath directory, load.path
      if !tree.exists(path) {
        continue
      }
      // A file a program loads is a script wherever it lies, also where a test directory swept it in as a module
      // (docs/design/SCRIPTS.md section 3) - but a `project.trb` stays the manifest, and the first load decides
      if known.contains(path) {
        for position in 0..ordinary {
          if modules[position].path == path && modules[position].receiver.isNone() {
            modules[position] = modules[position].copy(receiver: ScriptReceiver.Loaded(from, load.annotation))
          }
        }
        continue
      }
      known.insert path
      addScript tree, modules, package, path, ScriptReceiver.Loaded(from, load.annotation)
    }
  }
}

fn addScript(tree: SourceTree, var modules: List<Module>, package: Int, path: String, receiver: ScriptReceiver) {
  const (source, parsed) = tree.parsedAt path
  const id = ModuleId modules.length()
  const shown = tree.display path
  const deferred = parsed.deferred
  modules.append Module(id, package, path, source, parsed.file, parsed.diagnostics, true, shown, receiver, deferred)
}

/** What a `use "..."` path names, or why it names nothing. */
public type Import {
  case Found(module: ModuleId)
  /** A relative path with no file behind it */
  case NoModule(path: String)
  case NoPackage(name: String)
  /** The package is there, but the importing project does not depend on it */
  case NotADependency(name: String)
  case NoModuleInPackage(package: String, path: String)
  /**
   * A relative path that climbs out of the package of the importing file, or names a file of another package below it:
   * a package is imported by its name (docs/design/PROJECT.md section 6)
   */
  case OutsidePackage(path: String, package: String)
  /** The file is the entry of a program, and a program is not importable (docs/design/PROJECT.md section 3) */
  case Entry(path: String, program: String)
}

/**
 * A path that starts with `./` or `../` is a file next to the importing one. Everything else starts with the name of
 * a package: `"owner/name"` is its `src/lib.trb`, `"owner/name/path"` is `src/path.trb` of it.
 */
public fn resolveImport(graph: Graph, workspace: Workspace, from: ModuleId, path: String): Import {
  const module = graph.at(from)
  const importer = workspace.packages[module.package]
  if path.startsWith("./") || path.startsWith("../") {
    const target = "{joinPath(parentPath(module.path), path)}.trb"
    // A script that belongs to no project has no package to stay inside
    const isPackaged = !importer.name.isEmpty() && !importer.directory.isEmpty()
    if isPackaged && !isInside(target, importer.directory) {
      return Import.OutsidePackage path, importer.name
    }
    // A receiver script is not a module anybody imports: it is a body, checked against a receiver type
    if const Some(id) = graph.moduleAt(target) {
      const found = graph.at id
      if found.receiver.isNone() {
        const owner = workspace.packages[found.package]
        if isPackaged && found.package != module.package && !owner.name.isEmpty() {
          return Import.OutsidePackage path, importer.name
        }
        if const Some(program) = programOfEntry(owner, target) {
          return Import.Entry path, program
        }
        return Import.Found id
      }
    }
    return Import.NoModule path
  }
  const segments = path.split "/"
  if segments.length() < 2 {
    return Import.NoPackage path
  }
  const name = "{segments[0]}/{segments[1]}"
  const package = match workspace.packageNamed(name) {
    Some(found) => found
    None => {
      return Import.NoPackage name
    }
  }
  if !isAvailable(workspace.packages[module.package], name) {
    return Import.NotADependency name
  }
  const inside = if segments.length() == 2 {
    "src/lib.trb"
  } else {
    "src/{segments.skip(2).joined(separator: "/")}.trb"
  }
  const target = joinPath package.directory, inside
  if const Some(program) = programOfEntry(package, target) {
    return Import.Entry path, program
  }
  // `"owner/name/main"` names a program whether or not the file is there (docs/design/PROJECT.md section 3)
  if segments.length() > 2 && segments.last() == "main" {
    return Import.Entry path, shortNameOf(package.name, package.directory)
  }
  if const Some(id) = graph.moduleAt(target) {
    return Import.Found id
  }
  Import.NoModuleInPackage name, path
}

/**
 * Packages of the owner `std` come with the toolchain and have its version, so they need no entry in `dependencies`
 * (CONCEPT.md, "Modules and Packages"). Everything else a project imports it has to have asked for.
 */
fn isAvailable(importer: Package, name: String): Bool {
  name == importer.name || name.startsWith("std/") || importer.manifest.dependsOn(name)
}

/**
 * The packages whose declarations are part of the **program**: the packages of the roots, everything they depend on
 * (transitively, runtime and development alike), the prelude each of them names, and every package one of their
 * modules imports. The imports are what a program really reaches - a standalone file has no manifest, and a package of
 * `std` names none of the packages it imports - so a manifest alone would leave an override in an imported package
 * out of the closed world, and a trait-typed value would run the default where that override should have run.
 *
 * **A package next to yours in a workspace must not change your binary.** Two questions of the back end are
 * *closed-world* - "does any implementation override this default" (`overridesAnyMember`, which decides the member list of
 * every witness table) and, through it, how many instances the worklist reaches - and a closed world has to be the
 * **program**. It was the whole `SourceTree` instead, and `readSourceTree` always reads the entire workspace: adding
 * `examples/encoding-lab`, which overrides defaults of `Iterate` for types of its own, took the instance count of
 * `source.trb`'s program from 121 declarations to 192 without a line of the program changing.
 *
 * The unit is the **package** and not the module, because that is the unit of coherence
 * (docs/language/traits/coherence.md) and of what a project declares it depends on: an implementation is visible to
 * a program exactly where its package is.
 */
public fn programPackagesOf(graph: Graph, workspace: Workspace, modules: List<ModuleId>): Map<Int, Bool> {
  var found: Map<Int, Bool> = [:]
  var pending: List<Int> = []
  const modulesByPackage = modulesOfPackages graph
  for module in modules {
    const index = graph.at(module).package
    if !found.containsKey(index) {
      found.set index, true
      pending.append index
    }
  }
  var at = 0
  while at < pending.length() {
    const index = pending[at]
    at = at + 1
    if index < 0 || index >= workspace.packages.length() {
      continue
    }
    const manifest = workspace.packages[index].manifest
    var others: List<Int> = []
    var names = manifest.runtimeDependencies
    names.appendAll manifest.developmentDependencies
    names.append manifest.prelude
    for name in names {
      others.append packageIndexNamed(workspace, name)
    }
    for module in modulesByPackage.get(index) ?? [] {
      others.appendAll importedPackagesOf(graph, workspace, module)
    }
    for other in others {
      if other < 0 || found.containsKey(other) {
        continue
      }
      found.set other, true
      pending.append other
    }
  }
  found
}

/** Every module of the graph by the index of its package: what `programPackagesOf` follows the imports of. */
fn modulesOfPackages(graph: Graph): Map<Int, List<ModuleId>> {
  var found: Map<Int, List<ModuleId>> = [:]
  for module in graph.modules {
    var inside = found.get(module.package) ?? []
    inside.append module.id
    found.set module.package, inside
  }
  found
}

/** The packages the `use` declarations of one module reach. */
fn importedPackagesOf(graph: Graph, workspace: Workspace, module: ModuleId): List<Int> {
  var found: List<Int> = []
  for statement in graph.at(module).file.statements {
    if const .Declare(declaration) = statement.kind {
      if const .Use(usage) = declaration.kind {
        if const .Module(path) = usage.source {
          if const .Found(target) = resolveImport(graph, workspace, module, path) {
            found.append graph.at(target).package
          }
        }
      }
    }
  }
  found
}

fn packageIndexNamed(workspace: Workspace, name: String): Int {
  if name.isEmpty() {
    return 0 - 1
  }
  for index in 0..workspace.packages.length() {
    if workspace.packages[index].name == name {
      return index
    }
  }
  0 - 1
}
