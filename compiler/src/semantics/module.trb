use SourceText from "../syntax/source"
use SourceFile, TypeReference from "../syntax/ast"
use Diagnostic from "../syntax/diagnostic"

/**
 * Values have no identity in TorbScript: two modules with the same content are the same value. So everything the
 * front end needs to talk *about* lives in a list and is referred to by its index. A wrapper instead of a bare `Int`
 * because a `ModuleId` and a `SymbolId` are never the same thing, and no signature should let them be confused.
 */
public type ModuleId {
  value: Int
}

/**
 * Which receiver a file is a script for. A receiver script is checked as the body of `(var self: Receiver) => Void`
 * with the file scope "the prelude, and nothing else" (gap 34), so it is code without being a module anybody imports.
 */
public type ScriptReceiver {
  /** `project.trb`: the receiver is the `Project` of `std/project`. */
  case ProjectFile
  /** `Sandbox.load<Value>("./config.trb")`: the type argument, in a type position of the module that loads it. */
  case Loaded(from: ModuleId, annotation: TypeReference)
}

/** One `.trb` file of one package, parsed. */
public type Module {
  id: ModuleId
  /** The index of the package in `Workspace.packages` */
  package: Int
  /** Normalized path, the key of the file in the `SourceTree` */
  path: String
  source: SourceText
  file: SourceFile
  /** What the parser found. A file with syntax errors still contributes its symbols. */
  diagnostics: List<Diagnostic>
  /**
   * An entry file may contain top-level code: the build input of its package and every test. Imported modules
   * consist of declarations only, which is why cyclic imports are unproblematic.
   */
  isEntry: Bool
  /** Set for a receiver script: `project.trb` and every file a `Sandbox.load` names with a literal path. */
  receiver: ScriptReceiver? = None
}
