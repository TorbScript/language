/**
 * Evaluate and watch (docs/design/DEBUGGER.md section 12): the expressions a debugger answers over a stopped frame - a
 * name, and fields, tuple fields, items and entries below it: `point`, `point.x`, `pair.0`, `names[2]`,
 * `ages["Ada"]`, `shapes[0].radius`.
 *
 * The answer is read the way `variables` reads a value, so an expression can neither change the program nor run any of
 * its code. Anything else is refused with a message that says what is answered.
 */

use Inspector, Value, childrenOf, childCountOf, quoted from "./values"

/** One step below a name. */
public type WatchStep {
  /** `.field`, and `.0` of a tuple. */
  case Field(name: String)
  /** `[3]`: an item of a list, a set or an array, or the entry of a map whose key is the number. */
  case Index(index: Int)
  /** `["key"]`: the entry of a map whose key is the text. */
  case Key(text: String)
}

/** An expression taken apart: the name it starts with and the steps below it. */
public type Watch {
  name: String
  steps: List<WatchStep>
}

/** What an expression may be, for the message of one that is not. */
const whatIsAnswered = "an expression of the debugger is a name with fields and items below it: `point.x`, `names[2]`"

/** An expression taken apart, or why it is none the debugger answers. */
public fn parseWatch(expression: String): Result<Watch, String> {
  const characters = expression.trim().chars().toList()
  var at = 0
  const name = nameAt characters, at
  if name.isEmpty() {
    return Fail whatIsAnswered
  }
  at = at + name.byteLength()
  var steps: List<WatchStep> = []
  while at < characters.length() {
    const character = characters[at]
    if character == '.' {
      const field = nameAt(characters, at + 1)
      if field.isEmpty() {
        return Fail whatIsAnswered
      }
      steps.append WatchStep.Field(field)
      at = at + 1 + field.byteLength()
    } else if character == '[' {
      var end = at + 1
      while end < characters.length() && characters[end] != ']' {
        end = end + 1
      }
      if end >= characters.length() {
        return Fail whatIsAnswered
      }
      const inside = String.from(characters[at + 1..end]).trim()
      if inside.startsWith("\"") && inside.endsWith("\"") && inside.byteLength() >= 2 {
        steps.append WatchStep.Key(inside.dropping(1).droppingLast(1))
      } else {
        match Int.tryFrom(inside) {
          Ok(index) => steps.append WatchStep.Index(index)
          Fail(_) => {
            return Fail whatIsAnswered
          }
        }
      }
      at = end + 1
    } else if character == ' ' {
      at = at + 1
    } else {
      return Fail whatIsAnswered
    }
  }
  Ok Watch(name, steps)
}

/** The name, or the digits of a tuple field, that begins at `at`: ASCII letters, digits and `_`. */
fn nameAt(characters: List<Char>, at: Int): String {
  var end = at
  while end < characters.length() {
    const character = characters[end]
    const isPart = (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')
      || (character >= '0' && character <= '9') || character == '_'
    if !isPart {
      break
    }
    end = end + 1
  }
  if end <= at {
    return ""
  }
  String.from characters[at..end]
}

/** The value an expression names in a frame whose locals are `locals`, or why there is none. */
public fn evaluateWatch(inspector: Inspector, locals: List<(String, Value)>, watch: Watch): Result<Value, String> {
  var current = match locals.find({ _.0 == watch.name }) {
    Some((_, found)) => found
    None => {
      return Fail "There is no `{watch.name}` in this frame"
    }
  }
  var written = watch.name
  for step in watch.steps {
    const (label, shown) = match step {
      .Field(name) => (name, "{written}.{name}")
      .Index(index) => ("[{index}]", "{written}[{index}]")
      .Key(text) => (quoted(text), "{written}[{quoted(text)}]")
    }
    current = match childNamed(inspector, current, label, step) {
      Some(found) => found
      None => {
        return Fail "There is no `{shown}`"
      }
    }
    written = shown
  }
  Ok current
}

/** The child a step names: by its label, and an item of a list by its position without reading the others. */
fn childNamed(inspector: Inspector, value: Value, label: String, step: WatchStep): Value? {
  if const .Index(index) = step {
    if index < 0 {
      return None
    }
    const items = childrenOf inspector, value, index, 1
    if const Some((found, child)) = items.first() {
      if found == label {
        return child
      }
    }
    // A map is answered by the line of its key, which for a number is the number
    return childLabeled inspector, value, "{index}"
  }
  childLabeled inspector, value, label
}

fn childLabeled(inspector: Inspector, value: Value, label: String): Value? {
  const count = childCountOf inspector, value
  for (found, child) in childrenOf(inspector, value, 0, count) {
    if found == label {
      return child
    }
  }
  None
}
