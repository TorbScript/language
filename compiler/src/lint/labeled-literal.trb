/**
 * The rule `labeled-literal`: `true`, `false` or `None` passed to a parameter that is *declared* as `Bool` or as an
 * optional carries the parameter's label (`hasCapacity: false`, not a bare `false`), because a literal has no name of
 * its own that could say what it means (compiler/CONTRIBUTING.md, "A literal that sets an option is labeled").
 *
 * The two exceptions of the rule are kept: a call with a single argument (`setEnabled(true)`), and a literal that is the
 * data rather than an option, which is the case exactly when the declared type is a type parameter (`Some(true)`,
 * `list.append(None)`) - such a parameter is neither `Bool` nor an optional, so it is never found.
 *
 * This is the one rule that needs the checker: which declaration a call reaches, and which parameter an argument
 * fills, are the checker's tables. The fix writes the label in front of the literal - and, because labeled arguments
 * follow the positional ones, in front of every positional argument behind it but the closure that trails the call,
 * each with the name of the parameter the checker matched it to: `list(3, false, name)` becomes
 * `list(3, hasCapacity: false, name: name)`. That keeps which argument fills which parameter and the order they are
 * evaluated in, so it is certain wherever the checker matched every one of them. A spread, a variadic parameter or an
 * argument the checker did not match leaves the finding without a fix. Declaring the option last, with a default, is
 * the other way out and a person's choice: `newFunction(name, signature, label, origin: SymbolId? = None)` is called
 * without its option where it is `None`.
 */

use Span from "../syntax/source"
use SourceFile, Expression, ExpressionKind, Argument from "../syntax/ast"
use Checker, Resolution from "../semantics/checker/context"
use TypeId, TypeForm, TypeSignature, SignatureState, ParameterMode from "../semantics/checker/type"
use ModuleId from "../semantics/module"
use trailingClosureAt from "../semantics/checker/call"
use Finding, LintRule, TextEdit from "./finding"
use everyNodeOf from "./nodes"

/** One parameter a call can fill: the label it has, the type it is declared with, and whether it collects the rest. */
type Target {
  name: String
  type: TypeId
  variadic: Bool = false
}

public fn labeledLiteralFindings(checker: Checker, module: ModuleId, file: SourceFile): List<Finding> {
  var findings: List<Finding> = []
  for expression in everyNodeOf(file).expressions {
    match expression.kind {
      .Call(callee, arguments, _) => findingsOfCall findings, checker, module, expression, callee, arguments
      _ => {}
    }
  }
  findings.sort({ _.span.start })
  findings
}

fn findingsOfCall(
  var findings: List<Finding>,
  checker: Checker,
  module: ModuleId,
  call: Expression,
  callee: Expression,
  arguments: List<Argument>,
) {
  if arguments.length() < 2 {
    return
  }
  const targets = match checker.argumentTargetsAt(module, call.span) {
    Some(found) => found
    None => {
      return
    }
  }
  const parameters = match parametersOf(checker, module, call, callee) {
    Some(found) => found
    None => {
      return
    }
  }
  var literals: List<Finding> = []
  var first = -1
  for (index, argument) in arguments.indexed() {
    if argument.label.isSome() || argument.spread {
      continue
    }
    const literal = match literalText(argument.value) {
      Some(text) => text
      None => {
        continue
      }
    }
    const target = targets.get(index) ?? -1
    if target < 0 {
      continue
    }
    const parameter = match parameters.get(target) {
      Some(found) => found
      None => {
        continue
      }
    }
    if !isBool(checker, parameter.type) && !isOptional(checker, parameter.type) {
      continue
    }
    if first < 0 {
      first = index
    }
    const message = "`{literal}` sets the option `{parameter.name}`, and a literal does not say so: write `{parameter.name}: {literal}`"
    literals.append Finding(LintRule.LabeledLiteral, message, argument.value.span)
  }
  if literals.isEmpty() {
    return
  }
  // One fix for the whole call, which every finding of it carries: `--fix` takes the first and leaves the others,
  // which overlap it
  const fix = labelsFrom(arguments, first, targets, parameters, call.span) ?? []
  for finding in literals {
    findings.append finding.copy(fix: fix)
  }
}

/**
 * The labels from the argument at `first` to the end of the call: every positional argument gets the name of the
 * parameter the checker matched it to, except the closure that trails the call, which fills its parameter wherever it
 * is written. `None` where one of them cannot be labeled - a spread, an argument the checker did not match, a variadic
 * parameter, which a label does not fill.
 */
fn labelsFrom(
  arguments: List<Argument>,
  first: Int,
  targets: List<Int>,
  parameters: List<Target>,
  at: Span,
): List<TextEdit>? {
  const trailing = trailingClosureAt arguments, at
  var edits: List<TextEdit> = []
  var index = first
  while index < arguments.length() {
    const argument = arguments[index]
    if argument.label.isNone() && index != trailing {
      if argument.spread {
        return None
      }
      const target = targets.get(index) ?? -1
      if target < 0 {
        return None
      }
      const parameter = parameters.get(target)?
      if parameter.variadic || parameter.name.isEmpty() {
        return None
      }
      edits.append TextEdit(argument.value.span.start, argument.value.span.start, "{parameter.name}: ")
    }
    index = index + 1
  }
  edits
}

/** `true`, `false` and `None` as written: the literals that have no name of their own. */
fn literalText(value: Expression): String? {
  match value.kind {
    .BoolLiteral(flag) => if flag { "true" } else { "false" }
    .Name(text) if text == "None" => text
    _ => None
  }
}

/**
 * The parameters a call fills, in the order `argumentTargets` counts them: those of a function or a method, the fields
 * of a type for its constructor, the fields of a case. `None` for anything else - and for a method called through its
 * type with the receiver as the first argument (`Point.area(p)`), where the count is not the one of the parameters.
 */
fn parametersOf(checker: Checker, module: ModuleId, call: Expression, callee: Expression): List<Target>? {
  const resolution = match checker.resolutionAt(module, call.span) {
    Some(.Deferred) | None => checker.resolutionAt(module, callee.span)?
    Some(found) => found
  }
  match resolution {
    .Callable(symbol, _, _) => {
      const index = match checker.signatureStates.get(symbol) {
        Some(.Ready(found)) => found
        _ => {
          return None
        }
      }
      const signature = checker.signatures[index]
      if signature.takesSelf && isReachedThroughItsType(checker, module, callee) {
        return None
      }
      var targets: List<Target> = []
      for parameter in signature.form.parameters {
        const variadic = match parameter.mode {
          .Variadic => true
          _ => false
        }
        targets.append Target(parameter.name?, parameter.type, variadic: variadic)
      }
      targets
    }
    .Construct(owner) => {
      const shape = typeSignatureOf(checker, owner)?
      var targets: List<Target> = []
      for field in shape.fields {
        targets.append Target(field.name, field.type)
      }
      targets
    }
    .CaseOf(owner, variant) => {
      const shape = typeSignatureOf(checker, owner)?
      const found = shape.cases.find({ _.symbol == variant })?
      var targets: List<Target> = []
      for field in found.fields {
        targets.append Target(field.name, field.type)
      }
      targets
    }
    _ => None
  }
}

/** `Point.area(p)`: a member read through a type rather than through a value. */
fn isReachedThroughItsType(checker: Checker, module: ModuleId, callee: Expression): Bool {
  match callee.kind {
    .Member(target, _, _) => {
      match checker.resolutionAt(module, target.span) {
        Some(.TypeOf(_)) => true
        _ => false
      }
    }
    _ => false
  }
}

fn typeSignatureOf(checker: Checker, owner: TypeId): TypeSignature? {
  const symbol = match checker.types.form(owner) {
    .Nominal(found, _) => found
    _ => {
      return None
    }
  }
  match checker.typeSignatureStates.get(symbol) {
    Some(.Ready(index)) => checker.typeSignatures[index]
    _ => None
  }
}

fn isBool(checker: Checker, annotation: TypeId): Bool {
  match checker.types.form(annotation) {
    .Nominal(symbol, arguments) => arguments.isEmpty() && checker.wellKnown.boolean == symbol
    _ => false
  }
}

fn isOptional(checker: Checker, annotation: TypeId): Bool {
  match checker.types.form(annotation) {
    .Nominal(symbol, _) => checker.wellKnown.option == symbol
    _ => false
  }
}
