/**
 * [SourceTree]: every file the front end may look at, with its text, read once and passed around as a value from
 * there on.
 */

use File from "std/fs"
use normalizePath, isInside, relativePath from "./path"
use SourceText from "../syntax/source"
use Parsed, parse from "../syntax/parser/parser"

/**
 * Every file the front end may look at, with its text. Reading happens once, in `read.trb`; from here on the whole
 * front end is a function of this value. That is what makes the tests of the module graph projects in memory instead
 * of fixtures on disk, and it is what a language server needs anyway (it has newer text than the disk).
 */
public type SourceTree {
  /** Normalized path to the text of the file */
  private files: Map<String, String>
  /** The paths of `files`, sorted. A directory is "there is a file below it", so there is nothing else to store. */
  private sortedPaths: List<String>
  /** Paths are shown relative to this directory: the way they were typed on the command line. */
  private base: String
  /** The toolchain's `std` directory, whose files are part of the tree, or empty. See [SourceTree.standardLibrary]. */
  private standardLibraryValue: String
  /**
   * Files parsed once, by normalized path: a tree that is checked again and again with one file changing - a session of
   * `torb repl` - parses everything else once ([SourceTree.parsedEverything]). Empty otherwise.
   */
  private parsedFiles: Map<String, (SourceText, Parsed)> = [:]
  /**
   * The files of a tree read from disk that were listed and not read yet ([SourceTree.onDisk]): each is read the first
   * time something asks for its text, so a program that reaches a few packages of a large workspace reads those.
   */
  private disk: DiskFiles? = None
  /**
   * Every other file below what was read, by normalized path and sorted, without its text: what a resource literal is
   * resolved against (docs/design/RESOURCES.md section 6). A tree built in memory lists its resources in `files`.
   */
  private otherPaths: List<String> = []
  /**
   * The package manager's cache, where a package of a lock is unpacked (`<cache>/packages/<hash>`), or empty. See
   * [SourceTree.cache].
   */
  private cacheValue: String = ""

  static fn of(files: Map<String, String>, base: String = ".", standardLibrary: String = "", cache: String = ""): Self {
    var normalized: Map<String, String> = [:]
    for (path, text) in files {
      normalized.set normalizePath(path), text
    }
    var paths = normalized.keys().toList()
    paths.sort({ _ })
    const library = if standardLibrary.isEmpty() { "" } else { normalizePath standardLibrary }
    const cached = if cache.isEmpty() { "" } else { normalizePath cache }
    Self normalized, paths, normalizePath(base), library, cacheValue: cached
  }

  /**
   * A tree of the files `read` already holds and the files `listed` names, which are read from disk the first time
   * their text is asked for. A file that cannot be read then reads as empty.
   */
  static fn onDisk(
    read: Map<String, String>,
    listed: List<String>,
    base: String,
    standardLibrary: String,
    others: List<String> = [],
    cache: String = "",
  ): Self {
    const tree = Self.of read, base, standardLibrary, cache
    var paths = tree.sortedPaths
    var names: Set<String> = Set.of()
    for path in listed {
      const normalized = normalizePath path
      if !tree.files.containsKey(normalized) && !names.contains(normalized) {
        names.insert normalized
        paths.append normalized
      }
    }
    paths.sort({ _ })
    var otherPaths = others.map(normalizePath).toList()
    otherPaths.sort({ _ })
    Self tree.files, paths, tree.base, tree.standardLibraryValue, [:], DiskFiles(names), otherPaths, tree.cacheValue
  }

  /**
   * Every file of the tree, its sources and the files that are no source, sorted by path: the listing a resource
   * literal is resolved against, byte for byte.
   */
  fn listedPaths(): List<String> {
    var all = sortedPaths.appendedAll otherPaths
    all.sort({ _ })
    all
  }

  /**
   * The `std` directory of the toolchain, for a workspace that has no standard library of its own: a standalone file,
   * or a project nobody lists as a member. Its packages join such a workspace (`findWorkspace`). Empty for a tree
   * built in memory, which brings its own prelude or none.
   */
  fn standardLibrary(): String {
    standardLibraryValue
  }

  /**
   * The package manager's cache: a package a `project.lock.trb` pins is a package of the workspace where it is unpacked
   * below it (`findWorkspace`). Empty for a tree built in memory, whose tests name the cache they unpack into.
   */
  fn cache(): String {
    cacheValue
  }

  /** `None` if the file is not part of the tree. */
  fn text(path: String): String? {
    const normalized = normalizePath path
    if const Some(found) = files.get(normalized) {
      return found
    }
    disk?.read(normalized)
  }

  fn exists(path: String): Bool {
    const normalized = normalizePath path
    files.containsKey(normalized) || (disk?.lists(normalized) ?? false)
  }

  /**
   * Every file whose text the tree holds: the ones it was made with, and the ones read from disk since - which are the
   * files a check of it read, what a native binary that loads scripts carries (`cli/host.trb`).
   */
  fn readTexts(): Map<String, String> {
    var found = files
    if const Some(read) = disk {
      for (path, text) in read.texts {
        found.set path, text
      }
    }
    found
  }

  /** Every file of the tree, sorted by path. */
  fn paths(): List<String> {
    sortedPaths
  }

  /** Every file below the directory, sorted by path. */
  fn below(directory: String): List<String> {
    const normalized = normalizePath directory
    sortedPaths.filter({ isInside _, normalized }).toList()
  }

  /** How a path is written in a message. */
  fn display(path: String): String {
    relativePath base, path
  }

  /** The same tree with one file added, or its text replaced; a parse the tree kept of it is forgotten. */
  fn withFile(path: String, text: String): Self {
    const normalized = normalizePath path
    var texts = files
    var paths = sortedPaths
    if !texts.containsKey(normalized) && !(disk?.lists(normalized) ?? false) {
      paths.append normalized
      paths.sort({ _ })
    }
    texts.set normalized, text
    var parsed = parsedFiles
    const _ = parsed.remove normalized
    Self texts, paths, base, standardLibraryValue, parsed, disk, otherPaths, cacheValue
  }

  /** The same tree with every file parsed once, which [SourceTree.parsedAt] then answers without parsing again. */
  fn parsedEverything(): Self {
    var parsed = parsedFiles
    for path in sortedPaths {
      if !parsed.containsKey(path) {
        const source = SourceText.of(text(path) ?? "")
        parsed.set path, (source, parse(source))
      }
    }
    Self files, sortedPaths, base, standardLibraryValue, parsed, disk, otherPaths, cacheValue
  }

  /**
   * The same tree with these parses kept, each for the file at its path: what a language server parsed once and reads
   * again for as long as the file does not change. A parse of a file whose text is replaced later is forgotten there.
   */
  fn withParsed(parsed: Map<String, (SourceText, Parsed)>): SourceTree {
    var kept = parsedFiles
    for (path, found) in parsed {
      kept.set normalizePath(path), found
    }
    Self files, sortedPaths, base, standardLibraryValue, kept, disk, otherPaths, cacheValue
  }

  /** The text of a file as the parser reads it, and what the parser made of it: kept, or parsed now. */
  fn parsedAt(path: String): (SourceText, Parsed) {
    const normalized = normalizePath path
    if const Some(found) = parsedFiles.get(normalized) {
      return found
    }
    const source = SourceText.of(text(normalized) ?? "")
    (source, parse(source))
  }
}

/** The files of a tree that are read the first time they are asked for, and what was read of them since. */
shared type DiskFiles {
  listed: Set<String>
  var texts: Map<String, String> = [:]

  fn lists(path: String): Bool {
    listed.contains path
  }

  /** The text of a listed file, read once; `None` for a file that is not listed. */
  fn read(path: String): String? {
    if !listed.contains(path) {
      return None
    }
    if const Some(found) = texts.get(path) {
      return found
    }
    const text = File.readText(path).ok() ?? ""
    texts.set path, text
    text
  }
}
