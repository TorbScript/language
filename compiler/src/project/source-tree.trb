/**
 * [SourceTree]: every file the front end may look at, with its text, read once and passed around as a value from
 * there on.
 */

use normalizePath, isInside, relativePath from "./path"
use SourceText from "../syntax/source"
use Parsed, parse from "../syntax/parser/parser"

/**
 * Every file the front end may look at, with its text. Reading happens once, in `read.trb`; from here on the whole
 * front end is a function of this value. That is what makes the tests of the module graph projects in memory instead
 * of fixtures on disk, and it is what a language server needs anyway (it has newer text than the disk).
 */
public type SourceTree {
  /** Normalized path to the text of the file */
  private files: Map<String, String>
  /** The paths of `files`, sorted. A directory is "there is a file below it", so there is nothing else to store. */
  private sortedPaths: List<String>
  /** Paths are shown relative to this directory: the way they were typed on the command line. */
  private base: String
  /** The toolchain's `std` directory, whose files are part of the tree, or empty. See [SourceTree.standardLibrary]. */
  private standardLibraryValue: String
  /**
   * Files parsed once, by normalized path: a tree that is checked again and again with one file changing - a session of
   * `torb repl` - parses everything else once ([SourceTree.parsedEverything]). Empty otherwise.
   */
  private parsedFiles: Map<String, (SourceText, Parsed)> = [:]

  static fn of(files: Map<String, String>, base: String = ".", standardLibrary: String = ""): SourceTree {
    var normalized: Map<String, String> = [:]
    for (path, text) in files {
      normalized.set normalizePath(path), text
    }
    var paths = normalized.keys().toList()
    paths.sort({ _ })
    const library = if standardLibrary.isEmpty() { "" } else { normalizePath standardLibrary }
    Self normalized, paths, normalizePath(base), library
  }

  /**
   * The `std` directory of the toolchain, for a workspace that has no standard library of its own: a standalone file,
   * or a project nobody lists as a member. Its packages join such a workspace (`findWorkspace`). Empty for a tree
   * built in memory, which brings its own prelude or none.
   */
  fn standardLibrary(): String {
    standardLibraryValue
  }

  /** `None` if the file is not part of the tree. */
  fn text(path: String): String? {
    files.get normalizePath(path)
  }

  fn exists(path: String): Bool {
    files.containsKey normalizePath(path)
  }

  /** Every file of the tree, sorted by path. */
  fn paths(): List<String> {
    sortedPaths
  }

  /** Every file below the directory, sorted by path. */
  fn below(directory: String): List<String> {
    const normalized = normalizePath directory
    sortedPaths.filter({ isInside _, normalized }).toList()
  }

  /** How a path is written in a message. */
  fn display(path: String): String {
    relativePath base, path
  }

  /** The same tree with one file added, or its text replaced; a parse the tree kept of it is forgotten. */
  fn withFile(path: String, text: String): SourceTree {
    const normalized = normalizePath path
    var texts = files
    var paths = sortedPaths
    if !texts.containsKey(normalized) {
      paths.append normalized
      paths.sort({ _ })
    }
    texts.set normalized, text
    var parsed = parsedFiles
    const _ = parsed.remove normalized
    Self texts, paths, base, standardLibraryValue, parsed
  }

  /** The same tree with every file parsed once, which [SourceTree.parsedAt] then answers without parsing again. */
  fn parsedEverything(): SourceTree {
    var parsed = parsedFiles
    for (path, text) in files {
      if !parsed.containsKey(path) {
        const source = SourceText.of text
        parsed.set path, (source, parse(source))
      }
    }
    Self files, sortedPaths, base, standardLibraryValue, parsed
  }

  /** The text of a file as the parser reads it, and what the parser made of it: kept, or parsed now. */
  fn parsedAt(path: String): (SourceText, Parsed) {
    const normalized = normalizePath path
    if const Some(found) = parsedFiles.get(normalized) {
      return found
    }
    const source = SourceText.of(files.get(normalized) ?? "")
    (source, parse(source))
  }
}
