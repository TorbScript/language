/**
 * [findStandardLibrary] and [findRuntime]: where the toolchain's own `std/` and `runtime/` are, for a program that does
 * not bring them along - a standalone file, or a project that is no member of a workspace with the standard library.
 * [findCompilerSources] finds its `compiler/` the same way, which `torb build --embed-vm` builds the VM of a binary from.
 *
 * All three ask the same question in the same order. The environment variable (`TORB_STD`, `TORB_RUNTIME`,
 * `TORB_COMPILER`) is taken as it is; otherwise the walk goes up from every path of the command line, then from the working directory, then from the
 * `torb` that runs, and the first directory that has the marker file answers. A checkout finds its own `std/` and
 * `runtime/` this way, whichever of its files is named, and `<checkout>/build/release/torb` finds them from anywhere.
 */

use File from "std/fs"
use Environment from "std/os"
use Process from "std/process"
use normalizePath, parentPath, joinPath, pathDepth from "./path"

/**
 * The toolchain's `std` directory: `$TORB_STD`, or the `std` of the nearest directory above a path of the command line
 * (then above the working directory and above `torb` itself) that has `std/prelude/project.trb`.
 */
public fn findStandardLibrary(paths: List<String>): String? {
  findToolchainPart "TORB_STD", "std", "prelude/project.trb", paths
}

/**
 * The C runtime a binary links against: `$TORB_RUNTIME`, or the `runtime` of the nearest directory above a path of the
 * command line (then above the working directory and above `torb` itself) that has `runtime/include/torb.h`.
 */
public fn findRuntime(paths: List<String>): String? {
  findToolchainPart "TORB_RUNTIME", "runtime", "include/torb.h", paths
}

/**
 * The toolchain's own sources, which `torb build --embed-vm` builds the VM of a native binary from: `$TORB_COMPILER`,
 * or the `compiler` of the nearest directory above a path of the command line (then above the working directory and
 * above `torb` itself) that has `compiler/src/vm/embed.trb`.
 */
public fn findCompilerSources(paths: List<String>): String? {
  findToolchainPart "TORB_COMPILER", "compiler", "src/vm/embed.trb", paths
}

/**
 * What a gcc or clang command line needs for the worker pool of the runtime: `-pthread` everywhere but Windows, where
 * the threads are the Win32 API that every C compiler links anyway. Windows is told by `OS`, which every Windows NT sets.
 */
public fn threadArguments(): List<String> {
  if Environment.get("OS") == "Windows_NT" {
    return []
  }
  ["-pthread"]
}

fn findToolchainPart(variable: String, name: String, marker: String, paths: List<String>): String? {
  if const Some(given) = Environment.get(variable) {
    if !given.isEmpty() {
      return absoluteOf given
    }
  }
  var starts: List<String> = []
  for path in paths {
    starts.append absoluteOf(path)
  }
  starts.append absoluteOf(".")
  if const Some(executable) = Process.executablePath() {
    starts.append parentPath(normalizePath(executable))
  }
  for start in starts {
    if const Some(found) = searchAbove(start, name, marker) {
      return found
    }
  }
  None
}

fn absoluteOf(path: String): String {
  match File.absolutePath(path) {
    Ok(found) => normalizePath found
    Fail(_) => normalizePath path
  }
}

/** The first directory at or above `start` that has `<name>/<marker>`, answered as `<directory>/<name>`. */
fn searchAbove(start: String, name: String, marker: String): String? {
  var current = start
  while pathDepth(current) >= 1 {
    const candidate = joinPath current, name
    if File.exists(joinPath(candidate, marker)) {
      return candidate
    }
    const parent = parentPath current
    if parent == current {
      return None
    }
    current = parent
  }
  None
}
