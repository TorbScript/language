/**
 * `project.trb`: [Manifest], what it declares about a project, and [readManifest], which reads one from its syntax
 * tree without evaluating it. [Setting] is the literal shape a `command argument..., { block }` line reduces to on
 * the way there.
 */

use SourceFile, Statement, Expression, TextSegment from "../syntax/ast"
use Span from "../syntax/source"

/** `registry "acme", url: "https://packages.acme.test"`: where the packages of one owner come from. */
public type RegistryBinding {
  owner: String
  url: String
}

/**
 * `source "acme/y", path: "../y"`: where one package comes from instead of its owner's registry
 * (docs/design/PROJECT.md section 7).
 */
public type SourceBinding {
  package: String
  /** `path`, `git` or `archive`: the label the location was written with. */
  kind: String
  location: String
  /** The `revision:` of a `git:` source, the `hash:` of an `archive:` source; empty for a `path:` source. */
  pin: String = ""
}

/**
 * `program "migrate", entry: "tools/migrate.trb"`: a program of the package beyond the `src/main.trb` that needs no
 * line (docs/design/PROJECT.md section 4). A line without an `entry` renames that default program.
 */
public type ProgramLine {
  /** The name of the program, of its binary, and of the argument to `torb run` and `torb build`. */
  name: String
  /** The file whose top-level code the program is, relative to the project. Empty renames `src/main.trb`. */
  entry: String = ""
  /** Where the binary goes, relative to the project and taken literally. Empty is `build/<profile>/<name>`. */
  output: String = ""

  fn renamesDefault(): Bool {
    entry.isEmpty()
  }
}

/**
 * How one of the two profiles builds (docs/design/PROJECT.md section 5): what a `profile "release" { optimize = 3 }`
 * block says, over the profile's own defaults. What a manifest reads is always the whole profile, so two manifests that
 * say the same thing in two ways read the same.
 */
public type ProfileSettings {
  /** `dev` or `release`: there is no third. */
  name: String
  /** How hard the C compiler optimizes, 0 to 3. */
  optimize: Int
  /** Whether the binary carries debug information for a debugger. */
  debugInformation: Bool = false
  /** Whether a panic prints the frames that led to it: read, and ignored until the runtime prints frames. */
  panicFrames: Bool = false

  /** The profile where no `profile` block says otherwise: `dev` at `-O1` with frames, `release` at `-O2` without. */
  static fn named(name: String): Self {
    if name == "release" {
      return Self name, optimize: 2
    }
    Self name, optimize: 1, panicFrames: true
  }
}

/** The names a `profile` block may have. */
public const profileNames = ["dev", "release"]

/**
 * What the toolchain needs to know about a project. The names of dependencies are stored without their version
 * requirement as well (`"acme/http:^1.2.3"` is the package `acme/http`), because the front end only asks "may this
 * project import that package"; the requirements as written are what the package manager resolves.
 */
public type Manifest {
  /** `owner/name`. Empty if the `project.trb` does not say. */
  name: String = ""
  version: String = ""
  /** `language = "0.3.0"`: the oldest language the project needs. Empty if it does not say. */
  language: String = ""
  /** What `torb publish` requires besides `name` and `version`, and what a registry shows. */
  description: String = ""
  license: String = ""
  repository: String = ""
  authors: List<String> = []
  /** The package whose public names are in scope in every file of the project. */
  prelude: String = "std/prelude"
  runtimeDependencies: List<String> = []
  /** Tests and tools. Never part of what dependents get. */
  developmentDependencies: List<String> = []
  /** The `runtime` lines as written, `"acme/http:^1.2.3"`. */
  runtimeRequirements: List<String> = []
  /** The `development` lines as written. */
  developmentRequirements: List<String> = []
  /** Every `registry` line, in order. */
  registries: List<RegistryBinding> = []
  /** Every `source` line, in order. */
  sources: List<SourceBinding> = []
  /** Patterns, each either a directory or `directory/*`. Empty for a project that is not a workspace. */
  workspaceMembers: List<String> = []
  /** Every `program` line, in order: the programs beyond `src/main.trb`, and a new name for it. */
  programs: List<ProgramLine> = []
  /** Every `profile` block, in order, each read over the defaults of its profile. */
  profiles: List<ProfileSettings> = []
  /**
   * `tasks { workers = 4 }`: how many workers the program's pool runs, where `TORB_WORKERS` does not say
   * (docs/design/CONCURRENCY.md section 3). `None` for the core count.
   */
  workers: Int? = None
  /** `tasks { blocking = 8 }`: how many threads the blocking pool has, where `TORB_BLOCKING` does not say. `None` for 4. */
  blocking: Int? = None

  fn isWorkspace(): Bool {
    !workspaceMembers.isEmpty()
  }

  fn dependsOn(package: String): Bool {
    runtimeDependencies.contains(package) || developmentDependencies.contains(package)
  }

  /**
   * What is wrong with `tasks { ... }`: a number outside 1 to 1024. `workers = 0` is refused rather than read as "decide
   * for me", because a zero nobody can read back is what leaving the line out already says.
   */
  fn poolProblem(): String? {
    for (word, number) in [("workers", workers), ("blocking", blocking)] {
      if const Some(given) = number {
        if given < 1 || given > 1024 {
          return "`tasks \{ {word} = {given} \}` is outside 1 to 1024: leave the line out for the default"
        }
      }
    }
    None
  }

  /** The two numbers of `tasks { ... }` for the runtime, 0 for one the manifest does not name. */
  fn pool(): (workers: Int, blocking: Int) {
    (workers: workers ?? 0, blocking: blocking ?? 0)
  }

  /** Whether a `profile` block of the name is in the file: a member without one takes its workspace root's. */
  fn configures(profile: String): Bool {
    profiles.any({ _.name == profile })
  }

  /** The profile as this project builds it: its `profile` block, or the defaults of the profile. */
  fn profileNamed(name: String): ProfileSettings {
    profiles.find({ _.name == name }) ?? ProfileSettings.named(name)
  }

  /** What is wrong with the `profile` blocks: a name that is no profile, a second block of one, a level outside 0 to 3. */
  fn profileProblem(): String? {
    var seen: List<String> = []
    for configured in profiles {
      if !profileNames.contains(configured.name) {
        return "`{configured.name}` is no profile: the profiles are `dev` and `release`"
      }
      if seen.contains(configured.name) {
        return "There are two `profile \"{configured.name}\"` blocks"
      }
      seen.append configured.name
      if configured.optimize < 0 || configured.optimize > 3 {
        return "`optimize = {configured.optimize}` of `profile \"{configured.name}\"` is outside 0 to 3"
      }
    }
    None
  }
}

/**
 * A `command argument..., { block }` line of a receiver script, as far as it is literal: the word, the string
 * arguments, and the settings of its block.
 */
public type Setting {
  word: String
  texts: List<String>
  block: List<Self>
  /** The string arguments written with a label, `url: "..."`, by label. */
  labeled: Map<String, String> = [:]
  /** Where the whole line stands in its file: what `torb add` and `torb remove` edit. */
  span: Span = Span 0, 0

  fn first(): String? {
    texts.get 0
  }

  /** The string arguments of every `word` line of the block, in order. */
  fn textsOf(word: String): List<String> {
    var found: List<String> = []
    for setting in block {
      if setting.word == word {
        found.appendAll setting.texts
      }
    }
    found
  }

  fn find(word: String): Self? {
    block.find({ _.word == word })
  }
}

/**
 * The manifest, read from the syntax tree instead of evaluated: top-level field assignments with literal values
 * (`name = "x"`) and the blocks the toolchain knows (`dependencies { runtime "acme/http:^1.2.3" }`, whose settings
 * are still command calls, because `runtime` is a method and not a field).
 *
 * A bare command call of a literal (`name "x"`) is read the same way: the language accepted only that form until
 * 2026-09-25, so old manifests and a seed built before that date still parse.
 *
 * Everything else in the file is ignored silently - a `project.trb` is a receiver script, and the sandboxed VM will
 * evaluate it properly once it exists. Until then reading it statically is what lets the compiler find its own
 * standard library, and it covers every `project.trb` that exists so far.
 */
public fn readManifest(file: SourceFile): Manifest {
  manifestOf readSettings(file.statements)
}

/** The manifest the literal lines say: the whole of [readManifest] once the file is lines, and a lock's `settings` block. */
public fn manifestOf(settings: List<Setting>): Manifest {
  var manifest = Manifest()
  for setting in settings {
    match setting.word {
      "name" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy name: text
        }
      }
      "version" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy version: text
        }
      }
      "description" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy description: text
        }
      }
      "license" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy license: text
        }
      }
      "repository" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy repository: text
        }
      }
      "authors" => {
        manifest = manifest.copy authors: manifest.authors.appendedAll(setting.texts)
      }
      "language" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy language: text
        }
      }
      "prelude" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy prelude: text
        }
      }
      "dependencies" => {
        const runtime = setting.textsOf "runtime"
        const development = setting.textsOf "development"
        manifest = manifest.copy(
          runtimeDependencies: runtime.map(packageNameOf).toList(),
          developmentDependencies: development.map(packageNameOf).toList(),
          runtimeRequirements: runtime,
          developmentRequirements: development,
        )
      }
      "registry" => {
        if const Some(owner) = setting.first() {
          const url = setting.labeled.get("url") ?? (setting.texts.get(1) ?? "")
          manifest = manifest.copy registries: manifest.registries.appended(RegistryBinding(owner, url))
        }
      }
      "source" => {
        if const Some(package) = setting.first() {
          for kind in ["path", "git", "archive"] {
            if const Some(location) = setting.labeled.get(kind) {
              const pin = setting.labeled.get("revision") ?? (setting.labeled.get("hash") ?? "")
              const bound = SourceBinding package, kind, location, pin
              manifest = manifest.copy sources: manifest.sources.appended(bound)
              break
            }
          }
        }
      }
      "workspace" => {
        manifest = manifest.copy workspaceMembers: setting.textsOf("members")
      }
      "program" => {
        if const Some(name) = setting.first() {
          const entry = setting.labeled.get("entry") ?? ""
          const output = setting.labeled.get("output") ?? ""
          manifest = manifest.copy programs: manifest.programs.appended(ProgramLine(name, entry, output))
        }
      }
      "profile" => {
        if const Some(name) = setting.first() {
          manifest = manifest.copy profiles: manifest.profiles.appended(profileOf(name, setting))
        }
      }
      "tasks" => {
        if const Some(text) = firstTextOf(setting, "workers") {
          manifest = manifest.copy workers: numberOf(text)
        }
        if const Some(text) = firstTextOf(setting, "blocking") {
          manifest = manifest.copy blocking: numberOf(text)
        }
      }
      _ => {}
    }
  }
  manifest
}

/** `profile "release" { optimize = 3 }` over the defaults of the profile; a value of the wrong kind is left out. */
fn profileOf(name: String, setting: Setting): ProfileSettings {
  var profile = ProfileSettings.named name
  if const Some(text) = firstTextOf(setting, "optimize") {
    profile = profile.copy optimize: numberOf(text, invalid: -1)
  }
  if const Some(text) = firstTextOf(setting, "debugInformation") {
    if const Some(value) = truthOf(text) {
      profile = profile.copy debugInformation: value
    }
  }
  if const Some(text) = firstTextOf(setting, "panicFrames") {
    if const Some(value) = truthOf(text) {
      profile = profile.copy panicFrames: value
    }
  }
  profile
}

/**
 * What is wrong with the `profile` blocks of a manifest (docs/design/PROJECT.md section 5): the first problem
 * [Manifest.profileProblem] finds, at the line of the block that has it.
 */
public fn profileProblemsOf(settings: List<Setting>): List<ManifestProblem> {
  var profiles: List<ProfileSettings> = []
  for setting in settings {
    if setting.word != "profile" {
      continue
    }
    if const Some(name) = setting.first() {
      profiles.append profileOf(name, setting)
      if const Some(problem) = Manifest(profiles: profiles).profileProblem() {
        return [ManifestProblem(setting.span, problem, "")]
      }
    }
  }
  []
}

/** `true` and `false` as the static reader keeps them. */
fn truthOf(text: String): Bool? {
  match text {
    "true" => true
    "false" => false
    _ => None
  }
}

/** The first string argument of a `word` line inside the block of the setting. */
fn firstTextOf(setting: Setting, word: String): String? {
  const found = setting.find(word)?
  found.first()
}

/** An integer literal as it was written, `1_024` included; one that is no integer reads as `invalid`, which is refused. */
fn numberOf(text: String, invalid: Int = 0): Int {
  Int.tryFrom(text.replace("_", "")).ok() ?? invalid
}

/** `"acme/http:^1.2.3"` is the package `acme/http`. */
fn packageNameOf(requirement: String): String {
  requirement.substringBefore(":") ?? requirement
}

/** The literal `word = value` and `word argument...` lines of a block, recursively. Anything else is skipped. */
public fn readSettings(statements: List<Statement>): List<Setting> {
  var settings: List<Setting> = []
  for statement in statements {
    if const Some(setting) = settingOf(statement) {
      settings.append setting
    }
  }
  settings
}

fn settingOf(statement: Statement): Setting? {
  const setting = match statement.kind {
    .Evaluate(expression) => settingOfCall(expression)?
    // `name = "x"`: a field written with `=`, read the same way a command call was until 2026-09-25
    .Assign(target, value) => settingOfAssign(target, value)?
    _ => {
      return None
    }
  }
  setting.copy span: statement.span
}

fn settingOfCall(expression: Expression): Setting? {
  const (callee, arguments) = match expression.kind {
    .Call(callee, arguments, _) => (callee, arguments)
    _ => {
      return None
    }
  }
  const word = match callee.kind {
    .Name(text) => text
    _ => {
      return None
    }
  }
  var texts: List<String> = []
  var block: List<Setting> = []
  var labeled: Map<String, String> = [:]
  for argument in arguments {
    match argument.value.kind {
      .TextLiteral(segments) => {
        if const Some(text) = plainText(segments) {
          match argument.label {
            Some(label) => labeled.set label.text, text
            None => texts.append text
          }
        }
      }
      // `workers 4`: an integer is read as it is written, and whoever reads the setting makes it a number
      .IntegerLiteral(text) => texts.append text
      .Closure(closure) => {
        block = readSettings closure.body.statements
      }
      _ => {}
    }
  }
  Setting word, texts, block, labeled
}

/** `name = "x"`, `input = "src/main.trb"`: the field's own name is the word, its value the one text a field takes. */
fn settingOfAssign(target: Expression, value: Expression): Setting? {
  const word = match target.kind {
    .Name(text) => text
    _ => {
      return None
    }
  }
  const text = match value.kind {
    .TextLiteral(segments) => plainText(segments)?
    .IntegerLiteral(written) => written
    // `debugInformation = true`: a truth value is kept as it is written, and whoever reads the setting makes it one
    .BoolLiteral(value) => "{value}"
    _ => {
      return None
    }
  }
  Setting word, [text], []
}

// --- What has to be evaluated (docs/design/PROJECT.md sections 8 and 10, SCRIPTS.md slice 5) ----------------------

/**
 * A setting the toolchain reads before it can run anything, written as something that has to be run:
 * `name = "acme/{suffix}"`. The static reader refuses it instead of reading an empty value (PROJECT.md section 10).
 */
public type ManifestProblem {
  /** The value that is not a literal. */
  span: Span
  message: String
  note: String
}

/**
 * The settings the toolchain reads from the syntax tree alone: it needs them before anything is checked, so they are
 * literals (PROJECT.md section 10, the first nine rows). `program` is among them because its `entry` decides which
 * files may hold top-level code.
 */
const staticWords = ["language", "name", "prelude", "dependencies", "source", "registry", "workspace", "program"]

/** Settings the toolchain does not read at all: computing one never makes it evaluate the file. */
const unreadWords = ["authors", "description", "license", "repository", "resources", "test"]

/** Every setting of the file the toolchain reads before it can run anything, where one is not a literal. */
public fn manifestProblemsOf(file: SourceFile): List<ManifestProblem> {
  var found: List<ManifestProblem> = []
  for statement in file.statements {
    const word = wordOf(statement) ?? ""
    if staticWords.contains(word) {
      staticProblemsOf statement, word, found
    }
  }
  found
}

/**
 * Whether the toolchain has to evaluate the file to know a setting it uses (SCRIPTS.md slice 5): a `version`, a
 * `tasks { ... }` or a `profile` block that is not a literal, or a line that is no setting at all - an `if`, a loop,
 * a call of something else - which may configure anything. A `use`, a `const` and a computed setting the toolchain
 * does not read change nothing it reads; a computed static setting is refused ([manifestProblemsOf]) and never
 * evaluated.
 */
public fn needsEvaluation(file: SourceFile): Bool {
  for statement in file.statements {
    if const .Declare(_) = statement.kind {
      continue
    }
    if const .Bind(_) = statement.kind {
      continue
    }
    const word = match wordOf(statement) {
      Some(found) => found
      None => {
        return true
      }
    }
    if staticWords.contains(word) || unreadWords.contains(word) {
      continue
    }
    if !isLiteralStatement(statement) {
      return true
    }
  }
  false
}

/** The word of a setting - `name = ...`, `name ...`, `tasks { ... }` - or `None` for a line that is no setting. */
fn wordOf(statement: Statement): String? {
  match statement.kind {
    .Assign(target, _) => {
      if const .Name(text) = target.kind {
        return text
      }
      None
    }
    .Evaluate(expression) => {
      if const .Call(callee, _, _) = expression.kind {
        if const .Name(text) = callee.kind {
          return text
        }
      }
      None
    }
    _ => None
  }
}

/** A setting whose every value is a literal, and every line of whose block is one. */
fn isLiteralStatement(statement: Statement): Bool {
  firstComputedOf(statement).isNone()
}

/** The first value of a setting that is not a literal, or the whole line where it is no setting. */
fn firstComputedOf(statement: Statement): Span? {
  match statement.kind {
    .Assign(target, value) => {
      if const .Name(_) = target.kind {
        if isLiteral(value) {
          return None
        }
        return value.span
      }
      statement.span
    }
    .Evaluate(expression) => {
      const arguments = match expression.kind {
        .Call(callee, given, _) => {
          if const .Name(_) = callee.kind {
            given
          } else {
            return statement.span
          }
        }
        _ => {
          return statement.span
        }
      }
      for argument in arguments {
        if const .Closure(closure) = argument.value.kind {
          for inner in closure.body.statements {
            if const Some(span) = firstComputedOf(inner) {
              return span
            }
          }
          continue
        }
        if !isLiteral(argument.value) {
          return argument.value.span
        }
      }
      None
    }
    _ => statement.span
  }
}

/** A plain string or an integer, as written. */
fn isLiteral(expression: Expression): Bool {
  match expression.kind {
    .TextLiteral(segments) => plainText(segments).isSome()
    .IntegerLiteral(_) => true
    .BoolLiteral(_) => true
    _ => false
  }
}

fn staticProblemsOf(statement: Statement, word: String, var found: List<ManifestProblem>) {
  const span = match firstComputedOf(statement) {
    Some(found) => found
    None => {
      return
    }
  }
  if word == "program" {
    found.append(ManifestProblem(
      span,
      "The name, the `entry` and the `output` of a `program` have to be plain strings",
      "The toolchain reads them before it can run anything: the entry decides which files may hold top-level code",
    ))
    return
  }
  found.append(ManifestProblem(
    span,
    "`{word}` has to be a plain string",
    "The toolchain reads `{word}` before it can run anything, so it cannot be computed",
  ))
}

/** `None` for a string with `{...}` in it: what it means depends on evaluation. */
fn plainText(segments: List<TextSegment>): String? {
  if const [.Literal(text)] = segments {
    return text
  }
  if segments.isEmpty() {
    return ""
  }
  None
}
