/**
 * `project.trb`: [Manifest], what it declares about a project, and [readManifest], which reads one from its syntax
 * tree without evaluating it. [Setting] is the literal shape a `command argument..., { block }` line reduces to on
 * the way there.
 */

use SourceFile, Statement, Expression, TextSegment from "../syntax/ast"
use Span from "../syntax/source"

/**
 * What the toolchain needs to know about a project. Names of dependencies are stored without their version
 * requirement (`"acme/http:^1.2.3"` is the package `acme/http`): resolving versions is the business of the package
 * manager, the front end only asks "may this project import that package".
 */
public type Manifest {
  /** `owner/name`. Empty if the `project.trb` does not say. */
  name: String = ""
  version: String = ""
  /** The package whose public names are in scope in every file of the project. */
  prelude: String = "std/prelude"
  runtimeDependencies: List<String> = []
  /** Tests and tools. Never part of what dependents get. */
  developmentDependencies: List<String> = []
  /** Patterns, each either a directory or `directory/*`. Empty for a project that is not a workspace. */
  workspaceMembers: List<String> = []
  buildInput: String = "src/main.trb"
  /**
   * The test directory, relative to the project. Empty for none, which is what a workspace manifest has unless it
   * says `test { input }`: its tests belong to its members, and a `tests/` beside it is theirs or another workspace's.
   */
  testInput: String = "tests"
  /**
   * `tasks { workers = 4 }`: how many workers the program's pool runs, where `TORB_WORKERS` does not say
   * (docs/design/CONCURRENCY.md section 3). `None` for the core count.
   */
  workers: Int? = None
  /** `tasks { blocking = 8 }`: how many threads the blocking pool has, where `TORB_BLOCKING` does not say. `None` for 4. */
  blocking: Int? = None

  fn isWorkspace(): Bool {
    !workspaceMembers.isEmpty()
  }

  fn dependsOn(package: String): Bool {
    runtimeDependencies.contains(package) || developmentDependencies.contains(package)
  }

  /**
   * What is wrong with `tasks { ... }`: a number outside 1 to 1024. `workers = 0` is refused rather than read as "decide
   * for me", because a zero nobody can read back is what leaving the line out already says.
   */
  fn poolProblem(): String? {
    for (word, number) in [("workers", workers), ("blocking", blocking)] {
      if const Some(given) = number {
        if given < 1 || given > 1024 {
          return Some "`tasks \{ {word} = {given} \}` is outside 1 to 1024: leave the line out for the default"
        }
      }
    }
    None
  }

  /** The two numbers of `tasks { ... }` for the runtime, 0 for one the manifest does not name. */
  fn pool(): (workers: Int, blocking: Int) {
    (workers: workers ?? 0, blocking: blocking ?? 0)
  }
}

/**
 * A `command argument..., { block }` line of a receiver script, as far as it is literal: the word, the string
 * arguments, and the settings of its block.
 */
public type Setting {
  word: String
  texts: List<String>
  block: List<Setting>

  fn first(): String? {
    texts.get 0
  }

  /** The string arguments of every `word` line of the block, in order. */
  fn textsOf(word: String): List<String> {
    var found: List<String> = []
    for setting in block {
      if setting.word == word {
        found.appendAll setting.texts
      }
    }
    found
  }

  fn find(word: String): Setting? {
    block.find({ _.word == word })
  }
}

/**
 * The manifest, read from the syntax tree instead of evaluated: top-level field assignments with literal values
 * (`name = "x"`) and the blocks the toolchain knows (`dependencies { runtime "acme/http:^1.2.3" }`, whose settings
 * are still command calls, because `runtime` is a method and not a field).
 *
 * A bare command call of a literal (`name "x"`) is read the same way: the language accepted only that form until
 * 2026-09-25, so old manifests and a seed built before that date still parse.
 *
 * Everything else in the file is ignored silently - a `project.trb` is a receiver script, and the sandboxed VM will
 * evaluate it properly once it exists. Until then reading it statically is what lets the compiler find its own
 * standard library, and it covers every `project.trb` that exists so far.
 */
public fn readManifest(file: SourceFile): Manifest {
  var manifest = Manifest()
  var namesTestInput = false
  for setting in readSettings(file.statements) {
    match setting.word {
      "name" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy name: text
        }
      }
      "version" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy version: text
        }
      }
      "prelude" => {
        if const Some(text) = setting.first() {
          manifest = manifest.copy prelude: text
        }
      }
      "dependencies" => {
        manifest = manifest.copy(
          runtimeDependencies: setting.textsOf("runtime").map(packageNameOf).toList(),
          developmentDependencies: setting.textsOf("development").map(packageNameOf).toList(),
        )
      }
      "workspace" => {
        manifest = manifest.copy workspaceMembers: setting.textsOf("members")
      }
      "build" => {
        if const Some(text) = firstTextOf(setting, "input") {
          manifest = manifest.copy buildInput: text
        }
      }
      "test" => {
        if const Some(text) = firstTextOf(setting, "input") {
          manifest = manifest.copy testInput: text
          namesTestInput = true
        }
      }
      "tasks" => {
        if const Some(text) = firstTextOf(setting, "workers") {
          manifest = manifest.copy workers: Some(numberOf(text))
        }
        if const Some(text) = firstTextOf(setting, "blocking") {
          manifest = manifest.copy blocking: Some(numberOf(text))
        }
      }
      _ => {}
    }
  }
  if manifest.isWorkspace() && !namesTestInput {
    manifest = manifest.copy testInput: ""
  }
  manifest
}

/** The first string argument of a `word` line inside the block of the setting. */
fn firstTextOf(setting: Setting, word: String): String? {
  const found = setting.find(word)?
  found.first()
}

/** An integer literal as it was written, `1_024` included; one that is no integer reads as 0, which is refused. */
fn numberOf(text: String): Int {
  Int.tryFrom(text.replace("_", "")).ok() ?? 0
}

/** `"acme/http:^1.2.3"` is the package `acme/http`. */
fn packageNameOf(requirement: String): String {
  requirement.substringBefore(":") ?? requirement
}

/** The literal `word = value` and `word argument...` lines of a block, recursively. Anything else is skipped. */
public fn readSettings(statements: List<Statement>): List<Setting> {
  var settings: List<Setting> = []
  for statement in statements {
    if const Some(setting) = settingOf(statement) {
      settings.append setting
    }
  }
  settings
}

fn settingOf(statement: Statement): Setting? {
  match statement.kind {
    .Evaluate(expression) => settingOfCall expression
    // `name = "x"`: a field written with `=`, read the same way a command call was until 2026-09-25
    .Assign(target, value) => settingOfAssign target, value
    _ => None
  }
}

fn settingOfCall(expression: Expression): Setting? {
  const (callee, arguments) = match expression.kind {
    .Call(callee, arguments, _) => (callee, arguments)
    _ => {
      return None
    }
  }
  const word = match callee.kind {
    .Name(text) => text
    _ => {
      return None
    }
  }
  var texts: List<String> = []
  var block: List<Setting> = []
  for argument in arguments {
    match argument.value.kind {
      .TextLiteral(segments) => {
        if const Some(text) = plainText(segments) {
          texts.append text
        }
      }
      // `workers 4`: an integer is read as it is written, and whoever reads the setting makes it a number
      .IntegerLiteral(text) => texts.append text
      .Closure(closure) => {
        block = readSettings closure.body.statements
      }
      _ => {}
    }
  }
  Some Setting(word, texts, block)
}

/** `name = "x"`, `input = "src/main.trb"`: the field's own name is the word, its value the one text a field takes. */
fn settingOfAssign(target: Expression, value: Expression): Setting? {
  const word = match target.kind {
    .Name(text) => text
    _ => {
      return None
    }
  }
  const text = match value.kind {
    .TextLiteral(segments) => plainText(segments)?
    .IntegerLiteral(written) => written
    _ => {
      return None
    }
  }
  Some Setting(word, [text], [])
}

// --- What has to be evaluated (docs/design/PROJECT.md sections 8 and 10, SCRIPTS.md slice 5) ----------------------

/**
 * A setting the toolchain reads before it can run anything, written as something that has to be run:
 * `name = "acme/{suffix}"`. The static reader refuses it instead of reading an empty value (PROJECT.md section 10).
 */
public type ManifestProblem {
  /** The value that is not a literal. */
  span: Span
  message: String
  note: String
}

/**
 * The settings the toolchain reads from the syntax tree alone: it needs them before anything is checked, so they are
 * literals (PROJECT.md section 10, the first nine rows). `build { input }` and `test { input }` are the entry files,
 * which the checker needs as well.
 */
const staticWords = ["language", "name", "prelude", "dependencies", "source", "registry", "workspace", "program"]

/** The blocks whose `input` is static: which files are entry files. */
const inputWords = ["build", "test"]

/** Settings the toolchain does not read at all: computing one never makes it evaluate the file. */
const unreadWords = ["authors", "description", "license", "repository", "profile", "resources"]

/** Every setting of the file the toolchain reads before it can run anything, where one is not a literal. */
public fn manifestProblemsOf(file: SourceFile): List<ManifestProblem> {
  var found: List<ManifestProblem> = []
  for statement in file.statements {
    const word = wordOf(statement) ?? ""
    if staticWords.contains(word) {
      staticProblemsOf statement, word, found
    } else if inputWords.contains(word) {
      inputProblemsOf statement, word, found
    }
  }
  found
}

/**
 * Whether the toolchain has to evaluate the file to know a setting it uses (SCRIPTS.md slice 5): a `version` or a
 * `tasks { ... }` that is not a literal, or a line that is no setting at all - an `if`, a loop, a call of something
 * else - which may configure anything. A `use`, a `const` and a computed setting the toolchain does not read change
 * nothing it reads; a computed static setting is refused ([manifestProblemsOf]) and never evaluated.
 */
public fn needsEvaluation(file: SourceFile): Bool {
  for statement in file.statements {
    if const .Declare(_) = statement.kind {
      continue
    }
    if const .Bind(_) = statement.kind {
      continue
    }
    const word = match wordOf(statement) {
      Some(found) => found
      None => {
        return true
      }
    }
    if staticWords.contains(word) || unreadWords.contains(word) {
      continue
    }
    if inputWords.contains(word) {
      // Only `input` is read, and it is static; `test { coverageThreshold = threshold }` is nothing the toolchain uses
      continue
    }
    if !isLiteralStatement(statement) {
      return true
    }
  }
  false
}

/** The word of a setting - `name = ...`, `name ...`, `tasks { ... }` - or `None` for a line that is no setting. */
fn wordOf(statement: Statement): String? {
  match statement.kind {
    .Assign(target, _) => {
      if const .Name(text) = target.kind {
        return Some text
      }
      None
    }
    .Evaluate(expression) => {
      if const .Call(callee, _, _) = expression.kind {
        if const .Name(text) = callee.kind {
          return Some text
        }
      }
      None
    }
    _ => None
  }
}

/** A setting whose every value is a literal, and every line of whose block is one. */
fn isLiteralStatement(statement: Statement): Bool {
  firstComputedOf(statement).isNone()
}

/** The first value of a setting that is not a literal, or the whole line where it is no setting. */
fn firstComputedOf(statement: Statement): Span? {
  match statement.kind {
    .Assign(target, value) => {
      if const .Name(_) = target.kind {
        if isLiteral(value) {
          return None
        }
        return Some value.span
      }
      Some statement.span
    }
    .Evaluate(expression) => {
      const arguments = match expression.kind {
        .Call(callee, given, _) => {
          if const .Name(_) = callee.kind {
            given
          } else {
            return Some statement.span
          }
        }
        _ => {
          return Some statement.span
        }
      }
      for argument in arguments {
        if const .Closure(closure) = argument.value.kind {
          for inner in closure.body.statements {
            if const Some(span) = firstComputedOf(inner) {
              return Some span
            }
          }
          continue
        }
        if !isLiteral(argument.value) {
          return Some argument.value.span
        }
      }
      None
    }
    _ => Some statement.span
  }
}

/** A plain string or an integer, as written. */
fn isLiteral(expression: Expression): Bool {
  match expression.kind {
    .TextLiteral(segments) => plainText(segments).isSome()
    .IntegerLiteral(_) => true
    _ => false
  }
}

fn staticProblemsOf(statement: Statement, word: String, var found: List<ManifestProblem>) {
  if const Some(span) = firstComputedOf(statement) {
    found.append(ManifestProblem(
      span,
      "`{word}` has to be a plain string",
      "The toolchain reads `{word}` before it can run anything, so it cannot be computed",
    ))
  }
}

/** `build { input = ... }`, `test { input = ... }`: the entry files, which the checker needs before it checks any. */
fn inputProblemsOf(statement: Statement, word: String, var found: List<ManifestProblem>) {
  const arguments = match statement.kind {
    .Evaluate(expression) => {
      if const .Call(_, given, _) = expression.kind {
        given
      } else {
        return
      }
    }
    _ => {
      return
    }
  }
  for argument in arguments {
    if const .Closure(closure) = argument.value.kind {
      for inner in closure.body.statements {
        if wordOf(inner) == Some("input") {
          if const Some(span) = firstComputedOf(inner) {
            found.append(ManifestProblem(
              span,
              "`{word} \{ input \}` has to be a plain string",
              "It names the entry files, which the checker needs before it can run anything",
            ))
          }
        }
      }
    }
  }
}

/** `None` for a string with `{...}` in it: what it means depends on evaluation. */
fn plainText(segments: List<TextSegment>): String? {
  if const [.Literal(text)] = segments {
    return Some text
  }
  if segments.isEmpty() {
    return Some ""
  }
  None
}
