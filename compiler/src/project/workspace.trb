/**
 * [Workspace]: the projects one run of the toolchain works with, found from the paths on the command line by
 * [findWorkspace] - the outermost `project.trb` whose `workspace { members ... }` reaches the path, or the path's
 * own project, or a standalone script that belongs to none.
 */

use SourceText, LineIndex from "../syntax/source"
use parse from "../syntax/parser/parser"
use normalizePath, parentPath, joinPath, isInside, pathName, pathDepth, relativePath from "./path"
use SourceTree from "./source-tree"
use Manifest, RegistryBinding, ManifestProblem, readManifest, readSettings from "./manifest"
use manifestProblemsOf, manifestNotesOf, profileProblemsOf from "./manifest"
use programProblemsOf from "./programs"
use Lock, readLock from "../package/lock"
use packageDirectory from "../package/store"
use requirementOf from "../package/requirement"
use Version from "../package/version"
use registryOf, bindingsOf from "../package/registry"

/**
 * One project: one `project.trb`, one package name, and its files - every `.trb` file below its directory that is not
 * inside a nested package (docs/design/PROJECT.md section 3).
 */
public type Package {
  /** `owner/name` from `project.trb`. Empty if the project does not say, which makes it unimportable. */
  name: String
  /** The directory that contains the `project.trb`. Empty for a standalone script. */
  directory: String
  manifest: Manifest
  /** Every `.trb` file of the package, sorted: the modules it consists of. */
  files: List<String>
  /**
   * A package the workspace's `project.lock.trb` pins rather than one of its members: unpacked in the package manager's
   * cache, or a `path:` package. What the build checks and never writes.
   */
  installed: Bool = false
}

/**
 * The projects one run of the toolchain works with. A path on the command line names a workspace root (then all of
 * its members are here), a single project (then its whole workspace is here anyway, because that is where the
 * standard library is), or a script that belongs to no project at all.
 */
public type Workspace {
  packages: List<Package>
  /** What went wrong before any source was looked at: a member that is not there, a path without a project */
  problems: List<String> = []
  /**
   * Every file the tree lists, sources and others, sorted: what a resource literal is resolved against, byte for byte
   * (docs/design/RESOURCES.md section 6). Empty where nobody asked.
   */
  listedFiles: List<String> = []

  fn packageNamed(name: String): Package? {
    if name.isEmpty() {
      return None
    }
    packages.find({ _.name == name })
  }
}

/**
 * The workspace of a path: the outermost `project.trb` above it whose `workspace { members ... }` contains the
 * project the path belongs to. A project that nobody lists is its own workspace, and a file below no `project.trb`
 * at all becomes a package of its own, checked with the default prelude.
 *
 * A file that is named on its own is a module of the project around it even where the package does not reach it - in a
 * hidden or a `build` directory - so `torb check .scratch/try.trb` checks it instead of finding nothing. A workspace that has no standard
 * library of its own gets the packages of the toolchain's (`SourceTree.standardLibrary`).
 */
public fn findWorkspace(tree: SourceTree, path: String): Workspace {
  const target = normalizePath path
  const directory = if tree.exists(target) { parentPath target } else { target }
  const manifests = manifestDirectories tree
  // Innermost first: the project the path belongs to, then everything it could be a member of
  const owners = manifests.filter({ isInside directory, _ }).toList().reversed()
  if const Some(project) = owners.first() {
    const members = withLockedPackages tree, workspaceOf(tree, manifests, owners, project)
    const found = withNamedFile members, tree, project, target
    return withStandardLibrary tree, manifests, found
  }
  const files = if tree.exists(target) { [target] } else { tree.below directory }
  withStandardLibrary tree, manifests, Workspace([Package("", directory, Manifest(), files)])
}

/**
 * The workspace with the packages its root's `project.lock.trb` pins (docs/design/PROJECT.md section 11): a registry
 * package where it is unpacked in the cache, its manifest the `settings` of its own lock, and a `path:` package as the
 * project it is. A problem for everything the build cannot take from the lock as it is - a dependency of a member that
 * the lock does not pin, pins at a version the requirement does not allow, or pins from another registry than the one
 * the owner is bound to, a locked package that is not installed, and a dependency of a locked package the lock lacks.
 * The build reads the lock and never writes it: each problem names the command that does.
 */
fn withLockedPackages(tree: SourceTree, workspace: Workspace): Workspace {
  const root = match workspace.packages.first() {
    Some(found) => found.directory
    None => {
      return workspace
    }
  }
  const lockPath = joinPath root, "project.lock.trb"
  const lockText = tree.text lockPath
  var problems = workspace.problems
  var packages = workspace.packages
  var lock = Lock()
  if const Some(text) = lockText {
    match readLock(text) {
      Ok(found) => {
        lock = found
      }
      Fail(problem) => {
        problems.append "{tree.display(lockPath)}: {problem}"
        return workspace.copy problems: problems
      }
    }
  }
  var lines: List<RegistryBinding> = []
  for package in workspace.packages {
    lines.appendAll package.manifest.registries
  }
  const bindings = match bindingsOf(lines) {
    Ok(found) => found
    Fail(problem) => {
      problems.append problem
      []
    }
  }
  for locked in lock.graph {
    if workspace.packageNamed(locked.name).isSome() {
      continue
    }
    if locked.isPath() {
      const directory = joinPath root, locked.path
      if !tree.exists(joinPath(directory, "project.trb")) {
        problems.append "project.lock.trb names `{locked.name}` at `{locked.path}`, which has no project.trb"
        continue
      }
      packages.append packageAt(tree, directory, manifestDirectories(tree)).copy(installed: true)
      continue
    }
    const directory = packageDirectory tree.cache(), locked.hash
    const own = match tree.text(joinPath(directory, "project.lock.trb")) {
      Some(text) => text
      None => {
        problems.append "{locked.name} {locked.version} is in project.lock.trb and not installed: run `torb install`"
        continue
      }
    }
    const settings = readLock(own).ok().flatMap({ _.settingsOf locked.name }) ?? Manifest()
    const manifest = settings.copy name: locked.name
    packages.append Package(locked.name, directory, manifest, tree.below(joinPath(directory, "src")), installed: true)
  }
  const members = workspace.packages.map({ _.name }).filter({ !_.isEmpty() }).toList()
  problems.appendAll lockProblems(workspace.packages, lock, lockText.isSome(), bindings)
  for package in packages {
    if !package.installed {
      continue
    }
    for name in package.manifest.runtimeDependencies {
      if !name.startsWith("std/") && lock.locked(name).isNone() && !members.contains(name) {
        problems.append "`{package.name}` needs `{name}`, which project.lock.trb does not pin: run `torb update`"
      }
    }
  }
  workspace.copy packages: packages, problems: problems
}

/**
 * Why `lock` does not do for the requirements of `members`: a dependency that is neither the toolchain's nor a member and
 * that the lock does not pin, pins at a version the requirement does not allow, or pins from another registry than the
 * one its owner is bound to. `hasLock` is whether there is a lock file at all, which the message says.
 */
public fn lockProblems(
  members: List<Package>,
  lock: Lock,
  hasLock: Bool,
  bindings: List<RegistryBinding>,
): List<String> {
  var problems: List<String> = []
  const names = members.map({ _.name }).filter({ !_.isEmpty() }).toList()
  for package in members {
    var written = package.manifest.runtimeRequirements
    written.appendAll package.manifest.developmentRequirements
    for line in written {
      const requirement = match requirementOf(line) {
        Ok(found) => found
        Fail(_) => {
          continue
        }
      }
      if requirement.package.startsWith("std/") || names.contains(requirement.package) {
        continue
      }
      const locked = match lock.locked(requirement.package) {
        Some(found) => found
        None => {
          const why = if hasLock { "project.lock.trb does not pin it" } else { "there is no project.lock.trb" }
          problems.append "`{package.name}` depends on `{line}`, and {why}: run `torb update`"
          continue
        }
      }
      if locked.isPath() {
        continue
      }
      const pinned = Version.tryFrom(locked.version).ok()
      if !(pinned.map({ requirement.versions.contains _ }) ?? false) {
        problems.append "project.lock.trb pins {locked.name} {locked.version}, and `{package.name}` needs `{line}`: run `torb update {locked.name}`"
      }
      const bound = registryOf locked.name, bindings
      if locked.registry != bound {
        problems.append "project.lock.trb has {locked.name} from `{locked.registry}`, and its owner is bound to `{bound}`: run `torb update {locked.name}`"
      }
    }
  }
  problems
}

/** The workspace with a file that was named on its own added to its project, unless a package has it already. */
fn withNamedFile(workspace: Workspace, tree: SourceTree, project: String, target: String): Workspace {
  if !tree.exists(target) || pathName(target) == "project.trb" {
    return workspace
  }
  if workspace.packages.any({ _.files.contains target }) {
    return workspace
  }
  var packages: List<Package> = []
  for package in workspace.packages {
    if package.directory == project {
      packages.append package.copy(files: package.files.appended(target))
    } else {
      packages.append package
    }
  }
  workspace.copy packages: packages
}

/**
 * The workspace with the packages of the toolchain's standard library added, when one of its packages names a prelude
 * that none of them is. A package the workspace already has - by directory or by name - is not added twice.
 */
fn withStandardLibrary(tree: SourceTree, manifests: List<String>, workspace: Workspace): Workspace {
  const library = tree.standardLibrary()
  if library.isEmpty() {
    return workspace
  }
  const lacksPrelude = workspace.packages.any({
    !_.manifest.prelude.isEmpty() && workspace.packageNamed(_.manifest.prelude).isNone()
  })
  if !lacksPrelude {
    return workspace
  }
  var packages = workspace.packages
  for directory in manifests.filter({ parentPath(_) == library }) {
    const package = packageAt tree, directory, manifests
    if !packages.any({ _.directory == directory || (!package.name.isEmpty() && _.name == package.name) }) {
      packages.append package
    }
  }
  workspace.copy packages: packages
}

/** The directories with a `project.trb`, the outermost first: a directory always comes before what is inside it. */
fn manifestDirectories(tree: SourceTree): List<String> {
  var directories = tree.paths().filter({ pathName(_) == "project.trb" }).map(parentPath).toList()
  directories.sort by: pathDepth
  directories
}

fn workspaceOf(tree: SourceTree, manifests: List<String>, owners: List<String>, project: String): Workspace {
  var problems: List<String> = []
  // `owners` is innermost first, so the last workspace that contains the project is the outermost one
  var root = project
  var members: List<String> = []
  for owner in owners {
    const candidate = manifestOf tree, owner
    if !candidate.isWorkspace() {
      continue
    }
    const expanded = expandMembers tree, manifests, owner, candidate.workspaceMembers, problems
    if owner == project || expanded.contains(project) {
      root = owner
      members = expanded
    }
  }
  var directories = [root]
  for member in members {
    if !directories.contains(member) {
      directories.append member
    }
  }
  for directory in directories {
    problems.appendAll manifestProblemLines(tree, directory)
  }
  Workspace(directories.map({ packageAt tree, _, manifests }).toList(), problems)
}

/**
 * What is wrong with the `project.trb` of a directory before anything is checked, each with the file, the line and the
 * column: a setting the toolchain reads before it can run anything that is computed (docs/design/PROJECT.md section
 * 10), a `program` line the tree contradicts (section 4), a `profile` block that is no profile (section 5).
 */
fn manifestProblemLines(tree: SourceTree, directory: String): List<String> {
  const path = joinPath directory, "project.trb"
  const text = match tree.text(path) {
    Some(found) => found
    None => {
      return []
    }
  }
  const file = parse(SourceText.of(text)).file
  const settings = readSettings file.statements
  const name = readManifest(file).name
  var found = manifestProblemsOf file
  found.appendAll programProblemsOf(tree, directory, name, settings)
  found.appendAll profileProblemsOf(settings)
  const lines = LineIndex.of text
  found.map({ renderedProblem tree.display(path), lines, _ }).toList()
}

/**
 * The lines of the `project.trb` of a directory that are accepted and read by nobody, each with its place: what
 * `torb check` prints as a note where it checks that manifest.
 */
public fn manifestNoteLines(tree: SourceTree, directory: String): List<String> {
  const path = joinPath directory, "project.trb"
  const text = match tree.text(path) {
    Some(found) => found
    None => {
      return []
    }
  }
  const lines = LineIndex.of text
  manifestNotesOf(parse(SourceText.of(text)).file).map({ renderedProblem tree.display(path), lines, _ }).toList()
}

/** A problem of a manifest as the text `torb check` prints after `error:` or `note:`. */
fn renderedProblem(path: String, lines: LineIndex, problem: ManifestProblem): String {
  const (line, column) = lines.lineAndColumn problem.span.start
  const place = "{problem.message}\n --> {path}:{line}:{column}"
  if problem.note.isEmpty() {
    return place
  }
  "{place}\n  = {problem.note}"
}

/** `members "std/*", "compiler"`: a pattern is a directory, or `directory/*` for every project directly below it. */
fn expandMembers(
  tree: SourceTree,
  manifests: List<String>,
  root: String,
  patterns: List<String>,
  var problems: List<String>,
): List<String> {
  var members: List<String> = []
  for pattern in patterns {
    if const Some(directory) = pattern.withoutSuffix("/*") {
      const parent = joinPath root, directory
      const matched = manifests.filter({ _ != root && parentPath(_) == parent }).toList()
      if matched.isEmpty() {
        problems.append "The workspace member pattern `{pattern}` of {root} matches no project"
      }
      members.appendAll matched
      continue
    }
    const directory = joinPath root, pattern
    if manifests.contains(directory) {
      members.append directory
    } else {
      problems.append "The workspace member `{pattern}` of {root} has no `project.trb`"
    }
  }
  members
}

/**
 * The package in `directory`: every `.trb` file below it that is not inside a nested package - a directory of
 * `manifests` below it - skipping hidden directories, `build`, `target` and `node_modules`
 * (docs/design/PROJECT.md section 3). One rule instead of `src/` plus a test directory: a file of `tools/` is a
 * file of the package as much as one of `src/` is.
 */
fn packageAt(tree: SourceTree, directory: String, manifests: List<String>): Package {
  const manifest = manifestOf tree, directory
  const nested = manifests.filter({ _ != directory && isInside(_, directory) }).toList()
  var files: List<String> = []
  for file in tree.below(directory) {
    if isFileOfPackage(file, directory, nested) {
      files.append file
    }
  }
  Package manifest.name, directory, manifest, files
}

/** The directories a package does not reach into: what a tool writes, what a tool keeps, and what is hidden. */
const skippedDirectories = ["build", "target", "node_modules"]

/**
 * Whether a file below the directory of a package is one of its files. `project.trb` and `project.lock.trb` never
 * are: the one declares the package and is a receiver script whose scope is the prelude alone, the other is written by
 * the toolchain.
 */
fn isFileOfPackage(file: String, directory: String, nested: List<String>): Bool {
  const name = pathName file
  if !name.endsWith(".trb") || name == "project.trb" || name == "project.lock.trb" {
    return false
  }
  if nested.any({ isInside file, _ }) {
    return false
  }
  const inside = relativePath(directory, file).split("/").toList()
  for index in 0..(inside.length() - 1) {
    const component = inside[index]
    if component.startsWith(".") || skippedDirectories.contains(component) {
      return false
    }
  }
  true
}

/** The `project.trb` of a directory, read from its syntax tree. An unreadable one is an empty manifest. */
public fn manifestOf(tree: SourceTree, directory: String): Manifest {
  const text = tree.text(joinPath(directory, "project.trb")) ?? ""
  readManifest parse(SourceText.of(text)).file
}
