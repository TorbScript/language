/**
 * The IR verifier. Lowering builds the IR by a direct walk of the checked tree, with nothing that checks its own
 * output, so a bug in it shows up as a wrong C file and not as an error - unless something checks the IR itself. This
 * is that something: it runs in the tests, in the debug profile of `torb build`, and behind `torb ir`.
 *
 * What it demands:
 *
 * - the parameter slots are the signature's parameters, in order, with their types;
 * - every block's terminator points at blocks that exist, and a `Switch` has one target per value;
 * - every block is reachable from the entry block, or is an empty `Unreachable` marker;
 * - every slot is defined before it is used, **on every path** that reaches the use;
 * - the type of every operand is the type the position asks for, and the type of every result is what it produces;
 * - `Retain`, `Release` and `MakeUnique` only ever touch something that is counted.
 *
 * What it does *not* demand: that every counted value is consumed or released exactly once on every path. That is only
 * true of the IR **after** the ownership pass, and asking it of phase one would reject every function there is - so it
 * lives next to the pass that inserts them, in `ownership-verify.trb`, and `verifyOwnedProgram` is the two together.
 */

use IrTypeId, IrType, IrProgram, IrFunction, IrSignature, FunctionKind, RuntimeKind, Ownership from "./ir"
use Block, BlockId, Slot, SlotRole, Instruction, Terminator, Argument, Reference, PathStep from "./ir"
use Intrinsic, IntrinsicOperation, NumericKind, WitnessSource, WitnessRoot, Capture, LayoutId from "./ir"
use FunctionId, IrSignatureId from "./ir"
use isManagedType, containsCountedType, textPartKindOf from "./layout"
use isEnvironmentLayout from "./capture"
use describeIrType, describeIntrinsic, describeNumericKind from "./print"

/**
 * Every finding against one function: its parameters, its graph, that every block is reachable, that every slot is
 * defined before it is used, and that every type agrees. Later checks run only once the earlier ones are clean, since
 * a dangling edge or a wrong parameter makes everything after it meaningless.
 */
public fn verifyFunction(program: IrProgram, function: IrFunction): List<String> {
  var found: List<String> = []
  verifyParameters program, function, found
  // A `native fn` the runtime provides is a signature and nothing else: there is no body to say anything about
  if const .Runtime(_) = function.kind {
    if !function.blocks.isEmpty() {
      found.append "{function.name}: a function of the runtime has no body"
    }
    return found
  }
  // The accessor of an immortal constant is a signature plus the initializer it names: the cell and the flag are the
  // back end's, so there is no body here either
  if const .ConstantCell(initializer) = function.kind {
    if !function.blocks.isEmpty() {
      found.append "{function.name}: the accessor of a constant has no body"
    }
    if !program.hasFunction(initializer) {
      found.append "{function.name}: the initializer of the constant is not in the program"
      return found
    }
    const built = program.functionAt initializer
    if built.signature.result != function.signature.result {
      found.append "{function.name}: the initializer of the constant produces another type"
    }
    if !built.signature.parameters.isEmpty() {
      found.append "{function.name}: the initializer of the constant takes arguments"
    }
    return found
  }
  verifyGraph program, function, found
  // A dataflow over a graph with a dangling edge says nothing useful, so the shape has to be right first
  if !found.isEmpty() {
    return found
  }
  verifyReachability program, function, found
  verifyDefinedness program, function, found
  verifyTypes program, function, found
  found
}

/** Every function of a program, in the order they were lowered. */
public fn verifyProgram(program: IrProgram): List<String> {
  var found: List<String> = []
  for function in program.functions {
    found.appendAll verifyFunction(program, function)
  }
  found
}

fn verifyParameters(program: IrProgram, function: IrFunction, var found: List<String>) {
  const parameters = function.signature.parameters
  if function.slots.length() < parameters.length() {
    found.append "{function.name}: the signature has {parameters.length()} parameters and the function only {function.slots.length()} slots"
    return
  }
  for index in 0..parameters.length() {
    const slot = function.slots[index]
    if slot.role != SlotRole.Parameter(index) {
      found.append "{function.name}: slot %{index} has to be parameter {index}"
    }
    if slot.annotation != parameters[index].annotation {
      const wanted = describeIrType program, parameters[index].annotation
      const actual = describeIrType program, slot.annotation
      found.append "{function.name}: parameter {index} is `{wanted}` and its slot is `{actual}`"
    }
  }
  for index in 0..function.slots.length() {
    const annotation = function.slots[index].annotation
    match program.typeAt(annotation) {
      .NeverType => found.append "{function.name}: slot %{index} has the type `Never`, which has no values"
      .ConstantValue(_, _) => found.append "{function.name}: slot %{index} holds a const argument, which is not a value"
      _ => {}
    }
  }
}

/** The shape of the graph: every edge points at a block that exists, and a switch has one target per value. */
fn verifyGraph(program: IrProgram, function: IrFunction, var found: List<String>) {
  if function.blocks.isEmpty() {
    found.append "{function.name}: a function needs at least the entry block"
    return
  }
  for index in 0..function.blocks.length() {
    const block = function.blocks[index]
    const at = "{function.name} b{index}"
    match block.terminator {
      .Jump(target) => checkTarget function, found, at, target
      .Branch(_, then, otherwise) => {
        checkTarget function, found, at, then
        checkTarget function, found, at, otherwise
      }
      .Switch(_, values, targets, otherwise) => {
        if values.length() != targets.length() {
          found.append "{at}: the switch has {values.length()} values and {targets.length()} targets"
        }
        for target in targets {
          checkTarget function, found, at, target
        }
        checkTarget function, found, at, otherwise
      }
      _ => {}
    }
  }
}

/** A block nothing reaches is a bug of the lowering, unless it is deliberately an empty `unreachable` marker. */
fn verifyReachability(program: IrProgram, function: IrFunction, var found: List<String>) {
  const reachable = reachableBlocks function
  for index in 1..function.blocks.length() {
    if reachable[index] {
      continue
    }
    const block = function.blocks[index]
    if !block.instructions.isEmpty() || !isUnreachableTerminator(block.terminator) {
      found.append "{function.name} b{index}: nothing reaches this block, and it is not an `unreachable` marker"
    }
  }
}

fn isUnreachableTerminator(terminator: Terminator): Bool {
  match terminator {
    .Unreachable => true
    _ => false
  }
}

fn checkTarget(function: IrFunction, var found: List<String>, at: String, target: BlockId) {
  if !function.hasBlock(target) {
    found.append "{at}: there is no block b{target.value}"
  }
}

fn checkReturn(program: IrProgram, function: IrFunction, var found: List<String>, at: String, value: Argument?) {
  const result = function.signature.result
  match program.typeAt(result) {
    .VoidType => {
      if value.isSome() {
        found.append "{at}: the function returns `Void`, so `return` carries no value"
      }
    }
    .NeverType => found.append "{at}: the function returns `Never`, so it may not return at all"
    _ => {
      match value {
        None => found.append "{at}: the function returns `{describeIrType(program, result)}`, so `return` needs a value"
        Some(argument) => {
          if !function.hasSlot(argument.slot) {
            found.append "{at}: there is no slot %{argument.slot.value}"
            return
          }
          const actual = function.typeOfSlot argument.slot
          if actual != result {
            const wanted = describeIrType program, result
            found.append "{at}: the function returns `{wanted}` and `return` carries `{describeIrType(program, actual)}`"
          }
        }
      }
    }
  }
}

// --- Reachability and definedness -----------------------------------------------------------------------------------

/** Which blocks the entry block can reach. Every terminator target of a reachable block is reachable. */
public fn reachableBlocks(function: IrFunction): List<Bool> {
  var reachable = filledBooleans function.blocks.length(), false
  if function.blocks.isEmpty() {
    return reachable
  }
  var pending = [0]
  reachable.set 0, true
  while !pending.isEmpty() {
    const last = pending.length() - 1
    const current = pending[last]
    pending.removeAt last
    for target in successorsOf(function.blocks[current]) {
      if target < 0 || target >= reachable.length() || reachable[target] {
        continue
      }
      reachable.set target, true
      pending.append target
    }
  }
  reachable
}

/** The blocks a terminator can go to, in the order they are written. */
public fn successorsOf(block: Block): List<Int> {
  match block.terminator {
    .Jump(target) => [target.value]
    .Branch(_, then, otherwise) => [then.value, otherwise.value]
    .Switch(_, _, targets, otherwise) => {
      var all: List<Int> = []
      for target in targets {
        all.append target.value
      }
      all.append otherwise.value
      all
    }
    _ => []
  }
}

fn filledBooleans(count: Int, value: Bool): List<Bool> {
  var filled: List<Bool> = []
  for _ in 0..count {
    filled.append value
  }
  filled
}

/**
 * "Defined on every path": the intersection over the predecessors, iterated until nothing changes. A slot that is
 * written in one arm of an `if` and read after it is exactly what this catches, and it is the mistake a lowering makes.
 */
fn verifyDefinedness(program: IrProgram, function: IrFunction, var found: List<String>) {
  const slotCount = function.slots.length()
  const blockCount = function.blocks.length()
  const reachable = reachableBlocks function
  const predecessors = predecessorsOf function
  // What a block writes, so that what leaves it is what arrived plus that - the loop below needs both ends of a block
  const defines = definitionsOf program, function, slotCount
  var definedIn: List<List<Bool>> = []
  for index in 0..blockCount {
    definedIn.append filledBooleans(slotCount, index != 0)
  }
  definedIn.set 0, parameterSlots(function, slotCount)
  var rounds = 0
  var isChanged = true
  while isChanged {
    isChanged = false
    rounds = rounds + 1
    if rounds > blockCount + 2 {
      found.append "{function.name}: the definedness of the slots did not settle"
      return
    }
    for index in 1..blockCount {
      if !reachable[index] {
        continue
      }
      const incoming = intersected definedIn, defines, predecessors[index], slotCount
      if incoming != definedIn[index] {
        definedIn.set index, incoming
        isChanged = true
      }
    }
  }
  for index in 0..blockCount {
    if !reachable[index] {
      continue
    }
    var defined = definedIn[index]
    const block = function.blocks[index]
    const at = "{function.name} b{index}"
    for instruction in block.instructions {
      // The end of a temporary's statement may stand where one path of the statement never made it: the ownership
      // pass clears the slot on that path first (`withClearedTemporaries`), so nothing has to be defined here yet
      if const .EndOfScope(_) = instruction {
        continue
      }
      const outs = outParameterSlotsOf program, instruction
      for slot in usedSlots(instruction) {
        if !outs.contains(slot) {
          checkDefined function, found, defined, at, slot
        }
      }
      if const Some(target) = definedSlot(instruction) {
        if function.hasSlot(target) {
          defined.set target.value, true
        }
      }
      for slot in outs {
        if function.hasSlot(slot) {
          defined.set slot.value, true
        }
      }
    }
    for slot in usedByTerminator(block.terminator) {
      checkDefined function, found, defined, at, slot
    }
  }
}

fn checkDefined(function: IrFunction, var found: List<String>, defined: List<Bool>, at: String, slot: Slot) {
  if !function.hasSlot(slot) {
    found.append "{at}: there is no slot %{slot.value}"
    return
  }
  if defined[slot.value] {
    return
  }
  found.append "{at}: %{slot.value} is used before it is defined on every path"
}

fn parameterSlots(function: IrFunction, slotCount: Int): List<Bool> {
  var defined = filledBooleans slotCount, false
  for index in 0..function.slots.length() {
    match function.slots[index].role {
      .Parameter(_) => defined.set index, true
      // The place a `.ByPointer` result is written to is the caller's, so it arrives defined as well
      .ResultPointer => defined.set index, true
      _ => {}
    }
  }
  defined
}

fn predecessorsOf(function: IrFunction): List<List<Int>> {
  var predecessors: List<List<Int>> = []
  for _ in 0..function.blocks.length() {
    predecessors.append([])
  }
  for index in 0..function.blocks.length() {
    for target in successorsOf(function.blocks[index]) {
      if target >= 0 && target < predecessors.length() {
        predecessors[target].append(index)
      }
    }
  }
  predecessors
}

/** Which slots a block writes, whatever arrived in it: what leaves the block is the union of the two. */
fn definitionsOf(program: IrProgram, function: IrFunction, slotCount: Int): List<List<Bool>> {
  var defines: List<List<Bool>> = []
  for block in function.blocks {
    var written = filledBooleans slotCount, false
    for instruction in block.instructions {
      if const Some(target) = definedSlot(instruction) {
        if target.value >= 0 && target.value < slotCount {
          written.set target.value, true
        }
      }
      for slot in outParameterSlotsOf(program, instruction) {
        if slot.value >= 0 && slot.value < slotCount {
          written.set slot.value, true
        }
      }
    }
    defines.append written
  }
  defines
}

/**
 * The slots an **out** parameter of a call writes: the callee never reads what is there and leaves a value the caller
 * owns (BACKEND 5.R1's `bool` plus out parameter convention, which is what the wrapper around `torb_list_get` uses).
 *
 * So such a slot is *defined by* the call and is not read at it - which is the one position where the base of a place
 * does not have to hold anything yet.
 */
public fn outParameterSlotsOf(program: IrProgram, instruction: Instruction): List<Slot> {
  var found: List<Slot> = []
  const (callee, arguments) = match instruction {
    .Call(_, called, given, _, _) => (called, given)
    _ => {
      return found
    }
  }
  if !program.hasFunction(callee) {
    return found
  }
  const parameters = program.functionAt(callee).signature.parameters
  for index in 0..arguments.length() {
    if index >= parameters.length() {
      continue
    }
    if !parameters[index].isOut {
      continue
    }
    if const Some(place) = arguments[index].place {
      found.append place.base
    }
  }
  found
}

/**
 * What is defined at the beginning of a block: the intersection over its predecessors of what *leaves* each of them.
 * A slot that one arm of an `if` writes and the other does not is exactly what this catches, and it is the mistake a
 * lowering makes.
 */
fn intersected(
  definedIn: List<List<Bool>>,
  defines: List<List<Bool>>,
  predecessors: List<Int>,
  slotCount: Int,
): List<Bool> {
  if predecessors.isEmpty() {
    return filledBooleans slotCount, false
  }
  var common = leaving definedIn, defines, predecessors[0], slotCount
  for index in 1..predecessors.length() {
    const other = leaving definedIn, defines, predecessors[index], slotCount
    for slot in 0..slotCount {
      if !other[slot] {
        common.set slot, false
      }
    }
  }
  common
}

fn leaving(definedIn: List<List<Bool>>, defines: List<List<Bool>>, block: Int, slotCount: Int): List<Bool> {
  var found = definedIn[block]
  const written = defines[block]
  for slot in 0..slotCount {
    if written[slot] {
      found.set slot, true
    }
  }
  found
}

// --- What an instruction reads and writes ---------------------------------------------------------------------------

/** Every slot an instruction reads, in evaluation order. The ownership pass walks this list backwards (BACKEND 2.2). */
public fn usedSlots(instruction: Instruction): List<Slot> {
  match instruction {
    .Constant(_, _) => []
    .Move(_, source) => [source]
    .Copy(_, source) => [source]
    .Retain(slot) => [slot]
    .Release(slot) => [slot]
    .EndOfScope(slot) => [slot]
    .Clear(_) => []
    .MakeUnique(reference) => slotsOfReference reference
    .Call(_, _, arguments, witnesses, _) => {
      var used = slotsOfArguments arguments
      used.appendAll slotsOfWitnesses(witnesses)
      used
    }
    .CallClosure(_, callee, arguments) => {
      var used = [callee]
      used.appendAll slotsOfArguments(arguments)
      used
    }
    .CallWitness(_, witness, _, arguments) => {
      var used = slotsOfWitness witness
      used.appendAll slotsOfArguments(arguments)
      used
    }
    .Intrinsic(_, _, arguments, _) => arguments
    .Construct(_, _, _, fields) => slotsOfArguments fields
    .Read(_, reference) => slotsOfReference reference
    // A write with no steps replaces the whole slot, so it does not *read* its base: what the slot held died at its
    // own last use, which is what lets `x = f(x)` hand the old value to the call (docs/PERFORMANCE.md, finding 1)
    .Write(reference, value) => {
      if reference.steps.isEmpty() {
        return [value.slot]
      }
      var used = slotsOfReference reference
      used.append value.slot
      used
    }
    .Tag(_, source) => [source]
    .Closure(_, _, captures, _) => {
      var used: List<Slot> = []
      for capture in captures {
        used.appendAll slotsOfCapture(capture)
      }
      used
    }
    .BoxNew(_, value) => [value.slot]
    .TraitValue(_, value, tables) => {
      var used = [value.slot]
      used.appendAll slotsOfWitnesses(tables)
      used
    }
    .ContainerNew(_, _, _) => []
    .TakeOut(_, container, key, _) => {
      var used = slotsOfReference container
      used.append key
      used
    }
    .PutBack(container, key, value, _) => {
      var used = slotsOfReference container
      used.append key
      used.append value
      used
    }
    .Panic(message, _) => [message.slot]
    .Suspend(_, awaited) => [awaited]
    .TaskNew(_, _, _, arguments) => slotsOfArguments arguments
    .ChannelNew(_, capacity, _, _) => [capacity]
  }
}

/**
 * The slot an instruction writes, if it writes one.
 *
 * A `Write` **with no steps** is one of them: it replaces the whole slot, so it defines its base rather than reading
 * it. That is what makes `x = f(x)` a move - the assignment kills the old value instead of holding it across the call
 * - and it is what makes the extended verifier report an overwrite of a slot that still owns one
 * (docs/PERFORMANCE.md, finding 1). A `Write` **with** steps changes a value that stays where it is, so it defines
 * nothing.
 */
public fn definedSlot(instruction: Instruction): Slot? {
  match instruction {
    .Constant(target, _) => Some target
    .Clear(target) => Some target
    .Move(target, _) => Some target
    .Copy(target, _) => Some target
    .Call(target, _, _, _, _) => target
    .CallClosure(target, _, _) => target
    .CallWitness(target, _, _, _) => target
    .Intrinsic(target, _, _, _) => target
    .Construct(target, _, _, _) => Some target
    .Read(target, _) => Some target
    .Tag(target, _) => Some target
    .Closure(target, _, _, _) => Some target
    .BoxNew(target, _) => Some target
    .TraitValue(target, _, _) => Some target
    .ContainerNew(target, _, _) => Some target
    .TakeOut(target, _, _, _) => Some target
    .TaskNew(target, _, _, _) => Some target
    .ChannelNew(target, _, _, _) => Some target
    .Write(reference, _) => {
      if reference.steps.isEmpty() {
        Some reference.base
      } else {
        None
      }
    }
    _ => None
  }
}

/** The slots a terminator reads: the condition of a `Branch`, the scrutinee of a `Switch`, the value of a `Return`. */
public fn usedByTerminator(terminator: Terminator): List<Slot> {
  match terminator {
    .Branch(condition, _, _) => [condition]
    .Switch(scrutinee, _, _, _) => [scrutinee]
    .Return(value) => {
      match value {
        Some(argument) => [argument.slot]
        None => []
      }
    }
    _ => []
  }
}

fn slotsOfArguments(arguments: List<Argument>): List<Slot> {
  var used: List<Slot> = []
  for argument in arguments {
    // The base of a place is the slot the argument names, and an index into it is read at the call site as well
    match argument.place {
      Some(place) => used.appendAll slotsOfReference(place)
      None => used.append argument.slot
    }
  }
  used
}

/** The base of a place and every slot that indexes into it, the base first. */
public fn slotsOfReference(reference: Reference): List<Slot> {
  var used = [reference.base]
  for step in reference.steps {
    if const .Element(_, index, _, _) = step {
      used.append index
    }
  }
  used
}

fn slotsOfWitnesses(witnesses: List<WitnessSource>): List<Slot> {
  var used: List<Slot> = []
  for witness in witnesses {
    used.appendAll slotsOfWitness(witness)
  }
  used
}

fn slotsOfWitness(witness: WitnessSource): List<Slot> {
  if const .Value(place, _) = witness.root {
    return slotsOfReference place
  }
  []
}

fn slotsOfCapture(capture: Capture): List<Slot> {
  match capture {
    .Value(slot) => [slot]
    .Boxed(slot) => [slot]
    .Place(reference) => slotsOfReference reference
  }
}

// --- Types ----------------------------------------------------------------------------------------------------------

fn verifyTypes(program: IrProgram, function: IrFunction, var found: List<String>) {
  for index in 0..function.blocks.length() {
    const at = "{function.name} b{index}"
    const block = function.blocks[index]
    for instruction in block.instructions {
      verifyInstruction program, function, found, at, instruction
    }
    if const .Return(value) = block.terminator {
      checkReturn program, function, found, at, value
    }
    if const .Stop = block.terminator {
      if function.kind != FunctionKind.TaskResume {
        found.append "{at}: only the body of a task stops as cancelled"
      }
    }
  }
}

fn verifyInstruction(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  instruction: Instruction,
) {
  match instruction {
    .Constant(target, value) => {
      if !program.hasStatic(value) {
        found.append "{at}: there is no static value s{value.value}"
        return
      }
      expectType program, function, found, at, target, program.staticAt(value).annotation, "the constant"
    }
    .Move(target, source) => expectSame program, function, found, at, target, source, "a move"
    .Copy(target, source) => expectSame program, function, found, at, target, source, "a copy"
    .Retain(slot) => expectManaged program, function, found, at, slot, "retain"
    .Release(slot) => expectManaged program, function, found, at, slot, "release"
    // Any binding may end its scope: whether its value holds a `Close` object is decided by the ownership pass
    .EndOfScope(_) => {}
    // The zero value of any type is a value of it
    .Clear(_) => {}
    .MakeUnique(reference) => {
      const annotation = typeOfReference program, function, found, at, reference
      if const Some(inner) = annotation {
        if !isManagedType(program, inner) {
          found.append "{at}: `makeUnique` needs a place that is counted, and `{describeIrType(program, inner)}` is not"
        }
      }
    }
    .Call(target, callee, arguments, witnesses, site) => {
      if !program.hasFunction(callee) {
        found.append "{at}: there is no function t{callee.value}"
        return
      }
      if const Some(location) = site {
        if !program.hasLocation(location) {
          found.append "{at}: there is no location for the call"
        }
      }
      const signature = program.functionAt(callee).signature
      const name = program.functionAt(callee).name
      verifyCall program, function, found, at, target, signature, arguments, witnesses, "`{name}`"
    }
    .CallClosure(target, callee, arguments) => {
      if !function.hasSlot(callee) {
        found.append "{at}: there is no slot %{callee.value}"
        return
      }
      const annotation = function.typeOfSlot callee
      match program.typeAt(annotation) {
        .Closure(signature) => {
          const shape = program.signatureAt signature
          verifyCall program, function, found, at, target, shape, arguments, [], "the closure in %{callee.value}"
        }
        _ => found.append "{at}: %{callee.value} is `{describeIrType(program, annotation)}` and not a closure"
      }
    }
    .CallWitness(_, witness, member, _) => {
      if member < 0 {
        found.append "{at}: a witness member index cannot be negative"
      }
      verifyWitness program, function, found, at, witness
    }
    .Intrinsic(target, intrinsic, arguments, location) => {
      if !program.hasLocation(location) {
        found.append "{at}: there is no location for the intrinsic"
      }
      verifyIntrinsic program, function, found, at, target, intrinsic, arguments
    }
    .Construct(target, layout, variant, fields) => {
      verifyConstruct program, function, found, at, target, layout, variant, fields
    }
    .Read(target, reference) => {
      const annotation = typeOfReference program, function, found, at, reference
      if const Some(inner) = annotation {
        expectType program, function, found, at, target, inner, "the place that is read"
      }
    }
    .Write(reference, value) => {
      const annotation = typeOfReference program, function, found, at, reference
      if const Some(inner) = annotation {
        expectType program, function, found, at, value.slot, inner, "the place that is written"
      }
    }
    .Tag(target, source) => {
      if !function.hasSlot(source) || !function.hasSlot(target) {
        found.append "{at}: a tag needs two slots that exist"
        return
      }
      const annotation = function.typeOfSlot source
      if !isVariantType(program, annotation) {
        found.append "{at}: `tag` needs a value of a variant layout, and %{source.value} is `{describeIrType(program, annotation)}`"
      }
      if !isIntegerType(program, function.typeOfSlot(target)) {
        found.append "{at}: a tag is an integer"
      }
    }
    .Closure(target, callee, captures, _) => {
      if !program.hasFunction(callee) {
        found.append "{at}: there is no function t{callee.value}"
        return
      }
      if !function.hasSlot(target) {
        found.append "{at}: there is no slot %{target.value}"
        return
      }
      const annotation = function.typeOfSlot target
      match program.typeAt(annotation) {
        .Closure(signature) => {
          verifyClosure program, function, found, at, callee, captures, signature
        }
        _ => found.append "{at}: a closure value is not `{describeIrType(program, annotation)}`"
      }
    }
    .BoxNew(target, value) => {
      if !function.hasSlot(target) || !function.hasSlot(value.slot) {
        found.append "{at}: a box needs two slots that exist"
        return
      }
      const annotation = function.typeOfSlot target
      match program.typeAt(annotation) {
        .Box(item) => expectType program, function, found, at, value.slot, item, "the boxed value"
        .Lazy(item) => expectType program, function, found, at, value.slot, item, "the lazy value"
        _ => found.append "{at}: %{target.value} is `{describeIrType(program, annotation)}` and not a box"
      }
    }
    .TraitValue(target, value, tables) => {
      if !function.hasSlot(target) || !function.hasSlot(value.slot) {
        found.append "{at}: a trait-typed value needs two slots that exist"
        return
      }
      const annotation = function.typeOfSlot target
      match program.typeAt(annotation) {
        .Object(bounds) => {
          if bounds.length() != tables.length() {
            found.append "{at}: `{describeIrType(program, annotation)}` has {bounds.length()} bounds and {tables.length()} witness tables were given"
          }
          for table in tables {
            verifyWitness program, function, found, at, table
          }
        }
        _ => found.append "{at}: %{target.value} is `{describeIrType(program, annotation)}` and not a trait-typed value"
      }
    }
    // A fresh container: the target has to *be* that container, and one descriptor per type argument of it
    .ContainerNew(target, kind, elements) => {
      if !function.hasSlot(target) {
        found.append "{at}: `new` needs a target slot that exists"
        return
      }
      const annotation = function.typeOfSlot target
      expectRuntime program, found, at, annotation, kind
      const arguments = match program.typeAt(annotation) {
        .Runtime(_, given) => given
        _ => []
      }
      if elements.length() != arguments.length() {
        found.append "{at}: `new` has {elements.length()} descriptors for {arguments.length()} type arguments"
        return
      }
      for index in 0..elements.length() {
        if !program.hasElement(elements[index]) {
          found.append "{at}: `new` names an element descriptor that is not in the program"
          continue
        }
        const descriptor = program.elementAt elements[index]
        if descriptor.item != arguments[index] {
          const wanted = describeIrType program, arguments[index]
          found.append "{at}: the descriptor `{descriptor.name}` is not the one of `{wanted}`"
        }
      }
    }
    .TakeOut(target, container, key, kind) => {
      const annotation = typeOfReference program, function, found, at, container
      if const Some(inner) = annotation {
        expectRuntime program, found, at, inner, kind
      }
      if !function.hasSlot(key) || !function.hasSlot(target) {
        found.append "{at}: `takeOut` needs a key slot and a target slot that exist"
      }
    }
    .PutBack(container, key, value, kind) => {
      const annotation = typeOfReference program, function, found, at, container
      if const Some(inner) = annotation {
        expectRuntime program, found, at, inner, kind
      }
      if !function.hasSlot(key) || !function.hasSlot(value) {
        found.append "{at}: `putBack` needs a key slot and a value slot that exist"
      }
    }
    .Panic(message, location) => {
      if !program.hasLocation(location) {
        found.append "{at}: there is no location for the panic"
      }
      if !function.hasSlot(message.slot) {
        found.append "{at}: there is no slot %{message.slot.value}"
        return
      }
      if !isTextType(program, function.typeOfSlot(message.slot)) {
        found.append "{at}: the message of a panic is a `String`"
      }
    }
    .Suspend(_, awaited) => {
      if function.kind != FunctionKind.TaskResume {
        found.append "{at}: only the body of a task suspends"
      }
      if !function.hasSlot(awaited) {
        found.append "{at}: there is no slot %{awaited.value}"
        return
      }
      if !isTaskValue(program, function.typeOfSlot(awaited)) {
        found.append "{at}: a task waits for a `Task`, and %{awaited.value} is `{describeIrType(program, function.typeOfSlot(awaited))}`"
      }
    }
    .TaskNew(target, resume, _, arguments) => verifyTaskNew program, function, found, at, target, resume, arguments
    .ChannelNew(target, capacity, item, location) => {
      if !program.hasElement(item) {
        found.append "{at}: there is no element descriptor d{item.value}"
      }
      if !program.hasLocation(location) {
        found.append "{at}: there is no location for the channel"
      }
      if !function.hasSlot(target) || !function.hasSlot(capacity) {
        found.append "{at}: a channel needs a target slot and a capacity slot that exist"
        return
      }
      if !isIntegerType(program, function.typeOfSlot(capacity)) {
        found.append "{at}: the capacity of a channel is an integer"
      }
      if const .Runtime(kind, _) = program.typeAt(function.typeOfSlot(target)) {
        if const .ChannelObject = kind {
          return
        }
      }
      found.append "{at}: `channelNew` makes a `Channel`, and %{target.value} is `{describeIrType(program, function.typeOfSlot(target))}`"
    }
  }
}

/**
 * `taskNew`: the resume function is one, every argument fills its parameter of the same position with the same type, and
 * the target is a `Task` - of the resume function's result, which the element descriptor describes.
 */
fn verifyTaskNew(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  target: Slot,
  resume: FunctionId,
  arguments: List<Argument>,
) {
  if !program.hasFunction(resume) {
    found.append "{at}: there is no function t{resume.value}"
    return
  }
  const started = program.functionAt resume
  if started.kind != FunctionKind.TaskResume {
    found.append "{at}: `taskNew` starts the resume function of a task, and `{started.name}` is none"
  }
  const parameters = started.signature.parameters
  if parameters.length() != arguments.length() {
    found.append "{at}: `{started.name}` takes {parameters.length()} arguments and {arguments.length()} were given"
    return
  }
  for index in 0..arguments.length() {
    expectType program, function, found, at, arguments[index].slot, parameters[index].annotation, "a frame parameter"
  }
  if !function.hasSlot(target) {
    found.append "{at}: there is no slot %{target.value}"
    return
  }
  if !isTaskValue(program, function.typeOfSlot(target)) {
    found.append "{at}: `taskNew` makes a `Task`, and %{target.value} is `{describeIrType(program, function.typeOfSlot(target))}`"
  }
}

fn isTaskValue(program: IrProgram, annotation: IrTypeId): Bool {
  if const .Runtime(kind, _) = program.typeAt(annotation) {
    if const .TaskObject = kind {
      return true
    }
  }
  false
}

fn verifyCall(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  target: Slot?,
  signature: IrSignature,
  arguments: List<Argument>,
  witnesses: List<WitnessSource>,
  callee: String,
) {
  if arguments.length() != signature.parameters.length() {
    found.append "{at}: {callee} takes {signature.parameters.length()} arguments and {arguments.length()} were given"
  } else {
    for index in 0..arguments.length() {
      const parameter = signature.parameters[index]
      if parameter.isReference {
        checkPlaceArgument program, function, found, at, arguments[index], parameter.annotation, index, callee
        continue
      }
      if arguments[index].place.isSome() {
        found.append "{at}: parameter {index} of {callee} takes a value, so argument {index} carries no place"
        continue
      }
      expectType program, function, found, at, arguments[index].slot, parameter.annotation, "argument {index}"
    }
  }
  if witnesses.length() != signature.witnesses.length() {
    found.append "{at}: {callee} takes {signature.witnesses.length()} witness tables and {witnesses.length()} were given"
  }
  for witness in witnesses {
    verifyWitness program, function, found, at, witness
  }
  const returnsNothing = isVoidType(program, signature.result) || isNeverType(program, signature.result)
  match target {
    None => {
      if !returnsNothing {
        found.append "{at}: {callee} produces `{describeIrType(program, signature.result)}` and nothing takes it"
      }
    }
    Some(slot) => {
      if returnsNothing {
        found.append "{at}: {callee} produces no value, so nothing can take one"
        return
      }
      expectType program, function, found, at, slot, signature.result, "the result"
    }
  }
}

/**
 * The argument of a `var` parameter is a **place** and not a value: it carries the whole path the callee writes through,
 * the path has to end in the type the parameter declares, and `slot` has to be the base of it - everything that walks an
 * argument reads `slot`, so a base that disagreed with the path would keep the wrong value alive.
 */
fn checkPlaceArgument(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  argument: Argument,
  wanted: IrTypeId,
  index: Int,
  callee: String,
) {
  const place = match argument.place {
    Some(inner) => inner
    None => {
      found.append "{at}: parameter {index} of {callee} is a `var` parameter, so argument {index} has to be a place"
      return
    }
  }
  if place.base != argument.slot {
    found.append "{at}: argument {index} of {callee} names %{argument.slot.value} and its place starts at %{place.base.value}"
    return
  }
  // A place carries no count, so it is never `owned`. `last` is about the *base* and not about the path: where the
  // caller's own value dies at the call (`printGraph found.checker` as the last use of `found`) the ownership pass marks
  // it and puts the `Release` after the instruction, which is the ordinary rule for a borrowed operand
  if argument.ownership != Ownership.Borrowed {
    found.append "{at}: argument {index} of {callee} is a place, which carries no count and is therefore borrowed"
  }
  const annotation = match typeOfReference(program, function, found, at, place) {
    Some(inner) => inner
    None => {
      return
    }
  }
  if annotation == wanted {
    return
  }
  const shown = describeIrType program, wanted
  found.append "{at}: parameter {index} of {callee} is `{shown}` and its place is `{describeIrType(program, annotation)}`"
}

/**
 * A closure value: the function it points at has to be callable with exactly the closure's own parameters, after the
 * **environment** that stands in front of them wherever there are captures at all.
 *
 * The environment is what ties the two halves together, so this is where a lowering that puts the wrong value into a
 * field of it, or that forgets one, is caught: one field per capture, and the type of each of them is the type of what
 * the frame handed over.
 */
fn verifyClosure(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  callee: FunctionId,
  captures: List<Capture>,
  signature: IrSignatureId,
) {
  const target = program.functionAt callee
  const shape = program.signatureAt signature
  const layout = environmentLayoutOf program, target
  const first = match layout {
    Some(_) => 1
    None => 0
  }
  if target.signature.parameters.length() != shape.parameters.length() + first {
    found.append "{at}: `{target.name}` does not take the parameters of `{describeIrType(program, resultTypeOfSignature(program, signature))}`"
    return
  }
  for index in 0..shape.parameters.length() {
    const declared = target.signature.parameters[index + first]
    const wanted = shape.parameters[index]
    if declared.annotation != wanted.annotation || declared.isReference != wanted.isReference {
      found.append "{at}: parameter {index} of `{target.name}` is not the parameter the closure type declares"
    }
  }
  if target.signature.result != shape.result {
    found.append "{at}: `{target.name}` does not answer what the closure type declares"
  }
  const fields = match layout {
    Some(inner) => program.layoutAt(inner).fields
    None => []
  }
  if fields.length() != captures.length() {
    found.append "{at}: the environment of `{target.name}` holds {fields.length()} values and {captures.length()} were captured"
    return
  }
  for index in 0..captures.length() {
    const slot = match slotOfCapture(captures[index]) {
      Some(inner) => inner
      None => {
        continue
      }
    }
    if !function.hasSlot(slot) {
      found.append "{at}: there is no slot %{slot.value}"
      continue
    }
    if function.typeOfSlot(slot) != fields[index].annotation {
      const shown = describeIrType program, fields[index].annotation
      found.append "{at}: the environment of `{target.name}` keeps `{shown}` and %{slot.value} is `{describeIrType(program, function.typeOfSlot(slot))}`"
    }
  }
}

/** A closure body is the one kind of function whose first parameter is the environment of a closure. */
fn environmentLayoutOf(program: IrProgram, target: IrFunction): LayoutId? {
  const parameter = target.signature.parameters.first()?
  const layout = layoutOfType(program, parameter.annotation)?
  if !isEnvironmentLayout(program.layoutAt(layout)) {
    return None
  }
  Some layout
}

/** The slot a capture hands over, or `None` for a place - which carries a whole path and not one value. */
fn slotOfCapture(capture: Capture): Slot? {
  match capture {
    .Value(slot) => Some slot
    .Boxed(slot) => Some slot
    .Place(_) => None
  }
}

fn resultTypeOfSignature(program: IrProgram, signature: IrSignatureId): IrTypeId {
  program.signatureAt(signature).result
}

fn verifyWitness(program: IrProgram, function: IrFunction, var found: List<String>, at: String, witness: WitnessSource) {
  match witness.root {
    .Table(table) => {
      if !program.hasWitnessTable(table) {
        found.append "{at}: there is no witness table w{table.value}"
      }
    }
    .Parameter(index) => {
      if index < 0 || index >= function.signature.witnesses.length() {
        found.append "{at}: the function has no witness parameter {index}"
      }
    }
    .Value(place, bound) => {
      if !function.hasSlot(place.base) {
        found.append "{at}: there is no slot %{place.base.value}"
        return
      }
      const annotation = match typeOfReference(program, function, found, at, place) {
        Some(inner) => inner
        None => {
          return
        }
      }
      match program.typeAt(annotation) {
        .Object(bounds) => {
          if bound < 0 || bound >= bounds.length() {
            found.append "{at}: `{describeIrType(program, annotation)}` has no bound {bound}"
          }
        }
        _ => {
          const shown = describeIrType program, annotation
          found.append "{at}: the witness of %{place.base.value} is `{shown}` and carries no witness table"
        }
      }
    }
  }
}

fn verifyConstruct(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  target: Slot,
  layout: LayoutId,
  variant: Int,
  fields: List<Argument>,
) {
  if !program.hasLayout(layout) {
    found.append "{at}: there is no layout T{layout.value}"
    return
  }
  const shape = program.layoutAt layout
  if !shape.variants.isEmpty() && !shape.hasVariant(variant) {
    found.append "{at}: `{shape.name}` has no variant {variant}"
    return
  }
  if shape.variants.isEmpty() && variant != 0 {
    found.append "{at}: `{shape.name}` is a record, so its variant is 0"
    return
  }
  const wanted = shape.fieldsOfConstruction variant
  if wanted.length() != fields.length() {
    found.append "{at}: `{shape.name}` is built from {wanted.length()} fields and {fields.length()} were given"
  } else {
    for index in 0..fields.length() {
      expectType program, function, found, at, fields[index].slot, wanted[index].annotation, "the field `{wanted[index].name}`"
    }
  }
  if !function.hasSlot(target) {
    found.append "{at}: there is no slot %{target.value}"
    return
  }
  const annotation = function.typeOfSlot target
  if layoutOfType(program, annotation) != Some(layout) {
    found.append "{at}: `{shape.name}` was built into %{target.value}, which is `{describeIrType(program, annotation)}`"
  }
}

fn verifyIntrinsic(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  target: Slot?,
  intrinsic: Intrinsic,
  arguments: List<Slot>,
) {
  const name = describeIntrinsic intrinsic
  const wanted = operandCountOf intrinsic.operation
  if wanted >= 0 && arguments.length() != wanted {
    found.append "{at}: `{name}` takes {wanted} operands and {arguments.length()} were given"
  }
  for slot in arguments {
    if !function.hasSlot(slot) {
      found.append "{at}: there is no slot %{slot.value}"
      return
    }
  }
  if needsNumericKind(intrinsic.operation) && intrinsic.kind.isNone() {
    found.append "{at}: `{name}` needs to say which numeric type it works on"
  }
  if !allowsNumericKind(intrinsic.operation) && intrinsic.kind.isSome() {
    found.append "{at}: `{name}` has only one form, so it names no numeric type"
  }
  if const .TextConcat = intrinsic.operation {
    verifyPartOperands program, function, found, at, name, arguments
  } else if isTextPartsOperation(intrinsic.operation) {
    verifyTextOperands program, function, found, at, name, arguments
  } else {
    match intrinsic.kind {
      Some(kind) => verifyOperands program, function, found, at, name, intrinsic.operation, kind, arguments
      // `==` on a `Bool`, a `Char` or `Void` names no numeric type, and then both sides have to be the same thing
      None => verifySameOperands program, function, found, at, name, arguments
    }
  }
  // `print` writes its parts and answers nothing at all, so a target would be a slot nothing could ever be put in
  if producesNoValue(intrinsic.operation) {
    if target.isSome() {
      found.append "{at}: `{name}` produces no value, and a slot was given for one"
    }
    return
  }
  match target {
    None => found.append "{at}: `{name}` produces a value and nothing takes it"
    Some(slot) => {
      if !function.hasSlot(slot) {
        found.append "{at}: there is no slot %{slot.value}"
        return
      }
      verifyIntrinsicResult program, function, found, at, name, intrinsic, arguments, slot
    }
  }
}

/**
 * Every operand of a numeric intrinsic has the type the intrinsic names - except the amount of a shift, which is an
 * `Int64` whatever is shifted, as `shiftedLeft(by: Int64)` says.
 */
fn verifyOperands(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  name: String,
  operation: IntrinsicOperation,
  kind: NumericKind,
  arguments: List<Slot>,
) {
  const isShift = isShiftOperation operation
  const isConversion = isConversionOperation operation
  for index in 0..arguments.length() {
    if isShift && index == 1 {
      expectNumeric program, function, found, at, arguments[index], NumericKind.Signed(64), name
      continue
    }
    // The operand of a conversion may be a `Char`, whose bits are an `UInt32`: `Int.from('A')` is the one that writes it
    if isConversion {
      expectConversionSource program, function, found, at, arguments[index], kind, name
      continue
    }
    expectNumeric program, function, found, at, arguments[index], kind, name
  }
}

fn isConversionOperation(operation: IntrinsicOperation): Bool {
  match operation {
    .Convert(_) => true
    _ => false
  }
}

/**
 * An equality that names no numeric type: `==` and `!=` on a `Bool`, a `Char` or `Void`, which are one instruction
 * each and have exactly one form. Both operands have to be the same type, whatever that type is.
 */
fn verifySameOperands(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  name: String,
  arguments: List<Slot>,
) {
  if arguments.length() < 2 {
    return
  }
  const first = function.typeOfSlot arguments[0]
  const second = function.typeOfSlot arguments[1]
  if first == second {
    return
  }
  const one = describeIrType program, first
  const other = describeIrType program, second
  found.append "{at}: `{name}` compares `{one}` with `{other}`"
}

fn isShiftOperation(operation: IntrinsicOperation): Bool {
  match operation {
    .ShiftedLeft => true
    .ShiftedRight => true
    _ => false
  }
}

/** The three operations whose operand list is as long as the call was written: `print`'s parts are all `String`. */
fn isTextPartsOperation(operation: IntrinsicOperation): Bool {
  match operation {
    .TextConcat | .PrintParts | .PrintErrorParts => true
    _ => false
  }
}

/** Whether an operation answers nothing at all, which is what makes a target slot wrong rather than optional. */
public fn producesNoValue(operation: IntrinsicOperation): Bool {
  match operation {
    .PrintParts | .PrintErrorParts | .ExitWithCode => true
    _ => false
  }
}

fn verifyTextOperands(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  name: String,
  arguments: List<Slot>,
) {
  for slot in arguments {
    const annotation = function.typeOfSlot slot
    if !isTextType(program, annotation) {
      found.append "{at}: `{name}` joins strings, and %{slot.value} is `{describeIrType(program, annotation)}`"
    }
  }
}

/**
 * The operands of a concatenation: a text, or a primitive the runtime writes into the result itself
 * (`textPartKindOf`). Everything else went through `Show.show` in the lowering and arrives here as a text.
 */
fn verifyPartOperands(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  name: String,
  arguments: List<Slot>,
) {
  for slot in arguments {
    const annotation = function.typeOfSlot slot
    if textPartKindOf(program, annotation).isNone() {
      const what = "a string or a value the runtime shows"
      found.append "{at}: `{name}` joins {what}, and %{slot.value} is `{describeIrType(program, annotation)}`"
    }
  }
}

/** What an intrinsic produces. Every one of them is decided by the operation, so a wrong target slot is found here. */
fn verifyIntrinsicResult(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  name: String,
  intrinsic: Intrinsic,
  arguments: List<Slot>,
  slot: Slot,
) {
  const actual = function.typeOfSlot slot
  const what = "the result of `{name}`"
  match intrinsic.operation {
    .Convert(to) => expectNumeric program, function, found, at, slot, to, name
    .TextCompare => expectInteger program, found, at, actual, what
    .TextByteLength => expectInteger program, found, at, actual, what
    .TextConcat => {
      if !isTextType(program, actual) {
        found.append "{at}: {what} is a `String`, and %{slot.value} is `{describeIrType(program, actual)}`"
      }
    }
    .LazyForce => {
      if arguments.isEmpty() {
        return
      }
      if const .Lazy(item) = program.typeAt(function.typeOfSlot(arguments[0])) {
        expectType program, function, found, at, slot, item, what
        return
      }
      found.append "{at}: `{name}` needs a lazy cell, and %{arguments[0].value} is not one"
    }
    _ => {
      if isComparisonOperation(intrinsic.operation) || isBooleanOperation(intrinsic.operation) {
        if !isBooleanType(program, actual) {
          found.append "{at}: {what} is a `Bool`, and %{slot.value} is `{describeIrType(program, actual)}`"
        }
        return
      }
      if arguments.isEmpty() {
        return
      }
      const first = function.typeOfSlot arguments[0]
      expectType program, function, found, at, slot, first, what
    }
  }
}

fn isComparisonOperation(operation: IntrinsicOperation): Bool {
  match operation {
    .Equal => true
    .NotEqual => true
    .Less => true
    .LessOrEqual => true
    .Greater => true
    .GreaterOrEqual => true
    .TextEqual => true
    _ => false
  }
}

fn isBooleanOperation(operation: IntrinsicOperation): Bool {
  match operation {
    .BooleanNot => true
    _ => false
  }
}

/** How many operands an operation takes. `-1` means "as many as there are parts": the three text-part operations. */
public fn operandCountOf(operation: IntrinsicOperation): Int {
  match operation {
    .Negate => 1
    .BitwiseNot => 1
    .BooleanNot => 1
    .Convert(_) => 1
    .TextByteLength => 1
    .LazyForce => 1
    .TextConcat => 0 - 1
    .PrintParts => 0 - 1
    .PrintErrorParts => 0 - 1
    .ExitWithCode => 1
    _ => 2
  }
}

/**
 * Whether an operation has one form per numeric type. `==` and `!=` are the two that work on the numbers *and* on
 * `Bool`, `Char` and `Void`, so for them the numeric type is optional rather than required - which is exactly what the
 * natives manifest writes down (`Int64.equals` is `equal.i64`, `Bool.equals` is `equal`).
 */
fn needsNumericKind(operation: IntrinsicOperation): Bool {
  match operation {
    // Every comparison may name no numeric type, and then both sides have to be the same thing: `Bool.equals` is
    // `equal` and the ordering of two `Char`s is `less` over two code points, neither of which is arithmetic
    .Equal | .NotEqual | .Less | .LessOrEqual | .Greater | .GreaterOrEqual => false
    _ => allowsNumericKind operation
  }
}

fn allowsNumericKind(operation: IntrinsicOperation): Bool {
  match operation {
    .BooleanNot => false
    .TextConcat => false
    .PrintParts => false
    .PrintErrorParts => false
    .ExitWithCode => false
    .TextEqual => false
    .TextCompare => false
    .TextByteLength => false
    .LazyForce => false
    _ => true
  }
}

// --- Small questions about a type ------------------------------------------------------------------------------------

fn expectSame(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  target: Slot,
  source: Slot,
  what: String,
) {
  if !function.hasSlot(target) || !function.hasSlot(source) {
    found.append "{at}: {what} needs two slots that exist"
    return
  }
  const annotation = function.typeOfSlot source
  expectType program, function, found, at, target, annotation, what
}

fn expectType(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  slot: Slot,
  wanted: IrTypeId,
  what: String,
) {
  if !function.hasSlot(slot) {
    found.append "{at}: there is no slot %{slot.value}"
    return
  }
  const actual = function.typeOfSlot slot
  if actual == wanted {
    return
  }
  found.append "{at}: {what} is `{describeIrType(program, wanted)}` and %{slot.value} is `{describeIrType(program, actual)}`"
}

/**
 * A `retain` and a `release` need a value that owns a count. That is `containsCountedType` and not `isManagedType`: an
 * inline record of two `String`s carries no count of its own but owns one on each of its fields, so retaining it
 * retains both and releasing it releases both - which is what the per-layout retain and drop functions of the runtime
 * do. `makeUnique` asks the narrower question, because only *shared* storage has to be made unique.
 */
fn expectManaged(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  slot: Slot,
  what: String,
) {
  if !function.hasSlot(slot) {
    found.append "{at}: there is no slot %{slot.value}"
    return
  }
  const annotation = function.typeOfSlot slot
  if containsCountedType(program, annotation) {
    return
  }
  found.append "{at}: `{what}` needs a value that is counted, and `{describeIrType(program, annotation)}` is not"
}

/** The operand of a conversion: the form the intrinsic names, and a `Char` where that form is its own `UInt32`. */
fn expectConversionSource(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  slot: Slot,
  kind: NumericKind,
  name: String,
) {
  if !function.hasSlot(slot) {
    found.append "{at}: there is no slot %{slot.value}"
    return
  }
  const annotation = function.typeOfSlot slot
  if conversionKindOf(program, annotation) == Some(kind) {
    return
  }
  const wanted = describeNumericKind kind
  found.append "{at}: `{name}` works on `{wanted}`, and %{slot.value} is `{describeIrType(program, annotation)}`"
}

/** A numeric operand or result: the type has to be exactly the form the intrinsic names. */
fn expectNumeric(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  slot: Slot,
  kind: NumericKind,
  name: String,
) {
  if !function.hasSlot(slot) {
    found.append "{at}: there is no slot %{slot.value}"
    return
  }
  const annotation = function.typeOfSlot slot
  if numericKindOf(program, annotation) == Some(kind) {
    return
  }
  const wanted = describeNumericKind kind
  found.append "{at}: `{name}` works on `{wanted}`, and %{slot.value} is `{describeIrType(program, annotation)}`"
}

/**
 * What numeric type a **conversion** starts from, which is the one question a `Char` answers as well: it is a `uint32_t`
 * code point (BACKEND 3.1), and `Int.from('A')` is the one conversion the language writes over one.
 *
 * It is not `numericKindOf`, and the difference is the point: a `Char` is not a number, so no arithmetic and no comparison
 * intrinsic may name a kind for one (BACKEND 5.6) - only the width of the bits a conversion moves.
 */
public fn conversionKindOf(program: IrProgram, id: IrTypeId): NumericKind? {
  if const .Character = program.typeAt(id) {
    return Some NumericKind.Unsigned(32)
  }
  numericKindOf program, id
}

/** What numeric type a value has, if it has one at all. */
public fn numericKindOf(program: IrProgram, id: IrTypeId): NumericKind? {
  match program.typeAt(id) {
    .Integer(width, isSigned) => {
      if isSigned {
        return Some NumericKind.Signed(width)
      }
      Some NumericKind.Unsigned(width)
    }
    .Floating(width) => Some NumericKind.Floating(width)
    _ => None
  }
}

fn expectInteger(program: IrProgram, var found: List<String>, at: String, annotation: IrTypeId, what: String) {
  if isIntegerType(program, annotation) {
    return
  }
  found.append "{at}: {what} is an integer, and `{describeIrType(program, annotation)}` is not"
}

fn expectRuntime(program: IrProgram, var found: List<String>, at: String, annotation: IrTypeId, kind: RuntimeKind) {
  if const .Runtime(actual, _) = program.typeAt(annotation) {
    if actual == kind {
      return
    }
  }
  found.append "{at}: the container is `{describeIrType(program, annotation)}` and not the one the step names"
}

/** The type a place has, or `None` when the path does not fit the value it starts from. */
public fn typeOfReference(
  program: IrProgram,
  function: IrFunction,
  var found: List<String>,
  at: String,
  reference: Reference,
): IrTypeId? {
  if !function.hasSlot(reference.base) {
    found.append "{at}: there is no slot %{reference.base.value}"
    return None
  }
  var current = function.typeOfSlot reference.base
  for step in reference.steps {
    const next = stepOf program, current, step
    match next {
      Some(inner) => {
        current = inner
      }
      None => {
        found.append "{at}: `{describeIrType(program, current)}` has no {describeStep(program, step)}"
        return None
      }
    }
  }
  Some current
}

fn stepOf(program: IrProgram, current: IrTypeId, step: PathStep): IrTypeId? {
  match step {
    .Field(layout, index) => {
      if layoutOfType(program, current) != Some(layout) || !program.hasLayout(layout) {
        return None
      }
      const shape = program.layoutAt layout
      if index < 0 || index >= shape.fields.length() {
        return None
      }
      Some shape.fields[index].annotation
    }
    .TupleField(layout, index) => {
      if layoutOfType(program, current) != Some(layout) || !program.hasLayout(layout) {
        return None
      }
      const shape = program.layoutAt layout
      if index < 0 || index >= shape.fields.length() {
        return None
      }
      Some shape.fields[index].annotation
    }
    .Variant(layout, variant, index) => {
      if layoutOfType(program, current) != Some(layout) || !program.hasLayout(layout) {
        return None
      }
      const shape = program.layoutAt layout
      if !shape.hasVariant(variant) {
        return None
      }
      const fields = shape.fieldsOfVariant variant
      if index < 0 || index >= fields.length() {
        return None
      }
      Some fields[index].annotation
    }
    .Element(item, _, missing, location) => {
      // The panic of an index out of range is what the step carries instead of the call it replaced, so a step that
      // cannot name it is no step at all (BACKEND 1.2)
      if !program.hasStatic(missing) || !program.hasLocation(location) {
        return None
      }
      match program.typeAt(current) {
        .FixedArray(inner, _) => if inner == item { Some item } else { None }
        .Runtime(kind, arguments) => {
          if kind != RuntimeKind.ListStorage || arguments.length() != 1 || arguments[0] != item {
            return None
          }
          Some item
        }
        _ => None
      }
    }
    .Contents(annotation) => {
      match program.typeAt(current) {
        .Box(item) => if item == annotation { Some item } else { None }
        .Lazy(item) => if item == annotation { Some item } else { None }
        .SharedObject(_) => Some annotation
        .Record(_) => Some annotation
        .Variant(_) => Some annotation
        _ => None
      }
    }
  }
}

fn describeStep(program: IrProgram, step: PathStep): String {
  match step {
    .Field(_, index) => "field {index}"
    .TupleField(_, index) => "tuple field {index}"
    .Variant(_, variant, index) => "field {index} of variant {variant}"
    .Element(_, _, _, _) => "elements"
    .Contents(_) => "contents"
  }
}

/** The layout behind a type, for a record, a variant, a tuple or a `shared type` object - `None` for anything else. */
public fn layoutOfType(program: IrProgram, id: IrTypeId): LayoutId? {
  match program.typeAt(id) {
    .Record(layout) => Some layout
    .Variant(layout) => Some layout
    .Tuple(layout) => Some layout
    .SharedObject(layout) => Some layout
    _ => None
  }
}

fn isVariantType(program: IrProgram, id: IrTypeId): Bool {
  match program.typeAt(id) {
    .Variant(_) => true
    _ => false
  }
}

fn isIntegerType(program: IrProgram, id: IrTypeId): Bool {
  match program.typeAt(id) {
    .Integer(_, _) => true
    _ => false
  }
}

fn isTextType(program: IrProgram, id: IrTypeId): Bool {
  match program.typeAt(id) {
    .Text => true
    _ => false
  }
}

fn isBooleanType(program: IrProgram, id: IrTypeId): Bool {
  match program.typeAt(id) {
    .Boolean => true
    _ => false
  }
}

fn isVoidType(program: IrProgram, id: IrTypeId): Bool {
  match program.typeAt(id) {
    .VoidType => true
    _ => false
  }
}

fn isNeverType(program: IrProgram, id: IrTypeId): Bool {
  match program.typeAt(id) {
    .NeverType => true
    _ => false
  }
}
