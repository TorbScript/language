/**
 * Ownership in the IR: which parameter takes the count, where the last use of a value is, and therefore where a `Move`
 * stands instead of a `Copy`, where a `Retain` has to, where a `Release` goes, and what is made unique before a write
 * (docs/BACKEND.md 2).
 *
 * The lowering writes phase one: every operand `Borrowed`, no `Copy` that counts, no `Release`, no `MakeUnique`. This
 * pass turns that into the final IR in three steps, none of which depends on the order the functions were lowered in:
 *
 * 1. **The summary.** Which parameters the callee *stores*, to a fixpoint over the call graph. A parameter is `Owned`
 *    when its value escapes the frame - returned, built into something, written into a place, handed on to another
 *    `Owned` position, or copied into a slot that is later written through. That last rule is what makes the participles
 *    free: `fn appended(value): Self \{ var result = self  result.append(value)  result \}` receives `self` owned, so at
 *    a call site where the receiver is dead the `Copy` is a `Move`, the count stays one, `MakeUnique` is a no-op, and
 *    `list = list.appended(x)` changes in place.
 * 2. **Liveness** over the slots the frame counts (`liveness.trb`).
 * 3. **The rewrite.** Every operand occurrence, walked backwards; a value that dies on an edge is released on that edge,
 *    and an edge that needs releases and is not the only one out of its block is split. Which positions there *are* and
 *    what each of them does with the count is `operand.trb`, and every pass here asks that one pair of functions.
 *
 * Two invariants hold everything together. **An unmanaged value is never touched**: a function without a single counted
 * slot is not even looked at, and an operand of a number, a `Bool` or an inline record of those keeps the mode phase one
 * gave it - so the arithmetic half of a program comes out of this pass byte for byte as it went in. And **a borrowed
 * parameter belongs to the caller**: it is never moved out of and never released, and where such a value is needed
 * owned it is retained.
 *
 * Getting the summary wrong costs speed and never correctness (a missing `Owned` is one copy, a superfluous one is one
 * retain), which is what makes a fixpoint over the call graph a safe thing to run at all.
 */

use IrProgram, IrFunction, FunctionKind, Ownership, Slot, SlotRole, SlotDeclaration from "./ir"
use BlockId, Block, Instruction, Terminator, Argument, Reference, IrTypeId from "./ir"
use isManagedType, containsCountedType from "./layout"
use isSharedStorage from "./capture"
use usedSlots, definedSlot, successorsOf, reachableBlocks, typeOfReference, usedByTerminator from "./verify"
use Counted, LiveSets, countedSlotsOf, holdsCountedValue, livenessOf, filledFlags from "./liveness"
use SlotFacts, Operand, slotFactsOf, operandsOf, withOperands from "./operand"
use NativeTarget, nativeEntries from "../backend/c/natives"
use Closing, closingOf from "./closing"

// --- The whole pass -------------------------------------------------------------------------------------------------

/**
 * The ownership of a whole program: the summaries first, because a call site reads the ownership of the callee's
 * parameters, then one rewrite per function. It runs after `finishProgram`, because whether a type is counted follows
 * from the representation of its layout, and a representation is only final once every layout is.
 *
 * It is written to run **exactly once** over a program. Running it twice would count the `Retain`s and `Release`s it
 * inserted itself as ordinary uses.
 */
public fn insertOwnership(var program: IrProgram) {
  summarizeParameters program
  const closing = closingOf program
  for index in 0..program.functions.length() {
    rewriteFunction program, index, closing
  }
}

// --- Phase 2: the summaries -----------------------------------------------------------------------------------------

/**
 * Which parameters of every function of the program take the count, as the least fixpoint over the call graph.
 *
 * A worklist rather than rounds over everything: a function whose summary grew re-queues its *callers*, because an
 * argument that reaches an `Owned` position is what makes the caller's own parameter escape. Ownership only ever grows
 * from `Borrowed` to `Owned`, so the fixpoint is unique and recursion - a function that calls itself is its own caller -
 * needs no special case at all.
 */
public fn summarizeParameters(var program: IrProgram) {
  const count = program.functions.length()
  if count == 0 {
    return
  }
  applyManifest program
  const erased = closureBodiesOf program
  const callers = callersOf program
  var queue: List<Int> = []
  var isQueued = filledFlags count, value: true
  for index in 0..count {
    queue.append index
  }
  var cursor = 0
  while cursor < queue.length() {
    const index = queue[cursor]
    cursor = cursor + 1
    isQueued.set index, false
    if !promoteParameters(program, index, erased[index]) {
      continue
    }
    for caller in callers[index] {
      if isQueued[caller] {
        continue
      }
      isQueued.set caller, true
      queue.append caller
    }
  }
}

/**
 * The parameters a function of the runtime stores, out of the natives manifest (BACKEND 3.7): `ArrayList.append`,
 * `Map.set`, `ArrayStack.push`. Keyed by the C symbol, because that is what a `FunctionKind.Runtime` carries - and two
 * manifest entries that map to one symbol (`ArrayList.append` and `TrieList.append` are one `torb_list_add`) agree about it
 * by construction.
 */
fn applyManifest(var program: IrProgram) {
  const owned = ownedParametersBySymbol()
  for index in 0..program.functions.length() {
    const kind = program.functions[index].kind
    if const .Runtime(symbol) = kind {
      if const Some(positions) = owned.get(symbol) {
        applyOwnedParameters program, index, positions
      }
    }
  }
}

fn ownedParametersBySymbol(): Map<String, List<Int>> {
  var found: Map<String, List<Int>> = [:]
  for entry in nativeEntries() {
    if entry.ownedParameters.isEmpty() {
      continue
    }
    if const .Runtime(symbol) = entry.target {
      found.set symbol, entry.ownedParameters
    }
  }
  found
}

fn applyOwnedParameters(var program: IrProgram, index: Int, positions: List<Int>) {
  const function = program.functions[index]
  var parameters = function.signature.parameters
  var isChanged = false
  for position in positions {
    if position < 0 || position >= parameters.length() {
      continue
    }
    const parameter = parameters[position]
    if parameter.byReference || parameter.ownership == Ownership.Owned {
      continue
    }
    // A list of numbers stores its items as bytes: there is no count to hand over, so the mode would only be noise
    if !containsCountedType(program, parameter.annotation) {
      continue
    }
    const promoted = parameter.copy ownership: Ownership.Owned
    parameters.set position, promoted
    isChanged = true
  }
  if !isChanged {
    return
  }
  const signature = function.signature.copy parameters: parameters
  const updated = function.copy signature: signature
  program.functions.set index, updated
}

/**
 * The functions a `Closure` instruction points at: closure bodies, and named functions used as a value.
 *
 * Their parameters may **never** be promoted to `Owned`. A closure is called through `CallClosure`, whose callee is a
 * *slot*, so no call site can read the summary of the function it will reach - and the type of a closure is the type of
 * every closure of its shape (BACKEND 5.8), so the signature in the type cannot answer it either. A closure body that
 * stored an argument would therefore consume a count nobody handed it, which is a double release: `Iterate.joined`
 * builds `separator + item` and was exactly that.
 *
 * It costs one copy inside a closure that really stores an argument, which is BACKEND 2.1's own rule: getting the
 * summary wrong costs speed, never correctness.
 *
 * A function a **host** calls ([IrProgram.hosted]) is the same case: the host passes words it keeps and never reads a
 * summary, so what the function stores it retains.
 */
fn closureBodiesOf(program: IrProgram): List<Bool> {
  const count = program.functions.length()
  var found = filledFlags count, value: false
  for index in 0..count {
    for block in program.functions[index].blocks {
      for instruction in block.instructions {
        if const .Closure(_, callee, _, _) = instruction {
          if callee.value >= 0 && callee.value < count {
            found.set callee.value, true
          }
        }
      }
    }
  }
  for function in program.hosted {
    if function.value >= 0 && function.value < count {
      found.set function.value, true
    }
  }
  found
}

/** Which function calls which, so that a summary that grew only wakes the call sites it can change. */
fn callersOf(program: IrProgram): List<List<Int>> {
  const count = program.functions.length()
  var callers: List<List<Int>> = []
  for _ in 0..count {
    callers.append([])
  }
  for index in 0..count {
    for block in program.functions[index].blocks {
      for instruction in block.instructions {
        if const .Call(_, callee, _, _, _) = instruction {
          if callee.value < 0 || callee.value >= count {
            continue
          }
          if callers[callee.value].contains(index) {
            continue
          }
          callers[callee.value].append(index)
        }
      }
    }
  }
  callers
}

/** One function's summary, applied. Answers whether anything became `Owned` that was not. */
fn promoteParameters(var program: IrProgram, index: Int, isErased: Bool): Bool {
  const function = program.functions[index]
  // A function of the runtime has no body to read: the manifest is the whole answer
  if const .Runtime(_) = function.kind {
    return false
  }
  // A function some `Closure` points at is reached through the erased ABI of a closure value, which borrows everything
  if isErased {
    return false
  }
  // The parameters of a resume function are the frame's: `TaskNew` moved them in, and the machine releases them
  const isTask = function.kind == FunctionKind.TaskResume
  const escaping = escapingSlots program, function
  var parameters = function.signature.parameters
  var isChanged = false
  for position in 0..parameters.length() {
    const parameter = parameters[position]
    if parameter.byReference || parameter.ownership == Ownership.Owned {
      continue
    }
    if !containsCountedType(program, parameter.annotation) {
      continue
    }
    if position >= function.slots.length() || (!escaping[position] && !isTask) {
      continue
    }
    const promoted = parameter.copy ownership: Ownership.Owned
    parameters.set position, promoted
    isChanged = true
  }
  if !isChanged {
    return false
  }
  const signature = function.signature.copy parameters: parameters
  const updated = function.copy signature: signature
  program.functions.set index, updated
  true
}

/**
 * Which slots of a function hold a value that leaves the frame. Three sources, which are exactly the three rules of
 * BACKEND 2.1: a position that takes the count (`Construct`, `BoxNew`, `TraitValue`, a store, `Return`), a parameter of
 * a callee that is already `Owned`, and a `Copy` into a slot that is written through or escapes itself.
 *
 * A slot that is *itself* written through counts too. A write through a place releases what was there before it, and the
 * value it releases has to be the frame's - so a parameter the body writes into is one the caller hands over. From
 * source that can only be a `var` parameter, which is a `Reference` and never counted at all; the rule is here because
 * the *answer* has to be right whatever built the body, not only for what the lowering happens to write.
 */
fn escapingSlots(program: IrProgram, function: IrFunction): List<Bool> {
  const slotCount = function.slots.length()
  var escapes = filledFlags slotCount, value: false
  var mutated = filledFlags slotCount, value: false
  const facts = slotFactsOf program, function
  for block in function.blocks {
    for instruction in block.instructions {
      for operand in operandsOf(program, facts, instruction) {
        if operand.takesCount {
          setFlag escapes, operand.slot
        }
      }
      markMutated mutated, instruction
    }
    if const .Return(value) = block.terminator {
      if const Some(argument) = value {
        setFlag escapes, argument.slot
      }
    }
  }
  for index in 0..slotCount {
    if mutated[index] {
      escapes.set index, true
    }
  }
  var rounds = 0
  var isChanged = true
  while isChanged {
    isChanged = false
    rounds = rounds + 1
    if rounds > slotCount + 1 {
      return escapes
    }
    for block in function.blocks {
      for instruction in block.instructions {
        if const Some(edge) = copyEdgeOf(instruction) {
          const (target, source) = edge
          if !isFlagged(escapes, target) && !isFlagged(mutated, target) {
            continue
          }
          if isFlagged(escapes, source) {
            continue
          }
          setFlag escapes, source
          isChanged = true
        }
      }
    }
  }
  escapes
}

/**
 * A slot whose storage is written through: the owner of a place, which is what `MakeUnique` needs a count of one for.
 *
 * A slot handed to a `var` parameter is one of them, because the callee writes through it. That is what makes
 * `fn f(text: String) \{ var local = text  g(local) \}` receive `text` owned: the copy into `local` reaches storage that
 * is written, so the count has to be the frame's.
 */
fn markMutated(var mutated: List<Bool>, instruction: Instruction) {
  match instruction {
    .Write(reference, _) => setFlag mutated, reference.base
    .MakeUnique(reference) => setFlag mutated, reference.base
    .TakeOut(_, container, _, _) => setFlag mutated, container.base
    .PutBack(container, _, _, _) => setFlag mutated, container.base
    .Call(_, _, arguments, _, _) => {
      for place in placesOfArguments(arguments) {
        setFlag mutated, place.base
      }
    }
    _ => {}
  }
}

/** `%4 = copy %2` and `%4 = move %2`: the edge a value travels along inside a frame. */
fn copyEdgeOf(instruction: Instruction): (Slot, Slot)? {
  match instruction {
    .Copy(target, source) => (target, source)
    .Move(target, source) => (target, source)
    _ => None
  }
}

fn setFlag(var flags: List<Bool>, slot: Slot) {
  if slot.value >= 0 && slot.value < flags.length() {
    flags.set slot.value, true
  }
}

fn isFlagged(flags: List<Bool>, slot: Slot): Bool {
  if slot.value < 0 || slot.value >= flags.length() {
    return false
  }
  flags[slot.value]
}

// --- Phase 3: one function ------------------------------------------------------------------------------------------

/** What one rewritten block is, before it goes back into the function. */
type RewrittenBlock {
  instructions: List<Instruction>
  terminator: Terminator
  /** Counted slots whose last use is the terminator itself, so their release belongs on every outgoing edge. */
  endDrops: List<Slot>
}

fn rewriteFunction(var program: IrProgram, index: Int, closing: Closing) {
  const lowered = program.functions[index]
  // A function of the runtime is a signature and nothing else, and a body nothing reaches has nothing to own
  if const .Runtime(_) = lowered.kind {
    return
  }
  if lowered.blocks.isEmpty() {
    return
  }
  // The ends of scope the whole program does not need go first, so a function without one is exactly what it was
  var original = lowered
  if hasScopeEnds(lowered) {
    original = withNeededScopeEnds program, closing, lowered
    program.functions.set index, original
  }
  const before = countedSlotsOf program, original
  // Not one counted value anywhere: the function is left exactly as the lowering wrote it, down to the bytes of its
  // text. A frame that only *borrows* one is walked, because handing a borrowed value on to a position that keeps it
  // needs a retain - which is what a closure that returns its own parameter does
  if before.isEmpty() && !holdsCountedValue(program, original) {
    return
  }
  var function = prepared program, original, before
  if hasScopeEnds(function) {
    function = resolvedScopeEnds program, function
  }
  const facts = slotFactsOf program, function
  const counted = countedSlotsOf program, function
  const live = livenessOf program, function, counted
  const reachable = reachableBlocks function
  const blockCount = function.blocks.length()
  var endDrops: List<List<Slot>> = []
  for block in 0..blockCount {
    if !reachable[block] {
      endDrops.append([])
      continue
    }
    const rewritten = rewriteBlock program, facts, counted, live, function.blocks[block], block
    function.blocks[block].instructions = rewritten.instructions
    function.blocks[block].terminator = rewritten.terminator
    endDrops.append rewritten.endDrops
  }
  const conditional = conditionalOutSlotsOf program, function
  splitEdges function, counted, live, endDrops, blockCount, conditional
  removeScopeEnds function
  program.functions.set index, function
}

/**
 * The slots a call filled through an **out parameter**, which the frame owns only where that call answered `true`.
 *
 * `torb_list_get(list, index, void *out)` writes nothing when the index is past the end, so the wrapper of the
 * `.Optional` convention (`ir/lower/native.trb`) has one slot that is defined on one of its two paths. Liveness sees an
 * ordinary definition and would release it on the edge the value was never written on - which is a release of a zeroed
 * trait-typed value, whose `w0->drop` is a null pointer. The `then` path moves the value into the `Option` it builds, so
 * excluding these slots from the edge drops is exact and not a leak.
 */
fn conditionalOutSlotsOf(program: IrProgram, function: IrFunction): List<Bool> {
  var found = filledFlags function.slots.length(), value: false
  for block in function.blocks {
    for instruction in block.instructions {
      if const .Call(_, callee, arguments, _, _) = instruction {
        if callee.value < 0 || callee.value >= program.functions.length() {
          continue
        }
        const parameters = program.functions[callee.value].signature.parameters
        for index in 0..arguments.length().min(parameters.length()) {
          if !parameters[index].out {
            continue
          }
          const slot = arguments[index].slot
          if slot.value >= 0 && slot.value < found.length() {
            found.set slot.value, true
          }
        }
      }
    }
  }
  found
}

/**
 * What has to be in place before liveness can be read: a `MakeUnique` in front of every write through a counted owner,
 * and a `Move` in front of every instruction that reads and writes one counted slot.
 *
 * The second one is not a nicety. `total = total + other` on two strings is `%2 = intrinsic textConcat %2, %1`, and the
 * old value of `%2` has to be released *after* the concatenation has read it and *before* the slot holds the new one -
 * which is impossible unless the old value has a slot of its own. `%9 = move %2` gives it one, and every rule after it
 * is the ordinary rule for a value that dies.
 */
fn prepared(program: IrProgram, function: IrFunction, counted: Counted): IrFunction {
  var built = function
  const facts = slotFactsOf program, function
  for block in 0..function.blocks.length() {
    const instructions = function.blocks[block].instructions
    var written: List<Instruction> = []
    var isChanged = false
    for at in 0..instructions.length() {
      const instruction = instructions[at]
      const owners = uniqueOwnersOf program, function, instructions, at
      if !owners.isEmpty() {
        written.appendAll owners
        isChanged = true
      }
      if const Some(slot) = conflictingSlot(instruction, counted) {
        const annotation = function.typeOfSlot slot
        built.slots.append SlotDeclaration(annotation, SlotRole.Temporary, "")
        const saved = Slot(built.slots.length() - 1)
        written.append Instruction.Move(saved, slot)
        written.append renamedUse(program, facts, instruction, slot, saved)
        isChanged = true
        continue
      }
      written.append instruction
    }
    if isChanged {
      built.blocks[block].instructions = written
    }
  }
  built
}

/**
 * The `MakeUnique`s one instruction needs: every *owner* along the path it writes through that carries a count of its
 * own, outermost first. At runtime each of them is `if (count == 1) \{ \} else \{ shallow copy, retain the children,
 * release the old \}`, so a write to a value that nobody shares costs one comparison.
 *
 * A write whose owners were already made unique is left alone, which is what a `MakeUnique` directly in front of it
 * says: the lowering (`ir/lower/place.trb`) forms the path and knows more about it than this pass can see.
 */
fn uniqueOwnersOf(
  program: IrProgram,
  function: IrFunction,
  instructions: List<Instruction>,
  at: Int,
): List<Instruction> {
  var needed: List<Instruction> = []
  const places = writtenPlacesOf instructions[at]
  if places.isEmpty() {
    return needed
  }
  if at > 0 {
    if const .MakeUnique(_) = instructions[at - 1] {
      return needed
    }
  }
  var ignored: List<String> = []
  for found in places {
    for count in 0..found.steps.length() {
      const prefix = Reference found.base, found.steps[0..count]
      const annotation = typeOfReference program, function, ignored, "", prefix
      if const Some(inner) = annotation {
        // A box and a `lazy` cell are shared on purpose: copying one is exactly what must not happen
        if isSharedStorage(program, inner) {
          continue
        }
        // Two `var` arguments of one call may share a prefix, and making the same storage unique twice is only noise
        if isManagedType(program, inner) && !needed.contains(Instruction.MakeUnique(prefix)) {
          needed.append Instruction.MakeUnique(prefix)
        }
      }
    }
  }
  needed
}

/**
 * The places an instruction writes through. `PutBack` is not one: the container it puts a value back into is the one a
 * `TakeOut` formed the path to, and that is where it was made unique.
 *
 * A **`var` argument** is one, and it is why this answers a list: the callee writes through the place, and the `var`
 * access of a call begins once every argument has been evaluated (BACKEND 2.3) - which is exactly in front of the call.
 */
fn writtenPlacesOf(instruction: Instruction): List<Reference> {
  match instruction {
    .Write(reference, _) => [reference]
    .TakeOut(_, container, _, _) => [container]
    .Call(_, _, arguments, _, _) => placesOfArguments arguments
    // `database { ... }`: a receiver closure writes through the place its `var self` argument names
    .CallClosure(_, _, arguments, _) => placesOfArguments arguments
    _ => []
  }
}

fn placesOfArguments(arguments: List<Argument>): List<Reference> {
  var places: List<Reference> = []
  for argument in arguments {
    if const Some(place) = argument.place {
      places.append place
    }
  }
  places
}

/**
 * The slot an instruction both reads and writes, when the frame counts it.
 *
 * An instruction that writes through a **place** is never one: saving the old value into a slot of its own and reading
 * the copy would leave the write pointing at the copy. The lowering keeps the result of such a call out of the base of
 * its own place for exactly that reason (`ir/lower/place.trb`), so there is nothing left to save here.
 */
fn conflictingSlot(instruction: Instruction, counted: Counted): Slot? {
  if !writtenPlacesOf(instruction).isEmpty() {
    return None
  }
  const target = definedSlot(instruction)?
  if !counted.counts(target) {
    return None
  }
  for slot in usedSlots(instruction) {
    if slot == target {
      return target
    }
  }
  None
}

/** The same instruction, reading `saved` wherever it read `slot`. Every mode stays what phase one wrote. */
fn renamedUse(program: IrProgram, facts: SlotFacts, instruction: Instruction, slot: Slot, saved: Slot): Instruction {
  var decided: List<Argument> = []
  for operand in operandsOf(program, facts, instruction) {
    if operand.slot == slot {
      decided.append Argument(saved, Ownership.Borrowed, last: false)
      continue
    }
    decided.append Argument(operand.slot, Ownership.Borrowed, last: false)
  }
  withOperands instruction, decided
}

// --- Phase 3: one block ---------------------------------------------------------------------------------------------

/**
 * One block, walked backwards from what is live when it ends. The terminator comes first because it is the last thing
 * that runs, and for every instruction the *definition* is answered before the operands - the transfer function is
 * `live before = uses union (live after minus the defined slot)`, and any other order releases the wrong value.
 */
fn rewriteBlock(
  program: IrProgram,
  facts: SlotFacts,
  counted: Counted,
  live: LiveSets,
  block: Block,
  index: Int,
): RewrittenBlock {
  var alive = live.liveOut[index]
  var endDrops: List<Slot> = []
  var tail: List<Instruction> = []
  const terminator = rewriteTerminator program, facts, counted, alive, endDrops, tail, block.terminator
  const count = block.instructions.length()
  var before: List<List<Instruction>> = []
  var after: List<List<Instruction>> = []
  var updated: List<Instruction> = []
  for position in 0..count {
    before.append([])
    after.append([])
    updated.append block.instructions[position]
  }
  var at = count - 1
  while at >= 0 {
    var retains: List<Instruction> = []
    var releases: List<Instruction> = []
    const instruction = block.instructions[at]
    const rewritten = rewriteInstruction program, facts, counted, alive, retains, releases, instruction
    updated.set at, rewritten
    before.set at, retains
    after.set at, releases
    at = at - 1
  }
  var instructions = entryReleases facts, counted, alive, index
  for position in 0..count {
    instructions.appendAll before[position]
    instructions.append updated[position]
    instructions.appendAll after[position]
  }
  instructions.appendAll tail
  RewrittenBlock instructions, terminator, endDrops
}

/**
 * A parameter the caller handed over and this body never uses is released where the body begins. It is the one place
 * where a value dies without a use to die at - everything else dies at its last one.
 */
fn entryReleases(facts: SlotFacts, counted: Counted, arriving: List<Bool>, index: Int): List<Instruction> {
  var released: List<Instruction> = []
  if index != 0 {
    return released
  }
  for position in 0..counted.width() {
    if arriving[position] {
      continue
    }
    const slot = counted.slots[position]
    if !facts.isParameter[slot.value] {
      continue
    }
    released.append Instruction.Release(slot)
  }
  released
}

fn rewriteTerminator(
  program: IrProgram,
  facts: SlotFacts,
  counted: Counted,
  var alive: List<Bool>,
  var endDrops: List<Slot>,
  var tail: List<Instruction>,
  terminator: Terminator,
): Terminator {
  match terminator {
    .Return(value) => {
      const argument = match value {
        Some(found) => found
        None => {
          return terminator
        }
      }
      var retains: List<Instruction> = []
      var releases: List<Instruction> = []
      const operand = Operand argument.slot, true, true, retainsItself: false
      const answer = decideOperand program, facts, counted, alive, retains, releases, operand
      // Nothing can follow a `return`, and a value that is returned is never released: only a retain can land here
      tail.appendAll retains
      markAlive alive, counted, argument.slot
      Terminator.Return answer
    }
    // A condition and a scrutinee are read and nothing else, so their last use is the end of the block
    .Branch(condition, _, _) => {
      dropAtEnd counted, alive, endDrops, condition
      terminator
    }
    .Switch(scrutinee, _, _, _) => {
      dropAtEnd counted, alive, endDrops, scrutinee
      terminator
    }
    _ => terminator
  }
}

fn dropAtEnd(counted: Counted, var alive: List<Bool>, var endDrops: List<Slot>, slot: Slot) {
  const position = counted.positionOf slot
  if position < 0 {
    return
  }
  if !alive[position] {
    endDrops.append slot
  }
  alive.set position, true
}

/**
 * One instruction: the ownership of every operand, the retains that have to run before it and the releases that have to
 * run after it. `retains` and `releases` come out in evaluation order although the walk is backwards, because the text
 * of a block should read the way it runs.
 */
fn rewriteInstruction(
  program: IrProgram,
  facts: SlotFacts,
  counted: Counted,
  var alive: List<Bool>,
  var retains: List<Instruction>,
  var releases: List<Instruction>,
  instruction: Instruction,
): Instruction {
  const operands = operandsOf program, facts, instruction
  // A panic runs nothing at all: no retain, no release, and what it read is left behind
  if const .Panic(_, _) = instruction {
    for operand in operands {
      markAlive alive, counted, operand.slot
    }
    return instruction
  }
  const defined = definedSlot instruction
  var isDeadDefinition = false
  if const Some(target) = defined {
    const position = counted.positionOf target
    if position >= 0 {
      isDeadDefinition = !alive[position]
      alive.set position, false
    }
  }
  var decided: List<Argument> = []
  for operand in operands {
    decided.append Argument(operand.slot, Ownership.Borrowed, last: false)
  }
  var taken: List<Instruction> = []
  var dropped: List<Instruction> = []
  var at = operands.length() - 1
  while at >= 0 {
    const operand = operands[at]
    const answer = decideOperand program, facts, counted, alive, taken, dropped, operand
    decided.set at, answer
    markAlive alive, counted, operand.slot
    at = at - 1
  }
  retains.appendAll reversedInstructions(taken)
  releases.appendAll reversedInstructions(dropped)
  // `const _ = text.trimmed()`: a value nobody takes is dead where it is made
  if isDeadDefinition {
    if const Some(target) = defined {
      releases.append Instruction.Release(target)
    }
  }
  withOperands instruction, decided
}

/**
 * What one operand occurrence becomes. The whole of BACKEND 2.1 in one function:
 *
 * - unmanaged: nothing at all, and the mode phase one wrote stays;
 * - a position that takes the count, at the last use of a value the frame owns: a `Move`;
 * - a position that takes the count, anywhere else: a `Retain` - unless the instruction is its own retain, which a
 *   `Copy` is;
 * - a position that borrows, at the last use: the borrow stays and a `Release` follows the instruction.
 *
 * A value the frame does not own - a borrowed parameter, a `var` path - has no last use here at all: the caller keeps
 * its count for the whole call, so it is never moved out of and never released, and where it is needed owned it is
 * retained.
 *
 * A slot that holds a **static** value is the one that needs neither. Its count is the immortal sentinel, so a retain
 * and a release of it do nothing at run time; the position keeps the mode it asks for and no instruction is inserted
 * around it (`immortalSlotsOf` in `liveness.trb`, docs/PERFORMANCE.md finding 11).
 */
fn decideOperand(
  program: IrProgram,
  facts: SlotFacts,
  counted: Counted,
  alive: List<Bool>,
  var retains: List<Instruction>,
  var releases: List<Instruction>,
  operand: Operand,
): Argument {
  const slot = operand.slot
  if !facts.isCountedSlot(slot) {
    return Argument slot, Ownership.Borrowed, last: false
  }
  if counted.isImmortal(slot) {
    if !operand.takesCount {
      return Argument slot, Ownership.Borrowed, last: false
    }
    return Argument slot, Ownership.Owned, last: false
  }
  const position = counted.positionOf slot
  const isLast = position >= 0 && !alive[position]
  if !operand.takesCount {
    if isLast {
      releases.append Instruction.Release(slot)
    }
    return Argument slot, Ownership.Borrowed, isLast
  }
  if isLast && operand.canMove {
    return Argument slot, Ownership.Owned, last: true
  }
  if !operand.retainsItself {
    retains.append Instruction.Retain(slot)
  }
  if isLast {
    releases.append Instruction.Release(slot)
  }
  Argument slot, Ownership.Owned, last: false
}

fn markAlive(var alive: List<Bool>, counted: Counted, slot: Slot) {
  const position = counted.positionOf slot
  if position >= 0 {
    alive.set position, true
  }
}

fn reversedInstructions(instructions: List<Instruction>): List<Instruction> {
  var reversed: List<Instruction> = []
  var at = instructions.length() - 1
  while at >= 0 {
    reversed.append instructions[at]
    at = at - 1
  }
  reversed
}

// --- Phase 3: the edges ---------------------------------------------------------------------------------------------

/**
 * `drops(B -> S) = liveOut(B) minus liveIn(S)`: the values that are still owned when a block ends and that the block it
 * goes to does not need. With one successor they go at the end of the block; with several the edge is **split** into a
 * block that holds the releases and a `Jump`.
 *
 * This is the whole mechanism for the early exits. A `return` in the middle of a loop, a `break`, a `continue`, the arms
 * of an `if` that bind different things: every one of them is an ordinary edge with its own drop set, and nothing
 * special is written for any of them. The new blocks are appended in block order and, inside a block, in the order the
 * terminator writes its targets, so the graph is a function of the graph and not of a traversal.
 */
fn splitEdges(
  var function: IrFunction,
  counted: Counted,
  live: LiveSets,
  endDrops: List<List<Slot>>,
  blockCount: Int,
  conditional: List<Bool>,
) {
  for block in 0..blockCount {
    const targets = successorsOf function.blocks[block]
    if targets.isEmpty() {
      continue
    }
    if targets.length() == 1 {
      // A `jump` reads nothing, so a release at the end of the block is on the edge
      const drops = dropsOnEdge counted, live, endDrops, block, targets[0], conditional
      for slot in drops {
        function.blocks[block].instructions.append(Instruction.Release(slot))
      }
      continue
    }
    for position in 0..targets.length() {
      const drops = dropsOnEdge counted, live, endDrops, block, targets[position], conditional
      if drops.isEmpty() {
        continue
      }
      var instructions: List<Instruction> = []
      for slot in drops {
        instructions.append Instruction.Release(slot)
      }
      const at = function.blocks[block].at
      const jump = Terminator.Jump BlockId(targets[position])
      function.blocks.append Block(instructions, jump, "drop", at)
      const added = BlockId(function.blocks.length() - 1)
      const replaced = withEdge function.blocks[block].terminator, position, added
      function.blocks[block].terminator = replaced
    }
  }
}

fn dropsOnEdge(
  counted: Counted,
  live: LiveSets,
  endDrops: List<List<Slot>>,
  block: Int,
  target: Int,
  conditional: List<Bool>,
): List<Slot> {
  var drops: List<Slot> = []
  if target >= 0 && target < live.liveIn.length() {
    const leaving = live.liveOut[block]
    const arriving = live.liveIn[target]
    for position in 0..counted.width() {
      if leaving[position] && !arriving[position] {
        const slot = counted.slots[position]
        if slot.value < conditional.length() && conditional[slot.value] {
          continue
        }
        drops.append slot
      }
    }
  }
  drops.appendAll endDrops[block]
  drops
}

/** One edge of a terminator, in the order `successorsOf` writes them: a switch's targets first, `otherwise` last. */
fn withEdge(terminator: Terminator, position: Int, block: BlockId): Terminator {
  match terminator {
    .Jump(_) => Terminator.Jump block
    .Branch(condition, then, otherwise) => {
      if position == 0 {
        return Terminator.Branch condition, block, otherwise
      }
      Terminator.Branch condition, then, block
    }
    .Switch(scrutinee, values, targets, otherwise) => {
      if position >= targets.length() {
        return Terminator.Switch scrutinee, values, targets, block
      }
      var replaced = targets
      replaced.set position, block
      Terminator.Switch scrutinee, values, replaced, otherwise
    }
    _ => terminator
  }
}

// --- The ends of scopes ---------------------------------------------------------------------------------------------

/*
 * A binding whose value may hold a `Close` object is released at the end of its scope, in reverse declaration order
 * (docs/design/DESTRUCTORS.md 2a), and the lowering wrote an `EndOfScope` for it at every way out of its block. Here
 * each of them becomes what it means:
 *
 * - where the value is still owned, the `EndOfScope` stays and is an ordinary use - the last one, so the rewrite puts
 *   the `Release` right after it, and the next one's release after that;
 * - where a move already took it - returned, stored, handed to a callee that keeps it - there is nothing left to
 *   release, and it goes, so the move stays a move;
 * - where some paths moved it and others did not, the binding keeps every one of its ends, and the moves on those
 *   paths become retains: the slot is its own drop flag, and a flag it cannot have is paid for with one count.
 *
 * Which operands are moves is what the rewrite would decide without the ends of scope, so it is asked of the body
 * without them; the ends that stay come after every such move on every path, which is what keeps each move a move.
 */

fn hasScopeEnds(function: IrFunction): Bool {
  for block in function.blocks {
    for instruction in block.instructions {
      if const .EndOfScope(_) = instruction {
        return true
      }
    }
  }
  false
}

/** The body without the ends of scope of bindings the program does not need them for: nothing they hold closes. */
fn withNeededScopeEnds(program: IrProgram, closing: Closing, function: IrFunction): IrFunction {
  const counted = countedSlotsOf program, function
  var built = function
  for index in 0..function.blocks.length() {
    var kept: List<Instruction> = []
    var isChanged = false
    for instruction in function.blocks[index].instructions {
      if const .EndOfScope(slot) = instruction {
        if !counted.counts(slot) || !closing.holds(function.typeOfSlot(slot)) {
          isChanged = true
          continue
        }
      }
      kept.append instruction
    }
    if isChanged {
      built.blocks[index].instructions = kept
    }
  }
  built
}

/** What becomes of the ends of scope, decided over the prepared body: kept where the value is owned, gone where moved. */
fn resolvedScopeEnds(program: IrProgram, original: IrFunction): IrFunction {
  const function = withClearedTemporaries program, original
  const states = scopeStatesOfBody program, function
  // A binding that is moved on one path and not on another keeps all of its ends
  var isPinned = filledFlags function.slots.length(), value: false
  for block in 0..function.blocks.length() {
    const instructions = function.blocks[block].instructions
    for at in 0..instructions.length() {
      if const .EndOfScope(slot) = instructions[at] {
        if states[block][at] == stateMixed {
          isPinned.set slot.value, true
        }
      }
    }
  }
  var built = function
  for block in 0..function.blocks.length() {
    const instructions = function.blocks[block].instructions
    var kept: List<Instruction> = []
    var isChanged = false
    for at in 0..instructions.length() {
      const instruction = instructions[at]
      if const .EndOfScope(slot) = instruction {
        const state = states[block][at]
        const isKept = state == stateOwned || state == stateMixed || (isPinned[slot.value] && state == stateMoved)
        if !isKept {
          isChanged = true
          continue
        }
      }
      kept.append instruction
    }
    if isChanged {
      built.blocks[block].instructions = kept
    }
  }
  built
}

/** The state of every scoped binding at every `EndOfScope` of the body, over the moves the rewrite would make. */
fn scopeStatesOfBody(program: IrProgram, function: IrFunction): List<List<Int>> {
  const stripped = withoutScopeEnds function
  const facts = slotFactsOf program, stripped
  const counted = countedSlotsOf program, stripped
  const live = livenessOf program, stripped, counted
  const moves = movesOf program, facts, counted, live, stripped
  scopeStatesOf function, moves
}

/**
 * A temporary that only some paths of its statement make - the arm of an `if` expression, the fallback of a `??` - is
 * still released at the end of that statement (docs/design/DESTRUCTORS.md 2a). The slot is its own drop flag: it is
 * cleared where the function begins, so a path that never made the temporary reaches the end with the zero value and
 * releases nothing, and cleared again after an end inside a loop, so the next turn finds it empty and not holding what
 * that end already released. The end is then owned on every path, and the ordinary rule turns it into the release.
 *
 * A type whose zero value cannot be released - one that holds a trait-typed value inline, which has no table to take
 * the drop function from - keeps the old answer: no end, and a release at the last use.
 */
fn withClearedTemporaries(program: IrProgram, function: IrFunction): IrFunction {
  const states = scopeStatesOfBody program, function
  var isPartial = filledFlags function.slots.length(), value: false
  var slots: List<Slot> = []
  for block in 0..function.blocks.length() {
    const instructions = function.blocks[block].instructions
    for at in 0..instructions.length() {
      if const .EndOfScope(slot) = instructions[at] {
        if states[block][at] == statePartial && !isPartial[slot.value] {
          if isClearable(program, function.typeOfSlot(slot)) {
            isPartial.set slot.value, true
            slots.append slot
          }
        }
      }
    }
  }
  if slots.isEmpty() {
    return function
  }
  var built = function
  for block in 0..function.blocks.length() {
    var written: List<Instruction> = []
    if block == 0 {
      for slot in slots {
        written.append Instruction.Clear(slot)
      }
    }
    // Only an end that control can come back to needs the slot emptied behind it
    const isRepeated = isOnCycle function, block
    for instruction in function.blocks[block].instructions {
      written.append instruction
      if const .EndOfScope(slot) = instruction {
        if isPartial[slot.value] && isRepeated {
          written.append Instruction.Clear(slot)
        }
      }
    }
    built.blocks[block].instructions = written
  }
  built
}

/** Whether a block can be reached again from itself: whether it is inside a loop. */
fn isOnCycle(function: IrFunction, start: Int): Bool {
  var isSeen = filledFlags function.blocks.length(), value: false
  var pending: List<Int> = []
  for target in successorsOf(function.blocks[start]) {
    pending.append target
  }
  var cursor = 0
  while cursor < pending.length() {
    const block = pending[cursor]
    cursor = cursor + 1
    if block == start {
      return true
    }
    if isSeen[block] {
      continue
    }
    isSeen.set block, true
    for target in successorsOf(function.blocks[block]) {
      pending.append target
    }
  }
  false
}

/**
 * Whether the zero value of a type can be released: a null pointer, which every release of the runtime passes over, or
 * a trait-typed value whose release the C back end guards. A trait-typed value held inline in a record or a case has
 * no such guard, because the release of the aggregate is one helper for every value of its layout.
 */
fn isClearable(program: IrProgram, id: IrTypeId): Bool {
  if const .Object(_) = program.typeAt(id) {
    return true
  }
  isZeroReleasable program, id, 0
}

fn isZeroReleasable(program: IrProgram, id: IrTypeId, depth: Int): Bool {
  if depth > 16 || !program.hasType(id) {
    return false
  }
  match program.typeAt(id) {
    .Object(_) => false
    .Record(layout) | .Tuple(layout) | .Variant(layout) => {
      const shape = program.layouts[layout.value]
      if const .Boxed = shape.representation {
        return true
      }
      shape.fields.all({ isZeroReleasable(program, _.annotation, depth + 1) })
    }
    .FixedArray(item, _) => isZeroReleasable(program, item, depth + 1)
    _ => true
  }
}

fn withoutScopeEnds(function: IrFunction): IrFunction {
  var built = function
  for index in 0..function.blocks.length() {
    var kept: List<Instruction> = []
    for instruction in function.blocks[index].instructions {
      if const .EndOfScope(_) = instruction {
        continue
      }
      kept.append instruction
    }
    built.blocks[index].instructions = kept
  }
  built
}

/** Every `EndOfScope` left after the rewrite: each one stood where a release now follows it, or nothing had to. */
fn removeScopeEnds(var function: IrFunction) {
  if !hasScopeEnds(function) {
    return
  }
  function = withoutScopeEnds function
}

/**
 * What a scoped binding is at one point: no path reached it yet, never defined on the way here, owned, moved out, owned
 * on some paths and moved on others, or defined on some paths only. The last one keeps no end at all: the value is
 * released at its last use, as it would be without one, because an end there would release what one path never made.
 */
const stateUnreached = 0 - 1
const stateUndefined = 0
const stateOwned = 1
const stateMoved = 2
const stateMixed = 3
const statePartial = 4

fn joinedState(left: Int, right: Int): Int {
  if left == stateUnreached || left == right {
    return right
  }
  if right == stateUnreached {
    return left
  }
  if left == stateUndefined || right == stateUndefined || left == statePartial || right == statePartial {
    return statePartial
  }
  stateMixed
}

/**
 * The slots the rewrite would move out of, per block and per instruction of the body without ends of scope: the same
 * backwards walk as [rewriteBlock], asking [decideOperand] and keeping only the answer "owned, last".
 */
fn movesOf(
  program: IrProgram,
  facts: SlotFacts,
  counted: Counted,
  live: LiveSets,
  function: IrFunction,
): List<List<List<Slot>>> {
  var found: List<List<List<Slot>>> = []
  for index in 0..function.blocks.length() {
    const block = function.blocks[index]
    var perInstruction: List<List<Slot>> = []
    for _ in block.instructions {
      perInstruction.append([])
    }
    var alive = live.liveOut[index]
    for slot in usedByTerminator(block.terminator) {
      markAlive alive, counted, slot
    }
    var at = block.instructions.length() - 1
    while at >= 0 {
      const instruction = block.instructions[at]
      const operands = operandsOf program, facts, instruction
      if const .Panic(_, _) = instruction {
        for operand in operands {
          markAlive alive, counted, operand.slot
        }
        at = at - 1
        continue
      }
      if const Some(target) = definedSlot(instruction) {
        const position = counted.positionOf target
        if position >= 0 {
          alive.set position, false
        }
      }
      var moved: List<Slot> = []
      var position = operands.length() - 1
      while position >= 0 {
        const operand = operands[position]
        var ignoredRetains: List<Instruction> = []
        var ignoredReleases: List<Instruction> = []
        const answer = decideOperand program, facts, counted, alive, ignoredRetains, ignoredReleases, operand
        if answer.ownership == Ownership.Owned && answer.last {
          moved.append operand.slot
        }
        markAlive alive, counted, operand.slot
        position = position - 1
      }
      perInstruction.set at, moved
      at = at - 1
    }
    found.append perInstruction
  }
  found
}

/**
 * The state of every scoped binding at every `EndOfScope`, by block and by instruction (the entry of any other
 * instruction is `stateUndefined` and unused): a forward walk from the entry to a fixpoint, where a definition makes a
 * binding owned, a move makes it moved, and two paths that disagree make it mixed - or partial, where one of them never
 * defined it.
 */
fn scopeStatesOf(function: IrFunction, moves: List<List<List<Slot>>>): List<List<Int>> {
  const slotCount = function.slots.length()
  const blockCount = function.blocks.length()
  var entering: List<List<Int>> = []
  for index in 0..blockCount {
    // The entry is where nothing is defined yet; every other block is unreached until a path arrives
    const initial = if index == 0 { stateUndefined } else { stateUnreached }
    entering.append filledStates(slotCount, initial)
  }
  var isQueued = filledFlags blockCount, value: false
  var queue: List<Int> = []
  if blockCount > 0 {
    queue.append 0
    isQueued.set 0, true
  }
  var cursor = 0
  while cursor < queue.length() {
    const index = queue[cursor]
    cursor = cursor + 1
    isQueued.set index, false
    const leaving = walkedBlock(function, moves, index, entering[index]).leaving
    for target in successorsOf(function.blocks[index]) {
      var joined = entering[target]
      var isChanged = false
      for slot in 0..slotCount {
        const state = joinedState joined[slot], leaving[slot]
        if state != joined[slot] {
          joined.set slot, state
          isChanged = true
        }
      }
      if !isChanged {
        continue
      }
      entering.set target, joined
      if !isQueued[target] {
        isQueued.set target, true
        queue.append target
      }
    }
  }
  var found: List<List<Int>> = []
  for index in 0..blockCount {
    found.append walkedBlock(function, moves, index, entering[index]).seen
  }
  found
}

fn filledStates(count: Int, state: Int): List<Int> {
  var filled: List<Int> = []
  for _ in 0..count {
    filled.append state
  }
  filled
}

/** One block, walked forwards: the states it leaves, and the state each of its instructions sees. */
type WalkedBlock {
  leaving: List<Int>
  /** Per instruction: the state of the slot of an `EndOfScope`, and `stateUndefined` for every other one. */
  seen: List<Int>
}

fn walkedBlock(function: IrFunction, moves: List<List<List<Slot>>>, index: Int, entering: List<Int>): WalkedBlock {
  var states = entering
  var seen: List<Int> = []
  var stripped = 0
  for instruction in function.blocks[index].instructions {
    if const .EndOfScope(slot) = instruction {
      seen.append states[slot.value]
      continue
    }
    seen.append stateUndefined
    for slot in moves[index][stripped] {
      states.set slot.value, stateMoved
    }
    if const Some(target) = definedSlot(instruction) {
      if target.value >= 0 && target.value < states.length() {
        states.set target.value, stateOwned
      }
    }
    stripped = stripped + 1
  }
  WalkedBlock states, seen
}
