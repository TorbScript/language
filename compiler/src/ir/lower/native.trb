use Span from "../../syntax/source"
use SymbolId from "../../semantics/symbols"
use TypeId, ParameterId from "../../semantics/checker/type"
use signatureOf from "../../semantics/checker/signature"
use NativeEntry, NativeResult from "../../backend/c/natives"
use IrType, IrTypeId, IrSignature, FunctionId, LayoutId, Slot, BlockId, LocationId from "../ir"
use StaticContents from "../ir"
use Reference, WitnessSource, Instruction, Terminator, Argument, borrowed, referenced from "../ir"
use FunctionBuilder, newFunction, addTemporary, addBlock, emit, terminate, switchTo from "../build"
use terminateBlock, finishFunction, setBlockLocation from "../build"
use layoutOfType from "../verify"
use nativeWrapperName from "../mangle"
use symbolPathOf from "../instantiate"
use RuntimeShape, runtimeFunctionShaped, instanceArgumentsOf, irSignatureUnder from "../instances"
use Lowering, reportUnsupported, locationOf, irTypeOfClosed, internStatic from "./context"
use variantLayoutOfType, variantNamed from "./match"

/**
 * The two conventions of `runtime/`, and the wrapper the lowering builds around them.
 *
 * A function of the runtime may not build a layout of the *program* (BACKEND 5.R1), and there is exactly **one** C list
 * and one C hash table for every element type (3.1). So two things differ between what `std/` declares and what the
 * runtime offers, and the manifest writes both of them down per entry:
 *
 * - an `Option` or a `Result` result becomes `bool` plus an out parameter (`torb_list_get`, `torb_text_index_of`,
 *   `torb_parse_i64`),
 * - an element of a container is passed **by address**, because the runtime spells it `const void *`
 *   (`torb_list_add`, `torb_map_set`).
 *
 * Where either applies, a call does not reach the runtime symbol directly: it reaches a generated **wrapper** of the
 * program, whose signature is exactly what the declaration says and whose body is the call plus the `Construct` of the
 * `Option` or the `Result`. That keeps the knowledge of the conventions in this one file, keeps `Instruction.Call` an
 * ordinary call for every pass after the lowering, and gives a witness table a function to point at.
 *
 * The wrapper is built in full where it is first needed rather than through the worklist: its body mentions nothing but
 * the runtime function and the layouts of its own result, so it cannot need an instance that is not there yet.
 */

/**
 * The function a call of a `.Runtime` native reaches: the runtime symbol itself where the declaration *is* its ABI, and
 * the generated wrapper otherwise.
 */
public fn nativeFunctionOf(
  var lowering: Lowering,
  member: SymbolId,
  mapping: Map<ParameterId, TypeId>,
  entry: NativeEntry,
  symbol: String,
  at: Span,
): FunctionId? {
  const shape = runtimeShapeOf lowering, member, mapping, entry
  if !needsWrapper(entry) {
    return runtimeFunctionShaped lowering, member, symbol, mapping, shape
  }
  const arguments = match instanceArgumentsOf(lowering, member, mapping) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`{entry.name}`, whose declaration is not monomorphic", at
      return None
    }
  }
  const path = symbolPathOf lowering.checker, member
  const name = nativeWrapperName lowering.program, path, arguments
  if const Some(found) = lowering.nativeWrappers.get(name) {
    return Some found
  }
  const raw = match runtimeFunctionShaped(lowering, member, symbol, mapping, shape) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`{entry.name}`, whose declaration is not monomorphic", at
      return None
    }
  }
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  const declared = irSignatureUnder lowering, signature, mapping
  buildWrapper lowering, name, member, declared, raw, entry, at
}

/**
 * Whether the runtime's own ABI differs from the declaration at all - and therefore whether `nativeFunctionOf` answers a
 * function of the *program* (a wrapper, which a witness table may point at) or the bare runtime symbol (which it may not,
 * because a thunk calls a mangled name and a `FunctionKind.Runtime` has none in C).
 */
public fn needsNativeWrapper(entry: NativeEntry): Bool {
  needsWrapper entry
}

/** Whether the runtime's own ABI differs from the declaration at all. */
fn needsWrapper(entry: NativeEntry): Bool {
  if !entry.addressedParameters.isEmpty() {
    return true
  }
  match entry.result {
    .Direct => false
    _ => true
  }
}

/** The shape the manifest gives one entry, with the out parameters read off the declared result. */
fn runtimeShapeOf(
  var lowering: Lowering,
  member: SymbolId,
  mapping: Map<ParameterId, TypeId>,
  entry: NativeEntry,
): RuntimeShape {
  if const .Direct = entry.result {
    return RuntimeShape entry.addressedParameters, []
  }
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  const declared = irSignatureUnder lowering, signature, mapping
  var annotations: List<IrTypeId> = []
  for out in outParametersOf(lowering, declared, isPartsResult(entry)) {
    annotations.add out.annotation
  }
  RuntimeShape entry.addressedParameters, annotations
}

/**
 * Whether the runtime writes one out parameter **per field of the payload** instead of one for the payload itself: the
 * third convention, which the map and the set cursor need. A `(Key, Value)` is a layout of the *program* and the two
 * halves of an entry live in two arrays of the table, so nothing could write one in a single piece.
 */
fn isPartsResult(entry: NativeEntry): Bool {
  if const .OptionalParts = entry.result {
    return true
  }
  false
}

/** One out parameter: what the runtime writes through it, and which field of the result it is. */
type OutParameter {
  /** The field of the failure type it fills, or `out` for the payload of the success case. */
  name: String
  annotation: IrTypeId
}

/**
 * The out parameters of a `.Optional` or a `.Fallible` native, in the order the runtime takes them.
 *
 * 1. The **payload** of the success case - unless it is `Void`, which is no value the runtime could write:
 *    `File.writeText` answers `Result<Void, IoError>` and its symbol takes no out for it.
 * 2. One per field of the **failure** type that no parameter of the declaration names. That is exactly the `message`
 *    of every `IoError` of `std/fs`: its `path` *is* the parameter `path`, and the reason is something only the
 *    operating system knows. `Int.parse` needs none of them - `NumberParseError(text)` is the parameter `text`.
 *
 * An `Option` has no failure fields at all (`None` carries nothing), so for one this is the payload alone, which is
 * what the first round of 5.7 built.
 *
 * `isSplit` is the third convention: the payload is a **tuple** the runtime cannot write in one piece, so it takes one out
 * parameter per field of it and the wrapper builds the tuple (`torb_map_entry_after` writes a key and a value).
 */
fn outParametersOf(var lowering: Lowering, declared: IrSignature, isSplit: Bool): List<OutParameter> {
  var found: List<OutParameter> = []
  const layout = match variantLayoutOfType(lowering, declared.result) {
    Some(inner) => inner
    None => {
      return found
    }
  }
  const shape = lowering.program.layoutAt layout
  const success = successVariantOf lowering, layout
  if success >= 0 {
    if const Some(first) = shape.fieldsOfVariant(success).first() {
      if !isVoidResult(lowering, first.annotation) {
        if isSplit {
          found.addAll payloadParametersOf(lowering, first.annotation)
        } else {
          found.add OutParameter("out", first.annotation)
        }
      }
    }
  }
  const failure = failureVariantOf lowering, layout
  if failure < 0 {
    return found
  }
  const carried = match shape.fieldsOfVariant(failure).first() {
    Some(inner) => inner
    None => {
      return found
    }
  }
  const errorLayout = match layoutOfType(lowering.program, carried.annotation) {
    Some(inner) => inner
    None => {
      return found
    }
  }
  const errorShape = lowering.program.layoutAt errorLayout
  if !errorShape.variants.isEmpty() {
    return found
  }
  for field in errorShape.fields {
    if parameterNamed(declared, field.name) < 0 {
      found.add OutParameter(field.name, field.annotation)
    }
  }
  found
}

/** `Some` of an `Option`, `Ok` of a `Result`. */
fn successVariantOf(var lowering: Lowering, layout: LayoutId): Int {
  const some = variantNamed lowering, layout, "Some"
  if some >= 0 {
    return some
  }
  variantNamed lowering, layout, "Ok"
}

/** `None` of an `Option`, `Fail` of a `Result`. */
fn failureVariantOf(var lowering: Lowering, layout: LayoutId): Int {
  const none = variantNamed lowering, layout, "None"
  if none >= 0 {
    return none
  }
  variantNamed lowering, layout, "Fail"
}

/**
 * The body of one wrapper: the call of the runtime function, and where its result is an `Option` or a `Result`, the
 * branch that turns `bool` plus the out parameter into the two cases.
 */
fn buildWrapper(
  var lowering: Lowering,
  name: String,
  member: SymbolId,
  declared: IrSignature,
  raw: FunctionId,
  entry: NativeEntry,
  at: Span,
): FunctionId? {
  var builder = newFunction name, Some(member), declared, "native wrapper"
  const location = declarationLocationOf lowering, member
  setBlockLocation builder, BlockId(0), Some(location)
  var given: List<Argument> = []
  for index in 0..declared.parameters.length() {
    // A `var self` is a place; an element the runtime takes by address stays an ordinary value operand, and the emitter
    // takes its address off the callee's signature - it carries a count and a place does not
    if declared.parameters[index].isReference {
      given.add referenced(Reference(Slot(index), []))
      continue
    }
    given.add borrowed(Slot(index))
  }
  const empty: List<WitnessSource> = []
  if const .Direct = entry.result {
    directWrapperBody lowering, builder, declared, raw, given, location
    const direct = finishFunction lowering.program, builder
    lowering.nativeWrappers.set name, direct
    return Some direct
  }
  const layout = match variantLayoutOfType(lowering, declared.result) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`{entry.name}`, whose result is not an `Option` or a `Result`", at
      return None
    }
  }
  const success = successVariantOf lowering, layout
  const failure = failureVariantOf lowering, layout
  if success < 0 || failure < 0 {
    reportUnsupported lowering, "`{entry.name}`, whose result has no success and no failure case", at
    return None
  }
  const outs = outParametersOf lowering, declared, isPartsResult(entry)
  var slots: List<Slot> = []
  for out in outs {
    const slot = addTemporary builder, out.annotation
    slots.add slot
    given.add referenced(Reference(slot, []))
  }
  const boolean = lowering.program.internType IrType.Boolean
  const answered = addTemporary builder, boolean
  const target = addTemporary builder, declared.result
  emit builder, Instruction.Call(Some(answered), raw, given, empty, Some(location))
  const good = addBlock builder, "then", Some(location)
  const bad = addBlock builder, "else", Some(location)
  const done = addBlock builder, "done", Some(location)
  terminate builder, Terminator.Branch(answered, good, bad)
  switchTo builder, good
  const built = match successConstruct(lowering, builder, layout, success, outs, slots, location) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`{entry.name}`, whose result carries no payload", at
      return None
    }
  }
  emit builder, Instruction.Construct(target, layout, success, built)
  terminate builder, Terminator.Jump(done)
  switchTo builder, bad
  if !failureConstruct(lowering, builder, declared, target, layout, failure, outs, slots, entry, at) {
    return None
  }
  terminate builder, Terminator.Jump(done)
  switchTo builder, done
  terminate builder, Terminator.Return(Some(borrowed(target)))
  const added = finishFunction lowering.program, builder
  lowering.nativeWrappers.set name, added
  Some added
}

/**
 * Where the `native fn` itself is written. One wrapper serves every call of one native, so taking the location from
 * whichever call site the worklist reached first would make the output depend on the traversal - and a location reaches
 * the generated C as a `#line`, which the fixpoint of milestone 6 compares byte for byte.
 */
fn declarationLocationOf(var lowering: Lowering, member: SymbolId): LocationId {
  const outer = lowering.module
  if const Some(site) = lowering.checker.siteOf(member) {
    lowering.module = site.module
  }
  const at = lowering.checker.symbolAt(member).span
  const location = locationOf lowering, at
  lowering.module = outer
  location
}

/** A wrapper that only has to pass an element by address: one call, and the result straight through. */
fn directWrapperBody(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  declared: IrSignature,
  raw: FunctionId,
  given: List<Argument>,
  location: LocationId,
) {
  const empty: List<WitnessSource> = []
  if isVoidResult(lowering, declared.result) {
    emit builder, Instruction.Call(None, raw, given, empty, Some(location))
    terminate builder, Terminator.Return(None)
    return
  }
  const target = addTemporary builder, declared.result
  emit builder, Instruction.Call(Some(target), raw, given, empty, Some(location))
  terminate builder, Terminator.Return(Some(borrowed(target)))
}

fn isVoidResult(var lowering: Lowering, annotation: IrTypeId): Bool {
  if const .VoidType = lowering.program.typeAt(annotation) {
    return true
  }
  false
}

/**
 * The failing case. `None` carries nothing; the `Fail` of a `Result` carries the error the declaration names, and the
 * runtime gives nothing for it - so the wrapper builds it from the error type's own **fields, each taken from the
 * parameter of the same name**: `Int.parse(text)` fails with `NumberParseError(text)`. An error type with a field no
 * parameter names is a clean finding and no guess.
 */
/**
 * The successful case: the payload out where there is one, and the one value of `Void` where the declaration answers
 * `Result<Void, _>` - a `Void` is no value the runtime writes, so the wrapper makes it.
 */
fn successConstruct(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  layout: LayoutId,
  success: Int,
  outs: List<OutParameter>,
  slots: List<Slot>,
  location: LocationId,
): List<Argument>? {
  const shape = lowering.program.layoutAt layout
  const fields = shape.fieldsOfVariant success
  if fields.isEmpty() {
    return Some([])
  }
  const annotation = fields[0].annotation
  if isVoidResult(lowering, annotation) {
    const slot = addTemporary builder, annotation
    const value = internStatic lowering, StaticContents.VoidValue, annotation
    emit builder, Instruction.Constant(slot, value)
    return Some([borrowed(slot)])
  }
  const at = outIndexOf outs, "out"
  if at < 0 {
    // The runtime wrote the payload in pieces (`.OptionalParts`), so the **tuple** is built here: it is a layout of the
    // program, which is exactly why the runtime could not answer it
    return builtPayload lowering, builder, annotation, outs, slots
  }
  Some([borrowed(slots[at])])
}

/** The payload of a `.OptionalParts` native: one `Construct` of the tuple out of the out parameters, in their order. */
fn builtPayload(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  payload: IrTypeId,
  outs: List<OutParameter>,
  slots: List<Slot>,
): List<Argument>? {
  const inner = layoutOfType(lowering.program, payload)?
  var parts: List<Argument> = []
  for index in 0..outs.length() {
    if outs[index].name.startsWith("out") && outs[index].name != "out" {
      parts.add borrowed(slots[index])
    }
  }
  if parts.isEmpty() {
    return None
  }
  const built = addTemporary builder, payload
  emit builder, Instruction.Construct(built, inner, 0, parts)
  Some([borrowed(built)])
}

/**
 * One out parameter per field of a payload the runtime writes in pieces. They are named after the field's position, and
 * `out0` is deliberately not `out`: `successConstruct` tells the two conventions apart by exactly that name.
 */
fn payloadParametersOf(var lowering: Lowering, payload: IrTypeId): List<OutParameter> {
  var found: List<OutParameter> = []
  const layout = match layoutOfType(lowering.program, payload) {
    Some(inner) => inner
    None => {
      return found
    }
  }
  const fields = lowering.program.layoutAt(layout).fields
  for index in 0..fields.length() {
    found.add OutParameter("out{index}", fields[index].annotation)
  }
  found
}

/** The out parameter of this name, or -1. */
fn outIndexOf(outs: List<OutParameter>, name: String): Int {
  for index in 0..outs.length() {
    if outs[index].name == name {
      return index
    }
  }
  -1
}

fn failureConstruct(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  declared: IrSignature,
  target: Slot,
  layout: LayoutId,
  failure: Int,
  outs: List<OutParameter>,
  slots: List<Slot>,
  entry: NativeEntry,
  at: Span,
): Bool {
  const shape = lowering.program.layoutAt layout
  const fields = shape.fieldsOfVariant failure
  if fields.isEmpty() {
    emit builder, Instruction.Construct(target, layout, failure, [])
    return true
  }
  const error = fields[0].annotation
  const errorLayout = match layoutOfType(lowering.program, error) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`{entry.name}`, whose failure type has no layout", at
      return false
    }
  }
  const errorShape = lowering.program.layoutAt errorLayout
  if !errorShape.variants.isEmpty() {
    reportUnsupported lowering, "`{entry.name}`, whose failure type has cases of its own", at
    return false
  }
  var parts: List<Argument> = []
  for field in errorShape.fields {
    const found = parameterNamed declared, field.name
    if found >= 0 {
      parts.add borrowed(Slot(found))
      continue
    }
    // What no parameter names is what the runtime wrote through an out parameter of its own: the `message`
    const written = outIndexOf outs, field.name
    if written < 0 {
      const what = "`{entry.name}`, whose failure needs a `{field.name}` the runtime does not answer"
      reportUnsupported lowering, what, at
      return false
    }
    parts.add borrowed(slots[written])
  }
  const value = addTemporary builder, error
  emit builder, Instruction.Construct(value, errorLayout, 0, parts)
  emit builder, Instruction.Construct(target, layout, failure, [borrowed(value)])
  true
}

/** The index of the parameter of this name, or -1. */
fn parameterNamed(declared: IrSignature, name: String): Int {
  for index in 0..declared.parameters.length() {
    if declared.parameters[index].name == name {
      return index
    }
  }
  -1
}
