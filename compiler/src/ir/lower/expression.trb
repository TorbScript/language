/**
 * Every expression of the monomorphic part of the language, as instructions over numbered slots.
 *
 * `destination` is a hint and not a contract: where the caller already has a slot for the value - a local it is bound
 * to, the result of the `if` both arms produce - the value is computed *into* that slot, and only a value that is
 * already somewhere else is copied. That is what keeps one value to one defining slot, which is what the ownership
 * pass needs, and it is why the arms of an `if` need no phi node and no join instruction.
 *
 * Evaluation order is source order, always (docs/BACKEND.md, Evaluation order is only half specified): the receiver
 * first, then the arguments in written order, then the defaults. Nothing here reorders anything -
 * `Adaptation.Reorder` is replayed by moving finished slots into their parameter positions, never by evaluating out
 * of order.
 */

use Span from "../../syntax/source"
use Expression, Argument, TextSegment, Condition, Block, Binding from "../../syntax/ast"
use PrefixOperator, InfixOperator from "../../syntax/ast"
use SymbolId from "../../semantics/symbols"
use ModuleId from "../../semantics/module"
use TypeId, LiteralValue from "../../semantics/checker/type"
use Adaptation, BindingId from "../../semantics/checker/context"
use IrTypeId, IrType, Slot, BlockId, LocationId, Instruction, Terminator, Reference, PathStep from "../ir"
use FunctionId, FunctionKind, IrSignature, WitnessSource, borrowed from "../ir"
use Intrinsic, IntrinsicOperation, NumericKind, StaticContents, LayoutId from "../ir"
use FunctionBuilder, addTemporary, addBlock, emit, newFunction, finishFunction, setBlockLocation from "../build"
use numericKindOf, layoutOfType from "../verify"
use describeIrType from "../print"
use bindingOfSite, signatureOf from "../../semantics/checker/signature"
use evaluateConstant, staticOfConstant from "../constant"
use functionName, mangledName from "../mangle"
use symbolPathOf from "../instantiate"
use Lowering, reportUnsupported, locationOf, typeAtSpan, voidTypeOf from "./context"
use internStatic, isNeverType, isVoidType, finishBlock, continueIn, irTypeOfClosed from "./context"
use lowerCall, lowerOperator, lowerConstruct, lowerCaseValue from "./call"
use objectTypeOf, lowerTraitValue, closedBounds from "./generic"
use lowerBlockInto from "./statement"
use lowerListLiteral, lowerMapLiteral, lowerIndexRead from "./collection"
use lowerMatch, lowerIfBinding, lowerTry, lowerCoalesce, lowerOptionalMember from "./match"
use variantLayoutOfType from "./match"
use lowerClosureValue, lowerNamedFunctionValue, lowerForcedRead, bindingReferenceOf from "./closure"
use savedFrame, restoreFrame, enterBody from "./closure"
use lowerConstructorValue from "./closure"
use lowerTextLiteral, showsHere from "./text"

/** One expression, lowered into `destination` where the caller has a slot for it, or into a fresh one otherwise. */
public fn lowerExpression(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  expression: Expression,
  destination: Slot?,
): Slot {
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const annotation = match typeAtSpan(lowering, expression.span) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "an expression without a type", expression.span
    }
  }
  if !canReplayAdaptations(lowering, expression) {
    return abandonedSlot lowering, builder, destination
  }
  // `Adaptation.ToTraitValue`: the value is computed first and then boxed with one witness pointer per bound
  const bounds = traitValueBoundsOf lowering, expression
  if !bounds.isEmpty() {
    if !closedBounds(lowering, bounds, expression.span) {
      return abandonedSlot lowering, builder, destination
    }
    return lowerCoercedValue lowering, builder, destination, expression, annotation, bounds
  }
  lowerInnerExpression lowering, builder, expression, destination, annotation
}

/**
 * The value an expression produces before anything the checker recorded around it applies. Split out so that a coercion
 * has somewhere to put the value it wraps, and so that nothing has to be lowered twice.
 */
fn lowerInnerExpression(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  expression: Expression,
  destination: Slot?,
  annotation: IrTypeId,
): Slot {
  // Every literal, including a negated one, is static data: the checker already decided which type it adapted to
  if isLiteralExpression(expression) {
    return lowerLiteral lowering, builder, destination, expression
  }
  // `a?.m` and `a?.m(...)` are control flow over the `Option`, and the member is lowered inside the arm that has a value
  if const Some(chain) = optionalChainOf(lowering, expression) {
    return lowerOptionalMember lowering, builder, destination, expression, chain.base, chain.member, annotation
  }
  match expression.kind {
    .Name(_) | .Member(_, _, _) | .ImplicitMember(_) => {
      lowerReference lowering, builder, destination, expression, annotation
    }
    .Call(callee, arguments, _) => lowerCall lowering, builder, destination, expression, callee, arguments, annotation
    .Unary(operator, operand) => lowerUnary lowering, builder, destination, expression, operator, operand, annotation
    .Binary(operator, left, right) => {
      lowerBinary lowering, builder, destination, expression, operator, left, right, annotation
    }
    .If(condition, then, otherwise) => {
      lowerIf lowering, builder, destination, expression, condition, then, otherwise, annotation
    }
    .Block(block) => {
      const target = valueSlot lowering, builder, destination, annotation
      lowerBlockInto lowering, builder, block, Some(target)
      target
    }
    .TupleLiteral(items) => lowerTuple lowering, builder, destination, items, annotation, expression.span
    .Index(target, index) => lowerIndexRead lowering, builder, destination, expression, target, index, annotation
    .ListLiteral(items) => lowerListLiteral lowering, builder, destination, expression, items, annotation
    .MapLiteral(entries) => lowerMapLiteral lowering, builder, destination, expression, entries, annotation
    .RangeLiteral(from, to, isInclusive) => {
      lowerRangeLiteral lowering, builder, destination, from, to, isInclusive, annotation, expression.span
    }
    .Try(inner) => lowerTry lowering, builder, destination, expression, inner, annotation
    .Closure(closure) => {
      lowerClosureValue lowering, builder, destination, expression, closure, annotation
    }
    .Match(subject, arms) => lowerMatch lowering, builder, destination, expression, subject, arms, annotation
    .Generic(_, _) => unsupportedSlot lowering, builder, destination, "a generic call", expression.span
    .TextLiteral(segments) => {
      lowerTextLiteral lowering, builder, destination, expression, segments, annotation
    }
    _ => unsupportedSlot lowering, builder, destination, "an expression the front end rejected", expression.span
  }
}

/**
 * The base and the member of a `?.`, where this expression is one and it has not been unwrapped yet. `a?.m` is the member
 * itself, `a?.m(...)` the call around it, and both are lowered once - `lowerOptionalMember` puts the payload in place of
 * the base and lowers the very same expression again, which is what the entry in `optionalReceivers` says.
 */
fn optionalChainOf(var lowering: Lowering, expression: Expression): OptionalChain? {
  const member = match optionalMemberOf(expression) {
    Some(found) => found
    None => {
      return None
    }
  }
  if lowering.optionalReceivers.containsKey(member.base.span) {
    return None
  }
  Some member
}

/** `a?.m` written on its own, or as the callee of a call. */
fn optionalMemberOf(expression: Expression): OptionalChain? {
  if const .Member(base, name, isOptional) = expression.kind {
    if isOptional {
      return Some OptionalChain(base, name.span)
    }
    return None
  }
  if const .Call(callee, _, _) = expression.kind {
    if const .Member(base, name, isOptional) = callee.kind {
      if isOptional {
        return Some OptionalChain(base, name.span)
      }
    }
  }
  None
}

type OptionalChain {
  base: Expression
  /** The span of the member's name, which is where the checker recorded whether it answers an `Option` already. */
  member: Span
}

/** The value of an expression that nothing has a slot for yet. */
public fn lowerValue(var lowering: Lowering, var builder: FunctionBuilder, expression: Expression): Slot {
  lowerExpression lowering, builder, expression, None
}

/**
 * The value of an expression **without** the coercion to a trait-typed value the checker recorded at it.
 *
 * One caller: an argument of `print`, whose declared parameter is `Show` and which is therefore coerced. Boxing the
 * value only to read the table back out of the box would cost one allocation per argument, while the type of the value
 * itself already says which `show` runs - so the shown parts of a `print` are free, and a value that is trait typed to
 * begin with is unaffected (there the table is the only answer there is).
 */
public fn lowerUncoercedValue(var lowering: Lowering, var builder: FunctionBuilder, expression: Expression): Slot {
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, None
  }
  const annotation = match typeAtSpan(lowering, expression.span) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, None, "an expression without a type", expression.span
    }
  }
  if !canReplayAdaptations(lowering, expression) {
    return abandonedSlot lowering, builder, None
  }
  lowerInnerExpression lowering, builder, expression, None, annotation
}

/** The bounds `Adaptation.ToTraitValue` recorded at an expression, or an empty list where it recorded none. */
fn traitValueBoundsOf(var lowering: Lowering, expression: Expression): List<TypeId> {
  const module = lowering.module
  const adaptations = lowering.checker.adaptationsAt module, expression.span
  for adaptation in adaptations {
    if const .ToTraitValue(bounds, _) = adaptation {
      return bounds
    }
  }
  []
}

/**
 * A value that becomes a trait-typed value: the payload is boxed and one witness pointer per bound goes with it. The
 * tables are static data of the program, unless the value is already trait typed - `Show & Hash` narrowed to `Show` -
 * in which case they are the ones it already carries.
 */
fn lowerCoercedValue(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  annotation: IrTypeId,
  bounds: List<TypeId>,
): Slot {
  const inner = lowerInnerExpression lowering, builder, expression, None, annotation
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const object = objectTypeOf lowering, bounds
  const source = match lowering.checker.expressionType(lowering.module, expression.span) {
    Some(found) => found
    None => {
      const what = "a value used as a trait-typed value without a type"
      return unsupportedSlot lowering, builder, destination, what, expression.span
    }
  }
  const target = valueSlot lowering, builder, destination, object
  if !lowerTraitValue(lowering, builder, target, inner, bounds, source, expression.span) {
    return abandonedSlot lowering, builder, destination
  }
  target
}

// --- Slots ----------------------------------------------------------------------------------------------------------

/** The slot an expression produces into: the one the caller asked for, or a temporary of its own. */
public fn valueSlot(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  annotation: IrTypeId,
): Slot {
  // `Never` has no values, so a slot may not have that type: the expression diverges and nothing reads this one
  const inner = if isNeverType(lowering, annotation) { voidTypeOf lowering } else { annotation }
  if const Some(slot) = destination {
    // The one `Void` slot of the function is the **wrong** hint for a value that is not `Void`. An `if` used as a
    // statement has the type `Void`, so both of its arms produce into that one slot - and an arm whose last expression
    // answers a value nobody takes (`parser.bump()`, whose `Token` is discarded) was then a call of a `Token` into a
    // `Void` slot, which the verifier rejects. Every other disagreement is deliberate: `?.` lowers its member into a slot
    // of the *payload* type while the expression it lowers is the `Option` around it.
    if isVoidType(lowering, builder.typeOfSlot(slot)) && !isVoidType(lowering, inner) {
      return addTemporary builder, inner
    }
    return slot
  }
  addTemporary builder, inner
}

/** A value that is already in a slot, moved into the destination where the caller asked for one. */
public fn copiedInto(var builder: FunctionBuilder, destination: Slot?, source: Slot): Slot {
  if const Some(slot) = destination {
    if slot != source {
      emit builder, Instruction.Copy(slot, source)
    }
    return slot
  }
  source
}

/** A construct the lowering does not translate yet: reported once, and the function becomes an `unreachable` stub. */
public fn unsupportedSlot(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  what: String,
  at: Span,
  because: String = "",
): Slot {
  reportUnsupported lowering, what, at, because
  abandonedSlot lowering, builder, destination
}

/**
 * A slot for a value nobody takes: the result of a statement, and everything in a body that is being walked only to
 * get out of it. One `Void` slot per function is enough for all of them, because nothing ever reads one.
 */
public fn abandonedSlot(var lowering: Lowering, var builder: FunctionBuilder, destination: Slot?): Slot {
  if const Some(slot) = destination {
    return slot
  }
  if const Some(known) = lowering.hole {
    return known
  }
  const annotation = voidTypeOf lowering
  const made = addTemporary builder, annotation
  lowering.hole = Some made
  made
}

// --- Adaptations ----------------------------------------------------------------------------------------------------

/**
 * Whether every adaptation the checker recorded for this expression can be replayed here. The ones that cannot are
 * named one by one rather than as "an adaptation", because each of them is unsupported for a different reason.
 */
fn canReplayAdaptations(var lowering: Lowering, expression: Expression): Bool {
  const at = expression.span
  const module = lowering.module
  const adaptations = lowering.checker.adaptationsAt module, at
  // `?` converts the error out of the very adaptation this would refuse, and a `??` inlines the thunk of its fallback
  const convertsItself = isTryExpression expression
  const inlinesThunk = lowering.inlinedThunks.containsKey at
  // `assert` lowers its condition as the ordinary expression it was checked as, and owns the message of a failure
  const inlinesQuotation = lowering.inlinedQuotations.containsKey at
  // An interpolated part and an argument of `print` are shown by `ir/lower/text.trb`, which records the span first
  const isShown = showsHere lowering, at
  for adaptation in adaptations {
    const blocked = match adaptation {
      .Convert(_, _) => if convertsItself { "" } else { "a conversion through `From`" }
      .ShowValue(_) => if isShown { "" } else { "a value shown outside of an interpolation" }
      .Delegate(_) => "`by` delegation"
      .Lazy => if inlinesThunk { "" } else { "a `lazy` argument" }
      .Quote(_) => if inlinesQuotation { "" } else { "a quoted expression" }
      .Spread => ""
      .Variadic(_, _) => ""
      _ => ""
    }
    if !blocked.isEmpty() {
      reportUnsupported lowering, blocked, at
      return false
    }
  }
  true
}

// --- Literals -------------------------------------------------------------------------------------------------------

fn isTryExpression(expression: Expression): Bool {
  match expression.kind {
    .Try(_) => true
    _ => false
  }
}

/** Whether the whole expression is one literal: the four kinds, a plain text, and a negated number. */
public fn isLiteralExpression(expression: Expression): Bool {
  match expression.kind {
    .IntegerLiteral(_) | .FloatLiteral(_) | .BoolLiteral(_) | .CharLiteral(_) | .VoidLiteral => true
    .TextLiteral(segments) => isPlainText segments
    .Unary(operator, operand) => {
      if const .Negate = operator {
        return isNumberLiteral operand
      }
      false
    }
    _ => false
  }
}

fn isPlainText(segments: List<TextSegment>): Bool {
  for segment in segments {
    if const .Interpolated(_) = segment {
      return false
    }
  }
  true
}

fn isNumberLiteral(operand: Expression): Bool {
  match operand.kind {
    .IntegerLiteral(_) | .FloatLiteral(_) => true
    _ => false
  }
}

fn lowerLiteral(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
): Slot {
  const value = match evaluateConstant(lowering, expression) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a literal the back end cannot read", expression.span
    }
  }
  constantSlot lowering, builder, destination, value.contents, value.annotation
}

/** A slot that holds one static value. Two literals of the same value are one static, whatever they are written in. */
public fn constantSlot(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  contents: StaticContents,
  annotation: IrTypeId,
): Slot {
  const identifier = internStatic lowering, contents, annotation
  const target = valueSlot lowering, builder, destination, annotation
  emit builder, Instruction.Constant(target, identifier)
  target
}

/** An integer of a known type as static data: the step of a `for`, the zero a text comparison is compared against. */
public fn integerSlot(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  value: Int,
  annotation: IrTypeId,
): Slot {
  const contents = StaticContents.Literal LiteralValue.Integer(value)
  constantSlot lowering, builder, None, contents, annotation
}

/**
 * The one value of `Void`, in a slot. A construct whose result is `Void` still has to *define* what it produced, or a
 * later read of the slot would be a read of nothing - and the verifier says so.
 */
public fn voidSlot(var lowering: Lowering, var builder: FunctionBuilder, destination: Slot?): Slot {
  const annotation = voidTypeOf lowering
  constantSlot lowering, builder, destination, StaticContents.VoidValue, annotation
}

// --- Names, fields and tuple positions ------------------------------------------------------------------------------

/** A name or a member path read as a value: a local, a compile-time constant, a field, or a position of a tuple. */
fn lowerReference(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  annotation: IrTypeId,
): Slot {
  const module = lowering.module
  const resolution = match lowering.checker.resolutionAt(module, expression.span) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a name the checker did not resolve", expression.span
    }
  }
  match resolution {
    .Local(binding) => lowerLocalRead lowering, builder, destination, expression, binding, annotation
    .Constant(symbol, _) => lowerConstantReference lowering, builder, destination, symbol, expression.span
    .Field(_, field) => lowerFieldRead lowering, builder, destination, expression, field, annotation
    .TupleField(_, index) => lowerTupleRead lowering, builder, destination, expression, index, annotation
    .Callable(symbol, _, _) => {
      lowerNamedFunctionValue lowering, builder, destination, expression, symbol, annotation
    }
    .CaseOf(owner, variant) => lowerCaseValue lowering, builder, destination, expression, owner, variant, annotation
    // `byPath.get(path).map(ModuleId)`: the constructor itself, as a function value
    .Construct(_) => lowerConstructorValue lowering, builder, destination, expression, 0, annotation
    _ => unsupportedSlot lowering, builder, destination, "a name the back end does not lower yet", expression.span
  }
}

/**
 * A local, a parameter, a binding of a pattern, a parameter of a closure, or a binding a closure shares through its box.
 *
 * Three of them are not a plain slot. An **implicit closure parameter** (`_`, `_2`, a name the expected function type
 * gives) is reached by the position `Adaptation.ImplicitParameter` names, because the checker declares every one of them
 * under the span of the closure itself. A **captured `var` binding** lives in a box the frame shares with the closure,
 * so reading it is a `Read` through that place. And a **`lazy` parameter** is a cell, so reading it forces it.
 */
fn lowerLocalRead(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  binding: BindingId,
  annotation: IrTypeId,
): Slot {
  const at = expression.span
  const declared = lowering.checker.binding(binding).at
  if const Some(position) = implicitParameterOf(lowering, at) {
    /*
     * The position is one of the *innermost* closure's parameters. Where the binding was declared under another
     * closure's span the name means an implicit parameter of a closure around this one, which the checker records no
     * capture for - it declares the binding when the name is first used, which is already inside the inner closure - so
     * reading it by position would silently read the wrong parameter.
     */
    if lowering.closureAt != Some(declared) {
      const what = "a closure that captures an implicit parameter of a closure around it"
      return unsupportedSlot lowering, builder, destination, what, at
    }
    match lowering.closureParameters.get(position) {
      Some(found) => {
        return copiedInto builder, destination, found
      }
      None => {
        const what = "an implicit closure parameter the back end cannot place"
        return unsupportedSlot lowering, builder, destination, what, at
      }
    }
  }
  if const Some(place) = bindingReferenceOf(lowering, builder, declared) {
    const target = valueSlot lowering, builder, destination, annotation
    emit builder, Instruction.Read(target, place)
    return target
  }
  const slot = match lowering.slots.get(declared) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a captured binding", at
    }
  }
  if forcesLazy(lowering, at) {
    return lowerForcedRead lowering, builder, destination, slot, annotation, at
  }
  copiedInto builder, destination, slot
}

/** The position `Adaptation.ImplicitParameter` names at this span, in the order the *declaration* counts parameters. */
fn implicitParameterOf(var lowering: Lowering, at: Span): Int? {
  const module = lowering.module
  const adaptations = lowering.checker.adaptationsAt module, at
  for adaptation in adaptations {
    if const .ImplicitParameter(position) = adaptation {
      return Some position
    }
  }
  None
}

/** Whether reading this name forces a `lazy` cell, which is what `Adaptation.Force` says (TYPECHECKER 3.4). */
fn forcesLazy(var lowering: Lowering, at: Span): Bool {
  const module = lowering.module
  const adaptations = lowering.checker.adaptationsAt module, at
  for adaptation in adaptations {
    if const .Force = adaptation {
      return true
    }
  }
  false
}

fn lowerConstantReference(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  symbol: SymbolId,
  at: Span,
): Slot {
  // A top-level binding of the entry file is a local of the entry function, not a static value
  if const Some(slot) = lowering.entryLocals.get(symbol.value) {
    return copiedInto builder, destination, slot
  }
  if isVarBinding(lowering, symbol) {
    const what = "a top-level `var` read from a function"
    return unsupportedSlot lowering, builder, destination, what, at
  }
  const identifier = match staticOfConstant(lowering, symbol) {
    Some(found) => found
    None => {
      return lowerImmortalConstant lowering, builder, destination, symbol, at
    }
  }
  const annotation = lowering.program.staticAt(identifier).annotation
  const target = valueSlot lowering, builder, destination, annotation
  emit builder, Instruction.Constant(target, identifier)
  target
}

/**
 * A top-level `const` whose value is **not static data**, as one **immortal counted static**: one block per constant,
 * built once by an initializer of its own, never freed, and a read of the constant is a call of the accessor.
 *
 * Static data is what has an immortal C spelling: a number, a `Bool`, a `Char`, a text, and an inline aggregate of
 * those. A collection literal is a counted heap block, a case of a `Boxed` variant type is a counted heap block, and
 * `"a" + "b"` is a call of `Add.add` - so `const knownFields: List<String> = [...]`, `CExpression.Literal "NULL"` and a
 * source built out of pieces have no static value the emitter could write, whatever the evaluator does.
 *
 * **Built once, at the first read.** The language says there is no module initialization, ever, and a lazily built
 * immortal keeps that promise: nothing runs before `main`, the order of the reads decides nothing, and a `const` no path
 * reads is never built at all. What makes it unobservable is the checker's own rule (docs/TYPECHECKER.md, What exactly is
 * "compile-time evaluable"?): the initializer is **pure** - literals, the operators of the number types, interpolation,
 * collection literals, constructor calls and other constants, and never a function call - so it has no side effect whose
 * order anything could see, and values have no identity, so no reader can tell one list from an equal one.
 *
 * **Immortal, and what that costs.** The value is built inside an immortal region (`torb_begin_immortal`), so every block
 * it is made of - and every temporary the initializer made on the way - is born with the immortal count: a retain and a
 * release of it are no-ops, a write to it copies, and none of them is ever freed. That is a fixed number of blocks per
 * program, counted apart from the live ones, which is what keeps `live blocks at exit: 0` exact.
 *
 * Two constructs need exactly this shape, so they are one mechanism: a module `const` here, and the static
 * `ExpressionNode` tree of a quotation.
 *
 * In an entry file or a test file a top-level `const` is a **local of the entry function** and never reaches this, so the
 * purity rule not applying there costs nothing.
 */
fn lowerImmortalConstant(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  symbol: SymbolId,
  at: Span,
): Slot {
  const accessor = match constantAccessorOf(lowering, symbol, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const annotation = lowering.program.functionAt(accessor).signature.result
  const target = valueSlot lowering, builder, destination, annotation
  const location = locationOf lowering, at
  const empty: List<WitnessSource> = []
  emit builder, Instruction.Call(Some(target), accessor, [], empty, Some(location))
  target
}

/**
 * The accessor of one constant, built the first time the constant is read. One per declaration, however many modules
 * read it: the cell is the value of the constant and not of the read.
 *
 * The initializer is lowered **here** rather than through the worklist, because a construct the back end does not
 * translate yet has to abandon the body that reads the constant - which is what the reader's `isSupported` carries, and
 * what a worklist entry drained later could not reach any more.
 */
fn constantAccessorOf(var lowering: Lowering, symbol: SymbolId, at: Span): FunctionId? {
  if const Some(known) = lowering.constantCells.get(symbol.value) {
    return Some known
  }
  const site = match lowering.checker.siteOf(symbol) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a constant the checker did not declare", at
      return None
    }
  }
  const binding = match bindingOfSite(site) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a constant without an initializer", at
      return None
    }
  }
  // A constant in terms of itself is a cycle the checker reports; stopping here keeps the lowering from recursing on one
  if lowering.inlinedConstants.containsKey(symbol.value) {
    reportUnsupported lowering, "a constant that names itself", at
    return None
  }
  const declared = match constantTypeOf(lowering, symbol) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a constant whose type the checker did not decide", at
      return None
    }
  }
  const path = symbolPathOf lowering.checker, symbol
  const noArguments: List<IrTypeId> = []
  const accessorName = functionName lowering.program, path, noArguments
  const initializerName = mangledName "t", ["constant"], accessorName
  const shape = LoweredConstant symbol, binding, site.module, initializerName, declared
  const initializer = match loweredConstantInitializer(lowering, shape) {
    Some(found) => found
    None => {
      return None
    }
  }
  const produced = lowering.program.functionAt(initializer).signature.result
  var accessor = newFunction accessorName, Some(symbol), IrSignature([], produced), "constant"
  const empty = accessor.function
  accessor.function = empty.copy blocks: [], kind: FunctionKind.ConstantCell(initializer)
  const added = finishFunction lowering.program, accessor
  lowering.constantCells.set symbol.value, added
  Some added
}

/**
 * The initializer, as a function of its own with no parameters. The frame of the body that is being lowered is saved and
 * restored around it, exactly as it is around a closure - a lowering has one of everything a body needs - and the module
 * becomes the one the constant is written in, because that is whose tables say what its initializer means.
 *
 * The signature is finished **after** the body: what the initializer produces is the type of the slot it returns, and
 * asking the declaration instead would let a coercion at the annotation and the IR disagree.
 */
fn loweredConstantInitializer(var lowering: Lowering, constant: LoweredConstant): FunctionId? {
  const symbol = constant.symbol
  const value = constant.binding.value
  var inner = newFunction constant.name, Some(symbol), IrSignature([], constant.declared), "constant"
  const saved = savedFrame lowering
  enterBody lowering, constant.name
  lowering.module = constant.module
  lowering.substitution = [:]
  lowering.capturedVariables = [:]
  lowering.inlinedConstants.set symbol.value, true
  const location = locationOf lowering, value.span
  setBlockLocation inner, BlockId(0), Some(location)
  const slot = lowerExpression lowering, inner, value, None
  const produced = inner.function.typeOfSlot slot
  if lowering.isSupported && !lowering.isDiverged {
    finishBlock lowering, inner, Terminator.Return(Some(borrowed(slot)))
  }
  const isSupported = lowering.isSupported
  const _ = lowering.inlinedConstants.remove symbol.value
  restoreFrame lowering, saved
  if !isSupported {
    lowering.isSupported = false
    return None
  }
  const written = inner.function
  inner.function = written.copy signature: IrSignature([], produced)
  Some finishFunction(lowering.program, inner)
}

/** What the initializer of one constant is built from: everything that is known before its body is walked. */
type LoweredConstant {
  symbol: SymbolId
  binding: Binding
  /** The module the constant is written in, which is whose tables say what its initializer means. */
  module: ModuleId
  /** The mangled name of the initializer, which is the accessor's with `constant` in front of it. */
  name: String
  /** The declared type, which the signature starts out as until the body says what it really produces. */
  declared: IrTypeId
}

/** The declared type of a constant, which is what the initializer's signature starts out as. */
fn constantTypeOf(var lowering: Lowering, symbol: SymbolId): IrTypeId? {
  const identifier = signatureOf lowering.checker, symbol
  const declared = lowering.checker.signature(identifier).form.result
  if lowering.checker.isBroken(declared) {
    return None
  }
  Some irTypeOfClosed(lowering, declared)
}

/**
 * Whether the declaration is a top-level `var`. Reading one from a *function* of the same file would read the static the
 * const evaluator makes of its initializer and never what the entry code wrote into it, so it is a clean finding.
 */
public fn isVarBinding(var lowering: Lowering, symbol: SymbolId): Bool {
  const site = match lowering.checker.siteOf(symbol) {
    Some(found) => found
    None => {
      return false
    }
  }
  if const .Constant(binding) = site.kind {
    return binding.isVar
  }
  false
}

/**
 * `p.x`, and a field of `self` that was written without it. A field of a field is two reads rather than one path:
 * an interior projection as a place is `ir/lower/place.trb`'s concern for a `var` mutation, not for a plain read.
 */
fn lowerFieldRead(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  field: SymbolId,
  annotation: IrTypeId,
): Slot {
  const base = match receiverSlot(lowering, builder, expression) {
    Some(found) => found
    None => {
      const what = "a field of something the back end cannot reach"
      return unsupportedSlot lowering, builder, destination, what, expression.span
    }
  }
  const owner = builder.typeOfSlot base
  const layout = match layoutOfType(lowering.program, owner) {
    Some(found) => found
    None => {
      const shown = describeIrType lowering.program, owner
      return unsupportedSlot lowering, builder, destination, "a field of `{shown}`", expression.span
    }
  }
  const index = fieldIndexOf lowering, layout, field
  if index < 0 {
    return unsupportedSlot lowering, builder, destination, "a field of a variant type", expression.span
  }
  const step = if isTupleLayout(lowering, owner) {
    PathStep.TupleField layout, index
  } else {
    PathStep.Field layout, index
  }
  const target = valueSlot lowering, builder, destination, annotation
  emit builder, Instruction.Read(target, Reference(base, [step]))
  target
}

fn lowerTupleRead(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  index: Int,
  annotation: IrTypeId,
): Slot {
  const base = match receiverSlot(lowering, builder, expression) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a tuple position of something unreachable", expression.span
    }
  }
  const owner = builder.typeOfSlot base
  const layout = match layoutOfType(lowering.program, owner) {
    Some(found) => found
    None => {
      const what = "a tuple position of a value without a layout"
      return unsupportedSlot lowering, builder, destination, what, expression.span
    }
  }
  const target = valueSlot lowering, builder, destination, annotation
  emit builder, Instruction.Read(target, Reference(base, [PathStep.TupleField(layout, index)]))
  target
}

/** Which field of a layout a symbol is. Only the common fields of a variant layout are reachable without a `match`. */
public fn fieldIndexOf(var lowering: Lowering, layout: LayoutId, field: SymbolId): Int {
  const shape = lowering.program.layoutAt layout
  const reachable = if shape.variants.isEmpty() { shape.fields.length() } else { shape.commonFieldCount }
  for index in 0..reachable {
    if shape.fields[index].symbol == Some(field) {
      return index
    }
  }
  -1
}

fn isTupleLayout(var lowering: Lowering, owner: IrTypeId): Bool {
  match lowering.program.typeAt(owner) {
    .Tuple(_) => true
    _ => false
  }
}

/**
 * The value a member path is read from: what is written in front of the dot, or the receiver of the enclosing method
 * where the source left it out (`Adaptation.ImplicitSelf`).
 */
public fn receiverSlot(var lowering: Lowering, var builder: FunctionBuilder, expression: Expression): Slot? {
  // Written type arguments sit between the receiver and the call (`to<List<Item>>()`, `value.to<Set<Int>>()`), so the
  // receiver is whatever is under them - and `Adaptation.ImplicitSelf` is recorded at that inner span
  if const .Generic(target, _) = expression.kind {
    return receiverSlot lowering, builder, target
  }
  if const .Member(base, _, isOptional) = expression.kind {
    // `a?.m`: the base of the member is the *payload* of the `Option`, which `lowerOptionalMember` unwrapped and put here
    if isOptional {
      if const Some(payload) = lowering.optionalReceivers.get(base.span) {
        return Some payload
      }
      const what = "`?.` the back end did not unwrap"
      reportUnsupported lowering, what, expression.span
      return None
    }
    const slot = lowerValue lowering, builder, base
    return Some slot
  }
  implicitReceiver lowering, expression.span
}

/** The binding `Adaptation.ImplicitSelf` names: the lowering puts the receiver back that the source left out. */
public fn implicitReceiver(var lowering: Lowering, at: Span): Slot? {
  const module = lowering.module
  const adaptations = lowering.checker.adaptationsAt module, at
  for adaptation in adaptations {
    if const .ImplicitSelf(receiver) = adaptation {
      const declared = lowering.checker.binding(receiver).at
      return lowering.slots.get declared
    }
  }
  None
}

// --- Tuples ---------------------------------------------------------------------------------------------------------

fn lowerTuple(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  items: List<Argument>,
  annotation: IrTypeId,
  at: Span,
): Slot {
  const layout = match layoutOfType(lowering.program, annotation) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a tuple without a layout", at
    }
  }
  var slots: List<Slot> = []
  for item in items {
    slots.add lowerValue(lowering, builder, item.value)
  }
  const target = valueSlot lowering, builder, destination, annotation
  lowerConstruct lowering, builder, target, layout, 0, slots
  target
}

// --- Ranges ---------------------------------------------------------------------------------------------------------

/**
 * `0..10`, `0..=10`, `..10`, `0..`: **a `Range` is an ordinary record** (5.1's note - the one `native type` that declares
 * fields and is not a `RuntimeKind`), so a range literal is one `Construct` of its three fields. The two ends are an
 * `Option` each, `inclusive` is a `Bool`, and both ends are evaluated in source order before the record is built.
 *
 * Nothing about *iterating* a range is here: `for index in a..b` with both ends written out is still the counter of 5.2,
 * and every other range walks `Range<Int>.iterator` like any other `Iterable`.
 */
fn lowerRangeLiteral(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  from: Expression?,
  to: Expression?,
  isInclusive: Bool,
  annotation: IrTypeId,
  at: Span,
): Slot {
  const layout = match layoutOfType(lowering.program, annotation) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a range whose type has no layout", at
    }
  }
  // One type per pair of ends (`std/core/src/range.trb`), so the fields are exactly the ends that were written plus
  // the `inclusive` flag wherever there is a high end at all
  const fields = lowering.program.layoutAt(layout).fields
  var written: List<Expression> = []
  if const Some(found) = from {
    written.add found
  }
  if const Some(found) = to {
    written.add found
  }
  const hasFlag = to.isSome()
  const wanted = if hasFlag { written.length() + 1 } else { written.length() }
  if fields.length() != wanted {
    return unsupportedSlot lowering, builder, destination, "a range with other fields than its ends", at
  }
  var arguments: List<Slot> = []
  for index in 0..written.length() {
    const value = lowerValue lowering, builder, written[index]
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
    arguments.add value
  }
  if hasFlag {
    const contents = StaticContents.Literal LiteralValue.Boolean(isInclusive)
    arguments.add constantSlot(lowering, builder, None, contents, fields[written.length()].annotation)
  }
  const target = valueSlot lowering, builder, destination, annotation
  lowerConstruct lowering, builder, target, layout, 0, arguments
  target
}

// --- Operators ------------------------------------------------------------------------------------------------------

fn lowerUnary(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  operator: PrefixOperator,
  operand: Expression,
  annotation: IrTypeId,
): Slot {
  const slot = lowerValue lowering, builder, operand
  if const .Not = operator {
    const at = expression.span
    return intrinsicSlot lowering, builder, destination, IntrinsicOperation.BooleanNot, None, [slot], annotation, at
  }
  const inner = builder.typeOfSlot slot
  if const Some(kind) = numericKindOf(lowering.program, inner) {
    const at = expression.span
    return intrinsicSlot lowering, builder, destination, IntrinsicOperation.Negate, Some(kind), [slot], annotation, at
  }
  const written = lowering.checker.expressionType lowering.module, operand.span
  lowerOperator lowering, builder, destination, expression.span, [slot], annotation, written
}

fn lowerBinary(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  operator: InfixOperator,
  left: Expression,
  right: Expression,
  annotation: IrTypeId,
): Slot {
  match operator {
    .And | .Or => shortCircuit lowering, builder, destination, operator, left, right, annotation, expression.span
    .Coalesce => lowerCoalesce lowering, builder, destination, expression, left, right, annotation
    _ => {
      const first = lowerValue lowering, builder, left
      const second = lowerValue lowering, builder, right
      // The type of the **left** operand, which is the receiver of the member an operator is (`a + b` is `a.add(b)`)
      const operand = lowering.checker.expressionType lowering.module, left.span
      if isComparison(operator) {
        const at = expression.span
        return lowerComparison lowering, builder, destination, operator, first, second, annotation, at, operand
      }
      const at = expression.span
      lowerArithmetic lowering, builder, destination, operator, first, second, annotation, at, operand
    }
  }
}

fn isComparison(operator: InfixOperator): Bool {
  match operator {
    .Equal | .NotEqual | .Less | .LessOrEqual | .Greater | .GreaterOrEqual => true
    _ => false
  }
}

/**
 * `&&` and `||` short circuit, so they are control flow and not an instruction: the destination holds the left side,
 * and only the path that needs the right side computes it. One slot, one definition per path.
 */
fn shortCircuit(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  operator: InfixOperator,
  left: Expression,
  right: Expression,
  annotation: IrTypeId,
  at: Span,
): Slot {
  const target = valueSlot lowering, builder, destination, annotation
  const _ = lowerExpression lowering, builder, left, Some(target)
  const location = locationOf lowering, at
  const other = addBlock builder, "right", Some(location)
  const join = addBlock builder, "join", Some(location)
  const isAnd = match operator {
    .And => true
    _ => false
  }
  const terminator = if isAnd {
    Terminator.Branch target, other, join
  } else {
    Terminator.Branch target, join, other
  }
  finishBlock lowering, builder, terminator
  continueIn lowering, builder, other
  const _ = lowerExpression lowering, builder, right, Some(target)
  if !lowering.isDiverged {
    finishBlock lowering, builder, Terminator.Jump(join)
  }
  continueIn lowering, builder, join
  target
}

/**
 * A comparison of a built-in type is an intrinsic and never a call: `==` on the numbers, on `Bool` and on `Char` is
 * one instruction, `==` on a `String` is `textEqual`, and an ordering of two strings is `textCompare` against zero.
 * Everything else goes through the member the checker recorded.
 */
fn lowerComparison(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  operator: InfixOperator,
  first: Slot,
  second: Slot,
  annotation: IrTypeId,
  at: Span,
  operand: TypeId? = None,
): Slot {
  const operands = builder.typeOfSlot first
  const operation = comparisonOperation operator
  if const Some(kind) = numericKindOf(lowering.program, operands) {
    return intrinsicSlot lowering, builder, destination, operation, Some(kind), [first, second], annotation, at
  }
  if isEqualityOperation(operation) && isPlainEquality(lowering, operands) {
    return intrinsicSlot lowering, builder, destination, operation, None, [first, second], annotation, at
  }
  if isTextType(lowering, operands) {
    return lowerTextComparison lowering, builder, destination, operation, first, second, annotation, at
  }
  if !isEqualityOperation(operation) {
    return lowerOrderComparison lowering, builder, destination, operation, first, second, annotation, at, operand
  }
  /*
   * The member is `Equals.equals` for both operators - the language has no `notEquals` - so `!=` is that call and one
   * `BooleanNot` on top of it, exactly as `lowerTextComparison` does it for two strings. Without this, `!=` on every type
   * whose equality is a *call* (a record, a case, a collection) came out as `==`: three gate programs compared records
   * and derived members and none of them wrote a `!=`.
   */
  if const .NotEqual = operation {
    const equal = lowerOperator lowering, builder, None, at, [first, second], annotation, operand, "equals"
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
    const negate = IntrinsicOperation.BooleanNot
    return intrinsicSlot lowering, builder, destination, negate, None, [equal], annotation, at
  }
  lowerOperator lowering, builder, destination, at, [first, second], annotation, operand, "equals"
}

/**
 * `<`, `<=`, `>` and `>=` on a type whose order is `Compare.compare`: the member answers an `Ordering`, and the operator
 * is one test of its tag - which is exactly what the defaults of `Compare` say (`lessThan` is `compare(other) == .Less`).
 */
fn lowerOrderComparison(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  operation: IntrinsicOperation,
  first: Slot,
  second: Slot,
  annotation: IrTypeId,
  at: Span,
  operand: TypeId? = None,
): Slot {
  const ordering = match orderingTypeOf(lowering) {
    Some(found) => found
    None => {
      const what = "an order over a type, without an `Ordering` in the prelude"
      return unsupportedSlot lowering, builder, destination, what, at
    }
  }
  const operands = [first, second]
  const order = lowerOperator lowering, builder, None, at, operands, ordering, operand, "compare"
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const layout = match layoutOfType(lowering.program, ordering) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "an `Ordering` without a layout", at
    }
  }
  const wanted = if isLessTest(operation) { "Less" } else { "Greater" }
  const index = variantNamed lowering, layout, wanted
  if index < 0 {
    return unsupportedSlot lowering, builder, destination, "an `Ordering` without a `{wanted}` case", at
  }
  const integer = lowering.program.internType IrType.Integer(64, true)
  const tag = addTemporary builder, integer
  emit builder, Instruction.Tag(tag, order)
  const value = integerSlot lowering, builder, index, integer
  const test = if isStrictTest(operation) {
    IntrinsicOperation.Equal
  } else {
    IntrinsicOperation.NotEqual
  }
  const kind = NumericKind.Signed 64
  intrinsicSlot lowering, builder, destination, test, Some(kind), [tag, value], annotation, at
}

/** `a < b` and `a >= b` both test against `.Less`; `a > b` and `a <= b` against `.Greater`. */
fn isLessTest(operation: IntrinsicOperation): Bool {
  match operation {
    .Less | .GreaterOrEqual => true
    _ => false
  }
}

/** A strict comparison asks for that case, the other two ask for anything but it. */
fn isStrictTest(operation: IntrinsicOperation): Bool {
  match operation {
    .Less | .Greater => true
    _ => false
  }
}

fn orderingTypeOf(var lowering: Lowering): IrTypeId? {
  const symbol = lowering.checker.wellKnown.symbolNamed("Ordering")?
  const empty: List<TypeId> = []
  const named = lowering.checker.nominal symbol, empty
  Some irTypeOfClosed(lowering, named)
}

fn variantNamed(var lowering: Lowering, layout: LayoutId, name: String): Int {
  const shape = lowering.program.layoutAt layout
  for index in 0..shape.variants.length() {
    if shape.variants[index].name == name {
      return index
    }
  }
  -1
}

fn comparisonOperation(operator: InfixOperator): IntrinsicOperation {
  match operator {
    .Equal => IntrinsicOperation.Equal
    .NotEqual => IntrinsicOperation.NotEqual
    .Less => IntrinsicOperation.Less
    .LessOrEqual => IntrinsicOperation.LessOrEqual
    .Greater => IntrinsicOperation.Greater
    _ => IntrinsicOperation.GreaterOrEqual
  }
}

fn isEqualityOperation(operation: IntrinsicOperation): Bool {
  match operation {
    .Equal | .NotEqual => true
    _ => false
  }
}

/** `Bool` and `Char` compare as themselves: the equality intrinsic of those two names no numeric type. */
fn isPlainEquality(var lowering: Lowering, operands: IrTypeId): Bool {
  match lowering.program.typeAt(operands) {
    .Boolean | .Character | .VoidType => true
    _ => false
  }
}

fn isTextType(var lowering: Lowering, operands: IrTypeId): Bool {
  match lowering.program.typeAt(operands) {
    .Text => true
    _ => false
  }
}

/**
 * `a == b` on two strings is one intrinsic; an ordering is `textCompare`, whose result is an `Int64`, compared against
 * zero. Doing it here rather than through the derived `compare` keeps `Ordering` - a layout of the program - out of it.
 */
fn lowerTextComparison(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  operation: IntrinsicOperation,
  first: Slot,
  second: Slot,
  annotation: IrTypeId,
  at: Span,
): Slot {
  if const .Equal = operation {
    const equals = IntrinsicOperation.TextEqual
    return intrinsicSlot lowering, builder, destination, equals, None, [first, second], annotation, at
  }
  if const .NotEqual = operation {
    const equals = IntrinsicOperation.TextEqual
    const equal = intrinsicSlot lowering, builder, None, equals, None, [first, second], annotation, at
    return intrinsicSlot lowering, builder, destination, IntrinsicOperation.BooleanNot, None, [equal], annotation, at
  }
  const integer = lowering.program.internType IrType.Integer(64, true)
  const order = addTemporary builder, integer
  emitIntrinsic lowering, builder, Some(order), IntrinsicOperation.TextCompare, None, [first, second], at
  const zero = integerSlot lowering, builder, 0, integer
  const kind = NumericKind.Signed 64
  intrinsicSlot lowering, builder, destination, operation, Some(kind), [order, zero], annotation, at
}

/** `+`, `-`, `*`, `/`, `%` on the built-in numbers, and `+` on two strings. Everything else is a call of `Add.add`. */
fn lowerArithmetic(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  operator: InfixOperator,
  first: Slot,
  second: Slot,
  annotation: IrTypeId,
  at: Span,
  operand: TypeId? = None,
): Slot {
  const operands = builder.typeOfSlot first
  if const Some(kind) = numericKindOf(lowering.program, operands) {
    const operation = arithmeticOperation operator
    return intrinsicSlot lowering, builder, destination, operation, Some(kind), [first, second], annotation, at
  }
  if isTextType(lowering, operands) {
    if const .Add = operator {
      const concat = IntrinsicOperation.TextConcat
      return intrinsicSlot lowering, builder, destination, concat, None, [first, second], annotation, at
    }
  }
  lowerOperator lowering, builder, destination, at, [first, second], annotation, operand
}

fn arithmeticOperation(operator: InfixOperator): IntrinsicOperation {
  match operator {
    .Add => IntrinsicOperation.Add
    .Subtract => IntrinsicOperation.Subtract
    .Multiply => IntrinsicOperation.Multiply
    .Divide => IntrinsicOperation.Divide
    _ => IntrinsicOperation.Remainder
  }
}

/** One intrinsic into a slot of its own or into the destination the caller has. */
public fn intrinsicSlot(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  operation: IntrinsicOperation,
  kind: NumericKind?,
  operands: List<Slot>,
  annotation: IrTypeId,
  at: Span,
): Slot {
  const target = valueSlot lowering, builder, destination, annotation
  emitIntrinsic lowering, builder, Some(target), operation, kind, operands, at
  target
}

/** One `Instruction.Intrinsic`, at the location of the expression it came from. Every arithmetic op goes through this. */
public fn emitIntrinsic(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  target: Slot?,
  operation: IntrinsicOperation,
  kind: NumericKind?,
  operands: List<Slot>,
  at: Span,
) {
  const location = locationOf lowering, at
  emit builder, Instruction.Intrinsic(target, Intrinsic(operation, kind), operands, location)
}

// --- `if` -----------------------------------------------------------------------------------------------------------

/**
 * `if` as a statement and as an expression, in one piece: with an `else` both arms produce into one slot, without one
 * the body is a block of statements and the whole is `Void`. An arm that diverges simply does not jump to the join
 * block, which is what makes `if c { return 1 } else { 2 }` fall out without a rule of its own.
 */
public fn lowerIf(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  condition: Condition,
  then: Block,
  otherwise: Expression?,
  annotation: IrTypeId,
): Slot {
  const test = match condition {
    .Test(inner) => inner
    .Bind(isVar, pattern, value) => {
      const found = lowerIfBinding(
        lowering,
        builder,
        destination,
        expression,
        isVar,
        pattern,
        value,
        then,
        otherwise,
        annotation,
      )
      return found
    }
  }
  const scrutinee = lowerValue lowering, builder, test
  const location = locationOf lowering, expression.span
  const thenBlock = addBlock builder, "then", Some(location)
  const alternative = match otherwise {
    Some(found) => found
    None => {
      return lowerIfStatement lowering, builder, destination, scrutinee, thenBlock, then, location
    }
  }
  const elseBlock = addBlock builder, "else", Some(location)
  const join = addBlock builder, "join", Some(location)
  const target = valueSlot lowering, builder, destination, annotation
  finishBlock lowering, builder, Terminator.Branch(scrutinee, thenBlock, elseBlock)
  continueIn lowering, builder, thenBlock
  lowerBlockInto lowering, builder, then, Some(target)
  const thenDiverged = lowering.isDiverged
  if !thenDiverged {
    finishBlock lowering, builder, Terminator.Jump(join)
  }
  continueIn lowering, builder, elseBlock
  const _ = lowerExpression lowering, builder, alternative, Some(target)
  const elseDiverged = lowering.isDiverged
  if !elseDiverged {
    finishBlock lowering, builder, Terminator.Jump(join)
  }
  continueIn lowering, builder, join
  // Nothing reaches the join block when both arms left the function, and an empty `unreachable` marker is what it is
  lowering.isDiverged = thenDiverged && elseDiverged
  target
}

fn lowerIfStatement(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  scrutinee: Slot,
  thenBlock: BlockId,
  then: Block,
  location: LocationId,
): Slot {
  const join = addBlock builder, "join", Some(location)
  // An `if` without an `else` produces `Void`. Where somebody takes that value it is defined *before* the branch, so
  // that it is defined on both paths; where nobody does, no instruction is written at all
  const target = match destination {
    Some(_) => voidSlot lowering, builder, destination
    None => abandonedSlot lowering, builder, destination
  }
  finishBlock lowering, builder, Terminator.Branch(scrutinee, thenBlock, join)
  continueIn lowering, builder, thenBlock
  lowerBlockInto lowering, builder, then, None
  if !lowering.isDiverged {
    finishBlock lowering, builder, Terminator.Jump(join)
  }
  continueIn lowering, builder, join
  target
}
