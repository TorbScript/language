/**
 * `var` paths: how the path the checker wrote down becomes a `Reference` of the IR, and what a call, an assignment and a
 * property command do with one.
 *
 * **The checker already walked the expression.** 4.6 decided that the path leads somewhere, that a change may go through
 * every step of it, and that no second access to it is open, and recorded the answer as a `Place` under the span of the
 * argument, the receiver or the target (TYPECHECKER 5.1). So nothing here reads the syntax tree a second time: a root
 * becomes a slot, a step becomes a `PathStep`, and the type of every step comes out of the layout the IR already has.
 * That is also what keeps the two halves honest - a path this file forms is exactly the path exclusivity was checked for.
 *
 * A place is **never counted and never escapes** (BACKEND 2.3): the caller holds the base live across the call, and
 * `MakeUnique` in front of the call - one per counted owner of the path, which the ownership pass inserts - is what makes
 * the storage safe to write through. So a `var` parameter costs a pointer and nothing else.
 *
 * An **index** on the path (`a[key]`) is the one step that is not a `PathStep`: it takes the element out of its
 * container into a slot of the frame, runs the access against that slot and puts it back afterwards (`TakenElement`).
 * A **slice** on the path (`a[from..to]`) is the same round trip over the window: `Slice.slice` takes it out and
 * `MutableSlice.replace` puts it back, so `samples[1..4].sort { _ }` sorts three items and writes them back.
 *
 * An `Array<Item, Size>` on the path is an ordinary index: its round trip is formed here like every other one, and
 * `ir/elements.trb` turns it into one `Element` step into the array's inline slots.
 */

use Span from "../../syntax/source"
use Expression from "../../syntax/ast"
use Signature, TypeId, ParameterId from "../../semantics/checker/type"
use substitute from "../../semantics/checker/unify"
use traitArgumentsOf from "../../semantics/checker/implementation"
use Place, PlaceRoot, PlaceStep, BindingId from "../../semantics/checker/context"
use IrProgram, IrType, IrTypeId, Slot, LayoutId, Reference, PathStep, Instruction, borrowed from "../ir"
use FunctionBuilder, addTemporary, emit from "../build"
use layoutOfType, typeOfReference from "../verify"
use isManagedType from "../layout"
use isSharedStorage from "../capture"
use describeIrType from "../print"
use isReferenceParameter, isClosedType from "../instances"
use Lowering, reportUnsupported, irTypeOf, irTypeOfClosed, voidTypeOf, locationOf from "./context"
use substituted from "./context"
use lowerExpression, lowerValue, voidSlot, abandonedSlot, fieldIndexOf from "./expression"
use bindingReferenceOf, emitClosureCall from "./closure"
use Dispatched, dispatchedOn, resultTypeOf from "./generic"
use lowerDispatched from "./call"
use entryCellRead, readEntryCell from "./cell"

/**
 * A place of the IR: the path, the type it ends in - which is what a write through it has to produce - and the elements
 * the path went through `a[key]` for, which the access has to put back when it has run.
 */
public type PlacePath {
  reference: Reference
  annotation: IrTypeId
  /** Outermost first. `putBackElements` writes them back, and every caller of one of the two forms below calls it. */
  taken: List<TakenElement> = []
}

/**
 * One element a `var` path goes through `a[key]` for: taken out of its container before the access begins, put back
 * after it has run. A window of `a[from..to]` is one as well, with the range as its key.
 *
 * That is the concept's own model of an index path - "take it out, change it, put it back" (`var` Paths) - and the two
 * halves are two members the language already has: **`Indexed.at`** takes the element out, which is why a missing key
 * *panics* in the one place `std/core` decides it, and **`MutableIndexed.set`** puts it back, which is why a missing key
 * of a map is an *insert* on `map[key] = value`. Neither half is a decision of the back end.
 *
 * **Why it is not `Instruction.TakeOut`/`PutBack`.** Those name a `RuntimeKind` and reach the runtime's own
 * `torb_list_element_reference` / `torb_map_take_out` - and the container of a path is almost always a **trait-typed**
 * value (`List<Int>`, `Map<String, Int>`) whose payload the back end may not index: a witness table says which members
 * a value has and never that it is a `torb_list`, and `List<Item>` may be implemented by anything. So the two
 * instructions stay for the contiguous shapes of 5.9b (`Array<Item, Size>` and a slice window), where the receiver is
 * concrete, and the price of the general form is one copy of the element in and one out.
 *
 * The element lives in an ordinary slot of the frame in between, so the access is a change of a local: `MakeUnique`
 * happens for a counted element for the same reason it happens for any other value, and copy on write follows from the
 * count the container still holds.
 */
public type TakenElement {
  /** The container it came out of: a place, because a container may itself be an element of another. */
  container: Reference
  /** The key, lowered exactly once and before the access began. */
  key: Slot
  /** The frame's own slot the element lives in while the access runs. */
  element: Slot
  /** `MutableIndexed.set` of the container's own type, or `MutableSlice.replace` for a window: what puts it back. */
  setter: Dispatched
  at: Span
}

/**
 * The operands of one call: one slot per position, and the place of every position that is a `var` parameter.
 *
 * `places` is either empty - no position of the callee takes a place at all - or exactly as long as `slots`, so a reader
 * of a position never has to ask which of the two lists is authoritative.
 */
public type CallOperands {
  slots: List<Slot> = []
  places: List<Reference?> = []
  /** What the places of these arguments took out of a container, in the order the arguments were written. */
  taken: List<TakenElement> = []
}

/** Which positions of a signature are `var` parameters, in the order of the signature. `self` is not one of them. */
public fn referenceParametersOf(signature: Signature): List<Bool> {
  var found: List<Bool> = []
  for parameter in signature.form.parameters {
    found.append isReferenceParameter(parameter.mode)
  }
  found
}

/**
 * The IR type of one parameter of a declaration, which is the type the place of a `var` argument has to end in.
 *
 * The arguments of the **callee's** instance go in and not the caller's, exactly as they do for a `lazy` parameter and
 * for a default (`lazyItemAt` and `lowerDefaults` in `lower/call.trb`): the type is written in the callee's own
 * declaration, so `using(var resource: Resource, ...)` reads `Resource` through the mapping the dispatch decided. With
 * the caller's substitution instead, a generic `var` parameter reached the back end unsubstituted - an internal error -
 * and the place was then formed over a `Void` slot, which is two more.
 */
public fn parameterTypeAt(
  var lowering: Lowering,
  signature: Signature,
  position: Int,
  mapping: Map<ParameterId, TypeId> = [:],
): IrTypeId? {
  const parameter = signature.form.parameters.get(position)?
  const annotation = parameter.type
  if lowering.checker.isBroken(annotation) {
    return None
  }
  if mapping.isEmpty() {
    return irTypeOf lowering, annotation
  }
  // The mapping's own arguments are closed already (the dispatch substituted the caller's first), so this is the answer
  const applied = substitute lowering.checker.types, annotation, mapping
  if lowering.checker.isBroken(applied) {
    return None
  }
  irTypeOfClosed lowering, applied
}

// --- From the checker's place to a reference -------------------------------------------------------------------------

/**
 * The place the checker recorded under this expression, as a `Reference`. `what` names the construct in every message, so
 * that a finding says whether it was an assignment, a receiver or an argument that could not form its path.
 *
 * The **expression** is taken and not only its span, because the key of an `a[key]` on the path is an expression that has
 * to be lowered and the checker's `PlaceStep.Index` carries only its span.
 */
public fn referenceAt(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  target: Expression,
  what: String,
): PlacePath? {
  const prelude = match pathPreludeAt(lowering, builder, target, what) {
    Some(found) => found
    None => {
      return None
    }
  }
  referenceFrom lowering, builder, prelude, what, target.span
}

/**
 * The half of a path that is **evaluated**: where it starts, and the key of every `a[key]` on it, each lowered once
 * and in source order.
 *
 * It is a half of its own because the two halves happen at different moments. The keys are subexpressions of the
 * assignment and are evaluated with everything else it needs; the take-out of an element is part of the **access**,
 * which begins once all of that is done (BACKEND 2.3). `lowerPlaceAssignment` is the one caller that needs the two
 * apart, and it lowers the value in between.
 */
public type PathPrelude {
  root: PlacePath
  /** The steps the checker wrote down, which is what the second half walks. */
  steps: List<PlaceStep> = []
  /** One slot per `a[key]` on the path, outermost first. */
  keys: List<Slot> = []
}

/** The root and the keys of the path the checker recorded under an expression. */
public fn pathPreludeAt(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  target: Expression,
  what: String,
): PathPrelude? {
  const at = target.span
  const place = match placeRecordedAt(lowering, at) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "{what} the checker recorded no path for", at
      return None
    }
  }
  if const .Temporary = place.root {
    if place.steps.isEmpty() {
      return temporaryPrelude lowering, builder, target
    }
  }
  const root = match rootReferenceOf(lowering, builder, place.root, what, at) {
    Some(found) => found
    None => {
      return None
    }
  }
  const keys = match loweredKeys(lowering, builder, place.steps, indexKeysOf(target), what, at) {
    Some(found) => found
    None => {
      return None
    }
  }
  PathPrelude root, place.steps, keys
}

/**
 * A freshly produced object as the whole path: `source.through(stage).checked()`, where `checked` is a `var fn` and its
 * receiver is what `through` answered. The checker allows it only where the value has an identity - a `shared type`,
 * a `shared trait` value, a task, a file (`MutationProblem.TemporaryRoot` otherwise) - so a change through it is the
 * object's and nothing is lost with the copy. The value goes into a hidden local of the frame and the path starts there;
 * the ownership pass releases it after its last use, as it does every other temporary.
 */
fn temporaryPrelude(var lowering: Lowering, var builder: FunctionBuilder, target: Expression): PathPrelude? {
  const slot = lowerValue lowering, builder, target
  if !lowering.isSupported {
    return None
  }
  PathPrelude PlacePath(Reference(slot, []), builder.typeOfSlot(slot))
}

/** The other half: every step walked, and every `a[key]` on the way taken out of its container. */
public fn referenceFrom(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  prelude: PathPrelude,
  what: String,
  at: Span,
): PlacePath? {
  steppedFrom lowering, builder, prelude.root, prelude.steps, prelude.keys, what, at
}

/** The path the checker wrote down under a span, or `None` where it wrote none. */
public fn placeRecordedAt(var lowering: Lowering, at: Span): Place? {
  const module = lowering.module
  lowering.checker.placeAt module, at
}

/**
 * Whether the path under a span is a temporary: a valid *argument* of a `var` parameter and nothing else
 * (docs/TYPECHECKER.md, `using` passes a temporary to a `var` parameter).
 */
fn isTemporaryPlace(var lowering: Lowering, at: Span): Bool {
  match placeRecordedAt(lowering, at) {
    Some(place) => {
      if const .Temporary = place.root {
        return true
      }
      false
    }
    None => false
  }
}

/**
 * The path from a root that is already in hand, with the keys of its `a[key]` steps already in slots. Every `.Index` step
 * takes its element out here, which is what makes the path of the *access* start at that element - `points[0].x` is a
 * write to the `x` of a `Point` the frame holds, and the element goes back into the list afterwards.
 */
fn steppedFrom(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  root: PlacePath,
  written: List<PlaceStep>,
  keys: List<Slot>,
  what: String,
  at: Span,
): PlacePath? {
  var base = root.reference.base
  var steps = root.reference.steps
  var annotation = root.annotation
  var taken: List<TakenElement> = []
  var position = 0
  for step in written {
    const taking = match step {
      .Index(container, _, _) => Some TakenKind(container, takesWindow: false)
      .Range(container, _) => Some TakenKind(container, takesWindow: true)
      _ => None
    }
    if const Some(kind) = taking {
      const key = match keys.get(position) {
        Some(found) => found
        None => {
          reportUnsupported lowering, "{what} through `a[key]` without a key", at
          return None
        }
      }
      position = position + 1
      const container = Reference base, steps
      const element = match takenElement(lowering, builder, container, annotation, kind, key, what, at) {
        Some(found) => found
        None => {
          return None
        }
      }
      taken.append element
      base = element.element
      steps = []
      annotation = builder.typeOfSlot element.element
      continue
    }
    const next = match steppedPath(lowering, annotation, step, what, at) {
      Some(found) => found
      None => {
        return None
      }
    }
    steps.append next.step
    annotation = next.annotation
  }
  PlacePath Reference(base, steps), annotation, taken
}

/** What a step that takes a value out of its container takes: an element of `a[key]`, or a window of `a[from..to]`. */
type TakenKind {
  /** The container's type as the checker wrote it. */
  container: TypeId
  takesWindow: Bool
}

/** One step of a path, and the type it leads to. */
type SteppedPath {
  step: PathStep
  annotation: IrTypeId
}

/**
 * Where a path starts, as a path of its own: usually a slot and no steps, and for a **captured** `var` binding the one
 * field of the box the frame shares with the closure - which is why this answers a `PlacePath` and not a `Slot`.
 *
 * `self` is an ordinary local, so a `var fn` receiver needs no case of its own, and a top-level binding of an entry
 * file is a local of its entry function.
 */
fn rootReferenceOf(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  root: PlaceRoot,
  what: String,
  at: Span,
): PlacePath? {
  match root {
    .Local(binding) => {
      const declared = lowering.checker.binding(binding).at
      if const Some(place) = bindingReferenceOf(lowering, builder, declared) {
        const annotation = typeOfPlace lowering, builder, place
        return PlacePath place, annotation
      }
      match lowering.slots.get(declared) {
        Some(found) => PlacePath Reference(found, []), builder.typeOfSlot(found)
        None => {
          const shown = describeRoot lowering, binding
          reportUnsupported lowering, "{what} through {shown}", at
          None
        }
      }
    }
    .Declared(symbol) => {
      match lowering.entryLocals.get(symbol.value) {
        Some(found) => PlacePath Reference(found, []), builder.typeOfSlot(found)
        None => {
          // A top-level `const` of the entry file: a path into it starts at the one value the entry made - for a shared
          // object the one object, whoever holds a count of it
          if const Some(accesses) = entryCellRead(lowering, symbol) {
            const object = addTemporary builder, accesses.held
            readEntryCell lowering, builder, symbol, accesses, object, at
            return PlacePath Reference(object, []), accesses.held
          }
          reportUnsupported lowering, "{what} through a top-level `var` read from a function", at
          None
        }
      }
    }
    // A temporary is a valid argument of a `var` parameter and never the base of a path, so it is handled one level up
    .Temporary => {
      reportUnsupported lowering, "{what} through a temporary", at
      None
    }
    .Unknown => {
      reportUnsupported lowering, "{what} whose path the checker left open", at
      None
    }
  }
}

/**
 * Why the root of a path is nowhere in the frame. The one that really happens is the receiver of a **receiver script**:
 * `project.trb` and a configuration file *are* the body of a receiver closure, and what applies that body is
 * `Sandbox.load` - so there is no frame to put the receiver in until the sandbox exists.
 */
fn describeRoot(var lowering: Lowering, binding: BindingId): String {
  if lowering.checker.binding(binding).bindsReceiver {
    return "the receiver of a receiver script, which `Sandbox.load` applies"
  }
  "a binding the back end cannot reach"
}

/**
 * One step from a value to one of its fields. A field of a tuple is a `TupleField` step, because a tuple layout names its
 * positions and not its fields; an index and a slice need the containers of 5.7, so each of them is a finding.
 */
fn steppedPath(var lowering: Lowering, annotation: IrTypeId, step: PlaceStep, what: String, at: Span): SteppedPath? {
  match step {
    .Field(_, field) => {
      const layout = match layoutOfType(lowering.program, annotation) {
        Some(found) => found
        None => {
          const shown = describeIrType lowering.program, annotation
          reportUnsupported lowering, "{what} through a field of `{shown}`", at
          return None
        }
      }
      const index = fieldIndexOf lowering, layout, field
      if index < 0 {
        reportUnsupported lowering, "{what} through a field of a variant type", at
        return None
      }
      SteppedPath PathStep.Field(layout, index), fieldTypeOf(lowering, layout, index)
    }
    .TupleField(_, index) => {
      const layout = match layoutOfType(lowering.program, annotation) {
        Some(found) => found
        None => {
          reportUnsupported lowering, "{what} through a tuple position of a value without a layout", at
          return None
        }
      }
      if index < 0 || index >= lowering.program.layoutAt(layout).fields.length() {
        reportUnsupported lowering, "{what} through a tuple position the layout does not have", at
        return None
      }
      SteppedPath PathStep.TupleField(layout, index), fieldTypeOf(lowering, layout, index)
    }
    // An index and a slice take their value out one level up, so the walk never asks this one about them
    .Index(_, _, _) | .Range(_, _) => {
      reportUnsupported lowering, "{what} through `a[key]` the walk did not take out", at
      None
    }
  }
}

fn fieldTypeOf(var lowering: Lowering, layout: LayoutId, index: Int): IrTypeId {
  lowering.program.layoutAt(layout).fields[index].annotation
}

/**
 * The type a place of the lowering's own making ends in: the field of a box, and the path an `if var` binds a name to,
 * which goes through the fields of a case and the positions of a tuple as well.
 */
fn typeOfPlace(var lowering: Lowering, var builder: FunctionBuilder, place: Reference): IrTypeId {
  var annotation = builder.typeOfSlot place.base
  for step in place.steps {
    match step {
      .Field(layout, index) => {
        annotation = fieldTypeOf lowering, layout, index
      }
      .TupleField(layout, index) => {
        annotation = fieldTypeOf lowering, layout, index
      }
      .Variant(layout, variant, index) => {
        annotation = lowering.program.layoutAt(layout).fieldsOfVariant(variant)[index].annotation
      }
      _ => {}
    }
  }
  annotation
}

// --- An index on the path --------------------------------------------------------------------------------------------

/**
 * The key expression of every `a[key]` and `a[from..to]` on the path, from the root outwards - which is the order the
 * steps of a place are in.
 *
 * The checker's `PlaceStep.Index` carries the **span** of the key and nothing else, and the lowering does not lower from
 * spans: so the target expression is walked in step with the steps of its place. That is no second opinion about what a
 * place is - the walk collects the expressions inside the brackets and nothing else, the path itself stays the one 4.6
 * wrote down, and the target is still lowered *only* through its path and never also as a value (5.9a's rule).
 */
fn indexKeysOf(expression: Expression): List<Expression> {
  var inwards: List<Expression> = []
  var current = expression
  var more = true
  while more {
    const kind = current.kind
    match kind {
      .Index(target, key) => {
        inwards.append key
        current = target
      }
      .Member(target, _, _) => {
        current = target
      }
      .Generic(inner, _) => {
        current = inner
      }
      _ => {
        more = false
      }
    }
  }
  var keys: List<Expression> = []
  for position in 0..inwards.length() {
    keys.append inwards[inwards.length() - 1 - position]
  }
  keys
}

/**
 * Every key of the path, lowered exactly once, in source order and **before** the access begins. That is the evaluation
 * order of a `var` path (CONCEPT, `var` Paths, after the model of Swift): all keys and all arguments are evaluated first,
 * and only then does the access - which the take-out below is already part of - begin.
 *
 * A path with no index needs none of it, so nothing walks anything for the ordinary field paths.
 */
fn loweredKeys(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  steps: List<PlaceStep>,
  keys: List<Expression>,
  what: String,
  at: Span,
): List<Slot>? {
  var count = 0
  for step in steps {
    match step {
      .Index(_, _, _) | .Range(_, _) => {
        count = count + 1
      }
      _ => {}
    }
  }
  const empty: List<Slot> = []
  if count == 0 {
    return empty
  }
  if keys.length() != count {
    reportUnsupported lowering, "{what} through `a[key]` the back end could not pair with its path", at
    return None
  }
  var found: List<Slot> = []
  for key in keys {
    const slot = lowerValue lowering, builder, key
    if !lowering.isSupported {
      return None
    }
    found.append slot
  }
  found
}

/**
 * One element on the path: the container as a value, `Indexed.at` to take the element out of it into a slot of the frame,
 * and the `MutableIndexed.set` that will put it back once the access has run. A window is the same with `Slice.slice`
 * and `MutableSlice.replace`, and the range as the key.
 *
 * The container is **read out of its place** first, because `at` takes `self` by value: a `Read` of a counted value hands
 * the frame a count of its own, which dies at the call again and leaves the container's count untouched.
 *
 * A window of a list shares the list's storage, so the first write through it copies the part it covers - that copy is
 * what `replace` writes back, and it is the price of a window over storage that is not its own.
 */
fn takenElement(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  container: Reference,
  annotation: IrTypeId,
  kind: TakenKind,
  key: Slot,
  what: String,
  at: Span,
): TakenElement? {
  const subject = substituted lowering, kind.container
  const readerName = if kind.takesWindow { "slice" } else { "at" }
  const setterName = if kind.takesWindow { "replace" } else { "set" }
  const reader = match takingMemberOf(lowering, subject, false, kind.takesWindow, readerName, what, at) {
    Some(found) => found
    None => {
      return None
    }
  }
  const setter = match takingMemberOf(lowering, subject, true, kind.takesWindow, setterName, what, at) {
    Some(found) => found
    None => {
      return None
    }
  }
  const elementType = resultTypeOf lowering, reader
  if !isClosedType(lowering, elementType) {
    reportUnsupported lowering, "{what} through `a[key]` whose element type the back end cannot close", at
    return None
  }
  const spelling = irTypeOfClosed lowering, elementType
  const receiver = addTemporary builder, annotation
  emit builder, Instruction.Read(receiver, container)
  const element = addTemporary builder, spelling
  const places: List<Reference?> = []
  const _ = lowerDispatched lowering, builder, element, at, reader, [receiver, key], places, spelling
  if !lowering.isSupported {
    return None
  }
  if kind.takesWindow {
    return TakenElement container, key, element, setter, at
  }
  // Which member this was, so that `ir/elements.trb` can recognize the round trip once the container is concrete and
  // replace it with one `Element` step - by the symbol, because a specialized copy of it is the same member
  lowering.program.elementReaders.insert reader.member.value
  // An array's `set` is TorbScript and has no native symbol to be recognized by, so the lowering names it
  if const .FixedArray(_, _) = lowering.program.typeAt(annotation) {
    lowering.program.elementWriters.insert setter.member.value
  }
  TakenElement container, key, element, setter, at
}

/** The two halves of an index path, or of a window: `Slice.slice` and `MutableSlice.replace` of the container. */
fn takingMemberOf(
  var lowering: Lowering,
  container: TypeId,
  isMutable: Bool,
  isWindow: Bool,
  name: String,
  what: String,
  at: Span,
): Dispatched? {
  if !isWindow {
    return indexedMemberOf lowering, container, isMutable, name, what, at
  }
  const capability = if isMutable {
    lowering.checker.wellKnown.mutableSlice
  } else {
    lowering.checker.wellKnown.slice
  }
  const symbol = match capability {
    Some(found) => found
    None => {
      reportUnsupported lowering, "{what} through `a[from..to]` without `Slice` in the prelude", at
      return None
    }
  }
  // `Slice<Index>` is applied to the position type of the container, an `Int` for a list: the bound has to say it
  const empty: List<TypeId> = []
  const arguments = traitArgumentsOf(lowering.checker, container, symbol) ?? empty
  const bound = lowering.checker.nominal symbol, arguments
  dispatchedOn lowering, container, bound, name, at
}

/** `Indexed.at` and `MutableIndexed.set` of the container's own type: the two halves of an index path. */
fn indexedMemberOf(
  var lowering: Lowering,
  container: TypeId,
  isMutable: Bool,
  name: String,
  what: String,
  at: Span,
): Dispatched? {
  const capability = if isMutable {
    lowering.checker.wellKnown.mutableIndexed
  } else {
    lowering.checker.wellKnown.indexed
  }
  const symbol = match capability {
    Some(found) => found
    None => {
      reportUnsupported lowering, "{what} through `a[key]` without `Indexed` in the prelude", at
      return None
    }
  }
  const arguments = match traitArgumentsOf(lowering.checker, container, symbol) {
    Some(found) => found
    None => {
      const shown = lowering.checker.describe container
      reportUnsupported lowering, "{what} through `a[key]` on `{shown}`, which the back end cannot change by index", at
      return None
    }
  }
  const bound = lowering.checker.nominal symbol, arguments
  dispatchedOn lowering, container, bound, name, at
}

/**
 * The other half of every `a[key]` on a path: `MutableIndexed.set` puts the element back where it came from, **innermost
 * first**, after the access has run - an element that is itself in a container has to be back in it before that container
 * goes back into its own.
 *
 * It is what makes a change through `a[key]` a change of the container and not of a copy, and it is where copy on write
 * happens: the access made the element unique (it had to, the container still held a count of it), and `set` releases
 * what the container had there.
 */
public fn putBackElements(var lowering: Lowering, var builder: FunctionBuilder, taken: List<TakenElement>) {
  if taken.isEmpty() || !lowering.isSupported || lowering.isDiverged {
    return
  }
  const voidType = voidTypeOf lowering
  for position in 0..taken.length() {
    const entry = taken[taken.length() - 1 - position]
    // One entry per operand, because that is how a call says which of its positions takes a place and which a value
    const places: List<Reference?> = [entry.container, None, None]
    const operands = [entry.container.base, entry.key, entry.element]
    const _ = lowerDispatched lowering, builder, None, entry.at, entry.setter, operands, places, voidType
    if !lowering.isSupported {
      return
    }
  }
}

/** Whether a slot is a `var` parameter of this frame: it holds a pointer into the caller's frame and not a value. */
public fn isReferenceSlot(builder: FunctionBuilder, slot: Slot): Bool {
  if !builder.function.hasSlot(slot) {
    return false
  }
  if const .Parameter(index) = builder.function.slots[slot.value].role {
    if const Some(parameter) = builder.function.signature.parameters.get(index) {
      return parameter.byReference
    }
  }
  false
}

// --- What a call does with a place -----------------------------------------------------------------------------------

/**
 * The place a `var fn` call changes. The checker recorded it under the span of what stands in front of the dot, and
 * under the span of the callee where the member was written bare - the same two spans `openReceiverAccess` opened its
 * access at, which is why this is not read off the syntax tree again.
 */
public fn receiverReference(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  callee: Expression,
  what: String,
): PlacePath? {
  const target = receiverPlaceOf callee
  referenceAt lowering, builder, target, what
}

/** What stands in front of the dot, or the callee itself where the member was written bare. */
fn receiverPlaceOf(expression: Expression): Expression {
  match expression.kind {
    .Member(base, _, _) => base
    .Generic(inner, _) => receiverPlaceOf inner
    _ => expression
  }
}

/**
 * One argument that fills a `var` parameter. A **temporary** is one of them: the callee is its only owner, so "copy in,
 * copy out" is exact and nothing is written back anywhere (docs/TYPECHECKER.md, `using` passes a temporary to a `var`
 * parameter) - it is lowered into a slot of its own, in the position it was written, and the callee gets the address
 * of that slot.
 */
public fn argumentReference(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  value: Expression,
  annotation: IrTypeId,
  what: String,
): PlacePath? {
  if isTemporaryPlace(lowering, value.span) {
    const slot = addTemporary builder, annotation
    const _ = lowerExpression lowering, builder, value, slot
    if !lowering.isSupported {
      return None
    }
    return PlacePath Reference(slot, []), annotation
  }
  referenceAt lowering, builder, value, what
}

/**
 * Whether the result of a call would land in the base of a place the same call writes through (`x = f(x)` where `f` takes
 * `x` by `var`). The lowering then produces into a slot of its own and writes the result through the destination, because
 * an assignment into the base would overwrite - and therefore leak - what the callee has just put there.
 */
public fn collidesWithPlace(destination: Slot?, places: List<Reference?>): Bool {
  const slot = match destination {
    Some(found) => found
    None => {
      return false
    }
  }
  for place in places {
    if const Some(found) = place {
      if found.base == slot {
        return true
      }
    }
  }
  false
}

// --- Writing through a place -----------------------------------------------------------------------------------------

/**
 * `p.x = 1`, `target.count = target.count + 1`, and an assignment through a `var` parameter: a `Write` through the path
 * the checker recorded. The write **releases what was there** before it stores the new value, which is the contract the
 * value operand of a write carries (BACKEND 5.4) and the reason an assignment through a `var` parameter may not simply
 * compute into its slot.
 *
 * The **value goes first**, and only then is the path formed. That is what BACKEND 2.3 says a `var` access is - the
 * access begins once everything the call needs has been evaluated, "not when the path is formed" - and for a path with
 * an index it is load bearing: `points[index].y = failing()` has to reach `failing()` at the same point whether the
 * write goes through the taken-out element or through the `Element` step `ir/elements.trb` replaces it with. A path
 * without an index evaluates nothing at all, so for `p.x = 1` the order is no order.
 */
public fn lowerPlaceAssignment(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  target: Expression,
  value: Expression,
) {
  // `a[key] = value` is `MutableIndexed.set` and not a `Write`, which is the whole difference between a write and an
  // insert: what a missing key does is the container's own answer (`map[key] = value` adds it) and no rule of the back end
  if const Some(place) = placeRecordedAt(lowering, target.span) {
    if isIndexedTarget(place) {
      lowerIndexAssignment lowering, builder, place, target, value
      return
    }
  }
  const what = "an assignment"
  const prelude = match pathPreludeAt(lowering, builder, target, what) {
    Some(found) => found
    None => {
      return
    }
  }
  const written = lowerValue lowering, builder, value
  if !lowering.isSupported {
    return
  }
  const path = match referenceFrom(lowering, builder, prelude, what, target.span) {
    Some(found) => found
    None => {
      return
    }
  }
  emit builder, Instruction.Write(path.reference, borrowed(written))
  putBackElements lowering, builder, path.taken
}

/** Whether the *last* step of a path is an index, which is what makes an assignment through it a `set`. */
fn isIndexedTarget(place: Place): Bool {
  if const Some(last) = place.steps.last() {
    if const .Index(_, _, _) = last {
      return true
    }
  }
  false
}

/**
 * `numbers[0] = 5`, `map[key] = value`, `grid[y][x] = v`: the last step of the path is the index, so the assignment is a
 * call of `MutableIndexed.set` on the container the rest of the path leads to. Everything in front of that index is an
 * ordinary place, which is what makes the nested case fall out of nothing: `grid[y]` is taken out and put back around the
 * `set`, by the very machinery a `var` argument uses.
 *
 * The order is what evaluation order asks for (docs/BACKEND.md, Evaluation order is only half specified): the place's
 * own subexpressions first - every key, in source order - then the value, and only then the access, which is where the
 * take-out of every index in front of the last one belongs (BACKEND 2.3). So `grid[y][x] = failing()` reaches
 * `failing()` before it reads the row, and the two shapes the write can take - the taken-out element and the `Element`
 * step of `ir/elements.trb` - panic in the same order.
 */
fn lowerIndexAssignment(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  place: Place,
  target: Expression,
  value: Expression,
) {
  const what = "an assignment"
  const at = target.span
  const steps = place.steps
  const last = steps.length() - 1
  const container = match steps[last] {
    .Index(found, _, _) => found
    _ => {
      reportUnsupported lowering, "an assignment through `a[key]` without a container", at
      return
    }
  }
  const root = match rootReferenceOf(lowering, builder, place.root, what, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const keys = match loweredKeys(lowering, builder, steps, indexKeysOf(target), what, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const key = match keys.last() {
    Some(found) => found
    None => {
      reportUnsupported lowering, "an assignment through `a[key]` without a key", at
      return
    }
  }
  const subject = substituted lowering, container
  const setter = match indexedMemberOf(lowering, subject, true, "set", what, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const written = lowerValue lowering, builder, value
  if !lowering.isSupported {
    return
  }
  const path = match steppedFrom(lowering, builder, root, steps[0..last], keys[0..keys.length() - 1], what, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const places: List<Reference?> = [path.reference, None, None]
  const operands = [path.reference.base, key, written]
  const voidType = voidTypeOf lowering
  const _ = lowerDispatched lowering, builder, None, at, setter, operands, places, voidType
  putBackElements lowering, builder, path.taken
}

/**
 * The value of a write, evaluated after the place - which for a path without an index is no order at all. It is lowered
 * into whatever slot it is already in, exactly as the field of a `Construct` is, so that `p.name = name` hands the count
 * of the binding over instead of copying it into a temporary first.
 */
fn writtenPlace(var lowering: Lowering, var builder: FunctionBuilder, path: PlacePath, value: Expression) {
  const slot = lowerValue lowering, builder, value
  if !lowering.isSupported {
    return
  }
  emit builder, Instruction.Write(path.reference, borrowed(slot))
}

/**
 * `database { url = "..." }`: a field is written only with `=` (2026-09-25) - the one property command left is a
 * trailing block on a record field, which configures the value the field already holds *in place* rather than
 * replacing it. The closure is a *receiver* closure over the field, so the field's own place is its `var self`
 * argument and the value is changed where it lies. Nothing is copied out and back in, which is what makes the
 * configuration DSL cost what an assignment costs. The checker recorded the field's own place under the span of the
 * callee.
 */
public fn lowerPropertyWrite(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  callee: Expression,
  value: Expression,
): Slot {
  const holder = lowerValue lowering, builder, value
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const path = match referenceAt(lowering, builder, callee, "a property command") {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const voidType = voidTypeOf lowering
  const site = Some locationOf(lowering, callee.span)
  emitClosureCall lowering, builder, None, holder, [path.reference.base], [path.reference], voidType, site
  match destination {
    Some(_) => voidSlot lowering, builder, destination
    None => abandonedSlot lowering, builder, destination
  }
}

/**
 * `text = other`, `list = other` - an assignment to a plain local whose type carries a count.
 *
 * It is a `Write` through the slot and not a value computed *into* the slot, because a write releases what was there
 * and a store does not: `var a = "x"  a = b` would otherwise drop the count of `"x"` on the floor. Only the counted
 * locals go through here, so the arithmetic half of a program is byte for byte what it was.
 */
public fn lowerSlotAssignment(var lowering: Lowering, var builder: FunctionBuilder, slot: Slot, value: Expression) {
  const annotation = builder.typeOfSlot slot
  writtenPlace lowering, builder, PlacePath(Reference(slot, []), annotation), value
}

/**
 * Every `MakeUnique` a write through a path needs: one per counted owner along it, **outermost first**, the place itself
 * last.
 *
 * The ownership pass of 5.4 does exactly this for a `Write`, a `TakeOut` and a `var` argument, but only for the *proper
 * prefixes* - the storage the place itself names is the callee's business there. A `var fn` member of a **trait-typed
 * value** is the one call where it is not: the callee is handed the payload inside the box, so the box at the end of the
 * path has to be unique too, and only the lowering knows that the call writes. 5.4 lets the lowering take the decision
 * over (a `MakeUnique` directly in front of an instruction says "already made unique"), which is why both halves are
 * emitted here and the pass adds nothing.
 */
public fn makeOwnersUnique(var lowering: Lowering, var builder: FunctionBuilder, place: Reference) {
  var needed: List<Reference> = []
  var ignored: List<String> = []
  for count in 0..place.steps.length() {
    const prefix = Reference place.base, place.steps[0..count]
    if const Some(annotation) = typeOfReference(lowering.program, builder.function, ignored, "", prefix) {
      // A box and a `lazy` cell are shared on purpose: copying one is exactly what must not happen (docs/TYPECHECKER.md,
      // A captured `var` binding is a reference that escapes)
      if isSharedStorage(lowering.program, annotation) {
        continue
      }
      if mayBeCountedOwner(lowering.program, annotation) {
        needed.append prefix
      }
    }
  }
  needed.append place
  for reference in needed {
    emit builder, Instruction.MakeUnique(reference)
  }
}

/**
 * Whether a prefix of a path **may** be a counted owner - asked while the representations are not final yet.
 *
 * `isManagedType` answers for a `Record`, a `Variant` and a `Tuple` by the layout's *representation*, and a
 * representation is a fixpoint over the whole layout table that `finishLayouts` settles long after the lowering has run
 * (the trap `isStaticLayout` describes in the note of 6.1). So all three count as owners here, and the answer is the safe
 * one in both directions: a `MakeUnique` of a record that turns out to be **inline** emits nothing at all, while a
 * missing one is a write that a *copy* of the value can see.
 *
 * It is what made the first native build of the compiler misparse itself. `parseClosureParameters` backtracks by keeping a
 * copy of the whole `Parser` and assigning it back, and a `Parser` is a boxed record: the trial's `errorHere` wrote its
 * diagnostic into the box the copy shared, so the restore restored the error along with everything else and
 * `{ !imported.contains(_) }` came out as "Expected a pattern, found `!`".
 */
fn mayBeCountedOwner(program: IrProgram, id: IrTypeId): Bool {
  if isManagedType(program, id) {
    return true
  }
  match program.typeAt(id) {
    .Record(_) | .Variant(_) | .Tuple(_) => true
    _ => false
  }
}

/**
 * The result of a call that would otherwise overwrite the base of its own place: it is produced into a slot of its own
 * and stored through the destination, so that what the destination held is released before the new value lands in it.
 */
public fn writtenResult(var builder: FunctionBuilder, destination: Slot, source: Slot) {
  emit builder, Instruction.Write(Reference(destination, []), borrowed(source))
}
