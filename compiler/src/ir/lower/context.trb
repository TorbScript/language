/**
 * What the lowering from the checked syntax tree to the IR threads through itself: the program it builds, the tables
 * the type checker filled, and the little bookkeeping one function body needs.
 *
 * It is one `var lowering: Lowering` for the same reason the grammar has one `var parser: Parser` and the checker one
 * `var checker: Checker` - every program-wide table lives in exactly one owner and is never held twice, because a
 * second live copy across a write is O(n).
 *
 * The **builder** of the function that is being lowered is deliberately *not* a field of this value: a lowering
 * function takes `var lowering: Lowering` and `var builder: FunctionBuilder` side by side, so that emitting an
 * instruction never has to read a field of the same place that was just taken out.
 */

use Span, LineIndex from "../../syntax/source"
use Diagnostic from "../../syntax/diagnostic"
use ModuleId from "../../semantics/module"
use SymbolId from "../../semantics/symbols"
use TypeId, ParameterId, Signature, ImplementationId from "../../semantics/checker/type"
use Checker from "../../semantics/checker/context"
use NativeEntry, nativeEntries, ArrayOperation from "../../backend/c/natives"
use BuildTarget from "../../project/target"
use IrProgram, IrTypeId, IrType, Slot, BlockId, StaticId, StaticValue, StaticContents from "../ir"
use Location, LocationId, Terminator, Argument, Reference, borrowed, referenced from "../ir"
use FunctionId, Intrinsic, RuntimeKind from "../ir"
use substitute from "../../semantics/checker/unify"
use Instantiation, newInstantiation, instantiateType from "../instantiate"
use canonicalType, canonicalLiteral, escapedComponent, mangledName from "../mangle"
use unsupportedMessage from "../unsupported"
use FunctionBuilder, terminate, switchTo from "../build"

/** One construct the lowering does not translate yet, with where it was first seen and how often it blocked a function. */
public type Unsupported {
  what: String
  /** `path:line:column` of the first occurrence. */
  at: String
  count: Int
}

/**
 * One error of the *program* the lowering found, with the module it belongs to so that it can be rendered like any
 * other diagnostic. The only ones there are come from the constant evaluator: overflow, a division by zero and a `nan`
 * in a compile-time constant are compile errors at that expression (docs/BACKEND.md, Overflow and division by zero in
 * a compile-time constant).
 */
public type LoweredProblem {
  module: ModuleId
  diagnostic: Diagnostic
}

/**
 * What a member without a source does. Two kinds of declaration have no body anywhere: a member of a **derived**
 * implementation (`Show`, `Equals`, `Hash`), and a `native fn` whose manifest entry is `.Derived` - plus the one case
 * the manifest does not name, a member a witness table has to point at although it is an intrinsic or a function of the
 * runtime. A table holds function pointers, so `Int64.equals` needs a function even where a call of it is one
 * instruction.
 *
 * It lives here rather than in `lower/derive.trb` because `Lowering` carries the worklist of these, and a field of
 * `Lowering` may not need a file that needs `Lowering` back.
 */
public type Generated {
  /** A wrapper around one intrinsic, so that a witness table has something to point at: `Int64.equals`. */
  case Operation(intrinsic: Intrinsic)
  /** The same for a function of the runtime: `Int64.show`. */
  case RuntimeCall(symbol: String)
  /**
   * `Type(field: value, ...)`, a case as `Case(field: value)` or as its bare name (docs/TYPECHECKER.md, The
   * generated `Show` format is not specified).
   */
  case Show
  /** The same, with a `String` quoted and a `Char` in single quotes: what everything nested calls. */
  case ShowNested
  case Equals
  case Hash
  case Compare
  /** `if self < 0 { -self } else { self }`, so the overflow of the smallest value falls out of `Negate`. */
  case Absolute
  /** `String.show()` is the text itself, `Void.equals` is always true: the argument, or one constant. */
  case Identity
  case Copy
  /**
   * The `from` of a `From` nobody wrote: the argument itself where it already is the target (the reflexive `From<Self>`
   * every type has), and otherwise the one case of the target that wraps exactly one value of the source.
   */
  case Conversion
  /**
   * The `tryFrom` of a literal type (`type Status = "online" | "offline"`): the text compared with every member, `Ok` of
   * the one it equals, and a `LiteralParseError` naming the text and every member where it equals none.
   */
  case LiteralParse
  /**
   * An empty container over the element descriptors of the owner's type arguments: `ArrayList.withCapacity` and friends.
   * It is `Instruction.ContainerNew` and can be nothing else, because `torb_list_new` needs a descriptor and no
   * declaration of `std/` can name one.
   */
  case Container(kind: RuntimeKind)
  /**
   * One of the three private members of `Array` that are its storage: `unfilled`, `load` and `store`, one instruction
   * each over the inline slots of the `FixedArray` (`ir/lower/derive.trb`).
   */
  case ArrayStorage(operation: ArrayOperation)
  /**
   * The three forms of a type's constructor, over `std/encoding`'s vocabulary: one body per type and format, because the
   * format is the member's own type parameter (`ir/lower/encoding.trb`).
   */
  case Encode
  case Decode
  case Describe
  /**
   * A required member of a `by` implementation (`type Meters with Add by value`): the one field of every value of the
   * type unwrapped, the field type's own member called, and a result of the type wrapped again (`ir/lower/derive.trb`).
   */
  case Delegate
}

/**
 * One member with type parameters of its own, for one list of arguments: `Stage.onto` for one `Final`. It is one slot of
 * every table of its trait.
 */
public type GenericSlot {
  member: SymbolId
  /** Closed checker types, one per type parameter the member declares itself. */
  arguments: List<TypeId>
  /** The member and the arguments by their ids, which is what tells two slots apart. */
  key: String
}

/** The type, the bound and the implementation one witness table was built for. */
public type TableSource {
  subject: TypeId
  bound: TypeId
  implementation: ImplementationId
}

/** One generated member that is known to be needed and not built yet. */
public type GeneratedRequest {
  /** The stub the worklist already added, whose body this replaces. */
  function: FunctionId
  kind: Generated
  /** The declaration the trait or the `native type` wrote down, for its name and its signature. */
  member: SymbolId
  /** The type the member is generated for. */
  subject: TypeId
  /** The trait it satisfies, with its arguments. */
  bound: TypeId
  /** The generic parameters of the member's owner, filled in for `subject`. */
  mapping: Map<ParameterId, TypeId>
}

/**
 * The one value every lowering function threads through itself (see the module comment): the program under
 * construction, the checker's tables, and the bookkeeping the function currently being lowered needs.
 */
public type Lowering {
  var program: IrProgram
  var checker: Checker
  var instantiation: Instantiation
  natives: List<NativeEntry>
  /** The name of the manifest entry to its index, so a native call is a lookup and never a scan over the table. */
  nativeIndex: Map<String, Int>
  /** How every module's path is written in a location, in the order of `program.graph.modules`. */
  paths: List<String>
  /**
   * What the program is built for: the case `OperatingSystem.current` and its two siblings answer, which decides the
   * arm a `match` on one of them keeps (`ir/fold.trb`) and which natives of `runtime/os/` may be reached.
   */
  target: BuildTarget
  /** The line index of a module, built the first time a location of it is needed and kept afterwards. */
  var lines: Map<Int, LineIndex> = [:]
  /** Whose tables are being read. A default argument is lowered at the call site but in the callee's module. */
  var module: ModuleId = ModuleId 0
  /** One static value per distinct constant: the literals of a program repeat, and their names have to agree. */
  var staticKeys: Map<String, StaticId> = [:]
  /** The slot of every binding of the function that is being lowered, by the span of the name it was declared under. */
  var slots: Map<Span, Slot> = [:]
  /**
   * The mangled name of the function that is being lowered, so that a closure written in it can be named after it.
   * While a closure body is being lowered it is that closure's name, which is what makes a nested closure's name
   * unique without an id in it.
   */
  var owner: String = ""
  /** How many closures the function that is being lowered has written so far: the second half of a closure's name. */
  var closureCount: Int = 0
  /**
   * The `var` bindings of the body that some closure captures, by the span they are declared under. A captured `var`
   * binding is a shared box (docs/TYPECHECKER.md, A captured `var` binding is a reference that escapes), and it has
   * to *become* one where it is declared - so the whole body is walked once before it is lowered
   * (`ir/lower/closure.trb`).
   */
  var capturedVariables: Map<Span, Bool> = [:]
  /** The slot that holds the shared box of such a binding, by the same span: every read and every write goes through it. */
  var boxes: Map<Span, Slot> = [:]
  /**
   * A binding that is reached through a place rather than through a slot: a `var` parameter a closure captured, which
   * lives in the environment as the pointer it is. `if var` of 5.9b needs the same table.
   */
  var references: Map<Span, Reference> = [:]
  /**
   * The parameter slots of the closure that is being lowered, by the position the *declaration* counts them in - which
   * is what `Adaptation.ImplicitParameter` names. Empty outside of a closure body.
   */
  var closureParameters: List<Slot> = []
  /**
   * The span of the closure that is being lowered, so that an implicit parameter can be told from an implicit parameter
   * of a closure *around* it: the checker declares every one of them under the span of its own closure, and only the
   * innermost one is reachable by position.
   */
  var closureAt: Span? = None
  /**
   * The top-level bindings of an entry file, by `SymbolId.value`: they are **locals of the entry function** and not
   * module constants, because a top-level `var` can be assigned to and a static value cannot.
   *
   * A module that is imported has no entry function, and its top-level `const` stays a static value the const evaluator
   * produces - there is no module initialization, ever.
   */
  var entryLocals: Map<Int, Slot> = [:]
  /** The one `Void` slot of the function that holds every result nobody takes, made when the first one needs it. */
  var hole: Slot? = None
  /**
   * The spans whose `Adaptation.Lazy` has already been dealt with, so that lowering the expression itself may not refuse
   * it a second time. Two of them: the fallback of a `??`, which is inlined as control flow because a short circuit
   * needs no thunk at all, and the body of a thunk the lowering is building right now - there the adaptation is the
   * reason the body is a function of its own.
   */
  var inlinedThunks: Map<Span, Bool> = [:]
  /**
   * The spans whose `Adaptation.Quote` is being replayed by the call that quotes them, so that lowering the expression
   * itself may not refuse it a second time. One caller: `assert`, whose condition is the ordinary expression it was
   * checked as and whose captures become the message of a failure (`ir/lower/quote.trb`).
   */
  var inlinedQuotations: Map<Span, Bool> = [:]
  /**
   * The spans whose `Adaptation.ShowValue` is already being replayed: an interpolated part, and an argument of `print`.
   * Everywhere else the adaptation stays a clean finding, so a `Show` the back end forgot to call cannot pass unnoticed.
   */
  var shownParts: Map<Span, Bool> = [:]
  /**
   * The slot and the type that stand in for the base of a `?.` while its member is being lowered, by the span of that
   * base: the payload of the `Option`, unwrapped in the arm that has one (`lowerOptionalMember`).
   *
   * There is at most one entry at a time and it is removed again right after, which is what lets the ordinary lowering of
   * a call and of a field read serve `a?.m` without a case of its own.
   */
  var optionalReceivers: Map<Span, Slot> = [:]
  var optionalReceiverTypes: Map<Span, TypeId> = [:]
  /** `false` once the function that is being lowered hit a construct the back end does not support yet. */
  var isSupported: Bool = true
  /**
   * Whether a finding is swallowed. Exactly one thing sets it: the **nested** tables of a witness table, which are built
   * because some *other* coercion might narrow through one and may therefore not blame the value that is being boxed
   * (`nestedTablesOf` in `ir/witness.trb`).
   */
  var isSilent: Bool = false
  /** Control cannot reach the end of the current block any more: `return`, `break`, `continue`, a panic. */
  var isDiverged: Bool = false
  /**
   * Whether the body being lowered is the body of a task - a function or a closure that answers a `Task`, a `spawn`
   * closure, the top-level code of an entry file - where an `await()` is a suspension point (`ir/lower/task.trb`).
   */
  var isTaskBody: Bool = false
  /** Where a `break` and a `continue` of the innermost loop go, innermost last. */
  var breakTargets: List<BlockId> = []
  var continueTargets: List<BlockId> = []
  /** Whether anything in the loop wrote a `break`: a `loop` without one never ends. */
  var loopBroke: List<Bool> = []
  /**
   * The blocks that are open in the body being lowered, innermost last, each with the bindings declared in it whose
   * value may hold a `Close` object, in declaration order: what an `EndOfScope` is written for at every way out of the
   * block (`ir/lower/scope.trb`).
   */
  var scopes: List<List<Slot>> = []
  /** How many of `scopes` were open where each loop of `breakTargets` began, innermost last. */
  var loopScopes: List<Int> = []
  /** The temporaries whose statement already ended them, by slot index: each one ends once (`endTemporaries`). */
  var endedTemporaries: Set<Int> = []
  /**
   * The declarations that implement `Close` and the traits an object of one can be seen through, by `SymbolId.value`,
   * asked of the checker once per program (`closeFactsKnown`), and per IR type whether a value of it may hold such an
   * object.
   */
  var closeTypes: Set<Int> = []
  var closeTraits: Set<Int> = []
  var closeFactsKnown: Bool = false
  var closeHolding: Map<Int, Bool> = [:]
  /** The layouts whose `close()` was asked for already, by `LayoutId.value` (`requestCloseFunctions`). */
  var closeRequested: Map<Int, Bool> = [:]
  var unsupported: List<Unsupported> = []
  var unsupportedIndex: Map<String, Int> = [:]
  /** Errors of the program itself, in the order they were found. */
  var problems: List<LoweredProblem> = []
  /** How many instances were lowered, and how many became an `unreachable` stub. */
  var lowered: Int = 0
  var stubbed: Int = 0
  /** How far the worklist has come. The cursor never goes back, so draining it is one pass over a growing list. */
  var drained: Int = 0
  /**
   * The type arguments of the instance whose body is being lowered, by the generic parameter each of them fills.
   *
   * Every type the body mentions goes through `irTypeOf`, which substitutes this first - so the body of
   * `fn largest<Item: Compare>(items: Item, other: Item)` is lowered once per argument list and nothing inside it has
   * to know that it is generic.
   */
  var substitution: Map<ParameterId, TypeId> = [:]
  /** The substitution of every instance, by its key, so that draining the worklist can restore it. */
  var instanceMappings: Map<String, Map<ParameterId, TypeId>> = [:]
  /** The members the lowering generates from the layout, and how far that second worklist has come. */
  var pendingGenerated: List<GeneratedRequest> = []
  var drainedGenerated: Int = 0
  /** The generated member of one target, by the mangled name it got: one body per member per type. */
  var generatedInstances: Map<String, FunctionId> = [:]
  /**
   * The wrapper around one function of the runtime, by the mangled name it got (`ir/lower/native.trb`): one per
   * instance of a native whose ABI is not the declaration's.
   */
  var nativeWrappers: Map<String, FunctionId> = [:]
  /** The witness tables that are being built right now: a supertrait that leads back to its own subtrait. */
  var buildingTables: Map<String, Bool> = [:]
  /**
   * The members with type parameters of their own that a trait-typed value was called through, by the `TraitId` of the
   * table the value carries: each one is a slot behind the fixed members of every table of that trait, in the order the
   * calls asked for them (`ir/witness.trb`, `genericSlotOf`).
   */
  var genericSlots: Map<Int, List<GenericSlot>> = [:]
  /** What every witness table was built for, by its index: what a generic slot added after it fills in for it. */
  var tableSources: Map<Int, TableSource> = [:]
  /**
   * The names under which some implementation of the program declares a member, which is the **closed-world** question
   * "does anything override this default" (`ir/witness.trb`, `overridesAnyMember`). Built once, from the whole program,
   * because the layout of a table has to be the same for every implementer of its trait.
   */
  var overriddenMembers: Map<String, Bool> = [:]
  var overriddenMembersAreKnown: Bool = false
  /**
   * Which packages the **program** consists of, by their index in `Workspace.packages`: the roots' own, everything they
   * depend on and the prelude (`programPackagesOf` in `ir/lower/lower.trb`). Every closed-world question of the back end
   * is asked over exactly these, because a package next to yours in a workspace must not change your binary - and
   * `readSourceTree` reads the whole workspace whatever is being built.
   *
   * Empty means "no answer yet", which is every reader's cue to take the whole tree: a `Lowering` built by hand in a test
   * has no roots to derive it from.
   */
  var programPackages: Map<Int, Bool> = [:]
  /**
   * The static value of every constant, by the key of its instance (`constantInstanceOf` in `ir/constant.trb`): a
   * `const` of a generic type is one value per type argument, so the declaration alone does not name it.
   */
  var constants: Map<String, StaticId> = [:]
  /** The constants whose initializer is being evaluated right now: a `const` in terms of itself is a cycle. */
  var evaluating: Map<String, Bool> = [:]
  /**
   * The constants whose initializer is being lowered **at a use site** right now, by the key of their instance: the same
   * cycle one level further on. A `const` that is not static data has no static value to stop at, so the recursion needs
   * its own guard - and a cycle is a diagnostic of the checker, so hitting this one is a clean finding and never a hang.
   */
  var inlinedConstants: Map<String, Bool> = [:]
  /**
   * The accessor of every constant whose value is an **immortal counted static**, by the key of its instance: one cell
   * and one initializer per instance, however many modules read it (`lowerImmortalConstant` in
   * `ir/lower/expression.trb`).
   */
  var constantCells: Map<String, FunctionId> = [:]
  /**
   * The accesses of every entry cell made so far, by `SymbolId.value` of the `const` it belongs to, and `None` for a
   * `const` that has none (`ir/lower/cell.trb`). Program-wide, because the entry function writes a cell and the
   * functions of its file read it, in whichever order the worklist reaches them.
   */
  var entryCells: Map<Int, EntryCellAccesses?> = [:]
  /** The read of every entry cell a function read so far, by `SymbolId.value` of its `const`. */
  var entryCellReads: Map<Int, FunctionId> = [:]
  /** The function of every receiver script lowered so far, by `ModuleId.value` (docs/design/SCRIPTS.md section 3). */
  var scriptFunctions: Map<Int, FunctionId> = [:]
  /** The functions `lowerScripts` was asked to call the scripts through, in the order it was given them. */
  var scriptHosts: List<FunctionId> = []
  /**
   * Whether the program is lowered for the VM, which is the one thing the IR of both back ends differs in: a call of
   * `runScript` of `std/sandbox` is an operation of the VM there, and a finding for the C back end (docs/design/SCRIPTS.md
   * section 1).
   */
  var forMachine: Bool = false
}

/** One entry cell (`FunctionKind.EntryCell`): its write, and what its read is made from when a function reads it. */
public type EntryCellAccesses {
  write: FunctionId
  /** The type the cell holds, which the entry's binding has to have. */
  held: IrTypeId
  /** The name of the cell in the back end. */
  cell: String
  /** The mangled name of the constant, which the names of the accesses are built from. */
  accessor: String
}

/** A lowering for one checked program. `paths` holds one path per module, in the order of `program.graph.modules`. */
public fn newLowering(checker: Checker, paths: List<String>, target: BuildTarget): Lowering {
  const instantiation = newInstantiation checker
  const entries = nativeEntries()
  var index: Map<String, Int> = [:]
  for position in 0..entries.length() {
    const name = entries[position].name
    if !index.containsKey(name) {
      index.set name, position
    }
  }
  Lowering IrProgram(), checker, instantiation, entries, index, paths, target
}

// --- What the back end does not do yet ------------------------------------------------------------------------------

/**
 * Records a construct the lowering does not translate yet. The function being lowered becomes an `unreachable`
 * stub, so a real body can replace it later without anything else changing, and the counts are the progress bar
 * `statisticsLines` (`ir/lower/lower.trb`) reports.
 *
 * Only the *first* one per function is recorded: everything after it walks a body whose slots were abandoned, and one
 * root cause gets one message - the same rule the checker's diagnostics follow.
 *
 * `what` names the construct as a noun phrase and never a plan number: the sentence a user reads is
 * [unsupportedMessage]'s, and the C emitter's findings go through the same one.
 */
public fn reportUnsupported(var lowering: Lowering, what: String, at: Span, because: String = "") {
  if lowering.isSilent || !lowering.isSupported {
    return
  }
  lowering.isSupported = false
  const message = unsupportedMessage what, because
  if const Some(index) = lowering.unsupportedIndex.get(message) {
    const entry = lowering.unsupported[index]
    lowering.unsupported.set index, entry.copy(count: entry.count + 1)
    return
  }
  const place = describeSpan lowering, at
  const next = lowering.unsupported.length()
  lowering.unsupportedIndex.set message, next
  lowering.unsupported.append Unsupported(message, place, 1)
}

/**
 * An error of the program, at the expression that caused it. Not an internal error - those go to
 * `IrProgram.problems` - and not a construct the lowering does not translate yet (`reportUnsupported`).
 */
public fn reportProblem(var lowering: Lowering, message: String, at: Span) {
  const module = lowering.module
  const problem = Diagnostic.error message, at
  lowering.problems.append LoweredProblem(module, problem)
}

/** `src/main.trb:12:5`, the way a location is written everywhere else. */
public fn describeSpan(var lowering: Lowering, at: Span): String {
  const index = lowering.module.value
  const path = pathOfModule lowering, index
  const lines = lineIndexOf lowering, index
  const (line, column) = lines.lineAndColumn at.start
  "{path}:{line}:{column}"
}

/** The interned location of a span of the module that is being lowered. */
public fn locationOf(var lowering: Lowering, at: Span): LocationId {
  const index = lowering.module.value
  const path = pathOfModule lowering, index
  const lines = lineIndexOf lowering, index
  const (line, column) = lines.lineAndColumn at.start
  lowering.program.internLocation Location(path, line, column)
}

fn pathOfModule(lowering: Lowering, index: Int): String {
  lowering.paths.get(index) ?? "?"
}

/** Built on the first location of a module and kept: walking the characters of a file is not free. */
fn lineIndexOf(var lowering: Lowering, index: Int): LineIndex {
  if const Some(known) = lowering.lines.get(index) {
    return known
  }
  const modules = lowering.checker.program.graph.modules
  const text = if index >= 0 && index < modules.length() { modules[index].source.text } else { "" }
  const built = LineIndex.of text
  lowering.lines.set index, built
  built
}

// --- Types ----------------------------------------------------------------------------------------------------------

/**
 * The IR type a checker type stands for, with the type arguments of the instance that is being lowered filled in.
 * Everything that comes out of it is monomorphic, which is what the whole back end rests on.
 *
 * It is asked for the type of a **value**, so a const parameter read as one (`0..Rows`) is the type of its argument
 * (`Int64`) and not the type-level constant: the constant only means something as an argument of a type, where
 * `Grid<4>` and `Grid<5>` have to stay two instances.
 */
public fn irTypeOf(var lowering: Lowering, id: TypeId): IrTypeId {
  const mapping = lowering.substitution
  const built = instantiateType lowering.program, lowering.checker, lowering.instantiation, mapping, id
  if const .ConstantValue(_, of) = lowering.program.typeAt(built) {
    return of
  }
  built
}

/**
 * The same for a type that is closed already: a witness table and a generated member are built from types the caller
 * has substituted, and applying the *current* instance's arguments to one of those would be one substitution too many.
 */
public fn irTypeOfClosed(var lowering: Lowering, id: TypeId): IrTypeId {
  const empty: Map<ParameterId, TypeId> = [:]
  instantiateType lowering.program, lowering.checker, lowering.instantiation, empty, id
}

/** A checker type with the arguments of the instance that is being lowered filled in. Still a checker type. */
public fn substituted(var lowering: Lowering, id: TypeId): TypeId {
  const mapping = lowering.substitution
  if mapping.isEmpty() {
    return id
  }
  substitute lowering.checker.types, id, mapping
}

/**
 * The IR type of the expression at `at`, or `None` where the checker recorded nothing or something broken.
 *
 * A `native type` whose representation is not implemented yet has **none at all** here: `instantiateType` answers
 * `VoidType` for one so that a layout it sits in can still be built, and a *value* of it is then a slot nothing ever
 * defines - a call that answers a `Script` writes no target because its result looks like `Void`, and the
 * expression around it reads a slot that was never assigned. That would be two internal errors of the verifier, so the
 * body is abandoned here with the same clean finding as every other unsupported construct (`reportUnsupported`).
 */
public fn typeAtSpan(var lowering: Lowering, at: Span): IrTypeId? {
  const module = lowering.module
  const found = lowering.checker.expressionType(module, at)?
  if lowering.checker.isBroken(found) {
    return None
  }
  lowering.instantiation.plannedWhat = ""
  const built = irTypeOf lowering, found
  const planned = lowering.instantiation.plannedWhat
  if !planned.isEmpty() {
    reportUnsupported lowering, planned, at
    return None
  }
  Some built
}

/** The IR's `Void` type, interned once. */
public fn voidTypeOf(var lowering: Lowering): IrTypeId {
  lowering.program.internType IrType.VoidType
}

/** The IR's `Bool` type, interned once. */
public fn booleanTypeOf(var lowering: Lowering): IrTypeId {
  lowering.program.internType IrType.Boolean
}

/** Whether an IR type is `Void`. */
public fn isVoidType(lowering: Lowering, id: IrTypeId): Bool {
  match lowering.program.typeAt(id) {
    .VoidType => true
    _ => false
  }
}

/**
 * Whether a type is a `Task<Value>`. A function that answers one has a body that produces the `Value` (concept,
 * Concurrency), so its body and its signature disagree by design: the body becomes the resume function of the task
 * and the function itself its constructor (`ir/lower/task.trb`).
 */
public fn isTaskType(lowering: Lowering, id: IrTypeId): Bool {
  if const .Runtime(kind, _) = lowering.program.typeAt(id) {
    if const .TaskObject = kind {
      return true
    }
  }
  false
}

/** Whether an IR type is `Never`. */
public fn isNeverType(lowering: Lowering, id: IrTypeId): Bool {
  match lowering.program.typeAt(id) {
    .NeverType => true
    _ => false
  }
}

/** Whether a call of a function with this result produces a value something can take. */
public fn producesValue(lowering: Lowering, id: IrTypeId): Bool {
  !isVoidType(lowering, id) && !isNeverType(lowering, id)
}

// --- Static data ----------------------------------------------------------------------------------------------------

/**
 * One static value per distinct constant. The name is a function of the type and of the value, so two literals that
 * are the same value are one static and the text of the program does not depend on the order they were found in.
 */
public fn internStatic(var lowering: Lowering, contents: StaticContents, annotation: IrTypeId): StaticId {
  const spelling = spellingOfContents lowering, contents
  const key = "{annotation.value};{spelling}"
  if const Some(found) = lowering.staticKeys.get(key) {
    return found
  }
  const instance = "{canonicalType(lowering.program, annotation)}_{spelling}"
  const name = mangledName "s", ["literal"], instance
  const identifier = lowering.program.addStatic StaticValue(name, annotation, contents)
  lowering.staticKeys.set key, identifier
  identifier
}

/** A static value that carries the name of the declaration it is the value of: a top-level `const` of a module. */
public fn namedStatic(var lowering: Lowering, name: String, contents: StaticContents, annotation: IrTypeId): StaticId {
  lowering.program.addStatic StaticValue(name, annotation, contents)
}

/** How a constant is spelled inside a name. Injective, because every escape is, so two values never collide. */
fn spellingOfContents(lowering: Lowering, contents: StaticContents): String {
  match contents {
    .Literal(value) => canonicalLiteral value
    .VoidValue => "void"
    .Floating(value) => escapedComponent "{value}"
    .Aggregate(layout, variant, fields) => {
      var parts = ["{lowering.program.layoutAt(layout).name}", "{variant}"]
      for field in fields {
        parts.append lowering.program.staticAt(field).name
      }
      parts.joined separator: "_"
    }
    .Items(item, items) => {
      var parts = ["items", canonicalType(lowering.program, item)]
      for one in items {
        parts.append lowering.program.staticAt(one).name
      }
      parts.joined separator: "_"
    }
  }
}

/**
 * Every operand of a call and every field of a `Construct`, as `Borrowed`. Which position takes the count is decided
 * afterwards, out of the body written here, by the ownership pass (docs/BACKEND.md, Ownership in the IR) - so this
 * phase writes one thing everywhere.
 *
 * `places` names the positions that are `var` parameters: such an argument is the path itself and not a value, and it
 * stays borrowed whatever the ownership pass decides, because a reference carries no count (docs/BACKEND.md, Why
 * `var` paths need no counting). A list that is not as long as `slots` means the callee has no `var` parameter at all.
 */
public fn borrowedArguments(slots: List<Slot>, places: List<Reference?> = []): List<Argument> {
  var given: List<Argument> = []
  if places.length() != slots.length() {
    for slot in slots {
      given.append borrowed(slot)
    }
    return given
  }
  for index in 0..slots.length() {
    match places[index] {
      Some(place) => given.append referenced(place)
      None => given.append borrowed(slots[index])
    }
  }
  given
}

// --- The natives manifest -------------------------------------------------------------------------------------------

/**
 * `"Int64.add"`, `"print"`: what a `native` declaration becomes, looked up by owner and member name.
 *
 * A member a type has **once per source** is keyed by that source as well: `Int64.tryFrom` reads text and narrows a
 * `Float64`, and those are two functions of the runtime that the member name alone cannot tell apart. The manifest
 * writes every row of such a member with its source in parentheses and none without one - so the plain name is asked
 * first and misses, and the qualified name is what answers.
 */
public fn nativeNamed(lowering: Lowering, owner: String, member: String, signature: Signature): NativeEntry? {
  const key = if owner.isEmpty() { member } else { "{owner}.{member}" }
  if const Some(index) = lowering.nativeIndex.get(key) {
    return lowering.natives.get index
  }
  const source = conversionSourceOf lowering, signature
  if source.isEmpty() {
    return None
  }
  const index = lowering.nativeIndex.get("{key}({source})")?
  lowering.natives.get index
}

/** The type the one value of a conversion comes from, as the manifest writes it. Empty for every other member. */
fn conversionSourceOf(lowering: Lowering, signature: Signature): String {
  if signature.takesSelf || signature.form.parameters.length() != 1 {
    return ""
  }
  lowering.checker.describe signature.form.parameters[0].annotation
}

// --- Blocks ---------------------------------------------------------------------------------------------------------

/**
 * Terminates the current block. Everything after it in the same block is unreachable, which is what `isDiverged`
 * says - a lowering that kept emitting there would build a block nothing reaches, and the verifier rejects one.
 */
public fn finishBlock(var lowering: Lowering, var builder: FunctionBuilder, terminator: Terminator) {
  terminate builder, terminator
  lowering.isDiverged = true
}

/** Where the next instructions go. Control reaches the beginning of a block that was just opened. */
public fn continueIn(var lowering: Lowering, var builder: FunctionBuilder, block: BlockId) {
  switchTo builder, block
  lowering.isDiverged = false
}

// --- Loops ----------------------------------------------------------------------------------------------------------

/** Opens a new loop: where its `break` and its `continue` jump to, and a fresh flag for whether it ever broke. */
public fn enterLoop(var lowering: Lowering, exit: BlockId, step: BlockId) {
  lowering.breakTargets.append exit
  lowering.continueTargets.append step
  lowering.loopBroke.append false
  lowering.loopScopes.append lowering.scopes.length()
}

/** Answers whether anything in the loop wrote a `break`, which is what says a `loop` can be left at all. */
public fn leaveLoop(var lowering: Lowering): Bool {
  const last = lowering.breakTargets.length() - 1
  const _ = lowering.breakTargets.removeAt last
  const other = lowering.continueTargets.length() - 1
  const _ = lowering.continueTargets.removeAt other
  const opened = lowering.loopScopes.length() - 1
  const _ = lowering.loopScopes.removeAt opened
  const index = lowering.loopBroke.length() - 1
  lowering.loopBroke.removeAt(index) ?? false
}

/** A `break` of the innermost loop, so that the block after a `loop` is reachable. */
public fn markBreak(var lowering: Lowering) {
  const index = lowering.loopBroke.length() - 1
  if index >= 0 {
    lowering.loopBroke.set index, true
  }
}

/** Where a `break` of the innermost loop jumps to. */
public fn breakTarget(lowering: Lowering): BlockId? {
  lowering.breakTargets.last()
}

/** Where a `continue` of the innermost loop jumps to. */
public fn continueTarget(lowering: Lowering): BlockId? {
  lowering.continueTargets.last()
}
