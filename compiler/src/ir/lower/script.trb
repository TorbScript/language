/**
 * The table of the receiver scripts a program was compiled with (docs/design/SCRIPTS.md section 3): the generated
 * bodies of `scriptBody<Value>` and `scriptImports<Value>` of `std/sandbox`, one per receiver type.
 *
 * `Sandbox.load<ServerConfig>("./config.trb")` names a file the checker checked against `ServerConfig`, so the program
 * knows every script it can load, and which receiver each one has. `scriptBody<Value>(path)` answers the script function
 * of the one whose path relative to its package is `path` - a closure the sandbox runs - and `scriptImports<Value>(path)`
 * the modules its `use` lines name, each with its line, which `Sandbox.load` holds against the grant.
 *
 * Both bodies are a chain of text comparisons over constants: ordinary IR, which either back end could run.
 */

use Span, LineIndex from "../../syntax/source"
use SymbolId from "../../semantics/symbols"
use ModuleId from "../../semantics/module"
use TypeId, ParameterId from "../../semantics/checker/type"
use signatureOf from "../../semantics/checker/signature"
use scriptReceiverOf, moduleOfImport from "../../semantics/checker/receiver"
use ScriptTableKind from "../../backend/c/natives"
use relativePath, embeddedPathOf from "../../project/path"
use IrType, IrTypeId, FunctionId, BlockId, Slot, Instruction, Terminator, Intrinsic, IntrinsicOperation from "../ir"
use StaticContents, StaticId, borrowed from "../ir"
use LiteralValue from "../../semantics/checker/type"
use newFunction, addTemporary, addBlock, emit, terminate, switchTo, finishFunction, setBlockLocation from "../build"
use nativeWrapperName from "../mangle"
use symbolPathOf from "../instantiate"
use instanceArgumentsOf, irSignatureUnder from "../instances"
use Lowering, reportUnsupported, locationOf, internStatic from "./context"
use variantLayoutOfType, variantNamed from "./match"
use lowerScriptFunction from "./function"
use instanceFor from "../instances"
use implementsTraitNamed from "./encoding"

/** The generated body of one of the two tables for the receiver the instance names, built once per receiver. */
public fn scriptTableOf(
  var lowering: Lowering,
  member: SymbolId,
  mapping: Map<ParameterId, TypeId>,
  kind: ScriptTableKind,
  at: Span,
): FunctionId? {
  const receiver = match mapping.values().first() {
    Some(found) => found
    None => {
      reportUnsupported lowering, "the table of scripts without a receiver type", at
      return None
    }
  }
  const arguments = match instanceArgumentsOf(lowering, member, mapping) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "the table of scripts of a receiver that is not monomorphic", at
      return None
    }
  }
  const name = nativeWrapperName lowering.program, symbolPathOf(lowering.checker, member), arguments
  if const Some(found) = lowering.nativeWrappers.get(name) {
    return found
  }
  const signature = lowering.checker.signature signatureOf(lowering.checker, member)
  const declared = irSignatureUnder lowering, signature, mapping
  var builder = newFunction name, member, declared, "script table"
  const location = locationOf lowering, at
  setBlockLocation builder, BlockId(0), location
  const text = lowering.program.internType IrType.Text
  const boolean = lowering.program.internType IrType.Boolean
  const layout = variantLayoutOfType lowering, declared.result
  // No path at all: the receiver as the running `torb` - or the front end a native binary embeds - finds its declaration
  // again (docs/design/SCRIPTS.md slices 7 and 8), and the files that front end checks again
  if kind == ScriptTableKind.Receiver || kind == ScriptTableKind.Sources {
    // The C of a program that loads scripts names paths of the machine it was built on: the sources are keyed by them
    if kind == ScriptTableKind.Sources && !lowering.forMachine {
      lowering.asksScriptSources = true
    }
    const written = match kind {
      .Receiver => receiverTextOf lowering, receiver
      _ => if lowering.forMachine { "" } else { lowering.scriptSources }
    }
    const described = addTemporary builder, text
    emit builder, Instruction.Constant(described, textStatic(lowering, written, text))
    terminate builder, Terminator.Return(borrowed(described))
    const built = finishFunction lowering.program, builder
    lowering.nativeWrappers.set name, built
    return built
  }
  // A native binary runs no script natively: the front end it embeds loads even the ones it was compiled with
  const tabled = if lowering.forMachine || kind != ScriptTableKind.Body { scriptsOf lowering, receiver } else { [] }
  for (module, path) in tabled {
    const written = addTemporary builder, text
    emit builder, Instruction.Constant(written, textStatic(lowering, path, text))
    const equal = addTemporary builder, boolean
    const comparison = Intrinsic operation: IntrinsicOperation.TextEqual
    emit builder, Instruction.Intrinsic(equal, comparison, [Slot(0), written], location)
    const found = addBlock builder, "found", location
    const next = addBlock builder, "next", location
    terminate builder, Terminator.Branch(equal, found, next)
    switchTo builder, found
    match kind {
      .Body => {
        const inner = match layout {
          Some(found) => found
          None => {
            reportUnsupported lowering, "a table of scripts whose result is no `Option`", at
            return None
          }
        }
        const function = lowerScriptFunction(lowering, module, receiver)?
        const some = variantNamed lowering, inner, "Some"
        const closureType = lowering.program.layoutAt(inner).fieldsOfVariant(some)[0].annotation
        const closure = addTemporary builder, closureType
        emit builder, Instruction.Closure(closure, function, [], escaping: true)
        const result = addTemporary builder, declared.result
        emit builder, Instruction.Construct(result, inner, some, [borrowed(closure)])
        terminate builder, Terminator.Return(borrowed(result))
      }
      .Imports => {
        const imports = addTemporary builder, text
        emit builder, Instruction.Constant(imports, textStatic(lowering, importsOf(lowering, module), text))
        terminate builder, Terminator.Return(borrowed(imports))
      }
      // Answered above, without a path, or no table at all
      .Receiver | .Sources | .Crossing => {}
    }
    switchTo builder, next
  }
  match kind {
    .Body => {
      const inner = match layout {
        Some(found) => found
        None => {
          reportUnsupported lowering, "a table of scripts whose result is no `Option`", at
          return None
        }
      }
      const result = addTemporary builder, declared.result
      emit builder, Instruction.Construct(result, inner, variantNamed(lowering, inner, "None"), [])
      terminate builder, Terminator.Return(borrowed(result))
    }
    .Imports => {
      const nothing = addTemporary builder, text
      emit builder, Instruction.Constant(nothing, textStatic(lowering, "", text))
      terminate builder, Terminator.Return(borrowed(nothing))
    }
    .Receiver | .Sources => {}
    .Crossing => {
      reportUnsupported lowering, "the crossing of a script's value as a table", at
      return None
    }
  }
  const built = finishFunction lowering.program, builder
  lowering.nativeWrappers.set name, built
  built
}

/**
 * `crossedApply` of `std/sandbox` for the receiver of a `runCrossed` of a native binary (docs/design/SCRIPTS.md slice
 * 8): the value crosses into the VM through the derived `Encode` and `Decode` of the receiver, so a receiver without
 * them is an error of the program at the `Sandbox.load` that reached it.
 */
public fn crossedApplyOf(
  var lowering: Lowering,
  member: SymbolId,
  mapping: Map<ParameterId, TypeId>,
  at: Span,
): FunctionId? {
  const receiver = match mapping.values().first() {
    Some(found) => found
    None => {
      reportUnsupported lowering, "the crossing of a script's value without a receiver type", at
      return None
    }
  }
  if !implementsTraitNamed(lowering, receiver, "Encode") || !implementsTraitNamed(lowering, receiver, "Decode") {
    const shown = lowering.checker.describe receiver
    const what = "a script whose receiver `{shown}` is not `Encode & Decode`: a native binary hands the value to the VM it runs the script in as text"
    reportUnsupported lowering, what, at
    return None
  }
  const site = match lowering.checker.siteOf(member) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "the crossing of a script's value outside `std/sandbox`", at
      return None
    }
  }
  const symbol = match lowering.checker.program.scopes[site.module.value].names.get("crossedApply") {
    Some(found) => found
    None => {
      reportUnsupported lowering, "the crossing of a script's value without `crossedApply` in `std/sandbox`", at
      return None
    }
  }
  const identifier = signatureOf lowering.checker, symbol
  const signature = lowering.checker.signature identifier
  var crossed: Map<ParameterId, TypeId> = [:]
  if const Some(parameter) = signature.generics.first() {
    crossed.set parameter, receiver
  }
  instanceFor lowering, symbol, crossed
}

/**
 * `"<module path>\t<name>"`: where the receiver is declared, which is how the running `torb` finds the type again when
 * the program loads a script from a path only known while it runs. Empty for a receiver that is no type of a module or
 * that has type arguments, which the running program cannot name that way.
 */
fn receiverTextOf(var lowering: Lowering, receiver: TypeId): String {
  if const .Nominal(symbol, arguments) = lowering.checker.types.form(receiver) {
    if !arguments.isEmpty() {
      return ""
    }
    const declared = lowering.checker.symbolAt symbol
    if const Some(module) = declared.module {
      // In C, as the files the binary carries name it (`Lowering.scriptRoot`)
      const path = lowering.checker.program.graph.at(module).path
      const named = if lowering.forMachine { path } else { embeddedPathOf lowering.scriptRoot, path }
      return "{named}\t{declared.name}"
    }
  }
  ""
}

/** Every script the checker checked against `receiver`, with its path below its package, in the order of the graph. */
fn scriptsOf(var lowering: Lowering, receiver: TypeId): List<(ModuleId, String)> {
  var found: List<(ModuleId, String)> = []
  for module in lowering.checker.program.graph.modules {
    if const Some(.Loaded(_, _)) = module.receiver {
      if scriptReceiverOf(lowering.checker, module.id) == receiver {
        const package = lowering.checker.program.workspace.packages[module.package]
        found.append((module.id, relativePath(package.directory, module.path)))
      }
    }
  }
  found
}

/**
 * The modules the script imports, `"std/fs\t3"` per line: what `Sandbox.load` holds against the grant. A module is what
 * a grant names, the package or a module of `std/os` (`moduleOfImport`).
 */
fn importsOf(var lowering: Lowering, module: ModuleId): String {
  const inside = lowering.checker.program.graph.at module
  const lines = LineIndex.of inside.source.text
  var found: List<String> = []
  for statement in inside.file.statements {
    if const .Declare(declaration) = statement.kind {
      if const .Use(usage) = declaration.kind {
        if const .Module(path) = usage.source {
          const (line, _) = lines.lineAndColumn declaration.span.start
          found.append "{moduleOfImport(path)}\t{line}"
        }
      }
    }
  }
  found.joined separator: "\n"
}

fn textStatic(var lowering: Lowering, value: String, text: IrTypeId): StaticId {
  internStatic lowering, StaticContents.Literal(LiteralValue.Text(value)), text
}
