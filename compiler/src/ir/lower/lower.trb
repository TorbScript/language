/**
 * From a checked program to the IR, in the order the worklist finds it.
 *
 * `torb build` seeds the entry function alone - nothing unreachable is emitted - but `torb ir` seeds every
 * monomorphic declaration of every module it was asked about as well, because the share of them that lowers is the
 * progress bar `statisticsLines` reports, and a progress bar must not depend on what one entry file happens to call.
 */

use ModuleId from "../../semantics/module"
use programPackagesOf as programPackagesIn from "../../semantics/graph"
use Checker from "../../semantics/checker/context"
use Checked from "../../semantics/check"
use Package, Workspace from "../../project/workspace"
use relativePath, pathName from "../../project/path"
use BuildTarget, hostTarget from "../../project/target"
use IrProgram, IrFunction, Instruction, RuntimeKind from "../ir"
use devirtualizeProgram from "../devirtualize"
use rewriteElementPlaces from "../elements"
use dropProvableChecks from "../ranges"
use trackCallerSites from "../sites"
use dropListBoundsChecks from "../bounds"
use finishProgram, isManagedType from "../layout"
use verifyProgram, typeOfReference from "../verify"
use printProgram from "../print"
use Lowering, newLowering from "./context"
use lowerEntryFunction, lowerInstance, seedModule, lowerScriptFunction from "./function"
use SymbolId from "../../semantics/symbols"
use TypeId, ParameterId from "../../semantics/checker/type"
use scriptReceiverOf from "../../semantics/checker/receiver"
use instanceOfSymbol from "../instances"
use symbolPathOf from "../instantiate"
use instanceFor from "../instances"
use signatureOf from "../../semantics/checker/signature"
use lowerGenerated from "./derive"
use requestCloseFunctions from "./scope"
use settleEntryCells from "./cell"

/**
 * The whole lowering of a checked workspace: the entry functions first, then everything the worklist reaches.
 * `debugging` lowers it for a debugger - a `Statement` in front of every statement and a `KeepAlive` where every
 * binding's scope ends (docs/design/DEBUGGER.md sections 5 and 6).
 */
public fn lowerWorkspace(
  checker: Checker,
  paths: List<String>,
  modules: List<ModuleId>,
  seedsEverything: Bool,
  target: BuildTarget,
  forMachine: Bool = false,
  scriptSources: String = "",
  scriptRoot: String = "",
  debugging: Bool = false,
): Lowering {
  var lowering = newLowering checker, paths, target
  lowering.forMachine = forMachine
  lowering.debugging = debugging
  lowering.scriptSources = scriptSources
  lowering.scriptRoot = scriptRoot
  lowering.programPackages = programPackagesOf checker, modules
  const own = programModules checker, modules
  for module in own {
    // A script a `Sandbox.load` names is the body of its receiver, not top-level code (docs/design/SCRIPTS.md section 3)
    if checker.program.graph.at(module).receiver.isSome() {
      if const Some(receiver) = scriptReceiverOf(lowering.checker, module) {
        const _ = lowerScriptFunction lowering, module, receiver
        drainPending lowering
        continue
      }
    }
    const _ = lowerEntryFunction lowering, module
    drainPending lowering
  }
  if seedsEverything {
    for module in own {
      seedModule lowering, module
      drainPending lowering
    }
  }
  finishLowering lowering
  lowering
}

/**
 * The program of a host that runs receiver scripts (docs/design/SCRIPTS.md section 3): the script function of every
 * module in `scripts` against its receiver, the functions in `hosts` that call them, and everything they reach. A
 * `project.trb` is a script here, and the one place it is ever lowered: `evaluated` of `std/project` is its host.
 *
 * A generic host is instantiated with `hostArguments` for its type parameters, in order: `crossedHost<Value>` of
 * `std/sandbox` for the receiver, in the VM a native binary embeds (slice 8).
 */
public fn lowerScripts(
  checker: Checker,
  paths: List<String>,
  scripts: List<(ModuleId, TypeId)>,
  hosts: List<SymbolId>,
  target: BuildTarget,
  hostArguments: List<TypeId> = [],
): Lowering {
  var lowering = newLowering checker, paths, target
  lowering.forMachine = true
  var roots: List<ModuleId> = []
  for (module, _) in scripts {
    roots.append module
  }
  for symbol in hosts {
    if const Some(site) = checker.siteOf(symbol) {
      roots.append site.module
    }
  }
  lowering.programPackages = programPackagesOf checker, roots
  for (module, receiver) in scripts {
    const _ = lowerScriptFunction lowering, module, receiver
    drainPending lowering
  }
  for symbol in hosts {
    // The signature may be built only now, so it is asked for before the checker is read
    const identifier = signatureOf lowering.checker, symbol
    const generics = lowering.checker.signature(identifier).generics
    var mapping: Map<ParameterId, TypeId> = [:]
    for index in 0..generics.length().min(hostArguments.length()) {
      mapping.set generics[index], hostArguments[index]
    }
    if const Some(function) = instanceFor(lowering, symbol, mapping) {
      lowering.scriptHosts.append function
      lowering.program.hosted.append function
    }
    drainPending lowering
  }
  finishLowering lowering
  lowering
}

/**
 * The program of a library of C functions: the functions `exports` names and everything they reach, and no entry - the
 * script host a native binary that loads receiver scripts links in (docs/design/SCRIPTS.md slice 8). Each keeps the
 * signature it is declared with ([IrProgram.hosted]), because the C of another program calls it; its function is in
 * `scriptHosts`, in the order of `exports`.
 */
public fn lowerLibrary(checker: Checker, paths: List<String>, exports: List<SymbolId>, target: BuildTarget): Lowering {
  var lowering = newLowering checker, paths, target
  var roots: List<ModuleId> = []
  for symbol in exports {
    if const Some(site) = checker.siteOf(symbol) {
      roots.append site.module
    }
  }
  lowering.programPackages = programPackagesOf checker, roots
  for symbol in exports {
    const empty: Map<ParameterId, TypeId> = [:]
    if const Some(function) = instanceFor(lowering, symbol, empty) {
      lowering.scriptHosts.append function
      lowering.program.hosted.append function
    }
    drainPending lowering
  }
  finishLowering lowering
  lowering
}

/** What every lowering does once its roots are lowered, in the one order both back ends rely on. */
fn finishLowering(var lowering: Lowering) {
  // Nothing calls a destructor, so the objects that have one ask for it once everything else is lowered
  while requestCloseFunctions(lowering) {
    drainPending lowering
  }
  // Only once every function is lowered is it known which entry cells a function reads
  settleEntryCells lowering
  finishProgram lowering.program
  // Both back ends read the IR after this, so a value whose concrete type the program decides is that type from here
  // on: the boxes and the indirect calls of docs/PERFORMANCE.md finding 2 are gone before anything else looks
  devirtualizeProgram lowering.program
  // After it too, and for the same reason: `takenElement` formed the round trip while the container was still an
  // `Object(List<Int>)`, and only the devirtualization says which container is inside it
  rewriteElementPlaces lowering.program
  // After the devirtualization, because a payload that turned out not to be counted leaves a `makeUnique` behind that
  // the box it replaced did need
  dropUncountedMakeUnique lowering.program
  // Last of the three, because a direct call is what makes a constant visible where a dispatch hid it: an overflow
  // check the ranges of a function prove cannot fire is the plain operation from here on
  dropProvableChecks lowering.program
  const standard = standardFunctionsOf lowering
  // A read of a list whose index a loop proves inside it needs no check (docs/design/PANICS.md, recommendation 6)
  const (readers, lengths) = listMembersOf lowering, standard
  dropListBoundsChecks lowering.program, readers, lengths
  // Last, because which calls are direct and which checks remain is what decides where a panic can happen
  trackCallerSites lowering.program, standard
  // After the copies, which a frame names as it names their original
  lowering.program.frameNames = frameNamesOf lowering
}

/**
 * What a frame of the `dev` profile calls each function ([IrProgram.frameNames]): a declaration by the declarations
 * around it and its own name, `ArrayList.at`; a closure after the function it is written in, `a closure in main`; the
 * resume function of a task after the function that answers it; the top-level code of an entry file `the top level`.
 */
fn frameNamesOf(lowering: Lowering): List<String> {
  const functions = lowering.program.functions
  var byName: Map<String, Int> = [:]
  for index in 0..functions.length() {
    byName.set functions[index].name, index
  }
  var names: List<String> = []
  for function in functions {
    names.append frameNameOf(lowering, byName, function.name, 0)
  }
  names
}

fn frameNameOf(lowering: Lowering, byName: Map<String, Int>, name: String, depth: Int): String {
  // A closure inside a closure names its owner's owner, and a chain that long is a bug the bound keeps finite
  if depth > 16 {
    return name
  }
  if const Some(rest) = name.withoutPrefix("t_closure__") {
    const cut = rest.lastByteOffsetOf("_") ?? rest.byteLength()
    const owner = rest.sliceBytes 0, cut
    const named = frameNameOf(lowering, byName, owner, depth + 1)
    // The mangled name of an owner too long to spell is hashed, and then it names nothing to look up
    if named == owner {
      return "a closure"
    }
    return "a closure in {named}"
  }
  if const Some(rest) = name.withoutPrefix("t_resume__") {
    return frameNameOf(lowering, byName, rest, depth + 1)
  }
  if name.startsWith("t_spawned__") {
    return "a spawned task"
  }
  const function = match byName.get(name) {
    Some(index) => lowering.program.functions[index]
    None => {
      return name
    }
  }
  if const Some(symbol) = function.origin {
    const path = symbolPathOf lowering.checker, symbol
    var parts = path.owners
    parts.append path.name
    return parts.joined separator: "."
  }
  match function.blocks.first() {
    Some(entry) => if entry.label == "entry" { "the top level" } else { name }
    None => name
  }
}

/**
 * Which functions are the `at` and the `length()` of a list of `std/collections`: a member of that name whose first
 * parameter is the runtime's list. The readers are also recorded as element readers, so one whose every call was
 * rewritten into an `Element` step is left out of the emitted C like one `ir/elements.trb` made unnecessary.
 */
fn listMembersOf(var lowering: Lowering, standard: List<Bool>): (List<Bool>, List<Bool>) {
  var readers: List<Bool> = []
  var lengths: List<Bool> = []
  for index in 0..lowering.program.functions.length() {
    const function = lowering.program.functions[index]
    var isReader = false
    var isLength = false
    if const Some(symbol) = function.origin {
      if (standard.get(index) ?? false) && isListParameter(lowering, function) {
        const name = lowering.checker.symbolAt(symbol).name
        const count = function.signature.parameters.length()
        isReader = name == "at" && count == 2
        isLength = name == "length" && count == 1
        if isReader {
          lowering.program.elementReaders.insert symbol.value
        }
      }
    }
    readers.append isReader
    lengths.append isLength
  }
  (readers, lengths)
}

fn isListParameter(var lowering: Lowering, function: IrFunction): Bool {
  const first = match function.signature.parameters.first() {
    Some(found) => found
    None => {
      return false
    }
  }
  if first.byReference {
    return false
  }
  if const .Runtime(kind, _) = lowering.program.typeAt(first.type) {
    return kind == RuntimeKind.ListStorage
  }
  false
}

/**
 * Whether each function of the program was lowered from a library module of `std/` - a file under `src/` of a
 * package whose name starts with `std/` - which is what may track the site of its caller (`ir/sites.trb`). A test of
 * `std/` is the program's own code, and a generated body has no declaration to ask.
 */
fn standardFunctionsOf(var lowering: Lowering): List<Bool> {
  var standard: List<Bool> = []
  for function in lowering.program.functions {
    standard.append isStandardOrigin(lowering, function.origin)
  }
  standard
}

fn isStandardOrigin(var lowering: Lowering, origin: SymbolId?): Bool {
  const symbol = match origin {
    Some(found) => found
    None => {
      return false
    }
  }
  const site = match lowering.checker.siteOf(symbol) {
    Some(found) => found
    None => {
      return false
    }
  }
  const program = lowering.checker.program
  const module = program.graph.modules[site.module.value]
  const package = program.workspace.packages[module.package]
  if !package.name.startsWith("std/") {
    return false
  }
  const relative = if package.directory.isEmpty() { module.path } else { module.path.withoutPrefix("{package.directory}/") ?? module.path }
  relative.startsWith "src/"
}

/**
 * Every `MakeUnique` of a place that turned out **not** to be counted, removed - the one thing the lowering could not
 * decide while it ran.
 *
 * A representation is a fixpoint over the whole layout table that `finishProgram` settles, and the path of a `var self`
 * member of a trait-typed value is formed long before that. So `makeOwnersUnique` treats every record, variant and tuple
 * on the path as a possible owner: asking the other way round loses the one that matters, and a missing `MakeUnique` is a
 * write a **copy** of the value can see - which is what made the first native build of the compiler misparse itself
 * (`parseClosureParameters` backtracks by keeping a copy of the whole `Parser`, and a `Parser` is a boxed record).
 *
 * One that turned out inline carries no count and there is nothing to make unique, so it goes away here rather than being
 * accepted by the verifier: the rule "a `makeUnique` needs a place that is counted" stays exact, an IR snapshot stays free
 * of noise, and nothing after this point has to know that the question was ever open.
 */
fn dropUncountedMakeUnique(var program: IrProgram) {
  for index in 0..program.functions.length() {
    const function = program.functions[index]
    for block in 0..function.blocks.length() {
      const instructions = function.blocks[block].instructions
      var kept: List<Instruction> = []
      var isChanged = false
      var ignored: List<String> = []
      for instruction in instructions {
        if const .MakeUnique(reference) = instruction {
          const annotation = typeOfReference program, function, ignored, "", reference
          const isCounted = match annotation {
            Some(found) => isManagedType program, found
            None => false
          }
          if !isCounted {
            isChanged = true
            continue
          }
        }
        kept.append instruction
      }
      if isChanged {
        program.functions[index].blocks[block].instructions = kept
      }
    }
  }
}

/** The packages whose declarations are part of the program (`programPackagesOf` of `semantics/graph.trb`). */
fn programPackagesOf(checker: Checker, modules: List<ModuleId>): Map<Int, Bool> {
  programPackagesIn checker.program.graph, checker.program.workspace, modules
}

/**
 * The modules that are **program code**. A `project.trb` is not one: it is a manifest, and it is read *statically* by
 * `compiler/src/project/` - which is why the front end can check it as a receiver script while no back end ever compiles
 * one. So neither `torb ir` nor `torb build` lowers it, and the property command its receiver applies is not a finding of
 * the back end any more because **the file is not part of the program**, not because anything was hidden.
 *
 * Every other receiver script stays: a file a `Sandbox.load` names is code the program runs, and it lowers like any
 * other body. The one place a `project.trb` is lowered is [lowerScripts], as the script function the toolchain's
 * evaluation runs in the VM (docs/design/SCRIPTS.md section 3).
 */
fn programModules(checker: Checker, modules: List<ModuleId>): List<ModuleId> {
  var found: List<ModuleId> = []
  for module in modules {
    const receiver = checker.program.graph.at(module).receiver
    if const Some(.ProjectFile) = receiver {
      continue
    }
    found.append module
  }
  found
}

/** What `torb ir` lowers: everything the requested modules declare, for the machine it runs on unless told otherwise. */
public fn lowerChecked(checked: Checked, target: BuildTarget = hostTarget(), debugging: Bool = false): Lowering {
  const paths = pathsOfModules checked
  const modules = checked.requested
  const checker = checked.checker
  lowerWorkspace checker, paths, modules, seedsEverything: true, target: target, debugging: debugging
}

/**
 * One path per module, in the order of `program.graph.modules`: that is what a `ModuleId` indexes.
 *
 * The path is the package's name plus the file below the package's directory (`torbscript/compiler/src/ir/print.trb`),
 * **not** the way the path was typed on the command line. A location of the IR reaches the generated C as a `#line`
 * directive and the fixpoint compares two C files byte for byte, so no working directory and no machine may ever leak
 * into one.
 */
public fn pathsOfModules(checked: Checked): List<String> {
  var paths: List<String> = []
  for module in checked.program.graph.modules {
    const package = checked.program.workspace.packages[module.package]
    paths.append stablePathOf(package, module.path)
  }
  paths
}

fn stablePathOf(package: Package, path: String): String {
  if package.directory.isEmpty() {
    return pathName path
  }
  const relative = relativePath package.directory, path
  if package.name.isEmpty() {
    return relative
  }
  "{package.name}/{relative}"
}

/**
 * Every instance that is known to be needed and not lowered yet. The cursor never goes back, so the whole worklist is
 * one pass over a list that only grows - which is what keeps the lowering near-linear in the size of the program.
 */
public fn drainPending(var lowering: Lowering) {
  var isChanged = true
  while isChanged {
    isChanged = false
    while lowering.drained < lowering.program.pending.length() {
      const index = lowering.drained
      const instance = lowering.program.pending[index]
      lowering.drained = index + 1
      lowerInstance lowering, instance
      isChanged = true
    }
    // A generated member may need an instance of the source, and a body of the source a generated member: two lists,
    // one cursor each, and the outer loop until neither of them grew
    while lowering.drainedGenerated < lowering.pendingGenerated.length() {
      const index = lowering.drainedGenerated
      const request = lowering.pendingGenerated[index]
      lowering.drainedGenerated = index + 1
      lowerGenerated lowering, request
      isChanged = true
    }
  }
}

// --- What `torb ir` prints ------------------------------------------------------------------------------------------

/** The IR text of everything that was lowered, in the deterministic form of BACKEND 1.7. */
public fn loweredText(lowering: Lowering): String {
  printProgram lowering.program
}

/**
 * Whether the lowering found nothing to refuse. A lowering that checked bodies on demand and refused the program is
 * done again with every body of the program checked, so that the refusal is the one the whole program gives.
 */
public fn isLowered(lowering: Lowering): Bool {
  lowering.problems.isEmpty() && lowering.unsupported.isEmpty() && lowering.program.planned.isEmpty()
    && lowering.program.problems.isEmpty()
}

/** Everything the verifier found. An entry here is a bug of the lowering, never of the program. */
public fn loweredProblems(lowering: Lowering): List<String> {
  var found = verifyProgram lowering.program
  for problem in lowering.program.problems {
    found.append problem
  }
  found
}

/**
 * The progress bar: how many declarations became a function with a body, how many are still an `unreachable` stub, and
 * which construct blocked each of them - counted like the checker's `--statistics`.
 */
public fn statisticsLines(lowering: Lowering): List<String> {
  var lines: List<String> = []
  const total = lowering.lowered + lowering.stubbed
  const share = if total == 0 { 100 } else { lowering.lowered * 100 / total }
  lines.append "{lowering.lowered} of {total} functions lowered ({share}%), {lowering.stubbed} not supported yet"
  var sorted = lowering.unsupported
  sorted.sort({ (0 - _.count, _.what) })
  for entry in sorted {
    lines.append "  {entry.count}  {entry.what} (first at {entry.at})"
  }
  // A `native type` the runtime does not represent yet belongs here and not among the internal errors: it is a
  // declaration of `std/` that is not implemented yet, exactly like a `native fn` the manifest marks as planned
  var planned = lowering.program.planned
  planned.sort({ _ })
  for what in planned {
    lines.append "  {what}"
  }
  lines
}
