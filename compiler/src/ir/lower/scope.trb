/**
 * The ends of scopes: where a binding whose value may hold a `Close` object is released (docs/design/DESTRUCTORS.md
 * 2a). Such a binding is released at the end of the block it was declared in, in reverse declaration order, and not at
 * its last use - so the moment its `close()` runs is a line of the source and never a result of the liveness pass.
 *
 * The lowering keeps a stack of the open blocks ([Lowering.scopes]) and writes one `EndOfScope` per such binding at
 * every way out of a block: its end, a `return`, a `break` or `continue` out of it, a `?` that leaves the function, and
 * the `stop` of a task. The names of a pattern belong to the arm, the `then` block or the loop body they are bound for.
 * A temporary that may hold such an object ends with the statement that made it. What each end becomes - the release,
 * or nothing where a move already emptied the slot - is the ownership pass's decision (`ir/ownership.trb`).
 *
 * Every other binding is left alone, so a function that holds no such value is lowered exactly as before.
 *
 * A program lowered for a debugger (docs/design/DEBUGGER.md sections 5 and 6) keeps a second stack beside it,
 * [Lowering.visible]: every binding of every open block. A `Statement` in front of each statement lists them - the
 * locals its line shows - and a `KeepAlive` where their block ends keeps each one's value until then.
 *
 * # Pitfalls
 *
 * A temporary that only some paths of its statement define (the arms of an `if` expression, the fallback of a `??`)
 * ends with its statement too: the ownership pass clears its slot where the function begins and after an end inside a
 * loop, so a path that never made it releases the zero value, which is nothing. Only a type whose zero value cannot be released -
 * a trait-typed value held inline in a record - is left to its last use. A closure captures by retaining, so a binding a
 * closure captured is still held by its slot until its scope ends.
 */

use Span from "../../syntax/source"
use IrTypeId, Slot, Instruction, LayoutId, TraitId, RuntimeKind from "../ir"
use FunctionBuilder, emit from "../build"
use Lowering, enterModule, locationOf from "./context"
use closeImplementers, traitsOfCloseImplementers from "../../semantics/checker/close"
use TypeId, ParameterId from "../../semantics/checker/type"
use memberOfType from "../witness"

/** A block begins: the bindings declared from here on belong to it. */
public fn openScope(var lowering: Lowering) {
  lowering.scopes.append([])
  openVisible lowering
}

/**
 * A block ends: its scoped bindings end, the last declared first, where control still reaches the end - a block that
 * left through a `return` or a `break` ended its scopes there already.
 */
public fn closeScope(var lowering: Lowering, var builder: FunctionBuilder) {
  const last = lowering.scopes.length() - 1
  if last < 0 {
    return
  }
  if !lowering.diverged && lowering.supported {
    endBindings builder, lowering.scopes[last]
  }
  const closing = lowering.scopes.removeAt(last) ?? []
  closeVisible lowering, builder, closing
}

/** A binding of the innermost block, if its value may hold a `Close` object; in a debugged program, a binding it shows. */
public fn declareScoped(var lowering: Lowering, var builder: FunctionBuilder, slot: Slot) {
  declareVisible lowering, builder, slot
  const last = lowering.scopes.length() - 1
  if last < 0 {
    return
  }
  if !mayHoldClose(lowering, builder.typeOfSlot(slot)) {
    return
  }
  lowering.scopes[last].append(slot)
}

/**
 * Every binding the lowering declared from slot `from` on, for a destructuring `const (reader, writer) = ...` whose
 * names are bound through a plan: the temporaries of the plan are not bindings and stay out.
 */
public fn declareScopedFrom(var lowering: Lowering, var builder: FunctionBuilder, from: Int) {
  var index = from
  while index < builder.slotCount() {
    if const .Local = builder.function.slots[index].role {
      declareScoped lowering, builder, Slot(index)
    }
    index = index + 1
  }
}

/** The bindings of a pattern, slots `from ..< to`, as bindings of the innermost block: an arm, the body of a loop. */
public fn declareScopedBetween(var lowering: Lowering, var builder: FunctionBuilder, from: Int, to: Int) {
  var index = from
  while index < to {
    declareScoped lowering, builder, Slot(index)
    index = index + 1
  }
}

/**
 * The end of a statement: every temporary it made from slot `from` on that may hold a `Close` object, the last made
 * first. A statement inside it ended its own already, and a temporary is ended once, by the innermost statement. The
 * last expression of a block is a statement as well, whose own value - `except` - is the block's and is not ended.
 * One that is defined on only some paths through the statement - an arm of an `if` - ends here as well: its slot is
 * its drop flag, which the ownership pass clears on the paths that never made it (`withClearedTemporaries`).
 */
public fn endTemporaries(var lowering: Lowering, var builder: FunctionBuilder, from: Int, except: Slot? = None) {
  if lowering.diverged || !lowering.supported {
    return
  }
  var index = builder.slotCount() - 1
  while index >= from {
    if except == Slot(index) {
      index = index - 1
      continue
    }
    if const .Temporary = builder.function.slots[index].role {
      if !lowering.endedTemporaries.contains(index) && mayHoldClose(lowering, builder.typeOfSlot(Slot(index))) {
        lowering.endedTemporaries.insert index
        emit builder, Instruction.EndOfScope(Slot(index))
      }
    }
    index = index - 1
  }
}

/** A `return`, a `?` that leaves the function, the `stop` of a task: every open scope ends, the innermost first. */
public fn endEveryScope(var lowering: Lowering, var builder: FunctionBuilder) {
  if lowering.diverged {
    return
  }
  var index = lowering.scopes.length() - 1
  while index >= 0 {
    endBindings builder, lowering.scopes[index]
    index = index - 1
  }
}

/** A `break` or a `continue`: the scopes opened inside the innermost loop end, the innermost first. */
public fn endLoopScopes(var lowering: Lowering, var builder: FunctionBuilder) {
  if lowering.diverged {
    return
  }
  const depth = lowering.loopScopes.last() ?? 0
  var index = lowering.scopes.length() - 1
  while index >= depth {
    endBindings builder, lowering.scopes[index]
    index = index - 1
  }
}

fn endBindings(var builder: FunctionBuilder, slots: List<Slot>) {
  var index = slots.length() - 1
  while index >= 0 {
    emit builder, Instruction.EndOfScope(slots[index])
    index = index - 1
  }
}

// --- What a debugger sees -------------------------------------------------------------------------------------------

/**
 * The body of a function begins, in a debugged program with one open block of its own: the one a closure's captures are
 * declared in (docs/design/DEBUGGER.md section 5). Every function's lowering starts here.
 */
public fn startVisible(var lowering: Lowering) {
  lowering.visible = []
  openVisible lowering
}

/** A block a debugger sees begins, where a debugged program is lowered. */
public fn openVisible(var lowering: Lowering) {
  if lowering.debugging {
    lowering.visible.append([])
  }
}

/**
 * The innermost block a debugger sees ends: every binding of it is kept alive to here, the last declared first, so it
 * holds its value as long as a debugger shows it (docs/design/DEBUGGER.md section 6). A binding in `closing` - one whose
 * value may hold a `Close` object - already ends here, and keeping it alive would turn the move that hands it on into a
 * copy, which moves its `close()`.
 */
public fn closeVisible(var lowering: Lowering, var builder: FunctionBuilder, closing: List<Slot> = []) {
  const last = lowering.visible.length() - 1
  if !lowering.debugging || last < 0 {
    return
  }
  const slots = lowering.visible.removeAt(last) ?? []
  if lowering.diverged || !lowering.supported {
    return
  }
  var index = slots.length() - 1
  while index >= 0 {
    if !closing.contains(slots[index]) {
      emit builder, Instruction.KeepAlive(slots[index])
    }
    index = index - 1
  }
}

/**
 * The end of a body in a debugged program: its parameters and its captures, which a debugger shows in every one of its
 * frames, kept alive to here - an owned parameter handed on is copied instead of moved, so its slot still holds it.
 * A `return` further up leaves without them, and the frame goes with it.
 */
public fn keepBodyAlive(var lowering: Lowering, var builder: FunctionBuilder) {
  if !lowering.debugging || lowering.diverged || !lowering.supported {
    return
  }
  const parameters = builder.function.signature.parameters
  for index in 0..builder.function.slots.length() {
    const declared = builder.function.slots[index]
    if const .Parameter(position) = declared.role {
      const isValue = !(parameters.get(position)?.byReference ?? true)
      if isValue && !declared.name.isEmpty() {
        emit builder, Instruction.KeepAlive(Slot(index))
      }
    }
  }
  if const Some(captures) = lowering.visible.first() {
    for slot in captures {
      emit builder, Instruction.KeepAlive(slot)
    }
  }
}

/** A binding of the source a debugged program shows from its next statement on, until the innermost block ends. */
public fn declareVisible(var lowering: Lowering, var builder: FunctionBuilder, slot: Slot) {
  const last = lowering.visible.length() - 1
  if !lowering.debugging || last < 0 || !builder.function.hasSlot(slot) {
    return
  }
  const declared = builder.function.slots[slot.value]
  if const .Local = declared.role {
    if !declared.name.isEmpty() && !lowering.visible[last].contains(slot) {
      lowering.visible[last].append(slot)
    }
  }
}

/**
 * A statement of the source begins at `at`: a debugged program marks it with every binding in sight, the earliest
 * declared first - the line a debugger stops at and the locals it shows there (docs/design/DEBUGGER.md section 5).
 */
public fn markStatement(var lowering: Lowering, var builder: FunctionBuilder, at: Span) {
  if !lowering.debugging || lowering.diverged || !lowering.supported {
    return
  }
  var slots: List<Slot> = []
  for scope in lowering.visible {
    slots.appendAll scope
  }
  emit builder, Instruction.Statement(locationOf(lowering, at), slots)
}

// --- Which values may hold a `Close` object -------------------------------------------------------------------------

/**
 * Whether a value of this type may hold a `Close` object: an object of a `shared type` that implements `Close`, a
 * record, a case, a tuple or a container with one inside, and a trait-typed value of a trait some implementer of
 * `Close` implements. A closure is not asked into: what it captured is released with its environment.
 *
 * This is what the lowering can know while it runs, and it is the wider answer: the ownership pass narrows it with what
 * the whole program turned out to box into a trait-typed value.
 */
public fn mayHoldClose(var lowering: Lowering, id: IrTypeId): Bool {
  learnCloseFacts lowering
  if lowering.closeTypes.isEmpty() {
    return false
  }
  var search = Search()
  const answer = holdsClose lowering, id, search
  // A `false` at the top is final for every type the walk entered, a revisited one included: all of them reached only
  // types that answered `false`, because a `true` anywhere below would have made this one `true`. Without it every
  // question about a type of a recursive family - the syntax tree of the compiler - walked the whole family again
  if !answer {
    for entered in search.entered {
      lowering.closeHolding.set entered, false
    }
  }
  answer
}

/** What the checker knows about `Close`, asked once per program. */
fn learnCloseFacts(var lowering: Lowering) {
  if lowering.closeFactsKnown {
    return
  }
  const implementers = closeImplementers lowering.checker
  lowering.closeTypes = implementers
  lowering.closeTraits = traitsOfCloseImplementers lowering.checker, implementers
  lowering.closeFactsKnown = true
}

/** Where the walk over the types stands: the types it is still answering, and whether it came back to one of them. */
type Search {
  var visiting: Set<Int> = []
  /** Every type the walk entered, which a `false` at the top answers for all of them ([mayHoldClose]). */
  var entered: List<Int> = []
  /** A `false` below a type that was revisited is not final: the type it came back to may still answer `true`. */
  var revisited: Bool = false
}

fn holdsClose(var lowering: Lowering, id: IrTypeId, var search: Search): Bool {
  if const Some(known) = lowering.closeHolding.get(id.value) {
    return known
  }
  // A type that contains itself is answered by the rest of its fields
  if search.visiting.contains(id.value) {
    search.revisited = true
    return false
  }
  const outer = search.revisited
  search.revisited = false
  search.visiting.insert id.value
  search.entered.append id.value
  const answer = match lowering.program.typeAt(id) {
    .SharedObject(layout) => isCloseLayout(lowering, layout) || layoutHoldsClose(lowering, layout, search)
    .Record(layout) => layoutHoldsClose lowering, layout, search
    .Variant(layout) => layoutHoldsClose lowering, layout, search
    .Tuple(layout) => layoutHoldsClose lowering, layout, search
    .FixedArray(item, _) => holdsClose lowering, item, search
    .Box(inner) => holdsClose lowering, inner, search
    .Lazy(inner) => holdsClose lowering, inner, search
    // A `File` is a `Close` object the runtime owns: its block is no layout of the program, and its drop closes it
    .Runtime(kind, arguments) => kind == RuntimeKind.FileHandle || anyHoldsClose(lowering, arguments, search)
    .Object(bounds) => anyCloseTrait(lowering, bounds) || anyTraitArgumentHolds(lowering, bounds, search)
    _ => false
  }
  const _ = search.visiting.remove id.value
  if answer || !search.revisited {
    lowering.closeHolding.set id.value, answer
  }
  search.revisited = outer || search.revisited
  answer
}

fn anyHoldsClose(var lowering: Lowering, types: List<IrTypeId>, var search: Search): Bool {
  for id in types {
    if holdsClose(lowering, id, search) {
      return true
    }
  }
  false
}

fn layoutHoldsClose(var lowering: Lowering, layout: LayoutId, var search: Search): Bool {
  var fields: List<IrTypeId> = []
  for field in lowering.program.layoutAt(layout).fields {
    fields.append field.type
  }
  anyHoldsClose lowering, fields, search
}

fn anyCloseTrait(var lowering: Lowering, bounds: List<TraitId>): Bool {
  for bound in bounds {
    if lowering.closeTraits.contains(lowering.program.traitAt(bound).symbol.value) {
      return true
    }
  }
  false
}

/** `List<Probe>`, `Iterate<Probe>`: what a trait-typed value of a collection holds is what its type arguments hold. */
fn anyTraitArgumentHolds(var lowering: Lowering, bounds: List<TraitId>, var search: Search): Bool {
  for bound in bounds {
    const arguments = lowering.program.traitAt(bound).arguments
    if anyHoldsClose(lowering, arguments, search) {
      return true
    }
  }
  false
}

/** Whether a layout is the object of a `shared type` that implements `Close`. */
public fn isCloseLayout(var lowering: Lowering, layout: LayoutId): Bool {
  match lowering.program.layoutAt(layout).origin {
    Some(symbol) => lowering.closeTypes.contains symbol.value
    None => false
  }
}

// --- The destructor of every object that has one --------------------------------------------------------------------

/**
 * Asks for the `close()` of every `shared type` object of the program that implements `Close` and has none yet, and
 * records it in [IrProgram.closeFunctions]: nothing in the program calls `close()`, so it is the release of the object
 * that needs the instance (docs/design/DESTRUCTORS.md 8). Answers whether it asked for anything, because the bodies it
 * adds to the worklist may bring new objects with them - the caller drains the worklist and asks again until it does not.
 *
 * A `native shared type` gets no entry: its `close` is a function of the runtime, and the runtime's drop function of its
 * block already runs it.
 */
public fn requestCloseFunctions(var lowering: Lowering): Bool {
  learnCloseFacts lowering
  if lowering.closeTypes.isEmpty() {
    return false
  }
  const close = match lowering.checker.wellKnown.symbolNamed("Close") {
    Some(found) => found
    None => {
      return false
    }
  }
  var subjects: Map<Int, TypeId> = [:]
  for (key, value) in lowering.instantiation.memo {
    subjects.set value.value, TypeId(key)
  }
  var isRequested = false
  for index in 0..lowering.program.typeCount() {
    const layout = match lowering.program.typeAt(IrTypeId(index)) {
      .SharedObject(found) => found
      _ => {
        continue
      }
    }
    if lowering.closeRequested.containsKey(layout.value) || !isCloseLayout(lowering, layout) {
      continue
    }
    lowering.closeRequested.set layout.value, true
    lowering.program.closingLayouts.insert layout.value
    const subject = match subjects.get(index) {
      Some(found) => found
      None => {
        continue
      }
    }
    const symbol = match lowering.program.layoutAt(layout).origin {
      Some(found) => found
      None => {
        continue
      }
    }
    const declared = lowering.checker.symbolAt symbol
    if const Some(module) = declared.module {
      enterModule lowering, module
    }
    lowering.supported = true
    const empty: Map<ParameterId, TypeId> = [:]
    lowering.substitution = empty
    const bound = lowering.checker.nominal close, []
    const function = match memberOfType(lowering, subject, bound, "close", declared.span) {
      Some(found) => found
      None => {
        continue
      }
    }
    if const .Runtime(_) = lowering.program.functionAt(function).kind {
      continue
    }
    lowering.program.closeFunctions.set layout.value, function
    isRequested = true
  }
  isRequested
}
