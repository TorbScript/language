/**
 * One function body, from the first block to the last terminator, plus the entry function of a module.
 *
 * A body that turns out to need a construct the back end does not translate yet is **thrown away**: the
 * `unreachable` stub the worklist already added stays, the construct is counted, and every caller keeps a well typed
 * `Call`. That is what lets a still-unsupported construct be finished later as a plain replacement rather than a
 * rewrite.
 */

use Statement, Block, Binding, FunctionDeclaration, Declaration, ExtendDeclaration from "../../syntax/ast"
use ModuleId from "../../semantics/module"
use SymbolId, boundNamesOf from "../../semantics/symbols"
use TypeId, ParameterId, FunctionForm, ParameterForm, ParameterMode from "../../semantics/checker/type"
use signatureOf, typeSignatureOf from "../../semantics/checker/signature"
use extensionAt from "../../semantics/checker/implementation"
use Span from "../../syntax/source"
use IrSignature, IrTypeId, Slot, BlockId, FunctionId, Instance, Terminator, FunctionKind, LocationId, borrowed from "../ir"
use FunctionBuilder, newFunction, setBlockLocation, finishFunction, setFunctionKind, addBlock from "../build"
use resumeFunctionName from "../mangle"
use taskValueOf, resumeSignatureOf, buildTaskConstructor, numberSuspensions, hasSuspension from "./task"
use moduleComponentOf, instantiateSignature from "../instantiate"
use mangledName from "../mangle"
use instanceOfSymbol, instanceKeyOf, functionDeclarationOf, isMonomorphic from "../instances"
use Lowering, reportUnsupported, locationOf, isVoidType, isNeverType, isTaskType, typeAtSpan from "./context"
use finishBlock, continueIn, voidTypeOf, enterModule from "./context"
use lowerBlockInto, lowerBlockValue, lowerStatement from "./statement"
use capturedVariablesOf, capturedVariablesIn, savedFrame, restoreFrame, enterBody from "./closure"
use staticOfConstant from "../constant"
use taskValueOf as declaredTaskValueOf from "../../semantics/checker/statement"
use openScope, closeScope from "./scope"
use writeEntryCell from "./cell"

/** The body of one instance. The stub is replaced only where everything in it could be lowered. */
public fn lowerInstance(var lowering: Lowering, instance: Instance) {
  const symbol = instance.symbol
  const key = instanceKeyOf instance
  const identifier = match lowering.program.instances.get(key) {
    Some(found) => found
    None => {
      return
    }
  }
  const declaration = match functionDeclarationOf(lowering, symbol) {
    Some(found) => found
    None => {
      lowering.stubbed = lowering.stubbed + 1
      return
    }
  }
  const body = match declaration.body {
    Some(found) => found
    None => {
      lowering.stubbed = lowering.stubbed + 1
      return
    }
  }
  const module = match lowering.checker.siteOf(symbol) {
    Some(site) => site.module
    None => {
      lowering.stubbed = lowering.stubbed + 1
      return
    }
  }
  const stub = lowering.program.functionAt identifier
  const name = stub.name
  const signature = stub.signature
  beginFunction lowering, module
  // The type arguments this instance was reached with: every type the body mentions is substituted through them
  const empty: Map<ParameterId, TypeId> = [:]
  lowering.substitution = lowering.instanceMappings.get(key) ?? empty
  lowering.owner = name
  lowering.capturedVariables = capturedVariablesOf lowering, body
  const location = locationOf lowering, body.span
  // A declaration that *says* `Task<...>` - not one whose type parameter a task happens to fill, as `Option.expect` of
  // an `Option<Task<Int>>` does: that body produces the task itself
  if declaresTask(lowering, symbol) {
    if const Some(value) = taskValueOf(lowering, signature.result) {
      lowerTaskInstance lowering, identifier, symbol, declaration, body, signature, value, location
      return
    }
  }
  var builder = newFunction name, Some(symbol), signature, "body"
  setBlockLocation builder, BlockId(0), Some(location)
  // A parameter of type `Never` has no value to arrive with, so nothing ever runs this body: `described<Never>` is
  // called only from code that is unreachable itself. The body would ask for what `Never` does not have - a `Show`
  // of it, a layout - so the instance is its one `unreachable` block
  if hasNeverParameter(lowering, signature) {
    finishBlock lowering, builder, Terminator.Unreachable
    lowering.program.functions.set identifier.value, builder.function
    lowering.lowered = lowering.lowered + 1
    return
  }
  declareParameterSlots lowering, symbol, declaration
  lowerBody lowering, builder, body, signature.result
  if !lowering.isSupported {
    lowering.stubbed = lowering.stubbed + 1
    return
  }
  lowering.program.functions.set identifier.value, builder.function
  lowering.lowered = lowering.lowered + 1
}

/** Whether a value of one of the parameters can never exist, which makes a call of the function unreachable. */
fn hasNeverParameter(lowering: Lowering, signature: IrSignature): Bool {
  for parameter in signature.parameters {
    if isNeverType(lowering, parameter.annotation) {
      return true
    }
  }
  false
}

/** Whether the declaration writes `Task<...>` as its result, which is what makes its body the body of a task. */
fn declaresTask(var lowering: Lowering, symbol: SymbolId): Bool {
  const identifier = signatureOf lowering.checker, symbol
  const declared = lowering.checker.signature(identifier).form.result
  declaredTaskValueOf(lowering.checker, declared).isSome()
}

/**
 * The body of a function that answers a `Task<Value>`: the **resume function** of the task, whose body produces the
 * `Value` and may wait, and in the stub's place the **constructor** every caller already calls, which starts it
 * (`ir/lower/task.trb`).
 */
fn lowerTaskInstance(
  var lowering: Lowering,
  identifier: FunctionId,
  symbol: SymbolId,
  declaration: FunctionDeclaration,
  body: Block,
  signature: IrSignature,
  value: IrTypeId,
  location: LocationId,
) {
  const name = lowering.program.functionAt(identifier).name
  const resumeSignature = match resumeSignatureOf(lowering, signature, value, body.span) {
    Some(found) => found
    None => {
      lowering.stubbed = lowering.stubbed + 1
      return
    }
  }
  var resume = newFunction resumeFunctionName(name), Some(symbol), resumeSignature, "task"
  setFunctionKind resume, FunctionKind.TaskResume
  setBlockLocation resume, BlockId(0), Some(location)
  declareParameterSlots lowering, symbol, declaration
  lowering.isTaskBody = true
  lowerBody lowering, resume, body, value
  numberSuspensions resume
  if !lowering.isSupported {
    lowering.stubbed = lowering.stubbed + 1
    return
  }
  const started = finishFunction lowering.program, resume
  var constructor = newFunction name, Some(symbol), signature, "task"
  setBlockLocation constructor, BlockId(0), Some(location)
  buildTaskConstructor lowering, constructor, signature, started, value
  lowering.program.functions.set identifier.value, constructor.function
  lowering.lowered = lowering.lowered + 1
}

/** What every function starts from: no slots, no loops, nothing diverged, and the module its body is written in. */
public fn beginFunction(var lowering: Lowering, module: ModuleId) {
  enterModule lowering, module
  lowering.slots = [:]
  lowering.entryLocals = [:]
  lowering.hole = None
  lowering.isTaskBody = false
  lowering.inlinedConstants = [:]
  lowering.inlinedThunks = [:]
  lowering.inlinedQuotations = [:]
  lowering.quotedCaptures = [:]
  lowering.shownParts = [:]
  lowering.substitution = [:]
  lowering.isSupported = true
  lowering.isDiverged = false
  lowering.breakTargets = []
  lowering.continueTargets = []
  lowering.loopBroke = []
  lowering.scopes = []
  lowering.loopScopes = []
  lowering.endedTemporaries = Set.of()
  lowering.owner = ""
  lowering.closureCount = 0
  lowering.capturedVariables = [:]
  lowering.boxes = [:]
  lowering.references = [:]
  lowering.closureParameters = []
  lowering.closureAt = None
}

/**
 * The block of a body, and the terminator that follows it. Where the function produces a value the body is lowered
 * *into* the slot the `return` carries, so the last expression of a body needs no move of its own.
 */
public fn lowerBody(var lowering: Lowering, var builder: FunctionBuilder, body: Block, result: IrTypeId) {
  if isVoidType(lowering, result) {
    lowerBlockInto lowering, builder, body, None
    if !lowering.isDiverged {
      finishBlock lowering, builder, Terminator.Return(None)
    }
    return
  }
  if isNeverType(lowering, result) {
    lowerBlockInto lowering, builder, body, None
    if !lowering.isDiverged {
      // A generic body instantiated with `Never` ends in a value of it: `Some(value) => value` of
      // `Option<Never>.expect`. There is no value of `Never`, so the end of that body is never reached
      if lowering.isSupported && endsInNever(lowering, body) {
        finishBlock lowering, builder, Terminator.Unreachable
        return
      }
      // A function that does not return has to leave through a panic or a call of another such function
      reportUnsupported lowering, "a body of a function that returns `Never` and does return", body.span
      return
    }
    // The checker infers `Never` from a body that never *ends* (a `loop` without a `break`), and a bare `return`
    // inside such a loop does leave the function - so the body contradicts its own signature. One clean finding rather
    // than IR the verifier rejects; closing it is a rule of the checker's inference, not of the back end
    if returnsAnywhere(builder) {
      reportUnsupported lowering, "a `return` in a function whose result was inferred as `Never`", body.span
    }
    return
  }
  const found = lowerBlockValue lowering, builder, body
  if lowering.isDiverged {
    return
  }
  match found {
    Some(target) => finishBlock lowering, builder, Terminator.Return(Some(borrowed(target)))
    // A body that produces nothing and does not diverge is what the checker reports, so nothing is said here
    None => reportUnsupported lowering, "a body that produces no value", body.span
  }
}

/** Whether the last expression of a body has the type `Never` as instantiated, which no value has. */
fn endsInNever(var lowering: Lowering, body: Block): Bool {
  const last = match body.statements.last() {
    Some(found) => found
    None => {
      return false
    }
  }
  if const .Evaluate(expression) = last.kind {
    if const Some(annotation) = typeAtSpan(lowering, expression.span) {
      return isNeverType lowering, annotation
    }
  }
  false
}

/** Whether any block of the body leaves the function through a `return`, which a `Never` result may not. */
fn returnsAnywhere(builder: FunctionBuilder): Bool {
  for block in builder.function.blocks {
    if const .Return(_) = block.terminator {
      return true
    }
  }
  false
}

/**
 * `self` and the parameters, by the span of the name each of them was declared under - which is the very span the
 * checker's `LocalBinding` carries, so a name in the body finds its slot without the lowering keeping a scope chain.
 */
fn declareParameterSlots(var lowering: Lowering, symbol: SymbolId, declaration: FunctionDeclaration) {
  const identifier = signatureOf lowering.checker, symbol
  const signature = lowering.checker.signature identifier
  var next = 0
  for parameter in declaration.parameters {
    if parameter.name.text == "self" && parameter.annotation.isNone() {
      if signature.takesSelf {
        lowering.slots.set parameter.name.span, Slot(next)
        next = next + 1
      }
      continue
    }
    lowering.slots.set parameter.name.span, Slot(next)
    next = next + 1
  }
}

// --- The entry function of a module ---------------------------------------------------------------------------------

/**
 * The top-level code of an entry file, as one function. `t_main` for a script that belongs to no package, and the
 * package plus the module for one that does - a name with no member component, which no declaration can produce.
 *
 * Its top-level bindings are **locals of this function**, in source order, and not static values: `var counter = 0`
 * followed by `counter = counter + 1` is ordinary code, and a static value cannot be assigned to. A `const` of a module
 * that is *imported* stays a static value the const evaluator produces - there is no module initialization, ever.
 */
public fn lowerEntryFunction(var lowering: Lowering, module: ModuleId): FunctionId? {
  const statements = lowering.checker.program.graph.at(module).file.statements
  if !isEntryModule(lowering, module, statements) {
    return None
  }
  const name = entryNameOf lowering, module
  const voidType = voidTypeOf lowering
  const signature = IrSignature([], voidType)
  beginFunction lowering, module
  lowering.owner = name
  lowering.capturedVariables = capturedVariablesIn lowering, statements
  // An entry file may wait at the top level: where it does, its code becomes the resume function of the main task
  lowering.isTaskBody = true
  var builder = newFunction name, None, signature, "entry"
  for statement in statements {
    if isEntryStatement(statement) {
      const location = locationOf lowering, statement.span
      setBlockLocation builder, BlockId(0), Some(location)
      break
    }
  }
  // The top level of an entry file is the block of its entry function: its bindings end where the file does
  openScope lowering
  for statement in statements {
    if lowering.isDiverged || !lowering.isSupported {
      break
    }
    lowerTopLevel lowering, builder, statement
  }
  closeScope lowering, builder
  if !lowering.isDiverged {
    finishBlock lowering, builder, Terminator.Return(None)
  }
  if hasSuspension(builder) {
    setFunctionKind builder, FunctionKind.TaskResume
    numberSuspensions builder
  }
  if !lowering.isSupported {
    lowering.stubbed = lowering.stubbed + 1
    var stub = newFunction name, None, signature, "not supported yet"
    return Some finishFunction(lowering.program, stub)
  }
  lowering.lowered = lowering.lowered + 1
  Some finishFunction(lowering.program, builder)
}

/**
 * Whether the module is an entry file or a script: whether anything in it runs. A module of declarations and top-level
 * `const`s is not one - those constants are static data, and there is no module initialization, ever.
 */
public fn isEntryModule(var lowering: Lowering, module: ModuleId, statements: List<Statement>): Bool {
  for statement in statements {
    match statement.kind {
      .Declare(_) => {}
      .Bind(binding) => {
        if !isNamedBinding(lowering, module, binding) {
          return true
        }
      }
      _ => {
        return true
      }
    }
  }
  false
}

/** A top-level binding the module declared a name for. In an entry file it is a local; elsewhere it is static data. */
fn isNamedBinding(var lowering: Lowering, module: ModuleId, binding: Binding): Bool {
  if const .Binding(_) = binding.pattern.kind {
    return lowering.checker.resolvedName(module, binding.pattern.span).isSome()
  }
  false
}

/** Every statement of an entry file is code of its entry function; only a declaration is reached through the worklist. */
fn isEntryStatement(statement: Statement): Bool {
  match statement.kind {
    .Declare(_) => false
    _ => true
  }
}

/**
 * One statement of the entry function. A binding with a name of its own is a local like any other, and the symbol the
 * module declared for it is remembered so that a *name* of it later in the file finds the slot instead of a static.
 */
fn lowerTopLevel(var lowering: Lowering, var builder: FunctionBuilder, statement: Statement) {
  if const .Declare(_) = statement.kind {
    // Declarations are reached through the worklist, never emitted here
    return
  }
  lowerStatement lowering, builder, statement
  if const .Bind(binding) = statement.kind {
    rememberEntryLocal lowering, builder, binding
  }
}

/**
 * Every name a top-level binding declares, a destructuring one included: `const (quotient, remainder) = ...` is two
 * locals of the entry function, each found under the span of its own name, exactly like `const quotient = ...`. A name
 * of a `const` goes into its entry cell as well, which is where a function of the file reads it (`ir/lower/cell.trb`).
 */
fn rememberEntryLocal(var lowering: Lowering, var builder: FunctionBuilder, binding: Binding) {
  const module = lowering.module
  for name in boundNamesOf(binding.pattern) {
    if const Some(symbol) = lowering.checker.resolvedName(module, name.span) {
      if const Some(slot) = lowering.slots.get(name.span) {
        lowering.entryLocals.set symbol.value, slot
        writeEntryCell lowering, builder, symbol, slot, name.span
      }
    }
  }
}

// --- The function of a receiver script ------------------------------------------------------------------------------

/**
 * The function of a receiver script (docs/design/SCRIPTS.md section 3): the file as the body of
 * `(var self: Receiver) => Void`, lowered once per module however often it is asked for.
 *
 * The receiver is parameter zero, a reference, and the checker declared its binding at `Span(0, 0)` - so that span is
 * the parameter's slot, exactly as `bindClosureParameters` maps the implicit receiver of a closure. Every statement is
 * code of the body, the bindings are locals, and a `use` is no code at all.
 */
public fn lowerScriptFunction(var lowering: Lowering, module: ModuleId, receiver: TypeId): FunctionId? {
  if const Some(found) = lowering.scriptFunctions.get(module.value) {
    return Some found
  }
  const statements = lowering.checker.program.graph.at(module).file.statements
  const name = scriptNameOf lowering, module
  const voidType = lowering.checker.voidType
  const form = FunctionForm([ParameterForm(Some("self"), ParameterMode.Receiver(true), receiver)], voidType)
  const identifier = instantiateSignature lowering.program, lowering.checker, lowering.instantiation, form
  const signature = lowering.program.signatureAt identifier
  // A script is asked for where its value is made, which may be in the middle of another body
  const saved = savedFrame lowering
  const savedSupport = lowering.isSupported
  const savedDivergence = lowering.isDiverged
  enterBody lowering, name
  enterModule lowering, module
  lowering.substitution = [:]
  lowering.isSupported = true
  lowering.capturedVariables = capturedVariablesIn lowering, statements
  var builder = newFunction name, None, signature, "script"
  for statement in statements {
    if isEntryStatement(statement) {
      const location = locationOf lowering, statement.span
      setBlockLocation builder, BlockId(0), Some(location)
      break
    }
  }
  lowering.slots.set Span(0, 0), Slot(0)
  openScope lowering
  var isFirst = true
  for statement in statements {
    if lowering.isDiverged || !lowering.isSupported {
      break
    }
    if isImport(statement) {
      continue
    }
    // One block per statement of the file, each at its own location: a script that stops is blamed on the statement
    // that was running, even where nothing in it carries a location of its own (docs/design/SCRIPTS.md section 6)
    if !isFirst {
      const next = addBlock builder, "statement", Some(locationOf(lowering, statement.span))
      finishBlock lowering, builder, Terminator.Jump(next)
      continueIn lowering, builder, next
    }
    isFirst = false
    lowerStatement lowering, builder, statement
  }
  closeScope lowering, builder
  if !lowering.isDiverged {
    finishBlock lowering, builder, Terminator.Return(None)
  }
  const isSupported = lowering.isSupported
  restoreFrame lowering, saved
  lowering.isSupported = savedSupport
  lowering.isDiverged = savedDivergence
  if !isSupported {
    lowering.stubbed = lowering.stubbed + 1
    var stub = newFunction name, None, signature, "not supported yet"
    const stubbed = finishFunction lowering.program, stub
    lowering.scriptFunctions.set module.value, stubbed
    return Some stubbed
  }
  lowering.lowered = lowering.lowered + 1
  const function = finishFunction lowering.program, builder
  lowering.scriptFunctions.set module.value, function
  Some function
}

/** `use X from "..."`: a declaration of the file scope, never code. */
fn isImport(statement: Statement): Bool {
  if const .Declare(declaration) = statement.kind {
    if const .Use(_) = declaration.kind {
      return true
    }
  }
  false
}

/**
 * The name of a script function: the module's name with the member component `script`, which no declaration can
 * produce and which never collides with the entry function of the same module.
 */
public fn scriptNameOf(var lowering: Lowering, module: ModuleId): String {
  const inside = lowering.checker.program.graph.at module
  const package = lowering.checker.program.workspace.packages[inside.package]
  const component = moduleComponentOf package.directory, inside.path
  mangledName "t", [package.name, component], "script"
}

/** `t_main`, `t_acme_x2f_app_main`: the entry function is named after the file and has no member component. */
public fn entryNameOf(var lowering: Lowering, module: ModuleId): String {
  const inside = lowering.checker.program.graph.at module
  const package = lowering.checker.program.workspace.packages[inside.package]
  const component = moduleComponentOf package.directory, inside.path
  mangledName "t", [package.name, component], ""
}

// --- Seeding the worklist -------------------------------------------------------------------------------------------

/**
 * Every monomorphic declaration of a module, so that `torb ir` can say how much of real code the back end lowers.
 * `torb build` seeds the entry function alone - nothing unreachable is emitted there - but a progress bar has to
 * measure everything, not only what one entry file happens to call.
 */
public fn seedModule(var lowering: Lowering, module: ModuleId) {
  const statements = lowering.checker.program.graph.at(module).file.statements
  // The top-level bindings of an entry file are locals of its entry function, so seeding them would count them twice
  const isEntry = isEntryModule lowering, module, statements
  for statement in statements {
    match statement.kind {
      .Declare(declaration) => seedDeclaration lowering, module, declaration
      // A plain top-level `const` of a module that runs nothing is static data; `public const` is a declaration
      .Bind(binding) => {
        if !isEntry {
          if const .Binding(_) = binding.pattern.kind {
            if const Some(symbol) = lowering.checker.resolvedName(module, binding.pattern.span) {
              seedSymbol lowering, symbol
            }
          }
        }
      }
      _ => {}
    }
  }
}

fn seedDeclaration(var lowering: Lowering, module: ModuleId, declaration: Declaration) {
  match declaration.kind {
    .Function(function) => {
      if const Some(symbol) = lowering.checker.resolvedName(module, function.name.span) {
        seedSymbol lowering, symbol
      }
    }
    .Type(declared) => {
      if const Some(symbol) = lowering.checker.resolvedName(module, declared.name.span) {
        seedMembersOf lowering, symbol
      }
    }
    .Extend(extension) => seedExtension lowering, module, extension
    _ => {}
  }
}

fn seedMembersOf(var lowering: Lowering, symbol: SymbolId) {
  const identifier = typeSignatureOf lowering.checker, symbol
  const shape = lowering.checker.typeSignature identifier
  var names: List<String> = []
  for (name, _) in shape.members {
    names.append name
  }
  names.sort({ _ })
  for name in names {
    if const Some(member) = shape.members.get(name) {
      seedSymbol lowering, member
    }
  }
}

fn seedExtension(var lowering: Lowering, module: ModuleId, extension: ExtendDeclaration) {
  const found = match extensionAt(lowering.checker, module, extension.target.span) {
    Some(inner) => inner
    None => {
      return
    }
  }
  var names: List<String> = []
  for (name, _) in found.members {
    names.append name
  }
  names.sort({ _ })
  for name in names {
    if const Some(member) = found.members.get(name) {
      seedSymbol lowering, member
    }
  }
}

/** One declaration, if anything monomorphic can be built from it. A `const` becomes a static value instead. */
fn seedSymbol(var lowering: Lowering, symbol: SymbolId) {
  const declared = lowering.checker.symbolAt symbol
  match declared.kind {
    .Function => {
      /*
       * A **generic** declaration is a template and no function of the back end: monomorphization gives it one instance
       * per argument list, each counted where the worklist reaches it, and none at all where nothing calls it. So asking
       * for its instance *without* arguments could only ever fail, and counting that as a construct the back end does not
       * support would say "cannot build an instance of" about code it builds a dozen of - the same pitfall the
       * `.Constant` case below avoids for a `const` whose value is no static data. `commaSeparated<Item>` and
       * `withTrailingClosures<Output>` of the parser are the compiler's only two.
       *
       * A `native fn` is a callee and not a function of the program either: it becomes one where it is called, or not at
       * all.
       */
      if isMonomorphic(lowering, symbol) && hasBody(lowering, symbol) {
        if instanceOfSymbol(lowering, symbol).isNone() {
          countUnbuildable lowering, symbol, "a declaration the back end cannot build an instance of"
        }
      }
    }
    .Constant => {
      const reported = lowering.problems.length()
      if staticOfConstant(lowering, symbol).isNone() {
        // A constant that overflowed or divided by zero was *reported*: one root cause gets one message, so it is
        // only counted here and not named a second time as a construct the back end does not know
        if lowering.problems.length() > reported {
          lowering.stubbed = lowering.stubbed + 1
        }
        /*
         * Everything else is a `const` whose value is no static data at all - a list, a counted block, a text built out
         * of pieces. It is no declaration of the back end then: it is lowered where it is *read*
         * (`lowerConstantInitializer`), like a default, so it is neither lowered nor stubbed here and the progress bar
         * counts only what really becomes a function.
         */
      }
    }
    _ => {}
  }
}

fn hasBody(var lowering: Lowering, symbol: SymbolId): Bool {
  const identifier = signatureOf lowering.checker, symbol
  lowering.checker.signature(identifier).hasBody
}

/** A declaration that never even became an instance still counts: the statistics are about declarations, not calls. */
fn countUnbuildable(var lowering: Lowering, symbol: SymbolId, what: String) {
  const declared = lowering.checker.symbolAt symbol
  if const Some(module) = declared.module {
    enterModule lowering, module
  }
  lowering.isSupported = true
  reportUnsupported lowering, what, declared.span
  lowering.isSupported = true
  lowering.stubbed = lowering.stubbed + 1
}
