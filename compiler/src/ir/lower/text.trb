/**
 * Text: string interpolation, and the two calls that write one - `print` and `printError`.
 *
 * `"{name}: {count + 1}"` is one `Intrinsic.TextConcat` over the literal pieces and the parts (BACKEND 1.6), so a
 * text of *n* parts is one allocation and never a chain of `String.add`: building the long text of a loop stays linear.
 *
 * A part whose type is a **primitive the runtime formats itself** - every integer, every float, `Bool`, `Char`, `Void`
 * and a `String`, which [textPartKindOf] answers for - is handed to the intrinsic as the value it is, and the runtime
 * writes it into the result where it belongs. That is what makes the *whole* interpolation one allocation instead of
 * one per part plus one (docs/PERFORMANCE.md, finding 6). Every other part goes through `Show.show` - statically where
 * its type is known, through the witness table the value carries where it is trait typed - which is the very same
 * function a derived `Show` calls per field, so a value that is interpolated and one that is nested inside another
 * value run the same code.
 *
 * `print` is the shape beside it and takes its parts as texts, because the join with one space and one `\n` is the
 * runtime's and the parts of a variadic call are not the parts of one text.
 *
 * `showNested` is *not* what interpolation uses: `"{name}"` is the text itself and `["a"]` is quoted, which is exactly
 * the difference the generated `Show` format draws between the two members (docs/TYPECHECKER.md, The generated
 * `Show` format is not specified).
 *
 * The literal pieces need nothing: escapes, `\{`, a raw string and the dedenting of a `"""` block are all the lexer's,
 * so a `TextSegment.Literal` already carries the bytes the program has to produce.
 */

use Span from "../../syntax/source"
use Expression, Argument, TextSegment from "../../syntax/ast"
use SymbolId from "../../semantics/symbols"
use TypeId, LiteralValue from "../../semantics/checker/type"
use IrTypeId, IrType, Slot, Instruction, StaticContents, WitnessSource, Reference from "../ir"
use Intrinsic, IntrinsicOperation, Terminator, borrowed from "../ir"
use textPartKindOf from "../layout"
use FunctionBuilder, addTemporary, emit from "../build"
use memberOfType, memberInValue, traitMemberNamed from "../witness"
use Lowering, reportUnsupported, locationOf, internStatic, substituted, finishBlock from "./context"
use borrowedArguments from "./context"
use boundsOfTraitValue from "./generic"
use valueSlot, unsupportedSlot, abandonedSlot, voidSlot, lowerUncoercedValue, lowerValue from "./expression"
use witnessFor from "../../semantics/checker/implementation"
use instanceOfSymbol from "../instances"

/**
 * `"{a} and {b}"`. The parts are evaluated in source order - a part is an ordinary expression and may call anything -
 * and only then concatenated, which is what keeps evaluation order the order a reader sees (docs/BACKEND.md,
 * Evaluation order is only half specified).
 *
 * An empty literal piece is left out: it is no bytes, and one operand fewer is one array entry fewer in the C.
 */
public fn lowerTextLiteral(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  segments: List<TextSegment>,
  annotation: IrTypeId,
): Slot {
  var parts: List<Slot> = []
  for segment in segments {
    match segment {
      .Literal(text) => {
        if !text.isEmpty() {
          parts.append textSlot(lowering, builder, text)
        }
      }
      .Interpolated(inner) => {
        const part = partSlotOf lowering, builder, inner
        if !lowering.isSupported {
          return abandonedSlot lowering, builder, destination
        }
        parts.append part
      }
    }
  }
  const target = valueSlot lowering, builder, destination, annotation
  concatenate lowering, builder, target, parts, expression.span
  target
}

/** One static text in a slot of its own, which is what every literal piece of an interpolation is. */
public fn textSlot(var lowering: Lowering, var builder: FunctionBuilder, value: String): Slot {
  const text = lowering.program.internType IrType.Text
  const target = addTemporary builder, text
  const contents = StaticContents.Literal LiteralValue.Text(value)
  const found = internStatic lowering, contents, text
  emit builder, Instruction.Constant(target, found)
  target
}

/**
 * The parts of a text that is built from slots rather than from an interpolation, in one concatenation: what the
 * message of a failed `assert` is put together with (`ir/lower/quote.trb`).
 */
public fn concatenatedSlot(var lowering: Lowering, var builder: FunctionBuilder, parts: List<Slot>, at: Span): Slot {
  const text = lowering.program.internType IrType.Text
  const target = addTemporary builder, text
  concatenate lowering, builder, target, parts, at
  target
}

/** One concatenation of every part, never a chain of two-part additions. */
fn concatenate(var lowering: Lowering, var builder: FunctionBuilder, target: Slot, parts: List<Slot>, at: Span) {
  const location = locationOf lowering, at
  const intrinsic = Intrinsic IntrinsicOperation.TextConcat, kind: None
  emit builder, Instruction.Intrinsic(target, intrinsic, parts, location)
}

// --- `Show` of one value ----------------------------------------------------------------------------------------------

/**
 * One value, shown: the expression is lowered and `Show.show` is called on it.
 *
 * The coercion to a trait-typed value the checker recorded at an argument of `print` is deliberately **not** replayed
 * (`lowerUncoercedValue`): boxing a value only to read its table back out of the box would cost one allocation per
 * argument, and the type of the value itself already says which `show` runs. A value that is trait typed to begin with
 * is unaffected - there the table is the only answer there is, and it is read out of the value.
 *
 * # Related
 *
 * - [loweredPart] - the body, which an interpolated part asks one question more of.
 */
public fn shownSlotOf(var lowering: Lowering, var builder: FunctionBuilder, expression: Expression): Slot {
  loweredPart lowering, builder, expression, raw: false
}

/**
 * One **interpolated** part: the value itself where the runtime knows how to write it, and the `Show.show` of it
 * everywhere else. It is the same step as [shownSlotOf] and asks one question more.
 */
fn partSlotOf(var lowering: Lowering, var builder: FunctionBuilder, expression: Expression): Slot {
  loweredPart lowering, builder, expression, raw: true
}

/**
 * The body both of them are: the value is lowered, the `Show` adaptation the checker recorded is marked as replayed
 * ([showsHere]), and then the value either stands for itself or is shown.
 *
 * `raw` is what separates an interpolation from `print`: an interpolated part may be a number, because
 * `Intrinsic.TextConcat` takes one, and a part of `print` may not, because the runtime joins finished texts.
 */
fn loweredPart(var lowering: Lowering, var builder: FunctionBuilder, expression: Expression, raw: Bool): Slot {
  const at = expression.span
  const source = match lowering.checker.expressionType(lowering.module, at) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, None, "a shown value without a type", at
    }
  }
  const subject = substituted lowering, source
  lowering.shownParts.set at, true
  const value = lowerUncoercedValue lowering, builder, expression
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination: None
  }
  if raw && textPartKindOf(lowering.program, builder.typeOfSlot(value)).isSome() {
    return value
  }
  showSlot lowering, builder, value, subject, at
}

/** The same for a value that is already in a slot: what `print` and an interpolated part share. */
public fn showSlot(var lowering: Lowering, var builder: FunctionBuilder, value: Slot, subject: TypeId, at: Span): Slot {
  // A part before this one did not return: nothing is shown, and no `show` is instantiated for it
  if lowering.isDiverged {
    return abandonedSlot lowering, builder, destination: None
  }
  // `"{item}"` with an `item: Never` - inside `List<Never>.show`, say - is never reached, and `Never` has no `show`
  if const .NeverType = lowering.checker.types.form(subject) {
    finishBlock lowering, builder, Terminator.Unreachable
    return abandonedSlot lowering, builder, destination: None
  }
  const bound = match showBoundOf(lowering) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, None, "`Show`, which the prelude does not declare", at
    }
  }
  const text = lowering.program.internType IrType.Text
  const target = addTemporary builder, text
  const location = locationOf lowering, at
  const bounds = boundsOfTraitValue lowering, subject
  if !bounds.isEmpty() {
    const member = match traitMemberNamed(lowering, bound, "show") {
      Some(found) => found
      None => {
        return unsupportedSlot lowering, builder, None, "`Show.show`, which the prelude does not declare", at
      }
    }
    // A member that is in none of the value's own tables is not a dead end: a trait the value does not carry may be
    // implemented **for its trait type**, and `extend<Item: Show> List<Item> with Show` of the prelude is exactly that -
    // so `"{list}"` on a `List<Item>` value is a *static* call of that implementation. `dynamicDispatch` asks the same
    // question for every other member (5.10's note); this one asked only the tables, which is why no collection could be
    // printed at all
    if const Some(found) = memberInValue(lowering, bounds, subject, Reference(value, []), member) {
      const none: List<Slot> = []
      emit builder, Instruction.CallWitness(target, found.source, found.member, borrowedArguments(none))
      return target
    }
  }
  const called = match memberOfType(lowering, subject, bound, "show", at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination: None
    }
  }
  const empty: List<WitnessSource> = []
  emit builder, Instruction.Call(target, called, [borrowed(value)], empty, location)
  target
}

/**
 * `describedKey(key)` of `std/collections` - what `map[key]` names a missing key with - as
 * `describedShownKey(key.showNested())`, where the type of the key has `Show`: `the key "Alan"`.
 *
 * Whether it has is a question about the type, and a generic `Key` of `std/` has no bound that answers it; the
 * instance being lowered knows the type, so the answer is given here. `None` where the type has no `Show` - a type
 * parameter the caller hands a dictionary for, a function type - and the call is the ordinary one, whose body says
 * `the key` alone.
 */
public fn describedKeySlot(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  arguments: List<Argument>,
): Slot? {
  const written = arguments.first()?.value?
  const found = lowering.checker.expressionType(lowering.module, written.span)?
  const subject = substituted lowering, found
  const bound = showBoundOf(lowering)?
  if const .Implementation(_, _, _) = witnessFor(lowering.checker, subject, bound) {
  } else {
    return None
  }
  const describer = lowering.checker.wellKnown.describedShownKey?
  const describe = instanceOfSymbol(lowering, describer)?
  const at = expression.span
  const value = lowerValue lowering, builder, written
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const showNested = match memberOfType(lowering, subject, bound, "showNested", at) {
    Some(member) => member
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const text = lowering.program.internType IrType.Text
  const location = locationOf lowering, at
  const empty: List<WitnessSource> = []
  const shown = addTemporary builder, text
  emit builder, Instruction.Call(shown, showNested, [borrowed(value)], empty, location)
  const target = valueSlot lowering, builder, destination, text
  emit builder, Instruction.Call(target, describe, [borrowed(shown)], empty, location)
  target
}

/** `Show` as a bound, which is the trait every interpolated part and every argument of `print` is resolved against. */
fn showBoundOf(var lowering: Lowering): TypeId? {
  const symbol = lowering.checker.wellKnown.symbolNamed("Show")?
  const empty: List<TypeId> = []
  lowering.checker.nominal symbol, empty
}

/**
 * Whether the `Adaptation.ShowValue` at a span is already being replayed, which is true for exactly the spans this file
 * lowers: an interpolated part, and an argument of `print`. Everywhere else the adaptation is still a clean finding, so
 * a `Show` the back end forgot to call cannot pass unnoticed.
 */
public fn showsHere(lowering: Lowering, at: Span): Bool {
  lowering.shownParts.containsKey at
}

// --- `print` and `printError` -----------------------------------------------------------------------------------------

/**
 * `print a, b` writes the shown parts separated by one space and one `\n` (`runtime/console.c`).
 *
 * `print` is declared `print(...values: Show)`, so an ordinary variadic call builds a **list** at the call site
 * (`ir/lower/collection.trb`). The two well-known natives take a fast path instead: every argument is shown, and the
 * parts become the operands of `Intrinsic.PrintParts` directly, whose operand list is as long as the call is - the
 * same variable-arity shape `TextConcat` already has. The join stays in the runtime, so the two back ends cannot
 * disagree about the format, and nothing about `print` is special *after* the lowering: it is one instruction the VM
 * gets as one opcode.
 *
 * Building a `List<Show>` and calling a `printText` native instead is not an improvement: the **runtime** would have
 * to call `show` through a witness table, which a C function cannot do (the same reason `ArrayList.from` is written
 * in TorbScript instead of as a native), so `print` would need to become TorbScript over a new native - moving the
 * one space and the one `\n` out of `runtime/console.c` and costing a list plus a concatenation at every call. This
 * fast path sits on top of the general variadic lowering, not in place of it: a variadic call of anything else still
 * builds its list.
 */
public fn printOperationOf(var lowering: Lowering, symbol: SymbolId): IntrinsicOperation? {
  const known = lowering.checker.wellKnown
  if known.symbolNamed("print") == symbol {
    return IntrinsicOperation.PrintParts
  }
  if known.symbolNamed("printError") == symbol {
    return IntrinsicOperation.PrintErrorParts
  }
  None
}

/** Every argument shown, then the one instruction. `print` answers `Void`, so nobody takes a value from it. */
public fn lowerPrint(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  arguments: List<Argument>,
  operation: IntrinsicOperation,
): Slot {
  var parts: List<Slot> = []
  for written in arguments {
    // `print(...parts)` is the one shape the fast path cannot take: the number of operands would be a runtime question
    if written.spread {
      const what = "`...` in the argument list of `print`, which the two instructions cannot take"
      return unsupportedSlot lowering, builder, destination, what, expression.span
    }
    const shown = shownSlotOf lowering, builder, written.value
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
    parts.append shown
  }
  const location = locationOf lowering, expression.span
  const intrinsic = Intrinsic operation, kind: None
  emit builder, Instruction.Intrinsic(None, intrinsic, parts, location)
  match destination {
    Some(_) => voidSlot lowering, builder, destination
    None => abandonedSlot lowering, builder, destination
  }
}
