/**
 * Calls, constructors and operators: which function a call reaches, and in which order its arguments are evaluated.
 *
 * A call is one of four things, and the checker decided which: a call of a known function (monomorphized here, with the
 * type arguments of the enclosing instance filled in), an intrinsic, a function of the runtime, or a member of the
 * witness table a trait-typed value carries. A `var` argument is the path itself (`ir/lower/place.trb`), a variadic
 * list is built at the call site (`ir/lower/collection.trb`), and a closure argument is converted by
 * `ir/lower/closure.trb` - each through its own file, so this one stays about which function is reached and in what
 * order the arguments run.
 *
 * The argument plan is the checker's: `argumentTargets` says which parameter every *written* argument fills, and the
 * adaptations say which parameters take their default. Written arguments are evaluated in written order - source
 * order, whatever the declaration order is - and the defaults afterwards, in declaration order, **at the call site**
 * (docs/BACKEND.md, Parameter defaults have no evaluation rule).
 */

use Span from "../../syntax/source"
use Expression, Argument, FunctionDeclaration, Field from "../../syntax/ast"
use SymbolId from "../../semantics/symbols"
use TypeId, TypeForm, ParameterId, Signature, FieldSignature from "../../semantics/checker/type"
use substitute from "../../semantics/checker/unify"
use Resolution, Dispatch, DefaultSource from "../../semantics/checker/context"
use signatureOf, typeSignatureOf from "../../semantics/checker/signature"
use fieldsOf from "../../semantics/checker/member"
use NativeEntry, DerivedKind, ArrayOperation, loadScriptFunction, ScriptTableKind from "../../backend/c/natives"
use IrTypeId, Slot, Instruction, Terminator, FunctionId, LayoutId, Reference, PathStep, borrowed from "../ir"
use IrType, StaticContents from "../ir"
use LiteralValue from "../../semantics/checker/type"
use Intrinsic, NumericKind from "../ir"
use RuntimeKind, ElementId from "../ir"
use CallOperands, PlacePath, TakenElement from "./place"
use referenceParametersOf, parameterTypeAt, receiverReference, argumentReference from "./place"
use collidesWithPlace, writtenResult, lowerPropertyWrite, makeOwnersUnique, putBackElements from "./place"
use FunctionBuilder, emit, addTemporary from "../build"
use layoutOfType, conversionKindOf from "../verify"
use describeIrType from "../print"
use memberInValue, genericMemberInValue, derivedKindOf, generatedKindOf from "../witness"
use generatedFunctionOf, literalConversionOf, isKeyedContainer from "./derive"
use instanceFor, needsReference, isMonomorphic, isClosedType from "../instances"
use nativeFunctionOf from "./native"
use scriptTableOf, crossedApplyOf from "./script"
use elementFor from "../element"
use Lowering, Generated, reportUnsupported, locationOf, nativeNamed, producesValue, substituted from "./context"
use irTypeOfClosed, typeAtSpan, voidTypeOf from "./context"
use isNeverType, finishBlock, borrowedArguments, enterModule from "./context"
use lowerValue, valueSlot, unsupportedSlot, abandonedSlot, voidSlot, constantSlot from "./expression"
use variantIndexOf from "./match"
use emitIntrinsic, receiverSlot, snapshotted, spanOfArguments from "./expression"
use Dispatched, dispatchedMember, dispatchedOn, preludeType, lowerTraitValue, boundsOfTraitValue from "./generic"
use objectTypeOf from "./generic"
use traitExtensionTargetOf from "../instantiate"
use lowerClosureCall, lowerLazyArgument, lazyParametersOf, lowerConstructorValue from "./closure"
use printOperationOf, lowerPrint from "./text"
use isAssertion, lowerAssertion from "./quote"
use lowerQuotedValue from "./quoted"
use describedKeySlot from "./text"
use lowerItemList, listBoundFor from "./collection"
use loweredNativeOf, lowerSpawn, lowerStop, isSuspendingCall, emitSuspension from "./task"
use channelItemOf, lowerChannelNew from "./task"
use checkAvailable, lowerTargetCase from "./target"

/**
 * `f(x)`, `Point(1, 2)`, `p.copy(y: 3)`, `a.Circle`: every call syntax lowers to one of a handful of shapes, chosen by
 * what the checker's `Resolution` at this span says the callee is.
 */
public fn lowerCall(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  callee: Expression,
  arguments: List<Argument>,
  annotation: IrTypeId,
): Slot {
  // `adder(4)(1)`: the callee is itself a call, so what is called is the **value** the inner call answered. Its own
  // span carries its own resolution, and asking the checker here would answer that one - which would lower the inner
  // call with the outer call's arguments and drop one call of the two
  if const .Call(_, _, _) = callee.kind {
    return lowerClosureCall lowering, builder, destination, expression, callee, arguments, annotation
  }
  const resolution = match callResolutionOf(lowering, expression, callee) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a call the checker did not resolve", expression.span
    }
  }
  match resolution {
    .Callable(symbol, typeArguments, dispatch) => {
      const given = if typeArguments.isEmpty() { writtenTypeArguments lowering, expression.span } else { typeArguments }
      lowerCallable lowering, builder, destination, expression, callee, arguments, annotation, symbol, given, dispatch
    }
    .Construct(owner) => {
      lowerConstructorCall lowering, builder, destination, expression, arguments, annotation, owner
    }
    .CopyOf(owner) => lowerCopyCall lowering, builder, destination, expression, callee, arguments, annotation, owner
    .CaseOf(_, variant) => {
      lowerCaseCall lowering, builder, destination, expression, arguments, annotation, variant
    }
    // A local, a field, a parameter and a top-level binding of an entry file: whatever holds the closure is lowered as
    // a value, and the type it turns out to have is what says how the call is made
    .Local(_) | .Field(_, _) | .Constant(_, _) => {
      lowerClosureCall lowering, builder, destination, expression, callee, arguments, annotation
    }
    // `database { url = "..." }`: the one property command left, a trailing block on a record field, configures the
    // field's value in place
    .PropertyWrite(_, _) => {
      const written = match arguments.first() {
        Some(found) => found.value
        None => {
          const what = "a property command without a value"
          return unsupportedSlot lowering, builder, destination, what, expression.span
        }
      }
      lowerPropertyWrite lowering, builder, destination, callee, written
    }
    .TypeOf(_) => unsupportedSlot lowering, builder, destination, "a call of a type", expression.span
    _ => unsupportedSlot lowering, builder, destination, "a call the checker left open", expression.span
  }
}

/**
 * What a call resolved to. The span of the call itself is the answer - except for a call whose *receiver* is a call
 * (`text.trim().replace(a, b)`): reading the member of the outer one records `Resolution.Deferred` at the span of the
 * inner one, over the answer the inner call had already put there, and the two spans begin at the same byte. The
 * callee's own span carries the same answer without the type arguments, so that is what stands in - and whether a call
 * *has* type arguments is asked of the call's span either way, which is where they are recorded.
 */
fn callResolutionOf(var lowering: Lowering, expression: Expression, callee: Expression): Resolution? {
  const module = lowering.module
  const found = lowering.checker.resolutionAt module, expression.span
  match found {
    Some(.Deferred) => lowering.checker.resolutionAt module, callee.span
    None => lowering.checker.resolutionAt module, callee.span
    _ => found
  }
}

/** Explicit type arguments (`to<Set<Int>>()`), where the resolution itself carries none. */
fn writtenTypeArguments(var lowering: Lowering, at: Span): List<TypeId> {
  const module = lowering.module
  lowering.checker.typeArgumentsAt(module, at) ?? []
}

/**
 * A call of a declaration: a function, a method, a `native` the runtime provides, or a member of the witness table a
 * trait-typed value carries. Which of them it is was decided by the checker and is worked out by `dispatchedMember`,
 * with the type arguments of the *enclosing* instance filled in first.
 */
fn lowerCallable(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  callee: Expression,
  arguments: List<Argument>,
  annotation: IrTypeId,
  symbol: SymbolId,
  typeArguments: List<TypeId>,
  dispatch: Dispatch,
): Slot {
  // `Point.area(p)`: a method read through its type is the unbound function, and its receiver is the first argument
  const receiverWritten = isReceiverWritten lowering, callee, symbol, arguments
  const receiver = if receiverWritten {
    lowering.checker.expressionType lowering.module, arguments[0].value.span
  } else {
    receiverTypeOf lowering, callee
  }
  const at = expression.span
  // `print` and `printError` are variadic, but a variadic call ordinarily builds a list (`ir/lower/collection.trb`);
  // the parts are shown here instead, on the fast path `ir/lower/text.trb` explains
  if const Some(operation) = printOperationOf(lowering, symbol) {
    return lowerPrint lowering, builder, destination, expression, arguments, operation
  }
  // `assert` holds an `Expression<Bool>`, and what a failed one shows is one decision of the lowering
  if isAssertion(lowering, symbol) {
    return lowerAssertion lowering, builder, destination, expression, arguments
  }
  // `describedKey(key)` shows the key where its type has `Show`, which only the instance being lowered knows
  if lowering.checker.wellKnown.describedKey == Some(symbol) {
    if const Some(described) = describedKeySlot(lowering, builder, destination, expression, arguments) {
      return described
    }
  }
  // `spawn` needs the closure literal it is handed, not a value of it: its body becomes the resume function of the task
  if loweredNativeOf(lowering, symbol) == Some("spawn") {
    return lowerSpawn lowering, builder, destination, arguments, annotation, expression.span
  }
  // A method called on a value of `Never` - `_.showNested()` inside `List<Never>.show` - is never reached, and `Never`
  // has no implementation to dispatch to: what the receiver is read from is evaluated, and the call is unreachable
  if isNeverReceiver(lowering, symbol, receiver) {
    const written = if receiverWritten { Some arguments[0].value } else { receiverExpressionOf callee }
    if const Some(value) = written {
      const _ = lowerValue lowering, builder, value
    }
    if !lowering.isDiverged {
      finishBlock lowering, builder, Terminator.Unreachable
    }
    return abandonedSlot lowering, builder, destination
  }
  const dispatched = match dispatchedMember(lowering, symbol, typeArguments, dispatch, receiver, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const member = dispatched.member
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  // The receiver comes first, because evaluation order is source order and the receiver is written first
  var operands: List<Slot> = []
  var places: List<Reference?> = []
  // What a place of this call took out of a container and has to put back once the call has run
  var taken: List<TakenElement> = []
  if receiverWritten && signature.takesSelf {
    const value = arguments[0].value
    if signature.isVarSelf {
      const declared = typeAtSpan(lowering, value.span) ?? voidTypeOf(lowering)
      const path = match argumentReference(lowering, builder, value, declared, "a `var` receiver") {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      operands.append path.reference.base
      places.append Some(path.reference)
      taken.appendAll path.taken
    } else {
      const slot = lowerValue lowering, builder, value
      operands.append snapshotted(lowering, builder, value, slot, spanOfArguments(arguments, 1))
      places.append None
    }
  } else if signature.takesSelf {
    if signature.isVarSelf {
      const path = match receiverReference(lowering, builder, callee, "a `var` receiver") {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      operands.append path.reference.base
      places.append Some(path.reference)
      taken.appendAll path.taken
    } else {
      const reached = match receiverSlot(lowering, builder, callee) {
        Some(found) => found
        None => {
          const what = "a receiver the back end cannot reach"
          return unsupportedSlot lowering, builder, destination, what, expression.span
        }
      }
      const later = spanOfArguments arguments, 0
      const held = match receiverExpressionOf(callee) {
        Some(written) => snapshotted lowering, builder, written, reached, later
        None => reached
      }
      const coerced = match receiverOfTraitExtension(lowering, builder, held, dispatched, receiver, at) {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      operands.append coerced
      places.append None
    }
  }
  const plan = dispatched.mapping
  const shifted = receiverWritten && signature.takesSelf
  const written = lowerArgumentSlots lowering, builder, expression, arguments, signature, plan, receiverWritten: shifted
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  operands.appendAll written.slots
  places.appendAll written.places
  taken.appendAll written.taken
  const result = lowerDispatched lowering, builder, destination, at, dispatched, operands, places, annotation
  putBackElements lowering, builder, taken
  result
}

/**
 * The receiver of a member of an `extend` whose target is a **trait** - `extend<Item> Iterate<Item> { fn parallel() }` -
 * as the trait-typed value that member takes. Its `self` is a value of the trait, so a `Range<Int>`, a `Set<Int>` or a
 * `List<Int>` it is reached on is boxed with its table, or narrowed to the table of the supertrait it carries, exactly as
 * an argument is coerced where the parameter names the trait. A receiver that already is that trait-typed value, and
 * every other member, goes in as it is.
 */
fn receiverOfTraitExtension(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  slot: Slot,
  dispatched: Dispatched,
  receiver: TypeId?,
  at: Span,
): Slot? {
  const written = match receiver {
    Some(found) => found
    None => {
      return Some slot
    }
  }
  const target = match traitExtensionTargetOf(lowering.checker, dispatched.member) {
    Some(found) => found
    None => {
      return Some slot
    }
  }
  const wanted = substituted lowering, substitute(lowering.checker.types, target, dispatched.mapping)
  const source = substituted lowering, written
  if wanted == source {
    return Some slot
  }
  const bounds = boundsOfTraitValue lowering, wanted
  if bounds.isEmpty() {
    return Some slot
  }
  const boxed = addTemporary builder, objectTypeOf(lowering, bounds)
  if !lowerTraitValue(lowering, builder, boxed, slot, bounds, source, at) {
    return None
  }
  Some boxed
}

/**
 * The half of a call that is the same wherever the operands came from: which of the five shapes the member really is -
 * `panic`, a member of a witness table, a native, a generated body, or an instance of a source body - and the `Call` for
 * it. `a[key]` and an operator have no callee expression and no argument list, so they hand their slots over here.
 */
public fn lowerDispatched(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  at: Span,
  dispatched: Dispatched,
  written: List<Slot>,
  places: List<Reference?>,
  annotation: IrTypeId,
): Slot {
  // An operand did not return - `take(fail())` - so the call is never made, and its callee is not instantiated for it:
  // an instance nothing calls is a `static` function the C compiler refuses
  if lowering.isDiverged {
    return abandonedSlot lowering, builder, destination
  }
  const member = dispatched.member
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  const owner = dispatched.owner
  const name = memberNameOf lowering, member
  // `native fn panic(message): Never` is the one native with an instruction of its own
  if owner.isEmpty() && name == "panic" {
    return lowerPanic lowering, builder, destination, written, at
  }
  // `task.await()` and `task.result()` wait first, and the call reads the answer once the task has completed
  if isSuspendingCall(lowering, builder, name, written) {
    if !emitSuspension(lowering, builder, name, written[0], at) {
      return abandonedSlot lowering, builder, destination
    }
  }
  const operands = separatedFromPlaces builder, written, places
  if dispatched.isDynamic {
    return lowerWitnessCall lowering, builder, destination, at, dispatched, operands, annotation, places
  }
  if !signature.hasBody {
    // `Status.tryFrom(text)`: the conversion a literal type is given, generated from its members
    if name == "tryFrom" && operands.length() == 1 && isTextSlot(lowering, builder, operands[0]) {
      if const Some(generated) = literalConversionOf(lowering, dispatched.subject, at) {
        return emitCall lowering, builder, destination, generated, operands, annotation, at
      }
    }
    // `expression.value()`: the `lazy` cell the quotation was built with, forced (`ir/lower/quoted.trb`)
    if owner == "Expression" && name == "value" && operands.length() == 1 {
      return lowerQuotedValue lowering, builder, destination, operands[0], annotation, at
    }
    if const Some(entry) = nativeNamed(lowering, owner, name, signature) {
      return lowerNativeCall lowering, builder, destination, at, operands, annotation, dispatched, entry, places
    }
    // No body and no manifest entry: a member of a **derived** implementation, generated from the layout. The encoding
    // forms take their format as a `var` parameter, so the places go along
    if const Some(generated) = generatedMemberFor(lowering, dispatched, at) {
      return emitCall lowering, builder, destination, generated, operands, annotation, at, places
    }
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
  }
  const mapping = dispatched.mapping
  const function = match instanceFor(lowering, member, mapping) {
    Some(found) => found
    None => {
      const what = describeCallee lowering, member, signature
      return unsupportedSlot lowering, builder, destination, what, at
    }
  }
  emitCall lowering, builder, destination, function, operands, annotation, at, places
}

fn isTextSlot(var lowering: Lowering, var builder: FunctionBuilder, slot: Slot): Bool {
  match lowering.program.typeAt(builder.typeOfSlot(slot)) {
    .Text => true
    _ => false
  }
}

/**
 * Whether the receiver of a method is its first argument: `Point.area(p)` and `Into.into(url)`, a member that takes
 * `self` read through the name of a type or of a trait instead of on a value.
 */
fn isReceiverWritten(var lowering: Lowering, callee: Expression, symbol: SymbolId, arguments: List<Argument>): Bool {
  if arguments.isEmpty() {
    return false
  }
  const base = match callee.kind {
    .Member(found, _, isOptional) => {
      if isOptional {
        return false
      }
      found
    }
    _ => {
      return false
    }
  }
  // The name of a type in front of the dot is its constructor, and the name of a trait the type itself. A call there
  // (`Rectangle(a, b).covering(c)`) resolves to the constructor as well, and is a value
  if const .Call(_, _, _) = base.kind {
    return false
  }
  const module = lowering.module
  match lowering.checker.resolutionAt(module, base.span) {
    Some(.TypeOf(_)) | Some(.Construct(_)) => {
      const identifier = signatureOf lowering.checker, symbol
      lowering.checker.signature(identifier).takesSelf
    }
    _ => false
  }
}

/**
 * `value.into()` and `value.tryInto()`: the `from` (or `tryFrom`) of the target, called with the value. The checker
 * records the conversion as `Adaptation.Convert` and resolves the call to the target's member, but the member is static
 * and the value is its argument and not its receiver, so the call is built here and not by `lowerCallable`.
 *
 * Which implementation of the target runs is asked again under the instance that is being lowered, with the bound the
 * source spells out (`From<(Float, Float)>`): a type made from several sources has one `from` per source, and inside a
 * generic function the source is only known here.
 */
public fn lowerConversionCall(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  method: SymbolId,
  annotation: IrTypeId,
): Slot {
  const at = expression.span
  const module = lowering.module
  const base = match conversionReceiverOf(expression) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a conversion through `From` without a value", at
    }
  }
  const written = lowering.checker.expressionType module, base.span
  const produced = lowering.checker.expressionType module, at
  const (source, result) = match (written, produced) {
    (Some(one), Some(other)) => (substituted(lowering, one), substituted(lowering, other))
    _ => {
      return unsupportedSlot lowering, builder, destination, "a conversion through `From` without a type", at
    }
  }
  const name = memberNameOf lowering, method
  const conversion = match conversionBoundOf(lowering, name, source, result) {
    Some(found) => found
    None => {
      const what = "a conversion through `{name}` the back end cannot resolve"
      return unsupportedSlot lowering, builder, destination, what, at
    }
  }
  const value = lowerValue lowering, builder, base
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const dispatched = match dispatchedOn(lowering, conversion.target, conversion.bound, name, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  lowerDispatched lowering, builder, destination, at, dispatched, [value], [None], annotation
}

/** The value in front of `.into()`, where the expression is such a call. */
fn conversionReceiverOf(expression: Expression): Expression? {
  const callee = match expression.kind {
    .Call(found, _, _) => found
    _ => {
      return None
    }
  }
  match callee.kind {
    .Member(base, _, _) => Some base
    .Generic(inner, _) => {
      if const .Member(base, _, _) = inner.kind {
        return Some base
      }
      None
    }
    _ => None
  }
}

/** The type a conversion makes, and the trait of it that makes it from the source. */
type ConversionBound {
  target: TypeId
  bound: TypeId
}

/**
 * `From<Source>` on the result of `into()`, and `TryFrom<Source, Failure>` on the `Ok` side of the result of
 * `tryInto()`: the one implementation the conversion reaches, spelled out.
 */
fn conversionBoundOf(var lowering: Lowering, name: String, source: TypeId, result: TypeId): ConversionBound? {
  if name == "from" {
    const conversion = lowering.checker.wellKnown.from?
    return Some ConversionBound(result, lowering.checker.nominal(conversion, [source]))
  }
  if name == "tryFrom" {
    const tryFrom = lowering.checker.wellKnown.tryFrom?
    const arguments = match lowering.checker.types.form(result) {
      .Nominal(_, found) => found
      _ => {
        return None
      }
    }
    if arguments.length() != 2 {
      return None
    }
    return Some ConversionBound(arguments[0], lowering.checker.nominal(tryFrom, [source, arguments[1]]))
  }
  None
}

/**
 * The operands of a call, where a **value** argument that names the base of a place argument of the same call is a copy
 * of its own: `resetThenRead(list, list)` with `var target` first, and `bag.merge bag` with a `var fn` receiver.
 *
 * The value argument is the value *before* the call - reading the path a `var` argument names is allowed as another
 * argument of the same call - and it is handed over borrowed, so without the copy the callee would read it through the
 * very storage it writes: a write through the place releases what was there, and the value argument then points at a
 * freed block. The copy is one retain, which also makes the storage shared, so a `MakeUnique` in the callee copies it
 * before the first write, and the ownership pass releases the copy after the call. A call where no value argument names
 * the base of a place gets its operands back as they are and costs nothing.
 */
fn separatedFromPlaces(var builder: FunctionBuilder, operands: List<Slot>, places: List<Reference?>): List<Slot> {
  var bases: List<Slot> = []
  for place in places {
    if const Some(found) = place {
      bases.append found.base
    }
  }
  if bases.isEmpty() {
    return operands
  }
  var separated = operands
  for index in 0..operands.length() {
    if const Some(Some(_)) = places.get(index) {
      continue
    }
    const slot = operands[index]
    if !bases.contains(slot) {
      continue
    }
    const copy = addTemporary builder, builder.typeOfSlot(slot)
    emit builder, Instruction.Copy(copy, slot)
    separated.set index, copy
  }
  separated
}

/**
 * The checker type of what a call is written on: the receiver, or the `self` the source left out. `None` for a free
 * function and for a static member, whose owner carries no arguments a call site could decide.
 */
/** Whether a call is a method of a receiver whose type, as instantiated, is `Never`. */
fn isNeverReceiver(var lowering: Lowering, symbol: SymbolId, receiver: TypeId?): Bool {
  const written = match receiver {
    Some(found) => found
    None => {
      return false
    }
  }
  const identifier = signatureOf lowering.checker, symbol
  if !lowering.checker.signature(identifier).takesSelf {
    return false
  }
  const applied = substituted lowering, written
  if const .NeverType = lowering.checker.types.form(applied) {
    return true
  }
  false
}

/** The expression in front of the dot of a method call, where there is one: `base` of `base.member(...)`. */
fn receiverExpressionOf(callee: Expression): Expression? {
  if const .Generic(inner, _) = callee.kind {
    return receiverExpressionOf inner
  }
  if const .Member(base, _, _) = callee.kind {
    return Some base
  }
  None
}

public fn receiverTypeOf(var lowering: Lowering, callee: Expression): TypeId? {
  const module = lowering.module
  // `values.to<Map<Key, Value>>()` writes its type arguments *between* the receiver and the call, so the receiver is one
  // node deeper. `receiverSlot` already unwraps it (5.7's third round) and this one has to as well, or such a call is
  // dispatched without a receiver at all
  if const .Generic(inner, _) = callee.kind {
    return receiverTypeOf lowering, inner
  }
  if const .Member(base, _, _) = callee.kind {
    // Behind a `?.` the member is looked up on the payload, so that is the receiver and not the `Option` around it
    if const Some(payload) = lowering.optionalReceiverTypes.get(base.span) {
      return Some payload
    }
    return lowering.checker.expressionType module, base.span
  }
  const adaptations = lowering.checker.adaptationsAt module, callee.span
  for adaptation in adaptations {
    if const .ImplicitSelf(receiver) = adaptation {
      return Some lowering.checker.binding(receiver).annotation
    }
  }
  None
}

fn memberNameOf(var lowering: Lowering, symbol: SymbolId): String {
  lowering.checker.symbolAt(symbol).name
}

/** Why a member without a body and without a manifest entry cannot be called yet. */
fn describeCallee(var lowering: Lowering, symbol: SymbolId, signature: Signature): String {
  if !signature.hasBody {
    const name = lowering.checker.symbolAt(symbol).name
    return "`{name}`, which the natives manifest does not know"
  }
  if !isMonomorphic(lowering, symbol) {
    return "a generic function or a member of a generic type"
  }
  "a function the back end cannot build an instance of"
}

// --- A call through a witness table ------------------------------------------------------------------------------------

/**
 * A member of the table a trait-typed value carries. The **receiver is not among the arguments**: it is the boxed payload
 * of the value the witness came from, which the instruction already names through its `WitnessSource` - so a back end
 * reads both out of one slot and nothing has to say twice which value the call is on.
 */
fn lowerWitnessCall(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  at: Span,
  dispatched: Dispatched,
  operands: List<Slot>,
  annotation: IrTypeId,
  places: List<Reference?> = [],
): Slot {
  const base = match operands.first() {
    Some(found) => found
    None => {
      const what = "a call on a trait-typed value without a receiver"
      return unsupportedSlot lowering, builder, destination, what, at
    }
  }
  // The place the trait-typed value is at: the path of a `var fn` receiver, and the slot alone for a read-only one.
  // `WitnessRoot.Value` carries it, so the table and the payload come out of the same expression however deep it is
  const receiver = match places.first() {
    Some(Some(found)) => found
    _ => Reference base, []
  }
  // A `var fn` member writes through the payload, so the box has to be made unique first - a trait-typed value is a
  // value, and a copy of one may not see a change made through the other. The owners *above* it on the path are the
  // ownership pass's business, exactly as they are for a `var` argument
  if const Some(Some(place)) = places.first() {
    makeOwnersUnique lowering, builder, place
  }
  const subject = match dispatched.subject {
    Some(found) => found
    None => {
      const what = "a call on a trait-typed value of an unknown type"
      return unsupportedSlot lowering, builder, destination, what, at
    }
  }
  const bounds = dispatched.bounds
  const member = dispatched.member
  // A member with type parameters of its own sits in the slot of the arguments this call decided
  const located = if dispatched.ownArguments.isEmpty() {
    memberInValue lowering, bounds, subject, receiver, member
  } else {
    genericMemberInValue lowering, bounds, subject, receiver, member, dispatched.ownArguments, at
  }
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const found = match located {
    Some(inner) => inner
    None => {
      const name = memberNameOf lowering, member
      const what = "`{name}`, which is not in the witness table of a trait-typed value"
      return unsupportedSlot lowering, builder, destination, what, at
    }
  }
  var rest: List<Slot> = []
  for index in 1..operands.length() {
    rest.append operands[index]
  }
  const given = borrowedArguments rest
  const location = locationOf lowering, at
  if !producesValue(lowering, annotation) {
    emit builder, Instruction.CallWitness(None, found.source, found.member, given, Some(location))
    if isNeverType(lowering, annotation) {
      finishBlock lowering, builder, Terminator.Unreachable
      return abandonedSlot lowering, builder, destination
    }
    match destination {
      Some(_) => {
        return voidSlot lowering, builder, destination
      }
      None => {
        return abandonedSlot lowering, builder, destination
      }
    }
  }
  const target = valueSlot lowering, builder, destination, annotation
  emit builder, Instruction.CallWitness(Some(target), found.source, found.member, given, Some(location))
  target
}

// --- Natives --------------------------------------------------------------------------------------------------------

fn lowerNativeCall(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  at: Span,
  operands: List<Slot>,
  annotation: IrTypeId,
  dispatched: Dispatched,
  entry: NativeEntry,
  places: List<Reference?> = [],
): Slot {
  if const .Planned(_) = entry.state {
    const what = "`{entry.name}`"
    return unsupportedSlot lowering, builder, destination, what, at, "the runtime does not provide it"
  }
  // An error of the program for this target, and the call is lowered all the same: nothing is emitted from a program
  // with an error, and a body that stays whole lets `--every-target` report every such call and not only the first
  checkAvailable lowering, entry, at
  const member = dispatched.member
  const mapping = dispatched.mapping
  match entry.target {
    // A constant of the build: the case of `std/core` the target answers, and no call at all
    .Target(dimension) => lowerTargetCase lowering, builder, destination, annotation, dimension, at
    .Intrinsic(intrinsic) => {
      if !producesValue(lowering, annotation) {
        const what = "`{entry.name}`, an intrinsic that produces no value"
        return unsupportedSlot lowering, builder, destination, what, at
      }
      const target = valueSlot lowering, builder, destination, annotation
      const kind = sourceKindOf lowering, builder, intrinsic, operands
      emitIntrinsic lowering, builder, Some(target), intrinsic.operation, kind, operands, at
      target
    }
    // The runtime's own conventions - an out parameter, an element by address - are a generated wrapper (`native.trb`)
    .Runtime(function) => {
      const identifier = match nativeFunctionOf(lowering, member, mapping, entry, function, at) {
        Some(found) => found
        None => {
          if !lowering.isSupported {
            return abandonedSlot lowering, builder, destination
          }
          const what = "`{entry.name}`, whose declaration is not monomorphic"
          return unsupportedSlot lowering, builder, destination, what, at
        }
      }
      emitCall lowering, builder, destination, identifier, operands, annotation, at, places
    }
    // A member the language generates has no source anywhere: the body is built from the layout and called like any other
    .Derived(derived) => {
      const generated = match generatedMemberOf(lowering, dispatched, derived, at) {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      emitCall lowering, builder, destination, generated, operands, annotation, at
    }
    // The empty container: one `ContainerNew` in a generated body, because the element descriptors are the lowering's
    .Container(kind) => {
      const built = match containerMemberOf(lowering, dispatched, kind, at) {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      emitCall lowering, builder, destination, built, operands, annotation, at
    }
    // The storage of an `Array`: one instruction in a generated body, over the slots of the receiver's own `FixedArray`
    .ArrayStorage(operation) => {
      const built = match arrayStorageMemberOf(lowering, dispatched, operation, at) {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      emitCall lowering, builder, destination, built, operands, annotation, at, places
    }
    // `spawn` never reaches this (`lowerCallable` takes it first), so what is left is the end of a task
    .Lowered => {
      if entry.name == "stopAsCancelled" {
        return lowerStop lowering, builder, destination, at
      }
      unsupportedSlot lowering, builder, destination, "`{entry.name}` as a value", at
    }
    // The scripts the program was compiled with, one table per receiver type (docs/design/SCRIPTS.md section 3)
    .ScriptTable(kind) => {
      // The crossing of a native binary is `crossedApply` for the receiver, called with the operands of the call
      if kind == ScriptTableKind.Crossing {
        if lowering.forMachine {
          const text = lowering.program.internType IrType.Text
          const answer = "0\tinternal error: only a native binary crosses a script's value"
          return constantSlot lowering, builder, destination, StaticContents.Literal(LiteralValue.Text(answer)), text
        }
        const crossed = match crossedApplyOf(lowering, member, mapping, at) {
          Some(found) => found
          None => {
            return abandonedSlot lowering, builder, destination
          }
        }
        return emitCall lowering, builder, destination, crossed, operands, annotation, at, places
      }
      const table = match scriptTableOf(lowering, member, mapping, kind, at) {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      emitCall lowering, builder, destination, table, operands, annotation, at
    }
    // Running a script is the VM's alone (docs/design/SCRIPTS.md section 1): a native binary runs its scripts in the VM
    // of the script host it links, through `hostLoadScript` and `runCrossed`, and never takes these paths
    .Machine(function) => {
      if !lowering.forMachine {
        const text = lowering.program.internType IrType.Text
        const answer = if function == loadScriptFunction { "!" } else { "" }
        const said = "{answer}0\tinternal error: a native binary runs a script in the VM of its script host"
        return constantSlot lowering, builder, destination, StaticContents.Literal(LiteralValue.Text(said)), text
      }
      const identifier = match nativeFunctionOf(lowering, member, mapping, entry, function, at) {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      emitCall lowering, builder, destination, identifier, operands, annotation, at, places
    }
    // The script host a native binary embeds (docs/design/SCRIPTS.md slice 8): a function of the object the driver
    // links in. The VM loads and runs a script itself and never takes this path, whatever the program says
    .ScriptHost(function) => {
      if lowering.forMachine {
        const text = lowering.program.internType IrType.Text
        const answer = "!0\tinternal error: only a native binary loads a script through the front end it embeds"
        return constantSlot lowering, builder, destination, StaticContents.Literal(LiteralValue.Text(answer)), text
      }
      const identifier = match nativeFunctionOf(lowering, member, mapping, entry, function, at) {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      emitCall lowering, builder, destination, identifier, operands, annotation, at, places
    }
  }
}

/** The generated body of one of the storage members of `Array`: one per operation per `FixedArray` type. */
fn arrayStorageMemberOf(
  var lowering: Lowering,
  dispatched: Dispatched,
  operation: ArrayOperation,
  at: Span,
): FunctionId? {
  const subject = dispatched.subject?
  const member = dispatched.member
  const bound = dispatched.capability
  const mapping = dispatched.mapping
  generatedFunctionOf lowering, Generated.ArrayStorage(operation), member, subject, bound, mapping, at
}

/** The generated body of `ArrayList.withCapacity` and friends: one per implementation per element type. */
fn containerMemberOf(
  var lowering: Lowering,
  dispatched: Dispatched,
  kind: RuntimeKind,
  at: Span,
): FunctionId? {
  const subject = dispatched.subject?
  const member = dispatched.member
  const bound = dispatched.capability
  const mapping = dispatched.mapping
  generatedFunctionOf lowering, Generated.Container(kind), member, subject, bound, mapping, at
}

/**
 * The generated body of a member whose implementation is a **derived** one: `Show`, `Equals` and `Hash` of a `type` have
 * no source anywhere, and a call of one is an ordinary call of the body the lowering builds from the layout.
 */
fn generatedMemberFor(var lowering: Lowering, dispatched: Dispatched, at: Span): FunctionId? {
  const implementation = dispatched.implementation?
  const subject = dispatched.subject?
  const member = dispatched.member
  const owner = dispatched.owner
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  const kind = generatedKindOf(lowering, member, owner, implementation, signature, at)?
  const bound = dispatched.capability
  const mapping = dispatched.mapping
  generatedFunctionOf lowering, kind, member, subject, bound, mapping, at
}

/** The generated body of a member the manifest marks `.Derived`: `Int64.compare`, `String.show`, `Range.hash`. */
fn generatedMemberOf(
  var lowering: Lowering,
  dispatched: Dispatched,
  derived: DerivedKind,
  at: Span,
): FunctionId? {
  const subject = match dispatched.subject {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a generated member without a receiver", at
      return None
    }
  }
  const kind = derivedKindOf(lowering, derived, at)?
  const member = dispatched.member
  const bound = dispatched.capability
  const mapping = dispatched.mapping
  generatedFunctionOf lowering, kind, member, subject, bound, mapping, at
}

/**
 * `panic "unreachable"`: an instruction of its own, and nothing after it in the block is reachable (docs/BACKEND.md,
 * What a panic prints, what it runs, and the exit code).
 */
fn lowerPanic(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  operands: List<Slot>,
  at: Span,
): Slot {
  const message = match operands.first() {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "`panic` without a message", at
    }
  }
  const location = locationOf lowering, at
  emit builder, Instruction.Panic(borrowed(message), location)
  finishBlock lowering, builder, Terminator.Unreachable
  abandonedSlot lowering, builder, destination
}

// --- Emitting a call ------------------------------------------------------------------------------------------------

/**
 * One `Call`. Every operand is `Borrowed` here: which positions take the count is what the ownership pass of 5.4
 * decides, out of the body this one writes. `places` says which positions are `var` parameters and therefore carry the
 * whole path the callee writes through instead of a value.
 */
public fn emitCall(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  function: FunctionId,
  operands: List<Slot>,
  annotation: IrTypeId,
  at: Span,
  places: List<Reference?> = [],
): Slot {
  const given = borrowedArguments operands, places
  // Where the call is written: a runtime function that can panic takes it, and a panic message is observable
  const location = locationOf lowering, at
  if !producesValue(lowering, annotation) {
    emit builder, Instruction.Call(None, function, given, [], Some(location))
    if isNeverType(lowering, annotation) {
      finishBlock lowering, builder, Terminator.Unreachable
      return abandonedSlot lowering, builder, destination
    }
    match destination {
      Some(_) => {
        return voidSlot lowering, builder, destination
      }
      None => {
        return abandonedSlot lowering, builder, destination
      }
    }
  }
  // `x = f(x)` where `f` takes `x` by `var`: the result may not land in the base of a place the call writes through, or
  // it would overwrite - and therefore leak - what the callee has just put there
  if collidesWithPlace(destination, places) {
    const inner = valueSlot lowering, builder, None, annotation
    emit builder, Instruction.Call(Some(inner), function, given, [], Some(location))
    if const Some(slot) = destination {
      writtenResult builder, slot, inner
      return slot
    }
    return inner
  }
  const target = valueSlot lowering, builder, destination, annotation
  emit builder, Instruction.Call(Some(target), function, given, [], Some(location))
  target
}

// --- The argument plan ----------------------------------------------------------------------------------------------

/**
 * The arguments of a call, in declaration order, evaluated in **written** order. `Adaptation.Reorder` is replayed by
 * putting finished slots into their positions and never by evaluating out of order, which is what makes a side effect
 * in a labeled argument happen where a reader sees it.
 */
public fn lowerArgumentSlots(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  expression: Expression,
  written: List<Argument>,
  signature: Signature,
  mapping: Map<ParameterId, TypeId> = [:],
  receiverWritten: Bool = false,
): CallOperands {
  const module = lowering.module
  const count = signature.form.parameters.length()
  const planned = match lowering.checker.argumentTargetsAt(module, expression.span) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a call without an argument plan", expression.span
      return CallOperands([], [])
    }
  }
  // `Point.translate(p, deltaX: 1)`: the plan counts the receiver as parameter 0 and as the first argument, and the
  // caller has lowered it already - so both lists lose it and every position moves down by one
  var targets = planned
  var arguments = written
  if receiverWritten {
    targets = []
    for index in 1..planned.length() {
      targets.append(planned[index] - 1)
    }
    arguments = []
    for index in 1..written.length() {
      arguments.append written[index]
    }
  }
  const references = referenceParametersOf signature
  const lazies = lazyParametersOf signature
  const variadic = variadicParameterOf signature
  var filled: List<Slot?> = []
  var places: List<Reference?> = []
  var taken: List<TakenElement> = []
  for _ in 0..count {
    filled.append None
    places.append None
  }
  // `...values: Show` is **one** parameter that every positional argument from its position on fills, so the list is built
  // before the ordinary loop runs and in the place the first of those arguments stands: a variadic is written last, so
  // that is also where a reader sees them evaluated
  if variadic >= 0 {
    const list = match lowerVariadicArgument(lowering, builder, expression, arguments, targets, signature, variadic, mapping) {
      Some(found) => found
      None => {
        return CallOperands([], [])
      }
    }
    filled.set variadic, Some(list)
  }
  for index in 0..arguments.length() {
    const position = targets.get(index) ?? -1
    if position < 0 || position >= count {
      reportUnsupported lowering, "an argument that fills no parameter", arguments[index].value.span
      return CallOperands([], [])
    }
    // Every one of them is already in the list
    if position == variadic {
      continue
    }
    // `lazy Value`: the argument is an expression, so what is handed over is a thunk in a one-shot memo cell
    if lazies.get(position) ?? false {
      const item = lazyItemAt lowering, signature, position, mapping, arguments[index].value.span
      const cell = match lowerLazyArgument(lowering, builder, arguments[index].value, item) {
        Some(found) => found
        None => {
          return CallOperands([], [])
        }
      }
      filled.set position, Some(cell)
      continue
    }
    if references.get(position) ?? false {
      const path = match referenceArgumentAt(lowering, builder, arguments[index].value, signature, position, mapping) {
        Some(found) => found
        None => {
          return CallOperands([], [])
        }
      }
      filled.set position, Some(path.reference.base)
      places.set position, Some(path.reference)
      taken.appendAll path.taken
      continue
    }
    const value = arguments[index].value
    const lowered = lowerValue lowering, builder, value
    const slot = snapshotted lowering, builder, value, lowered, spanOfArguments(arguments, index + 1)
    if !lowering.isSupported {
      return CallOperands([], [])
    }
    filled.set position, Some(slot)
  }
  lowerDefaults lowering, builder, expression, signature, filled, places, taken, references, mapping
}

/** Which position of a signature is its variadic parameter, or -1. There is at most one and it is written last. */
fn variadicParameterOf(signature: Signature): Int {
  const parameters = signature.form.parameters
  for index in 0..parameters.length() {
    if const .Variadic = parameters[index].mode {
      return index
    }
  }
  0 - 1
}

/**
 * The one argument a variadic parameter takes: the `List<Item>` of every positional argument that fills it, in written
 * order, built at the call site (BACKEND 1.6) - and the **empty** list where nothing was written, which is what makes
 * `print()` and `Set.of()` calls and not missing arguments.
 *
 * The item type comes from the callee's declaration under the callee's own instance mapping, exactly as a `lazy`
 * parameter's does: the parameter is written in terms of the declaration's parameters and never the caller's.
 */
fn lowerVariadicArgument(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  expression: Expression,
  arguments: List<Argument>,
  targets: List<Int>,
  signature: Signature,
  position: Int,
  mapping: Map<ParameterId, TypeId>,
): Slot? {
  const at = expression.span
  const item = lazyItemAt lowering, signature, position, mapping, at
  const bound = match listBoundFor(lowering, item, at) {
    Some(found) => found
    None => {
      return None
    }
  }
  var collected: List<Argument> = []
  for index in 0..arguments.length() {
    if targets.get(index) == Some(position) {
      collected.append arguments[index]
    }
  }
  const annotation = irTypeOfClosed lowering, lowering.checker.types.intern(TypeForm.Traits([bound]))
  const slot = lowerItemList lowering, builder, None, collected, item, [bound], annotation, at
  if !lowering.isSupported {
    return None
  }
  Some slot
}

/**
 * The inner type of a `lazy` parameter. The arguments of the **callee's** instance go in and not the caller's: the type
 * is written in the callee's declaration, so `okOr(ConfigError(...))` has to read `Failure` through the mapping the
 * dispatch decided.
 */
fn lazyItemAt(
  var lowering: Lowering,
  signature: Signature,
  position: Int,
  mapping: Map<ParameterId, TypeId>,
  at: Span,
): TypeId {
  const parameter = match signature.form.parameters.get(position) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a `lazy` parameter without a type", at
      return lowering.checker.invalidType
    }
  }
  if mapping.isEmpty() {
    return parameter.annotation
  }
  substitute lowering.checker.types, parameter.annotation, mapping
}

/** One argument of a `var` parameter, whose place has to end in exactly the type the parameter declares. */
fn referenceArgumentAt(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  value: Expression,
  signature: Signature,
  position: Int,
  mapping: Map<ParameterId, TypeId> = [:],
): PlacePath? {
  const annotation = match parameterTypeAt(lowering, signature, position, mapping) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a `var` parameter without a type", value.span
      return None
    }
  }
  const path = match argumentReference(lowering, builder, value, annotation, "a `var` argument") {
    Some(found) => found
    None => {
      return None
    }
  }
  /*
   * A place is **not** a value, so nothing can coerce one: where the storage the caller names is a concrete type and the
   * parameter asks for the trait type of it (`Source<Item, Failure>` for an `Iterating<…>`), there is no `TraitValue` to
   * put in between - the callee would write through a box the caller does not have. The checker allows the coercion
   * because it reads the argument as a value; here it is a clean finding instead of the two internal errors of the
   * verifier ("its place is …") a body in `std/stream` would otherwise produce.
   */
  if path.annotation != annotation && isSharedObjectType(lowering, path.annotation) && isObjectType(lowering, annotation) {
    return sharedObjectAsTraitPlace lowering, builder, value, signature, position, mapping, path, annotation
  }
  if path.annotation != annotation {
    const given = describeIrType lowering.program, path.annotation
    const wanted = describeIrType lowering.program, annotation
    const what = "a `var` argument of `{given}` where the parameter asks for `{wanted}`, which a place cannot become"
    reportUnsupported lowering, what, value.span
    return None
  }
  Some path
}

/**
 * A `shared type` object handed to a `var` parameter of a trait it implements (`Staged.of self, stage` in a default member
 * of `Source` reached for a concrete source): the object has an identity, so what the callee changes through the
 * trait-typed value is the very object the caller's place holds, and the place itself is never written. So the object
 * is read out of the place and boxed as the trait-typed value, and the callee gets the place of that value.
 */
fn sharedObjectAsTraitPlace(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  value: Expression,
  signature: Signature,
  position: Int,
  mapping: Map<ParameterId, TypeId>,
  path: PlacePath,
  annotation: IrTypeId,
): PlacePath? {
  const parameter = signature.form.parameters.get(position)?
  const wanted = if mapping.isEmpty() { parameter.annotation } else { substitute lowering.checker.types, parameter.annotation, mapping }
  const source = match lowering.checker.expressionType(lowering.module, value.span) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a `var` argument without a type", value.span
      return None
    }
  }
  const held = addTemporary builder, path.annotation
  emit builder, Instruction.Read(held, path.reference)
  const boxed = addTemporary builder, annotation
  if !lowerTraitValue(lowering, builder, boxed, held, boundsOfTraitValue(lowering, wanted), source, value.span) {
    return None
  }
  Some PlacePath(Reference(boxed, []), annotation, path.taken)
}

fn isSharedObjectType(lowering: Lowering, annotation: IrTypeId): Bool {
  match lowering.program.typeAt(annotation) {
    .SharedObject(_) => true
    _ => false
  }
}

fn isObjectType(lowering: Lowering, annotation: IrTypeId): Bool {
  match lowering.program.typeAt(annotation) {
    .Object(_) => true
    _ => false
  }
}

/**
 * The parameters that were not written take their default, lowered **at the call site**, at every call, in the scope
 * of the declaration - so the tables that are read for it are the callee's module's (docs/BACKEND.md, Parameter
 * defaults have no evaluation rule), and the substitution in scope for it is the **callee's** instance mapping and
 * not the caller's: a default of a generic declaration is written in terms of that declaration's own parameters.
 */
fn lowerDefaults(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  expression: Expression,
  signature: Signature,
  filled: List<Slot?>,
  places: List<Reference?>,
  taken: List<TakenElement>,
  references: List<Bool>,
  mapping: Map<ParameterId, TypeId> = [:],
): CallOperands {
  var found = filled
  const lazies = lazyParametersOf signature
  const defaults = declaredDefaults lowering, signature.symbol
  for index in 0..found.length() {
    if found[index].isSome() {
      continue
    }
    // A default is a value, so a `var` parameter nobody wrote an argument for has no place the callee could work on
    if references.get(index) ?? false {
      reportUnsupported lowering, "a `var` parameter that takes its default", expression.span
      return CallOperands([], [])
    }
    // The default of a `lazy` parameter would have to become a thunk of the *callee's* module, which no call site builds
    if lazies.get(index) ?? false {
      reportUnsupported lowering, "a `lazy` parameter that takes its default", expression.span
      return CallOperands([], [])
    }
    const written = defaults.get(index) ?? None
    const value = match written {
      Some(inner) => inner
      None => {
        reportUnsupported lowering, missingArgument(signature, index), expression.span
        return CallOperands([], [])
      }
    }
    const slot = lowerForeignExpression lowering, builder, signature.symbol, value, mapping
    if !lowering.isSupported {
      return CallOperands([], [])
    }
    found.set index, Some(slot)
  }
  var ordered: List<Slot> = []
  for entry in found {
    match entry {
      Some(slot) => ordered.append slot
      None => {
        reportUnsupported lowering, "an argument list the back end could not complete", expression.span
        return CallOperands([], [])
      }
    }
  }
  CallOperands ordered, places, taken
}

/**
 * Why a parameter has nothing to take. A **variadic** one is the case that really happens: `Set.of()` writes no argument
 * at all, and a variadic parameter has no default either - it is the empty *list*, which is what a variadic parameter is
 * at the call site and therefore what the spread of the other row brings. Saying "without a default" for one named the
 * wrong cause: twelve of them in the compiler are `Set.of()` and `List.of()`.
 */
fn missingArgument(signature: Signature, index: Int): String {
  if const Some(parameter) = signature.form.parameters.get(index) {
    if const .Variadic = parameter.mode {
      return "a variadic parameter no argument was written for"
    }
  }
  "a parameter without an argument and without a default"
}

/**
 * The default expression of every parameter of a declaration, in the order of its *signature* - which skips the `self`
 * the parameter list of the source writes.
 *
 * A **case constructor** is a function from its fields to the type it belongs to (`caseSignature`), and what declares it
 * is a `case` and not a `fn` - so looking for a `fn` answered "this declaration has no defaults at all" and a field that
 * took its own default became "a parameter without an argument and without a default". `CStatement.Declaration` of the C
 * writer is the one in the compiler: four fields, of which every call writes two or three.
 */
fn declaredDefaults(var lowering: Lowering, symbol: SymbolId): List<Expression?> {
  var defaults: List<Expression?> = []
  // A **case** is a function from its own fields, so the defaults of a `Call(target, callee, arguments, witnesses,
  // at = None)` are the fields' and not a parameter list's
  if const Some(fields) = caseFieldsOfDeclarationSite(lowering, symbol) {
    for field in fields {
      defaults.append field.default
    }
    return defaults
  }
  const declared = match functionOfDeclarationSite(lowering, symbol) {
    Some(found) => found.parameters
    None => {
      return defaults
    }
  }
  for parameter in declared {
    if parameter.name.text == "self" && parameter.annotation.isNone() {
      continue
    }
    defaults.append parameter.default
  }
  defaults
}

/** The fields of a case, where the symbol is one: what `caseSignature` made the parameters of its constructor. */
fn caseFieldsOfDeclarationSite(var lowering: Lowering, symbol: SymbolId): List<Field>? {
  const site = lowering.checker.siteOf(symbol)?
  if const .Owned(_, _, member) = site.kind {
    if const .Case(declaration) = member.kind {
      return Some declaration.fields
    }
  }
  None
}

fn functionOfDeclarationSite(var lowering: Lowering, symbol: SymbolId): FunctionDeclaration? {
  const site = lowering.checker.siteOf(symbol)?
  match site.kind {
    .Declared(declaration) => {
      if const .Function(function) = declaration.kind {
        return Some function
      }
      None
    }
    .Owned(_, _, member) => {
      if const .Function(function) = member.kind {
        return Some function
      }
      None
    }
    _ => None
  }
}

/**
 * An expression of another module, lowered into the frame of this one: a parameter default and a field default. The
 * tables are keyed by module, so which module is being read has to change with the expression.
 */
public fn lowerForeignExpression(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  symbol: SymbolId,
  value: Expression,
  substitution: Map<ParameterId, TypeId> = [:],
): Slot {
  const outer = lowering.module
  const outerSubstitution = lowering.substitution
  if const Some(site) = lowering.checker.siteOf(symbol) {
    enterModule lowering, site.module
  } else if const Some(declared) = lowering.checker.symbolAt(symbol).module {
    // The field of a case has no site of its own, and its default is written where the symbol is
    enterModule lowering, declared
  }
  lowering.substitution = substitution
  const slot = lowerValue lowering, builder, value
  lowering.module = outer
  lowering.substitution = outerSubstitution
  slot
}

// --- Constructors ---------------------------------------------------------------------------------------------------

/** `Point(10, 20)`: the generated constructor of a plain record, with the fields in declaration order. */
fn lowerConstructorCall(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  arguments: List<Argument>,
  annotation: IrTypeId,
  owner: TypeId,
): Slot {
  // `Channel<Item>(capacity:)` is a block of the runtime, which only the runtime can make
  if const Some(item) = channelItemOf(lowering, annotation) {
    const fields = lowerFieldArguments lowering, builder, expression, arguments, owner, None
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
    const capacity = match fields.first() {
      Some(found) => found
      None => {
        return unsupportedSlot lowering, builder, destination, "a `Channel` without a capacity", expression.span
      }
    }
    return lowerChannelNew lowering, builder, destination, capacity, annotation, item, expression.span
  }
  // `HashMap()`: a container of the runtime has no fields, so its constructor is the empty container itself
  if const .Runtime(kind, _) = lowering.program.typeAt(annotation) {
    if arguments.isEmpty() {
      return lowerEmptyContainer lowering, builder, destination, annotation, kind, owner, expression.span
    }
  }
  const layout = match layoutOfType(lowering.program, annotation) {
    Some(found) => found
    None => {
      const shown = describeIrType lowering.program, annotation
      return unsupportedSlot lowering, builder, destination, "a constructor of `{shown}`", expression.span
    }
  }
  const shape = lowering.program.layoutAt layout
  if !shape.variants.isEmpty() {
    return unsupportedSlot lowering, builder, destination, "a constructor of a variant type", expression.span
  }
  const slots = lowerFieldArguments lowering, builder, expression, arguments, owner, None
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const target = valueSlot lowering, builder, destination, annotation
  lowerConstruct lowering, builder, target, layout, 0, slots
  target
}

/**
 * `var index: Map<String, Int> = HashMap()`: the constructor of a container the runtime owns, which is the empty
 * container over the element descriptors of its type arguments - the same `ContainerNew` its `withCapacity` is.
 */
fn lowerEmptyContainer(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  annotation: IrTypeId,
  kind: RuntimeKind,
  owner: TypeId,
  at: Span,
): Slot {
  const isContainer = match kind {
    .ListStorage | .MapStorage | .SetStorage => true
    _ => false
  }
  const given = match lowering.checker.types.form(substituted(lowering, owner)) {
    .Nominal(_, found) => found
    _ => []
  }
  if !isContainer || given.isEmpty() {
    const shown = describeIrType lowering.program, annotation
    return unsupportedSlot lowering, builder, destination, "a constructor of `{shown}`", at
  }
  var elements: List<ElementId> = []
  for index in 0..given.length() {
    const found = match elementFor(lowering, given[index], index == 0 && isKeyedContainer(kind), at) {
      Some(one) => one
      None => {
        return abandonedSlot lowering, builder, destination
      }
    }
    elements.append found
  }
  const target = valueSlot lowering, builder, destination, annotation
  emit builder, Instruction.ContainerNew(target, kind, elements)
  target
}

/**
 * `p.copy(y: 30)`: every field that is not written comes out of the receiver. A `Construct` from the old fields plus
 * the overrides - turning that into a `MakeUnique` plus a `Write` where the source is dead is 5.4's, because only
 * liveness says whether the source *is* dead.
 */
fn lowerCopyCall(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  callee: Expression,
  arguments: List<Argument>,
  annotation: IrTypeId,
  owner: TypeId,
): Slot {
  const layout = match layoutOfType(lowering.program, annotation) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "`copy` of a value without a layout", expression.span
    }
  }
  const receiver = match receiverSlot(lowering, builder, callee) {
    Some(found) => found
    None => {
      const what = "`copy` of a receiver the back end cannot reach"
      return unsupportedSlot lowering, builder, destination, what, expression.span
    }
  }
  const slots = lowerFieldArguments lowering, builder, expression, arguments, owner, Some(receiver)
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const target = valueSlot lowering, builder, destination, annotation
  lowerConstruct lowering, builder, target, layout, 0, slots
  target
}

/**
 * The fields of a construction, in declaration order. A field that was not written takes its own default, or - for
 * `copy` - the value the receiver has.
 */
fn lowerFieldArguments(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  expression: Expression,
  arguments: List<Argument>,
  owner: TypeId,
  receiver: Slot?,
): List<Slot> {
  const module = lowering.module
  const fields = fieldsOf lowering.checker, owner
  const count = fields.length()
  const targets = match lowering.checker.argumentTargetsAt(module, expression.span) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a construction without an argument plan", expression.span
      return []
    }
  }
  var filled: List<Slot?> = []
  for _ in 0..count {
    filled.append None
  }
  for index in 0..arguments.length() {
    const position = targets.get(index) ?? -1
    if position < 0 || position >= count {
      reportUnsupported lowering, "an argument that fills no field", arguments[index].value.span
      return []
    }
    const slot = lowerValue lowering, builder, arguments[index].value
    if !lowering.isSupported {
      return []
    }
    filled.set position, Some(slot)
  }
  const substitution = ownerSubstitutionOf lowering, owner
  completeFields lowering, builder, expression, fields, filled, receiver, substitution
}

/**
 * The generic parameters of the type that is being constructed, filled in from the arguments it is constructed with:
 * `Request<Item>(...)` for an `Item` of `String` maps `Item` to `String`.
 *
 * A **field default** is written in terms of exactly these, and it is lowered in the module the field is declared in -
 * so the caller's own substitution is the wrong one there, which is what made a default of a field of a generic type of
 * `std/http` report "the generic parameter `Item` was not substituted". The mapping is only in hand here.
 */
fn ownerSubstitutionOf(var lowering: Lowering, owner: TypeId): Map<ParameterId, TypeId> {
  var mapping: Map<ParameterId, TypeId> = [:]
  const applied = substituted lowering, owner
  if const .Nominal(symbol, given) = lowering.checker.types.form(applied) {
    const identifier = typeSignatureOf lowering.checker, symbol
    const shape = lowering.checker.typeSignature identifier
    for index in 0..shape.generics.length().min(given.length()) {
      mapping.set shape.generics[index], given[index]
    }
  }
  mapping
}

fn completeFields(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  expression: Expression,
  fields: List<FieldSignature>,
  filled: List<Slot?>,
  receiver: Slot?,
  substitution: Map<ParameterId, TypeId> = [:],
): List<Slot> {
  var found = filled
  for index in 0..found.length() {
    if found[index].isSome() {
      continue
    }
    const field = fields[index]
    if const Some(base) = receiver {
      const slot = readFieldOf lowering, builder, base, index, expression.span
      if !lowering.isSupported {
        return []
      }
      found.set index, Some(slot)
      continue
    }
    const value = match fieldDefaultOf(lowering, field.symbol) {
      Some(inner) => inner
      None => {
        reportUnsupported lowering, "a field without an argument and without a default", expression.span
        return []
      }
    }
    const slot = lowerForeignExpression lowering, builder, field.symbol, value, substitution
    if !lowering.isSupported {
      return []
    }
    found.set index, Some(slot)
  }
  var ordered: List<Slot> = []
  for entry in found {
    match entry {
      Some(slot) => ordered.append slot
      None => {
        reportUnsupported lowering, "a construction the back end could not complete", expression.span
        return []
      }
    }
  }
  ordered
}

/** One field of the receiver of a `copy`. */
fn readFieldOf(var lowering: Lowering, var builder: FunctionBuilder, base: Slot, index: Int, at: Span): Slot {
  const owner = builder.typeOfSlot base
  const layout = match layoutOfType(lowering.program, owner) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`copy` of a value without a layout", at
      return abandonedSlot lowering, builder, None
    }
  }
  const shape = lowering.program.layoutAt layout
  const annotation = shape.fields[index].annotation
  const target = valueSlot lowering, builder, None, annotation
  emit builder, Instruction.Read(target, Reference(base, [PathStep.Field(layout, index)]))
  target
}

/** The default of a field, which is written in the declaration of its type. */
/**
 * The default of one parameter of a function **value**: `const makeConfig = Config` keeps the defaults of `Config`, so
 * `makeConfig("h")` fills `port` with the default of that field. The declaration is the one the checker noted for the
 * function type ([DefaultSource]); a constructor's defaults are its fields' and everything else's are its parameters'.
 */
public fn lowerDefaultOfSource(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  source: DefaultSource,
  index: Int,
  at: Span,
): Slot? {
  match source {
    .Constructed(owner) => {
      const fields = fieldsOf lowering.checker, owner
      const field = match fields.get(index) {
        Some(found) => found
        None => {
          reportUnsupported lowering, "a function value with a parameter that is no field", at
          return None
        }
      }
      const written = match fieldDefaultOf(lowering, field.symbol) {
        Some(found) => found
        None => {
          reportUnsupported lowering, "a function value whose field has no default", at
          return None
        }
      }
      const substitution = ownerSubstitutionOf lowering, owner
      Some lowerForeignExpression(lowering, builder, field.symbol, written, substitution)
    }
    .Declared(symbol) => {
      const defaults = declaredDefaults lowering, symbol
      const written = match defaults.get(index) ?? None {
        Some(found) => found
        None => {
          reportUnsupported lowering, "a function value whose parameter has no default", at
          return None
        }
      }
      const empty: Map<ParameterId, TypeId> = [:]
      Some lowerForeignExpression(lowering, builder, symbol, written, empty)
    }
    .Ambiguous => {
      reportUnsupported lowering, "a function value whose defaults two declarations could have written", at
      None
    }
  }
}

fn fieldDefaultOf(var lowering: Lowering, field: SymbolId): Expression? {
  const site = lowering.checker.siteOf(field)?
  if const .Owned(_, _, member) = site.kind {
    if const .Field(declared) = member.kind {
      return declared.default
    }
    if const .Case(declared) = member.kind {
      for one in declared.fields {
        if one.name.text == lowering.checker.symbolAt(field).name {
          return one.default
        }
      }
    }
  }
  None
}

// --- Case constructors ----------------------------------------------------------------------------------------------

/**
 * `Shape.Circle(1.0)`, `.Circle(1.0)`, `Some(x)`, `Ok(value)`: one `Construct` of the variant the case names. A case is a
 * function from *its own* fields to the type it belongs to, so a variant type that also declares fields of its own
 * cannot be built this way - that is a gap of the language and not of the back end, and it is named as one.
 */
fn lowerCaseCall(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  arguments: List<Argument>,
  annotation: IrTypeId,
  variant: SymbolId,
): Slot {
  const identifier = signatureOf lowering.checker, variant
  const signature = lowering.checker.signature identifier
  // A case is a function from its own fields, and a field is a value: no position of one is ever a place
  const written = lowerArgumentSlots lowering, builder, expression, arguments, signature
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  constructedCase lowering, builder, destination, expression, annotation, variant, written.slots
}

/** `Shape.Empty`, `None`: a case without fields, written as a value. */
public fn lowerCaseValue(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  owner: TypeId,
  variant: SymbolId,
  annotation: IrTypeId,
): Slot {
  // `Ok`, `Some`: a case that takes fields and is written without them is a function value like a constructor
  if layoutOfType(lowering.program, annotation).isNone() {
    const layout = match layoutOfType(lowering.program, resultOfCaseValue(lowering, annotation)) {
      Some(found) => found
      None => {
        const name = lowering.checker.symbolAt(variant).name
        const what = "`{name}` used as a function value of a type without a layout"
        return unsupportedSlot lowering, builder, destination, what, expression.span
      }
    }
    const index = variantIndexOf lowering, layout, variant
    if index < 0 {
      const name = lowering.checker.symbolAt(variant).name
      const what = "`{name}`, which the layout of its type does not have as a case"
      return unsupportedSlot lowering, builder, destination, what, expression.span
    }
    return lowerConstructorValue lowering, builder, destination, expression, index, annotation
  }
  constructedCase lowering, builder, destination, expression, annotation, variant, []
}

/** What a case used as a function value builds: the result of the closure type the checker gave it. */
fn resultOfCaseValue(var lowering: Lowering, annotation: IrTypeId): IrTypeId {
  if const .Closure(signature) = lowering.program.typeAt(annotation) {
    return lowering.program.signatureAt(signature).result
  }
  annotation
}

fn constructedCase(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  annotation: IrTypeId,
  variant: SymbolId,
  slots: List<Slot>,
): Slot {
  const layout = match layoutOfType(lowering.program, annotation) {
    Some(found) => found
    None => {
      const shown = describeIrType lowering.program, annotation
      return unsupportedSlot lowering, builder, destination, "a case of `{shown}`", expression.span
    }
  }
  const index = variantIndexOf lowering, layout, variant
  if index < 0 {
    const name = lowering.checker.symbolAt(variant).name
    const what = "`{name}`, which the layout of its type does not have as a case"
    return unsupportedSlot lowering, builder, destination, what, expression.span
  }
  const shape = lowering.program.layoutAt layout
  if shape.fieldsOfConstruction(index).length() != slots.length() {
    const name = lowering.checker.symbolAt(variant).name
    const what = "`{name}` of a type that carries fields of its own next to its cases"
    return unsupportedSlot lowering, builder, destination, what, expression.span
  }
  const target = valueSlot lowering, builder, destination, annotation
  lowerConstruct lowering, builder, target, layout, index, slots
  target
}

/** One `Construct`: every field is an `Owned` position, which 5.4 writes out. */
public fn lowerConstruct(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  target: Slot,
  layout: LayoutId,
  variant: Int,
  slots: List<Slot>,
) {
  const given = borrowedArguments slots
  emit builder, Instruction.Construct(target, layout, variant, given)
}

// --- Operators that are not intrinsics ------------------------------------------------------------------------------

/**
 * An operator on a type of the program: `a + b` is `Add.add`, and the checker recorded which implementation provides
 * it. The operands are already in slots, so this is an ordinary call with the receiver first.
 */
public fn lowerOperator(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  at: Span,
  operands: List<Slot>,
  annotation: IrTypeId,
  operand: TypeId? = None,
  memberName: String = "",
): Slot {
  // An operand did not return (`1 + fail()`), so the operator is never applied (`lowerDispatched` says why)
  if lowering.isDiverged {
    return abandonedSlot lowering, builder, destination
  }
  const module = lowering.module
  const resolution = match lowering.checker.resolutionAt(module, at) {
    Some(found) => found
    None => {
      const name = memberName
      return structuralOperator lowering, builder, destination, at, operands, annotation, operand, name
    }
  }
  const (symbol, typeArguments, dispatch) = match resolution {
    .Callable(found, given, how) => (found, given, how)
    _ => {
      return unsupportedSlot lowering, builder, destination, "an operator the back end does not lower yet", at
    }
  }
  const receiver = operandTypeOf lowering, dispatch, operand
  const dispatched = match dispatchedMember(lowering, symbol, typeArguments, dispatch, receiver, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const member = dispatched.member
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  if needsReference(signature) {
    return unsupportedSlot lowering, builder, destination, "an operator with a `var` receiver", at
  }
  if dispatched.isDynamic {
    const what = "an operator on a trait-typed value, which object safety forbids"
    return unsupportedSlot lowering, builder, destination, what, at
  }
  const owner = dispatched.owner
  const name = memberNameOf lowering, member
  if !signature.hasBody {
    if const Some(entry) = nativeNamed(lowering, owner, name, signature) {
      return lowerNativeOperator lowering, builder, destination, at, operands, annotation, dispatched, entry
    }
    if const Some(generated) = generatedMemberFor(lowering, dispatched, at) {
      return emitCall lowering, builder, destination, generated, operands, annotation, at
    }
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
  }
  const mapping = dispatched.mapping
  const function = match instanceFor(lowering, member, mapping) {
    Some(found) => found
    None => {
      const what = describeCallee lowering, member, signature
      return unsupportedSlot lowering, builder, destination, what, at
    }
  }
  emitCall lowering, builder, destination, function, operands, annotation, at
}

/**
 * The numeric kind an intrinsic works on, which for a **conversion** is the operand's own type and not the manifest's.
 *
 * `Int64` implements `From<Int8>`, `From<Int16>`, `From<Int32>`, `From<UInt8>`, `From<UInt16>`, `From<UInt32>` and
 * `From<Char>`, and the manifest is keyed by `owner.member`: there is one `Int64.from` entry for all seven. What the entry
 * decides is the type the conversion arrives at (`Convert(Signed(64))`); where it *starts* is what the call hands over, so
 * it is read off the operand - which is also what makes `Int.from('A')` work, because a `Char` is a `uint32_t` code point
 * and therefore starts at `Unsigned(32)`.
 *
 * Every other intrinsic keeps the kind the manifest gave it: `Int8.add` is one entry per width on purpose.
 */
fn sourceKindOf(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  intrinsic: Intrinsic,
  operands: List<Slot>,
): NumericKind? {
  if const .Convert(_) = intrinsic.operation {
    if const Some(slot) = operands.first() {
      if const Some(found) = conversionKindOf(lowering.program, builder.typeOfSlot(slot)) {
        return Some found
      }
    }
  }
  intrinsic.kind
}

/**
 * An operator the checker accepted and recorded no **member** for. `==` and `<` are where this happens: the `Equals`
 * and the `Compare` of a **tuple** are structural and belong to no declaration at all, and the generated ones of a
 * record are reached through the implementation the language writes rather than through a member of the type - in both
 * cases `lookupMember` finds nothing, so `recordTraitCall` records nothing, although `traitArgumentsOf` says the type
 * has the trait and the comparison is accepted.
 *
 * The lowering asks the question its own `for` asks instead (`dispatchedOn`), which reaches the body `derive.trb`
 * generates for that very type: `equalsBody` field by field, `compareTupleBody` lexicographically. An operand that is
 * neither a tuple nor a nominal type - and every arithmetic operator, which has no member name here - stays the
 * finding it was.
 */
fn structuralOperator(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  at: Span,
  operands: List<Slot>,
  annotation: IrTypeId,
  operand: TypeId?,
  memberName: String,
): Slot {
  const unresolved = "an operator the checker did not resolve"
  const written = match operand {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, unresolved, at
    }
  }
  const subject = substituted lowering, written
  if memberName.isEmpty() || !isDerivableOperand(lowering, subject) {
    return unsupportedSlot lowering, builder, destination, unresolved, at
  }
  const capability = if memberName == "equals" { "Equals" } else { "Compare" }
  const empty: List<TypeId> = []
  const bound = match preludeType(lowering, capability, empty) {
    Some(found) => found
    None => {
      const what = "an operator without `{capability}` in the prelude"
      return unsupportedSlot lowering, builder, destination, what, at
    }
  }
  const dispatched = match dispatchedOn(lowering, subject, bound, memberName, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const places: List<Reference?> = []
  lowerDispatched lowering, builder, destination, at, dispatched, operands, places, annotation
}

/** Whether an operand is a type whose comparison the language can write itself: a tuple, or a record or a case. */
fn isDerivableOperand(var lowering: Lowering, subject: TypeId): Bool {
  match lowering.checker.types.form(subject) {
    .Tuple(_) | .Nominal(_, _) => true
    _ => false
  }
}

/**
 * What the left operand of an operator is, as a checker type. An operator has no callee expression, so the dispatch is
 * what says it where it can: an implementation names its own target. Where it cannot - `Dispatch.Object`, which is what
 * `==` between two trait-typed values is - the **written operand** answers, and a dispatch without one is a finding.
 *
 * A **generic** implementation names a target that is not closed: `extend<Item: Numeric> Pair<Item> with Add` says
 * `Pair<Item>`, and an instance cannot be built for a parameter. The written operand carries the same type with the
 * arguments of the enclosing instance in it (`Pair<Int64>`), so it is the better answer wherever the target still holds
 * a parameter - which is what makes `a + b` reach the instance `a.add(b)` reaches.
 */
fn operandTypeOf(var lowering: Lowering, dispatch: Dispatch, operand: TypeId?): TypeId? {
  // `a == b` on two `List<TypeId>`s: the member is reached on the **left operand**, which is the receiver an operator has.
  // `Equals.equals` mentions `Self` as a parameter and is therefore in no table, so what this decides is not whether the
  // call is dynamic but which type's `equals` runs - `dynamicDispatch` then finds the body and instantiates it statically
  const written = writtenOperandOf lowering, operand
  if const .Implementation(implementation, _) = dispatch {
    const found = lowering.checker.implementations.at implementation
    if isClosedType(lowering, found.target) {
      return Some found.target
    }
    if const Some(applied) = written {
      return Some applied
    }
    return Some found.target
  }
  written
}

/** The type of the left operand as this instance sees it, with its own type arguments substituted. */
fn writtenOperandOf(var lowering: Lowering, operand: TypeId?): TypeId? {
  const found = operand?
  Some substituted(lowering, found)
}

fn lowerNativeOperator(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  at: Span,
  operands: List<Slot>,
  annotation: IrTypeId,
  dispatched: Dispatched,
  entry: NativeEntry,
): Slot {
  if const .Planned(_) = entry.state {
    const what = "`{entry.name}`"
    return unsupportedSlot lowering, builder, destination, what, at, "the runtime does not provide it"
  }
  const member = dispatched.member
  const mapping = dispatched.mapping
  match entry.target {
    .Intrinsic(intrinsic) => {
      const target = valueSlot lowering, builder, destination, annotation
      const kind = sourceKindOf lowering, builder, intrinsic, operands
      emitIntrinsic lowering, builder, Some(target), intrinsic.operation, kind, operands, at
      target
    }
    .Runtime(function) => {
      const identifier = match nativeFunctionOf(lowering, member, mapping, entry, function, at) {
        Some(found) => found
        None => {
          if !lowering.isSupported {
            return abandonedSlot lowering, builder, destination
          }
          return unsupportedSlot lowering, builder, destination, "`{entry.name}`", at
        }
      }
      emitCall lowering, builder, destination, identifier, operands, annotation, at
    }
    .Derived(derived) => {
      const generated = match generatedMemberOf(lowering, dispatched, derived, at) {
        Some(found) => found
        None => {
          return abandonedSlot lowering, builder, destination
        }
      }
      emitCall lowering, builder, destination, generated, operands, annotation, at
    }
    // No operator of the language builds a container, starts a task or stops one, so nothing reaches these
    .Container(_) => unsupportedSlot lowering, builder, destination, "`{entry.name}` as an operator", at
    .Lowered => unsupportedSlot lowering, builder, destination, "`{entry.name}` as an operator", at
    .ArrayStorage(_) => unsupportedSlot lowering, builder, destination, "`{entry.name}` as an operator", at
    .Target(_) => unsupportedSlot lowering, builder, destination, "`{entry.name}` as an operator", at
    .ScriptTable(_) => unsupportedSlot lowering, builder, destination, "`{entry.name}` as an operator", at
    .Machine(_) => unsupportedSlot lowering, builder, destination, "`{entry.name}` as an operator", at
    .ScriptHost(_) => unsupportedSlot lowering, builder, destination, "`{entry.name}` as an operator", at
  }
}
