/**
 * Statements, blocks and the two loops. A block is a value where its last statement is an expression, which is the
 * same rule the checker follows - so `const x = \{ ... value \}` needs nothing of its own here.
 *
 * `for` is lowered **without an iterator** where the subject is written as a range with both ends: a counter, a
 * comparison and an increment, which is what "only if it needs no trait dispatch" means. Every other `for` needs
 * `Iterate.iterate()` and the `Option` its `next()` answers (`lowerForIterate`).
 */

use Span from "../../syntax/source"
use Statement, Block, Binding, Condition, Expression, Pattern from "../../syntax/ast"
use resultOf from "../../semantics/checker/signature"
use IrTypeId, IrType, Slot, Terminator, IntrinsicOperation, Instruction, Reference, PathStep, borrowed from "../ir"
use LayoutId from "../ir"
use FunctionBuilder, addLocal, addTemporary, addBlock, emit from "../build"
use numericKindOf, layoutOfType from "../verify"
use Lowering, reportUnsupported, locationOf, irTypeOf, booleanTypeOf, SlotAlias from "./context"
use substituted, irTypeOfClosed from "./context"
use isVoidType, isNeverType, typeAtSpan, finishBlock, continueIn from "./context"
use enterLoop, leaveLoop, breakTarget, continueTarget, markBreak from "./context"
use lowerExpression, lowerValue, voidSlot, integerSlot, emitIntrinsic, implicitParameterOf from "./expression"
use traitArgumentsOf from "../../semantics/checker/implementation"
use lowerPatternBinding, lowerWhileBinding, variantLayoutOfType, variantNamed from "./match"
use lowerPlaceAssignment, lowerSlotAssignment, isReferenceSlot from "./place"
use pathPreludeAt, referenceFrom, indexedMemberOf, PathPrelude from "./place"
use PlaceStep from "../../semantics/checker/context"
use isCapturedVariable, lowerBoxedBinding, bindingReferenceOf from "./closure"
use containsCountedType from "../layout"
use TypeId from "../../semantics/checker/type"
use isClosedType from "../instances"
use Dispatched, dispatchedOn, resultTypeOf from "./generic"
use lowerDispatched from "./call"
use iterateBoundOf, iteratorBoundOf from "./collection"
use openScope, closeScope, declareScoped, declareScopedFrom, endEveryScope, endLoopScopes, endTemporaries from "./scope"
use markStatement, openVisible, closeVisible, declareVisible from "./scope"

/**
 * Every statement of a block, and the value of the block where somebody takes one. Nothing is emitted after a
 * statement that diverges: the instructions would land in a block nothing reaches, which the verifier rejects.
 */
public fn lowerBlockInto(var lowering: Lowering, var builder: FunctionBuilder, block: Block, destination: Slot?) {
  const found = lowerStatements lowering, builder, block, destination
  // A block that does not end in an expression is worth `Void`, and somebody may still be taking that value
  if found.isSome() || lowering.diverged || destination.isNone() {
    return
  }
  const _ = voidSlot lowering, builder, destination
}

/**
 * The value of a block, in whatever slot it already is. Used where nothing forces a slot on it - the body of a
 * function, whose value the `return` carries - so that `fn f(): Point \{ ... point \}` returns the local itself
 * instead of a copy of it.
 */
public fn lowerBlockValue(var lowering: Lowering, var builder: FunctionBuilder, block: Block): Slot? {
  lowerStatements lowering, builder, block, destination: None
}

/**
 * A block is a scope: the bindings it declares whose value may hold a `Close` object end where it ends
 * (`ir/lower/scope.trb`), after the value of the block was produced.
 */
fn lowerStatements(var lowering: Lowering, var builder: FunctionBuilder, block: Block, destination: Slot?): Slot? {
  openScope lowering
  const found = lowerStatementsOfScope lowering, builder, block, destination
  closeScope lowering, builder
  found
}

fn lowerStatementsOfScope(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  block: Block,
  destination: Slot?,
): Slot? {
  const last = block.statements.length() - 1
  for index in 0..block.statements.length() {
    if lowering.diverged || !lowering.supported {
      return None
    }
    const statement = block.statements[index]
    // A debugged program marks where every statement begins; a declaration inside a block runs nothing
    if runsCode(statement) {
      markStatement lowering, builder, statement.span
    }
    if index == last {
      if const .Evaluate(expression) = statement.kind {
        // The last expression of a block that stands as a statement - a loop body, a body, a branch whose value nobody
        // takes - is a statement too, and the temporaries it made end with it, all but the value the block hands on. A
        // block that produces into a slot is part of the statement around it, which ends them
        const firstSlot = builder.slotCount()
        const isStatement = destination.isNone()
        // The value of a block that is used as a statement is `Void`, and its last expression may still *have* one:
        // `{ errorHere "..."  bump() }` as a `match` arm discards the `Token` that `bump` answers (docs/TYPECHECKER.md,
        // Which discarded values are errors?). Producing it into the arm's own slot would put a `Token` in a `Void`
        // slot, which is what the verifier catches
        if discardsLastValue(lowering, builder, expression, destination) {
          const _ = lowerExpression lowering, builder, expression, destination: None
          if isStatement {
            endTemporaries lowering, builder, firstSlot
          }
          return None
        }
        const value = lowerExpression lowering, builder, expression, destination
        if isStatement {
          endTemporaries lowering, builder, firstSlot, except: value
        }
        return value
      }
    }
    lowerStatement lowering, builder, statement
  }
  None
}

/** Whether a statement of a block runs anything: a `fn`, a `type` or a `trait` declared inside it does not. */
fn runsCode(statement: Statement): Bool {
  match statement.kind {
    .Declare(_) => false
    _ => true
  }
}

/** Whether the slot the block produces into is `Void` while its last expression answers something else. */
fn discardsLastValue(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  expression: Expression,
  destination: Slot?,
): Bool {
  const slot = match destination {
    Some(found) => found
    None => {
      return false
    }
  }
  if !isVoidType(lowering, builder.typeOfSlot(slot)) {
    return false
  }
  const annotation = match typeAtSpan(lowering, expression.span) {
    Some(found) => found
    None => {
      return false
    }
  }
  !isVoidType(lowering, annotation) && !isNeverType(lowering, annotation)
}

/**
 * One statement, dispatched on its kind. A `Declare` is reached through the worklist and emits nothing here.
 *
 * A statement is also the scope of the temporaries it made: one that may hold a `Close` object is released where the
 * statement ends, the last made first (`endTemporaries`), and never in the middle of it.
 */
public fn lowerStatement(var lowering: Lowering, var builder: FunctionBuilder, statement: Statement) {
  if !lowering.supported {
    return
  }
  const firstSlot = builder.slotCount()
  lowerStatementKind lowering, builder, statement
  endTemporaries lowering, builder, firstSlot
}

fn lowerStatementKind(var lowering: Lowering, var builder: FunctionBuilder, statement: Statement) {
  match statement.kind {
    // A `fn`, a `type` or a `trait` inside a block is reached through a call of it, so nothing is emitted here
    .Declare(_) => {}
    .Bind(binding) => lowerBinding lowering, builder, binding, statement.span
    .Assign(target, value) => lowerAssignment lowering, builder, target, value, statement.span
    .While(condition, body) => lowerWhile lowering, builder, condition, body, statement.span
    .Loop(body) => lowerLoop lowering, builder, body, statement.span
    .For(pattern, iterable, body, isSlots) => {
      if isSlots {
        lowerForSlots lowering, builder, pattern, iterable, body, statement.span
      } else {
        lowerFor lowering, builder, pattern, iterable, body, statement.span
      }
    }
    .Return(value) => lowerReturn lowering, builder, value, statement.span
    .Break => lowerBreak lowering, builder, statement.span
    .Continue => lowerContinue lowering, builder, statement.span
    .Evaluate(expression) => {
      const _ = lowerExpression lowering, builder, expression, destination: None
    }
  }
}

// --- Bindings and assignment ----------------------------------------------------------------------------------------

/** `const x = e`, `var x = e`: one local slot, and the value is computed straight into it. */
fn lowerBinding(var lowering: Lowering, var builder: FunctionBuilder, binding: Binding, at: Span) {
  const pattern = binding.pattern
  if isWildcardPattern(pattern) {
    const _ = lowerValue lowering, builder, binding.value
    return
  }
  // `const (line, column) = pair`, `const Point(x, y) = point`: one `Read` per name, along the paths of the plan
  const name = match bindingNameOf(pattern) {
    Some(found) => found
    None => {
      const source = lowerValue lowering, builder, binding.value
      if !lowering.supported {
        return
      }
      const first = builder.slotCount()
      lowerPatternBinding lowering, builder, pattern, source, pattern.span
      declareScopedFrom lowering, builder, first
      return
    }
  }
  const declared = pattern.span
  const annotation = match bindingTypeOf(lowering, declared) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a binding without a type", declared
      return
    }
  }
  // A `var` binding some closure captures is a shared box, not a slot: from here on it is a place (docs/TYPECHECKER.md,
  // A captured `var` binding is a reference that escapes)
  if isCapturedVariable(lowering, declared) {
    lowerBoxedBinding lowering, builder, declared, name, annotation, binding.value
    if const Some(box) = lowering.boxes.get(declared) {
      declareScoped lowering, builder, box
    }
    return
  }
  const slot = addLocal builder, annotation, name
  const _ = lowerExpression lowering, builder, binding.value, slot
  lowering.slots.set declared, slot
  declareScoped lowering, builder, slot
}

fn bindingNameOf(pattern: Pattern): String? {
  if const .Binding(name) = pattern.kind {
    if name == "_" {
      return None
    }
    return name
  }
  None
}

fn isWildcardPattern(pattern: Pattern): Bool {
  match pattern.kind {
    .Wildcard => true
    .Binding(name) => name == "_"
    _ => false
  }
}

/**
 * The type of what a binding binds. A binding of a *body* has a pattern type; a top-level binding of a module is
 * checked through its declaration instead and has none, so the declared result of its symbol stands in - which is the
 * same answer the const evaluator reads for a `const` of an imported module.
 */
fn bindingTypeOf(var lowering: Lowering, at: Span): IrTypeId? {
  if const Some(found) = patternTypeOf(lowering, at) {
    return found
  }
  const module = lowering.module
  const symbol = lowering.checker.resolvedName(module, at)?
  const declared = resultOf lowering.checker, symbol
  if lowering.checker.isBroken(declared) {
    return None
  }
  irTypeOf lowering, declared
}

fn patternTypeOf(var lowering: Lowering, at: Span): IrTypeId? {
  const module = lowering.module
  const found = lowering.checker.patternType(module, at)?
  if lowering.checker.isBroken(found) {
    return None
  }
  irTypeOf lowering, found
}

/**
 * `x = e`: a plain local, whose value is computed straight into its slot. Everything that is a **path** - a field, a
 * field of a field, a field of a `var` parameter, and a `var` parameter itself - is a `Write` through the place the
 * checker recorded (`lower/place.trb`), because a write releases what was there and an assignment into a pointer's slot
 * would not.
 */
fn lowerAssignment(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  target: Expression,
  value: Expression,
  at: Span,
) {
  const module = lowering.module
  const resolution = match lowering.checker.resolutionAt(module, target.span) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "an assignment the checker did not resolve", at
      return
    }
  }
  const binding = match resolution {
    .Local(found) => found
    // A top-level `var` of the entry file: a local of the entry function, so an assignment to it is an ordinary one
    .Constant(symbol, _) => {
      const found = match lowering.entryLocals.get(symbol.value) {
        Some(slot) => slot
        None => {
          reportUnsupported lowering, "an assignment to a top-level `var` from a function", at
          return
        }
      }
      assignedInto lowering, builder, found, value
      return
    }
    _ => {
      lowerPlaceAssignment lowering, builder, target, value
      return
    }
  }
  const declared = lowering.checker.binding(binding).at
  // The slot of a `for var` is `container[key]` of the turn, so assigning it is `MutableIndex.set`
  if lowering.slotAliases.containsKey(declared) {
    lowerPlaceAssignment lowering, builder, target, value
    return
  }
  // `_ = value` where the closure's parameter is `var`: a pointer into the caller's place, which the path finds by the
  // position its use names, because the checker declares every implicit parameter under the span of its closure
  if implicitParameterOf(lowering, target.span).isSome() && lowering.closureAt == declared {
    lowerPlaceAssignment lowering, builder, target, value
    return
  }
  // A captured `var` binding is a shared box, so an assignment to it writes through that box and both sides see it
  if const Some(place) = bindingReferenceOf(lowering, builder, declared) {
    const slot = lowerValue lowering, builder, value
    if !lowering.supported {
      return
    }
    emit builder, Instruction.Write(place, borrowed(slot))
    return
  }
  const slot = match lowering.slots.get(declared) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "an assignment to a captured binding", at
      return
    }
  }
  // A `var` parameter holds a pointer into the caller's frame: assigning through one has to release what the caller had
  if isReferenceSlot(builder, slot) {
    lowerPlaceAssignment lowering, builder, target, value
    return
  }
  assignedInto lowering, builder, slot, value
}

/**
 * The value of an assignment, into the slot the target names. A **counted** local is written *through* rather than
 * stored into, because a write releases what was there first and a store would leak it - exactly what a plain copy
 * between two counted locals would get wrong.
 */
fn assignedInto(var lowering: Lowering, var builder: FunctionBuilder, slot: Slot, value: Expression) {
  const annotation = builder.typeOfSlot slot
  if containsCountedType(lowering.program, annotation) {
    lowerSlotAssignment lowering, builder, slot, value
    return
  }
  const _ = lowerExpression lowering, builder, value, slot
}

// --- `return`, `break`, `continue` ----------------------------------------------------------------------------------

fn lowerReturn(var lowering: Lowering, var builder: FunctionBuilder, value: Expression?, at: Span) {
  const result = builder.function.signature.result
  const expression = match value {
    Some(found) => found
    None => {
      endEveryScope lowering, builder
      finishBlock lowering, builder, Terminator.Return(None)
      return
    }
  }
  if isVoidType(lowering, result) {
    // `return Void` in a function that produces nothing: the value is evaluated and thrown away
    const _ = lowerValue lowering, builder, expression
    endEveryScope lowering, builder
    finishBlock lowering, builder, Terminator.Return(None)
    return
  }
  const slot = lowerValue lowering, builder, expression
  if !lowering.supported {
    return
  }
  // The value is produced before the scopes end, so a binding that is returned is moved out and not released
  endEveryScope lowering, builder
  finishBlock lowering, builder, Terminator.Return(borrowed(slot))
}

fn lowerBreak(var lowering: Lowering, var builder: FunctionBuilder, at: Span) {
  const target = match breakTarget(lowering) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`break` outside of a loop", at
      return
    }
  }
  markBreak lowering
  endLoopScopes lowering, builder
  finishBlock lowering, builder, Terminator.Jump(target)
}

fn lowerContinue(var lowering: Lowering, var builder: FunctionBuilder, at: Span) {
  const target = match continueTarget(lowering) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`continue` outside of a loop", at
      return
    }
  }
  endLoopScopes lowering, builder
  finishBlock lowering, builder, Terminator.Jump(target)
}

// --- `while` --------------------------------------------------------------------------------------------------------

/** `while c { ... }`: the condition is a block of its own, because the back edge jumps to it. */
fn lowerWhile(var lowering: Lowering, var builder: FunctionBuilder, condition: Condition, body: Block, at: Span) {
  const test = match condition {
    .Test(inner) => inner
    .Bind(isVar, pattern, value) => {
      lowerWhileBinding lowering, builder, isVar, pattern, value, body, at
      return
    }
  }
  const location = locationOf lowering, at
  const check = addBlock builder, "while", location
  const inner = addBlock builder, "body", location
  const done = addBlock builder, "done", location
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, check
  const scrutinee = lowerValue lowering, builder, test
  if !lowering.supported {
    return
  }
  finishBlock lowering, builder, Terminator.Branch(scrutinee, inner, done)
  continueIn lowering, builder, inner
  enterLoop lowering, done, check
  lowerBlockInto lowering, builder, body, destination: None
  const _ = leaveLoop lowering
  if !lowering.diverged {
    finishBlock lowering, builder, Terminator.Jump(check)
  }
  continueIn lowering, builder, done
}

/**
 * `loop { ... }`: one block that jumps back to itself, with no condition to evaluate. Without a `break` nothing after
 * it is reachable - and the block after it stays an empty `unreachable` marker.
 */
fn lowerLoop(var lowering: Lowering, var builder: FunctionBuilder, body: Block, at: Span) {
  const location = locationOf lowering, at
  const inner = addBlock builder, "loop", location
  const done = addBlock builder, "done", location
  finishBlock lowering, builder, Terminator.Jump(inner)
  continueIn lowering, builder, inner
  enterLoop lowering, done, inner
  lowerBlockInto lowering, builder, body, destination: None
  const broke = leaveLoop lowering
  if !lowering.diverged {
    finishBlock lowering, builder, Terminator.Jump(inner)
  }
  continueIn lowering, builder, done
  if !broke {
    lowering.diverged = true
  }
}

// --- `for` over a range ---------------------------------------------------------------------------------------------

/**
 * `for index in 0..count`: a counter, a comparison and an increment. Both ends are evaluated once, in source order,
 * into slots of their own - a `for` evaluates its subject once (docs/TYPECHECKER.md, Does `for` over a `var` path
 * iterate the original or a copy?), and the end must not change with the body.
 *
 * Everything else - a collection, a pipeline, an inclusive range, a range without both ends - goes through
 * `Iterate.iterate()` and the `Option` that `next()` answers (`lowerForIterate`).
 */
/** The two ends of a range that is written out. Everything else is iterated through its `Iterate`. */
fn rangeEndsOf(iterable: Expression): (Expression, Expression)? {
  const (from, to, isInclusive) = match iterable.kind {
    .RangeLiteral(first, second, inclusive) => (first, second, inclusive)
    _ => {
      return None
    }
  }
  if isInclusive {
    return None
  }
  const start = from?
  const end = to?
  (start, end)
}

fn lowerFor(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  pattern: Pattern,
  iterable: Expression,
  body: Block,
  at: Span,
) {
  const (start, end) = match rangeEndsOf(iterable) {
    Some(found) => found
    None => {
      lowerForIterate lowering, builder, pattern, iterable, body, at
      return
    }
  }
  const item = match patternTypeOf(lowering, pattern.span) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`for` over a range without an item type", at
      return
    }
  }
  const kind = match numericKindOf(lowering.program, item) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`for` over a range of something that is not a number", at
      return
    }
  }
  const name = bindingNameOf(pattern) ?? ""
  // A pattern that takes the item apart binds in the body, through the plan the checker recorded for it
  const takesApart = !isWildcardPattern(pattern) && name.isEmpty()
  const counter = addLocal builder, item, name
  const _ = lowerExpression lowering, builder, start, counter
  const limit = addTemporary builder, item
  const _ = lowerExpression lowering, builder, end, limit
  if !lowering.supported {
    return
  }
  if !name.isEmpty() {
    lowering.slots.set pattern.span, counter
  }
  const location = locationOf lowering, at
  const check = addBlock builder, "for", location
  const inner = addBlock builder, "body", location
  const step = addBlock builder, "step", location
  const done = addBlock builder, "done", location
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, check
  const boolean = booleanTypeOf lowering
  const scrutinee = addTemporary builder, boolean
  emitIntrinsic lowering, builder, scrutinee, IntrinsicOperation.Less, kind, [counter, limit], at
  finishBlock lowering, builder, Terminator.Branch(scrutinee, inner, done)
  continueIn lowering, builder, inner
  enterLoop lowering, done, step
  // The counter is a binding of the body, which a debugger shows there and nowhere else
  openVisible lowering
  if takesApart {
    const first = builder.slotCount()
    lowerPatternBinding lowering, builder, pattern, counter, pattern.span
    for index in first..builder.slotCount() {
      declareVisible lowering, builder, Slot(index)
    }
  } else {
    declareVisible lowering, builder, counter
  }
  lowerBlockInto lowering, builder, body, destination: None
  closeVisible lowering, builder
  const _ = leaveLoop lowering
  if !lowering.diverged {
    finishBlock lowering, builder, Terminator.Jump(step)
  }
  continueIn lowering, builder, step
  const one = integerSlot lowering, builder, 1, item
  emitIntrinsic lowering, builder, counter, IntrinsicOperation.Add, kind, [counter, one], at
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, done
}

// --- `for` over a collection ----------------------------------------------------------------------------------------

/**
 * `for value in values`: the subject once into a slot of its own, `Iterate.iterate()` on it, and a loop whose head
 * pulls `next()` from the cursor and switches on the `Option` that comes back (BACKEND 1.6).
 *
 * Three properties make it correct, and not one of them is a rule of the `for`:
 *
 * - **The cursor is a `var` local of this frame.** `Iterator.next()` changes it, so the receiver is a
 *   `Reference` and goes through the ordinary place machinery - which for a trait-typed cursor is what makes its payload
 *   box unique before the write (5.7's note).
 * - **The cursor holds the subject by value.** `ListIterator` keeps the list, so changing the collection inside the body
 *   does not change what the loop walks. That is what a value *is*, and nothing here has to arrange it.
 * - **The subject is evaluated exactly once** (docs/TYPECHECKER.md, Does `for` over a `var` path iterate the
 *   original or a copy?), which is what putting it into a slot before the loop says.
 *
 * `continue` jumps to the head, where the next value is pulled; `break` leaves to the block after it. So neither needs a
 * step block of its own, unlike the counter of a range.
 */
fn lowerForIterate(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  pattern: Pattern,
  iterable: Expression,
  body: Block,
  at: Span,
) {
  const module = lowering.module
  const written = match lowering.checker.expressionType(module, iterable.span) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`for` over a subject the checker recorded no type for", at
      return
    }
  }
  const subjectType = substituted lowering, written
  const iterateBound = match iterateBoundOf(lowering, subjectType, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const subject = lowerValue lowering, builder, iterable
  if !lowering.supported {
    return
  }
  const plan = match pullPlanOf(lowering, builder, subject, subjectType, iterateBound, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const cursor = plan.cursor
  const pull = plan.pull
  const option = plan.option
  const layout = plan.layout
  const some = plan.some
  const item = match patternTypeOf(lowering, pattern.span) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`for` over a collection without an item type", at
      return
    }
  }
  const name = bindingNameOf(pattern) ?? ""
  // A pattern that takes the item apart binds in the body, through the plan the checker recorded for it
  const takesApart = !isWildcardPattern(pattern) && name.isEmpty()
  const value = addLocal builder, item, name
  if !name.isEmpty() {
    lowering.slots.set pattern.span, value
  }
  const location = locationOf lowering, at
  const check = addBlock builder, "for", location
  const inner = addBlock builder, "body", location
  const done = addBlock builder, "done", location
  const pulled = addTemporary builder, option
  const integer = lowering.program.internType IrType.Integer(64, signed: true)
  const tag = addTemporary builder, integer
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, check
  const places = [Some(Reference(cursor.slot, []))]
  const _ = lowerDispatched lowering, builder, pulled, at, pull, [cursor.slot], places, option
  if !lowering.supported {
    return
  }
  emit builder, Instruction.Tag(tag, pulled)
  finishBlock lowering, builder, Terminator.Switch(tag, [some], [inner], done)
  continueIn lowering, builder, inner
  emit builder, Instruction.Read(value, Reference(pulled, [PathStep.Variant(layout, some, 0)]))
  enterLoop lowering, done, check
  // The item is bound again every round, so every round ends it - and a `break` or a `continue` does too
  openScope lowering
  const firstSlot = builder.slotCount()
  if takesApart {
    lowerPatternBinding lowering, builder, pattern, value, pattern.span
  }
  declareScoped lowering, builder, value
  declareScopedFrom lowering, builder, firstSlot
  lowerBlockInto lowering, builder, body, destination: None
  closeScope lowering, builder
  const _ = leaveLoop lowering
  if !lowering.diverged {
    finishBlock lowering, builder, Terminator.Jump(check)
  }
  continueIn lowering, builder, done
}

/**
 * What a loop pulls its items with: the cursor `iterate()` made of the subject, the `next` dispatched on it, and the
 * `Option` that `next` answers - its IR type, its layout and the position of `Some` in it. `None` where one of them
 * cannot be formed, which has been reported.
 */
fn pullPlanOf(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  subject: Slot,
  subjectType: TypeId,
  iterateBound: TypeId,
  at: Span,
): PullPlan? {
  const cursor = lowerCursor(lowering, builder, subject, subjectType, iterateBound, at)?
  const iteratorBound = iteratorBoundOf(lowering, cursor.type, at)?
  const pull = dispatchedOn(lowering, cursor.type, iteratorBound, "next", at)?
  const optionType = resultTypeOf lowering, pull
  if !isClosedType(lowering, optionType) {
    reportUnsupported lowering, "`for` whose item type the back end cannot close", at
    return None
  }
  const option = irTypeOfClosed lowering, optionType
  const layout = match variantLayoutOfType(lowering, option) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`for` over an iterator whose `next` does not answer an `Option`", at
      return None
    }
  }
  const some = variantNamed lowering, layout, "Some"
  if some < 0 {
    reportUnsupported lowering, "`for` over an iterator whose `next` does not answer an `Option`", at
    return None
  }
  PullPlan cursor, pull, option, layout, some
}

/** The parts of [pullPlanOf]. */
type PullPlan {
  cursor: Cursor
  pull: Dispatched
  option: IrTypeId
  layout: LayoutId
  /** Which variant of the `Option` is `Some`. */
  some: Int
}

// --- `for var` ------------------------------------------------------------------------------------------------------

/**
 * `for var particle in particles`, `for (name, var count) in stock`: every slot of a container in place
 * (docs/design/COLLECTIONS.md section 3.11).
 *
 * The container's path is evaluated once - its root and the key of every `a[key]` on it - and so are its keys. In a
 * turn the slot is no binding of the frame but the path `container[key]` ([SlotAlias]), which every use of the name
 * continues: a read takes the element out with `Index.at`, a change puts it back with `MutableIndex.set` in the same
 * statement. That round trip is the one `ir/elements.trb` turns into a single `Element` step where the container is the
 * runtime's own list or an array, so the loop holds no copy of an element there - and everywhere, `break`, `continue`,
 * `return` and `?` leave nothing to write back, because every change was written where it happened.
 *
 * The keys of a `List` and an `Array` are its indices, `0..length()`, walked as a counter ([lowerSlotIndices]) without
 * an iterator; every other container answers `MutableIndex.keys()`, pulled like the items of any `Iterate`
 * ([lowerSlotKeys]). The checker's rule 2 is what makes both sound: nothing in the body reaches the container except
 * through the slot, so nothing grows, shrinks or rehashes it under the loop.
 */
fn lowerForSlots(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  pattern: Pattern,
  iterable: Expression,
  body: Block,
  at: Span,
) {
  const what = "`for var`"
  const module = lowering.module
  const written = match lowering.checker.expressionType(module, iterable.span) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`for var` over a container the checker recorded no type for", at
      return
    }
  }
  var keyPattern: Pattern? = None
  var slotPattern = pattern
  if const .TuplePattern(items) = pattern.kind {
    if items.length() == 2 {
      keyPattern = items[0]
      slotPattern = items[1]
    }
  }
  const prelude = match pathPreludeAt(lowering, builder, iterable, what) {
    Some(found) => found
    None => {
      return
    }
  }
  // The container once, for its keys: reading a path takes nothing out for good
  const container = match referenceFrom(lowering, builder, prelude, what, iterable.span) {
    Some(found) => found
    None => {
      return
    }
  }
  const receiver = addTemporary builder, container.type
  emit builder, Instruction.Read(receiver, container.reference)
  const turn = SlotTurn prelude, written, keyPattern, slotPattern, body, at
  if walksIndices(lowering, written, container.type) {
    lowerSlotIndices lowering, builder, turn, receiver
  } else {
    lowerSlotKeys lowering, builder, turn, receiver
  }
}

/** What every turn of a `for var` needs, whichever way its keys are walked. */
type SlotTurn {
  /** The container's path, evaluated before the loop. */
  prelude: PathPrelude
  /** The container's type as the checker wrote it. */
  container: TypeId
  keyPattern: Pattern?
  slotPattern: Pattern
  body: Block
  at: Span
}

/**
 * Whether the keys of a container are its indices `0..length()`: a `List` - the contract of `List.keys()` - and an
 * `Array<Item, Size>`.
 */
fn walksIndices(var lowering: Lowering, written: TypeId, annotation: IrTypeId): Bool {
  if const .FixedArray(_, _) = lowering.program.typeAt(annotation) {
    return true
  }
  const list = match lowering.checker.wellKnown.list {
    Some(found) => found
    None => {
      return false
    }
  }
  traitArgumentsOf(lowering.checker, substituted(lowering, written), list).isSome()
}

/**
 * The keys of a `List` or an `Array` as a counter: `length()` once, then a comparison and an increment per turn -
 * the loop of a written range, with no iterator. `continue` goes to the increment.
 */
fn lowerSlotIndices(var lowering: Lowering, var builder: FunctionBuilder, turn: SlotTurn, receiver: Slot) {
  const at = turn.at
  const containerType = substituted lowering, turn.container
  const measure = match lengthOf(lowering, containerType, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const integer = lowering.program.internType IrType.Integer(64, signed: true)
  const kind = match numericKindOf(lowering.program, integer) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`for var` without an integer type", at
      return
    }
  }
  const limit = addTemporary builder, integer
  const noPlaces: List<Reference?> = []
  const _ = lowerDispatched lowering, builder, limit, at, measure, [receiver], noPlaces, integer
  if !lowering.supported {
    return
  }
  const key = addLocal builder, integer, keyNameOf(turn.keyPattern, "index")
  const zero = integerSlot lowering, builder, 0, integer
  emit builder, Instruction.Copy(key, zero)
  const location = locationOf lowering, at
  const check = addBlock builder, "for", location
  const inner = addBlock builder, "body", location
  const step = addBlock builder, "step", location
  const done = addBlock builder, "done", location
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, check
  const boolean = booleanTypeOf lowering
  const scrutinee = addTemporary builder, boolean
  emitIntrinsic lowering, builder, scrutinee, IntrinsicOperation.Less, kind, [key, limit], at
  finishBlock lowering, builder, Terminator.Branch(scrutinee, inner, done)
  continueIn lowering, builder, inner
  enterLoop lowering, done, step
  lowerSlotTurn lowering, builder, turn, key
  const _ = leaveLoop lowering
  if !lowering.diverged {
    finishBlock lowering, builder, Terminator.Jump(step)
  }
  continueIn lowering, builder, step
  const one = integerSlot lowering, builder, 1, integer
  emitIntrinsic lowering, builder, key, IntrinsicOperation.Add, kind, [key, one], at
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, done
}

/** `Length.length` of a container's own type, or the `length` of its `List` where that trait declares one itself. */
fn lengthOf(var lowering: Lowering, container: TypeId, at: Span): Dispatched? {
  const empty: List<TypeId> = []
  if const Some(symbol) = lowering.checker.wellKnown.symbolNamed("Length") {
    if traitArgumentsOf(lowering.checker, container, symbol).isSome() {
      return dispatchedOn lowering, container, lowering.checker.nominal(symbol, empty), "length", at
    }
  }
  const list = match lowering.checker.wellKnown.list {
    Some(found) => found
    None => {
      reportUnsupported lowering, "`for var` over a container without `length`", at
      return None
    }
  }
  const arguments = traitArgumentsOf(lowering.checker, container, list) ?? empty
  dispatchedOn lowering, container, lowering.checker.nominal(list, arguments), "length", at
}

/**
 * The keys of every other container: `MutableIndex.keys()` once, then `next()` of its cursor per turn, exactly as a
 * `for` pulls the items of an `Iterate`. `continue` goes to the pull.
 */
fn lowerSlotKeys(var lowering: Lowering, var builder: FunctionBuilder, turn: SlotTurn, receiver: Slot) {
  const at = turn.at
  const what = "`for var`"
  const containerType = substituted lowering, turn.container
  const keysMember = match indexedMemberOf(lowering, containerType, isMutable: true, name: "keys", what: what, at: at) {
    Some(found) => found
    None => {
      return
    }
  }
  const keysType = resultTypeOf lowering, keysMember
  if !isClosedType(lowering, keysType) {
    reportUnsupported lowering, "`for var` whose keys the back end cannot close", at
    return
  }
  const keysSpelling = irTypeOfClosed lowering, keysType
  const keys = addTemporary builder, keysSpelling
  const noPlaces: List<Reference?> = []
  const _ = lowerDispatched lowering, builder, keys, at, keysMember, [receiver], noPlaces, keysSpelling
  if !lowering.supported {
    return
  }
  const iterateBound = match iterateBoundOf(lowering, keysType, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const plan = match pullPlanOf(lowering, builder, keys, keysType, iterateBound, at) {
    Some(found) => found
    None => {
      return
    }
  }
  const keyItem = lowering.program.layoutAt(plan.layout).fieldsOfVariant(plan.some)[0].type
  const key = addLocal builder, keyItem, keyNameOf(turn.keyPattern, "key")
  const location = locationOf lowering, at
  const check = addBlock builder, "for", location
  const inner = addBlock builder, "body", location
  const done = addBlock builder, "done", location
  const pulled = addTemporary builder, plan.option
  const integer = lowering.program.internType IrType.Integer(64, signed: true)
  const tag = addTemporary builder, integer
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, check
  const places = [Some(Reference(plan.cursor.slot, []))]
  const _ = lowerDispatched lowering, builder, pulled, at, plan.pull, [plan.cursor.slot], places, plan.option
  if !lowering.supported {
    return
  }
  emit builder, Instruction.Tag(tag, pulled)
  finishBlock lowering, builder, Terminator.Switch(tag, [plan.some], [inner], done)
  continueIn lowering, builder, inner
  emit builder, Instruction.Read(key, Reference(pulled, [PathStep.Variant(plan.layout, plan.some, 0)]))
  enterLoop lowering, done, check
  lowerSlotTurn lowering, builder, turn, key
  const _ = leaveLoop lowering
  if !lowering.diverged {
    finishBlock lowering, builder, Terminator.Jump(check)
  }
  continueIn lowering, builder, done
}

/** What a debugger and the IR call the key of a turn: the name the pattern gives it, or `fallback`. */
fn keyNameOf(keyPattern: Pattern?, fallback: String): String {
  match keyPattern {
    Some(found) => bindingNameOf(found) ?? fallback
    None => fallback
  }
}

/**
 * One turn: the key bound as the pattern says - a copy, like the item of every `for` - and the slot as the path
 * `container[key]` for as long as the body runs.
 */
fn lowerSlotTurn(var lowering: Lowering, var builder: FunctionBuilder, turn: SlotTurn, key: Slot) {
  openScope lowering
  const firstSlot = builder.slotCount()
  if const Some(found) = turn.keyPattern {
    if const Some(_) = bindingNameOf(found) {
      lowering.slots.set found.span, key
    } else if !isWildcardPattern(found) {
      lowerPatternBinding lowering, builder, found, key, found.span
    }
  }
  declareScoped lowering, builder, key
  declareScopedFrom lowering, builder, firstSlot
  var steps = turn.prelude.steps
  steps.append PlaceStep.Index(turn.container, turn.at, "")
  var keys = turn.prelude.keys
  keys.append key
  const root = turn.prelude.root
  lowering.slotAliases.set turn.slotPattern.span, SlotAlias(root.reference, root.type, steps, keys)
  lowerBlockInto lowering, builder, turn.body, destination: None
  const _ = lowering.slotAliases.remove turn.slotPattern.span
  closeScope lowering, builder
}

/** The cursor a loop pulls from: `xs.iterate()`, with the type it answered, which is what `next` is dispatched on. */
fn lowerCursor(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  subject: Slot,
  subjectType: TypeId,
  iterateBound: TypeId,
  at: Span,
): Cursor? {
  const made = match dispatchedOn(lowering, subjectType, iterateBound, "iterate", at) {
    Some(found) => found
    None => {
      return None
    }
  }
  const annotation = resultTypeOf lowering, made
  if !isClosedType(lowering, annotation) {
    reportUnsupported lowering, "`for` whose iterator type the back end cannot close", at
    return None
  }
  const spelling = irTypeOfClosed lowering, annotation
  const slot = addLocal builder, spelling, "iterator"
  const places: List<Reference?> = []
  const _ = lowerDispatched lowering, builder, slot, at, made, [subject], places, spelling
  if !lowering.supported {
    return None
  }
  Cursor slot, annotation
}

/** The slot a cursor lives in, and its checker type. */
type Cursor {
  slot: Slot
  type: TypeId
}
