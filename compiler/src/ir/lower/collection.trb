/**
 * `[1, 2, 3]` and `["a": 1]`: the two container literals of the language.
 *
 * The **type of a literal is a trait-typed value.** The checker gives `[1, 2, 3]` the type `List<Int>`, which in a type
 * position is `Traits([List<Int>])` and therefore an `Object` of the IR (5.6's note) - it does *not* name the
 * implementation. So a literal is three things in a row: build the default implementation empty over the element
 * descriptors of its type arguments (`ContainerNew`), fill it through the ordinary `add`/`set` of that implementation,
 * and coerce the result to the trait-typed value the literal's type is.
 *
 * Which implementation is the default is written in `std/collections`: `List.from` answers an `ArrayList` and `Map.from`
 * a `TrieMap`. The lowering has to know the same thing, because a literal is not a call of `from` - and a wrong answer
 * would be a *different container* and not a slower one, so it is asked of the prelude by name and is a clean finding
 * where the name is not there.
 */

use Span from "../../syntax/source"
use Expression, Argument from "../../syntax/ast"
use SymbolId from "../../semantics/symbols"
use TypeId from "../../semantics/checker/type"
use Adaptation from "../../semantics/checker/context"
use IrTypeId, IrType, Slot, ElementId, RuntimeKind, Instruction, Reference, FunctionId from "../ir"
use LayoutId, PathStep, Terminator from "../ir"
use borrowed, referenced from "../ir"
use FunctionBuilder, addTemporary, addLocal, addBlock, emit from "../build"
use elementFor from "../element"
use memberOfType from "../witness"
use traitArgumentsOf from "../../semantics/checker/implementation"
use locationOf from "./context"
use Lowering, reportUnsupported, irTypeOfClosed, substituted, voidTypeOf from "./context"
use finishBlock, continueIn from "./context"
use isClosedType from "../instances"
use variantLayoutOfType, variantNamed from "./match"
use valueSlot, unsupportedSlot, abandonedSlot from "./expression"
use lowerValue from "./expression"
use lowerTraitValue, dispatchedMember, dispatchedOn, resultTypeOf, preludeType from "./generic"
use lowerDispatched from "./call"

/** `[1, 2, 3]`: an `ArrayList<Item>` filled in written order, then coerced to the `List<Item>` the literal is. */
public fn lowerListLiteral(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  items: List<Argument>,
  annotation: IrTypeId,
): Slot {
  const at = expression.span
  if !isDefaultLiteral(lowering, at) {
    return abandonedSlot lowering, builder, destination
  }
  const bounds = boundsOfLiteral lowering, expression
  const bound = match bounds.first() {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a list literal of a type that is not a `List`", at
    }
  }
  const arguments = traitArgumentsOfBound lowering, bound
  const item = match arguments.first() {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a list literal without an item type", at
    }
  }
  lowerItemList lowering, builder, destination, items, item, bounds, annotation, at
}

/**
 * The `List<Item>` that a literal and a **variadic argument list** are both made of: an `ArrayList<Item>` built empty over
 * the element descriptor of its item type, filled in written order through the ordinary `add` - and through `addAll` for a
 * `...spread` - and coerced to the trait-typed value a `List<Item>` is.
 *
 * `bounds` is what the result is boxed with: the bounds of the literal's own type, or `[List<Item>]` for a variadic
 * parameter, whose declared type is what the body sees.
 */
public fn lowerItemList(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  items: List<Argument>,
  item: TypeId,
  bounds: List<TypeId>,
  annotation: IrTypeId,
  at: Span,
): Slot {
  const bound = match bounds.first() {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a list of a type that is not a `List`", at
    }
  }
  const container = match implementationOf(lowering, "ArrayList", [item], at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const element = match elementFor(lowering, item, false, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const storage = addTemporary builder, irTypeOfClosed(lowering, container)
  emit builder, Instruction.ContainerNew(storage, RuntimeKind.ListStorage, [element])
  const adder = match memberOfType(lowering, container, bound, "add", at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  for written in items {
    if written.isSpread {
      if !spreadInto(lowering, builder, storage, adder, written.value) {
        return abandonedSlot lowering, builder, destination
      }
      continue
    }
    const value = lowerValue lowering, builder, written.value
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
    addInto lowering, builder, adder, storage, [value], written.value.span
  }
  coerced lowering, builder, destination, storage, bounds, container, annotation, at
}

/**
 * `...values` in a list or in a variadic argument list: **one `add` per item**, which is what `Collection.addAll` means.
 *
 * It is written out here rather than called, and the reason is the fourth round's decision about the tables: a default no
 * implementation overrides has **one** instance with `Self` bound to the *trait type*, so `Collection.addAll` takes an
 * `Object(List<Item>)` place - and what is being filled here is the concrete buffer the literal builds. Boxing the buffer
 * to call it would hand the callee a box of its own and the items would never reach this slot.
 *
 * So the spread is the loop BACKEND 1.6 describes for a `for`: the subject once into a slot, `iterator()` on it, and a
 * head that pulls `next()` from a `var` local and switches on the `Option` - which is also why a spread of a *pipeline*
 * works and not only one of a list.
 */
fn spreadInto(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  storage: Slot,
  adder: FunctionId,
  value: Expression,
): Bool {
  const at = value.span
  const module = lowering.module
  const written = match lowering.checker.expressionType(module, at) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a `...` whose value the checker recorded no type for", at
      return false
    }
  }
  const subject = substituted lowering, written
  const iterableBound = match iterableBoundOf(lowering, subject, at) {
    Some(found) => found
    None => {
      return false
    }
  }
  const source = lowerValue lowering, builder, value
  if !lowering.isSupported {
    return false
  }
  const made = match dispatchedOn(lowering, subject, iterableBound, "iterator", at) {
    Some(found) => found
    None => {
      return false
    }
  }
  const cursorType = resultTypeOf lowering, made
  if !isClosedType(lowering, cursorType) {
    reportUnsupported lowering, "a `...` whose iterator type the back end cannot close", at
    return false
  }
  const cursorSpelling = irTypeOfClosed lowering, cursorType
  const cursor = addLocal builder, cursorSpelling, "spread"
  const noPlaces: List<Reference?> = []
  const _ = lowerDispatched lowering, builder, Some(cursor), at, made, [source], noPlaces, cursorSpelling
  if !lowering.isSupported {
    return false
  }
  const iteratorBound = match iteratorBoundOf(lowering, cursorType, at) {
    Some(found) => found
    None => {
      return false
    }
  }
  const pull = match dispatchedOn(lowering, cursorType, iteratorBound, "next", at) {
    Some(found) => found
    None => {
      return false
    }
  }
  const optionType = resultTypeOf lowering, pull
  if !isClosedType(lowering, optionType) {
    reportUnsupported lowering, "a `...` whose item type the back end cannot close", at
    return false
  }
  const option = irTypeOfClosed lowering, optionType
  const layout = match variantLayoutOfType(lowering, option) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a `...` over an iterator whose `next` does not answer an `Option`", at
      return false
    }
  }
  const some = variantNamed lowering, layout, "Some"
  if some < 0 {
    reportUnsupported lowering, "a `...` over an iterator whose `next` does not answer an `Option`", at
    return false
  }
  const payload = payloadTypeOf lowering, layout, some
  const location = locationOf lowering, at
  const check = addBlock builder, "spread", Some(location)
  const inner = addBlock builder, "add", Some(location)
  const done = addBlock builder, "spread done", Some(location)
  const pulled = addTemporary builder, option
  const integer = lowering.program.internType IrType.Integer(64, true)
  const tag = addTemporary builder, integer
  const held = addTemporary builder, payload
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, check
  const places = [Some(Reference(cursor, []))]
  const _ = lowerDispatched lowering, builder, Some(pulled), at, pull, [cursor], places, option
  if !lowering.isSupported {
    return false
  }
  emit builder, Instruction.Tag(tag, pulled)
  finishBlock lowering, builder, Terminator.Switch(tag, [some], [inner], done)
  continueIn lowering, builder, inner
  emit builder, Instruction.Read(held, Reference(pulled, [PathStep.Variant(layout, some, 0)]))
  addInto lowering, builder, adder, storage, [held], at
  finishBlock lowering, builder, Terminator.Jump(check)
  continueIn lowering, builder, done
  lowering.isSupported
}

/** The type the successful case of the `Option` an iterator answers carries. */
fn payloadTypeOf(var lowering: Lowering, layout: LayoutId, variant: Int): IrTypeId {
  const shape = lowering.program.layoutAt layout
  const fields = shape.fieldsOfVariant variant
  match fields.first() {
    Some(found) => found.annotation
    None => voidTypeOf lowering
  }
}

/** `List<Item>` of the prelude, applied to one item type: what a variadic parameter holds. */
public fn listBoundFor(var lowering: Lowering, item: TypeId, at: Span): TypeId? {
  const symbol = match lowering.checker.wellKnown.list {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a variadic parameter without `List` in the prelude", at
      return None
    }
  }
  Some lowering.checker.nominal(symbol, [item])
}

/**
 * Whether a literal is built **directly** as the collection its own type names, which is `CollectionLiteral.Default`
 * and the only one of the three shapes the lowering translates today. The checker decided which of the three it is
 * (docs/TYPECHECKER.md, What does a collection literal become, and which types may one adapt to?) and recorded it at
 * the literal's span, so the back end reads that decision instead of asking the expected type a second time and
 * answering it differently.
 *
 * - **`InlineArray`** writes the items straight into the inline slots of an `Array<Item, Size>`. That is a
 *   `FixedArray`, and filling one this way is not lowered yet, together with its interior paths.
 * - **`FromIterable`** builds the default list and hands it to the `from` of the target (`Set<String>`, `Queue<Int>`).
 *   The `from` to call is `memberOfImplementation` of the `witness` the checker recorded, so the *call* is ordinary - but
 *   every one of those bottoms out in `TrieSet.from` or `ArrayQueue.from`, which are the same `.Planned` natives as
 *   `ArrayList.from` and cannot be functions of the runtime at all (they walk an `Iterable` of the program). So it waits
 *   for exactly the step `ArrayList.from` waits for, and naming the target is more use than half a chain.
 */
fn isDefaultLiteral(var lowering: Lowering, at: Span): Bool {
  const module = lowering.module
  const found = match lowering.checker.collectionLiteralAt(module, at) {
    Some(inner) => inner
    None => {
      // A literal whose target the checker never decided is a program it reported on itself
      return true
    }
  }
  match found {
    .Default => true
    .InlineArray(_, size) => {
      reportUnsupported lowering, "a literal that fills an `Array` of {size} items (milestone 5.9b)", at
      false
    }
    .FromIterable(target, _, _) => {
      const shown = lowering.checker.describe target
      reportUnsupported lowering, "a literal that is built through the `from` of `{shown}`", at
      false
    }
  }
}

/** `["a": 1]`: a `TrieMap<Key, Value>` filled in written order, then coerced to the `Map<Key, Value>` the literal is. */
public fn lowerMapLiteral(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  entries: List<(Expression, Expression)>,
  annotation: IrTypeId,
): Slot {
  const at = expression.span
  if !isDefaultLiteral(lowering, at) {
    return abandonedSlot lowering, builder, destination
  }
  const bounds = boundsOfLiteral lowering, expression
  const bound = match bounds.first() {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "a map literal of a type that is not a `Map`", at
    }
  }
  const arguments = traitArgumentsOfBound lowering, bound
  if arguments.length() < 2 {
    const what = "a map literal without a key and a value type"
    return unsupportedSlot lowering, builder, destination, what, at
  }
  const key = arguments[0]
  const value = arguments[1]
  const container = match implementationOf(lowering, "TrieMap", [key, value], at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  // A key of the hash table is compared and hashed through its descriptor, so this one carries both members
  const keyElement = match elementFor(lowering, key, true, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const valueElement = match elementFor(lowering, value, false, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  const storage = addTemporary builder, irTypeOfClosed(lowering, container)
  emit builder, Instruction.ContainerNew(storage, RuntimeKind.MapStorage, [keyElement, valueElement])
  const setter = match memberOfType(lowering, container, bound, "set", at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  for (written, given) in entries {
    const first = lowerValue lowering, builder, written
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
    const second = lowerValue lowering, builder, given
    if !lowering.isSupported {
      return abandonedSlot lowering, builder, destination
    }
    addInto lowering, builder, setter, storage, [first, second], written.span
  }
  coerced lowering, builder, destination, storage, bounds, container, annotation, at
}

// --- The traits a `for` walks ---------------------------------------------------------------------------------------

/**
 * The `Iterable<Item>` a subject implements, with its arguments filled in - the very question `checkLoop` asked before it
 * accepted the loop, so a `for` the checker let through is one the back end can dispatch.
 */
public fn iterableBoundOf(var lowering: Lowering, subject: TypeId, at: Span): TypeId? {
  appliedBoundOf lowering, subject, "Iterable", at
}

/**
 * The `Iterator<Item>` the cursor of a loop implements. It is asked of the cursor's own type rather than read off the
 * declared result of `iterator`, so a cursor that is a concrete type and one that is the trait value both answer.
 */
public fn iteratorBoundOf(var lowering: Lowering, cursor: TypeId, at: Span): TypeId? {
  appliedBoundOf lowering, cursor, "Iterator", at
}

/** One trait of the prelude, applied to the arguments the subject has for it. */
fn appliedBoundOf(var lowering: Lowering, subject: TypeId, name: String, at: Span): TypeId? {
  const capability = match lowering.checker.wellKnown.symbolNamed(name) {
    Some(found) => found
    None => {
      reportUnsupported lowering, "a `for` without `{name}` in the prelude", at
      return None
    }
  }
  const arguments = match traitArgumentsOf(lowering.checker, subject, capability) {
    Some(found) => found
    None => {
      const shown = lowering.checker.describe subject
      reportUnsupported lowering, "`for` over `{shown}`, which the back end cannot see as an `{name}`", at
      return None
    }
  }
  Some lowering.checker.nominal(capability, arguments)
}

// --- Reading an element ---------------------------------------------------------------------------------------------

/**
 * `a[key]`: the `Indexed.at` the checker resolved at the span of the whole index expression.
 *
 * **The panic on a missing key is the language's own and no rule of the back end.** `at` is a default of `Indexed` whose
 * body is `get(key).expect("Key does not exist")`, so what an index out of range does is decided in `std/core` and is the
 * same in every back end - which is exactly what design principle 5 asks for.
 *
 * The receiver is read as a **value**, because `at` takes `self`. A `var` path *through* an index
 * (`enemies[0].health = 5`) is `TakeOut`/`PutBack`, in `lowerIndexAssignment` (`ir/lower/place.trb`); this is the
 * read alone.
 */
public fn lowerIndexRead(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  expression: Expression,
  target: Expression,
  index: Expression,
  annotation: IrTypeId,
): Slot {
  const at = expression.span
  const module = lowering.module
  const resolution = match lowering.checker.resolutionAt(module, at) {
    Some(found) => found
    None => {
      return unsupportedSlot lowering, builder, destination, "`a[key]` the checker did not resolve", at
    }
  }
  const (symbol, typeArguments, dispatch) = match resolution {
    .Callable(found, given, how) => (found, given, how)
    _ => {
      return unsupportedSlot lowering, builder, destination, "`a[key]` the back end does not lower yet", at
    }
  }
  const receiver = lowering.checker.expressionType module, target.span
  const dispatched = match dispatchedMember(lowering, symbol, typeArguments, dispatch, receiver, at) {
    Some(found) => found
    None => {
      return abandonedSlot lowering, builder, destination
    }
  }
  // Source order: what stands in front of the bracket first, then what is in it (docs/BACKEND.md, Evaluation order
  // is only half specified)
  const base = lowerValue lowering, builder, target
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const key = lowerValue lowering, builder, index
  if !lowering.isSupported {
    return abandonedSlot lowering, builder, destination
  }
  const places: List<Reference?> = []
  lowerDispatched lowering, builder, destination, at, dispatched, [base, key], places, annotation
}

// --- The pieces both literals share ---------------------------------------------------------------------------------

/** One `add` or `set` on the container under construction: the receiver is the temporary, which is a place. */
fn addInto(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  member: FunctionId,
  storage: Slot,
  values: List<Slot>,
  at: Span,
) {
  var given = [referenced(Reference(storage, []))]
  for value in values {
    given.add borrowed(value)
  }
  const location = locationOf lowering, at
  emit builder, Instruction.Call(None, member, given, [], Some(location))
}

/**
 * The bounds of the trait-typed value a literal *is*. The checker built the type out (`Traits([List<Int>])`), so there is
 * no `Adaptation.ToTraitValue` at a literal and nothing has recorded the bounds anywhere else.
 *
 * The arguments of the instance that is being lowered go in first: a `[]` inside
 * `fn empty<Item>(): List<Item>` is recorded as `Traits([List<Item>])`, and without substituting it the element
 * descriptor would be built for the *parameter* - which reaches the back end as "`Item` was not substituted".
 */
fn boundsOfLiteral(var lowering: Lowering, expression: Expression): List<TypeId> {
  const module = lowering.module
  const written = match lowering.checker.expressionType(module, expression.span) {
    Some(inner) => inner
    None => {
      return []
    }
  }
  const found = substituted lowering, written
  match lowering.checker.types.form(found) {
    .Traits(bounds) => bounds
    _ => []
  }
}

/** `List<Int>` as a bound: its own type arguments, which are the type arguments of the container. */
fn traitArgumentsOfBound(var lowering: Lowering, bound: TypeId): List<TypeId> {
  match lowering.checker.types.form(bound) {
    .Nominal(_, arguments) => arguments
    _ => []
  }
}

/** `ArrayList<Item>`, `TrieMap<Key, Value>`: the implementation a literal builds, asked of the prelude by name. */
fn implementationOf(
  var lowering: Lowering,
  name: String,
  arguments: List<TypeId>,
  at: Span,
): TypeId? {
  const found = preludeType lowering, name, arguments
  if found.isNone() {
    reportUnsupported lowering, "a container literal without `{name}` in the prelude", at
  }
  found
}

/** The container, boxed with one witness pointer per bound: which is what the type of a literal is. */
fn coerced(
  var lowering: Lowering,
  var builder: FunctionBuilder,
  destination: Slot?,
  storage: Slot,
  bounds: List<TypeId>,
  container: TypeId,
  annotation: IrTypeId,
  at: Span,
): Slot {
  const target = valueSlot lowering, builder, destination, annotation
  if !lowerTraitValue(lowering, builder, target, storage, bounds, container, at) {
    return abandonedSlot lowering, builder, destination
  }
  target
}
