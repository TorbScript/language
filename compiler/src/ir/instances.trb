/**
 * The monomorphization worklist: which declarations become functions of the program, and under which name.
 *
 * An instance is a declaration plus the **type arguments of every generic parameter that is in scope of it**, and
 * `IrProgram.instances` maps its key to the `FunctionId` it became - so two routes to the same declaration with the same
 * arguments are one function however the lowering reached them. The arguments of a *method of a generic type* are the
 * owner's, of a *generic function* its own, and of a **trait default member** the `Self` it was reached for; all three
 * are the same list, in the order of `Signature.generics` with `Self` in front where there is one.
 *
 * Every instance is added to the program *before* its body is lowered, with an `unreachable` placeholder body: a
 * function that calls itself needs its own id before the body that makes the call exists. `drainPending` in
 * `ir/lower/lower.trb` then lowers each instance's real body in turn, from `IrProgram.pending`.
 */

use FunctionDeclaration from "../syntax/ast"
use SymbolId from "../semantics/symbols"
use TypeId, TypeForm, ParameterId, ParameterForm, ParameterMode, Signature, LiteralValue from "../semantics/checker/type"
use signatureOf, functionOfSite from "../semantics/checker/signature"
use substitute from "../semantics/checker/unify"
use IrFunction, IrSignature, IrParameter, IrType, IrTypeId, Ownership from "./ir"
use FunctionId, FunctionKind, Instance, SlotDeclaration, SlotRole, RuntimeKind from "./ir"
use Lowering, irTypeOfClosed, reportUnsupported from "./lower/context"
use functionName from "./mangle"
use symbolPathOf, cellType from "./instantiate"
use newFunction, finishFunction from "./build"

/** What a monomorphic declaration is as a function of the IR, or `None` where nothing can be built from it. */
public fn instanceOfSymbol(var lowering: Lowering, symbol: SymbolId): FunctionId? {
  const empty: Map<ParameterId, TypeId> = [:]
  instanceFor lowering, symbol, empty
}

/**
 * The function one declaration becomes under one substitution. `mapping` has to be closed already - every value of it
 * is a type of the *caller's* instance, substituted - because the name of an instance is a function of its arguments
 * and a generic parameter has no name in the back end.
 */
public fn instanceFor(
  var lowering: Lowering,
  symbol: SymbolId,
  mapping: Map<ParameterId, TypeId>,
): FunctionId? {
  const plain = match instanceArgumentsOf(lowering, symbol, mapping) {
    Some(found) => found
    None => {
      return None
    }
  }
  const arguments = plain.appendedAll literalArgumentsOf(lowering, symbol, mapping)
  const instance = Instance symbol, arguments, []
  const key = instanceKeyOf instance
  if const Some(found) = lowering.program.instances.get(key) {
    return found
  }
  if !boundedArguments(lowering, symbol, mapping) {
    return None
  }
  const identifier = signatureOf lowering.checker, symbol
  const signature = lowering.checker.signature identifier
  if !signature.hasBody {
    return None
  }
  if functionDeclarationOf(lowering, symbol).isNone() {
    return None
  }
  const built = irSignatureUnder lowering, signature, mapping
  const name = nameOfInstance lowering, symbol, arguments
  var builder = newFunction name, symbol, built, "not supported yet"
  const added = finishFunction lowering.program, builder
  lowering.program.instances.set key, added
  lowering.instanceMappings.set key, mapping
  lowering.program.pending.append instance
  added
}

/**
 * The backstop against a worklist that does not end. A type-growing instance - one whose body asks for itself with a
 * *bigger* type argument - would otherwise be a hang and not a message: `Iterate.indexed` is `Zipped(0.., self)`, so a
 * table holding it asks for `Zipped<Int, (Int, Item)>`, then for `Zipped<Int, (Int, (Int, Item))>`, and so on. A witness
 * table holds only the members a type overrides, not its trait's defaults (BACKEND 5.6), which is what really bounds it
 * in practice; this is the guard that turns any remaining case into a finding at the declaration instead of a build
 * that never finishes.
 *
 * The limit is deliberately generous: the deepest type argument the repository really instantiates nests four
 * (`Map<String, List<Diagnostic>>` inside a generic function), so nothing legitimate comes near it.
 */
fn boundedArguments(
  var lowering: Lowering,
  symbol: SymbolId,
  mapping: Map<ParameterId, TypeId>,
): Bool {
  const limit = 10
  for (_, given) in mapping {
    if nestingDepthOf(lowering, given, 0) <= limit {
      continue
    }
    const name = lowering.checker.symbolAt(symbol).name
    const shown = lowering.checker.describe given
    const what = "the instances of `{name}` do not end: its type argument `{shown}` nests deeper than {limit}"
    reportUnsupported lowering, what, lowering.checker.symbolAt(symbol).span
    return false
  }
  true
}

/** How deep a type nests: `Int64` is 1, `List<Int64>` 2, `Zipped<Int64, (Int64, Item)>` 3. */
fn nestingDepthOf(var lowering: Lowering, id: TypeId, depth: Int): Int {
  if depth > 12 {
    return depth
  }
  match lowering.checker.types.form(id) {
    .Nominal(_, arguments) => deepestOf lowering, arguments, depth
    .Traits(bounds) => deepestOf lowering, bounds, depth
    .Literals(base, _) => nestingDepthOf lowering, base, depth
    .Constant(_, of) => nestingDepthOf lowering, of, depth
    .Tuple(fields) => {
      var deepest = depth + 1
      for field in fields {
        deepest = deepest.max nestingDepthOf(lowering, field.annotation, depth + 1)
      }
      deepest
    }
    .Function(form) => {
      var deepest = depth + 1
      for parameter in form.parameters {
        deepest = deepest.max nestingDepthOf(lowering, parameter.annotation, depth + 1)
      }
      deepest.max nestingDepthOf(lowering, form.result, depth + 1)
    }
    _ => depth + 1
  }
}

fn deepestOf(var lowering: Lowering, arguments: List<TypeId>, depth: Int): Int {
  var deepest = depth + 1
  for argument in arguments {
    deepest = deepest.max nestingDepthOf(lowering, argument, depth + 1)
  }
  deepest
}

/**
 * A `native fn` the runtime provides: a function with a signature and no body, whose `kind` carries the C symbol the
 * emitter calls. It is a function and not an instruction of its own, so a call of one is an ordinary `Call` and the
 * ownership pass reads its modes out of the signature exactly as it does for anything else.
 */
public fn runtimeFunctionOf(var lowering: Lowering, symbol: SymbolId, runtime: String): FunctionId? {
  const empty: Map<ParameterId, TypeId> = [:]
  runtimeFunctionUnder lowering, symbol, runtime, empty
}

/**
 * What the ABI of one function of the runtime really is, where it is not the declaration's: which declared parameters go
 * by address because there is one C implementation per container (BACKEND 3.1), and the out parameter through which it
 * writes the payload of an `Option` or a `Result` while answering `bool` (BACKEND 5.R1).
 *
 * It comes out of the natives manifest and nothing else, so both back ends read the same shape.
 */
public type RuntimeShape {
  addressed: List<Int> = []
  /**
   * What the runtime writes through **out parameters**, in the order it takes them: the payload of the success case, one
   * per field of the failure type that no parameter of the declaration names (the `message` of an `IoError`), and one per
   * **field of the payload** where that payload is a tuple the runtime cannot build in one piece
   * (`torb_map_entry_after` writes a key and a value, and the wrapper makes the `(Key, Value)`).
   * The result of the function is then `Bool`, and `ir/lower/native.trb` builds the `Option` or the `Result`.
   */
  outs: List<IrTypeId> = []
  /**
   * The positions where the runtime holds the **storage** of a collection although the declaration names the trait type
   * (`String.split`, `File.list`, `Process.arguments`): a runtime function cannot carry a witness table, so what crosses
   * the boundary is the one implementation. `ir/lower/native.trb` coerces it, the same way a list literal does.
   */
  storage: List<StoragePosition> = []
}

/** One position of a runtime ABI that holds a container's storage, and what that storage is. */
public type StoragePosition {
  /** The index of the declared parameter, or `-1` for the result. */
  at: Int
  annotation: IrTypeId
}

/** The same for a native of a generic owner, whose parameters the caller has filled in. */
public fn runtimeFunctionUnder(
  var lowering: Lowering,
  symbol: SymbolId,
  runtime: String,
  mapping: Map<ParameterId, TypeId>,
): FunctionId? {
  runtimeFunctionShaped lowering, symbol, runtime, mapping, RuntimeShape()
}

/** The same, with the runtime's own convention applied to the signature. */
public fn runtimeFunctionShaped(
  var lowering: Lowering,
  symbol: SymbolId,
  runtime: String,
  mapping: Map<ParameterId, TypeId>,
  shape: RuntimeShape,
): FunctionId? {
  const arguments = match instanceArgumentsOf(lowering, symbol, mapping) {
    Some(found) => found
    None => {
      return None
    }
  }
  const instance = Instance symbol, arguments, []
  const key = instanceKeyOf instance
  if const Some(found) = lowering.program.instances.get(key) {
    return found
  }
  const identifier = signatureOf lowering.checker, symbol
  const signature = lowering.checker.signature identifier
  const declared = irSignatureUnder lowering, signature, mapping
  const built = shapedSignature lowering, declared, shape
  const name = nameOfInstance lowering, symbol, arguments
  var function = IrFunction name, symbol, built, [], [], FunctionKind.Runtime(runtime)
  for index in 0..built.parameters.length() {
    const parameter = built.parameters[index]
    function.slots.append SlotDeclaration(parameter.annotation, SlotRole.Parameter(index), parameter.name)
  }
  const added = lowering.program.addFunction function
  lowering.program.instances.set key, added
  added
}

/**
 * The declared signature with the runtime's convention applied: an addressed parameter becomes a reference, and an out
 * parameter is appended after the declared ones while the result becomes `Bool`.
 */
fn shapedSignature(var lowering: Lowering, declared: IrSignature, shape: RuntimeShape): IrSignature {
  if shape.addressed.isEmpty() && shape.outs.isEmpty() && shape.storage.isEmpty() {
    return declared
  }
  var parameters: List<IrParameter> = []
  for index in 0..declared.parameters.length() {
    var parameter = declared.parameters[index]
    if const Some(found) = storageAt(shape, index) {
      parameter = parameter.copy annotation: found
    }
    if shape.addressed.contains(index) {
      parameters.append parameter.copy(isByAddress: true)
      continue
    }
    parameters.append parameter
  }
  if shape.outs.isEmpty() {
    const result = storageAt(shape, 0 - 1) ?? declared.result
    return IrSignature parameters, result
  }
  // A name per out parameter, because several of them are several slots of the wrapper and a reader of the IR text has to
  // tell them apart
  for index in 0..shape.outs.length() {
    const name = if index == 0 { "out" } else { "out{index}" }
    parameters.append IrParameter(name, shape.outs[index], true, Ownership.Borrowed, true, false)
  }
  const boolean = lowering.program.internType IrType.Boolean
  IrSignature parameters, boolean
}

/** The storage type of one position of a runtime ABI, or `None` where it holds what the declaration says. */
fn storageAt(shape: RuntimeShape, at: Int): IrTypeId? {
  for position in shape.storage {
    if position.at == at {
      return position.annotation
    }
  }
  None
}

/** The mangled name of an instance: a pure function of where the declaration is written and of its arguments. */
public fn nameOfInstance(var lowering: Lowering, symbol: SymbolId, arguments: List<IrTypeId>): String {
  const path = symbolPathOf lowering.checker, symbol
  functionName lowering.program, path, arguments
}

/**
 * The key an instance is memoized under. Spelled out here rather than taken from `mangle.trb` because the key never
 * leaves the run that built it, while a *name* has to be stable across runs.
 */
public fn instanceKeyOf(instance: Instance): String {
  var key = "{instance.symbol.value}"
  for argument in instance.arguments {
    key = key + ";{argument.value}"
  }
  key = key + "!"
  for witness in instance.witnesses {
    key = key + ";{witness.value}"
  }
  key
}

/**
 * The type arguments of one instance, in the order a name is built from: the `Self` of a trait first where the owner is
 * one, then every generic parameter that is in scope of the declaration.
 *
 * `None` where one of them is missing or is still a generic parameter itself - which is what "this call site did not
 * decide everything the declaration needs" means, and what makes such a call a clean finding.
 */
public fn instanceArgumentsOf(
  var lowering: Lowering,
  symbol: SymbolId,
  mapping: Map<ParameterId, TypeId>,
): List<IrTypeId>? {
  const identifier = signatureOf lowering.checker, symbol
  const signature = lowering.checker.signature identifier
  var arguments: List<IrTypeId> = []
  if const Some(own) = selfParameterOf(lowering, signature) {
    const found = closedArgument(lowering, mapping, own)?
    arguments.append found
  }
  for parameter in signature.generics {
    const found = closedArgument(lowering, mapping, parameter)?
    arguments.append found
  }
  // An owner that is neither concrete nor covered by the arguments cannot be laid out at all
  if const Some(owner) = signature.owner {
    const applied = substitute lowering.checker.types, owner, mapping
    if !isClosedType(lowering, applied) {
      return None
    }
  }
  arguments
}

/**
 * What tells an instance over a literal type from the one over its base: one more argument per type argument that has
 * a literal type in it, which spells the position and the whole type (`0: "draft" | "sent"`).
 *
 * A literal type **is** its base at run time, so `"draft" | "sent"` and `String` are one IR type and would be one
 * instance - and the body of the first one asked for would serve both. That is right for everything a body does with
 * the value, and wrong for what it asks of the type: `Value.decode` of a literal type checks the text against the values
 * it allows, `Value.tryFrom` compares with them, and the base does neither. So an instance whose arguments mention a
 * literal type anywhere, `List<"draft" | "sent">` too, is an instance of its own, with a name of its own.
 */
fn literalArgumentsOf(
  var lowering: Lowering,
  symbol: SymbolId,
  mapping: Map<ParameterId, TypeId>,
): List<IrTypeId> {
  const identifier = signatureOf lowering.checker, symbol
  const signature = lowering.checker.signature identifier
  var parameters: List<ParameterId> = []
  if const Some(own) = selfParameterOf(lowering, signature) {
    parameters.append own
  }
  parameters.appendAll signature.generics
  var found: List<IrTypeId> = []
  for position in 0..parameters.length() {
    const given = match mapping.get(parameters[position]) {
      Some(found) => found
      None => {
        continue
      }
    }
    if !mentionsLiteralType(lowering, given, 0) {
      continue
    }
    const text = lowering.checker.describe given
    const voidType = lowering.program.internType IrType.VoidType
    const spelled = LiteralValue.Text "{position}: {text}"
    found.append lowering.program.internType(IrType.ConstantValue(spelled, voidType))
  }
  found
}

/** Whether a literal type stands anywhere inside of a type. */
fn mentionsLiteralType(var lowering: Lowering, id: TypeId, depth: Int): Bool {
  if depth > 12 {
    return false
  }
  match lowering.checker.types.form(id) {
    .Literals(_, _) => true
    .Nominal(_, arguments) => anyMentionsLiteralType lowering, arguments, depth
    .Traits(bounds) => anyMentionsLiteralType lowering, bounds, depth
    .Tuple(fields) => {
      for field in fields {
        if mentionsLiteralType(lowering, field.annotation, depth + 1) {
          return true
        }
      }
      false
    }
    .Function(form) => {
      for parameter in form.parameters {
        if mentionsLiteralType(lowering, parameter.annotation, depth + 1) {
          return true
        }
      }
      mentionsLiteralType(lowering, form.result, depth + 1)
    }
    _ => false
  }
}

fn anyMentionsLiteralType(var lowering: Lowering, types: List<TypeId>, depth: Int): Bool {
  for id in types {
    if mentionsLiteralType(lowering, id, depth + 1) {
      return true
    }
  }
  false
}

/** The `Self` of a trait, which is a generic parameter that is not in `Signature.generics`. */
fn selfParameterOf(var lowering: Lowering, signature: Signature): ParameterId? {
  const owner = signature.owner?
  if const .Parameter(parameter) = lowering.checker.types.form(owner) {
    return parameter
  }
  None
}

fn closedArgument(
  var lowering: Lowering,
  mapping: Map<ParameterId, TypeId>,
  parameter: ParameterId,
): IrTypeId? {
  const given = mapping.get(parameter)?
  if !isClosedType(lowering, given) {
    return None
  }
  irTypeOfClosed lowering, given
}

/**
 * Whether nothing inside a type is still a generic parameter or an unsolved variable. Every argument of an instance has
 * to answer `true`: a mangled name is built from the arguments, and a parameter has no name in the back end.
 */
public fn isClosedType(var lowering: Lowering, id: TypeId): Bool {
  match lowering.checker.types.form(id) {
    .Parameter(_) => false
    .Variable(_) => false
    .Deferred => false
    .Invalid => false
    .Nominal(_, arguments) => everyClosed lowering, arguments
    .Traits(bounds) => everyClosed lowering, bounds
    .Literals(base, _) => isClosedType lowering, base
    .Constant(_, of) => isClosedType lowering, of
    .Tuple(fields) => {
      for field in fields {
        if !isClosedType(lowering, field.annotation) {
          return false
        }
      }
      true
    }
    .Function(form) => {
      for parameter in form.parameters {
        if !isClosedType(lowering, parameter.annotation) {
          return false
        }
      }
      isClosedType lowering, form.result
    }
    _ => true
  }
}

fn everyClosed(var lowering: Lowering, arguments: List<TypeId>): Bool {
  for argument in arguments {
    if !isClosedType(lowering, argument) {
      return false
    }
  }
  true
}

/**
 * Whether a declaration needs nothing a call site has to decide: no generic parameters of its own or of the
 * declaration around it, and an owner that is a concrete type rather than the `Self` of a trait.
 */
public fn isMonomorphic(var lowering: Lowering, symbol: SymbolId): Bool {
  const identifier = signatureOf lowering.checker, symbol
  const signature = lowering.checker.signature identifier
  if !signature.generics.isEmpty() {
    return false
  }
  match signature.owner {
    None => true
    Some(owner) => isConcreteOwner lowering, owner
  }
}

fn isConcreteOwner(var lowering: Lowering, owner: TypeId): Bool {
  match lowering.checker.types.form(owner) {
    .Nominal(_, arguments) => arguments.isEmpty()
    _ => false
  }
}

/** The `fn` a symbol was declared by, so that a body can be lowered from it. */
public fn functionDeclarationOf(var lowering: Lowering, symbol: SymbolId): FunctionDeclaration? {
  const site = lowering.checker.siteOf(symbol)?
  functionOfSite site
}

// --- Signatures -----------------------------------------------------------------------------------------------------

/**
 * The IR signature of a closed declaration: `self` first, then the parameters in declaration order. Every one of them
 * is `Borrowed` here - which parameters the callee stores is what the ownership summary pass decides (BACKEND 2.2),
 * and it reads the body the lowering writes.
 */
public fn irSignatureOf(var lowering: Lowering, signature: Signature): IrSignature {
  const empty: Map<ParameterId, TypeId> = [:]
  irSignatureUnder lowering, signature, empty
}

/**
 * The same with the generic parameters of the instance filled in. There are **no witness parameters**: a trait-typed
 * value carries its own tables, so a bound that is not known statically is read out of the value it belongs to
 * (BACKEND 5.6).
 */
public fn irSignatureUnder(
  var lowering: Lowering,
  signature: Signature,
  mapping: Map<ParameterId, TypeId>,
): IrSignature {
  var parameters: List<IrParameter> = []
  if signature.takesSelf {
    if const Some(owner) = signature.owner {
      const applied = substitute lowering.checker.types, owner, mapping
      const annotation = irTypeOfClosed lowering, applied
      parameters.append IrParameter("self", annotation, signature.isVarSelf, Ownership.Borrowed)
    }
  }
  for parameter in signature.form.parameters {
    const annotation = parameterTypeOf lowering, parameter, mapping
    const name = parameter.name ?? ""
    const isReference = isReferenceParameter parameter.mode
    parameters.append IrParameter(name, annotation, isReference, Ownership.Borrowed)
  }
  const applied = substitute lowering.checker.types, signature.form.result, mapping
  const result = irTypeOfClosed lowering, applied
  IrSignature parameters, result
}

/** `lazy Value` is a one-shot memo cell and a variadic parameter holds the list the call site builds (BACKEND 1.6). */
fn parameterTypeOf(
  var lowering: Lowering,
  parameter: ParameterForm,
  mapping: Map<ParameterId, TypeId>,
): IrTypeId {
  const applied = substitute lowering.checker.types, parameter.annotation, mapping
  const annotation = irTypeOfClosed lowering, applied
  match parameter.mode {
    .Lazy => cellTypeFor lowering, applied, annotation
    .Variadic => variadicTypeOf lowering, applied, annotation
    _ => annotation
  }
}

/**
 * What a variadic parameter holds: the **`List<Item>` the body sees**, and not the buffer the call site fills. The checker
 * declares the binding of `...values: Show` as `List<Show>`, which in a type position is a trait-typed value
 * (BACKEND 5.6), so a signature that said `ArrayList<Item>` would have the body read a buffer through a pointer to an
 * `Object`.
 *
 * Without `List` in the prelude there is nothing to box it with, and the buffer is the honest answer: a workspace with
 * another prelude has to keep working, and nothing of the language reaches such a parameter there.
 */
fn variadicTypeOf(var lowering: Lowering, item: TypeId, buffer: IrTypeId): IrTypeId {
  const symbol = match lowering.checker.wellKnown.list {
    Some(found) => found
    None => {
      return lowering.program.internType IrType.Runtime(RuntimeKind.ListStorage, [buffer])
    }
  }
  const bound = lowering.checker.nominal symbol, [item]
  const traits = lowering.checker.types.intern TypeForm.Traits([bound])
  irTypeOfClosed lowering, traits
}

/** The memo cell of a `lazy Value` parameter, which the whole back end sees as an ordinary counted record. */
public fn cellTypeFor(var lowering: Lowering, item: TypeId, inner: IrTypeId): IrTypeId {
  cellType lowering.program, lowering.checker, lowering.instantiation, item, inner
}

/** Whether a parameter of this mode is passed as a `Reference` rather than by value: a `var` parameter or receiver. */
public fn isReferenceParameter(mode: ParameterMode): Bool {
  match mode {
    .Var => true
    .Receiver(isVar) => isVar
    _ => false
  }
}

/** Whether a call of this declaration would need a `var` path: a `var self`, or a parameter that takes one. */
public fn needsReference(signature: Signature): Bool {
  if signature.isVarSelf {
    return true
  }
  signature.form.parameters.any({ isReferenceParameter _.mode })
}
