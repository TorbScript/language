/**
 * Witness tables: what a trait-typed value and a dynamic call go through.
 *
 * A table is static data, one per `(trait with its arguments, target type)`, holding one function pointer per member the
 * ABI can reach, in a deterministic order. A **default** member is deliberately not in a table: calling one is a call of
 * the monomorphic instance of the default body with `Self` bound to the target, which is what makes `by` forward the
 * required members only.
 *
 * Two things are decided here and not in BACKEND section 1.4, and both are recorded in BACKEND 5.6:
 *
 * - **A trait-typed value carries its own tables, so nothing is ever passed as a witness parameter.** Every open bound
 *   of the language belongs to a value that is in hand - the receiver of the call, the argument that is interpolated -
 *   and reading the table out of that value is what `WitnessRoot.Value` is for.
 * - **The members of the supertraits are flattened into the table instead of sitting in a nested one.** A call through a
 *   table has to spell the member's C type, and the only trait a back end can name at a `CallWitness` is the bound the
 *   value carries - so a path through nested tables could not be spelled at all. `WitnessTable.nested` stays empty.
 */

use Span from "../syntax/source"
use SymbolId from "../semantics/symbols"
use TypeId, TypeForm, ParameterId, Signature, ImplementationId from "../semantics/checker/type"
use signatureOf, typeSignatureOf from "../semantics/checker/signature"
use sameType from "../semantics/checker/unify"
use witnessFor, supertraitsOfBound, memberOfImplementation, matchTypePattern from "../semantics/checker/implementation"
use traitArgumentsOf, defaultInClosureOf from "../semantics/checker/implementation"
use DerivedKind from "../backend/c/natives"
use TraitId, FunctionId, Slot, Reference, WitnessTable, WitnessTableId from "./ir"
use WitnessSource, WitnessRoot, IrSignature, Instruction, Terminator, Argument, BlockId from "./ir"
use borrowed, referenced from "./ir"
use witnessTableName, selfAnswerName from "./mangle"
use instantiateTrait from "./instantiate"
use instanceFor, isClosedType from "./instances"
use newFunction, addTemporary, emit, terminate, finishFunction, setBlockLocation from "./build"
use Lowering, Generated, reportUnsupported, irTypeOfClosed, nativeNamed from "./lower/context"
use GenericSlot, TableSource from "./lower/context"
use generatedFunctionOf from "./lower/derive"
use nativeFunctionOf, needsNativeWrapper, declarationLocationOf from "./lower/native"
use lowerTraitValue from "./lower/generic"

/**
 * The static table of one concrete type and one trait, built once. Both types have to be closed: a table is named after
 * them, and a generic parameter has no name in the back end.
 */
public fn witnessTableOf(var lowering: Lowering, subject: TypeId, bound: TypeId, at: Span): WitnessTableId? {
  if !isClosedType(lowering, subject) || !isClosedType(lowering, bound) {
    reportUnsupported lowering, "a witness table of a type the call site did not decide", at
    return None
  }
  const applied = traitIdOf lowering, bound
  const target = irTypeOfClosed lowering, subject
  const name = witnessTableName lowering.program, applied, target
  if const Some(found) = lowering.program.witnessTableNamed(name) {
    return found
  }
  if lowering.buildingTables.containsKey(name) {
    reportUnsupported lowering, "a witness table that needs itself", at
    return None
  }
  const implementation = match witnessFor(lowering.checker, subject, bound) {
    .Implementation(found, _, _) => found
    .Object(_, _) => {
      reportUnsupported lowering, "a static witness table of a trait-typed value", at
      return None
    }
    _ => {
      const shown = lowering.checker.describe bound
      reportUnsupported lowering, "a witness for `{shown}` the checker did not resolve", at
      return None
    }
  }
  lowering.buildingTables.set name, true
  const members = membersOfTable lowering, subject, bound, implementation, at
  const nested = nestedTablesOf lowering, subject, bound, at
  const _ = lowering.buildingTables.remove name
  const found = match members {
    Some(inner) => inner
    None => {
      return None
    }
  }
  const added = lowering.program.addWitnessTable WitnessTable(name, applied, target, found, nested)
  lowering.tableSources.set added.value, TableSource(subject, bound, implementation)
  adaptSelfAnswers lowering, added, subject, bound, at
  added
}

/**
 * The slots of a new table that answer `Self` point at a function that boxes the answer, once the table exists.
 *
 * `List.slice` answers `Self`, and on a trait-typed receiver `Self` is the trait type: the implementation's own member
 * answers an `ArrayList<UInt8>`, and what the call site holds afterwards is a `List<UInt8>` - the same payload type as
 * the receiver's, so the same tables apply to it. The function a slot points at therefore calls the member and boxes its
 * answer with this very table ([selfAnswerOf]), which is why it can only be built after the table was added: until then
 * the slot holds the member itself. The slots are the ones behind the fixed members ([isSelfAnswerSlot]).
 */
fn adaptSelfAnswers(var lowering: Lowering, table: WitnessTableId, subject: TypeId, bound: TypeId, at: Span) {
  const fixed = tableMembersOf(lowering, bound, subject).length()
  const slots = lowering.genericSlots.get(traitIdOf(lowering, bound).value) ?? []
  for index in 0..slots.length() {
    if !slots[index].arguments.isEmpty() || !answersSelf(lowering, slots[index].member) {
      continue
    }
    const current = lowering.program.witnessTableAt table
    const position = fixed + index
    const member = slots[index].member
    const answer = match selfAnswerOf(lowering, current.members[position], member, table, subject, bound, at) {
      Some(found) => found
      None => {
        return
      }
    }
    var patched = current.members
    patched.set position, answer
    lowering.program.witnessTables.set table.value, current.copy(members: patched)
  }
}

/**
 * The function a slot that answers `Self` points at: the implementation's member, and its answer boxed as a value of the
 * table's trait. Its receiver and its parameters are the member's, so the thunk of the table unwraps the payload for it
 * exactly as for any other member.
 *
 * What it answers is a trait-typed value with **one** bound, the table's; a receiver of several bounds
 * (`List<UInt8> & Show`) gets the tables of its own put around the payload at the call site (`lowerWitnessCall`), which
 * is where they are in hand.
 */
fn selfAnswerOf(
  var lowering: Lowering,
  member: FunctionId,
  declared: SymbolId,
  table: WitnessTableId,
  subject: TypeId,
  bound: TypeId,
  at: Span,
): FunctionId? {
  const wrapped = lowering.program.functionAt member
  const name = selfAnswerName wrapped.name, lowering.program.witnessTableAt(table).name
  const result = irTypeOfClosed lowering, lowering.checker.types.intern(TypeForm.Traits([bound]))
  const signature = IrSignature wrapped.signature.parameters, result
  const origin = wrapped.origin ?? declared
  var builder = newFunction name, origin, signature, "answers Self"
  const location = declarationLocationOf lowering, origin
  setBlockLocation builder, BlockId(0), location
  var given: List<Argument> = []
  for index in 0..signature.parameters.length() {
    if signature.parameters[index].isReference {
      given.append referenced(Reference(Slot(index), []))
      continue
    }
    given.append borrowed(Slot(index))
  }
  const answered = addTemporary builder, wrapped.signature.result
  const empty: List<WitnessSource> = []
  emit builder, Instruction.Call(answered, member, given, empty, location)
  const boxed = addTemporary builder, result
  if !lowerTraitValue(lowering, builder, boxed, answered, [bound], subject, at) {
    // The slot would hold the member itself, which answers the payload and not the boxed value a call site reads: a
    // program with such a table must not be emitted, however silently the table was asked for
    const shown = lowering.checker.symbolAt(declared).name
    const owner = lowering.program.witnessTableAt(table).name
    lowering.program.problems.append "`{shown}` of `{owner}` answers `Self`, and its answer could not be boxed"
    return None
  }
  terminate builder, Terminator.Return(borrowed(boxed))
  finishFunction lowering.program, builder
}

/**
 * The table of every **direct** supertrait of a bound, in declaration order. That is what makes a narrowing coercion
 * possible: `List<Item>` handed to a parameter of type `Iterate<Item>` has erased its payload's type, so the table of
 * `(the payload's type, Iterate<Item>)` can only come out of the table the value already carries - and `nested[i]` is
 * where it is (5.6 left the list empty and named this as what needs it).
 *
 * The indices are a static property of the **trait** and not of the erased target, because they are the positions of
 * `supertraitsOfBound`, which reads the trait's own `with` list. So a step is spelled once, in the lowering, and every
 * back end walks it the same way.
 *
 * A supertrait whose own table cannot be built leaves a hole: the narrowing that would have read it is a clean finding
 * at the coercion, and a table nobody narrows through costs one null pointer.
 */
fn nestedTablesOf(var lowering: Lowering, subject: TypeId, bound: TypeId, at: Span): List<WitnessTableId?> {
  const target = irTypeOfClosed lowering, subject
  var found: List<WitnessTableId?> = []
  for supertrait in supertraitsOfBound(lowering.checker, bound, subject) {
    const applied = traitIdOf lowering, supertrait
    const name = witnessTableName lowering.program, applied, target
    // A supertrait whose table is being built one level up would report "a witness table that needs itself"
    if lowering.buildingTables.containsKey(name) {
      found.append None
      continue
    }
    found.append withoutReports(lowering, subject, supertrait, at)
  }
  found
}

/**
 * A table that may fail to build without saying anything. A supertrait's table is built because *some* narrowing might
 * need it, not because this coercion does - so a member of it the back end cannot provide may not blame the value that is
 * being boxed here. Every member of a nested table is a member of the flattened one above it, so in practice a nested
 * table fails exactly where the table above it fails and says so there.
 */
fn withoutReports(var lowering: Lowering, subject: TypeId, bound: TypeId, at: Span): WitnessTableId? {
  const before = lowering.isSilent
  lowering.isSilent = true
  const built = witnessTableOf lowering, subject, bound, at
  lowering.isSilent = before
  built
}

/** `Show`, `Iterate<Int64>`: one bound, interned, so that a name is a function of the trait and its arguments. */
public fn traitIdOf(var lowering: Lowering, bound: TypeId): TraitId {
  instantiateTrait lowering.program, lowering.checker, lowering.instantiation, bound
}

fn membersOfTable(
  var lowering: Lowering,
  subject: TypeId,
  bound: TypeId,
  implementation: ImplementationId,
  at: Span,
): List<FunctionId>? {
  var found: List<FunctionId> = []
  for member in tableMembersOf(lowering, bound, subject) {
    const built = memberFunctionOf(lowering, subject, member.bound, implementation, member.member, at)?
    found.append built
  }
  // Behind the fixed members: every member with type parameters of its own the program has called on this trait so far
  for slot in lowering.genericSlots.get(traitIdOf(lowering, bound).value) ?? [] {
    const built = genericMemberFunctionOf(lowering, subject, bound, implementation, slot, at)?
    found.append built
  }
  found
}

/**
 * The function one member of a table points at. Three shapes: a member the source wrote down, a member of a **derived**
 * implementation, and a member of a `native type` the runtime provides - the last two have no body anywhere and are
 * generated from the layout.
 */
public fn memberFunctionOf(
  var lowering: Lowering,
  subject: TypeId,
  bound: TypeId,
  implementation: ImplementationId,
  member: SymbolId,
  at: Span,
): FunctionId? {
  const name = lowering.checker.symbolAt(member).name
  const provider = providerOfMember lowering, subject, implementation, member, name
  const mapping = memberMappingOf lowering, provider, subject, bound
  const identifier = signatureOf lowering.checker, provider
  const signature = lowering.checker.signature identifier
  if signature.hasBody {
    const built = instanceFor lowering, provider, mapping
    if built.isNone() {
      reportUnsupported lowering, "`{name}`", at, "no instance of that member can be built"
    }
    return built
  }
  // No body anywhere: the manifest says what the runtime provides, everything else is generated from the layout
  const owner = manifestOwnerOf lowering, subject, implementation, provider
  // A native whose ABI is not the declaration's already has a function of the program around it, and that wrapper *is*
  // what the table points at - a second one around it would only be one call more (`ir/lower/native.trb`)
  if const Some(entry) = nativeNamed(lowering, owner, name, signature) {
    if const .Runtime(symbol) = entry.target {
      if needsNativeWrapper(lowering, provider, mapping, entry) {
        return nativeFunctionOf lowering, provider, mapping, entry, symbol, at
      }
    }
  }
  const kind = generatedKindOf(lowering, provider, owner, implementation, signature, at)?
  generatedFunctionOf lowering, kind, provider, subject, bound, mapping, at
}

/**
 * Which declaration really runs for one member of one table, in the order the checker's requirement check asks:
 *
 * 1. what the implementation provides under the name - its own member, a member of the target's body, a field, or a
 *    member of another implementation of the same target (`memberOfImplementation` *is* `providerOf`),
 * 2. the default of the trait that requires it,
 * 3. the default of any **other** trait of the type's closure. `Slice.slice` is required by `Slice` and written by its
 *    subtrait `List`, which `checkRequirements` accepts through `hasDefaultInClosure` - so without
 *    this step the back end refuses a program the checker approved.
 *
 * Where none of the three has a body the member has no source at all and the manifest or a derived implementation
 * answers for it, which is what the caller does next.
 *
 * Step one asks by **name and shape**, not by name alone: `declaredMemberOf` drops a declaration that cannot be the
 * member, which is what keeps a field of the target that happens to carry the name out.
 */
public fn providerOfMember(
  var lowering: Lowering,
  subject: TypeId,
  implementation: ImplementationId,
  member: SymbolId,
  name: String,
): SymbolId {
  // A **derived** implementation writes nothing, so a member another implementation of the target writes under the name
  // is not its member: the `From<ConfigError>` of a wrapper case is not the `from` of the target's `From<String>`
  if const .Derived = lowering.checker.implementations.at(implementation).origin {
    return member
  }
  if const Some(found) = declaredMemberOf(lowering, implementation, member, name) {
    return found
  }
  const identifier = signatureOf lowering.checker, member
  if lowering.checker.signature(identifier).hasBody {
    return member
  }
  defaultInClosureOf(lowering.checker, subject, name) ?? member
}

/**
 * Which manifest entry a member belongs to: the **target** type of the implementation and not the type that declares the
 * member. `Int64.hash` is an entry although `hash` is written in `trait Hash`, and `native type Int64 with Signed {}`
 * declares nothing at all - the runtime provides every member of every trait it comes with.
 *
 * The subject comes first, and the implementation's target stands in where the subject has no name of its own:
 * `Void` is `TypeForm.VoidType` and not a nominal type, while its members are declared on the `native type Void` of the
 * prelude - which is exactly what the implementation's target is (`WellKnown.declaredVoid`). Without it `"{void}"` would
 * look up `Show.show` under the empty owner and find nothing.
 */
public fn manifestOwnerOf(
  var lowering: Lowering,
  subject: TypeId,
  implementation: ImplementationId,
  member: SymbolId,
): String {
  if const Some(found) = manifestNameOf(lowering, subject) {
    return found
  }
  const target = lowering.checker.implementations.at(implementation).target
  if const Some(found) = manifestNameOf(lowering, target) {
    return found
  }
  ownerNameOf lowering, member
}

fn manifestNameOf(var lowering: Lowering, id: TypeId): String? {
  if const .Nominal(symbol, _) = lowering.checker.types.form(id) {
    return lowering.checker.symbolAt(symbol).name
  }
  None
}

/**
 * The function that implements one member of one trait for one concrete type: what a generated body calls per field, and
 * what a `for` loop and an interpolation will ask for. It goes through the very same path a witness table member does, so
 * a value that is shown through a table and one that is shown directly run the same code.
 */
public fn memberOfType(var lowering: Lowering, subject: TypeId, bound: TypeId, name: String, at: Span): FunctionId? {
  const implementation = match witnessFor(lowering.checker, subject, bound) {
    .Implementation(found, _, _) => found
    _ => {
      const given = lowering.checker.describe subject
      const wanted = lowering.checker.describe bound
      reportUnsupported lowering, "`{given}` as a `{wanted}`, which the checker did not resolve", at
      return None
    }
  }
  const required = traitMemberNamed lowering, bound, name
  const member = match declaredMemberOf(lowering, implementation, required, name) {
    Some(found) => found
    None => {
      const found = required?
      found
    }
  }
  memberFunctionOf lowering, subject, bound, implementation, member, at
}

/**
 * What the implementation writes under the name, where that declaration can *be* the member the trait requires.
 *
 * `providerOf` of the checker answers by name, and a name alone is not enough: a **field** of the target may carry the
 * name of a member. `WellKnown` of the compiler has a field `show: SymbolId?` where `Show.show` is
 * `fn show(): String`, so showing one asked for a generated member whose signature has no receiver at all.
 */
fn declaredMemberOf(
  var lowering: Lowering,
  implementation: ImplementationId,
  required: SymbolId?,
  name: String,
): SymbolId? {
  const found = memberOfImplementation(lowering.checker, implementation, name)?
  const wanted = match required {
    Some(inner) => inner
    None => {
      return found
    }
  }
  if providesMember(lowering, wanted, found) {
    return found
  }
  None
}

/**
 * Whether one declaration can be one member of a trait. The question is the one the checker's own requirement check
 * asks (`compareSignatures` in `semantics/checker/implementation.trb`): the two have to agree about `self` and about how
 * many parameters there are, and a field takes none. Asking it here is what makes the back end find the very
 * declaration that made the program legal.
 *
 * The count matters because a name is not a member: the blanket `Into` of the prelude gives **every** type an `into()`,
 * and `Source.into(sink)` is a member of another trait that only shares the word. Taking the one for the other built
 * the table of a source around a function that takes no sink.
 */
public fn providesMember(var lowering: Lowering, member: SymbolId, provider: SymbolId): Bool {
  if member == provider {
    return true
  }
  // Each identifier first, on a line of its own: asking for a signature may compute it, and that writes the checker
  const wantedIdentifier = signatureOf lowering.checker, member
  const givenIdentifier = signatureOf lowering.checker, provider
  const wanted = lowering.checker.signature wantedIdentifier
  const given = lowering.checker.signature givenIdentifier
  if wanted.takesSelf != given.takesSelf {
    return false
  }
  // A field has no parameters of its own to compare, and what reads it is decided by `self` alone
  if const .Field(_) = lowering.checker.symbolAt(provider).kind {
    return true
  }
  wanted.form.parameters.length() == given.form.parameters.length()
}

/**
 * What a member without a body does. A `native` declaration of `std/` is in the manifest; a member of a derived
 * implementation is one of the ones the language generates; anything else is a clean "not supported" finding.
 */
public fn generatedKindOf(
  var lowering: Lowering,
  member: SymbolId,
  owner: String,
  implementation: ImplementationId,
  signature: Signature,
  at: Span,
): Generated? {
  const name = lowering.checker.symbolAt(member).name
  if const Some(entry) = nativeNamed(lowering, owner, name, signature) {
    if const .Planned(_) = entry.state {
      reportUnsupported lowering, "`{entry.name}`", at, "the runtime does not provide it"
      return None
    }
    match entry.target {
      .Intrinsic(intrinsic) => {
        return Generated.Operation intrinsic
      }
      .Runtime(symbol) => {
        return Generated.RuntimeCall symbol
      }
      .Derived(derived) => {
        return derivedKindOf lowering, derived, at
      }
      .Container(kind) => {
        return Generated.Container kind
      }
      .ArrayStorage(operation) => {
        return Generated.ArrayStorage operation
      }
      // `spawn` and `stopAsCancelled` are control flow of the lowering and never the member of a table
      .Lowered | .Target(_) | .ScriptTable(_) | .Machine(_) | .ScriptHost(_) => {
        reportUnsupported lowering, "`{entry.name}` as a member of a witness table", at
        return None
      }
    }
  }
  const found = lowering.checker.implementations.at implementation
  if const .Derived = found.origin {
    return generatedForDerived lowering, name, at
  }
  // `with Add by value`: the required members are forwarded to the one field, and a default is the trait's own body
  if const .Delegated = found.origin {
    return Generated.Delegate
  }
  // `type Point with Show {}` **declares** the implementation and writes no member at all. The checker accepts that for
  // a trait the language derives, so the body is generated from the layout exactly as for an implementation the checker
  // created itself - the origin of the implementation says who wrote it down and not who writes the body
  if isDerivedName(name) {
    return generatedForDerived lowering, name, at
  }
  reportUnsupported lowering, "`{name}`, which neither the source nor the natives manifest provides", at
  None
}

/** The members the language can generate from a layout. Everything else without a body is a program the checker missed. */
fn isDerivedName(name: String): Bool {
  name == "show" || name == "showNested" || name == "equals" || name == "hash" || name == "compare"
}

/**
 * The members the language generates for a derived implementation. `encode`, `decode` and `describe` take their format
 * as a type parameter of their own, so each is one body per (type, format) pair, built by `ir/lower/encoding.trb` and
 * called directly - never through a table.
 */
fn generatedForDerived(var lowering: Lowering, name: String, at: Span): Generated? {
  if name == "show" {
    return Generated.Show
  }
  if name == "showNested" {
    return Generated.ShowNested
  }
  if name == "equals" {
    return Generated.Equals
  }
  if name == "hash" {
    return Generated.Hash
  }
  if name == "compare" {
    return Generated.Compare
  }
  if name == "from" {
    return Generated.Conversion
  }
  if name == "encode" {
    return Generated.Encode
  }
  if name == "decode" {
    return Generated.Decode
  }
  if name == "describe" {
    return Generated.Describe
  }
  // The conversion from text of a literal type, reached through a bound rather than by name
  if name == "tryFrom" {
    return Generated.LiteralParse
  }
  reportUnsupported lowering, "a derived `{name}` the back end does not generate", at
  None
}

/** What the manifest's `.Derived` entry means for the lowering: the same vocabulary, in the lowering's own words. */
public fn derivedKindOf(var lowering: Lowering, derived: DerivedKind, at: Span): Generated? {
  match derived {
    .Show => Generated.Show
    .ShowNested => Generated.ShowNested
    .Equals => Generated.Equals
    .Compare => Generated.Compare
    .Hash => Generated.Hash
    .Absolute => Generated.Absolute
    .Identity => Generated.Identity
    .Copy => {
      reportUnsupported lowering, "a derived `copy` of a native type", at
      None
    }
  }
}

/** `"Int64"`, `"String"`, `""` for a free function: the owner component of a manifest entry. */
public fn ownerNameOf(var lowering: Lowering, member: SymbolId): String {
  const site = match lowering.checker.siteOf(member) {
    Some(found) => found
    None => {
      return ""
    }
  }
  if const .Owned(owner, _, _) = site.kind {
    const found = match owner {
      Some(inner) => inner
      None => {
        return ""
      }
    }
    if const .Nominal(symbol, _) = lowering.checker.types.form(found) {
      return lowering.checker.symbolAt(symbol).name
    }
  }
  ""
}

/**
 * The substitution one member is instantiated under: the generic parameters of its owner, filled in from the type the
 * member was reached on, plus the `Self` of a trait where the owner is one.
 */
public fn memberMappingOf(
  var lowering: Lowering,
  member: SymbolId,
  subject: TypeId,
  bound: TypeId,
): Map<ParameterId, TypeId> {
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  var mapping: Map<ParameterId, TypeId> = [:]
  const owner = match signature.owner {
    Some(found) => found
    None => {
      return mapping
    }
  }
  if const .Parameter(parameter) = lowering.checker.types.form(owner) {
    mapping.set parameter, subject
    // A **blanket** implementation declares the parameter itself, and then its own list and the trait's are two
    // different lists (`addBlanketArguments`)
    if isDeclaredParameter(lowering, parameter) {
      addBlanketArguments lowering, mapping, signature.generics, subject, bound
      return mapping
    }
    // A member of the trait itself: `Self` is the target, and the trait's own arguments come out of the trait that
    // *declares* the member for that target - the bound a call resolved may be a subtrait, whose arguments say nothing
    // about this one (`Int64 with Signed` is what provides `TryFrom<String, NumberParseError>`)
    const applied = appliedArgumentsOf lowering, parameter, subject, bound
    addTraitArguments lowering, mapping, signature.generics, applied
    return mapping
  }
  const generics = signature.generics
  const _ = matchTypePattern lowering.checker, owner, subject, generics, mapping
  mapping
}

/**
 * The arguments the trait that declares a member has for one type: `TryFrom<String, NumberParseError>` for an `Int64`, whatever
 * bound a call site happened to resolve. The bound's own arguments stand in where the declaring trait cannot be found.
 */
fn appliedArgumentsOf(var lowering: Lowering, parameter: ParameterId, subject: TypeId, bound: TypeId): List<TypeId> {
  if const Some(declaring) = lowering.checker.types.parameter(parameter).owner {
    // The bound is the declaring trait itself: its arguments are the answer, and a type that implements the trait more
    // than once (`AppError` made from a `ConfigError` and from a `Never`) has no other single one
    if const .Nominal(symbol, given) = lowering.checker.types.form(bound) {
      if symbol == declaring && isClosedType(lowering, bound) {
        return given
      }
    }
    if const Some(found) = traitArgumentsOf(lowering.checker, subject, declaring) {
      return found
    }
  }
  match lowering.checker.types.form(bound) {
    .Nominal(_, given) => given
    _ => []
  }
}

/**
 * Whether the parameter an owner is stands in a source: the `Self` of a trait is declared nowhere and everything else
 * is written in a `fn`, a `type`, a `trait` or an `extend`.
 */
fn isDeclaredParameter(var lowering: Lowering, parameter: ParameterId): Bool {
  lowering.checker.types.parameter(parameter).symbol.isSome()
}

/**
 * A member a **blanket** implementation owns:
 * `extend<Source, Target> Source with Into<Target> where Target: From<Source>` is the one the language ships. Its
 * parameters are its own, so the trait's arguments do not fill them in declaration order: the receiver decides
 * `Source`, and `Target` comes out of matching the implementation's `with` clause against the bound the call resolved -
 * `Into<Target>` against `Into<Path>`. Filling them in the trait's order instead binds `Source` to `Path` and leaves
 * `Target` with nothing, and no instance can be built from that.
 *
 * The inner witness the `where` asks for needs no entry of its own: once `Target` is `Path` and `Source` is `String`,
 * the body `Target.from self` is the ordinary static call `Path.from(text)`.
 */
fn addBlanketArguments(
  var lowering: Lowering,
  var mapping: Map<ParameterId, TypeId>,
  generics: List<ParameterId>,
  subject: TypeId,
  bound: TypeId,
) {
  const implementation = match witnessFor(lowering.checker, subject, bound) {
    .Implementation(found, _, _) => found
    _ => {
      return
    }
  }
  const capability = match lowering.checker.implementations.at(implementation).capability {
    Some(found) => found
    None => {
      return
    }
  }
  const _ = matchTypePattern lowering.checker, capability, bound, generics, mapping
}

/** `trait Iterate<Item>`: the arguments of the trait fill its own parameters, in declaration order. */
fn addTraitArguments(
  var lowering: Lowering,
  var mapping: Map<ParameterId, TypeId>,
  generics: List<ParameterId>,
  arguments: List<TypeId>,
) {
  for index in 0..generics.length().min(arguments.length()) {
    mapping.set generics[index], arguments[index]
  }
}

// --- What is in a table, and where -----------------------------------------------------------------------------------

/** One member of a table: the declaration, and the trait that requires it - which may be a supertrait. */
public type TableMember {
  member: SymbolId
  bound: TypeId
}

/**
 * The members of the table of one bound, in the order a back end indexes them: the required members the ABI can reach,
 * in declaration order, then the same of every supertrait in declaration order.
 *
 * Three kinds of member are left out, and every one of them is a member object safety already forbids on a trait-typed
 * value (TYPECHECKER 4.4): one that mentions `Self` anywhere but as its receiver (`equals`, `compare`), a static one,
 * and one with generic parameters of its own, whose call would need witnesses appended. A call of one through a table is
 * therefore a clean "the member is not in the table" finding and never a wrong call.
 *
 * Two kinds of them get a slot behind the fixed members once the program calls one on a trait-typed value: a member with
 * type parameters of its own, one slot per list of arguments ([genericSlotOf]), and a member that answers **exactly**
 * `Self` and takes no second one ([isSelfAnswerSlot]) - on a trait-typed receiver `Self` is the receiver's own trait
 * type, so the answer is a payload of the receiver's type again and the receiver's tables fit it. That slot points at a
 * function that boxes the implementation's answer ([selfAnswerOf]), which is what makes `bytes[from..to]` on a `Bytes`
 * reach the O(1) `ArrayList.slice` instead of the default that copies.
 *
 * A **`var self`** member *is* in a table: its thunk takes the address of the payload inside the box, and the caller
 * makes that box unique first, which is what the `size` and the two helpers in the table are for. Without it
 * `List.append`, `Map.set`, `Set.insert` and `Iterator.next` would be unreachable on a trait-typed value, and every
 * collection of the language is one.
 *
 * A **default** member is in the table only where some implementation of the program **overrides** it: which of the
 * two a trait-typed value reaches is a run-time question exactly then. A default that nothing overrides is dispatched
 * statically with `Self` bound to the trait type itself, because a default body reaches `self` only through the
 * trait's own members - so one instance per trait type serves every implementer and what runs is what would have run
 * anyway. That is what bounds the instance set: `Iterate.indexed` is `Zipped(0.., self)`, so a table that held it
 * would need the table of `Iterate<(Int, Item)>` for `Zipped<Int, Item>`, which holds `indexed` again, and the
 * worklist would never end - a witness table holds only the members a type overrides, not its trait's defaults
 * (BACKEND 5.6).
 */
public fn tableMembersOf(var lowering: Lowering, bound: TypeId, subject: TypeId): List<TableMember> {
  var found: List<TableMember> = []
  addTableMembers lowering, found, bound, subject, 0
  found
}

/** Whether the list already holds a member of this name, which is what keeps a shared supertrait out of it twice. */
fn hasMemberNamed(var lowering: Lowering, found: List<TableMember>, name: String): Bool {
  for one in found {
    if lowering.checker.symbolAt(one.member).name == name {
      return true
    }
  }
  false
}

fn addTableMembers(var lowering: Lowering, var found: List<TableMember>, bound: TypeId, subject: TypeId, depth: Int) {
  if depth > 6 {
    return
  }
  const symbol = match lowering.checker.types.form(bound) {
    .Nominal(inner, _) => inner
    _ => {
      return
    }
  }
  const identifier = typeSignatureOf lowering.checker, symbol
  const shape = lowering.checker.typeSignature identifier
  // The generic parameters of the trait itself are in scope of every one of its members, so only the ones behind them
  // are the member's own - and a member with its own parameters would need witnesses appended
  const inherited = shape.generics.length()
  for (name, member) in shape.members {
    if hasMemberNamed(lowering, found, name) {
      continue
    }
    if !isTableMember(lowering, member, inherited) {
      continue
    }
    if isUnoverriddenDefault(lowering, member, name) {
      continue
    }
    found.append TableMember(member, bound)
  }
  for supertrait in supertraitsOfBound(lowering.checker, bound, subject) {
    addTableMembers(lowering, found, supertrait, subject, depth + 1)
  }
}

/**
 * Whether a member is a **default** that nothing in the program overrides, which is what keeps it out of every witness
 * table. Such a member is dispatched statically with `Self` bound to the trait type of the erased value
 * (`dynamicDispatch` in `ir/lower/generic.trb`), which is the mechanism a default with generic parameters of its own has
 * used since 5.6 - and it is sound for the same reason: a default body reaches `self` only through the members of its
 * trait, so the one instance built for the trait type behaves like the per-type instance would.
 *
 * "Overridden anywhere in the program" is a **closed-world** property, and the back end may ask it because it sees the
 * whole program: one translation unit in C, and whole modules in the VM. A separately compiled package would need the
 * table layout of a trait fixed per *program* rather than per package - which it already is, because a table is emitted
 * with the program that uses it and its member order is computed from the same closed world.
 */
fn isUnoverriddenDefault(var lowering: Lowering, member: SymbolId, name: String): Bool {
  const identifier = signatureOf lowering.checker, member
  if !lowering.checker.signature(identifier).hasBody {
    return false
  }
  !isOverriddenDefault(lowering, member, name)
}

/** Whether some implementation of the program overrides this default. Built once, over the whole program. */
fn isOverriddenDefault(var lowering: Lowering, member: SymbolId, name: String): Bool {
  if !lowering.overriddenMembersAreKnown {
    collectOverriddenMembers lowering
  }
  lowering.overriddenMembers.containsKey member
}

/**
 * Every default some implementation of the program overrides: for each implementation of a trait, each default of that
 * trait and of its supertraits that the implementation answers with a declaration of its own - which is every way an
 * override can be **written**: the members of an `extend ... with` block, the body of a `type ... with`, and the body of
 * the implementation's target, which `providerOf` reaches as well.
 *
 * The question is asked **per trait and per signature**, and the answer is the one the table itself is built from
 * (`declaredMemberOf`): a declaration counts only where it can *be* the member (`providesMember`), and only for the
 * traits the implementation implements. Asked by name alone, the `all(name)` of `std/http`'s `Headers`, which is a
 * `Show` and an `Equals` and nothing iterable, made `Iterate.all` and `Iterate.any` overridden in every program that
 * imports `std/http`, and put both into every witness table of `Iterate` there.
 *
 * It still over-approximates where it has to. Reading a declaration as an override that nothing really overrides costs
 * one slot in one table; *missing* one would run the default where the override should have run, which is observable.
 *
 * The **fields** of a target are deliberately not overrides, although `providerOf` answers a member with one: a field is
 * not a method and cannot be the body of a default, and one field of the compiler is called `indexed` - which would put
 * `Iterate.indexed` back into every table and bring the non-terminating worklist back with it.
 */
fn collectOverriddenMembers(var lowering: Lowering) {
  lowering.overriddenMembersAreKnown = true
  // Every name some implementation of the program writes at all: a default whose name is not among them is overridden
  // nowhere, which spares the far more expensive `providerOf` for most of them
  var written: Map<String, Bool> = [:]
  var implementations: List<Int> = []
  const total = lowering.checker.implementations.all.length()
  for index in 0..total {
    const implementation = lowering.checker.implementations.all[index]
    if !isProgramPackage(lowering, implementation.package) {
      continue
    }
    for (name, _) in implementation.members {
      written.set name, true
    }
    addTargetMembers lowering, written, implementation.target
    implementations.append index
  }
  for index in implementations {
    addOverriddenDefaults lowering, written, index
  }
}

/**
 * The defaults one implementation overrides. A **derived** implementation writes nothing, and one whose target is a
 * **trait** overrides only with what its own block writes: `extend<Item: Show> List<Item> with Show` has `List<Item>` as
 * its target, and reading the defaults of `List` there as overrides would put every one of them back into every table.
 */
fn addOverriddenDefaults(var lowering: Lowering, written: Map<String, Bool>, index: Int) {
  const implementation = lowering.checker.implementations.all[index]
  if const .Derived = implementation.origin {
    return
  }
  const capability = match implementation.capability {
    Some(found) => found
    None => {
      return
    }
  }
  const ownOnly = isTraitTarget lowering, implementation.target
  var traits: List<SymbolId> = []
  addTraitClosure lowering, traits, capability, implementation.target, 0
  for symbol in traits {
    const identifier = typeSignatureOf lowering.checker, symbol
    const shape = lowering.checker.typeSignature identifier
    for (name, member) in shape.members {
      if !written.containsKey(name) || lowering.overriddenMembers.containsKey(member) {
        continue
      }
      const provider = if ownOnly {
        implementation.members.get name
      } else {
        memberOfImplementation lowering.checker, ImplementationId(index), name
      }
      const found = match provider {
        Some(inner) => inner
        None => {
          continue
        }
      }
      if found == member {
        continue
      }
      if const .Field(_) = lowering.checker.symbolAt(found).kind {
        continue
      }
      const signature = signatureOf lowering.checker, member
      if !lowering.checker.signature(signature).hasBody {
        continue
      }
      if providesMember(lowering, member, found) {
        lowering.overriddenMembers.set member, true
      }
    }
  }
}

/** A trait and every supertrait of it, by symbol and once each. */
fn addTraitClosure(var lowering: Lowering, var traits: List<SymbolId>, bound: TypeId, subject: TypeId, depth: Int) {
  if depth > 6 {
    return
  }
  const symbol = match lowering.checker.types.form(bound) {
    .Nominal(inner, _) => inner
    _ => {
      return
    }
  }
  if traits.contains(symbol) {
    return
  }
  traits.append symbol
  for supertrait in supertraitsOfBound(lowering.checker, bound, subject) {
    addTraitClosure(lowering, traits, supertrait, subject, depth + 1)
  }
}

fn isTraitTarget(var lowering: Lowering, target: TypeId): Bool {
  if const .Nominal(symbol, _) = lowering.checker.types.form(target) {
    if const .Trait = lowering.checker.symbolAt(symbol).kind {
      return true
    }
  }
  false
}

/**
 * Whether a package is part of the program. **The closed world of a closed-world question is the program**, never the
 * whole `SourceTree` - and `readSourceTree` reads the entire workspace whatever is being lowered, so without this an
 * unrelated package next to yours changes the member list of your witness tables and with it your binary. Adding
 * `examples/encoding-lab`, which overrides defaults of `Iterate` for types of its own, took the instance count of
 * `source.trb`'s program from 121 declarations to 192.
 */
fn isProgramPackage(var lowering: Lowering, package: Int): Bool {
  if lowering.programPackages.isEmpty() {
    return true
  }
  lowering.programPackages.containsKey package
}

/**
 * The names of the members of the target of an implementation. A target whose head is a **trait** contributes nothing
 * (`addOverriddenDefaults` says why).
 */
fn addTargetMembers(var lowering: Lowering, var written: Map<String, Bool>, target: TypeId) {
  const symbol = match lowering.checker.types.form(target) {
    .Nominal(found, _) => found
    _ => {
      return
    }
  }
  if const .Trait = lowering.checker.symbolAt(symbol).kind {
    return
  }
  const identifier = typeSignatureOf lowering.checker, symbol
  const shape = lowering.checker.typeSignature identifier
  for (name, _) in shape.members {
    written.set name, true
  }
}

fn isTableMember(var lowering: Lowering, member: SymbolId, inherited: Int): Bool {
  if const .Function = lowering.checker.symbolAt(member).kind {
    const identifier = signatureOf lowering.checker, member
    const signature = lowering.checker.signature identifier
    if !signature.takesSelf {
      return false
    }
    // A member with generic parameters or a `where` clause of its own is conditionally available (4.3)
    if signature.generics.length() > inherited || !signature.bounds.isEmpty() {
      return false
    }
    const owner = match signature.owner {
      Some(found) => found
      None => {
        return false
      }
    }
    const parameter = match lowering.checker.types.form(owner) {
      .Parameter(found) => found
      _ => {
        return false
      }
    }
    return !mentionsSelfElsewhere(lowering, signature.form.result, parameter)
      && !anyParameterMentions(lowering, signature, parameter)
  }
  false
}

/**
 * Whether a call of this member on a trait-typed value goes through a slot of the table: a member that answers exactly
 * `Self` and takes no second one, which some implementation of the program answers itself - a required member, or a
 * default an implementation overrides (`List.slice`, which `ArrayList` answers in O(1)).
 *
 * Such a slot is not one of the fixed members of every table. It is added the way a member with type parameters of its
 * own is (`genericSlotOf`), once the program calls it: a table of `List<Item>` is built for every item type of the
 * program, and a slot of `slice` in each of them would instantiate `ArrayList.slice` and the function around it for
 * every one, called or not. The function it points at boxes the implementation's answer with the table ([selfAnswerOf]).
 */
public fn isSelfAnswerSlot(var lowering: Lowering, member: SymbolId): Bool {
  if !answersSelf(lowering, member) {
    return false
  }
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  if !signature.takesSelf || !signature.bounds.isEmpty() || anySelfParameter(lowering, signature) {
    return false
  }
  if !signature.hasBody {
    return true
  }
  isOverriddenDefault lowering, member, lowering.checker.symbolAt(member).name
}

/** Whether a parameter of a member of a trait mentions the trait's `Self`: a second value of the concrete type. */
fn anySelfParameter(var lowering: Lowering, signature: Signature): Bool {
  const owner = match signature.owner {
    Some(found) => found
    None => {
      return false
    }
  }
  if const .Parameter(parameter) = lowering.checker.types.form(owner) {
    return anyParameterMentions lowering, signature, parameter
  }
  false
}

/**
 * Whether a member of a trait answers exactly `Self` - `List.slice`, `Negate.negate` - which puts its slot behind a
 * function that boxes the answer ([selfAnswerOf]) and makes the call site read it as a value of the receiver's type.
 */
public fn answersSelf(var lowering: Lowering, member: SymbolId): Bool {
  const identifier = signatureOf lowering.checker, member
  const signature = lowering.checker.signature identifier
  const owner = match signature.owner {
    Some(found) => found
    None => {
      return false
    }
  }
  if const .Parameter(parameter) = lowering.checker.types.form(owner) {
    return isSelfOf lowering, signature.form.result, parameter
  }
  false
}

/** Whether a type is the parameter itself, and not a type that mentions it. */
fn isSelfOf(var lowering: Lowering, id: TypeId, parameter: ParameterId): Bool {
  if const .Parameter(found) = lowering.checker.types.form(id) {
    return found == parameter
  }
  false
}

fn anyParameterMentions(var lowering: Lowering, signature: Signature, parameter: ParameterId): Bool {
  for one in signature.form.parameters {
    if mentionsSelfElsewhere(lowering, one.annotation, parameter) {
      return true
    }
  }
  false
}

/** Whether `Self` occurs in a type. A member that says `Self` has no meaning on a trait-typed value. */
fn mentionsSelfElsewhere(var lowering: Lowering, id: TypeId, parameter: ParameterId): Bool {
  match lowering.checker.types.form(id) {
    .Parameter(found) => found == parameter
    .Nominal(_, arguments) => anyMentions lowering, arguments, parameter
    .Traits(bounds) => anyMentions lowering, bounds, parameter
    .Literals(base, _) => mentionsSelfElsewhere lowering, base, parameter
    .Constant(_, of) => mentionsSelfElsewhere lowering, of, parameter
    .Tuple(fields) => {
      for field in fields {
        if mentionsSelfElsewhere(lowering, field.annotation, parameter) {
          return true
        }
      }
      false
    }
    .Function(form) => {
      for one in form.parameters {
        if mentionsSelfElsewhere(lowering, one.annotation, parameter) {
          return true
        }
      }
      mentionsSelfElsewhere lowering, form.result, parameter
    }
    _ => false
  }
}

fn anyMentions(var lowering: Lowering, arguments: List<TypeId>, parameter: ParameterId): Bool {
  for argument in arguments {
    if mentionsSelfElsewhere(lowering, argument, parameter) {
      return true
    }
  }
  false
}

/** The member a trait declares under a name, whether it is required or a default. */
public fn traitMemberNamed(var lowering: Lowering, bound: TypeId, name: String): SymbolId? {
  const symbol = match lowering.checker.types.form(bound) {
    .Nominal(found, _) => found
    _ => {
      return None
    }
  }
  const identifier = typeSignatureOf lowering.checker, symbol
  const shape = lowering.checker.typeSignature identifier
  shape.members.get name
}

/** Where a member of a trait-typed value sits: the table one of its bounds carries, and the slot inside that table. */
public type MemberInValue {
  source: WitnessSource
  member: Int
}

/**
 * Which witness pointer of a trait-typed value carries a member, and at which index. The bounds of the value are walked
 * in order and each one's table is searched, so a member the value reaches through a supertrait is found in the table of
 * the bound that has that supertrait - which is why the members of a supertrait are flattened into it.
 */
public fn memberInValue(
  var lowering: Lowering,
  bounds: List<TypeId>,
  subject: TypeId,
  place: Reference,
  member: SymbolId,
): MemberInValue? {
  const name = lowering.checker.symbolAt(member).name
  for index in 0..bounds.length() {
    const members = tableMembersOf lowering, bounds[index], subject
    for position in 0..members.length() {
      if lowering.checker.symbolAt(members[position].member).name == name {
        const empty: List<Int> = []
        return MemberInValue WitnessSource(WitnessRoot.Value(place, index), empty), position
      }
    }
  }
  None
}

// --- Members with type parameters of their own -----------------------------------------------------------------------

/**
 * Where a member with type parameters of its own sits in the tables of one trait, for one list of arguments: behind the
 * fixed members, one slot per list the program calls it with. `lines().onto(Collected())` asks `Stage.onto` for one
 * `Final`, and every table of that `Stage<Input, Output>` - the ones built already and every one built later - gets the
 * instance of its own type's `onto` for that `Final` at the same position.
 *
 * The set of lists is closed because the program is: a generic member is instantiated for the arguments a call site
 * decided, exactly as a generic function is, and a table is static data emitted once the whole program is lowered.
 */
public fn genericSlotOf(
  var lowering: Lowering,
  bound: TypeId,
  subject: TypeId,
  member: SymbolId,
  arguments: List<TypeId>,
  at: Span,
): Int? {
  const applied = traitIdOf(lowering, bound).value
  const fixed = tableMembersOf(lowering, bound, subject).length()
  var slots = lowering.genericSlots.get(applied) ?? []
  const key = genericSlotKey member, arguments
  for index in 0..slots.length() {
    if slots[index].key == key {
      return fixed + index
    }
  }
  const slot = GenericSlot member, arguments, key
  const position = fixed + slots.length()
  slots.append slot
  lowering.genericSlots.set applied, slots
  for index in 0..lowering.program.witnessTables.length() {
    const table = lowering.program.witnessTables[index]
    if table.applied.value != applied {
      continue
    }
    const source = match lowering.tableSources.get(index) {
      Some(found) => found
      None => {
        reportUnsupported lowering, "a witness table the back end cannot add a member to", at
        return None
      }
    }
    if table.members.length() != position {
      reportUnsupported lowering, "a witness table whose members do not line up with its trait", at
      return None
    }
    var built = genericMemberFunctionOf(lowering, source.subject, source.bound, source.implementation, slot, at)?
    // A member that answers `Self` is reached through the function that boxes its answer with this table
    if arguments.isEmpty() && answersSelf(lowering, member) {
      const tableId = WitnessTableId index
      built = selfAnswerOf(lowering, built, member, tableId, source.subject, source.bound, at)?
    }
    var members = lowering.program.witnessTables[index].members
    members.append built
    lowering.program.witnessTables.set index, lowering.program.witnessTables[index].copy(members: members)
  }
  position
}

fn genericSlotKey(member: SymbolId, arguments: List<TypeId>): String {
  var parts = ["{member.value}"]
  for argument in arguments {
    parts.append "{argument.value}"
  }
  parts.joined separator: ":"
}

/** The instance of one generic slot for one table: the implementation's own member, with its own parameters filled in. */
fn genericMemberFunctionOf(
  var lowering: Lowering,
  subject: TypeId,
  bound: TypeId,
  implementation: ImplementationId,
  slot: GenericSlot,
  at: Span,
): FunctionId? {
  const name = lowering.checker.symbolAt(slot.member).name
  const provider = providerOfMember lowering, subject, implementation, slot.member, name
  var mapping = memberMappingOf lowering, provider, subject, bound
  const identifier = signatureOf lowering.checker, provider
  const signature = lowering.checker.signature identifier
  // The member's own parameters are the last ones of its signature: the ones before them belong to its owner
  const first = signature.generics.length() - slot.arguments.length()
  if first < 0 || !signature.hasBody {
    reportUnsupported lowering, "`{name}`", at, "no instance of that member can be built"
    return None
  }
  for index in 0..slot.arguments.length() {
    mapping.set signature.generics[first + index], slot.arguments[index]
  }
  const built = instanceFor lowering, provider, mapping
  if built.isNone() {
    reportUnsupported lowering, "`{name}`", at, "no instance of that member can be built"
  }
  built
}

/**
 * [memberInValue] for a member with type parameters of its own: the bound of the value whose trait declares it, and the
 * slot of these arguments in its table.
 */
public fn genericMemberInValue(
  var lowering: Lowering,
  bounds: List<TypeId>,
  subject: TypeId,
  place: Reference,
  member: SymbolId,
  arguments: List<TypeId>,
  at: Span,
): MemberInValue? {
  const name = lowering.checker.symbolAt(member).name
  for index in 0..bounds.length() {
    if traitMemberNamed(lowering, bounds[index], name) == member {
      const position = genericSlotOf(lowering, bounds[index], subject, member, arguments, at)?
      const empty: List<Int> = []
      return MemberInValue WitnessSource(WitnessRoot.Value(place, index), empty), position
    }
  }
  reportUnsupported lowering, "`{name}`", at, "a supertrait declares it, and it has type parameters of its own"
  None
}

/** Whether a member can be reached through the table of one of the bounds at all, which is what makes a call dynamic. */
public fn isInTable(var lowering: Lowering, bounds: List<TypeId>, subject: TypeId, member: SymbolId): Bool {
  memberInValue(lowering, bounds, subject, Reference(Slot(0), []), member).isSome()
}

/** Whether one of the bounds of a trait-typed value is exactly this trait, which a narrowing coercion asks. */
public fn boundIndexOf(var lowering: Lowering, bounds: List<TypeId>, bound: TypeId): Int {
  for index in 0..bounds.length() {
    if sameType(lowering.checker.types, bounds[index], bound) {
      return index
    }
  }
  -1
}

/**
 * Where the table of a **supertrait** of one of a value's bounds sits: the index of the bound, and then one `nested`
 * index per step down the supertrait lists. `List<Item>` narrowed to `Iterate<Item>` is bound 0 step 0, because
 * `Iterate<Item>` is the first supertrait of `List<Item>`.
 *
 * The steps are positions in `supertraitsOfBound` and therefore a static property of the **trait**, which is exactly why
 * an erased payload can be narrowed at all: nothing about the path depends on the type the value has hidden.
 */
public fn narrowingPathOf(
  var lowering: Lowering,
  bounds: List<TypeId>,
  subject: TypeId,
  bound: TypeId,
): WitnessSource? {
  for index in 0..bounds.length() {
    var steps: List<Int> = []
    if stepsToBound(lowering, bounds[index], subject, bound, steps, 0) {
      return WitnessSource WitnessRoot.Value(Reference(Slot(0), []), index), steps
    }
  }
  None
}

/** Depth-first over the supertraits, writing the indices of the path it took. The trait graph is a DAG and shallow. */
fn stepsToBound(
  var lowering: Lowering,
  from: TypeId,
  subject: TypeId,
  wanted: TypeId,
  var steps: List<Int>,
  depth: Int,
): Bool {
  if depth > 6 {
    return false
  }
  const supertraits = supertraitsOfBound lowering.checker, from, subject
  for index in 0..supertraits.length() {
    if sameType(lowering.checker.types, supertraits[index], wanted) {
      steps.append index
      return true
    }
  }
  for index in 0..supertraits.length() {
    steps.append index
    if stepsToBound(lowering, supertraits[index], subject, wanted, steps, depth + 1) {
      return true
    }
    const _ = steps.removeAt(steps.length() - 1)
  }
  false
}
