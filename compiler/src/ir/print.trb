/**
 * The text format of the IR: what `torb ir <path>`, `torb build --emit-ir` and every snapshot test show.
 *
 * It is deterministic by construction. Blocks come in the order the lowering created them, slots in declaration order,
 * one instruction per line, `owned`/`borrowed`/`last` written out on every argument, source locations as
 * `path:line:column` with forward slashes relative to the workspace root, and nothing else on a line. Everything that
 * is program-wide - layouts, element descriptors, witness tables, static values, functions - is sorted by its mangled
 * name before it is written, so the text is a function of the *instance set* and not of the traversal that found it.
 *
 * A test that compares this text catches an ownership regression far earlier than a C-level test can.
 */

use IrTypeId, IrType, IrProgram, IrFunction, IrSignature, IrParameter, TraitId, RuntimeKind from "./ir"
use Block, BlockId, Slot, SlotDeclaration, SlotRole, Instruction, Terminator, Argument, Ownership from "./ir"
use Reference, PathStep, Capture, WitnessSource, Intrinsic, IntrinsicOperation, NumericKind from "./ir"
use LayoutId, LocationId, Location, StaticValue, StaticContents, ElementDescriptor, WitnessTable from "./ir"
use FunctionKind, ResultMode, IrSignatureId, FunctionId from "./ir"
use Layout, FieldLayout, Representation from "./layout"
use LiteralValue, describeLiteral from "../semantics/checker/type"

/** The whole program, in the order a reader needs it: what things are, then what they do. */
public fn printProgram(program: IrProgram): String {
  var lines: List<String> = []
  var layouts = program.layouts
  layouts.sort({ _.name })
  for layout in layouts {
    lines.append printLayout(program, layout)
  }
  var elements = program.elements
  elements.sort({ _.name })
  for element in elements {
    lines.append printElement(program, element)
  }
  var tables = program.witnessTables
  tables.sort({ _.name })
  for table in tables {
    lines.append printWitnessTable(program, table)
  }
  var statics = program.statics
  statics.sort({ _.name })
  for value in statics {
    lines.append printStatic(program, value)
  }
  var functions = program.functions
  functions.sort({ _.name })
  for function in functions {
    if !lines.isEmpty() {
      lines.append ""
    }
    lines.appendAll functionLines(program, function)
  }
  lines.joined separator: "\n"
}

/** One function, as the snapshot tests compare it. */
public fn printFunction(program: IrProgram, function: IrFunction): String {
  functionLines(program, function).joined(separator: "\n")
}

fn functionLines(program: IrProgram, function: IrFunction): List<String> {
  var lines: List<String> = []
  const head = "({printParameters(program, function.signature)}) -> {printResult(program, function.signature)}"
  // A `native fn` the runtime provides has no body at all: the symbol it is is everything a back end needs
  if const .Runtime(symbol) = function.kind {
    return ["runtime fn {function.name}{head} = {symbol}"]
  }
  // The accessor of an immortal constant is its initializer and nothing else: the cell and the flag are the back end's
  if const .ConstantCell(initializer) = function.kind {
    const built = if program.hasFunction(initializer) { program.functionAt(initializer).name } else { "?" }
    return ["constant fn {function.name}{head} = {built}"]
  }
  // An access to an entry cell is the cell and what it does with it: the storage is the back end's
  if const .EntryCell(cell, access) = function.kind {
    return ["cell fn {function.name}{head} = {access} {cell}"]
  }
  const prefix = match function.kind {
    .TaskResume => "task "
    _ => ""
  }
  lines.append "{prefix}fn {function.name}{head} \{"
  for index in 0..function.slots.length() {
    lines.append "  {printSlot(program, index, function.slots[index])}"
  }
  for index in 0..function.blocks.length() {
    const block = function.blocks[index]
    lines.append "b{index}:{printBlockComment(program, block)}"
    for instruction in block.instructions {
      lines.append "  {printInstruction(program, function, instruction)}"
    }
    lines.append "  {printTerminator(program, function, block.terminator)}"
  }
  lines.append "\}"
  lines
}

fn printParameters(program: IrProgram, signature: IrSignature): String {
  var parts: List<String> = []
  for parameter in signature.parameters {
    parts.append printParameter(program, parameter)
  }
  for index in 0..signature.witnesses.length() {
    parts.append "witness {index}: {describeTrait(program, signature.witnesses[index])}"
  }
  parts.joined separator: ", "
}

fn printParameter(program: IrProgram, parameter: IrParameter): String {
  const reference = if parameter.out {
    "out "
  } else if parameter.byReference {
    "var "
  } else if parameter.byAddress {
    "byAddress "
  } else {
    ""
  }
  const name = if parameter.name.isEmpty() { "" } else { "{parameter.name}: " }
  "{reference}{name}{describeIrType(program, parameter.annotation)} {printOwnership(parameter.ownership)}"
}

fn printResult(program: IrProgram, signature: IrSignature): String {
  const shown = describeIrType program, signature.result
  match signature.resultMode {
    .ByValue => shown
    .ByPointer => "{shown} byPointer"
  }
}

fn printSlot(program: IrProgram, index: Int, slot: SlotDeclaration): String {
  const role = match slot.role {
    .Parameter(_) => "parameter"
    .Local => "local"
    .Temporary => "temporary"
    .Environment => "environment"
    .ResultPointer => "result"
  }
  const name = if slot.name.isEmpty() { "" } else { " {slot.name}" }
  "slot %{index} {role}{name}: {describeIrType(program, slot.annotation)}"
}

fn printBlockComment(program: IrProgram, block: Block): String {
  var parts: List<String> = []
  if const Some(at) = block.at {
    const location = program.locationAt at
    parts.append "{location.path}:{location.line}"
  }
  if !block.label.isEmpty() {
    parts.append block.label
  }
  if parts.isEmpty() {
    return ""
  }
  " # {parts.joined(separator: " ")}"
}

// --- Instructions ---------------------------------------------------------------------------------------------------

/** One instruction, in the text format `torb ir` and the snapshot tests print. */
public fn printInstruction(program: IrProgram, function: IrFunction, instruction: Instruction): String {
  match instruction {
    .Constant(target, value) => "{printTarget(target)}constant {program.staticAt(value).name}"
    .Move(target, source) => "{printTarget(target)}move %{source.value}"
    .Copy(target, source) => "{printTarget(target)}copy %{source.value}"
    .Retain(slot) => "retain %{slot.value}"
    .Release(slot) => "release %{slot.value}"
    .EndOfScope(slot) => "endOfScope %{slot.value}"
    .Clear(target) => "{printTarget(target)}clear"
    .MakeUnique(reference) => "makeUnique {printReference(program, reference)}"
    .Call(target, callee, arguments, witnesses, at) => {
      const head = "{printOptionalTarget(target)}call {program.functionAt(callee).name}"
      const site = match at {
        Some(found) => " at {printLocation(program, found)}"
        None => ""
      }
      "{head}({printArguments(program, arguments)}){printWitnesses(program, witnesses)}{site}"
    }
    .CallClosure(target, callee, arguments, _) => {
      "{printOptionalTarget(target)}callClosure %{callee.value}({printArguments(program, arguments)})"
    }
    .CallWitness(target, witness, member, arguments, _) => {
      const source = printWitnessSource program, witness
      "{printOptionalTarget(target)}callWitness {source} member {member}({printArguments(program, arguments)})"
    }
    .Intrinsic(target, intrinsic, arguments, at) => {
      var parts: List<String> = []
      for slot in arguments {
        parts.append "%{slot.value}"
      }
      const operands = parts.joined separator: ", "
      const head = "{printOptionalTarget(target)}intrinsic {describeIntrinsic(intrinsic)}"
      "{head} {operands} at {printLocation(program, at)}"
    }
    .Construct(target, layout, variant, fields) => {
      "{printTarget(target)}construct {printConstructed(program, layout, variant)} ({printArguments(program, fields)})"
    }
    .ArrayNew(target, items) => "{printTarget(target)}arrayNew ({printArguments(program, items)})"
    .Read(target, reference) => "{printTarget(target)}read {printReference(program, reference)}"
    .Write(reference, value) => "write {printReference(program, reference)} = {printArgument(program, value)}"
    .Tag(target, source) => "{printTarget(target)}tag %{source.value}"
    .Closure(target, callee, captures, isEscaping) => {
      const escaping = if isEscaping { "escaping" } else { "local" }
      var parts: List<String> = []
      for capture in captures {
        parts.append printCapture(program, capture)
      }
      const taken = parts.joined separator: ", "
      "{printTarget(target)}closure {program.functionAt(callee).name} captures({taken}) {escaping}"
    }
    .BoxNew(target, value) => "{printTarget(target)}boxNew {printArgument(program, value)}"
    .TraitValue(target, value, tables) => {
      var parts: List<String> = []
      for table in tables {
        parts.append printWitnessSource(program, table)
      }
      "{printTarget(target)}traitValue {printArgument(program, value)} tables({parts.joined(separator: ", ")})"
    }
    .ContainerNew(target, kind, elements) => {
      var names: List<String> = []
      for element in elements {
        names.append program.elementAt(element).name
      }
      "%{target.value} = new {describeRuntimeKind(kind)}({names.joined(separator: ", ")})"
    }
    .TakeOut(target, container, key, kind) => {
      const place = printReference program, container
      "{printTarget(target)}takeOut {place}[%{key.value}] {describeRuntimeKind(kind)}"
    }
    .PutBack(container, key, value, kind) => {
      const place = printReference program, container
      "putBack {place}[%{key.value}] = %{value.value} {describeRuntimeKind(kind)}"
    }
    .Panic(message, at) => "panic {printArgument(program, message)} at {printLocation(program, at)}"
    .Suspend(state, awaited, observes) => {
      if observes {
        return "observe state {state} %{awaited.value}"
      }
      "suspend state {state} %{awaited.value}"
    }
    .TaskNew(target, resume, result, arguments) => {
      const described = match result {
        Some(element) => program.elementAt(element).name
        None => "void"
      }
      "{printTarget(target)}taskNew {program.functionAt(resume).name}({printArguments(program, arguments)}) {described}"
    }
    .ChannelNew(target, capacity, item, at) => {
      "{printTarget(target)}channelNew %{capacity.value} {program.elementAt(item).name} at {printLocation(program, at)}"
    }
  }
}

/** How a block ends, in the text format. */
public fn printTerminator(program: IrProgram, function: IrFunction, terminator: Terminator): String {
  match terminator {
    .Jump(target) => "jump b{target.value}"
    .Branch(condition, then, otherwise) => "branch %{condition.value} then b{then.value} else b{otherwise.value}"
    .Switch(scrutinee, values, targets, otherwise) => {
      var parts: List<String> = []
      for index in 0..values.length().min(targets.length()) {
        parts.append "case {values[index]} b{targets[index].value}"
      }
      parts.append "otherwise b{otherwise.value}"
      "switch %{scrutinee.value} {parts.joined(separator: ", ")}"
    }
    .Return(value) => {
      match value {
        Some(argument) => "return {printArgument(program, argument)}"
        None => "return"
      }
    }
    .Unreachable => "unreachable"
    .Stop => "stop"
  }
}

fn printTarget(target: Slot): String {
  "%{target.value} = "
}

fn printOptionalTarget(target: Slot?): String {
  match target {
    Some(slot) => printTarget slot
    None => ""
  }
}

fn printArguments(program: IrProgram, arguments: List<Argument>): String {
  var parts: List<String> = []
  for argument in arguments {
    parts.append printArgument(program, argument)
  }
  parts.joined separator: ", "
}

/**
 * `%3 owned last`, and `&%0.x borrowed` for the argument of a `var` parameter: the `&` is what says that the position
 * takes the caller's storage and not a value, which is the one thing a reader of a call has to see at a glance.
 */
fn printArgument(program: IrProgram, argument: Argument): String {
  const last = if argument.last { " last" } else { "" }
  const operand = match argument.place {
    Some(place) => "&{printReference(program, place)}"
    None => "%{argument.slot.value}"
  }
  "{operand} {printOwnership(argument.ownership)}{last}"
}

fn printOwnership(ownership: Ownership): String {
  match ownership {
    .Borrowed => "borrowed"
    .Owned => "owned"
  }
}

fn printWitnesses(program: IrProgram, witnesses: List<WitnessSource>): String {
  if witnesses.isEmpty() {
    return ""
  }
  var parts: List<String> = []
  for witness in witnesses {
    parts.append printWitnessSource(program, witness)
  }
  " witnesses({parts.joined(separator: ", ")})"
}

fn printWitnessSource(program: IrProgram, witness: WitnessSource): String {
  var head = match witness.root {
    .Table(table) => "table {program.witnessTableAt(table).name}"
    .Parameter(index) => "parameter {index}"
    .Value(place, bound) => "value {printReference(program, place)} bound {bound}"
  }
  for step in witness.steps {
    head = head + ".{step}"
  }
  head
}

fn printCapture(program: IrProgram, capture: Capture): String {
  match capture {
    .Value(slot) => "%{slot.value} value"
    .Boxed(slot) => "%{slot.value} boxed"
    .Place(reference) => "{printReference(program, reference)} place"
  }
}

fn printConstructed(program: IrProgram, layout: LayoutId, variant: Int): String {
  if !program.hasLayout(layout) {
    return "T?{layout.value}"
  }
  const shape = program.layoutAt layout
  if !shape.hasVariant(variant) {
    return shape.name
  }
  "{shape.name}.{shape.variants[variant].name}"
}

/** `%0.x`, `%0.Circle.radius`, `%0[%3]`, `%0.*`: a place, the way the source wrote it. */
public fn printReference(program: IrProgram, reference: Reference): String {
  var shown = "%{reference.base.value}"
  for step in reference.steps {
    shown = shown + printStep(program, step)
  }
  shown
}

fn printStep(program: IrProgram, step: PathStep): String {
  match step {
    .Field(layout, index) => ".{fieldNameOf(program, layout, index)}"
    .TupleField(_, index) => ".{index}"
    .Variant(layout, variant, index) => {
      if !program.hasLayout(layout) {
        return ".variant{variant}.{index}"
      }
      const shape = program.layoutAt layout
      if !shape.hasVariant(variant) {
        return ".variant{variant}.{index}"
      }
      const fields = shape.fieldsOfVariant variant
      if index < 0 || index >= fields.length() {
        return ".{shape.variants[variant].name}.{index}"
      }
      ".{shape.variants[variant].name}.{fields[index].name}"
    }
    .Element(_, index, _, checked) => if checked { "[%{index.value}]" } else { "[%{index.value} unchecked]" }
    .Contents(_) => ".*"
  }
}

fn fieldNameOf(program: IrProgram, layout: LayoutId, index: Int): String {
  if !program.hasLayout(layout) {
    return "field{index}"
  }
  const shape = program.layoutAt layout
  if index < 0 || index >= shape.fields.length() {
    return "field{index}"
  }
  shape.fields[index].name
}

/** `path:line:column`, relative to the workspace root, or `?` for a location the program does not have. */
public fn printLocation(program: IrProgram, at: LocationId): String {
  if !program.hasLocation(at) {
    return "?"
  }
  const location = program.locationAt at
  "{location.path}:{location.line}:{location.column}"
}

// --- Layouts, static data, witnesses --------------------------------------------------------------------------------

/** One layout: its name, its representation, its size and alignment, and its fields or its variants. */
public fn printLayout(program: IrProgram, layout: Layout): String {
  var parts = ["layout", layout.name, printRepresentation(layout.representation)]
  if layout.recursive {
    parts.append "recursive"
  }
  parts.append "size"
  parts.append "{layout.size}"
  parts.append "align"
  parts.append "{layout.alignment}"
  if layout.containsCounted {
    parts.append "counted"
  }
  if layout.containsShared {
    parts.append "shared"
  }
  if layout.commonFieldCount > 0 {
    parts.append "common({printFields(program, layout.commonFields())})"
  }
  if layout.variants.isEmpty() {
    parts.append "fields({printFields(program, layout.fields)})"
  } else {
    var shown: List<String> = []
    for index in 0..layout.variants.length() {
      const variant = layout.variants[index]
      const fields = layout.fieldsOfVariant index
      if fields.isEmpty() {
        shown.append variant.name
        continue
      }
      shown.append "{variant.name}({printFields(program, fields)})"
    }
    parts.append "variants({shown.joined(separator: ", ")})"
  }
  parts.joined separator: " "
}

fn printFields(program: IrProgram, fields: List<FieldLayout>): String {
  var parts: List<String> = []
  for field in fields {
    parts.append "{field.name}: {describeIrType(program, field.annotation)}"
  }
  parts.joined separator: ", "
}

fn printRepresentation(representation: Representation): String {
  match representation {
    .Inline => "inline"
    .Boxed => "boxed"
    .Niche(variant, field) => "niche({variant}, {field})"
  }
}

/** One element descriptor: its item type, its size and alignment, and the functions it carries, where it has any. */
public fn printElement(program: IrProgram, element: ElementDescriptor): String {
  var parts = [
    "element",
    element.name,
    describeIrType(program, element.item),
    "size",
    "{element.size}",
    "align",
    "{element.alignment}",
  ]
  addFunctionPart program, parts, "retain", element.retain
  addFunctionPart program, parts, "release", element.release
  addFunctionPart program, parts, "equals", element.equals
  addFunctionPart program, parts, "hash", element.hash
  parts.joined separator: " "
}

fn addFunctionPart(program: IrProgram, var parts: List<String>, word: String, function: FunctionId?) {
  if const Some(found) = function {
    parts.append word
    parts.append program.functionAt(found).name
  }
}

/** One witness table: its members in table order, and the tables of its direct supertraits. */
public fn printWitnessTable(program: IrProgram, table: WitnessTable): String {
  var members: List<String> = []
  for member in table.members {
    members.append program.functionAt(member).name
  }
  var nested: List<String> = []
  for inner in table.nested {
    match inner {
      Some(found) => nested.append program.witnessTableAt(found).name
      None => nested.append "none"
    }
  }
  const head = "witness {table.name} {describeTrait(program, table.applied)} for {describeIrType(program, table.target)}"
  "{head} members({members.joined(separator: ", ")}) nested({nested.joined(separator: ", ")})"
}

/** One static value: its name, its type, and its contents. */
public fn printStatic(program: IrProgram, value: StaticValue): String {
  "static {value.name}: {describeIrType(program, value.annotation)} = {printContents(program, value.contents)}"
}

fn printContents(program: IrProgram, contents: StaticContents): String {
  match contents {
    .Literal(value) => describeLiteral value
    .Floating(value) => "{value}"
    .VoidValue => "void"
    .Aggregate(layout, variant, fields) => {
      var parts: List<String> = []
      for field in fields {
        parts.append program.staticAt(field).name
      }
      "{printConstructed(program, layout, variant)}({parts.joined(separator: ", ")})"
    }
    .Items(item, items) => {
      var parts: List<String> = []
      for one in items {
        parts.append program.staticAt(one).name
      }
      "{describeIrType(program, item)}[{parts.joined(separator: ", ")}]"
    }
  }
}

// --- Types ----------------------------------------------------------------------------------------------------------

/** How a type is written in the text format and in every message about the IR. */
public fn describeIrType(program: IrProgram, id: IrTypeId): String {
  if !program.hasType(id) {
    return "?"
  }
  match program.typeAt(id) {
    .Integer(width, isSigned) => {
      if isSigned {
        return "Int{width}"
      }
      "UInt{width}"
    }
    .Floating(width) => "Float{width}"
    .Boolean => "Bool"
    .Character => "Char"
    .VoidType => "Void"
    .NeverType => "Never"
    .Text => "String"
    .Record(layout) => "Record({layoutNameOf(program, layout)})"
    .Variant(layout) => "Variant({layoutNameOf(program, layout)})"
    .Tuple(layout) => "Tuple({layoutNameOf(program, layout)})"
    .SharedObject(layout) => "Shared({layoutNameOf(program, layout)})"
    .FixedArray(item, size) => "Array({describeIrType(program, item)}, {size})"
    .Closure(signature) => "Closure({describeIrSignature(program, signature)})"
    .Object(bounds) => {
      var parts: List<String> = []
      for bound in bounds {
        parts.append describeTrait(program, bound)
      }
      "Object({parts.joined(separator: " + ")})"
    }
    .Box(item) => "Box({describeIrType(program, item)})"
    .Lazy(item) => "Lazy({describeIrType(program, item)})"
    .Runtime(kind, arguments) => {
      const head = describeRuntimeKind kind
      if arguments.isEmpty() {
        return head
      }
      var parts: List<String> = []
      for argument in arguments {
        parts.append describeIrType(program, argument)
      }
      "{head}({parts.joined(separator: ", ")})"
    }
    .ConstantValue(value, _) => "const {describeLiteral(value)}"
  }
}

fn layoutNameOf(program: IrProgram, layout: LayoutId): String {
  if !program.hasLayout(layout) {
    return "T?{layout.value}"
  }
  program.layoutAt(layout).name
}

/** `(Int64, var Bool) -> Void`: the shape a closure value is called with. */
public fn describeIrSignature(program: IrProgram, id: IrSignatureId): String {
  const signature = program.signatureAt id
  var parts: List<String> = []
  for parameter in signature.parameters {
    const reference = if parameter.byReference { "var " } else { "" }
    parts.append "{reference}{describeIrType(program, parameter.annotation)}"
  }
  for witness in signature.witnesses {
    parts.append "witness {describeTrait(program, witness)}"
  }
  "({parts.joined(separator: ", ")}) -> {describeIrType(program, signature.result)}"
}

/** `Show`, `Iterate<Int64>`: the trait the way the source names it, not its mangled spelling. */
public fn describeTrait(program: IrProgram, id: TraitId): String {
  const applied = program.traitAt id
  if applied.arguments.isEmpty() {
    return applied.path.name
  }
  var parts: List<String> = []
  for argument in applied.arguments {
    parts.append describeIrType(program, argument)
  }
  "{applied.path.name}<{parts.joined(separator: ", ")}>"
}

/** `List`, `Map`, `Set`, `Task`, `Channel`, `File`, `Expression`, `Decimal`: a runtime kind, in a message and in the text format. */
public fn describeRuntimeKind(kind: RuntimeKind): String {
  match kind {
    .ListStorage => "List"
    .MapStorage => "Map"
    .SetStorage => "Set"
    .TaskObject => "Task"
    .ChannelObject => "Channel"
    .FileHandle => "File"
    .ExpressionTree => "Expression"
    .DecimalNumber => "Decimal"
  }
}

/**
 * `add.i64`, `less.f64`, `convert.i32.i64`, `textConcat`: the operation and the numeric type it works on. A conversion
 * names both, what it comes from first.
 */
public fn describeIntrinsic(intrinsic: Intrinsic): String {
  if const .Convert(to) = intrinsic.operation {
    const from = match intrinsic.kind {
      Some(kind) => suffixOfNumeric kind
      None => "?"
    }
    return "convert.{from}.{suffixOfNumeric(to)}"
  }
  const head = describeOperation intrinsic.operation
  const named = match intrinsic.kind {
    None => head
    Some(kind) => "{head}.{suffixOfNumeric(kind)}"
  }
  if intrinsic.checked {
    return named
  }
  "{named}.unchecked"
}

fn describeOperation(operation: IntrinsicOperation): String {
  match operation {
    .Add => "add"
    .Subtract => "subtract"
    .Multiply => "multiply"
    .Divide => "divide"
    .Remainder => "remainder"
    .Negate => "negate"
    .BitwiseAnd => "bitwiseAnd"
    .BitwiseOr => "bitwiseOr"
    .BitwiseExclusiveOr => "bitwiseExclusiveOr"
    .BitwiseNot => "bitwiseNot"
    .ShiftedLeft => "shiftedLeft"
    .ShiftedRight => "shiftedRight"
    .Equal => "equal"
    .NotEqual => "notEqual"
    .Less => "less"
    .LessOrEqual => "lessOrEqual"
    .Greater => "greater"
    .GreaterOrEqual => "greaterOrEqual"
    .Convert(_) => "convert"
    .BooleanNot => "booleanNot"
    .TextConcat => "textConcat"
    .TextEqual => "textEqual"
    .TextCompare => "textCompare"
    .TextByteLength => "textByteLength"
    .LazyForce => "lazyForce"
    .PrintParts => "printParts"
    .PrintErrorParts => "printErrorParts"
    .ExitWithCode => "exitWithCode"
  }
}

/** `i64`, `u8`, `f64`: how a numeric type is spelled in the name of an intrinsic. */
public fn suffixOfNumeric(kind: NumericKind): String {
  match kind {
    .Signed(width) => "i{width}"
    .Unsigned(width) => "u{width}"
    .Floating(width) => "f{width}"
  }
}

/** `Int64`, `UInt8`, `Float64`: how a numeric type is named in a message. */
public fn describeNumericKind(kind: NumericKind): String {
  match kind {
    .Signed(width) => "Int{width}"
    .Unsigned(width) => "UInt{width}"
    .Floating(width) => "Float{width}"
  }
}
