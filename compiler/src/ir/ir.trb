/**
 * The typed IR: a control flow graph of basic blocks holding three-address instructions over numbered slots.
 *
 * It is not a structured tree and not SSA, for four reasons that all point the same way (docs/BACKEND.md 1.1): the
 * VM's bytecode is a near 1:1 encoding of this form, C has `goto`, the state-machine transformation for tasks is a
 * CFG transformation, and backward liveness over a block graph is the shortest correct last-use analysis there is.
 *
 * Everything program-wide lives in a list of `IrProgram` and is addressed by an id, because values have no identity -
 * the same rule the front end follows with `ModuleId` and `SymbolId`. Types, layouts, traits, signatures and source
 * locations are *interned*, so `==` on their ids means "the same thing" and a back end never walks a type twice.
 */

use SymbolId from "../semantics/symbols"
use LiteralValue, literalKey from "../semantics/checker/type"
use Layout, LayoutKind from "./layout"
use SymbolPath from "./mangle"

// --- Ids ------------------------------------------------------------------------------------------------------------

/** The index of a type in `IrProgram.types`. Interned, so `==` means "the same type". */
public type IrTypeId {
  value: Int
}

/** The index of a layout in `IrProgram.layouts`. */
public type LayoutId {
  value: Int
}

/** The index of a function in `IrProgram.functions`. The only identity a back end needs is its mangled name. */
public type FunctionId {
  value: Int
}

/** The index of a block in the `blocks` of its own function. */
public type BlockId {
  value: Int
}

/** The index of a slot in the `slots` of its own function: a register of the frame. */
public type Slot {
  value: Int
}

/** The index of a static value in `IrProgram.statics`. */
public type StaticId {
  value: Int
}

/** The index of a source location in `IrProgram.locations`. */
public type LocationId {
  value: Int
}

/** The index of a witness table in `IrProgram.witnessTables`. */
public type WitnessTableId {
  value: Int
}

/** The index of an element descriptor in `IrProgram.elements`: what a runtime container knows about its items. */
public type ElementId {
  value: Int
}

/**
 * The index of a function signature in `IrProgram.signatures`. Not the checker's `SignatureId`: this one is
 * monomorphic and interned, and it is what the type of a closure value is made of.
 */
public type IrSignatureId {
  value: Int
}

/** The index of an applied trait in `IrProgram.traits`: `Show`, `Iterate<Int64>`. */
public type TraitId {
  value: Int
}

// --- Types ----------------------------------------------------------------------------------------------------------

/**
 * A type after monomorphization: every one of them is concrete, and every child is an id, so one form is one level
 * deep and interning is a single map lookup.
 *
 * The names differ from the types of the language where a case may not shadow a type name of the prelude - `Floating`
 * for `Float`, `Boolean` for `Bool`, `Character` for `Char`, `SharedObject` for a `shared type` - which is the rule
 * that makes the syntax tree say `TupleType` and the checker `VoidType`.
 */
public type IrType {
  /** `Int8` ... `Int64`, `UInt8` ... `UInt64`. The width is in bits. */
  case Integer(width: Int, signed: Bool)
  /** `Float32`, `Float64` */
  case Floating(width: Int)
  case Boolean
  /** A Unicode scalar value, 32 bits wide. */
  case Character
  /** The type with exactly one value. A parameter and a field of it still exist; only a result becomes `void` in C. */
  case VoidType
  /**
   * The result of a function that does not return. It is never the type of a slot, a field or a parameter, because
   * there is no value of it - the C back end turns it into `_Noreturn void`.
   */
  case NeverType
  /** `String`: a counted storage block plus a byte offset and a byte length. */
  case Text
  case Record(layout: LayoutId)
  case Variant(layout: LayoutId)
  case Tuple(layout: LayoutId)
  /** `Array<Item, Size>`: the size is the const argument, so it is part of the type. */
  case FixedArray(item: IrTypeId, size: Int)
  /** A closure value: the code pointer plus its environment. */
  case Closure(signature: IrSignatureId)
  /** A trait-typed value: the boxed payload plus one witness pointer per bound, in the order of `bounds`. */
  case Object(bounds: List<TraitId>)
  /** A `shared type` object: counted, and the one kind of block that can be part of a reference cycle. */
  case SharedObject(layout: LayoutId)
  /** A captured `var` binding. Counted - the only sharing of a variable in the language. */
  case Box(item: IrTypeId)
  /** `lazy Value` as a parameter: a one-shot memo cell holding the thunk and, after the first use, the value. */
  case Lazy(item: IrTypeId)
  /**
   * What the runtime owns: the list, the ordered hash table, the set, `Task`, `Channel`, `File`, `Expression`,
   * `Decimal`.
   */
  case Runtime(kind: RuntimeKind, arguments: List<IrTypeId>)
  /**
   * A const generic argument: the `16` of `Array<Float, 16>`. It is not the type of any value - it stands in a type
   * argument list, so that an instance key and a mangled name are a function of *all* arguments of an instance.
   */
  case ConstantValue(value: LiteralValue, of: IrTypeId)
}

/**
 * The runtime's own types. There is one list implementation and one ordered hash table for every collection name of
 * the standard library: `ArrayList` and `TrieList` are the list, `TrieMap`/`HashMap` and `TrieSet`/`HashSet` the
 * table, which is observable only through performance because iteration order and `Show` are the same either way.
 */
public type RuntimeKind {
  /** `ArrayList<Item>`, `TrieList<Item>`: contiguous storage, an offset and a length. */
  case ListStorage
  /** `HashMap<Key, Value>`, `TrieMap<Key, Value>`: open addressing plus an insertion-ordered entry vector. */
  case MapStorage
  /** `HashSet<Item>`, `TrieSet<Item>`: the table with a value descriptor of size zero. */
  case SetStorage
  case TaskObject
  case ChannelObject
  /**
   * `File` of `std/fs`: a `native shared type` whose whole representation is the runtime's (`torb_file`, header first),
   * so a value is the pointer to that counted block, exactly as a task and a channel are.
   */
  case FileHandle
  /** `Expression<Value>`: a static tree plus the captures collected at the quotation site. */
  case ExpressionTree
  /** Exact base-10 arithmetic. Not implemented yet; using one is a clean compile error. */
  case DecimalNumber
}

/**
 * `Show`, `Iterate<Int64>`: a trait with its type arguments applied. Interned.
 *
 * It carries where the trait is declared, because a mangled name has to be a pure function of the *program*: a
 * witness table and a trait-typed value are named after the trait, and two traits of the same name in two packages
 * are two traits.
 */
public type IrTrait {
  symbol: SymbolId
  path: SymbolPath
  arguments: List<IrTypeId>
}

/** Whether a result is returned in a register or written through a pointer the caller passes first (BACKEND 3.2). */
public type ResultMode {
  case ByValue
  /** The layout model estimates more than 64 bytes: the caller passes `T *result` as the first parameter. */
  case ByPointer
}

/** How one operand position consumes its value. Filled in by the ownership pass of 5.4. */
public type Ownership {
  /** The value must be live at that point and no count changes: the caller keeps it for the whole call. */
  case Borrowed
  /** The position takes the count: `Construct`, `BoxNew`, `TraitValue`, `Return` and a parameter the callee stores. */
  case Owned
}

/** One parameter of a monomorphic function. Its name is for `torb ir` and for readable C, never load bearing. */
public type IrParameter {
  name: String
  type: IrTypeId
  /** A `var` parameter or a `var fn` receiver: a reference into the caller's frame, never counted (BACKEND 2.3). */
  byReference: Bool = false
  ownership: Ownership = Ownership.Borrowed
  /**
   * An **out** parameter: the callee never reads what is there and writes a value the caller then owns. Only the
   * functions of `runtime/` whose result is an `Option` or a `Result` have one (BACKEND 5.R1), and it is what tells the
   * ownership verifier that the base of such a place starts empty and owns a value afterwards.
   */
  out: Bool = false
  /**
   * An **element of a container**, handed over by address. It is an ordinary *value* position - the callee takes the
   * count of it exactly as `ownership` says - and the address is only how the one C list and the one C hash table reach
   * an element whose type they do not know (BACKEND 3.1). A `var` path is a different thing, which is why it is a
   * different flag: a place carries no count, and this carries one.
   */
  byAddress: Bool = false
}

/**
 * The type of a function, and of a closure value. Interned, because `Closure` names one - two closures of the same
 * shape are the same type.
 */
public type IrSignature {
  parameters: List<IrParameter>
  result: IrTypeId
  /** One per witness table the caller appends after the declared parameters, in bound order (BACKEND 1.4). */
  witnesses: List<TraitId> = []
  /**
   * Decided by `finishProgram`, not by whoever interned the signature: it follows from the size of the result, and
   * that size is only final once every layout is. It is therefore not part of the interning key either.
   */
  resultMode: ResultMode = ResultMode.ByValue
}

/** A source location, relative to the workspace root with forward slashes: no path of a machine ever leaks in. */
public type Location {
  path: String
  line: Int
  column: Int
}

// --- Static data ----------------------------------------------------------------------------------------------------

/** A compile-time constant: a literal, a top-level `const` of a module, a quoted expression tree. */
public type StaticValue {
  /** Mangled, prefix `s`. */
  name: String
  type: IrTypeId
  contents: StaticContents
}

/**
 * What a static value holds. Text, integers, characters and booleans are the checker's `LiteralValue`, because a
 * compile-time constant of one of those types is exactly what the checker already evaluated.
 */
public type StaticContents {
  case Literal(value: LiteralValue)
  /** There is no float literal *type*, so a float constant is not a `LiteralValue`. */
  case Floating(value: Float)
  case VoidValue
  /** A record, a tuple or one variant of a variant layout, from static fields. */
  case Aggregate(layout: LayoutId, variant: Int, fields: List<StaticId>)
  /** `Array<Item, Size>` of static items. */
  case Items(item: IrTypeId, items: List<StaticId>)
}

/**
 * What one element type of a runtime container is, as static data. There is one list and one hash table in C, and
 * they are parameterized by this instead of by a template (BACKEND 3.1), so the VM and the C back end share them.
 */
public type ElementDescriptor {
  /** Mangled, prefix `d`. */
  name: String
  item: IrTypeId
  size: Int
  alignment: Int
  /** `None` when the element is trivial, which is what lets the runtime skip the indirect call entirely. */
  retain: FunctionId? = None
  release: FunctionId? = None
  equals: FunctionId? = None
  hash: FunctionId? = None
}

/**
 * One witness table: what a trait-typed value and a generic function that was not monomorphized call through.
 *
 * Required members in declaration order, then the supertraits' tables in declaration order, then the witnesses of the
 * trait's own generic parameters. Default members are *not* in a table: calling one is a call of the monomorphic
 * instance of the default body with the table passed in, which is what makes `by` forward the required members only.
 */
public type WitnessTable {
  /** Mangled, prefix `w`. */
  name: String
  applied: TraitId
  /** The type the implementation is for. */
  target: IrTypeId
  members: List<FunctionId>
  /**
   * The table of each **direct** supertrait, in declaration order, so that narrowing a trait-typed value to a supertrait
   * is one indirection and needs nothing of the erased target. `None` where the table could not be built: a narrowing
   * through it is then a clean finding at the coercion, and a hole nobody reads costs one null pointer.
   */
  nested: List<WitnessTableId?>
}

/**
 * One monomorphic instance of one declaration: what the worklist of 5.6 holds and what a mangled name is a function
 * of. Two instances with the same key are one function, however the lowering reached them.
 */
public type Instance {
  symbol: SymbolId
  /** Type arguments and const arguments together, in declaration order. */
  arguments: List<IrTypeId>
  /** The witness tables the instance was reached with, for a call that passes dictionaries instead of specializing. */
  witnesses: List<WitnessTableId> = []
}

// --- Functions, blocks, slots ---------------------------------------------------------------------------------------

/** What role a slot plays in its frame. Only `.Parameter` is load bearing; the rest is for readable output. */
public type SlotRole {
  case Parameter(index: Int)
  case Local
  case Temporary
  /** A slot that holds a closure's environment, or a field of it. */
  case Environment
  /** The place a `.ByPointer` result is written to. */
  case ResultPointer
}

/** One slot of a function's frame: its type, the role it plays, and the source name it prints as. */
public type SlotDeclaration {
  type: IrTypeId
  role: SlotRole
  /** A name from the source, for `torb ir` and for `#line`-friendly C identifiers. Never load bearing. */
  name: String = ""
}

/** A function whose body is a state machine over `Task<Value>` is not a plain function (BACKEND 5.3). */
public type FunctionKind {
  case Plain
  /**
   * The **resume function** of a task: the body of a function that answers a `Task<Value>`, of a closure that does, of a
   * `spawn` closure, or the top-level code of an entry file that waits. Its result is the `Value` and its parameters are
   * the frame's (the task owns them); nothing calls it but the scheduler, and a `TaskNew` is what makes one run.
   *
   * A back end drives it as a state machine: a switch over the state at the entry, one resume point after every
   * `Suspend`, a cancellation check there and at every loop back-edge, and a stop path per point that releases what is
   * live (`ir/suspension.trb` computes what).
   */
  case TaskResume
  /**
   * A `native fn` the runtime provides (BACKEND 3.7): a signature, no blocks, and the C symbol the emitter calls.
   *
   * It is a *function* and not an instruction of its own, so a call of one is an ordinary `Call`, the ownership pass
   * reads the modes of its parameters out of its signature like any other callee's, and nothing in the two back ends
   * needs a second way to reach the runtime.
   */
  case Runtime(symbol: String)
  /**
   * The accessor of a module `const` whose value is no static data: one **immortal** block per constant, built once by
   * `initializer` and never freed, and a read of the constant is a call of this (BACKEND, the immortal counted static).
   *
   * It has no blocks of its own. The two back ends write the cell and the flag that says it was built, because where
   * that state lives is a property of the back end and not of the program: in C it is two file-scope `static`s beside the
   * function, in the VM a slot of the module's own frame. The value is born inside an immortal region, so a retain and a
   * release of it are no-ops, a write to it copies, and the leak gate counts it apart from the live blocks.
   */
  case ConstantCell(initializer: FunctionId)
  /**
   * One access to the **entry cell** of a top-level `const` of an entry file whose value is a shared object: the one
   * place the entry function's binding and every function of the file that names it meet, so that all of them see one
   * object and not an object each (docs/BACKEND.md, the entry cell).
   *
   * The cell holds a count of its own: `Write` takes one right after the binding is made, `Read` answers the object with
   * one more, and the back end releases every cell once the program is done - after the tasks the entry left running,
   * which may still read it. It has no blocks: where the cell lives is the back end's, a file-scope `static` in C, as for
   * [FunctionKind.ConstantCell].
   */
  case EntryCell(cell: String, access: CellAccess)
}

/** What one function of an entry cell does with it. */
public type CellAccess {
  /** `() -> Value`: the object in the cell, with a count the caller owns. */
  case Read
  /** `(value: Value) -> Void`: the entry's binding goes into the cell, which takes the count it is handed. */
  case Write
}

/** One basic block: the instructions that run in it, in order, and how it ends. */
public type Block {
  var instructions: List<Instruction> = []
  /**
   * Exactly one, always. A fresh block carries `Unreachable`, which is also what an unterminated block would mean -
   * and the verifier rejects one that anything can reach.
   */
  var terminator: Terminator = Terminator.Unreachable
  /** The source construct this block came from. Only a comment in the output. */
  label: String = ""
  /** Where that construct is, for the block comment of the text format and for `#line` in C. */
  var at: LocationId? = None
}

/** One function of the program: its signature, its slots and blocks, and what kind of body it has. */
public type IrFunction {
  /** The mangled name. Unique, deterministic, the only identity a back end needs. */
  name: String
  /** The declaration this instance came from, for messages and `torb ir`. `None` for a generated body. */
  origin: SymbolId? = None
  signature: IrSignature
  var slots: List<SlotDeclaration> = []
  var blocks: List<Block> = []
  kind: FunctionKind = FunctionKind.Plain
  /**
   * Whether the function takes the site of its caller as a hidden argument, after its declared ones, and names it in
   * every panic instead of a site of its own: the copy `ir/sites.trb` makes of a function of `std/` that can panic.
   * Its slots and its signature are the original's - the argument is the back end's, a `const torb_location *` in C
   * and an entry of the kernel's stack of sites in the VM.
   */
  tracksCaller: Bool = false

  fn typeOfSlot(slot: Slot): IrTypeId {
    slots[slot.value].type
  }

  fn hasSlot(slot: Slot): Bool {
    slot.value >= 0 && slot.value < slots.length()
  }

  fn hasBlock(block: BlockId): Bool {
    block.value >= 0 && block.value < blocks.length()
  }
}

// --- Places ---------------------------------------------------------------------------------------------------------

/**
 * A place: the base slot plus a static path of steps. Never counted and never escaping, because exclusivity is
 * checked statically, references are second class, and `MakeUnique` at the moment the path is formed leaves the
 * storage with count one (BACKEND 2.3).
 */
public type Reference {
  base: Slot
  steps: List<PathStep> = []
}

/** One step of a [Reference]'s path: a field, a variant field, a tuple field, an array element, or a dereference. */
public type PathStep {
  case Field(layout: LayoutId, index: Int)
  case Variant(layout: LayoutId, variant: Int, index: Int)
  case TupleField(layout: LayoutId, index: Int)
  /**
   * `Array<Item, Size>` and the contiguous list: an interior pointer after `MakeUnique`.
   *
   * An index out of range panics with `index <index> is out of bounds for a length of <count>`, the message the `at` of
   * `ArrayList` and of `Array` answer the same mistake with, and `at` is the site that panic names: the one the
   * `Index.at` it replaced would have named. A step that could not name it is never formed, and the read-copy-write
   * stays (`ir/elements.trb`).
   *
   * `checked` is false where the range analysis proved the index inside an `Array<Item, Size>` (`ir/ranges.trb`):
   * the back end then indexes the slots without comparing, and the panic is never reached.
   */
  case Element(item: IrTypeId, index: Slot, at: LocationId, checked: Bool = true)
  /** Dereference a boxed layout, a `Box`, a `Lazy` cell or a `shared` object. */
  case Contents(type: IrTypeId)
}

/** How one operand is consumed. Filled in by the ownership pass (BACKEND 2). */
public type Argument {
  slot: Slot
  ownership: Ownership = Ownership.Borrowed
  last: Bool = false
  /**
   * The place an argument of a `var` parameter refers to: the whole path, formed at the call site (BACKEND 3.2), so
   * that a C back end can take its address and the VM can carry a (frame, slot, path) triple.
   *
   * `slot` is the **base** of that path, which is what makes every pass right without a rule of its own: liveness keeps
   * the base live across the call, the ownership pass borrows it because a reference is never counted, and the verifier
   * reads the type of the place through the same path the callee will write through.
   */
  place: Reference? = None
}

/** A borrowed operand: what phase 1 of the lowering emits everywhere. */
public fn borrowed(slot: Slot): Argument {
  Argument slot, Ownership.Borrowed, last: false
}

/** An operand position that takes the count: `Construct`, `BoxNew`, `TraitValue`, `Return`, a stored parameter. */
public fn owned(slot: Slot): Argument {
  Argument slot, Ownership.Owned, last: false
}

/**
 * An argument that fills a `var` parameter: the place itself, borrowed, because a reference carries no count at all -
 * the caller holds the base live for the whole call and exclusivity keeps a second path to the same storage out.
 */
public fn referenced(place: Reference): Argument {
  Argument place.base, Ownership.Borrowed, last: false, place: place
}

// --- Witnesses at a call site ---------------------------------------------------------------------------------------

/** Where a witness table comes from at the point where it is used. */
public type WitnessRoot {
  /** A static table of the program: the implementation is known. */
  case Table(table: WitnessTableId)
  /** A table the caller appended after the declared parameters: the index among them. */
  case Parameter(index: Int)
  /**
   * One of the witness pointers inside a trait-typed value: the place the value is at, and which of its bounds.
   *
   * A **place** and not a slot, because a `var fn` member reached through a table writes through the value the table
   * came from - `holder.items.append(x)` reads the table out of `holder.items` and hands the callee the payload inside
   * exactly that box. A bare slot is `Reference(slot, [])`.
   */
  case Value(place: Reference, bound: Int)
}

/**
 * A witness table, possibly one that sits inside another one. `path` walks the `nested` lists of the tables,
 * outermost first - a supertrait's table, or the witness of a trait's own generic parameter.
 *
 * Flat instead of recursive on purpose: a value type may not contain itself, and a list of indices is what both back
 * ends index with anyway.
 */
public type WitnessSource {
  root: WitnessRoot
  steps: List<Int> = []
}

/** What a closure takes from the frame that creates it. */
public type Capture {
  /** A `const` binding: copied into the environment. */
  case Value(slot: Slot)
  /** A `var` binding that some closure captures: the `Box` is retained, so both sides see one variable. */
  case Boxed(slot: Slot)
  /** A `var` parameter or a `var fn` receiver, captured by a closure that provably does not escape. */
  case Place(reference: Reference)
}

// --- Intrinsics -----------------------------------------------------------------------------------------------------

/** Which numeric type an operation works on. The suffix of the printed intrinsic name comes from this. */
public type NumericKind {
  case Signed(width: Int)
  case Unsigned(width: Int)
  case Floating(width: Int)
}

/**
 * What the C back end emits inline and the VM has an opcode for. Arithmetic is always checked, because overflow
 * panics in every back end - that is semantics, not a diagnostic.
 */
public type IntrinsicOperation {
  case Add
  case Subtract
  case Multiply
  case Divide
  case Remainder
  case Negate
  case BitwiseAnd
  case BitwiseOr
  case BitwiseExclusiveOr
  case BitwiseNot
  case ShiftedLeft
  case ShiftedRight
  case Equal
  case NotEqual
  case Less
  case LessOrEqual
  case Greater
  case GreaterOrEqual
  /** A numeric conversion. `kind` is what it comes from, `to` what it becomes. */
  case Convert(to: NumericKind)
  case BooleanNot
  /** One concatenation of all parts of an interpolation, never repeated `String.add`. */
  case TextConcat
  case TextEqual
  case TextCompare
  case TextByteLength
  /** The first use of a `lazy` parameter runs its thunk and remembers the value. */
  case LazyForce
  /**
   * `print a, b` and `printError a, b`: the already shown parts, joined by the runtime with one space and one `\n`.
   *
   * They take as many operands as the call was written with, exactly as `TextConcat` does, and they produce nothing.
   * `print(...values: Show)` is a variadic parameter and would otherwise build a `List<Show>` at the call site, but the
   * lowering keeps this one as a fast path instead: it shows every argument itself and hands the parts over as one
   * instruction, so the join stays in `runtime/console.c` and the two back ends cannot disagree about the format.
   */
  case PrintParts
  case PrintErrorParts
  /**
   * Ends the program with this exit code. Nothing follows it, so the block that holds it ends `unreachable`.
   *
   * It is an intrinsic and not a call of `Process.exit`, because it is what the *language* does where a top-level `?`
   * hands on a failure - `error: <the error>` and exit code 1 - and an entry file that never imports `std/process`
   * has no name for that function, while the behaviour is the same in both back ends either way.
   */
  case ExitWithCode
  /**
   * The `?` return trace of the debug profile (`TORB_RETURN_TRACE_MARK` in `runtime/include/torb.h`): where the trace
   * of the thread stands before the operand of a `?` is evaluated. Answers the mark, an `Int64`, which the other two
   * take. A release build answers 0 and records nothing, and the VM emits it only for a run in the `dev` profile.
   */
  case ReturnTraceMark
  /** The operand of a `?` succeeded: what was recorded since the mark belongs to failures that were handled. */
  case ReturnTraceRewind
  /** A `?` hands a failure on here: one entry of the trace, at the location of the instruction, with the mark. */
  case ReturnTraceRecord
  /** The chain of the failure a top-level `?` reports, one `  at <location>` line each, under the report. */
  case ReturnTracePrint
}

/**
 * One intrinsic: an operation and, where the operation has more than one form, the numeric type it works on. The
 * pair is what prints as `add.i64` and what the natives manifest (BACKEND 5.R1) maps a `native fn` to.
 */
public type Intrinsic {
  operation: IntrinsicOperation
  kind: NumericKind? = None
  /**
   * Whether an integer operation still carries its overflow check. `true` everywhere the lowering writes one, and
   * `false` only where the range analysis (`ir/ranges.trb`) proved that the result cannot leave the width of its own
   * type. It prints as `add.i64.unchecked`, so a snapshot says which of the two a line is.
   */
  checked: Bool = true
}

// --- Instructions ---------------------------------------------------------------------------------------------------

/**
 * One instruction of a [Block], run in order: an ownership operation, a call, a read or write through a [Reference],
 * a construct, or anything else a back end executes as one step.
 */
public type Instruction {
  case Constant(target: Slot, value: StaticId)
  /** Ownership moves: the source is dead afterwards. Inserted by 5.4. */
  case Move(target: Slot, source: Slot)
  /** Ownership is shared: a retain for a managed type, a plain copy otherwise. */
  case Copy(target: Slot, source: Slot)
  case Retain(slot: Slot)
  case Release(slot: Slot)
  /**
   * The scope of a binding whose value may hold a `Close` object ends here (docs/design/DESTRUCTORS.md 2a): a use that
   * keeps the value alive to this line, so its release - and the `close()` inside that release - happens at the end of
   * the block in reverse declaration order and never at a last use the liveness pass happened to find. The lowering
   * writes one per such binding at every way out of its block; the ownership pass turns the one the value is still
   * owned at into its `Release`, drops the one a move already emptied, and removes every one of them, so nothing after
   * it ever sees this instruction.
   */
  case EndOfScope(slot: Slot)
  /**
   * The slot holds nothing: the zero value of its type, which owns no count and whose release does nothing. The slot
   * is its own drop flag (docs/design/DESTRUCTORS.md 2a), and this is how it says "empty": the ownership pass writes
   * one where a path reaches the end of a temporary's statement without having made the temporary - an arm of an `if`
   * that made none - and one after such an end inside a loop, so the next turn finds it empty again.
   */
  case Clear(target: Slot)
  /** Before every write through a counted owner on a path, outermost first. A no-op when the count is one. */
  case MakeUnique(reference: Reference)

  /**
   * A call of a known function. `witnesses` is empty for a monomorphic instance and holds one table per bound of the
   * callee where the caller passes dictionaries instead (BACKEND 1.4) - they arrive after the declared parameters.
   *
   * `at` is where the call is written. A function of the runtime that can panic takes it as a `torb_location`
   * (`torb_text_slice`, `torb_list_with_capacity`), so a call without one could not name the site of that panic - and a
   * panic message is output, which two back ends have to agree on to the character.
   */
  case Call(
    target: Slot?,
    callee: FunctionId,
    arguments: List<Argument>,
    witnesses: List<WitnessSource>,
    at: LocationId? = None,
  )
  /**
   * A closure value, a function in a field, a `lazy` force. `at` is where the call is written: the line a frame of
   * the `dev` profile names for the function that is in the middle of this call.
   */
  case CallClosure(target: Slot?, callee: Slot, arguments: List<Argument>, at: LocationId? = None)
  /** A member of a witness table: a trait-typed receiver, or a forwarded witness. */
  /**
   * A member of a witness table: a trait-typed receiver, or a forwarded witness. `at` is where the call is written,
   * which a direct call the devirtualization makes of it keeps (`ir/sites.trb` hands it to a function of `std/`).
   */
  case CallWitness(
    target: Slot?,
    witness: WitnessSource,
    member: Int,
    arguments: List<Argument>,
    at: LocationId? = None,
  )
  /** Arithmetic, comparisons, conversions, string building: what the C back end emits inline. */
  case Intrinsic(target: Slot?, intrinsic: Intrinsic, arguments: List<Slot>, at: LocationId)

  case Construct(target: Slot, layout: LayoutId, variant: Int, fields: List<Argument>)
  /**
   * An `Array<Item, Size>` value: the type of `target` is the `FixedArray`, and `items` fill its slots in order, each
   * one owned - a list literal against an expected `Array` (docs/BACKEND.md 5.9b).
   *
   * With **no** items every slot is empty: all bits zero in C, which holds no count, so a later write through an
   * `Element` step may release what it replaces. That is what the private `Array.unfilled` of `std/core` answers, and
   * `filled` and `generated` write every slot of it before anything reads one.
   */
  case ArrayNew(target: Slot, items: List<Argument>)
  case Read(target: Slot, reference: Reference)
  case Write(reference: Reference, value: Argument)
  /** The variant index of a value of a variant layout. */
  case Tag(target: Slot, source: Slot)

  case Closure(target: Slot, function: FunctionId, captures: List<Capture>, escaping: Bool)
  case BoxNew(target: Slot, value: Argument)
  case TraitValue(target: Slot, value: Argument, tables: List<WitnessSource>)

  /**
   * An empty runtime container over its element descriptors: what a list and a map literal start from, and the one
   * instruction the containers need of their own.
   *
   * It is an instruction and not a `native fn`, because `torb_list_new` takes an **element descriptor** and no
   * declaration of `std/` can name one: the descriptors are the answer to "one C implementation for every element type"
   * (BACKEND 3.1). `elements` holds one per type argument of the container - the item of a list, the key and the value of
   * a map, the item of a set.
   */
  case ContainerNew(target: Slot, kind: RuntimeKind, elements: List<ElementId>)

  /** A `var` path through a container whose storage is not contiguous: take out, change, put back (BACKEND 2.3). */
  case TakeOut(target: Slot, container: Reference, key: Slot, kind: RuntimeKind)
  case PutBack(container: Reference, key: Slot, value: Slot, kind: RuntimeKind)

  case Panic(message: Argument, at: LocationId)
  /**
   * `awaited.await()`, the suspension half: the machine records `state`, waits for `awaited` to complete, and goes on
   * after this instruction once it has - or stops there, releasing what is live, where it was cancelled meanwhile. Only
   * in the body of a task (docs/CONCURRENCY.md 16). `state` counts the suspension points of the body from 1, in the
   * order of its blocks; 0 is the entry.
   *
   * Where `awaited` ends cancelled, the machine is cancelled with it and stops right here - the cascade of `await()`
   * (`torb_task_await`) - unless the wait `observes`: that is `result()`, which goes on and reads the cancellation as a
   * value (`torb_task_observe`).
   */
  case Suspend(state: Int, awaited: Slot, observes: Bool)
  /**
   * A task over a resume function, started: `torb_task_new`, every argument moved into the parameter of the same position
   * of `resume`, `torb_task_start`. It is what a call of a function that answers a `Task` does, and what `spawn` is -
   * the arguments are the parameters, or the environment of the `spawn` closure.
   *
   * `result` is the element descriptor of the task's value, which places and releases it in the task block; `None` is a
   * `Void` task, which the runtime describes itself.
   */
  case TaskNew(target: Slot, resume: FunctionId, result: ElementId?, arguments: List<Argument>)
  /**
   * `Channel<Item>(capacity:)`: `torb_channel_new` over the element descriptor of `Item`, which no declaration of `std/`
   * can name - the same reason `ContainerNew` is an instruction. A negative capacity panics at `at`.
   */
  case ChannelNew(target: Slot, capacity: Slot, item: ElementId, at: LocationId)
  /**
   * A statement of the source begins here, at `at`: the line a debugger stops at and steps by (docs/design/DEBUGGER.md
   * section 5). `visible` is every binding of the source that is declared and still in scope where it begins, the
   * earliest first - the locals the line shows; parameters and a closure's captures are in sight for the whole body and
   * are not listed. Only a lowering asked for a debugged program writes one; it has no operands, and every pass carries
   * it through where it stands.
   */
  case Statement(at: LocationId, visible: List<Slot>)
  /**
   * The end of a binding's scope in a debugged program: an ordinary borrowed use that does nothing, so the ownership
   * pass releases the value after it and never before, and a move before it becomes a copy (docs/design/DEBUGGER.md
   * section 6). A binding a debugger shows therefore holds its value to the end of its block. The back ends write
   * nothing for it.
   */
  case KeepAlive(slot: Slot)
}

/** How a [Block] ends: a jump, a branch, a switch, a return, or code nothing may reach. */
public type Terminator {
  case Jump(target: BlockId)
  case Branch(condition: Slot, then: BlockId, else: BlockId)
  /** Variant tags, integer and char literals. Dense or sparse is the back end's business. */
  case Switch(scrutinee: Slot, values: List<Int>, targets: List<BlockId>, else: BlockId)
  case Return(value: Argument?)
  /** `panic`, `Process.exit`, a call of a `Never` function, an exhausted decision tree. */
  case Unreachable
  /**
   * Ends the running task as cancelled: no value, every `await()` of it cancels its waiter in turn, and every `result()`
   * of it answers `Fail(Cancelled)`. What is live is released before it, as before a `return`. Only in the body of a
   * task, where a task that observed a cancellation passes it on (`stopAsCancelled` of `std/task`: `Task.all`, `both`).
   */
  case Stop
}

// --- The program ----------------------------------------------------------------------------------------------------

/**
 * Everything the back ends read, threaded through the lowering as `var program: IrProgram` - exactly as
 * `var parser: Parser` is threaded through the grammar and `var checker: Checker` through the type checker.
 *
 * The interning tables are `Map<String, Id>` over a key that is one level deep, so adding a type is one map lookup
 * and never a walk. Nothing here is ever renumbered: an id that was handed out stays valid.
 */
public type IrProgram {
  private var types: List<IrType> = []
  private var typeIdentifiers: Map<String, IrTypeId> = [:]
  private var traits: List<IrTrait> = []
  private var traitIdentifiers: Map<String, TraitId> = [:]
  private var signatures: List<IrSignature> = []
  private var signatureIdentifiers: Map<String, IrSignatureId> = [:]
  private var locationIdentifiers: Map<String, LocationId> = [:]
  /** Layouts, addressed by `LayoutId`. Reserved before they are filled, so a recursive type terminates. */
  var layouts: List<Layout> = []
  /** The mangled name of a layout to its id: that name is the whole identity of a layout. */
  private var layoutIdentifiers: Map<String, LayoutId> = [:]
  var functions: List<IrFunction> = []
  var witnessTables: List<WitnessTable> = []
  /** The mangled name of a witness table to its id: one table per applied trait and target type. */
  private var witnessTableIdentifiers: Map<String, WitnessTableId> = [:]
  var elements: List<ElementDescriptor> = []
  /** The mangled name of an element descriptor to its id: one descriptor per element type. */
  private var elementIdentifiers: Map<String, ElementId> = [:]
  var statics: List<StaticValue> = []
  var locations: List<Location> = []
  /**
   * The members an index on a `var` path takes its element out through - `Index.at` - by the **symbol** of the
   * declaration and not by the instance, so that a copy `specializeFrozenCallees` made answers the same question.
   *
   * `ir/elements.trb` reads it: a `Call` of one of these is an element read of the path the lowering formed and not
   * an ordinary two-argument call that happens to look like one, which is what lets that pass replace the round trip
   * with an `Element` step and keep the answer.
   */
  var elementReaders: Set<Int> = []
  /**
   * The members an index on a `var` path through an `Array<Item, Size>` puts its element back with - `Array.set` - by the
   * symbol, like [IrProgram.elementReaders]. The runtime's list is recognized by its native symbol instead, and an array
   * has none: its `set` is TorbScript, so the lowering says which member closes the round trip.
   */
  var elementWriters: Set<Int> = []
  /**
   * The functions `specializeFrozenCallees` copied, by index: a body no witness table, no closure and no descriptor
   * names, which only a direct call the devirtualization wrote ever reaches.
   *
   * A back end reads it to leave out the ones that nothing calls any more - `ir/elements.trb` removes the put-back of
   * every index path it rewrites, and that can be the last call a copy had.
   */
  var specializedFunctions: Set<Int> = []
  /**
   * The functions of `std/` that `ir/sites.trb` copied into ones that track their caller, and the copies, by index: a
   * back end leaves out each of them that nothing reaches, as it leaves out a specialized copy.
   */
  var callerSiteFunctions: Set<Int> = []
  /**
   * The copy that tracks its caller, by the index of the original: what a witness table's member is called as, so a
   * call through a table names its caller as a direct call does (`ir/sites.trb`).
   */
  var siteCopies: Map<Int, Int> = [:]
  /**
   * What a frame of the `dev` profile calls each function, by index: `ArrayList.at`, `a closure in main`, `the top
   * level`. Written last by the lowering (`frameNamesOf`); a function past its end is named by its mangled name.
   */
  var frameNames: List<String> = []
  /**
   * The functions a host calls with words it holds itself - the host of a receiver script, the entry of a `torb repl`
   * session - whose signature therefore may not move: a value the host passes in or keeps was laid out by another
   * program (docs/design/REPL.md section 5), and only the declared type means the same thing in both.
   */
  var hosted: List<FunctionId> = []
  /** An instance key to the function it became: the memo of the monomorphization worklist. */
  var instances: Map<String, FunctionId> = [:]
  /** Instances that are known to be needed and not lowered yet. */
  var pending: List<Instance> = []
  /** What could not be represented. An entry here is an internal error of the compiler, never the user's fault. */
  var problems: List<String> = []
  /**
   * What is well formed but not implemented yet: a `native type` whose representation the runtime does not have
   * (`Script`, `Sandbox`). It is a clean finding that names what is missing - a program that uses one
   * cannot be built, but nothing about it is an internal error, which is what an entry in `problems` means.
   */
  var planned: List<String> = []
  /**
   * The `close()` of every `shared type` object that implements `Close`, by `LayoutId.value` of its layout: the
   * destructor its release runs before it releases the fields (docs/design/DESTRUCTORS.md 2 and 8). A type without
   * `Close` has no entry and its release is what it always was. A `native shared type` has none either - its runtime
   * drop function closes the handle itself.
   */
  var closeFunctions: Map<Int, FunctionId> = [:]
  /**
   * Every layout whose object implements `Close`, by `LayoutId.value`, a `native shared type` among them: what the
   * ownership pass asks to know which bindings are released at the end of their scope (`ir/closing.trb`).
   */
  var closingLayouts: Set<Int> = []

  // --- Types

  var fn internType(form: IrType): IrTypeId {
    const key = keyOfIrType form
    if const Some(existing) = typeIdentifiers.get(key) {
      return existing
    }
    const identifier = IrTypeId types.length()
    types.append form
    typeIdentifiers.set key, identifier
    identifier
  }

  fn typeAt(id: IrTypeId): IrType {
    types[id.value]
  }

  fn typeCount(): Int {
    types.length()
  }

  fn hasType(id: IrTypeId): Bool {
    id.value >= 0 && id.value < types.length()
  }

  // --- Traits

  var fn internTrait(applied: IrTrait): TraitId {
    const key = keyOfTrait applied
    if const Some(existing) = traitIdentifiers.get(key) {
      return existing
    }
    const identifier = TraitId traits.length()
    traits.append applied
    traitIdentifiers.set key, identifier
    identifier
  }

  fn traitAt(id: TraitId): IrTrait {
    traits[id.value]
  }

  // --- Signatures

  var fn internSignature(signature: IrSignature): IrSignatureId {
    const key = keyOfSignature signature
    if const Some(existing) = signatureIdentifiers.get(key) {
      return existing
    }
    const identifier = IrSignatureId signatures.length()
    signatures.append signature
    signatureIdentifiers.set key, identifier
    identifier
  }

  fn signatureAt(id: IrSignatureId): IrSignature {
    signatures[id.value]
  }

  fn signatureCount(): Int {
    signatures.length()
  }

  /** Only `finishProgram` uses this, to fill in what follows from the finished layouts. */
  var fn setSignature(id: IrSignatureId, signature: IrSignature) {
    signatures.set id.value, signature
  }

  // --- Layouts

  /**
   * The id of the layout with this name, reserving one when it is new. A layout is reserved *before* its fields are
   * built, so a type that contains itself finds its own id instead of recursing forever.
   */
  var fn reserveLayout(name: String, kind: LayoutKind): ReservedLayout {
    if const Some(existing) = layoutIdentifiers.get(name) {
      return ReservedLayout existing, fresh: false
    }
    const identifier = LayoutId layouts.length()
    layouts.append Layout(name, kind)
    layoutIdentifiers.set name, identifier
    ReservedLayout identifier, fresh: true
  }

  fn layoutAt(id: LayoutId): Layout {
    layouts[id.value]
  }

  /** The layout with this name, if the lowering built one. A name is the whole identity of a layout. */
  fn layoutNamed(name: String): LayoutId? {
    layoutIdentifiers.get name
  }

  var fn setLayout(id: LayoutId, layout: Layout) {
    layouts.set id.value, layout
  }

  fn hasLayout(id: LayoutId): Bool {
    id.value >= 0 && id.value < layouts.length()
  }

  // --- Locations

  var fn internLocation(location: Location): LocationId {
    const key = "{location.path}:{location.line}:{location.column}"
    if const Some(existing) = locationIdentifiers.get(key) {
      return existing
    }
    const identifier = LocationId locations.length()
    locations.append location
    locationIdentifiers.set key, identifier
    identifier
  }

  fn locationAt(id: LocationId): Location {
    locations[id.value]
  }

  fn hasLocation(id: LocationId): Bool {
    id.value >= 0 && id.value < locations.length()
  }

  // --- Everything else

  var fn addFunction(function: IrFunction): FunctionId {
    functions.append function
    FunctionId(functions.length() - 1)
  }

  fn functionAt(id: FunctionId): IrFunction {
    functions[id.value]
  }

  fn hasFunction(id: FunctionId): Bool {
    id.value >= 0 && id.value < functions.length()
  }

  var fn addStatic(value: StaticValue): StaticId {
    statics.append value
    StaticId(statics.length() - 1)
  }

  fn staticAt(id: StaticId): StaticValue {
    statics[id.value]
  }

  fn hasStatic(id: StaticId): Bool {
    id.value >= 0 && id.value < statics.length()
  }

  var fn addWitnessTable(table: WitnessTable): WitnessTableId {
    witnessTables.append table
    witnessTableIdentifiers.set table.name, WitnessTableId(witnessTables.length() - 1)
    WitnessTableId(witnessTables.length() - 1)
  }

  /** The table with this name, if it is there already. A name is the whole identity of a table, as it is of a layout. */
  fn witnessTableNamed(name: String): WitnessTableId? {
    witnessTableIdentifiers.get name
  }

  fn witnessTableAt(id: WitnessTableId): WitnessTable {
    witnessTables[id.value]
  }

  /**
   * Fills a table in after it was added. A table is added empty and filled afterwards, because one of its members may
   * need the very same table - `extend<Item: Show> List<Item> with Show` reaches itself through its own item - and a
   * table that is not there yet would be built a second time.
   */
  var fn setWitnessTable(id: WitnessTableId, table: WitnessTable) {
    witnessTables.set id.value, table
  }

  fn witnessTableCount(): Int {
    witnessTables.length()
  }

  fn hasWitnessTable(id: WitnessTableId): Bool {
    id.value >= 0 && id.value < witnessTables.length()
  }

  var fn addElement(descriptor: ElementDescriptor): ElementId {
    elements.append descriptor
    elementIdentifiers.set descriptor.name, ElementId(elements.length() - 1)
    ElementId(elements.length() - 1)
  }

  /** One descriptor per element type, whatever container asks for it: its mangled name is its whole identity. */
  fn elementNamed(name: String): ElementId? {
    elementIdentifiers.get name
  }

  fn hasElement(id: ElementId): Bool {
    id.value >= 0 && id.value < elements.length()
  }

  fn elementAt(id: ElementId): ElementDescriptor {
    elements[id.value]
  }

  var fn setElement(id: ElementId, descriptor: ElementDescriptor) {
    elements.set id.value, descriptor
  }

  /** An internal error of the compiler: the lowering produced something no back end can represent. */
  var fn reportProblem(message: String) {
    if !problems.contains(message) {
      problems.append message
    }
  }

  /** A construct that is well formed but not implemented yet. One root cause gets one message, however often. */
  var fn reportPlanned(message: String) {
    if !planned.contains(message) {
      planned.append message
    }
  }
}

/** What `reserveLayout` answers: the id, and whether the caller still has to fill the layout in. */
public type ReservedLayout {
  layout: LayoutId
  /** `false` when the layout was there already - which, while it is being built, means the type is recursive. */
  fresh: Bool
}

// --- Interning keys -------------------------------------------------------------------------------------------------

/**
 * The key a type is interned under. One level deep, because every child is an id already, and everything that is not
 * a number carries its byte length so that no separator can be forged.
 */
public fn keyOfIrType(form: IrType): String {
  match form {
    .Integer(width, isSigned) => {
      const sign = if isSigned { "s" } else { "u" }
      "i{width}{sign}"
    }
    .Floating(width) => "f{width}"
    .Boolean => "b"
    .Character => "c"
    .VoidType => "v"
    .NeverType => "n"
    .Text => "t"
    .Record(layout) => "R{layout.value}"
    .Variant(layout) => "V{layout.value}"
    .Tuple(layout) => "U{layout.value}"
    .FixedArray(item, size) => "A{item.value};{size}"
    .Closure(signature) => "C{signature.value}"
    .Object(bounds) => {
      var key = "O"
      for bound in bounds {
        key = key + ";{bound.value}"
      }
      key
    }
    .SharedObject(layout) => "H{layout.value}"
    .Box(item) => "B{item.value}"
    .Lazy(item) => "L{item.value}"
    .Runtime(kind, arguments) => "N{keyOfRuntimeKind(kind)}{keyOfIrTypes(arguments)}"
    .ConstantValue(value, of) => "K{of.value};{literalKey(value)}"
  }
}

fn keyOfIrTypes(arguments: List<IrTypeId>): String {
  var key = ""
  for argument in arguments {
    key = key + ";{argument.value}"
  }
  key
}

/** The key one `RuntimeKind` interns under. */
public fn keyOfRuntimeKind(kind: RuntimeKind): String {
  match kind {
    .ListStorage => "list"
    .MapStorage => "map"
    .SetStorage => "set"
    .TaskObject => "task"
    .ChannelObject => "channel"
    .FileHandle => "file"
    .ExpressionTree => "expression"
    .DecimalNumber => "decimal"
  }
}

/** The key an applied trait interns under: which trait, and which type arguments. */
public fn keyOfTrait(applied: IrTrait): String {
  "{applied.symbol.value}{keyOfIrTypes(applied.arguments)}"
}

/**
 * The key of a signature. The *names* of the parameters are left out on purpose: a name is documentation for a
 * position, not part of type identity - the same rule the checker follows for a tuple label. `resultMode` is left out
 * because it is a function of the result type, and `finishProgram` fills it in afterwards.
 */
public fn keyOfSignature(signature: IrSignature): String {
  var key = ""
  for parameter in signature.parameters {
    const reference = if parameter.byReference { "&" } else { "" }
    const out = if parameter.out { "!" } else { "" }
    const address = if parameter.byAddress { "@" } else { "" }
    const ownership = keyOfOwnership parameter.ownership
    key = key + ";{reference}{out}{address}{ownership}{parameter.type.value}"
  }
  var witnesses = ""
  for witness in signature.witnesses {
    witnesses = witnesses + ";{witness.value}"
  }
  "{key}->{signature.result.value}!{witnesses}"
}

fn keyOfOwnership(ownership: Ownership): String {
  match ownership {
    .Borrowed => "b"
    .Owned => "o"
  }
}
