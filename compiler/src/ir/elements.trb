/**
 * The element step: a write through `a[key]` goes into the container's own storage instead of through a copy.
 *
 * `grid[row][column] = value`, `points[index].y = value`, `rows[index].append(value)` are all lowered the same way
 * (`ir/lower/place.trb`): the element is **taken out** of the container with `Indexed.at`, changed in a slot of the
 * frame, and **put back** with `MutableIndexed.set`. That is the concept's own model of an index path, and it is what
 * a trait-typed container can do - but the container still holds a count of the element while the frame changes it,
 * so the `MakeUnique` in the middle copies. `benchmarks/nested-write` pays two allocations and a whole row per write
 * for it (docs/PERFORMANCE.md, finding 3).
 *
 * This pass answers the question the IR contains once the devirtualization has run: where the container is the
 * runtime's own contiguous list, the round trip is a `PathStep.Element` into that list and the change goes through an
 * interior pointer. Nothing is taken out, nothing is put back, and the element never has a second owner.
 *
 * An `Array<Item, Size>` is contiguous as well, and inline: its round trip becomes the same step into its slots, and so
 * does a plain `a[key]` read of one ([arrayReadAt]), which would otherwise hand the whole array to `at` by value.
 *
 * **It is not a change of the lowering.** `takenElement` runs while the container is still `Object(List<Int>)`;
 * `devirtualizeProgram` is what makes it a `Runtime(ListStorage, Item)`, and that is two passes later. So this is a
 * peephole over the IR after it, and a container that stayed boxed - two implementations meet in it, it sits in a
 * field - keeps the copy it always had.
 *
 * **The panic is the language's.** `a[index]` out of range panics `index 9 is out of bounds for a length of 3`, the
 * message of the `at` of `ArrayList` and of `Array`, and the step carries the site that `at` names ([readerSiteOf]),
 * read out of the very body the call would have run, so the two shapes of the same program say the same thing. A
 * reader whose body does not say it is not rewritten at all.
 *
 * # Related
 *
 * - [rewriteElementPlaces] - the pass.
 * - [elementWriteAt] - the shape it looks for, and every reason it refuses one.
 * - [PathStep.Element] - what it writes.
 */

use IrProgram, IrFunction, IrTypeId, Slot, LocationId, FunctionId from "./ir"
use Instruction, Reference, PathStep, Argument, WitnessSource, WitnessRoot from "./ir"
use RuntimeKind, Capture from "./ir"
use typeOfReference, usedSlots, usedByTerminator, definedSlot from "./verify"
use isManagedType from "./layout"
use isSharedStorage from "./capture"

/**
 * Every read-change-write round trip through a concrete list, rewritten into one `Element` path step.
 *
 * It runs after `devirtualizeProgram` and before `insertOwnership`: the container is concrete by then, and the counts
 * are not inserted yet, so what this reads is the shape the lowering wrote and nothing else. The block is rewritten
 * until nothing more matches, which is what makes a nested path fall out of one rule - `grid[row][column].field = v`
 * matches innermost first, and the container of that match is the element the outer match then replaces.
 */
public fn rewriteElementPlaces(var program: IrProgram) {
  if program.elementReaders.isEmpty() {
    return
  }
  for index in 0..program.functions.length() {
    const function = program.functions[index]
    for block in 0..function.blocks.length() {
      var instructions = function.blocks[block].instructions
      var isChanged = false
      var more = true
      while more {
        more = false
        if const Some(found) = elementWriteIn(program, function, block, instructions) {
          instructions = rewritten program, function, instructions, found
          isChanged = true
          more = true
        }
      }
      for at in 0..instructions.length() {
        if const Some(read) = arrayReadAt(program, function, instructions[at]) {
          instructions.set at, read
          isChanged = true
        }
      }
      const folded = foldedArrayReads function, block, instructions
      if folded.length() != instructions.length() {
        instructions = folded
        isChanged = true
      }
      if isChanged {
        program.functions[index].blocks[block].instructions = instructions
      }
    }
  }
}

/**
 * `a[key]` on an `Array<Item, Size>` as one `Read` through an `Element` step, where the instruction is the call of
 * `Indexed.at` that read it: the item is a slot of the array's own struct, so there is nothing to call, no `Option` to
 * build and no copy of the whole array to hand to `at` by value.
 *
 * The step carries the site of the panic `at` would have produced - read out of its body, exactly as a list's round
 * trip does - so an index out of bounds says what the call would have said, where it would have said it. A call whose
 * reader does not say it stays a call.
 */
fn arrayReadAt(program: IrProgram, function: IrFunction, instruction: Instruction): Instruction? {
  const (target, callee, arguments) = match instruction {
    .Call(Some(found), reader, given, witnesses, _) => {
      if !witnesses.isEmpty() || given.length() != 2 {
        return None
      }
      (found, reader, given)
    }
    _ => {
      return None
    }
  }
  if hasPlace(arguments[0]) || hasPlace(arguments[1]) || !isElementReader(program, callee) {
    return None
  }
  const array = arguments[0].slot
  if !function.hasSlot(array) || !function.hasSlot(target) {
    return None
  }
  const item = match program.typeAt(function.typeOfSlot(array)) {
    .FixedArray(found, _) => found
    _ => {
      return None
    }
  }
  if item != function.typeOfSlot(target) {
    return None
  }
  const site = readerSiteOf(program, instruction)?
  const step = PathStep.Element item, arguments[1].slot, site
  Some Instruction.Read(target, Reference(array, [step]))
}

/**
 * The block with every array that is read whole only to read one element of it read through the one path instead:
 * `%3 = read %0.cells` followed by `%4 = read %3[%1]` becomes `%4 = read %0.cells[%1]`, where `%3` is used by that
 * second read and by nothing else.
 *
 * It is what `cells[row][column]` inside a method needs. The field is a value like any other, so the lowering reads it
 * into a slot before the bracket - and for an array of counted items that read retains every item, once per access,
 * only to release them all again. The two reads stand next to each other, so nothing can write the path between them.
 */
fn foldedArrayReads(function: IrFunction, block: Int, instructions: List<Instruction>): List<Instruction> {
  var kept: List<Instruction> = []
  for instruction in instructions {
    // The key may be computed between the two reads (`cells[row + 1]`): a constant and an intrinsic touch no memory,
    // so the first read may move down past them as long as none of them defines what that read reads
    var at = kept.length() - 1
    while at >= 0 && isPureBetween(kept[at], instruction) {
      at = at - 1
    }
    if at >= 0 {
      if const Some(read) = foldedRead(function, block, instructions, kept[at], instruction) {
        if !definesAnyOf(kept[at + 1..kept.length()], kept[at]) {
          kept.removeAt at
          kept.append read
          continue
        }
      }
    }
    kept.append instruction
  }
  kept
}

/** Whether an instruction reads and writes no memory - a constant or an intrinsic - and is not the definition asked for. */
fn isPureBetween(instruction: Instruction, reader: Instruction): Bool {
  const wanted = match reader {
    .Read(_, reference) => reference.base
    _ => {
      return false
    }
  }
  if definedSlot(instruction) == Some(wanted) {
    return false
  }
  match instruction {
    .Constant(_, _) => true
    .Intrinsic(_, _, _, _) => true
    _ => false
  }
}

/** Whether one of these instructions defines a slot the read reads: its base, or the index of one of its steps. */
fn definesAnyOf(between: List<Instruction>, read: Instruction): Bool {
  const reference = match read {
    .Read(_, found) => found
    _ => {
      return true
    }
  }
  var slots: List<Slot> = [reference.base]
  for step in reference.steps {
    if const .Element(_, index, _, _) = step {
      slots.append index
    }
  }
  for instruction in between {
    if const Some(defined) = definedSlot(instruction) {
      if slots.contains(defined) {
        return true
      }
    }
  }
  false
}

/** The one read two adjacent reads make, where the first one's target is the second one's array and nothing else's. */
fn foldedRead(
  function: IrFunction,
  block: Int,
  instructions: List<Instruction>,
  first: Instruction,
  second: Instruction,
): Instruction? {
  const (whole, source) = match first {
    .Read(target, reference) => (target, reference)
    _ => {
      return None
    }
  }
  const (target, reference) = match second {
    .Read(found, inner) => (found, inner)
    _ => {
      return None
    }
  }
  if reference.base != whole || source.base == whole || reference.steps.length() != 1 {
    return None
  }
  const step = reference.steps[0]
  if const .Element(_, index, _, _) = step {
    if index == whole {
      return None
    }
  } else {
    return None
  }
  if touchesOutsideBlock(function, block, whole) {
    return None
  }
  var uses = 0
  var definitions = 0
  for instruction in instructions {
    uses = uses + occurrences(usedSlots(instruction), whole)
    if definedSlot(instruction) == Some(whole) {
      definitions = definitions + 1
    }
  }
  if uses != 1 || definitions != 1 {
    return None
  }
  var steps = source.steps
  steps.append step
  Some Instruction.Read(target, Reference(source.base, steps))
}

/** One take-out and the put-back that closes it, with everything the rewrite needs decided. */
type ElementWrite {
  /** The `Read` of the container, which the take-out needed because `at` takes `self` by value. */
  read: Int
  /** The `Indexed.at` that took the element out. */
  take: Int
  /** The `MutableIndexed.set` that put it back. */
  putBack: Int
  /** Whether the instruction in front of the put-back is the `MakeUnique` of the container it needed. */
  hasOwnerUnique: Bool
  container: Reference
  key: Slot
  element: Slot
  item: IrTypeId
  at: LocationId
}

/** The first rewritable round trip of a block, or `None` where the block holds none. */
fn elementWriteIn(
  program: IrProgram,
  function: IrFunction,
  block: Int,
  instructions: List<Instruction>,
): ElementWrite? {
  for at in 0..instructions.length() {
    if const Some(found) = elementWriteAt(program, function, block, instructions, at) {
      return Some found
    }
  }
  None
}

/**
 * The round trip that ends in the put-back at `at`, or `None` for every reason it may not be rewritten.
 *
 * Everything that cannot be proved is proved false, because a wrong answer here is a wrong program: the element may
 * have no owner but the container, the container and the key may not move while the access runs, and every use of the
 * element in between has to be a **place** - a value read of it would read a slot that is not written any more.
 */
fn elementWriteAt(
  program: IrProgram,
  function: IrFunction,
  block: Int,
  instructions: List<Instruction>,
  at: Int,
): ElementWrite? {
  const arguments = match putBackArguments(program, instructions[at]) {
    Some(found) => found
    None => {
      return None
    }
  }
  const container = match arguments[0].place {
    Some(found) => found
    None => {
      return None
    }
  }
  if arguments[0].slot != container.base || hasPlace(arguments[1]) || hasPlace(arguments[2]) {
    return None
  }
  const key = arguments[1].slot
  const element = arguments[2].slot
  const take = definitionOf instructions, at, element
  if take < 1 {
    return None
  }
  const receiver = match takenReceiver(program, instructions[take], element, key) {
    Some(found) => found
    None => {
      return None
    }
  }
  if !readsContainerInto(instructions[take - 1], receiver, container) {
    return None
  }
  const setter = match instructions[at] {
    .Call(_, callee, _, _, _) => callee
    _ => {
      return None
    }
  }
  const item = match elementTypeOf(program, function, container, setter) {
    Some(found) => found
    None => {
      return None
    }
  }
  if item != function.typeOfSlot(element) {
    return None
  }
  const site = match readerSiteOf(program, instructions[take]) {
    Some(found) => found
    None => {
      return None
    }
  }
  if !isConfined(function, block, instructions, take, at, receiver, element) {
    return None
  }
  if !isUndisturbed(instructions, take, at, container, key) {
    return None
  }
  const hasOwnerUnique = isMakeUniqueOf instructions[at - 1], container
  Some ElementWrite(take - 1, take, at, hasOwnerUnique, container, key, element, item, site)
}

/**
 * The three arguments of a put-back: a `MutableIndexed.set` on the runtime's own list, answering nothing.
 *
 * The **native symbol** decides it and not a name of the source: `torb_list_set` is what `ArrayList.set` and
 * `TrieList.set` both are, and a function of the program that merely looks like one is not one.
 */
fn putBackArguments(program: IrProgram, instruction: Instruction): List<Argument>? {
  match instruction {
    .Call(target, callee, arguments, witnesses, _) => {
      if const Some(_) = target {
        return None
      }
      if !witnesses.isEmpty() || arguments.length() != 3 {
        return None
      }
      if !isListSetter(program, callee) && !isArraySetter(program, callee) {
        return None
      }
      Some arguments
    }
    _ => None
  }
}

/**
 * Whether a callee is the runtime's `torb_list_set`, which is what every `a[key] = value` on a list becomes.
 *
 * A `native fn` of `std/` does not reach the runtime directly: the lowering gives it a **wrapper** whose one body
 * forwards its own parameters to the function the natives manifest named, so that the declaration's modes are what a
 * caller reads. So this looks through exactly one such body - a single block, a single call, every argument the
 * parameter in its own position - and through nothing else.
 */
fn isListSetter(program: IrProgram, callee: FunctionId): Bool {
  if isRuntimeSymbol(program, callee, "torb_list_set") {
    return true
  }
  if !program.hasFunction(callee) {
    return false
  }
  match forwardedCallee(program.functionAt(callee)) {
    Some(inner) => isRuntimeSymbol program, inner, "torb_list_set"
    None => false
  }
}

/**
 * Whether a callee is the `set` an index path through an `Array<Item, Size>` puts its element back with, by the symbol
 * the lowering recorded: that `set` is TorbScript, so there is no native symbol to recognize it by. The container of
 * the put-back is checked to be an array as well ([elementTypeOf]).
 */
fn isArraySetter(program: IrProgram, callee: FunctionId): Bool {
  if !program.hasFunction(callee) {
    return false
  }
  match program.functionAt(callee).origin {
    Some(symbol) => program.elementWriters.contains symbol.value
    None => false
  }
}

/** Whether a function is the runtime function of this symbol. */
fn isRuntimeSymbol(program: IrProgram, callee: FunctionId, symbol: String): Bool {
  if !program.hasFunction(callee) {
    return false
  }
  if const .Runtime(found) = program.functionAt(callee).kind {
    return found == symbol
  }
  false
}

/** The callee of a body that is one call forwarding every parameter of this function, in its own position. */
fn forwardedCallee(function: IrFunction): FunctionId? {
  if function.blocks.length() != 1 {
    return None
  }
  const instructions = function.blocks[0].instructions
  if instructions.length() != 1 {
    return None
  }
  const parts = match instructions[0] {
    .Call(target, callee, arguments, witnesses, _) => {
      if const Some(_) = target {
        return None
      }
      if !witnesses.isEmpty() || arguments.length() != function.signature.parameters.length() {
        return None
      }
      Forwarded callee, arguments
    }
    _ => {
      return None
    }
  }
  for index in 0..parts.arguments.length() {
    const argument = parts.arguments[index]
    if argument.slot != Slot(index) {
      return None
    }
    if const Some(place) = argument.place {
      if !isSameReference(place, Reference(Slot(index))) {
        return None
      }
    }
  }
  Some parts.callee
}

/** One forwarding call: what it calls, and with what. */
type Forwarded {
  callee: FunctionId
  arguments: List<Argument> = []
}

/**
 * The slot the container was read into, where the instruction is the `Indexed.at` that defines the element from it.
 *
 * `program.elementReaders` is what says it is one: the lowering wrote the symbol of the member it dispatched there,
 * so a copy `specializeFrozenCallees` made answers the same question and a two-argument call that only looks like an
 * index read does not.
 */
fn takenReceiver(program: IrProgram, instruction: Instruction, element: Slot, key: Slot): Slot? {
  match instruction {
    .Call(target, callee, arguments, witnesses, _) => {
      if target != Some(element) || !witnesses.isEmpty() || arguments.length() != 2 {
        return None
      }
      if !isElementReader(program, callee) {
        return None
      }
      if arguments[1].slot != key || hasPlace(arguments[0]) || hasPlace(arguments[1]) {
        return None
      }
      Some arguments[0].slot
    }
    _ => None
  }
}

/** Whether a callee is a member an index path takes its element out through, by the symbol the lowering recorded. */
fn isElementReader(program: IrProgram, callee: FunctionId): Bool {
  if !program.hasFunction(callee) {
    return false
  }
  match program.functionAt(callee).origin {
    Some(symbol) => program.elementReaders.contains symbol.value
    None => false
  }
}

/** Whether the instruction is the `Read` of exactly this container into exactly this slot. */
fn readsContainerInto(instruction: Instruction, receiver: Slot, container: Reference): Bool {
  if const .Read(target, reference) = instruction {
    return target == receiver && isSameReference(reference, container)
  }
  false
}

/**
 * The item type of a container whose storage is contiguous - the runtime's list, or an `Array<Item, Size>` - and `None`
 * for everything else. The setter has to match it: an array's `set` on an array, the list's on a list.
 */
fn elementTypeOf(program: IrProgram, function: IrFunction, container: Reference, callee: FunctionId): IrTypeId? {
  var ignored: List<String> = []
  const annotation = typeOfReference(program, function, ignored, "", container)?
  match program.typeAt(annotation) {
    .Runtime(kind, arguments) => {
      if kind == RuntimeKind.ListStorage && arguments.length() == 1 && isListSetter(program, callee) {
        return Some arguments[0]
      }
      None
    }
    .FixedArray(item, _) => if isArraySetter(program, callee) { Some item } else { None }
    _ => None
  }
}

/**
 * The site the `at` of the call would have panicked at. That `at` is a function of `std/` with one `panic` - the
 * out-of-bounds panic of the `at` of `ArrayList`, `TrieList` and `Array` - and it names the site of its caller
 * (`ir/sites.trb`): the site of this call, which is what the step carries.
 *
 * The body is read rather than trusted because the message belongs to `std/` and the back end may not decide it -
 * `tests/conformance/collection-index.trb` pins it, and the two shapes of the same read have to agree. A body with no
 * panic or with more than one answers `None`, and the round trip stays; a call without a site keeps the one of the
 * panic inside the body.
 */
fn readerSiteOf(program: IrProgram, instruction: Instruction): LocationId? {
  const (reader, called) = match instruction {
    .Call(_, callee, _, _, at) => (callee, at)
    _ => {
      return None
    }
  }
  if !program.hasFunction(reader) {
    return None
  }
  const body = program.functionAt reader
  var found: LocationId? = None
  for block in body.blocks {
    for step in block.instructions {
      if const .Panic(_, at) = step {
        if const Some(_) = found {
          return None
        }
        found = Some at
      }
    }
  }
  if found.isNone() {
    return None
  }
  if const Some(site) = called {
    return Some site
  }
  found
}

/**
 * Whether the container and the element belong to this one access and to nothing else: the container was read into a
 * slot that only the take-out sees, the element is defined once and used only in between, and every use of it there
 * is a **place**.
 *
 * A value read of the element is what this refuses. After the rewrite the slot is not written any more, so anything
 * that reads it as a value would read a zero - and a pass that answered "close enough" would be a wrong program.
 */
fn isConfined(
  function: IrFunction,
  block: Int,
  instructions: List<Instruction>,
  take: Int,
  putBack: Int,
  receiver: Slot,
  element: Slot,
): Bool {
  if touchesOutsideBlock(function, block, receiver) || touchesOutsideBlock(function, block, element) {
    return false
  }
  for at in 0..instructions.length() {
    const instruction = instructions[at]
    if at != take - 1 && definedSlot(instruction) == Some(receiver) {
      return false
    }
    if at != take && definedSlot(instruction) == Some(element) {
      return false
    }
    if at != take && occurrences(usedSlots(instruction), receiver) > 0 {
      return false
    }
    const used = occurrences usedSlots(instruction), element
    if used == 0 {
      continue
    }
    if at <= take || at > putBack {
      return false
    }
    // The put-back reads it as the value it writes back, and that instruction goes away with the round trip
    const allowed = if at == putBack { 1 } else { 0 }
    if used != occurrences(referenceBasesOf(instruction), element) + allowed {
      return false
    }
  }
  true
}

/**
 * Whether the path stays the path while the access runs: nothing between the take-out and the put-back defines the
 * container's base or the key, and nothing writes through the container except the `MakeUnique` the put-back needed.
 *
 * Exclusivity already says no second access to the container is open (BACKEND 2.3). This asks the IR the same
 * question, because that is what the rewrite depends on and it costs one walk.
 */
fn isUndisturbed(
  instructions: List<Instruction>,
  take: Int,
  putBack: Int,
  container: Reference,
  key: Slot,
): Bool {
  var guarded = [container.base, key]
  for step in container.steps {
    if const .Element(_, index, _, _) = step {
      guarded.append index
    }
  }
  var at = take + 1
  while at < putBack {
    const instruction = instructions[at]
    for slot in guarded {
      if definedSlot(instruction) == Some(slot) {
        return false
      }
    }
    if at == putBack - 1 && isMakeUniqueOf(instruction, container) {
      at = at + 1
      continue
    }
    for reference in writtenReferencesOf(instruction) {
      if reference.base == container.base {
        return false
      }
    }
    at = at + 1
  }
  true
}

/** Whether an instruction is exactly the `MakeUnique` of this place. */
fn isMakeUniqueOf(instruction: Instruction, container: Reference): Bool {
  if const .MakeUnique(reference) = instruction {
    return isSameReference reference, container
  }
  false
}

// --- The rewrite ------------------------------------------------------------------------------------------------------

/**
 * The block with the round trip replaced by one `Element` step: the `Read`, the take-out, the put-back and the
 * `MakeUnique` the put-back needed are gone, and every place that stood on the element now stands on the container.
 *
 * A `MakeUnique` of the element becomes the whole chain of owners the new path has, outermost first, which is what
 * `makeOwnersUnique` emits for a path the lowering forms - the storage at the end of the path needs it as much as the
 * container does, and only the instruction that writes knows that it writes.
 */
fn rewritten(
  program: IrProgram,
  function: IrFunction,
  instructions: List<Instruction>,
  found: ElementWrite,
): List<Instruction> {
  const step = PathStep.Element found.item, found.key, found.at
  var steps = found.container.steps
  steps.append step
  const prefix = Reference found.container.base, steps
  var kept: List<Instruction> = []
  for at in 0..instructions.length() {
    if at == found.read || at == found.take || at == found.putBack {
      continue
    }
    if at == found.putBack - 1 && found.hasOwnerUnique {
      continue
    }
    const instruction = instructions[at]
    if at <= found.take || at > found.putBack {
      kept.append instruction
      continue
    }
    if const .MakeUnique(reference) = instruction {
      if reference.base == found.element {
        kept.appendAll ownersMadeUnique(program, function, substitutedReference(reference, found.element, prefix))
        continue
      }
    }
    kept.append substituted(instruction, found.element, prefix)
  }
  kept
}

/**
 * Every `MakeUnique` a write through a path needs: one per counted owner along it, outermost first, the place itself
 * last. It is `makeOwnersUnique` of `ir/lower/place.trb`, asked once the representations are final, so what it answers
 * here is exact rather than conservative.
 */
fn ownersMadeUnique(program: IrProgram, function: IrFunction, reference: Reference): List<Instruction> {
  var found: List<Instruction> = []
  var ignored: List<String> = []
  for count in 0..reference.steps.length() {
    const owner = Reference reference.base, reference.steps[0..count]
    if const Some(annotation) = typeOfReference(program, function, ignored, "", owner) {
      // A box and a `lazy` cell are shared on purpose: copying one is exactly what must not happen
      if isSharedStorage(program, annotation) {
        continue
      }
      if isManagedType(program, annotation) {
        found.append Instruction.MakeUnique(owner)
      }
    }
  }
  found.append Instruction.MakeUnique(reference)
  found
}

/** One instruction with every place that stood on the element standing on the container's element instead. */
fn substituted(instruction: Instruction, element: Slot, prefix: Reference): Instruction {
  match instruction {
    .MakeUnique(reference) => Instruction.MakeUnique substitutedReference(reference, element, prefix)
    .Read(target, reference) => Instruction.Read target, substitutedReference(reference, element, prefix)
    .Write(reference, value) => {
      Instruction.Write substitutedReference(reference, element, prefix), value
    }
    .Call(target, callee, arguments, witnesses, at) => {
      Instruction.Call(
        target,
        callee,
        substitutedArguments(arguments, element, prefix),
        substitutedWitnesses(witnesses, element, prefix),
        at,
      )
    }
    .CallClosure(target, callee, arguments) => {
      Instruction.CallClosure target, callee, substitutedArguments(arguments, element, prefix)
    }
    .CallWitness(target, witness, member, arguments, at) => {
      Instruction.CallWitness(
        target,
        substitutedWitness(witness, element, prefix),
        member,
        substitutedArguments(arguments, element, prefix),
        at,
      )
    }
    .Construct(target, layout, variant, fields) => {
      Instruction.Construct target, layout, variant, substitutedArguments(fields, element, prefix)
    }
    .ArrayNew(target, items) => Instruction.ArrayNew target, substitutedArguments(items, element, prefix)
    .TraitValue(target, value, tables) => {
      Instruction.TraitValue target, value, substitutedWitnesses(tables, element, prefix)
    }
    _ => instruction
  }
}

fn substitutedReference(reference: Reference, element: Slot, prefix: Reference): Reference {
  if reference.base != element {
    return reference
  }
  var steps = prefix.steps
  steps.appendAll reference.steps
  Reference prefix.base, steps
}

fn substitutedArguments(arguments: List<Argument>, element: Slot, prefix: Reference): List<Argument> {
  var found: List<Argument> = []
  for argument in arguments {
    match argument.place {
      Some(place) => {
        const moved = substitutedReference place, element, prefix
        found.append argument.copy(slot: moved.base, place: Some(moved))
      }
      None => found.append argument
    }
  }
  found
}

fn substitutedWitnesses(
  witnesses: List<WitnessSource>,
  element: Slot,
  prefix: Reference,
): List<WitnessSource> {
  var found: List<WitnessSource> = []
  for witness in witnesses {
    found.append substitutedWitness(witness, element, prefix)
  }
  found
}

fn substitutedWitness(witness: WitnessSource, element: Slot, prefix: Reference): WitnessSource {
  if const .Value(place, bound) = witness.root {
    const moved = substitutedReference place, element, prefix
    return witness.copy root: WitnessRoot.Value(moved, bound)
  }
  witness
}

// --- Reading the shape ------------------------------------------------------------------------------------------------

/** The index of the one instruction before `at` that defines the slot, or -1 where there is none. */
fn definitionOf(instructions: List<Instruction>, at: Int, slot: Slot): Int {
  var found = -1
  for index in 0..at {
    if definedSlot(instructions[index]) == Some(slot) {
      found = index
    }
  }
  found
}

/** Whether an argument names a place, which is what makes it a `var` parameter rather than a value. */
fn hasPlace(argument: Argument): Bool {
  if const Some(_) = argument.place {
    return true
  }
  false
}

/** Two places are the same place: the same base and the same steps, index slots included. */
fn isSameReference(first: Reference, second: Reference): Bool {
  if first.base != second.base || first.steps.length() != second.steps.length() {
    return false
  }
  for index in 0..first.steps.length() {
    if first.steps[index] != second.steps[index] {
      return false
    }
  }
  true
}

/** Every place an instruction names, whatever it does with it: the bases are what a substitution moves. */
fn referenceBasesOf(instruction: Instruction): List<Slot> {
  var found: List<Slot> = []
  for reference in referencesOf(instruction) {
    found.append reference.base
  }
  found
}

/** The places an instruction **writes** through, which is what may not touch a container while an access runs. */
fn writtenReferencesOf(instruction: Instruction): List<Reference> {
  match instruction {
    .Write(reference, _) => [reference]
    .MakeUnique(reference) => [reference]
    .TakeOut(_, container, _, _) => [container]
    .PutBack(container, _, _, _) => [container]
    .Call(_, _, arguments, _, _) => placesOfArguments arguments
    .CallClosure(_, _, arguments) => placesOfArguments arguments
    .CallWitness(_, witness, _, arguments, _) => {
      var found = placesOfArguments arguments
      found.appendAll placeOfWitness(witness)
      found
    }
    _ => []
  }
}

/** Every place one instruction names: what it reads, what it writes, and every place argument and witness root. */
public fn referencesOf(instruction: Instruction): List<Reference> {
  match instruction {
    .MakeUnique(reference) => [reference]
    .Read(_, reference) => [reference]
    .Write(reference, _) => [reference]
    .TakeOut(_, container, _, _) => [container]
    .PutBack(container, _, _, _) => [container]
    .Call(_, _, arguments, witnesses, _) => {
      var found = placesOfArguments arguments
      for witness in witnesses {
        found.appendAll placeOfWitness(witness)
      }
      found
    }
    .CallClosure(_, _, arguments) => placesOfArguments arguments
    .CallWitness(_, witness, _, arguments, _) => {
      var found = placeOfWitness witness
      found.appendAll placesOfArguments(arguments)
      found
    }
    .Construct(_, _, _, fields) => placesOfArguments fields
    .ArrayNew(_, items) => placesOfArguments items
    .TraitValue(_, _, tables) => {
      var found: List<Reference> = []
      for table in tables {
        found.appendAll placeOfWitness(table)
      }
      found
    }
    .Closure(_, _, captures, _) => {
      var found: List<Reference> = []
      for capture in captures {
        if const .Place(reference) = capture {
          found.append reference
        }
      }
      found
    }
    _ => []
  }
}

fn placesOfArguments(arguments: List<Argument>): List<Reference> {
  var found: List<Reference> = []
  for argument in arguments {
    if const Some(place) = argument.place {
      found.append place
    }
  }
  found
}

fn placeOfWitness(witness: WitnessSource): List<Reference> {
  if const .Value(place, _) = witness.root {
    return [place]
  }
  []
}

/** How often a slot stands in a list of slots. */
fn occurrences(slots: List<Slot>, slot: Slot): Int {
  var count = 0
  for found in slots {
    if found == slot {
      count = count + 1
    }
  }
  count
}

/** Whether any block but this one, or any terminator at all, reads or defines the slot. */
fn touchesOutsideBlock(function: IrFunction, block: Int, slot: Slot): Bool {
  for index in 0..function.blocks.length() {
    const found = function.blocks[index]
    if occurrences(usedByTerminator(found.terminator), slot) > 0 {
      return true
    }
    if index == block {
      continue
    }
    for instruction in found.instructions {
      if occurrences(usedSlots(instruction), slot) > 0 || definedSlot(instruction) == Some(slot) {
        return true
      }
    }
  }
  false
}
