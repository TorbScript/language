/**
 * A run of the checker that is taken one module at a time: a [ModuleRun] builds what every module needs once - the
 * declaration sites and the implementation index of the whole program (`preparedChecker`) - and then checks one module
 * per [ModuleRun.step], so that the language server answers the messages that arrive in between. The escapes of what
 * the bodies hand on are settled once, as the last step, as `torb check` settles them after the last module.
 *
 * What the checker found is the same as a `torb check` of the same modules: every module is checked by the functions
 * `checkTypes` calls, in the same order.
 */

use Diagnostic from "../syntax/diagnostic"
use Front, diagnosticsOfModule from "../semantics/check"
use ModuleId from "../semantics/module"
use Checker from "../semantics/checker/context"
use preparedChecker, checkNextModule from "../semantics/checker/check"
use settleEscapes from "../semantics/checker/escape"

/** The modules of a front that are checked one at a time, and the checker that checks them. */
public type ModuleRun {
  front: Front
  modules: List<ModuleId>
  var checker: Checker
  /** How many of `modules` are checked */
  var done: Int = 0
  /** Whether the escapes are settled, which is the last step */
  var settled: Bool = false

  /** A run over the modules of a front, with the passes over the whole program behind it. */
  static fn over(front: Front, modules: List<ModuleId>): Self {
    Self front, modules, preparedChecker(front.program, front.resolutions)
  }

  fn isDone(): Bool {
    settled
  }

  /** The module the next step checks, or `None` where the next step settles the escapes or nothing is left. */
  fn nextModule(): ModuleId? {
    modules.get done
  }

  /** Checks the next module, or settles the escapes once every module is checked. */
  var fn step() {
    if const Some(module) = nextModule() {
      checkNextModule checker, module
      done = done + 1
      return
    }
    if !settled {
      settleEscapes checker
      settled = true
    }
  }

  /** Everything that is wrong with a module the run checked, as `torb check` prints it. */
  fn diagnosticsOf(module: ModuleId): List<Diagnostic> {
    diagnosticsOfModule front, checker, module
  }
}
