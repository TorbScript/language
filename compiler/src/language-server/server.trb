/**
 * The language server itself, without its transport: [LanguageServer.receive] takes the bodies of the messages that
 * arrived together and answers every message the server sends in return - the responses to the requests, in the order
 * they came, and the diagnostics it publishes. Nothing here reads standard input or writes standard output
 * (`./command.trb` does), so the tests hold a whole session in memory.
 *
 * **A batch is the unit of work.** A change of a document marks it; the checker runs once at the end of the batch, or
 * earlier where a request of the batch needs its answer. A client that sends a change per keystroke while the checker
 * is busy has its changes read together once the checker is done, and they cost one run.
 *
 * **A run checks what a change can have changed.** Every folder of the workspace is a [Project] of its own. A change
 * inside of the bodies of functions checks those bodies again and keeps the check of the rest of the document
 * (`./view.trb`); a change of what other bodies see - a declaration, a signature, a `use` - checks the document as a
 * whole, and every open document that imports it. The others keep what their last run found.
 */

use File from "std/fs"
use Clock from "std/time"
use JsonValue from "std/json"
use Span from "../syntax/source"
use SourceTree from "../project/source-tree"
use readSourceTree from "../project/read"
use normalizePath from "../project/path"
use Front, frontOf from "../semantics/check"
use Analysis, analyzeOver, refreshedFrontOf, parsesOfProgram, dependentsOf from "./analysis"
use DocumentView, Layer, Located, documentDiagnostics, documentFindings, viewAfterChange from "./view"
use Document, Project from "./projects"
use memberAt, textAt, integerAt, itemsAt, object, integer, text, array, decoded from "./json"
use LineMap, Position, Range from "./position"
use Locations, absolutePathOf, fileUriOf from "./uri"
use diagnosticsJson, rangeJson from "./diagnostics"
use hoverOf from "./hover"
use definitionOf from "./definition"
use completionContextOf, memberCompletion, nameCompletion, withoutMemberAccess from "./completion"
use semanticTokensOf, tokenTypes, tokenModifiers from "./tokens"
use codeActionsOf from "./actions"
use testTreeOf from "./test-tree"
use SpanMapping, mappingBetween from "./mapping"
use languageVersion from "../package/version"

/** Where the server is in the life cycle the protocol prescribes. */
public type Phase {
  /** Before `initialize`: every request but that one is refused. */
  case Starting
  case Running
  /** After `shutdown`: nothing but `exit` is answered. */
  case ShuttingDown
  /** After `exit`, with the exit code: 0 where `shutdown` came first, 1 where it did not. */
  case Exited(code: Int)
}

/** The state of one session: the projects of the workspace, the open documents, and what the checker found. */
public type LanguageServer {
  /** One per folder of the workspace, and one per file that belongs to no folder */
  var projects: List<Project> = []
  /** By normalized path */
  var documents: Map<String, Document> = [:]
  var phase: Phase = Phase.Starting
  /** Lines for standard error: what the server did and what it refused, taken by whoever writes them. */
  var log: List<String> = []
  /** Whether the trees are read from disk, or were handed in (a test) */
  private readsDisk: Bool = true
  /** The messages the batch that is being handled sends */
  private var outgoing: List<JsonValue> = []

  /** A server over a tree built in memory, whose root is `rootUri`: nothing is read from disk. */
  static fn over(tree: SourceTree, rootUri: String): Self {
    Self projects: [Project(Locations.of(rootUri, "."), tree)], readsDisk: false
  }

  fn hasExited(): Bool {
    match phase {
      .Exited(_) => true
      _ => false
    }
  }

  /** The code `exit` asked for: 0 after a `shutdown`, 1 otherwise. */
  fn exitCode(): Int {
    match phase {
      .Exited(code) => code
      _ => 1
    }
  }

  /**
   * Handles the messages that arrived together, in order, and answers what the server sends: the responses and the
   * diagnostics of every document it checked.
   */
  var fn receive(bodies: List<String>): List<JsonValue> {
    outgoing = []
    for body in bodies {
      if hasExited() {
        break
      }
      match decoded(body) {
        Some(message) => handle message
        None => respondError(JsonValue.Null, -32700, "the message is not JSON")
      }
    }
    if !hasExited() && phase == Phase.Running {
      for index in 0..projects.length() {
        if !projects[index].changed.isEmpty() {
          refresh index, None
        }
      }
    }
    const sent = outgoing
    outgoing = []
    sent
  }

  private var fn handle(message: JsonValue) {
    const method = match textAt(message, ["method"]) {
      Some(name) => name
      None => {
        // A response to a request of the server's: it sends none
        return
      }
    }
    const parameters = memberAt(message, ["params"]) ?? JsonValue.Null
    match memberAt(message, ["id"]) {
      Some(id) => request id, method, parameters
      None => notify method, parameters
    }
  }

  private var fn request(id: JsonValue, method: String, parameters: JsonValue) {
    if phase == Phase.Starting && method != "initialize" {
      respondError(id, -32002, "the server is not initialized")
      return
    }
    if phase == Phase.ShuttingDown {
      respondError(id, -32600, "the server is shutting down")
      return
    }
    match method {
      "initialize" => respond id, initialize(parameters)
      "shutdown" => {
        phase = Phase.ShuttingDown
        respond id, JsonValue.Null
      }
      "textDocument/hover" => respond id, hover(parameters)
      "textDocument/definition" => respond id, definition(parameters)
      "textDocument/completion" => respond id, completion(parameters)
      "textDocument/semanticTokens/full" => respond id, semanticTokens(parameters)
      "textDocument/codeAction" => respond id, codeActions(parameters)
      // Of this server's own, and `experimental` in the capabilities says so: the tests of a file, for an editor
      "torbscript/tests" => respond id, testsOf(parameters)
      _ => respondError(id, -32601, "`{method}` is not a request this server answers")
    }
  }

  private var fn notify(method: String, parameters: JsonValue) {
    match method {
      "exit" => {
        phase = Phase.Exited(if phase == Phase.ShuttingDown { 0 } else { 1 })
      }
      "textDocument/didOpen" => opened parameters
      "textDocument/didChange" => changedDocument parameters
      "textDocument/didClose" => closed parameters
      "workspace/didChangeWatchedFiles" => watchedFilesChanged parameters
      // `initialized`, `$/cancelRequest`, `$/setTrace`, `textDocument/didSave`, `workspace/didChangeConfiguration`:
      // nothing to do. A request is answered before the next message is read, so none is ever cancelled in flight
      _ => {}
    }
  }

  // --- The life cycle --------------------------------------------------------------------------------------------------

  private var fn initialize(parameters: JsonValue): JsonValue {
    if readsDisk {
      var roots: List<String> = []
      for folder in itemsAt(parameters, ["workspaceFolders"]) {
        if const Some(uri) = textAt(folder, ["uri"]) {
          roots.append uri
        }
      }
      if roots.isEmpty() {
        if const Some(uri) = textAt(parameters, ["rootUri"]) {
          roots.append uri
        }
      }
      for uri in roots {
        addFolder uri
      }
    }
    phase = Phase.Running
    object([
      ("capabilities", capabilities()),
      ("serverInfo", object([("name", text("torb")), ("version", text(languageVersion))])),
    ])
  }

  /** A folder of the workspace, read the way `torb check` reads it, as a project of its own. */
  private var fn addFolder(uri: String) {
    const root = match absolutePathOf(uri) {
      Some(found) => found
      None => {
        log.append "not a folder on disk, not read: {uri}"
        return
      }
    }
    match readTreeOf(root) {
      Some(tree) => projects.append Project(Locations.of(uri, root), tree)
      None => log.append "the folder could not be read: {root}"
    }
  }

  /** What the client is told the server does. */
  private fn capabilities(): JsonValue {
    const legend = object([
      ("tokenTypes", array(tokenTypes().map(text).toList())),
      ("tokenModifiers", array(tokenModifiers().map(text).toList())),
    ])
    object([
      ("positionEncoding", text("utf-16")),
      // 2: incremental changes, each a range and its new text
      ("textDocumentSync", object([("openClose", JsonValue.Bool(true)), ("change", integer(2))])),
      ("hoverProvider", JsonValue.Bool(true)),
      ("definitionProvider", JsonValue.Bool(true)),
      ("completionProvider", object([("triggerCharacters", array([text(".")]))])),
      ("semanticTokensProvider", object([("legend", legend), ("full", JsonValue.Bool(true))])),
      ("codeActionProvider", object([("codeActionKinds", array([text("quickfix")]))])),
      // The requests of this server's own: `torbscript/tests`
      ("experimental", object([("tests", JsonValue.Bool(true))])),
    ])
  }

  // --- Projects and documents ------------------------------------------------------------------------------------------

  /**
   * The project a URI belongs to and the path it names there: the innermost folder whose root holds it, a project whose
   * tree holds the file, or - for a file of no folder - a project of its own surroundings. `None` for a URI that is no
   * file.
   */
  private var fn placeOf(uri: String): (Int, String)? {
    var found: (Int, String)? = None
    var longest = -1
    for (index, project) in projects.indexed() {
      if const Some(path) = project.locations.pathBelow(uri) {
        if project.locations.rootUri.byteLength() > longest {
          longest = project.locations.rootUri.byteLength()
          found = (index, path)
        }
      }
    }
    if found.isSome() {
      return found
    }
    const path = absolutePathOf(uri)?
    for (index, project) in projects.indexed() {
      if project.holds(path) {
        return (index, path)
      }
    }
    if !readsDisk {
      return None
    }
    const tree = readTreeOf(path)?
    projects.append Project(Locations.of("", "."), tree, isFolder: false)
    (projects.length() - 1, path)
  }

  /** The URI of a path, in the spelling of the folder that holds it. */
  private fn uriOf(path: String): String {
    var best: Locations? = None
    var longest = -1
    for project in projects {
      if project.locations.holds(path) && project.locations.rootUri.byteLength() > longest {
        longest = project.locations.rootUri.byteLength()
        best = project.locations
      }
    }
    match best {
      Some(locations) => locations.uriOf path
      None => fileUriOf normalizePath(path)
    }
  }

  private var fn opened(parameters: JsonValue) {
    const uri = textAt(parameters, ["textDocument", "uri"]) ?? ""
    const (index, path) = match placeOf(uri) {
      Some(found) => found
      None => {
        log.append "not a file, not checked: {uri}"
        return
      }
    }
    const content = textAt(parameters, ["textDocument", "text"]) ?? ""
    const version = integerAt(parameters, ["textDocument", "version"]) ?? 0
    documents.set path, Document(uri, path, version, content, index)
    var project = projects[index]
    project.tree = project.tree.withFile path, content
    project.markChanged path
    projects.set index, project
  }

  private var fn changedDocument(parameters: JsonValue) {
    const document = match documentOf(parameters) {
      Some(found) => found
      None => {
        log.append "a change of a document that is not open: {textAt(parameters, ["textDocument", "uri"]) ?? ""}"
        return
      }
    }
    var content = document.text
    for change in itemsAt(parameters, ["contentChanges"]) {
      const replacement = textAt(change, ["text"]) ?? ""
      content = match rangeAt(change, ["range"]) {
        Some(range) => {
          const lines = LineMap.of content
          const start = lines.offsetOf range.start
          const end = lines.offsetOf(range.end).max(start)
          content.sliceBytes(0, start) + replacement + content.sliceBytes(end, content.byteLength())
        }
        None => replacement
      }
    }
    const version = integerAt(parameters, ["textDocument", "version"]) ?? document.version
    documents.set document.path, document.copy(version: version, text: content)
    var project = projects[document.project]
    project.tree = project.tree.withFile document.path, content
    project.markChanged document.path
    projects.set document.project, project
  }

  private var fn closed(parameters: JsonValue) {
    const document = match documentOf(parameters) {
      Some(found) => found
      None => {
        return
      }
    }
    const path = document.path
    const _document = documents.remove path
    var project = projects[document.project]
    const _view = project.views.remove path
    const _findings = project.findings.remove path
    // The front holds the text of the document, and the disk holds the text everybody else sees now
    project.front = None
    project.changed = project.changed.filter({ _ != path }).toList()
    if readsDisk {
      if const Ok(onDisk) = File.readText(path) {
        project.tree = project.tree.withFile path, onDisk
      }
    }
    projects.set document.project, project
    publish document.uri, []
  }

  /** A file the client watches changed on disk: an open document keeps its own text, every other file is read again. */
  private var fn watchedFilesChanged(parameters: JsonValue) {
    if !readsDisk {
      return
    }
    for change in itemsAt(parameters, ["changes"]) {
      const uri = textAt(change, ["uri"]) ?? ""
      const (index, path) = match placeOf(uri) {
        Some(found) => found
        None => {
          continue
        }
      }
      if documents.containsKey(path) {
        continue
      }
      if const Ok(onDisk) = File.readText(path) {
        var project = projects[index]
        project.tree = project.tree.withFile path, onDisk
        // Every open document may import what changed; the next run asks all of them again
        project.front = None
        for (open, document) in documents {
          if document.project == index {
            project.markChanged open
          }
        }
        projects.set index, project
      }
    }
  }

  // --- The checker -----------------------------------------------------------------------------------------------------

  /**
   * Brings the views of a project up to date: every document that changed, every open document that imports one whose
   * interface changed, and `also` (the document a request is about, where no run has checked it yet). Publishes what
   * each document it touched has now.
   */
  private var fn refresh(index: Int, also: String?) {
    var project = projects[index]
    const tree = project.tree
    var open: List<String> = []
    for (path, document) in documents {
      if document.project == index {
        open.append path
      }
    }
    var changed: List<String> = []
    for path in project.changed {
      if open.contains(path) {
        changed.append path
      }
    }
    project.changed = []
    const wanted = match also {
      Some(path) => if open.contains(path) && !project.views.containsKey(path) { Some path } else { None }
      None => None
    }
    if changed.isEmpty() && wanted.isNone() {
      projects.set index, project
      return
    }
    const started = Clock.milliseconds()
    // The front of the last run with the changed documents read again - or, where that is not right or it has served
    // long enough (each such run adds the symbols of a file's type parameters once more), a front from scratch
    var refreshed: Front? = None
    if const Some(last) = project.front {
      if project.frontRuns < frontRunLimit && open.all({ last.program.graph.moduleAt(_).isSome() }) {
        refreshed = refreshedFrontOf tree, last, changed
      }
    }
    var current = match refreshed {
      Some(found) => {
        project.frontRuns = project.frontRuns + 1
        found
      }
      None => {
        project.frontRuns = 0
        frontOf tree, open, withTimings: true, onlyReached: true
      }
    }
    var whole: List<String> = []
    var interfaces: List<String> = []
    var updated: List<String> = []
    var bodies: List<String> = []
    for path in changed {
      const view = match project.views.get(path) {
        Some(found) => found
        None => {
          addPath whole, path
          continue
        }
      }
      match viewAfterChange(view, tree, current, path) {
        Some(next) => {
          project.views.set path, next
          addPath updated, path
          if const Some(overlay) = next.overlay {
            bodies.append "{next.mapping.changed.length()} of {path}"
            logTimings "checked the changed bodies", overlay
          }
        }
        None => {
          addPath whole, path
          interfaces.append path
        }
      }
    }
    // A document whose interface changed may change what every document that imports it finds
    for path in interfaces {
      if const Some(view) = project.views.get(path) {
        for dependent in dependentsOf(view.base, path, open) {
          addPath whole, dependent
        }
      }
    }
    if const Some(path) = wanted {
      addPath whole, path
    }
    if !whole.isEmpty() {
      var analysis = analyzeOver tree, current, whole
      if analysis.isNone() && refreshed.isSome() {
        // A document the front of the last run did not reach
        project.frontRuns = 0
        current = frontOf tree, open, withTimings: true, onlyReached: true
        analysis = analyzeOver tree, current, whole
      }
      if const Some(found) = analysis {
        logTimings "checked {whole.length()} document(s)", found
        for path in whole {
          project.views.set path, DocumentView.of(path, found)
          addPath updated, path
        }
      }
    }
    project.front = current
    project.tree = tree.withParsed parsesOfProgram(current.program)
    const checkedAt = Clock.milliseconds()
    for path in updated {
      const document = match documents.get(path) {
        Some(found) => found
        None => {
          continue
        }
      }
      const view = match project.views.get(path) {
        Some(found) => found
        None => {
          continue
        }
      }
      const problems = documentDiagnostics view, current
      const found = documentFindings view, current, clean: problems.isEmpty()
      project.findings.set path, found
      publish document.uri, diagnosticsJson(LineMap.of(document.text), problems, found)
    }
    projects.set index, project
    const finished = Clock.milliseconds()
    const kept = if bodies.isEmpty() { "" } else { ", bodies: {bodies.joined(separator: ", ")}" }
    log.append "refreshed {updated.length()} document(s) in {checkedAt - started} ms{kept}, published in {finished - checkedAt} ms"
  }

  /** One line of standard error with the cost of every pass of a run. */
  private var fn logTimings(what: String, analysis: Analysis) {
    var passes: List<String> = []
    for timing in analysis.checked.checker.timings {
      if timing.milliseconds > 0 {
        passes.append "{timing.pass} {timing.milliseconds}"
      }
    }
    log.append "{what}: {passes.joined(separator: ", ")}"
  }

  /** The open document a request names, with its project. */
  private var fn documentOf(parameters: JsonValue): Document? {
    const uri = textAt(parameters, ["textDocument", "uri"]) ?? ""
    const (_, path) = placeOf(uri)?
    documents.get path
  }

  /** The view of a document, brought up to date where its text changed since its last run or none has checked it. */
  private var fn viewOf(document: Document): DocumentView? {
    const project = projects[document.project]
    if project.changed.contains(document.path) || !project.views.containsKey(document.path) {
      refresh document.project, document.path
    }
    projects[document.project].views.get document.path
  }

  /**
   * The document a request about a position names, its view, the run that knows the code at the position and the offset
   * there. `None` for a document that is not open, one no run could check, and a position no run knows.
   */
  private var fn located(parameters: JsonValue): (Document, DocumentView, Located)? {
    const document = documentOf(parameters)?
    const view = viewOf(document)?
    const position = positionAt(parameters, ["position"]) ?? Position(0, 0)
    const offset = LineMap.of(document.text).offsetOf(position)
    (document, view, view.layerAt(offset)?)
  }

  /**
   * Where a span of the file at `path` in the text the run `analysis` read is now: through the view of the document
   * where it is the open one a question was about, through a mapping of the two texts where the file changed since the
   * run, and as it is where it did not. `None` where the code it was about changed.
   */
  private fn currentSpanOf(
    document: Document,
    view: DocumentView,
    layer: Layer,
    analysis: Analysis,
    path: String,
    span: Span,
  ): Span? {
    if path == document.path {
      return view.currentSpan layer, span
    }
    const project = projects[document.project]
    const now = project.tree.text(path) ?? ""
    const module = analysis.moduleOf(path)?
    const earlier = analysis.checked.program.graph.at module
    if earlier.source.text == now {
      return span
    }
    const front = project.front?
    const currentModule = front.program.graph.moduleAt(path)?
    const current = front.program.graph.at currentModule
    const mapping = mappingBetween(earlier.file, earlier.source.text, current.file, current.source.text)?
    mapping.toCurrent span
  }

  // --- Requests about a position ---------------------------------------------------------------------------------------

  private var fn hover(parameters: JsonValue): JsonValue {
    const (document, view, at) = match located(parameters) {
      Some(found) => found
      None => {
        return JsonValue.Null
      }
    }
    const found = match hoverOf(at.analysis, document.path, at.offset) {
      Some(thing) => thing
      None => {
        return JsonValue.Null
      }
    }
    var entries = [("contents", object([("kind", text("markdown")), ("value", text(found.markdown))]))]
    if const Some(span) = view.currentSpan(at.layer, found.span) {
      entries.append(("range", rangeJson(LineMap.of(document.text).rangeOf(span))))
    }
    object entries
  }

  private var fn definition(parameters: JsonValue): JsonValue {
    const (document, view, at) = match located(parameters) {
      Some(found) => found
      None => {
        return JsonValue.Null
      }
    }
    const place = match definitionOf(at.analysis, document.path, at.offset) {
      Some(found) => found
      None => {
        return JsonValue.Null
      }
    }
    const span = match currentSpanOf(document, view, at.layer, at.analysis, place.path, place.span) {
      Some(found) => found
      None => {
        return JsonValue.Null
      }
    }
    const project = projects[document.project]
    const lines = LineMap.of(
      if place.path == document.path { document.text } else { project.tree.text(place.path) ?? "" },
    )
    object([("uri", text(uriOf(place.path))), ("range", rangeJson(lines.rangeOf(span)))])
  }

  /**
   * The completion at a position. Behind a `.` where no expression of the run ends at it - the text around it does not
   * parse yet - the text without the member access is checked once more, and its run answers.
   */
  private var fn completion(parameters: JsonValue): JsonValue {
    const document = match documentOf(parameters) {
      Some(found) => found
      None => {
        return JsonValue.Null
      }
    }
    const view = match viewOf(document) {
      Some(found) => found
      None => {
        return JsonValue.Null
      }
    }
    const offset = LineMap.of(document.text).offsetOf(positionAt(parameters, ["position"]) ?? Position(0, 0))
    match completionContextOf(document.text, offset) {
      .Name(_) => {
        match view.layerAt(offset) {
          Some(at) => nameCompletion at.analysis, document.path, at.offset
          None => JsonValue.Null
        }
      }
      .Member(receiverEnd, dot, optional) => {
        if const Some(at) = view.layerAt(receiverEnd) {
          if const Some(found) = memberCompletion(at.analysis, document.path, at.offset, optional) {
            return found
          }
        }
        const retried = match viewOfText(document, view, withoutMemberAccess(document.text, dot, offset, optional)) {
          Some(found) => found
          None => {
            return JsonValue.Null
          }
        }
        match retried.layerAt(receiverEnd) {
          Some(at) => memberCompletion(at.analysis, document.path, at.offset, optional) ?? JsonValue.Null
          None => JsonValue.Null
        }
      }
    }
  }

  /** A view of the document with another text, which nobody keeps: what a completion behind a `.` asks once more. */
  private fn viewOfText(document: Document, view: DocumentView, content: String): DocumentView? {
    const project = projects[document.project]
    const tree = project.tree.withFile document.path, content
    const last = project.front?
    const current = refreshedFrontOf(tree, last, [document.path])?
    if const Some(found) = viewAfterChange(view, tree, current, document.path, comparesFacts: false) {
      return found
    }
    DocumentView.of(document.path, analyzeOver(tree, current, [document.path])?)
  }

  private var fn semanticTokens(parameters: JsonValue): JsonValue {
    const document = match documentOf(parameters) {
      Some(found) => found
      None => {
        return JsonValue.Null
      }
    }
    const view = match viewOf(document) {
      Some(found) => found
      None => {
        return JsonValue.Null
      }
    }
    match projects[document.project].front {
      Some(current) => semanticTokensOf view, current
      None => JsonValue.Null
    }
  }

  private var fn codeActions(parameters: JsonValue): JsonValue {
    const document = match documentOf(parameters) {
      Some(found) => found
      None => {
        return array([])
      }
    }
    const _view = viewOf document
    const range = rangeAt(parameters, ["range"]) ?? Range(Position(0, 0), Position(0, 0))
    const lines = LineMap.of document.text
    const from = lines.offsetOf range.start
    const to = lines.offsetOf range.end
    const findings = projects[document.project].findings.get(document.path) ?? []
    codeActionsOf findings, document, from, to
  }

  /**
   * `torbscript/tests`: the tests and groups of a file (`./test-tree`), from the text the client holds where it opened
   * the document and from the disk where it did not - a parse, and no run of the checker. A URI that is no file, or a
   * file that cannot be read, has none: the answer is an empty array and never an error.
   */
  private var fn testsOf(parameters: JsonValue): JsonValue {
    const uri = textAt(parameters, ["textDocument", "uri"]) ?? ""
    const (index, path) = match placeOf(uri) {
      Some(found) => found
      None => {
        return array([])
      }
    }
    const source: String? = match documents.get(path) {
      Some(document) => document.text
      None => textOnDisk index, path
    }
    match source {
      Some(found) => testTreeOf found
      None => array([])
    }
  }

  /** What the disk holds now, and not what the tree read of it before; a tree built in memory is its own disk. */
  private fn textOnDisk(project: Int, path: String): String? {
    if readsDisk {
      return File.readText(path).ok()
    }
    projects[project].tree.text path
  }

  // --- Messages --------------------------------------------------------------------------------------------------------

  private var fn respond(id: JsonValue, result: JsonValue) {
    outgoing.append object([("jsonrpc", text("2.0")), ("id", id), ("result", result)])
  }

  private var fn respondError(id: JsonValue, code: Int, message: String) {
    log.append "error {code}: {message}"
    const problem = object([("code", integer(code)), ("message", text(message))])
    outgoing.append object([("jsonrpc", text("2.0")), ("id", id), ("error", problem)])
  }

  private var fn publish(uri: String, diagnostics: List<JsonValue>) {
    const parameters = object([("uri", text(uri)), ("diagnostics", array(diagnostics))])
    outgoing.append(object([
      ("jsonrpc", text("2.0")),
      ("method", text("textDocument/publishDiagnostics")),
      ("params", parameters),
    ]))
  }
}

/**
 * How many runs one front serves before it is built from scratch again. Each run over it declares the type parameters
 * of the changed files once more, so the symbols of the program grow by a few per keystroke until then.
 */
const frontRunLimit = 200

/** Adds a path to a list that does not hold it yet. */
fn addPath(var paths: List<String>, path: String) {
  if !paths.contains(path) {
    paths.append path
  }
}

/** The files of the workspace around a path, read the way `torb check` reads them; `None` where that fails. */
fn readTreeOf(path: String): SourceTree? {
  readSourceTree([path]).ok()
}

fn positionAt(value: JsonValue, path: List<String>): Position? {
  const line = integerAt(value, path.appended("line"))?
  const character = integerAt(value, path.appended("character"))?
  Position line, character
}

fn rangeAt(value: JsonValue, path: List<String>): Range? {
  const start = positionAt(value, path.appended("start"))?
  const end = positionAt(value, path.appended("end"))?
  Range start, end
}
