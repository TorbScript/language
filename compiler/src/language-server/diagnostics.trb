/**
 * What `textDocument/publishDiagnostics` says about a document: every problem `torb check` reports for it, as an error
 * with its range, and every finding of `torb lint`'s rules, as a hint that names its rule - a hint, because the rules
 * are the style the checker leaves alone and `torb lint` is no gate. A finding with a fix is where the quick fix of
 * `./actions.trb` is offered.
 */

use JsonValue from "std/json"
use Diagnostic from "../syntax/diagnostic"
use Finding, LintRule, everyLintRule from "../lint/finding"
use lintFindings from "../lint/command"
use labeledLiteralFindings from "../lint/labeled-literal"
use redundantWrapFindings from "../lint/redundant-wrap"
use plainBindingStarts from "../lint/plain-values"
use Analysis from "./analysis"
use LineMap, Range from "./position"
use object, integer, text, array from "./json"

/** The severities of the protocol that the server uses. */
const errorSeverity = 1
const hintSeverity = 4

/** The tag of a diagnostic about code nothing needs, which an editor fades. */
const unnecessaryTag = 1

/** The diagnostics of one document: the checker's problems, then the findings of the lint rules. */
public fn diagnosticsOf(analysis: Analysis, path: String, current: String, findings: List<Finding>): List<JsonValue> {
  const source = analysis.textOf(path) ?? current
  const lines = LineMap.of source
  var found: List<JsonValue> = []
  if const Some(file) = analysis.fileOf(path) {
    for diagnostic in file.diagnostics {
      found.append problemOf(lines, diagnostic)
    }
  }
  for finding in findings {
    found.append findingOf(lines, finding)
  }
  found
}

/**
 * What the rules of `torb lint` find in one document of a run: the rules that read the syntax tree wherever the file
 * parses, and the rules that read the checker's tables only where the checker found no problem - as `torb lint` does,
 * because the tables of a file with a problem are not whole.
 */
public fn findingsOf(analysis: Analysis, path: String): List<Finding> {
  const module = match analysis.moduleOf(path) {
    Some(found) => found
    None => {
      return []
    }
  }
  const checker = analysis.checked.checker
  const shape = analysis.checked.program.graph.at module
  const isClean = analysis.fileOf(path).map({ _.diagnostics.isEmpty() }) ?? false
  const plain = if isClean { Some plainBindingStarts(checker, module) } else { None }
  var findings = lintFindings(shape.source.text, everyLintRule(), plain) ?? []
  if isClean {
    findings.appendAll labeledLiteralFindings(checker, module, shape.file)
    findings.appendAll redundantWrapFindings(checker, module, shape.source.text, shape.file)
  }
  findings.sort({ _.span.start })
  findings
}

fn problemOf(lines: LineMap, diagnostic: Diagnostic): JsonValue {
  var message = diagnostic.message
  for note in diagnostic.notes {
    message = "{message}\n{note}"
  }
  object([
    ("range", rangeJson(lines.rangeOf(diagnostic.span))),
    ("severity", integer(errorSeverity)),
    ("source", text("torb")),
    ("message", text(message)),
  ])
}

/** A finding, with the id of its rule as the code, which is also what finds its fix again. */
public fn findingOf(lines: LineMap, finding: Finding): JsonValue {
  var entries = [
    ("range", rangeJson(lines.rangeOf(finding.span))),
    ("severity", integer(hintSeverity)),
    ("source", text("torb lint")),
    ("code", text(finding.rule.id())),
    ("message", text(finding.message)),
  ]
  if finding.rule == LintRule.UnreadBinding {
    entries.append(("tags", array([integer(unnecessaryTag)])))
  }
  object entries
}

public fn rangeJson(range: Range): JsonValue {
  object([
    ("start", object([("line", integer(range.start.line)), ("character", integer(range.start.character))])),
    ("end", object([("line", integer(range.end.line)), ("character", integer(range.end.character))])),
  ])
}
