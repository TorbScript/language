/**
 * What `textDocument/publishDiagnostics` says about a document: every problem `torb check` reports for it, as an error
 * with its range, and every finding of `torb lint`'s rules, as a hint that names its rule - a hint, because the rules
 * are the style the checker leaves alone and `torb lint` is no gate. A finding with a fix is where the quick fix of
 * `./actions.trb` is offered.
 */

use JsonValue from "std/json"
use Diagnostic from "../syntax/diagnostic"
use Finding, LintRule from "../lint/finding"
use LineMap, Range from "./position"
use object, integer, text, array from "./json"

/** The severities of the protocol that the server uses. */
const errorSeverity = 1
const hintSeverity = 4

/** The tag of a diagnostic about code nothing needs, which an editor fades. */
const unnecessaryTag = 1

/** The diagnostics of one document in the protocol's form: the checker's problems, then the findings of the lint rules. */
public fn diagnosticsJson(lines: LineMap, problems: List<Diagnostic>, findings: List<Finding>): List<JsonValue> {
  var found: List<JsonValue> = []
  for diagnostic in problems {
    found.append problemOf(lines, diagnostic)
  }
  for finding in findings {
    found.append findingOf(lines, finding)
  }
  found
}

/** A problem of `torb check` as an error of the protocol, its notes on lines of their own below the message. */
public fn problemOf(lines: LineMap, diagnostic: Diagnostic): JsonValue {
  var message = diagnostic.message
  for note in diagnostic.notes {
    message = "{message}\n{note}"
  }
  object([
    ("range", rangeJson(lines.rangeOf(diagnostic.span))),
    ("severity", integer(errorSeverity)),
    ("source", text("torb")),
    ("message", text(message)),
  ])
}

/** A finding, with the id of its rule as the code, which is also what finds its fix again. */
public fn findingOf(lines: LineMap, finding: Finding): JsonValue {
  var entries = [
    ("range", rangeJson(lines.rangeOf(finding.span))),
    ("severity", integer(hintSeverity)),
    ("source", text("torb lint")),
    ("code", text(finding.rule.id())),
    ("message", text(finding.message)),
  ]
  if finding.rule == LintRule.UnreadBinding {
    entries.append(("tags", array([integer(unnecessaryTag)])))
  }
  object entries
}

public fn rangeJson(range: Range): JsonValue {
  object([
    ("start", object([("line", integer(range.start.line)), ("character", integer(range.start.character))])),
    ("end", object([("line", integer(range.end.line)), ("character", integer(range.end.character))])),
  ])
}
