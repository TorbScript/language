/**
 * What stands at a byte offset of a module, as the checker's tables say: the question hover, go to definition, the
 * references and a rename all start from.
 *
 * The tables are keyed by span, so the answer is the **smallest** span that contains the offset: of `a.b.c` with the
 * offset on `b`, that is `a.b`, whose resolution is the member `b`. An offset right behind the last character of a name
 * still counts as on it, which is where an editor's cursor stands after typing it.
 */

use Span from "../syntax/source"
use Checked from "../semantics/check"
use ModuleId from "../semantics/module"
use SymbolId, SymbolKind from "../semantics/symbols"
use Resolution, BindingId from "../semantics/checker/context"
use TypeId from "../semantics/checker/type"

/** One thing the tables know at an offset. */
public type Found {
  /** A name, a member, a call or a constructor in an expression, and what it resolved to */
  case Resolved(span: Span, resolution: Resolution)
  /** A name in a type position */
  case TypeName(span: Span, symbol: SymbolId)
  /** The name of a declaration: a `fn`, a `type` and its fields, cases and members, a module constant */
  case Declared(span: Span, symbol: SymbolId)
  /** The name of a local binding where it is bound: a `const`, a parameter, a pattern */
  case Bound(span: Span, binding: BindingId)
  /** An expression the checker typed, where nothing above says more */
  case Typed(span: Span, result: TypeId)

  fn span(): Span {
    match self {
      .Resolved(span, _) => span
      .TypeName(span, _) => span
      .Declared(span, _) => span
      .Bound(span, _) => span
      .Typed(span, _) => span
    }
  }
}

/** Whether the span holds the offset, the position right behind its last byte included. */
fn holds(span: Span, offset: Int): Bool {
  span.start <= offset && offset <= span.end
}

/** Whether `span` is a better answer than `best`: it holds the offset and is smaller. */
fn isNarrower(span: Span, best: Found?): Bool {
  match best {
    Some(found) => span.end - span.start < found.span().end - found.span().start
    None => true
  }
}

/** Whether the text holds `name` at `span`, which may lie anywhere: past the end, or inside of a character. */
fn isNamedAt(text: String, span: Span, name: String): Bool {
  if span.start < 0 || span.end > text.byteLength() || span.end - span.start != name.byteLength() {
    return false
  }
  // A name is ASCII, so each of its bytes is a character of its own
  for (index, byte) in name.bytes().indexed() {
    if text.byteAt(span.start + index) != byte {
      return false
    }
  }
  true
}

/** What stands at `offset` in `module`: the narrowest thing the tables know there. */
public fn foundAt(checked: Checked, module: ModuleId, offset: Int): Found? {
  const checker = checked.checker
  const tables = checker.tables[module.value]
  var best: Found? = None
  for (span, resolution) in tables.resolutions {
    if holds(span, offset) && resolution != Resolution.Deferred && isNarrower(span, best) {
      best = Found.Resolved span, resolution
    }
  }
  if const Some(names) = checked.resolutions.get(module.value) {
    for (span, symbol) in names {
      if holds(span, offset) && isNarrower(span, best) {
        best = Found.TypeName span, symbol
      }
    }
  }
  const text = checked.program.graph.at(module).source.text
  for (index, symbol) in checker.symbols.all.indexed() {
    if symbol.module == module && holds(symbol.span, offset) && isNarrower(symbol.span, best) {
      // A language server's run keeps the symbols of an earlier text of the file: a name that is not there any more
      if isNamedAt(text, symbol.span, symbol.name) {
        best = Found.Declared symbol.span, SymbolId(index)
      }
    }
  }
  for (index, binding) in checker.bindings.indexed() {
    if holds(binding.at, offset) && isNarrower(binding.at, best) {
      // The bindings of every body checked share one list; the name at the span says which module it belongs to
      if isNamedAt(text, binding.at, binding.name) {
        best = Found.Bound binding.at, BindingId(index)
      }
    }
  }
  if best.isSome() {
    return best
  }
  for (span, result) in tables.expressionTypes {
    if holds(span, offset) && isNarrower(span, best) {
      best = Found.Typed span, result
    }
  }
  best
}

/** The symbol a resolution leads to, where it leads to a declaration. */
public fn symbolOfResolution(checked: Checked, resolution: Resolution): SymbolId? {
  match resolution {
    .Callable(symbol, _, _) => symbol
    .Field(_, field) => field
    .Constant(symbol, _) => symbol
    .CaseOf(_, variant) => variant
    .PropertyWrite(_, field) => field
    .Construct(owner) => nominalSymbolOf checked, owner
    .CopyOf(owner) => nominalSymbolOf checked, owner
    .TypeOf(owner) => nominalSymbolOf checked, owner
    _ => None
  }
}

/** The declaration behind a type, where it has one. */
public fn nominalSymbolOf(checked: Checked, annotation: TypeId): SymbolId? {
  match checked.checker.types.form(annotation) {
    .Nominal(symbol, _) => symbol
    _ => None
  }
}

/** How a symbol is named in a completion or a hover: the word the source writes in front of it. */
public fn kindWord(kind: SymbolKind): String {
  match kind {
    .Function => "fn"
    .Type => "type"
    .Alias => "type"
    .Trait => "trait"
    .Constant => "const"
    .Case(_) => "case"
    .Field(_) => "field"
    .Namespace(_) => "module"
    .GenericParameter => "type parameter"
    .Builtin => "type"
  }
}
