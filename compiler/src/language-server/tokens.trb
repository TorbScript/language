/**
 * `textDocument/semanticTokens/full`: the tokens `torb highlight` gives a file, sharpened by the checker. The syntax
 * resolver of `../highlight` decides every name it can place from the file alone; where the checker knows more - the
 * member behind a `.` of a value whose type the file does not say, a name another module declares - its resolution
 * decides instead. That is the seam `memberTargetOf` of the resolver names, answered by the checker's tables.
 *
 * The legend is the one the editor extension has always declared for `torb highlight`, in the same order.
 */

use JsonValue from "std/json"
use Span from "../syntax/source"
use HighlightToken from "../highlight/token"
use resolveFile from "../highlight/resolve"
use Checker, Resolution from "../semantics/checker/context"
use SymbolKind from "../semantics/symbols"
use fieldsOf from "../semantics/checker/member"
use Front from "../semantics/check"
use ModuleId from "../semantics/module"
use DeprecatedUseForm, deprecatedNamesOf from "../semantics/checker/deprecation"
use DocumentView from "./view"
use LineMap, utf16Units from "./position"
use object, integer, array from "./json"

/** The token types of the legend, in the order their indices mean. */
public fn tokenTypes(): List<String> {
  [
    "type",
    "interface",
    "typeParameter",
    "enumMember",
    "namespace",
    "function",
    "method",
    "parameter",
    "variable",
    "property",
  ]
}

/** The token modifiers of the legend: bit `n` of a token's modifiers is the `n`-th of these. */
public fn tokenModifiers(): List<String> {
  ["declaration", "readonly", "static", "defaultLibrary", "mutable", "deprecated"]
}

/**
 * The semantic tokens of an open document as it is now, encoded as the protocol wants them: the resolver's tokens of
 * the current parse, sharpened by the base's resolutions outside of the changed bodies - moved to where their code is
 * now - and by the overlay's inside of them.
 */
public fn semanticTokensOf(view: DocumentView, current: Front): JsonValue {
  const module = match current.program.graph.moduleAt(view.path) {
    Some(found) => found
    None => {
      return object([("data", array([]))])
    }
  }
  const shape = current.program.graph.at module
  const source = shape.source.text
  var tokens = resolveFile shape.file
  if const Some(earlier) = view.base.moduleOf(view.path) {
    var checker = view.base.checked.checker
    checker.module = earlier
    var moved: Map<Span, Resolution> = [:]
    for (span, resolution) in checker.tables[earlier.value].resolutions {
      if view.mapping.touchesChangedEarlier(span) {
        continue
      }
      if const Some(now) = view.mapping.toCurrent(span) {
        moved.set now, resolution
      }
    }
    sharpened tokens, checker, moved, source
  }
  if const Some(changed) = view.overlay {
    if const Some(now) = changed.moduleOf(view.path) {
      var checker = changed.checked.checker
      checker.module = now
      var inside: Map<Span, Resolution> = [:]
      for (span, resolution) in checker.tables[now.value].resolutions {
        if view.mapping.isInsideChanged(span) {
          inside.set span, resolution
        }
      }
      sharpened tokens, checker, inside, source
    }
  }
  markDeprecated tokens, deprecatedSpansOf(view, current, module)
  object([("data", array(encoded(tokens, source).map(integer).toList()))])
}

/**
 * Every name of the document as it is now that is deprecated: each use of a deprecated declaration, from the run that
 * knows the code there - the base's moved to where they are now, the overlay's inside of the changed bodies - with the
 * kind of token it gets where the resolver placed none, and the name of every declaration of the file that is
 * deprecated itself.
 */
fn deprecatedSpansOf(view: DocumentView, current: Front, module: ModuleId): List<(Span, String)> {
  var spans: List<(Span, String)> = []
  if const Some(earlier) = view.base.moduleOf(view.path) {
    for found in view.base.checked.deprecatedUses {
      if found.module != earlier || view.mapping.touchesChangedEarlier(found.span) {
        continue
      }
      if const Some(now) = view.mapping.toCurrent(found.span) {
        spans.append((now, kindOfUse(found.form)))
      }
    }
  }
  if const Some(changed) = view.overlay {
    if const Some(now) = changed.moduleOf(view.path) {
      for found in changed.checked.deprecatedUses {
        if found.module == now && view.mapping.isInsideChanged(found.span) {
          spans.append((found.span, kindOfUse(found.form)))
        }
      }
    }
  }
  for name in deprecatedNamesOf(current.program.graph.at(module).file) {
    spans.append((name.span, ""))
  }
  spans
}

/**
 * The modifier `deprecated` on every token of these spans, which an editor strikes through. A use the resolver placed no
 * token on gets one of the kind it is paired with.
 */
fn markDeprecated(var tokens: List<HighlightToken>, spans: List<(Span, String)>) {
  if spans.isEmpty() {
    return
  }
  var wanted: Map<Span, String> = [:]
  for (span, kind) in spans {
    wanted.set span, kind
  }
  var marked: Set<Span> = Set.of()
  for index in 0..tokens.length() {
    const token = tokens[index]
    if wanted.containsKey(token.span) {
      tokens.set index, token.copy(modifiers: token.modifiers.appended("deprecated"))
      marked.insert token.span
    }
  }
  for (span, kind) in wanted {
    if !marked.contains(span) && !kind.isEmpty() {
      tokens.append HighlightToken(span, kind, ["deprecated"])
    }
  }
}

/** The kind of token a use gets where the resolver placed none: a type for a name in a type position. */
fn kindOfUse(form: DeprecatedUseForm): String {
  match form {
    .TypeName => "type"
    .Called => "function"
    .Read | .Assigned | .Label => "property"
  }
}

/**
 * The tokens with what the checker resolved: the member behind every `.` classified by the member it is, and every
 * plain name the resolver placed nowhere added. A resolution is recorded at the span of the expression that names it -
 * `a.b` for the member `b`, and the whole call for a call - so the member behind a `.` is the one of the smallest
 * span that ends with it, and a plain name is a span that is one name and nothing else.
 */
fn sharpened(var tokens: List<HighlightToken>, checker: Checker, resolutions: Map<Span, Resolution>, source: String) {
  var at: Map<Span, Int> = [:]
  for (index, token) in tokens.indexed() {
    at.set token.span, index
  }
  var endingAt: Map<Int, List<Span>> = [:]
  for (span, _) in resolutions {
    var spans = endingAt.get(span.end) ?? []
    spans.append span
    endingAt.set span.end, spans
  }
  var lookups = checker
  for index in 0..tokens.length() {
    const token = tokens[index]
    const afterDot = token.span.start > 0 && source.byteAt(token.span.start - 1) == 46
    if !afterDot {
      continue
    }
    var member: Span? = None
    for span in endingAt.get(token.span.end) ?? [] {
      const narrower = match member {
        Some(best) => span.start > best.start
        None => true
      }
      if span.start < token.span.start && narrower {
        member = span
      }
    }
    const resolution = match member {
      Some(span) => resolutions.get(span) ?? Resolution.Deferred
      None => {
        continue
      }
    }
    if const Some((kind, modifiers)) = classified(lookups, resolution) {
      // The resolver placed a member of a receiver it knew nothing about; the checker knows it
      const kept = if token.kind == kind { token.modifiers } else { modifiers }
      tokens.set index, HighlightToken(token.span, kind, kept)
    }
  }
  for (span, resolution) in resolutions {
    const bare = span.end > span.start && nameStartBefore(source, span.end) == span.start
    if !bare || at.containsKey(span) {
      continue
    }
    if const Some((kind, modifiers)) = classified(lookups, resolution) {
      at.set span, tokens.length()
      tokens.append HighlightToken(span, kind, modifiers)
    }
  }
}

/** The kind and the modifiers of a token for what a name resolved to; `None` where it says nothing a token could. */
fn classified(var checker: Checker, resolution: Resolution): (String, List<String>)? {
  match resolution {
    .Local(binding) => {
      const found = checker.binding binding
      const kind = if found.bindsParameter || found.bindsReceiver { "parameter" } else { "variable" }
      (kind, if found.var { ["mutable"] } else { ["readonly"] })
    }
    .Callable(symbol, _, _) => {
      if const Some(site) = checker.sites.get(symbol) {
        if const .Owned(_, _, _) = site.kind {
          return ("method", [])
        }
      }
      ("function", [])
    }
    .Field(owner, field) => {
      const changeable = fieldsOf(checker, owner).any({ _.symbol == field && _.var })
      ("property", if changeable { ["mutable"] } else { ["readonly"] })
    }
    .PropertyWrite(_, _) => ("property", ["mutable"])
    .Constant(_, owner) => {
      if owner.isSome() {
        ("property", ["static", "readonly"])
      } else {
        ("variable", ["readonly"])
      }
    }
    .CaseOf(_, _) => ("enumMember", [])
    .TypeOf(owner) | .Construct(owner) => {
      if const .Nominal(symbol, _) = checker.types.form(owner) {
        if checker.symbolAt(symbol).kind == SymbolKind.Trait {
          return ("interface", [])
        }
      }
      ("type", [])
    }
    .CopyOf(_) => ("method", [])
    .TupleField(_, _) => ("property", ["readonly"])
    .Namespace(_) => ("namespace", [])
    .Deferred => None
  }
}

/** Where the name that ends at `end` starts: the bytes of a name before it. */
fn nameStartBefore(source: String, end: Int): Int {
  var start = end.min source.byteLength()
  while start > 0 && isNameByte(source.byteAt(start - 1) ?? 0) {
    start = start - 1
  }
  start
}

fn isNameByte(byte: UInt8): Bool {
  (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95
}

/**
 * The tokens as the protocol's integers: five per token - the line relative to the token before, the character
 * relative to it where both are on one line, the length, the index of the type and the bits of the modifiers. Sorted
 * by position; a token on the span of one before it, one that overlaps it and one that crosses a line break are
 * dropped, which keeps the promises of the protocol whatever the resolvers produced.
 */
fn encoded(tokens: List<HighlightToken>, source: String): List<Int> {
  var ordered = tokens
  ordered.sort({ (_.span.start, _.span.end) })
  const lines = LineMap.of source
  const types = tokenTypes()
  const modifiers = tokenModifiers()
  var data: List<Int> = []
  var previousLine = 0
  var previousCharacter = 0
  var previousEnd = -1
  for token in ordered {
    if token.span.start < previousEnd || token.span.end <= token.span.start {
      continue
    }
    const kind = match types.indexOf(token.kind) {
      Some(found) => found
      None => {
        continue
      }
    }
    const piece = source.sliceBytes token.span.start, token.span.end
    if piece.contains("\n") {
      continue
    }
    var bits = 0
    for modifier in token.modifiers {
      if const Some(index) = modifiers.indexOf(modifier) {
        bits = bits | (1 << index)
      }
    }
    const position = lines.positionOf token.span.start
    const deltaLine = position.line - previousLine
    const deltaCharacter = if deltaLine == 0 { position.character - previousCharacter } else { position.character }
    data.appendAll([deltaLine, deltaCharacter, utf16Units(piece), kind, bits])
    previousLine = position.line
    previousCharacter = position.character
    previousEnd = token.span.end
  }
  data
}
