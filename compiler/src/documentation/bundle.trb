/**
 * `torb docs bundle`: an `llms.txt` and an `llms-full.txt` (https://llmstxt.org/).
 *
 * The format is an H1, a blockquote summary, and H2 sections whose lists are `[title](path): notes`. It is worth the
 * sixty lines it costs here as a **manifest of the tree in one file** - something a person or a tool can be pointed at
 * with a single path - and for nothing else: measurements of real traffic (Ahrefs, May 2026: 97% of published
 * `llms.txt` files were never requested; SE Ranking over about 300 000 domains: no correlation with being cited) show
 * that no crawler reads it. Google has said it does not support it. So this file is an output of the documentation and
 * never an input to it, and the agent-facing form of the documentation is the skill `torb docs skill` builds instead.
 *
 * `llms-full.txt` is not part of that proposal - it is a convention Mintlify popularized - and it is the concatenation
 * of every page. It exists here for the one case the index cannot serve: a model without a file system that has to be
 * handed the whole documentation at once.
 *
 * # Related
 *
 * - [writeBundle] - writes both files to disk.
 */

use File, IoError from "std/fs"
use Documentation, Page, folderOf from "./tree"

/** The two files `torb docs bundle` writes: the index and the full concatenation. */
public type BundledDocumentation {
  index: String
  full: String
}

/** Builds both files of the bundle from the documentation tree. Writing them to disk is [writeBundle]. */
public fn bundleDocumentation(documentation: Documentation, title: String, summary: String): BundledDocumentation {
  BundledDocumentation bundleIndex(documentation, title, summary), bundleFull(documentation, title)
}

fn bundleIndex(documentation: Documentation, title: String, summary: String): String {
  var lines: List<String> = ["# {title}", "", "> {summary}", ""]
  lines.append "Every page is Markdown with front matter. `kind` says what a page is for, `status` how far it can be"
  lines.append "trusted, and `summary` what it answers."
  lines.append ""
  for folder in documentation.folders {
    const own = published folder.path, documentation
    if own.isEmpty() {
      continue
    }
    const heading = if folder.path.isEmpty() {
      "Start here"
    } else {
      match folder.index {
        Some(index) => index.frontMatter.text("title") ?? folder.path
        None => folder.path
      }
    }
    lines.append "## {heading}"
    lines.append ""
    for page in own {
      const pageTitle = page.frontMatter.text("title") ?? ""
      const pageSummary = page.frontMatter.text("summary") ?? ""
      lines.append "- [{pageTitle}]({page.path}): {pageSummary}"
    }
    lines.append ""
  }
  lines.append "## Optional"
  lines.append ""
  lines.append "- [The concept](../CONCEPT.md): the design source of truth of the language, longer and less finished than"
  lines.append "  the documentation."
  lines.append ""
  lines.joined separator: "\n"
}

/** Everything of one folder that a reader outside the repository should see, in path order. */
fn published(folder: String, documentation: Documentation): List<Page> {
  var kept: List<Page> = []
  for page in documentation.pages {
    if page.folder != folder {
      continue
    }
    const status = page.frontMatter.text("status") ?? "stable"
    const role = page.frontMatter.text("skill") ?? ""
    const kind = page.frontMatter.text("kind") ?? ""
    // The same exclusions as the skill: a planned feature is not a feature, and a page about the documentation itself
    // or a page of the website is of no use to somebody reading the documentation from outside, and neither is a lesson
    // of the course for beginners, which teaches in small steps what the other pages state
    const isForTheSite = kind == "site" || kind == "lesson"
    if status == "planned" || role == "omit" || isForTheSite || page.path == "index.md" {
      continue
    }
    kept.append page
  }
  kept
}

fn bundleFull(documentation: Documentation, title: String): String {
  var parts: List<String> = ["# {title}", ""]
  for folder in documentation.folders {
    for page in published(folder.path, documentation) {
      parts.append "<!-- {page.path} -->"
      parts.append ""
      parts.append page.text
      parts.append ""
    }
  }
  parts.joined separator: "\n"
}

/** Writes `llms.txt` and `llms-full.txt` into `out`, creating the directory if it does not exist yet. */
public fn writeBundle(out: String, bundled: BundledDocumentation): Result<Void, IoError> {
  File.createDirectory(out)?
  File.writeText("{out}/llms.txt", bundled.index)?
  File.writeText("{out}/llms-full.txt", bundled.full)?
  Ok(void)
}
