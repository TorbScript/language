/**
 * The reader of a documentation page: the front matter, the headings, the fenced code blocks and the links.
 *
 * The front matter between two `---` lines is read by `std/yaml`, with the subset of `docs/contributing` checked on
 * top of it, and the body by `std/markdown`: the headings, the fenced code blocks and the links come out of its
 * tree, each with its line, which is what lets a diagnostic name a line number - what a writer and an agent both need.
 * The prose the writing rules judge is every line of the body that is neither blank, nor a heading, nor in a fence.
 */

use Yaml, YamlNode, ScalarStyle from "std/yaml"
use Markdown, MarkdownBlock, MarkdownInline, plainText from "std/markdown"

/** A value of the front matter. The subset is documented in `docs/contributing/front-matter.md`. */
public type FieldValue {
  case Text(value: String)
  case Number(value: Int)
  /** An inline list (`[a, b]`) or a block list of scalars */
  case Items(values: List<String>)
}

/** One `key: value` of the front matter, with the line it stands on. */
public type Field {
  key: String
  value: FieldValue
  line: Int
}

/**
 * The front matter of a page. The order of the fields is the order of the file, so a message about a field points at
 * the line it was written on.
 */
public type FrontMatter {
  fields: List<Field>

  fn has(key: String): Bool {
    fields.any({ _.key == key })
  }

  fn at(key: String): Field? {
    fields.find({ _.key == key })
  }

  /** The value of a scalar field, or `None` when it is absent or a list. */
  fn text(key: String): String? {
    match at(key) {
      Some(field) => match field.value {
        .Text(value) => value
        .Number(value) => "{value}"
        .Items(_) => None
      }
      None => None
    }
  }

  fn number(key: String): Int? {
    match at(key) {
      Some(field) => match field.value {
        .Number(value) => value
        _ => None
      }
      None => None
    }
  }

  /** The items of a list field. A scalar counts as a list of one, so `source: CONCEPT.md` needs no brackets. */
  fn items(key: String): List<String> {
    match at(key) {
      Some(field) => match field.value {
        .Items(values) => values
        .Text(value) => [value]
        .Number(value) => ["{value}"]
      }
      None => []
    }
  }

  fn lineOf(key: String): Int {
    match at(key) {
      Some(field) => field.line
      None => 1
    }
  }
}

/** A heading of the body. The anchor is what a link after a `#` has to name. */
public type Heading {
  level: Int
  /** The text without the `#`, without an explicit `{#anchor}`, trimmed */
  text: String
  anchor: String
  /** `true` when the anchor was written as `{#anchor}` instead of derived from the text */
  isExplicit: Bool
  line: Int
}

/**
 * A fenced code block. `info` is what stands behind the three backticks; `language` is its first word and `marker`
 * the second one (`trb check`, `trb error`, `trb skip <reason>`).
 */
public type CodeBlock {
  info: String
  language: String
  marker: String
  /** Everything behind the marker: the reason of a `skip` */
  reason: String
  /** The lines of the block, joined with a line break. Never ends with one. */
  text: String
  /** The line of the opening fence */
  line: Int
  /** The line the content starts on */
  contentLine: Int
}

/** An inline link `[text](target)` or `[text](target#anchor)`. */
public type Link {
  text: String
  target: String
  /** Without the `#`, empty when the link has none */
  anchor: String
  line: Int
}

/** A problem of a documentation file, in the shape every command reports. */
public type DocumentationProblem {
  /** The path as it is shown: relative to the directory the command was started in */
  path: String
  /** 1-based; 0 for a problem that belongs to no line */
  line: Int
  message: String

  fn show(): String {
    if line == 0 {
      return "{path}: {message}"
    }
    "{path}:{line}: {message}"
  }
}

/** Everything the reader found in one file. */
public type ReadPage {
  /** `None` when the file does not start with a `---` line: then it is not a page */
  frontMatter: FrontMatter?
  /** The line the body starts on, 1-based */
  bodyLine: Int
  headings: List<Heading>
  blocks: List<CodeBlock>
  links: List<Link>
  /** Every line of the body that is neither blank, nor a heading, nor inside a fence */
  prose: List<(line: Int, text: String)>
  /** The body as text, without the front matter */
  body: String
  problems: List<DocumentationProblem>
}

/** The lines of a file, without their line breaks and without a trailing carriage return. */
public fn linesOf(text: String): List<String> {
  var lines: List<String> = []
  for line in text.split("\n") {
    lines.append(line.withoutSuffix("\r") ?? line)
  }
  lines
}

/**
 * Reads one file. `path` is only used in the problems, so this is a pure function over the text - which is what lets
 * the tests hold their documents in a `Map`.
 */
public fn readPage(path: String, text: String): ReadPage {
  const lines = linesOf text
  var problems: List<DocumentationProblem> = []
  var bodyStart = 0
  var frontMatter: FrontMatter? = None
  if !lines.isEmpty() && lines[0].trim() == "---" {
    const end = closingDelimiter lines
    match end {
      Some(index) => {
        const read = readFrontMatter path, lines, 1, index
        problems.appendAll read.problems
        frontMatter = read.frontMatter
        bodyStart = index + 1
      }
      None => {
        problems.append DocumentationProblem(path, 1, "The front matter is never closed. A second `---` line ends it")
      }
    }
  }
  const scanned = scanBody path, lines, bodyStart
  scanned.copy frontMatter: frontMatter, problems: problems.appendedAll(scanned.problems)
}

/** The index of the `---` line that closes the front matter. */
fn closingDelimiter(lines: List<String>): Int? {
  var index = 1
  while index < lines.length() {
    if lines[index].trim() == "---" {
      return index
    }
    index = index + 1
  }
  None
}

type ReadFields {
  frontMatter: FrontMatter
  problems: List<DocumentationProblem>
}

/**
 * The front matter, between the two `---` lines, read by `std/yaml`. The subset of `docs/contributing/front-matter.md`
 * holds on top of YAML: one `key: value` per line, a value that is a plain or double-quoted scalar or a list of them, a
 * block list whose items are indented by two spaces and start with `- `, and no comment, tab, anchor, alias, tag or
 * value of several lines. What breaks it is a problem that names the line, because a front matter that is read
 * differently by two tools is worse than one that is rejected.
 */
fn readFrontMatter(path: String, lines: List<String>, from: Int, to: Int): ReadFields {
  var problems = lineProblems path, lines, from, to
  var text: List<String> = []
  for index in from..to {
    text.append lines[index]
  }
  const document = match Yaml().parse(text.joined(separator: "\n") + "\n") {
    Ok(found) => found
    Fail(problem) => {
      // A line rule has said what is wrong already where YAML cannot read the line
      if problems.isEmpty() {
        problems.append(DocumentationProblem(
          path,
          problem.line() + from,
          "The front matter is not YAML: {problem.message()}",
        ))
      }
      return ReadFields FrontMatter([]), problems
    }
  }
  const root = document.root
  if root.text() == "" {
    return ReadFields FrontMatter([]), problems
  }
  var fields: List<Field> = []
  for entry in root.entries() {
    const number = entry.key.line + from
    const key = match entry.key.content {
      .Scalar(found, ScalarStyle.Plain) => found
      _ => {
        problems.append DocumentationProblem(path, number, "A key of the front matter is a plain field name")
        continue
      }
    }
    if !isFieldKey(key) {
      problems.append(DocumentationProblem(
        path,
        number,
        "`{key}` is not a field name. A field name is lowercase letters and hyphens",
      ))
      continue
    }
    if fields.any({ _.key == key }) {
      problems.append DocumentationProblem(path, number, "The field `{key}` is written twice")
      continue
    }
    match fieldValue(path, key, entry.value, from) {
      Ok(value) => fields.append Field(key, value, number)
      Fail(problem) => problems.append problem
    }
  }
  ReadFields FrontMatter(fields), problems
}

/** The value of one field: a scalar, a number, or a list of scalars. */
fn fieldValue(path: String, key: String, node: YamlNode, from: Int): Result<FieldValue, DocumentationProblem> {
  const number = node.line + from
  if node.anchor.isSome() || node.tag.isSome() {
    return Fail(DocumentationProblem(
      path,
      number,
      "`{key}` has an anchor or a tag, which the front matter does not have",
    ))
  }
  match node.content {
    .Scalar(text, style) => {
      if style == ScalarStyle.Plain && text.isEmpty() {
        return Fail(DocumentationProblem(
          path,
          number,
          "`{key}` has no value. A block list needs at least one `- ` item below it",
        ))
      }
      if style != ScalarStyle.Plain && style != ScalarStyle.DoubleQuoted {
        return Fail DocumentationProblem(path, number, "`{key}` is a value on one line, plain or in double quotes")
      }
      if style == ScalarStyle.Plain && isNumber(text) {
        return FieldValue.Number numberOf(text)
      }
      FieldValue.Text text
    }
    .Sequence(items, _) => {
      var values: List<String> = []
      for item in items {
        match item.content {
          .Scalar(text, ScalarStyle.Plain) => values.append text
          .Scalar(text, ScalarStyle.DoubleQuoted) => values.append text
          _ => {
            return Fail(DocumentationProblem(
              path,
              item.line + from,
              "An item of `{key}` is a value on one line, plain or in double quotes",
            ))
          }
        }
      }
      FieldValue.Items values
    }
    .Mapping(_, _) => Fail(DocumentationProblem(
      path,
      number,
      "`{key}` holds a mapping. A value of the front matter is a scalar or a list",
    ))
    .Alias(_) => Fail DocumentationProblem(path, number, "`{key}` is an alias, which the front matter does not have")
  }
}

/**
 * The rules of the subset that are rules about lines: a line at the start of the front matter is `key: value`, an
 * indented one a list item, a value that contains `: ` or starts with a character YAML reserves is in double quotes,
 * and there is no tab and no comment.
 */
fn lineProblems(path: String, lines: List<String>, from: Int, to: Int): List<DocumentationProblem> {
  var problems: List<DocumentationProblem> = []
  for index in from..to {
    const line = lines[index]
    const number = index + 1
    if line.trim().isEmpty() {
      continue
    }
    if line.contains("\t") {
      problems.append(DocumentationProblem(
        path,
        number,
        "A tab is not part of the front matter: YAML indents with spaces",
      ))
      continue
    }
    if line.trim().startsWith("#") {
      problems.append DocumentationProblem(path, number, "A comment is not part of the front matter")
      continue
    }
    if line.startsWith(" ") {
      if !line.startsWith("  - ") {
        problems.append(DocumentationProblem(
          path,
          number,
          "An indented line in the front matter belongs to a list item and has to start with `- `",
        ))
        continue
      }
      if const Some(problem) = scalarProblem(path, number, line.sliceBytes(4, line.byteLength()).trim()) {
        problems.append problem
      }
      continue
    }
    const colon = match line.byteOffsetOf(":") {
      Some(found) => found
      None => {
        problems.append(DocumentationProblem(
          path,
          number,
          "A line of the front matter is `key: value`. There is no colon on this one",
        ))
        continue
      }
    }
    const rest = line.sliceBytes(colon + 1, line.byteLength()).trim()
    if rest.isEmpty() || rest.startsWith("[") {
      continue
    }
    if const Some(problem) = scalarProblem(path, number, rest) {
      problems.append problem
    }
  }
  problems
}

/**
 * The rule of one scalar. Either in double quotes, or bare, and then it must not start with a character that YAML
 * gives a meaning to and must not contain `: `, which ends a plain scalar there.
 */
fn scalarProblem(path: String, line: Int, text: String): DocumentationProblem? {
  if text.startsWith("\"") {
    if !text.endsWith("\"") || text.byteLength() < 2 {
      return DocumentationProblem path, line, "A quoted value ends with `\"` on the same line"
    }
    return None
  }
  if text.contains(": ") {
    return DocumentationProblem path, line, "`{text}` contains `: ` and has to be written in double quotes"
  }
  if startsWithIndicator(text) {
    return DocumentationProblem(
      path,
      line,
      "`{text}` starts with a character YAML reserves and has to be written in double quotes",
    )
  }
  None
}

/** The indicator characters of YAML that cannot start a plain scalar. */
fn startsWithIndicator(text: String): Bool {
  const indicators = ["-", "?", ":", ",", "[", "]", "{", "}", "#", "&", "*", "!", "|", ">", "'", "\"", "%", "@", "`"]
  indicators.any({ text.startsWith _ })
}

fn isNumber(text: String): Bool {
  const digits = text.withoutPrefix("-") ?? text
  if digits.isEmpty() {
    return false
  }
  digits.chars().all({ _.isDigit() })
}

fn numberOf(text: String): Int {
  const isNegative = text.startsWith "-"
  const digits = text.withoutPrefix("-") ?? text
  var value = 0
  for character in digits.chars() {
    value = value * 10 + (Int.from(character) - Int.from('0'))
  }
  if isNegative { -value } else { value }
}

/** A field name: lowercase letters and hyphens, starting with a letter. */
fn isFieldKey(key: String): Bool {
  if key.isEmpty() {
    return false
  }
  var first = true
  for character in key.chars() {
    const isLower = character >= 'a' && character <= 'z'
    if first {
      if !isLower {
        return false
      }
      first = false
      continue
    }
    if !isLower && character != '-' {
      return false
    }
  }
  true
}

/**
 * The headings, the fenced blocks, the links and the prose of the body, read by `std/markdown`: the headings of the top
 * level, the fenced code blocks and the links wherever they stand - in a list item, a quote, a table - and as prose
 * every line that is neither blank, nor a heading, nor inside a fence.
 */
fn scanBody(path: String, lines: List<String>, from: Int): ReadPage {
  var bodyLines: List<String> = []
  for index in from..lines.length() {
    bodyLines.append lines[index]
  }
  const body = bodyLines.joined separator: "\n"
  const document = Markdown(frontMatter: false).parse(body)
  var headings: List<Heading> = []
  for block in document.blocks {
    if const .Heading(level, inlines) = block.content {
      // The text of a heading is its source, markup included, which is what the writing rules judge
      const source = bodyLines.get(block.line - 1) ?? ""
      const text = if source.startsWith("#") { source.sliceBytes(level, source.byteLength()).trim() } else { plainText(inlines).trim() }
      headings.append headingOf(level, text, block.line + from)
    }
  }
  var scanner = BodyScanner path, bodyLines, from
  scanner.blocks document.blocks
  var prose: List<(line: Int, text: String)> = []
  for index in 0..bodyLines.length() {
    const line = bodyLines[index]
    const number = from + index + 1
    if scanner.codeLines.contains(number) {
      continue
    }
    if line.startsWith("#") {
      const hashes = fenceLengthOf line.replace("#", "`")
      const rest = line.sliceBytes hashes, line.byteLength()
      if !rest.isEmpty() && !rest.startsWith(" ") {
        scanner.problems.append DocumentationProblem(path, number, "A heading has a space behind its `#`")
      }
      continue
    }
    if !line.trim().isEmpty() {
      prose.append((line: number, text: line))
    }
  }
  ReadPage(None, from + 1, headings, scanner.codeBlocks, scanner.links, prose, body, scanner.problems)
}

/** A heading: its text, and its anchor - written as `\{#anchor\}`, or derived from the text. */
fn headingOf(level: Int, source: String, line: Int): Heading {
  var text = source
  var anchor = ""
  var isExplicit = false
  if text.endsWith("}") {
    if const Some(parts) = text.splitOnce("\{#") {
      anchor = parts.after.droppingLast characters: 1
      text = parts.before.trim()
      isExplicit = true
    }
  }
  if !isExplicit {
    anchor = anchorOf text
  }
  Heading level, text, anchor, isExplicit, line
}

/** Walks the blocks of a page for its fenced code blocks and its links. */
type BodyScanner {
  path: String
  bodyLines: List<String>
  /** How many lines of the file stand before the body. */
  from: Int
  var codeBlocks: List<CodeBlock> = []
  var links: List<Link> = []
  var problems: List<DocumentationProblem> = []
  /** The lines of the file inside a fenced code block, fences included. */
  var codeLines: Set<Int> = []

  var fn blocks(blocks: List<MarkdownBlock>) {
    for block in blocks {
      self.block block
    }
  }

  var fn block(block: MarkdownBlock) {
    match block.content {
      .Paragraph(inlines) => collectLinks inlines
      .Heading(_, inlines) => collectLinks inlines
      .CodeBlock(info, text, fenced) => {
        if fenced {
          codeBlock block, info, text
        }
      }
      .BlockQuote(children) => blocks children
      .ItemList(list) => {
        for item in list.items {
          blocks item.blocks
        }
      }
      .Table(table) => {
        for cell in table.header {
          collectLinks cell
        }
        for row in table.rows {
          for cell in row {
            collectLinks cell
          }
        }
      }
      _ => {}
    }
  }

  /**
   * One fenced block. `info` is what stands behind the fence: its first word the language, its second the marker, the
   * rest the reason of a `skip`. A block that runs to the end of what holds it was never closed.
   */
  var fn codeBlock(block: MarkdownBlock, info: String, text: String) {
    const line = block.line + from
    const endLine = block.endLine + from
    for number in line..(endLine + 1) {
      codeLines.insert number
    }
    const opening = bodyLines.get(block.line - 1) ?? ""
    if opening.trim().startsWith("~") {
      problems.append(DocumentationProblem(
        path,
        line,
        "A code block is fenced with three backticks and names its language",
      ))
    }
    var contentLines = 0
    for character in text.chars() {
      if character == '\n' {
        contentLines = contentLines + 1
      }
    }
    if endLine - line + 1 < contentLines + 2 {
      problems.append DocumentationProblem(path, line, "This code block is never closed")
    }
    const parts = words info
    const language = parts.get(0) ?? ""
    const marker = parts.get(1) ?? ""
    var reasonParts: List<String> = []
    for index in 2..parts.length().max(2) {
      reasonParts.append parts[index]
    }
    const content = if text.endsWith("\n") { text.sliceBytes(0, text.byteLength() - 1) } else { text }
    codeBlocks.append CodeBlock(info, language, marker, reasonParts.joined(separator: " "), content, line, line + 1)
  }

  /** Every link and image of the inlines, with the `#anchor` of its target apart. */
  var fn collectLinks(inlines: List<MarkdownInline>) {
    for inline in inlines {
      match inline {
        .Link(destination, _, children, line) => {
          links.append linkOf(plainText(children), destination, line + from)
          collectLinks children
        }
        .Image(destination, _, children, line) => links.append linkOf(plainText(children), destination, line + from)
        .Emphasis(children) => collectLinks children
        .Strong(children) => collectLinks children
        _ => {}
      }
    }
  }
}

fn linkOf(text: String, destination: String, line: Int): Link {
  match destination.splitOnce("#") {
    Some(parts) => Link text, parts.before, parts.after, line
    None => Link text, destination, "", line
  }
}

/** How many backticks a line starts with. A fence needs at least three. */
public fn fenceLengthOf(line: String): Int {
  var length = 0
  for character in line.chars() {
    if character != '`' {
      break
    }
    length = length + 1
  }
  length
}

/** How many spaces a line starts with: the indentation a fence inside a list item carries. */
public fn indentOf(line: String): Int {
  var length = 0
  for character in line.chars() {
    if character != ' ' {
      break
    }
    length = length + 1
  }
  length
}

/** The words of a text, separated by runs of spaces. */
public fn words(text: String): List<String> {
  var found: List<String> = []
  for part in text.split(" ") {
    const trimmed = part.trim()
    if !trimmed.isEmpty() {
      found.append trimmed
    }
  }
  found
}

/**
 * The anchor a heading gets: lowercase, every run of characters that is neither a letter, a digit, a hyphen nor an
 * underscore becomes one hyphen. That is the slug GitHub, Docusaurus and MkDocs agree on for plain headings, so a
 * link that works here works in every renderer.
 */
public fn anchorOf(text: String): String {
  var characters: List<Char> = []
  var lastWasHyphen = false
  for character in text.toLowerCase().chars() {
    const isKept = character.isLetter() || character.isDigit() || character == '-' || character == '_'
    if isKept {
      characters.append character
      lastWasHyphen = false
      continue
    }
    if !lastWasHyphen && !characters.isEmpty() {
      characters.append '-'
      lastWasHyphen = true
    }
  }
  var slug = String.from characters
  while slug.endsWith("-") {
    slug = slug.droppingLast characters: 1
  }
  slug
}
