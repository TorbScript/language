/**
 * The comments of a `.trb` file, read the way the documentation standard judges them: every comment line with the
 * line it stands on, every doc comment split into its sections, and the examples under `# Examples`.
 *
 * This is the lexical half of `torb docs source`. It finds text and structure and decides nothing: [historyHits]
 * names the words a comment must not contain, [sectionsOf] names the headings a doc comment is built from, and
 * [examplesOf] names the code below `# Examples`. The rules that turn all of that into findings live in `source.trb`.
 *
 * # Related
 *
 * - [DocumentationBlock] - one doc comment, line by line.
 * - [sectionHeadings] - the whole heading vocabulary.
 */

use Span, SourceText, LineIndex from "../syntax/source"
use Token, DocComment from "../syntax/token"
use linesOf from "./markdown"

/** One line of a comment, with the line of the file it stands on. */
public type CommentLine {
  line: Int
  /** Without the `//` and without the margin of a block comment. Never ends with a line break. */
  text: String
}

/**
 * Every comment of a file, line by line: `//` comments, block comments and doc comments alike.
 *
 * A comment can only stand between two tokens, so the gaps between the tokens are the only places that are looked at.
 * That is what keeps a `//` inside a string literal out of the result without a second lexer.
 */
public fn commentLines(source: SourceText, lines: LineIndex, tokens: List<Token>): List<CommentLine> {
  var found: List<CommentLine> = []
  var after = 0
  for token in tokens {
    const start = token.span.start
    collectComments found, source, lines, after, start
    after = after.max token.span.end
  }
  collectComments found, source, lines, after, source.text.byteLength()
  found
}

/** The comments between two tokens. Everything else in there is whitespace. */
fn collectComments(var found: List<CommentLine>, source: SourceText, lines: LineIndex, from: Int, to: Int) {
  if from >= to {
    return
  }
  // Byte by byte: `/`, `*` and the line break are ASCII, and no byte of another character is one of them
  const text = source.text
  var index = from
  while index < to {
    const isLineComment = text.byteAt(index) == 47 && text.byteAt(index + 1) == 47
    if isLineComment {
      var stop = index
      while stop < to && text.byteAt(stop) != 10 {
        stop = stop + 1
      }
      const line = lineAt lines, index
      found.append CommentLine(line, source.slice(index + 2, stop))
      index = stop
      continue
    }
    const isBlockComment = text.byteAt(index) == 47 && text.byteAt(index + 1) == 42
    if isBlockComment {
      var stop = index + 2
      while stop < to {
        if text.byteAt(stop) == 42 && text.byteAt(stop + 1) == 47 {
          stop = stop + 2
          break
        }
        stop = stop + 1
      }
      const line = lineAt lines, index
      const comment = source.slice index, stop
      var offset = 0
      for content in linesOf(comment) {
        found.append CommentLine(line + offset, content)
        offset = offset + 1
      }
      index = stop
      continue
    }
    index = index + 1
  }
}

fn lineAt(lines: LineIndex, offset: Int): Int {
  lines.lineAndColumn(offset).line
}

/** One doc comment of a file, with the line of every line of its content. */
public type DocumentationBlock {
  span: Span
  /** The line the `/**` stands on */
  line: Int
  /** The content, without the comment markers and without the margin of stars, one entry per line */
  lines: List<CommentLine>

  /** Everything the comment says, as Markdown. */
  fn text(): String {
    lines.map({ _.text }).toList().joined(separator: "\n")
  }
}

/**
 * Every doc comment of a file, in the order they stand in it.
 *
 * The lexer already answers which block comments are doc comments; this reads their text a second time, line by line,
 * because a finding about a heading or a link has to name the line it stands on.
 */
public fn documentationBlocks(source: SourceText, lines: LineIndex, docs: List<DocComment>): List<DocumentationBlock> {
  var blocks: List<DocumentationBlock> = []
  for doc in docs {
    const raw = source.text.sliceBytes doc.span.start, doc.span.end
    const inner = raw.dropping(characters: 3).droppingLast(characters: 2)
    const start = lineAt lines, doc.span.start
    var content: List<CommentLine> = []
    var offset = 0
    for line in linesOf(inner) {
      content.append CommentLine(start + offset, stripMargin(line))
      offset = offset + 1
    }
    blocks.append DocumentationBlock(doc.span, start, content)
  }
  blocks
}

/** The `*` that every line of a doc comment is written with, and the space behind it. */
fn stripMargin(line: String): String {
  const trimmed = line.trim()
  if !trimmed.startsWith("*") {
    return line.trim()
  }
  trimmed.withoutPrefix("* ") ?? trimmed.dropping(characters: 1)
}

/** Is there nothing but whitespace in front of this offset? Then a doc comment there is the module comment. */
public fn startsFile(source: SourceText, offset: Int): Bool {
  source.text.sliceBytes(0, offset).isBlank()
}

/**
 * The headings a doc comment may carry, and no others. Everything else a construct has to say belongs in the
 * sentences above them: what it does, and what it is for.
 */
public const sectionHeadings: List<String> = ["Examples", "Errors", "Panics", "Pitfalls", "Open", "Related"]

/** One `# Heading` of a doc comment and everything below it. */
public type DocumentationSection {
  /** Without the `#`, trimmed */
  heading: String
  /** How many `#` were written: only one is a heading of a doc comment */
  level: Int
  line: Int
  lines: List<CommentLine>

  fn isEmpty(): Bool {
    lines.all({ _.text.isBlank() })
  }
}

/** A doc comment as the standard describes it: sentences, then sections. */
public type Sections {
  /** Everything above the first heading */
  summary: List<CommentLine>
  sections: List<DocumentationSection>
}

/** Splits a doc comment at its headings. A heading starts at the beginning of a line, so indented code is never one. */
public fn sectionsOf(block: DocumentationBlock): Sections {
  var summary: List<CommentLine> = []
  var sections: List<DocumentationSection> = []
  var heading = ""
  var level = 0
  var line = 0
  var body: List<CommentLine> = []
  for content in block.lines {
    if !content.text.startsWith("#") {
      if level == 0 {
        summary.append content
      } else {
        body.append content
      }
      continue
    }
    if level > 0 {
      sections.append DocumentationSection(heading, level, line, body)
    }
    level = headingLevel content.text
    heading = content.text.dropping(characters: level).trim()
    line = content.line
    body = []
  }
  if level > 0 {
    sections.append DocumentationSection(heading, level, line, body)
  }
  Sections summary, sections
}

fn headingLevel(text: String): Int {
  var level = 0
  for character in text.chars() {
    if character != '#' {
      break
    }
    level = level + 1
  }
  level
}

/** The first sentence of a doc comment: what the construct does. */
public fn firstSentence(sections: Sections): String {
  var words = ""
  for content in sections.summary {
    if content.text.isBlank() {
      if !words.isEmpty() {
        break
      }
      continue
    }
    words = if words.isEmpty() { content.text } else { "{words} {content.text}" }
    if sentenceEnd(words).isSome() || words.endsWith(".") {
      break
    }
  }
  match sentenceEnd(words) {
    Some(stop) => words.sliceBytes 0, stop
    None => words.withoutSuffix(".") ?? words
  }
}

/**
 * The byte offset of the `.` that ends the first sentence, or `None` where the text is one sentence.
 *
 * What stands between backticks is code and not prose, so a period in it ends nothing: the summary of a construct is
 * one sentence even when it names `loop { ... }` or `0..list.length()`.
 */
fn sentenceEnd(text: String): Int? {
  var isQuoted = false
  var isAfterPeriod = false
  var offset = 0
  for character in text.chars() {
    if isAfterPeriod && character == ' ' {
      return offset - 1
    }
    isAfterPeriod = false
    if character == '`' {
      isQuoted = !isQuoted
    } else if !isQuoted && character == '.' {
      isAfterPeriod = true
    }
    offset = offset + character.byteLength()
  }
  None
}

/** How much of an example the tool can say something about. The spelling mirrors the markers of a documentation page. */
public type ExampleKind {
  /** The whole thing: it parses, it is in the canon, it type checks, and `torb doc --check` runs it */
  case Program
  /**
   * `// check`: it parses, it is in the canon and it type checks, and it is not run - an example that reads standard
   * input, starts a process, ends the program or panics on purpose shows how, and a doc test would only wait or stop
   * there; so does one the native back end cannot build yet
   */
  case Checked
  /** `// fragment`: a signature or a shape, so only the lexer can judge it */
  case Fragment
  /** `// skip <reason>`: nothing is checked, and the reason is counted in the report */
  case Skipped
}

/** One code block below `# Examples`. */
public type Example {
  /** The line the code starts on */
  line: Int
  kind: ExampleKind
  /** The code, without the four spaces that make it a code block. The marker line stays in it: it is a comment. */
  text: String
  /** The reason of a `// skip` */
  reason: String
}

/** The examples of one section, and the lines that tried to be a code block in another way. */
public type Examples {
  examples: List<Example>
  /** The lines of a ``` fence, which a doc comment does not use */
  fences: List<Int>
}

/**
 * The code blocks of a section: the lines that are indented by four spaces, as a doc comment writes an example.
 *
 * Prose between two blocks is allowed and separates them, so one `# Examples` can show one use case after another.
 */
public fn examplesOf(section: DocumentationSection): Examples {
  var examples: List<Example> = []
  var fences: List<Int> = []
  var block: List<CommentLine> = []
  for content in section.lines {
    if const Some(code) = content.text.withoutPrefix("    ") {
      block.append CommentLine(content.line, code)
      continue
    }
    if content.text.isBlank() {
      if !block.isEmpty() {
        block.append CommentLine(content.line, "")
      }
      continue
    }
    if content.text.trim().startsWith("```") {
      fences.append content.line
    }
    addExample block, examples
    block = []
  }
  addExample block, examples
  Examples examples, fences
}

fn addExample(block: List<CommentLine>, var examples: List<Example>) {
  var kept = block
  while !kept.isEmpty() && kept[kept.length() - 1].text.isBlank() {
    kept = kept[0..(kept.length() - 1)]
  }
  if kept.isEmpty() {
    return
  }
  const text = kept.map({ _.text }).toList().joined(separator: "\n")
  const marker = kept[0].text.trim()
  if marker == "// fragment" {
    examples.append Example(kept[0].line, ExampleKind.Fragment, text, "")
    return
  }
  if marker == "// check" {
    examples.append Example(kept[0].line, ExampleKind.Checked, text, "")
    return
  }
  if const Some(skipped) = marker.withoutPrefix("// skip") {
    const reason = skipped.trim()
    examples.append Example(kept[0].line, ExampleKind.Skipped, text, reason)
    return
  }
  examples.append Example(kept[0].line, ExampleKind.Program, text, "")
}

/** A link of a doc comment: `[Iterator]`, `[List.append]`, `[Option.Some]`. */
public type DocumentationLink {
  line: Int
  /** Everything between the brackets */
  target: String
}

/**
 * The links of a doc comment. A link is a name in brackets, so what stands inside a pair of backticks is not one -
 * `` `[1, 2]` `` is a list literal - and neither is the text of a Markdown link with a target of its own.
 */
public fn linksOf(block: DocumentationBlock): List<DocumentationLink> {
  var links: List<DocumentationLink> = []
  for content in block.lines {
    addLinks content, links
  }
  links
}

fn addLinks(content: CommentLine, var links: List<DocumentationLink>) {
  const characters = content.text.chars().toList()
  var index = 0
  var isCode = false
  while index < characters.length() {
    if characters[index] == '`' {
      isCode = !isCode
      index = index + 1
      continue
    }
    if isCode || characters[index] != '[' {
      index = index + 1
      continue
    }
    var stop = index + 1
    while stop < characters.length() && characters[stop] != ']' {
      stop = stop + 1
    }
    if stop >= characters.length() {
      return
    }
    const target = String.from characters[(index + 1)..stop]
    // `[text](page.md)`: a link that names its own target, not a name of the code
    const isInline = characters.get(stop + 1) == '('
    if !isInline && isName(target) {
      links.append DocumentationLink(content.line, target)
    }
    index = stop + 1
  }
}

/** `Iterator`, `List.append`: one name, or a name and one member. */
fn isName(target: String): Bool {
  const parts = target.split "."
  if parts.length() > 2 {
    return false
  }
  for part in parts {
    if part.isEmpty() || !isWord(part) {
      return false
    }
  }
  const first = target.chars().first() ?? ' '
  first.isLetter() || first == '_'
}

fn isWord(text: String): Bool {
  text.chars().all({ _.isLetter() || _.isDigit() || _ == '_' })
}

/**
 * The words that turn a comment into a history of itself. A comment says what the construct does now; what it did
 * before is in the log, and a reader who has to subtract the past from the present reads twice.
 *
 * This is the one place the words are written down. A phrase matches whole words, and its last word matches its plural
 * as well, so `milestone` also finds `milestones`: the inflected form is the same word and not a way around the rule.
 */
public const historyPhrases: List<String> = [
  "used to",
  "formerly",
  "previously",
  "originally",
  "at first",
  "no longer",
  "legacy",
  "was renamed",
  "milestone",
]

/** The one phrase of the list that needs a second question asked of it, in `isAboutTheCode`. */
const noLonger = "no longer"

/** Words that end in `s` and are no verb, so that `no longer as fast` is not read as a change of the code. */
const notVerbs: List<String> = ["as", "is", "was", "has", "its", "this", "thus", "less", "always", "perhaps"]

/** The words a plan number follows: `gap 58`, `round four`. The number itself is what makes it a hit. */
public const numberingWords: List<String> = ["gap", "round"]

const numberWords: List<String> = ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"]

/** A history word that was found, with the line it stands on. */
public type HistoryHit {
  line: Int
  /** The word or the two words, as the list spells them */
  word: String
}

/**
 * Every history word of every comment of a file. The whole list is asked of every line, so nothing depends on order.
 *
 * What stands between backticks is quoted and not prose, so a comment about the rule - this module's own, for one -
 * can name the words the rule forbids.
 */
public fn historyHits(comments: List<CommentLine>): List<HistoryHit> {
  var hits: List<HistoryHit> = []
  for comment in comments {
    const words = wordsOf withoutCode(comment.text)
    for phrase in historyPhrases {
      if tellsHistory(words, phrase) {
        hits.append HistoryHit(comment.line, phrase)
      }
    }
    for word in numberingWords {
      if isNumbered(words, word) {
        hits.append HistoryHit(comment.line, "{word} <number>")
      }
    }
  }
  hits
}

/** A line without what stands between backticks: the prose of it. */
fn withoutCode(text: String): String {
  var characters: List<Char> = []
  var isCode = false
  for character in text.chars() {
    if character == '`' {
      isCode = !isCode
      continue
    }
    if !isCode {
      characters.append character
    }
  }
  String.from characters
}

/**
 * The letters and the digits of a text, as lowercase words. Everything else separates, and a run of digits is a word
 * of its own, so a plan number is two words.
 */
public fn wordsOf(text: String): List<String> {
  var words: List<String> = []
  var current: List<Char> = []
  var isDigits = false
  for character in text.toLowerCase().chars() {
    const isWord = character.isLetter() || character.isDigit()
    if !isWord {
      addWord current, words
      current = []
      continue
    }
    if !current.isEmpty() && character.isDigit() != isDigits {
      addWord current, words
      current = []
    }
    isDigits = character.isDigit()
    current.append character
  }
  addWord current, words
  words
}

fn addWord(characters: List<Char>, var words: List<String>) {
  if !characters.isEmpty() {
    words.append String.from(characters)
  }
}

/** Does one phrase of the list stand in these words, as a history of the code and not as prose? */
fn tellsHistory(words: List<String>, phrase: String): Bool {
  const parts = phrase.split " "
  var start = 0
  while start + parts.length() <= words.length() {
    if matchesAt(words, parts, start) && isAboutTheCode(words, phrase, start + parts.length()) {
      return true
    }
    start = start + 1
  }
  false
}

fn matchesAt(words: List<String>, phrase: List<String>, start: Int): Bool {
  var offset = 0
  for word in phrase {
    const isLast = offset == phrase.length() - 1
    if !matchesWord(words[start + offset], word, isLast) {
      return false
    }
    offset = offset + 1
  }
  true
}

/** The word itself, and at the end of a phrase its plural too: `milestones` is `milestone`, said of several. */
fn matchesWord(word: String, expected: String, withPlural: Bool): Bool {
  if word == expected {
    return true
  }
  if !withPlural {
    return false
  }
  if const Some(stem) = expected.withoutSuffix("y") {
    return word == "{stem}ies"
  }
  word == "{expected}s" || word == "{expected}es"
}

/**
 * Whether the phrase that matched says something about the code. Every phrase of the list does on its own, except one.
 *
 * `no longer` is also ordinary prose: "a producer that is no longer needed" describes a value at run time and says
 * nothing about the history of the code. So it counts only in front of a verb in the third person singular -
 * `no longer takes a Range`, `no longer panics` - which is the shape a comment uses when it states a change of its own
 * code; `no longer needed`, `no longer valid` and `no longer be scheduled` are a state and are not flagged. A change
 * written in any other shape is missed on purpose: a gate that cries wolf is a gate that gets skipped.
 */
fn isAboutTheCode(words: List<String>, phrase: String, after: Int): Bool {
  if phrase != noLonger {
    return true
  }
  if after >= words.length() {
    return false
  }
  isThirdPerson words[after]
}

/** `takes`, `panics`, `returns`: the form a comment about the code uses. */
fn isThirdPerson(word: String): Bool {
  word.byteLength() > 3 && word.endsWith("s") && !notVerbs.contains(word)
}

/** `gap 58`, `round four`, `gaps 58`: the word or its plural, and a number behind it. */
fn isNumbered(words: List<String>, word: String): Bool {
  var index = 0
  while index + 1 < words.length() {
    if matchesWord(words[index], word, withPlural: true) && isNumber(words[index + 1]) {
      return true
    }
    index = index + 1
  }
  false
}

fn isNumber(word: String): Bool {
  if numberWords.contains(word) {
    return true
  }
  word.chars().all({ _.isDigit() })
}
