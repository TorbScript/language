/**
 * What the native back end says about the blocks of the documentation. The front end only answers whether a block is
 * TorbScript; this file answers whether it is a program the toolchain can build today, and - for a `trb run` block -
 * whether it prints what the page says it prints.
 *
 * Two questions, asked of the workspace [typeCheckSnippets] already checked, so the standard library is still read and
 * resolved once:
 *
 * - **Is it refused?** Every `trb run` block, and every `trb check` block of a `stable` page, is lowered on its own. A
 *   construct the back end does not lower yet, a `native type` the runtime does not represent, or anything the verifier
 *   says is a finding at the block. A `stable` page promises that what it shows works, and since `torb run` builds
 *   natively, a block the back end refuses is a block a reader cannot run. [refusalsOf] asks it.
 * - **What does it print?** Every `trb run` block that is not refused becomes one entry of **one** program - one C
 *   compile for all of them, not one per block - which is built with the C compiler and run. Before each entry the
 *   program writes a marker line, so its output is cut back into one piece per block, and each piece is compared with
 *   the block's `// prints` comments. [outputProblems] is that comparison, a pure function a test can call.
 *
 * # Related
 *
 * - [typeCheckSnippets] - the one run of the front end this file reads.
 */

use File, IoError from "std/fs"
use Environment from "std/os"
use Process from "std/process"
use joinPath from "../project/path"
use threadArguments from "../project/toolchain"
use hostTarget from "../project/target"
use runtimeSourcesOf, tlsArgumentsOf from "../cli/build"
use tlsSymbolPrefix from "../backend/c/natives"
use Checked from "../semantics/check"
use ModuleId from "../semantics/module"
use Lowering from "../ir/lower/context"
use lowerWorkspace, pathsOfModules from "../ir/lower/lower"
use entryNameOf from "../ir/lower/function"
use insertOwnership from "../ir/ownership"
use verifyOwnedProgram from "../ir/ownership-verify"
use emitProgram, ProgramEntry from "../backend/c/emit"
use emittedText from "../backend/c/emission"
use DocumentationProblem, linesOf from "./markdown"
use Snippet, SnippetKind, TypedSnippets, snippetPath, withoutTrailingSpaces from "./snippets"
use nativeNote from "./schema"

/** Where the native half of `docs check` finds the C runtime and puts what it builds. */
public type NativeOptions {
  /** The `runtime/` directory whose `include/torb.h` and `*.c` the program is compiled with */
  runtime: String
  /** Where `program.c` and the binary are written. It is created when it is missing */
  directory: String
}

/**
 * Is the native back end asked about this block? A `trb run` block always, because it is built; a `trb check` block
 * when its page says `stable`, because that page promises that what it shows works. A `draft` page may show a form the
 * back end does not build yet, and its banner says so.
 */
public fn isHeldToNative(snippet: Snippet): Bool {
  if snippet.kind == SnippetKind.Running {
    return true
  }
  snippet.kind == SnippetKind.Checked && snippet.status == "stable"
}

/**
 * Everything the native back end says about the blocks that [typeCheckSnippets] checked: the refusals, and for every
 * `trb run` block the difference between what it printed and what it says it prints. A block the type checker already
 * reported is not asked again.
 */
public fn nativeSnippetProblems(typed: TypedSnippets, options: NativeOptions): Result<List<DocumentationProblem>, IoError> {
  const checked = match typed.checked {
    Some(found) => found
    None => {
      return Ok([])
    }
  }
  const paths = pathsOfModules checked
  var problems: List<DocumentationProblem> = []
  var runnable: List<Snippet> = []
  var modules: List<ModuleId> = []
  // The pages that say the back end refuses them, by the first block that was asked, and the ones where it did
  var noted: Map<String, Int> = [:]
  var refusedPages: List<String> = []
  for snippet in typed.snippets {
    if !isHeldToNative(snippet) {
      continue
    }
    if typed.problems.any({ _.path == snippet.path && _.line == snippet.line }) {
      continue
    }
    const module = match moduleOf(checked, snippet) {
      Some(found) => found
      None => {
        continue
      }
    }
    const isChecked = snippet.kind == SnippetKind.Checked
    if isChecked && snippet.hasNativeNote && !noted.containsKey(snippet.path) {
      noted.set snippet.path, snippet.line
    }
    const refused = refusalsOf checked, paths, module, isChecked
    if !refused.isEmpty() {
      if isChecked && snippet.hasNativeNote {
        refusedPages.append snippet.path
        continue
      }
      problems.append DocumentationProblem(snippet.path, snippet.line, refusalNote(snippet, refused))
      continue
    }
    if snippet.kind == SnippetKind.Running {
      runnable.append snippet
      modules.append module
    }
  }
  // The note is held to the truth the other way as well, so that it goes away when the back end catches up
  for (path, line) in noted {
    if !refusedPages.contains(path) {
      const note = "Every block of this page builds natively: the line `{nativeNote}` is no longer true, remove it"
      problems.append DocumentationProblem(path, line, note)
    }
  }
  if !runnable.isEmpty() {
    problems.appendAll(runSnippets(checked, paths, runnable, modules, options)?)
  }
  Ok problems
}

fn refusalNote(snippet: Snippet, refused: List<String>): String {
  const said = refused.joined separator: " | "
  if snippet.kind == SnippetKind.Running {
    return "The native back end cannot build this `trb run` block: {said}"
  }
  const fixes = "Show a form that builds, or say so on the page in a paragraph that opens with `{nativeNote}`"
  "The native back end cannot build this block of a `stable` page: {said}. {fixes}"
}

fn moduleOf(checked: Checked, snippet: Snippet): ModuleId? {
  const path = snippetPath snippet
  for module in checked.program.graph.modules {
    if module.path == path {
      return Some module.id
    }
  }
  None
}

/**
 * What the native back end refuses about one block, lowered on its own so that a finding belongs to it: what the
 * lowering does not translate, what the verifier says, and what the C emitter cannot write. `seedsEverything` lowers
 * the block's declarations as well as its top-level code, which is what a `trb check` block that only declares a type
 * needs to be asked anything at all.
 */
public fn refusalsOf(checked: Checked, paths: List<String>, module: ModuleId, seedsEverything: Bool): List<String> {
  var lowering = lowerWorkspace checked.checker, paths, [module], seedsEverything, hostTarget()
  insertOwnership lowering.program
  var found: List<String> = []
  for problem in lowering.problems {
    found.append problem.diagnostic.message
  }
  for blocked in lowering.unsupported {
    found.append blocked.what
  }
  for what in lowering.program.planned {
    found.append what
  }
  for problem in lowering.program.problems {
    found.append "internal error: {problem}"
  }
  if !found.isEmpty() {
    return found
  }
  for problem in verifyOwnedProgram(lowering.program) {
    found.append "internal error: {problem}"
  }
  if !found.isEmpty() {
    return found
  }
  const name = entryNameOf lowering, module
  const entries = if hasFunction(lowering, name) { [ProgramEntry(name)] } else { [] }
  emitProgram(lowering.program, entries).unsupported
}

fn hasFunction(lowering: Lowering, name: String): Bool {
  lowering.program.functions.any({ _.name == name })
}

/** The line the program writes before the output of one block, which is where [outputProblems] cuts. */
public fn markerOf(snippet: Snippet): String {
  "=== torb docs check: {snippet.name}"
}

fn runSnippets(
  checked: Checked,
  paths: List<String>,
  runnable: List<Snippet>,
  modules: List<ModuleId>,
  options: NativeOptions,
): Result<List<DocumentationProblem>, IoError> {
  var lowering = lowerWorkspace checked.checker, paths, modules, false, hostTarget()
  insertOwnership lowering.program
  var entries: List<ProgramEntry> = []
  var index = 0
  for snippet in runnable {
    const name = entryNameOf lowering, modules[index]
    const called = if hasFunction(lowering, name) { name } else { "" }
    entries.append ProgramEntry(called, markerOf(snippet))
    index = index + 1
  }
  const emission = emitProgram lowering.program, entries
  if !emission.unsupported.isEmpty() {
    const said = emission.unsupported.joined separator: " | "
    const note = "Every `trb run` block builds on its own, and together they do not: {said}"
    return Ok([DocumentationProblem(runnable[0].path, runnable[0].line, note)])
  }
  File.createDirectory(options.directory)?
  const source = joinPath options.directory, "program.c"
  const text = emittedText emission
  File.writeText(source, text)?
  const binary = joinPath options.directory, "snippets"
  const failure = compileProgram(source, binary, options.runtime, text.contains(tlsSymbolPrefix))?
  if !failure.isEmpty() {
    return Ok([DocumentationProblem(runnable[0].path, runnable[0].line, failure)])
  }
  const executable = if File.exists(binary) { binary } else { "{binary}.exe" }
  const ran = Process.runBlocking(executable, [])?
  Ok outputProblems(runnable, ran.standardOutput, ran.exitCode)
}

/**
 * Compiles the program the way `torb build` does, without its optimization: a documentation check asks what the
 * program prints, and `-O0` is what makes one C compile of every block cost seconds rather than a minute. The answer is
 * empty on success, and otherwise what went wrong.
 */
fn compileProgram(source: String, binary: String, runtime: String, usesTls: Bool): Result<String, IoError> {
  const compiler = match cCompiler() {
    Some(found) => found
    None => {
      return Ok "No C compiler found for the `trb run` blocks (tried $TORB_CC, clang, gcc, cc). Pass --no-native to leave them out"
    }
  }
  if !File.exists(joinPath(runtime, "include/torb.h")) {
    return Ok "There is no C runtime at `{runtime}`. Set $TORB_RUNTIME, or pass --no-native to leave the `trb run` blocks out"
  }
  var arguments = ["-std=c11", "-O0", "-g0", "-I{joinPath(runtime, "include")}", "-o", binary, source]
  arguments.appendAll(runtimeSourcesOf(runtime)?)
  if usesTls {
    arguments.appendAll(tlsArgumentsOf(runtime, compiler, false, binary)?)
  }
  arguments.appendAll threadArguments()
  arguments.append "-lm"
  const output = Process.runBlocking(compiler, arguments)?
  if output.exitCode == 0 {
    return Ok ""
  }
  // A C compiler says what is wrong on standard error, and some say part of it on standard output
  const said = if output.standardError.trim().isEmpty() { output.standardOutput } else { output.standardError }
  const first = linesOf(said).take(5).toList().joined(separator: " | ")
  Ok "internal error: the C of the `trb run` blocks did not compile ({source}): {first}"
}

/** The C compiler, in `torb build`'s order: `$TORB_CC`, then `clang`, `gcc`, `cc`. */
fn cCompiler(): String? {
  if const Some(given) = Environment.get("TORB_CC") {
    if !given.isEmpty() {
      return Some given
    }
  }
  for candidate in ["clang", "gcc", "cc"] {
    if const Ok(output) = Process.runBlocking(candidate, ["--version"]) {
      if output.exitCode == 0 {
        return Some candidate
      }
    }
  }
  None
}

/**
 * The output of the one program every `trb run` block became, cut at the marker lines back into one piece per block,
 * and each piece compared with that block's `// prints` comments. A block whose entry ended the program - a panic, an
 * exit code other than 0 - is reported with what it printed, and every block after it did not run at all.
 */
public fn outputProblems(snippets: List<Snippet>, output: String, exitCode: Int): List<DocumentationProblem> {
  var pieces: Map<String, List<String>> = [:]
  var started: List<String> = []
  var current = ""
  // The line break that ends the output ends its last line, and starts no line of its own
  var lines = linesOf output
  if output.endsWith("\n") && !lines.isEmpty() && lines[lines.length() - 1].isEmpty() {
    lines.removeAt(lines.length() - 1)
  }
  for raw in lines {
    const line = withoutTrailingSpaces raw
    if const Some(snippet) = snippets.find({ markerOf(_) == line }) {
      current = snippet.name
      started.append current
      pieces.set current, []
      continue
    }
    if current.isEmpty() {
      continue
    }
    var piece = pieces.get(current) ?? []
    piece.append line
    pieces.set current, piece
  }
  // The summary a run of entries ends with belongs to no block: an empty line and `0 passed, 0 failed (N files)`
  if exitCode == 0 && !current.isEmpty() {
    var last = pieces.get(current) ?? []
    if !last.isEmpty() && last[last.length() - 1].contains(" passed, ") {
      last.removeAt(last.length() - 1)
      if !last.isEmpty() && last[last.length() - 1].isEmpty() {
        last.removeAt(last.length() - 1)
      }
    }
    pieces.set current, last
  }
  var problems: List<DocumentationProblem> = []
  for snippet in snippets {
    const piece = match pieces.get(snippet.name) {
      Some(found) => found
      None => {
        const note = "This `trb run` block did not run: a block before it ended the program with exit code {exitCode}"
        problems.append DocumentationProblem(snippet.path, snippet.line, note)
        continue
      }
    }
    const printed = shownLines piece
    if exitCode != 0 && snippet.name == current {
      const note = "This `trb run` block ended the program with exit code {exitCode}. It printed: {printed}"
      problems.append DocumentationProblem(snippet.path, snippet.line, note)
      continue
    }
    if piece != snippet.expectedOutput {
      const expected = shownLines snippet.expectedOutput
      const note = "This `trb run` block printed {printed}, and its `// prints` comments say {expected}"
      problems.append DocumentationProblem(snippet.path, snippet.line, note)
    }
  }
  problems
}

fn shownLines(lines: List<String>): String {
  if lines.isEmpty() {
    return "nothing"
  }
  const quoted = lines.map({ "`{_}`" }).toList()
  quoted.joined separator: " | "
}
