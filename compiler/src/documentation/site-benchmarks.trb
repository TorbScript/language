/**
 * The numbers of the site's benchmarks page (`site/benchmarks.md`): the report `benchmarks/game.sh` writes - the
 * forge measures it after every nightly and publishes it as `benchmarks.json` beside the nightly's archives - read,
 * and turned into the charts, the tables and the lines about the machine that fill the page's placeholders.
 *
 * A placeholder is an empty `div` that stands as an HTML block of its own in the page's Markdown:
 *
 *     <div data-benchmark="summary"></div>     the two headline numbers, or the notice that nothing is measured yet
 *     <div data-benchmark="n-body"></div>      the chart of one program
 *     <div data-benchmark="table"></div>       every time and every peak of memory
 *     <div data-benchmark="machine"></div>     the machine, the tools and the commit
 *
 * Without a report `summary` and `table` say that nothing is measured yet and every other placeholder is left out: a
 * site built without the file is still a whole site, which is what `torb docs site --check` builds in the gates.
 *
 * Every chart is inline SVG drawn here, with no library and no script: horizontal bars of the time relative to C on the
 * same input, TorbScript's binary in the brand's carmine and everything else in one neutral, each bar labelled with its
 * value and titled with its time. The colours are the site's stylesheet's (`site-style.trb`), so both themes follow.
 *
 * # Related
 *
 * - `benchmarks/game.sh` - what writes the report, and its format.
 * - [buildSite] of `site.trb` - where the placeholders are filled.
 */

use Json from "std/json"
use escapedHtml from "../reference/highlight"
use filled from "./site-strings"
use calloutIcon from "./site-html"

/** One language on one input: the times of its runs in seconds, and its peak memory in KiB (0 where not measured). */
public type BenchmarkResult {
  /** `c`, `torbscript`, `torbscript-vm`, `python` or `node` */
  language: String
  /** `ok`, or why there are no times: `missing`, `build-failed`, `failed`, `timeout`, `wrong-output` */
  status: String
  runs: Int
  median: Float
  minimum: Float
  maximum: Float
  memory: Int
  note: String
}

/** One input of a program, and what every language measured on it. */
public type BenchmarkWorkload {
  /** `large`, `small` or `startup` */
  size: String
  /** The program's one argument, empty for none */
  input: String
  results: List<BenchmarkResult>
}

public type BenchmarkProgram {
  /** `n-body`, or `startup` for the program that prints one line and ends */
  name: String
  workloads: List<BenchmarkWorkload>
}

public type BenchmarkMachine {
  system: String
  distribution: String
  processor: String
  cores: Int
  memoryKibibytes: Int
}

public type BenchmarkTools {
  torbscript: String
  c: String
  cFlags: String
  python: String
  node: String
  /** How the peak memory was measured, empty where it was not */
  memory: String
}

/** A `benchmarks.json`: schema 1. */
public type BenchmarkReport {
  schema: Int
  /** `ci` for the forge's runner, `local` for anything else */
  origin: String
  /** When, in UTC: `2026-09-30T02:41:07Z` */
  measured: String
  commit: String
  /** The nightly or the release the toolchain came from, empty for a checkout */
  release: String
  /** Whether the inputs were the tiny ones of `game.sh --quick` */
  quick: Bool
  runs: Int
  vmRuns: Int
  machine: BenchmarkMachine
  tools: BenchmarkTools
  programs: List<BenchmarkProgram>
}

/**
 * The report of a `benchmarks.json`, or why it cannot be read: malformed, or of a schema this toolchain cannot read.
 */
public fn benchmarkReportOf(text: String): Result<BenchmarkReport, String> {
  const report = Json().decode<BenchmarkReport>(text).mapError({ "{_}" })?
  if report.schema != 1 {
    return Fail "it has schema {report.schema}, and this toolchain reads schema 1"
  }
  report
}

/** The languages in the order of every table, each with the key of its name. */
const languageKeys: List<(language: String, key: String)> = [
  (language: "c", key: "benchmarks.language.c"),
  (language: "torbscript", key: "benchmarks.language.torbscript"),
  (language: "torbscript-vm", key: "benchmarks.language.torbscriptVm"),
  (language: "python", key: "benchmarks.language.python"),
  (language: "node", key: "benchmarks.language.node"),
]

/** The placeholder of a part of the page, as `site/benchmarks.md` writes it. */
public fn benchmarkPlaceholder(part: String): String {
  "<div data-benchmark=\"{part}\"></div>"
}

/**
 * The HTML of a page with every placeholder filled: from the report where there is one, and otherwise the summary and
 * the table saying that nothing is measured yet and every other placeholder left out. `word` gives the words of the
 * page's language; `forge` is the address of the repository, which the links to the sources start with.
 */
public fn withBenchmarks(html: String, report: BenchmarkReport?, word: (key: String) => String, forge: String): String {
  if !html.contains("<div data-benchmark=\"") {
    return html
  }
  const text = Words word
  var result = html
  match report {
    Some(measured) => {
      result = result.replace benchmarkPlaceholder("summary"), summaryHtml(measured, text)
      result = result.replace benchmarkPlaceholder("table"), tablesHtml(measured, text)
      result = result.replace benchmarkPlaceholder("machine"), machineHtml(measured, text)
      for program in measured.programs {
        result = result.replace benchmarkPlaceholder(program.name), chartHtml(measured, program, text, forge)
      }
    }
    None => {
      result = result.replace benchmarkPlaceholder("summary"), calloutHtml("info", text.of("benchmarks.missing"))
      result = result.replace(
        benchmarkPlaceholder("table"),
        "<p class=\"benchmark-none\">{escapedHtml(text.of("benchmarks.table.none"))}</p>",
      )
    }
  }
  // A placeholder the report has nothing for - a program it did not measure - is left out rather than shown empty
  const pieces = result.split "<div data-benchmark=\""
  var kept = [pieces[0]]
  for index in 1..pieces.length() {
    kept.append(pieces[index].substringAfter("\"></div>") ?? pieces[index])
  }
  kept.joined separator: ""
}

/** The words of the page's language, and its way of writing a number. */
type Words {
  word: (key: String) => String

  fn of(key: String): String {
    word(key)
  }

  fn filledWith(key: String, values: List<(name: String, value: String)>): String {
    filled word(key), values
  }

  /** `value` with `places` digits after the separator of the language, and a narrow space between thousands. */
  fn number(value: Float, places: Int): String {
    decimal value, places, word("benchmarks.decimal")
  }

  /** A ratio as the charts and the summary write it: two places below ten, one below a hundred, none above. */
  fn ratio(value: Float): String {
    const places = if value < 10.0 { 2 } else if value < 100.0 { 1 } else { 0 }
    "{number(value, places)}×"
  }

  /** A time in seconds, as milliseconds below a second. */
  fn time(seconds: Float): String {
    "{digitsOf(seconds, seconds)} {unitOf(seconds)}"
  }

  /** The fastest and the slowest run in the unit of the median, which is written once: `1.21-1.30 s`. */
  fn range(fastest: Float, slowest: Float, median: Float): String {
    "{digitsOf(fastest, median)}–{digitsOf(slowest, median)} {unitOf(median)}"
  }

  fn unitOf(seconds: Float): String {
    if seconds < 1.0 { "ms" } else { "s" }
  }

  /** The digits of `seconds` in the unit and with the places the time `scale` is written with. */
  fn digitsOf(seconds: Float, scale: Float): String {
    if scale < 0.01 {
      return number(seconds * 1000.0, 1)
    }
    if scale < 1.0 {
      return number(seconds * 1000.0, 0)
    }
    number seconds, 2
  }

  /** KiB as MiB. */
  fn memory(kibibytes: Int): String {
    const mebibytes = Float.from(kibibytes) / 1024.0
    "{number(mebibytes, if mebibytes < 10.0 { 1 } else { 0 })} MiB"
  }

  fn language(language: String): String {
    const key = languageKeys.find({ _.language == language })?.key ?? language
    word(key)
  }
}

/**
 * `value` rounded to `places` digits after `separator`, with a narrow no-break space between groups of three digits,
 * which reads the same in every language.
 */
fn decimal(value: Float, places: Int, separator: String): String {
  const scale = 10.0 ** Float.from(places)
  const scaled = Int.tryFrom((value.absolute() * scale).round()) ?? 0
  const sign = if value < 0.0 && scaled > 0 { "-" } else { "" }
  const unit = Int.tryFrom(scale) ?? 1
  const whole = grouped(scaled / unit)
  if places <= 0 {
    return "{sign}{whole}"
  }
  const fraction = "{scaled % unit}"
  "{sign}{whole}{separator}{"0".repeat(places - fraction.byteLength())}{fraction}"
}

/** The digits of `value` in groups of three, from the right. */
fn grouped(value: Int): String {
  const digits = "{value}"
  const length = digits.byteLength()
  if length <= 4 {
    return digits
  }
  var parts: List<String> = []
  var end = length
  while end > 0 {
    const start = if end > 3 { end - 3 } else { 0 }
    parts.insert 0, digits.sliceBytes(start, end)
    end = start
  }
  parts.joined separator: "\u{202F}"
}

fn calloutHtml(state: String, text: String): String {
  "<div class=\"callout callout-{state}\" role=\"note\">{calloutIcon(state)}<div class=\"callout-body\"><p>{escapedHtml(text)}</p></div></div>"
}

/** A language's result on the first input it was measured on, with the C of that input: what its bar compares. */
type Compared {
  result: BenchmarkResult
  c: BenchmarkResult
  input: String

  fn ratio(): Float {
    if c.median > 0.0 { result.median / c.median } else { 0.0 }
  }
}

fn comparedToC(program: BenchmarkProgram, language: String): Compared? {
  for workload in program.workloads {
    const own = workload.results.find { _.language == language && _.status == "ok" }
    const c = workload.results.find { _.language == "c" && _.status == "ok" }
    if const Some(found) = own {
      if const Some(reference) = c {
        return Compared found, reference, workload.input
      }
    }
  }
  None
}

/** The programs of the Benchmarks Game in a report: every one but `startup`. */
fn gamePrograms(report: BenchmarkReport): List<BenchmarkProgram> {
  report.programs.filter({ _.name != "startup" }).toList()
}

/** The geometric mean of some ratios, with the lowest and the highest; `None` for none. */
fn spread(ratios: List<Float>): (mean: Float, lowest: Float, highest: Float)? {
  if ratios.isEmpty() {
    return None
  }
  var logarithms = 0.0
  var lowest = ratios[0]
  var highest = ratios[0]
  for ratio in ratios {
    logarithms = logarithms + ratio.naturalLogarithm()
    if ratio < lowest {
      lowest = ratio
    }
    if ratio > highest {
      highest = ratio
    }
  }
  (mean: (logarithms / Float.from(ratios.length())).exponential(), lowest: lowest, highest: highest)
}

/**
 * The two numbers the page leads with - TorbScript's binary against C and the VM against Python, each the geometric
 * mean over the programs - and the notices about where the numbers come from.
 */
fn summaryHtml(report: BenchmarkReport, text: Words): String {
  var binaries: List<Float> = []
  var interpreted: List<Float> = []
  for program in gamePrograms(report) {
    if const Some(compared) = comparedToC(program, "torbscript") {
      binaries.append compared.ratio()
    }
    for workload in program.workloads {
      const vm = workload.results.find { _.language == "torbscript-vm" && _.status == "ok" }
      const python = workload.results.find { _.language == "python" && _.status == "ok" }
      if const Some(machine) = vm {
        if const Some(baseline) = python {
          if baseline.median > 0.0 {
            interpreted.append(machine.median / baseline.median)
          }
        }
      }
    }
  }
  var parts: List<String> = []
  if report.origin != "ci" {
    parts.append calloutHtml("warning", text.of("benchmarks.sample"))
  }
  if report.quick {
    parts.append calloutHtml("warning", text.of("benchmarks.quick"))
  }
  var tiles: List<String> = []
  if const Some(found) = spread(binaries) {
    const detail = text.filledWith("benchmarks.summary.native", [
      (name: "count", value: "{binaries.length()}"),
      (name: "lowest", value: text.ratio(found.lowest)),
      (name: "highest", value: text.ratio(found.highest)),
    ])
    tiles.append tileHtml(text.ratio(found.mean), text.of("benchmarks.summary.nativeLabel"), detail, highlighted: true)
  }
  if const Some(found) = spread(interpreted) {
    const detail = text.filledWith("benchmarks.summary.vm", [
      (name: "count", value: "{interpreted.length()}"),
      (name: "lowest", value: text.ratio(found.lowest)),
      (name: "highest", value: text.ratio(found.highest)),
    ])
    tiles.append tileHtml(text.ratio(found.mean), text.of("benchmarks.summary.vmLabel"), detail, highlighted: false)
  }
  if !tiles.isEmpty() {
    parts.append "<div class=\"benchmark-tiles\">{tiles.joined(separator: "")}</div>"
  }
  parts.joined separator: "\n"
}

fn tileHtml(value: String, label: String, detail: String, highlighted: Bool): String {
  const kind = if highlighted { " benchmark-tile-torbscript" } else { "" }
  const lines = [
    "<div class=\"benchmark-tile{kind}\">",
    "<p class=\"benchmark-tile-label\">{escapedHtml(label)}</p>",
    "<p class=\"benchmark-tile-value\">{escapedHtml(value)}</p>",
    "<p class=\"benchmark-tile-detail\">{escapedHtml(detail)}</p>",
    "</div>",
  ]
  lines.joined separator: ""
}

/** One bar of a chart. */
type Bar {
  language: String
  ratio: Float
  compared: Compared
}

/**
 * The chart of one program: two panels, TorbScript's binary against C and the VM against Python and Node.js, each bar
 * the time relative to C on the same input, with a caption that names the inputs and links the four sources.
 */
fn chartHtml(report: BenchmarkReport, program: BenchmarkProgram, text: Words, forge: String): String {
  var binaries: List<Bar> = []
  for language in ["c", "torbscript"] {
    if const Some(compared) = comparedToC(program, language) {
      binaries.append Bar(language, compared.ratio(), compared)
    }
  }
  var interpreted: List<Bar> = []
  for language in ["torbscript-vm", "python", "node"] {
    if const Some(compared) = comparedToC(program, language) {
      interpreted.append Bar(language, compared.ratio(), compared)
    }
  }
  if binaries.isEmpty() && interpreted.isEmpty() {
    return calloutHtml "warning", text.filledWith("benchmarks.chart.none", [(name: "program", value: program.name)])
  }
  var panels: List<String> = []
  if !binaries.isEmpty() {
    panels.append panelHtml(program.name, text.of("benchmarks.chart.native"), binaries, text)
  }
  if !interpreted.isEmpty() {
    panels.append panelHtml(program.name, text.of("benchmarks.chart.interpreted"), interpreted, text)
  }
  const large = program.workloads.find({ _.size == "large" })?.input ?? ""
  const small = program.workloads.find({ _.size == "small" })?.input ?? ""
  const inputs = text.filledWith("benchmarks.chart.inputs", [
    (name: "large", value: inputText(large, text)),
    (name: "small", value: inputText(small, text)),
  ])
  const lines = [
    "<figure class=\"benchmark-chart\">",
    "<div class=\"benchmark-panels\">{panels.joined(separator: "")}</div>",
    "<figcaption>{escapedHtml(inputs)} {sourcesHtml(report, program.name, text, forge)}</figcaption>",
    "</figure>",
  ]
  lines.joined separator: "\n"
}

fn inputText(input: String, text: Words): String {
  match Int.tryFrom(input) {
    Ok(number) => grouped number
    Fail(_) => input
  }
}

/** The links to the four versions of a program, at the commit that was measured. */
fn sourcesHtml(report: BenchmarkReport, name: String, text: Words, forge: String): String {
  const tree = if report.commit.isEmpty() { "branch/main" } else { "commit/{report.commit}" }
  const base = "{forge}/src/{tree}/benchmarks/game"
  const links = [
    (label: text.language("torbscript"), path: "{name}.trb"),
    (label: text.language("c"), path: "c/{name}.c"),
    (label: text.language("python"), path: "python/{name}.py"),
    (label: text.language("node"), path: "node/{name}.js"),
  ]
  var anchors: List<String> = []
  for link in links {
    anchors.append "<a href=\"{escapedHtml("{base}/{link.path}")}\">{escapedHtml(link.label)}</a>"
  }
  "{escapedHtml(text.of("benchmarks.chart.sources"))} {anchors.joined(separator: ", ")}"
}

/** The width of a panel's drawing, and where its bars start and may end, in the units of its `viewBox`. */
const panelWidth = 360.0
const barStart = 108.0
const valueRoom = 62.0
const rowHeight = 30.0
const barThickness = 18.0
const axisHeight = 24.0

/** One panel: its title, and its bars on one linear axis from zero, with a gridline at every tick. */
fn panelHtml(program: String, title: String, bars: List<Bar>, text: Words): String {
  var highest = 0.0
  for bar in bars {
    if bar.ratio > highest {
      highest = bar.ratio
    }
  }
  const axis = axisOf highest
  const barRoom = panelWidth - barStart - valueRoom
  const plotHeight = rowHeight * Float.from(bars.length())
  const height = plotHeight + axisHeight
  var shapes: List<String> = []
  var tick = 0.0
  while tick <= axis.maximum + axis.step / 2.0 {
    const x = barStart + tick / axis.maximum * barRoom
    shapes.append "<line class=\"benchmark-grid\" x1=\"{svg(x)}\" y1=\"0\" x2=\"{svg(x)}\" y2=\"{svg(plotHeight)}\"/>"
    const label = "{text.number(tick, axis.places)}×"
    shapes.append "<text class=\"benchmark-tick\" x=\"{svg(x)}\" y=\"{svg(plotHeight + 16.0)}\" text-anchor=\"middle\">{label}</text>"
    tick = tick + axis.step
  }
  var described: List<String> = []
  for index in 0..bars.length() {
    const bar = bars[index]
    const top = rowHeight * Float.from(index) + (rowHeight - barThickness) / 2.0
    const middle = top + barThickness / 2.0
    var end = barStart + bar.ratio / axis.maximum * barRoom
    if end < barStart + 2.0 {
      end = barStart + 2.0
    }
    const name = text.language bar.language
    const value = text.ratio bar.ratio
    const kind = if bar.language == "torbscript" { " benchmark-bar-torbscript" } else { "" }
    const result = bar.compared.result
    const detail = text.filledWith("benchmarks.chart.bar", [
      (name: "language", value: name),
      (name: "time", value: text.time(result.median)),
      (name: "ratio", value: value),
      (name: "runs", value: "{result.runs}"),
      (name: "fastest", value: text.time(result.minimum)),
      (name: "slowest", value: text.time(result.maximum)),
    ])
    const group = [
      "<g class=\"benchmark-row\">",
      "<title>{escapedHtml(detail)}</title>",
      "<rect class=\"benchmark-hit\" x=\"0\" y=\"{svg(rowHeight * Float.from(index))}\" width=\"{svg(panelWidth)}\" height=\"{svg(rowHeight)}\"/>",
      "<text class=\"benchmark-name\" x=\"{svg(barStart - 8.0)}\" y=\"{svg(middle + 4.5)}\" text-anchor=\"end\">{escapedHtml(name)}</text>",
      "<path class=\"benchmark-bar{kind}\" d=\"{barPath(barStart, end, top, barThickness)}\"/>",
      "<text class=\"benchmark-value\" x=\"{svg(end + 6.0)}\" y=\"{svg(middle + 4.5)}\">{escapedHtml(value)}</text>",
      "</g>",
    ]
    shapes.append group.joined(separator: "")
    described.append "{name} {value}"
  }
  shapes.append "<line class=\"benchmark-baseline\" x1=\"{svg(barStart)}\" y1=\"0\" x2=\"{svg(barStart)}\" y2=\"{svg(plotHeight)}\"/>"
  const label = "{program}, {title}: {described.joined(separator: ", ")}"
  const drawing = [
    "<svg class=\"benchmark-svg\" viewBox=\"0 0 {svg(panelWidth)} {svg(height)}\" role=\"img\" aria-label=\"{escapedHtml(label)}\">",
    shapes.joined(separator: ""),
    "</svg>",
  ]
  "<div class=\"benchmark-panel\"><p class=\"benchmark-panel-title\">{escapedHtml(title)}</p>{drawing.joined(separator: "")}</div>"
}

/** A number for an attribute of the drawing: one place, and always a point. */
fn svg(value: Float): String {
  decimal value, 1, "."
}

/** A bar from `start` to `end`: square where it starts, its end rounded by four units. */
fn barPath(start: Float, end: Float, top: Float, thickness: Float): String {
  const radius = if end - start < 8.0 { (end - start) / 2.0 } else { 4.0 }
  const bottom = top + thickness
  [
    "M{svg(start)} {svg(top)}",
    "H{svg(end - radius)}",
    "Q{svg(end)} {svg(top)} {svg(end)} {svg(top + radius)}",
    "V{svg(bottom - radius)}",
    "Q{svg(end)} {svg(bottom)} {svg(end - radius)} {svg(bottom)}",
    "H{svg(start)}Z",
  ].joined(separator: "")
}

/**
 * The axis of a panel: its end, a round number at or above the highest ratio, and the step between its ticks - one,
 * two, two and a half or five times a power of ten, so that it has three to five of them.
 */
fn axisOf(highest: Float): (maximum: Float, step: Float, places: Int) {
  const wanted = if highest > 0.0 { highest / 4.0 } else { 0.25 }
  const exponent = wanted.logarithm(10.0).floor()
  const power = 10.0 ** exponent
  var step = power * 10.0
  for factor in [1.0, 2.0, 2.5, 5.0, 10.0] {
    if power * factor >= wanted {
      step = power * factor
      break
    }
  }
  var maximum = step
  while maximum < highest {
    maximum = maximum + step
  }
  const places = if step >= 1.0 { 0 } else if step >= 0.1 && (step * 10.0).round() == step * 10.0 { 1 } else { 2 }
  (maximum: maximum, step: step, places: places)
}

/** The two tables: the time of every language on every input, and its peak of memory. */
fn tablesHtml(report: BenchmarkReport, text: Words): String {
  var header = "<tr><th>{escapedHtml(text.of("benchmarks.table.program"))}</th><th class=\"align-right\">{escapedHtml(text.of("benchmarks.table.input"))}</th>"
  for (language, _) in languageKeys {
    header = "{header}<th class=\"align-right\">{escapedHtml(text.language(language))}</th>"
  }
  header = "{header}</tr>"
  var times: List<String> = []
  var memory: List<String> = []
  for program in report.programs {
    const name = if program.name == "startup" { text.of "benchmarks.table.startup" } else { program.name }
    for workload in program.workloads {
      var timeRow = "<tr><th scope=\"row\">{escapedHtml(name)}</th><td class=\"align-right\">{escapedHtml(inputText(workload.input, text))}</td>"
      var memoryRow = timeRow
      for (language, _) in languageKeys {
        const found = workload.results.find { _.language == language }
        timeRow = "{timeRow}<td class=\"align-right\">{timeCell(found, text)}</td>"
        memoryRow = "{memoryRow}<td class=\"align-right\">{memoryCell(found, text)}</td>"
      }
      times.append "{timeRow}</tr>"
      memory.append "{memoryRow}</tr>"
    }
  }
  const timeCaption = text.filledWith("benchmarks.table.time", [
    (name: "runs", value: "{report.runs}"),
    (name: "vmRuns", value: "{report.vmRuns}"),
  ])
  var lines = [
    "<div class=\"table-wrap benchmark-table\"><table>",
    "<caption>{escapedHtml(timeCaption)}</caption>",
    "<thead>{header}</thead>",
    "<tbody>{times.joined(separator: "")}</tbody>",
    "</table></div>",
  ]
  if !report.tools.memory.isEmpty() {
    const memoryTable = [
      "<div class=\"table-wrap benchmark-table\"><table>",
      "<caption>{escapedHtml(text.of("benchmarks.table.memory"))}</caption>",
      "<thead>{header}</thead>",
      "<tbody>{memory.joined(separator: "")}</tbody>",
      "</table></div>",
    ]
    lines.appendAll memoryTable
  }
  lines.joined separator: "\n"
}

fn timeCell(found: BenchmarkResult?, text: Words): String {
  match found {
    Some(result) => {
      if result.status != "ok" {
        return statusHtml result, text
      }
      const range = text.range result.minimum, result.maximum, result.median
      "{escapedHtml(text.time(result.median))}<span class=\"benchmark-range\">{escapedHtml(range)}</span>"
    }
    None => "<span class=\"benchmark-none\">–</span>"
  }
}

fn memoryCell(found: BenchmarkResult?, text: Words): String {
  match found {
    Some(result) => {
      if result.status != "ok" {
        return statusHtml result, text
      }
      if result.memory <= 0 {
        return "<span class=\"benchmark-none\">–</span>"
      }
      escapedHtml text.memory(result.memory)
    }
    None => "<span class=\"benchmark-none\">–</span>"
  }
}

fn statusHtml(result: BenchmarkResult, text: Words): String {
  const word = text.of "benchmarks.status.{result.status}"
  const shown = if word.startsWith("benchmarks.status.") { result.status } else { word }
  "<span class=\"benchmark-status\" title=\"{escapedHtml(result.note)}\">{escapedHtml(shown)}</span>"
}

/** Where the numbers were measured: the machine, the tools, the commit and the date. */
fn machineHtml(report: BenchmarkReport, text: Words): String {
  const machine = report.machine
  const memory = decimal(Float.from(machine.memoryKibibytes) / 1048576.0, 1, text.of("benchmarks.decimal"))
  const system = if machine.distribution.isEmpty() {
    machine.system
  } else {
    "{machine.distribution}, {machine.system}"
  }
  const commit = if report.commit.isEmpty() { "-" } else { report.commit.prefix characters: 12 }
  // A report of a checkout names no nightly or release its toolchain came from
  const measuredKey = if report.release.isEmpty() {
    "benchmarks.machine.checkout"
  } else {
    "benchmarks.machine.measured"
  }
  const measured = text.filledWith(measuredKey, [
    (name: "date", value: report.measured.prefix(characters: 10)),
    (name: "commit", value: commit),
    (name: "release", value: report.release),
  ])
  const hardware = text.filledWith("benchmarks.machine.hardware", [
    (name: "processor", value: if machine.processor.isEmpty() { "-" } else { machine.processor }),
    (name: "cores", value: "{machine.cores}"),
    (name: "memory", value: memory),
    (name: "system", value: system),
  ])
  var tools = [
    "{text.language("torbscript")}: {report.tools.torbscript}",
    "{text.language("c")}: {report.tools.c}, {report.tools.cFlags}",
  ]
  if !report.tools.python.isEmpty() {
    tools.append "{text.language("python")}: {report.tools.python}"
  }
  if !report.tools.node.isEmpty() {
    tools.append "{text.language("node")}: {report.tools.node}"
  }
  var items = [measured, hardware, "{text.of("benchmarks.machine.tools")} {tools.joined(separator: "; ")}"]
  if !report.tools.memory.isEmpty() {
    items.append text.filledWith("benchmarks.machine.memory", [(name: "method", value: report.tools.memory)])
  }
  var lines = ["<ul class=\"benchmark-machine\">"]
  for item in items {
    lines.append "<li>{escapedHtml(item)}</li>"
  }
  lines.append "</ul>"
  lines.joined separator: "\n"
}
