/**
 * `torb docs skill`: the documentation as a set of Agent Skills, in the open format of
 * https://agentskills.io/specification - one directory per skill, whose `SKILL.md` has the front matter `name` and
 * `description`, a body that is loaded when the skill triggers, and further files that are read only when they are
 * needed.
 *
 * The set is declared by the templates below `skills/` of the documentation root. `skills/<name>/SKILL.md` is the frame
 * of one skill: its front matter as it is published, the few sentences only an agent needs, and directives on lines of
 * their own that the builder expands. Every other file of that directory - a script - is copied as it is.
 *
 * | Directive | What it becomes |
 * |-----------|-----------------|
 * | `<!-- carry: <path>... -->` | Nothing in the body: the pages it names go into `references/`. A path that ends in `/` is a folder and everything below it |
 * | `<!-- inline: <path> -->` | The body of that page, one heading level deeper, its links seen from `SKILL.md` |
 * | `<!-- pages -->` | One line per page of the skill, with its summary |
 * | `<!-- sections -->` | One line per folder index the skill carries, with its summary |
 * | `<!-- skills -->` | One line per other skill of the set, with the first sentence of its description |
 *
 * Every page belongs to at most one skill. The most specific `carry` rule decides - a page named on its own before its
 * folder, a deeper folder before a shallower one - and two skills naming the same page or folder is a problem. A page no
 * rule reaches is a problem too, unless it says `skill: omit` or belongs to the website or the course, so that a new
 * page cannot fall out of every skill unnoticed.
 *
 * The three levels of progressive disclosure are what the shape follows: the description is in every context and says
 * what a skill is for and when to use it, `SKILL.md` stays under [longestSkillBody] lines, and `references/` costs
 * nothing until a file is opened. A copied page keeps its place in the tree of the documentation below `references/`,
 * so a link between two pages of one skill still resolves; a link to a page of another skill becomes its text and the
 * name of that skill, and a link to anything no skill carries becomes its text. After that every link of every file has
 * to resolve inside its own skill: a dangling link is a problem of the build, never a file that is written anyway.
 *
 * [buildSkills] is the whole command, a pure function of the [Documentation]; [writeSkills] and [staleSkillFiles]
 * (`--check`, the gate) are the two places that touch disk.
 */

use File, IoError from "std/fs"
use normalizePath from "../project/path"
use DocumentationProblem, linesOf, readPage from "./markdown"
use Page, Folder, Documentation, skillsFolder, folderOf, joinDocumentationPath from "./tree"
use sortedByOrder, sortedChildren from "./index"

/** Anthropic's guidance and the format's: a body under 500 lines keeps the second level inside its budget. */
public const longestSkillBody = 500

/** The limits the format sets on the front matter. */
const longestName = 64
const longestDescription = 1024
const longestCompatibility = 500

/** The fields of the format's front matter. A template with any other field would not validate everywhere. */
const skillFields: List<String> = ["name", "description", "license", "compatibility", "metadata", "allowed-tools"]

/** What a file of the skills is below the output directory, always with `/`: `torbscript/SKILL.md` */
public type SkillFile {
  path: String
  text: String
}

/** What one skill of the set came to, for the line the command prints about it. */
public type BuiltSkill {
  name: String
  /** The lines of its `SKILL.md`, the number the size limit is about */
  bodyLines: Int
  /** How many pages went into its `references/` */
  pages: Int
}

/** Everything `torb docs skill` builds: every file of every skill, and the problems found while building them. */
public type BuiltSkills {
  files: List<SkillFile>
  problems: List<DocumentationProblem>
  skills: List<BuiltSkill>
  /** The pages no skill carries on purpose: `skill: omit`, the website's and the course's */
  excluded: Int
}

/** One skill as its template declares it. */
type SkillTemplate {
  /** The directory below `skills/`, which the format requires to be the `name` of the front matter */
  name: String
  description: String
  /** The front matter as it is published: every line from the first `---` to the second, both included */
  frontMatter: List<String>
  /** The lines of the body, directives included */
  body: List<String>
  /** The line of the template the body starts on, 1-based, for the problems */
  bodyLine: Int
  /** The `carry` rules, in the order they are written */
  carries: List<String>
  /** Every other file of the template's directory, by its path relative to that directory */
  files: List<SkillFile>
}

/** A line of a template that is a directive: `<!-- inline: guide/model.md -->` is `inline` with one argument. */
type Directive {
  name: String
  arguments: List<String>
}

/** Which skill carries each page, and how many pages none carries on purpose. */
type PageHomes {
  /** The name of the skill that carries a page, by the page's path */
  homes: Map<String, String>
  excluded: Int
}

/** What a link of one file of a skill is resolved against. */
type LinkContext {
  /** The skill the file belongs to */
  skill: String
  homes: Map<String, String>
  /** What a target of the same skill is written relative to: `references/` from `SKILL.md`, nothing from a page */
  prefix: String
}

/** What one link becomes in a file of a skill. */
type Rewritten {
  /** The link stays, with this target */
  case Kept(target: String)
  /** The page belongs to another skill: its text stays, followed by that skill and the path inside it */
  case Elsewhere(skill: String, path: String)
  /** No skill carries the target: only the text of the link stays */
  case Dropped
}

/** Builds every skill the templates declare. Writing them to disk is [writeSkills]. */
public fn buildSkills(documentation: Documentation): BuiltSkills {
  var problems: List<DocumentationProblem> = []
  const templates = templatesOf documentation, problems
  const placed = homesOf documentation, templates, problems
  var files: List<SkillFile> = []
  var skills: List<BuiltSkill> = []
  for template in templates {
    const pages = pagesOf documentation, placed.homes, template.name
    var own: List<SkillFile> = []
    const body = bodyOf documentation, template, templates, placed.homes, pages, problems
    own.append SkillFile("SKILL.md", body)
    if !pages.isEmpty() {
      own.append SkillFile("references/index.md", referenceIndex(documentation, template.name, pages))
    }
    const context = LinkContext template.name, placed.homes, ""
    for page in pages {
      own.append SkillFile("references/{page.path}", carriedText(page, context))
    }
    own.appendAll template.files
    problems.appendAll danglingLinks(template.name, own)
    const lines = linesOf(body).length()
    if lines > longestSkillBody {
      const note = "`SKILL.md` has {lines} lines. A skill body stays under {longestSkillBody}: carry material instead"
      problems.append DocumentationProblem(sourceOf(documentation, "{template.name}/SKILL.md"), 0, note)
    }
    for file in own {
      files.append SkillFile("{template.name}/{file.path}", file.text)
    }
    skills.append BuiltSkill(template.name, lines, pages.length())
  }
  BuiltSkills files, problems, skills, placed.excluded
}

/** How a file below `skills/` is named in a problem. */
fn sourceOf(documentation: Documentation, path: String): String {
  const root = documentation.root
  if root.isEmpty() || root == "." {
    return "{skillsFolder}/{path}"
  }
  "{root}/{skillsFolder}/{path}"
}

/** Every template below `skills/`, sorted by name. */
fn templatesOf(documentation: Documentation, var problems: List<DocumentationProblem>): List<SkillTemplate> {
  var paths = documentation.skillSources.keys().toList()
  paths.sort({ _ })
  var names: List<String> = []
  for path in paths {
    match path.splitOnce("/") {
      Some(parts) => {
        if !names.contains(parts.before) {
          names.append parts.before
        }
      }
      None => {
        const note = "A file below `{skillsFolder}/` belongs to the directory of one skill"
        problems.append DocumentationProblem(sourceOf(documentation, path), 0, note)
      }
    }
  }
  // By name, so that `torbscript` comes before `torbscript-language`, which the order of the paths would not give
  names.sort({ _ })
  var templates: List<SkillTemplate> = []
  for name in names {
    match documentation.skillSources.get("{name}/SKILL.md") {
      Some(text) => {
        if const Some(template) = templateOf(documentation, name, text, problems) {
          templates.append template
        }
      }
      None => {
        const note = "The directory of a skill has a `SKILL.md`, the template of the skill"
        problems.append DocumentationProblem(sourceOf(documentation, name), 0, note)
      }
    }
  }
  templates
}

/** One template, read and checked against the rules of the format. `None` when there is nothing to build from. */
fn templateOf(
  documentation: Documentation,
  name: String,
  text: String,
  var problems: List<DocumentationProblem>,
): SkillTemplate? {
  const shown = sourceOf documentation, "{name}/SKILL.md"
  const read = readPage shown, text
  problems.appendAll read.problems
  const frontMatter = match read.frontMatter {
    Some(found) => found
    None => {
      problems.append DocumentationProblem(shown, 1, "A template starts with the front matter of the skill")
      return None
    }
  }
  for field in frontMatter.fields {
    if !skillFields.contains(field.key) {
      const all = skillFields.joined separator: ", "
      problems.append DocumentationProblem(shown, field.line, "`{field.key}` is not a field of a skill. One of: {all}")
    }
  }
  const declared = frontMatter.text("name") ?? ""
  if declared != name {
    const note = "The `name` of a skill is the name of its directory, `{name}`"
    problems.append DocumentationProblem(shown, frontMatter.lineOf("name"), note)
  }
  if const Some(note) = nameProblem(name) {
    problems.append DocumentationProblem(shown, frontMatter.lineOf("name"), note)
  }
  const description = frontMatter.text("description") ?? ""
  if description.isEmpty() || description.byteLength() > longestDescription {
    const note = "A skill has a `description` of 1 to {longestDescription} characters: what it does and when to use it"
    problems.append DocumentationProblem(shown, frontMatter.lineOf("description"), note)
  }
  if description.contains("<") || description.contains(">") {
    const note = "A `description` has no angle brackets: some agents read them as a tag"
    problems.append DocumentationProblem(shown, frontMatter.lineOf("description"), note)
  }
  if (frontMatter.text("compatibility") ?? "").byteLength() > longestCompatibility {
    const note = "A `compatibility` is at most {longestCompatibility} characters"
    problems.append DocumentationProblem(shown, frontMatter.lineOf("compatibility"), note)
  }
  const lines = linesOf text
  const bodyStart = read.bodyLine - 1
  var published: List<String> = []
  var body: List<String> = []
  for index in 0..lines.length() {
    if index < bodyStart {
      published.append lines[index]
    } else {
      body.append lines[index]
    }
  }
  var carries: List<String> = []
  var openFence = 0
  var openIndent = 0
  var number = bodyStart
  for line in body {
    number = number + 1
    const fence = fenceAfter line, openFence, openIndent
    if fence != openFence {
      if openFence == 0 {
        openIndent = indentOf line
      }
      openFence = fence
      continue
    }
    if openFence > 0 {
      continue
    }
    if const Some(directive) = directiveOf(line) {
      if const Some(note) = directiveProblem(directive) {
        problems.append DocumentationProblem(shown, number, note)
      }
      if directive.name == "carry" {
        carries.appendAll directive.arguments
      }
    }
  }
  var files: List<SkillFile> = []
  for (path, content) in documentation.skillSources {
    if const Some(relative) = path.withoutPrefix("{name}/") {
      if relative != "SKILL.md" {
        files.append SkillFile(relative, content)
      }
    }
  }
  files.sort({ _.path })
  SkillTemplate name, description, published, body, read.bodyLine, carries, files
}

/** What is wrong with the name of a skill, by the rules of the format, or `None`. */
fn nameProblem(name: String): String? {
  const rule = "A skill's name is lowercase letters, digits and single hyphens, at most {longestName} characters"
  if name.isEmpty() || name.byteLength() > longestName {
    return rule
  }
  if name.startsWith("-") || name.endsWith("-") || name.contains("--") {
    return rule
  }
  for character in name.chars() {
    const isAllowed = (character >= 'a' && character <= 'z') || character.isDigit() || character == '-'
    if !isAllowed {
      return rule
    }
  }
  if name.contains("anthropic") || name.contains("claude") {
    return "A skill's name does not contain `anthropic` or `claude`, which are reserved"
  }
  None
}

/** The directive a line is, when it is one: a whole line `<!-- name: arguments -->`. */
fn directiveOf(line: String): Directive? {
  const trimmed = line.trim()
  const opened = trimmed.withoutPrefix("<!--")?
  const inner = (opened.withoutSuffix("-->")?).trim()
  const parts = inner.splitOnce ":"
  const name = (parts?.before ?? inner).trim()
  var arguments: List<String> = []
  if const Some(found) = parts {
    for word in found.after.split(" ") {
      if !word.trim().isEmpty() {
        arguments.append word.trim()
      }
    }
  }
  Directive name, arguments
}

/** What is wrong with a directive, or `None`. */
fn directiveProblem(directive: Directive): String? {
  match directive.name {
    "carry" => {
      if directive.arguments.isEmpty() {
        return "`carry` names at least one page or folder: `<!-- carry: guide/ tooling/torb-run.md -->`"
      }
      for argument in directive.arguments {
        if argument.startsWith("/") || argument.startsWith(".") || argument.contains("..") {
          return "`{argument}` is a path relative to the documentation root, without `.` or `..`"
        }
      }
      None
    }
    "inline" => {
      if directive.arguments.length() != 1 {
        return "`inline` names exactly one page: `<!-- inline: guide/model.md -->`"
      }
      None
    }
    "pages" | "sections" | "skills" => {
      if !directive.arguments.isEmpty() {
        return "`{directive.name}` takes nothing: `<!-- {directive.name} -->`"
      }
      None
    }
    _ => "`{directive.name}` is not a directive of a template. One of: carry, inline, pages, sections, skills"
  }
}

/** Which skill carries each page: the most specific rule of every template decides. */
fn homesOf(
  documentation: Documentation,
  templates: List<SkillTemplate>,
  var problems: List<DocumentationProblem>,
): PageHomes {
  var homes: Map<String, String> = [:]
  var excluded = 0
  for page in documentation.pages {
    // The root index is the map of the whole documentation, and every skill has a map of its own instead
    if page.path == "index.md" {
      continue
    }
    const shown = page.shown documentation.root
    const kind = page.frontMatter.text("kind") ?? ""
    const isForTheSite = kind == "site" || kind == "lesson"
    const isOmitted = (page.frontMatter.text("skill") ?? "") == "omit"
    var best = -1
    var winners: List<String> = []
    for template in templates {
      for rule in template.carries {
        const weight = weightOf rule, page.path, isForTheSite
        if weight < 0 {
          continue
        }
        if weight > best {
          best = weight
          winners = [template.name]
        } else if weight == best && !winners.contains(template.name) {
          winners.append template.name
        }
      }
    }
    if isOmitted {
      excluded = excluded + 1
      if best >= 1000 {
        problems.append DocumentationProblem(shown, 0, "The page says `skill: omit`, and `{winners[0]}` carries it")
      }
      continue
    }
    if winners.isEmpty() {
      if isForTheSite {
        excluded = excluded + 1
        continue
      }
      const note = "No skill carries the page. Name it in a `carry` line below `{skillsFolder}/`, or give it `skill: omit`"
      problems.append DocumentationProblem(shown, 0, note)
      continue
    }
    if winners.length() > 1 {
      const both = winners.joined separator: " and "
      problems.append DocumentationProblem(shown, 0, "{both} both carry the page. One skill carries it")
    }
    homes.set page.path, winners[0]
  }
  for template in templates {
    for rule in template.carries {
      const kind = if rule.endsWith("/") { "folder" } else { "page" }
      const reaches = documentation.pages.any({ page =>
        const isForTheSite = ["site", "lesson"].contains(page.frontMatter.text("kind") ?? "")
        weightOf(rule, page.path, isForTheSite) >= 0
      })
      if !reaches {
        const note = "`carry: {rule}` reaches no page: there is no such {kind} below the documentation root"
        problems.append DocumentationProblem(sourceOf(documentation, "{template.name}/SKILL.md"), 0, note)
      }
    }
  }
  PageHomes homes, excluded
}

/**
 * How specific a rule is about a page, or `-1` when it does not reach it: a page named on its own beats every folder,
 * and a folder beats the folders above it. A folder rule never reaches a page of the website or the course, which only
 * a rule naming the page itself carries.
 */
fn weightOf(rule: String, path: String, isForTheSite: Bool): Int {
  if !rule.endsWith("/") {
    return if rule == path { 1000 } else { -1 }
  }
  if isForTheSite || !path.startsWith(rule) {
    return -1
  }
  var depth = 0
  for character in rule.chars() {
    if character == '/' {
      depth = depth + 1
    }
  }
  depth
}

/**
 * Every folder in the order the indexes show them: a folder, then the folders below it, each level sorted by the
 * `order` of its index - the way a reader walks the tree.
 */
fn orderedFolders(documentation: Documentation): List<Folder> {
  var ordered: List<Folder> = []
  if const Some(root) = documentation.folderAt("") {
    appendFolderTree documentation, root, ordered
  }
  // A folder whose index is missing is reached through no index: it follows, in the order of its path
  for folder in documentation.folders {
    if !ordered.any({ _.path == folder.path }) {
      ordered.append folder
    }
  }
  ordered
}

fn appendFolderTree(documentation: Documentation, folder: Folder, var ordered: List<Folder>) {
  ordered.append folder
  for index in sortedChildren(documentation, folder) {
    if const Some(child) = documentation.folderAt(index.folder) {
      appendFolderTree documentation, child, ordered
    }
  }
}

/** The pages one skill carries, folder by folder in the order of the documentation, each folder's index first. */
fn pagesOf(documentation: Documentation, homes: Map<String, String>, skill: String): List<Page> {
  var pages: List<Page> = []
  for folder in orderedFolders(documentation) {
    if const Some(index) = folder.index {
      if (homes.get(index.path) ?? "") == skill {
        pages.append index
      }
    }
    for page in sortedByOrder(folder.pages) {
      if (homes.get(page.path) ?? "") == skill {
        pages.append page
      }
    }
  }
  pages
}

/** The text of one `SKILL.md`: the front matter as the template has it, and the body with every directive expanded. */
fn bodyOf(
  documentation: Documentation,
  template: SkillTemplate,
  templates: List<SkillTemplate>,
  homes: Map<String, String>,
  pages: List<Page>,
  var problems: List<DocumentationProblem>,
): String {
  const shown = sourceOf documentation, "{template.name}/SKILL.md"
  const context = LinkContext template.name, homes, "references/"
  var lines: List<String> = []
  var openFence = 0
  var openIndent = 0
  var number = template.bodyLine - 1
  for line in template.body {
    number = number + 1
    const fence = fenceAfter line, openFence, openIndent
    if fence != openFence {
      if openFence == 0 {
        openIndent = indentOf line
      }
      openFence = fence
      lines.append line
      continue
    }
    const directive: Directive? = if openFence > 0 { None } else { directiveOf line }
    match directive {
      Some(found) => {
        match found.name {
          "inline" => {
            const path = found.arguments.get(0) ?? ""
            match documentation.pageAt(path) {
              Some(page) => lines.appendAll inlined(page, context)
              None => problems.append DocumentationProblem(shown, number, "`inline: {path}` names no page")
            }
          }
          "pages" => lines.appendAll pageList(pages)
          "sections" => lines.appendAll sectionList(pages)
          "skills" => lines.appendAll skillList(templates, template.name)
          _ => {}
        }
      }
      None => lines.append line
    }
  }
  var text = template.frontMatter
  text.append ""
  text.appendAll withoutRepeatedBlankLines(trimmedBlankLines(lines))
  text.joined(separator: "\n") + "\n"
}

/** The body of a page, one heading level deeper and without its comments, its links seen from `SKILL.md`. */
fn inlined(page: Page, context: LinkContext): List<String> {
  var lines: List<String> = []
  var openFence = 0
  var openIndent = 0
  for line in linesOf(page.read.body) {
    const fence = fenceAfter line, openFence, openIndent
    if fence != openFence {
      if openFence == 0 {
        openIndent = indentOf line
      }
      openFence = fence
      lines.append line
      continue
    }
    if openFence > 0 {
      lines.append line
      continue
    }
    // A comment of a page is for its authors - the markers of a generated index, a note - and not for an agent
    if line.trim().startsWith("<!--") && line.trim().endsWith("-->") {
      continue
    }
    if line.startsWith("#") {
      lines.append "#{line}"
      continue
    }
    lines.append withRewrittenLinks(line, page.folder, context)
  }
  trimmedBlankLines lines
}

/** `<!-- pages -->`: every page of the skill with its summary. */
fn pageList(pages: List<Page>): List<String> {
  var lines: List<String> = []
  for page in pages {
    lines.append "- [{titleOf(page)}](references/{page.path}){statusOf(page)} - {summaryOf(page)}"
  }
  lines
}

/** `<!-- sections -->`: every folder index the skill carries, with its summary. */
fn sectionList(pages: List<Page>): List<String> {
  var lines: List<String> = []
  for page in pages {
    if page.indexesFolder {
      lines.append "- [{titleOf(page)}](references/{page.path}) - {summaryOf(page)}"
    }
  }
  lines
}

/** `<!-- skills -->`: every other skill of the set, with the first sentence of its description. */
fn skillList(templates: List<SkillTemplate>, own: String): List<String> {
  var lines: List<String> = []
  for template in templates {
    if template.name != own {
      lines.append "- `{template.name}` - {firstSentenceOf(template.description)}"
    }
  }
  lines
}

/** A description up to the end of its first sentence. */
fn firstSentenceOf(text: String): String {
  match text.splitOnce(". ") {
    Some(parts) => "{parts.before}."
    None => text
  }
}

fn titleOf(page: Page): String {
  page.frontMatter.text("title") ?? page.path
}

fn summaryOf(page: Page): String {
  page.frontMatter.text("summary") ?? ""
}

/** ` (planned)` or ` (draft)` behind the title of a page that is not stable, nothing behind one that is. */
fn statusOf(page: Page): String {
  const status = page.frontMatter.text("status") ?? "stable"
  if status == "stable" { "" } else { " ({status})" }
}

/**
 * A copied page, whose links to pages of the same skill stay as they are - the tree below `references/` is the tree of
 * the documentation, so a relative link still resolves - and whose other links are rewritten by [withRewrittenLinks].
 */
fn carriedText(page: Page, context: LinkContext): String {
  var lines: List<String> = []
  var openFence = 0
  var openIndent = 0
  for line in linesOf(page.text) {
    const fence = fenceAfter line, openFence, openIndent
    if fence != openFence {
      if openFence == 0 {
        openIndent = indentOf line
      }
      openFence = fence
      lines.append line
      continue
    }
    if openFence > 0 {
      lines.append line
      continue
    }
    lines.append withRewrittenLinks(line, page.folder, context)
  }
  var text = lines.joined separator: "\n"
  if page.text.endsWith("\n") {
    text = text + "\n"
  }
  text
}

/**
 * Every link of one line, seen from a file of a skill: a link to a page of the same skill is written relative to the
 * prefix of the context, a link to a page of another skill becomes its text and where that skill has it, and a link to
 * anything else keeps only its text. What stands between backticks is code and is left alone.
 */
fn withRewrittenLinks(line: String, folder: String, context: LinkContext): String {
  var rewritten = ""
  var rest = line
  var isInsideCode = false
  while !rest.isEmpty() {
    const opening = match rest.byteOffsetOf("](") {
      Some(found) => found
      None => {
        rewritten = rewritten + rest
        rest = ""
        continue
      }
    }
    const tail = rest.sliceBytes opening, rest.byteLength()
    const end = match tail.byteOffsetOf(")") {
      Some(found) => opening + found
      None => {
        rewritten = rewritten + rest
        rest = ""
        continue
      }
    }
    const head = rest.sliceBytes 0, opening
    const wasInsideCode = isInsideCode
    isInsideCode = hasOddBackticks head, isInsideCode
    const target = rest.sliceBytes(opening + 2, end)
    const labelStart = labelStartOf head
    if wasInsideCode || isInsideCode || labelStart.isNone() {
      rewritten = rewritten + head + "](" + target + ")"
    } else {
      const start = labelStart.expect "checked above"
      const before = head.sliceBytes 0, start
      const label = head.sliceBytes(start + 1, head.byteLength())
      match rewrittenTarget(target, folder, context) {
        .Kept(written) => {
          rewritten = rewritten + head + "](" + written + ")"
        }
        .Elsewhere(skill, path) => {
          rewritten = rewritten + before + label + " (skill `{skill}`: `references/{path}`)"
        }
        .Dropped => {
          rewritten = rewritten + before + label
        }
      }
    }
    rest = rest.sliceBytes(end + 1, rest.byteLength())
  }
  rewritten
}

/** Where the `[` of the link that ends at the end of `head` stands, if it stands in `head` at all. */
fn labelStartOf(head: String): Int? {
  // The last `[` that no `]` closes, found walking forward: a byte offset in the middle of a character is no offset
  var open: List<Int> = []
  var at = 0
  for character in head.chars() {
    if character == '[' {
      open.append at
    }
    if character == ']' && !open.isEmpty() {
      open.removeAt(open.length() - 1)
    }
    at = at + character.byteLength()
  }
  open.last()
}

fn hasOddBackticks(text: String, before: Bool): Bool {
  var isInside = before
  for character in text.chars() {
    if character == '`' {
      isInside = !isInside
    }
  }
  isInside
}

/** What one link target becomes in a file of the skill of the context. */
fn rewrittenTarget(target: String, folder: String, context: LinkContext): Rewritten {
  const isExternal = target.startsWith("http://") || target.startsWith("https://") || target.startsWith("mailto:")
  if isExternal || target.isEmpty() || target.startsWith("#") {
    return Rewritten.Kept target
  }
  const parts = target.splitOnce "#"
  const path = parts?.before ?? target
  const anchor = match parts {
    Some(found) => "#{found.after}"
    None => ""
  }
  const resolved = normalizePath joinDocumentationPath(folder, path)
  match context.homes.get(resolved) {
    Some(skill) => {
      if skill != context.skill {
        return Rewritten.Elsewhere skill, resolved
      }
      if context.prefix.isEmpty() {
        return Rewritten.Kept target
      }
      Rewritten.Kept "{context.prefix}{resolved}{anchor}"
    }
    None => Rewritten.Dropped
  }
}

/**
 * The length of the fence that is open after this line: `0` outside a block. A fence opens with three backticks or more
 * and closes only with a line of at least as many and nothing else, indented no deeper than the line that opened it - so
 * a block of four backticks can show one of three, and a block can show an indented one, the way the page reader reads
 * them.
 */
fn fenceAfter(line: String, open: Int, indent: Int): Int {
  const trimmed = line.trim()
  var count = 0
  for character in trimmed.chars() {
    if character != '`' {
      break
    }
    count = count + 1
  }
  if open == 0 {
    return if count >= 3 { count } else { 0 }
  }
  if count >= open && count == trimmed.byteLength() && indentOf(line) <= indent {
    return 0
  }
  open
}

fn indentOf(line: String): Int {
  var count = 0
  for character in line.chars() {
    if character != ' ' {
      break
    }
    count = count + 1
  }
  count
}

fn trimmedBlankLines(lines: List<String>): List<String> {
  var kept = lines
  while !kept.isEmpty() && kept[0].trim().isEmpty() {
    kept.removeAt 0
  }
  while !kept.isEmpty() && kept[kept.length() - 1].trim().isEmpty() {
    kept.removeAt(kept.length() - 1)
  }
  kept
}

/** The lines with every run of blank lines outside a fence cut to one: a directive that wrote nothing leaves none. */
fn withoutRepeatedBlankLines(lines: List<String>): List<String> {
  var kept: List<String> = []
  var openFence = 0
  var openIndent = 0
  var wasBlank = false
  for line in lines {
    const fence = fenceAfter line, openFence, openIndent
    if fence != openFence {
      if openFence == 0 {
        openIndent = indentOf line
      }
      openFence = fence
      kept.append line
      wasBlank = false
      continue
    }
    const isBlank = openFence == 0 && line.trim().isEmpty()
    if isBlank && wasBlank {
      continue
    }
    kept.append line
    wasBlank = isBlank
  }
  kept
}

/**
 * Every link of every Markdown file of one skill that does not resolve to another file of it. The rewriting above is
 * meant to leave none, and this is what makes that a promise: a link that leads nowhere is the one thing an agent cannot
 * recover from, so the build fails instead of writing it.
 */
fn danglingLinks(skill: String, files: List<SkillFile>): List<DocumentationProblem> {
  var paths: List<String> = []
  for file in files {
    paths.append file.path
  }
  var problems: List<DocumentationProblem> = []
  for file in files {
    if !file.path.endsWith(".md") {
      continue
    }
    const folder = folderOf file.path
    var openFence = 0
    var openIndent = 0
    var number = 0
    for line in linesOf(file.text) {
      number = number + 1
      const fence = fenceAfter line, openFence, openIndent
      if fence != openFence {
        if openFence == 0 {
          openIndent = indentOf line
        }
        openFence = fence
        continue
      }
      if openFence > 0 {
        continue
      }
      for target in linkTargetsOf(line) {
        const path = target.substringBefore("#") ?? target
        const isExternal = path.startsWith("http://") || path.startsWith("https://") || path.startsWith("mailto:")
        if path.isEmpty() || isExternal {
          continue
        }
        const resolved = normalizePath joinDocumentationPath(folder, path)
        if !paths.contains(resolved) {
          const note = "The link `{target}` leads to no file of the skill"
          problems.append DocumentationProblem("{skill}/{file.path}", number, note)
        }
      }
    }
  }
  problems
}

/** The targets of the links of one line, leaving out what stands between backticks. */
fn linkTargetsOf(line: String): List<String> {
  var targets: List<String> = []
  var rest = line
  var isInsideCode = false
  loop {
    const opening = match rest.byteOffsetOf("](") {
      Some(found) => found
      None => {
        break
      }
    }
    const head = rest.sliceBytes 0, opening
    isInsideCode = hasOddBackticks head, isInsideCode
    const tail = rest.sliceBytes(opening + 2, rest.byteLength())
    const end = match tail.byteOffsetOf(")") {
      Some(found) => found
      None => {
        break
      }
    }
    if !isInsideCode && labelStartOf(head).isSome() {
      targets.append tail.sliceBytes(0, end)
    }
    rest = tail.sliceBytes(end + 1, tail.byteLength())
  }
  targets
}

/**
 * One file with every page of a skill: its path, its title and its summary, grouped by folder. It is the level between
 * the body of the skill and a page - an index of summaries costs a fraction of the pages it describes, and a search over
 * it costs a fraction of the index.
 */
fn referenceIndex(documentation: Documentation, skill: String, pages: List<Page>): String {
  var lines: List<String> = ["# The pages of {skill}", ""]
  lines.append "Every page of this skill, with what it answers. Search this file for a word, then open the one page that"
  lines.append "answers the question. A page marked planned describes a feature that does not compile yet."
  lines.append ""
  lines.append "## Contents"
  lines.append ""
  const folders = orderedFolders documentation
  for folder in folders {
    if pages.any({ _.folder == folder.path }) {
      lines.append "- {shownFolder(folder.path)}"
    }
  }
  lines.append ""
  for folder in folders {
    const own = pages.filter({ _.folder == folder.path }).toList()
    if own.isEmpty() {
      continue
    }
    lines.append "## {shownFolder(folder.path)}"
    lines.append ""
    for page in own {
      const kind = page.frontMatter.text("kind") ?? ""
      const status = page.frontMatter.text("status") ?? "stable"
      const marked = if status == "stable" { kind } else { "{kind}, {status}" }
      lines.append "- `{page.path}` - **{titleOf(page)}** ({marked}): {summaryOf(page)}"
    }
    lines.append ""
  }
  lines.joined separator: "\n"
}

/** A folder as the reference index names it: the root has no path of its own. */
fn shownFolder(path: String): String {
  if path.isEmpty() { "the root" } else { path }
}

/**
 * Writes the skills, every directory before the file that goes into it, and removes every file below the directory of
 * one of them that no template writes any more - a page that moved to another skill, a script that was renamed. Nothing
 * outside those directories is touched. Returns the paths it removed.
 */
public fn writeSkills(out: String, skills: BuiltSkills): Result<List<String>, IoError> {
  for file in skills.files {
    const path = "{out}/{file.path}"
    const directory = folderOf path
    if !directory.isEmpty() {
      File.createDirectory(directory)?
    }
    File.writeText(path, file.text)?
  }
  var generated: List<String> = []
  for file in skills.files {
    generated.append file.path
  }
  var removed: List<String> = []
  for skill in skills.skills {
    for path in filesBelow(out, skill.name)? {
      if !generated.contains(path) {
        File.remove("{out}/{path}")?
        removed.append path
      }
    }
  }
  removed
}

/**
 * Every file under `out` that is not what [writeSkills] would write there, relative to `out` and sorted: one that is
 * missing, one whose text differs, and one that no template writes. Empty when the committed skills are current. A line
 * ending is not a difference, because git may check the files out with either one. A hidden entry directly below `out`
 * belongs to somebody else - the manifest of a plugin, say - and is left alone.
 */
public fn staleSkillFiles(out: String, skills: BuiltSkills): Result<List<String>, IoError> {
  var stale: List<String> = []
  var generated: List<String> = []
  for file in skills.files {
    generated.append file.path
    const path = "{out}/{file.path}"
    if !File.exists(path) {
      stale.append "{file.path} (missing)"
      continue
    }
    const text = File.readText(path)?
    if text.replace("\r\n", "\n") != file.text.replace("\r\n", "\n") {
      stale.append "{file.path} (differs)"
    }
  }
  if File.isDirectory(out) {
    for entry in File.list(out)? {
      if entry.startsWith(".") {
        continue
      }
      const paths = if File.isDirectory("{out}/{entry}") { filesBelow(out, entry)? } else { [entry] }
      for path in paths {
        if !generated.contains(path) {
          stale.append "{path} (no template writes it)"
        }
      }
    }
  }
  stale.sort({ _ })
  stale
}

/** Every file below `out/relative`, as a path relative to `out`. Nothing when there is no such directory. */
fn filesBelow(out: String, relative: String): Result<List<String>, IoError> {
  const directory = "{out}/{relative}"
  if !File.isDirectory(directory) {
    return Ok([])
  }
  var found: List<String> = []
  for entry in File.list(directory)? {
    const child = "{relative}/{entry}"
    if File.isDirectory("{out}/{child}") {
      found.appendAll(filesBelow(out, child)?)
    } else {
      found.append child
    }
  }
  found
}
