/**
 * `torb docs skill`: the documentation as an Agent Skill, in the format Anthropic published
 * (https://agentskills.io/specification): a folder whose `SKILL.md` has the front matter `name` and `description`, a
 * body that is loaded when the skill triggers, and further files that are read only when they are needed.
 *
 * The three levels of progressive disclosure are what the shape follows:
 *
 * 1. `name` and `description` are always in the model's context (about 100 tokens). They decide whether the skill is
 *    used at all, so the description says what the skill is **and when to use it**, in the third person.
 * 2. `SKILL.md` is read when the skill triggers and stays under `longestSkillBody` lines: the mental model of the
 *    language, how to verify work, and how to find the rest. It is the only file the skill asks to be read up front.
 * 3. `reference/` holds the pages, and costs nothing until a file is opened. The body points at the section indexes and
 *    at a search, never at "read this long file first", because every file read up front is paid for on every task.
 *
 * Nothing in the body is written here: every section is the body of a page that carries the matching `skill` role in
 * its front matter, so the skill cannot drift away from the documentation. What this file decides is the *shape*.
 *
 * A link of a copied page that points at something the skill does not carry - a page about the documentation itself,
 * a design record, a file of the repository outside `docs/` - becomes its plain text, and after that every link of
 * every file the skill holds has to resolve inside the skill: a dangling link is a problem of the build, never a file
 * that is written anyway.
 *
 * [buildSkill] is the whole command, a pure function of the [Documentation] to a [BuiltSkill]; [writeSkill] and
 * [staleSkillFiles] (`--check`, the gate) are the two places that touch disk.
 */

use File, IoError from "std/fs"
use normalizePath from "../project/path"
use DocumentationProblem, linesOf from "./markdown"
use Page, Documentation, folderOf, fileName, joinDocumentationPath from "./tree"

/**
 * The name of the skill. It is also the name of its directory, which the format requires, and it may only contain
 * lowercase letters, digits and single hyphens.
 */
public const skillName = "torbscript"

/**
 * What the model matches a request against. It says what the skill is and when to use it, in the third person, and it
 * names the words that should trigger it - a description that does not name them is a skill nobody reaches. The format
 * allows 1024 characters; this one stays far below that on purpose, because it is in the context of every request.
 */
public const skillDescription = "Writes, reads and reviews TorbScript, a functional-first language with value semantics whose CLI is `torb` and whose files end in `.trb`. Use it for any task that touches TorbScript source, a `project.trb`, the `torb` toolchain, or the TorbScript standard library - and use it before writing TorbScript from memory, because the language looks like Rust, Swift and Kotlin but differs from all three in mutation, error handling, cases and call syntax."

/** Anthropic's guidance: under 500 lines keeps the body inside the token budget of level two. */
public const longestSkillBody = 500

/** One file of the generated skill. Writing happens in `writeSkill`, so building it is a pure function. */
public type SkillFile {
  /** Relative to the skill directory, always with `/` */
  path: String
  text: String
}

/** Everything `torb docs skill` builds: every file of the skill, and the problems found while building it. */
public type BuiltSkill {
  files: List<SkillFile>
  problems: List<DocumentationProblem>
  /** The lines of `SKILL.md`, the number the size limit is about */
  bodyLines: Int
  /** How many pages went into `reference/`, and how many were left out because they say `skill: omit` */
  included: Int
  excluded: Int
}

/** Builds the whole skill from the documentation tree. Writing it to disk is [writeSkill]. */
public fn buildSkill(documentation: Documentation): BuiltSkill {
  var problems: List<DocumentationProblem> = []
  const pages = includedPages documentation
  const excluded = documentation.pages.length() - pages.length()
  var carried: List<String> = ["index.md"]
  for page in pages {
    carried.add page.path
  }
  var files: List<SkillFile> = []
  const body = skillBody documentation, pages, carried
  problems.addAll body.problems
  files.add SkillFile("SKILL.md", body.text)
  files.add SkillFile("reference/index.md", referenceIndex(documentation, pages))
  for page in pages {
    // `reference/index.md` is the generated map of every page, which is worth more here than the root index
    if page.path == "index.md" {
      continue
    }
    files.add SkillFile("reference/{page.path}", carriedText(page, carried))
  }
  problems.addAll danglingLinks(files)
  const lines = linesOf(body.text).length()
  if lines > longestSkillBody {
    const note = "`SKILL.md` has {lines} lines. A skill body stays under {longestSkillBody}: move material into a page"
    problems.add DocumentationProblem("SKILL.md", 0, note)
  }
  BuiltSkill files, problems, lines, pages.length(), excluded
}

/**
 * Everything the skill carries: every page except the ones whose author said `skill: omit`. A `planned` page is
 * carried with its banner, like a `draft` one: the pages of the features that exist link it for the rules of a
 * construct they use (`spawn`, `.await()`), and a model reads the banner in the same file as the design.
 */
fn includedPages(documentation: Documentation): List<Page> {
  var kept: List<Page> = []
  for page in documentation.pages {
    const role = page.frontMatter.text("skill") ?? ""
    if role == "omit" {
      continue
    }
    kept.add page
  }
  kept
}

type WrittenBody {
  text: String
  problems: List<DocumentationProblem>
}

fn skillBody(documentation: Documentation, pages: List<Page>, carried: List<String>): WrittenBody {
  var problems: List<DocumentationProblem> = []
  var lines: List<String> = ["---", "name: {skillName}"]
  lines.add "description: \"{skillDescription}\""
  lines.add "---"
  lines.add ""
  lines.add "# TorbScript"
  lines.add ""
  lines.add "Paths below are relative to the directory of this file. Nothing but this file needs to be read up front:"
  lines.add "every other file is opened when a question needs it."
  lines.add ""
  // Two sections are needed on every task and are short, so they stand in the body. The two that are long lookup
  // material are one `Read` away instead, which is what keeps the body inside the published budget of 500 lines -
  // and they are named as lookup material, not as reading, because a file read up front is paid on every task
  const referenced = [
    ("cheat-sheet", "every form of the language with its exact spelling: how is this written?"),
    ("mistakes", "the lines that look right and are not, each with its diagnostic: why does this not compile?"),
  ]
  match pageWithRole(documentation, "model") {
    Some(page) => {
      lines.addAll inlinedSection("The language in sixty seconds", page, carried)
    }
    None => {
      problems.add DocumentationProblem("SKILL.md", 0, "No page carries `skill: model`")
    }
  }
  lines.add "## Two files to look things up in"
  lines.add ""
  for (role, why) in referenced {
    match pageWithRole(documentation, role) {
      Some(page) => {
        lines.add "- `reference/{page.path}` - {why}"
      }
      None => {
        problems.add DocumentationProblem("SKILL.md", 0, "No page carries `skill: {role}`")
      }
    }
  }
  lines.add ""
  lines.add "Search them instead of reading them whole: `grep -n \"^###\" <file>` lists the sections of either one, and a"
  lines.add "section is a few dozen lines. Before handing over code, scan the section headings of the second one."
  lines.add ""
  match pageWithRole(documentation, "verify") {
    Some(page) => {
      lines.addAll inlinedSection("How to verify your work", page, carried)
    }
    None => {
      problems.add DocumentationProblem("SKILL.md", 0, "No page carries `skill: verify`")
    }
  }
  lines.addAll navigation(documentation, pages)
  WrittenBody lines.joined(separator: "\n"), problems
}

/** One section of the body: the heading, the page's body one level deeper, and where it came from. */
fn inlinedSection(heading: String, page: Page, carried: List<String>): List<String> {
  var lines = ["## {heading}", ""]
  lines.addAll demoted(page, carried)
  lines.add ""
  lines.add "Source: `reference/{page.path}`"
  lines.add ""
  lines
}

fn pageWithRole(documentation: Documentation, role: String): Page? {
  documentation.pages.find({ (_.frontMatter.text("skill") ?? "") == role })
}

/**
 * The body of a page, one heading level deeper, so that its sections sit below the section of the skill they fill. The
 * body is copied verbatim otherwise: a condensed copy would be a second version of the same text, and two versions of
 * one rule is how a documentation starts to contradict itself. Its links are seen from `SKILL.md` instead of from the
 * page, so a link that was relative to the page's folder becomes relative to the skill's root.
 */
fn demoted(page: Page, carried: List<String>): List<String> {
  var lines: List<String> = []
  var openFence = 0
  var openIndent = 0
  for line in linesOf(page.read.body) {
    const fence = fenceAfter line, openFence, openIndent
    if fence != openFence {
      if openFence == 0 {
        openIndent = indentOf line
      }
      openFence = fence
      lines.add line
      continue
    }
    if openFence > 0 {
      lines.add line
      continue
    }
    if line.startsWith("#") {
      lines.add "#{line}"
      continue
    }
    lines.add withRewrittenLinks(line, page.folder, carried, "reference/")
  }
  trimmedBlankLines lines
}

/**
 * A copied page, whose links to what the skill carries stay as they are - the tree below `reference/` is the tree of
 * the documentation, so a relative link still resolves - and whose links to anything else become their plain text.
 */
fn carriedText(page: Page, carried: List<String>): String {
  var lines: List<String> = []
  var openFence = 0
  var openIndent = 0
  for line in linesOf(page.text) {
    const fence = fenceAfter line, openFence, openIndent
    if fence != openFence {
      if openFence == 0 {
        openIndent = indentOf line
      }
      openFence = fence
      lines.add line
      continue
    }
    if openFence > 0 {
      lines.add line
      continue
    }
    lines.add withRewrittenLinks(line, page.folder, carried, "")
  }
  var text = lines.joined separator: "\n"
  if page.text.endsWith("\n") {
    text = text + "\n"
  }
  text
}

/**
 * Every link of one line, seen from a file of the skill: a link to a page the skill carries is written relative to
 * `prefix` (`reference/` from `SKILL.md`, nothing from a copied page, whose folder is the page's own), and a link to
 * anything else keeps only its text. What stands between backticks is code and is left alone.
 */
fn withRewrittenLinks(line: String, folder: String, carried: List<String>, prefix: String): String {
  var rewritten = ""
  var rest = line
  var isInsideCode = false
  while !rest.isEmpty() {
    const opening = match rest.indexOf("](") {
      Some(found) => found
      None => {
        rewritten = rewritten + rest
        rest = ""
        continue
      }
    }
    const tail = rest.slice(opening..rest.byteLength())
    const end = match tail.indexOf(")") {
      Some(found) => opening + found
      None => {
        rewritten = rewritten + rest
        rest = ""
        continue
      }
    }
    const head = rest.slice(0..opening)
    const wasInsideCode = isInsideCode
    isInsideCode = hasOddBackticks head, isInsideCode
    const target = rest.slice((opening + 2)..end)
    const labelStart = labelStartOf head
    const kept = keptTarget target, folder, carried, prefix
    if wasInsideCode || isInsideCode || labelStart.isNone() {
      rewritten = rewritten + head + "](" + target + ")"
    } else {
      match kept {
        Some(written) => {
          rewritten = rewritten + head + "](" + written + ")"
        }
        None => {
          // A target the skill does not carry: the text of the link stays, the brackets and the target go
          const start = labelStart.expect "checked above"
          rewritten = rewritten + head.slice(0..start) + head.slice((start + 1)..head.byteLength())
        }
      }
    }
    rest = rest.slice((end + 1)..rest.byteLength())
  }
  rewritten
}

/** Where the `[` of the link that ends at the end of `head` stands, if it stands in `head` at all. */
fn labelStartOf(head: String): Int? {
  // The last `[` that no `]` closes, found walking forward: a byte offset in the middle of a character is no offset
  var open: List<Int> = []
  var at = 0
  for character in head.chars() {
    if character == '[' {
      open.add at
    }
    if character == ']' && !open.isEmpty() {
      open.removeAt(open.length() - 1)
    }
    at = at + character.byteLength()
  }
  open.last()
}

fn hasOddBackticks(text: String, before: Bool): Bool {
  var isInside = before
  for character in text.chars() {
    if character == '`' {
      isInside = !isInside
    }
  }
  isInside
}

/**
 * The target a link keeps in a file of the skill, or `None` when it points at something the skill does not carry. An
 * external link and an anchor of the same page are kept as they are.
 */
fn keptTarget(target: String, folder: String, carried: List<String>, prefix: String): String? {
  const isExternal = target.startsWith("http://") || target.startsWith("https://") || target.startsWith("mailto:")
  if isExternal || target.isEmpty() || target.startsWith("#") {
    return Some target
  }
  const hash = target.indexOf "#"
  const path = match hash {
    Some(at) => target.slice(0..at)
    None => target
  }
  const anchor = match hash {
    Some(at) => target.slice(at..target.byteLength())
    None => ""
  }
  const resolved = normalizePath joinDocumentationPath(folder, path)
  if !carried.contains(resolved) {
    return None
  }
  if prefix.isEmpty() {
    return Some target
  }
  Some "{prefix}{resolved}{anchor}"
}

/**
 * The length of the fence that is open after this line: `0` outside a block. A fence opens with three backticks or more
 * and closes only with a line of at least as many and nothing else, indented no deeper than the line that opened it - so
 * a block of four backticks can show one of three, and a block can show an indented one, the way the page reader reads
 * them.
 */
fn fenceAfter(line: String, open: Int, indent: Int): Int {
  const trimmed = line.trim()
  var count = 0
  for character in trimmed.chars() {
    if character != '`' {
      break
    }
    count = count + 1
  }
  if open == 0 {
    return if count >= 3 { count } else { 0 }
  }
  if count >= open && count == trimmed.byteLength() && indentOf(line) <= indent {
    return 0
  }
  open
}

fn indentOf(line: String): Int {
  var count = 0
  for character in line.chars() {
    if character != ' ' {
      break
    }
    count = count + 1
  }
  count
}

fn trimmedBlankLines(lines: List<String>): List<String> {
  var kept = lines
  while !kept.isEmpty() && kept[0].trim().isEmpty() {
    kept.removeAt 0
  }
  while !kept.isEmpty() && kept[kept.length() - 1].trim().isEmpty() {
    kept.removeAt(kept.length() - 1)
  }
  kept
}

/**
 * Every link of every file of the skill that does not resolve to another file of it. The rewriting above is meant to
 * leave none, and this is what makes that a promise: a link that leads nowhere is the one thing an agent cannot recover
 * from, so the build fails instead of writing it.
 */
fn danglingLinks(files: List<SkillFile>): List<DocumentationProblem> {
  var paths: List<String> = []
  for file in files {
    paths.add file.path
  }
  var problems: List<DocumentationProblem> = []
  for file in files {
    const folder = folderOf file.path
    var openFence = 0
    var openIndent = 0
    var number = 0
    for line in linesOf(file.text) {
      number = number + 1
      const fence = fenceAfter line, openFence, openIndent
      if fence != openFence {
        if openFence == 0 {
          openIndent = indentOf line
        }
        openFence = fence
        continue
      }
      if openFence > 0 {
        continue
      }
      for target in linkTargetsOf(line) {
        const hash = target.indexOf "#"
        const path = match hash {
          Some(at) => target.slice(0..at)
          None => target
        }
        const isExternal = path.startsWith("http://") || path.startsWith("https://") || path.startsWith("mailto:")
        if path.isEmpty() || isExternal {
          continue
        }
        const resolved = normalizePath joinDocumentationPath(folder, path)
        if !paths.contains(resolved) {
          const note = "The link `{target}` leads to no file of the skill"
          problems.add DocumentationProblem("{skillName}/{file.path}", number, note)
        }
      }
    }
  }
  problems
}

/** The targets of the links of one line, leaving out what stands between backticks. */
fn linkTargetsOf(line: String): List<String> {
  var targets: List<String> = []
  var rest = line
  var isInsideCode = false
  loop {
    const opening = match rest.indexOf("](") {
      Some(found) => found
      None => {
        break
      }
    }
    const head = rest.slice(0..opening)
    isInsideCode = hasOddBackticks head, isInsideCode
    const tail = rest.slice((opening + 2)..rest.byteLength())
    const end = match tail.indexOf(")") {
      Some(found) => found
      None => {
        break
      }
    }
    if !isInsideCode && labelStartOf(head).isSome() {
      targets.add tail.slice(0..end)
    }
    rest = tail.slice((end + 1)..tail.byteLength())
  }
  targets
}

/** How to find the rest: the section indexes, a search, and the one map of every page. */
fn navigation(documentation: Documentation, pages: List<Page>): List<String> {
  var lines: List<String> = ["## Where to look things up", ""]
  lines.add "Every section has an index that lists its pages with one sentence each. Open the index of the section a"
  lines.add "question belongs to, then the one page that answers it:"
  lines.add ""
  lines.add "| Section | What is in it |"
  lines.add "|---------|---------------|"
  for folder in documentation.folders {
    if folder.path.isEmpty() || folder.path.contains("/") {
      continue
    }
    match folder.index {
      Some(index) => {
        // A folder whose index is not part of the skill has no file to point at
        if pages.any({ _.path == index.path }) {
          const summary = index.frontMatter.text("summary") ?? ""
          lines.add "| `reference/{folder.path}/index.md` | {summary} |"
        }
      }
      None => {}
    }
  }
  lines.add ""
  lines.add "To find a construct or a name directly, search: `grep -ril \"<word>\" reference/` names the pages, and"
  lines.add "`reference/index.md` has every page's path and summary on one line each - search it, it is long:"
  lines.add "`grep -i \"<word>\" reference/index.md`."
  lines.add ""
  lines.add "Every page is self-contained: it defines or links every term it uses, so one page is enough to answer one"
  lines.add "question. A page marked `status: draft` may still be wrong, so verify it against the compiler. A page marked"
  lines.add "`status: planned` describes a designed feature that does not compile yet, and its first line says so."
  lines.add ""
  lines.add "There are {pages.length()} pages."
  lines
}

/**
 * One file with every page: its path, its title and its summary, grouped by folder. This is the level between the body
 * of the skill and a page - an index of summaries costs a fraction of the pages it describes, and a search over it
 * costs a fraction of the index.
 */
fn referenceIndex(documentation: Documentation, pages: List<Page>): String {
  var lines: List<String> = ["# The TorbScript documentation", ""]
  lines.add "Every page of the reference, with what it answers. Search this file for a word, then open the one page"
  lines.add "that answers the question. A page marked (planned) describes a feature that does not compile yet."
  lines.add ""
  lines.add "## Contents"
  lines.add ""
  for folder in documentation.folders {
    if carried(pages, folder.path).isEmpty() {
      continue
    }
    const shown = if folder.path.isEmpty() { "the root" } else { folder.path }
    lines.add "- {shown}"
  }
  lines.add ""
  for folder in documentation.folders {
    const own = carried pages, folder.path
    if own.isEmpty() {
      continue
    }
    const heading = if folder.path.isEmpty() { "The root" } else { folder.path }
    lines.add "## {heading}"
    lines.add ""
    for page in own {
      const title = page.frontMatter.text("title") ?? ""
      const summary = page.frontMatter.text("summary") ?? ""
      const kind = page.frontMatter.text("kind") ?? ""
      const status = page.frontMatter.text("status") ?? "stable"
      const marked = if status == "stable" { kind } else { "{kind}, {status}" }
      lines.add "- `{page.path}` - **{title}** ({marked}): {summary}"
    }
    lines.add ""
  }
  lines.joined separator: "\n"
}

/** The pages of one folder that the skill carries, without the root index, which `reference/index.md` replaces. */
fn carried(pages: List<Page>, folder: String): List<Page> {
  pages.filter({ _.folder == folder && _.path != "index.md" }).toList()
}

/** Writes the skill. Every directory is created before the file that goes into it. */
public fn writeSkill(out: String, skill: BuiltSkill): Result<Void, IoError> {
  for file in skill.files {
    const path = "{out}/{file.path}"
    const directory = folderOf path
    if !directory.isEmpty() {
      File.createDirectory(directory)?
    }
    File.writeText(path, file.text)?
  }
  Ok(void)
}

/**
 * Every file under `out` that is not what [writeSkill] would write there, relative to `out` and sorted: one that is
 * missing, one whose text differs, and one that no page produces any more. Empty when the committed skill is current.
 * A line ending is not a difference, because git may check the files out with either one.
 */
public fn staleSkillFiles(out: String, skill: BuiltSkill): Result<List<String>, IoError> {
  var stale: List<String> = []
  var generated: List<String> = []
  for file in skill.files {
    generated.add file.path
    const path = "{out}/{file.path}"
    if !File.exists(path) {
      stale.add "{file.path} (missing)"
      continue
    }
    const text = File.readText(path)?
    if text.replace("\r\n", "\n") != file.text.replace("\r\n", "\n") {
      stale.add "{file.path} (differs)"
    }
  }
  if File.isDirectory(out) {
    for path in filesBelow(out, "")? {
      if !generated.contains(path) {
        stale.add "{path} (no page writes it)"
      }
    }
  }
  stale.sort({ _ })
  Ok stale
}

/** Every file below `out`, as a path relative to it. */
fn filesBelow(out: String, relative: String): Result<List<String>, IoError> {
  const directory = if relative.isEmpty() { out } else { "{out}/{relative}" }
  var found: List<String> = []
  for entry in File.list(directory)? {
    const child = if relative.isEmpty() { entry } else { "{relative}/{entry}" }
    if File.isDirectory("{out}/{child}") {
      found.addAll(filesBelow(out, child)?)
    } else {
      found.add child
    }
  }
  Ok found
}

/** The name of the file the skill is installed as, for the message the command prints. */
public fn installationHint(out: String): String {
  const name = fileName out
  "Copy `{out}` to `~/.claude/skills/{name}` for yourself, or to `.claude/skills/{name}` of a project to share it"
}
