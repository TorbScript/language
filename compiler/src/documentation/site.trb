/**
 * `torb docs site`: the website of TorbScript as static files, generated from `docs/` by the toolchain itself
 * (docs/design/RELEASE.md section 6). The documentation tree `torb docs check` reads is the input, and the site is one
 * more output of it beside the skill and the bundle.
 *
 * What it writes, below the output directory:
 *
 * - `index.html`, the front page, from `site/home.md`; `install.html`, `imprint.html` and `privacy.html` from the page
 *   of the same name in `site/`, each only where that page exists; `404.html` for a path that is not there.
 * - `docs/<version>/`, every page and design document of the documentation as HTML, with the navigation of the index
 *   tree, and `docs/<version>/search-index.json`, the index the search reads.
 * - `docs/versions.json` ([SiteVersions]), once at the root for every language: what the version switcher offers.
 * - `assets/site.css` and `assets/site.js`, one stylesheet and one script; `assets/fonts/`, Chivo and Geist Mono.
 * - The icons, the web manifest and the preview card, copied from `brand/`.
 * - The playground in `assets/` - its script, worker and stylesheet, and `torb` as WebAssembly - where
 *   `playground/build.sh` built it ([writePlayground]).
 *
 * [buildSite] is the whole site as a pure function of the [Documentation]; [writeBuiltSite] writes it and copies the
 * files of the brand. Every internal link of the output is checked against the output, so a link that would lead
 * nowhere fails the build instead of being written.
 *
 * # Related
 *
 * - [renderedBody] - one page's body.
 * - [navigationOf] - the navigation.
 * - [searchIndexOf] - the search.
 */

use File, IoError from "std/fs"
use Sha256 from "std/digest"
use Json from "std/json"
use normalizePath from "../project/path"
use DocumentationProblem, ReadPage, readPage from "./markdown"
use Page, Documentation, Translation, folderOf, fileName, joinDocumentationPath from "./tree"
use SiteLinks, ContentsEntry, RenderedBody, BodyOptions, renderedBody, relativeUrl from "./site-html"
use NavigationEntry, Level, navigationOf, titlesOf, sectionsOf, siteFolder, levelOrder, levelOf from "./site-navigation"
use levelIndex from "./site-navigation"
use SearchPage, SearchHeading, IndexedPage, searchIndexOf, searchIndexJson from "./site-search"
use SiteContext, DocumentationPage, docsDirectory, documentationPageHtml, plainPageHtml, missingPageHtml from "./site-layout"
use frontPageHtml, noticeHtml, forgeAddress, siteSlogan from "./site-layout"
use sourceLanguage, siteLanguagesOf, filled from "./site-strings"
use isStale from "./translations"
use indexBegin from "./schema"
use fontFaces, baseStylesheet, siteStylesheet, themeScript, siteScript from "./site-style"
use brandTokens from "./site-tokens"

/** What a build of the site is given besides the documentation. */
public type SiteSettings {
  /** The version the documentation is of, and the name of its directory below `docs/` */
  version: String
  /** The horizontal lockup as inline SVG, its wordmark in `currentColor` */
  lockup: String
  /** The flat mark as inline SVG */
  mark: String
  /** A hash of the playground's files where the site serves them ([playgroundVersionOf]), empty where it does not */
  playgroundVersion: String = ""
}

/** The site: every text file it writes, every file of the brand it copies, and the problems found building it. */
public type BuiltSite {
  /** By path below the output directory */
  texts: Map<String, String>
  /** `(target, source)`: a path below the output directory, and one below the brand directory */
  copies: List<(target: String, source: String)>
  problems: List<DocumentationProblem>
  /** How many pages of the documentation were written, in every language together */
  pages: Int
  /** How many languages the site is written in */
  languages: Int = 1
}

/**
 * `docs/versions.json`, at the root of the site and the same for every language: what the version switcher of
 * `site-style.trb` offers. Today `versions` is always the one version this build is of - the site image bakes in
 * exactly one version per deploy (`tools/deploy/Dockerfile.site`) and nothing yet accumulates a running site's
 * history (docs/design/RELEASE.md section 6, "Not built yet") - so the file exists instead of 404ing on every page,
 * and the switcher, seeing nothing to switch to, hides itself (`names.length < 2`).
 */
public type SiteVersions {
  latest: String
  versions: List<String>
}

/**
 * The files of the brand the site serves as they are: the fonts, the icons, the manifest's icons and the preview card,
 * each with the path it is served at.
 */
public const brandCopies: List<(target: String, source: String)> = [
  (target: "assets/fonts/chivo.woff2", source: "fonts/chivo.woff2"),
  (target: "assets/fonts/GeistMono-Variable.woff2", source: "fonts/GeistMono-Variable.woff2"),
  (target: "assets/fonts/OFL.txt", source: "fonts/OFL.txt"),
  (target: "assets/fonts/GeistMono-OFL.txt", source: "fonts/GeistMono-OFL.txt"),
  (target: "favicon.svg", source: "logo/favicon.svg"),
  (target: "mask-icon.svg", source: "logo/favicon-mono.svg"),
  (target: "favicon.ico", source: "icons/favicon.ico"),
  (target: "apple-touch-icon.png", source: "icons/apple-touch-icon.png"),
  (target: "icons/app-icon-256.png", source: "icons/app-icon-256.png"),
  (target: "icons/app-icon-512.png", source: "icons/app-icon-512.png"),
  (target: "icons/app-icon-maskable-192.png", source: "icons/app-icon-maskable-192.png"),
  (target: "icons/app-icon-maskable-512.png", source: "icons/app-icon-maskable-512.png"),
  (target: "social-card.png", source: "icons/social-card.png"),
]

/**
 * The files of the playground (docs/design/RELEASE.md section 6), as `playground/build.sh` writes them: served in
 * `assets/` beside the site's script, which loads `playground.js` on a page with a mount; the rest is loaded by it,
 * relative to it - the editor loads its stylesheet and the font of its icons. `torb.wasm.gz` is the same toolchain
 * gzipped, for a server that sends a file's `.gz` as it is.
 */
public const playgroundFiles: List<String> = [
  "playground.js",
  "playground-worker.js",
  "playground-editor.js",
  "playground-editor.css",
  "playground-codicon.ttf",
  "playground.css",
  "torb.js",
  "torb.wasm",
  "torb.wasm.gz",
]

/** The folder of the gallery of `/play` in a built playground, copied with it where it is there. */
const playgroundExamples = "examples"

/** The files of the gallery in a built playground, relative to it (`examples/index.json`, ...); none where it has none. */
fn playgroundExampleFiles(playground: String): Result<List<String>, IoError> {
  const folder = joinDocumentationPath playground, playgroundExamples
  if !File.isDirectory(folder) {
    return []
  }
  var found: List<String> = []
  for entry in File.walk(folder)? {
    if !File.isDirectory(joinDocumentationPath(folder, entry)) {
      found.append "{playgroundExamples}/{entry}"
    }
  }
  found
}

/**
 * The pages of `site/` the footer links when they exist, with the key of the word it shows: the legal pages of a
 * German site.
 */
public const footerPageNames: List<(name: String, key: String)> = [
  (name: "imprint", key: "footer.imprint"),
  (name: "privacy", key: "footer.privacy"),
]

/**
 * Where a file of the documentation is written, relative to the output directory: `site/home.md` is the front page,
 * any other page of `site/` but its index stands at the root, and everything else below `docs/<version>/`.
 *
 * # Examples
 *
 *     print targetOf("guide/index.md", "0.2.0")
 */
public fn targetOf(path: String, version: String): String {
  if path == "{siteFolder}/home.md" {
    return "index.html"
  }
  const html = "{path.withoutSuffix(".md") ?? path}.html"
  if const Some(name) = html.withoutPrefix("{siteFolder}/") {
    if !name.contains("/") && name != "index.html" {
      return name
    }
  }
  "{docsDirectory(version)}/{html}"
}

/**
 * The whole site of a documentation tree, without touching a disk: every page in English at the root and in every
 * other language below its folder, a page without a translation in English inside the other language's interface.
 */
public fn buildSite(documentation: Documentation, settings: SiteSettings): BuiltSite {
  const version = settings.version
  var targets: Map<String, String> = [:]
  for page in documentation.pages {
    targets.set page.path, targetOf(page.path, version)
  }
  for (path, _) in documentation.plainTexts {
    targets.set path, targetOf(path, version)
  }
  const navigation = navigationOf documentation
  var titles = titlesOf navigation
  const sections = sectionsOf navigation
  var summaries: Map<String, String> = [:]
  for page in documentation.pages {
    const title = page.frontMatter.text("title") ?? page.path
    if !titles.containsKey(page.path) {
      titles.set page.path, title
    }
    summaries.set(page.path, page.frontMatter.text("summary") ?? "")
  }
  const orders = [
    (level: Level.Start, order: levelOrder(navigation, Level.Start)),
    (level: Level.Guide, order: levelOrder(navigation, Level.Guide)),
    (level: Level.Reference, order: levelOrder(navigation, Level.Reference)),
  ]
  var footerPages: List<(key: String, target: String)> = []
  for (name, key) in footerPageNames {
    if documentation.pageAt("{siteFolder}/{name}.md").isSome() {
      footerPages.append((key: key, target: "{name}.html"))
    }
  }
  const installPage = installPageOf documentation, targets, version
  const css = siteCss()
  const script = "{themeScript}\n{siteScript}"
  const assetVersion = Sha256.of("{css}{script}".bytes()).hex().prefix(characters: 12)
  const forge = "{forgeAddress}/src/branch/main"
  // Every body is rendered once: its links are relative, and every language has the same tree of pages
  var bodies: Map<String, RenderedBody> = [:]
  for page in documentation.pages {
    const target = targets.get(page.path) ?? ""
    const links = SiteLinks target, page.folder, targets, forge
    bodies.set page.path, renderedBody(bodyOf(page), page.read.headings, links, bodyOptionsOf(page.path))
  }
  var plainBodies: Map<String, (read: ReadPage, rendered: RenderedBody)> = [:]
  for (path, text) in documentation.plainTexts {
    const target = targets.get(path) ?? ""
    const read = readPage path, text
    const links = SiteLinks target, folderOf(path), targets, forge
    plainBodies.set path, (read: read, rendered: renderedBody(text, read.headings, links))
  }
  var translations: Map<String, Translation> = [:]
  var translatedBodies: Map<String, RenderedBody> = [:]
  var translated: Map<String, List<String>> = [:]
  for translation in documentation.translations {
    if documentation.pageAt(translation.original).isNone() {
      continue
    }
    const key = "{translation.language}:{translation.original}"
    translations.set key, translation
    const target = targets.get(translation.original) ?? ""
    const links = SiteLinks target, folderOf(translation.original), targets, forge
    const page = translation.page
    translatedBodies.set key, renderedBody(bodyOf(page), page.read.headings, links, bodyOptionsOf(translation.original))
    const codes = translated.get(translation.original) ?? [sourceLanguage]
    translated.set translation.original, codes.appended(translation.language)
  }
  const languages = siteLanguagesOf documentation
  var texts: Map<String, String> = [:]
  var pages = 0
  for language in languages {
    var localTitles: Map<String, String> = [:]
    var localSummaries = summaries
    for (key, translation) in translations {
      if !key.startsWith("{language.code}:") {
        continue
      }
      if const Some(title) = translation.page.frontMatter.text("title") {
        localTitles.set translation.original, title
      }
      if const Some(summary) = translation.page.frontMatter.text("summary") {
        localSummaries.set translation.original, summary
      }
    }
    const site = SiteContext(
      version,
      settings.lockup,
      settings.mark,
      navigation,
      targets,
      footerPages,
      installPage,
      assetVersion,
      language,
      languages,
      translated,
      localTitles,
      localSummaries,
      hasPlayground: documentation.pageAt("{siteFolder}/play.md").isSome(),
      playgroundVersion: settings.playgroundVersion,
    )
    var shownTitles = titles
    for (source, title) in localTitles {
      shownTitles.set source, title
    }
    var indexed: List<IndexedPage> = []
    for page in documentation.pages {
      const target = targets.get(page.path) ?? ""
      const own = translations.get "{language.code}:{page.path}"
      const shownPage = match own {
        Some(translation) => translation.page
        None => page
      }
      const rendered = match own {
        Some(_) => translatedBodies.get("{language.code}:{page.path}") ?? RenderedBody("", [], "")
        None => bodies.get(page.path) ?? RenderedBody("", [], "")
      }
      const title = shownPage.frontMatter.text("title") ?? page.path
      const summary = shownPage.frontMatter.text("summary") ?? ""
      const untranslated = !language.prefix.isEmpty() && own.isNone()
      const notice = noticeOf documentation, site, untranslated, target, own
      if page.folder == siteFolder && !page.indexesFolder {
        const links = SiteLinks target, page.folder, targets, forge
        if fileName(page.path) == "home.md" {
          texts.set "{language.prefix}{target}", frontPageHtml(site, summary, shownPage.read.body, links, untranslated)
        } else {
          const html = plainPageHtml site, page.path, target, title, summary, rendered.html, notice, untranslated
          texts.set "{language.prefix}{target}", html
        }
        continue
      }
      const neighbours = neighboursOf orders, page.path, shownTitles, targets
      const body = "{referenceLinkOf(page, target, version, site)}{rendered.html}"
      const shown = DocumentationPage(
        page.path,
        target,
        title,
        summary,
        title,
        body,
        rendered.contents,
        neighbours.previous,
        neighbours.next,
        neighbours.nextKey,
        notice,
        untranslated,
      )
      texts.set "{language.prefix}{target}", documentationPageHtml(site, shown)
      pages = pages + 1
      if page.folder != siteFolder {
        const entry = SearchPage(
          title,
          summary,
          target.withoutPrefix("{docsDirectory(version)}/") ?? target,
          sectionTitleOf(documentation, sections, page.path, localTitles),
          page.frontMatter.items("keywords"),
          headingsOf(rendered.contents),
        )
        indexed.append IndexedPage(entry, rendered.text)
      }
    }
    for (path, plain) in plainBodies {
      const target = targets.get(path) ?? ""
      const title = documentation.plainTitles.get(path) ?? path
      const neighbours = neighboursOf orders, path, shownTitles, targets
      const untranslated = !language.prefix.isEmpty()
      const shown = DocumentationPage(
        path,
        target,
        "",
        "",
        title,
        plain.rendered.html,
        plain.rendered.contents,
        neighbours.previous,
        neighbours.next,
        neighbours.nextKey,
        noticeOf(documentation, site, untranslated, target, own: None),
        untranslated,
      )
      texts.set "{language.prefix}{target}", documentationPageHtml(site, shown)
      pages = pages + 1
      const entry = SearchPage(
        title,
        "",
        target.withoutPrefix("{docsDirectory(version)}/") ?? target,
        sectionTitleOf(documentation, sections, path, localTitles),
        [],
        headingsOf(plain.rendered.contents),
      )
      indexed.append IndexedPage(entry, plain.rendered.text)
    }
    const index = "{language.prefix}{docsDirectory(version)}/search-index.json"
    texts.set index, searchIndexJson(searchIndexOf(version, indexed))
    if language.prefix.isEmpty() {
      texts.set "404.html", missingPageHtml(site)
    }
  }
  texts.set "assets/site.css", css
  texts.set "assets/site.js", script
  texts.set "manifest.webmanifest", manifestOf(documentation)
  texts.set "docs/versions.json", Json().encode(SiteVersions(version, [version]))
  var problems: List<DocumentationProblem> = []
  if documentation.pageAt("{siteFolder}/home.md").isNone() {
    problems.append(DocumentationProblem(
      "{documentation.root}/{siteFolder}/home.md",
      0,
      "The front page of the site is missing",
    ))
  }
  problems.appendAll brokenLinks(texts, brandCopies, version)
  BuiltSite texts, brandCopies, problems, pages, languages.length()
}

/** The body of a page as the site renders it: an index of Start without the list `docs index` writes into it. */
fn bodyOf(page: Page): String {
  if page.path == levelIndex(Level.Start) {
    return page.read.body.substringBefore(indexBegin) ?? page.read.body
  }
  page.read.body
}

/** How the body of a source is rendered: a lesson in rows of text beside code, and its runnable blocks runnable locally. */
fn bodyOptionsOf(path: String): BodyOptions {
  const name = fileName(path).withoutSuffix(".md") ?? fileName(path)
  const isStart = levelOf(path) == Level.Start
  BodyOptions("{name}.trb", isStart, isStart && fileName(path) != "index.md")
}

/**
 * The notice above a page in another language: that it is shown in English, which links the English page, or that the
 * English page changed since the translation was made.
 */
fn noticeOf(
  documentation: Documentation,
  site: SiteContext,
  untranslated: Bool,
  target: String,
  own: Translation?,
): String {
  const page = "{site.language.prefix}{target}"
  if untranslated {
    return noticeHtml site, "notice.untranslated", page, target
  }
  match own {
    Some(translation) => {
      if isStale(documentation, translation) {
        return noticeHtml site, "notice.outdated", page, target
      }
      ""
    }
    None => ""
  }
}

/**
 * Where the front page's red button leads: the install page of the site, or the guide's page that installs and runs
 * the toolchain, or the overview of the documentation - the first of them the tree has.
 */
fn installPageOf(documentation: Documentation, targets: Map<String, String>, version: String): String {
  if documentation.pageAt("{siteFolder}/install.md").isSome() {
    return "install.html"
  }
  targets.get("guide/installing-and-running.md") ?? "{docsDirectory(version)}/index.html"
}

/** The one stylesheet of the site: the two faces, the tokens of the brand, and the rules written for the site. */
public fn siteCss(): String {
  "{fontFaces("fonts/")}\n{brandTokens}\n{baseStylesheet}\n{siteStylesheet}"
}

/** The previous and the next page of a page, and the word the link to the next one shows. */
type Neighbours {
  previous: (title: String, target: String)?
  next: (title: String, target: String)?
  nextKey: String
}

/**
 * The previous and the next page of a page, in the order of its level. The last page of Start leads to the Guide and
 * the last page of the Guide to the Reference, each with the words of that step.
 */
fn neighboursOf(
  orders: List<(level: Level, order: List<String>)>,
  path: String,
  titles: Map<String, String>,
  targets: Map<String, String>,
): Neighbours {
  for (level, order) in orders {
    var at = -1
    for index in 0..order.length() {
      if order[index] == path {
        at = index
        break
      }
    }
    if at < 0 {
      continue
    }
    const previous = if at > 0 { neighbourAt order[at - 1], titles, targets } else { None }
    if at + 1 < order.length() {
      return Neighbours previous, neighbourAt(order[at + 1], titles, targets), "page.next"
    }
    return match level {
      .Start => Neighbours previous, neighbourAt(levelIndex(Level.Guide), titles, targets), "next.guide"
      .Guide => Neighbours previous, neighbourAt(levelIndex(Level.Reference), titles, targets), "next.reference"
      _ => Neighbours previous, next: None, nextKey: "page.next"
    }
  }
  Neighbours previous: None, next: None, nextKey: "page.next"
}

fn neighbourAt(
  path: String,
  titles: Map<String, String>,
  targets: Map<String, String>,
): (title: String, target: String)? {
  const target = targets.get(path) ?? ""
  if target.isEmpty() {
    return None
  }
  (title: titles.get(path) ?? path, target: target)
}

/**
 * The title of the section a page belongs to - the index of the top-level folder whose navigation lists it, or of the
 * folder it is in - for a result of the search.
 */
fn sectionTitleOf(
  documentation: Documentation,
  sections: Map<String, String>,
  path: String,
  titles: Map<String, String>,
): String {
  const folder = folderOf path
  const top = sections.get(path) ?? (folder.split("/").first() ?? folder)
  if top.isEmpty() {
    return ""
  }
  match documentation.indexOf(top) {
    Some(index) => titles.get(index.path) ?? (index.frontMatter.text("title") ?? top)
    None => top
  }
}

fn headingsOf(contents: List<ContentsEntry>): List<SearchHeading> {
  var headings: List<SearchHeading> = []
  for entry in contents {
    headings.append SearchHeading(entry.text, entry.anchor)
  }
  headings
}

/**
 * The link from the written page of a package of `std/` to its generated reference, which `torb doc std` writes into
 * `docs/<version>/reference/` (docs/design/RELEASE.md section 6): the generator writes it, from the package name the
 * page is titled with, so no page of `docs/` links into generated output.
 */
fn referenceLinkOf(page: Page, target: String, version: String, site: SiteContext): String {
  const kind = page.frontMatter.text("kind") ?? ""
  const title = page.frontMatter.text("title") ?? ""
  if kind != "package" || !title.startsWith("std/") {
    return ""
  }
  const reference = "{docsDirectory(version)}/reference/{title}/index.html"
  const url = relativeUrl "{site.language.prefix}{target}", reference
  const link = "<a href=\"{url}\"><code>{title}</code></a>"
  const text = filled site.word("page.reference").replace("<", "&lt;"), [(name: "package", value: link)]
  "<p class=\"page-reference\">{text}</p>\n"
}

/** The web manifest: the name, the colours of the two themes' grounds, and the icons with the maskable one. */
fn manifestOf(documentation: Documentation): String {
  const description = match documentation.pageAt("{siteFolder}/home.md") {
    Some(page) => page.frontMatter.text("summary") ?? siteSlogan
    None => siteSlogan
  }
  const escaped = description.replace("\\", "\\\\").replace("\"", "\\\"")
  const lines = [
    "\{",
    "  \"name\": \"TorbScript\",",
    "  \"short_name\": \"TorbScript\",",
    "  \"description\": \"{escaped}\",",
    "  \"start_url\": \"./\",",
    "  \"scope\": \"./\",",
    "  \"display\": \"minimal-ui\",",
    "  \"background_color\": \"#FFFDFC\",",
    "  \"theme_color\": \"#FFFDFC\",",
    "  \"icons\": [",
    "    \{ \"src\": \"icons/app-icon-256.png\", \"sizes\": \"256x256\", \"type\": \"image/png\", \"purpose\": \"any\" \},",
    "    \{ \"src\": \"icons/app-icon-512.png\", \"sizes\": \"512x512\", \"type\": \"image/png\", \"purpose\": \"any\" \},",
    "    \{ \"src\": \"icons/app-icon-maskable-192.png\", \"sizes\": \"192x192\", \"type\": \"image/png\", \"purpose\": \"maskable\" \},",
    "    \{ \"src\": \"icons/app-icon-maskable-512.png\", \"sizes\": \"512x512\", \"type\": \"image/png\", \"purpose\": \"maskable\" \}",
    "  ]",
    "\}",
    "",
  ]
  lines.joined separator: "\n"
}

/**
 * Every link of the written pages that leads to no file of the site: an `href` or a `src` that is relative, resolved
 * against the page it stands on. The generated reference below `docs/<version>/reference/` is not part of this build
 * and is not asked for.
 */
public fn brokenLinks(
  texts: Map<String, String>,
  copies: List<(target: String, source: String)>,
  version: String,
): List<DocumentationProblem> {
  var known: Set<String> = []
  for (path, _) in texts {
    known.insert path
  }
  for copy in copies {
    known.insert copy.target
  }
  const reference = "{docsDirectory(version)}/reference/"
  var problems: List<DocumentationProblem> = []
  for (path, text) in texts {
    if !path.endsWith(".html") {
      continue
    }
    const folder = folderOf path
    for url in linkTargetsOf(text) {
      const isOutside = url.startsWith("http://") || url.startsWith("https://") || url.startsWith("mailto:")
      if isOutside || url.startsWith("#") || url.startsWith("/") || url.startsWith("data:") || url.isEmpty() {
        continue
      }
      const withoutFragment = url.substringBefore("#") ?? url
      const bare = withoutFragment.substringBefore("?") ?? withoutFragment
      const resolved = normalizePath joinDocumentationPath(folder, bare)
      if resolved.startsWith(reference) || known.contains(resolved) {
        continue
      }
      problems.append DocumentationProblem(path, 0, "The link `{url}` leads to no file of the site")
    }
  }
  problems.sort({ (_.path, _.message) })
  problems
}

/** The values of every `href="..."` and `src="..."` of an HTML text. */
fn linkTargetsOf(html: String): List<String> {
  var found: List<String> = []
  for attribute in [" href=\"", " src=\""] {
    // Split once instead of searching the rest again after every link: a design document has thousands of them
    const pieces = html.split attribute
    for index in 1..pieces.length() {
      if const Some(value) = pieces[index].substringBefore("\"") {
        found.append value.replace("&amp;", "&")
      }
    }
  }
  found
}

/**
 * Writes the site into `output`: every text, and every file of the brand copied from `brand`. A directory is created
 * before the first file that goes into it. Answers with the number of files written.
 */
public fn writeBuiltSite(output: String, brand: String, site: BuiltSite): Result<Int, IoError> {
  var created: Set<String> = []
  var count = 0
  for (path, text) in site.texts {
    const target = joinDocumentationPath output, path
    ensureDirectory(created, folderOf(target))?
    File.writeText(target, text)?
    count = count + 1
  }
  for copy in site.copies {
    const target = joinDocumentationPath output, copy.target
    ensureDirectory(created, folderOf(target))?
    File.copy(joinDocumentationPath(brand, copy.source), target)?
    count = count + 1
  }
  count
}

/**
 * The version of a built playground: twelve hexadecimal digits of the SHA-256 of its files but `torb.wasm`, whose
 * `torb.wasm.gz` is hashed instead - the same bytes, a quarter of them - and of the gallery's files, with their names.
 * A page loads the playground with it as `?v=`, and the playground loads every file of its own with the same query.
 */
public fn playgroundVersionOf(playground: String): Result<String, IoError> {
  var hasher = Sha256()
  for name in playgroundFiles {
    if name != "torb.wasm" {
      hasher.add(File.readBytes(joinDocumentationPath(playground, name))?)
    }
  }
  for name in playgroundExampleFiles(playground)? {
    hasher.add name.bytes()
    hasher.add(File.readBytes(joinDocumentationPath(playground, name))?)
  }
  hasher.finished().hex().prefix(characters: 12)
}

/**
 * Copies the built playground from `playground` into `assets/` of `output`, with the gallery's folder where it has one.
 * Answers with the number of files.
 */
public fn writePlayground(output: String, playground: String): Result<Int, IoError> {
  var created: Set<String> = []
  const assets = joinDocumentationPath output, "assets"
  ensureDirectory(created, assets)?
  for name in playgroundFiles {
    File.copy(joinDocumentationPath(playground, name), joinDocumentationPath(assets, name))?
  }
  const examples = playgroundExampleFiles(playground)?
  for name in examples {
    const target = joinDocumentationPath assets, name
    ensureDirectory(created, folderOf(target))?
    File.copy(joinDocumentationPath(playground, name), target)?
  }
  playgroundFiles.length() + examples.length()
}

fn ensureDirectory(var created: Set<String>, directory: String): Result<Void, IoError> {
  if directory.isEmpty() || created.contains(directory) {
    return Ok(void)
  }
  File.createDirectory(directory)?
  created.insert directory
  Ok(void)
}

/**
 * The inline drawings of the header and the footer, read from the brand: the lockup with the flat mark, whose wordmark
 * is made to follow the theme's text colour, and the flat mark.
 */
public fn brandDrawingsOf(brand: String): Result<(lockup: String, mark: String), IoError> {
  const lockup = File.readText(joinDocumentationPath(brand, "logo/lockup-flat.svg"))?
  const mark = File.readText(joinDocumentationPath(brand, "logo/mark-flat.svg"))?
  const inline = withoutTitle(lockup.trim()).replace("fill=\"#14110F\"", "fill=\"currentColor\"")
  (lockup: withRole(inline), mark: withRole(withoutTitle(mark.trim())))
}

/** A drawing without its `<title>`, which a link or a text beside it already says. */
fn withoutTitle(svg: String): String {
  match svg.splitOnce("<title>") {
    Some(parts) => match parts.after.splitOnce("</title>") {
      Some(rest) => "{parts.before}{rest.after}"
      None => svg
    }
    None => svg
  }
}

fn withRole(svg: String): String {
  svg.replace "<svg ", "<svg aria-hidden=\"true\" focusable=\"false\" "
}
