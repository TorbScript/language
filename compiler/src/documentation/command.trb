/**
 * `torb docs <command>`: the commands that keep the documentation true. Every one of them is a gate that can be run
 * from a script, so all of them answer with the number of problems and print nothing but problems when there are any.
 *
 * [runCheck], [runIndex], [runSkill], [runBundle] and [runSite] are the command line behind `torb docs check`,
 * `docs index`, `docs skill`, `docs bundle` and `docs site`; `docs source` is a command of its own in `source.trb`,
 * because it reads `.trb` files instead of the pages.
 *
 * # Related
 *
 * - [checkDocumentation] - what `runCheck` asks of the tree.
 * - [buildSkills] - what `runSkill` writes.
 */

use File, IoError from "std/fs"
use Environment from "std/os"
use DocumentationProblem from "./markdown"
use Page, readDocumentation from "./tree"
use PathExists from "./links"
use readStandardLibrary from "./snippets"
use checkDocumentation, checkSnippets, sortedProblems from "./check"
use NativeOptions from "./native"
use generateIndexes, writeIndexes, staleIndexes from "./index"
use buildSkills, writeSkills, staleSkillFiles from "./skill"
use bundleDocumentation, writeBundle from "./bundle"
use SiteSettings, buildSite, writeBuiltSite, brandDrawingsOf from "./site"
use playgroundFiles, playgroundVersionOf, writePlayground from "./site"
use BenchmarkReport, benchmarkReportOf from "./site-benchmarks"
use counted from "../cli/render"

/** The options every `torb docs` command is called with, parsed once by [documentationOptionsOf]. */
public type DocumentationOptions {
  root: String
  /** Where `std/` is, for the type check of the snippets. Empty means `<root>/../std`. */
  standardLibrary: String
  /** `--no-snippets`: skip the type check, which is the slow part */
  withoutSnippets: Bool
  /** `--no-native`: skip what the native back end says about the blocks, for a machine without a C compiler */
  withoutNative: Bool
  /** `--check` of `docs index` and `docs skill` */
  onlyCheck: Bool
  /** The output directory of `skill`, `bundle` and `site`: the second path, or `--output` */
  out: String
  /** `--version` of `docs site`: the version the documentation is of. Empty is `latest` */
  version: String = ""
  /** `--brand` of `docs site`: where `brand/` is. Empty means `<root>/../brand` */
  brand: String = ""
  /** `--playground` of `docs site`: what `playground/build.sh` wrote. Empty means `<root>/../build/playground` */
  playground: String = ""
  /** `--benchmarks` of `docs site`: what the benchmarks page shows. Empty means `<root>/../build/benchmarks.json` */
  benchmarks: String = ""
}

/**
 * Parses `torb docs`'s arguments. `--standard-library`, `--output`, `--version`, `--brand`, `--playground` and
 * `--benchmarks` take the argument after them; `--no-snippets`, `--no-native` and `--check` are flags; everything else
 * is a path.
 */
public fn documentationOptionsOf(arguments: List<String>): DocumentationOptions {
  var paths: List<String> = []
  var standardLibrary = ""
  var withoutSnippets = false
  var withoutNative = false
  var onlyCheck = false
  var output = ""
  var version = ""
  var brand = ""
  var playground = ""
  var benchmarks = ""
  var wanted = ""
  for argument in arguments {
    match wanted {
      "--standard-library" => {
        standardLibrary = argument
        wanted = ""
        continue
      }
      "--output" => {
        output = argument
        wanted = ""
        continue
      }
      "--version" => {
        version = argument
        wanted = ""
        continue
      }
      "--brand" => {
        brand = argument
        wanted = ""
        continue
      }
      "--playground" => {
        playground = argument
        wanted = ""
        continue
      }
      "--benchmarks" => {
        benchmarks = argument
        wanted = ""
        continue
      }
      _ => {}
    }
    if ["--standard-library", "--output", "--version", "--brand", "--playground", "--benchmarks"].contains(argument) {
      wanted = argument
      continue
    }
    if argument == "--no-snippets" {
      withoutSnippets = true
      continue
    }
    if argument == "--no-native" {
      withoutNative = true
      continue
    }
    if argument == "--check" {
      onlyCheck = true
      continue
    }
    paths.append argument
  }
  const root = paths.get(0) ?? "docs"
  const out = if output.isEmpty() { paths.get(1) ?? "" } else { output }
  DocumentationOptions(
    root,
    standardLibrary,
    withoutSnippets,
    withoutNative,
    onlyCheck,
    out,
    version,
    brand,
    playground,
    benchmarks,
  )
}

/** Where the standard library is, for the type check of the snippets. */
fn standardLibraryPath(options: DocumentationOptions): String {
  if !options.standardLibrary.isEmpty() {
    return options.standardLibrary
  }
  "{options.root}/../std"
}

/**
 * Where the `trb run` blocks are built: the C runtime is `$TORB_RUNTIME`, or the `runtime/` beside the standard library,
 * and the program goes to `build/docs/` beside the documentation root - both are where a checkout has them.
 */
fn nativeOptionsOf(options: DocumentationOptions, standardLibrary: String): NativeOptions {
  const given = Environment.get("TORB_RUNTIME") ?? ""
  const runtime = if given.isEmpty() { "{standardLibrary}/../runtime" } else { given }
  NativeOptions runtime, "{options.root}/../build/docs"
}

fn reportProblems(problems: List<DocumentationProblem>): Int {
  for problem in sortedProblems(problems) {
    printError problem.show()
  }
  problems.length()
}

/** `torb docs check <root>`. Returns the number of problems. */
public fn runCheck(options: DocumentationOptions): Result<Int, IoError> {
  const documentation = readDocumentation(options.root)?
  const exists = PathExists({ File.exists _ })
  const checked = checkDocumentation documentation, exists
  var problems = checked.problems
  if !options.withoutSnippets {
    const path = standardLibraryPath options
    const standardLibrary = readStandardLibrary(path)?
    const nativeOptions = if options.withoutNative { None } else { Some nativeOptionsOf(options, path) }
    problems.appendAll(checkSnippets(documentation, standardLibrary, nativeOptions)?)
  }
  const count = reportProblems problems
  for stale in checked.staleTranslations {
    printError "outdated: {stale}"
  }
  if count > 0 {
    printError ""
    printError "{counted(count, "problem")} in {counted(checked.pages, "page")}"
    return count
  }
  const folders = counted checked.folders, "folder"
  print "{counted(checked.pages, "page")}, {folders}, {counted(checked.snippets, "snippet")}, no problems"
  for skipped in checked.skipped {
    print "skipped: {skipped}"
  }
  0
}

/** `torb docs index <root> [--check]`. Returns the number of problems. */
public fn runIndex(options: DocumentationOptions): Result<Int, IoError> {
  const documentation = readDocumentation(options.root)?
  const result = generateIndexes documentation
  if options.onlyCheck {
    var problems = result.problems
    problems.appendAll staleIndexes(documentation, result)
    const count = reportProblems problems
    if count == 0 {
      print "{result.generated.length()} indexes, all up to date"
    }
    return count
  }
  const count = reportProblems result.problems
  const written = writeIndexes(documentation, result)?
  for path in written {
    print "wrote {path}"
  }
  if written.isEmpty() {
    print "{result.generated.length()} indexes, nothing to write"
  }
  count
}

/**
 * `torb docs skill <root> <out> [--check]`: the Agent Skills the templates below `<root>/skills/` declare, written into
 * one directory per skill below `out`. Returns the number of problems. With `--check` nothing is written: every file
 * under `out` that is not what the command would write is a problem, which is the gate that keeps the committed skills
 * in step with the pages they are built from.
 */
public fn runSkill(options: DocumentationOptions): Result<Int, IoError> {
  if options.out.isEmpty() {
    printError "torb docs skill <root> <out>: where the skills go is missing"
    return 1
  }
  const documentation = readDocumentation(options.root)?
  const built = buildSkills documentation
  const count = reportProblems built.problems
  if count > 0 {
    return count
  }
  if built.skills.isEmpty() {
    printError "torb docs skill: {options.root}/skills/ declares no skill"
    return 1
  }
  if options.onlyCheck {
    const stale = staleSkillFiles(options.out, built)?
    for path in stale {
      printError "{options.out}/{path}"
    }
    const skills = counted built.skills.length(), "skill"
    if stale.isEmpty() {
      print "{skills}, {counted(built.files.length(), "file")}, all up to date"
    } else {
      printError "{stale.length()} files of the skills are stale: torb docs skill {options.root} {options.out}"
    }
    return stale.length()
  }
  const removed = writeSkills(options.out, built)?
  for skill in built.skills {
    print "{skill.name}: SKILL.md has {counted(skill.bodyLines, "line")}, {counted(skill.pages, "page")}"
  }
  var summary = "{counted(built.files.length(), "file")} in {options.out}, {built.excluded} pages in no skill on purpose"
  if !removed.isEmpty() {
    summary = "{summary}, {counted(removed.length(), "stale file")} removed"
  }
  print summary
  0
}

/** `torb docs bundle <root> <out>`. */
public fn runBundle(options: DocumentationOptions): Result<Int, IoError> {
  if options.out.isEmpty() {
    printError "torb docs bundle <root> <out>: where the bundle goes is missing"
    return 1
  }
  const documentation = readDocumentation(options.root)?
  const index = documentation.pageAt "index.md"
  const title = titleOf index
  const summary = summaryOf index
  const bundled = bundleDocumentation documentation, title, summary
  writeBundle(options.out, bundled)?
  print "wrote {options.out}/llms.txt and {options.out}/llms-full.txt"
  0
}

/**
 * `torb docs site <root> --output <dir> [--version <v>] [--brand <dir>] [--playground <dir>] [--benchmarks <file>]
 * [--check]`. Returns the number of problems. With `--check` nothing is written: the site is built and its links are
 * checked, which is the gate that keeps it from rotting between releases.
 *
 * The playground is copied into `assets/` where it was built (`playground/build.sh`), and left out where it was not:
 * a page links none of its files, and a mount without it stays the code it was written as. The benchmarks page shows
 * the report of [benchmarksOf], and says that nothing is measured yet where there is none.
 */
public fn runSite(options: DocumentationOptions): Result<Int, IoError> {
  if options.out.isEmpty() && !options.onlyCheck {
    printError "torb docs site <root> --output <dir>: where the site goes is missing"
    return 1
  }
  const brand = if options.brand.isEmpty() { "{options.root}/../brand" } else { options.brand }
  if !File.isDirectory(brand) {
    printError "torb docs site: the brand is read from `{brand}`, which is not a directory. `--brand <dir>` names it"
    return 1
  }
  const version = if options.version.isEmpty() { "latest" } else { options.version }
  const documentation = readDocumentation(options.root)?
  const drawings = brandDrawingsOf(brand)?
  const playground = if options.playground.isEmpty() { "{options.root}/../build/playground" } else { options.playground }
  const hasPlayground = playgroundFiles.all({ File.exists "{playground}/{_}" })
  if !hasPlayground && !options.playground.isEmpty() {
    printError "torb docs site: `{playground}` has no built playground. `sh playground/build.sh` builds it"
    return 1
  }
  const playgroundVersion = if hasPlayground { playgroundVersionOf(playground)? } else { "" }
  const benchmarks = match benchmarksOf(options) {
    Ok(report) => report
    Fail(problem) => {
      printError "torb docs site: {problem}"
      return 1
    }
  }
  const settings = SiteSettings version, drawings.lockup, drawings.mark, playgroundVersion, benchmarks
  const site = buildSite documentation, settings
  var count = reportProblems site.problems
  for copy in site.copies {
    const source = "{brand}/{copy.source}"
    if !File.exists(source) {
      printError "{source}: the site serves this file of the brand as `{copy.target}`, and it is missing"
      count = count + 1
    }
  }
  if count > 0 {
    return count
  }
  const pages = "{counted(site.pages / site.languages.max(1), "page")} of {version} in {counted(site.languages, "language")}"
  if options.onlyCheck {
    print "{pages}, {counted(site.texts.length() + site.copies.length(), "file")}, no broken link"
    return 0
  }
  var written = writeBuiltSite(options.out, brand, site)?
  if hasPlayground {
    written = written + writePlayground(options.out, playground)?
  }
  print "{pages}: wrote {counted(written, "file")} to {options.out}"
  0
}

/**
 * The report the benchmarks page shows: the file `--benchmarks` names, which has to be there, or else
 * `<root>/../build/benchmarks.json` where it is (`tools/fetch-benchmarks.sh` writes it). A file that cannot be read as
 * a report is said on standard error and left out, so a site is still built when a night's measurement went wrong;
 * only a named file that is missing fails the build.
 */
fn benchmarksOf(options: DocumentationOptions): Result<BenchmarkReport?, String> {
  const path = if options.benchmarks.isEmpty() { "{options.root}/../build/benchmarks.json" } else { options.benchmarks }
  if !File.exists(path) {
    if options.benchmarks.isEmpty() {
      return Ok None
    }
    return Fail "`{path}` is not there. `sh tools/fetch-benchmarks.sh` fetches the newest one"
  }
  const text = match File.readText(path) {
    Ok(read) => read
    Fail(problem) => {
      printError "torb docs site: `{path}` cannot be read ({problem}), so nothing is shown"
      return Ok None
    }
  }
  match benchmarkReportOf(text) {
    Ok(report) => Ok Some(report)
    Fail(problem) => {
      printError "torb docs site: `{path}` is no report of benchmarks/game.sh ({problem}), so nothing is shown"
      Ok None
    }
  }
}

fn titleOf(page: Page?): String {
  match page {
    Some(found) => found.frontMatter.text("title") ?? "TorbScript"
    None => "TorbScript"
  }
}

fn summaryOf(page: Page?): String {
  match page {
    Some(found) => found.frontMatter.text("summary") ?? ""
    None => ""
  }
}

/** The `torb docs` block of `torb --help`: one line per command, one per flag. */
public fn printDocumentationUsage() {
  for line in documentationUsageLines() {
    printError line
  }
}

/** The lines of that block: what `torb docs --help` prints as well. */
public fn documentationUsageLines(): List<String> {
  [
    "  torb docs source <path>...     The doc comments of the code: the standard of compiler/CONTRIBUTING.md",
    "                         --statistics: how much of every tree is documented",
    "                         --no-examples: do not type check the examples, which is the slow part",
    "                         --tree <std|compiler|examples|tests>: which rules to judge every file by",
    "                         --panics: only whether every public function of std/ that can panic says when",
    "  torb docs check [root]  Check the documentation (default root: docs)",
    "                         --standard-library <path>: where std/ is, for the snippets",
    "                         --no-snippets: do not type check the snippets, which is the slow part",
    "                         --no-native: do not build the snippets, for a machine without a C compiler",
    "  torb docs index [root]  Write the generated part of every index.md",
    "                         --check: report instead of writing, for the gate",
    "  torb docs skill <root> <out>   Write the Agent Skills of <root>/skills/, one directory each below <out>",
    "                         --check: report the stale files instead of writing, for the gate",
    "  torb docs bundle <root> <out>  Write llms.txt and llms-full.txt",
    "  torb docs site <root> --output <dir>  Write the website: the front page, every page, the search",
    "                         --version <v>: the version the documentation is of (default: latest)",
    "                         --brand <dir>: where brand/ is (default: <root>/../brand)",
    "                         --playground <dir>: the built playground (default: <root>/../build/playground)",
    "                         --benchmarks <file>: the measurements (default: <root>/../build/benchmarks.json)",
    "                         --check: build it and check its links, and write nothing",
  ]
}
