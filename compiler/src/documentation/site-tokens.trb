    --torb-font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --torb-font-mono-features: "zero" 1, "liga" 0, "calt" 0;
    --torb-font-mono-ligatures: none;
    --torb-weight-regular: 400;
    --torb-weight-medium: 500;
    --torb-weight-semibold: 600;
    --torb-weight-bold: 700;
