/**
 * Every fenced code block of the documentation is verified with the compiler's own front end. A wrong example is the
 * worst thing a documentation for agents can contain: a model copies what it reads, and it cannot tell a typo from a
 * rule. So the default is the strictest thing the front end can say about a block, and every weaker level has to be
 * asked for in the info string of the fence.
 *
 * | Fence                 | What is checked                                                              |
 * |-----------------------|------------------------------------------------------------------------------|
 * | `trb`                 | Lexes and parses without a diagnostic, and is in the formatter canon         |
 * | `trb check`           | ...and type checks against the real `std/`, as the entry file of a package   |
 * | `trb run`             | ...and is built natively and run: its output is what its `// prints` say     |
 * | `trb fragment`        | Lexes without a diagnostic. For a signature or a shape that is not a program |
 * | `trb error`           | Produces exactly the diagnostics the block declares with `// error:` lines   |
 * | `trb skip <reason>`   | Nothing. The reason is required and every skip is counted in the report      |
 *
 * The type check of every `trb check`, `trb run` and `trb error` block of the whole documentation happens in **one**
 * run of the front end: the standard library is read and resolved once, and every block is a package of a synthetic
 * workspace next to it. One run of the checker costs seconds, one per block would cost minutes.
 *
 * [collectSnippets] judges the info string of every block; [verifySyntax] and [verifyTypes] are the two checks that
 * follow, syntax for every block and types for the ones that asked for it. What the native back end says about a block
 * is [nativeSnippetProblems]'s.
 *
 * # Related
 *
 * - [canonProblems] - the style rule a parsed snippet is also held to.
 */

use File, IoError from "std/fs"
use SourceText from "../syntax/source"
use lex from "../syntax/lexer"
use parse from "../syntax/parser/parser"
use SourceTree from "../project/source-tree"
use check, Checked from "../semantics/check"
use DocumentationProblem, CodeBlock, linesOf from "./markdown"
use Page, Documentation from "./tree"
use canonProblems from "./canon"
use nativeNote from "./schema"

/** How hard a fenced block is checked, decided by its marker. The spelling mirrors the markers themselves. */
public type SnippetKind {
  /** `trb` */
  case Program
  /** `trb check` */
  case Checked
  /** `trb run` */
  case Running
  /** `trb fragment` */
  case Fragment
  /** `trb error` */
  case Failing
  /** `trb skip <reason>` */
  case Skipped
}

/** One fenced `trb` block, ready to be checked: its text, its [SnippetKind], and where it stands in the page. */
public type Snippet {
  /** The page the block stands in, as a message shows it */
  path: String
  /** The line of the opening fence in the page */
  line: Int
  /** The line the content of the block starts on */
  contentLine: Int
  kind: SnippetKind
  text: String
  /** What a `trb error` block declares with `// error:` lines, in the order they appear */
  expected: List<String>
  /** What a `trb run` block declares with `// prints` comments: its output, one line per comment */
  expectedOutput: List<String>
  /** The directory of the synthetic package this block becomes, without `snippets/` */
  name: String
  /** The reason of a `trb skip` */
  reason: String
  /** The `status` of the page: a `trb check` block of a `stable` page is held to what the native back end accepts */
  status: String
  /** Whether the page says, with a line that opens with [nativeNote], that the native back end refuses a block of it */
  hasNativeNote: Bool
}

/** The languages a fence may name. A typo in the info string is a problem, not a block nobody checks. */
public const knownLanguages: List<String> = ["trb", "text", "console", "json", "md", "yaml", "diff"]

/** The markers of a `trb` fence. */
public const knownMarkers: List<String> = ["check", "run", "fragment", "error", "skip"]

/** Every snippet of the tree, plus the problems found in an info string along the way. */
public type CollectedSnippets {
  snippets: List<Snippet>
  problems: List<DocumentationProblem>
}

/** Every `trb` block of every page, with the info strings judged. */
public fn collectSnippets(documentation: Documentation): CollectedSnippets {
  var snippets: List<Snippet> = []
  var problems: List<DocumentationProblem> = []
  for page in documentation.pages {
    const shown = page.shown documentation.root
    var index = 0
    for block in page.read.blocks {
      const collected = snippetOf shown, page, block, index
      problems.appendAll collected.problems
      match collected.snippet {
        Some(found) => snippets.append found
        None => {}
      }
      index = index + 1
    }
  }
  CollectedSnippets snippets, problems
}

type CollectedSnippet {
  snippet: Snippet?
  problems: List<DocumentationProblem>
}

fn snippetOf(shown: String, page: Page, block: CodeBlock, index: Int): CollectedSnippet {
  var problems: List<DocumentationProblem> = []
  const languages = knownLanguages.joined separator: ", "
  if block.language.isEmpty() {
    const note = "A fenced block names its language. One of: {languages}"
    return CollectedSnippet None, [DocumentationProblem(shown, block.line, note)]
  }
  if !knownLanguages.contains(block.language) {
    const note = "`{block.language}` is not a language of this documentation. One of: {languages}"
    return CollectedSnippet None, [DocumentationProblem(shown, block.line, note)]
  }
  if block.language != "trb" {
    if !block.marker.isEmpty() {
      const note = "Only a `trb` block takes a marker. `{block.info}` has one"
      problems.append DocumentationProblem(shown, block.line, note)
    }
    return CollectedSnippet None, problems
  }
  if !block.marker.isEmpty() && !knownMarkers.contains(block.marker) {
    const markers = knownMarkers.joined separator: ", "
    const note = "`{block.marker}` is not a marker. One of: {markers}"
    return CollectedSnippet None, [DocumentationProblem(shown, block.line, note)]
  }
  const kind = match block.marker {
    "" => SnippetKind.Program
    "check" => SnippetKind.Checked
    "run" => SnippetKind.Running
    "fragment" => SnippetKind.Fragment
    "error" => SnippetKind.Failing
    _ => SnippetKind.Skipped
  }
  if kind == SnippetKind.Skipped && block.reason.byteLength() < 10 {
    const note = "`trb skip` needs a reason of its own behind it, so that a skip cannot hide"
    problems.append DocumentationProblem(shown, block.line, note)
  }
  if kind != SnippetKind.Skipped && !block.reason.isEmpty() {
    const note = "`{block.info}` says more than a language and a marker"
    problems.append DocumentationProblem(shown, block.line, note)
  }
  const expected = expectedMessages block.text
  if kind == SnippetKind.Failing && expected.isEmpty() {
    const note = "A `trb error` block names the diagnostic it expects in a `// error: <message>` line"
    problems.append DocumentationProblem(shown, block.line, note)
  }
  if kind != SnippetKind.Failing && !expected.isEmpty() {
    const note = "A `// error:` line only means something in a `trb error` block"
    problems.append DocumentationProblem(shown, block.line, note)
  }
  const output = expectedOutputOf block.text
  if kind == SnippetKind.Running && output.isEmpty() {
    const note = "A `trb run` block writes the output it expects as `// prints <line>` comments, one per line"
    problems.append DocumentationProblem(shown, block.line, note)
  }
  if kind != SnippetKind.Running && kind != SnippetKind.Skipped && !output.isEmpty() {
    const note = "A `// prints` comment is compared with the output only in a `trb run` block. Mark the block `trb run`"
    problems.append DocumentationProblem(shown, block.line, note)
  }
  const name = snippetName page.path, index
  const status = page.frontMatter.text("status") ?? "stable"
  const hasNativeNote = page.read.prose.any({ _.text.trim().startsWith(nativeNote) })
  const snippet = Snippet(
    shown,
    block.line,
    block.contentLine,
    kind,
    block.text,
    expected,
    output,
    name,
    block.reason,
    status,
    hasNativeNote,
  )
  CollectedSnippet Some(snippet), problems
}

/**
 * What a `trb error` block expects, written as a comment inside the block. The comment stays in the code - it parses
 * like every other comment - so the block is exactly what a reader copies, and the expectation cannot drift away from
 * the line it belongs to.
 */
fn expectedMessages(text: String): List<String> {
  var found: List<String> = []
  for line in linesOf(text) {
    const trimmed = line.trim()
    if const Some(expected) = trimmed.withoutPrefix("// error:") {
      found.append expected.trim()
    }
  }
  found
}

/**
 * What a `trb run` block expects on its output: one line per `// prints <line>` comment, in the order they appear. The
 * comment stands on a line of its own or behind the statement that prints, which keeps the expectation next to the
 * line it belongs to - the reason a `trb error` block writes its `// error:` into the code as well.
 */
public fn expectedOutputOf(text: String): List<String> {
  var found: List<String> = []
  for line in linesOf(text) {
    const rest = match line.substringAfter("// prints") {
      Some(found) => found
      None => {
        continue
      }
    }
    if rest.trim().isEmpty() {
      found.append ""
      continue
    }
    if rest.startsWith(" ") {
      found.append withoutTrailingSpaces(rest.dropping(characters: 1))
    }
  }
  found
}

/** The text without the spaces and carriage returns at its end, which no reader of an output line can see. */
public fn withoutTrailingSpaces(text: String): String {
  var kept = text
  while kept.endsWith(" ") || kept.endsWith("\r") {
    kept = kept.droppingLast characters: 1
  }
  kept
}

/** The directory of the package one block becomes. A name that is unique and readable in a message. */
fn snippetName(path: String, index: Int): String {
  var characters: List<Char> = []
  for character in path.toLowerCase().chars() {
    if character.isLetter() || character.isDigit() {
      characters.append character
    } else {
      characters.append '-'
    }
  }
  "{String.from(characters)}-{index}"
}

/** The problems of everything that needs no type checker: the info strings, the parser and the canon. */
public fn verifySyntax(snippets: List<Snippet>): List<DocumentationProblem> {
  var problems: List<DocumentationProblem> = []
  for snippet in snippets {
    problems.appendAll syntaxProblemsOf(snippet)
  }
  problems
}

fn syntaxProblemsOf(snippet: Snippet): List<DocumentationProblem> {
  if snippet.kind == SnippetKind.Skipped {
    return []
  }
  const source = SourceText.of snippet.text
  var problems: List<DocumentationProblem> = []
  // A fragment is a signature or a shape, not a file, so only the lexer can say anything about it
  if snippet.kind == SnippetKind.Fragment {
    for diagnostic in lex(source).diagnostics {
      const at = snippet.contentLine + lineOfOffset(snippet.text, diagnostic.span.start) - 1
      problems.append DocumentationProblem(snippet.path, at, diagnostic.message)
    }
    return problems
  }
  const parsed = parse source
  // A `trb error` block is wrong on purpose: its diagnostics are compared with what it declares, not reported
  const isFailing = snippet.kind == SnippetKind.Failing
  for diagnostic in parsed.diagnostics {
    if isFailing {
      continue
    }
    const line = snippet.contentLine + lineOfOffset(snippet.text, diagnostic.span.start) - 1
    problems.append DocumentationProblem(snippet.path, line, diagnostic.message)
  }
  if !parsed.diagnostics.isEmpty() {
    return problems
  }
  // Code that is wrong on purpose is not judged on its style: the block exists for its diagnostic
  if isFailing {
    return problems
  }
  for problem in canonProblems(snippet.text, parsed.file) {
    const line = snippet.contentLine + problem.line - 1
    problems.append DocumentationProblem(snippet.path, line, problem.message)
  }
  problems
}

/** The 1-based line of a byte offset inside a snippet. */
public fn lineOfOffset(text: String, offset: Int): Int {
  var line = 1
  var seen = 0
  for character in text.chars() {
    if seen >= offset {
      break
    }
    if character == '\n' {
      line = line + 1
    }
    seen = seen + character.byteLength()
  }
  line
}

/**
 * One synthetic workspace: the standard library as it is on disk, and one package per block that needs the type
 * checker. The root manifest is written here and not read, so a block is checked against `std/` and against nothing
 * else - not against the compiler, not against the examples.
 *
 * Every block is the entry file of a package of its own, `snippets/<name>/src/main.trb`, which is a member of the
 * workspace exactly the way `examples/<name>` is one of the repository's: it sees `std/` through its imports and not as
 * files of its own package, and it sees no other block.
 */
public fn snippetWorkspace(standardLibrary: Map<String, String>, snippets: List<Snippet>): SourceTree {
  var files: Map<String, String> = [:]
  files.set "project.trb", rootManifest()
  for (path, text) in standardLibrary {
    files.set path, text
  }
  for snippet in snippets {
    if !needsTypeCheck(snippet.kind) {
      continue
    }
    const manifest = "name \"docs/{snippet.name}\"\n"
    files.set "snippets/{snippet.name}/project.trb", manifest
    files.set snippetPath(snippet), snippet.text
  }
  SourceTree.of files
}

fn rootManifest(): String {
  """
    name "docs/snippets"

    workspace \{
      members "std/*", "snippets/*"
    }
    """
}

/** Does this kind of block ask for the type checker? `trb check`, `trb run` and `trb error` do. */
public fn needsTypeCheck(kind: SnippetKind): Bool {
  kind == SnippetKind.Checked || kind == SnippetKind.Running || kind == SnippetKind.Failing
}

/** The file of the synthetic workspace a block becomes. */
public fn snippetPath(snippet: Snippet): String {
  "snippets/{snippet.name}/src/main.trb"
}

/** What one run of the front end over every block found: the problems, and the checked workspace behind them. */
public type TypedSnippets {
  problems: List<DocumentationProblem>
  /** The blocks that were handed to the checker */
  snippets: List<Snippet>
  /** `None` when no block asked for the checker */
  checked: Checked?
}

/**
 * The type problems of every block that asked for the checker, and the expectations of a `trb error` block that did
 * not come true. One run of the front end answers for all of them.
 */
public fn verifyTypes(standardLibrary: Map<String, String>, snippets: List<Snippet>): List<DocumentationProblem> {
  typeCheckSnippets(standardLibrary, snippets, false).problems
}

/**
 * [verifyTypes], keeping the checked workspace for what the native back end is asked next. `checksEveryBody` is what a
 * lowering needs: the body of every function of `std/` that a block can reach, and not only the blocks' own.
 */
public fn typeCheckSnippets(
  standardLibrary: Map<String, String>,
  snippets: List<Snippet>,
  checksEveryBody: Bool,
): TypedSnippets {
  const wanted = snippets.filter({ needsTypeCheck _.kind }).toList()
  if wanted.isEmpty() {
    return TypedSnippets([], wanted, None)
  }
  const tree = snippetWorkspace standardLibrary, wanted
  const checked = check tree, ["snippets"], false, checksEveryBody
  var problems: List<DocumentationProblem> = []
  for problem in checked.problems {
    problems.append DocumentationProblem("<the snippet workspace>", 0, problem)
  }
  for snippet in wanted {
    const path = snippetPath snippet
    var messages: List<String> = []
    for file in checked.files {
      if file.path != path {
        continue
      }
      for diagnostic in file.diagnostics {
        messages.append diagnostic.message
      }
    }
    problems.appendAll snippetTypeProblems(snippet, messages)
  }
  TypedSnippets problems, wanted, Some(checked)
}

fn snippetTypeProblems(snippet: Snippet, messages: List<String>): List<DocumentationProblem> {
  var problems: List<DocumentationProblem> = []
  if snippet.kind != SnippetKind.Failing {
    for message in messages {
      problems.append DocumentationProblem(snippet.path, snippet.line, message)
    }
    return problems
  }
  // A `trb error` block: every expectation has to be met, and it has to be wrong at all
  // The file's diagnostics hold what the parser said already; a parse of its own is what a block that never reached the
  // checker is judged by, and a message is counted once either way
  const parsed = parse SourceText.of(snippet.text)
  var all: List<String> = []
  for message in messages {
    if !all.contains(message) {
      all.append message
    }
  }
  for diagnostic in parsed.diagnostics {
    if !all.contains(diagnostic.message) {
      all.append diagnostic.message
    }
  }
  if all.isEmpty() {
    const note = "This `trb error` block has no diagnostic at all, so it is not the error it claims to be"
    problems.append DocumentationProblem(snippet.path, snippet.line, note)
    return problems
  }
  for expectation in snippet.expected {
    if !all.any({ _.contains expectation }) {
      const said = all.joined separator: " | "
      const note = "No diagnostic of this block contains `{expectation}`. It says: {said}"
      problems.append DocumentationProblem(snippet.path, snippet.line, note)
    }
  }
  // And nothing else may be wrong with it: a block that fails for a second reason teaches a second wrong line, and one
  // whose expected diagnostic went away passes for an incidental reason. A block that means several errors lists each
  for message in all {
    if !snippet.expected.any({ message.contains _ }) {
      const note = "This `trb error` block also says `{message}`, which none of its `// error:` lines expects"
      problems.append DocumentationProblem(snippet.path, snippet.line, note)
    }
  }
  problems
}

/** The files of the standard library, keyed the way the synthetic workspace needs them: `std/<package>/...`. */
public fn readStandardLibrary(path: String): Result<Map<String, String>, IoError> {
  if !File.isDirectory(path) {
    return Fail IoError(path, "There is no standard library here. Name it with --standard-library <path>")
  }
  var files: Map<String, String> = [:]
  readStandardLibraryInto(files, path, "std")?
  Ok files
}

fn readStandardLibraryInto(var files: Map<String, String>, directory: String, relative: String): Result<Void, IoError> {
  for entry in File.list(directory)? {
    const child = "{directory}/{entry}"
    const key = "{relative}/{entry}"
    if File.isDirectory(child) {
      if !entry.startsWith(".") {
        readStandardLibraryInto(files, child, key)?
      }
      continue
    }
    if entry.endsWith(".trb") {
      const text = File.readText(child)?
      files.set key, text
    }
  }
  Ok(void)
}
