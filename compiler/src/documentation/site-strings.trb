/** One language of a build of the site: its code, its folder below the root of the site, and its words. */
public type SiteLanguage {
  /** `en`, `de` */
  code: String
  /** Where its pages are written, relative to the root of the site: empty for English, `de/` for German */
  prefix: String
  /** Every key of [englishStrings], in this language or, where it has none, in English */
  words: Map<String, String>

  /** The text of a key in this language. */
  fn text(key: String): String {
    words.get(key) ?? key
  }

  /** The name of the language in itself: `Deutsch`. */
  fn name(): String {
    text "language"
  }
}

/** The English words by key. */
public fn englishWords(): Map<String, String> {
  var words: Map<String, String> = [:]
  for (key, text) in englishStrings {
    words.set key, text
  }
  words
}

/**
 * Every language of the site, English first and then the others by their code. A language is one whose
 * `translations/<language>/strings.json` is there; a `strings.json` that cannot be read leaves the words English, and
 * `docs check` says why.
 */
public fn siteLanguagesOf(documentation: Documentation): List<SiteLanguage> {
  const english = englishWords()
  var languages = [SiteLanguage(sourceLanguage, "", english)]
  var codes = documentation.strings.keys().toList()
  codes.sort({ _ })
  for code in codes {
    var words = english
    const read = stringsOf(documentation.strings.get(code) ?? "")
    for (key, text) in read.words {
      if english.containsKey(key) {
        words.set key, text
      }
    }
    languages.append SiteLanguage(code, "{code}/", words)
  }
  languages
}

/** What a `strings.json` holds, and what is wrong with it. */
public type ReadStrings {
  words: Map<String, String>
  problems: List<String>
}

/** The words of a `strings.json`: a flat object of texts. */
public fn stringsOf(text: String): ReadStrings {
  const parsed = match Json().parse(text) {
    Ok(value) => value
    Fail(error) => {
      return ReadStrings([:], ["It is not JSON: {error}"])
    }
  }
  const entries = match parsed {
    .Object(entries) => entries
    _ => {
      return ReadStrings([:], ["It is one JSON object of texts, by key"])
    }
  }
  var words: Map<String, String> = [:]
  var problems: List<String> = []
  const english = englishWords()
  var keys = entries.keys().toList()
  keys.sort({ _ })
  for key in keys {
    match entries.get(key) {
      Some(.String(value)) => {
        if !english.containsKey(key) {
          problems.append "`{key}` is no key of the interface. The keys are the ones of `englishStrings` in site-strings.trb"
        }
        words.set key, value
      }
      _ => problems.append "The value of `{key}` is a text"
    }
  }
  if !words.containsKey("language") {
    problems.append "It names the language in itself, as `language`: \"Deutsch\""
  }
  ReadStrings words, problems
}

/** What `docs check` says about every `strings.json`, and about a language that has pages but none. */
public fn stringsProblems(documentation: Documentation): List<DocumentationProblem> {
  var problems: List<DocumentationProblem> = []
  for (code, text) in documentation.strings {
    const shown = "{documentation.root}/{translationsFolder}/{code}/strings.json"
    for problem in stringsOf(text).problems {
      problems.append DocumentationProblem(shown, 0, problem)
    }
  }
  var reported: Set<String> = []
  for translation in documentation.translations {
    if documentation.strings.containsKey(translation.language) || reported.contains(translation.language) {
      continue
    }
    reported.insert translation.language
    const shown = "{documentation.root}/{translationsFolder}/{translation.language}"
    const note = "A language of the site has the words of its interface in `strings.json`, and this one has none"
    problems.append DocumentationProblem(shown, 0, note)
  }
  problems
}

/**
 * A text with its placeholders filled: every `{name}` of `values` replaced by its value.
 *
 * # Examples
 *
 *     print filled("Lesson \{number\} of \{total\}", [(name: "number", value: "3"), (name: "total", value: "13")])
 */
public fn filled(text: String, values: List<(name: String, value: String)>): String {
  var result = text
  for (name, value) in values {
    result = result.replace "\{{name}}", value
  }
  result
}
