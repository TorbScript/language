/**
 * The words of the site's own interface - the navigation, the buttons, the notices, the search, the labels of the
 * playground - in English, and the languages the site is written in besides (docs/tooling/torb-docs-site.md,
 * "Languages"). English is the table below; every other language is `translations/<language>/strings.json` of the
 * documentation, a flat JSON object with some of the same keys, and a key it leaves out is said in English.
 *
 * A text may hold a placeholder in braces, `{number}`, which [filled] replaces.
 *
 * # Related
 *
 * - [SiteLanguage] - one language of a build, with its words.
 */

use Json, JsonValue from "std/json"
use DocumentationProblem from "./markdown"
use Documentation, translationsFolder from "./tree"

/** The language every page is written in first, and the one at the root of the site. */
public const sourceLanguage = "en"

