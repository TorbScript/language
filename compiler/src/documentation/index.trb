/**
 * `torb docs index`: the body of an `index.md` between the two marker comments, generated from the `title`, the
 * `summary` and the `order` of its children. Nobody maintains a list of links by hand, so an index can never be
 * stale, and an agent navigates index to summary to page while loading almost nothing.
 *
 * Everything above the first marker is the author's: the front matter and an introduction that says what belongs in
 * the folder. Below the closing marker nothing is allowed, so that the generated part is always the end of the file
 * and a diff of it is one block.
 *
 * # Related
 *
 * - [writeIndexes] - writes every index whose body changed.
 * - [staleIndexes] - what `docs index --check` reports instead of writing.
 */

use File, IoError from "std/fs"
use normalizePath from "../project/path"
use DocumentationProblem, linesOf from "./markdown"
use Page, Folder, Documentation, joinDocumentationPath, fileName from "./tree"
use indexBegin, indexEnd from "./schema"

/** What `docs index` would write for one index page. */
public type GeneratedIndex {
  page: Page
  text: String
}

/** Every index of the tree, generated, with the problems found along the way. */
public type IndexResult {
  generated: List<GeneratedIndex>
  problems: List<DocumentationProblem>
}

/** The whole documentation, with the body of every index as it has to look. */
public fn generateIndexes(documentation: Documentation): IndexResult {
  var generated: List<GeneratedIndex> = []
  var problems: List<DocumentationProblem> = []
  for folder in documentation.folders {
    match folder.index {
      Some(page) => {
        const written = indexTextOf documentation, folder, page
        problems.appendAll written.problems
        generated.append GeneratedIndex(page, written.text)
      }
      None => {}
    }
  }
  IndexResult generated, problems
}

type WrittenIndex {
  text: String
  problems: List<DocumentationProblem>
}

fn indexTextOf(documentation: Documentation, folder: Folder, page: Page): WrittenIndex {
  const shown = page.shown documentation.root
  const lines = linesOf page.text
  var problems: List<DocumentationProblem> = []
  var beginAt = -1
  var endAt = -1
  var index = 0
  while index < lines.length() {
    const trimmed = lines[index].trim()
    if trimmed == indexBegin && beginAt < 0 {
      beginAt = index
    }
    if trimmed == indexEnd && beginAt >= 0 && endAt < 0 {
      endAt = index
    }
    index = index + 1
  }
  var head: List<String> = []
  if beginAt < 0 {
    const note = "The generated part of an index stands between `{indexBegin}` and `{indexEnd}`. Run `torb docs index`"
    problems.append DocumentationProblem(shown, 1, note)
    head = lines
  } else {
    if endAt < 0 {
      const note = "The generated part of this index is never closed by `{indexEnd}`"
      problems.append DocumentationProblem(shown, beginAt + 1, note)
    }
    var line = 0
    while line < beginAt {
      head.append lines[line]
      line = line + 1
    }
    if endAt >= 0 {
      var after = endAt + 1
      while after < lines.length() {
        if !lines[after].trim().isEmpty() {
          const note = "Nothing stands below the generated part of an index"
          problems.append DocumentationProblem(shown, after + 1, note)
          break
        }
        after = after + 1
      }
    }
  }
  while !head.isEmpty() && head[head.length() - 1].trim().isEmpty() {
    head.removeAt(head.length() - 1)
  }
  var body = head
  if !body.isEmpty() {
    body.append ""
  }
  body.append indexBegin
  body.appendAll entriesOf(documentation, folder, page)
  body.append indexEnd
  const text = body.joined separator: "\n"
  WrittenIndex "{text}\n", problems
}

/** A value gets quotes exactly where the subset of the front matter needs them. */
public fn quotedIfNeeded(value: String): String {
  const indicators = ["-", "?", ":", ",", "[", "]", "{", "}", "#", "&", "*", "!", "|", ">", "'", "\"", "%", "@", "`"]
  const startsBadly = indicators.any({ indicator => value.startsWith indicator })
  if startsBadly || value.contains(": ") {
    const escaped = value.replace("\\", "\\\\").replace("\"", "\\\"")
    return "\"{escaped}\""
  }
  value
}

/** The generated lines: the subfolders, then the pages, then the design documents the index names. */
fn entriesOf(documentation: Documentation, folder: Folder, page: Page): List<String> {
  var lines: List<String> = []
  const sections = sortedChildren documentation, folder
  if !sections.isEmpty() {
    lines.append ""
    lines.append "## Sections"
    lines.append ""
    for child in sections {
      lines.append entryOf(child, indexLinkOf(folder, child))
    }
  }
  const pages = sortedPages folder
  if !pages.isEmpty() {
    lines.append ""
    lines.append "## Pages"
    lines.append ""
    for child in pages {
      lines.append entryOf(child, fileName(child.path))
    }
  }
  const documents = page.frontMatter.items "documents"
  if !documents.isEmpty() {
    lines.append ""
    lines.append "## Design documents"
    lines.append ""
    for document in documents {
      const resolved = normalizePath joinDocumentationPath(folder.path, document)
      const title = documentation.plainTitles.get(resolved) ?? fileName(document)
      lines.append "- **[{title}]({document})**"
    }
  }
  lines.append ""
  lines
}

fn indexLinkOf(folder: Folder, child: Page): String {
  const name = childFolderName folder.path, child.folder
  "{name}/index.md"
}

fn childFolderName(parent: String, child: String): String {
  if parent.isEmpty() {
    return child
  }
  child.withoutPrefix("{parent}/") ?? child
}

fn entryOf(child: Page, target: String): String {
  const title = child.frontMatter.text("title") ?? ""
  const summary = child.frontMatter.text("summary") ?? ""
  const status = child.frontMatter.text("status") ?? "stable"
  const mark = match status {
    "planned" => " _(planned)_"
    "draft" => " _(draft)_"
    _ => ""
  }
  "- **[{title}]({target})**{mark} - {summary}"
}

/** The indexes of the folders directly below this one, in the order they are shown. */
fn sortedChildren(documentation: Documentation, folder: Folder): List<Page> {
  var found: List<Page> = []
  for child in folder.folders {
    match documentation.indexOf(child) {
      Some(index) => found.append index
      None => {}
    }
  }
  sortedByOrder found
}

fn sortedPages(folder: Folder): List<Page> {
  sortedByOrder folder.pages
}

/** By `order` where there is one, then by title. A page without an `order` follows every page that has one. */
fn sortedByOrder(pages: List<Page>): List<Page> {
  var sorted = pages
  sorted.sort({ (_.frontMatter.number("order") ?? 1_000_000, _.frontMatter.text("title") ?? "") })
  sorted
}

/** Writes every index whose body is not what it has to be. Returns the paths that changed. */
public fn writeIndexes(documentation: Documentation, result: IndexResult): Result<List<String>, IoError> {
  var written: List<String> = []
  for generated in result.generated {
    if generated.page.text == generated.text {
      continue
    }
    const path = "{documentation.root}/{generated.page.path}"
    File.writeText(path, generated.text)?
    written.append generated.page.path
  }
  Ok written
}

/** What `docs index --check` reports: every index whose generated part is not what it would be. */
public fn staleIndexes(documentation: Documentation, result: IndexResult): List<DocumentationProblem> {
  var problems: List<DocumentationProblem> = []
  for generated in result.generated {
    if generated.page.text == generated.text {
      continue
    }
    const shown = generated.page.shown documentation.root
    const note = "The generated part of this index is not up to date. Run `torb docs index`"
    problems.append DocumentationProblem(shown, 1, note)
  }
  problems
}
