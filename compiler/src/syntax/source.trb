/**
 * The text of a source file as the lexer and every diagnostic see it: [Span], a byte range into it, [SourceText], and
 * [LineIndex], which translates bytes to line/column positions.
 */

/** A range of bytes in a source file. */
public type Span {
  start: Int
  end: Int

  /** The span that covers both. */
  fn to(other: Span): Span {
    Span start.min(other.start), end.max(other.end)
  }
}

/**
 * The text of a file as the lexer reads it. Positions everywhere are byte offsets - inside of the lexer as in a span -
 * and a character is decoded where one is looked at (`String.charAtByte`), so preparing a file costs nothing: a
 * decoded copy of every character, and the offset of each, were once a quarter of lexing.
 */
public type SourceText {
  text: String

  static fn of(text: String): Self {
    Self text
  }

  /** The text between two byte offsets, each at the start of a character or at the end. */
  fn slice(start: Int, end: Int): String {
    text.sliceBytes start, end
  }
}

/** Translates byte offsets to lines and columns. Both start at 1, columns count characters. */
public type LineIndex {
  private text: String
  private lineStarts: List<Int>

  static fn of(text: String): Self {
    var lineStarts = [0]
    const length = text.byteLength()
    var offset = 0
    // A line break is one byte, and no byte of another character is one: the breaks are searched for as bytes
    while const Some(found) = text.sliceBytes(offset, length).byteOffsetOf("\n") {
      offset = offset + found + 1
      lineStarts.append offset
    }
    Self text, lineStarts
  }

  fn lineAndColumn(offset: Int): (line: Int, column: Int) {
    const target = offset.min text.byteLength()
    // The last line that starts at or before the offset
    var low = 0
    var high = lineStarts.length()
    while low + 1 < high {
      const middle = (low + high) / 2
      if lineStarts[middle] <= target {
        low = middle
      } else {
        high = middle
      }
    }
    const column = text.sliceBytes(lineStarts[low], target).chars().count()
    (line: low + 1, column: column + 1)
  }

  /** The text of a line (starting at 1), without its line break. */
  fn lineText(line: Int): String {
    const start = lineStarts[line - 1]
    const end = lineStarts.get(line) ?? text.byteLength()
    var result = text.sliceBytes start, end
    while result.endsWith("\n") || result.endsWith("\r") {
      result = result.droppingLast characters: 1
    }
    result
  }
}
