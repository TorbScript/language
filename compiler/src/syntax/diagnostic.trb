/**
 * [Diagnostic]: one problem found in the source, as data rather than as printed text.
 *
 * Every pass of the compiler - lexer, parser, checker - reports its findings this way, so rendering (the command
 * line, a language server) is one piece of code instead of one per pass.
 */

use Span from "./source"

/** A problem in the source. Rendering is up to the consumer (command line, language server). */
public type Diagnostic {
  message: String
  span: Span
  notes: List<String> = []
  severity: Severity = Severity.Error

  static fn error(message: String, span: Span): Self {
    Self message, span
  }

  /** A problem that is printed and builds anyway: the use of a deprecated declaration. */
  static fn warning(message: String, span: Span): Self {
    Self message, span, severity: Severity.Warning
  }

  fn withNote(note: String): Self {
    copy notes: notes.appended(note)
  }
}

/**
 * How bad a [Diagnostic] is. An error is why nothing is built; a warning is printed next to the errors, in a list of
 * its own (`CheckedFile.warnings`), and a program that has only warnings builds and runs.
 */
public type Severity {
  case Error
  case Warning

  /** The word a rendered diagnostic starts with: `error`, `warning`. */
  fn word(): String {
    match self {
      .Error => "error"
      .Warning => "warning"
    }
  }
}

/**
 * A problem of the `String` reading of one string literal: an escape sequence a `String` does not have (`"\d"`), or an
 * interpolation that does not parse (`"{2,4}"`). Where the literal is read verbatim - where a `Regex` or a
 * `UriTemplate` is expected, whose braces and backslashes are their own grammar (docs/design/URI.md section 9) - it is
 * no problem at all. Only the checker knows which reading a literal gets, so the lexer and the parser keep these apart
 * and the checker reports every one whose literal it did not read verbatim.
 */
public type DeferredDiagnostic {
  /** The whole literal, quotes included: the span the checker records a verbatim reading at. */
  literal: Span
  diagnostic: Diagnostic
}
