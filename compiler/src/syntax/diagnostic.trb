use Span from "./source"

/** A problem in the source. Rendering is up to the consumer (command line, language server). */
public type Diagnostic {
  message: String
  span: Span
  notes: List<String> = []

  fn error(message: String, span: Span): Diagnostic {
    Diagnostic message, span
  }

  fn withNote(self, note: String): Diagnostic {
    copy notes: notes.added(note)
  }
}
