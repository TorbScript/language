/**
 * Source text to tokens: [lex] and [Lexed]. The lexer never fails - what it does not understand becomes a
 * diagnostic and is skipped - and it resolves the one context rule that lives below the parser: which line breaks
 * end a statement ([Lexer.push]) and which `.` inside of a `match` starts an arm.
 *
 * It is a hand-written scanner over the bytes of `SourceText.text`, kept a character behind a Pratt parser's needs: no
 * lookahead table, just `peek`/`peekAt` and a byte offset that only moves forward. A character is decoded where the
 * scanner looks at one, and a comment, which it only skips, is searched for as bytes. `compiler/tests/lexer.test.trb`
 * pins it token for token; it was verified against the lexer of stage 0 until stage 0 was deleted.
 */

use concatenated from "std/iteration"
use Span, SourceText from "./source"
use Diagnostic, DeferredDiagnostic from "./diagnostic"
use Token, TokenKind, TextPart, Keyword, DocComment from "./token"

/**
 * Source text to tokens. The lexer never fails: what it does not understand becomes a diagnostic and is skipped.
 */
public type Lexed {
  /** Every token that means something, ending with `EndOfFile`: a line break only where it ends a statement. */
  tokens: ArrayList<Token>
  docs: List<DocComment>
  diagnostics: List<Diagnostic>
  /** The problems of the `String` reading of the string literals, which the checker reports or drops. */
  deferred: List<DeferredDiagnostic> = []
}

/** Lexes a whole file, from its first character to its last. */
public fn lex(source: SourceText): Lexed {
  lexRange source, Span(0, source.text.byteLength())
}

/** Lexes a part of a file (the expressions inside of string literals). Spans stay relative to the file. */
public fn lexRange(source: SourceText, range: Span): Lexed {
  var lexer = Lexer.over source, range
  lexer.run()
  Lexed lexer.tokens, lexer.docs, lexer.diagnostics, lexer.deferred
}

/**
 * The verbatim reading of the string literal at `literal`: the characters between its quotes exactly as they were
 * written, with no escape sequence and no interpolation read. It is what a literal is where a `Regex` or a
 * `UriTemplate` is expected, whose braces and backslashes are their own grammar (docs/design/URI.md section 9). A
 * multi-line literal loses its indentation exactly as its `String` reading does.
 */
public fn writtenTextOf(source: SourceText, literal: Span): String {
  var lexer = Lexer.over source, literal, keepsWritten: true
  lexer.readWritten()
  concatenated lexer.written, ""
}

fn isAsciiDigit(character: Char): Bool {
  character >= '0' && character <= '9'
}

fn isHexDigit(character: Char): Bool {
  isAsciiDigit(character) || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
}

fn isWordStart(character: Char): Bool {
  character == '_' || character.isLetter()
}

fn isWordPart(character: Char): Bool {
  character == '_' || character.isLetter() || character.isDigit()
}

fn isAsciiLetter(character: Char): Bool {
  (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')
}

/** The text of a doc comment: without the comment markers and the star in front of every line. */
fn docText(comment: String): String {
  const inner = comment.dropping(characters: 3).droppingLast(characters: 2)
  const lines = inner.split("\n").map(stripMargin).toList()
  lines.joined(separator: "\n").trim()
}

fn stripMargin(line: String): String {
  var text = line
  while text.endsWith("\r") {
    text = text.droppingLast characters: 1
  }
  var offset = 0
  for character in text.chars() {
    if !character.isWhitespace() {
      break
    }
    offset = offset + character.byteLength()
  }
  const rest = text.sliceBytes offset, text.byteLength()
  if !rest.startsWith("*") {
    return text
  }
  rest.withoutPrefix("* ") ?? rest.dropping(characters: 1)
}

/**
 * The first line break of a run, held back until the token after the run says whether it ends a statement: what can
 * be told before that token is known, and the break itself.
 */
type HeldLineBreak {
  token: Token
  /**
   * Neither inside of `(` or `[`, nor after a token that needs a right side: the break ends a statement, unless the
   * token after the run continues the line
   */
  ending: Bool
  /** Whether the innermost bracket is the body of a `match`, where a line that starts with `.` is an arm */
  insideMatch: Bool
}

type Lexer {
  source: SourceText
  /** `source.text`, which every look at a character reads */
  text: String
  /** A byte offset into `text`, always at the start of a character */
  var position: Int
  end: Int
  var tokens: ArrayList<Token>
  var docs: List<DocComment> = []
  var diagnostics: List<Diagnostic> = []
  /** The problems of the `String` reading of every string literal, which the checker reports or drops. */
  var deferred: List<DeferredDiagnostic> = []
  /** Whether a string literal is being read, whose problems of its `String` reading go to [Lexer.pending]. */
  var isReadingText: Bool = false
  /** The problems of the `String` reading of the literal that is being read, until its span is known. */
  var pending: List<Diagnostic> = []
  /** Whether the verbatim reading of a literal is kept: only [writtenTextOf] asks for it. */
  keepsWritten: Bool = false
  /** The literal that is being read, as it was written, in the pieces between the indentation it loses. */
  var written: List<String> = []
  /**
   * The brackets that are open, innermost last, each with whether it is the body of a `match` (see
   * [Lexer.decideLineBreak]).
   */
  var brackets: List<(TokenKind, Bool)> = []
  /** The depth of the brackets where the `{` that follows is the body of a `match`. */
  var pendingMatch: Int? = None
  /** The depth of the `match` that was just pushed, until the token after it says whether it is a label. */
  var undecidedMatch: Int? = None
  /** The first line break of the run that is being lexed. */
  var heldLineBreak: HeldLineBreak? = None
  /** Whether the token lexed last, a line break among them, is a `.`: `tuple.0.1` is no float. */
  var followsDot: Bool = false

  static fn over(source: SourceText, range: Span, keepsWritten: Bool = false): Self {
    Self(
      source,
      source.text,
      position: range.start,
      end: range.end,
      tokens: ArrayList.withCapacity(0),
      keepsWritten: keepsWritten,
    )
  }

  var fn run() {
    // A byte order mark in front of the first character is how some editors on Windows save UTF-8: it is no text
    if position == 0 && peek() == '\u{FEFF}' {
      position = '\u{FEFF}'.byteLength()
    }
    while const Some(character) = peek() {
      const start = position
      match character {
        '\n' => {
          position = position + 1
          push TokenKind.Newline, start
        }
        _ if character.isWhitespace() => {
          position = position + character.byteLength()
        }
        '/' if peekAt(1) == '/' => skipLineComment()
        '/' if peekAt(1) == '*' => skipBlockComment()
        '"' => textLiteral start, raw: false
        // `raw` is contextual: it is the prefix only directly in front of `"`, an ordinary name everywhere else, so
        // `const raw = 1` still declares one.
        'r' if isAt("raw\"") => {
          position = position + 3
          textLiteral start, raw: true
        }
        // The one-letter prefix this replaced (docs/RUST-EXIT.md 4.2, "the two-commit rename"): still lexed as a raw
        // string, so the rest of the file reports nothing else about it, but with the one diagnostic that says what
        // to write instead.
        'r' if peekAt(1) == '"' => {
          errorWithNote(
            "`r\"...\"` is written `raw\"...\"`",
            "The one-letter prefix was retired: `raw` is the prefix everywhere a raw string starts",
            start,
          )
          position = position + 1
          textLiteral start, raw: true
        }
        '\'' => characterLiteral start
        _ if isAsciiDigit(character) => number start
        _ if isWordStart(character) => word start
        _ => punctuation start, character
      }
    }
    const last = end
    push TokenKind.EndOfFile, last
  }

  fn peek(): Char? {
    if position < end {
      text.charAtByte position
    } else {
      None
    }
  }

  /**
   * The character `offset` bytes ahead. Every caller looks past characters it already knows to be ASCII, one byte each,
   * so the offset is the start of a character.
   */
  fn peekAt(offset: Int): Char? {
    const index = position + offset
    if index < end {
      text.charAtByte index
    } else {
      None
    }
  }

  /** Does the rest of the input start with this text? */
  fn isAt(expected: String): Bool {
    textStartsAt position, expected
  }

  /** Does the input starting at `offset` start with this text? */
  fn textStartsAt(offset: Int, expected: String): Bool {
    offset <= end && text.sliceBytes(offset, end).startsWith(expected)
  }

  /** The byte offset of the next `part` at or after `from` and before the end of the input. */
  fn offsetOf(part: String, from: Int): Int? {
    const found = text.sliceBytes(from, end).byteOffsetOf(part)?
    from + found
  }

  /** The span from a byte offset to the current position. */
  fn spanFrom(start: Int): Span {
    Span start, position
  }

  /** The span of a problem that starts at `start`: up to the position, and at least the character at `start`. */
  fn problemSpan(start: Int): Span {
    const length = text.byteLength()
    if position > start {
      return Span start, position.min(length)
    }
    const width = text.charAtByte(start)?.byteLength() ?? 1
    Span start, (start + width).min(length)
  }

  /**
   * Appends a token, and decides the line breaks: one only ends a statement if it is not inside of `(` or `[`, not
   * after a token that needs a right side, and not before a token that needs a left side. The first break of a run
   * waits for the token after the run, which is the last thing it depends on ([HeldLineBreak]).
   */
  var fn push(kind: TokenKind, start: Int) {
    const token = Token kind, spanFrom(start)
    followsDot = match kind {
      .Dot => true
      _ => false
    }
    // `text.match(...)` and `match: value` are names: the token right after a `match` says which
    if const Some(depth) = undecidedMatch {
      undecidedMatch = None
      if kind != TokenKind.Colon {
        pendingMatch = depth
      }
    }
    if const .Newline = kind {
      if heldLineBreak.isNone() {
        heldLineBreak = holdLineBreak token
      }
      return
    }
    decideLineBreak kind
    match kind {
      .Reserved(.Match) => {
        const isAfterMember = tokens.last()?.kind == TokenKind.Dot || tokens.last()?.kind == TokenKind.QuestionDot
        if !isAfterMember {
          undecidedMatch = brackets.length()
        }
      }
      .BraceOpen => {
        const isMatchBody = pendingMatch == brackets.length()
        if isMatchBody {
          pendingMatch = None
        }
        brackets.append((kind, isMatchBody))
      }
      .ParenOpen | .BracketOpen => brackets.append((kind, false))
      .ParenClose | .BracketClose | .BraceClose => {
        const last = brackets.length() - 1
        const _ = brackets.removeAt last
      }
      _ => {}
    }
    tokens.append token
  }

  /** What the first line break of a run can tell before the token after the run is known. */
  fn holdLineBreak(token: Token): HeldLineBreak {
    const (innermost, isMatchBody) = brackets.last() ?? (TokenKind.BraceOpen, false)
    const isInsideBrackets = innermost == TokenKind.ParenOpen || innermost == TokenKind.BracketOpen
    const isAfter = match tokens.last() {
      Some(previous) => previous.kind.continuesLineAfter() || previous.kind == TokenKind.Newline
      None => true
    }
    HeldLineBreak(token, ending: !(isInsideBrackets || isAfter), insideMatch: isMatchBody)
  }

  /** The token after a run of line breaks is `next`: the first break of the run ends a statement, or it goes. */
  var fn decideLineBreak(next: TokenKind) {
    const held = match heldLineBreak {
      Some(found) => found
      None => {
        return
      }
    }
    heldLineBreak = None
    const startsArm = held.insideMatch && next == TokenKind.Dot
    const isBefore = next.continuesLineBefore() && !startsArm
    if held.ending && !isBefore {
      tokens.append held.token
    }
  }

  var fn error(message: String, start: Int) {
    diagnostics.append Diagnostic.error(message, problemSpan(start))
  }

  var fn errorWithNote(message: String, note: String, start: Int) {
    const problem = Diagnostic.error message, problemSpan(start)
    diagnostics.append problem.withNote(note)
  }

  /** Up to the line break, which ends the comment and stays for the statement. */
  var fn skipLineComment() {
    position = offsetOf("\n", from: position) ?? end
  }

  /** Block comments do not nest: the first star-slash ends the comment. */
  var fn skipBlockComment() {
    const start = position
    match offsetOf("*/", from: position + 2) {
      Some(close) => {
        position = close + 2
        const comment = source.slice start, position
        if comment.startsWith("/**") && comment.byteLength() > 4 {
          docs.append DocComment(docText(comment), spanFrom(start))
        }
      }
      None => {
        position = end
        error "This comment is never closed", start
      }
    }
  }

  /**
   * A name is ASCII: `[A-Za-z_][A-Za-z0-9_]*`. The whole run of word characters is still read, so that a name with
   * letters from another script in it is **one** diagnostic and not one per character, and the token stays an
   * `Identifier` so that nothing else is reported about the line it stands in.
   */
  var fn word(start: Int) {
    var isAscii = true
    while const Some(character) = peek() {
      if !isWordPart(character) {
        break
      }
      if !isAsciiLetter(character) && !isAsciiDigit(character) && character != '_' {
        isAscii = false
      }
      position = position + character.byteLength()
    }
    if !isAscii {
      errorWithNote(
        "A name is written in ASCII letters, digits and `_`",
        "Text is not: a string, a character literal and a comment may contain anything",
        start,
      )
    }
    const kind = match Keyword.fromText(source.slice(start, position)) {
      Some(keyword) => TokenKind.Reserved keyword
      None => TokenKind.Identifier
    }
    push kind, start
  }

  var fn number(start: Int) {
    const isAfterMember = followsDot
    if isAt("0x") || isAt("0b") {
      position = position + 2
      digits isHexDigit
      push TokenKind.IntegerLiteral, start
      return
    }
    digits isAsciiDigit
    var kind = TokenKind.IntegerLiteral
    // `tuple.0.1` and `1..5` are not floats, `16.megabytes()` is a call on an integer
    const hasFraction = !isAfterMember && peek() == '.' && (peekAt(1).map(isAsciiDigit) ?? false)
    if hasFraction {
      position = position + 1
      digits isAsciiDigit
      kind = TokenKind.FloatLiteral
    }
    if !isAfterMember && (peek() == 'e' || peek() == 'E') {
      const sign = if peekAt(1) == '+' || peekAt(1) == '-' { 1 } else { 0 }
      if peekAt(1 + sign).map(isAsciiDigit) ?? false {
        position = position + 1 + sign
        digits isAsciiDigit
        kind = TokenKind.FloatLiteral
      }
    }
    push kind, start
  }

  var fn digits(accepts: (Char) => Bool) {
    while const Some(character) = peek() {
      if character != '_' && !accepts(character) {
        break
      }
      position = position + 1
    }
  }

  var fn characterLiteral(start: Int) {
    position = position + 1
    const value = match peek() {
      Some('\\') => {
        position = position + 1
        escape()
      }
      Some(character) if character != '\'' && character != '\n' => {
        position = position + character.byteLength()
        Some character
      }
      _ => None
    }
    if peek() != '\'' {
      error "A character literal contains exactly one character and ends with `'`", start
      // `'ab'`: the literal ends at the next quote of the line and stands for its first character from there on, so the
      // rest of it is not read as a name and a second literal
      if const Some(first) = value {
        if skipToQuote() {
          push TokenKind.CharLiteral(first), start
        }
      }
      return
    }
    position = position + 1
    match value {
      Some(value) => push TokenKind.CharLiteral(value), start
      None => error "This character literal is empty", start
    }
  }

  /** Moves past the next `'` of the line, where there is one: the end of a character literal that holds too much. */
  var fn skipToQuote(): Bool {
    const quote = match offsetOf("'", from: position) {
      Some(found) => found
      None => {
        return false
      }
    }
    if const Some(lineBreak) = offsetOf("\n", from: position) {
      if lineBreak < quote {
        return false
      }
    }
    position = quote + 1
    true
  }

  /** Reads what follows a `\`. */
  var fn escape(): Char? {
    const start = position - 1
    const character = peek()?
    position = position + character.byteLength()
    const result = match character {
      'n' => '\n'
      'r' => '\r'
      't' => '\t'
      '0' => '\0'
      '\\' | '"' | '\'' | '{' | '}' => character
      'u' if peek() == '{' => unicodeEscape(start)?
      _ => {
        textError "Unknown escape sequence `\\{character}`", start
        character
      }
    }
    result
  }

  /**
   * A problem of the `String` reading of a string literal, which a verbatim reading does not have: it waits for the
   * checker, which knows which reading the literal gets. Inside a character literal it is an ordinary error.
   */
  var fn textError(message: String, start: Int) {
    if !isReadingText {
      error message, start
      return
    }
    pending.append Diagnostic.error(message, problemSpan(start))
  }

  /** `\u{1F44B}`. The position is at the `{`. `None` if the `}` is missing. */
  var fn unicodeEscape(start: Int): Char? {
    const close = match offsetOf("}", from: position) {
      Some(found) => found
      None => {
        return None
      }
    }
    const hexDigits = source.slice(position + 1, close)
    position = close + 1
    const code = Int.parseDigits(hexDigits, radix: 16).ok().flatMap({ Char.tryFrom(_).ok() })
    match code {
      Some(code) => code
      None => {
        textError "This is not a Unicode scalar value", start
        '\u{FFFD}'
      }
    }
  }

  /**
   * `"..."`, `"""..."""`, and their raw variants `raw"..."`, `raw"""..."""` (the older spelling `r"..."` is an error
   * that names this one). The position is at the first quote.
   *
   * The `String` reading is kept in pieces: a run of characters that stand for themselves is a slice of the source,
   * and only an escape sequence, an interpolation and the indentation a multi-line literal loses end one.
   */
  var fn textLiteral(start: Int, raw: Bool) {
    // An escape sequence a `String` does not have and an interpolation that does not parse are problems of the
    // `String` reading only, and the checker decides which reading this literal gets (`DeferredDiagnostic`)
    isReadingText = !raw
    pending = []
    written = []
    const quotes = if isAt("\"\"\"") { "\"\"\"" } else { "\"" }
    const isTripleQuoted = quotes != "\""
    position = position + quotes.byteLength()
    // A triple-quoted string is dedented (see `dedentLine`) only if it really spans more than one line: a
    // one-line `"""text"""` is left exactly as written.
    const isMultiLine = isTripleQuoted && hasMultipleLines(raw)
    if isMultiLine {
      skipLeadingLineBreak()
    }
    var parts: List<TextPart> = []
    var literal: List<String> = []
    // Where the run of characters that stand for themselves began, in the `String` reading and in the verbatim one
    var literalFrom = position
    var writtenFrom = position
    var reference: String? = None
    var atLineStart = isMultiLine
    loop {
      const character = match peek() {
        Some(character) => character
        None => {
          error "This string is never closed", start
          keepPiece literal, literalFrom, position
          keepWritten writtenFrom, position
          pushUnclosed parts, literal, start
          return
        }
      }
      // Once per character of every string: the quote is compared before the text is
      if character == '"' && isAt(quotes) {
        keepPiece literal, literalFrom, position
        keepWritten writtenFrom, position
        position = position + quotes.byteLength()
        break
      }
      if character == '\n' && !isTripleQuoted {
        error "This string is never closed. Multi-line strings use `\"\"\"`", start
        keepPiece literal, literalFrom, position
        keepWritten writtenFrom, position
        pushUnclosed parts, literal, start
        return
      }
      if atLineStart {
        atLineStart = false
        keepPiece literal, literalFrom, position
        keepWritten writtenFrom, position
        dedentLine reference
        literalFrom = position
        writtenFrom = position
        continue
      }
      // Whatever this character starts - an escape sequence, an interpolation - goes into the verbatim reading exactly
      // as it was written
      const first = position
      position = position + character.byteLength()
      if character == '\\' && !raw {
        keepPiece literal, literalFrom, first
        if const Some(escaped) = escape() {
          literal.append escaped.show()
        }
        literalFrom = position
      } else if character == '{' && !raw {
        keepPiece literal, literalFrom, first
        const expressionStart = position
        if !skipInterpolation() {
          error "This `\{` inside of a string is never closed. A literal brace is written `\\\{`", start
          keepWritten writtenFrom, first
          // The line break that ended the search still ends the statement
          if position > 0 && text.byteAt(position - 1) == 10 {
            position = position - 1
          }
          pushUnclosed parts, literal, start
          return
        }
        if literal.isNotEmpty() {
          parts.append TextPart.Literal(concatenated(literal, ""))
          literal = []
        }
        parts.append TextPart.Expression(Span(expressionStart, position - 1))
        literalFrom = position
      } else if character == '\n' && isMultiLine {
        atLineStart = true
      }
    }
    if literal.isNotEmpty() || parts.isEmpty() {
      parts.append TextPart.Literal(concatenated(literal, ""))
    }
    push TokenKind.TextLiteral(parts), start
    finishText start, isClosed: true
  }

  /** Adds the characters from `from` to `to` to the `String` reading of a literal, where there are any. */
  fn keepPiece(var literal: List<String>, from: Int, to: Int) {
    if to > from {
      literal.append text.sliceBytes(from, to)
    }
  }

  /** Adds the characters from `from` to `to` to the verbatim reading of a literal, where it is kept. */
  var fn keepWritten(from: Int, to: Int) {
    if keepsWritten && to > from {
      written.append text.sliceBytes(from, to)
    }
  }

  /**
   * A string that was never closed is still a string, as far as it was read: the statement it stands in stays what it
   * was - `print "total: {value` is a call of `print` and not a function nobody called.
   */
  var fn pushUnclosed(parts: List<TextPart>, literal: List<String>, start: Int) {
    var read = parts
    if literal.isNotEmpty() || read.isEmpty() {
      read.append TextPart.Literal(concatenated(literal, ""))
    }
    push TokenKind.TextLiteral(read), start
    finishText start, isClosed: false
  }

  /**
   * The end of a string literal. The problems of its `String` reading wait for the checker under the span of the whole
   * literal; a literal that was never closed has no verbatim reading either, so they are reported at once.
   */
  var fn finishText(start: Int, isClosed: Bool) {
    isReadingText = false
    if isClosed {
      const literal = spanFrom start
      for problem in pending {
        deferred.append DeferredDiagnostic(literal, problem)
      }
    } else {
      diagnostics.appendAll pending
    }
    pending = []
  }

  /** The verbatim reading of the string literal at the position, which [writtenTextOf] asks for. */
  var fn readWritten() {
    const start = position
    if isAt("raw\"") {
      position = position + 3
      textLiteral start, raw: true
    } else if isAt("r\"") {
      position = position + 1
      textLiteral start, raw: true
    } else {
      textLiteral start, raw: false
    }
  }

  /**
   * Whether a `"""`/`raw"""` string starting right after the opening quotes spans more than one physical line, i.e.
   * contains a raw line break before the closing quotes. An interpolation cannot contain one, so this is enough to
   * tell a one-line `"""text"""` apart from a real block. Leaves `position` unchanged.
   */
  var fn hasMultipleLines(raw: Bool): Bool {
    const saved = position
    var found = false
    while const Some(character) = peek() {
      if character == '"' && isAt("\"\"\"") {
        break
      }
      if character == '\n' {
        found = true
        break
      }
      position = position + character.byteLength()
      if character == '\\' && !raw {
        skipRawEscape()
      } else if character == '{' && !raw {
        if !skipInterpolation() {
          break
        }
      }
    }
    position = saved
    found
  }

  /**
   * Advances past an escape sequence without decoding it. Used only to look for a raw line break before the real,
   * diagnostic-producing `escape` runs (which happens later, once dedenting is settled).
   */
  var fn skipRawEscape() {
    const character = match peek() {
      Some(found) => found
      None => {
        return
      }
    }
    position = position + character.byteLength()
    if character == 'u' && peek() == '{' {
      if const Some(close) = offsetOf("}", from: position) {
        position = close + 1
      }
    }
  }

  /** The number of `' '`/`'\t'` characters starting at `position`. */
  fn indentLength(): Int {
    var offset = 0
    loop {
      if peekAt(offset) != ' ' && peekAt(offset) != '\t' {
        return offset
      }
      offset = offset + 1
    }
  }

  /**
   * Rule 1 of multi-line strings: a line break directly after the opening `"""` (optionally after trailing
   * spaces) is not part of the string.
   */
  var fn skipLeadingLineBreak() {
    const length = indentLength()
    if peekAt(length) == '\r' && peekAt(length + 1) == '\n' {
      position = position + length + 2
    } else if peekAt(length) == '\n' {
      position = position + length + 1
    }
  }

  /**
   * Called at the start of a physical line inside of a multi-line string. Strips this line's share of the
   * indentation of the first line that has content (the reference), or the whole line if it has none itself (a
   * blank line, or the line of a lone closing `"""`). A line indented less than the reference, or whose
   * indentation is not the reference followed by more, is a lexer error and is left exactly as written.
   */
  var fn dedentLine(var reference: String?) {
    const length = indentLength()
    const hasNoContent = peekAt(length) == '\n' || peekAt(length) == '\r' || textStartsAt(position + length, "\"\"\"")
    if hasNoContent {
      position = position + length
      return
    }
    match reference {
      None => {
        reference = source.slice(position, position + length)
        position = position + length
      }
      Some(indentation) => {
        if isAt(indentation) {
          position = position + indentation.byteLength()
        } else {
          const indentStart = position
          position = position + length
          error "This line is indented less than the first line of the string", indentStart
          position = indentStart
        }
      }
    }
  }

  /** Moves behind the `}` that closes an interpolation. Braces and strings inside of it may nest. */
  var fn skipInterpolation(): Bool {
    var depth = 1
    while const Some(character) = peek() {
      position = position + character.byteLength()
      match character {
        '{' => {
          depth = depth + 1
        }
        '}' => {
          depth = depth - 1
          if depth == 0 {
            return true
          }
        }
        '"' => skipNestedString()
        '\n' => {
          return false
        }
        _ => {}
      }
    }
    false
  }

  var fn skipNestedString() {
    while const Some(inner) = peek() {
      position = position + inner.byteLength()
      if inner == '\\' {
        if const Some(escaped) = peek() {
          position = position + escaped.byteLength()
        }
      } else if inner == '"' {
        return
      }
    }
  }

  /**
   * The punctuation that stands at the position - the longest that does, `..=` before `..` before `.` - as its length
   * and its kind. `;` is not part of the language, but it gets a better message than "unexpected character".
   *
   * Every punctuation character is ASCII, so the characters after it are one byte on each. Any other character is no
   * punctuation, and nothing after it is looked at: the byte after it may be inside of it.
   */
  fn punctuationAt(character: Char): (Int, TokenKind)? {
    if character > '\u{7F}' {
      return None
    }
    const next = peekAt 1
    const found = match character {
      '.' => {
        if next != '.' {
          (1, TokenKind.Dot)
        } else if peekAt(2) == '.' {
          (3, TokenKind.Ellipsis)
        } else if peekAt(2) == '=' {
          (3, TokenKind.DotDotEqual)
        } else {
          (2, TokenKind.DotDot)
        }
      }
      '?' => {
        if next == '.' {
          (2, TokenKind.QuestionDot)
        } else if next == '?' {
          (2, TokenKind.QuestionQuestion)
        } else {
          (1, TokenKind.Question)
        }
      }
      '=' => {
        if next == '>' {
          (2, TokenKind.Arrow)
        } else if next == '=' {
          (2, TokenKind.EqualEqual)
        } else {
          (1, TokenKind.Equal)
        }
      }
      '!' => if next == '=' { (2, TokenKind.BangEqual) } else { (1, TokenKind.Bang) }
      '<' => {
        if next == '=' {
          (2, TokenKind.LessEqual)
        } else if next == '<' {
          (2, TokenKind.LessLess)
        } else {
          (1, TokenKind.Less)
        }
      }
      '>' => if next == '=' { (2, TokenKind.GreaterEqual) } else { (1, TokenKind.Greater) }
      '&' => if next == '&' { (2, TokenKind.AndAnd) } else { (1, TokenKind.Ampersand) }
      '|' => if next == '|' { (2, TokenKind.OrOr) } else { (1, TokenKind.Pipe) }
      '*' => if next == '*' { (2, TokenKind.StarStar) } else { (1, TokenKind.Star) }
      '+' => (1, TokenKind.Plus)
      '-' => (1, TokenKind.Minus)
      '/' => (1, TokenKind.Slash)
      '%' => (1, TokenKind.Percent)
      ',' => (1, TokenKind.Comma)
      ':' => (1, TokenKind.Colon)
      '(' => (1, TokenKind.ParenOpen)
      ')' => (1, TokenKind.ParenClose)
      '[' => (1, TokenKind.BracketOpen)
      ']' => (1, TokenKind.BracketClose)
      '{' => (1, TokenKind.BraceOpen)
      '}' => (1, TokenKind.BraceClose)
      '^' => (1, TokenKind.Caret)
      '~' => (1, TokenKind.Tilde)
      ';' => (1, TokenKind.Newline)
      _ => {
        return None
      }
    }
    found
  }

  var fn punctuation(start: Int, character: Char) {
    const (length, kind) = match punctuationAt(character) {
      Some(entry) => entry
      None => {
        position = position + character.byteLength()
        error "Unexpected character `{character}`", start
        return
      }
    }
    position = position + length
    // Read as the line break it maps to: the statement after it is still a statement of its own
    if character == ';' {
      error "There are no semicolons. A statement ends at the end of its line", start
    }
    push kind, start
  }
}
