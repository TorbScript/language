/**
 * What the lexer produces: [Token], its [TokenKind], and [Keyword] for the reserved words. A doc comment
 * ([DocComment]) is lexed alongside the tokens but is not one itself - the parser attaches it to the declaration
 * that follows.
 */

use Span from "./source"

/** One token of the source: its kind and the span it occupies. */
public type Token {
  kind: TokenKind
  span: Span
}

/** Everything a doc comment block held, kept aside so the parser can attach it to the declaration that follows. */
public type DocComment {
  /** Without the comment markers and the margin of stars. Markdown. */
  text: String
  span: Span
}

/** One piece of a `TokenKind.TextLiteral`: either literal text or the span of an interpolated expression. */
public type TextPart {
  case Literal(text: String)
  /** The source range between `{` and `}`. The parser parses it. */
  case Expression(span: Span)
}

/** Every kind of token the lexer produces. */
public type TokenKind {
  case Identifier
  case Reserved(keyword: Keyword)
  case IntegerLiteral
  case FloatLiteral
  case CharLiteral(value: Char)
  /** A string literal. Interpolated expressions are kept as source ranges. */
  case TextLiteral(parts: List<TextPart>)

  // Brackets
  case ParenOpen
  case ParenClose
  case BracketOpen
  case BracketClose
  case BraceOpen
  case BraceClose

  // Punctuation
  case Comma
  case Colon
  case Dot
  case DotDot
  case DotDotEqual
  case Ellipsis
  case Arrow
  case Question
  case QuestionDot
  case QuestionQuestion

  // Operators
  case Equal
  case EqualEqual
  case BangEqual
  case Bang
  case Less
  case LessEqual
  case Greater
  case GreaterEqual
  case AndAnd
  case OrOr
  /** A literal-type union and an or-pattern (`1 | 2 | 3`), and in an expression the bitwise or of two integers. */
  case Pipe
  /** An intersection of traits (`Compare & Show`), and in an expression the bitwise and of two integers. */
  case Ampersand
  /** The bitwise exclusive or of two integers, `a ^ b`. */
  case Caret
  /** The bitwise not of an integer, `~a`: a prefix operator. */
  case Tilde
  /**
   * The shift towards the high bits, `a << b`. Its mirror `>>` is no token: it is two `>` with nothing between them,
   * which the expression parser reads as one operator, so that `List<List<Int>>` stays two closing brackets.
   */
  case LessLess
  case Plus
  case Minus
  case Star
  /** The power, `a ** b`. `^` is lexed as this one too, with a message that says so. */
  case StarStar
  case Slash
  case Percent

  /** A line break that ends a statement. Line breaks that do not are removed by the lexer. */
  case Newline
  case EndOfFile

  /** A line that ends with one of these continues on the next line. */
  fn continuesLineAfter(): Bool {
    match self {
      .Comma | .Colon | .Dot | .QuestionDot | .Arrow | .Equal | .EqualEqual | .BangEqual | .Less | .LessEqual | .GreaterEqual => true
      .AndAnd | .OrOr | .QuestionQuestion | .Plus | .Ampersand | .Minus | .Star | .Slash | .Percent | .ParenOpen | .BracketOpen => true
      .StarStar | .Caret | .Pipe | .LessLess => true
      _ => false
    }
  }

  /** A line that starts with one of these continues the previous line. */
  fn continuesLineBefore(): Bool {
    match self {
      .Dot | .QuestionDot | .AndAnd | .OrOr | .QuestionQuestion | .Plus | .Ampersand | .Star | .Slash | .Percent => true
      .StarStar | .Caret | .LessLess => true
      .EqualEqual | .BangEqual | .LessEqual | .GreaterEqual | .Equal => true
      .Reserved(Keyword.With) | .Reserved(Keyword.Where) | .Reserved(Keyword.Else) => true
      _ => false
    }
  }

  /** For messages: "Expected a type, found `)`" */
  fn describe(): String {
    match self {
      .Identifier => "a name"
      .Reserved(_) => "a keyword"
      .IntegerLiteral | .FloatLiteral => "a number"
      .CharLiteral(_) => "a character"
      .TextLiteral(_) => "a string"
      .ParenOpen => "`(`"
      .ParenClose => "`)`"
      .BracketOpen => "`[`"
      .BracketClose => "`]`"
      .BraceOpen => "`\{`"
      .BraceClose => "`\}`"
      .Comma => "`,`"
      .Colon => "`:`"
      .Dot => "`.`"
      .DotDot => "`..`"
      .DotDotEqual => "`..=`"
      .Ellipsis => "`...`"
      .Arrow => "`=>`"
      .Question => "`?`"
      .QuestionDot => "`?.`"
      .QuestionQuestion => "`??`"
      .Equal => "`=`"
      .EqualEqual => "`==`"
      .BangEqual => "`!=`"
      .Bang => "`!`"
      .Less => "`<`"
      .LessEqual => "`<=`"
      .Greater => "`>`"
      .GreaterEqual => "`>=`"
      .AndAnd => "`&&`"
      .OrOr => "`||`"
      .Pipe => "`|`"
      .Ampersand => "`&`"
      .Caret => "`^`"
      .Tilde => "`~`"
      .LessLess => "`<<`"
      .Plus => "`+`"
      .Minus => "`-`"
      .Star => "`*`"
      .StarStar => "`**`"
      .Slash => "`/`"
      .Percent => "`%`"
      .Newline => "the end of the line"
      .EndOfFile => "the end of the file"
    }
  }
}

/**
 * The one spelling of the keyword that says a member belongs to the type. It stands here alone, and every message
 * that teaches it interpolates it, so that trading it for another word (`type fn`, `type const`) is this line and a
 * `canon` rule and nothing else.
 */
public const staticKeyword = "static"

/** Every reserved word of the language. `from`, `as` and `by` are not among them; see [Keyword.fromText]. */
public type Keyword {
  case Const
  case Var
  /** A member that belongs to the type and not to a value. See [staticKeyword]. */
  case Static
  case Fn
  case Type
  case Trait
  case Extend
  case Foreign
  case Case
  case Use
  case Public
  case Private
  case Native
  case Shared
  case Lazy
  case If
  case Else
  case Match
  case For
  case In
  case While
  /** The endless loop, `loop { }`. Without a `break` that targets it, its type is `Never`. */
  case Loop
  case Break
  case Continue
  case Return
  case True
  case False
  /** The one value of `Void`, like `true` and `false` are the values of `Bool` */
  case Void
  case SelfValue
  case SelfType
  case With
  case Where

  /** `from`, `as` and `by` are contextual: they are ordinary identifiers for the lexer. */
  static fn fromText(text: String): Self? {
    // Not an arm of the match below: a bare name in a pattern binds, and [staticKeyword] is to stand in one place
    if text == staticKeyword {
      return Self.Static
    }
    const keyword: Self = match text {
      "const" => .Const
      "var" => .Var
      "fn" => .Fn
      "type" => .Type
      "trait" => .Trait
      "extend" => .Extend
      "foreign" => .Foreign
      "case" => .Case
      "use" => .Use
      "public" => .Public
      "private" => .Private
      "native" => .Native
      "shared" => .Shared
      "lazy" => .Lazy
      "if" => .If
      "else" => .Else
      "match" => .Match
      "for" => .For
      "in" => .In
      "while" => .While
      "loop" => .Loop
      "break" => .Break
      "continue" => .Continue
      "return" => .Return
      "true" => .True
      "false" => .False
      "void" => .Void
      "self" => .SelfValue
      "Self" => .SelfType
      "with" => .With
      "where" => .Where
      _ => {
        return None
      }
    }
    keyword
  }
}
