/**
 * The grammar of types: [parseType] down to a named type, a tuple or function type, and a literal type
 * (`"online" | "offline"`).
 */

use TokenKind, Keyword from "../token"
use TypeReference, TypeKind, TupleTypeField, FunctionTypeParameter from "../ast"
use Expression, ExpressionKind, TextSegment, PrefixOperator, Name from "../ast"
use Parser from "./parser"
use parsePrimaryExpression from "./expressions"

/** A type, including `Show & Encode` (a value that implements several traits). */
public fn parseType(var parser: Parser): TypeReference {
  const start = parser.span()
  const first = parseSingleType parser
  // `Array<Float, size + 1>`: a value with arithmetic after it is an expression, and no type position computes one
  if isArithmetic(parser.kind()) && isValueLike(first) {
    while isArithmetic(parser.kind()) {
      parser.bump()
      const _ = parseSingleType parser
    }
    const at = start.to parser.previousSpan()
    const note = "A size is computed in a `const` and named here: `const length = size + 1`, then `Array<Float, length>`"
    parser.errorWithNote "A type argument is a type or the name of a constant, never an expression", note, at
    return TypeReference TypeKind.Invalid, at
  }
  if parser.isAt(TokenKind.Plus) {
    parser.errorHere "Traits are combined with `&`: `Compare & Show`"
  } else if !parser.isAt(TokenKind.Ampersand) {
    return first
  }
  var members = [first]
  while parser.eat(TokenKind.Ampersand) || parser.eat(TokenKind.Plus) {
    members.append parseSingleType(parser)
  }
  TypeReference TypeKind.Intersection(members), start.to(parser.previousSpan())
}

fn isArithmetic(kind: TokenKind): Bool {
  match kind {
    .Plus | .Minus | .Star | .StarStar | .Slash | .Percent => true
    _ => false
  }
}

/** A constant's name or a literal: what a `const` argument is, and never a trait `+` could combine. */
fn isValueLike(reference: TypeReference): Bool {
  match reference.kind {
    .Named(path, arguments) => {
      if path.length() != 1 || !arguments.isEmpty() {
        return false
      }
      match path[0].text.chars().first() {
        Some(first) => first >= 'a' && first <= 'z'
        None => false
      }
    }
    .Literals(_) => true
    _ => false
  }
}

/** A type without `&`. This is what the items of a bound list are (`where Item: Hash & Equals`). */
public fn parseSingleType(var parser: Parser): TypeReference {
  const start = parser.span()
  if parser.eatKeyword(Keyword.Lazy) {
    const inner = parseType parser
    return TypeReference TypeKind.Lazy(inner), start.to(parser.previousSpan())
  }
  var result = parsePrimaryType parser
  loop {
    if parser.eat(TokenKind.Question) {
      result = TypeReference TypeKind.Optional(result), start.to(parser.previousSpan())
      continue
    }
    // `Int??` is `Option<Option<Int>>`: the lexer reads `??` as one token, which only an expression means as `orElse`
    if parser.eat(TokenKind.QuestionQuestion) {
      const inner = TypeReference TypeKind.Optional(result), start.to(parser.previousSpan())
      result = TypeReference TypeKind.Optional(inner), start.to(parser.previousSpan())
      continue
    }
    break
  }
  if parser.isAt(TokenKind.Pipe) {
    parser.errorHere(
      "Only literals can be combined with `|` (`\"online\" | \"offline\"`). There are no unions of types: declare a type with cases"
    )
    while parser.eat(TokenKind.Pipe) {
      const _ = parsePrimaryType parser
    }
  }
  result
}

/** A text, integer, character or boolean literal, or `-` in front of one: what may stand where a type stands. A
 * float is deliberately excluded (rejected explicitly, with its own message) and never reaches here. */
fn startsLiteral(kind: TokenKind): Bool {
  match kind {
    .TextLiteral(_) | .IntegerLiteral | .CharLiteral(_) | .Minus => true
    .Reserved(.True) | .Reserved(.False) => true
    _ => false
  }
}

fn parsePrimaryType(var parser: Parser): TypeReference {
  const start = parser.span()
  const kind = match parser.kind() {
    .ParenOpen => parseTupleOrFunctionType parser
    .FloatLiteral => {
      parser.errorHere "A float cannot be a literal type"
      parser.bump()
      TypeKind.Invalid
    }
    .Identifier | .Reserved(.SelfType) => parseNamedType parser
    other if startsLiteral(other) => parseLiteralType parser
    other => {
      parser.errorHere "Expected a type, found {other.describe()}"
      TypeKind.Invalid
    }
  }
  TypeReference kind, start.to(parser.previousSpan())
}

/** `List<Item>`, `http.Response`, `Self` */
fn parseNamedType(var parser: Parser): TypeKind {
  var path = [parser.nameOrKeyword()]
  while parser.isAt(TokenKind.Dot) && parser.kindAt(1) == TokenKind.Identifier {
    parser.bump()
    path.append parser.name()
  }
  const arguments = if parser.eat(TokenKind.Less) { parser.commaSeparated TokenKind.Greater, parseType } else { [] }
  TypeKind.Named path, arguments
}

/** `"online" | "offline"`, `1 | 2 | 3`. A single literal is also what a const argument looks like: `Array<Float, 16>`. */
fn parseLiteralType(var parser: Parser): TypeKind {
  var literals = [parseTypeLiteral(parser)]
  while parser.eat(TokenKind.Pipe) {
    if startsLiteral(parser.kind()) {
      literals.append parseTypeLiteral(parser)
    } else if parser.isAt(TokenKind.FloatLiteral) {
      parser.errorHere "A float cannot be a literal type"
      parser.bump()
    } else {
      parser.errorHere "Only literals can be combined with `|`. There are no unions of types: declare a type with cases"
      const _ = parsePrimaryType parser
    }
  }
  TypeKind.Literals literals
}

fn parseTypeLiteral(var parser: Parser): Expression {
  const start = parser.span()
  if parser.eat(TokenKind.Minus) {
    const operand = parsePrimaryExpression parser
    return Expression ExpressionKind.Unary(PrefixOperator.Negate, operand), start.to(parser.previousSpan())
  }
  const literal = parsePrimaryExpression parser
  if const .TextLiteral(segments) = literal.kind {
    if segments.any(isInterpolated) {
      parser.error "A literal type cannot contain `\{...\}`", literal.span
    }
  }
  literal
}

fn isInterpolated(segment: TextSegment): Bool {
  match segment {
    .Interpolated(_) => true
    .Literal(_) => false
  }
}

/** `(Int, String)` and `(lowest: Int, highest: Int)` are tuples, `(value: Int, String) => Bool` is a function. */
fn parseTupleOrFunctionType(var parser: Parser): TypeKind {
  parser.bump()
  const parameters = parser.commaSeparated TokenKind.ParenClose, parseFunctionTypeParameter
  if parser.eat(TokenKind.Arrow) {
    return TypeKind.FunctionType parameters, parseType(parser)
  }
  if const Some(parameter) = parameters.find({ _.isVar }) {
    parser.error "`var` only makes sense in a function type. Is a `=> Result` missing?", parameter.annotation.span
  }
  if parameters.length() == 1 && parameters[0].name.isNone() {
    return parameters[0].annotation.kind
  }
  TypeKind.TupleType(parameters.map({ TupleTypeField _.name, _.annotation }).toList())
}

fn parseFunctionTypeParameter(var parser: Parser): FunctionTypeParameter {
  const isVar = parser.eatKeyword Keyword.Var
  const isNamed = isNameOrKeyword(parser.kind()) && parser.kindAt(1) == TokenKind.Colon
  var name: Name? = None
  if isNamed {
    name = Some parser.nameOrKeyword()
    parser.bump()
  }
  FunctionTypeParameter name, isVar, parseType(parser)
}

/** Whether the token can stand where a name is expected: a keyword works too, after a `.` and as a label. */
public fn isNameOrKeyword(kind: TokenKind): Bool {
  match kind {
    .Identifier | .Reserved(_) => true
    _ => false
  }
}
