/**
 * The grammar of patterns: [parsePattern], from a bare wildcard or binding up to a case with fields and the `|` of
 * alternatives. A leading uppercase letter is what tells a case from a binding here; the scope only matters later,
 * when a name has to be resolved.
 */

use TokenKind, Keyword from "../token"
use Pattern, PatternKind, RestPattern, FieldPattern, Name, Expression, ExpressionKind, PrefixOperator from "../ast"
use Parser from "./parser"
use parsePrimaryExpression from "./expressions"
use isNameOrKeyword from "./types"

/** A pattern, including alternatives: `1 | 2 | 3` */
public fn parsePattern(var parser: Parser): Pattern {
  const start = parser.span()
  const first = parseSinglePattern parser
  if !parser.isAt(TokenKind.Pipe) {
    return first
  }
  var alternatives = [first]
  while parser.eat(TokenKind.Pipe) {
    alternatives.append parseSinglePattern(parser)
  }
  Pattern PatternKind.Alternatives(alternatives), start.to(parser.previousSpan())
}

fn parseSinglePattern(var parser: Parser): Pattern {
  const start = parser.span()
  const kind = match parser.kind() {
    .Identifier if parser.text(start) == "_" => {
      parser.bump()
      PatternKind.Wildcard
    }
    .Identifier => parseNameOrVariant parser
    // `.Circle(radius)`, `.Empty`, `.Rectangle(width, ...)`
    .Dot => {
      parser.bump()
      const name = parser.name()
      if !parser.eat(TokenKind.ParenOpen) {
        return Pattern PatternKind.ImplicitVariant(name, [], hasRest: false), start.to(parser.previousSpan())
      }
      const written = parseVariantFields parser
      PatternKind.ImplicitVariant name, written.fields, written.hasRest
    }
    .ParenOpen => {
      parser.bump()
      const items = parser.commaSeparated TokenKind.ParenClose, parsePattern
      if items.length() == 1 {
        items[0].kind
      } else {
        PatternKind.TuplePattern items
      }
    }
    .BracketOpen => parseListPattern parser
    .IntegerLiteral | .FloatLiteral | .CharLiteral(_) | .TextLiteral(_) | .Minus => parseLiteralPattern parser
    .Reserved(.True | .False | .Void) => parseLiteralPattern parser
    other => {
      parser.errorHere "Expected a pattern, found {other.describe()}"
      PatternKind.Invalid
    }
  }
  Pattern kind, start.to(parser.previousSpan())
}

/** `value`, `None`, `Some(value)`, `Shape.Circle(radius)` */
fn parseNameOrVariant(var parser: Parser): PatternKind {
  var path = [parser.name()]
  while parser.isAt(TokenKind.Dot) && parser.kindAt(1) == TokenKind.Identifier {
    parser.bump()
    path.append parser.name()
  }
  if parser.eat(TokenKind.ParenOpen) {
    const written = parseVariantFields parser
    return PatternKind.Variant path, written.fields, written.hasRest
  }
  // A name that starts with an uppercase letter is never a binding: it is a case the scope has to know (`None`)
  if path.length() > 1 || startsUpperCase(path[0].text) {
    return PatternKind.Variant path, [], hasRest: false
  }
  PatternKind.Binding path[0].text
}

/**
 * Whether a name starts with an uppercase letter, which is what decides between a binding and a case. A name is ASCII,
 * so "uppercase" is `A` to `Z` and nothing else: `_found` and `found` bind and `Found` does not.
 */
fn startsUpperCase(text: String): Bool {
  match text.chars().first() {
    Some(first) => first >= 'A' && first <= 'Z'
    None => false
  }
}

/** The fields a constructor pattern names, and whether it ends in the `...` that stands for the rest of them. */
type WrittenFields {
  fields: List<FieldPattern>
  hasRest: Bool
}

/**
 * `Point(x, y)`, `Circle(radius: r)`, `Config(host, ...)`: the fields that are named, and the `...` that says the
 * rest of them are not. A `...` comes last and comes once, which is the rule a list pattern has for its own.
 */
fn parseVariantFields(var parser: Parser): WrittenFields {
  var hasRest = false
  const written = parser.commaSeparated(TokenKind.ParenClose, { parser =>
    if !parser.eat(TokenKind.Ellipsis) {
      if hasRest {
        const at = parser.span()
        parser.error "A `...` comes last in a pattern: it stands for every field behind it", at
      }
      return Some parseVariantField(parser)
    }
    if hasRest {
      const at = parser.previousSpan()
      parser.error "A pattern can only have one `...`", at
    }
    hasRest = true
    None
  })
  WrittenFields written.filterMap({ _ }).toList(), hasRest
}

/**
 * `Circle(radius: r)`: the label is kept, and the type checker decides which field the sub-pattern matches - the
 * positional ones from the left, the labeled ones by name.
 */
fn parseVariantField(var parser: Parser): FieldPattern {
  var label: Name? = None
  // A label is the name of a field, and a field may be named after a reserved word: `.Click(type: kind)`
  if isNameOrKeyword(parser.kind()) && parser.kindAt(1) == TokenKind.Colon {
    label = parser.nameOrKeyword()
    parser.bump()
  }
  FieldPattern label, parsePattern(parser)
}

/** `[]`, `[first, second]`, `[first, ...rest]`, `[..., last]` */
fn parseListPattern(var parser: Parser): PatternKind {
  parser.bump()
  var rest: RestPattern? = None
  var count = 0
  const items = parser.commaSeparated(TokenKind.BracketClose, { parser =>
    if !parser.eat(TokenKind.Ellipsis) {
      count = count + 1
      return Some parsePattern(parser)
    }
    var name: Name? = None
    if parser.isAt(TokenKind.Identifier) {
      name = parser.name()
    }
    if rest.isSome() {
      const at = parser.previousSpan()
      parser.error "A list pattern can only have one `...`", at
    }
    rest = RestPattern count, name
    None
  })
  PatternKind.ListPattern(items.filterMap({ _ }).toList(), rest)
}

/** `0`, `"text"`, `'a'`, `-1`, `1..=9` */
fn parseLiteralPattern(var parser: Parser): PatternKind {
  const start = parseLiteralPatternValue parser
  const isInclusive = parser.isAt TokenKind.DotDotEqual
  if isInclusive || parser.isAt(TokenKind.DotDot) {
    parser.bump()
    return PatternKind.RangePattern start, parseLiteralPatternValue(parser), isInclusive
  }
  PatternKind.Literal start
}

fn parseLiteralPatternValue(var parser: Parser): Expression {
  const start = parser.span()
  if parser.eat(TokenKind.Minus) {
    const operand = parsePrimaryExpression parser
    return Expression ExpressionKind.Unary(PrefixOperator.Negate, operand), start.to(parser.previousSpan())
  }
  parsePrimaryExpression parser
}
