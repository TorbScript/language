/**
 * The grammar of every top-level and member declaration: [parseDeclaration] for `fn`, `type`, `trait`, `extend`,
 * `use` and `foreign`, and [parseFunction] for the parameter list and body a function and a member share.
 */

use Span from "../source"
use TokenKind, Keyword, TextPart, staticKeyword from "../token"
use Declaration, DeclarationKind, Modifiers, Visibility, UseDeclaration, UseItem, UseItems, UseSource from "../ast"
use FunctionDeclaration, Parameter, GenericParameter, WhereClause, TypeReference, TraitClause from "../ast"
use TypeDeclaration, AliasDeclaration, TraitDeclaration, ExtendDeclaration, ForeignDeclaration from "../ast"
use Member, MemberKind, Field, CaseDeclaration, Name, TypeKind, ExpressionKind from "../ast"
use Parser from "./parser"
use parseBlock, parseBinding, parseBindingBody from "./statements"
use parseType, parseSingleType from "./types"
use parseExpression, parseCommandExpression from "./expressions"

/** `fn`, `type`, `trait`, `extend`, `use`, `foreign`, with their modifiers. */
public fn parseDeclaration(var parser: Parser): Declaration {
  const doc = parser.takeDoc()
  const start = parser.span()
  const modifiers = parseModifiers parser
  const kind = match parser.kind() {
    .Reserved(.Use) => parseUse parser
    .Reserved(.Fn) => DeclarationKind.Function parseFunction(parser)
    .Reserved(.Type) => parseTypeDeclaration parser
    .Reserved(.Trait) => parseTrait parser
    .Reserved(.Extend) => parseExtend parser
    .Reserved(.Foreign) => parseForeign parser
    .Reserved(.Const | .Var) => parseConstant parser, modifiers
    other => {
      parser.errorHere "Expected a declaration (`fn`, `type`, `trait`, `extend`, `use`), found {other.describe()}"
      DeclarationKind.Use UseDeclaration(UseItems.Names([]), UseSource.Module(""))
    }
  }
  Declaration doc, modifiers, kind, start.to(parser.previousSpan())
}

fn parseModifiers(var parser: Parser): Modifiers {
  var modifiers = Modifiers()
  loop {
    // `private: Bool` is a field named after a keyword, not a modifier in front of one
    if parser.kindAt(1) == TokenKind.Colon {
      break
    }
    match parser.kind() {
      .Reserved(.Public) => {
        modifiers = withVisibility parser, modifiers, Visibility.Public, parser.span()
      }
      .Reserved(.Private) => {
        // `private(var) balance: Int`, the spelling `protected var` replaces
        if parser.kindAt(1) == TokenKind.ParenOpen && parser.kindAt(2) == TokenKind.Reserved(Keyword.Var) {
          const start = parser.span()
          parser.bump()
          parser.bump()
          parser.bump()
          parser.expect TokenKind.ParenClose
          modifiers = withVisibility parser, modifiers, Visibility.PrivateVar, start.to(parser.previousSpan())
          continue
        }
        modifiers = withVisibility parser, modifiers, Visibility.Private, parser.span()
      }
      // `protected var connections: Int`: a word only here, so a member may still be named `protected`
      .Identifier if isAtProtected(parser) => {
        modifiers = withVisibility parser, modifiers, Visibility.Protected, parser.span()
      }
      .Reserved(.Native) => {
        modifiers = modifiers.copy native: true
      }
      .Reserved(.Shared) => {
        modifiers = modifiers.copy shared: true
      }
      _ => {
        break
      }
    }
    parser.bump()
  }
  modifiers
}

/**
 * The word `protected` in front of a member (`protected var connections: Int`). It is no keyword: a field, a method and
 * a case field may be named `protected`, and in front of a `:` it is that name.
 */
fn isAtProtected(parser: Parser): Bool {
  parser.isAtWord protectedWord
}

/**
 * The word `protected` in front of a declaration that a statement starts - a top-level one, or one inside a block -
 * where it is always a mistake: only a field of a type is write-protected. The word counts only in front of a keyword
 * that starts a declaration, so `protected = 1` and `protected.count` stay what they are.
 */
public fn isAtProtectedDeclaration(parser: Parser): Bool {
  if !isAtProtected(parser) {
    return false
  }
  match parser.kindAt(1) {
    .Reserved(.Public | .Private | .Native | .Shared | .Static | .Fn | .Type | .Trait | .Extend | .Foreign) => true
    .Reserved(.Const | .Var | .Case | .Use) => true
    _ => false
  }
}

const protectedWord = "protected"

/** The visibility of a declaration, which it has once: `private protected var count: Int` is an error. */
fn withVisibility(var parser: Parser, modifiers: Modifiers, visibility: Visibility, at: Span): Modifiers {
  const first = modifiers.visibility
  if first == Visibility.Default {
    return modifiers.copy visibility: visibility, visibilitySpan: Some(at)
  }
  if first == visibility {
    parser.error "`{visibility.written()}` is written twice", at
    return modifiers
  }
  const message = "`{first.written()}` and `{visibility.written()}` do not combine: a declaration has one visibility"
  const both = [first, visibility]
  if both.contains(Visibility.Private)
    && (both.contains(Visibility.Protected) || both.contains(Visibility.PrivateVar)) {
    const note = "`private` hides the field, `protected var` only its writing: keep the one that is meant"
    parser.errorWithNote message, note, at
  } else {
    parser.error message, at
  }
  modifiers
}

/**
 * `public const pi = 3.14` at the top level of a module. `public var` is an error: a module has no mutable state,
 * so there is nothing a top-level `var` could export.
 */
fn parseConstant(var parser: Parser, modifiers: Modifiers): DeclarationKind {
  const binding = parseBinding parser
  if binding.var && modifiers.visibility == Visibility.Public {
    parser.error "A module has no mutable state: only `const` can be public", binding.pattern.span
  }
  DeclarationKind.Constant binding
}

/** `use A, B from "./file"`, `use Option.Some from "./option"`, `use Shape.Circle`, `use * as http from "std/http"` */
fn parseUse(var parser: Parser): DeclarationKind {
  parser.bump()
  // `use "acme/text"`: nothing runs when a module is imported, so a `use` without names would mean nothing
  if const .TextLiteral(_) = parser.kind() {
    const start = parser.span()
    const path = parsePlainText parser, "the path of a module"
    const note = "Write the names: `use Name from \"{path}\"`, a member of a type `use String.shout from \"{path}\"`"
    parser.errorWithNote "A `use` names what it imports", note, start.to(parser.previousSpan())
    return DeclarationKind.Use UseDeclaration(UseItems.Names([]), UseSource.Module(path))
  }
  const items = if parser.eat(TokenKind.Star) {
    if parser.isAtWord("as") {
      parser.bump()
    } else {
      parser.errorHere "`use *` needs a name: `use * as name from \"...\"`"
    }
    UseItems.All parser.name()
  } else {
    var items = [parseUseItem(parser)]
    while parser.eat(TokenKind.Comma) {
      items.append parseUseItem(parser)
    }
    UseItems.Names items
  }
  if parser.isAtWord("from") {
    parser.bump()
  } else {
    // `use Shape.Circle`: without `from` every path is resolved in this file's own scope, which is what a type
    // declared here needs. A path of one segment would rebind something that is in scope already.
    if isLocalUse(items) {
      return DeclarationKind.Use UseDeclaration(items, UseSource.Local)
    }
    parser.errorHere "Expected `from \"...\"`"
  }
  // `use Some, None from Option` is gone: after `from` there is always a module
  if parser.isAt(TokenKind.Identifier) {
    const start = parser.span()
    var path = [parser.name()]
    while parser.isAt(TokenKind.Dot) && parser.kindAt(1) == TokenKind.Identifier {
      parser.bump()
      path.append parser.name()
    }
    const at = start.to parser.previousSpan()
    const message = typeSourceMessage path, items
    parser.error message, at
    return DeclarationKind.Use UseDeclaration(items, UseSource.Module(""))
  }
  const isWritten = match parser.kind() {
    .TextLiteral(_) => true
    _ => false
  }
  const before = parser
  const path = parsePlainText parser, "the path of a module"
  // An empty path is what a broken `use` leaves behind, so the one written that way is reported here
  if isWritten && path.isEmpty() && !parser.hasFailedSince(before) {
    parser.error "A `use` needs the path of a module: `use Name from \"std/core\"`", parser.previousSpan()
  }
  DeclarationKind.Use UseDeclaration(items, UseSource.Module(path))
}

/** `Option.Some as Just`: one item of a `use` list, with its path and the local name it is to get. */
fn parseUseItem(var parser: Parser): UseItem {
  var path = [parser.name()]
  while parser.isAt(TokenKind.Dot) && parser.kindAt(1) == TokenKind.Identifier {
    parser.bump()
    path.append parser.name()
  }
  // `use Option.* from "std/core"`: a case list is never a wildcard, so the message is the line to write instead
  if parser.isAt(TokenKind.Dot) && parser.kindAt(1) == TokenKind.Star {
    const dot = parser.span()
    parser.bump()
    parser.bump()
    const at = dot.to parser.previousSpan()
    const owner = path.map({ _.text }).toList().joined(separator: ".")
    const note = "A case list is not a wildcard: name every case on its own (`use {owner}.<Case> from \"...\"`)"
    parser.errorWithNote "There is no `use {owner}.*`", note, at
  }
  // `use A as B from "..."`: `as` is a word, not a keyword, so a type named `as` stays possible
  if !parser.isAtWord("as") {
    return UseItem path, alias: None
  }
  parser.bump()
  UseItem path, parser.name()
}

/**
 * Whether a `use` without `from` is the local form: every item names a type of this file and a case of it
 * (`use Shape.Circle`). A single bare name would rebind what is in scope already, so that stays a missing `from`.
 */
fn isLocalUse(items: UseItems): Bool {
  match items {
    .Names(names) => !names.isEmpty() && names.all({ _.path.length() > 1 })
    _ => false
  }
}

/** `use Some, None from Option` was the old spelling of a case import. The message teaches the path form instead. */
fn typeSourceMessage(path: List<Name>, items: UseItems): String {
  const owner = path.map({ _.text }).toList().joined(separator: ".")
  const message = "`from` takes a module in quotes, not the type `{owner}`"
  if const .Names(names) = items {
    if const Some(first) = names.get(0) {
      return "{message}: a case is imported by its path, `use {owner}.{first.name().text} from \"...\"`"
    }
  }
  message
}

/** A string literal without interpolation. */
fn parsePlainText(var parser: Parser, what: String): String {
  match parser.kind() {
    .TextLiteral(parts) => {
      parser.bump()
      if const [.Literal(text)] = parts {
        return text
      }
      const at = parser.previousSpan()
      parser.error "Expected {what} as a plain string, without `\{...\}`", at
    }
    other => parser.errorHere "Expected {what} as a string, found {other.describe()}"
  }
  ""
}

/**
 * The position is at `fn`. A member (`isMember`) may be named after a reserved word, because it is only ever reached
 * after a `.` - `event.type()`, `self.match(pattern)` - where the parser reads a keyword as a name already.
 */
public fn parseFunction(var parser: Parser, isMember: Bool = false): FunctionDeclaration {
  parser.bump()
  const name = if isMember { parser.nameOrKeyword() } else { parser.name() }
  const generics = parseGenericParameters parser
  parser.expect TokenKind.ParenOpen
  const parameters = parser.withTrailingClosures(
    allowed: true,
    parseInner: { parser => parser.commaSeparated TokenKind.ParenClose, parseParameter },
  )
  const returnType = if parser.eat(TokenKind.Colon) { Some parseType(parser) } else { None }
  const whereClauses = parseWhereClauses parser
  const body = if parser.isAt(TokenKind.BraceOpen) { Some parseBlock(parser) } else { None }
  FunctionDeclaration name, generics, parameters, returnType, whereClauses, body
}

fn parseParameter(var parser: Parser): Parameter {
  const doc = parser.takeDoc()
  const isVariadic = parser.eat TokenKind.Ellipsis
  const isVar = parser.eatKeyword Keyword.Var
  // A method does not list its receiver: the parameter list is what the caller writes. `self` still stands in a
  // function *type* (`(var self: Config) => Void`), which is parsed in `types.trb` and never reaches here.
  if parser.isAtKeyword(Keyword.SelfValue) {
    return parseWrittenReceiver parser, doc, isVar, isVariadic
  }
  const name = parser.name()
  const annotation = if parser.eat(TokenKind.Colon) { Some parseType(parser) } else { None }
  if annotation.isNone() && !name.text.isEmpty() {
    parser.error "The parameter `{name.text}` needs a type", name.span
  }
  const default = if parser.eat(TokenKind.Equal) { Some parseExpression(parser) } else { None }
  Parameter doc, name, isVar, isVariadic, annotation, default
}

/**
 * `fn area()` and `var fn translate(...)`: the two spellings the language traded for `fn area()` and
 * `var fn translate(...)`, each with the line it is written as now.
 */
fn parseWrittenReceiver(var parser: Parser, doc: String?, isVar: Bool, isVariadic: Bool): Parameter {
  const written = parser.nameOrKeyword()
  const note = if isVar {
    "Write `var fn name(...)`: `var` says the method may change its receiver"
  } else {
    "Write `fn name(...)`: what stands in the parentheses is what the caller writes"
  }
  parser.errorWithNote "A method does not list `self`", note, written.span
  const annotation = if parser.eat(TokenKind.Colon) { Some parseType(parser) } else { None }
  // An empty name is the parser's placeholder: the member keeps the receiver it was given, not this one
  Parameter doc, Name("", written.span), isVar, isVariadic, annotation, default: None
}

/** `<Key: Hash & Equals, Value = Self>`, `<const Size: Int>` */
fn parseGenericParameters(var parser: Parser): List<GenericParameter> {
  if !parser.eat(TokenKind.Less) {
    return []
  }
  parser.commaSeparated TokenKind.Greater, parseGenericParameter
}

fn parseGenericParameter(var parser: Parser): GenericParameter {
  const isConst = parser.eatKeyword Keyword.Const
  const name = parser.name()
  const bounds = if parser.eat(TokenKind.Colon) { parseBounds parser } else { [] }
  if isConst && bounds.length() != 1 {
    parser.error "A const parameter needs a type: `const {name.text}: Int`", name.span
  }
  const default = if parser.eat(TokenKind.Equal) { Some parseType(parser) } else { None }
  GenericParameter isConst, name, bounds, default
}

/** `Hash & Equals` */
fn parseBounds(var parser: Parser): List<TypeReference> {
  var bounds = [parseSingleType(parser)]
  if parser.isAt(TokenKind.Plus) {
    parser.errorHere "Traits are combined with `&`: `Compare & Show`"
  }
  while parser.eat(TokenKind.Ampersand) || parser.eat(TokenKind.Plus) {
    bounds.append parseSingleType(parser)
  }
  bounds
}

/** `where Key: Hash, Value: Show` */
fn parseWhereClauses(var parser: Parser): List<WhereClause> {
  var clauses: List<WhereClause> = []
  if !parser.eatKeyword(Keyword.Where) {
    return clauses
  }
  loop {
    const subject = parseType parser
    parser.expect TokenKind.Colon
    clauses.append WhereClause(subject, parseBounds(parser))
    if !parser.eat(TokenKind.Comma) {
      break
    }
  }
  clauses
}

/**
 * `with Add, Compare`, for a `trait`'s supertraits and an `extend`'s implementations - neither has a field of its
 * own to delegate to, so a stray `by` is rejected here rather than parsed and ignored, and a parenthesised group
 * (only meaningful in front of a `by`) is the same error a delegated group without `by` is. Entries are separated
 * by `,` only: `&` is a bound or a type position's intersection, never a `with` list's separator.
 */
fn parseTraitList(var parser: Parser): List<TypeReference> {
  if !parser.eatKeyword(Keyword.With) {
    return []
  }
  var traits = parseWithListEntry parser
  while parser.eat(TokenKind.Comma) {
    traits.appendAll parseWithListEntry(parser)
  }
  if parser.isAtWord("by") {
    parser.errorHere "`by` delegates to a field: only a `type` has fields to name"
    parser.bump()
    parser.name()
  }
  traits
}

/**
 * One entry of a `with` list that never delegates. `&` between traits is the mistake [reportAmpersandTypo] names,
 * and a parenthesised group - only meaningful in front of a `by` this list never has - is the same error a
 * delegated group without `by` is.
 */
fn parseWithListEntry(var parser: Parser): List<TypeReference> {
  if parser.isAt(TokenKind.ParenOpen) {
    const group = parseParenthesizedTraitGroup parser
    parser.error "A group without `by` is an error: write the traits without parentheses", group.span
    return group.items
  }
  const start = parser.span()
  var items = [parseSingleType(parser)]
  const sawTypo = isAtSeparatorTypo parser
  while eatSeparatorTypo(parser) {
    items.append parseSingleType(parser)
  }
  if sawTypo {
    reportAmpersandTypo parser, items, delegate: None, at: start.to(parser.previousSpan())
  }
  items
}

/**
 * `with Show, (Add, Subtract) by value, Compare by value`: `by` binds to the one element directly in front of it,
 * the trait or the parenthesised group. A group is written `(Trait, Trait)`; `&` between traits is the mistake
 * [reportAmpersandTypo] names, whether or not a `by` follows.
 */
fn parseDelegatedTraitList(var parser: Parser): List<TraitClause> {
  if !parser.eatKeyword(Keyword.With) {
    return []
  }
  var traits = [parseTraitClause(parser)]
  while parser.eat(TokenKind.Comma) {
    traits.append parseTraitClause(parser)
  }
  traits
}

fn parseTraitClause(var parser: Parser): TraitClause {
  if parser.isAt(TokenKind.ParenOpen) {
    return parseGroupedTraitClause parser
  }
  const start = parser.span()
  var items = [parseSingleType(parser)]
  const sawTypo = isAtSeparatorTypo parser
  while eatSeparatorTypo(parser) {
    items.append parseSingleType(parser)
  }
  const itemsSpan = start.to parser.previousSpan()
  var delegate: Name? = None
  if parser.isAtWord("by") {
    parser.bump()
    delegate = parser.name()
  }
  if sawTypo {
    reportAmpersandTypo parser, items, delegate, itemsSpan
  }
  TraitClause combineTraitItems(items, itemsSpan), delegate
}

/** `(Add, Subtract, Compare) by value`: several traits delegated together to the same field. */
fn parseGroupedTraitClause(var parser: Parser): TraitClause {
  const group = parseParenthesizedTraitGroup parser
  var delegate: Name? = None
  if parser.isAtWord("by") {
    parser.bump()
    delegate = parser.name()
  } else {
    parser.error "A group without `by` is an error: write the traits without parentheses", group.span
  }
  TraitClause combineTraitItems(group.items, group.span), delegate
}

/** `(Trait, Trait)`: the parenthesised part of a group, before anything decides what a `by` or its absence means. */
fn parseParenthesizedTraitGroup(var parser: Parser): (items: List<TypeReference>, span: Span) {
  const start = parser.span()
  parser.bump()
  const items = parser.commaSeparated TokenKind.ParenClose, parseSingleType
  const span = start.to parser.previousSpan()
  if items.isEmpty() {
    parser.error "A group needs at least one trait: `(Add, Subtract) by value`", span
  }
  (items: items, span: span)
}

fn isAtSeparatorTypo(parser: Parser): Bool {
  parser.isAt(TokenKind.Ampersand) || parser.isAt(TokenKind.Plus)
}

fn eatSeparatorTypo(var parser: Parser): Bool {
  parser.eat(TokenKind.Ampersand) || parser.eat(TokenKind.Plus)
}

/** `with Y & Z` -> "write `with Y, Z`"; `Y & Z by f` -> "write `(Y, Z) by f`". */
fn reportAmpersandTypo(var parser: Parser, items: List<TypeReference>, delegate: Name?, at: Span) {
  const joined = joinedTraitTexts parser, items
  match delegate {
    Some(field) => {
      const message = "Traits delegated to the same field are grouped with parentheses, not `&`: write `({joined}) by {field.text}`"
      parser.error message, at
    }
    None => parser.error "A `with` list separates entries with commas, not `&`: write `with {joined}`", at
  }
}

/** `Y, Z` for the items of an `&`-typo, read back from the source rather than reprinted from the tree. */
fn joinedTraitTexts(parser: Parser, items: List<TypeReference>): String {
  var joined = ""
  for item in items {
    if !joined.isEmpty() {
      joined = joined + ", "
    }
    joined = joined + parser.text(item.span)
  }
  joined
}

/** One or several trait items as the `TypeReference` a [TraitClause] carries. */
fn combineTraitItems(items: List<TypeReference>, at: Span): TypeReference {
  if items.length() == 1 {
    return items[0]
  }
  TypeReference TypeKind.Intersection(items), at
}

fn parseTypeDeclaration(var parser: Parser): DeclarationKind {
  parser.bump()
  const name = parser.name()
  const generics = parseGenericParameters parser
  if parser.eat(TokenKind.Equal) {
    return DeclarationKind.Alias AliasDeclaration(name, generics, parseType(parser))
  }
  const traits = parseDelegatedTraitList parser
  const whereClauses = parseWhereClauses parser
  DeclarationKind.Type TypeDeclaration(name, generics, traits, whereClauses, parseMembers(parser, hasReceiver: true))
}

fn parseTrait(var parser: Parser): DeclarationKind {
  parser.bump()
  const name = parser.name()
  const generics = parseGenericParameters parser
  const supertraits = parseTraitList parser
  DeclarationKind.Trait TraitDeclaration(name, generics, supertraits, parseMembers(parser, hasReceiver: true))
}

fn parseExtend(var parser: Parser): DeclarationKind {
  parser.bump()
  const generics = parseGenericParameters parser
  const target = parseType parser
  const traits = parseTraitList parser
  const whereClauses = parseWhereClauses parser
  DeclarationKind.Extend(ExtendDeclaration(
    generics,
    target,
    traits,
    whereClauses,
    parseMembers(parser, hasReceiver: true),
  ))
}

fn parseForeign(var parser: Parser): DeclarationKind {
  parser.bump()
  const library = parsePlainText parser, "the name of a library"
  DeclarationKind.Foreign ForeignDeclaration(library, parseMembers(parser, hasReceiver: false))
}

/**
 * `{ ... }` of a type, trait or extension. A missing body is an empty one (`native type Bool`). `hasReceiver` is
 * false for a `foreign` block: what it holds are free functions of a C library, with no type to belong to.
 */
fn parseMembers(var parser: Parser, hasReceiver: Bool): List<Member> {
  var members: List<Member> = []
  // The body may start on its own line, after a long `with ...` or `where ...`
  if parser.isAt(TokenKind.Newline) && parser.kindAt(1) == TokenKind.BraceOpen {
    parser.bump()
  }
  if !parser.eat(TokenKind.BraceOpen) {
    return members
  }
  loop {
    parser.skipNewlines()
    if parser.isAt(TokenKind.BraceClose) || parser.isAt(TokenKind.EndOfFile) {
      break
    }
    const before = parser.position
    members.append parseMember(parser, hasReceiver)
    if !parser.isAtEndOfStatement() {
      const found = parser.kind().describe()
      parser.errorHere "Expected the end of the member, found {found}"
      parser.recoverToLineEnd()
    }
    if parser.position == before {
      parser.bump()
    }
  }
  parser.expect TokenKind.BraceClose
  members
}

fn parseMember(var parser: Parser, hasReceiver: Bool): Member {
  const doc = parser.takeDoc()
  const start = parser.span()
  // `public` on a member says what it is already: a member is public unless it is `private`. `public: Bool` is a field
  // named after the keyword, as `private: Bool` is
  if parser.isAtKeyword(Keyword.Public) && parser.kindAt(1) != TokenKind.Colon {
    const note = "Members are public by default: drop `public`, or write `private` to hide one"
    parser.errorWithNote "`public` is what a member is without it", note, parser.span()
  }
  const modifiers = parseModifiers parser
  const kind = match parser.kind() {
    // `type: String`, `case: Int`: a reserved word followed by `:` names a field, which is reached as `self.type`
    .Reserved(_) if hasReceiver
      && parser.kindAt(1) == TokenKind.Colon => MemberKind.Field parseField(parser, isVar: false)
    .Reserved(.Static) if hasReceiver => parseStaticMember parser
    .Reserved(.Fn) => MemberKind.Function parseMethod(parser, hasReceiver, isVar: false)
    .Reserved(.Var) if hasReceiver && parser.kindAt(1) == TokenKind.Reserved(Keyword.Fn) => {
      parser.bump()
      MemberKind.Function parseMethod(parser, hasReceiver: true, isVar: true)
    }
    .Reserved(.Const) => parseConstantMember parser
    .Reserved(.Case) => {
      parser.bump()
      const name = parser.name()
      const fields = if parser.eat(TokenKind.ParenOpen) {
        parser.commaSeparated(TokenKind.ParenClose, { parser => parseField parser, isVar: false })
      } else {
        []
      }
      MemberKind.Case CaseDeclaration(name, fields)
    }
    _ => {
      const isVar = parser.eatKeyword Keyword.Var
      MemberKind.Field parseField(parser, isVar)
    }
  }
  Member doc, modifiers, kind, start.to(parser.previousSpan())
}

/**
 * `fn area(): Int` and `var fn translate(deltaX: Int)`: the receiver is not written, so it is put back here. Its
 * span is the name of the function, which is where a message about the receiver has to point.
 */
fn parseMethod(var parser: Parser, hasReceiver: Bool, isVar: Bool): FunctionDeclaration {
  const function = parseFunction parser, isMember: hasReceiver
  if !hasReceiver {
    return function
  }
  var parameters = [
    Parameter(
      doc: None,
      name: Name("self", function.name.span),
      var: isVar,
      variadic: false,
      type: None,
      default: None,
    ),
  ]
  parameters.appendAll function.parameters
  function.copy parameters: parameters
}

/**
 * `static origin = Point(0, 0)`, `static fn square(size: Int): Self`. A constant is what a `static` member is without
 * a word of its own, so `static const origin = ...` is an error that says so.
 */
fn parseStaticMember(var parser: Parser): MemberKind {
  const keyword = parser.span()
  parser.bump()
  if parser.isAtKeyword(Keyword.Var) {
    const at = keyword.to parser.span()
    parser.bump()
    const note = "A type has no mutable state: what belongs to the type is a constant of it"
    parser.errorWithNote "`{staticKeyword} var` does not exist", note, at
  } else if parser.isAtKeyword(Keyword.Const) {
    const at = keyword.to parser.span()
    parser.bump()
    const note = "What belongs to the type is a constant of it: write `{staticKeyword} name = ...`"
    parser.errorWithNote "`const` is what a `{staticKeyword}` member is without it", note, at
  }
  if parser.isAt(TokenKind.Reserved(Keyword.Fn)) {
    return MemberKind.Function parseFunction(parser, isMember: true)
  }
  // `static zero: Self` without a value is what a trait requires of its implementations. Whether the member stands in a
  // trait is the checker's question: the parser only knows it has a name and a type and no `=`
  MemberKind.Constant parseBindingBody(parser, doc: None, isVar: false, valueOptional: true)
}

/**
 * `const x: Int` is the field `x: Int` with the word it has without it, so the word is an error that says so. Without
 * a type it names neither reading, and the message offers both.
 */
fn parseConstantMember(var parser: Parser): MemberKind {
  const keyword = parser.span()
  parser.bump()
  if parser.kindAt(1) == TokenKind.Colon {
    const note = "A field is `const` unless it is `var`: write `{parser.text(parser.span())}: ...`"
    parser.errorWithNote "`const` is what a field is without it", note, keyword
  } else {
    const name = parser.name()
    const at = keyword.to name.span
    const note = "A field is `{name.text}: Type`, a constant of the type is `{staticKeyword} {name.text} = ...`"
    parser.errorWithNote "`{name.text}` is neither a field nor a constant of the type", note, at
    const annotation = TypeReference TypeKind.Invalid, name.span
    const default = if parser.eat(TokenKind.Equal) {
      Some parser.withTrailingClosures(allowed: true, parseInner: parseCommandExpression)
    } else {
      None
    }
    return MemberKind.Field Field(doc: None, name: name, var: false, type: annotation, default: default)
  }
  MemberKind.Field parseField(parser, isVar: false)
}

/** A field of a type or of a case. Its name may be a reserved word (`type: String`): a field is reached after a `.`. */
fn parseField(var parser: Parser, isVar: Bool): Field {
  const doc = parser.takeDoc()
  const name = parser.nameOrKeyword()
  parser.expect TokenKind.Colon
  const annotation = parseType parser
  const default = if parser.eat(TokenKind.Equal) {
    Some parser.withTrailingClosures(allowed: true, parseInner: parseCommandExpression)
  } else {
    None
  }
  Field doc, name, isVar, annotation, default
}
