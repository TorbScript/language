use TokenKind, Keyword, TextPart from "../token"
use Declaration, DeclarationKind, Modifiers, Visibility, UseDeclaration, UseItem, UseItems, UseSource from "../ast"
use FunctionDeclaration, Parameter, GenericParameter, WhereClause, TypeReference, TraitClause from "../ast"
use TypeDeclaration, AliasDeclaration, TraitDeclaration, ExtendDeclaration, ForeignDeclaration from "../ast"
use Member, MemberKind, Field, CaseDeclaration, Name from "../ast"
use Parser from "./parser"
use parseBlock, parseBinding from "./statements"
use parseType, parseSingleType from "./types"
use parseExpression, parseCommandExpression from "./expressions"

/** `fn`, `type`, `trait`, `extend`, `use`, `foreign`, with their modifiers. */
public fn parseDeclaration(var parser: Parser): Declaration {
  const doc = parser.takeDoc()
  const start = parser.span()
  const modifiers = parseModifiers parser
  const kind = match parser.kind() {
    .Reserved(.Use) => parseUse parser
    .Reserved(.Fn) => DeclarationKind.Function parseFunction(parser)
    .Reserved(.Type) => parseTypeDeclaration parser
    .Reserved(.Trait) => parseTrait parser
    .Reserved(.Extend) => parseExtend parser
    .Reserved(.Foreign) => parseForeign parser
    .Reserved(.Const | .Var) => parseConstant parser, modifiers
    other => {
      parser.errorHere "Expected a declaration (`fn`, `type`, `trait`, `extend`, `use`), found {other.describe()}"
      DeclarationKind.Use UseDeclaration(UseItems.Names([]), UseSource.Module(""))
    }
  }
  Declaration doc, modifiers, kind, start.to(parser.previousSpan())
}

fn parseModifiers(var parser: Parser): Modifiers {
  var modifiers = Modifiers()
  loop {
    match parser.kind() {
      .Reserved(.Public) => {
        modifiers = modifiers.copy visibility: Visibility.Public
      }
      .Reserved(.Private) => {
        // `private(var) balance: Int`
        if parser.kindAt(1) == TokenKind.ParenOpen && parser.kindAt(2) == TokenKind.Reserved(Keyword.Var) {
          parser.bump()
          parser.bump()
          parser.bump()
          parser.expect TokenKind.ParenClose
          modifiers = modifiers.copy visibility: Visibility.PrivateVar
          continue
        }
        modifiers = modifiers.copy visibility: Visibility.Private
      }
      .Reserved(.Native) => {
        modifiers = modifiers.copy isNative: true
      }
      .Reserved(.Shared) => {
        modifiers = modifiers.copy isShared: true
      }
      _ => {
        break
      }
    }
    parser.bump()
  }
  modifiers
}

/**
 * `public const pi = 3.14` at the top level of a module. `public var` is an error: a module has no mutable state,
 * so there is nothing a top-level `var` could export.
 */
fn parseConstant(var parser: Parser, modifiers: Modifiers): DeclarationKind {
  const binding = parseBinding parser
  if binding.isVar && modifiers.visibility == Visibility.Public {
    parser.error "A module has no mutable state: only `const` can be public", binding.pattern.span
  }
  DeclarationKind.Constant binding
}

/** `use A, B from "./file"`, `use Option.Some from "./option"`, `use Shape.Circle`, `use * as http from "std/http"` */
fn parseUse(var parser: Parser): DeclarationKind {
  parser.bump()
  // `use "acme/text"`: nothing runs when a module is imported, so a `use` without names would mean nothing
  if const .TextLiteral(_) = parser.kind() {
    const start = parser.span()
    const path = parsePlainText parser, "the path of a module"
    const note = "Write the names: `use Name from \"{path}\"`, a member of a type `use String.shout from \"{path}\"`"
    parser.errorWithNote "A `use` names what it imports", note, start.to(parser.previousSpan())
    return DeclarationKind.Use UseDeclaration(UseItems.Names([]), UseSource.Module(path))
  }
  const items = if parser.eat(TokenKind.Star) {
    if parser.isAtWord("as") {
      parser.bump()
    } else {
      parser.errorHere "`use *` needs a name: `use * as name from \"...\"`"
    }
    UseItems.All parser.name()
  } else {
    var items = [parseUseItem(parser)]
    while parser.eat(TokenKind.Comma) {
      items.add parseUseItem(parser)
    }
    UseItems.Names items
  }
  if parser.isAtWord("from") {
    parser.bump()
  } else {
    // `use Shape.Circle`: without `from` every path is resolved in this file's own scope, which is what a type
    // declared here needs. A path of one segment would rebind something that is in scope already.
    if isLocalUse(items) {
      return DeclarationKind.Use UseDeclaration(items, UseSource.Local)
    }
    parser.errorHere "Expected `from \"...\"`"
  }
  // `use Some, None from Option` is gone: after `from` there is always a module
  if parser.isAt(TokenKind.Identifier) {
    const start = parser.span()
    var path = [parser.name()]
    while parser.isAt(TokenKind.Dot) && parser.kindAt(1) == TokenKind.Identifier {
      parser.bump()
      path.add parser.name()
    }
    const at = start.to parser.previousSpan()
    const message = typeSourceMessage path, items
    parser.error message, at
    return DeclarationKind.Use UseDeclaration(items, UseSource.Module(""))
  }
  DeclarationKind.Use UseDeclaration(items, UseSource.Module(parsePlainText(parser, "the path of a module")))
}

/** `Option.Some as Just`: one item of a `use` list, with its path and the local name it is to get. */
fn parseUseItem(var parser: Parser): UseItem {
  var path = [parser.name()]
  while parser.isAt(TokenKind.Dot) && parser.kindAt(1) == TokenKind.Identifier {
    parser.bump()
    path.add parser.name()
  }
  // `use A as B from "..."`: `as` is a word, not a keyword, so a type named `as` stays possible
  if !parser.isAtWord("as") {
    return UseItem path, None
  }
  parser.bump()
  UseItem path, Some(parser.name())
}

/**
 * Whether a `use` without `from` is the local form: every item names a type of this file and a case of it
 * (`use Shape.Circle`). A single bare name would rebind what is in scope already, so that stays a missing `from`.
 */
fn isLocalUse(items: UseItems): Bool {
  match items {
    .Names(names) => !names.isEmpty() && names.all({ _.path.length() > 1 })
    _ => false
  }
}

/** `use Some, None from Option` was the old spelling of a case import. The message teaches the path form instead. */
fn typeSourceMessage(path: List<Name>, items: UseItems): String {
  const owner = path.map({ _.text }).toList().joined(separator: ".")
  const message = "`from` takes a module in quotes, not the type `{owner}`"
  if const .Names(names) = items {
    if const Some(first) = names.get(0) {
      return "{message}: a case is imported by its path, `use {owner}.{first.name().text} from \"...\"`"
    }
  }
  message
}

/** A string literal without interpolation. */
fn parsePlainText(var parser: Parser, what: String): String {
  match parser.kind() {
    .TextLiteral(parts) => {
      parser.bump()
      if const [.Literal(text)] = parts {
        return text
      }
      const at = parser.previousSpan()
      parser.error "Expected {what} as a plain string, without `\{...\}`", at
    }
    other => parser.errorHere "Expected {what} as a string, found {other.describe()}"
  }
  ""
}

/** The position is at `fn`. */
public fn parseFunction(var parser: Parser): FunctionDeclaration {
  parser.bump()
  const name = parser.name()
  const generics = parseGenericParameters parser
  parser.expect TokenKind.ParenOpen
  const parameters = parser.withTrailingClosures(true, { parser => parser.commaSeparated TokenKind.ParenClose, parseParameter })
  const returnType = if parser.eat(TokenKind.Colon) { Some parseType(parser) } else { None }
  const whereClauses = parseWhereClauses parser
  const body = if parser.isAt(TokenKind.BraceOpen) { Some parseBlock(parser) } else { None }
  FunctionDeclaration name, generics, parameters, returnType, whereClauses, body
}

fn parseParameter(var parser: Parser): Parameter {
  const doc = parser.takeDoc()
  const isVariadic = parser.eat TokenKind.Ellipsis
  const isVar = parser.eatKeyword Keyword.Var
  const name = if parser.isAtKeyword(Keyword.SelfValue) { parser.nameOrKeyword() } else { parser.name() }
  const annotation = if parser.eat(TokenKind.Colon) { Some parseType(parser) } else { None }
  if annotation.isNone() && name.text != "self" && !name.text.isEmpty() {
    parser.error "The parameter `{name.text}` needs a type", name.span
  }
  const default = if parser.eat(TokenKind.Equal) { Some parseExpression(parser) } else { None }
  Parameter doc, name, isVar, isVariadic, annotation, default
}

/** `<Key: Hash & Equals, Value = Self>`, `<const Size: Int>` */
fn parseGenericParameters(var parser: Parser): List<GenericParameter> {
  if !parser.eat(TokenKind.Less) {
    return []
  }
  parser.commaSeparated TokenKind.Greater, parseGenericParameter
}

fn parseGenericParameter(var parser: Parser): GenericParameter {
  const isConst = parser.eatKeyword Keyword.Const
  const name = parser.name()
  const bounds = if parser.eat(TokenKind.Colon) { parseBounds parser } else { [] }
  if isConst && bounds.length() != 1 {
    parser.error "A const parameter needs a type: `const {name.text}: Int`", name.span
  }
  const default = if parser.eat(TokenKind.Equal) { Some parseType(parser) } else { None }
  GenericParameter isConst, name, bounds, default
}

/** `Hash & Equals` */
fn parseBounds(var parser: Parser): List<TypeReference> {
  var bounds = [parseSingleType(parser)]
  if parser.isAt(TokenKind.Plus) {
    parser.errorHere "Traits are combined with `&`: `Compare & Show`"
  }
  while parser.eat(TokenKind.Ampersand) || parser.eat(TokenKind.Plus) {
    bounds.add parseSingleType(parser)
  }
  bounds
}

/** `where Key: Hash, Value: Show` */
fn parseWhereClauses(var parser: Parser): List<WhereClause> {
  var clauses: List<WhereClause> = []
  if !parser.eatKeyword(Keyword.Where) {
    return clauses
  }
  loop {
    const subject = parseType parser
    parser.expect TokenKind.Colon
    clauses.add WhereClause(subject, parseBounds(parser))
    if !parser.eat(TokenKind.Comma) {
      break
    }
  }
  clauses
}

/**
 * `with Add, Compare`, for a `trait`'s supertraits and an `extend`'s implementations - neither has a field of its
 * own to delegate to, so a stray `by` is rejected here rather than parsed and ignored.
 */
fn parseTraitList(var parser: Parser): List<TypeReference> {
  if !parser.eatKeyword(Keyword.With) {
    return []
  }
  var traits = [parseType(parser)]
  while parser.eat(TokenKind.Comma) {
    traits.add parseType(parser)
  }
  if parser.isAtWord("by") {
    parser.errorHere "`by` delegates to a field: only a `type` has fields to name"
    parser.bump()
    parser.name()
  }
  traits
}

/**
 * `with Show, Add & Subtract by value, Compare by value`: `by` binds to the one element directly in front of it,
 * which may be an `&` group.
 */
fn parseDelegatedTraitList(var parser: Parser): List<TraitClause> {
  if !parser.eatKeyword(Keyword.With) {
    return []
  }
  var traits = [parseTraitClause(parser)]
  while parser.eat(TokenKind.Comma) {
    traits.add parseTraitClause(parser)
  }
  traits
}

fn parseTraitClause(var parser: Parser): TraitClause {
  const capability = parseType parser
  var delegate: Name? = None
  if parser.isAtWord("by") {
    parser.bump()
    delegate = Some parser.name()
  }
  TraitClause capability, delegate
}

fn parseTypeDeclaration(var parser: Parser): DeclarationKind {
  parser.bump()
  const name = parser.name()
  const generics = parseGenericParameters parser
  if parser.eat(TokenKind.Equal) {
    return DeclarationKind.Alias AliasDeclaration(name, generics, parseType(parser))
  }
  const traits = parseDelegatedTraitList parser
  const whereClauses = parseWhereClauses parser
  DeclarationKind.Type TypeDeclaration(name, generics, traits, whereClauses, parseMembers(parser))
}

fn parseTrait(var parser: Parser): DeclarationKind {
  parser.bump()
  const name = parser.name()
  const generics = parseGenericParameters parser
  const supertraits = parseTraitList parser
  DeclarationKind.Trait TraitDeclaration(name, generics, supertraits, parseMembers(parser))
}

fn parseExtend(var parser: Parser): DeclarationKind {
  parser.bump()
  const generics = parseGenericParameters parser
  const target = parseType parser
  const traits = parseTraitList parser
  const whereClauses = parseWhereClauses parser
  DeclarationKind.Extend ExtendDeclaration(generics, target, traits, whereClauses, parseMembers(parser))
}

fn parseForeign(var parser: Parser): DeclarationKind {
  parser.bump()
  const library = parsePlainText parser, "the name of a library"
  DeclarationKind.Foreign ForeignDeclaration(library, parseMembers(parser))
}

/** `{ ... }` of a type, trait or extension. A missing body is an empty one (`native type Bool`). */
fn parseMembers(var parser: Parser): List<Member> {
  var members: List<Member> = []
  // The body may start on its own line, after a long `with ...` or `where ...`
  if parser.isAt(TokenKind.Newline) && parser.kindAt(1) == TokenKind.BraceOpen {
    parser.bump()
  }
  if !parser.eat(TokenKind.BraceOpen) {
    return members
  }
  loop {
    parser.skipNewlines()
    if parser.isAt(TokenKind.BraceClose) || parser.isAt(TokenKind.EndOfFile) {
      break
    }
    const before = parser.position
    members.add parseMember(parser)
    if !parser.isAtEndOfStatement() {
      const found = parser.kind().describe()
      parser.errorHere "Expected the end of the member, found {found}"
      parser.recoverToLineEnd()
    }
    if parser.position == before {
      parser.bump()
    }
  }
  parser.expect TokenKind.BraceClose
  members
}

fn parseMember(var parser: Parser): Member {
  const doc = parser.takeDoc()
  const start = parser.span()
  const modifiers = parseModifiers parser
  const kind = match parser.kind() {
    .Reserved(.Fn) => MemberKind.Function parseFunction(parser)
    .Reserved(.Const) => MemberKind.Constant parseBinding(parser)
    .Reserved(.Case) => {
      parser.bump()
      const name = parser.name()
      const fields = if parser.eat(TokenKind.ParenOpen) {
        parser.commaSeparated(TokenKind.ParenClose, { parser => parseField parser, isVar: false })
      } else {
        []
      }
      MemberKind.Case CaseDeclaration(name, fields)
    }
    _ => {
      const isVar = parser.eatKeyword Keyword.Var
      MemberKind.Field parseField(parser, isVar)
    }
  }
  Member doc, modifiers, kind, start.to(parser.previousSpan())
}

fn parseField(var parser: Parser, isVar: Bool): Field {
  const doc = parser.takeDoc()
  const name = parser.name()
  parser.expect TokenKind.Colon
  const annotation = parseType parser
  const default = if parser.eat(TokenKind.Equal) {
    Some parser.withTrailingClosures(true, parseCommandExpression)
  } else {
    None
  }
  Field doc, name, isVar, annotation, default
}
