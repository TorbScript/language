/**
 * The grammar of statements: [parseStatementsUntil] for the body of a file or a [parseBlock], and [parseBinding]
 * for `const`/`var`. Everything that is not one of the keyword forms falls through to a command expression, so an
 * assignment and a bare call share one arm at the bottom of [parseStatement] - except `using name = value`, whose
 * `using` is a keyword only in front of a name and an `=` ([isAtUsingBinding]).
 */

use Span from "../source"
use TokenKind, Keyword from "../token"
use Statement, StatementKind, Binding, Block, Condition, Expression, ExpressionKind from "../ast"
use Parser from "./parser"
use parseDeclaration, isAtProtectedDeclaration, isAtDeprecatedDeclaration from "./declarations"
use parseType from "./types"
use parsePattern from "./patterns"
use parseExpression, parseCommandExpression from "./expressions"

/** The statements of a file (up to `EndOfFile`) or of a block (up to `BraceClose`). */
public fn parseStatementsUntil(var parser: Parser, end: TokenKind): List<Statement> {
  var statements: List<Statement> = []
  loop {
    parser.skipNewlines()
    if parser.isAt(end) || parser.isAt(TokenKind.EndOfFile) {
      break
    }
    const before = parser.position
    statements.append parseStatement(parser)
    if !parser.isAtEndOfStatement() {
      const found = parser.kind().describe()
      parser.errorHere "Expected the end of the statement, found {found}"
      parser.recoverToLineEnd()
    }
    if parser.position == before {
      parser.bump()
    }
  }
  statements
}

/** `{ statements }`. Expects the opening brace itself; [parseBlockAfterBrace] is for a caller that consumed it already. */
public fn parseBlock(var parser: Parser): Block {
  const start = parser.span()
  if !parser.expect(TokenKind.BraceOpen) {
    return Block([], start)
  }
  parseBlockAfterBrace parser, start
}

/** The rest of a block whose `{` is consumed already. `start` is the span of that `{`. */
public fn parseBlockAfterBrace(var parser: Parser, start: Span): Block {
  const statements = parser.withTrailingClosures(
    allowed: true,
    parseInner: { parser => parseStatementsUntil parser, TokenKind.BraceClose },
  )
  parser.expect TokenKind.BraceClose
  Block statements, start.to(parser.previousSpan())
}

fn parseStatement(var parser: Parser): Statement {
  const start = parser.span()
  // `type = "click"` in a receiver closure or a method: a bare keyword always begins its own construct, so a field named
  // after one is written through `self`. `self = ...` itself is the checker's message about replacing the receiver
  if const .Reserved(keyword) = parser.kind() {
    if parser.kindAt(1) == TokenKind.Equal && keyword != Keyword.SelfValue {
      const word = parser.text parser.span()
      const note = "A field named after a keyword is reached through `self`: `self.{word} = ...`"
      parser.errorWithNote "`{word}` is a keyword and cannot be assigned bare", note, parser.span()
      parser.recoverToLineEnd()
      const invalid = Expression ExpressionKind.Invalid, start
      return Statement StatementKind.Evaluate(invalid), start.to(parser.previousSpan())
    }
  }
  // `protected fn probe()`: the word write-protects a field of a type, and in front of anything else it is refused and
  // the declaration after it read as if it were not there
  if isAtProtectedDeclaration(parser) {
    const note = "It says that everybody reads a field and only the file of its type writes it."
      + " Write `private` to hide the declaration"
    parser.errorWithNote "`protected` is only a modifier of a field", note, parser.span()
    parser.bump()
  }
  // `deprecated("...")` on the line above a declaration is its clause, and not a call
  if isAtDeprecatedDeclaration(parser) {
    return Statement StatementKind.Declare(parseDeclaration(parser)), start.to(parser.previousSpan())
  }
  const kind = match parser.kind() {
    .Reserved(.Public | .Private | .Native | .Shared | .Fn | .Type | .Trait | .Extend | .Use | .Foreign) => {
      StatementKind.Declare parseDeclaration(parser)
    }
    .Reserved(.Const | .Var) => StatementKind.Bind parseBinding(parser)
    .Reserved(.For) => parseFor parser
    .Reserved(.While) => {
      parser.bump()
      const condition = parseCondition parser
      StatementKind.While condition, parseBlock(parser)
    }
    .Reserved(.Loop) => {
      parser.bump()
      StatementKind.Loop parseBlock(parser)
    }
    .Reserved(.Return) => {
      parser.bump()
      if parser.isAtEndOfStatement() {
        StatementKind.Return None
      } else {
        StatementKind.Return parseCommandExpression(parser)
      }
    }
    .Reserved(.Break) => {
      parser.bump()
      StatementKind.Break
    }
    .Reserved(.Continue) => {
      parser.bump()
      StatementKind.Continue
    }
    _ => {
      if isAtUsingBinding(parser) {
        return Statement StatementKind.Bind(parseUsingBinding(parser)), start.to(parser.previousSpan())
      }
      const target = parseCommandExpression parser
      if parser.eat(TokenKind.Equal) {
        StatementKind.Assign target, parseCommandExpression(parser)
      } else {
        StatementKind.Evaluate target
      }
    }
  }
  Statement kind, start.to(parser.previousSpan())
}

/** `const x: Int = 1`, `var (a, b) = pair`. The position is at `const` or `var`. */
public fn parseBinding(var parser: Parser): Binding {
  const doc = parser.takeDoc()
  const isVar = parser.isAtKeyword Keyword.Var
  parser.bump()
  parseBindingBody parser, doc, isVar
}

/**
 * `using file = File.open(path)?`. `using` is a contextual keyword: a binding only where a name and an `=` (or a `:`
 * and a type) follow it, so every other `using` is still a name.
 */
fn isAtUsingBinding(parser: Parser): Bool {
  if !parser.isAtWord("using") || parser.kindAt(1) != TokenKind.Identifier {
    return false
  }
  parser.kindAt(2) == TokenKind.Equal || parser.kindAt(2) == TokenKind.Colon
}

/** `using name = value`: a `const` whose name may not escape its block. The position is at `using`. */
fn parseUsingBinding(var parser: Parser): Binding {
  const doc = parser.takeDoc()
  parser.bump()
  const binding = parseBindingBody parser, doc, isVar: false
  Binding binding.doc, var: false, pattern: binding.pattern, type: binding.type, value: binding.value, scoped: true
}

/**
 * The part of a binding behind its keyword: `name: Type = value`. A constant of a type is written
 * `static name = value`, so its binding starts here and not at a `const`.
 *
 * `valueOptional` is for that constant of a type: `static zero: Self` with a type and without a value is a binding the
 * checker holds to be the requirement of a trait ([Binding.required]).
 */
public fn parseBindingBody(var parser: Parser, doc: String?, isVar: Bool, valueOptional: Bool = false): Binding {
  const pattern = parsePattern parser
  const annotation = if parser.eat(TokenKind.Colon) { Some parseType(parser) } else { None }
  if valueOptional && annotation.isSome() && !parser.isAt(TokenKind.Equal) {
    const missing = Expression ExpressionKind.Invalid, parser.previousSpan()
    return Binding doc, isVar, pattern, annotation, missing, required: true
  }
  if !parser.isAt(TokenKind.Equal) {
    parser.errorHere "A binding needs a value: there are no uninitialized bindings and no default values"
    return Binding doc, isVar, pattern, annotation, Expression(ExpressionKind.Invalid, parser.span())
  }
  parser.bump()
  Binding doc, isVar, pattern, annotation, parseCommandExpression(parser)
}

fn parseFor(var parser: Parser): StatementKind {
  parser.bump()
  const pattern = parsePattern parser
  parser.expect TokenKind.Reserved(Keyword.In)
  const iterable = parseHeadExpression parser
  StatementKind.For pattern, iterable, parseBlock(parser)
}

/** The head of `if` and `while`. */
public fn parseCondition(var parser: Parser): Condition {
  if parser.isAtKeyword(Keyword.Const) || parser.isAtKeyword(Keyword.Var) {
    const isVar = parser.isAtKeyword Keyword.Var
    parser.bump()
    const pattern = parsePattern parser
    parser.expect TokenKind.Equal
    return Condition.Bind isVar, pattern, parseHeadExpression(parser)
  }
  Condition.Test parseHeadExpression(parser)
}

/** An expression in front of a `{` that belongs to the statement. */
public fn parseHeadExpression(var parser: Parser): Expression {
  parser.withTrailingClosures allowed: false, parseInner: parseExpression
}
