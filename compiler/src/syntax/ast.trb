/**
 * The syntax tree: [SourceFile] down to every statement, expression and pattern. It mirrors the source exactly -
 * nothing is resolved, desugared or checked here - and every node a diagnostic can point to carries its [Span].
 *
 * The parser (`./parser`) builds this tree from the tokens of the lexer, `dump.trb` prints those tokens, and every
 * later pass - name resolution, the type checker, the lowering to IR - starts here.
 */

use Span from "./source"

/** One file: its top-level statements, in the order they were written. */
public type SourceFile {
  statements: List<Statement>
}

/** An identifier as written in the source: its text and the span it occupies. */
public type Name {
  text: String
  span: Span
}

// --- Declarations -------------------------------------------------------------------------------------------------------

/** Who may see a declaration or a member. */
public type Visibility {
  /** Members: public. Top-level declarations: private to the file. */
  case Default
  case Public
  case Private
  /** `private(var)`: everybody reads, only the type writes. */
  case PrivateVar
}

/** The modifiers a declaration or a member can carry, besides its kind: `public`, `native`, `shared`. */
public type Modifiers {
  visibility: Visibility = Visibility.Default
  isNative: Bool = false
  isShared: Bool = false
}

/** One top-level construct of a file: what it is ([DeclarationKind]), its modifiers, and its doc comment. */
public type Declaration {
  /** The doc comment in front of the declaration */
  doc: String?
  modifiers: Modifiers
  kind: DeclarationKind
  span: Span
}

/** The seven things a top-level declaration can be. */
public type DeclarationKind {
  case Use(declaration: UseDeclaration)
  case Function(declaration: FunctionDeclaration)
  case Type(declaration: TypeDeclaration)
  case Alias(declaration: AliasDeclaration)
  case Trait(declaration: TraitDeclaration)
  case Extend(declaration: ExtendDeclaration)
  case Foreign(declaration: ForeignDeclaration)
  /**
   * `public const pi = 3.14` at the top level of a module. `public var` is an error: a module has no mutable
   * state. `Binding.doc` is always `None` here, the doc comment is `Declaration.doc`.
   */
  case Constant(binding: Binding)
}

/** `use <items> from <source>`: what is imported, and where it comes from. */
public type UseDeclaration {
  items: UseItems
  source: UseSource
}

/** Where a `use` reads its items from. */
public type UseSource {
  /** `from "./file"`, `from "std/fs"` */
  case Module(path: String)
  /** `use Shape.Circle`: no `from`, so every path is resolved in the file's own scope */
  case Local
}

/**
 * One item of a `use` list: a path and the local name it gets (`Option.Some as Just`). The last segment is what is
 * imported, the ones before it the type it is a case of. Every name carries its own span, so a message about the export
 * points at the export and one about the local name at the alias.
 */
public type UseItem {
  path: List<Name>
  alias: Name?

  /** The name that is imported: the last segment of the path. */
  fn name(): Name {
    path[path.length() - 1]
  }

  /** The name the importing file sees. Everything about the *export* keeps naming `name()` instead. */
  fn localName(): Name {
    alias ?? name()
  }
}

/** What a `use` names: a list of items, or `*` for everything a module exports. */
public type UseItems {
  case Names(items: List<UseItem>)
  /** `use * as http from "..."` */
  case All(alias: Name)
}

/** One `<Name>` between the angle brackets of a generic declaration. */
public type GenericParameter {
  /** `<const Size: Int>`: a value instead of a type. Its type is the only item of `bounds`. */
  isConst: Bool
  name: Name
  bounds: List<TypeReference>
  default: TypeReference?
}

/** One clause of a `where` list: `where Item: Hash & Compare`. */
public type WhereClause {
  subject: TypeReference
  bounds: List<TypeReference>
}

/** A `fn`: its name, its generics, its parameters and result, and the body it runs. */
public type FunctionDeclaration {
  name: Name
  generics: List<GenericParameter>
  parameters: List<Parameter>
  returnType: TypeReference?
  whereClauses: List<WhereClause>
  /** `None` for `native` functions and for requirements of a trait. */
  body: Block?
}

/** One parameter of a function: `self`, `var self`, or a name with its type and an optional default. */
public type Parameter {
  doc: String?
  name: Name
  isVar: Bool
  /** `...items: Item` */
  isVariadic: Bool
  /** `self` and `var self` have no annotation. */
  annotation: TypeReference?
  default: Expression?
}

/** A `type`: its name, its generics, the traits it comes `with`, and its members. */
public type TypeDeclaration {
  name: Name
  generics: List<GenericParameter>
  traits: List<TraitClause>
  whereClauses: List<WhereClause>
  members: List<Member>
}

/**
 * One element of a `with` list: `(Add, Subtract) by value` is one clause, its capability an intersection of two
 * traits. `by` binds to this element alone, not to the list (`with Show, (Add, Subtract) by value, Compare by
 * value` derives `Show` and delegates the other two, each to `value`).
 */
public type TraitClause {
  capability: TypeReference
  delegate: Name?
}

/** `type Name<Generics> = target`: a name for another type. */
public type AliasDeclaration {
  name: Name
  generics: List<GenericParameter>
  target: TypeReference
}

/** A `trait`: its name, the traits it requires (`supertraits`), and its members. */
public type TraitDeclaration {
  name: Name
  generics: List<GenericParameter>
  supertraits: List<TypeReference>
  members: List<Member>
}

/** `extend Target with Trait { ... }`: members added to a type that already exists. */
public type ExtendDeclaration {
  generics: List<GenericParameter>
  target: TypeReference
  traits: List<TypeReference>
  whereClauses: List<WhereClause>
  members: List<Member>
}

/** `foreign "library" { ... }`: declarations implemented outside of TorbScript. */
public type ForeignDeclaration {
  library: String
  members: List<Member>
}

/** One member of a `type`, a `trait`, an `extend` or a `foreign` block. */
public type Member {
  doc: String?
  modifiers: Modifiers
  kind: MemberKind
  span: Span
}

/** The four things a member can be. */
public type MemberKind {
  case Field(field: Field)
  case Constant(binding: Binding)
  case Function(declaration: FunctionDeclaration)
  case Case(declaration: CaseDeclaration)
}

/** One field of a `type` or of a `case`: its name, its type, and a default if it has one. */
public type Field {
  /** Only for the fields of a case. The doc comment of a field of a type belongs to its `Member`. */
  doc: String?
  name: Name
  isVar: Bool
  annotation: TypeReference
  default: Expression?
}

/** One `case Name(fields)` of a `type`. */
public type CaseDeclaration {
  name: Name
  fields: List<Field>
}

// --- Types --------------------------------------------------------------------------------------------------------------

/** A type as it is written in the source: what it is ([TypeKind]) and where it stands. */
public type TypeReference {
  kind: TypeKind
  span: Span
}

/** The shapes a written type can take. */
public type TypeKind {
  /** `List<Item>`, `http.Response`, `Self` */
  case Named(path: List<Name>, arguments: List<TypeReference>)
  /** `Item?` */
  case Optional(inner: TypeReference)
  /** `(Int, String)`, `(lowest: Int, highest: Int)` */
  case TupleType(fields: List<TupleTypeField>)
  /** `"online" | "offline"`. A single literal is also a const argument: `Array<Float, 16>` */
  case Literals(values: List<Expression>)
  /** `Show & Encode`: a value that implements all of these traits */
  case Intersection(members: List<TypeReference>)
  case FunctionType(parameters: List<FunctionTypeParameter>, result: TypeReference)
  /** `lazy Value`, only as the type of a parameter */
  case Lazy(inner: TypeReference)
  case Invalid
}

/** One field of `TypeKind.TupleType`, labeled or not. */
public type TupleTypeField {
  label: Name?
  annotation: TypeReference
}

/** One parameter of `TypeKind.FunctionType`: named or not, `var` or not. */
public type FunctionTypeParameter {
  name: Name?
  isVar: Bool
  annotation: TypeReference
}

// --- Statements ---------------------------------------------------------------------------------------------------------

/** `{ ... }`: a sequence of statements between braces, the body of a function, an `if`, a loop or a `match` arm. */
public type Block {
  statements: List<Statement>
  span: Span
}

/** One line of a [Block]: what it does ([StatementKind]) and where it stands. */
public type Statement {
  kind: StatementKind
  span: Span
}

/** The things a statement can be. */
public type StatementKind {
  case Declare(declaration: Declaration)
  case Bind(binding: Binding)
  case Assign(target: Expression, value: Expression)
  case For(pattern: Pattern, iterable: Expression, body: Block)
  case While(condition: Condition, body: Block)
  /** The endless loop, with no condition of its own: nothing after it runs unless a `break` targets it. */
  case Loop(body: Block)
  case Return(value: Expression?)
  case Break
  case Continue
  case Evaluate(expression: Expression)
}

/** `const x: Int = 1`, `var (a, b) = pair`, `using file = File.open(path)?` */
public type Binding {
  /**
   * The doc comment in front of a top-level `const`/`var` **statement** (`StatementKind.Bind`). `None` when this
   * binding is the payload of a `Declaration` or a `Member`: the doc comment belongs to that instead, so it is
   * never duplicated.
   */
  doc: String?
  isVar: Bool
  pattern: Pattern
  annotation: TypeReference?
  value: Expression
  /**
   * `using name = value`: a `const` whose name may not outlive the block it is written in - not stored, returned,
   * bound to another name or captured by a closure that escapes (docs/design/DESTRUCTORS.md section 4).
   */
  scoped: Bool = false
  /**
   * `static zero: Self` in a trait: a constant the trait requires and every implementation provides, written without a
   * value. `value` is then an `Invalid` expression at the end of the binding, which nothing evaluates.
   */
  required: Bool = false
}

/** The head of `if` and `while`: an expression, or a pattern binding (`if const Some(x) = lookup()`). */
public type Condition {
  case Test(expression: Expression)
  case Bind(isVar: Bool, pattern: Pattern, value: Expression)
}

// --- Expressions --------------------------------------------------------------------------------------------------------

/** An expression: what it computes ([ExpressionKind]) and where it stands. */
public type Expression {
  kind: ExpressionKind
  span: Span
}

/** Every shape an expression can take, from a literal to a `match`. */
public type ExpressionKind {
  case IntegerLiteral(text: String)
  case FloatLiteral(text: String)
  case BoolLiteral(value: Bool)
  /** `void`: the one value of `Void` */
  case VoidLiteral
  case CharLiteral(value: Char)
  case TextLiteral(segments: List<TextSegment>)
  /** A name, including `_`, `_2`, `self` and `Self` */
  case Name(text: String)
  /** `.Circle`: a case of the type that is expected here */
  case ImplicitMember(name: Name)
  /** `List<Int>` in front of `.of(...)` or `(...)` */
  case Generic(target: Expression, arguments: List<TypeReference>)
  /** `(1, "one")`, `(lowest: 1, highest: 9)` */
  case TupleLiteral(items: List<Argument>)
  case ListLiteral(items: List<Argument>)
  case MapLiteral(entries: List<(Expression, Expression)>)
  case Member(target: Expression, name: Name, isOptional: Bool)
  case Index(target: Expression, index: Expression)
  case Call(callee: Expression, arguments: List<Argument>, style: CallStyle)
  case Unary(operator: PrefixOperator, operand: Expression)
  case Binary(operator: InfixOperator, left: Expression, right: Expression)
  case RangeLiteral(start: Expression?, end: Expression?, isInclusive: Bool)
  /** Postfix `?` */
  case Try(inner: Expression)
  case Closure(closure: Closure)
  case If(condition: Condition, then: Block, otherwise: Expression?)
  case Match(subject: Expression, arms: List<MatchArm>)
  /** Only as the body of a match arm and as the `else` of an `if` */
  case Block(block: Block)
  case Invalid
}

/** One piece of a string literal: literal text, or `{expression}` between the braces. */
public type TextSegment {
  case Literal(text: String)
  case Interpolated(expression: Expression)
}

/** Whether a call was written in parentheses or as a command. The formatter canon decides which one a call gets. */
public type CallStyle {
  /** `f(a, b)`, possibly with a trailing closure */
  case Parentheses
  /** `f a, b` */
  case Command
}

/** One argument of a call: its label if it has one, and whether it spreads a collection. */
public type Argument {
  label: Name?
  /** `...items` */
  isSpread: Bool
  value: Expression
}

/** `{ parameters => body }`: a closure literal. */
public type Closure {
  parameters: List<ClosureParameter>
  body: Block
}

/** One parameter of a [Closure]: a pattern, with an annotation where one is written. */
public type ClosureParameter {
  pattern: Pattern
  annotation: TypeReference?
}

/** One `pattern => body` of a `match`, with its optional `if` guard. */
public type MatchArm {
  pattern: Pattern
  guard: Expression?
  body: Expression
}

/** A unary operator: `-value` or `!condition`. */
public type PrefixOperator {
  case Negate
  case Not
  /** `~`: `Bits.bitwiseNot` */
  case BitwiseNot
}

/** A binary operator between two expressions. */
public type InfixOperator {
  case Add
  case Subtract
  case Multiply
  case Divide
  case Remainder
  /** `**`: binds tighter than `*` and groups to the right */
  case Power
  /** `&`, at the level of `*`: `Bits.bitwiseAnd` */
  case BitwiseAnd
  /** `|`, at the level of `+`: `Bits.bitwiseOr` */
  case BitwiseOr
  /** `^`, at the level of `+`: `Bits.bitwiseExclusiveOr` */
  case BitwiseExclusiveOr
  /** `<<`, between `**` and `*`: `Bits.shiftedLeft(by:)` */
  case ShiftLeft
  /** `>>`, between `**` and `*`: `Bits.shiftedRight(by:)` */
  case ShiftRight
  case Equal
  case NotEqual
  case Less
  case LessOrEqual
  case Greater
  case GreaterOrEqual
  case And
  case Or
  /** `??` */
  case Coalesce
}

// --- Patterns -----------------------------------------------------------------------------------------------------------

/** A pattern: what it matches ([PatternKind]) and where it stands. */
public type Pattern {
  kind: PatternKind
  span: Span
}

/** Every shape a pattern can take, from a bare wildcard to a case with fields. */
public type PatternKind {
  case Wildcard
  /** A bare name always binds. Cases are written `.Case` or `Type.Case`. */
  case Binding(name: String)
  case Literal(value: Expression)
  case RangePattern(start: Expression, end: Expression, isInclusive: Bool)
  case TuplePattern(items: List<Pattern>)
  /** `[first, ...rest]` */
  case ListPattern(items: List<Pattern>, rest: RestPattern?)
  /** `Some(x)`, `Shape.Circle(radius)`, `Point(x, y)`, `Config(host, ...)` */
  case Variant(path: List<Name>, fields: List<FieldPattern>, hasRest: Bool = false)
  /** `.Circle(radius)`, `.Empty`, `.Rectangle(width, ...)`: a case of the type of the value */
  case ImplicitVariant(name: Name, fields: List<FieldPattern>, hasRest: Bool = false)
  /** `1 | 2 | 3` */
  case Alternatives(patterns: List<Pattern>)
  case Invalid
}

/** `...rest` inside of `ListPattern`: how many patterns come before it, and the name it binds if any. */
public type RestPattern {
  /** Number of patterns in front of the rest */
  position: Int
  name: Name?
}

/**
 * `Point(x: 0, y: 0)`: one sub-pattern, with the label it was written with. Which field it matches is the type
 * checker's answer: a sub-pattern without a label fills the next field from the left and a labeled one names its
 * own, exactly as an argument of the constructor does.
 */
public type FieldPattern {
  label: Name?
  pattern: Pattern
}
