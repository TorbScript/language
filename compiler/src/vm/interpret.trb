/**
 * The interpreter loop of the VM: bytecode over a word stack, in the runtime's own representation
 * (docs/design/VM.md sections 2 to 4 and 7).
 *
 * The registers are one `ArrayList<Int64>` of words for the whole run, reserved at their largest size before the first
 * instruction, so a register has an address that never changes: the loop reads and writes a register with one
 * `Machine.load` and one `Machine.store` at that address, and a `var` parameter's reference to a register is that
 * address. A frame is a window of the registers that starts at its `base`, a call pushes the callee's frame on top of
 * the caller's with its return record in the four words below it, and the constant pool lies below the first frame. A
 * word holds exactly the bytes the C back end would hold in the same place - an `Int64`, the two words of a
 * `torb_text`, the pointer to a counted block - so everything that is more than moving and comparing words is a call of
 * the kernel (`std/machine`), which is C and the one runtime of the process.
 *
 * The chunks are laid out once, before the first instruction, as an [Image]: every chunk's code in one list with its
 * jump targets relocated, and what a call needs of a chunk - where its code starts, its frame, its parameters, its
 * places and witness entries - in lists of words as well, which the loop reads by address like the registers.
 *
 * **Tasks run on every worker of the pool** (docs/design/VM.md section 4). Every thread that may resume a task has
 * registers of its own and an interpreter of its own installed in the kernel ([workersFor]); what they share - the
 * constant pool, the image - they only read by address, so no count of the interpreter's is ever touched by two threads.
 *
 * A destructor runs inside the instruction whose release dropped the last count: the kernel queues the block, and
 * [execute] runs its `close()` to its return before the next instruction, as one more `execute` on top of the words in
 * use. Where the runtime has to run code of the program itself - a test body, an `equals` a map asks for, a task the
 * scheduler resumes - the kernel calls the interpreter back ([answer]).
 *
 * **A sandboxed call can stop** (docs/design/SCRIPTS.md sections 4 and 6): the [Budget] runs out, or an operation of the
 * kernel answers `stoppedWord` because the script panicked, was refused or allocated too much. [execute] then answers
 * [haltedPoll], and every `execute` that ran it answers it in turn, each adding its frames to the budget's record of
 * where the script was. Nothing is released on the way out, as nothing is on a panic.
 *
 * # Related
 *
 * - [loadProgram] - the constant pool and the tables of the kernel, before the first instruction.
 * - [runProgram] - the whole run of one program.
 * - [callSandboxed] - one call of a chunk inside a sandbox, for a host that runs scripts.
 */

use Machine from "std/machine"
use Environment from "std/os"
use Clock from "std/time"
use Workers from "std/task"
use interrupted from "std/console"
use Opcode, KernelOperation, kernelNumberOf, opcodeOf, tailLengthOf, stoppedWord from "../backend/bytecode/format"
use BytecodeProgram, Chunk, Place, PlaceStep, WitnessEntry, WitnessRootEntry from "../backend/bytecode/format"
use ConstantPart, Shape, CountedWord from "../backend/bytecode/format"
use CountedKind, ElementKind, widthOfPart from "../backend/bytecode/format"

/**
 * The register file, shared by the loop and by the interpreter the kernel calls back into: one object, so a call back
 * in the middle of a kernel call works on the very words the loop does, and on the program as it is now - a session of
 * `torb repl` grows it by one continuation per entry.
 */
public shared type Registers {
  var words: ArrayList<Int>
  /** The address of the first register. The registers never move, so neither does any register's address. */
  var address: Int = 0
  /**
   * The first word above everything in use while the kernel runs: where a call back lays out its frame. The loop writes
   * it in front of every call of the kernel that may call back.
   */
  var top: Int = 0
  /** How many registers are zeroed: a frame beyond this is zeroed before its first use. */
  var extent: Int = 0
  /**
   * The program; a worker's registers hold an empty one, and read everything of the program the loop needs out of the
   * image by address.
   */
  var program: BytecodeProgram
  var image: Image
  /**
   * The address of the constant pool's first word, and of the cells in its gaps: the registers' own for the thread that
   * runs the program, and that thread's for a worker, whose frames are registers of its own.
   */
  var pool: Int = 0
  /** How far a frame may reach: beyond it a call is the runtime's `stack overflow`. */
  var limit: Int = largestStack
  /**
   * The host that checks and lowers a file the program loads from a path only known while it runs
   * (docs/design/SCRIPTS.md slice 7): `torb run` has one, a host that runs scripts of its own has none.
   */
  var loader: ScriptLoader? = None
  /** How often a loaded script grew the program: a loop whose image is older takes the new one. */
  var generation: Int = 0
  /**
   * Where the constants of the next script loaded at run time go: the top of the registers, which the frames give up
   * for them ([scriptWords]), because the constant pool below the frames cannot grow while they are in use. `0` until
   * the first one.
   */
  var scriptPool: Int = 0
  /** The chunks of the bodies of the scripts loaded at run time: the only ones `RunLoaded` runs. */
  var loadedScripts: List<Int> = []
}

/**
 * What the host answers for a file the program loads while it runs: the program with the script's part appended (a
 * continuation, `emitBytecode` with `after`), the chunk of its body, and its imports as `scriptImports` spells them - or
 * why it did not load, as a `SandboxError` of `Sandbox.load` says it.
 */
public type LoadedScript {
  program: BytecodeProgram
  chunk: Int
  imports: String
}

/** The host of [Registers.loader]: the path, the receiver as `scriptReceiver` names it, and the program to continue. */
public type ScriptLoader {
  load: (String, String, BytecodeProgram) => Result<LoadedScript, ScriptStop>
}

/**
 * How many words at the top of the registers the constants of scripts loaded at run time may take all together: what
 * their constant pools hold, a few kilobytes each.
 */
const scriptWords = 262144

/**
 * The program laid out for the loop. `code` is every chunk's code one after the other, with the jump targets, resume
 * points and stop paths offsets of it; `headers` holds [headerWords] words per chunk, `parameters` four words per
 * parameter, and `tables` the witness tables - all of them lists of words the loop reads at their addresses, and never
 * as lists, so the image of a worker ([sharedImageOf]) has the addresses alone.
 */
public type Image {
  code: ArrayList<Int>
  headers: ArrayList<Int>
  parameters: ArrayList<Int>
  tables: ArrayList<Int>
  /**
   * The words of every place of every chunk ([appendPlace]), and where each one starts: a chunk's first place is its
   * header's word [placesWord] in `placeStarts`.
   */
  places: ArrayList<Int>
  placeStarts: ArrayList<Int>
  /** The words of every witness entry ([appendWitness]), and where each starts: from the header's [witnessesWord]. */
  witnesses: ArrayList<Int>
  witnessStarts: ArrayList<Int>
  /** The code offset every state of a task's body resumes at: from its header's word [resumesWord] on. */
  resumes: ArrayList<Int>
  /** Whether a chunk runs a script: the sandbox is the process's, so such a program's tasks stay on one thread. */
  runsScripts: Bool = false
  codeAddress: Int = 0
  headersAddress: Int = 0
  parametersAddress: Int = 0
  tablesAddress: Int = 0
  placesAddress: Int = 0
  placeStartsAddress: Int = 0
  witnessesAddress: Int = 0
  witnessStartsAddress: Int = 0
  resumesAddress: Int = 0
}

/** The words of a chunk's header, and which is which. */
const headerWords = 10

const codeWord = 0

const frameWord = 1

const environmentWord = 2

const firstParameterWord = 3

const parameterCountWord = 4

const placesWord = 5

const witnessesWord = 6

const locationWord = 7

const taskRegisterWord = 8

const resumesWord = 9

/** The words of a parameter in [Image.parameters]: its register, its width, whether it is a reference, its shape. */
const parameterWords = 4

/**
 * What a run may still do: the steps and the time of a sandboxed script (docs/design/SCRIPTS.md section 4), and where
 * it was when it stopped. A program that is no script runs with [unlimitedBudget], which counts as well and never
 * runs out.
 */
public type Budget {
  /** Steps left before the next look at the step limit and the clock. */
  var countdown: Int = 0
  /** Steps left after the countdown. */
  var remaining: Int
  /** The step limit as it was granted, for the message. */
  steps: Int
  /** The monotonic milliseconds after which the script has run too long; `0` for no limit. */
  deadline: Int = 0
  /** The time limit as it was granted, for the message. */
  milliseconds: Int = 0
  /** Why the interpreter stopped the script itself: a limit. Empty where the kernel stopped it. */
  var reason: String = ""
  /** `(chunk, code offset)` of every frame when it stopped, the innermost first. */
  var frames: List<(Int, Int)> = []
}

/** The budget of a program that is no script: counted like any other, and never exhausted. */
public fn unlimitedBudget(): Budget {
  Budget(remaining: largest / 2, steps: largest / 2)
}

/** A budget of `steps` steps and `milliseconds` of time from now on; `0` milliseconds is no time limit. */
public fn limitedBudget(steps: Int, milliseconds: Int): Budget {
  const deadline = if milliseconds > 0 { Clock.milliseconds() + milliseconds } else { 0 }
  Budget remaining: steps, steps: steps, deadline: deadline, milliseconds: milliseconds
}

/** How many steps run between two looks at the limits: the clock is read once per this many. */
const checkInterval = 4096

/**
 * The words above a frame the interpreter uses itself for the operands it hands the kernel: a reference it resolved, a
 * text it copied out of the constant pool. The upper half is the return record of a call, which lies right below the
 * callee's frame. Nothing of the lower half outlives one instruction.
 */
const scratchWords = 8

/** A return record, below the callee's frame: the code offset to go on at, the caller's base, chunk, and result. */
const recordWords = 4

/**
 * How many words the stack may hold: a recursion deeper than this is the `stack overflow` panic of the runtime, with
 * the site of the function it could not enter - which is where the C back end's stack check reports it, too.
 */
const largestStack = 4194304

/**
 * How many words the stack of a worker of the pool may hold: a task's body starts at the bottom of it, and recursion
 * inside a task on another worker than the first ends in `stack overflow` sooner, as a native worker's smaller stack
 * does.
 */
const workerStack = 1048576

/** How many registers are zeroed at once when a frame reaches beyond [Registers.extent]. */
const zeroedAtOnce = 65536

/** The block kind of a static aggregate that is a block. */
const recordBlockKind = 4

/** The size of a block's header plus its shape word: where the contents of a counted block of the VM begin. */
const contentsOffset = 16

/**
 * The run of one program: the constant pool and the tables placed, then the entry chunks in order, each to its return.
 * Answers the exit code: 0, or `TORB_EXIT_CANCELLED` where the main task ended cancelled (docs/design/CONCURRENCY.md
 * section 8). A program that ends by `Process.exit` or a panic never comes back here, exactly as its native binary
 * never returns from `main`.
 */
public fn runProgram(
  program: BytecodeProgram,
  arguments: List<String>,
  executable: String = "",
  loader: ScriptLoader? = None,
  pool: (workers: Int, blocking: Int) = (workers: 0, blocking: 0),
): Int {
  const registers = registersFor program
  registers.loader = loader
  // `tasks { workers, blocking }` of the program's manifest, before a worker of the pool is asked for
  if pool.workers != 0 || pool.blocking != 0 {
    const _ = kernelCall(
      registers.words,
      kernelScratch(),
      0,
      KernelOperation.PoolDefaults,
      [pool.workers, pool.blocking],
    )
  }
  const workers = workersFor registers, program
  const ended = run registers.words, kernelScratch(), registers, registers.image, program, arguments, executable
  releaseWorkers registers, workers
  ended
}

/**
 * Registers and an interpreter for every other thread that may resume a task of the program: the workers of the pool
 * after the first, and the threads of the blocking pool (docs/design/VM.md section 4). Each gets words of its own for
 * its frames and an image that shares the program's lists by address only, so what one thread's interpreter counts no
 * other thread ever touches. Then the kernel lets a task whose frame may cross start portable. A program without tasks
 * needs none of it, and neither does one that runs scripts: the sandbox is the whole process's, so its tasks stay on
 * the thread that runs it - nor one whose top-level `const` a function reads holds a value no immortal copy was made
 * of (`BytecodeProgram.confinesTasks`), because such a function may run in any task.
 */
fn workersFor(main: Registers, program: BytecodeProgram): List<Registers> {
  var workers: List<Registers> = []
  if !program.usesTasks || main.image.runsScripts || program.confinesTasks {
    return workers
  }
  // A worker of the ring by its index (kind 0), a thread of the blocking pool by its number (kind 1)
  var threads: List<(Int, Int)> = []
  for index in 1..Workers.count() {
    threads.append((0, index))
  }
  for index in 0..Workers.blocking() {
    threads.append((1, index))
  }
  for (kind, number) in threads {
    const worker = Registers(
      words: ArrayList.withCapacity(0),
      program: BytecodeProgram(),
      image: sharedImageOf(main.image),
      pool: main.pool,
      limit: workerStack,
    )
    var kernel = kernelScratch()
    const capacity = [workerStack + 4 * scratchWords]
    const _ = kernelCall worker.words, kernel, 0, KernelOperation.Reserve, capacity
    worker.address = kernelCall worker.words, kernel, 0, KernelOperation.RegisterAddress, []
    const _ = kernelCall worker.words, kernel, 0, KernelOperation.InstallFor, [kind, number]
    Machine.install { answer worker, _ }
    workers.append worker
  }
  const _ = kernelCall main.words, kernelScratch(), 0, KernelOperation.Portable, [1]
  workers
}

/** The interpreters of the other threads given back once the program is done: every task has stopped by then. */
fn releaseWorkers(main: Registers, workers: List<Registers>) {
  if workers.isEmpty() {
    return
  }
  const _ = kernelCall main.words, kernelScratch(), 0, KernelOperation.Portable, [0]
  const _ = kernelCall main.words, kernelScratch(), 0, KernelOperation.InstallFor, [2, 0]
}

/**
 * Registers for a program: reserved at their largest size - a call back may grow the stack while a call of the kernel
 * holds a pointer into it, so it never moves - the program laid out as an image, and the interpreter handed to the
 * kernel for its call backs.
 */
fn registersFor(program: BytecodeProgram): Registers {
  const registers = Registers words: ArrayList.withCapacity(0), program: program, image: emptyImage()
  const capacity = [largestStack + 4 * scratchWords]
  const _ = kernelCall registers.words, kernelScratch(), 0, KernelOperation.Reserve, capacity
  registers.address = kernelCall registers.words, kernelScratch(), 0, KernelOperation.RegisterAddress, []
  registers.pool = registers.address
  registers.program = program
  registers.image = imageOf registers.words, program
  Machine.install { answer registers, _ }
  registers
}

/**
 * The constant pool and the tables, the program's arguments, then every entry chunk to its return. Answers the exit
 * code, as the `main` of the C back end does.
 */
fn run(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  image: Image,
  program: BytecodeProgram,
  arguments: List<String>,
  executable: String,
): Int {
  const scratch = firstFrameOf program
  ensureRegisters(registers, scratch + 2 * arguments.length() + 4 * scratchWords)
  loadProgram words, kernel, registers, program
  // `Process.arguments()` answers what was written behind the path, as it answers a native binary its `argv`
  var texts: List<Int> = [arguments.length()]
  for index in 0..arguments.length() {
    Machine.placeText(words, scratch + 2 * index, arguments[index])
    texts.append(2 * index)
  }
  const _ = kernelCall words, kernel, scratch, KernelOperation.SetArguments, texts
  // `Process.executablePath()` answers the entry file, which is what executes
  if !executable.isEmpty() {
    Machine.placeText words, scratch, executable
    const _ = kernelCall words, kernel, scratch, KernelOperation.SetExecutable, [0]
  }
  var budget = unlimitedBudget()
  var ended = 0
  // A program that ends in `Process.exit` never comes back here, so the runtime gives the cells' counts back there
  if program.entryCellRelease >= 0 {
    const _ = kernelCall words, kernel, scratch, KernelOperation.OnExit, [program.entryCellRelease]
  }
  for position in 0..program.entries.length() {
    // A test run prints the file in front of its tests, as the `main` of a native test binary does
    if const Some(file) = program.entryFiles.get(position) {
      Machine.placeText words, scratch, file
      const _ = kernelCall words, kernel, scratch, KernelOperation.TestFile, [0]
    }
    const entry = program.entries[position]
    if entry < 0 {
      continue
    }
    const chunk = program.chunks[entry]
    // An entry file that waits is the main task: the scheduler runs until it has completed. Where it ended cancelled,
    // the kernel said so (`torb_task_end_main`) and the run ends with `TORB_EXIT_CANCELLED` once the rest has stopped
    if chunk.suspendable {
      const operands = [entry, chunk.savedWords(), scratchWords - 1]
      schedule words, kernel, registers, image, program, KernelOperation.RunMain, operands
      const answered = loadRegister(registers, scratch + scratchWords - 1)
      if answered != 0 {
        ended = answered
      }
      continue
    }
    const _ = execute(words, kernel, budget, registers, image, program, entry, scratch, 0 - 1, 0)
    // Tasks it started and did not wait for run once it is done, in the order they were queued
    if program.usesTasks {
      schedule words, kernel, registers, image, program, KernelOperation.SchedulerRun, []
    }
  }
  // What is still running when the program ends is cancelled and runs to its stop, so every frame is released
  if program.usesTasks {
    schedule words, kernel, registers, image, program, KernelOperation.SchedulerFinish, []
  }
  // The entry cells hold a count until nothing can read them any more: after the last task
  if program.entryCellRelease >= 0 {
    const _ = kernelCall words, kernel, scratch, KernelOperation.OnExit, [0 - 1]
    const release = program.entryCellRelease
    const _ = execute(words, kernel, budget, registers, image, program, release, scratch, 0 - 1, 0)
  }
  // The summary of a test run, before the leak report, and its exit code where the run failed
  if !program.entryFiles.isEmpty() {
    const failed = kernelCall words, kernel, scratch, KernelOperation.TestFinish, []
    if failed != 0 {
      return failed
    }
  }
  ended
}

/**
 * One call of the scheduler, which resumes tasks by calling back into the interpreter above the first frame, and the
 * destructors the last releases of it queued.
 */
fn schedule(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  image: Image,
  program: BytecodeProgram,
  operation: KernelOperation,
  operands: List<Int>,
) {
  const scratch = firstFrameOf program
  registers.top = scratch + scratchWords
  if kernelCall(words, kernel, scratch, operation, operands) > 0 {
    var budget = unlimitedBudget()
    const _ = runClosers words, kernel, budget, registers, image, program, scratch
  }
}

/** The words a call of the kernel the interpreter makes itself puts its operation and operands into. */
fn kernelScratch(): ArrayList<Int> {
  var kernel: ArrayList<Int> = ArrayList.withCapacity 64
  for _ in 0..64 {
    kernel.append 0
  }
  kernel
}

// --- A host that calls into the program ------------------------------------------------------------------------------

/**
 * A program loaded into the kernel once, whose chunks a host calls one at a time: a script per call, or an entry of a
 * session of `torb repl`, whose program grows by one continuation per entry ([appendProgram]).
 */
public type LoadedProgram {
  var program: BytecodeProgram
  registers: Registers
  var kernel: ArrayList<Int>
  /** How much of `program` the kernel and the words have: where the next continuation starts loading. */
  var counts: LoadedCounts = LoadedCounts()
}

/** How much of a program is loaded: its parts of the constant pool and their words, and the kernel's tables. */
public type LoadedCounts {
  parts: Int = 0
  words: Int = 0
  locations: Int = 0
  elements: Int = 0
  shapes: Int = 0
}

/** The program's constant pool and tables in place, ready for [callSandboxed]. */
public fn loadedProgram(program: BytecodeProgram): LoadedProgram {
  const registers = registersFor program
  var kernel = kernelScratch()
  const counts = loadFrom registers.words, kernel, registers, program, LoadedCounts()
  LoadedProgram program, registers, kernel, counts
}

/**
 * `program` continues the loaded one (`emitBytecode` with `after`): what it adds - the constants and the gaps after the
 * old pool, the locations, shapes and element descriptors after the old ones - is loaded, and nothing that is loaded
 * already is touched, so every value the earlier part made keeps its meaning. The image is laid out again, because the
 * program has new chunks.
 */
public fn appendProgram(var loaded: LoadedProgram, program: BytecodeProgram) {
  loaded.counts = loadFrom loaded.registers.words, loaded.kernel, loaded.registers, program, loaded.counts
  loaded.program = program
  loaded.registers.program = program
  loaded.registers.image = imageOf loaded.registers.words, program
}

/**
 * `width` words below every frame for the host, zero, which no program of the continuation touches: a gap appended to
 * the constant pool. Answers where they begin.
 */
public fn reserveWords(var loaded: LoadedProgram, width: Int): Int {
  const offset = loaded.program.constantWords
  loaded.program.constants.append ConstantPart.Gap(width)
  loaded.program.constantWords = offset + width
  loaded.registers.program = loaded.program
  ensureRegisters(loaded.registers, offset + width + scratchWords * 4)
  for index in 0..width {
    storeRegister(loaded.registers, offset + index, 0)
  }
  loaded.counts = loaded.counts.copy(parts: loaded.program.constants.length(), words: offset + width)
  offset
}

/** The word in the register `index` - an absolute register below every frame - for a host that reads what it passed. */
public fn wordAt(loaded: LoadedProgram, index: Int): Int {
  loadRegister loaded.registers, index
}

/** Writes the word in the register `index` - an absolute register below every frame - for a host that keeps a value there. */
public fn storeWordAt(var loaded: LoadedProgram, index: Int, value: Int) {
  storeRegister loaded.registers, index, value
}

/** The reference a `var` parameter of an entry takes for the absolute register `index`: the register's address. */
public fn registerReferenceOf(loaded: LoadedProgram, index: Int): Int {
  loaded.registers.address + 8 * index
}

/**
 * Releases the value in the words at `register` - an absolute register below every frame - by the shape `shape` (its
 * index plus one, `0` for a value nothing in is counted), and runs the destructors that release queues, inside a
 * sandbox of `grant` so that a destructor that panics stops and the host goes on. The words are zero afterwards.
 */
public fn releaseSandboxed(
  var loaded: LoadedProgram,
  grant: String,
  register: Int,
  width: Int,
  shape: Int,
): Result<Void, Stop> {
  const registers = loaded.registers
  if shape > 0 {
    Machine.install { answer registers, _ }
    const scratch = firstFrameOf loaded.program
    const top = scratch + scratchWords
    ensureRegisters(registers, top + scratchWords * 4)
    Machine.placeText registers.words, scratch, grant
    const _ = kernelCall registers.words, loaded.kernel, scratch, KernelOperation.SandboxOpen, [0]
    var budget = unlimitedBudget()
    var finished = true
    registers.top = top
    const queued = kernelCall registers.words, loaded.kernel, 0, KernelOperation.Release, [register, shape - 1]
    if queued == stoppedWord {
      finished = false
    } else if queued > 0 {
      const image = registers.image
      finished = runClosers registers.words, loaded.kernel, budget, registers, image, loaded.program, top
    }
    const _ = kernelCall registers.words, loaded.kernel, scratch, KernelOperation.SandboxClose, []
    if !finished {
      return Fail stopAt(registers.words, loaded.kernel, budget, registers, scratch)
    }
  }
  for index in 0..width {
    storeRegister(registers, register + index, 0)
  }
  Ok void
}

/** Why a sandboxed call stopped, as the kernel and the interpreter saw it. */
public type Stop {
  /** `0` for a limit of the interpreter, otherwise the kernel's kind (`TORB_SANDBOX_*` of `runtime/torb.h`). */
  kind: Int
  message: String
  /** The location index of the panic's site, `-1` for none. */
  site: Int
  /** `(chunk, code offset)` of every frame when it stopped, the innermost first. */
  frames: List<(Int, Int)>
}

/**
 * One call of `chunk` inside a sandbox: the grant's text opened in the kernel, `arguments` as the words of the
 * parameters in order, the budget counted, and the sandbox closed again whatever happened. Answers the words of the
 * result, or where and why the call stopped.
 */
public fn callSandboxed(
  var loaded: LoadedProgram,
  grant: String,
  var budget: Budget,
  chunk: Int,
  arguments: List<Int>,
): Result<List<Int>, Stop> {
  const program = loaded.program
  const registers = loaded.registers
  Machine.install { answer registers, _ }
  const callee = program.chunks[chunk]
  const base = firstFrameOf(program) + scratchWords
  // The grant's text in the scratch words below the frame, where the kernel reads it
  const scratch = firstFrameOf program
  ensureRegisters(registers, base + callee.frameWords + callee.resultWidth + scratchWords * 2)
  Machine.placeText registers.words, scratch, grant
  const _ = kernelCall registers.words, loaded.kernel, scratch, KernelOperation.SandboxOpen, [0]
  var cursor = 0
  for parameter in callee.parameters {
    for offset in 0..parameter.width {
      storeRegister(registers, base + parameter.offset + offset, arguments.get(cursor + offset) ?? 0)
    }
    cursor = cursor + parameter.width
  }
  const target = base + callee.frameWords + scratchWords
  const image = registers.image
  var finished = ensureFrame registers, base, image, chunk
  if finished {
    const into = registers.address + 8 * target
    const poll = execute(registers.words, loaded.kernel, budget, registers, image, program, chunk, base, 0 - 1, into)
    finished = poll != haltedPoll
  } else {
    budget.frames.append((chunk, 0))
  }
  // Closed first, so that nothing after this is held against the script's budget - reading the stop included
  const _ = kernelCall registers.words, loaded.kernel, scratch, KernelOperation.SandboxClose, []
  if !finished {
    return Fail stopAt(registers.words, loaded.kernel, budget, registers, firstFrameOf(program))
  }
  var result: List<Int> = []
  for offset in 0..callee.resultWidth {
    result.append loadRegister(registers, target + offset)
  }
  result
}

/**
 * The stop the kernel recorded, or the limit the interpreter hit, with the frames the budget collected. `scratch` is
 * the first of the words above everything in use, which the kernel writes the stop into.
 */
fn stopAt(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  budget: Budget,
  registers: Registers,
  scratch: Int,
): Stop {
  if !budget.reason.isEmpty() {
    return Stop(0, budget.reason, 0 - 1, budget.frames)
  }
  // The site, the length and up to 1023 code points of the message
  ensureRegisters(registers, scratch + 1100)
  const kind = kernelCall words, kernel, scratch, KernelOperation.TakeStop, [0]
  const site = loadRegister registers, scratch
  const count = loadRegister(registers, scratch + 1)
  var points: List<Int> = []
  for index in 0..count {
    points.append loadRegister(registers, scratch + 2 + index)
  }
  Stop kind, textOfCodePoints(points), site, budget.frames
}

/**
 * A text of the host placed in the VM, as the two words a parameter of type `String` takes: the argument a host hands a
 * chunk of the program through [callSandboxed] (`vm/host.trb`). The words are all that hold it.
 */
public fn placedText(var loaded: LoadedProgram, text: String): List<Int> {
  const registers = loaded.registers
  const scratch = firstFrameOf loaded.program
  ensureRegisters(registers, scratch + 4)
  Machine.placeText registers.words, scratch, text
  [loadRegister(registers, scratch), loadRegister(registers, scratch + 1)]
}

/**
 * What the sandbox opened last recorded, where its grant said `record`: `file\t<path>` and `variable\t<name>` lines,
 * the inputs of a `project.trb` (docs/design/PROJECT.md section 8). Read after [callSandboxed] returned.
 */
public fn recordedInputs(var loaded: LoadedProgram): String {
  const registers = loaded.registers
  const scratch = firstFrameOf loaded.program
  ensureRegisters(registers, scratch + 4)
  const _ = kernelCall registers.words, loaded.kernel, scratch, KernelOperation.TakeInputs, [0]
  textAt(registers.words, loaded.kernel, registers, scratch, scratch + 2)
}

/** The text of the two words of a `String` in the VM, as a `String` of the host: `TextOut`, then the code points. */
public fn textOfWords(var loaded: LoadedProgram, text: List<Int>): String {
  const registers = loaded.registers
  const scratch = firstFrameOf loaded.program
  ensureRegisters(registers, scratch + 4)
  storeRegister(registers, scratch, text.get(0) ?? 0)
  storeRegister(registers, scratch + 1, text.get(1) ?? 0)
  textAt(registers.words, loaded.kernel, registers, scratch, scratch + 2)
}

/** The text in the two words at the register `at`, as a `String` of the host, with the words from `scratch` on to spare. */
fn textAt(var words: ArrayList<Int>, var kernel: ArrayList<Int>, registers: Registers, at: Int, scratch: Int): String {
  ensureRegisters(registers, scratch + 2)
  // A text has no more code points than bytes, so its byte length is room enough
  const _ = kernelCall words, kernel, scratch, KernelOperation.TextByteLength, [0, at - scratch]
  const bytes = loadRegister registers, scratch
  ensureRegisters(registers, scratch + 2 + bytes)
  const count = kernelCall words, kernel, scratch, KernelOperation.TextOut, [1, at - scratch]
  var points: List<Int> = []
  for index in 0..count {
    points.append loadRegister(registers, scratch + 1 + index)
  }
  textOfCodePoints points
}

// --- Stops, as the author of a script reads them --------------------------------------------------------------------

/** Where and why a script stopped: the two fields of its `SandboxError`. `line` is 0 where no line of it is to blame. */
public type ScriptStop {
  line: Int
  message: String
}

/** The kinds of a stop the kernel reports, as `runtime/torb.h` numbers them. */
const panicked = 1

/** The stop as the script's author reads it: the line of the script, and the message with a foreign site appended. */
public fn scriptStopOf(program: BytecodeProgram, stop: Stop, scriptPath: String): ScriptStop {
  const blamed = innermostLineOf program, stop.frames, scriptPath
  if stop.kind != panicked {
    return ScriptStop blamed, stop.message
  }
  const site = match program.locations.get(stop.site) {
    Some(found) => found
    None => {
      return ScriptStop blamed, stop.message
    }
  }
  if site.path == scriptPath {
    return ScriptStop site.line, stop.message
  }
  ScriptStop blamed, "{stop.message} (at {site.path}:{site.line}:{site.column})"
}

/**
 * The line of the innermost frame that is in the script's file: the site of the last instruction before its program
 * counter that carries one. A caller's program counter is the one after its call, so its call is before it.
 */
fn innermostLineOf(program: BytecodeProgram, frames: List<(Int, Int)>, scriptPath: String): Int {
  var isInnermost = true
  for (chunkIndex, pc) in frames {
    const chunk = match program.chunks.get(chunkIndex) {
      Some(found) => found
      None => {
        continue
      }
    }
    const last = if isInnermost { pc } else { pc - 1 }
    isInnermost = false
    var location = chunk.location
    for (offset, index) in chunk.sites {
      if offset > last {
        break
      }
      location = index
    }
    if const Some(found) = program.locations.get(location) {
      if found.path == scriptPath {
        return found.line
      }
    }
  }
  0
}

/**
 * `runScript` of `std/sandbox`, the one instruction only the VM has (docs/design/SCRIPTS.md sections 4 to 6): the grant
 * opened in the kernel, the script's closure called with the receiver's reference under a budget of its own, the
 * sandbox closed whatever happened, and the answer placed as text - `""`, or the line of the script and the message of
 * the stop with a tab between them. A stop ends the script and never the program that ran it. `callee` is the chunk of
 * the script's body and `environment` the environment its closure carries; `runLoadedScript` runs the body of a script
 * the program loaded while it ran, which has none.
 */
fn runScriptInstruction(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  image: Image,
  program: BytecodeProgram,
  base: Int,
  top: Int,
  target: Int,
  callee: Int,
  environment: Int,
  receiver: Int,
  grant: Int,
) {
  const scratch = top + scratchWords
  const granted = textAt(words, kernel, registers, base + grant, scratch)
  var steps = 1_000_000
  var milliseconds = 2000
  for line in granted.split("\n") {
    if const Some(number) = line.substringAfter("steps\t") {
      steps = Int.tryFrom(number).ok() ?? steps
    }
    if const Some(number) = line.substringAfter("milliseconds\t") {
      milliseconds = Int.tryFrom(number).ok() ?? milliseconds
    }
  }
  const _ = kernelCall words, kernel, base, KernelOperation.SandboxOpen, [grant]
  var budget = limitedBudget steps, milliseconds
  const chunk = program.chunks[callee]
  var finished = ensureFrame registers, scratch, image, callee
  if finished {
    var first = 0
    if chunk.takesEnvironment {
      storeRegister(registers, scratch + chunk.parameters[0].offset, environment)
      first = 1
    }
    storeRegister(registers, scratch + chunk.parameters[first].offset, loadRegister(registers, base + receiver))
    const poll = execute(words, kernel, budget, registers, image, program, callee, scratch, 0 - 1, 0)
    finished = poll != haltedPoll
  } else {
    budget.frames.append((callee, 0))
  }
  const _ = kernelCall words, kernel, base, KernelOperation.SandboxClose, []
  var answer = ""
  if !finished {
    const stop = stopAt words, kernel, budget, registers, scratch
    const path = match program.locations.get(chunk.location) {
      Some(found) => found.path
      None => ""
    }
    const blamed = scriptStopOf program, stop, path
    answer = "{blamed.line}\t{blamed.message}"
  }
  Machine.placeText(words, base + target, answer)
}

/**
 * `loadScript` of `std/sandbox` (docs/design/SCRIPTS.md slice 7): the file at a path only known while the program runs,
 * checked against its receiver and lowered by the host ([Registers.loader]), and appended to the program as a
 * continuation. The answer is text: the chunk of the script's body on the first line and its imports below it, as
 * `scriptImports` spells them - or `!`, the line and the message of why the file did not load, a tab between the two.
 */
fn loadScriptInstruction(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  base: Int,
  top: Int,
  target: Int,
  path: Int,
  receiver: Int,
) {
  const scratch = top + scratchWords
  const written = textAt(words, kernel, registers, base + path, scratch)
  const named = textAt(words, kernel, registers, base + receiver, scratch)
  const answer = loadedAnswer words, kernel, registers, scratch, written, named
  Machine.placeText(words, base + target, answer)
}

/**
 * The continuation of one script loaded at run time, in place. Its constants go to the top of the registers, which the
 * frames give up for them the first time ([scriptWords]): the constant pool below the frames cannot grow while they are
 * in use. The image is laid out again with every old chunk where it was, and the loops that run take it up
 * ([Registers.generation]).
 */
fn loadedAnswer(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  scratch: Int,
  written: String,
  named: String,
): String {
  const loader = match registers.loader {
    Some(found) => found
    None => {
      return "!0\tThere is no script `{written}` in this program: a script is loaded by a path it was compiled with"
    }
  }
  if named.isEmpty() {
    return "!0\tA script from a path only known while the program runs has a receiver without type arguments"
  }
  if registers.scriptPool == 0 {
    const start = largestStack - scriptWords
    if scratch + 16 * scratchWords >= start {
      return "!0\tThe program is too deep in its calls to load a script"
    }
    registers.scriptPool = start
    registers.limit = start - 8 * scratchWords
  }
  const program = registers.program
  const loaded = match loader.load(written, named, program.copy(constantWords: registers.scriptPool)) {
    Ok(found) => found
    Fail(stop) => {
      return "!{stop.line}\t{stop.message}"
    }
  }
  // A file loaded before with the same text is the script it was then
  if loaded.program.chunks.length() == program.chunks.length() {
    return "{loaded.chunk}\n{loaded.imports}"
  }
  const width = loaded.program.constantWords - registers.scriptPool
  if registers.scriptPool + width > largestStack {
    return "!0\tThe scripts loaded while the program runs hold more constants than the VM has room for"
  }
  for index in 0..width {
    storeRegister(registers, registers.scriptPool + index, 0)
  }
  const from = LoadedCounts(
    program.constants.length(),
    registers.scriptPool,
    program.locations.length(),
    program.elements.length(),
    program.shapes.length(),
  )
  const _ = loadFrom words, kernel, registers, loaded.program, from, scratch
  registers.scriptPool = registers.scriptPool + width
  // The frames stay where the program laid them out: its first frame is not the top of the scripts' constants
  const grown = loaded.program.copy constantWords: program.constantWords
  registers.program = grown
  registers.image = imageOf words, grown
  registers.generation = registers.generation + 1
  registers.loadedScripts.append loaded.chunk
  "{loaded.chunk}\n{loaded.imports}"
}

/** The characters of the code points, which the kernel decoded from UTF-8 and are therefore valid. */
fn textOfCodePoints(points: List<Int>): String {
  var characters: List<Char> = []
  for point in points {
    if const Ok(character) = Char.tryFrom(point) {
      characters.append character
    }
  }
  String.from characters
}

// --- The image ------------------------------------------------------------------------------------------------------

/**
 * Every chunk laid out for the loop: its code appended to the one list of code, with every code offset it names - a
 * jump target, a resume point, a stop path - moved by where the chunk starts, and its header, parameters, places and
 * witness entries appended to theirs.
 */
fn imageOf(var words: ArrayList<Int>, program: BytecodeProgram): Image {
  var code: ArrayList<Int> = ArrayList.withCapacity 4096
  var headers: ArrayList<Int> = ArrayList.withCapacity(program.chunks.length() * headerWords + 1)
  var parameters: ArrayList<Int> = ArrayList.withCapacity 1024
  var places: ArrayList<Int> = ArrayList.withCapacity 4096
  var placeStarts: ArrayList<Int> = ArrayList.withCapacity 1024
  var witnesses: ArrayList<Int> = ArrayList.withCapacity 256
  var witnessStarts: ArrayList<Int> = ArrayList.withCapacity 64
  var resumes: ArrayList<Int> = ArrayList.withCapacity 64
  var runsScripts = false
  for chunk in program.chunks {
    const start = code.length()
    headers.append start
    headers.append chunk.frameWords
    headers.append(if chunk.takesEnvironment { 1 } else { 0 })
    headers.append(parameters.length() / parameterWords)
    headers.append chunk.parameters.length()
    headers.append placeStarts.length()
    headers.append witnessStarts.length()
    headers.append chunk.location
    headers.append chunk.taskRegister
    headers.append resumes.length()
    for parameter in chunk.parameters {
      parameters.append parameter.offset
      parameters.append parameter.width
      parameters.append(if parameter.byReference { 1 } else { 0 })
      parameters.append parameter.retainedThroughWitness
    }
    for place in chunk.places {
      placeStarts.append places.length()
      appendPlace places, place
    }
    for witness in chunk.witnesses {
      witnessStarts.append witnesses.length()
      appendWitness witnesses, witness
    }
    resumes.appendAll chunk.resumes
    if appendRelocated(code, chunk.code, start) {
      runsScripts = true
    }
  }
  var tables: ArrayList<Int> = ArrayList.withCapacity 256
  for _ in 0..program.tables.length() {
    tables.append 0
  }
  for index in 0..program.tables.length() {
    const table = program.tables[index]
    tables.set index, tables.length()
    tables.append table.members.length()
    tables.appendAll table.members
    tables.append table.nested.length()
    tables.appendAll table.nested
  }
  // The lists are complete, so their storage stays where it is for the whole run
  const codeAddress = addressOf words, code
  const headersAddress = addressOf words, headers
  const parametersAddress = addressOf words, parameters
  const tablesAddress = addressOf words, tables
  const placesAddress = addressOf words, places
  const placeStartsAddress = addressOf words, placeStarts
  const witnessesAddress = addressOf words, witnesses
  const witnessStartsAddress = addressOf words, witnessStarts
  const resumesAddress = addressOf words, resumes
  Image(
    code: code,
    headers: headers,
    parameters: parameters,
    tables: tables,
    places: places,
    placeStarts: placeStarts,
    witnesses: witnesses,
    witnessStarts: witnessStarts,
    resumes: resumes,
    runsScripts: runsScripts,
    codeAddress: codeAddress,
    headersAddress: headersAddress,
    parametersAddress: parametersAddress,
    tablesAddress: tablesAddress,
    placesAddress: placesAddress,
    placeStartsAddress: placeStartsAddress,
    witnessesAddress: witnessesAddress,
    witnessStartsAddress: witnessStartsAddress,
    resumesAddress: resumesAddress,
  )
}

/** An image of nothing: what the registers hold until the program is laid out. */
fn emptyImage(): Image {
  Image(
    code: ArrayList.withCapacity(0),
    headers: ArrayList.withCapacity(0),
    parameters: ArrayList.withCapacity(0),
    tables: ArrayList.withCapacity(0),
    places: ArrayList.withCapacity(0),
    placeStarts: ArrayList.withCapacity(0),
    witnesses: ArrayList.withCapacity(0),
    witnessStarts: ArrayList.withCapacity(0),
    resumes: ArrayList.withCapacity(0),
  )
}

/**
 * The image of a worker: the program's addresses and no list of its own. The lists stay the program's, whose image
 * holds them for the whole run, so a worker reads their words and never counts them.
 */
fn sharedImageOf(image: Image): Image {
  emptyImage().copy(
    runsScripts: image.runsScripts,
    codeAddress: image.codeAddress,
    headersAddress: image.headersAddress,
    parametersAddress: image.parametersAddress,
    tablesAddress: image.tablesAddress,
    placesAddress: image.placesAddress,
    placeStartsAddress: image.placeStartsAddress,
    witnessesAddress: image.witnessesAddress,
    witnessStartsAddress: image.witnessStartsAddress,
    resumesAddress: image.resumesAddress,
  )
}

/** The kinds of a step in the words of a place, and how many words a step takes: its kind and four operands. */
const offsetStep = 0

const dereferenceStep = 1

const elementStep = 2

const itemStep = 3

const listItemStep = 4

const stepWords = 6

/**
 * A place as words: its base register, whether that register holds a reference, its width, how many steps, the narrow
 * code of the element it ends in (0 for words), then [stepWords] words per step - the kind and its operands.
 */
fn appendPlace(var words: ArrayList<Int>, place: Place) {
  words.append place.base
  words.append(if place.throughReference { 1 } else { 0 })
  words.append place.width
  words.append place.steps.length()
  words.append place.narrow
  for step in place.steps {
    const (kind, first, second, third, fourth, fifth) = match step {
      .Offset(count) => (offsetStep, count, 0, 0, 0, 0)
      .Dereference => (dereferenceStep, 0, 0, 0, 0, 0)
      .Element(index, location) => (elementStep, index, location, 0, 0, 0)
      .ListItem(index, location) => (listItemStep, index, location, 0, 0, 0)
      .Item(index, size, width, location) => (itemStep, index, size, width, location, 0)
    }
    words.append kind
    words.append first
    words.append second
    words.append third
    words.append fourth
    words.append fifth
  }
}

/** A witness entry as words: its root (0 a static table, 1 a value's place and bound), how many steps, the steps. */
fn appendWitness(var words: ArrayList<Int>, witness: WitnessEntry) {
  match witness.root {
    .Table(table) => {
      words.append 0
      words.append table
      words.append 0
    }
    .Value(place, bound) => {
      words.append 1
      words.append place
      words.append bound
    }
  }
  words.append witness.steps.length()
  words.appendAll witness.steps
}

/** The address of the words of the place `index` of a chunk whose first place is `places`. */
fn placeAt(image: Image, places: Int, index: Int): Int {
  image.placesAddress + 8 * Machine.load(image.placeStartsAddress + 8 * (places + index))
}

/** The address of the words of a witness entry, by its index among every chunk's. */
fn witnessAt(image: Image, index: Int): Int {
  image.witnessesAddress + 8 * Machine.load(image.witnessStartsAddress + 8 * index)
}

/**
 * The address of a list's first word: the kernel answers it for the list it reads its operation out of, so the list
 * gets that operation as one more word at its end, which nothing else reads.
 */
fn addressOf(var words: ArrayList<Int>, var list: ArrayList<Int>): Int {
  list.append kernelNumberOf(KernelOperation.ListAddress)
  Machine.operate(words, 0, list, list.length() - 1)
}

/**
 * One chunk's code at the end of `into`, every code offset it names moved by `start`. Answers whether the chunk runs a
 * script.
 */
fn appendRelocated(var into: ArrayList<Int>, code: ArrayList<Int>, start: Int): Bool {
  var runsScripts = false
  var pc = 0
  while pc < code.length() {
    const head = code[pc]
    const opcode = opcodeOf(head & 255)
    const tail = tailLengthOf opcode, head
    if opcode == Opcode.RunScript || opcode == Opcode.RunLoaded {
      runsScripts = true
    }
    into.append head
    for index in 0..tail {
      const word = code[pc + 1 + index]
      const isTarget = match opcode {
        .Jump => true
        .Branch => true
        .Cancelled => true
        .Resume => true
        // A switch's tail is its pairs of value and target, then the target of `otherwise`
        .Switch => index & 1 == 1 || index == tail - 1
        _ => false
      }
      into.append(if isTarget { word + start } else { word })
    }
    pc = pc + 1 + tail
  }
  runsScripts
}

// --- Calls back ------------------------------------------------------------------------------------------------------

/** The kinds of request of `runtime/machine.c` (`TORB_REQUEST_*`), and where the fields of one are. */
const runRequest = 0

const equalsRequest = 1

const hashRequest = 2

const resumeRequest = 3

const callRequest = 4

const closeRequest = 5

const requestChunk = 8

const requestFirst = 16

const requestSecond = 24

const requestWords = 32

/**
 * What the kernel asks of the interpreter in the middle of one of its calls: a request of `runtime/machine.c`, run in a
 * frame above everything the loop that made the call uses, with a kernel scratch of its own - the loop's is in use. The
 * word below the frame takes the result. A sandboxed script that stops in the middle of one is passed on to the
 * operation that made the call (`StopInCallBack`), which stops as well.
 */
fn answer(registers: Registers, request: Int): Int {
  const program = registers.program
  const image = registers.image
  const saved = registers.top
  const result = saved + scratchWords
  const base = result + 1
  const kind = Machine.load request
  var budget = unlimitedBudget()
  var poll = finishedPoll
  var answered = 0
  if kind == closeRequest {
    // The destructors a release queued outside every operation of the loop, run where it happened
    if !runClosers(registers.words, kernelScratch(), budget, registers, image, program, saved) {
      poll = haltedPoll
    }
  } else if kind == callRequest {
    // A chunk without parameters: the release of the entry cells when the program ends in `Process.exit`
    const function = Machine.load(request + requestChunk)
    if ensureFrame(registers, base, image, function) {
      poll = execute(registers.words, kernelScratch(), budget, registers, image, program, function, base, 0 - 1, 0)
    } else {
      poll = haltedPoll
    }
  } else if kind == runRequest {
    // A closure of the program without arguments: its function word, then its environment
    const function = Machine.load(request + requestChunk) - 1
    if ensureFrame(registers, base, image, function) {
      if header(image, function, environmentWord) != 0 {
        storeRegister(registers, base + parameterWord(image, function, 0, 0), Machine.load(request + requestFirst))
      }
      poll = execute(registers.words, kernelScratch(), budget, registers, image, program, function, base, 0 - 1, 0)
    } else {
      poll = haltedPoll
    }
  } else if kind == resumeRequest {
    // A task's body, resumed by the scheduler: its frame out of the task block, its task in its register, and on at
    // the state it recorded. The answer is the poll of `torb_task.h`
    // Out of the image alone: a worker's registers hold no program
    const function = Machine.load(request + requestChunk)
    const taskRegister = header image, function, taskRegisterWord
    const task = Machine.load(request + requestFirst)
    const frame = Machine.load(request + requestSecond)
    const state = Machine.load(request + requestWords)
    if ensureFrame(registers, base, image, function) {
      for offset in 0..taskRegister {
        storeRegister(registers, base + offset, Machine.load(frame + 8 * offset))
      }
      storeRegister(registers, base + taskRegister, task)
      const resumed = Machine.load(image.resumesAddress + 8 * (header(image, function, resumesWord) + state))
      const at = header(image, function, codeWord) + resumed
      poll = execute registers.words, kernelScratch(), budget, registers, image, program, function, base, at, 0
      answered = poll
    } else {
      poll = haltedPoll
    }
  } else if kind == equalsRequest || kind == hashRequest {
    // An `equals` or a `hash` of an element: its operands are elements of the runtime's storage, borrowed, as the C
    // back end's element helpers pass them
    const function = Machine.load(request + requestChunk)
    const width = Machine.load(request + requestWords)
    if ensureFrame(registers, base, image, function) {
      var sources = [Machine.load(request + requestFirst)]
      if kind == equalsRequest {
        sources.append Machine.load(request + requestSecond)
      }
      for index in 0..sources.length() {
        const offset = parameterWord image, function, index, 0
        for word in 0..width {
          storeRegister(registers, base + offset + word, Machine.load(sources[index] + 8 * word))
        }
      }
      storeRegister registers, result, 0
      const into = registers.address + 8 * result
      poll = execute(registers.words, kernelScratch(), budget, registers, image, program, function, base, 0 - 1, into)
      answered = loadRegister registers, result
    } else {
      poll = haltedPoll
    }
  } else {
    panicInternal "the kernel asked the interpreter for a request it does not know"
  }
  registers.top = saved
  if poll == haltedPoll {
    const _ = kernelCall registers.words, kernelScratch(), saved, KernelOperation.StopInCallBack, []
    return 0
  }
  answered
}

/** What the body of a task answers the scheduler (`torb_poll`), and what a chunk that returns answers. */
const suspendedPoll = 0

const finishedPoll = 1

const stoppedPoll = 2

/** What [execute] answers where a sandboxed script stopped: no poll of the runtime's, the loop unwinds the script. */
const haltedPoll = 3

/** What `torb_task_await` answers where it registered the task (`TORB_WAIT_SUSPENDED`). */
const registeredWait = 0

// --- Loading --------------------------------------------------------------------------------------------------------

/**
 * Everything a program needs before its first instruction: the constant pool at the bottom of the words, and the
 * locations, element descriptors and shapes of the kernel's tables.
 */
fn loadProgram(var words: ArrayList<Int>, var kernel: ArrayList<Int>, registers: Registers, program: BytecodeProgram) {
  const _ = loadFrom words, kernel, registers, program, LoadedCounts()
}

/**
 * What [loadProgram] does for the part of the program after `from`: the part a continuation added. `above` is the
 * first register it may use for itself; `-1` is the first frame, where nothing runs yet.
 */
fn loadFrom(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  program: BytecodeProgram,
  from: LoadedCounts,
  above: Int = 0 - 1,
): LoadedCounts {
  const scratch = if above < 0 { firstFrameOf program } else { above }
  ensureRegisters(registers, scratch + scratchWords * 4)
  var offset = from.words
  for index in from.parts..program.constants.length() {
    const part = program.constants[index]
    placePart words, kernel, registers, part, offset, scratch
    offset = offset + widthOfPart(part)
  }
  for index in from.locations..program.locations.length() {
    const location = program.locations[index]
    Machine.placeText words, scratch, location.path
    kernelCall words, kernel, scratch, KernelOperation.DefineLocation, [index, 0, location.line, location.column]
  }
  var canonical = CanonicalShapes()
  for index in from.elements..program.elements.length() {
    const element = program.elements[index]
    const (kind, shape) = match element.kind {
      .Trivial => (0, 0 - 1)
      .TextElement => (1, 0 - 1)
      .Counted(found) => (2, canonicalShapeOf(canonical, program, found))
      .Narrow(code) => (3, code)
    }
    // An element whose words are not its identity is compared and hashed by the program's own `equals` and `hash`
    const (equals, hash) = if element.comparesByWords { (0 - 1, 0 - 1) } else { (element.equals, element.hash) }
    const operands = [index, element.words, kind, shape, equals, hash]
    kernelCall words, kernel, scratch, KernelOperation.DefineElement, operands
  }
  for index in from.shapes..program.shapes.length() {
    kernelCall words, kernel, scratch, KernelOperation.DefineShape, shapeOperands(index, program.shapes[index])
  }
  LoadedCounts(
    program.constants.length(),
    offset,
    program.locations.length(),
    program.elements.length(),
    program.shapes.length(),
  )
}

/**
 * The first shape of the program that is the same as a shape: the same name, words, counts, variants and destructor
 * function. A counted element descriptor is made from the canonical one, so that two continuations of a session that
 * both hold a `List<Point>` share one of the kernel's callback slots instead of taking one each, and the slots last as
 * long as the session does.
 */
type CanonicalShapes {
  var keys: Map<Int, String> = [:]
  var firsts: Map<String, Int> = [:]
  var known: Int = 0
}

fn canonicalShapeOf(var canonical: CanonicalShapes, program: BytecodeProgram, shape: Int): Int {
  while canonical.known < program.shapes.length() {
    const key = shapeKey program, canonical.known, []
    if !canonical.firsts.containsKey(key) {
      canonical.firsts.set key, canonical.known
    }
    canonical.keys.set canonical.known, key
    canonical.known = canonical.known + 1
  }
  const key = canonical.keys.get(shape) ?? ""
  canonical.firsts.get(key) ?? shape
}

/** What a shape does, as text: a nested shape by its own key, and one already being described by its name alone. */
fn shapeKey(program: BytecodeProgram, index: Int, visiting: List<Int>): String {
  const shape = match program.shapes.get(index) {
    Some(found) => found
    None => {
      return "?"
    }
  }
  if visiting.contains(index) {
    return "^{shape.name}"
  }
  const inside = visiting.appended index
  const closer = match program.chunks.get(shape.closer) {
    Some(chunk) => chunk.name
    None => ""
  }
  var key = "{shape.name.byteLength()}:{shape.name}|{shape.width}|{shape.tag}|{closer}|{shape.reversed}|"
  key = key + groupKey(program, shape.counted, inside)
  for group in shape.groups {
    key = key + "/" + groupKey(program, group, inside)
  }
  key
}

fn groupKey(program: BytecodeProgram, words: List<CountedWord>, visiting: List<Int>): String {
  var key = "["
  for word in words {
    const kind = match word.kind {
      .TextStorage => "t"
      .ListStorage => "l"
      .MapStorage => "m"
      .SetStorage => "s"
      .TaskObject => "k"
      .ChannelObject => "c"
      .FileHandle => "f"
      .Block(contents) => "b" + shapeKey(program, contents, visiting)
      .Environment => "e"
      .Payload => "p"
      .Nested(inner) => "n" + shapeKey(program, inner, visiting)
    }
    key = key + "{word.offset}{kind};"
  }
  key + "]"
}

/** Where the first frame begins: after the constant pool, whose gaps hold the cells of the constants. */
fn firstFrameOf(program: BytecodeProgram): Int {
  program.constantWords
}

/** One part of the constant pool into its words; a block part becomes an immortal block, as a static of C is. */
fn placePart(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  part: ConstantPart,
  offset: Int,
  scratch: Int,
) {
  match part {
    .Word(value) => storeRegister registers, offset, value
    .Floating(value) => Machine.placeFloat words, offset, value
    .Text(value) => Machine.placeText words, offset, value
    .Block(shape, parts) => {
      // The contents are placed above everything in use, then copied into the block in one piece
      var width = 0
      for inside in parts {
        width = width + widthOfPart(inside)
      }
      const contents = scratch + scratchWords
      ensureRegisters(registers, contents + width + scratchWords)
      var cursor = contents
      for inside in parts {
        placePart(words, kernel, registers, inside, cursor, cursor + width + scratchWords)
        cursor = cursor + widthOfPart(inside)
      }
      const operands = [scratchWords - 1, shape, recordBlockKind, width, 1, 0, scratchWords, width]
      kernelCall words, kernel, scratch, KernelOperation.BlockNew, operands
      kernelCall words, kernel, scratch, KernelOperation.MakeImmortal, [scratchWords - 1]
      storeRegister registers, offset, loadRegister(registers, scratch + scratchWords - 1)
    }
    .Gap(width) => {
      for index in 0..width {
        storeRegister(registers, offset + index, 0)
      }
    }
  }
}

/** A shape as the kernel's `DefineShape` reads it. */
fn shapeOperands(index: Int, shape: Shape): List<Int> {
  var operands = [index, shape.width, shape.tag, shape.closer, if shape.reversed { 1 } else { 0 }]
  appendGroup operands, shape.counted
  operands.append shape.groups.length()
  for group in shape.groups {
    appendGroup operands, group
  }
  operands
}

fn appendGroup(var operands: List<Int>, words: List<CountedWord>) {
  operands.append words.length()
  for word in words {
    operands.append word.offset
    const (kind, shape) = match word.kind {
      .TextStorage => (0, 0 - 1)
      .ListStorage => (1, 0 - 1)
      .MapStorage => (2, 0 - 1)
      .SetStorage => (3, 0 - 1)
      .TaskObject => (4, 0 - 1)
      .ChannelObject => (5, 0 - 1)
      .FileHandle => (6, 0 - 1)
      .Block(contents) => (7, contents)
      .Environment => (8, 0 - 1)
      .Payload => (9, 0 - 1)
      .Nested(inner) => (10, inner)
    }
    operands.append kind
    operands.append shape
  }
}

// --- The kernel -----------------------------------------------------------------------------------------------------

/**
 * One operation of the kernel with operands the interpreter makes itself; the registers are relative to `base`. Inside
 * a sandbox it answers `stoppedWord` where the operation stopped the script.
 */
fn kernelCall(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  base: Int,
  operation: KernelOperation,
  operands: List<Int>,
): Int {
  while kernel.length() < operands.length() + 1 {
    kernel.append 0
  }
  kernel.set 0, kernelNumberOf(operation)
  for index in 0..operands.length() {
    kernel.set(index + 1, operands[index])
  }
  Machine.operate words, base, kernel, 0
}

// --- Registers and references ---------------------------------------------------------------------------------------

/** The register with this absolute index. */
fn loadRegister(registers: Registers, index: Int): Int {
  Machine.load(registers.address + 8 * index)
}

fn storeRegister(registers: Registers, index: Int, value: Int) {
  Machine.store(registers.address + 8 * index, value)
}

/**
 * The registers up to `count` zeroed, which is what every frame finds the first time the stack reaches it; the stack
 * never goes beyond [largestStack], which the calls check first.
 */
fn ensureRegisters(registers: Registers, count: Int) {
  if count <= registers.extent {
    return
  }
  var reached = registers.extent + zeroedAtOnce
  if reached < count {
    reached = count
  }
  if reached > registers.limit + 4 * scratchWords {
    reached = registers.limit + 4 * scratchWords
  }
  for index in registers.extent..reached {
    storeRegister registers, index, 0
  }
  registers.extent = reached
}

/** One word of a chunk's header. */
fn header(image: Image, chunk: Int, word: Int): Int {
  Machine.load(image.headersAddress + 8 * (chunk * headerWords + word))
}

/** One word of a parameter of a chunk: its register (0), its width (1), a reference (2), its shape (3). */
fn parameterWord(image: Image, chunk: Int, parameter: Int, word: Int): Int {
  const index = (header(image, chunk, firstParameterWord) + parameter) * parameterWords + word
  Machine.load(image.parametersAddress + 8 * index)
}

/**
 * The callee's frame, and the recursion limit the runtime reports as a stack overflow. Answers false where that
 * overflow stopped a sandboxed script.
 */
fn ensureFrame(registers: Registers, calleeBase: Int, image: Image, callee: Int): Bool {
  const needed = calleeBase + header(image, callee, frameWord) + scratchWords
  if needed > registers.limit {
    const location = header image, callee, locationWord
    const _ = kernelCall registers.words, kernelScratch(), 0, KernelOperation.StackOverflow, [location]
    return false
  }
  ensureRegisters registers, needed
  true
}

/**
 * Where a place of the chunk is, as an address: the base register (or the address a `var` parameter holds), then one
 * step at a time - an offset, a dereference of a counted block, an element of a list through the kernel, an item of an
 * array. `stoppedWord` where the kernel stopped a sandboxed script on the way, an index out of range say.
 */
fn resolvePlace(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  place: Int,
  base: Int,
  top: Int,
): Int {
  const register = registers.address + 8 * (base + Machine.load(place))
  var address = if Machine.load(place + 8) != 0 { Machine.load register } else { register }
  const steps = Machine.load(place + 24)
  for position in 0..steps {
    const step = place + 40 + 8 * stepWords * position
    const kind = Machine.load step
    if kind == offsetStep {
      address = address + 8 * Machine.load(step + 8)
    } else if kind == dereferenceStep {
      address = Machine.load(address) + contentsOffset
    } else if kind == elementStep {
      // The container's address goes into the scratch word above the frame
      storeRegister registers, top, address
      const operands = [0, base + Machine.load(step + 8) - top, Machine.load(step + 16)]
      address = kernelCall words, kernel, top, KernelOperation.ElementAddress, operands
      if address == stoppedWord {
        return stoppedWord
      }
    } else if kind == listItemStep {
      storeRegister registers, top, address
      const operands = [0, base + Machine.load(step + 8) - top, Machine.load(step + 16)]
      address = kernelCall words, kernel, top, KernelOperation.ListItemAddress, operands
      if address == stoppedWord {
        return stoppedWord
      }
    } else {
      const at = loadRegister(registers, base + Machine.load(step + 8))
      if at < 0 || at >= Machine.load(step + 16) {
        // The message of the `at` of `Array`, at the site the step carries
        storeRegister registers, top, at
        storeRegister(registers, top + 1, Machine.load(step + 16))
        const _ = kernelCall words, kernel, top, KernelOperation.IndexOutOfBounds, [0, 1, Machine.load(step + 32)]
        return stoppedWord
      }
      address = address + 8 * at * Machine.load(step + 24)
    }
  }
  address
}

// --- The loop -------------------------------------------------------------------------------------------------------

/**
 * Runs one chunk to its return, with its frame from `entryBase` on - from its first instruction, or from `entryPc`
 * where the scheduler resumes a task's body - and hands the bottom frame's result to the words at `resultAddress`, 0
 * for none. Every call it makes is a frame of this loop, with its return record in the words below it; a destructor that has to run in the middle of an instruction is one more `execute`, above every word
 * in use. Answers the poll of a task's body, [finishedPoll] for a chunk that returns, and [haltedPoll] where a
 * sandboxed script stopped - after adding the frames of this loop to `budget.frames`.
 */
fn execute(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  var budget: Budget,
  registers: Registers,
  entryImage: Image,
  entryProgram: BytecodeProgram,
  entry: Int,
  entryBase: Int,
  entryPc: Int,
  resultAddress: Int,
): Int {
  const tracing = Environment.get("TORB_VM_TRACE").isSome()
  // A script loaded from a path only known while the program runs appends chunks (`LoadScript`): the image grows, and
  // a closure or a witness table of the new part reaches this loop through a value, so the loop takes the new image
  // wherever a chunk comes out of a value. Every chunk keeps its index and its code offset in the new image.
  var image = entryImage
  var program = entryProgram
  var code = image.codeAddress
  var generation = registers.generation
  // An empty list: a call of the kernel then reads its operation at the address it is given, in the code
  const instructions: ArrayList<Int> = ArrayList.withCapacity 0
  const first = registers.address
  const pool = registers.pool
  var chunk = entry
  var base = entryBase
  var frame = first + 8 * base
  var top = base + header(image, chunk, frameWord)
  var places = header image, chunk, placesWord
  var pc = if entryPc >= 0 { entryPc } else { header image, chunk, codeWord }
  // How many calls this loop made that have not returned: the bottom frame's return ends the loop
  var depth = 0
  ensureRegisters(registers, top + scratchWords)
  loop {
    budget.countdown = budget.countdown - 1
    if budget.countdown < 0 {
      if !refill(budget) {
        noteFrames budget, image, first, chunk, pc, base, depth
        return haltedPoll
      }
    }
    const head = Machine.load(code + 8 * pc)
    const a = head >> 8 & 65535
    const b = head >> 24 & 65535
    const c = head >> 40 & 65535
    const opcode = opcodeOf(head & 255)
    if tracing {
      printError "{nameOf(program, chunk)} {pc} {opcode.spelling()} base {base}"
    }
    match opcode {
      .Move => {
        for offset in 0..c {
          Machine.store(frame + 8 * (a + offset), Machine.load(frame + 8 * (b + offset)))
        }
        pc = pc + 1
      }
      .Constant => {
        const offset = Machine.load(code + 8 * (pc + 1))
        for index in 0..b {
          Machine.store(frame + 8 * (a + index), Machine.load(pool + 8 * (offset + index)))
        }
        pc = pc + 2
      }
      .Word => {
        Machine.store(frame + 8 * a, Machine.load(code + 8 * (pc + 1)))
        pc = pc + 2
      }
      .Zero => {
        for offset in 0..b {
          Machine.store(frame + 8 * (a + offset), 0)
        }
        pc = pc + 1
      }
      .Load => {
        const place = placeAt image, places, b
        const address = resolvePlace words, kernel, registers, place, base, top
        if address == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        const narrow = Machine.load(place + 32)
        if narrow != 0 {
          // An element of a list stored in its own width: the kernel reads exactly its bytes
          if kernelCall(words, kernel, base, KernelOperation.NarrowLoad, [a, address, narrow]) == stoppedWord {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        } else {
          for offset in 0..Machine.load(place + 16) {
            Machine.store(frame + 8 * (a + offset), Machine.load(address + 8 * offset))
          }
        }
        pc = pc + 1
      }
      .Store => {
        const place = placeAt image, places, a
        const address = resolvePlace words, kernel, registers, place, base, top
        if address == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        const narrow = Machine.load(place + 32)
        if narrow != 0 {
          if kernelCall(words, kernel, base, KernelOperation.NarrowStore, [address, b, narrow]) == stoppedWord {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        } else {
          for offset in 0..Machine.load(place + 16) {
            Machine.store(address + 8 * offset, Machine.load(frame + 8 * (b + offset)))
          }
        }
        pc = pc + 1
      }
      .Reference => {
        const place = placeAt image, places, b
        const address = resolvePlace words, kernel, registers, place, base, top
        if address == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        Machine.store(frame + 8 * a, address)
        pc = pc + 1
      }
      .Kernel => {
        registers.top = top
        const queued = Machine.operate(words, base, instructions, code + 8 * (pc + 1))
        if queued == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        if queued > 0 {
          if registers.generation != generation {
            image = registers.image
            program = registers.program
            code = image.codeAddress
            generation = registers.generation
          }
          if !runClosers(words, kernel, budget, registers, image, program, top) {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        }
        pc = pc + 1 + a
      }
      .Call => {
        const callee = Machine.load(code + 8 * (pc + 1))
        const calleeBase = top + scratchWords
        const calleeFrame = first + 8 * calleeBase
        if !ensureFrame(registers, calleeBase, image, callee) {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        const parameters = image.parametersAddress + 8 * parameterWords * header(image, callee, firstParameterWord)
        for index in 0..b {
          const parameter = parameters + 8 * parameterWords * index
          const source = frame + 8 * Machine.load(code + 8 * (pc + 2 + index))
          const target = calleeFrame + 8 * Machine.load(parameter)
          for offset in 0..Machine.load(parameter + 8) {
            Machine.store(target + 8 * offset, Machine.load(source + 8 * offset))
          }
        }
        enter(calleeFrame, pc + 2 + b, base, chunk, if c == 1 { base + a } else { 0 - 1 })
        depth = depth + 1
        chunk = callee
        base = calleeBase
        frame = calleeFrame
        top = base + header(image, chunk, frameWord)
        places = header image, chunk, placesWord
        pc = header image, chunk, codeWord
      }
      .CallClosure => {
        if registers.generation != generation {
          image = registers.image
          program = registers.program
          code = image.codeAddress
          generation = registers.generation
        }
        const closure = frame + 8 * b
        const callee = Machine.load(closure) - 1
        const calleeBase = top + scratchWords
        const calleeFrame = first + 8 * calleeBase
        if !ensureFrame(registers, calleeBase, image, callee) {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        var given = 0
        if header(image, callee, environmentWord) != 0 {
          Machine.store(calleeFrame + 8 * parameterWord(image, callee, 0, 0), Machine.load(closure + 8))
          given = 1
        }
        for index in 0..c {
          const source = frame + 8 * Machine.load(code + 8 * (pc + 2 + index))
          const target = calleeFrame + 8 * parameterWord(image, callee, given + index, 0)
          for offset in 0..parameterWord(image, callee, given + index, 1) {
            Machine.store(target + 8 * offset, Machine.load(source + 8 * offset))
          }
        }
        const hasResult = Machine.load(code + 8 * (pc + 1)) == 1
        enter(calleeFrame, pc + 2 + c, base, chunk, if hasResult { base + a } else { 0 - 1 })
        depth = depth + 1
        chunk = callee
        base = calleeBase
        frame = calleeFrame
        top = base + header(image, chunk, frameWord)
        places = header image, chunk, placesWord
        pc = header image, chunk, codeWord
      }
      .CallWitness => {
        if registers.generation != generation {
          image = registers.image
          program = registers.program
          code = image.codeAddress
          generation = registers.generation
        }
        const witness = witnessAt(image, header(image, chunk, witnessesWord) + Machine.load(code + 8 * (pc + 1)))
        const member = Machine.load(code + 8 * (pc + 2))
        const (table, payload) = resolveWitness words, kernel, registers, image, witness, places, base, top
        if table == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        const callee = tableWord(image, table, 1 + member)
        const calleeBase = top + scratchWords
        const calleeFrame = first + 8 * calleeBase
        if !ensureFrame(registers, calleeBase, image, callee) {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        const receiver = calleeFrame + 8 * parameterWord(image, callee, 0, 0)
        if parameterWord(image, callee, 0, 2) != 0 {
          Machine.store(receiver, payload + contentsOffset)
        } else {
          for offset in 0..parameterWord(image, callee, 0, 1) {
            Machine.store(receiver + 8 * offset, Machine.load(payload + contentsOffset + 8 * offset))
          }
        }
        for index in 0..b {
          const source = frame + 8 * Machine.load(code + 8 * (pc + 3 + index))
          const target = calleeFrame + 8 * parameterWord(image, callee, 1 + index, 0)
          for offset in 0..parameterWord(image, callee, 1 + index, 1) {
            Machine.store(target + 8 * offset, Machine.load(source + 8 * offset))
          }
        }
        // The erased convention borrows every operand, so what the member takes owned is retained here, as the C
        // back end's witness thunk retains it
        for index in 0..header(image, callee, parameterCountWord) {
          const shape = parameterWord image, callee, index, 3
          if shape >= 0 {
            const register = calleeBase + parameterWord(image, callee, index, 0) - top
            if kernelCall(words, kernel, top, KernelOperation.Retain, [register, shape]) == stoppedWord {
              noteFrames budget, image, first, chunk, pc, base, depth
              return haltedPoll
            }
          }
        }
        enter(calleeFrame, pc + 3 + b, base, chunk, if c == 1 { base + a } else { 0 - 1 })
        depth = depth + 1
        chunk = callee
        base = calleeBase
        frame = calleeFrame
        top = base + header(image, chunk, frameWord)
        places = header image, chunk, placesWord
        pc = header image, chunk, codeWord
      }
      .WitnessTable => {
        const witness = witnessAt(image, header(image, chunk, witnessesWord) + b)
        const (table, _) = resolveWitness words, kernel, registers, image, witness, places, base, top
        if table == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        Machine.store(frame + 8 * a, table + 1)
        pc = pc + 1
      }
      .Return => {
        const source = frame + 8 * a
        if depth == 0 {
          // The bottom frame hands its result to whoever ran this loop: a module constant's cell, a call back
          if resultAddress != 0 {
            for offset in 0..b {
              Machine.store(resultAddress + 8 * offset, Machine.load(source + 8 * offset))
            }
          }
          return finishedPoll
        }
        // The return record below the frame: where to go on, the caller's base and chunk, and the result's register
        const target = Machine.load(frame - 8)
        if target >= 0 {
          for offset in 0..b {
            Machine.store(first + 8 * (target + offset), Machine.load(source + 8 * offset))
          }
        }
        pc = Machine.load(frame - 32)
        base = Machine.load(frame - 24)
        chunk = Machine.load(frame - 16)
        depth = depth - 1
        frame = first + 8 * base
        top = base + header(image, chunk, frameWord)
        places = header image, chunk, placesWord
      }
      .AddInteger => {
        const left = Machine.load(frame + 8 * b)
        const right = Machine.load(frame + 8 * c)
        if (right > 0 && left > largest - right) || (right < 0 && left < smallest - right) {
          if !checkedByKernel(words, kernel, base, top, a, b, c, Machine.load(code + 8 * (pc + 1)), 0) {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        }
        Machine.store(frame + 8 * a, left + right)
        pc = pc + 2
      }
      .SubtractInteger => {
        const left = Machine.load(frame + 8 * b)
        const right = Machine.load(frame + 8 * c)
        if (right < 0 && left > largest + right) || (right > 0 && left < smallest + right) {
          if !checkedByKernel(words, kernel, base, top, a, b, c, Machine.load(code + 8 * (pc + 1)), 1) {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        }
        Machine.store(frame + 8 * a, left - right)
        pc = pc + 2
      }
      .MultiplyInteger => {
        const left = Machine.load(frame + 8 * b)
        const right = Machine.load(frame + 8 * c)
        if isSmall(left) && isSmall(right) {
          Machine.store(frame + 8 * a, left * right)
        } else if !checkedByKernel(words, kernel, base, top, a, b, c, Machine.load(code + 8 * (pc + 1)), 2) {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        pc = pc + 2
      }
      .DivideInteger => {
        const left = Machine.load(frame + 8 * b)
        const right = Machine.load(frame + 8 * c)
        if right == 0 || (right == 0 - 1 && left == smallest) {
          if !checkedByKernel(words, kernel, base, top, a, b, c, Machine.load(code + 8 * (pc + 1)), 3) {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        } else {
          Machine.store(frame + 8 * a, left / right)
        }
        pc = pc + 2
      }
      .RemainderInteger => {
        const left = Machine.load(frame + 8 * b)
        const right = Machine.load(frame + 8 * c)
        if right == 0 || (right == 0 - 1 && left == smallest) {
          if !checkedByKernel(words, kernel, base, top, a, b, c, Machine.load(code + 8 * (pc + 1)), 4) {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        } else {
          Machine.store(frame + 8 * a, left % right)
        }
        pc = pc + 2
      }
      .NegateInteger => {
        const operand = Machine.load(frame + 8 * b)
        if operand == smallest {
          if !checkedByKernel(words, kernel, base, top, a, b, b, Machine.load(code + 8 * (pc + 1)), 5) {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        }
        Machine.store(frame + 8 * a, 0 - operand)
        pc = pc + 2
      }
      .AddUnchecked => {
        Machine.store(frame + 8 * a, Machine.load(frame + 8 * b) + Machine.load(frame + 8 * c))
        pc = pc + 1
      }
      .SubtractUnchecked => {
        Machine.store(frame + 8 * a, Machine.load(frame + 8 * b) - Machine.load(frame + 8 * c))
        pc = pc + 1
      }
      .MultiplyUnchecked => {
        Machine.store(frame + 8 * a, Machine.load(frame + 8 * b) * Machine.load(frame + 8 * c))
        pc = pc + 1
      }
      .Equal => {
        Machine.store(frame + 8 * a, flag(Machine.load(frame + 8 * b) == Machine.load(frame + 8 * c)))
        pc = pc + 1
      }
      .NotEqual => {
        Machine.store(frame + 8 * a, flag(Machine.load(frame + 8 * b) != Machine.load(frame + 8 * c)))
        pc = pc + 1
      }
      .Less => {
        Machine.store(frame + 8 * a, flag(Machine.load(frame + 8 * b) < Machine.load(frame + 8 * c)))
        pc = pc + 1
      }
      .LessOrEqual => {
        Machine.store(frame + 8 * a, flag(Machine.load(frame + 8 * b) <= Machine.load(frame + 8 * c)))
        pc = pc + 1
      }
      .Greater => {
        Machine.store(frame + 8 * a, flag(Machine.load(frame + 8 * b) > Machine.load(frame + 8 * c)))
        pc = pc + 1
      }
      .GreaterOrEqual => {
        Machine.store(frame + 8 * a, flag(Machine.load(frame + 8 * b) >= Machine.load(frame + 8 * c)))
        pc = pc + 1
      }
      .Not => {
        Machine.store(frame + 8 * a, flag(Machine.load(frame + 8 * b) == 0))
        pc = pc + 1
      }
      .Tag => {
        Machine.store(frame + 8 * a, Machine.load(frame + 8 * (b + c)))
        pc = pc + 1
      }
      .TagNiche => {
        const empty = if c == 0 { 1 } else { 0 }
        Machine.store(frame + 8 * a, if Machine.load(frame + 8 * b) != 0 { c } else { empty })
        pc = pc + 1
      }
      .Jump => {
        pc = Machine.load(code + 8 * (pc + 1))
      }
      .Branch => {
        pc = if Machine.load(frame + 8 * a) != 0 {
          Machine.load(code + 8 * (pc + 1))
        } else {
          Machine.load(code + 8 * (pc + 2))
        }
      }
      .Switch => {
        const scrutinee = Machine.load(frame + 8 * a)
        var next = Machine.load(code + 8 * (pc + 1 + 2 * b))
        for index in 0..b {
          if Machine.load(code + 8 * (pc + 1 + 2 * index)) == scrutinee {
            next = Machine.load(code + 8 * (pc + 2 + 2 * index))
            break
          }
        }
        pc = next
      }
      .Unreachable => {
        panicInternal "the VM reached code the IR says nothing reaches, in `{nameOf(program, chunk)}`"
      }
      .Stop => {
        return stoppedPoll
      }
      .RunScript => {
        const grant = Machine.load(code + 8 * (pc + 1))
        const callee = Machine.load(frame + 8 * b) - 1
        const environment = Machine.load(frame + 8 * (b + 1))
        runScriptInstruction words, kernel, registers, image, program, base, top, a, callee, environment, c, grant
        pc = pc + 2
      }
      .LoadScript => {
        loadScriptInstruction words, kernel, registers, base, top, a, b, c
        image = registers.image
        program = registers.program
        code = image.codeAddress
        generation = registers.generation
        pc = pc + 1
      }
      .RunLoaded => {
        const grant = Machine.load(code + 8 * (pc + 1))
        const callee = Machine.load(frame + 8 * b)
        if !registers.loadedScripts.contains(callee) {
          panicInternal "`runLoadedScript` of a chunk that is no script the program loaded"
        }
        runScriptInstruction words, kernel, registers, image, program, base, top, a, callee, 0, c, grant
        pc = pc + 2
      }
      .Cancelled => {
        const cancelled = kernelCall words, kernel, base, KernelOperation.TaskCancelled, [a]
        if cancelled == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        pc = if cancelled != 0 { Machine.load(code + 8 * (pc + 1)) } else { pc + 2 }
      }
      .Suspend => {
        const observes = Machine.load(code + 8 * (pc + 1))
        const waited = kernelCall words, kernel, base, KernelOperation.TaskAwait, [a, b, c, observes]
        if waited == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        if waited == registeredWait {
          // Registered where it waits: the frame goes into the task block, and the scheduler resumes the body at the
          // state's `resume` - which only happens to the bottom frame, the one the scheduler called
          if depth != 0 {
            panicInternal "a task suspended below the frame the scheduler resumed, in `{nameOf(program, chunk)}`"
          }
          const saved = header(image, chunk, taskRegisterWord) + 1
          if kernelCall(words, kernel, base, KernelOperation.TaskSave, [a, saved]) == stoppedWord {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
          return suspendedPoll
        }
        pc = pc + 2
      }
      .Resume => {
        const cancelled = kernelCall words, kernel, base, KernelOperation.TaskCancelled, [a]
        if cancelled == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        if cancelled != 0 {
          pc = Machine.load(code + 8 * (pc + 1))
        } else {
          if kernelCall(words, kernel, base, KernelOperation.TaskOutcome, [a]) == stoppedWord {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
          pc = pc + 2
        }
      }
      .Finish => {
        if kernelCall(words, kernel, base, KernelOperation.TaskFinish, [a, b, c]) == stoppedWord {
          noteFrames budget, image, first, chunk, pc, base, depth
          return haltedPoll
        }
        return finishedPoll
      }
      .EntryCell => {
        const cell = pool + 8 * Machine.load(code + 8 * (pc + 1))
        for offset in 0..b {
          if c == 0 {
            Machine.store(frame + 8 * (a + offset), Machine.load(cell + 8 * offset))
          } else {
            Machine.store(cell + 8 * offset, Machine.load(frame + 8 * (a + offset)))
          }
        }
        pc = pc + 2
      }
      .Cell => {
        const cell = pool + 8 * Machine.load(code + 8 * (pc + 1))
        if Machine.load(cell) == 0 {
          const initializer = Machine.load(code + 8 * (pc + 2))
          if !buildCell(words, kernel, budget, registers, image, program, initializer, cell, top) {
            noteFrames budget, image, first, chunk, pc, base, depth
            return haltedPoll
          }
        }
        for offset in 0..b {
          Machine.store(frame + 8 * (a + offset), Machine.load(cell + 8 * (1 + offset)))
        }
        pc = pc + 3
      }
    }
  }
}

/**
 * The first read of a module constant builds it, into the cell at the address `cell` - its flag, then its value: under
 * the runtime's lock of constants, because two workers may read it at once, inside an immortal region, and with the
 * flag published once the value is in place, as the C back end's accessor does (`torb_constant_ready`). Answers false
 * where a sandboxed script stopped on the way; the lock is given back either way.
 */
fn buildCell(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  var budget: Budget,
  registers: Registers,
  image: Image,
  program: BytecodeProgram,
  initializer: Int,
  cell: Int,
  top: Int,
): Bool {
  if kernelCall(words, kernel, top, KernelOperation.ConstantLock, []) == stoppedWord {
    return false
  }
  var built = true
  var publish = 0
  // Another thread may have built it while this one waited for the lock
  if Machine.load(cell) == 0 {
    built = kernelCall(words, kernel, top, KernelOperation.BeginImmortal, []) != stoppedWord
    if built {
      const inner = top + scratchWords
      built = ensureFrame registers, inner, image, initializer
      if built {
        const poll = execute(words, kernel, budget, registers, image, program, initializer, inner, 0 - 1, cell + 8)
        built = poll != haltedPoll
      }
      // The region is closed whether or not the initializer ran to its end: a stop must not leave the host allocating
      // immortal blocks
      if kernelCall(words, kernel, top, KernelOperation.EndImmortal, []) == stoppedWord {
        built = false
      }
    }
    if built {
      publish = 1
    }
  }
  const unlocked = kernelCall words, kernel, top, KernelOperation.ConstantUnlock, [cell, publish]
  built && unlocked != stoppedWord
}

/** The name of a chunk for a message of the VM itself; a worker's registers hold no program, so there it is a number. */
fn nameOf(program: BytecodeProgram, chunk: Int): String {
  match program.chunks.get(chunk) {
    Some(found) => found.name
    None => "chunk {chunk}"
  }
}

/** The return record of a call, in the four words below the callee's frame. */
fn enter(calleeFrame: Int, pc: Int, base: Int, chunk: Int, target: Int) {
  Machine.store(calleeFrame - 32, pc)
  Machine.store(calleeFrame - 24, base)
  Machine.store(calleeFrame - 16, chunk)
  Machine.store(calleeFrame - 8, target)
}

/**
 * The countdown ran out: the step limit and the clock are looked at, and the next `checkInterval` steps are handed
 * out. Answers false, with the reason, where a limit is reached.
 */
fn refill(var budget: Budget): Bool {
  // Ctrl+C of `torb repl` (docs/design/REPL.md section 2): nothing sets this flag unless `installInterruptHandler`
  // ran, which only `torb repl` calls, so every other command pays one native call per `checkInterval` steps for
  // an answer that is always false.
  if interrupted() {
    budget.reason = "Interrupted"
    return false
  }
  if budget.remaining <= 0 {
    budget.reason = "The script ran more than {budget.steps} steps"
    return false
  }
  if budget.deadline > 0 && Clock.milliseconds() > budget.deadline {
    budget.reason = "The script ran longer than {budget.milliseconds} milliseconds"
    return false
  }
  const next = if budget.remaining < checkInterval { budget.remaining } else { checkInterval }
  // This step is the first of them
  budget.countdown = next - 1
  budget.remaining = budget.remaining - next
  true
}

/**
 * The frames of one loop, the innermost first, after the ones of the loops above it that stopped already: the
 * innermost at `pc`, then every caller at the code offset its return record goes on at - each an offset into its own
 * chunk, as the chunk's sites count them.
 */
fn noteFrames(var budget: Budget, image: Image, first: Int, chunk: Int, pc: Int, base: Int, depth: Int) {
  budget.frames.append((chunk, pc - header(image, chunk, codeWord)))
  var frame = first + 8 * base
  for _ in 0..depth {
    const callerPc = Machine.load(frame - 32)
    const callerBase = Machine.load(frame - 24)
    const callerChunk = Machine.load(frame - 16)
    budget.frames.append((callerChunk, callerPc - header(image, callerChunk, codeWord)))
    frame = first + 8 * callerBase
  }
}

const largest = 9223372036854775807

const smallest = 0 - 9223372036854775807 - 1

/** Whether two factors of this size multiply without leaving 64 bits. */
fn isSmall(value: Int): Bool {
  value > 0 - 2147483648 && value < 2147483648
}

fn flag(condition: Bool): Int {
  if condition {
    return 1
  }
  0
}

/**
 * An `Int64` operation whose check the interpreter could not settle itself: the kernel runs it through the helper of
 * `torb_number.h` the C back end calls, which panics with the runtime's own message at the operation's location.
 * Answers false where that panic stopped a sandboxed script.
 */
fn checkedByKernel(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  base: Int,
  top: Int,
  target: Int,
  first: Int,
  second: Int,
  location: Int,
  operation: Int,
): Bool {
  const operands = [target + base - top, first + base - top, second + base - top, location, operation + 256, 4]
  kernelCall(words, kernel, top, KernelOperation.Arithmetic, operands) != stoppedWord
}

/** An error of the VM itself, never of the program: the runtime's panic, as every internal error of torb is. */
fn panicInternal(message: String): Never {
  panic "internal error: {message}"
}

/** One word of the witness tables: `index` words into the table `table`. */
fn tableWord(image: Image, table: Int, index: Int): Int {
  const start = Machine.load(image.tablesAddress + 8 * table)
  Machine.load(image.tablesAddress + 8 * (start + index))
}

/**
 * The table a witness source names and the payload block of the value it came from: the table word of the
 * trait-typed value (its index plus one) or a static table, then one nested step per supertrait. The table is
 * `stoppedWord` where resolving the value's place stopped a sandboxed script.
 */
fn resolveWitness(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  registers: Registers,
  image: Image,
  witness: Int,
  places: Int,
  base: Int,
  top: Int,
): (Int, Int) {
  var table = 0
  var payload = 0
  if Machine.load(witness) == 0 {
    table = Machine.load(witness + 8)
  } else {
    const place = placeAt image, places, Machine.load(witness + 8)
    const address = resolvePlace words, kernel, registers, place, base, top
    if address == stoppedWord {
      return (stoppedWord, 0)
    }
    payload = Machine.load address
    table = Machine.load(address + 8 * (1 + Machine.load(witness + 16))) - 1
  }
  for position in 0..Machine.load(witness + 24) {
    // A table's nested tables follow its members: the count of members, the members, the count of nested ones
    const members = tableWord image, table, 0
    table = tableWord(image, table, members + 2 + Machine.load(witness + 32 + 8 * position))
  }
  (table, payload)
}

/**
 * The destructors the kernel queued, run in the order the C back end runs them: every block of the batch has its
 * `close()` called with the count lent to it, then its fields released - and what that release queues runs before the
 * next block of the batch, as the nested drop functions of C would. Answers false where a destructor stopped a
 * sandboxed script.
 */
fn runClosers(
  var words: ArrayList<Int>,
  var kernel: ArrayList<Int>,
  var budget: Budget,
  registers: Registers,
  image: Image,
  program: BytecodeProgram,
  top: Int,
): Bool {
  var batch: List<(Int, Int)> = []
  loop {
    const closer = kernelCall words, kernel, top, KernelOperation.TakeCloser, [0]
    if closer == stoppedWord {
      return false
    }
    if closer < 0 {
      break
    }
    batch.append((loadRegister(registers, top), closer))
  }
  for (block, closer) in batch {
    storeRegister registers, top, block
    if kernelCall(words, kernel, top, KernelOperation.ClosingBegin, [0]) == stoppedWord {
      return false
    }
    const calleeBase = top + scratchWords
    if !ensureFrame(registers, calleeBase, image, closer) {
      return false
    }
    const receiver = calleeBase + parameterWord(image, closer, 0, 0)
    if parameterWord(image, closer, 0, 2) != 0 {
      // `var fn close()` takes the object as a place: the register above the frame that holds it
      storeRegister(registers, calleeBase - 1, block)
      storeRegister(registers, receiver, registers.address + 8 * (calleeBase - 1))
    } else {
      storeRegister registers, receiver, block
    }
    if execute(words, kernel, budget, registers, image, program, closer, calleeBase, 0 - 1, 0) == haltedPoll {
      return false
    }
    storeRegister registers, top, block
    if kernelCall(words, kernel, top, KernelOperation.ClosingEnd, [0]) == stoppedWord {
      return false
    }
    const queued = kernelCall words, kernel, top, KernelOperation.FinishRelease, [0]
    if queued == stoppedWord {
      return false
    }
    if queued > 0 {
      if !runClosers(words, kernel, budget, registers, image, program, top) {
        return false
      }
    }
  }
  true
}
