/**
 * `torb run --vm`: a program checked, lowered to the final IR, encoded as bytecode and run by the interpreter inside
 * this process (docs/design/VM.md).
 *
 * The pipeline is `torb build`'s up to the IR both back ends read - check, lower the entry file and what it reaches,
 * insert the ownership, verify - and then the bytecode instead of the C. A program the native back end cannot compile
 * is refused here with the same findings, and a program the interpreter cannot run yet is refused with what it lacks,
 * before a single instruction runs.
 *
 * What the program writes is all that is written: nothing of this command is on standard output, and a program that
 * ends by `Process.exit` or a panic ends this process with its own exit code, as its native binary would.
 */

use File, IoError from "std/fs"
use Clock from "std/time"
use normalizePath from "../project/path"
use LineIndex from "../syntax/source"
use readSourceTree, absolutePaths from "../project/read"
use check, Checked, modulesOfProgram from "../semantics/check"
use checkBodiesOf from "../semantics/checker/check"
use insertOwnership from "../ir/ownership"
use verifyOwnedProgram from "../ir/ownership-verify"
use lowerWorkspace, lowerScripts, pathsOfModules, isLowered from "../ir/lower/lower"
use BuildTarget, hostTarget from "../project/target"
use capabilityOf, standardPackageOf from "../project/capability"
use Diagnostic from "../syntax/diagnostic"
use Statement from "../syntax/ast"
use entryNameOf from "../ir/lower/function"
use printDiagnostic, printProblem, printErrorMessage from "../cli/render"
use emitBytecode from "../backend/bytecode/emit"
use BytecodeProgram from "../backend/bytecode/format"
use IrProgram from "../ir/ir"
use Environment from "std/os"
use RuntimeScript from "../semantics/scripts"
use scriptReceiverOf, moduleOfImport from "../semantics/checker/receiver"
use runProgram, ScriptLoader, LoadedScript, ScriptStop from "./interpret"
use SourceTree from "../project/source-tree"
use ModuleId from "../semantics/module"
use BuildOptions, entryModulesOf, poolOf, chosenPrograms, nameOne from "../cli/build"

/** The exit code of a program that could not be run at all: the one `torb build` answers for a refused program. */
const refusedCode = 1

/**
 * Runs the program at `path` in the VM: the file, or the only program below the directory, or the one called
 * `program` (docs/design/PROJECT.md section 4). Answers the exit code when the program ends by running off the end of
 * its top-level code; `Process.exit` and a panic end the process directly. `returnTraces` records the return trace of
 * `?` and prints it under the report of a top-level one, which is what a run in the `dev` profile does.
 */
public fn runInMachine(
  path: String,
  program: String,
  arguments: List<String>,
  withTimings: Bool = false,
  returnTraces: Bool = false,
): Result<Int, IoError> {
  const clock = RunClock(enabled: withTimings, last: if withTimings { Clock.milliseconds() } else { 0 })
  const tree = readSourceTree([path])?
  clock.lap "reading the files"
  const requested = absolutePaths([path])?
  // The bodies of the entry: the lowering checks those of every module it reaches when it gets there
  const checked = check tree, requested, withTimings, onlyReached: true
  for timing in checked.checker.timings {
    clock.note "  {timing.pass}", timing.milliseconds
  }
  clock.lap "checking"
  if reportChecked(checked) > 0 {
    return refusedCode
  }
  if reportMissingCapabilities(checked, hostTarget()) > 0 {
    return refusedCode
  }
  const options = BuildOptions([path], program: program, command: "run")
  const module = match chosenPrograms(checked, tree, requested, options) {
    .Chosen(found) => {
      if found.length() > 1 {
        printErrorMessage "{nameOne(found, options)}"
        return refusedCode
      }
      found[0].module
    }
    .Libraries(what) => {
      printErrorMessage "{what}: there is nothing to run"
      return refusedCode
    }
    .Refused(message) => {
      printErrorMessage "{message}"
      return refusedCode
    }
  }
  const executable = checked.program.graph.at(module).path
  runModules(
    checked,
    tree,
    [module],
    arguments,
    isTestRun: false,
    executable: executable,
    requested: requested,
    clock: clock,
    returnTraces: returnTraces,
  )
}

/**
 * `torb run --timings`: the wall time of every step up to the program's first instruction, on standard error, as
 * `torb check --timings` prints the passes of the checker. Off, it reads no clock at all.
 */
public shared type RunClock {
  enabled: Bool
  var last: Int
  var total: Int = 0

  /** The time since the last lap, as the step `what`. */
  fn lap(what: String) {
    if !enabled {
      return
    }
    const now = Clock.milliseconds()
    note(what, now - last)
    total = total + now - last
    last = now
  }

  /** A time measured elsewhere, printed as it is and not added up: the passes of the checker. */
  fn note(what: String, milliseconds: Int) {
    if enabled {
      printError "{what}: {milliseconds} ms"
    }
  }

  /** What every step took together, printed once the program is ready to run. */
  fn finish() {
    if enabled {
      printError "until the first instruction: {total} ms"
    }
  }
}

/**
 * `torb test --vm`: every `*.test.trb` below the paths an entry of one program, as `torb test` builds them into one
 * binary, run in the VM with the report `runtime/test.c` writes - the file in front of its tests, the summary, the exit
 * code. `returnTraces` is what it is for [runInMachine].
 */
public fn testInMachine(paths: List<String>, returnTraces: Bool = false): Result<Int, IoError> {
  const tree = readSourceTree(paths)?
  const requested = absolutePaths(paths)?
  const checked = check tree, requested, onlyReached: true
  if reportChecked(checked) > 0 {
    return refusedCode
  }
  const modules = match entryModulesOf(checked, tree, BuildOptions(paths, testing: true)) {
    Some(found) => found
    None => {
      printErrorMessage "no test file (`*.test.trb`) below {paths.joined(", ")}"
      return refusedCode
    }
  }
  runModules(
    checked,
    tree,
    modules,
    [],
    isTestRun: true,
    executable: "",
    requested: requested,
    clock: RunClock(enabled: false, last: 0),
    returnTraces: returnTraces,
  )
}

/**
 * A program checked, lowered and encoded, ready to run - what `torb debug` launches (docs/design/DEBUGGER.md section
 * 16). `files` holds, per module of the program, the absolute path of its file and the path a location of the IR names
 * it by, and `checked` is kept for the names of its declarations.
 */
public type PreparedRun {
  lowered: MachineLowering
  executable: String
  loader: ScriptLoader
  pool: (workers: Int, blocking: Int)
  files: List<(String, String)>
  checked: Checked
}

/**
 * The program at `path` - a file, the only program below a directory, or the one called `program` - or every test file
 * below `path` where `isTestRun`, checked, lowered for the VM (for the debugger where `debugging`) and encoded. What
 * refused it is printed to standard error, and the answer is then `None`.
 */
public fn prepareRun(path: String, program: String, isTestRun: Bool, debugging: Bool): Result<PreparedRun?, IoError> {
  const tree = readSourceTree([path])?
  const requested = absolutePaths([path])?
  const checked = check tree, requested, onlyReached: true
  if reportChecked(checked) > 0 {
    return Ok None
  }
  var modules: List<ModuleId> = []
  var executable = ""
  if isTestRun {
    modules = match entryModulesOf(checked, tree, BuildOptions([path], testing: true)) {
      Some(found) => found
      None => {
        printError "error: no test file (`*.test.trb`) below {path}"
        return Ok None
      }
    }
  } else {
    const options = BuildOptions([path], program: program, command: "debug")
    const module = match chosenPrograms(checked, tree, requested, options) {
      .Chosen(found) => {
        if found.length() > 1 {
          printError "error: {nameOne(found, options)}"
          return Ok None
        }
        found[0].module
      }
      .Libraries(what) => {
        printError "error: {what}: there is nothing to run"
        return Ok None
      }
      .Refused(message) => {
        printError "error: {message}"
        return Ok None
      }
    }
    modules = [module]
    executable = checked.program.graph.at(module).path
  }
  const pool = match poolOf(checked, modules[0]) {
    Ok(found) => found
    Fail(problem) => {
      printError "error: {problem}"
      return Ok None
    }
  }
  const clock = RunClock enabled: false, last: 0
  const lowered = match machineLoweringOf(
    checked,
    tree,
    modules,
    isTestRun,
    clock,
    onDemand: true,
    debugging: debugging,
  ) {
    Some(found) => found
    None => {
      return Ok None
    }
  }
  var files: List<(String, String)> = []
  const stable = pathsOfModules checked
  for index in 0..checked.program.graph.modules.length() {
    files.append((checked.program.graph.modules[index].path, stable.get(index) ?? ""))
  }
  const loader = scriptLoaderOf tree, requested
  Ok Some(PreparedRun(lowered, executable, loader, pool, files, checked))
}

/** The entry files lowered, owned, verified, encoded and run; a test run with the file of every entry. */
fn runModules(
  checked: Checked,
  tree: SourceTree,
  modules: List<ModuleId>,
  arguments: List<String>,
  isTestRun: Bool,
  executable: String,
  requested: List<String>,
  clock: RunClock,
  returnTraces: Bool,
): Result<Int, IoError> {
  const pool = match poolOf(checked, modules[0]) {
    Ok(found) => found
    Fail(problem) => {
      printErrorMessage "{problem}"
      return refusedCode
    }
  }
  // `TORB_VM_DEBUGGED`: lowered as for the debugger and run without one, which has to change nothing the program does
  const debugging = Environment.get("TORB_VM_DEBUGGED").isSome()
  const program = match bytecodeOf(
    checked,
    tree,
    modules,
    isTestRun,
    clock,
    onDemand: true,
    debugging: debugging,
    returnTraces: returnTraces,
  ) {
    Some(found) => found
    None => {
      return refusedCode
    }
  }
  const loader = scriptLoaderOf tree, requested
  clock.lap "the loader of scripts"
  clock.finish()
  runProgram program, arguments, executable, loader, pool
}

/**
 * The entry files lowered for the VM, owned, verified and encoded as bytecode; a test run with the file of every entry.
 * `None` where the lowering or the emitter refused the program, which is printed. `debugging` lowers it for the
 * debugger (docs/design/DEBUGGER.md section 5), `returnTraces` with the return trace of `?`.
 */
public fn bytecodeOf(
  checked: Checked,
  tree: SourceTree,
  modules: List<ModuleId>,
  isTestRun: Bool = false,
  clock: RunClock = RunClock(enabled: false, last: 0),
  onDemand: Bool = false,
  debugging: Bool = false,
  returnTraces: Bool = false,
): BytecodeProgram? {
  const lowered = machineLoweringOf(checked, tree, modules, isTestRun, clock, onDemand, debugging, returnTraces)?
  lowered.program
}

/** What [bytecodeOf] answers, with the final IR it was encoded from: what a debugger reads the program's values by. */
public type MachineLowering {
  program: BytecodeProgram
  ir: IrProgram
}

/** [bytecodeOf], keeping the final IR beside the bytecode. */
public fn machineLoweringOf(
  checked: Checked,
  tree: SourceTree,
  modules: List<ModuleId>,
  isTestRun: Bool = false,
  clock: RunClock = RunClock(enabled: false, last: 0),
  onDemand: Bool = false,
  debugging: Bool = false,
  returnTraces: Bool = false,
): MachineLowering? {
  var checker = checked.checker
  checker.checksOnDemand = onDemand
  const paths = pathsOfModules checked
  var lowering = lowerWorkspace(
    checker,
    paths,
    modules,
    seedsEverything: false,
    target: hostTarget(),
    forMachine: true,
    debugging: debugging,
    returnTraces: returnTraces,
  )
  if onDemand && !isLowered(lowering) {
    // A refusal is about the program as a native build sees it: every body of the program checked, and lowered again
    var every = checked.checker
    checkBodiesOf every, modulesOfProgram(checked.program.graph, checked.program.workspace, checked.requested)
    lowering = lowerWorkspace(
      every,
      paths,
      modules,
      seedsEverything: false,
      target: hostTarget(),
      forMachine: true,
      debugging: debugging,
      returnTraces: returnTraces,
    )
  }
  clock.lap "lowering"
  insertOwnership lowering.program
  clock.lap "ownership"
  var refused = 0
  for problem in lowering.problems {
    const inside = checked.program.graph.at problem.module
    printDiagnostic tree.display(inside.path), LineIndex.of(inside.source.text), problem.diagnostic
    refused = refused + 1
  }
  for blocked in lowering.unsupported {
    printErrorMessage "{blocked.what} (at {blocked.at})"
    refused = refused + 1
  }
  for what in lowering.program.planned {
    printErrorMessage "{what}"
    refused = refused + 1
  }
  for problem in lowering.program.problems {
    printError "internal error: {problem}"
    refused = refused + 1
  }
  for problem in verifyOwnedProgram(lowering.program) {
    printError "internal error: {problem}"
    refused = refused + 1
  }
  clock.lap "verifying"
  if refused > 0 {
    return None
  }
  var entries: List<String> = []
  var files: List<String> = []
  for module in modules {
    entries.append entryNameOf(lowering, module)
    if isTestRun {
      files.append tree.display(checked.program.graph.at(module).path)
    }
  }
  const emission = emitBytecode lowering.program, entries, files: files
  if !emission.unsupported.isEmpty() {
    for what in emission.unsupported {
      printErrorMessage "{what} is not supported by the VM yet"
    }
    return None
  }
  clock.lap "the bytecode"
  MachineLowering emission.program, lowering.program
}

/**
 * The host of the scripts a program loads from paths only known while it runs (docs/design/SCRIPTS.md slice 7): the
 * program's files are checked again with the file as one more module, checked against the receiver the program names,
 * the script is lowered as its `script` function, and its part is encoded as a continuation of the program that runs.
 */
fn scriptLoaderOf(tree: SourceTree, requested: List<String>): ScriptLoader {
  const known = KnownScripts tree: tree
  ScriptLoader load: { path, receiver, after => loadAtRunTime known, requested, path, receiver, after }
}

/**
 * The scripts loaded at run time so far, by their absolute path, their receiver and their text, and the program's files:
 * parsed once, at the first script - a program that loads none never parses them twice - and a file loaded again with
 * the same text is the script loaded before.
 */
shared type KnownScripts {
  var tree: SourceTree
  var parsed: Bool = false
  var loaded: Map<String, (Int, String)> = [:]

  /** The program's files, parsed the first time they are asked for. */
  fn parsedTree(): SourceTree {
    if !parsed {
      tree = tree.parsedEverything()
      parsed = true
    }
    tree
  }
}

/** One script loaded at run time, or why it cannot be: the line of the script and the message of a `SandboxError`. */
fn loadAtRunTime(
  known: KnownScripts,
  requested: List<String>,
  path: String,
  receiver: String,
  after: BytecodeProgram,
): Result<LoadedScript, ScriptStop> {
  const absolute = match File.absolutePath(path) {
    Ok(found) => normalizePath found
    Fail(problem) => {
      return Fail ScriptStop(0, "There is no script `{path}`: {problem.message}")
    }
  }
  if !File.exists(absolute) || File.isDirectory(absolute) {
    return Fail ScriptStop(0, "There is no script `{path}`")
  }
  const text = match File.readText(absolute) {
    Ok(found) => found
    Fail(problem) => {
      return Fail ScriptStop(0, "The script `{path}` cannot be read: {problem.message}")
    }
  }
  const key = "{absolute}\n{receiver}\n{text}"
  if const Some((chunk, imports)) = known.loaded.get(key) {
    return LoadedScript after, chunk, imports
  }
  const (declaring, name) = match receiver.split("\t").toList() {
    [module, typeName] => (module, typeName)
    _ => {
      return Fail ScriptStop(0, "internal error: the receiver `{receiver}` names no type")
    }
  }
  const script = RuntimeScript absolute, declaring, name
  const parsed = known.parsedTree()
  const around = parsed.withFile absolute, text
  const checked = check around, requested, scripts: [script], onlyReached: true
  const shown = around.display absolute
  for file in checked.files {
    if file.path == shown && !file.diagnostics.isEmpty() {
      const first = file.diagnostics[0]
      const lines = LineIndex.of text
      const (line, _) = lines.lineAndColumn first.span.start
      return Fail ScriptStop(line, first.message)
    }
  }
  const module = match checked.program.graph.moduleAt(absolute) {
    Some(found) => found
    None => {
      return Fail ScriptStop(0, "internal error: the script `{path}` is no module of the program")
    }
  }
  var checker = checked.checker
  const typed = match scriptReceiverOf(checker, module) {
    Some(found) => found
    None => {
      return Fail ScriptStop(0, "internal error: the receiver `{name}` of the script `{path}` is not found again")
    }
  }
  checker.checksOnDemand = true
  var lowering = lowerScripts checker, pathsOfModules(checked), [(module, typed)], [], hostTarget()
  if !isLowered(lowering) {
    var every = checked.checker
    checkBodiesOf every, modulesOfProgram(checked.program.graph, checked.program.workspace, checked.requested)
    lowering = lowerScripts every, pathsOfModules(checked), [(module, typed)], [], hostTarget()
  }
  insertOwnership lowering.program
  var refused: List<String> = []
  for problem in lowering.problems {
    refused.append problem.diagnostic.message
  }
  for blocked in lowering.unsupported {
    refused.append "{blocked.what} (at {blocked.at})"
  }
  for what in lowering.program.planned {
    refused.append what
  }
  for problem in lowering.program.problems {
    refused.append "internal error: {problem}"
  }
  for problem in verifyOwnedProgram(lowering.program) {
    refused.append "internal error: {problem}"
  }
  if !refused.isEmpty() {
    return Fail ScriptStop(0, refused[0])
  }
  const emission = emitBytecode lowering.program, [], after
  if const Some(what) = emission.unsupported.first() {
    return Fail ScriptStop(0, "{what} is not supported by the VM yet")
  }
  const function = match lowering.scriptFunctions.get(module.value) {
    Some(found) => lowering.program.functionAt(found).name
    None => {
      return Fail ScriptStop(0, "internal error: the script `{path}` was not lowered")
    }
  }
  for index in after.chunks.length()..emission.program.chunks.length() {
    if emission.program.chunks[index].name == function {
      const imports = importsOf checked, module
      known.loaded.set key, (index, imports)
      return LoadedScript emission.program, index, imports
    }
  }
  Fail ScriptStop(0, "internal error: the script `{path}` was not emitted")
}

/** The modules the script imports, `"std/fs\t3"` per line, as the table of a program's scripts spells them. */
public fn importsOf(checked: Checked, module: ModuleId): String {
  const inside = checked.program.graph.at module
  const lines = LineIndex.of inside.source.text
  var found: List<String> = []
  for statement in inside.file.statements {
    if const .Declare(declaration) = statement.kind {
      if const .Use(usage) = declaration.kind {
        if const .Module(written) = usage.source {
          const (line, _) = lines.lineAndColumn declaration.span.start
          found.append "{moduleOfImport(written)}\t{line}"
        }
      }
    }
  }
  found.joined separator: "\n"
}

/**
 * Every import, in a file of the program, of a package of `std` the target does not have ([capabilityOf]): the VM
 * compiles a program for the machine it runs on, and in the playground that is the browser, where an import of
 * `std/process` is an error at the import. The packages of `std` are not asked - the toolchain compiles them for the
 * target - and no machine misses a capability.
 */
public fn missingCapabilitiesOf(checked: Checked, target: BuildTarget): List<MissingCapability> {
  var found: List<MissingCapability> = []
  const workspace = checked.program.workspace
  for module in checked.program.graph.modules {
    if workspace.packages[module.package].name.startsWith("std/") {
      continue
    }
    for statement in module.file.statements {
      const path = importPathOf(statement) ?? ""
      const package = standardPackageOf(path) ?? ""
      if const .Missing(why) = capabilityOf(target, package) {
        const message = "`{package}` does not exist in {target.system.displayName()}: {why}"
        const note = "The playground runs a program in the browser: printing and the clock are real, `std/fs` is in memory"
        found.append MissingCapability(module.id, Diagnostic.error(message, statement.span).withNote(note))
      }
    }
  }
  found
}

/** An import [missingCapabilitiesOf] refuses: the module it is written in, and the error at it. */
public type MissingCapability {
  module: ModuleId
  diagnostic: Diagnostic
}

/** [missingCapabilitiesOf], rendered the way `torb check` renders a diagnostic. Answers how many there were. */
fn reportMissingCapabilities(checked: Checked, target: BuildTarget): Int {
  const found = missingCapabilitiesOf checked, target
  for missing in found {
    const module = checked.program.graph.at missing.module
    printDiagnostic module.shownPath, LineIndex.of(module.source.text), missing.diagnostic
    printError ""
  }
  found.length()
}

/** The path a `use ... from "<path>"` statement names, and `None` for any other statement. */
fn importPathOf(statement: Statement): String? {
  if const .Declare(declaration) = statement.kind {
    if const .Use(written) = declaration.kind {
      if const .Module(path) = written.source {
        return path
      }
    }
  }
  None
}

/** Everything the front end found, rendered the way `torb check` renders it. */
public fn reportChecked(checked: Checked): Int {
  var problems = checked.problems.length()
  for problem in checked.problems {
    printProblem problem
  }
  for file in checked.files {
    if file.diagnostics.isEmpty() {
      continue
    }
    problems = problems + file.diagnostics.length()
    const lines = LineIndex.of file.text
    for diagnostic in file.diagnostics {
      printDiagnostic file.path, lines, diagnostic
      printError ""
    }
  }
  problems
}
