/**
 * `torb run`: a program run, with the rest of the command line, its three streams and its exit code passed through.
 *
 * By default the bytecode VM inside this process runs it (`vm/run.trb`, docs/design/VM.md), which needs no C compiler
 * and starts at once. `--native` or a profile is `build` into a directory named after the program's sources plus
 * starting what came out, so its first run costs a build and every run after it costs a process start - and what runs
 * is the binary `torb build` would have written. The two are one language: the conformance suite holds every program
 * to the same output in both.
 *
 * **Nothing of this command is on the program's output.** A build that succeeds says nothing, the binary is started
 * with the console this process holds rather than a pipe, and the exit code is the binary's. What a user sees is
 * exactly what the program wrote, which is what makes `torb run` usable inside a gate that compares output.
 */

use File, IoError from "std/fs"
use Process from "std/process"
use SourceTree from "../project/source-tree"
use readSourceTree from "../project/read"
use normalizePath, parentPath, joinPath, pathName, pathDepth from "../project/path"
use BuildOptions, Profile, build, buildFailedCode, binaryNameOf, identityFileName from "./build"
use findRuntime from "../project/toolchain"
use runInMachine from "../vm/run"

/** What `torb run` needs from the command line. */
public type RunOptions {
  /** The entry file, or a project directory, whose `build { input }` says which file that is. */
  path: String
  /**
   * Everything written behind the path. `run` reads none of it: it is what the program reads back out of
   * `Process.arguments()`, so `torb run tool.trb --verbose` hands `["--verbose"]` to `tool.trb`.
   */
  arguments: List<String> = []
  /**
   * `--profile`, written in front of the path: `dev` unless told otherwise, because a scratch program is built far more
   * often than it runs long. A benchmark says `torb run --release`.
   */
  profile: Profile = Profile.Dev
  /**
   * Whether the program runs in the bytecode VM inside this process (docs/design/VM.md), which is the default; `--native`
   * or a profile builds it instead.
   */
  usesMachine: Bool = true
  /** `--timings`: what every step up to the program's first instruction took, on standard error (the VM only). */
  withTimings: Bool = false
}

/** The exit code of the whole command: the program's own, or what went wrong before it started. */
public fn runProgram(options: RunOptions): Result<Int, IoError> {
  if !File.exists(options.path) {
    printError "error: `{options.path}` does not exist"
    return buildFailedCode
  }
  if options.usesMachine {
    return runInMachine options.path, options.arguments, options.withTimings
  }
  const entry = normalizePath(File.absolutePath(options.path)?)
  const tree = readSourceTree([options.path])?
  const key = cacheKeyOf tree, entry, toolchainKeyOf([options.path])
  const directory = joinPath cacheDirectoryOf(entry), "{options.profile.name()}/{key}"
  const output = joinPath directory, binaryNameOf(entry)
  if const None = builtBinary(output) {
    const built = build(BuildOptions([options.path], output: output, saysWhatItWrote: false, profile: options.profile))?
    if built != 0 {
      return built
    }
  }
  const binary = match builtBinary(output) {
    Some(found) => found
    None => {
      printError "error: the build wrote no binary at `{output}`"
      return buildFailedCode
    }
  }
  match Process.runPassingThrough(binary, options.arguments) {
    Ok(code) => code
    Fail(problem) => {
      printError "error: the program `{binary}` could not be started: {problem.message}"
      buildFailedCode
    }
  }
}

/**
 * What the cache is keyed by: every file the front end would read, with its path and its text, the entry that was
 * named, and the toolchain that builds it ([toolchainKeyOf]). A file that changed anywhere in the workspace is a
 * different key and therefore a different directory, and so is another `torb` or another runtime, so a stale binary is
 * never the one that is started.
 *
 * Reading more than the program reaches is deliberate and the same trade [readSourceTree] makes: an edit to a file the
 * program does not import costs one rebuild, and in exchange "is this binary current" is a question about bytes that
 * were read anyway rather than about a dependency graph that is only known after the check.
 * The cache is `build/run/` and is thrown away by deleting it.
 */
fn cacheKeyOf(tree: SourceTree, entry: String, toolchain: Int): Int {
  var seed = combineHashes entry.hash(), toolchain
  for path in tree.paths() {
    seed = combineHashes seed, path.hash()
    const text = tree.text(path) ?? ""
    seed = combineHashes seed, text.hash()
  }
  // A directory is named after the key, and a name that starts with `-` reads as a flag wherever the path is typed
  seed & 0x7FFFFFFFFFFFFFFF
}

/**
 * Which toolchain builds: the compiler that runs, by the hash of its own C that `torb build` wrote beside it
 * (`program.hash`, or `program.c` itself where only that is there), and every C file of the runtime it links. A
 * `torb` that was bootstrapped again over an unchanged program is a different key, and so is an edit of the runtime.
 *
 * # Pitfalls
 *
 * A `torb` copied somewhere without the `program.c` it was built from is known by its path alone, and a new one copied
 * over it at the same path reuses what the old one built. `tools/bootstrap.sh` and `tools/refresh-seed.sh` keep the two
 * files together.
 */
fn toolchainKeyOf(paths: List<String>): Int {
  var seed = 0
  if const Some(executable) = Process.executablePath() {
    const beside = parentPath normalizePath(executable)
    seed = combineHashes seed, compilerIdentityOf(executable, beside)
  }
  if const Some(runtime) = findRuntime(paths) {
    seed = combineHashes seed, runtimeIdentityOf(runtime)
  }
  seed
}

fn compilerIdentityOf(executable: String, directory: String): Int {
  for name in [identityFileName, "program.c"] {
    const path = joinPath directory, name
    if File.exists(path) {
      if const Ok(text) = File.readText(path) {
        return text.hash()
      }
    }
  }
  executable.hash()
}

/** The texts of the runtime's C files and headers, with their names: what every binary is linked against. */
fn runtimeIdentityOf(runtime: String): Int {
  var seed = 0
  for directory in [runtime, joinPath(runtime, "include")] {
    const names = match File.list(directory) {
      Ok(found) => found
      Fail(_) => []
    }
    for name in names {
      if !name.endsWith(".c") && !name.endsWith(".h") {
        continue
      }
      const text = match File.readText(joinPath(directory, name)) {
        Ok(found) => found
        Fail(_) => ""
      }
      seed = combineHashes seed, name.hash()
      seed = combineHashes seed, text.hash()
    }
  }
  seed
}

/**
 * Where the cache goes: `build/run/` under the outermost directory above the entry that has a `project.trb`, which is
 * the workspace root - so one checkout has one cache and a program outside of any project caches beside itself.
 *
 * The walk stops where [readSourceTree]'s does, at a hidden directory: a checkout below
 * `.claude/worktrees` is a workspace of its own and caches inside itself.
 */
fn cacheDirectoryOf(entry: String): String {
  const start = if File.isDirectory(entry) { entry } else { parentPath entry }
  var outermost = start
  var current = start
  loop {
    if File.exists(joinPath(current, "project.trb")) {
      outermost = current
    }
    if isSkippedDirectory(pathName(current)) {
      break
    }
    const parent = parentPath current
    if parent == current || pathDepth(parent) < 1 {
      break
    }
    current = parent
  }
  joinPath outermost, "build/run"
}

fn isSkippedDirectory(name: String): Bool {
  name.startsWith "."
}

/** A C compiler on Windows appends `.exe` to an output name without an extension, so both names are the binary. */
fn builtBinary(output: String): String? {
  if File.exists(output) {
    return output
  }
  const executable = "{output}.exe"
  if File.exists(executable) {
    return executable
  }
  None
}
