/**
 * `torb build`: a checked program to a native binary, through one C file and whatever C compiler is on the machine.
 *
 * This is the minimum path: two profiles ([Profile]), no cache of its own, no `project.trb` output path. `torb run`
 * (build into a cache and execute) and `torb test` (every `*.test.trb` as one binary) are additions on top of it, never
 * a rewrite of it, and a `profile` block and a `build { output }` read from the manifest will be the same.
 *
 * A C file the size of the compiler's is compiled while holding one of a few machine-wide build slots
 * (`tools/build-slot.sh`), so that several checkouts building at once do not run the machine out of memory.
 *
 * Nothing is compiled that the back end cannot emit yet: a construct the lowering does not support becomes a
 * finding, and `torb build` reports every finding and refuses to produce a binary. A C compiler error, on the other
 * hand, is an internal error of the compiler - never the user's fault.
 */

use File, IoError from "std/fs"
use Environment from "std/environment"
use Process, ProcessOutput from "std/process"
use LineIndex from "../syntax/source"
use normalizePath, parentPath, joinPath, pathName from "../project/path"
use SourceTree from "../project/source-tree"
use readSourceTree, absolutePaths from "../project/read"
use findRuntime from "../project/toolchain"
use ModuleId from "../semantics/module"
use check, Checked from "../semantics/check"
use insertOwnership from "../ir/ownership"
use verifyOwnedProgram from "../ir/ownership-verify"
use Lowering from "../ir/lower/context"
use lowerWorkspace, pathsOfModules from "../ir/lower/lower"
use entryNameOf from "../ir/lower/function"
use emitProgram, ProgramEntry from "../backend/c/emit"
use emittedText from "../backend/c/emission"
use renderDiagnostic, renderProblem, counted from "./render"

/**
 * How a program is built: how hard the C compiler optimizes the one C file. The C itself is the same under every
 * profile, which is what keeps the fixpoint of the compiler a question about the emitter and not about a flag.
 *
 * `torb build` builds `release` unless told otherwise, `torb test` and `torb run` build `dev`: a test suite or a
 * scratch program is run once per build, and there the C compiler is most of the wait.
 */
public type Profile {
  /** `-O1`: the C compiler takes about two thirds of the time of `-O2`, for a binary that is a little slower */
  case Dev
  /** `-O2`: what the toolchain builds itself with, and what a benchmark measures */
  case Release

  /** The word on the command line (`--profile dev`), and the directory of an output path (`build/dev/`). */
  fn name(): String {
    match self {
      .Dev => "dev"
      .Release => "release"
    }
  }

  /** The optimization flag of a C compiler that takes GCC's flags. */
  fn optimization(): String {
    match self {
      .Dev => "-O1"
      .Release => "-O2"
    }
  }
}

/** The profile a `--profile` names, or `None` for a name that is none. */
public fn profileNamed(name: String): Profile? {
  for profile in [Profile.Dev, Profile.Release] {
    if profile.name() == name {
      return Some profile
    }
  }
  None
}

/** What `torb build` needs from the command line. */
public type BuildOptions {
  paths: List<String>
  /** `--emit-c`: write the C and stop. It needs no C compiler at all, which is what keeps CI able to diff the C. */
  onlyC: Bool = false
  /** `--output <file>`: the binary. The C is written next to it, so both are in one place. */
  output: String = ""
  /**
   * `torb test`: **every** `*.test.trb` of what was named is an entry of one binary, and each one prints its file in
   * front of its tests. One binary per file is not an option - every test file imports the harness and through it the
   * whole compiler, so it would be one C compile the size of the compiler's own per file (BACKEND 6.3).
   */
  isTestRun: Bool = false
  /**
   * Whether the path of what was written is printed. A command that **runs** what it built next says nothing about
   * it: `torb run` and `torb test` put the program's own output on the console and nothing else.
   */
  saysWhatItWrote: Bool = true
  /** `--profile dev|release`, `--release`. It decides the C compiler's flags and the `build/<profile>/` directory. */
  profile: Profile = Profile.Release
}

/** Exit codes of `torb build`. */
public const buildFailedCode = 1
/** No C compiler, and no C runtime either: `torb build --emit-c` still works without either. */
public const noCompilerCode = 3
/** A bug of the compiler itself: the generated C did not compile, or the verifier found a malformed program. */
public const internalErrorCode = 70

/**
 * The file beside every `program.c` that holds the hash of its text: the identity of the binary built from it, so that
 * `torb run` can tell one `torb` from another by reading a line and not the compiler's whole C.
 */
public const identityFileName = "program.hash"

/** The exit code of the whole command: zero when a binary (or, with `--emit-c`, a C file) came out. */
public fn build(options: BuildOptions): Result<Int, IoError> {
  const tree = readSourceTree(options.paths)?
  const checked = check(tree, absolutePaths(options.paths)?, false, true)
  const reported = reportChecked checked
  if reported > 0 {
    printError "{counted(reported, "problem")}, nothing was built"
    return Ok buildFailedCode
  }
  const modules = match entryModulesOf(checked, tree, options) {
    Some(found) => found
    None => {
      printError "error: `torb build` needs one entry file. Name the file, or a project with a `build` input"
      return Ok buildFailedCode
    }
  }
  const paths = pathsOfModules checked
  const checker = checked.checker
  // Only what the entry files reach: nothing unreachable is emitted
  var lowering = lowerWorkspace checker, paths, modules, false
  // The IR both back ends read is phase one plus ownership: the `Retain`s, `Release`s and `Move`s of BACKEND 2 are what
  // makes the emitted C free what it allocates, so the pipeline is lower, own, verify, emit
  insertOwnership lowering.program
  const entries = programEntriesOf lowering, checked, tree, modules, options
  const found = reportLowering checked, tree, lowering
  if found > 0 {
    printError "{counted(found, "problem")} the native back end cannot compile yet, nothing was built"
    return Ok buildFailedCode
  }
  const emission = emitProgram lowering.program, entries
  if !emission.unsupported.isEmpty() {
    for what in emission.unsupported {
      printError "error: {what}"
    }
    return Ok buildFailedCode
  }
  const binary = outputPathOf checked, modules[0], options
  const directory = parentPath binary
  File.createDirectory(directory)?
  const source = joinPath directory, "program.c"
  const text = emittedText emission
  File.writeText(source, text)?
  // What says which program this is without reading it again: `torb run` keys its cache on the one beside `torb`
  File.writeText(joinPath(directory, identityFileName), "{text.hash()}")?
  if options.onlyC {
    if options.saysWhatItWrote {
      print "wrote {source}"
    }
    return Ok 0
  }
  compile source, text.byteLength(), binary, options
}

// --- What was wrong with the program --------------------------------------------------------------------------------

/** Everything the front end found, rendered the way `torb check` renders it. */
fn reportChecked(checked: Checked): Int {
  var problems = checked.problems.length()
  for problem in checked.problems {
    printError renderProblem(problem)
  }
  for file in checked.files {
    if file.diagnostics.isEmpty() {
      continue
    }
    problems = problems + file.diagnostics.length()
    const lines = LineIndex.of file.text
    for diagnostic in file.diagnostics {
      printError renderDiagnostic(file.path, lines, diagnostic)
      printError ""
    }
  }
  problems
}

/**
 * Everything the lowering found: an error of the program, a construct the back end does not lower yet, a `native type`
 * the runtime does not represent yet, and anything the verifier says - which is an internal error, because a malformed
 * body is a bug of the compiler.
 */
fn reportLowering(checked: Checked, tree: SourceTree, lowering: Lowering): Int {
  var found = 0
  for problem in lowering.problems {
    const module = checked.program.graph.at problem.module
    const lines = LineIndex.of module.source.text
    printError renderDiagnostic(tree.display(module.path), lines, problem.diagnostic)
    printError ""
    found = found + 1
  }
  for blocked in lowering.unsupported {
    printError "error: {blocked.what} (at {blocked.at})"
    found = found + blocked.count
  }
  for what in lowering.program.planned {
    printError "error: {what}"
    found = found + 1
  }
  for problem in lowering.program.problems {
    printError "internal error: {problem}"
    found = found + 1
  }
  for problem in verifyOwnedProgram(lowering.program) {
    printError "internal error: {problem}"
    found = found + 1
  }
  found
}

fn hasEntryFunction(lowering: Lowering, entry: String): Bool {
  for function in lowering.program.functions {
    if function.name == entry {
      return true
    }
  }
  false
}

// --- Where the output goes ------------------------------------------------------------------------------------------

/**
 * The modules whose top-level code the generated `main` runs, in the order it runs them.
 *
 * A build has exactly one - the entry file. A **test run** has one per `*.test.trb` of what was named, sorted by the
 * path the way it is written on the command line, which is the order `torb test` reports files in
 * (docs/tooling/the-torb-command.md). A module of the directory that is not a test file - a harness, a fixture - is
 * not an entry and is compiled in only where a test file imports it.
 */
fn entryModulesOf(checked: Checked, tree: SourceTree, options: BuildOptions): List<ModuleId>? {
  if !options.isTestRun {
    const only: List<ModuleId> = [entryModuleOf(checked)?]
    return Some only
  }
  var byPath: Map<String, ModuleId> = [:]
  var paths: List<String> = []
  for module in checked.requested {
    const shown = tree.display checked.program.graph.at(module).path
    if !shown.endsWith(".test.trb") {
      continue
    }
    paths.append shown
    byPath.set shown, module
  }
  paths.sort({ _ })
  var found: List<ModuleId> = []
  for path in paths {
    if const Some(module) = byPath.get(path) {
      found.append module
    }
  }
  if found.isEmpty() {
    return None
  }
  Some found
}

/**
 * One [ProgramEntry] per module: its entry function, plus - in a test run - the file that entry is the top-level code
 * of, which is the line `torb test` prints in front of that file's tests.
 *
 * A test file that declares things and runs nothing has no entry function at all, and nothing is called for it - but
 * its name is still printed, so every file gets a line in the report whether or not anything in it runs.
 */
fn programEntriesOf(
  var lowering: Lowering,
  checked: Checked,
  tree: SourceTree,
  modules: List<ModuleId>,
  options: BuildOptions,
): List<ProgramEntry> {
  var entries: List<ProgramEntry> = []
  for module in modules {
    const name = entryNameOf lowering, module
    if !options.isTestRun {
      entries.append ProgramEntry(name)
      continue
    }
    const file = tree.display checked.program.graph.at(module).path
    const called = if hasEntryFunction(lowering, name) { name } else { "" }
    entries.append ProgramEntry(called, file)
  }
  entries
}

/**
 * The entry file: the one requested module, or the `build { input }` of the project that was named. A workspace with
 * several members has no single entry, and building every member in dependency order is not implemented yet.
 */
fn entryModuleOf(checked: Checked): ModuleId? {
  if const [only] = checked.requested {
    return Some only
  }
  for module in checked.requested {
    const inside = checked.program.graph.at module
    const package = checked.program.workspace.packages[inside.package]
    if inside.path == joinPath(package.directory, package.manifest.buildInput) {
      return Some module
    }
  }
  None
}

/**
 * `<project>/build/<profile>/<name>`, or whatever `--output` says. Reading `build { output "build/{target}/torb" }`
 * out of the manifest is not implemented yet; the shape of the default path already matches what it would produce.
 */
fn outputPathOf(checked: Checked, module: ModuleId, options: BuildOptions): String {
  if !options.output.isEmpty() {
    return normalizePath options.output
  }
  const inside = checked.program.graph.at module
  const package = checked.program.workspace.packages[inside.package]
  const name = binaryNameOf inside.path
  const directory = if package.directory.isEmpty() { parentPath inside.path } else { package.directory }
  joinPath directory, "build/{options.profile.name()}/{name}"
}

/** The name of the binary: the entry file without its extension. */
public fn binaryNameOf(path: String): String {
  const name = pathName path
  if name.endsWith(".trb") {
    return name[0..name.byteLength() - 4]
  }
  name
}

// --- The C compiler -------------------------------------------------------------------------------------------------

/** Which compiler was found, and how it is called. */
type CCompiler {
  command: String
  /** MSVC takes `/`-flags and names its output differently, so the two shapes are told apart once. */
  isMicrosoft: Bool
}

/**
 * The C compiler, in the order of BACKEND 4: `$TORB_CC`, then `clang`, `gcc`, `cc`, then `cl`. A candidate counts as
 * found when the process starts at all - `torb build` never tries to configure another process's environment, so an
 * `x64 Native Tools` prompt is the user's job and not the build tool's.
 */
fn findCompiler(): CCompiler? {
  if const Some(given) = Environment.get("TORB_CC") {
    if !given.isEmpty() {
      return Some CCompiler(given, isMicrosoftName(given))
    }
  }
  for candidate in ["clang", "gcc", "cc"] {
    if canRun(candidate, ["--version"]) {
      return Some CCompiler(candidate, false)
    }
  }
  if canRun("cl", []) {
    return Some CCompiler("cl", true)
  }
  None
}

fn isMicrosoftName(command: String): Bool {
  const name = pathName command
  name == "cl" || name == "cl.exe"
}

/** Whether the command exists at all: a process that does not start is an `IoError` and not an exit code. */
fn canRun(command: String, arguments: List<String>): Bool {
  match Process.run(command, arguments) {
    Ok(output) => output.exitCode == 0
    Fail(_) => false
  }
}

/** Every `.c` file of the runtime, sorted: its tests are not part of a program. */
fn runtimeSourcesOf(directory: String): Result<List<String>, IoError> {
  var sources: List<String> = []
  for entry in File.list(directory)? {
    if entry.endsWith(".c") {
      sources.append joinPath(directory, entry)
    }
  }
  Ok sources
}

fn compile(source: String, size: Int, binary: String, options: BuildOptions): Result<Int, IoError> {
  const compiler = match findCompiler() {
    Some(found) => found
    None => {
      printError "error: no C compiler found. `torb build` needs one until the native back end emits machine code."
      printError "  tried: $TORB_CC, clang, gcc, cc, cl"
      printError "  on Windows: winget install LLVM.LLVM, or open a \"x64 Native Tools\" prompt"
      printError "  `torb build --emit-c` writes the C without compiling it"
      return Ok noCompilerCode
    }
  }
  const runtime = match findRuntime(options.paths) {
    Some(found) => found
    None => {
      printError "error: the C runtime was not found above the program, the working directory or `torb`."
      printError "  Set $TORB_RUNTIME to the `runtime` directory of the toolchain."
      return Ok noCompilerCode
    }
  }
  const sources = runtimeSourcesOf(runtime)?
  const arguments = compilerArguments compiler, source, binary, runtime, sources, options.profile
  const output = match runCompiler(compiler, arguments, source, size, runtime) {
    Ok(found) => found
    // `$TORB_CC` is taken as it is given, so a name that is not a program at all ends up here
    Fail(problem) => {
      printError "error: the C compiler `{compiler.command}` could not be started: {problem.message}"
      return Ok noCompilerCode
    }
  }
  if output.exitCode == 0 {
    // A C compiler on Windows appends `.exe` to an output name without an extension, so the path that is reported is
    // the one that is really there
    if options.saysWhatItWrote {
      if File.exists(binary) {
        print "wrote {binary}"
      } else {
        print "wrote {binary}.exe"
      }
    }
    return Ok 0
  }
  reportInternalError compiler, source, output.standardOutput, output.standardError
  Ok internalErrorCode
}

/**
 * The size from which a C file is compiled inside a build slot: the compiler's own C is about 65 MB and its test suite's
 * about 85 MB, the largest example a few MB. A program below it never waits for a slot.
 */
const slottedSize = 8_388_608

/**
 * Runs the C compiler. A C file of at least [slottedSize] is compiled through `tools/build-slot.sh`, found beside the
 * runtime, which holds one of a few machine-wide slots while the compiler runs and says so on standard error while it
 * waits for one - which is why it is started with this process's streams and its compiler's output comes back through
 * a file next to the C.
 *
 * # Pitfalls
 *
 * Without `sh`, or without the script beside the runtime, the compile runs without a slot: a machine that cannot run
 * the script is not one on which several checkouts build at once.
 */
fn runCompiler(
  compiler: CCompiler,
  arguments: List<String>,
  source: String,
  size: Int,
  runtime: String,
): Result<ProcessOutput, IoError> {
  const script = joinPath parentPath(runtime), "tools/build-slot.sh"
  if size < slottedSize || compiler.isMicrosoft || !File.exists(script) {
    return Process.run compiler.command, arguments
  }
  const log = joinPath parentPath(source), "c-compiler.log"
  var slotted = [script, log, compiler.command]
  slotted.appendAll arguments
  match Process.runPassingThrough("sh", slotted) {
    Ok(code) => {
      const text = File.readText(log).ok() ?? ""
      Ok ProcessOutput(code, text, "")
    }
    // No `sh` to start the script with
    Fail(_) => Process.run compiler.command, arguments
  }
}

/**
 * The flags of BACKEND 4, plus the warnings: a warning in generated code is a bug of the emitter, so it is an error
 * here and not a message the user has to read. The profile decides the optimization and nothing else.
 */
fn compilerArguments(
  compiler: CCompiler,
  source: String,
  binary: String,
  runtime: String,
  sources: List<String>,
  profile: Profile,
): List<String> {
  if compiler.isMicrosoft {
    const optimization = match profile {
      .Dev => "/O1"
      .Release => "/O2"
    }
    const include = joinPath runtime, "include"
    var arguments = ["/std:c11", optimization, "/W3", "/WX", "/nologo", "/I{include}", "/Fe{binary}"]
    arguments.append source
    arguments.appendAll sources
    return arguments
  }
  var arguments = [
    "-std=c11",
    profile.optimization(),
    "-g0",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-I{joinPath(runtime, "include")}",
    "-o",
    binary,
  ]
  arguments.append source
  arguments.appendAll sources
  arguments.append "-lm"
  arguments
}

/** A C compiler error is never the user's fault: the C file is kept and the first lines of the output are shown. */
fn reportInternalError(compiler: CCompiler, source: String, standardOutput: String, standardError: String) {
  printError "internal error: the generated C did not compile. This is a bug in torb, please report it."
  printError "  kept: {source}"
  const text = if standardError.trim().isEmpty() { standardOutput } else { standardError }
  var shown = 0
  for line in text.lines() {
    if shown >= 20 {
      break
    }
    if line.trim().isEmpty() {
      continue
    }
    printError "  {compiler.command}: {line}"
    shown = shown + 1
  }
}
