/**
 * `torb build`: a checked program to a native binary, through one C file and whatever C compiler is on the machine.
 *
 * A directory builds every program below it (docs/design/PROJECT.md section 4): the `src/main.trb` of each package and
 * every `program` line, each into `build/<profile>/<program>` of its package or the `output` its line names, with
 * what the package's `profile` block says ([ProfileSettings]). A package without a program is a library, which is
 * checked and builds nothing. `torb run` (build into a cache and execute) and `torb test` (every `*.test.trb` as one
 * binary) are additions on top of it, never a rewrite of it.
 *
 * A program the size of the compiler is written as several units besides its one `program.c`, and every C file of the
 * build is compiled at the same time into an object that a cache keeps ([compileInParallel], docs/BACKEND.md 4.1). A
 * batch of that size holds one of a few machine-wide build slots (`tools/build-slot.sh`), so that several checkouts
 * building at once do not run the machine out of memory.
 *
 * Nothing is compiled that the back end cannot emit yet: a construct the lowering does not support becomes a
 * finding, and `torb build` reports every finding and refuses to produce a binary. A C compiler error, on the other
 * hand, is an internal error of the compiler - never the user's fault.
 */

use File, IoError from "std/fs"
use Environment from "std/os"
use Process, ProcessOutput from "std/process"
use LineIndex from "../syntax/source"
use normalizePath, parentPath, joinPath, pathName, isInside from "../project/path"
use SourceTree from "../project/source-tree"
use Manifest, ProfileSettings from "../project/manifest"
use Package from "../project/workspace"
use PackageProgram, programsOf, libraryEntry from "../project/programs"
use programOfEntry from "../semantics/graph"
use readSourceTree, absolutePaths from "../project/read"
use findRuntime, threadArguments, extraCompilerArguments from "../project/toolchain"
use BuildTarget, hostTarget from "../project/target"
use ModuleId from "../semantics/module"
use check, Checked, modulesOfProgram from "../semantics/check"
use Stopwatch, checkBodiesOf from "../semantics/checker/check"
use insertOwnership from "../ir/ownership"
use verifyOwnedProgram from "../ir/ownership-verify"
use Lowering from "../ir/lower/context"
use lowerWorkspace, pathsOfModules, isLowered from "../ir/lower/lower"
use entryNameOf from "../ir/lower/function"
use emitProgram, ProgramEntry from "../backend/c/emit"
use emittedText from "../backend/c/emission"
use EmittedUnits, emittedUnits, headerFileName, unitFileName from "../backend/c/units"
use tlsPartMacro, tlsSymbolPrefix, machineKernelSymbol, hostsMachineMacro, scriptHostSymbolPrefix from "../backend/c/natives"
use findCompilerSources from "../project/toolchain"
use scriptHostObjectOf, programSourcesOf, hostedStandardLibraryOf from "./host"
use manifestOfProject from "../vm/manifest"
use Clock from "std/time"
use renderDiagnostic, renderProblem, counted from "./render"

/**
 * How a program is built: how hard the C compiler optimizes the one C file. The C itself is the same under every
 * profile, which is what keeps the fixpoint of the compiler a question about the emitter and not about a flag.
 *
 * `torb build` builds `release` unless told otherwise, `torb test` and `torb run` build `dev`: a test suite or a
 * scratch program is run once per build, and there the C compiler is most of the wait.
 */
public type Profile {
  /** `-O1`: the C compiler takes about two thirds of the time of `-O2`, for a binary that is a little slower */
  case Dev
  /** `-O2`: what the toolchain builds itself with, and what a benchmark measures */
  case Release

  /** The word on the command line (`--profile dev`), and the directory of an output path (`build/dev/`). */
  fn name(): String {
    match self {
      .Dev => "dev"
      .Release => "release"
    }
  }

  /** The optimization flag of a C compiler that takes GCC's flags. */
  fn optimization(): String {
    match self {
      .Dev => "-O1"
      .Release => "-O2"
    }
  }

  /**
   * The macros the C is compiled with. `TORB_PROFILE_DEV` gives a binary of the dev profile its default memory limit,
   * the smaller of 8 GiB and half the physical memory, where `TORB_MEMORY_LIMIT` does not say otherwise
   * (`runtime/memory.c`): a test suite or a scratch program that allocates without end stops with a message instead of
   * paging the machine to a standstill. A release binary has no default limit.
   */
  fn macros(): List<String> {
    match self {
      .Dev => ["TORB_PROFILE_DEV"]
      .Release => []
    }
  }
}

/** The profile a `--profile` names, or `None` for a name that is none. */
public fn profileNamed(name: String): Profile? {
  for profile in [Profile.Dev, Profile.Release] {
    if profile.name() == name {
      return profile
    }
  }
  None
}

/** What `torb build` needs from the command line. */
public type BuildOptions {
  paths: List<String>
  /** `--emit-c`: write the C and stop. It needs no C compiler at all, which is what keeps CI able to diff the C. */
  onlyC: Bool = false
  /** `--output <file>`: the binary. The C is written next to it, so both are in one place. */
  output: String = ""
  /**
   * `torb test`: **every** `*.test.trb` of what was named is an entry of one binary, and each one prints its file in
   * front of its tests. One binary per file is not an option - every test file imports the harness and through it the
   * whole compiler, so it would be one C compile the size of the compiler's own per file (BACKEND 6.3).
   */
  isTestRun: Bool = false
  /**
   * Whether the path of what was written is printed. A command that **runs** what it built next says nothing about
   * it: `torb run` and `torb test` put the program's own output on the console and nothing else.
   */
  saysWhatItWrote: Bool = true
  /** `--profile dev|release`, `--release`. It decides the C compiler's flags and the `build/<profile>/` directory. */
  profile: Profile = Profile.Release
  /**
   * `--target linux-x64`: what `OperatingSystem.current` and its two siblings answer in the program, and so which arm
   * of a `match` on one of them is compiled. `None` is the machine `torb` runs on. A target that is not the host needs
   * `--emit-c`, because the C compiler `torb` finds builds for the host.
   */
  target: BuildTarget? = None
  /**
   * `--embed-vm`: a native binary of the VM that runs the program's bytecode (`cli/embed.trb`, docs/design/VM.md section
   * 11), so a program that loads receiver scripts ships as one executable.
   */
  embedsMachine: Bool = false
  /** `torb build <name>`: the program of that name; empty for every program below the paths. */
  program: String = ""
  /** The command a message tells the user to run again: `build`, or `run` for what `torb run --native` builds. */
  command: String = "build"
  /** `--timings`: the wall time of every step on standard error, the passes of the checker first. */
  withTimings: Bool = false
}

/** Exit codes of `torb build`. */
public const buildFailedCode = 1
/** No C compiler, and no C runtime either: `torb build --emit-c` still works without either. */
public const noCompilerCode = 3
/** A bug of the compiler itself: the generated C did not compile, or the verifier found a malformed program. */
public const internalErrorCode = 70

/**
 * The file beside every `program.c` that holds the hash of its text: the identity of the binary built from it, so that
 * `torb run` can tell one `torb` from another by reading a line and not the compiler's whole C.
 */
public const identityFileName = "program.hash"

/** The exit code of the whole command: zero when a binary (or, with `--emit-c`, a C file) came out. */
public fn build(options: BuildOptions): Result<Int, IoError> {
  const tree = readSourceTree(options.paths)?
  buildTree(tree, absolutePaths(options.paths)?, options)
}

/**
 * [build] of files that are read already, `requested` the absolute paths of what was named: what `--embed-vm` builds
 * its generated entry with, a file that exists only in the tree.
 */
public fn buildTree(tree: SourceTree, requested: List<String>, options: BuildOptions): Result<Int, IoError> {
  var clock = Stopwatch options.withTimings
  clock.start()
  // The bodies of what was named, and the lowering checks those of every other module the first time it enters it:
  // a conformance program checks its own bodies and the modules of `std` it reaches, not every body of every package
  // its workspace holds (docs/design/VM.md section 8, as `torb run` does)
  const checked = check tree, requested, options.withTimings, checksEveryBody: false
  if options.withTimings {
    for timing in checked.checker.timings {
      printError "  {timing.pass}: {timing.milliseconds} ms"
    }
  }
  noteTiming options, "checking", clock.taken()
  const reported = reportChecked checked
  if reported > 0 {
    printError "{counted(reported, "problem")}, nothing was built"
    return buildFailedCode
  }
  if options.isTestRun {
    const modules = match entryModulesOf(checked, tree, options) {
      Some(found) => found
      None => {
        printError "error: no test file (`*.test.trb`) below {options.paths.joined(", ")}"
        return buildFailedCode
      }
    }
    return buildProgram tree, requested, options, checked, modules, normalizePath(options.output)
  }
  const programs = match chosenPrograms(checked, tree, requested, options) {
    .Chosen(found) => found
    .Libraries(what) => {
      // A library builds nothing, which is no error; a library that is to be run is one
      if options.command == "run" {
        printError "error: {what}: there is nothing to run"
        return buildFailedCode
      }
      if options.saysWhatItWrote {
        print "{what}: checked, nothing to build"
      }
      return 0
    }
    .Refused(message) => {
      printError "error: {message}"
      return buildFailedCode
    }
  }
  if programs.length() > 1 && (!options.output.isEmpty() || options.onlyC) {
    const flag = if options.onlyC { "--emit-c" } else { "--output" }
    printError "error: {nameOne(programs, options)}"
    if options.command == "build" {
      printError "  `{flag}` is for one program"
    }
    return buildFailedCode
  }
  for program in programs {
    const code = buildProgram(tree, requested, options, checked, [program.module], program.binary)?
    if code != 0 {
      return code
    }
  }
  0
}

/** One program - or, in a test run, every test file as one - built into `binary`. */
fn buildProgram(
  tree: SourceTree,
  requested: List<String>,
  options: BuildOptions,
  checked: Checked,
  modules: List<ModuleId>,
  binary: String,
): Result<Int, IoError> {
  // Each program times its own steps; the checking before them is timed once, by `buildTree`
  var clock = Stopwatch options.withTimings
  clock.start()
  const manifest = match manifestOfEntry(checked, modules[0]) {
    Ok(found) => found
    Fail(problem) => {
      printError "error: {problem}"
      return buildFailedCode
    }
  }
  const pool = match poolOfManifest(checked, modules[0], manifest) {
    Ok(found) => found
    Fail(problem) => {
      printError "error: {problem}"
      return buildFailedCode
    }
  }
  const settings = match profileSettingsOf(checked, modules[0], manifest, options.profile) {
    Ok(found) => found
    Fail(problem) => {
      printError "error: {problem}"
      return buildFailedCode
    }
  }
  const host = hostTarget()
  const target = options.target ?? host
  if target != host && !options.onlyC {
    printError "error: this machine is {host.name()}, and a binary for {target.name()} needs a C compiler for that target"
    printError "  `torb build --target {target.name()} --emit-c` writes the C, which builds on that system"
    return buildFailedCode
  }
  const paths = pathsOfModules checked
  var checker = checked.checker
  checker.checksOnDemand = true
  // Only what the entry files reach: nothing unreachable is emitted
  var lowering = lowerWorkspace checker, paths, modules, false, target
  if !isLowered(lowering) {
    // A refusal is about the program as a whole: every body of it checked, and lowered again, so what is reported is
    // what it always was
    checker = checked.checker
    checkBodiesOf checker, modulesOfProgram(checked.program.graph, checked.program.workspace, checked.requested)
    lowering = lowerWorkspace checker, paths, modules, false, target
  }
  // A program that loads receiver scripts carries its files for the script host it links (docs/design/SCRIPTS.md slice
  // 8): only such a program is lowered a second time, with the text
  if lowering.asksScriptSources {
    const hosted = hostedStandardLibraryOf(findCompilerSources(options.paths) ?? "")
    const (sources, root) = programSourcesOf tree, requested, checked, hosted
    lowering = lowerWorkspace checker, paths, modules, false, target, false, sources, root
  }
  noteTiming options, "lowering", clock.taken()
  // The IR both back ends read is phase one plus ownership: the `Retain`s, `Release`s and `Move`s of BACKEND 2 are what
  // makes the emitted C free what it allocates, so the pipeline is lower, own, verify, emit
  insertOwnership lowering.program
  noteTiming options, "ownership", clock.taken()
  const entries = programEntriesOf lowering, checked, tree, modules, options
  const found = reportLowering checked, tree, lowering
  if found > 0 {
    printError "{counted(found, "problem")} the native back end cannot compile yet, nothing was built"
    return buildFailedCode
  }
  noteTiming options, "verifying", clock.taken()
  const emission = emitProgram lowering.program, entries
  if !emission.unsupported.isEmpty() {
    for what in emission.unsupported {
      printError "error: {what}"
    }
    return buildFailedCode
  }
  const directory = parentPath binary
  File.createDirectory(directory)?
  const source = joinPath directory, "program.c"
  const text = emittedText emission
  noteTiming options, "emitting the C", clock.taken()
  File.writeText(source, text)?
  // What says which program this is without reading it again: `torb run` keys its cache on the one beside `torb`
  File.writeText(joinPath(directory, identityFileName), "{text.hash()}")?
  // The same C cut into units that compile in parallel, where the program is large enough (docs/BACKEND.md 4.1)
  const units = emittedUnits emission, forcedUnitCount()
  const program = writeUnits(directory, source, text, units)?
  noteTiming options, "writing the C", clock.taken()
  if options.onlyC {
    if options.saysWhatItWrote {
      print "wrote {source}"
      if units.isSplit() {
        print "wrote {joinPath(directory, headerFileName)} and {counted(units.units.length(), "unit")} beside it"
      }
    }
    return 0
  }
  // A program that runs the VM runs whatever its programs call, TLS included, and limits their memory - one that links
  // the script host runs it too
  const hostsScripts = text.contains scriptHostSymbolPrefix
  const hostsMachine = text.contains(machineKernelSymbol) || hostsScripts
  const usesTls = text.contains(tlsSymbolPrefix) || hostsMachine
  const compiled = compile(
    program,
    binary,
    options,
    CompileProfile(options.profile, settings),
    usesTls,
    hostsMachine,
    pool,
    hostsScripts,
  )?
  noteTiming options, "compiling and linking the C", clock.taken()
  compiled
}

/** One line of `torb build --timings`, on standard error so that it never mixes with what the command prints. */
fn noteTiming(options: BuildOptions, step: String, milliseconds: Int64) {
  if options.withTimings {
    printError "{step}: {milliseconds} ms"
  }
}

/**
 * `$TORB_UNITS`: the number of units a program is split into whatever its size, 0 where it is not set. It is what
 * tests the split on small programs (`sh tools/conformance.sh` with it set), and it cannot change `program.c` or its
 * hash, which the split is cut from.
 */
fn forcedUnitCount(): Int {
  const given = Environment.get("TORB_UNITS") ?? ""
  Int.parseDigits(given, radix: 10).ok() ?? 0
}

/**
 * The C a build compiles: `program.c` alone, or the units beside it - each with the hash that keys its object in the
 * cache, which for a unit includes the header it reads.
 */
type ProgramSources {
  /** `program.c`, the whole program as one unit: what is compiled where nothing can be compiled in parallel. */
  whole: String
  size: Int
  /** The files compiled in parallel: the units, or `program.c` itself for a program of one unit. */
  jobs: List<CompileJob>
  isSplit: Bool
}

/** One C file compiled into one object, and the hash of everything in the file that decides that object. */
type CompileJob {
  source: String
  /** The name of the object in the cache, in front of its key: `program-03`, `runtime-memory`. */
  stem: String
  contentHash: Int
  size: Int
  /** A flag this file is compiled with beyond every file's: `-flto` for a unit that is optimized across units. */
  extra: String = ""
  /** Whether this is a unit of the program's code, which is what is optimized across units where that is done. */
  isCode: Bool = false
}

/**
 * Writes the header and the units beside `program.c`, where the program is split. A unit an earlier build wrote and
 * this one does not is emptied, because nothing may read a stale unit as part of this program and `torb` has no way
 * to delete a file.
 */
fn writeUnits(directory: String, source: String, text: String, units: EmittedUnits): Result<ProgramSources, IoError> {
  var written: Set<String> = Set.of()
  var jobs: List<CompileJob> = []
  if units.isSplit() {
    File.writeText(joinPath(directory, headerFileName), units.header)?
    const headerHash = units.header.hash()
    for index in 0..units.units.length() {
      const name = unitFileName index
      const unit = units.units[index]
      const path = joinPath directory, name
      File.writeText(path, unit)?
      written.insert name
      const stem = name.withoutSuffix(".c") ?? name
      const size = unit.byteLength() + units.header.byteLength()
      // The first unit is the data (`units.trb`)
      jobs.append CompileJob(path, stem, combineHashes(headerHash, unit.hash()), size, isCode: index > 0)
    }
  } else {
    jobs.append CompileJob(source, "program", text.hash(), text.byteLength())
  }
  for entry in File.list(directory)? {
    const isUnit = entry.startsWith("program-") && entry.endsWith(".c")
    const isStale = (isUnit && !written.contains(entry)) || (entry == headerFileName && !units.isSplit())
    if isStale {
      File.writeText(joinPath(directory, entry), "")?
    }
  }
  ProgramSources source, text.byteLength(), jobs, units.isSplit()
}

/**
 * `tasks { workers, blocking }` of the `project.trb` of the package the entry belongs to (docs/design/CONCURRENCY.md
 * section 3), 0 for a number it does not name - or why it cannot be used. A manifest that computes the setting is
 * evaluated in the sandboxed VM (docs/design/SCRIPTS.md slice 5).
 */
public fn poolOf(checked: Checked, entry: ModuleId): Result<(workers: Int, blocking: Int), String> {
  poolOfManifest(checked, entry, manifestOfEntry(checked, entry)?)
}

/**
 * The manifest of the package the entry belongs to as the toolchain uses it: read statically, and evaluated in the
 * sandboxed VM where a setting the build reads is computed (docs/design/SCRIPTS.md slice 5).
 */
public fn manifestOfEntry(checked: Checked, entry: ModuleId): Result<Manifest, String> {
  const package = checked.program.workspace.packages[checked.program.graph.at(entry).package]
  if package.directory.isEmpty() {
    return package.manifest
  }
  manifestOfProject package.directory, package.manifest
}

/** [poolOf] of a manifest that is read already. */
fn poolOfManifest(
  checked: Checked,
  entry: ModuleId,
  manifest: Manifest,
): Result<(workers: Int, blocking: Int), String> {
  if const Some(problem) = manifest.poolProblem() {
    return Fail "{manifestPathOf(checked, entry)}: {problem}"
  }
  manifest.pool()
}

fn manifestPathOf(checked: Checked, entry: ModuleId): String {
  const package = checked.program.workspace.packages[checked.program.graph.at(entry).package]
  if package.directory.isEmpty() { "project.trb" } else { joinPath package.directory, "project.trb" }
}

/**
 * The profile as the project of the entry builds it (docs/design/PROJECT.md section 5): its own `profile` block, or
 * else the one of the workspace root around it - a member inherits the root's profiles - or else the defaults of the
 * profile. A block that is no profile, or whose level is outside 0 to 3, is why nothing is built.
 */
fn profileSettingsOf(
  checked: Checked,
  entry: ModuleId,
  manifest: Manifest,
  profile: Profile,
): Result<ProfileSettings, String> {
  if const Some(problem) = manifest.profileProblem() {
    return Fail "{manifestPathOf(checked, entry)}: {problem}"
  }
  const name = profile.name()
  if manifest.configures(name) {
    return manifest.profileNamed name
  }
  const package = checked.program.workspace.packages[checked.program.graph.at(entry).package]
  if !package.directory.isEmpty() {
    for other in checked.program.workspace.packages {
      const isRoot = other.manifest.isWorkspace() && !other.directory.isEmpty() && other.directory != package.directory
      if isRoot && isInside(package.directory, other.directory) && other.manifest.configures(name) {
        return other.manifest.profileNamed name
      }
    }
  }
  ProfileSettings.named name
}

// --- What was wrong with the program --------------------------------------------------------------------------------

/** Everything the front end found, rendered the way `torb check` renders it. */
public fn reportChecked(checked: Checked): Int {
  var problems = checked.problems.length()
  for problem in checked.problems {
    printError renderProblem(problem)
  }
  for file in checked.files {
    if file.diagnostics.isEmpty() {
      continue
    }
    problems = problems + file.diagnostics.length()
    const lines = LineIndex.of file.text
    for diagnostic in file.diagnostics {
      printError renderDiagnostic(file.path, lines, diagnostic)
      printError ""
    }
  }
  problems
}

/**
 * Everything the lowering found: an error of the program, a construct the back end does not lower yet, a `native type`
 * the runtime does not represent yet, and anything the verifier says - which is an internal error, because a malformed
 * body is a bug of the compiler.
 */
public fn reportLowering(checked: Checked, tree: SourceTree, lowering: Lowering): Int {
  var found = 0
  for problem in lowering.problems {
    const module = checked.program.graph.at problem.module
    const lines = LineIndex.of module.source.text
    printError renderDiagnostic(tree.display(module.path), lines, problem.diagnostic)
    printError ""
    found = found + 1
  }
  for blocked in lowering.unsupported {
    printError "error: {blocked.what} (at {blocked.at})"
    found = found + blocked.count
  }
  for what in lowering.program.planned {
    printError "error: {what}"
    found = found + 1
  }
  for problem in lowering.program.problems {
    printError "internal error: {problem}"
    found = found + 1
  }
  for problem in verifyOwnedProgram(lowering.program) {
    printError "internal error: {problem}"
    found = found + 1
  }
  found
}

fn hasEntryFunction(lowering: Lowering, entry: String): Bool {
  for function in lowering.program.functions {
    if function.name == entry {
      return true
    }
  }
  false
}

// --- Where the output goes ------------------------------------------------------------------------------------------

/**
 * The modules whose top-level code the generated `main` of a **test run** runs, in the order it runs them: one per
 * `*.test.trb` of what was named, sorted by the path the way it is written on the command line, which is the order
 * `torb test` reports files in (docs/tooling/the-torb-command.md). A module of the directory that is not a test file -
 * a harness, a fixture - is not an entry and is compiled in only where a test file imports it. A build that is no test
 * run has its programs from [chosenPrograms].
 */
public fn entryModulesOf(checked: Checked, tree: SourceTree, options: BuildOptions): List<ModuleId>? {
  var byPath: Map<String, ModuleId> = [:]
  var paths: List<String> = []
  for module in checked.requested {
    const shown = tree.display checked.program.graph.at(module).path
    if !shown.endsWith(".test.trb") {
      continue
    }
    paths.append shown
    byPath.set shown, module
  }
  paths.sort({ _ })
  var found: List<ModuleId> = []
  for path in paths {
    if const Some(module) = byPath.get(path) {
      found.append module
    }
  }
  if found.isEmpty() {
    return None
  }
  found
}

/**
 * One [ProgramEntry] per module: its entry function, plus - in a test run - the file that entry is the top-level code
 * of, which is the line `torb test` prints in front of that file's tests.
 *
 * A test file that declares things and runs nothing has no entry function at all, and nothing is called for it - but
 * its name is still printed, so every file gets a line in the report whether or not anything in it runs.
 */
fn programEntriesOf(
  var lowering: Lowering,
  checked: Checked,
  tree: SourceTree,
  modules: List<ModuleId>,
  options: BuildOptions,
): List<ProgramEntry> {
  var entries: List<ProgramEntry> = []
  for module in modules {
    const name = entryNameOf lowering, module
    if !options.isTestRun {
      entries.append ProgramEntry(name)
      continue
    }
    const file = tree.display checked.program.graph.at(module).path
    const called = if hasEntryFunction(lowering, name) { name } else { "" }
    entries.append ProgramEntry(called, file)
  }
  entries
}

/** One program a build writes: the module whose top-level code it runs, and the binary it goes into. */
public type ChosenProgram {
  module: ModuleId
  /** The binary, normalized: `--output`, the `output` of its `program` line, or `build/<profile>/<name>`. */
  binary: String
  /** The name of the program; for a file that is no program's entry, the file's name without its extension. */
  name: String
  /** The package it belongs to, as its name or its directory: what a message about several programs names. */
  owner: String
}

/** What a build writes: programs, nothing because every package is a library, or nothing because of a mistake. */
public type ProgramChoice {
  case Chosen(programs: List<ChosenProgram>)
  /**
   * No package below the paths has a program: checked, and there is nothing to build, which is no error. `what` says
   * which: `std/text is a library`, `acme/tour has no program`.
   */
  case Libraries(what: String)
  case Refused(message: String)
}

/**
 * The programs `torb build` writes (docs/design/PROJECT.md section 4). A file named directly is the one program,
 * whatever it is: a script, or the entry of a program, which then keeps its name and its `output`. A directory is every
 * program below it - the `src/main.trb` of each package and every `program` line with an `entry`, in that order - or
 * the one `--program`'s name picks. A directory of packages with no program builds nothing, and says so.
 */
public fn chosenPrograms(
  checked: Checked,
  tree: SourceTree,
  requested: List<String>,
  options: BuildOptions,
): ProgramChoice {
  const workspace = checked.program.workspace
  const graph = checked.program.graph
  const named = requested.map(normalizePath).toList()
  const files = named.filter({ tree.exists _ }).toList()
  if options.program.isEmpty() && !files.isEmpty() {
    if files.length() > 1 {
      return ProgramChoice.Refused "`torb {options.command}` builds one file at a time, and {files.length()} were named"
    }
    const module = match graph.moduleAt(files[0]) {
      Some(found) => found
      None => {
        return ProgramChoice.Refused "`{tree.display(files[0])}` is not a file of any package"
      }
    }
    const package = workspace.packages[graph.at(module).package]
    if const Some(name) = programOfEntry(package, files[0]) {
      if const Some(program) = programsOfPackage(tree, package).find({ _.name == name }) {
        return ProgramChoice.Chosen([chosenOf(module, package, program, options)])
      }
    }
    const name = binaryNameOf files[0]
    const directory = if package.directory.isEmpty() { parentPath files[0] } else { package.directory }
    const binary = binaryPathOf directory, name, "", options
    return ProgramChoice.Chosen([ChosenProgram(module, binary, name, ownerOf(package))])
  }
  var every: List<ChosenProgram> = []
  // The packages below a named directory, and the innermost one a named directory lies in: what a library says
  var below: List<String> = []
  var around = ""
  var aroundDepth = 0 - 1
  for package in workspace.packages {
    if package.installed || package.directory.isEmpty() {
      continue
    }
    const isBelow = named.any({ isInside package.directory, _ })
    const isAround = named.any({ isInside _, package.directory })
    if !isBelow && !isAround {
      continue
    }
    for program in programsOfPackage(tree, package) {
      if named.any({ isInside program.entry, _ }) {
        if const Some(module) = graph.moduleAt(program.entry) {
          every.append chosenOf(module, package, program, options)
        }
      }
    }
    if package.name.isEmpty() {
      continue
    }
    // A package without a program is a library where it has `src/lib.trb`, and a directory of scripts where it has not
    const said = if tree.exists(joinPath(package.directory, libraryEntry)) {
      "{package.name} is a library"
    } else {
      "{package.name} has no program"
    }
    if isBelow {
      below.append said
    } else if package.directory.byteLength() > aroundDepth {
      around = said
      aroundDepth = package.directory.byteLength()
    }
  }
  const libraries = if below.isEmpty() && !around.isEmpty() { [around] } else { below }
  if !options.program.isEmpty() {
    const picked = every.filter({ _.name == options.program }).toList()
    if picked.isEmpty() {
      const known = if every.isEmpty() { "none" } else { every.map({ _.name }).toList().joined(separator: ", ") }
      return ProgramChoice.Refused(
        "There is no program `{options.program}` here\n  = the programs are: {known}"
          + "\n  = a directory or a file is written as a path: `./{options.program}`",
      )
    }
    if picked.length() > 1 {
      const owners = picked.map({ _.owner }).toList().joined(separator: ", ")
      return ProgramChoice.Refused "`{options.program}` is a program of {owners}: name its package's directory instead"
    }
    return ProgramChoice.Chosen picked
  }
  if every.isEmpty() {
    if const [only] = libraries {
      return ProgramChoice.Libraries only
    }
    if !libraries.isEmpty() {
      const shown = options.paths.joined separator: ", "
      return ProgramChoice.Libraries "no package below {shown} has a program"
    }
    // A directory of scripts that belongs to no package: the one file there is, as a file named directly would be
    if const [only] = checked.requested {
      const path = graph.at(only).path
      const name = binaryNameOf path
      const binary = binaryPathOf parentPath(path), name, "", options
      return ProgramChoice.Chosen([ChosenProgram(only, binary, name, "")])
    }
    return ProgramChoice.Refused "`torb {options.command}` needs a program. Name the file, or a project that has a `src/main.trb`"
  }
  // With `--output` every program would go to one place, and the caller says to name one instead
  const count = if options.output.isEmpty() { every.length() } else { 0 }
  for index in 0..count {
    for other in 0..index {
      if every[index].binary == every[other].binary {
        const shown = tree.display every[index].binary
        return ProgramChoice.Refused "`{every[other].name}` and `{every[index].name}` both build to `{shown}`"
      }
    }
  }
  ProgramChoice.Chosen every
}

/** The error of several programs where one has to be named: `acme/shop has 3 programs. Name one: ...`, and their names. */
public fn nameOne(programs: List<ChosenProgram>, options: BuildOptions): String {
  const owners = programs.map({ _.owner }).toList()
  const first = owners.first() ?? ""
  const place = if owners.all({ _ == first }) && !first.isEmpty() { first } else { options.paths.joined separator: ", " }
  const names = programs.map({ _.name }).toList().joined(separator: ", ")
  const example = programs.first().map({ _.name }) ?? "<name>"
  "{place} has {counted(programs.length(), "program")}. Name one: `torb {options.command} {example}`\n  = {names}"
}

fn programsOfPackage(tree: SourceTree, package: Package): List<PackageProgram> {
  programsOf tree, package.directory, package.name, package.manifest
}

fn chosenOf(module: ModuleId, package: Package, program: PackageProgram, options: BuildOptions): ChosenProgram {
  const binary = binaryPathOf package.directory, program.name, program.output, options
  ChosenProgram module, binary, program.name, ownerOf(package)
}

fn ownerOf(package: Package): String {
  if package.name.isEmpty() { package.directory } else { package.name }
}

/**
 * Where a program's binary goes (docs/design/PROJECT.md section 5): `--output`, else the `output` of its `program`
 * line taken literally below the project, else `build/<profile>/<name>` - and `build/<target>/<profile>/<name>` for
 * a `--target` that is not this machine, so two targets never write over each other.
 */
fn binaryPathOf(directory: String, name: String, output: String, options: BuildOptions): String {
  if !options.output.isEmpty() {
    return normalizePath options.output
  }
  if !output.isEmpty() {
    return joinPath directory, output
  }
  const profile = options.profile.name()
  if const Some(target) = options.target {
    if target != hostTarget() {
      return joinPath directory, "build/{target.name()}/{profile}/{name}"
    }
  }
  joinPath directory, "build/{profile}/{name}"
}

/** The name of the binary: the entry file without its extension. */
public fn binaryNameOf(path: String): String {
  const name = pathName path
  name.withoutSuffix(".trb") ?? name
}

// --- The C compiler -------------------------------------------------------------------------------------------------

/** Which compiler was found, and how it is called. */
public type CCompiler {
  command: String
  /** MSVC takes `/`-flags and names its output differently, so the two shapes are told apart once. */
  isMicrosoft: Bool
  /**
   * The first line of `--version`: part of the key of every object in the cache, so a C compiler that was upgraded
   * in place compiles everything again. Empty where the compiler does not answer it.
   */
  version: String = ""
}

/**
 * The C compiler, in the order of BACKEND 4: `$TORB_CC`, then `clang`, `gcc`, `cc`, then `cl`. A candidate counts as
 * found when the process starts at all - `torb build` never tries to configure another process's environment, so an
 * `x64 Native Tools` prompt is the user's job and not the build tool's.
 */
fn findCompiler(): CCompiler? {
  if const Some(given) = Environment.get("TORB_CC") {
    if !given.isEmpty() {
      const isMicrosoft = isMicrosoftName given
      const version = if isMicrosoft { "" } else { versionOf(given) ?? "" }
      return CCompiler given, isMicrosoft, version
    }
  }
  for candidate in ["clang", "gcc", "cc"] {
    if const Some(version) = versionOf(candidate) {
      return CCompiler candidate, false, version
    }
  }
  if canRun("cl", []) {
    return CCompiler "cl", isMicrosoft: true
  }
  None
}

/** The first line `--version` prints, or `None` where the command does not start or does not answer it. */
fn versionOf(command: String): String? {
  const output = Process.runBlocking(command, ["--version"]).ok()?
  if output.exitCode != 0 {
    return None
  }
  output.standardOutput.lines().first() ?? ""
}

fn isMicrosoftName(command: String): Bool {
  const name = pathName command
  name == "cl" || name == "cl.exe"
}

/** Whether the command exists at all: a process that does not start is an `IoError` and not an exit code. */
fn canRun(command: String, arguments: List<String>): Bool {
  match Process.runBlocking(command, arguments) {
    Ok(output) => output.exitCode == 0
    Fail(_) => false
  }
}

/**
 * Every `.c` file of the runtime and of its `os/` directory, sorted: its tests are not part of a program. Every file of
 * `os/` is compiled on every machine and is empty where it does not belong, because each one is guarded as a whole
 * (`runtime/README.md`), so the list does not depend on the target.
 */
public fn runtimeSourcesOf(directory: String): Result<List<String>, IoError> {
  var sources: List<String> = []
  for entry in File.list(directory)? {
    if entry.endsWith(".c") {
      sources.append joinPath(directory, entry)
    }
  }
  const systems = joinPath directory, "os"
  if File.exists(systems) {
    for entry in File.list(systems)? {
      if entry.endsWith(".c") {
        sources.append joinPath(systems, entry)
      }
    }
  }
  sources
}

/**
 * What a program that calls a function of the TLS part of the runtime needs beside the runtime (docs/design/NETWORK.md
 * section 5): the part's macro, the include directories of `runtime/tls/` and of mbedTLS, the glue's sources, and the
 * objects of mbedTLS. Those are compiled once per checkout, C compiler, version and configuration into `build/vendor/`
 * beside the runtime, because mbedTLS is a library of somebody else's that takes longer to compile than all of the rest
 * of a program; where that directory cannot be written, they are compiled beside the program instead.
 */
public fn tlsArgumentsOf(
  runtime: String,
  command: String,
  microsoft: Bool,
  binary: String,
): Result<List<String>, IoError> {
  const parts = tlsPartsOf(runtime, command, microsoft, binary)?
  var arguments: List<String> = []
  arguments.appendAll parts.flags
  arguments.appendAll parts.sources
  arguments.appendAll parts.objects
  arguments
}

/** [tlsArgumentsOf] apart: the flags every C file of the program is compiled with, the glue's sources, mbedTLS. */
type TlsParts {
  flags: List<String>
  sources: List<String>
  objects: List<String>
}

fn tlsPartsOf(runtime: String, command: String, microsoft: Bool, binary: String): Result<TlsParts, IoError> {
  const tls = joinPath runtime, "tls"
  const vendor = joinPath runtime, "vendor/mbedtls"
  const prefix = if microsoft { "/" } else { "-" }
  // An angle-bracket name needs no quotes on any command line: mbedTLS reads it with `#include MBEDTLS_USER_CONFIG_FILE`
  const flags = [
    "{prefix}D{tlsPartMacro}",
    "{prefix}DMBEDTLS_USER_CONFIG_FILE=<torb_mbedtls_user.h>",
    "{prefix}I{tls}",
    "{prefix}I{joinPath(vendor, "include")}",
  ]
  var sources: List<String> = []
  for entry in File.list(tls)? {
    if entry.endsWith(".c") {
      sources.append joinPath(tls, entry)
    }
  }
  const versionText = File.readText(joinPath(vendor, "VERSION"))?
  const version = versionText.trim()
  const configurationText = File.readText(joinPath(tls, "torb_mbedtls_user.h"))?
  // A hash below zero would put `--` into the name: its sign is a letter
  const configuration = "{configurationText.hash()}".replace("-", "n")
  const key = "mbedtls-{version}-{configuration}-{pathName(command)}"
  const common = joinPath parentPath(runtime), "build/vendor/{key}"
  const unique = "{binary.hash()}-{Clock.milliseconds()}".replace("-", "n")
  const compilation = VendorCompilation vendor, flags, command, microsoft, joinPath(parentPath(runtime), "tools")
  const objects = match vendorObjectsOf(compilation, common, unique) {
    Ok(found) => found
    Fail(_) => vendorObjectsOf(compilation, joinPath(parentPath(binary), key), unique)?
  }
  TlsParts flags, sources, objects
}

/** How mbedTLS is compiled: its directory, the flags of the TLS part, the C compiler, and where the scripts are. */
type VendorCompilation {
  vendor: String
  flags: List<String>
  command: String
  microsoft: Bool
  tools: String
}

/**
 * The objects of mbedTLS in `directory`, one per C file of its library, named after the file: those that are there
 * already, or compiled now by `tools/build-units.sh` - every file at once, as many at a time as the machine has
 * processors. The script moves an object into place only once it is complete, and holds a lock beside it while it
 * compiles it, so several builds that start at once compile mbedTLS once: the others wait for its objects and use them.
 *
 * Without `sh`, without the script, or with Microsoft's C compiler, whose flags the script does not speak, the files are
 * compiled one after the other into a directory of this build's own instead, which leaves `compiled-version` behind
 * when it is complete, and only then is it read.
 */
fn vendorObjectsOf(compilation: VendorCompilation, directory: String, unique: String): Result<List<String>, IoError> {
  const suffix = if compilation.microsoft { ".obj" } else { ".o" }
  const library = joinPath compilation.vendor, "library"
  var sources: List<String> = []
  var objects: List<String> = []
  for entry in File.list(library)? {
    if entry.endsWith(".c") {
      sources.append joinPath(library, entry)
      objects.append joinPath(directory, "{entry.substringBefore(".c") ?? entry}{suffix}")
    }
  }
  if objects.all({ File.exists _ }) {
    return objects
  }
  if File.isDirectory(directory) {
    for entry in File.list(directory)? {
      const candidate = joinPath directory, entry
      if File.exists(joinPath(candidate, "compiled-version")) {
        return objectsIn candidate, suffix
      }
    }
  }
  File.createDirectory(directory)?
  const script = joinPath compilation.tools, "build-units.sh"
  if !compilation.microsoft && File.exists(script) {
    printError "compiling mbedTLS once into {directory}, or waiting for the build that compiles it"
    var lines: List<String> = []
    for (index, object) in objects.indexed() {
      lines.append "compile\t{object}\t{sources[index]}\t"
    }
    const list = joinPath directory, "c-units-{unique}.txt"
    File.writeText(list, lines.joined(separator: "\n") + "\n")?
    var arguments = [script, list, directory, compilation.command, "-std=c11", "-O2", "-w"]
    arguments.appendAll compilation.flags
    arguments.append "-I{library}"
    const ran = Process.runBlocking "sh", arguments
    const _ = File.remove list
    // No `sh` to start the script with: the files are compiled one after the other below
    if const Ok(output) = ran {
      if output.exitCode != 0 {
        const said = if output.standardOutput.trim().isEmpty() { output.standardError } else { output.standardOutput }
        return Fail IoError(library, said)
      }
      return objects
    }
  }
  sequentialVendorObjectsOf compilation, joinPath(directory, "objects-{unique}"), suffix
}

/** mbedTLS compiled one file after the other into `target`, a directory of this build's own. */
fn sequentialVendorObjectsOf(
  compilation: VendorCompilation,
  target: String,
  suffix: String,
): Result<List<String>, IoError> {
  const microsoft = compilation.microsoft
  const flags = compilation.flags
  const command = compilation.command
  File.createDirectory(target)?
  const library = joinPath compilation.vendor, "library"
  printError "compiling mbedTLS once into {target}"
  for entry in File.list(library)? {
    if !entry.endsWith(".c") {
      continue
    }
    const object = joinPath target, "{entry.substringBefore(".c") ?? entry}{suffix}"
    var arguments: List<String> = []
    if microsoft {
      arguments.appendAll(["/c", "/O2", "/w", "/nologo", "/std:c11", "/Fo{object}"])
    } else {
      arguments.appendAll(["-std=c11", "-O2", "-w", "-c", "-o", object])
    }
    arguments.appendAll flags
    arguments.append(if microsoft { "/I{library}" } else { "-I{library}" })
    arguments.append joinPath(library, entry)
    const output = Process.runBlocking(command, arguments)?
    if output.exitCode != 0 {
      const said = if output.standardError.trim().isEmpty() { output.standardOutput } else { output.standardError }
      return Fail IoError(joinPath(library, entry), said)
    }
  }
  File.writeText(joinPath(target, "compiled-version"), "{parentPath(target)}\n")?
  objectsIn target, suffix
}

/** The object files of a directory, sorted. */
fn objectsIn(directory: String, suffix: String): Result<List<String>, IoError> {
  var objects: List<String> = []
  for entry in File.list(directory)? {
    if entry.endsWith(suffix) {
      objects.append joinPath(directory, entry)
    }
  }
  objects
}

/**
 * How the C compiler compiles one program: the profile the command line chose, and what the project's `profile` block
 * made of it (docs/design/PROJECT.md section 5). The C is the same under every profile; only the flags differ.
 */
type CompileProfile {
  profile: Profile
  settings: ProfileSettings

  /** `-O1` in `dev`, `-O2` in `release`, or what `optimize` says. */
  fn optimization(): String {
    "-O{settings.optimize}"
  }

  /** `-g` where the project asks for debug information, `-g0` where it does not. */
  fn debugging(): String {
    if settings.debugInformation { "-g" } else { "-g0" }
  }

  /** The same two for MSVC, which has no third level of optimization. */
  fn microsoftFlags(): List<String> {
    const optimization = match settings.optimize {
      0 => "/Od"
      1 => "/O1"
      _ => "/O2"
    }
    if settings.debugInformation { [optimization, "/Zi"] } else { [optimization] }
  }

  fn macros(): List<String> {
    profile.macros()
  }
}

fn compile(
  program: ProgramSources,
  binary: String,
  options: BuildOptions,
  flavor: CompileProfile,
  usesTls: Bool,
  hostsMachine: Bool,
  pool: (workers: Int, blocking: Int),
  hostsScripts: Bool = false,
): Result<Int, IoError> {
  const source = program.whole
  const compiler = match findCompiler() {
    Some(found) => found
    None => {
      printError "error: no C compiler found. `torb build` needs one until the native back end emits machine code."
      printError "  tried: $TORB_CC, clang, gcc, cc, cl"
      printError "  on Windows: winget install LLVM.LLVM, or open a \"x64 Native Tools\" prompt"
      printError "  `torb build --emit-c` writes the C without compiling it"
      return noCompilerCode
    }
  }
  const runtime = match findRuntime(options.paths) {
    Some(found) => found
    None => {
      printError "error: the C runtime was not found above the program, the working directory or `torb`."
      printError "  Set $TORB_RUNTIME to the `runtime` directory of the toolchain."
      return noCompilerCode
    }
  }
  var runtimeSources = runtimeSourcesOf(runtime)?
  // What every C file of the program is compiled with beyond the profile's flags, and the objects compiled already
  var flags: List<String> = []
  var objects: List<String> = []
  // The script host is an object of its own, compiled once per toolchain (`cli/host.trb`)
  if hostsScripts {
    match scriptHostObjectOf(options, runtime, compiler)? {
      Some(object) => objects.append object
      None => {
        return buildFailedCode
      }
    }
  }
  if usesTls {
    const parts = tlsPartsOf(runtime, compiler.command, compiler.isMicrosoft, binary)?
    flags.appendAll parts.flags
    runtimeSources.appendAll parts.sources
    objects.appendAll parts.objects
  }
  const define = if compiler.isMicrosoft { "/D" } else { "-D" }
  // `TORB_MEMORY_LIMIT` of a binary that runs programs in the VM is the limit of those programs (runtime/memory.c)
  if hostsMachine {
    flags.append "{define}{hostsMachineMacro}"
  }
  // `tasks { workers, blocking }`: the defaults of the program's pool, which `TORB_WORKERS` and `TORB_BLOCKING` override
  if pool.workers != 0 {
    flags.append "{define}TORB_MANIFEST_WORKERS={pool.workers}u"
  }
  if pool.blocking != 0 {
    flags.append "{define}TORB_MANIFEST_BLOCKING={pool.blocking}u"
  }
  const parallel: ProcessOutput? = if compiler.isMicrosoft {
    None
  } else {
    const parts = CompileParts runtimeSources, flags, objects
    compileInParallel(compiler, program, binary, runtime, parts, flavor)?
  }
  const attempt = match parallel {
    Some(found) => Ok found
    None => {
      var sources = runtimeSources
      sources.appendAll flags
      sources.appendAll objects
      const arguments = compilerArguments compiler, source, binary, runtime, sources, flavor
      runCompiler compiler, arguments, source, program.size, runtime
    }
  }
  const output = match attempt {
    Ok(found) => found
    // `$TORB_CC` is taken as it is given, so a name that is not a program at all ends up here
    Fail(problem) => {
      printError "error: the C compiler `{compiler.command}` could not be started: {problem.message}"
      return noCompilerCode
    }
  }
  if output.exitCode == 0 {
    // A C compiler on Windows appends `.exe` to an output name without an extension, so the path that is reported is
    // the one that is really there
    if options.saysWhatItWrote {
      if File.exists(binary) {
        print "wrote {binary}"
      } else {
        print "wrote {binary}.exe"
      }
    }
    return 0
  }
  reportInternalError compiler, source, output.standardOutput, output.standardError
  internalErrorCode
}

/**
 * The size from which a C file is compiled inside a build slot: the compiler's own C is about 65 MB and its test suite's
 * about 85 MB, the largest example a few MB. A program below it never waits for a slot.
 */
const slottedSize = 8_388_608

/**
 * Runs the C compiler. A C file of at least [slottedSize] is compiled through `tools/build-slot.sh`, found beside the
 * runtime, which holds one of a few machine-wide slots while the compiler runs and says so on standard error while it
 * waits for one - which is why it is started with this process's streams and its compiler's output comes back through
 * a file next to the C.
 *
 * # Pitfalls
 *
 * Without `sh`, or without the script beside the runtime, the compile runs without a slot: a machine that cannot run
 * the script is not one on which several checkouts build at once.
 */
public fn runCompiler(
  compiler: CCompiler,
  arguments: List<String>,
  source: String,
  size: Int,
  runtime: String,
): Result<ProcessOutput, IoError> {
  const passed = argumentsThroughFile(arguments, joinPath(parentPath(source), "c-arguments.txt"))?
  const script = joinPath parentPath(runtime), "tools/build-slot.sh"
  if size < slottedSize || compiler.isMicrosoft || !File.exists(script) {
    return Process.runBlocking compiler.command, passed
  }
  const log = joinPath parentPath(source), "c-compiler.log"
  var slotted = [script, log, compiler.command]
  slotted.appendAll passed
  match Process.runPassingThrough("sh", slotted) {
    Ok(code) => {
      const text = File.readText(log).ok() ?? ""
      ProcessOutput code, text, ""
    }
    // No `sh` to start the script with
    Fail(_) => Process.runBlocking compiler.command, passed
  }
}

/**
 * The arguments of a C compiler as they are, or `@<file>` in their place where together they are longer than
 * `$TORB_RESPONSE_FILE_BYTES` (default 16384, `0` always): Windows refuses a command line of more than 32767
 * characters, and a build in a checkout with a long path - an agent's worktree - lists every file of the runtime and
 * every object of mbedTLS with that path in front. gcc, clang and Microsoft's `cl` all read the arguments of such a
 * response file, and gcc hands them on to its linker in one of its own (`tools/build-units.sh` does the same for its
 * link).
 */
public fn argumentsThroughFile(arguments: List<String>, file: String): Result<List<String>, IoError> {
  const given = Environment.get("TORB_RESPONSE_FILE_BYTES") ?? ""
  const threshold = Int.tryFrom(given).ok() ?? 16_384
  if !isLongerThan(arguments, threshold) {
    return arguments
  }
  File.writeText(file, responseFileText(arguments))?
  ["@{file}"]
}

/** Whether the arguments are longer than `threshold` bytes, each with its two quotes and the space in front of it. */
public fn isLongerThan(arguments: List<String>, threshold: Int): Bool {
  var length = 0
  for argument in arguments {
    length = length + argument.byteLength() + 3
  }
  length > threshold
}

/**
 * The text of a response file: every argument in double quotes on a line of its own, with each backslash turned into a
 * slash and each double quote escaped. gcc's quoting takes a backslash for an escape and that of Windows - clang's and
 * `cl`'s there - for a character, and a slash is the separator of a path to all three.
 */
public fn responseFileText(arguments: List<String>): String {
  var lines: List<String> = []
  for argument in arguments {
    const escaped = argument.replace("\\", "/").replace("\"", "\\\"")
    lines.append "\"{escaped}\"\n"
  }
  lines.joined separator: ""
}

// --- Units in parallel, and the cache of their objects --------------------------------------------------------------

/** What is compiled beside the program: the runtime's C files, the flags every file gets, the objects of mbedTLS. */
type CompileParts {
  runtimeSources: List<String>
  flags: List<String>
  objects: List<String>
}

/**
 * Compiles every C file of the build - the units of the program or its one `program.c`, and every file of the runtime
 * - into objects at the same time, then links them (docs/BACKEND.md 4.1). `None` where that cannot be done here: no
 * `sh`, or no `tools/build-units.sh` beside the runtime - and then the caller compiles `program.c` and the runtime in
 * one call of the C compiler, as a build always did.
 *
 * Every object is kept in a cache under the name of its **key**: the hash of the C compiler and its version, every
 * flag, every header of the runtime, and the text of the file - for a unit, of the header it includes too. An object
 * whose key is there already is not compiled again, so a second build of an unchanged program links and nothing else,
 * the second step of a bootstrap whose C agrees with the first compiles nothing, and the runtime is compiled once per
 * flag set and not once per program.
 *
 * `tools/build-units.sh` runs the compiles, as many at a time as the machine has processors, and moves each object
 * into the cache only once it is complete, so two builds that compile the same key at once never read half a file.
 * Where the files to compile are at least [slottedSize] together, the whole batch holds one machine-wide build slot
 * (`tools/build-slot.sh`).
 */
fn compileInParallel(
  compiler: CCompiler,
  program: ProgramSources,
  binary: String,
  runtime: String,
  parts: CompileParts,
  profile: CompileProfile,
): Result<ProcessOutput?, IoError> {
  const tools = joinPath parentPath(runtime), "tools"
  const script = joinPath tools, "build-units.sh"
  if !File.exists(script) {
    return Ok None
  }
  const cache = objectCacheOf runtime, binary
  const include = "-I{joinPath(runtime, "include")}"
  var flags = ["-std=c11", profile.optimization(), profile.debugging(), "-Wall", "-Wextra", "-Werror", include]
  for macro in profile.macros() {
    flags.append "-D{macro}"
  }
  flags.appendAll parts.flags
  flags.appendAll threadArguments()
  flags.appendAll extraCompilerArguments()
  // What decides every object besides the text of its own file
  var identity = combineHashes compiler.command.hash(), compiler.version.hash()
  identity = combineHashes identity, flags.joined(separator: "\n").hash()
  identity = combineHashes identity, runtimeHeadersHashOf(runtime)
  // A split program is optimized across its units of code when it is linked, where the C compiler can (docs/BACKEND.md
  // 4.1): without it a call from one unit into another is never inlined, and the program runs a fifth slower
  const optimizesAcross = program.isSplit && isGnuCompiler(compiler)
  var jobs: List<CompileJob> = []
  for job in program.jobs {
    if optimizesAcross && job.isCode {
      jobs.append job.copy(extra: "-flto")
    } else {
      jobs.append job
    }
  }
  for source in parts.runtimeSources {
    const text = File.readText(source)?
    const name = pathName source
    jobs.append CompileJob(source, "runtime-{name.withoutSuffix(".c") ?? name}", text.hash(), text.byteLength())
  }
  var linked: List<String> = []
  var pending: List<(size: Int, line: String)> = []
  var kept: List<String> = []
  var pendingSize = 0
  for job in jobs {
    // A hash below zero would put `--` into the name: its sign is a letter
    const key = "{combineHashes(combineHashes(identity, job.contentHash), job.extra.hash())}".replace("-", "n")
    const object = joinPath cache, "{job.stem}-{key}.o"
    linked.append object
    if File.exists(object) {
      kept.append "keep\t{object}\t{job.source}\t{job.extra}"
    } else {
      const line = "compile\t{object}\t{job.source}\t{job.extra}"
      pending.append((size: job.size, line: line))
      pendingSize = pendingSize + job.size
    }
  }
  // The largest first, so that the unit that takes longest never starts last
  pending.sort({ 0 - _.size })
  var lines: List<String> = []
  for one in pending {
    lines.append one.line
  }
  lines.appendAll kept
  // The link, one argument per line: the objects in the order of the program's units, then the runtime's
  var inputs = linked
  inputs.appendAll parts.objects
  inputs.appendAll threadArguments()
  inputs.appendAll extraCompilerArguments()
  inputs.append "-lm"
  if optimizesAcross {
    inputs.appendAll([profile.optimization(), profile.debugging(), "-Wall", "-Wextra", "-Werror"])
  }
  for argument in [compiler.command, "-o", binary] {
    lines.append "link\t{argument}"
  }
  for argument in inputs {
    lines.append "link\t{argument}"
  }
  // `-flto=` and the number of compiles the script runs at a time, which it knows and this process does not
  if optimizesAcross {
    lines.append "link-jobs\t-flto="
  }
  // The binary is a function of what is linked, so it is kept too: a build whose objects all come from the cache - the
  // second step of a bootstrap - copies the binary of the one before instead of linking it again
  const linkKey = "{combineHashes(identity, inputs.joined(separator: "\n").hash())}".replace("-", "n")
  lines.append "link-output\t{binary}"
  lines.append "link-cache\t{joinPath(cache, "{pathName(binary)}-{linkKey}.linked")}"
  const list = joinPath parentPath(binary), "c-units.txt"
  File.writeText(list, lines.joined(separator: "\n") + "\n")?
  var arguments = [script, list, cache, compiler.command]
  arguments.appendAll flags
  // The link of a program optimized across its units is as heavy as a compile of its size, so it counts too
  const weight = if optimizesAcross { pendingSize + program.size } else { pendingSize }
  match runUnits(tools, arguments, weight, binary) {
    Ok(found) => Ok Some(found)
    // No `sh` to start the script with
    Fail(_) => Ok None
  }
}

/**
 * Whether the C compiler is gcc, whose `-flto` needs nothing beyond itself - clang's needs a linker that can read its
 * objects, which a Linux machine may not have - so only gcc optimizes a split program across its units.
 */
fn isGnuCompiler(compiler: CCompiler): Bool {
  const name = pathName compiler.command
  const isNamed = name.endsWith("gcc") || name.endsWith("gcc.exe")
  isNamed
    || (compiler.version.contains("gcc") || compiler.version.contains("GCC")) && !compiler.version.contains("clang")
}

/**
 * Runs `tools/build-units.sh`, through `tools/build-slot.sh` where what it compiles is at least [slottedSize]: the slot
 * says on standard error when it waits, so it is started with this process's streams and the compilers' output comes
 * back through a file beside the binary.
 */
fn runUnits(tools: String, arguments: List<String>, size: Int, binary: String): Result<ProcessOutput, IoError> {
  const slot = joinPath tools, "build-slot.sh"
  if size < slottedSize || !File.exists(slot) {
    return Process.runBlocking "sh", arguments
  }
  const log = joinPath parentPath(binary), "c-compiler.log"
  var slotted = [slot, log, "sh"]
  slotted.appendAll arguments
  const code = Process.runPassingThrough("sh", slotted)?
  const text = File.readText(log).ok() ?? ""
  ProcessOutput code, text, ""
}

/**
 * `build/objects/` beside the runtime - the checkout's, for a checkout - where every build of the checkout finds the
 * objects of every other; `objects/` beside the binary where that cannot be written, as an installed toolchain's
 * directory may not be.
 */
fn objectCacheOf(runtime: String, binary: String): String {
  const common = joinPath parentPath(runtime), "build/objects"
  if File.createDirectory(common).isOk() {
    return common
  }
  const beside = joinPath parentPath(binary), "objects"
  const _ = File.createDirectory beside
  beside
}

/**
 * The names and texts of every header of the runtime, of its `os/` and `tls/` directories and of the version of mbedTLS:
 * what a C file of the program or of the runtime may include, and so part of the key of every object.
 */
fn runtimeHeadersHashOf(runtime: String): Int {
  var seed = 0
  const directories = [runtime, joinPath(runtime, "include"), joinPath(runtime, "os"), joinPath(runtime, "tls")]
  for directory in directories {
    const names = File.list(directory).ok() ?? []
    for name in names {
      if !name.endsWith(".h") {
        continue
      }
      const text = File.readText(joinPath(directory, name)).ok() ?? ""
      seed = combineHashes seed, name.hash()
      seed = combineHashes seed, text.hash()
    }
  }
  const version = File.readText(joinPath(runtime, "vendor/mbedtls/VERSION")).ok() ?? ""
  combineHashes seed, version.hash()
}

/**
 * The flags of BACKEND 4, plus the warnings: a warning in generated code is a bug of the emitter, so it is an error
 * here and not a message the user has to read. The profile decides the optimization and nothing else; `$TORB_CFLAGS`
 * adds what somebody asked for ([extraCompilerArguments]).
 */
fn compilerArguments(
  compiler: CCompiler,
  source: String,
  binary: String,
  runtime: String,
  sources: List<String>,
  profile: CompileProfile,
): List<String> {
  if compiler.isMicrosoft {
    const include = joinPath runtime, "include"
    var arguments = ["/std:c11"]
    arguments.appendAll profile.microsoftFlags()
    arguments.appendAll(["/W3", "/WX", "/nologo", "/I{include}", "/Fe{binary}"])
    for macro in profile.macros() {
      arguments.append "/D{macro}"
    }
    arguments.append source
    arguments.appendAll sources
    arguments.appendAll extraCompilerArguments()
    return arguments
  }
  var arguments = [
    "-std=c11",
    profile.optimization(),
    profile.debugging(),
    "-Wall",
    "-Wextra",
    "-Werror",
    "-I{joinPath(runtime, "include")}",
    "-o",
    binary,
  ]
  for macro in profile.macros() {
    arguments.append "-D{macro}"
  }
  arguments.append source
  arguments.appendAll sources
  arguments.appendAll threadArguments()
  arguments.appendAll extraCompilerArguments()
  arguments.append "-lm"
  arguments
}

/** A C compiler error is never the user's fault: the C file is kept and the first lines of the output are shown. */
public fn reportInternalError(compiler: CCompiler, source: String, standardOutput: String, standardError: String) {
  printError "internal error: the generated C did not compile. This is a bug in torb, please report it."
  printError "  kept: {source}"
  const text = if standardError.trim().isEmpty() { standardOutput } else { standardError }
  var shown = 0
  for line in text.lines() {
    if shown >= 20 {
      break
    }
    if line.trim().isEmpty() {
      continue
    }
    printError "  {compiler.command}: {line}"
    shown = shown + 1
  }
}
