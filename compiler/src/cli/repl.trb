/**
 * `torb repl`: entries read from standard input, one after the other, each checked against the session and run in the
 * VM inside this process (docs/design/REPL.md).
 *
 * The reader is plain standard input, so a file piped in is a session like a typed one - every entry, every message,
 * every value - which is how `tests/repl/` drives it. A line is joined to the lines before it until they are a whole
 * entry: a bracket that is open, an operator that still wants its operand, a string or a comment that is not closed.
 *
 * What an entry prints and the values it shows go to standard output; messages go to standard error.
 */

use File, IoError from "std/fs"
use readLine from "std/io"
use printErrorRaw, installInterruptHandler, interrupted from "std/console"
use readSourceTree from "../project/read"
use normalizePath from "../project/path"
use Session, Outcome, newSession, evaluate, typeOf, closeSession from "../repl/session"
use isComplete from "../repl/entry"

/** What one read of the input answered: a whole line, Ctrl+C, or the end of the input (docs/design/REPL.md section 2). */
public type ReadEvent {
  case Line(text: String)
  case Interrupted
  case EndOfInput
}

/** `readLine()`, told apart from a Ctrl+C that interrupted it - both answer `None` - by [interrupted]. */
public fn readEvent(): ReadEvent {
  match readLine() {
    Some(line) => ReadEvent.Line line
    None => if interrupted() { ReadEvent.Interrupted } else { ReadEvent.EndOfInput }
  }
}

/**
 * What the reader does next for one [ReadEvent] (docs/design/REPL.md section 2, Ctrl+C): pure, so the decision is
 * tested without driving a real interrupt (`compiler/tests/repl.test.trb`). `pending` is whether an entry is still
 * open, `idleInterrupts` how many Ctrl+C the reader has already seen in a row with nothing open.
 */
public type ReaderAction {
  /** Keep reading; `resetIdle` says whether this event ends a run of idle Ctrl+C's, and `discardPending` whether an
   *  open entry is thrown away. */
  case Continue(resetIdle: Bool, discardPending: Bool)
  /** Hand `line` to the entry reader. */
  case Read(line: String)
  /** The end of the session: the end of the input, or a second Ctrl+C with nothing open. */
  case Leave
}

public fn actionFor(event: ReadEvent, pendingIsEmpty: Bool, idleInterrupts: Int): ReaderAction {
  match event {
    .Line(line) => ReaderAction.Read line
    .EndOfInput => ReaderAction.Leave
    .Interrupted => {
      if pendingIsEmpty {
        if idleInterrupts >= 1 {
          return ReaderAction.Leave
        }
        return ReaderAction.Continue resetIdle: false, discardPending: false
      }
      ReaderAction.Continue resetIdle: true, discardPending: true
    }
  }
}

/** The commands of a session, as `:help` lists them. */
const commandLines = [
  ":type <expression>  the type of an expression, checked and not run",
  ":load <file>        a file as one entry: its declarations, its code and its bindings join the session",
  ":reset              a new session: every binding released, every declaration forgotten, the files read again",
  ":help               this list",
  ":quit               the end of the session, as the end of the input is",
]

/** `> ` before a whole new entry, `. ` while one is still open (docs/design/REPL.md section 2), on standard error. */
fn promptFor(pendingIsEmpty: Bool): String {
  if pendingIsEmpty { "> " } else { ". " }
}

/**
 * Runs a session to its end. Answers the exit code: `0`, or the code an entry handed to `Process.exit`.
 * `sandboxed` is `torb repl --sandbox` (docs/design/REPL.md section 7): every entry runs under SCRIPTS.md's grant of
 * the working directory instead of `unrestricted`, and `:reset` keeps it.
 */
public fn runRepl(sandboxed: Bool = false): Result<Int, IoError> {
  const directory = normalizePath(File.absolutePath(".")?)
  var session = newSession(readSourceTree([directory])?, directory, sandboxed)
  printError "torb repl: one entry at a time, :help lists the commands"
  installInterruptHandler()
  var pending: List<String> = []
  var blanks = 0
  var idleInterrupts = 0
  loop {
    printErrorRaw promptFor(pending.isEmpty())
    const line = match actionFor(readEvent(), pending.isEmpty(), idleInterrupts) {
      .Leave => {
        printError ""
        break
      }
      .Continue(resetIdle, discardPending) => {
        printError ""
        if discardPending {
          pending = []
          blanks = 0
        }
        idleInterrupts = if resetIdle { 0 } else { idleInterrupts + 1 }
        continue
      }
      .Read(found) => found
    }
    idleInterrupts = 0
    if pending.isEmpty() && line.trim().startsWith(":") {
      match command(session, directory, sandboxed, line.trim())? {
        Some(code) => {
          return Ok code
        }
        None => {
          continue
        }
      }
    }
    if line.trim().isEmpty() {
      if pending.isEmpty() {
        continue
      }
      // Two empty lines give up on an entry that never became whole
      blanks = blanks + 1
      if blanks >= 2 {
        printError "note: the unfinished entry is dropped"
        pending = []
        blanks = 0
        continue
      }
    } else {
      blanks = 0
    }
    pending.append line
    const text = pending.joined separator: "\n"
    if !isComplete(text) {
      continue
    }
    pending = []
    if const Some(code) = exitCodeOf(evaluate(session, text)) {
      return Ok code
    }
  }
  // The end of the input ends an entry that is still open: the parser says what is missing
  if !pending.isEmpty() {
    if const Some(code) = exitCodeOf(evaluate(session, pending.joined(separator: "\n"))) {
      return Ok code
    }
  }
  closeSession session
  Ok 0
}

/** The code the session ends with where an entry called `Process.exit`. */
fn exitCodeOf(outcome: Outcome): Int? {
  if const .Exited(code) = outcome {
    return Some code
  }
  None
}

/** One command. Answers the exit code where the command ends the session. */
fn command(var session: Session, directory: String, sandboxed: Bool, line: String): Result<Int?, IoError> {
  const name = line.substringBefore(" ") ?? line
  const rest = (line.substringAfter(" ") ?? "").trim()
  match name {
    ":quit" => {
      closeSession session
      return Ok Some(0)
    }
    ":help" => {
      for shown in commandLines {
        printError shown
      }
    }
    ":reset" => {
      closeSession session
      session = newSession(readSourceTree([directory])?, directory, sandboxed)
    }
    ":type" => {
      if rest.isEmpty() {
        printError "error: `:type` needs an expression"
      } else if const Some(shown) = typeOf(session, rest) {
        print shown
      }
    }
    ":load" => {
      if rest.isEmpty() {
        printError "error: `:load` needs a file"
      } else if !File.exists(rest) {
        printError "error: `{rest}` does not exist"
      } else {
        const text = File.readText(rest)?
        return Ok exitCodeOf(evaluate(session, text, Some(rest)))
      }
    }
    _ => printError "error: `{name}` is no command of the session: :help lists them"
  }
  Ok None
}
