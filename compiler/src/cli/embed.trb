/**
 * `torb build --embed-vm`: a native binary that embeds the VM (docs/design/VM.md section 11).
 *
 * The program is checked, lowered for the VM and encoded as bytecode exactly as `torb run` does, and the bytecode is
 * written as text into a module that exists only in memory, beside the interpreter in the toolchain's own sources
 * (`compiler/src/vm/`), whose top-level code decodes and runs it (`vm/embed.trb`). That module is what is built
 * natively, through C, with the interpreter and the runtime: the binary needs neither `torb` nor a C compiler where it
 * runs, and it runs the program as `torb run` does - receiver scripts in their sandbox included.
 */

use IoError from "std/fs"
use joinPath from "../project/path"
use readSourceTree, absolutePaths from "../project/read"
use findCompilerSources from "../project/toolchain"
use check from "../semantics/check"
use programText from "../vm/embed"
use bytecodeOf, reportChecked from "../vm/run"
use BuildOptions, buildTree, buildFailedCode, chosenPrograms, nameOne, poolOf from "./build"

/** The exit code of `torb build --embed-vm`: `build`'s own for the binary of the VM, or why nothing was built. */
public fn buildEmbedded(options: BuildOptions): Result<Int, IoError> {
  if options.onlyC || options.target.isSome() {
    printError "error: `--embed-vm` builds a binary for this machine, and takes neither `--emit-c` nor `--target`"
    return buildFailedCode
  }
  const tree = readSourceTree(options.paths)?
  const requested = absolutePaths(options.paths)?
  const checked = check tree, requested, false, true
  if reportChecked(checked) > 0 {
    return buildFailedCode
  }
  const chosen = match chosenPrograms(checked, tree, requested, options) {
    .Chosen(found) => found
    .Libraries(what) => {
      printError "error: {what}, and `--embed-vm` needs a program"
      return buildFailedCode
    }
    .Refused(message) => {
      printError "error: {message}"
      return buildFailedCode
    }
  }
  if chosen.length() > 1 {
    printError "error: {nameOne(chosen, options)}"
    printError "  `--embed-vm` builds one program"
    return buildFailedCode
  }
  const modules = [chosen[0].module]
  const pool = match poolOf(checked, modules[0]) {
    Ok(found) => found
    Fail(problem) => {
      printError "error: {problem}"
      return buildFailedCode
    }
  }
  const program = match bytecodeOf(checked, tree, modules) {
    Some(found) => found
    None => {
      return buildFailedCode
    }
  }
  const compiler = match findCompilerSources(options.paths) {
    Some(found) => found
    None => {
      printError "error: `--embed-vm` builds the VM from the toolchain's own sources, and there is no `compiler/` beside it"
      return buildFailedCode
    }
  }
  const entry = joinPath compiler, "src/vm/embedded-program.trb"
  const text = literalOf programText(program)
  const source = "use runEmbedded from \"./embed\"\n\nrunEmbedded \"{text}\", {pool.workers}, {pool.blocking}\n"
  const sources = readSourceTree([compiler])?
  const around = sources.withFile entry, source
  buildTree around, [entry], options.copy(paths: [entry], output: chosen[0].binary, embedsMachine: false, program: "")
}

/** The text as the body of a string literal of TorbScript: a backslash, a quote and the braces escaped. */
fn literalOf(value: String): String {
  var escaped: List<String> = []
  for character in value.chars() {
    if character == '\\' {
      escaped.append "\\\\"
    } else if character == '"' {
      escaped.append "\\\""
    } else if character == '{' {
      escaped.append "\\\{"
    } else if character == '}' {
      escaped.append "\\\}"
    } else {
      escaped.append "{character}"
    }
  }
  escaped.joined separator: ""
}
