/** [collectSourceFiles]: every `.trb` file below a list of command-line paths, for a command that reads plain files instead of a workspace. */

use File, IoError from "std/fs"

/** Every `.trb` file below the paths, sorted. Hidden directories are skipped. */
public fn collectSourceFiles(paths: List<String>): Result<List<String>, IoError> {
  var files: List<String> = []
  for path in paths {
    collectInto(files, path)?
  }
  files.sort({ _ })
  Ok files
}

fn collectInto(var files: List<String>, path: String): Result<Void, IoError> {
  if !File.isDirectory(path) {
    if !File.exists(path) {
      return Fail IoError(path, "The file does not exist")
    }
    files.append path
    return Ok(void)
  }
  for entry in File.list(path)? {
    const child = "{path}/{entry}"
    if File.isDirectory(child) {
      const isSkipped = entry.startsWith "."
      if !isSkipped {
        collectInto(files, child)?
      }
    } else if entry.endsWith(".trb") {
      files.append child
    }
  }
  Ok(void)
}
