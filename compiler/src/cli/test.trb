/**
 * `torb test`: every `*.test.trb` below the paths that were named, as **one** native binary, built and run.
 *
 * Any test package, and not only the compiler's own: `torb test ../std/collections/tests`, `torb test ../examples`,
 * or several at once, which is still one binary and one report over all of them.
 *
 * One binary and not one per file. Every test file imports its harness and through it the whole compiler, so one
 * binary per file would be one C compile of a translation unit the size of the compiler's own per file - and the C
 * compiler is where the time of a build goes (BACKEND 6.3). The whole suite together is about the size of one such
 * translation unit, so it is one `gcc` instead of fifty-five.
 *
 * What that costs is `--jobs`. Inside one process there is nothing to spread over cores: the files share one heap,
 * the report is one stream of lines in the order of the files, and threads would buy the run nothing that the one C
 * compile did not already dominate. The flag is accepted and ignored, and `docs/tooling/the-torb-command.md` says so.
 * What spreads a suite over cores is several processes of the one binary, each running a part of the files
 * ([TestShard], `--shard 2/4`).
 *
 * The report itself is not written here at all - `runtime/test.c` writes every line of it, including the counts and
 * the summary, and chooses the tests a `--filter` names and the lines `--report json` writes in place of the human ones:
 * it reads all three options off the command line of the process, which for a native run is handed to the binary here
 * and for a run in the VM is `torb`'s own.
 */

use File, IoError from "std/fs"
use Process from "std/process"
use normalizePath, joinPath, parentPath, pathName, pathDepth from "../project/path"
use BuildOptions, Profile, build, buildFailedCode from "./build"
use findRuntime from "../project/toolchain"
use testInMachine from "../vm/run"
use printErrorMessage from "./render"
use colorFlag from "./color"

/** What `torb test --help` prints: every flag of the command, and what a path is. */
public fn testUsage(): String {
  const lines = [
    "torb test - run every *.test.trb below the paths as one program, in the bytecode VM",
    "",
    "Usage:",
    "  torb test [path]... [flag]...",
    "",
    "  A path is a file or a directory (default: the package the working directory is in). A path that starts with",
    "  `--` is written `./--name`: every other argument that does is a flag, and one of these.",
    "",
    "  --native                 Build them into one binary and run it instead",
    "  --vm                     The default, accepted",
    "  --profile dev|release    Build natively with that profile (default: dev); --release is --profile release",
    "  --shard k/n              Only the k-th of every n files, so n processes run one suite between them",
    "  --shards n               With --native: build once and run all n shards at the same time",
    "  --filter <name>          Only the test of this full name (`Group > test`), or every test of the group of this",
    "                           name; any number of them, and a test runs when it matches one",
    "  --report json            JSON Lines on standard output instead of the report a person reads, for an editor",
    "  --color auto|always|never  Colour `ok`, `FAILED` and the summary (default: where the output is a terminal)",
    "  --jobs N                 Accepted and ignored: one program is one process",
  ]
  lines.joined separator: "\n"
}

/**
 * What `torb test` needs from the command line, which is the paths alone: `--jobs N` is read off the arguments and
 * dropped there, because one binary is one process and there is nothing here for it to say.
 */
public type TestOptions {
  /**
   * The directories and files the test files are looked for below. Several are one run and therefore **one** binary:
   * `torb test std/collections/tests std/text/tests` builds both packages together and prints one report over both,
   * in the order the paths sort in. The default is the package the working directory is in ([defaultTestPath]).
   */
  paths: List<String> = ["."]
  /** `--profile`: `dev` unless told otherwise, because a suite is run once per build and the C compiler is the wait */
  profile: Profile = Profile.Dev
  /**
   * Whether nothing is built and the same program - every test file an entry - runs in the bytecode VM inside this
   * process, with the report `runtime/test.c` writes for a native test binary (docs/design/VM.md): the default.
   * `--native` or a profile builds one binary instead - the compiler's own suite, which the VM runs too slowly.
   */
  usesMachine: Bool = true
  /** `--shard 2/4`: a part of the files, or `None` for all of them. */
  shard: TestShard? = None
  /**
   * `--shards 4`: the binary is built once and runs as that many shards at the same time, each a process of its own
   * (`tools/test-shards.sh`), whose reports come one after the other once all of them have ended. 1 is one process.
   */
  shards: Int = 1
  /**
   * `--filter <name>`, any number: the tests whose full name (`Outer > Inner > name`) is one of these or lies below one
   * of them run, and no other. Empty for every test.
   */
  filters: List<String> = []
  /** `--report json`: what the run writes on standard output. */
  report: TestReport = TestReport.Human
}

/** What `runtime/test.c` writes on standard output while the suite runs. */
public type TestReport {
  /** A line per file and per test, the message and the site of a failure, and the summary: for a person */
  case Human
  /**
   * `--report json`: JSON Lines, an object per event of the run - a file, the start of a test, its outcome and how long
   * it took, the summary - for an editor that shows the tests while they run (docs/tooling/torb-test.md)
   */
  case Json
}

/**
 * `--shard <index>/<count>`: the files whose position in the run, counted from 0, leaves `index - 1` divided by
 * `count`. Several processes that each run one shard run the whole suite between them at once, which is how a gate
 * splits the compiler's suite, whose files take from a second to minutes each.
 *
 * `runtime/test.c` chooses the files, in the binary and in the VM alike: it reads `--shard` off the command line of the
 * process, which for a native run is the binary's - handed to it here - and for a run in the VM is `torb`'s own. A native
 * shard is built into a directory of its own (`build/dev/shard-2-of-4/`), so shards that are built at the same time
 * never write one file; their C is the same, and the object cache compiles and links it once for all of them.
 *
 * # Pitfalls
 *
 * The files are dealt out in turn, not by how long they take: the shard that holds the slowest file takes at least as
 * long as that file alone.
 */
public type TestShard {
  /** From 1 to [TestShard.count]. */
  index: Int
  count: Int

  /** `2/4`, as the command line writes it. */
  fn written(): String {
    "{index}/{count}"
  }
}

/** The shard `2/4` names, or `None` for anything else: an index from 1 to the count. */
public fn testShardNamed(text: String): TestShard? {
  const parts = text.split("/").toList()
  if parts.length() != 2 {
    return None
  }
  const index = Int.tryFrom(parts[0]).ok()?
  const count = Int.tryFrom(parts[1]).ok()?
  if index < 1 || index > count {
    return None
  }
  TestShard index, count
}

/**
 * What `torb test` runs where no path is named: the package the working directory is in - the innermost directory
 * above it with a `project.trb` - because a file called `*.test.trb` is a test wherever it lies in the package
 * (docs/design/PROJECT.md section 3). The working directory itself where no project is above it.
 */
public fn defaultTestPath(): String {
  var current = "."
  loop {
    if File.exists(joinPath(current, "project.trb")) {
      return current
    }
    // A checkout below `.claude/worktrees` is a project of its own, as `readSourceTree` sees it
    const absolute = normalizePath(File.absolutePath(current).ok() ?? current)
    if pathName(absolute).startsWith(".") || pathDepth(parentPath(absolute)) < 1 || parentPath(absolute) == absolute {
      return "."
    }
    current = joinPath current, ".."
  }
}

/** The exit code of the whole command: what the test binary answered, or what went wrong before it ran. */
public fn runTests(options: TestOptions): Result<Int, IoError> {
  if options.usesMachine {
    return testInMachine options.paths
  }
  const first = options.paths.first() ?? "."
  // Where a run of several packages puts its binary: the first path is the one the command line names first, and the
  // key of the cache the binary is not - a test run is asked for, so it is built
  // A single test file names no directory of its own, so its binary goes beside it
  const directory = if first.endsWith(".trb") {
    parentPath normalizePath(first)
  } else {
    normalizePath first
  }
  const profile = options.profile.name()
  var arguments: List<String> = []
  var output = joinPath directory, "build/{profile}/tests"
  if const Some(shard) = options.shard {
    output = joinPath directory, "build/{profile}/shard-{shard.index}-of-{shard.count}/tests"
    arguments = ["--shard", shard.written()]
  }
  // What every shard of the run is handed besides its own `--shard`
  var selection: List<String> = []
  for filter in options.filters {
    selection.appendAll(["--filter", filter])
  }
  if options.report == TestReport.Json {
    selection.appendAll(["--report", "json"])
  }
  selection.appendAll colorFlag()
  arguments.appendAll selection
  const built = build(BuildOptions(
    options.paths,
    output: output,
    testing: true,
    saysWhatItWrote: false,
    profile: options.profile,
  ))?
  if built != 0 {
    return built
  }
  // A C compiler on Windows appends `.exe` to an output name without an extension
  const binary = if File.exists(output) { output } else { "{output}.exe" }
  if options.shards > 1 {
    const script = joinPath parentPath(findRuntime(options.paths) ?? "runtime"), "tools/test-shards.sh"
    const logs = joinPath directory, "build/{profile}/shards"
    // Without `sh` or the script the suite runs in one process, which is what the shards add up to
    if File.exists(script) {
      if const Ok(code) = Process.runPassingThrough("sh", [script, binary, "{options.shards}", logs, ...selection]) {
        return code
      }
    }
  }
  // The report is the binary's own output and is not touched on its way out: the binary is handed this process's three
  // streams, so every line appears while the suite runs instead of after it, and a panic that escaped every recovery
  // point stays on standard error where the binary put it
  match Process.runPassingThrough(binary, arguments) {
    Ok(code) => code
    Fail(problem) => {
      printErrorMessage "the test binary `{binary}` could not be started: {problem.message}"
      buildFailedCode
    }
  }
}
