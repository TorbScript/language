/**
 * `torb test`: every `*.test.trb` below the paths that were named, as **one** native binary, built and run.
 *
 * Any test package, and not only the compiler's own: `torb test ../std/collections/tests`, `torb test ../examples`,
 * or several at once, which is still one binary and one report over all of them.
 *
 * One binary and not one per file. Every test file imports its harness and through it the whole compiler, so one
 * binary per file would be one C compile of a translation unit the size of the compiler's own per file - and the C
 * compiler is where the time of a build goes (BACKEND 6.3). The whole suite together is about the size of one such
 * translation unit, so it is one `gcc` instead of fifty-five.
 *
 * What that costs is `--jobs`. Inside one process there is nothing to spread over cores: the files share one heap,
 * the report is one stream of lines in the order of the files, and threads would buy the run nothing that the one C
 * compile did not already dominate. The flag is accepted and ignored, and `docs/tooling/the-torb-command.md` says so.
 *
 * The report itself is not written here at all - `runtime/test.c` writes every line of it, including the counts and
 * the summary.
 */

use File, IoError from "std/fs"
use Process from "std/process"
use normalizePath, joinPath, parentPath from "../project/path"
use BuildOptions, Profile, build, buildFailedCode from "./build"
use testInMachine from "../vm/run"

/**
 * What `torb test` needs from the command line, which is the paths alone: `--jobs N` is read off the arguments and
 * dropped there, because one binary is one process and there is nothing here for it to say.
 */
public type TestOptions {
  /**
   * The directories and files the test files are looked for below. Several are one run and therefore **one** binary:
   * `torb test std/collections/tests std/text/tests` builds both packages together and prints one report over both,
   * in the order the paths sort in. The default is `tests` beside the working directory.
   */
  paths: List<String> = ["tests"]
  /** `--profile`: `dev` unless told otherwise, because a suite is run once per build and the C compiler is the wait */
  profile: Profile = Profile.Dev
  /**
   * Whether nothing is built and the same program - every test file an entry - runs in the bytecode VM inside this
   * process, with the report `runtime/test.c` writes for a native test binary (docs/design/VM.md): the default.
   * `--native` or a profile builds one binary instead - the compiler's own suite, which the VM runs too slowly.
   */
  usesMachine: Bool = true
}

/** The exit code of the whole command: what the test binary answered, or what went wrong before it ran. */
public fn runTests(options: TestOptions): Result<Int, IoError> {
  if options.usesMachine {
    return testInMachine options.paths
  }
  const first = options.paths.first() ?? "tests"
  // Where a run of several packages puts its binary: the first path is the one the command line names first, and the
  // key of the cache the binary is not - a test run is asked for, so it is built
  // A single test file names no directory of its own, so its binary goes beside it
  const directory = if first.endsWith(".trb") {
    parentPath normalizePath(first)
  } else {
    normalizePath first
  }
  const output = joinPath directory, "build/{options.profile.name()}/tests"
  const built = build(
    BuildOptions(options.paths, output: output, isTestRun: true, saysWhatItWrote: false, profile: options.profile),
  )?
  if built != 0 {
    return built
  }
  // A C compiler on Windows appends `.exe` to an output name without an extension
  const binary = if File.exists(output) { output } else { "{output}.exe" }
  // The report is the binary's own output and is not touched on its way out: the binary is handed this process's three
  // streams, so every line appears while the suite runs instead of after it, and a panic that escaped every recovery
  // point stays on standard error where the binary put it
  match Process.runPassingThrough(binary, []) {
    Ok(code) => code
    Fail(problem) => {
      printError "error: the test binary `{binary}` could not be started: {problem.message}"
      buildFailedCode
    }
  }
}
