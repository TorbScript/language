/**
 * `torb new`: a new directory, from a template (`./template`) - `torb/package-template` or `torb/app-template` of
 * git.torb.dev by default, `--template` naming another one - or, offline or where the template cannot be reached,
 * the built-in scaffold this file has always written: `project.trb`, a `src/main.trb` that prints a greeting, and a
 * `tests/main.test.trb` with one passing test.
 *
 * The built-in scaffold names nothing about the workspace the command runs in, so the package it describes finds the
 * toolchain's own `std/` and `runtime/` the way any standalone project does, searched for above the new directory,
 * the working directory and `torb` itself: `torb new` works the same inside this repository and in an empty
 * directory anywhere else. A template found over the network may of course declare dependencies of its own.
 */

use File, IoError from "std/fs"
use printErrorMessage from "./render"
use pathName, normalizePath from "../project/path"
use ScaffoldChoices from "./template"
use isInteractive, answersFor, confirmed, attemptScaffold, initializeGitRepository, printNextSteps from "./template"

/** What `torb new` needs from the command line: the directory to create, and the shared template flags. */
public type NewOptions {
  /** The directory `torb new` creates. Unless `--name` overrides it, the project's name is its last segment. */
  path: String
  choices: ScaffoldChoices = ScaffoldChoices()
}

/**
 * `<path>/project.trb`, `<path>/src/main.trb` and `<path>/tests/main.test.trb` - from a template, or the built-in
 * scaffold. Refuses with an error and changes nothing where `<path>` already exists, so a typo on the command line
 * never writes into a directory that was there for another reason.
 */
public fn runNew(options: NewOptions): Result<Int, IoError> {
  if File.exists(options.path) {
    printErrorMessage "`{options.path}` already exists"
    return 1
  }
  const interactive = isInteractive() && !options.choices.yes
  const defaultName = pathName normalizePath(options.path)
  const answers = answersFor defaultName, options.choices, interactive
  if !confirmed(options.path, answers, interactive) {
    print "nothing written"
    return 0
  }
  match attemptScaffold(options.path, answers, options.choices.offline) {
    Ok(_) => print "wrote {options.path}/ from the \"{answers.template}\" template"
    Fail(reason) => {
      printError "note: {reason} - writing the built-in scaffold instead"
      writePlainScaffold(options.path, answers.name)?
    }
  }
  if answers.git {
    initializeGitRepository options.path
  }
  printNextSteps options.path, isInit: false
  0
}

/** The built-in scaffold `torb new` has always written, where a template is not reached or not asked for. */
fn writePlainScaffold(path: String, name: String): Result<Void, IoError> {
  File.createDirectory("{path}/src")?
  File.createDirectory("{path}/tests")?
  File.writeText("{path}/project.trb", manifestFor(name))?
  File.writeText("{path}/src/main.trb", mainFor(name))?
  File.writeText("{path}/tests/main.test.trb", testFor(name))?
  print "wrote {path}/project.trb, {path}/src/main.trb, {path}/tests/main.test.trb"
  Ok void
}

/**
 * The `project.trb` of a new package: a name and a version, and nothing else - `src/main.trb` is its program and
 * `tests/main.test.trb` its test because of what they are called (docs/design/PROJECT.md section 3).
 */
public fn manifestFor(name: String): String {
  """
    name = "{name}"
    version = "0.1.0"
    """
}

/** The `src/main.trb` of a new package: a script, so it needs no `fn main` and prints the one line itself. */
public fn mainFor(name: String): String {
  "print \"Hello, {name}\"\n"
}

/** The `tests/main.test.trb` of a new package: one passing test, in the bare `use test from "std/test"` form. */
public fn testFor(name: String): String {
  """
    use test from "std/test"

    test "{name} runs" \{
      assert(1 + 1 == 2)
    \}
    """
}
