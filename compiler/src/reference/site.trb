/**
 * The static site of a [Reference]: an index of the packages, an index per package, one page per module, a search
 * index, and the whole model as JSON. It is plain files - no request leaves the host, the search is a script over a
 * generated index - so it can be opened from disk or served by any static host. It looks like the documentation site of
 * `torb docs site`: the same tokens of `brand/tokens.css`, the same shared stylesheet, light and dark by the system
 * or by the toggle, and Chivo where the host serves it at `/assets/fonts/`, as torb.dev does.
 *
 * [siteFiles] is a pure function from the model to the files, which is what a test asks; [writeSite] writes them.
 *
 * # Related
 *
 * - [referenceJson] - the model as the language server and the registry read it.
 * - [markdownHtml] - how a doc comment becomes HTML.
 */

use File, IoError from "std/fs"
use Json from "std/json"
use joinPath, parentPath from "../project/path"
use DocumentedPackage, DocumentedModule, DocumentedItem, ItemKind, ItemSection, ResolvedLink, Reference from "./model"
use DocumentedDeprecation from "./model"
use deprecationNotice from "../semantics/checker/deprecation"
use markdownHtml from "./render"
use highlightedCode, escapedHtml from "./highlight"
use fontFaces, baseStylesheet, themeScript, headScript from "../documentation/site-style"
use brandTokens from "../documentation/site-tokens"

/** The model as JSON, with the version of its shape, so a reader can tell a newer one. */
public type ReferenceIndex {
  /** Raised whenever a field changes meaning or goes away */
  format: Int
  packages: List<DocumentedPackage>
}

/** One entry of the search: what a result shows and where it goes. */
public type SearchEntry {
  /** `Option.map` */
  name: String
  kind: String
  /** The module the construct is declared in */
  module: String
  /** The page and the anchor, relative to the root of the site */
  url: String
  summary: String
}

/** The version of the JSON's shape that [referenceJson] writes. */
public const referenceFormat = 1

/** The whole model as one JSON document: what `torb doc --json` prints and `reference.json` holds. */
public fn referenceJson(reference: Reference): String {
  Json().encode(ReferenceIndex(referenceFormat, reference.packages))
}

/** Every entry of the search, top-level constructs and members alike. */
public fn searchEntries(reference: Reference): List<SearchEntry> {
  var entries: List<SearchEntry> = []
  for entry in reference.everyItem() {
    const url = "{entry.module.page}#{entry.item.anchor}"
    const name = if entry.item.kind == ItemKind.Extension { "extend {entry.item.name}" } else { entry.item.anchor }
    entries.append SearchEntry(name, entry.item.kind.word(), entry.module.name, url, entry.item.summary)
  }
  entries
}

/** Every file of the site, by its path relative to the root of the site. */
public fn siteFiles(reference: Reference): Map<String, String> {
  var files: Map<String, String> = [:]
  files.set "index.html", rootPage(reference)
  files.set "style.css", "{fontFaces("/assets/fonts/")}\n{brandTokens}\n{baseStylesheet}\n{stylesheet}"
  files.set "search.js", "{themeScript}\n{searchScript}"
  const entries = Json().encode(searchEntries(reference))
  files.set "search-index.json", entries
  files.set "search-index.js", "const searchIndex = {entries};\n"
  files.set "reference.json", referenceJson(reference)
  for package in reference.packages {
    files.set package.page, packagePage(package)
    for module in package.modules {
      files.set module.page, modulePage(package, module)
    }
  }
  files
}

/** Writes the site into `directory`, creating it and every folder below it. Answers with the number of files. */
public fn writeSite(directory: String, reference: Reference): Result<Int, IoError> {
  const files = siteFiles reference
  var created: List<String> = []
  for (path, text) in files {
    const target = joinPath directory, path
    const folder = parentPath target
    if !created.contains(folder) {
      File.createDirectory(folder)?
      created.append folder
    }
    File.writeText(target, text)?
  }
  files.length()
}

/** `../../` for `std/core/option.html`: the way from a page back to the root of the site. */
public fn rootOf(page: String): String {
  var prefix = ""
  for character in page.chars() {
    if character == '/' {
      prefix = "{prefix}../"
    }
  }
  prefix
}

/** The URL of a place of the site as a page links to it: an anchor alone on the same page. */
public fn urlFrom(page: String, target: String, anchor: String): String {
  const fragment = if anchor.isEmpty() { "" } else { "#{anchor}" }
  if target == page {
    return if fragment.isEmpty() { "#" } else { fragment }
  }
  "{rootOf(page)}{target}{fragment}"
}

/** The links of one comment as [markdownHtml] takes them, from the page they are shown on. */
fn linkTargets(page: String, links: List<ResolvedLink>): Map<String, String> {
  var targets: Map<String, String> = [:]
  for link in links {
    const url = if link.page.isEmpty() { "" } else { urlFrom page, link.page, link.anchor }
    targets.set link.target, url
  }
  targets
}

const moonIcon = "<svg class=\"icon-moon\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M16.25 12.1A6.75 6.75 0 0 1 7.9 3.75a6.75 6.75 0 1 0 8.35 8.35Z\"/></svg>"

const sunIcon = "<svg class=\"icon-sun\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"3.5\"/><path d=\"M10 1.75v2M10 16.25v2M1.75 10h2M16.25 10h2M4.17 4.17l1.41 1.41M14.42 14.42l1.41 1.41M4.17 15.83l1.41-1.41M14.42 5.58l1.41-1.41\"/></svg>"

/**
 * The frame every page shares: the stylesheet, the theme chosen last time, the search, and the header of the site -
 * the top rule, the way back to the index, the search field and the theme toggle.
 */
fn pageOf(page: String, title: String, body: String): String {
  const root = rootOf page
  const theme = "<button type=\"button\" class=\"button button-quiet button-icon theme-toggle\" data-theme-toggle hidden aria-label=\"Switch the theme\">{moonIcon}{sunIcon}</button>"
  const head = [
    "<!doctype html>",
    "<html lang=\"en\">",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "<title>{escapedHtml(title)}</title>",
    "<meta name=\"theme-color\" content=\"#FFFDFC\" media=\"(prefers-color-scheme: light)\">",
    "<meta name=\"theme-color\" content=\"#14110F\" media=\"(prefers-color-scheme: dark)\">",
    "<link rel=\"stylesheet\" href=\"{root}style.css\">",
    "<script>{headScript.replace("\n", "")}</script>",
    "<script src=\"{root}search-index.js\" defer></script>",
    "<script src=\"{root}search.js\" defer></script>",
    "</head>",
    "<body data-root=\"{root}\">",
    "<header class=\"site-header\">",
    "<div class=\"header-inner\">",
    "<a class=\"home\" href=\"{root}index.html\">Reference</a>",
    "<div class=\"header-actions\">",
    "<input id=\"search\" type=\"search\" placeholder=\"Search\" aria-label=\"Search the reference\" autocomplete=\"off\">",
    theme,
    "</div>",
    "</div>",
    "</header>",
    "<ul id=\"results\" hidden></ul>",
    "<main>",
  ]
  const tail = ["</main>", "</body>", "</html>", ""]
  "{head.joined(separator: "\n")}\n{body}\n{tail.joined(separator: "\n")}"
}

fn rootPage(reference: Reference): String {
  var body: List<String> = ["<h1>Reference</h1>", "<ul class=\"listing\">"]
  for package in reference.packages {
    const link = "<a href=\"{package.page}\"><code>{escapedHtml(package.name)}</code></a>"
    body.append "<li>{link}<span class=\"summary\">{inlineSummary(package.summary)}</span></li>"
  }
  body.append "</ul>"
  pageOf "index.html", "Reference", body.joined(separator: "\n")
}

fn packagePage(package: DocumentedPackage): String {
  const page = package.page
  var body: List<String> = [
    "<nav class=\"crumbs\"><a href=\"{rootOf(page)}index.html\">Reference</a></nav>",
    "<h1><code>{escapedHtml(package.name)}</code></h1>",
  ]
  if !package.doc.isEmpty() {
    body.append "<div class=\"doc\">{markdownHtml(package.doc, linkTargets(page, package.links))}</div>"
  }
  body.append "<h2>Modules</h2>"
  body.append "<ul class=\"listing\">"
  for module in package.modules {
    const link = "<a href=\"{urlFrom(page, module.page, "")}\"><code>{escapedHtml(module.name)}</code></a>"
    body.append "<li>{link}<span class=\"summary\">{inlineSummary(module.summary)}</span></li>"
  }
  body.append "</ul>"
  var items: List<(module: DocumentedModule, item: DocumentedItem)> = []
  for module in package.modules {
    for item in module.items {
      items.append((module: module, item: item))
    }
  }
  items.sort({ _.item.name.toLowerCase() })
  body.append "<h2>Everything</h2>"
  body.append "<ul class=\"listing\">"
  for entry in items {
    const url = urlFrom page, entry.module.page, entry.item.anchor
    const kind = "<span class=\"kind\">{entry.item.kind.word()}</span>"
    const link = "<a href=\"{url}\"><code>{escapedHtml(shownName(entry.item))}</code></a>"
    body.append "<li>{kind} {link}<span class=\"summary\">{inlineSummary(entry.item.summary)}</span></li>"
  }
  body.append "</ul>"
  pageOf page, package.name, body.joined(separator: "\n")
}

fn modulePage(package: DocumentedPackage, module: DocumentedModule): String {
  const page = module.page
  var body: List<String> = [
    "<nav class=\"crumbs\"><a href=\"{rootOf(page)}index.html\">Reference</a> / <a href=\"{urlFrom(page, package.page, "")}\">{escapedHtml(package.name)}</a></nav>",
    "<h1><code>{escapedHtml(module.name)}</code></h1>",
    "<p class=\"file\">{escapedHtml(module.path)}</p>",
  ]
  const links = linkTargets page, module.links
  if !module.doc.isEmpty() {
    body.append "<div class=\"doc\">{markdownHtml(module.doc, links)}</div>"
  }
  body.append sectionsHtml(module.sections, links, 2)
  body.append "<nav class=\"contents\" aria-label=\"Contents\"><ul>"
  for item in module.items {
    const kind = "<span class=\"kind\">{item.kind.word()}</span>"
    body.append "<li>{kind} <a href=\"#{item.anchor}\"><code>{escapedHtml(shownName(item))}</code></a></li>"
  }
  body.append "</ul></nav>"
  for item in module.items {
    body.append itemHtml(page, item, 2)
  }
  pageOf page, module.name, body.joined(separator: "\n")
}

/** One construct, and its members one heading level below it. */
fn itemHtml(page: String, item: DocumentedItem, level: Int): String {
  const links = linkTargets page, item.links
  const anchor = escapedHtml item.anchor
  var pieces: List<String> = [
    "<section class=\"item\" id=\"{anchor}\">",
    "<h{level}><span class=\"kind\">{item.kind.word()}</span> <a class=\"anchor\" href=\"#{anchor}\">{escapedHtml(shownName(item))}</a></h{level}>",
    "<pre class=\"signature\"><code>{highlightedCode(item.signature)}</code></pre>",
  ]
  if const Some(deprecation) = item.deprecation {
    pieces.append deprecationHtml(deprecation, links)
  }
  if !item.doc.isEmpty() {
    pieces.append "<div class=\"doc\">{markdownHtml(item.doc, links)}</div>"
  } else if item.required {
    pieces.append "<p class=\"undocumented\">Not documented.</p>"
  }
  if !item.parameters.isEmpty() {
    pieces.append "<dl class=\"parameters\">"
    for parameter in item.parameters {
      pieces.append "<dt><code>{escapedHtml(parameter.name)}</code></dt>"
      pieces.append "<dd>{markdownHtml(parameter.doc, links)}</dd>"
    }
    pieces.append "</dl>"
  }
  pieces.append sectionsHtml(item.sections, links, level + 1)
  if !item.members.isEmpty() {
    pieces.append "<div class=\"members\">"
    for member in item.members {
      pieces.append itemHtml(page, member, (level + 1).min(6))
    }
    pieces.append "</div>"
  }
  pieces.append "</section>"
  pieces.joined separator: "\n"
}

/**
 * What the `deprecated` clause of a construct says, above its documentation: since when, why, and what to write
 * instead.
 */
fn deprecationHtml(deprecation: DocumentedDeprecation, links: Map<String, String>): String {
  const text = deprecationNotice deprecation.reason, deprecation.replacement, deprecation.since
  "<div class=\"deprecated\">{markdownHtml(text, links)}</div>"
}

fn sectionsHtml(sections: List<ItemSection>, links: Map<String, String>, level: Int): String {
  var pieces: List<String> = []
  const heading = level.min 6
  for section in sections {
    pieces.append "<h{heading} class=\"section\">{escapedHtml(section.heading)}</h{heading}>"
    pieces.append "<div class=\"doc\">{markdownHtml(section.text, links)}</div>"
  }
  pieces.joined separator: "\n"
}

/**
 * How a list and a heading name a construct: its name, and for an `extend` what its header says after the keyword -
 * `Option<Value> with Show` - so two extensions of one type can be told apart. The type parameters of the `extend`
 * itself are left out: they say what the header uses, and the header says it again.
 */
fn shownName(item: DocumentedItem): String {
  if item.kind != ItemKind.Extension {
    return item.name
  }
  const header = item.signature.withoutPrefix("extend") ?? item.signature
  var depth = 0
  var offset = 0
  for character in header.chars() {
    if character == '<' {
      depth = depth + 1
    } else if character == '>' {
      depth = depth - 1
    } else if character == ' ' && depth == 0 {
      return header.sliceBytes(offset + 1, header.byteLength())
    }
    offset = offset + character.byteLength()
  }
  item.name
}

/** A summary inside a list: its Markdown without the paragraph around it. */
fn inlineSummary(summary: String): String {
  if summary.isEmpty() {
    return ""
  }
  const html = markdownHtml(summary, [:]).trim()
  const inner = html.withoutPrefix("<p>") ?? html
  inner.withoutSuffix("</p>") ?? inner
}

/**
 * The rules of the reference on top of the shared stylesheet of the site: the header's search field and its results,
 * the listings, and a construct with its signature, its doc comment and its members. Every value is a token of the
 * brand, so the reference and the documentation look like one site.
 */
const stylesheet = raw"""
  .home {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--torb-text);
    text-decoration: none;
  }

  #search {
    width: min(28rem, 50vw);
    height: 36px;
    padding: 0 12px;
    font-family: var(--torb-font-sans);
    font-size: var(--torb-type-ui-size);
    color: var(--torb-text);
    background: var(--torb-background);
    border: 1px solid var(--torb-border-control);
    border-radius: var(--torb-radius-small);
  }

  #results {
    position: fixed;
    top: 72px;
    left: 50%;
    z-index: 40;
    width: min(44rem, calc(100vw - 32px));
    max-height: 70vh;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    list-style: none;
    background: var(--torb-surface-raised);
    border: 1px solid var(--torb-border);
    border-radius: var(--torb-radius-medium);
    box-shadow: var(--torb-shadow-overlay);
    transform: translateX(-50%);
  }

  #results li {
    padding: 8px 10px;
    border-radius: var(--torb-radius-small);
  }

  #results li:hover {
    background: var(--torb-surface-hover);
  }

  main {
    max-width: 880px;
    margin: 0 auto;
    padding: 40px 24px 96px;
  }

  main > h1 {
    margin: 12px 0 8px;
  }

  h1 code {
    font-size: 0.9em;
    padding: 0;
    background: none;
    border: 0;
  }

  main h2 {
    margin: 48px 0 16px;
  }

  .crumbs,
  .file,
  .summary,
  .kind,
  .undocumented {
    color: var(--torb-text-muted);
  }

  .deprecated {
    border-left: 3px solid var(--torb-text-muted);
    padding-left: 0.75em;
    color: var(--torb-text-muted);
  }

  .crumbs {
    font-size: var(--torb-type-small-size);
  }

  .crumbs a {
    color: var(--torb-text-muted);
  }

  .file {
    margin: 0 0 24px;
    font-family: var(--torb-font-mono);
    font-size: var(--torb-type-small-size);
  }

  .kind {
    font-family: var(--torb-font-mono);
    font-size: 0.75em;
    font-weight: 500;
  }

  .summary::before {
    content: " - ";
  }

  .summary:empty::before {
    content: "";
  }

  .listing {
    padding-left: 1.2em;
  }

  .listing li {
    margin: 6px 0;
  }

  .contents ul {
    columns: 14rem;
    margin: 24px 0;
    padding: 16px 16px 16px 2em;
    background: var(--torb-surface);
    border: 1px solid var(--torb-border);
    border-radius: var(--torb-radius-medium);
  }

  .item {
    margin: 40px 0;
    padding-top: 24px;
    border-top: 1px solid var(--torb-border);
  }

  .item > h2,
  .item > h3,
  .item > h4,
  .item > h5,
  .item > h6 {
    margin: 0 0 12px;
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  .item code {
    padding: 0;
    background: none;
    border: 0;
  }

  .members {
    margin: 24px 0 0 4px;
    padding-left: 20px;
    border-left: 1px solid var(--torb-border);
  }

  .members .item {
    margin: 28px 0;
    padding-top: 0;
    border-top: 0;
  }

  .anchor {
    color: var(--torb-text);
    text-decoration: none;
  }

  pre.signature,
  pre.code {
    margin: 0 0 16px;
    padding: 12px 16px;
    overflow-x: auto;
    font-size: var(--torb-type-code-dense-size);
    line-height: var(--torb-type-code-dense-line-height);
    color: var(--torb-syntax-variable);
    background: var(--torb-code);
    border: 1px solid var(--torb-border);
    border-radius: var(--torb-radius-small);
  }

  .doc :not(pre) > code {
    padding: 0.08em 0.32em;
    background: var(--torb-surface);
    border: 1px solid var(--torb-border);
  }

  .section {
    margin: 20px 0 6px;
    font-size: 1rem;
  }

  .parameters dt {
    margin-top: 8px;
  }

  .parameters dd {
    margin-left: 18px;
  }

  .parameters dd p {
    margin: 0;
  }

  table {
    display: block;
    overflow-x: auto;
  }

  th,
  td {
    border: 1px solid var(--torb-border);
  }

  @media (max-width: 640px) {
    .header-inner {
      gap: 12px;
      padding: 0 16px;
    }

    .header-actions {
      flex: 1;
    }

    #search {
      width: 100%;
    }

    main {
      padding: 24px 16px 72px;
    }

    .members {
      padding-left: 12px;
    }
  }
  """

/**
 * The search: a filter over `searchIndex` as the reader types, best matches first - the name itself, then a name that
 * starts with the query, then one that contains it.
 */
const searchScript = raw"""
  "use strict";
  (function () {
    const input = document.getElementById("search");
    const results = document.getElementById("results");
    const root = document.body.dataset.root || "";
    if (!input || !results || typeof searchIndex === "undefined") {
      return;
    }
    function rank(entry, query) {
      const name = entry.name.toLowerCase();
      const last = name.slice(name.lastIndexOf(".") + 1);
      if (name === query || last === query) {
        return 0;
      }
      if (name.startsWith(query) || last.startsWith(query)) {
        return 1;
      }
      return name.includes(query) ? 2 : 3;
    }
    function show() {
      const query = input.value.trim().toLowerCase();
      results.textContent = "";
      if (query === "") {
        results.hidden = true;
        return;
      }
      const found = searchIndex
        .map((entry) => ({ entry: entry, rank: rank(entry, query) }))
        .filter((candidate) => candidate.rank < 3)
        .sort((left, right) => left.rank - right.rank || left.entry.name.length - right.entry.name.length)
        .slice(0, 40);
      for (const candidate of found) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = root + candidate.entry.url;
        const code = document.createElement("code");
        code.textContent = candidate.entry.name;
        link.appendChild(code);
        const kind = document.createElement("span");
        kind.className = "kind";
        kind.textContent = candidate.entry.kind + " ";
        item.appendChild(kind);
        item.appendChild(link);
        const summary = document.createElement("span");
        summary.className = "summary";
        summary.textContent = candidate.entry.summary;
        item.appendChild(summary);
        results.appendChild(item);
      }
      if (found.length === 0) {
        const item = document.createElement("li");
        item.textContent = "Nothing found.";
        results.appendChild(item);
      }
      results.hidden = false;
    }
    input.addEventListener("input", show);
  })();
  """
