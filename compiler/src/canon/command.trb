/**
 * The canon of the formatter, as the engine `torb format` (`../format/command`) runs first: rewrites over the syntax
 * tree and never with a regular expression. It only moves parentheses and indentation and rewrites three small forms of
 * the tree; it never reprints a file - that is the layout's job (`../format/layout`).
 *
 * The rules are [Rule]s, and [rewrite] applies a set of them to one source text.
 *
 * **The safety net.** Every edit is applied on its own and the file is parsed again. The edit only stays if the
 * syntax tree is the one from before with every span and every `CallStyle` erased ([canonicalText]), and if the
 * file still has no diagnostics; otherwise it is dropped and reported. A file that does not parse to begin with is
 * skipped whole. Nothing outside of an edited byte range is touched, so line endings and everything else stay
 * byte-identical.
 *
 * `torb canon`, the command this was until milestone 8, is an alias of `torb format` now that prints that it is
 * deprecated.
 */

use SourceText, LineIndex from "../syntax/source"
use lex from "../syntax/lexer"
use parse from "../syntax/parser/parser"
use walk from "./walk"
use Edit, EditKind, Document from "./edit"
use callEdits from "./calls"
use stringEdits from "./strings"
use patternEdits from "./patterns"
use bindingEdits from "./bindings"
use loopEdits from "./loops"

/** The five rules of the canon. `torb format` runs every one of them. */
public type Rule {
  case Calls
  case Strings
  case ImportedCasePatterns
  case UnusedBindings
  case Loops
}

/** How many edits of each kind were made (or would be), for the summary line. */
public type Counts {
  var toCommand: Int = 0
  var toParentheses: Int = 0
  var strings: Int = 0
  var patterns: Int = 0
  var bindings: Int = 0
  var endless: Int = 0

  var fn add(kind: EditKind) {
    match kind {
      .ToCommand => {
        toCommand = toCommand + 1
      }
      .ToParentheses => {
        toParentheses = toParentheses + 1
      }
      .IndentedString => {
        strings = strings + 1
      }
      .CasePattern => {
        patterns = patterns + 1
      }
      .UnusedBinding => {
        bindings = bindings + 1
      }
      .EndlessLoop => {
        endless = endless + 1
      }
    }
  }
}

/** The canon of one source text: the rewritten text, the counts, and what the safety net skipped or dropped. */
public type Outcome {
  var text: String
  var counts: Counts = Counts()
  /** Why a whole file, or one string inside of it, was left alone */
  var skipped: List<String> = []
  /** An edit the safety net threw away, with what it would have changed */
  var dropped: List<String> = []
}

/** The canon of one source text. Public for the tests; every rule is here, so a test can ask for one of them alone. */
public fn rewrite(source: String, rules: List<Rule>): Outcome {
  var outcome = Outcome source
  const baseline = match canonicalText(source) {
    Some(found) => found
    None => {
      outcome.skipped.append "it does not parse"
      return outcome
    }
  }
  const text = SourceText.of source
  const lexed = lex text
  const parsed = parse text
  const sites = walk parsed.file

  var edits: List<Edit> = []
  if rules.contains(Rule.Calls) {
    edits.appendAll callEdits(source, lexed.tokens, sites.calls)
  }
  if rules.contains(Rule.Strings) {
    const found = stringEdits source, lexed.tokens
    edits.appendAll found.edits
    const lines = LineIndex.of source
    for skip in found.skipped {
      const at = lines.lineAndColumn skip.offset
      outcome.skipped.append "{at.line}:{at.column}: {skip.reason}"
    }
  }
  edits.sort({ _.position })
  // The rule that changes the tree comes last, so that it starts from a file the safety net has settled
  if rules.contains(Rule.ImportedCasePatterns) {
    edits.appendAll patternEdits(source, parsed.file, sites.patterns)
  }
  if rules.contains(Rule.UnusedBindings) {
    edits.appendAll bindingEdits(source, sites.bindings)
  }
  if rules.contains(Rule.Loops) {
    edits.appendAll loopEdits(source, sites.endless)
  }

  var document = Document.of source
  var expected = baseline
  const lines = LineIndex.of source
  for edit in edits {
    const candidate = document.preview edit
    const after = canonicalText candidate
    const stays = if edit.kind.preservesTheTree() { after == expected } else { after.isSome() }
    if !stays {
      const at = lines.lineAndColumn edit.position
      outcome.dropped.append "{at.line}:{at.column}: {edit.kind} would change more than the way it is written"
      continue
    }
    if !edit.kind.preservesTheTree() {
      expected = after.expect "just checked that it parses"
    }
    document.accept edit, candidate
    outcome.counts.add edit.kind
  }
  outcome.text = document.intoText()
  outcome
}

/**
 * The syntax tree of a source as text, with every span and every `CallStyle` erased: what an edit of the canon must
 * not change. `None` if the source does not parse cleanly.
 *
 * It works on the generated `Show` of the tree, the same text `torb ast` prints, because that prints every field of
 * every node - a tree that is equal here is equal everywhere except in the two places the canon is allowed to
 * touch.
 */
public fn canonicalText(source: String): String? {
  const parsed = parse SourceText.of(source)
  if !parsed.diagnostics.isEmpty() {
    return None
  }
  withoutSpansAndStyles "{parsed.file}"
}

const spanMarker = "Span(start: "
const commandMarker = "style: Command"
const parenthesesMarker = "style: Parentheses"

fn withoutSpansAndStyles(dump: String): String {
  var result = ""
  var rest = dump
  loop {
    const spanAt = rest.byteOffsetOf spanMarker
    const commandAt = rest.byteOffsetOf commandMarker
    const parenthesesAt = rest.byteOffsetOf parenthesesMarker
    match earliest([spanAt, commandAt, parenthesesAt]) {
      None => {
        return result + rest
      }
      Some(index) => {
        result = result + rest.sliceBytes(0, index)
        if spanAt == index {
          const afterPrefix = index + spanMarker.byteLength()
          const end = match rest.sliceBytes(afterPrefix, rest.byteLength()).byteOffsetOf(")") {
            Some(length) => afterPrefix + length + 1
            None => rest.byteLength()
          }
          result = result + "Span"
          rest = rest.sliceBytes end, rest.byteLength()
        } else if commandAt == index {
          result = result + "style: *"
          rest = rest.sliceBytes(index + commandMarker.byteLength(), rest.byteLength())
        } else {
          result = result + "style: *"
          rest = rest.sliceBytes(index + parenthesesMarker.byteLength(), rest.byteLength())
        }
      }
    }
  }
}

fn earliest(indices: List<Int?>): Int? {
  var found: Int? = None
  for index in indices {
    match index {
      None => {}
      Some(value) => {
        const isEarlier = match found {
          Some(current) => value < current
          None => true
        }
        if isEarlier {
          found = value
        }
      }
    }
  }
  found
}
