/**
 * One walk over a syntax tree that collects what the rules of the canon need: every call, with whether it stands in
 * _command position_ and whether its callee could be a field, and every pattern.
 *
 * Command position is where `parser/expressions.trb`'s `parseCommandExpression` reads a call as a command: the
 * start of a statement, the right side of a binding or an assignment, after `return`, after `=>`, and the default
 * of a field of a type. The default of a parameter is parsed as an ordinary expression, and the default of a field
 * of a **case** is separated from the next field by a comma, which a command would swallow - neither counts here.
 */

use Span from "../syntax/source"
use SourceFile, Statement, StatementKind, Declaration, DeclarationKind, Member, MemberKind from "../syntax/ast"
use FunctionDeclaration, Binding, Condition, Block, Argument, Expression, ExpressionKind from "../syntax/ast"
use Pattern, PatternKind, InfixOperator from "../syntax/ast"

/** One call of the tree: whether it stands in command position, and whether its callee could be a field. */
public type CallSite {
  call: Expression
  isCommandPosition: Bool
  /**
   * The callee names a field or a constant of the `type`, `trait` or `extend` this call is in, so the parentheses
   * decide what the call **means**: a command writes the field ("property commands"), and "calling a function in a
   * field always needs parentheses". Such a call is left exactly as it is written.
   */
  calleeCouldBeAField: Bool
}

/**
 * One **refutable** pattern and the text a use of what it binds may stand in: the guard and the body of a `match`
 * arm, the body of an `if const`/`if var`, the body of a `while const`. Nothing else binds refutably.
 */
public type BindingSite {
  pattern: Pattern
  regions: List<Span>
}

/** Every call, pattern, refutable binding and endless loop of a file, for the rules of the canon to read. */
public type Sites {
  var calls: List<CallSite> = []
  var patterns: List<Pattern> = []
  var bindings: List<BindingSite> = []
  /** Every `while true { ... }`: the statement the rule `loops` rewrites into a `loop { ... }` */
  var endless: List<Statement> = []
  /**
   * Where the left operand of every infix operator ends: the operator is the first token after it that can be one.
   * This is how `torb format` tells a `<` that compares from one that opens type arguments, and a `-` that subtracts
   * from one that negates.
   */
  var infixOperators: List<Int> = []
  /** Where every `-`, `!` and `~` in front of an operand starts. */
  var prefixOperators: List<Int> = []
  /** Where every `.Case` of an expression or a pattern starts: a `.` in front of a name rather than between two. */
  var implicitMembers: List<Int> = []
  /** Where the parameters of every closure that has some end: its `=>` is the first one after it. */
  var closureArrows: List<Int> = []
  /** Where the target of every expression with type arguments ends (`decode<Config>`): its `<` is the first token after it. */
  var genericArguments: List<Int> = []
  /**
   * Every chain of at least two method calls, the one `torb format` breaks in front of each `.`. A chain that is part
   * of a longer one is listed too, after it.
   */
  var chains: List<ChainSite> = []
  /**
   * Every run of infix operators of one precedence (`a && b && c`), the one `torb format` breaks in front of each
   * operator. A run inside a longer one of the same precedence is listed too, after it.
   */
  var operatorRuns: List<OperatorRun> = []
}

/**
 * A chain of method calls: `items.filter(...).map(...)`. The head is the value the chain starts with, with the
 * members it reads before its first call; each group is a method call and whatever follows it up to the next one.
 * Behind a name that starts with a capital letter - a type, a case, a module - the first call belongs to the head:
 * `File.readText(path)`, `CExpression.Call(...)`.
 */
public type ChainSite {
  span: Span
  /** Where the name of the method that starts each group starts: its `.` is the token in front of it */
  groups: List<Int>
}

/** A run of infix operators of one precedence, and where the operand in front of each operator ends. */
public type OperatorRun {
  span: Span
  operands: List<Int>
}

public fn walk(file: SourceFile): Sites {
  var sites = Sites()
  walkStatements sites, [], file.statements
  sites
}

fn walkStatements(var sites: Sites, fields: List<String>, items: List<Statement>) {
  for item in items {
    walkStatement sites, fields, item
  }
}

fn walkStatement(var sites: Sites, fields: List<String>, item: Statement) {
  match item.kind {
    .Declare(inner) => walkDeclaration sites, fields, inner
    .Bind(inner) => walkBinding sites, fields, inner
    // A call is never the target of an assignment, so only the value is treated as command position
    .Assign(target, value) => {
      walkExpression sites, fields, target, isCommandPosition: false
      walkExpression sites, fields, value, isCommandPosition: true
    }
    .For(pattern, iterable, body) => {
      walkPattern sites, fields, pattern
      walkExpression sites, fields, iterable, isCommandPosition: false
      walkBlock sites, fields, body
    }
    .While(condition, body) => {
      // `while true { ... }` is written `loop { ... }`, which is the rule `loops`
      if isEndlessCondition(condition) {
        sites.endless.append item
      }
      walkCondition sites, fields, condition
      // `while const Some(item) = next()`: the body is where the binding has to be used
      walkRefutable sites, condition, [body.span]
      walkBlock sites, fields, body
    }
    .Loop(body) => walkBlock sites, fields, body
    .Return(value) => {
      match value {
        Some(inner) => walkExpression sites, fields, inner, isCommandPosition: true
        None => {}
      }
    }
    .Break | .Continue => {}
    .Evaluate(inner) => walkExpression sites, fields, inner, isCommandPosition: true
  }
}

fn isEndlessCondition(condition: Condition): Bool {
  match condition {
    .Test(test) => match test.kind {
      .BoolLiteral(true) => true
      _ => false
    }
    .Bind(_, _, _) => false
  }
}

fn walkDeclaration(var sites: Sites, fields: List<String>, item: Declaration) {
  match item.kind {
    .Use(_) | .Alias(_) => {}
    .Function(inner) => walkFunction sites, fields, inner
    .Type(inner) => walkMembers sites, inner.members
    .Trait(inner) => walkMembers sites, inner.members
    .Extend(inner) => walkMembers sites, inner.members
    .Foreign(inner) => walkMembers sites, inner.members
    .Constant(inner) => walkBinding sites, fields, inner
  }
}

fn walkMembers(var sites: Sites, items: List<Member>) {
  const innerFields = fieldNames items
  for item in items {
    match item.kind {
      // The members of a type end at the end of their line: a command in a default has nothing to swallow
      .Field(inner) => {
        match inner.default {
          Some(default) => walkExpression sites, innerFields, default, isCommandPosition: true
          None => {}
        }
      }
      .Constant(inner) => walkBinding sites, innerFields, inner
      .Function(inner) => walkFunction sites, innerFields, inner
      // The fields of a case are separated by commas, which a command call would read as its own arguments
      .Case(inner) => {
        for field in inner.fields {
          match field.default {
            Some(default) => walkExpression sites, innerFields, default, isCommandPosition: false
            None => {}
          }
        }
      }
    }
  }
}

fn walkFunction(var sites: Sites, fields: List<String>, item: FunctionDeclaration) {
  for parameter in item.parameters {
    match parameter.default {
      Some(default) => walkExpression sites, fields, default, isCommandPosition: false
      None => {}
    }
  }
  match item.body {
    Some(body) => walkBlock sites, fields, body
    None => {}
  }
}

fn walkBinding(var sites: Sites, fields: List<String>, item: Binding) {
  walkPattern sites, fields, item.pattern
  walkExpression sites, fields, item.value, isCommandPosition: true
}

fn walkCondition(var sites: Sites, fields: List<String>, item: Condition) {
  match item {
    .Test(inner) => walkExpression sites, fields, inner, isCommandPosition: false
    .Bind(_, pattern, value) => {
      walkPattern sites, fields, pattern
      walkExpression sites, fields, value, isCommandPosition: false
    }
  }
}

fn walkBlock(var sites: Sites, fields: List<String>, item: Block) {
  walkStatements sites, fields, item.statements
}

/** A pattern in the head of an `if` or a `while`, with the text its bindings may be used in. */
fn walkRefutable(var sites: Sites, item: Condition, regions: List<Span>) {
  match item {
    .Bind(_, pattern, _) => sites.bindings.append BindingSite(pattern, regions)
    .Test(_) => {}
  }
}

fn walkArguments(var sites: Sites, fields: List<String>, items: List<Argument>) {
  for item in items {
    walkExpression sites, fields, item.value, isCommandPosition: false
  }
}

fn walkExpression(var sites: Sites, fields: List<String>, node: Expression, isCommandPosition: Bool) {
  match node.kind {
    .IntegerLiteral(_) | .FloatLiteral(_) | .BoolLiteral(_) | .VoidLiteral | .CharLiteral(_) => {}
    .Name(_) | .Invalid => {}
    .ImplicitMember(_) => sites.implicitMembers.append node.span.start
    .TextLiteral(segments) => {
      for segment in segments {
        match segment {
          .Interpolated(inner) => walkExpression sites, fields, inner, isCommandPosition: false
          .Literal(_) => {}
        }
      }
    }
    .Generic(target, _) => {
      sites.genericArguments.append target.span.end
      recordChain sites, node
      walkExpression sites, fields, target, isCommandPosition: false
    }
    .TupleLiteral(items) | .ListLiteral(items) => walkArguments sites, fields, items
    .MapLiteral(entries) => {
      for (key, value) in entries {
        walkExpression sites, fields, key, isCommandPosition: false
        walkExpression sites, fields, value, isCommandPosition: false
      }
    }
    .Member(target, _, _) => {
      recordChain sites, node
      walkExpression sites, fields, target, isCommandPosition: false
    }
    .Index(target, index) => {
      recordChain sites, node
      walkExpression sites, fields, target, isCommandPosition: false
      walkExpression sites, fields, index, isCommandPosition: false
    }
    .Call(callee, arguments, _) => {
      const calleeCouldBeAField = match fieldNameOf(callee) {
        Some(name) => fields.contains name
        None => false
      }
      sites.calls.append CallSite(node, isCommandPosition, calleeCouldBeAField)
      recordChain sites, node
      walkExpression sites, fields, callee, isCommandPosition: false
      walkArguments sites, fields, arguments
    }
    .Unary(_, operand) => {
      sites.prefixOperators.append node.span.start
      walkExpression sites, fields, operand, isCommandPosition: false
    }
    .Binary(operator, left, right) => {
      sites.infixOperators.append left.span.end
      var operands: List<Int> = []
      collectOperands left, powerOf(operator), operands
      operands.append left.span.end
      collectOperands right, powerOf(operator), operands
      sites.operatorRuns.append OperatorRun(node.span, operands)
      walkExpression sites, fields, left, isCommandPosition: false
      walkExpression sites, fields, right, isCommandPosition: false
    }
    .RangeLiteral(start, end, _) => {
      match start {
        Some(inner) => walkExpression sites, fields, inner, isCommandPosition: false
        None => {}
      }
      match end {
        Some(inner) => walkExpression sites, fields, inner, isCommandPosition: false
        None => {}
      }
    }
    .Try(inner) => {
      recordChain sites, node
      walkExpression sites, fields, inner, isCommandPosition: false
    }
    .Closure(closure) => {
      for parameter in closure.parameters {
        walkPattern sites, fields, parameter.pattern
      }
      if const Some(last) = closure.parameters.last() {
        const end = match last.annotation {
          Some(annotation) => annotation.span.end
          None => last.pattern.span.end
        }
        sites.closureArrows.append end
      }
      walkBlock sites, fields, closure.body
    }
    .If(condition, then, otherwise) => {
      walkCondition sites, fields, condition
      // `if const Some(user) = lookup()` binds for the body of the `if` and for nothing else, the `else` branch included
      walkRefutable sites, condition, [then.span]
      walkBlock sites, fields, then
      match otherwise {
        Some(inner) => walkExpression sites, fields, inner, isCommandPosition: false
        None => {}
      }
    }
    .Match(subject, arms) => {
      walkExpression sites, fields, subject, isCommandPosition: false
      for arm in arms {
        walkPattern sites, fields, arm.pattern
        const regions = match arm.guard {
          Some(guard) => [guard.span, arm.body.span]
          None => [arm.body.span]
        }
        sites.bindings.append BindingSite(arm.pattern, regions)
        match arm.guard {
          Some(guard) => walkExpression sites, fields, guard, isCommandPosition: false
          None => {}
        }
        walkExpression sites, fields, arm.body, isCommandPosition: true
      }
    }
    .Block(inner) => walkBlock sites, fields, inner
  }
}

fn walkPattern(var sites: Sites, fields: List<String>, node: Pattern) {
  sites.patterns.append node
  match node.kind {
    .Wildcard | .Binding(_) | .Invalid => {}
    .Literal(value) => walkExpression sites, fields, value, isCommandPosition: false
    .RangePattern(start, end, _) => {
      walkExpression sites, fields, start, isCommandPosition: false
      walkExpression sites, fields, end, isCommandPosition: false
    }
    .TuplePattern(items) | .Alternatives(items) => {
      for item in items {
        walkPattern sites, fields, item
      }
    }
    .ListPattern(items, _) => {
      for item in items {
        walkPattern sites, fields, item
      }
    }
    .Variant(_, variantFields, _) => {
      for field in variantFields {
        walkPattern sites, fields, field.pattern
      }
    }
    .ImplicitVariant(_, variantFields, _) => {
      sites.implicitMembers.append node.span.start
      for field in variantFields {
        walkPattern sites, fields, field.pattern
      }
    }
  }
}

/**
 * The fields and the constants of a type, trait or extend: the names a command inside one of its functions writes
 * instead of calls.
 */
fn fieldNames(members: List<Member>): List<String> {
  var names: List<String> = []
  for member in members {
    match member.kind {
      .Field(field) => names.append field.name.text
      .Constant(binding) => {
        match binding.pattern.kind {
          .Binding(name) => names.append name
          _ => {}
        }
      }
      _ => {}
    }
  }
  names
}

/**
 * The field a callee could name: `step` and `self.step` inside of the type that has the field `step`. A field of
 * somebody else's value (`config.port`) is not visible here - the type checker sees those.
 */
fn fieldNameOf(callee: Expression): String? {
  match callee.kind {
    .Name(name) => name
    .Member(target, name, isOptional) if !isOptional && isSelfValue(target) => name.text
    _ => None
  }
}

fn isSelfValue(target: Expression): Bool {
  match target.kind {
    .Name(text) if text == "self" => true
    _ => false
  }
}

// --- Chains and runs of operators -------------------------------------------------------------------------------------

/** One step of a chain of postfix operations. */
type ChainStep {
  /** `.name`, with where the name starts */
  case Member(name: Int)
  case Call
  /** An index, a `?` or type arguments */
  case Other
}

/**
 * The chain a postfix expression ends, if it has at least two method calls behind its head. A target in parentheses
 * ends the chain: `(a.b).c()` is a chain of one call on `(a.b)`.
 */
fn recordChain(var sites: Sites, node: Expression) {
  var steps: List<ChainStep> = []
  const base = chainSteps node, steps
  var groups: List<Int> = []
  for (index, step) in steps.indexed() {
    match step {
      .Member(name) => {
        if index + 1 < steps.length() && isCall(steps[index + 1]) {
          groups.append name
        }
      }
      _ => {}
    }
  }
  if startsWithCapital(base) && !groups.isEmpty() {
    const _ = groups.removeAt 0
  }
  if groups.length() >= 2 {
    sites.chains.append ChainSite(node.span, groups)
  }
}

fn isCall(step: ChainStep): Bool {
  match step {
    .Call => true
    _ => false
  }
}

/** The steps of a chain, from its base on, and the base. */
fn chainSteps(node: Expression, var steps: List<ChainStep>): Expression {
  match node.kind {
    .Member(target, name, _) if target.span.start == node.span.start => {
      const base = chainSteps target, steps
      steps.append ChainStep.Member(name.span.start)
      base
    }
    .Call(callee, _, _) if callee.span.start == node.span.start => {
      const base = chainSteps callee, steps
      steps.append ChainStep.Call
      base
    }
    .Index(target, _) if target.span.start == node.span.start => {
      const base = chainSteps target, steps
      steps.append ChainStep.Other
      base
    }
    .Generic(target, _) if target.span.start == node.span.start => {
      const base = chainSteps target, steps
      steps.append ChainStep.Other
      base
    }
    .Try(inner) if inner.span.start == node.span.start => {
      const base = chainSteps inner, steps
      steps.append ChainStep.Other
      base
    }
    _ => node
  }
}

fn startsWithCapital(base: Expression): Bool {
  match base.kind {
    .Name(text) => {
      match text.chars().first() {
        Some(character) => character.toUpperCase() == character && character.isLetter()
        None => false
      }
    }
    _ => false
  }
}

/**
 * The ends of the operands of a run of operators of one precedence below `node`. An operand in parentheses is one
 * operand: its span starts at the `(`, while the left operand inside of it starts behind it.
 */
fn collectOperands(node: Expression, power: Int, var operands: List<Int>) {
  match node.kind {
    .Binary(operator, left, right) if powerOf(operator) == power && left.span.start == node.span.start => {
      collectOperands left, power, operands
      operands.append left.span.end
      collectOperands right, power, operands
    }
    _ => {}
  }
}

/** How tightly an infix operator binds, as the Pratt loop of the parser has it. */
fn powerOf(operator: InfixOperator): Int {
  match operator {
    .Or => 1
    .And => 2
    .Equal | .NotEqual | .Less | .LessOrEqual | .Greater | .GreaterOrEqual => 3
    .Coalesce => 4
    .Add | .Subtract | .BitwiseOr | .BitwiseExclusiveOr => 6
    .Multiply | .Divide | .Remainder | .BitwiseAnd => 7
    .ShiftLeft | .ShiftRight => 8
    .Power => 9
  }
}
