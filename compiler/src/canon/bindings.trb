/**
 * Rule `unused-bindings`: in a **refutable** pattern - an arm of a `match`, an `if const`/`if var`, a `while const`
 * - a binding whose name is nowhere in the arm's guard or body becomes `_`.
 *
 * The rule the checker enforces is the one about reading a binding, and this is only the sweep that brings a whole
 * checkout to it. It works without name resolution and therefore stays on the safe side: a use is "the name occurs
 * as a word anywhere in the text of the guard or the body". A comment, a string literal and an interpolation all
 * count, and so does a name that a nested pattern happens to bind again - every one of those leaves the binding
 * exactly as it is, and the checker then says what is left for a human.
 *
 * A name that starts with `_` is already the documented form and is never touched.
 *
 * Like `imported-case-patterns` this rule changes the syntax *tree* (`Binding` becomes `Wildcard`), so it is outside
 * the safety net that compares trees and is checked by parsing alone, and it stays out of the default run.
 */

use Span from "../syntax/source"
use Pattern, PatternKind from "../syntax/ast"
use Edit, EditKind, Replacement from "./edit"
use BindingSite from "./walk"

public fn bindingEdits(source: String, sites: List<BindingSite>): List<Edit> {
  var edits: List<Edit> = []
  for site in sites {
    var names: List<Span> = []
    collectNames site.pattern, names
    for name in names {
      const text = source[name.start..name.end]
      // `_reason` keeps the name as documentation and is the form the rule points at, never one it rewrites
      if text.startsWith("_") {
        continue
      }
      const isUsed = site.regions.any({ containsWord source[_.start.._.end], text })
      if isUsed {
        continue
      }
      edits.add Edit(EditKind.UnusedBinding, name.start, [Replacement(name.start, name.end, "_")])
    }
  }
  edits.sort({ _.position })
  edits
}

/** The span of every bare name the pattern binds. `...rest` is left out on purpose: dropping its name changes more than one token, and the checker reports the few that exist. */
fn collectNames(pattern: Pattern, var found: List<Span>) {
  match pattern.kind {
    .Binding(_) => found.add pattern.span
    .TuplePattern(items) | .Alternatives(items) => {
      for item in items {
        collectNames item, found
      }
    }
    .ListPattern(items, _) => {
      for item in items {
        collectNames item, found
      }
    }
    .Variant(_, fields) | .ImplicitVariant(_, fields) => {
      for field in fields {
        collectNames field.pattern, found
      }
    }
    .Wildcard | .Literal(_) | .RangePattern(_, _, _) | .Invalid => {}
  }
}

/** Whether the name stands in the text as a word of its own: not as a part of a longer name. Everything else about the place it stands in is deliberately ignored, because ignoring it can only keep a binding that the checker then names. */
fn containsWord(text: String, name: String): Bool {
  var from = 0
  const length = text.byteLength()
  while from < length {
    match text[from..length].indexOf(name) {
      None => {
        return false
      }
      Some(at) => {
        const start = from + at
        const end = start + name.byteLength()
        const before = start == 0 || !isWordCharacter(text.charAt(start - 1))
        const after = !isWordCharacter(text.charAt(end))
        if before && after {
          return true
        }
        from = start + 1
      }
    }
  }
  false
}

fn isWordCharacter(character: Char?): Bool {
  match character {
    None => false
    Some(value) => value == '_' || isAsciiAlphanumeric(value)
  }
}

fn isAsciiAlphanumeric(character: Char): Bool {
  (character >= '0' && character <= '9') || (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')
}
