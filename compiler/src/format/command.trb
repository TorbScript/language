/**
 * `torb format`: writes TorbScript sources in the one layout of the language - the canon of the formatter (a call is a
 * command wherever the grammar allows it, a multi-line string is indented, and the three rules that rewrite the tree)
 * and the layout of `./layout` (indentation, spaces, blank lines).
 *
 * ```text
 * torb format [--check] [path]...
 * ```
 *
 * Without a path it formats the current directory. `--check` writes nothing, lists the files that would change and
 * leaves with 1 if there is one. There is no option: the layout is decided once, for every program.
 *
 * **The safety net** is the one of `torb canon`, whose rules run first: every edit of the canon is applied on its own
 * and parsed again. The layout is checked once per file: the syntax tree of what comes out, with every span and every
 * call style erased, has to be the tree that went in, or the layout of that file is dropped and reported - a formatter
 * that would change what a program means is a bug, so `--check` fails on it too. The whole of it runs until nothing
 * changes any more, which is what makes it idempotent: a second run over its output changes nothing.
 */

use File, IoError from "std/fs"
use rewrite, Rule, canonicalText from "../canon/command"
use laidOut from "./layout"
use counted from "../cli/render"

/** `torb format --help` */
public fn formatUsage(): String {
  [
    "torb format - write TorbScript sources in the layout of the language",
    "",
    "Usage:",
    "  torb format [--check] [path]...",
    "",
    "  A path is a file or a directory (default: the current directory). Every rule of the canon runs - a call is a",
    "  command where the grammar allows it, a multi-line `\"\"\"` string is indented, `.None` becomes `None` for an",
    "  imported case, an unread binding of a refutable pattern becomes `_`, `while true \{` becomes `loop \{` - and then",
    "  the layout: two spaces per level, the spaces between tokens, at most one blank line in a row, one line break at",
    "  the end. Line breaks between tokens, comments and each file's line endings are kept.",
    "",
    "  --check   Write nothing, list the files that would change, leave with 1 if there is one",
  ].joined(separator: "\n")
}

/** What the command line asked for. */
public type FormatOptions {
  check: Bool
  paths: List<String>
}

/** Parses `torb format`'s arguments. `None` for a flag that is not `--check` - the caller prints [formatUsage] and exits with 2. */
public fn formatOptionsOf(arguments: List<String>): FormatOptions? {
  var check = false
  var paths: List<String> = []
  for argument in arguments {
    if argument == "--check" {
      check = true
      continue
    }
    if argument.startsWith("-") {
      return None
    }
    paths.append argument
  }
  if paths.isEmpty() {
    paths.append "."
  }
  FormatOptions check, paths
}

/**
 * The arguments of the retired `torb canon`, read as `torb format`'s: `--check` and the paths stay, and every
 * `--rule` is dropped with its value, because `torb format` runs every rule. `None` where `canon` would have printed
 * its usage: an unknown flag or no path.
 */
public fn formatOptionsOfCanon(arguments: List<String>): FormatOptions? {
  var check = false
  var paths: List<String> = []
  var index = 0
  while index < arguments.length() {
    const argument = arguments[index]
    index = index + 1
    if argument == "--check" {
      check = true
    } else if argument == "--rule" {
      index = index + 1
    } else if argument.startsWith("--rule=") {
      continue
    } else if argument.startsWith("-") {
      return None
    } else {
      paths.append argument
    }
  }
  if paths.isEmpty() {
    return None
  }
  FormatOptions check, paths
}

/** One source, formatted: the text, and what the safety nets left alone and why. */
public type Formatted {
  var text: String
  /** Why the whole file was left alone: it does not parse */
  var skipped: String? = None
  /** A string the rule `strings` left as it was, with the reason */
  var notes: List<String> = []
  /** An edit or a layout a safety net refused: a bug of the formatter, which `--check` fails on */
  var dropped: List<String> = []
}

/** Every rule of the canon, in the order `torb canon` ran them. */
const canonRules = [Rule.Calls, Rule.Strings, Rule.ImportedCasePatterns, Rule.UnusedBindings, Rule.Loops]

/** How many rounds the formatter runs before it gives up on reaching a text that stays as it is. */
const maximumRounds = 4

/** The layout of one source text. Public for the tests. */
public fn formatted(source: String): Formatted {
  var result = Formatted source
  var text = source
  var round = 0
  loop {
    const once = formattedOnce text
    if round == 0 && once.skipped.isSome() {
      return once
    }
    result.notes = once.notes
    result.dropped.appendAll once.dropped
    if once.text == text {
      result.text = text
      return result
    }
    text = once.text
    round = round + 1
    if round == maximumRounds {
      result.dropped.append "the formatter did not settle on one text in {maximumRounds} rounds"
      result.text = text
      return result
    }
  }
}

/** One round: the rules of the canon, the layout, and the rule `strings` again where the layout moved a line. */
fn formattedOnce(source: String): Formatted {
  var result = Formatted source
  const canon = rewrite source, canonRules
  for reason in canon.skipped {
    if reason == "it does not parse" {
      result.skipped = reason
      return result
    }
    result.notes.append reason
  }
  result.dropped.appendAll canon.dropped
  var text = canon.text
  match laidOut(text) {
    Some(laid) if laid != text => {
      if canonicalText(laid) == canonicalText(text) {
        const strings = rewrite laid, [Rule.Strings]
        result.dropped.appendAll strings.dropped
        text = strings.text
      } else {
        result.dropped.append "the layout would change what the file means"
      }
    }
    Some(_) => {}
    None => result.dropped.append "the layout found something between two tokens that is neither a comment nor white space"
  }
  result.text = text
  result
}

/** `torb format [--check] [path]...`. Returns the exit code. */
public fn runFormat(options: FormatOptions): Result<Int, IoError> {
  var files: List<String> = []
  for path in options.paths {
    collectFormatFiles(files, path)?
  }
  files.sort({ _ })
  var changed: List<String> = []
  var skipped: List<String> = []
  var notes: List<String> = []
  var dropped: List<String> = []
  for file in files {
    const source = File.readText(file)?
    const outcome = formatted source
    if const Some(reason) = outcome.skipped {
      skipped.append "{file}: {reason}"
      continue
    }
    for note in outcome.notes {
      notes.append "{file}: {note}"
    }
    for reason in outcome.dropped {
      dropped.append "{file}: {reason}"
    }
    if outcome.text == source {
      continue
    }
    changed.append file
    if !options.check {
      File.writeText(file, outcome.text)?
    }
  }
  for file in changed {
    print file
  }
  for reason in skipped {
    print "skipped {reason}"
  }
  for note in notes {
    print "left alone {note}"
  }
  for reason in dropped {
    printError "dropped {reason}"
  }
  const verb = if options.check { "would change" } else { "changed" }
  print "{changed.length()} of {counted(files.length(), "file")} {verb}"
  if !dropped.isEmpty() {
    printError "{counted(dropped.length(), "edit")} dropped by a safety net: that is a bug of `torb format`"
    return 1
  }
  if options.check && !changed.isEmpty() {
    return 1
  }
  0
}

/**
 * Every `.trb` file below the paths, without the hidden directories, the `build` directories (what a build or a docs
 * check writes, never a source) and the two directories of files that are broken on purpose - unlike a file that fails
 * to parse, they are not even read.
 */
public fn collectFormatFiles(var files: List<String>, path: String): Result<Void, IoError> {
  if !File.isDirectory(path) {
    if !File.exists(path) {
      return Fail IoError(path, "The file does not exist")
    }
    files.append path
    return Ok(void)
  }
  for entry in File.list(path)? {
    const child = "{path}/{entry}"
    if File.isDirectory(child) {
      const isSkipped = entry.startsWith(".") || entry == "build" || entry == "parser-cases" || entry == "lexer-cases"
      if !isSkipped {
        collectFormatFiles(files, child)?
      }
    } else if entry.endsWith(".trb") {
      files.append child
    }
  }
  Ok(void)
}
