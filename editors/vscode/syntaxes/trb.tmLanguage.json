{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TorbScript",
  "scopeName": "source.trb",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#imports" },
    { "include": "#keyword-names" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#labels" },
    { "include": "#calls" },
    { "include": "#variables" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.trb",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "patterns": [
            { "include": "#block-comment-nested" },
            { "name": "markup.inline.raw.trb", "match": "`[^`]*`" }
          ]
        },
        { "include": "#block-comment-nested" },
        {
          "name": "comment.line.double-slash.trb",
          "match": "//.*$"
        }
      ]
    },
    "block-comment-nested": {
      "name": "comment.block.trb",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": []
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.raw.trb",
          "begin": "\\braw\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.raw.trb",
          "begin": "\\braw\"",
          "end": "\""
        },
        {
          "name": "string.quoted.triple.trb",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#string-content" }]
        },
        {
          "name": "string.quoted.double.trb",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "include": "#string-content" }]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "constant.character.escape.trb",
          "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|.)"
        },
        {
          "name": "meta.interpolation.trb",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.trb" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.trb" } },
          "contentName": "meta.embedded.line.trb",
          "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
        }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
    },
    "chars": {
      "name": "string.quoted.single.trb",
      "match": "'(\\\\(u\\{[0-9A-Fa-f]+\\}|.)|[^'\\\\])'",
      "captures": { "1": { "name": "constant.character.escape.trb" } }
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.trb", "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b" },
        { "name": "constant.numeric.binary.trb", "match": "\\b0b[01][01_]*\\b" },
        {
          "name": "constant.numeric.float.trb",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b"
        },
        { "name": "constant.numeric.integer.trb", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(from)(?=\\s*\")",
          "captures": { "1": { "name": "keyword.control.import.trb" } }
        },
        {
          "match": "(?<=\\*\\s)(as)\\b",
          "captures": { "1": { "name": "keyword.control.import.trb" } }
        },
        { "name": "keyword.control.import.trb", "match": "\\buse\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "`fn area()`, `var fn translate(...)` and `static fn square(...)`: the word in front is part of the declaration",
          "match": "\\b(?:(var|static)\\s+)?(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.trb" },
            "2": { "name": "storage.type.function.trb" },
            "3": { "name": "entity.name.function.trb" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.trb" },
            "2": { "name": "entity.name.type.trb" }
          }
        },
        {
          "comment": "A trait's own name gets a scope of its own (entity.name.type.interface), distinct from a type's",
          "match": "\\b(trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.trb" },
            "2": { "name": "entity.name.type.interface.trb" }
          }
        },
        {
          "match": "\\b(case)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.case.trb" },
            "2": { "name": "variable.other.enummember.trb" }
          }
        },
        {
          "comment": "`var fn` declares a function, not a binding called `fn`",
          "match": "\\b(const|var|static)\\s+(?!(?:self|type|fn|const)\\b)([a-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
          "captures": {
            "1": { "name": "storage.type.trb" },
            "2": { "name": "variable.other.declaration.trb" }
          }
        }
      ]
    },
    "keyword-names": {
      "comment": "A reserved word where it can only be a name: a member after a `.` (`event.type`, `event.match(...)`), and a field or a label before a `:` (`type: String`, `Event(type: \"click\")`). `self` and `Self` keep their own colors.",
      "patterns": [
        { "name": "variable.other.property.trb", "match": "(?<=\\.)(?:const|var|fn|type|trait|extend|foreign|case|use|public|private|native|shared|lazy|static|if|else|match|for|in|while|loop|break|continue|return|true|false|void|with|where)\\b" },
        { "name": "variable.other.property.trb", "match": "\\b(?:const|var|fn|type|trait|extend|foreign|case|use|public|private|native|shared|lazy|static|if|else|match|for|in|while|loop|break|continue|return|true|false|void|with|where)(?=\\s*:(?!:))" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.trb",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|return)\\b"
        },
        {
          "name": "storage.type.trb",
          "match": "\\b(const|var|fn|type|trait|extend|foreign|case)\\b"
        },
        {
          "name": "storage.modifier.trb",
          "match": "\\b(public|private|native|shared|lazy|static)\\b"
        },
        {
          "comment": "`protected var count: Int`: a word only in front of `var`, so a member named `protected` stays a name",
          "name": "storage.modifier.trb",
          "match": "\\bprotected(?=\\s+var\\b)"
        },
        {
          "comment": "`deprecated(\"why\")` on the line above a declaration: a word only in front of its parenthesis at the start of a line, so a member named `deprecated` stays a name",
          "match": "^\\s*(deprecated)(?=\\()",
          "captures": {
            "1": { "name": "storage.modifier.trb" }
          }
        },
        {
          "name": "keyword.other.trb",
          "match": "\\b(with|where|by)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.trb", "match": "\\b(true|false|void)\\b" },
        { "name": "variable.language.self.trb", "match": "\\bself\\b" },
        { "name": "support.type.self.trb", "match": "\\bSelf\\b" },
        { "include": "#cases" },
        { "name": "support.function.builtin.trb", "match": "\\b(panic|print|assert|do|spawn)\\b" }
      ]
    },
    "cases": {
      "comment": "`.Circle` (a case with no receiver in front of it - the dot is never preceded by a word character or a closing bracket, unlike `shape.Circle`), `Shape.Circle` (both segments capitalized - this language never dots into a nested type, only into a case or a lowercase namespace), and the four prelude cases bare. This is a heuristic, like the rest of this grammar without a type checker: `torb highlight` (see README) resolves the same forms exactly.",
      "patterns": [
        {
          "match": "(?<![\\w)\\]])(\\.)([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.trb" },
            "2": { "name": "variable.other.enummember.trb" }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.trb" },
            "2": { "name": "punctuation.accessor.trb" },
            "3": { "name": "variable.other.enummember.trb" }
          }
        },
        { "name": "variable.other.enummember.trb", "match": "\\b(Some|None|Ok|Fail)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.trb",
          "match": "\\b(Int|Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Float|Float32|Float64|Decimal|Bool|Char|String|Void|Never)\\b"
        },
        {
          "name": "entity.name.type.trb",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "(\\.\\.\\.)?\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "keyword.operator.spread.trb" },
            "2": { "name": "variable.parameter.trb" },
            "3": { "name": "punctuation.separator.type.trb" }
          }
        }
      ]
    },
    "calls": {
      "comment": "A call written after a `.` is a method (`receiver.name(...)`, `receiver.name argument`) in every style; a bare one is a function - the same rule `torb highlight` (see README) applies from the syntax tree. Both scopes are assigned regardless of command style vs. parentheses style, so the two never differ in color here either.",
      "patterns": [
        {
          "comment": ".name(...) and .name<T>(...) - a method call with parentheses",
          "match": "(?<=\\.)([a-z_][A-Za-z0-9_]*)(?=\\s*(<[^<>()=]*(<[^<>()=]*>[^<>()=]*)*>)?\\()",
          "captures": { "1": { "name": "entity.name.function.member.trb" } }
        },
        {
          "comment": ".name { ... } - a method call with only a trailing closure",
          "match": "(?<=\\.)([a-z_][A-Za-z0-9_]*)(?=\\s*\\{)",
          "captures": { "1": { "name": "entity.name.function.member.trb" } }
        },
        {
          "comment": "name(...) and name<T>(...), not written after a `.`",
          "match": "(?<!\\.)\\b([a-z_][A-Za-z0-9_]*)(?=\\s*(<[^<>()=]*(<[^<>()=]*>[^<>()=]*)*>)?\\()",
          "captures": { "1": { "name": "entity.name.function.call.trb" } }
        },
        {
          "comment": "Command calls at the start of a statement: `print x`, `route \"/a\", to: b`, `database {`",
          "match": "(?:^\\s*|(?<=\\{ )|(?<==> ))(?!(?:if|else|match|for|in|while|loop|break|continue|return|const|var|static|fn|type|trait|extend|case|use|public|private|native|shared|lazy|foreign|with|where|by|true|false|self)\\b)([a-z_][A-Za-z0-9_]*)(?=[ \\t]+(?!(?:if|in|else|with|where|by|as)\\b)([\"'{0-9]|r\"|[A-Za-z_]))",
          "captures": { "1": { "name": "entity.name.function.call.command.trb" } }
        },
        {
          "comment": "Command calls on a member path: `Email.parse \"x\"`, `expect(x).toBe 3` - a method, like the parenthesized form",
          "match": "(?<=\\.)([a-z_][A-Za-z0-9_]*)(?=[ \\t]+([\"'0-9]|[A-Z][A-Za-z0-9_]*\\())",
          "captures": { "1": { "name": "entity.name.function.member.trb" } }
        }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.language.implicit.trb", "match": "\\b_[0-9]*\\b" },
        {
          "match": "(?<=\\.)([a-z_][A-Za-z0-9_]*)\\b",
          "captures": { "1": { "name": "variable.other.member.trb" } }
        },
        { "name": "variable.other.trb", "match": "\\b[a-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.trb", "match": "=>" },
        { "comment": "`...rest` in a list pattern and in a parameter list, `Config(host, ...)` in a constructor pattern, and the spread of an argument", "name": "keyword.operator.spread.trb", "match": "\\.\\.\\." },
        { "name": "keyword.operator.range.trb", "match": "\\.\\.=|\\.\\." },
        { "name": "keyword.operator.optional.trb", "match": "\\?\\?|\\?\\.|\\?" },
        { "name": "keyword.operator.comparison.trb", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.trb", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.trb", "match": "=" },
        { "name": "keyword.operator.arithmetic.trb", "match": "\\+|-|\\*|/|%" },
        { "name": "punctuation.separator.trb", "match": "[,.:|&]" }
      ]
    }
  }
}
