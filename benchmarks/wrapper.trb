/**
 * A one-field type against the number inside it: `Meters` arithmetic against `double` arithmetic in C.
 *
 * This is the zero-cost claim in its smallest form. A wrapper with one field and a method that unwraps, adds and wraps
 * again must lower to the same arithmetic the number would have had on its own.
 */
const steps = 200000000

type Meters {
  value: Float64

  fn plus(other: Self): Self {
    Self(value + other.value)
  }
}

fn walked(): Float64 {
  var total = Meters 0.0
  const step = Meters 0.5
  for _index in 0..steps {
    total = total.plus step
  }
  total.value
}

print "wrapper {walked()}"
