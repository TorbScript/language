/**
 * Reading an `Array<Int, 64>` by index: `values[index]` in a counted loop against `values[index]` in C.
 *
 * The array is passed by value and read through an `Element` step into its inline slots. The loop's own guard keeps
 * `index` inside `0..64`, which is the size the type says, so the range analysis leaves no bounds check in the loop.
 */
const rounds = 2000000

fn filled(): Array<Int, 64> {
  Array.generated { index => index % 7 }
}

fn total(values: Array<Int, 64>): Int {
  var sum = 0
  for _round in 0..rounds {
    for index in 0..64 {
      sum = sum + values[index]
    }
  }
  sum
}

print "array-index {total(filled())}"
