/**
 * Growing a list through a participle: `numbers = appended(numbers, index)` against one `push_back` in C.
 *
 * "Last use is a move" says the list is handed on and changed in place. The assignment back into the same binding is
 * what decides it, so this program measures whether the move happens or a copy of the whole list does.
 */
const size = 60000

fn appended(numbers: List<Int>, value: Int): List<Int> {
  var result = numbers
  result.append value
  result
}

fn grown(): Int {
  var numbers: List<Int> = []
  for index in 0..size {
    numbers = appended numbers, index
  }
  numbers.length()
}

print "accumulate {grown()}"
