/**
 * Reading a list by index: `numbers[index]` in a counted loop against `data[index]` in C.
 *
 * The literal is typed as the trait `List`, so every read is an indirect call through a witness table into
 * `Index.at`, which calls `get`, builds an `Option` and unwraps it again.
 */
const size = 2000000
const rounds = 40

fn filled(): List<Int> {
  var numbers: List<Int> = []
  for index in 0..size {
    numbers.append(index % 97)
  }
  numbers
}

fn total(numbers: List<Int>): Int {
  var sum = 0
  for _round in 0..rounds {
    for index in 0..size {
      sum = sum + numbers[index]
    }
  }
  sum
}

print "list-index {total(filled())}"
