/**
 * Calling a closure that captures one value, against a function pointer with a context in C.
 *
 * The closure is a pair of a code pointer and an environment. What is measured is the environment: whether it is
 * allocated once outside the loop and how much an indirect call with it costs.
 */
const steps = 50000000

fn applied(value: Int, transform: (value: Int) => Int): Int {
  var carried = value
  for _index in 0..steps {
    carried = transform carried
  }
  carried
}

fn stepping(factor: Int): Int {
  applied(1, { (_ * factor + 1) % 1000003 })
}

print "closure {stepping(31)}"
