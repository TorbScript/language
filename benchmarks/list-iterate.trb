/**
 * Walking a list with `for`: what the iterator costs against a plain index loop in C.
 *
 * `for value in numbers` asks the list for an `Iterator`, which is a trait-typed value on the heap, and every turn of
 * the loop is a `makeUnique` plus an indirect call that answers an `Option`.
 */
const size = 2000000
const rounds = 40

fn filled(): List<Int> {
  var numbers: List<Int> = []
  for index in 0..size {
    numbers.add(index % 97)
  }
  numbers
}

fn total(numbers: List<Int>): Int {
  var sum = 0
  for _round in 0..rounds {
    for value in numbers {
      sum = sum + value
    }
  }
  sum
}

print "list-iterate {total(filled())}"
