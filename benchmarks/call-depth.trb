/**
 * Plain calls: a recursive Fibonacci against the same recursion in C.
 *
 * Nothing here is counted, nothing is generic and nothing is behind a trait, so this is the calling convention on its
 * own - the number every other program's overhead is read against.
 */
const depth = 40

fn fibonacci(index: Int): Int {
  if index < 2 {
    return index
  }
  fibonacci(index - 1) + fibonacci(index - 2)
}

print "call-depth {fibonacci(depth)}"
