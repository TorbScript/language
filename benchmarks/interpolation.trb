/**
 * Building short strings: `"{a}:{b}"` against `snprintf` into a stack buffer in C.
 *
 * Every part that is not already a string is shown into a string of its own before the parts are put together, so
 * what is measured is how many allocations one interpolation costs.
 */
const steps = 2000000

fn built(): Int {
  var bytes = 0
  for index in 0..steps {
    const line = "row {index}: {index % 97}"
    bytes = bytes + line.byteLength()
  }
  bytes
}

print "interpolation {built()}"
