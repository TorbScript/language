/**
 * Counting keys in a map: `get` then `set` against one hash table probe in C.
 *
 * The read and the write are two lookups of the same key, and each one hashes the key again, so this measures what a
 * `getOrInsert` that updated in place would save.
 */
const distinct = 50000
const rounds = 60

fn keys(): List<String> {
  var made: List<String> = []
  for index in 0..distinct {
    made.add "key-{index}"
  }
  made
}

fn counted(words: List<String>): Int {
  var counts: Map<String, Int> = [:]
  for _round in 0..rounds {
    for word in words {
      const seen = counts.get(word) ?? 0
      counts.set(word, seen + 1)
    }
  }
  counts.length()
}

print "map-count {counted(keys())}"
