name "torbscript/benchmarks"
version "0.1.0"

// The programs of the performance suite: every `.trb` here has a hand written C twin in `c/` that does the same work,
// and `run.sh` builds both with the same C compiler and the same flags and prints the ratio.
//
// It is a member of the repository's workspace rather than a workspace of its own, so `torb check ..` reads these
// files with everything else: a benchmark that stops compiling is a broken measurement, and the gate should say so
// before `run.sh` does.
test {
  input "."
}
