/**
 * Integer arithmetic in a counted loop: what a checked `+`, `*` and `%` cost against the same loop in C.
 *
 * The chain is data dependent, so neither compiler can turn it into a closed form or vectorize it. What is left is
 * three checked operations and one division per turn, which is the floor every other program here is measured against.
 */
const rounds = 60
const steps = 1000000
const modulus = 1000003

fn chain(): Int {
  var state = 1
  for _round in 0..rounds {
    for index in 0..steps {
      state = (state * 31 + index) % modulus
    }
  }
  state
}

print "arithmetic {chain()}"
