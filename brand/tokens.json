{
  "name": "TorbScript",
  "version": "1.0.0",
  "description": "The design tokens of the TorbScript brand. Every colour is sRGB hex. docs/design/BRAND.md gives each one its role.",
  "logo": {
    "grid": 96,
    "cut": 18,
    "bar-top": 24,
    "bar-height": 18,
    "clear-space": 24,
    "minimum-size": {
      "mark-gradient": "48px",
      "mark-vector": "32px",
      "pixel-art": [
        "16px",
        "24px"
      ],
      "lockup-height": "24px",
      "print": "6mm"
    }
  },
  "color": {
    "brand": "#D4002D",
    "red": {
      "50": "#FFF2F2",
      "100": "#FFE3E2",
      "200": "#FFCBC8",
      "300": "#FFA6A3",
      "400": "#FE7373",
      "500": "#F33F49",
      "600": "#D4002D",
      "700": "#B00921",
      "800": "#8E1018",
      "900": "#6F1414",
      "950": "#430B0A"
    },
    "neutral": {
      "0": "#FFFDFC",
      "50": "#F9F6F5",
      "100": "#F2EDEC",
      "200": "#E3DEDD",
      "300": "#CFC9C7",
      "400": "#A9A3A1",
      "500": "#857E7C",
      "600": "#68625F",
      "700": "#4F4947",
      "800": "#37312F",
      "850": "#292422",
      "900": "#1F1B19",
      "950": "#14110F",
      "1000": "#0C0908"
    }
  },
  "theme": {
    "light": {
      "background": "#FFFDFC",
      "surface": "#F9F6F5",
      "surface-raised": "#FFFFFF",
      "surface-hover": "#F2EDEC",
      "surface-active": "#E3DEDD",
      "code": "#F9F6F5",
      "border": "#E3DEDD",
      "border-strong": "#CFC9C7",
      "border-control": "#857E7C",
      "text": "#14110F",
      "text-muted": "#68625F",
      "text-subtle": "#78716F",
      "brand": "#D4002D",
      "link": "#14110F",
      "link-underline": "#D4002D",
      "link-underline-hover": "#B00921",
      "focus": "#14110F",
      "selection": "#FFE3E2"
    },
    "dark": {
      "background": "#14110F",
      "surface": "#1F1B19",
      "surface-raised": "#292422",
      "surface-hover": "#292422",
      "surface-active": "#37312F",
      "code": "#1F1B19",
      "border": "#37312F",
      "border-strong": "#4F4947",
      "border-control": "#857E7C",
      "text": "#F9F6F5",
      "text-muted": "#A9A3A1",
      "text-subtle": "#857E7C",
      "brand": "#D4002D",
      "link": "#F9F6F5",
      "link-underline": "#F33F49",
      "link-underline-hover": "#FFA6A3",
      "focus": "#F9F6F5",
      "selection": "#5E2120"
    }
  },
  "state": {
    "error": {
      "light": {
        "text": "#B00921",
        "surface": "#FFF2F2",
        "border": "#FFA6A3",
        "accent": "#B00921"
      },
      "dark": {
        "text": "#FFA6A3",
        "surface": "#3A1413",
        "border": "#8E1018",
        "accent": "#FE7373"
      }
    },
    "warning": {
      "light": {
        "text": "#7D5000",
        "surface": "#FDF1E4",
        "border": "#DDB686",
        "accent": "#9F6700"
      },
      "dark": {
        "text": "#EEB976",
        "surface": "#2C1F0E",
        "border": "#704D1E",
        "accent": "#D6963B"
      }
    },
    "success": {
      "light": {
        "text": "#006E30",
        "surface": "#EAF8EC",
        "border": "#9ACCA3",
        "accent": "#1D8B44"
      },
      "dark": {
        "text": "#92D7A0",
        "surface": "#152619",
        "border": "#32613E",
        "accent": "#62BB78"
      }
    },
    "info": {
      "light": {
        "text": "#125CA1",
        "surface": "#EBF5FF",
        "border": "#99C2EF",
        "accent": "#2876C5"
      },
      "dark": {
        "text": "#98C8FF",
        "surface": "#152332",
        "border": "#33577F",
        "accent": "#64A9F3"
      }
    }
  },
  "button": {
    "light": {
      "cta": {
        "background": "#D4002D",
        "background-hover": "#B00921",
        "background-active": "#8E1018",
        "text": "#FFFDFC",
        "border": "#D4002D"
      },
      "primary": {
        "background": "#14110F",
        "background-hover": "#37312F",
        "background-active": "#4F4947",
        "text": "#FFFDFC",
        "border": "#14110F"
      },
      "secondary": {
        "background": "transparent",
        "background-hover": "#F2EDEC",
        "background-active": "#E3DEDD",
        "text": "#14110F",
        "border": "#857E7C"
      },
      "quiet": {
        "background": "transparent",
        "background-hover": "#F2EDEC",
        "background-active": "#E3DEDD",
        "text": "#14110F",
        "border": "transparent"
      },
      "disabled": {
        "background": "#F2EDEC",
        "background-hover": "#F2EDEC",
        "background-active": "#F2EDEC",
        "text": "#A9A3A1",
        "border": "#E3DEDD"
      }
    },
    "dark": {
      "cta": {
        "background": "#D4002D",
        "background-hover": "#B00921",
        "background-active": "#8E1018",
        "text": "#FFFDFC",
        "border": "#D4002D"
      },
      "primary": {
        "background": "#F9F6F5",
        "background-hover": "#E3DEDD",
        "background-active": "#CFC9C7",
        "text": "#14110F",
        "border": "#F9F6F5"
      },
      "secondary": {
        "background": "transparent",
        "background-hover": "#292422",
        "background-active": "#37312F",
        "text": "#F9F6F5",
        "border": "#857E7C"
      },
      "quiet": {
        "background": "transparent",
        "background-hover": "#292422",
        "background-active": "#37312F",
        "text": "#F9F6F5",
        "border": "transparent"
      },
      "disabled": {
        "background": "#1F1B19",
        "background-hover": "#1F1B19",
        "background-active": "#1F1B19",
        "text": "#68625F",
        "border": "#37312F"
      }
    }
  },
  "syntax": {
    "light": {
      "keyword": "#B00921",
      "type": "#006C6C",
      "function": "#2855AD",
      "string": "#207029",
      "number": "#925000",
      "case": "#7C3990",
      "parameter": "#4F4947",
      "variable": "#14110F",
      "comment": "#756E6C",
      "punctuation": "#68625F"
    },
    "dark": {
      "keyword": "#F97676",
      "type": "#67D2CC",
      "function": "#8FBCFF",
      "string": "#8CD384",
      "number": "#F6B669",
      "case": "#D8A4E9",
      "parameter": "#CFC9C7",
      "variable": "#F2EDEC",
      "comment": "#A9A3A1",
      "punctuation": "#A9A3A1"
    },
    "mutable": "underline 1.5px in the token's own colour"
  },
  "terminal": {
    "diagnostic": {
      "error": {
        "sgr": "1;31",
        "light": "#B00921",
        "dark": "#FFA6A3"
      },
      "error-caret": {
        "sgr": "31",
        "light": "#B00921",
        "dark": "#FFA6A3"
      },
      "warning": {
        "sgr": "1;33",
        "light": "#7D5000",
        "dark": "#EEB976"
      },
      "warning-caret": {
        "sgr": "33",
        "light": "#7D5000",
        "dark": "#EEB976"
      },
      "note": {
        "sgr": "1;36",
        "light": "#006770",
        "dark": "#78D6DB"
      },
      "help": {
        "sgr": "1;32",
        "light": "#006E30",
        "dark": "#92D7A0"
      },
      "message": {
        "sgr": "1",
        "light": "#14110F",
        "dark": "#F9F6F5"
      },
      "gutter": {
        "sgr": "2",
        "light": "#78716F",
        "dark": "#857E7C"
      },
      "success": {
        "sgr": "32",
        "light": "#006E30",
        "dark": "#92D7A0"
      },
      "emphasis": {
        "sgr": "1",
        "light": "#14110F",
        "dark": "#F9F6F5"
      }
    },
    "scheme": {
      "light": {
        "background": "#FFFDFC",
        "foreground": "#14110F",
        "cursor": "#14110F",
        "selection": "#E3DEDD",
        "black": "#14110F",
        "red": "#B00921",
        "green": "#006E30",
        "yellow": "#7D5000",
        "blue": "#125CA1",
        "magenta": "#7C3990",
        "cyan": "#006770",
        "white": "#857E7C",
        "bright-black": "#68625F",
        "bright-red": "#8E1018",
        "bright-green": "#278445",
        "bright-yellow": "#A16800",
        "bright-blue": "#2176C9",
        "bright-magenta": "#A056B6",
        "bright-cyan": "#00808B",
        "bright-white": "#A9A3A1"
      },
      "dark": {
        "background": "#14110F",
        "foreground": "#F9F6F5",
        "cursor": "#F9F6F5",
        "selection": "#4F4947",
        "black": "#292422",
        "red": "#FE7373",
        "green": "#4FB169",
        "yellow": "#D29135",
        "blue": "#5DA2EC",
        "magenta": "#C786DC",
        "cyan": "#3CADB3",
        "white": "#CFC9C7",
        "bright-black": "#857E7C",
        "bright-red": "#FFA6A3",
        "bright-green": "#92D7A0",
        "bright-yellow": "#EEB976",
        "bright-blue": "#98C8FF",
        "bright-magenta": "#D8A4E9",
        "bright-cyan": "#78D6DB",
        "bright-white": "#F9F6F5"
      }
    }
  },
  "gradient": {
    "depth": {
      "angle": 180,
      "stops": [
        [
          "#F33F49",
          0
        ],
        [
          "#8E1018",
          1
        ]
      ],
      "css": "linear-gradient(180deg, #F33F49 0%, #8E1018 100%)"
    },
    "depth-on-dark": {
      "angle": 180,
      "stops": [
        [
          "#F33F49",
          0
        ],
        [
          "#B00921",
          1
        ]
      ],
      "css": "linear-gradient(180deg, #F33F49 0%, #B00921 100%)"
    },
    "strata": {
      "angle": 180,
      "stops": [
        [
          "#FE7373",
          0,
          0.2
        ],
        [
          "#F33F49",
          0.2,
          0.4
        ],
        [
          "#D4002D",
          0.4,
          0.6
        ],
        [
          "#B00921",
          0.6,
          0.8
        ],
        [
          "#8E1018",
          0.8,
          1
        ]
      ],
      "css": "linear-gradient(180deg, #FE7373 0 20%, #F33F49 20% 40%, #D4002D 40% 60%, #B00921 60% 80%, #8E1018 80% 100%)"
    },
    "ink": {
      "angle": 180,
      "stops": [
        [
          "#1F1B19",
          0
        ],
        [
          "#0C0908",
          1
        ]
      ],
      "css": "linear-gradient(180deg, #1F1B19 0%, #0C0908 100%)"
    }
  },
  "shadow": {
    "light": {
      "raised": "0 1px 2px rgb(20 17 15 / 0.06), 0 1px 1px rgb(20 17 15 / 0.04)",
      "overlay": "0 4px 12px rgb(20 17 15 / 0.10), 0 1px 3px rgb(20 17 15 / 0.08)"
    },
    "dark": {
      "raised": "0 0 0 1px #37312F",
      "overlay": "0 0 0 1px #4F4947, 0 6px 16px rgb(0 0 0 / 0.40)"
    }
  },
  "radius": {
    "none": "0",
    "small": "2px",
    "medium": "4px"
  },
  "border": {
    "hairline": "1px",
    "accent": "3px",
    "focus": "2px",
    "focus-offset": "2px",
    "top-rule": "3px"
  },
  "typography": {
    "family": {
      "sans": "Chivo, ui-sans-serif, system-ui, \"Segoe UI\", sans-serif",
      "mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "features": {
      "mono": "\"zero\" 1, \"liga\" 0, \"calt\" 0"
    },
    "ligatures": {
      "mono": "none"
    },
    "scale": {
      "display": {
        "family": "sans",
        "size": "4rem",
        "pixels": 64,
        "line-height": 1.05,
        "weight": 800,
        "tracking": "-0.02em"
      },
      "heading-1": {
        "family": "sans",
        "size": "2.75rem",
        "pixels": 44,
        "line-height": 1.1,
        "weight": 800,
        "tracking": "-0.015em"
      },
      "heading-2": {
        "family": "sans",
        "size": "2rem",
        "pixels": 32,
        "line-height": 1.2,
        "weight": 700,
        "tracking": "-0.01em"
      },
      "heading-3": {
        "family": "sans",
        "size": "1.5rem",
        "pixels": 24,
        "line-height": 1.3,
        "weight": 700,
        "tracking": "-0.005em"
      },
      "heading-4": {
        "family": "sans",
        "size": "1.25rem",
        "pixels": 20,
        "line-height": 1.35,
        "weight": 600,
        "tracking": "0"
      },
      "body": {
        "family": "sans",
        "size": "1.0625rem",
        "pixels": 17,
        "line-height": 1.6,
        "weight": 400,
        "tracking": "0"
      },
      "ui": {
        "family": "sans",
        "size": "0.9375rem",
        "pixels": 15,
        "line-height": 1.45,
        "weight": 500,
        "tracking": "0"
      },
      "small": {
        "family": "sans",
        "size": "0.8125rem",
        "pixels": 13,
        "line-height": 1.45,
        "weight": 400,
        "tracking": "0.005em"
      },
      "code": {
        "family": "mono",
        "size": "0.9375rem",
        "pixels": 15,
        "line-height": 1.6,
        "weight": 400,
        "tracking": "0"
      },
      "code-dense": {
        "family": "mono",
        "size": "0.875rem",
        "pixels": 14,
        "line-height": 1.5,
        "weight": 400,
        "tracking": "0"
      }
    },
    "measure": "72ch"
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "quick": "140ms",
      "standard": "200ms",
      "exit": "120ms",
      "layout": "260ms",
      "signature": "480ms"
    },
    "easing": {
      "exact": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "linear": "linear"
    }
  }
}
