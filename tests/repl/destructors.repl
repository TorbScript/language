shared type Probe with Close {
  name: String

  var fn close() {
    print "close {name}"
  }
}
var probe = Probe("first")
probe = Probe("second")
const probe = Probe("third")
if true {
  using scoped = Probe("scoped")
  print "inside"
}
const other = Probe("other")
print "the end of the input releases other, then third"
