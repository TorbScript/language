type Shape {
  case Circle(radius: Float)
  case Square(side: Float)

  fn area(): Float {
    match self {
      .Circle(radius) => 3.0 * radius * radius
      .Square(side) => side * side
    }
  }
}
const shapes = [
  Shape.Circle(1.0),
  Shape.Square(2.0),
]
for shape in shapes {
  print shape.area()
}
const total =
  shapes.map({ _.area() }).toList().length()
total
