name "torbscript/tests"
version "0.1.0"

// The test inputs of the repository, and a package of its own so that `torb check .` at the root does not sweep them
// in: without this file `tests/` would be the root package's test directory, and the deliberately broken sources of
// `lexer-cases/` and `parser-cases/` would be checked as modules of it.
//
// This package holds no files itself. `conformance/` and `language/` are workspaces of their own, each checked with
// `torb check tests/conformance tests/language`, and the two case directories are checked by nothing, because
// everything in them is wrong on purpose.
