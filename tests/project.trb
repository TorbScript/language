name = "torbscript/tests"
version = "0.1.0"

// The test inputs of the repository, and a package of its own so that `torb check .` at the root does not sweep them
// in: without this file every `.trb` below `tests/` would be a file of the root package, and the deliberately broken
// sources of `lexer-cases/` and `parser-cases/` would be checked as modules of it.
//
// `conformance/` and `language/` are workspaces of their own, each checked with `torb check tests/conformance
// tests/language`. The two case directories are files of this package that nothing checks, because nothing names
// `tests/` itself and everything in them is wrong on purpose: compiler/tests/error-cases.test.trb parses them and pins
// where every problem is reported.
