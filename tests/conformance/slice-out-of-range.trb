use Process from "std/process"

/**
 * A slice that reaches past the end of a list panics, and the message is the runtime's word for word: `List.slice` and
 * the bounds check of the C runtime may not disagree about it.
 *
 * The end is exclusive, so the index in the message is the end that was asked for and not the last item.
 */
fn upTo(numbers: List<Int>, limit: Int): List<Int> {
  numbers[0..limit]
}

const numbers = [10, 20, 30]

print upTo(numbers, 2)
print upTo(numbers, 9)

Process.exit 0
