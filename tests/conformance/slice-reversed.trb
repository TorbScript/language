use Process from "std/process"

/** A slice whose start is after its end panics with its own message: an empty slice is `a..a`, never `b..a`. */
fn between(numbers: List<Int>, from: Int, to: Int): List<Int> {
  numbers[from..to]
}

const numbers = [10, 20, 30]

print between(numbers, 1, 1)
print between(numbers, 2, 1)

Process.exit 0
