/**
 * The module `unsigned-constants.trb` imports. A `const` of a module has to be known at compile time, and a `UInt64`
 * above the largest `Int64` is: written as a literal in every base, made by `~` and `<<`, and whatever an operator
 * makes of one - as a module's constant, a field's default and a type's `static`.
 */

/** The first word of SHA-384's initial state. */
public const initial: UInt64 = 0xcbbb9d5dc1059ed8
public const largest: UInt64 = ~0
public const high: UInt64 = 1 << 63
public const prime: UInt64 = 18446744073709551557
public const mixed: UInt64 = initial ^ 0xff
public const words: List<UInt64> = [0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17]
public const isHigh = initial > high

/** A state that starts from a word above the largest `Int64`. */
public type Hasher {
  state: UInt64 = 0xcbbb9d5dc1059ed8
  mask: UInt64 = ~0

  static seed: UInt64 = 0xffffffffffffffc5
}
