/**
 * A literal type is read from text with the `tryFrom` the language gives it: the text is compared with every member as
 * it is written, and the member it equals is the answer - a value of the base type, because that is what a literal type
 * is at run time. A text that equals none is a `LiteralParseError` that names the text and every member, in the order
 * the type keeps them (sorted, because `"a" | "b"` and `"b" | "a"` are one type). An `Int` and a `Char` member are
 * compared as the text they are written as, and the `tryFrom` a base has from another type stays beside it.
 */

type Status = "online" | "offline" | "away"

type Level = 1 | 2 | 3

type Grade = 'a' | 'b'

print Status.tryFrom("away")
print Status.tryFrom("busy")
const status: Status = Status.tryFrom("gone") ?? "offline"
print status
match Status.tryFrom("idle") {
  Ok(found) => print found
  Fail(problem) => print problem
}
print Level.tryFrom("2")
print Level.tryFrom("7")
print Grade.tryFrom("b")
print Grade.tryFrom("c").isOk()
