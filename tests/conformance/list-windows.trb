/**
 * The index-free helpers of a list: `windows` and `chunks` answer lazy runs of lists of the same kind, and `splitAt`
 * cuts a list in two. All three are total (docs/design/PANICS.md 5.1): a size below one answers nothing, a list shorter
 * than a window has none, and an index outside answers `None`.
 */

const numbers = [1, 2, 3, 4, 5]
print numbers.windows(2).toList()
print numbers.windows(5).toList()
print numbers.windows(6).toList()
print numbers.windows(0).toList()
print numbers.chunks(2).toList()
print numbers.chunks(5).toList()
print numbers.chunks(9).toList()
print numbers.chunks(-1).toList()
print numbers.splitAt(2)
print numbers.splitAt(0)
print numbers.splitAt(5)
print numbers.splitAt(6)
print numbers.splitAt(-1)

const readings = [3, 5, 4, 8]
print readings.windows(2).filter({ pair => pair[1] > pair[0] }).count()
if const Some((head, rest)) = numbers.splitAt(1) {
  print "{head} {rest}"
}
const empty: List<Int> = []
print empty.windows(1).toList()
print empty.chunks(3).toList()
print empty.splitAt(0)
