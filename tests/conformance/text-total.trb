/**
 * **The total text vocabulary cuts a text without an offset, and none of it can panic** (docs/design/PANICS.md 4.4):
 * `withoutPrefix`, `withoutSuffix`, `splitOnce`, and `dropping`, `droppingLast`, `prefix` and `suffix` counted in
 * characters. A count past the text answers the empty or the whole text, as `skip` and `take` do, and a character of
 * two or four bytes is one character.
 */

const text = "Grüße 👋"

print text.dropping(characters: 3)
print text.droppingLast(characters: 2)
print text.prefix(characters: 3)
print text.suffix(characters: 1)
print text.suffix(characters: 100)
print text.dropping(characters: 100).isEmpty()
print text.prefix(characters: -1).isEmpty()
print text.dropping(characters: 0)
print(text.withoutPrefix("Gr") ?? "none")
print(text.withoutPrefix("x") ?? "none")
print(text.withoutSuffix(" 👋") ?? "none")
print(text.withoutSuffix("") ?? "none")
print "name: Ada".splitOnce(": ")
match "name: Ada".splitOnce(": ") {
  Some(parts) => print "{parts.before} is {parts.after}"
  None => print "no field"
}
print "abc".splitOnce("x")
print "a=b=c".splitOnce("=")
print text.substringBefore("ß")
print text.substringAfter("ü")
