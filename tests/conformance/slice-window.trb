/**
 * **A `var` path through `a[from..to]` is a window.** A `var fn` called on it, a `var` argument handed it and an
 * assignment to it all change that part of the original list: the part is taken out with `Slice.slice`, changed, and put
 * back with `MutableSlice.replace`, exactly as an element of `a[key]` is taken out and put back. It works on a
 * trait-typed `List`, on a concrete `ArrayList`, behind a field and behind an index, and a copy taken before the change
 * keeps what it had.
 */

type Shelf {
  var books: List<String> = []
}

fn zero(var target: List<Int>) {
  for index in 0..target.length() {
    target[index] = 0
  }
}

var samples = [5, 3, 9, 1, 7]
samples[1..4].sort { _ }
print samples

samples[2..].reverse()
print samples

const before = samples
samples[..2].reverse()
print before, samples

samples[0..2] = [8]
print samples

samples[1..1] = [4, 4]
print samples

samples[1..=2] = []
print samples

var numbers = ArrayList.from([6, 2, 8, 4])
numbers[0..3].sort { _ }
print numbers.toList()
print numbers[1..3].toList()
numbers[1..3] = ArrayList.from([0, 0, 0])
print numbers.toList()

var shelf = Shelf(["c", "a", "b", "d"])
shelf.books[0..3].sort { _ }
print shelf.books

var grid = [[3, 2, 1], [9, 8, 7]]
grid[1][0..2].reverse()
print grid

var readings = [1, 2, 3, 4, 5]
zero readings[1..3]
print readings
