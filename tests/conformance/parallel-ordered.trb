/**
 * `parallel()` answers what the sequential pipeline answers, in input order, whatever the number of workers: the input
 * is cut into chunks whose borders depend on its length alone, the chunks run on whichever worker takes them, and they
 * are read back in order. So a map, a filter, a count, a sum and a find agree with their sequential counterparts, a
 * `Float` sum is the same bits with one worker, two or all of them, and an empty input makes no chunk at all. The
 * program runs with four workers and again with one (`parallel-ordered.workers`), and prints the same bytes both times.
 */

/** Steps of the Collatz sequence from `start` down to 1: work whose cost differs from item to item. */
fn collatz(start: Int): Int {
  var steps = 0
  var value = start
  while value != 1 {
    value = if value.remainder(2) == 0 { value / 2 } else { 3 * value + 1 }
    steps = steps + 1
  }
  steps
}

const numbers = (1..=30000).toList()
const sequential = numbers.map({ collatz _ }).toList()

const mapped = numbers.parallel().map({ collatz _ }).toList().await()
print "map: {mapped.length()} items, the same as the sequential map: {mapped == sequential}"
print "the first ten: {mapped.take(10).toList()}"

const odd = numbers.parallel().filter({ _.remainder(2) == 1 }).toList().await()
print "filter: {odd.length()} odd numbers, in order: {odd == numbers.filter({ _.remainder(2) == 1 }).toList()}"

const long = numbers.parallel().filter({ collatz(_) > 150 }).count().await()
print "count: {long} numbers take more than 150 steps"

const total = numbers.parallel().map({ collatz _ }).sum().await()
print "sum: {total}, the same as the sequential sum: {total == sequential.sum()}"

const first = (numbers.parallel().find({ collatz(_) > 250 }).await()) ?? 0
print "find: {first} is the first number that takes more than 250 steps"

const halves = numbers.parallel().filterMap({ if _.remainder(1000) == 0 { Some(_ / 1000) } else { None } })
print "filterMap: {halves.toList().await()}"

const fractions = numbers.map({ 1.0 / Float.from(_) }).toList()
const alone = fractions.parallel(workers: 1).sum().await()
const paired = fractions.parallel(workers: 2).sum().await()
const everywhere = fractions.parallel().sum().await()
print "a Float sum is the same with one worker, two and all: {alone == paired && paired == everywhere}"

const chunked = numbers.parallel(chunk: 7).map({ _ * 2 }).toList().await()
print "seven chunks: {chunked == numbers.map({ _ * 2 }).toList()}"

const nothing: List<Int> = []
print "an empty input: {nothing.parallel().map({ _ + 1 }).toList().await()}"

const words = ["one", "two", "three", "four", "five"]
print "words: {words.parallel().map({ _.byteLength() }).toList().await()}"
