use Process from "std/process"

/**
 * `a[key]` past the end of a list, which panics - and the panic is the **language's own**, not a rule of a back end:
 * `a[key]` is the `at` of `ArrayList`, whose body says `index 3 is out of bounds for a length of 3`, so what an index
 * out of range does is decided once and is the same everywhere.
 *
 * The lines before it have to run, so that the file also shows that the panic happens where it is written.
 */

const numbers = [10, 20, 30]

print numbers[2]
print numbers[3]
print "not reached"

Process.exit 0
