/**
 * **An entry file without top-level code is a program that does nothing, and `fn main()` is an ordinary function.** The
 * top-level code of the entry file is what runs; a `const` of it and a function declared in it run nothing by being
 * there, and no name is special - `main` included. So this program builds, prints nothing and leaves with zero.
 */

const million = 1_000_000

fn main() {
  print "main is never called: {million}"
}
