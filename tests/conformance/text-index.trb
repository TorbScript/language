/**
 * **A text is sliced at a `TextIndex`, which only the text hands out** (docs/design/PANICS.md section 4): its searches,
 * `start()`, `end()`, `indexAfter`, `indexBefore` and `indexedChars()` answer positions, `indexAt(byteOffset:)` checks a
 * number from outside, and an inclusive range ends after the character its end begins.
 */

const text = "Grüße 👋"
match text.indexOf("ß") {
  Some(at) => print text[at..]
  None => print "no ß"
}
print text.indexOf("ß")
print text[text.start()..text.end()]
const ue = text.indexOf("ü") ?? text.start()
print text.charAt(ue)
print text.indexAfter(ue)
print text.indexBefore(text.end())
print text.indexAt(byteOffset: 3)
print text.indexAt(byteOffset: 4)
print text.byteOffset(of: ue)
print text[..=ue]
for (index, character) in text.indexedChars() {
  print "{index} {character}"
}
print text.part(ue..text.end())
