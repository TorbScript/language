/**
 * An integer literal is read in the type it is expected as: a `UInt64` takes every literal below two to the power of
 * 64, so a literal above the largest `Int64` is no `Int64` first. The FNV-1a offset basis and prime are the example of
 * `UInt64.addedWrapping`.
 */

fn fingerprint(values: List<UInt64>): UInt64 {
  var hash: UInt64 = 14695981039346656037
  for value in values {
    hash = (hash ^ value).multipliedWrapping(1099511628211)
  }
  hash
}

const largest: UInt64 = 18446744073709551615
const top: UInt64 = 0xFFFFFFFFFFFFFFFF
const half: UInt64 = 9223372036854775808
print largest
print(top == UInt64.maximum)
print half
print(largest - half)
print fingerprint([])
print fingerprint([97])
