/**
 * Closing the reading end of a `Channel` is how a producer learns that nobody wants its items any more: every `add`
 * after it - and the one that waits for a reader right then - fails with `ChannelClosed`, and what was buffered is
 * dropped. No program calls `close()`: the reader lets go of the end, and the release of the last reference runs it -
 * here at the end of the function that read. The items that never arrived are counted blocks, released by the channel,
 * so nothing leaks.
 */

/** A value the program builds, so that its storage is counted and not the immortal storage of a literal. */
fn repeated(part: String, times: Int): String {
  var total = ""
  for _ in 0..times {
    total = total + part
  }
  total
}

/** Writes until the channel says nobody reads, and tells how far it got. */
fn write(channel: Channel<String>): Task<String> {
  var output = channel.sink()
  var written = 0
  for index in 0..10 {
    match output.add(repeated("w", index + 1)).await() {
      Ok(_) => {
        written = written + 1
      }
      Fail(problem) => {
        return "stopped after {written}: {problem}"
      }
    }
  }
  "wrote all {written}"
}

/**
 * Reads `count` items and lets go of the reading end: the end of this function releases it, and that closes it. The
 * reading end of a channel cannot fail - its failure is `Never` - so every `next()` is an `Ok`.
 */
fn readThenLetGo(channel: Channel<String>, count: Int): Task<Void> {
  var reading = channel.source()
  for _ in 0..count {
    if const Ok(item) = reading.next().await() {
      print item
    }
  }
}

const unbuffered = Channel<String>()
const writer = write unbuffered
readThenLetGo(unbuffered, 2).await()
print writer.await()

const buffered = Channel<String>(capacity: 3)
const filler = write buffered
readThenLetGo(buffered, 1).await()
print filler.await()
