use sleep from "std/time"

/**
 * A task that is cancelled while it waits stops where it waits: it never sees an answer, and whoever waits for it reads
 * `Fail(Cancelled)`. Cancellation is structured - a task's parent is the task that started it, and cancelling the parent
 * cancels its children, so a child that has not run yet never runs a line. What the stopped tasks held is released on
 * the way out.
 */

/** A value the program builds, so that its storage is counted and not the immortal storage of a literal. */
fn repeated(part: String, times: Int): String {
  var total = ""
  for _ in 0..times {
    total = total + part
  }
  total
}

/** Waits a long time for a sleep, holding a counted word, and says so only if it ever gets past it. */
fn waiting(word: String): Task<String> {
  sleep(60.0).await() ?? void
  print "the waiter woke up"
  word
}

/** Starts a child that would print, and waits for it. */
fn parent(word: String): Task<String> {
  const child = spawn {
    print "the child ran"
    word
  }
  child.await() ?? "child cancelled"
}

/** Waits for a task and tells what it read. */
fn watching(watched: Task<String>): Task<String> {
  match watched.await() {
    Ok(value) => "watched {value}"
    Fail(problem) => "watched: {problem}"
  }
}

var sleeper = waiting repeated("ab", 2)
const watcher = watching sleeper
sleep(0.01).await() ?? void
sleeper.cancel()
print(watcher.await() ?? "the watcher was cancelled")
print "sleeper: {sleeper.await().isOk()}"

// The parent is cancelled before it ran, and with it the child it would have started
var cancelledParent = parent repeated("cd", 2)
cancelledParent.cancel()
print "parent: {cancelledParent.await().isOk()}"

// A parent that is cancelled while its child waits takes the child with it
fn sleepingParent(): Task<String> {
  const child = spawn {
    sleep(60.0).await() ?? void
    print "the sleeping child woke up"
    repeated "ef", 2
  }
  child.await() ?? "child cancelled"
}

var outer = sleepingParent()
sleep(0.01).await() ?? void
outer.cancel()
print "outer: {outer.await().isOk()}"
