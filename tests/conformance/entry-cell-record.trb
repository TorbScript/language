/**
 * **A top-level `const` of a record or a variant that a function reads.** The read of its entry cell hands out one more
 * count of every text inside, through the retain function of the layout (`R_<layout>`) - which the back end defines
 * although no instruction of the program retains a value of that type (docs/BACKEND.md, "The entry cell").
 */
type Label {
  name: String
  suffix: String
}

type Kind {
  case Named(name: String)
  case Numbered(number: Int)
}

var parts: List<String> = []
for index in 0..3 {
  parts.append "part-{index}"
}
const label = Label name: parts[0], suffix: parts[1]
const kind = Kind.Named parts[2]

/** Reads both constants from their cells. */
fn described(): String {
  const kindName = match kind {
    .Named(name) => name
    .Numbered(number) => "{number}"
  }
  "{label.name}.{label.suffix} {kindName}"
}

print described()
print described()
