use Process from "std/process"

/**
 * `String.repeat` with a count whose product with the length does not fit a text: it panics with the size limit of a
 * text, the same message a concatenation past 4 GiB gives.
 *
 * The count is chosen so that `3 * times` wraps around 2^64 to 2: a length that is computed and then checked would pass
 * as a two-byte text, and three bytes would be copied into it over and over. The line before it has to run, which shows
 * the panic happens at the call and not earlier.
 */

const times = 6148914691236517206
const text = "abc"
print text.repeat(2)
const result = text.repeat times
print result.byteLength()

Process.exit 0
