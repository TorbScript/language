/**
 * A rest with items behind it binds what lies between. `[first, ...middle, last]` names the first item, the last item
 * and everything in between as `middle` - not everything from the second item on, which would count `last` twice. The
 * same holds for a list in a `match` and for an `Array` in a binding.
 */
fn summarized(items: List<Int>): String {
  match items {
    [] => "nothing"
    [only] => "one: {only}"
    [first, ...middle, last] => "{first}..{last}, {middle} between"
    _ => "unreachable, but a list's exhaustiveness does not count from both ends"
  }
}

fn edges(items: List<String>): String {
  match items {
    [first, second, ...inner, last] => "{first} {second} | {inner} | {last}"
    _ => "short"
  }
}

print summarized([1, 2, 3, 4])
print summarized([1, 2])
print summarized([7])
print edges(["a", "b", "c", "d", "e"])
print edges(["a", "b", "c"])
print edges(["a"])
const corners: Array<Int, 5> = [1, 2, 3, 4, 5]
const [front, ...center, back] = corners
print "{front} {center} {back}"
