/**
 * `std/linear` compiled to a native binary: the vectors over `Float`, the deterministic scalar over `Fixed`, and the
 * matrices and the quaternion built out of both.
 *
 * Two things this pins down. The **layout** of a generic value: `Vector2<Float>`, `Vector2<Fixed>` and
 * `Matrix4<Fixed>` are one type declaration and four different records, and every number printed below came out of the
 * instance the back end built for that scalar. And the **fixed-point arithmetic**: every digit of a `Fixed` is integer
 * arithmetic, so the interpreter and the binary have to agree on all of them, down to the last part - which is exactly
 * the promise the type exists for.
 *
 * The arithmetic is written as the operators it is, which is a call of the same trait member: `generic-operators.trb`
 * is what pins the two to each other. The modules are imported by path, because the interpreter resolves no package
 * import.
 *
 * Nothing here calls a trigonometric function on a `Float`: those live in `std/number`'s implementation of `Real`, which
 * the interpreter does not load at all - so `Fixed` is what the angles are measured in, and it is the implementor whose
 * answers are the same everywhere anyway.
 */

use Fixed from "../../std/linear/src/fixed"
use Angle from "../../std/linear/src/angle"
use Vector2 from "../../std/linear/src/vector2"
use Vector3 from "../../std/linear/src/vector3"
use Vector4 from "../../std/linear/src/vector4"
use Matrix2 from "../../std/linear/src/matrix2"
use Matrix3 from "../../std/linear/src/matrix3"
use Matrix4 from "../../std/linear/src/matrix4"
use Quaternion from "../../std/linear/src/quaternion"

/** A deterministic scalar from a whole number. */
fn exact(value: Int): Fixed {
  Fixed.from value
}

/** A deterministic point of two whole numbers. */
fn flat(x: Int, y: Int): Vector2<Fixed> {
  Vector2 exact(x), exact(y)
}

/** A deterministic point of three whole numbers. */
fn deep(x: Int, y: Int, z: Int): Vector3<Fixed> {
  Vector3 exact(x), exact(y), exact(z)
}

// The float vector: arithmetic, the dot product and the square root, all of them exactly specified by IEEE-754
const step = Vector2 3.0, 4.0
print "{step} {step + step} {step - Vector2(1.0, 1.0)} {step * 2.0}"
print "{step.length()} {step.lengthSquared()} {step.normalized()} {-step}"
print "{step.dot(step)} {step.cross(step.perpendicular())} {step.absolute()}"
print "{step.min(Vector2(1.0, 9.0))} {step.max(Vector2(1.0, 9.0))}"
print "{step.interpolated(toward: Vector2(5.0, 6.0), by: 0.5)} {step.withLength(10.0)}"
print "{step.projectedOnto(Vector2(1.0, 0.0))} {step.distanceTo(Vector2(0.0, 0.0))}"

const spread = Vector3 1.0, 2.0, 2.0
print "{spread} {spread.length()} {spread.cross(Vector3(0.0, 1.0, 0.0))} {spread.normalized()}"
print "{spread.toVector2()} {spread.sum()} {spread.largestComponent()}"

const wide = Vector4 2.0, 4.0, 6.0, 2.0
print "{wide} {wide.projected()} {wide.toVector3()} {wide.lengthSquared()}"

// The deterministic scalar, digit for digit
print "{exact(3)} {exact(3).squareRoot()} {Fixed.pi} {Fixed.tau} {Fixed.step}"
print "{Fixed.tryFrom("0.1")} {Fixed.tryFrom("-2.25")} {Fixed.tryFrom("nonsense")}"
print "{exact(3) * Fixed.tryFrom("0.5").expect("half parses")} {exact(7) / exact(2)}"
print "{exact(-5).floor()} {exact(-5).absolute()} {Fixed.approximating(1.25)}"

const quarter = Angle.degrees exact(90)
print "{quarter.radians} {quarter.toDegrees()} {quarter.sine()} {quarter.cosine()}"
print "{Angle.degrees(exact(370)).normalized().toDegrees()} {quarter.halved().toDegrees()}"

const turned = flat(1, 0).rotated(by: quarter)
print "{turned} {flat(1, 1).angle().toDegrees()} {flat(1, 0).angleTo(flat(0, 1)).toDegrees()}"

// The matrices: a column is where a basis vector lands, and a composition is applied right to left
const scale = Matrix2.scaling by: flat(2, 3)
print "{scale} {scale.determinant()} {scale.applied(to: flat(1, 1))}"
print "{scale.transposed()} {(scale * scale).applied(to: flat(1, 1))} {scale.inverse()}"
print Matrix2.rotation(by: quarter).applied(to: flat(1, 0))

const move = Matrix3.affine Matrix2<Fixed>.identity, by: flat(3, 4)
print "{move.transformedPoint(flat(1, 1))} {move.transformedDirection(flat(1, 1))}"
print "{move.translationPart()} {move.linearPart()} {move.determinant()}"
print Matrix3.rotationAroundZ(by: quarter).applied(to: deep(1, 0, 0))
print Matrix3.rotationAroundX(by: quarter).applied(to: deep(0, 1, 0))
print Matrix3.scaling(by: deep(2, 4, 8)).inverse()

const shift = Matrix4.translation of: deep(1, 2, 3)
print "{shift.transformedPoint(deep(0, 0, 0))} {shift.transformedDirection(deep(1, 0, 0))}"
print "{(shift * shift).translationPart()} {shift.row(0)} {shift.inverseAffine()}"

// The quaternion: the same rotation as a matrix, out of four numbers
const spin = Quaternion.rotation around: deep(0, 0, 1), by: quarter
print "{spin} {spin.applied(to: deep(1, 0, 0))} {spin.lengthSquared()}"
print "{(spin * spin).applied(to: deep(1, 0, 0))} {spin.conjugate().applied(to: deep(0, 1, 0))}"
print spin.toMatrix3().applied(to: deep(1, 0, 0))
print Quaternion<Fixed>.identity.interpolated(toward: spin, by: Fixed.one)
