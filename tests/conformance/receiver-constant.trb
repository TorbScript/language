/**
 * A method is a constant that holds a receiver closure, and a constant written that way is called the same way:
 * `rectangle.perimeter()` applies the closure to `rectangle`, `Rectangle.perimeter(rectangle)` passes the receiver by
 * hand, and `Rectangle.perimeter` read as a value is the closure itself.
 */

type Rectangle {
  width: Int
  height: Int

  fn area(): Int {
    width * height
  }

  static perimeter: (self: Rectangle) => Int = { 2 * (width + height) }
}

const rectangle = Rectangle 3, 4
print rectangle.area()
print rectangle.perimeter()
print Rectangle.perimeter(rectangle)
const measure = Rectangle.perimeter
print measure(Rectangle(1, 1))
