/**
 * `to<List<Int>?>()` and `to<Result<List<Int>, Failure>>()` collect a stream of optional or fallible items into one
 * optional or fallible collection: all of them, or the first that is missing. The conversion is the `From` of `Option`
 * and of `Result` over an `Iterate` of their items, an implementation whose item type only its trait names - the
 * collection the caller asks for says the rest.
 */

const complete: List<Int?> = [Some(1), Some(2), Some(3)]
const gap: List<Int?> = [Some(1), None, Some(3)]
print complete.to<List<Int>?>()
print gap.to<List<Int>?>()

const parsed = ["1", "2", "4"].map { text => Int.tryFrom text }.to<Result<List<Int>, NumberParseError>>()
print parsed
const broken = ["1", "x"].map { text => Int.tryFrom text }.to<Result<List<Int>, NumberParseError>>()
print broken.isOk()
