use Process from "std/process"

/**
 * **`Equals`, `Hash` and `Show` of an `Array` follow its items, in order**: two arrays are equal when the items at the
 * same index are, equal arrays hash alike, and an array shows like a `List`. The length is part of the type, so two
 * arrays that compare at all have the same one. A text item shows quoted, as inside every collection.
 */

const first: Array<Int, 3> = [1, 2, 3]
const same: Array<Int, 3> = [1, 2, 3]
const other: Array<Int, 3> = [3, 2, 1]
print(first == same)
print(first == other)
print(first != other)
print(first.hash() == same.hash())

const words: Array<String, 2> = ["a", "b"]
const nested: Array<Array<Int, 2>, 2> = [[1, 2], [3, 4]]
const again: Array<Array<Int, 2>, 2> = [[1, 2], [3, 4]]
print words
print nested
print(nested == again)
print(nested.hash() == again.hash())

var code = 0
if first == same {
  code = code + 1
}
if nested == again {
  code = code + 2
}
Process.exit code
