/**
 * `**`: exact on every integer width, `pow` on a float, right-associative and tighter than `*`. What the parser decides
 * (`-x ** 2` is an error) is `compiler/tests/parser.test.trb`; this is what the result is.
 */

fn cube(value: Int): Int {
  value ** 3
}

fn powerOf<Base: Power<Int>>(base: Base, exponent: Int): Base {
  base ** exponent
}

// Precedence and associativity
print(2 ** 3 ** 2)
print((2 ** 3) ** 2)
print(2 * 3 ** 2)
print(10 - 2 ** 3)
print(-(2 ** 2))
print((-2) ** 2)
print((-2) ** 3)
print cube(-4)

// Every integer width, and the edges
const byte: Int8 = 2
print(byte ** 6)
const negativeByte: Int8 = -2
print(negativeByte ** 7)
const short: Int16 = 3
print(short ** 9)
const word: Int32 = 7
print(word ** 11)
print((-2) ** 63)
print(3 ** 39)
const unsignedByte: UInt8 = 3
print(unsignedByte ** 5)
const unsignedShort: UInt16 = 2
print(unsignedShort ** 15)
const unsignedWord: UInt32 = 65535
print(unsignedWord ** 2)
const unsignedLong: UInt64 = 2
print(unsignedLong ** 63)
print(0 ** 0)
print(0 ** 5)
print(1 ** 9223372036854775807)
print((-1) ** 9223372036854775807)
print((-1) ** 9223372036854775806)
print powerOf(5, 3)

// Floats, by a float and by an `Int`
print(2.0 ** 0.5)
print(2.0 ** 10)
print(10.0 ** -3)
print(2.0 ** -1.0)
print(4.0 ** 0.5 ** 2.0)
print((-2.0) ** 3)
print((-8.0) ** 3.0)
print((-1.0) ** 9007199254740993)
print((-1.0) ** 9007199254740994)
print(0.0 ** 0)
print(2.0 ** 1024)
print powerOf(1.5, 2)
