/**
 * `charAtByte` on a continuation byte panics as a slice there does - `the offset 3 is inside of a character of a text of
 * 7 bytes` - at the line of the program: the offset is a number the program computed, and the site is the call.
 */

const text = "Grüße"
var offset = 2
print text.charAtByte(offset)
offset = 3
print text.charAtByte(offset)
print "not reached"
