/**
 * **A const parameter read as a value is a value of its type.** `Size` of `<const Size: Int>` is an `Int` inside the
 * declaration, so it is interpolated through the `Show` of an `Int`, compared and added like one, and each instance
 * answers its own argument.
 */

type Grid<const Size: Int> {
  cells: Array<Int, Size>

  fn describe(): String {
    "a grid of {Size} cells, the last at {Size - 1}"
  }

  fn isSmall(): Bool {
    Size < 4
  }
}

const small: Grid<3> = Grid([1, 2, 3])
const large: Grid<5> = Grid([1, 2, 3, 4, 5])
print small.describe()
print large.describe(), large.isSmall()
