/**
 * **`Void` has a value, and printing it prints `void`.** A call of a function without a result type is an expression
 * like any other: its value is `void`, the one value of `Void`, and its `Show` text is the word the literal is written
 * with (`docs/language/values-and-types/void-and-never.md`, rule 6). So `print setUp()` runs `setUp` first and then
 * prints what it answered.
 */

fn setUp() {
  print "ready"
}

print setUp()
print void
const answered = setUp()
print answered
