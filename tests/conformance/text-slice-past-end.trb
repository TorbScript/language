use Process from "std/process"

/**
 * A text is sliced at a `TextIndex`, which only a text hands out - so the one that can be past the end is a position of
 * **another** text, and it panics with the byte count of the text it is used on, not its length in characters.
 */
fn upTo(text: String, limit: TextIndex): String {
  text[..limit]
}

const text = "grüß"
const other = "a longer text"

print text.byteLength()
print upTo(text, text.indexOf("ß") ?? text.end())
print upTo(text, other.indexAt(byteOffset: 9) ?? other.end())

Process.exit 0
