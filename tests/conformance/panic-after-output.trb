/**
 * **Everything a program printed before it panicked is written before the panic is.** A panic is a report about a
 * program that already ran, so the lines it ran come first: standard output is flushed before the two lines of the
 * panic go to standard error.
 *
 * What the runner here compares is the two streams apart; the order between them is asserted in
 * `tools/conformance.sh`, which runs this very program and compares both of them.
 */

type Fragile {
  safe: Int = 1
  risky: Int

  static fn computed(): Fragile {
    Fragile risky: refuse()
  }
}

fn refuse(): Int {
  panic "a factory that panics"
}

print "before"
print Fragile(risky: 2)
print "after a value that was passed in"
print Fragile.computed()
print "never reached"
