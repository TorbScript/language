name = "torbscript/conformance"
version = "0.1.0"

// The programs of the conformance suite: every `.trb` here is built into a native binary, run, and compared with its
// `.expected`, `.stderr`, `.exit` and leak count by `tools/conformance.sh`.
//
// It is a workspace of its own whose only member is the standard library, instead of a member of the repository's
// workspace: these files are inputs of a test, not part of the toolchain, so `torb check .` over the repository does
// not look at them - but they still need the whole standard library in their workspace, because that is where `Int`
// and the prelude that brings it come from.
workspace {
  members "../../std/*"
}

// The programs are next to this file, so that a program and its `.expected` stay together.
test {
  input = "."
}
