use Process from "std/process"

/**
 * The derived `encode` and `decode` of records and cases, through `Json`, compiled to a native binary: what is written
 * can always be read back, because both forms are the one constructor (docs/design/ENCODING.md, section 3).
 *
 * What it pins: a record is an object in declaration order, a case with fields is externally tagged and one without is
 * its name, a list is an array, a map with text keys is an object, `None` is `null`, and a nested record is an object
 * inside an object. A `private` field with a default is no parameter of the constructor from outside, so it is written
 * nowhere and comes back as its default. A field with a default may be missing on the way in; one without may not.
 *
 * The program leaves with the number of checks that failed.
 */

/** A point on the plane. */
type Point {
  x: Int
  y: Int
}

/** A shape: one case with a record inside, one with a number, one with nothing. */
type Shape {
  case Circle(center: Point, radius: Float64)
  case Square(side: Int)
  case Empty
}

/** A drawing with every kind of field: text, a list of cases, a map, an option and a private cache. */
type Drawing {
  name: String
  shapes: List<Shape> = []
  layers: Map<String, Int> = [:]
  note: String? = None
  visible: Bool = true
  private cache: String = "not written"
}

var failed = 0

/** Compares one text with what it should be, and counts a difference. */
fn expect(actual: String, wanted: String): Int {
  if actual == wanted {
    return 0
  }
  print "expected {wanted}"
  print "     got {actual}"
  1
}

const json = Json()
const drawing = Drawing(
  "sketch",
  [.Circle(Point(1, 2), 1.5), .Square(3), .Empty],
  ["background": 0, "ink": 1],
  note: Some("draft"),
)
const text = json.encode drawing
print text
const shapesText = r"""[{"Circle":{"center":{"x":1,"y":2},"radius":1.5}},{"Square":{"side":3}},"Empty"]"""
const restText = r""""layers":{"background":0,"ink":1},"note":"draft","visible":true}"""
failed = failed + expect(text, r"""{"name":"sketch","shapes":""" + shapesText + "," + restText)

const back = json.decode<Drawing>(text)
print back
failed = failed + expect("{back == Ok(drawing)}", "true")

// Every field with a default may be missing, and takes it
const sparse = json.decode<Drawing>(r"""{"name": "empty"}""")
print sparse
failed = failed + expect("{sparse == Ok(Drawing("empty"))}", "true")

// `null` for an option is `None`, and so is a missing one
const nothing = json.decode<Drawing>(r"""{"name": "n", "note": null}""")
failed = failed + expect("{nothing.map({ _.note })}", "Ok(None)")

// A case on its own, and a list of them
failed = failed + expect(json.encode(Shape.Square(4)), r"""{"Square":{"side":4}}""")
failed = failed + expect("{json.decode<List<Shape>>(r"""["Empty", {"Square": {"side": 2}}]""")}", "Ok([Empty, Square(side: 2)])")

// The private field is nowhere in the text, and a text that names it does not reach it
failed = failed + expect("{text.contains("cache")}", "false")

// Collections of collections
const nested: Map<String, List<Int?>> = ["a": [Some(1), None, Some(3)], "b": []]
const nestedText = json.encode nested
failed = failed + expect(nestedText, r"""{"a":[1,null,3],"b":[]}""")
failed = failed + expect("{json.decode<Map<String, List<Int?>>>(nestedText) == Ok(nested)}", "true")

// A map whose keys are numbers is an object with text keys, and reads back as numbers
const counts: Map<Int, String> = [1: "one", 2: "two"]
failed = failed + expect(json.encode(counts), r"""{"1":"one","2":"two"}""")
failed = failed + expect("{json.decode<Map<Int, String>>(json.encode(counts)) == Ok(counts)}", "true")

// A set comes back as a set, and a tuple is an array of its positions
failed = failed + expect("{json.decode<Set<Int>>("[3, 1, 3]")}", "Ok(\{3, 1})")
failed = failed + expect(json.encode((7, "seven")), r"""[7,"seven"]""")
failed = failed + expect("{json.decode<(Int, String)>(r"""[7, "seven"]""")}", "Ok((7, \"seven\"))")

// `rendered` is the same value without its type, as text
failed = failed + expect(rendered(Point(1, 2)), "Point(x: 1, y: 2)")

Process.exit failed
