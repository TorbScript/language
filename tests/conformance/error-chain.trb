use Error from "std/core"
use Process from "std/process"

/**
 * A top-level `?` whose error carries `Error`: the report walks `cause()` and writes one `  caused by:` line per link.
 *
 * It is not a panic, so the exit code is **1** and not 101. The error has to arrive as a trait-typed `Error` value for
 * the report to have a chain to walk at all - a concrete type is one line, which `top-level-error.trb` pins - and the
 * chain ends where a `cause()` answers `None`, which is the default of the trait.
 *
 * The first `?` succeeds, so the program writes a line before the report: what stands before a failure still runs.
 */
type FileError with Error {
  path: String

  fn show(): String {
    "{path}: no such file"
  }
}

type ConfigError with Error {
  inner: FileError

  fn show(): String {
    "the configuration could not be read"
  }

  fn cause(): Error? {
    inner
  }
}

type StartupError with Error {
  inner: ConfigError

  fn show(): String {
    "the server did not start"
  }

  fn cause(): Error? {
    inner
  }
}

fn started(name: String): Result<Int, Error> {
  if name == "http" {
    return 8080
  }
  Fail StartupError(ConfigError(FileError("app.trb")))
}

const first = started("http")?

print first

const second = started("gopher")?

print second

Process.exit 0
