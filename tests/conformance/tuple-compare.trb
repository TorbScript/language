/**
 * The generated `compare` of a **tuple**: lexicographic, field by field, each field through its own `Compare`.
 *
 * A tuple is the one shape the checker derives an order for - an order over a `type` is a decision and not a structure
 * (TYPECHECKER 4.4) - and it is what `sorted { (a, b) }` and `sort({ (_.length(), _) })` are built on, so the compiler's
 * own passes sort by one at three places. Before this the generated body refused everything but a number, a `String` and
 * a `Char`.
 *
 * What is under test is the lexicographic rule itself: the first field that is not equal decides, a tuple whose first
 * fields agree falls through to the next one, and two tuples that agree everywhere are equal. The widths are mixed on
 * purpose (an `Int`, a `String`, a `Char`, a `Float` and a tuple inside a tuple) because each field goes through a
 * *different* member.
 */
fn pairs() {
  const first = (1, "b")
  print(first < (2, "a"))
  print(first < (1, "c"))
  print(first < (1, "b"))
  print(first > (1, "a"))
  print(first > (0, "z"))
  print(first == (1, "b"))
  print(first <= (1, "b"))
  print(first >= (1, "b"))
}

/**
 * The `Ordering` itself, through the one door the checker opens for a tuple: `sorted`, which calls `compare`. A tuple
 * has no `compare` *member* - the checker gives it the operators and nothing else - so a program that calls
 * `pair.compare(other)` does not type check.
 */
fn ordering() {
  const rows = [(2, "a"), (1, "z"), (1, "b"), (2, "a")]
  print rows.sorted({ _ }).toList()
}

/**
 * A `Float64` field, which is the one field whose order the **runtime** owns: a total order with `nan` above everything
 * (decided gap 5) is no comparison intrinsic, so `Float64.compare` is a `.Runtime` entry - and its symbol answers a
 * **sign** as an `int32_t` where the declaration answers an `Ordering`. `NativeResult.Ordering` is the wrapper that turns
 * the sign into the three cases, and it is why a tuple with a float field can be emitted at all.
 *
 * A `nan` is **not** here: what the order of a `nan` is belongs to `torb_compare_f64` and is pinned in
 * `runtime/tests/number_test.c`; that the wrapper calls it, and does not compare with `<`, is pinned in
 * `compiler/tests/lower-natives.test.trb`.
 */
fn floats() {
  const first = (1.5, "m")
  print(first < (2.5, "a"))
  print(first < (1.5, "n"))
  print(first > (0.5, "z"))
  print(first == (1.5, "m"))
  print(first >= (1.5, "m"))
  // Computed, so that no folding of a literal can be behind the answer
  const half = 1.0 / 2.0
  print(first > (half, "z"))
  var rows = [(2.0, "a"), (0.5, "z"), (1.5, "b"), (0.5, "a")]
  rows.sort({ _ })
  print rows
}

fn triples() {
  const first = (1, 'a', "m")
  print(first < (1, 'a', "n"))
  print(first < (1, 'b', "a"))
  print(first > (1, 'a', "l"))
  print(first == (1, 'a', "m"))
}

fn nested() {
  const first = ((1, 2), "x")
  print(first < ((1, 3), "a"))
  print(first > ((1, 1), "z"))
  print(first < ((1, 2), "y"))
  print(first == ((1, 2), "x"))
}

fn sorting() {
  var words = ["pear", "fig", "apple", "kiwi"]
  words.sort({ (_.byteLength(), _) })
  print words
  var numbers = [3, 1, 2]
  numbers.sort({ (0 - _, _) })
  print numbers
}

fn single() {
  // A one-field tuple is the degenerate case, and it is exactly the field's own order
  print((1, 2) < (1, 3))
  print(("a", 1) < ("b", 0))
}

pairs()
ordering()
floats()
triples()
nested()
sorting()
single()
