/**
 * The hash of a container is the language's hash of its elements, whatever width the runtime stores them in: a list
 * of bytes, of negative numbers of sixteen bits, of `Char`s and `Bool`s, of records and tuples of numbers and of
 * texts, a set of bytes and a map over records. The numbers are printed, so a back end that hashed an element any other
 * way - by its bytes in storage instead of by the language's `hash` - would print other ones.
 */

/** A record of two numbers, whose hash is the derived one. */
type Point {
  x: Int
  y: Int
}

const bytes: List<UInt8> = [0, 1, 127, 128, 255]
const shorts: List<Int16> = [-32768, -1, 0, 32767]
const letters: List<Char> = ['a', 'ß', '€']
const flags: List<Bool> = [true, false]
const numbers: List<Int> = [-1, 0, 1]
const pairs: List<(Int, Int)> = [(1, 2), (3, 4)]
const points: List<Point> = [Point(1, 2), Point(-3, 4)]
const words: List<String> = ["one", "two"]
print "bytes {bytes.hash()}"
print "shorts {shorts.hash()}"
print "letters {letters.hash()}"
print "flags {flags.hash()}"
print "numbers {numbers.hash()}"
print "pairs {pairs.hash()}"
print "points {points.hash()}"
print "words {words.hash()}"
const byteSet: Set<UInt8> = [3, 200, 7]
const keyed: Map<Point, Int8> = [Point(1, 2): -1, Point(3, 4): 5]
print "a set {byteSet.hash()}, a map {keyed.hash()}"
print "one byte {bytes[4].hash()}, one short {shorts[0].hash()}, one letter {letters[2].hash()}"
