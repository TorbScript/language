use Process from "std/process"

/**
 * Top-level `const`s of every shape, read from a function and from the top-level code.
 *
 * What is **static data** is what has an immortal C spelling: a number, a `Bool`, a `Char`, a text and an inline
 * aggregate of those. Everything else a `const` may hold - a list, a map, a case of a counted variant type, a text built
 * out of pieces - is a counted heap block, and there is no C initializer for one. Such a `const` is therefore no
 * declaration of the back end at all: its initializer is lowered **where it is read**, the way a field default and a
 * parameter default are lowered at the call site (BACKEND 1.6), so there is still no module initialization anywhere.
 *
 * The answer is the **immortal counted static**: one block per constant, built once at the first read and never freed, so
 * a read is a load and a retain of it is a no-op. It is unobservable because a module constant is pure by the checker's
 * own rule, and it keeps the promise that there is no module initialization ever - nothing runs before `main`, and a
 * constant no path reads is never built. A write to a copy of one copies, which is what `torb_make_unique` does with an
 * immortal block, and the leak gate is what says every copy is counted right: `live blocks at exit: 0` plus a fixed
 * number of immortal ones.
 *
 * That is the `const` of a module that runs nothing. This file is an entry file, so each of its `const`s that is no
 * static data is evaluated once, by the top-level code, and a function reads it from its **entry cell**
 * (`ir/lower/cell.trb`): the same value with a count of its own, which a write to a copy of it copies just the same.
 */

/** A `Boxed` layout: five fields, so it is above the inline limit and its constant cannot be static data. */
type Entry {
  label: String
  first: Int
  second: Int
  third: Int
  fourth: Int
}

const folded = 2 * 21

const greeting = "hello " + "world"

const words: List<String> = ["one", "two", "three"]

const entry = Entry "tag", 1, 2, 3, 4

/** A `const` that names another `const`: the initializer of both is lowered here. */
const twice = greeting + "!"

/** A table of tuples, which is what `punctuationTable` of the lexer is: no field of it can be static data. */
const punctuation: List<(String, Int)> = [("(", 1), (")", 2), ("[", 5), ("]", 6)]

/** A list of another constant's values, so that one immortal cell is built inside the region of another. */
const labels: List<String> = [greeting, twice, entry.label]

fn readFromFunction(): Int {
  var total = greeting.byteLength()
  for word in words {
    total = total + word.byteLength()
  }
  total + entry.label.byteLength() + entry.fourth + folded
}

/** Read twice in one body: one value, and no build the second time. */
fn readTwice(): Int {
  words.length() + words.length()
}

/** Read in a loop, which is the read count that made a constant that is built once worth writing. */
fn readOften(): Int {
  var total = 0
  for _ in 0..100 {
    total = total + punctuation.length() + words.length()
  }
  total
}

/**
 * A **mutated copy** of a constant: the value is shared with its cell, so the write makes a copy of it and the constant
 * itself is untouched however often this runs.
 */
fn mutatedCopy(): Int {
  var mine = words
  mine.append "four"
  var again = words
  again.append "five"
  again.append "six"
  mine.length() * 10 + again.length() + words.length()
}

/** The table shape the lexer has: a list of tuples, looked up by its first component. */
fn lookedUp(text: String): Int {
  for (spelling, code) in punctuation {
    if spelling == text {
      return code
    }
  }
  0
}

print greeting
print twice
print words
print entry.label
print folded

print punctuation
print labels

const fromFunction = readFromFunction()
print fromFunction
print readTwice()
print readOften()
print mutatedCopy()
print lookedUp("]")
print lookedUp("?")
print words

Process.exit((fromFunction + readTwice() + mutatedCopy()) % 251)
