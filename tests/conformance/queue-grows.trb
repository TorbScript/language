/**
 * **An `ArrayQueue` holds no slots until the first `enqueue`,** and its ring grows past 16 items, wraps around, is
 * compacted down to nothing and cleared - and every one of those answers the same items in the same order.
 */

use ArrayQueue from "std/collections"

var queue: ArrayQueue<Int> = ArrayQueue()
print queue.dequeue()
print queue.peek()
print queue.length()
print queue.toList()

queue.compact()
print queue.dequeue()

for value in 0..20 {
  queue.enqueue value
}
print queue.length()
print queue.peek()

// Take some off the front and put more on the back, so the ring wraps around
for _ in 0..15 {
  const _ = queue.dequeue()
}
for value in 20..40 {
  queue.enqueue value
}
print queue.toList()

queue.compact()
print queue.toList()
print queue.dequeue()

queue.clear()
print queue.length()
print queue.dequeue()
queue.enqueue 7
print queue.toList()

var drained: ArrayQueue<String> = ["a", "b"]
print drained.dequeue()
print drained.dequeue()
print drained.dequeue()
drained.compact()
drained.enqueue "c"
print drained.toList()
const empty: ArrayQueue<Int> = []
print empty.peek()
