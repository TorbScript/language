/**
 * `String.repeat` with a negative count says what went wrong in the words of the call - `a text cannot be repeated -1
 * times` - at the line of the program, and not as an index out of bounds of a list that does not exist.
 */

var times = 2
print "ab".repeat(times)
times = -1
print "ab".repeat(times)
print "not reached"
