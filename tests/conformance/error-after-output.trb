/**
 * **Everything a program printed before a top-level `?` failed is written before the `error:` line.** Standard output is
 * buffered when it is a pipe or a file and standard error is not, so a line to standard error writes out what standard
 * output still holds first - the same rule a panic keeps (`panic-after-output.trb`). A reader of both streams in one
 * terminal sees the lines in the order the program ran them.
 *
 * The runner compares the two streams apart; the order between them is what `runtime/tests/console_test.c` asserts
 * against the runtime directly.
 */

fn parsed(text: String): Result<Int, String> {
  if text.isEmpty() {
    return Fail "there is no number in an empty text"
  }
  Ok text.byteLength()
}

print "before"
const first = parsed("12")?
print first
const second = parsed("")?
print second
