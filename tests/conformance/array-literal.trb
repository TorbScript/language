use Process from "std/process"

/**
 * **A list literal against an expected `Array` writes its items straight into the inline slots**, in written order, and
 * a `...` inside it spreads another `Array` slot by slot. That is what `CollectionLiteral.InlineArray` means: no list is
 * built and no iterator runs, and the checker already counted the items against `Size`.
 *
 * An `Array` of no items is a value too, and shows as `[]` like an empty `List`: the size is in the type, so the text
 * says nothing a reader cannot count.
 */

const corners: Array<Int, 4> = [1, 2, 3, 4]
const wider: Array<Int, 6> = [...corners, 5, 6]
const around: Array<Int, 6> = [0, ...corners, 9]
const empty: Array<Int, 0> = []
const words: Array<String, 2> = ["left", "right"]

print corners
print wider
print around
print empty
print words
print "{corners.length()} {wider.length()} {empty.length()}"

Process.exit(wider[5] + around[0])
