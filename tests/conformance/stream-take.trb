use Source from "std/stream"
use mapping, taking from "std/iteration"

/**
 * `take` ends a pipeline instead of reading to the end and throwing the rest away: the taking stage answers
 * `isDone()` once it has what it takes, and the driver asks after every item. So an endless source is read exactly as
 * far as it is taken, and a pipeline over a list stops pulling as soon as its taking stage is done. The answer of
 * `isDone()` is the taking stage's own, which a trait-typed accumulator reaches through its witness table.
 */

/** Why a stream failed. Nothing here fails, and a cancellation is no failure: `await()` passes it on instead. */
type Stopped {
  reason: String
}

/** Counts up forever, and says what it hands out. */
shared type Endless with Source<Int, Stopped> {
  var current: Int = 0

  var fn next(): Task<Result<Int?, Stopped>> {
    current = current + 1
    print "read {current}"
    Ok Some(current)
  }

  var fn close() {
    print "closed after {current}"
  }
}

fn firstTwo(): Task<Result<List<Int>, Stopped>> {
  var endless = Endless()
  var taken = endless.take 2
  taken.toList().await()
}

print firstTwo().await()

const numbers = [1, 2, 3, 4, 5, 6]
const pulled = numbers.through(mapping({ value: Int =>
  print "pulled {value}"
  value * 10
}).then(taking(3))).toList()
print pulled
