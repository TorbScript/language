use Process from "std/process"

/**
 * A top-level binding of an entry file that destructures what a task answered is code of the entry file like every
 * other top-level binding: `const (quotient, remainder) = divide(17, 5).await()?` waits where it stands and binds two
 * locals of the file's code, and a `var` pattern binds names that can be assigned. Neither is a constant of the module
 * the compiler would have to evaluate before the program runs, which it could not do for a value that is waited for.
 */

fn divide(dividend: Int, divisor: Int): Task<(Int, Int)> {
  (dividend / divisor, dividend % divisor)
}

const (quotient, remainder) = divide(17, 5).await()?
print "{quotient} remainder {remainder}"
var (low, high) = (1, 2)
low = low + quotient
print "{low} {high}"
Process.exit(remainder + low - high)
