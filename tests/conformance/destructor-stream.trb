use Source from "std/stream"

/**
 * A stream is taken down by its release. Every stage holds the stream it reads from in a field, so the release of the
 * last stage releases the one below it after its own `close()` - and the source at the top closes once the last thing
 * that reads from it is gone, whether the pipeline read it to the end or stopped early with `take`. No stage calls
 * `close()`, and nothing is left alive.
 */

/** Why a stream failed. Nothing here fails; a stream still needs a failure type that a cancellation converts into. */
type Stopped {
  reason: String
}

extend Stopped with From<Cancelled> {
  static fn from(value: Cancelled): Stopped {
    Stopped value.show()
  }
}

/** Counts from one to `last`, and says when it is closed. */
shared type Counting with Source<Int, Stopped> {
  name: String
  last: Int
  var current: Int = 0

  var fn next(): Task<Result<Int?, Stopped>> {
    if current >= last {
      return Ok None
    }
    current = current + 1
    Ok Some(current)
  }

  var fn close() {
    print "{name} closed"
  }
}

/** Reads the whole stream through two stages. */
fn toTheEnd(): Task<Result<List<Int>, Stopped>> {
  var counting = Counting "all", 4
  var doubled = counting.map({ _ * 2 })
  var large = doubled.filter({ _ > 2 })
  large.toList().outcome()
}

/** Takes two items: the source is closed where the last stage that reads it is released. */
fn stoppingEarly(): Task<Result<List<Int>, Stopped>> {
  var counting = Counting "early", 100
  var taken = counting.take 2
  taken.toList().outcome()
}

print toTheEnd().outcome()
print stoppingEarly().outcome()
