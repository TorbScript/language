/**
 * A task is started where it is made and waited for with `await()`, which answers the value of the task. A function that answers a `Task` has a body that produces the value, a `spawn` closure is a task
 * over what it captured, and a counted value crosses into a task and back out of it as a copy - the words built here
 * are counted blocks, so a count too many or too few is a leak or a crash and not a wrong number.
 */

/** A value the program builds, so that its storage is counted and not the immortal storage of a literal. */
fn repeated(part: String, times: Int): String {
  var total = ""
  for _ in 0..times {
    total = total + part
  }
  total
}

/** A task function: the body produces the `String`, and the caller gets the `Task`. */
fn shouted(word: String): Task<String> {
  "{word}!"
}

/** A task that waits for two others and adds what they answered. */
fn summed(first: Task<Int>, second: Task<Int>): Task<Int> {
  first.await() + second.await()
}

const word = repeated "ab", 3
const loud = shouted word
print loud.await()

const lengths = spawn { word.byteLength() * 2 }
const counted = spawn { [word, repeated("c", 2)] }
print lengths.await()
print counted.await()

const total = summed(spawn { 20 }, spawn { 22 })
print total.await()

// A task that is awaited twice answers twice, a copy each time
print "{loud.await()} {loud.await()}"
