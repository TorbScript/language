use Process from "std/process"

/**
 * `a[index] = value` outside of an `Array`, which panics with the message a `List` gives the same mistake:
 * `index -1 is out of bounds for a length of 3`. `Array.set` of `std/core` checks the index before it touches a slot,
 * so a negative index never reaches the storage.
 */

fn put(var values: Array<Int, 3>, index: Int) {
  values[index] = 9
}

var values: Array<Int, 3> = [1, 2, 3]
put values, 1
print values
put(values, -1)
print values

Process.exit 0
