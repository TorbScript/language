/**
 * **Every partial operation has a total twin** (CONCEPT.md, "Error Handling"; docs/design/PANICS.md 5.1): the checked
 * arithmetic of every integer type answers `None` exactly where `+`, `-`, `*`, `/` and `%` panic, and `part` answers
 * `None` exactly where `list[from..to]` and `text[from..to]` do - an end outside, a start after the end, an offset
 * inside of a character.
 */

const small: Int8 = 100
print small.addedChecked(27)
print small.addedChecked(28)
const low: Int8 = -100
print low.subtractedChecked(28)
print low.subtractedChecked(29)
print low.addedChecked(-29)
const unsigned: UInt8 = 250
print unsigned.addedChecked(5)
print unsigned.addedChecked(6)
print unsigned.subtractedChecked(250)
print unsigned.subtractedChecked(251)
print Int.maximum.addedChecked(1)
print Int.minimum.subtractedChecked(1)
print Int.maximum.multipliedChecked(2)
print Int.minimum.multipliedChecked(-1)
print 3037000499.multipliedChecked(3037000499)
print 3037000500.multipliedChecked(3037000500)
print((-5).multipliedChecked(-7))
print 5.multipliedChecked(-7)
print 7.dividedChecked(2)
print 7.dividedChecked(0)
print Int.minimum.dividedChecked(-1)
print((-7).remainderChecked(2))
print 7.remainderChecked(0)
print Int.minimum.remainderChecked(-1)
const big: UInt64 = UInt64.maximum
print big.multipliedChecked(2)
print big.dividedChecked(1)
const numbers = [1, 2, 3]
print numbers.part(1..3)
print numbers.part(2..5)
print numbers.part(2..1)
print numbers.part(1..)
print numbers.part(0..=2)
print numbers.part(0..=3)
print "Grüße".part(0..3)
print "Grüße".part(0..4)
print "Grüße".part(4..)
print "Grüße".part(4..99)
