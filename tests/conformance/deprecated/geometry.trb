/**
 * The declarations `deprecated.trb` uses: a field that became a method of its own name, a method and a constant that
 * were renamed, a function of the module, a case and a type, each marked `deprecated` beside what replaces it.
 */

/** A point of the plane, stored in polar form. */
public type Point {
  /** The horizontal position, as it was stored. */
  deprecated("the position is computed from the polar form now", replacement: "x()", since: "0.4")
  x: Int = 0
  /** The distance from the origin. */
  radius: Int

  /** The horizontal position, computed. */
  fn x(): Int {
    radius * 2
  }

  /** The distance from the origin, under its old name. */
  deprecated("it says what it is under its new name", replacement: "length")
  fn size(): Int {
    radius
  }

  /** The distance from the origin. */
  fn length(): Int {
    radius
  }

  /** The point at the origin, under its old name. */
  deprecated("the origin is `Point.origin`", replacement: "origin", since: "0.3")
  static zero = Point radius: 0

  /** The point at the origin. */
  static origin = Point radius: 0
}

/** How a point is drawn. */
public type Marker {
  /** A dot, under its old name. */
  deprecated("a dot is a `Dot` now", replacement: "Dot", since: "0.2")
  case Spot
  case Dot
  case Cross(size: Int)
}

/** Reads a point from the length of a text, under its old name. */
deprecated("the name says too little", replacement: "parsePoint", since: "0.4")
public fn parse(text: String): Point {
  parsePoint text
}

/** Reads a point from the length of a text. */
public fn parsePoint(text: String): Point {
  Point radius: text.byteLength()
}

/** A pair of numbers, before `Point` existed. */
deprecated("a `Point` says what the numbers mean", since: "0.1")
public type Pair {
  first: Int
  second: Int
}
