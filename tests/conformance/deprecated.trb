use Point, Marker, Pair, parse from "./deprecated/geometry"

/**
 * A deprecated declaration still works: every use of one below is a warning of `torb check` and `torb build`, and none
 * of them changes what the program does. `geometry.trb` keeps each one beside the declaration that replaces it.
 *
 * `point.x` reads the deprecated field and `point.x()` calls the method of the same name that replaces it - the one pair
 * of members that may share a name. A pattern that names the deprecated case `Spot` is no use of it, because a `match`
 * has to cover it for as long as it exists.
 */
const point = parse "abc"
print point.x
print point.x()
print point.size()
print point.length()
print Point.zero.radius
const moved = point.copy x: 5
print moved.x
const markers = [Marker.Spot, .Dot, .Cross(3)]
for marker in markers {
  const name = match marker {
    .Spot => "spot"
    .Dot => "dot"
    .Cross(size) => "cross of {size}"
  }
  print name
}
const pair = Pair 1, 2
print(pair.first + pair.second)
