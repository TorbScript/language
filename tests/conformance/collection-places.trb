use Process from "std/process"

/**
 * A `var` path through `a[key]` (milestone 5.7): an assignment, a field of an element, a method on an element, a `var`
 * argument, and the nested case - plus the copy on write that makes every one of them a change of one value and not of
 * two.
 *
 * Every line here is also a test of the take-out and the put-back the lowering writes around such an access: the element
 * leaves its container into a slot of the frame and goes back into it afterwards, so a missing `Release`, a missing
 * `MakeUnique` or a put-back in the wrong order shows up as a wrong number, as a wrong list or as a live block at exit.
 *
 * The **read** half is here too, because reading and writing through a bracket share the path: `at` is what takes the
 * element out.
 */

type Point with Show {
  var x: Int
  var y: Int

  /** A `var self` member of an element, reached through the path: `points[1].shift(7)`. */
  var fn shift(byX: Int) {
    x = x + byX
  }
}

/** A counted element: the name is a `String`, so every copy of one is a retain and every put-back a release. */
type Counter with Show {
  var name: String
  var hits: Int

  var fn increment() {
    hits = hits + 1
  }
}

/** `a[key]` as a value: on a list, on a list of counted elements, and twice on a nested one. */
fn reads() {
  const numbers = [10, 20, 30]
  print numbers[0]
  print numbers[2]
  const words = ["a", "bb", "ccc"]
  print words[1]
  const grid = [[1, 2], [3, 4]]
  print grid[1][0]
  print grid[0]
  const points = [Point(1, 2), Point(3, 4)]
  print points[1].y
}

/** The write half: an element, a field of an element, a method on an element, and a method twice. */
fn writes() {
  var numbers = [1, 2, 3]
  numbers[0] = 5
  numbers[2] = numbers[0] + 1
  print numbers
  var points = [Point(1, 2), Point(3, 4)]
  points[0].x = 100
  points[1].shift(7)
  print points
  var counters = [Counter("a", 0), Counter("bb", 0)]
  counters[1].increment()
  counters[1].increment()
  counters[0].name = "ccc"
  print counters
}

/** A `var` parameter whose argument is an element, and one whose argument is a field of an element. */
fn bumped(var value: Int) {
  value = value + 1
}

fn renamed(var value: String) {
  value = value + "!"
}

fn arguments() {
  var numbers = [1, 2, 3]
  bumped numbers[1]
  print numbers
  var points = [Point(1, 2)]
  bumped points[0].y
  print points
  var counters = [Counter("a", 0)]
  renamed counters[0].name
  print counters
}

/**
 * The copy-on-write proof, which is the whole point of putting the element back: the copy taken before the write keeps
 * what it had, and the list that was written has the new value.
 */
fn kept() {
  var numbers = [1, 2, 3]
  const before = numbers
  numbers[0] = 9
  print before
  print numbers
  var counters = [Counter("a", 0), Counter("bb", 1)]
  const untouched = counters
  counters[0].increment()
  print untouched
  print counters
}

/** `grid[y][x] = v`: the row is taken out and put back around the write of the element. */
fn nested() {
  var grid = [[1, 2], [3, 4]]
  const before = grid
  grid[1][0] = 9
  grid[0][1] = grid[1][0] + 1
  print before
  print grid
  var rows = [["a"], ["b", "c"]]
  rows[1][0] = "z"
  print rows
}

/** `swapAt` and `update` of `std/collections`: two default members that are written with index paths themselves. */
fn members() {
  var numbers = [1, 2, 3]
  numbers.swapAt 0, 2
  print numbers
  print numbers.updated(1, 8)
  print numbers
  var words = ["a", "bb"]
  words.swapAt 0, 1
  print words
}

/**
 * `sort` is a **default of `List`** and written in TorbScript over `a[key]`, which is why it belongs in this program: a
 * bottom-up merge sort that reads and writes through the same index paths as everything above.
 *
 * What is checked is what a sort has to promise: the order, **stability** (two values with the same key keep theirs), and
 * that nothing is lost - empty, one value, already sorted, reversed, and all keys equal.
 */
fn sorts() {
  var numbers = [5, 1, 4, 2, 3]
  numbers.sort({ _ })
  print numbers
  var empty: List<Int> = []
  empty.sort({ _ })
  print empty
  var single = [7]
  single.sort({ _ })
  print single
  var sorted = [1, 2, 3, 4]
  sorted.sort({ _ })
  print sorted
  var backwards = [4, 3, 2, 1]
  backwards.sort({ _ })
  print backwards
  var words = ["ccc", "a", "bb", "dd", "e"]
  words.sort({ _.byteLength() })
  print words
  var points = [Point(3, 1), Point(1, 2), Point(2, 3)]
  points.sort({ _.x })
  print points
  // Every key the same: a stable sort leaves the list exactly as it was
  var same = ["first", "second", "third"]
  same.sort({ _ => 0 })
  print same
  // Long enough for the merge to run over several widths, and with duplicates
  var many: List<Int> = []
  for index in 0..21 {
    many.append((index * 7) % 10)
  }
  many.sort({ _ })
  print many
  print many.length()
  print sortedCopy([3, 1, 2])
}

/** The participle over the pipeline: `sorted` buffers into a list and sorts that, so it goes through the same body. */
fn sortedCopy(values: List<Int>): List<Int> {
  values.sorted({ _ }).toList()
}

/**
 * `a[from..to]` as a **value**: a list of the same kind holding that part.
 *
 * A trait-typed `List<Item>` reaches the default of `std/collections` (a member whose result is `Self` is in no witness
 * table), which copies the part; a concrete `ArrayList` reaches `torb_list_slice`, which shares the storage. Nothing
 * observable differs between the two, which is what this proves: the parts are equal and the original is untouched.
 */
fn slices() {
  const numbers = [1, 2, 3, 4, 5]
  print numbers[1..3]
  print numbers[1..=3]
  print numbers[..2]
  print numbers[3..]
  print numbers[0..5]
  print numbers[2..2]
  print numbers
  const words = ["a", "bb", "ccc", "dddd"]
  print words[1..3]
  print words
  var changed = [1, 2, 3]
  const part = changed[0..2]
  changed[0] = 9
  print part
  print changed
  const grid = [[1, 2], [3, 4], [5, 6]]
  print grid[1..3]
}

fn exitCode(): Int {
  const numbers = [1, 2, 3]
  numbers[0] + numbers[2]
}

reads()
writes()
arguments()
kept()
nested()
members()
sorts()
slices()

Process.exit exitCode()
