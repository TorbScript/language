/**
 * `**` on a type of the program, which writes down how it was grouped: `**` binds tighter than `*` and than a prefix
 * `-` in front of it, groups to the right, and takes an exponent that starts with a `-`.
 */
type Term with Power<Term, Term>, Multiply<Term, Term>, Negate {
  text: String

  fn power(exponent: Term): Term {
    Term "({text} ** {exponent.text})"
  }

  fn multiply(other: Term): Term {
    Term "({text} * {other.text})"
  }

  fn negate(): Term {
    Term "-{text}"
  }
}

const a = Term "a"
const b = Term "b"
const c = Term "c"
print((a ** b ** c).text)
print((a * b ** c).text)
print((a ** b * c).text)
print((a ** -b).text)
print((-(a ** b)).text)
print(((-a) ** b).text)
print a.power(b).text
