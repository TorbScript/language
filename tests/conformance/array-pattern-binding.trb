/**
 * A list pattern of an `Array<Item, Size>` binds like a tuple pattern. The length of an array is in its type, so a
 * pattern of exactly `Size` items - or a rest with at most `Size` items around it - matches every value of that type:
 * it stands after `const`, `var` and `for` without a `match`, and a `match` of such patterns needs no `_` arm
 * (docs/language/pattern-matching/patterns-in-bindings.md, rule 3). A `var` pattern binds copies the program changes on
 * its own, and the array it came from stays as it was.
 */
fn rotated(state: Array<Int, 4>): Array<Int, 4> {
  var [a, b, c, d] = state
  const carried = a
  a = b
  b = c
  c = d
  d = carried
  [a, b, c, d]
}

fn described(pair: Array<String, 2>): String {
  match pair {
    ["", _] => "no first"
    [first, second] => "{first} and {second}"
  }
}

const state: Array<Int, 4> = [1, 2, 3, 4]
print rotated(state)
print state
const [first, ...rest] = state
print "{first} then {rest}"
const [head, ...middle, last] = state
print "{head}, {middle}, {last}"
const pairs: List<Array<String, 2>> = [["ada", "alan"], ["", "grace"]]
for [left, right] in pairs {
  print "{left}|{right}"
}
for pair in pairs {
  print described(pair)
}
