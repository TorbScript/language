/**
 * **A list literal where a trait the list implements is expected is the default list, seen as that trait.**
 * `numbers.appendedAll([4, 5])` hands an `Iterate<Int>`, and `[[1, 2], [3]]` bound to an `Iterate<List<UInt8>>` is a
 * list of lists: the literal is built as it always is, item by item in written order, and boxed as the trait the
 * parameter or the binding names.
 */

use Process from "std/process"

fn total(values: Iterate<Int>): Int {
  var sum = 0
  for value in values {
    sum = sum + value
  }
  sum
}

const numbers = [1, 2, 3]
print numbers.appendedAll([4, 5])
const summed = total([10, 20, 30])
print summed
const nested: Iterate<List<UInt8>> = [[1, 2], [3]]
print nested.toList()

Process.exit(summed - 60)
