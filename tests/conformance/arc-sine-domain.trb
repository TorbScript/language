/**
 * `Float64.arcSine` and `arcCosine` agree with `Fixed`'s (docs/design/LINEAR.md, "Numeric policy"): inside `[-1, 1]`
 * they answer the angle, `nan` answers `nan`, `clamp` is the total form, and a value outside panics.
 */

print 0.5.arcSine().isCloseTo(0.5235987755982989)
print(1.0.arcSine() == Float64.pi / 2.0)
print((-1.0).arcSine() == -(Float64.pi / 2.0))
print(1.0.arcCosine() == 0.0)
print((-1.0).arcCosine() == Float64.pi)
print 0.5.arcCosine().isCloseTo(1.0471975511965979)
print Float64.nan.arcSine().isNaN()
print(1.0000000002.clamp(-1.0, 1.0).arcSine() == Float64.pi / 2.0)
print 1.5.arcSine()
print "never printed"
