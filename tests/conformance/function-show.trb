/**
 * `Show` of a function value is the source form of its type: the parameter types, `=>`, the result - no parameter
 * names, nothing the closure captured. Directly, interpolated, and as a field of a generated `Show`.
 */

type Handler {
  name: String
  run: (Int) => Int
}

const increment = { value: Int => value + 1 }
print increment
print "{increment}"
print Handler("inc", increment)
const pair: (String, Bool) => Void = { _, _ => }
print pair
const nothing: () => String = { "x" }
print nothing
