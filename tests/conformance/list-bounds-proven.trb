/**
 * **A read of a list whose index a loop proves inside it has no check** (docs/design/PANICS.md, recommendation 6):
 * `for index in 0..list.length()` over a list the body does not change reads every item through one unchecked `Element`
 * step (`ir/bounds.trb`), for counted items as for numbers. A list the loop changes, and an index that comes from
 * elsewhere, keep the check - the last read here is one, and it still panics with the index and the length.
 */

fn total(values: List<Int>): Int {
  var sum = 0
  for index in 0..values.length() {
    sum = sum + values[index]
  }
  sum
}

fn joinedLengths(names: List<String>): Int {
  var count = 0
  for index in 0..names.length() {
    count = count + names[index].byteLength()
  }
  count
}

fn grown(values: List<Int>): List<Int> {
  var copy = values
  for index in 0..copy.length() {
    copy.append(copy[index] * 2)
  }
  copy
}

fn pick(values: List<Int>, index: Int): Int {
  values[index]
}

print total([1, 2, 3, 4])
print joinedLengths(["Ada", "Grace", "Alan"])
print grown([1, 2])
print pick([1, 2, 3], 2)
print pick([1, 2, 3], 3)
