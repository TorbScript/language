/**
 * **A literal type is its base at run time**, so the members it comes with are the base's: `"tcp" | "udp"` is shown,
 * compared and hashed exactly as the `String` it is, and a field of one shows inside its type's generated `Show` like
 * any other text.
 *
 * Nothing about a literal type is generated for the literal type itself except the conversion from text, which is
 * what `tryFrom` on one answers with a `LiteralParseError` instead of the base's own error.
 */

use Process from "std/process"

type Protocol {
  kind: "tcp" | "udp" = "tcp"
  port: Int = 0
}

type Level {
  severity: 1 | 2 | 3 = 1
}

const one = Protocol()
const other = Protocol "udp", 9

print one
print other
print other.kind
print(one == Protocol())
print(one == other)
print Level()
print Level(3)

const chosen: "tcp" | "udp" = "udp"
print chosen
const both: List<Protocol> = [one, other]
print both
Process.exit(other.port - 9)
