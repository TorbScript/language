/**
 * Containers of numbers narrower than a word, of `Bool`s and of `Char`s: the runtime stores each element in its own
 * width - a byte for an `Int8`, four for a `Char` - and every way a program reads and writes one gives back the value
 * it put in, the negative ones included. Indexing, writing an element, handing one to a `var` parameter, iterating,
 * removing, searching, comparing, slicing, keys of a map and items of a set, a task's value and a channel's items.
 */

use sleep from "std/time"

/** Doubles a number in place: a `var` parameter that is an element of a list. */
fn double(var value: Int8) {
  value = value * 2
}

/** Answers a narrow value through a task, which keeps it in its own width until it is read. */
fn later(value: Int16): Task<Int16> {
  sleep(0.0).await()
  value - 1000
}

/** Sends two negative bytes through a channel and answers what came out of it. */
fn relayed(): Task<List<Int8>> {
  const signs = Channel<Int8>(capacity: 2)
  var sink = signs.sink()
  const _ = sink.add(-7).await()
  const _ = sink.add(-8).await()
  const _ = sink.end().await()
  var source = signs.source()
  var received: List<Int8> = []
  while const Ok(Some(value)) = source.next().await() {
    received.append value
  }
  received
}

var small: List<Int8> = [-128, -1, 0, 1, 127]
print "Int8: {small}"
small[1] = -100
double small[3]
print "written: {small[1]} {small[3]} {small}"
var total = 0
for value in small {
  total = total + Int.from(value)
}
print "sum {total}, contains -128: {small.contains(-128)}, index of 2: {small.indexOf(2)}"
print "removed {small.removeAt(0)}, left {small}, last {small.last()}"
print "sorted {small.sorted({ _ })}"
print "slice {small[1..3].toList()}, equal to itself: {small == [-100, 0, 2, 127]}"

const halves: List<Int16> = [-32768, -2, 32767]
const middles: List<UInt16> = [0, 65535, 4660]
const quads: List<Int32> = [-2147483648, -5, 2147483647]
const unsigned: List<UInt32> = [0, 4294967295, 305419896]
const bytes: List<UInt8> = [0, 200, 255]
print "Int16 {halves} UInt16 {middles}"
print "Int32 {quads} UInt32 {unsigned} UInt8 {bytes}"

var flags: List<Bool> = [true, false, true]
flags[1] = true
print "Bool {flags}, all: {flags.all({ _ })}"

var letters: List<Char> = ['a', 'ß', '€', '😀']
letters.append 'z'
print "Char {letters}, {String.from(letters)}"

var counts: Map<UInt8, Int> = [:]
for byte in [3, 250, 3, 7, 250, 3] {
  const key: UInt8 = UInt8.tryFrom(byte).ok() ?? 0
  counts.set(key, (counts.get(key) ?? 0) + 1)
}
print "counts {counts}"

var seen: Set<Char> = []
for letter in "abracadabra".chars() {
  seen.insert letter
}
print "letters {seen}"

const negative = later(-30000).await()
print "a task's Int16: {negative}"

print "received {relayed().await()}"
