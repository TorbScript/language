/**
 * An interpolated part or an argument of `print` of the type `Never`: an item of a `List<Never>`. No value of `Never`
 * exists, so the part is never shown - and the program still builds, although `Never` has no `show` to call.
 */

const nothing: List<Never> = []
for item in nothing {
  print "never {item}"
  print item
}
var text = "shown:"
for item in nothing {
  text = "{text} {item}"
}
print text
