/**
 * The type of `protected-field.trb`, in a file of its own so that the program reads it from outside: a `protected var`
 * field, the `var fn` and the function of this file that write it, and a field named `protected`.
 */
public type Server {
  host: String
  protected var connections: Int = 0
  /** A field named after the word, which is a modifier only in front of `var` */
  protected: Bool = true

  var fn accept() {
    connections = connections + 1
  }
}

/** A function of the file that declares `Server`, so it may write the `protected var` field. */
public fn reset(var server: Server) {
  server.connections = 0
}
