/**
 * **A list literal whose target is not a `List` is built through the target's `from`:** the default list is made and
 * handed over as an `Iterate`. `[]` where a `Set` is expected is how a field of one starts, because a field default is a
 * constant - and a type of one's own with `From<Iterate<Item>>` takes a literal the same way.
 */

use ArrayQueue from "std/collections"

type Total with From<Iterate<Int>> {
  sum: Int

  static fn from(items: Iterate<Int>): Total {
    var sum = 0
    for item in items {
      sum = sum + item
    }
    Total sum
  }
}

type Index {
  var seen: Set<String> = []
  var numbers: Set<Int> = [3, 1, 3, 2]
  var positions: Map<String, Int> = [:]
}

fn totals(): Total {
  [1, 2, 3]
}

var index = Index()
index.seen.insert "Ada"
index.seen.insert "Ada"
index.positions.set "Ada", 1
print index
print Index()
print totals()

const empty: Set<Int> = []
print empty.isEmpty()
const waiting: ArrayQueue<String> = ["a", "b"]
print waiting.toList()
