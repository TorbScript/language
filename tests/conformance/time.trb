use Clock, sleep from "std/time"

/**
 * `Duration` and `Instant` are values: a count of nanoseconds, compared and subtracted as numbers. A duration is written
 * with `seconds()`/`milliseconds()` on an integer, shows as its seconds with an `s` behind them, and is signed, so the
 * difference taken the wrong way round is negative. An `Instant` is only meaningful next to another one: the program
 * prints what the clock promises - it never goes backwards, and a sleep of 20 milliseconds lasts at least that long -
 * and never a reading itself.
 */

const wait = 2.seconds()
print wait
print wait.seconds()
print wait.nanoseconds()
print 250.milliseconds()
print(wait + 500.milliseconds())
print(wait - 500.milliseconds())
print(0.seconds() - wait)
print(1.seconds() == 1000.milliseconds())
print(1.seconds() < wait)
print wait.compare(wait)
const spans = [3.seconds(), 1.seconds()]
print spans

const start = Clock.now()
sleep(0.02).await() ?? void
const end = Clock.now()
print(end - start >= 20.milliseconds())
print(start <= end)
const deadline = start + 1.seconds()
print(deadline - start)
print(deadline > start)
