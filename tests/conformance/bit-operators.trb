/**
 * `&`, `|`, `^`, `~`, `<<` and `>>`: the members of `Bits`, with the precedence of Go and Swift. A shift of a signed type
 * is arithmetic and one of an unsigned type logical, and the bits that leave the width are dropped.
 */

fn lowNibble(value: Int): Int {
  value & 0x0F
}

fn isEven(value: Int): Bool {
  value & 1 == 0
}

// Every operator on the default width
print(12 & 10)
print(12 | 10)
print(12 ^ 10)
print(~12)
print(1 << 10)
print(1024 >> 3)
print(-16 >> 2)
print lowNibble(0xAB)
print isEven(6)
print isEven(7)

// The levels: `&` like `*`, `|` and `^` like `+`, a shift between `*` and `**`
print(1 | 2 & 3)
print(1 ^ 3 + 4)
print(1 << 2 * 3)
print(1 << 2 ** 3)
print(~0 & 0xFF)
print(-1 << 4)

// The narrow and the unsigned widths
const byte: UInt8 = 0xF0
print(~byte)
print(byte >> 4)
print(byte << 1)
const small: Int8 = -128
print(small >> 7)
const one: Int8 = 1
print(one << 7)
const word: UInt32 = 0xFFFF0000
print(word ^ 0xFFFFFFFF)
const wide: UInt64 = 1
print(wide << 63)
