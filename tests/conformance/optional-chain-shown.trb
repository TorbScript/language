/**
 * **A `?.` shown by `print` is shown as the `Option` it produces.** `print names.first()?.byteLength()` prints
 * `Some(3)`: the member runs on the payload and answers an `Int`, and only the `Option` around that answer is what
 * `print` shows - the same as for a `?.` bound to a name first, and for a member the runtime provides as much as for one
 * written in TorbScript.
 */

use Process from "std/process"

const names = ["Zoe", "Adam", "Mia"]
const nobody: List<String> = []
print names.first()?.byteLength(), nobody.first()?.byteLength()
print names.first()?.trim(), "{names.last()?.byteLength()}"
const bound = names.first()?.byteLength()
print bound

Process.exit((bound ?? 0) - 3)
