use Process from "std/process"

/**
 * **An `Array` is a value: `a[index] = value` changes this one, and a copy taken before keeps what it had.** The items
 * live inline, so copying the array copies them, and a write through a `var` parameter changes the caller's array and
 * nothing else.
 *
 * `get` is the same question as `a[index]` with an `Option` for an answer, and an index outside of `0..Size` is `None`
 * there - the negative one included.
 */

fn raised(var values: Array<Int, 3>, index: Int) {
  values[index] = values[index] + 100
}

var values: Array<Int, 3> = [1, 2, 3]
const before = values
values[0] = 10
raised values, 2
print values
print before
print "{values.get(1)} {values.get(3)} {values.get(-1)}"

var total = 0
for index in 0..values.length() {
  total = total + values[index]
}
print total

Process.exit(total - 100)
