use * as http from "std/http"
use Server, Request, Response, Status, Body, HttpError, Method, Headers from "std/http"
use SocketAddress, IpAddress from "std/network"
use Source, Bytes from "std/stream"

/**
 * An HTTP/1.1 server and its client over loopback, end to end: a handler is a function from a request to a task of a
 * response; a body with a known length is sent with `Content-Length` and one without in chunks, and the client reads
 * either the same way; a request body arrives as a stream; JSON goes both ways; a handler that fails is a `500` that
 * does not tell the client why; and a status that is not a success is still a response. The server serves every
 * connection in a task of its own until the end of the program cancels it.
 */

/** A value that travels as JSON. */
type Greeting {
  text: String
  count: Int
}

/** The routes of the test server. */
fn handle(request: Request): Task<Result<Response, HttpError>> {
  match request.path() {
    "/hello" => Ok Response.text("hello from {request.method} {request.target}")
    "/echo" => {
      const text = request.body.text().await()?
      Ok Response.text("echoed {text.byteLength()} bytes: {text}")
    }
    "/json" => {
      const greeting = request.body.json<Greeting>().await()?
      Ok Response.jsonOf(Greeting("{greeting.text}, back", greeting.count + 1))
    }
    "/stream" => {
      const parts: List<Bytes> = ["one ".bytes().toList(), "two ".bytes().toList(), "three".bytes().toList()]
      Ok Response(Status.ok, Headers(), Body.of(Source.from(parts)))
    }
    "/fail" => Fail HttpError.connectionFailed("a secret the client must not see")
    _ => Ok Response.text("nothing at {request.path()}", status: Status.notFound)
  }
}

/** A request of `method` to `path`, answered as its status, its framing and its text. */
fn fetch(base: String, method: Method, path: String, body: Body): Task<Result<String, HttpError>> {
  var response = http.send(method, "{base}{path}", body: body).await()?
  const framing = if response.headers.contains("Transfer-Encoding") { "chunked" } else { "length" }
  const text = response.body.text().await()?
  Ok "{method} {path} -> {response.status} ({framing}): {text}"
}

match Server.listen(SocketAddress(IpAddress.loopback, 0), handle) {
  Ok(server) => {
    const base = "http://127.0.0.1:{server.localAddress().port}"
    var serving = server.serve()
    print fetch(base, Method.Get, "/hello?name=ada", Body.empty()).await()
    print fetch(base, Method.Post, "/echo", Body.from("a body of known length")).await()
    const streamed: List<Bytes> = ["streamed ".bytes().toList(), "in ".bytes().toList(), "chunks".bytes().toList()]
    print fetch(base, Method.Post, "/echo", Body.of(Source.from(streamed))).await()
    print fetch(base, Method.Post, "/json", Body.jsonOf(Greeting("hi", 1))).await()
    print fetch(base, Method.Get, "/stream", Body.empty()).await()
    print fetch(base, Method.Get, "/nowhere", Body.empty()).await()
    print fetch(base, Method.Get, "/fail", Body.empty()).await()
    var head = http.send(Method.Head, "{base}/hello").await()
    print "HEAD /hello -> {head.map({ _.status })}, length {head.map({ _.headers.get("Content-Length") })}"
    serving.cancel()
    print "server: {serving.result()}"
  }
  Fail(problem) => print "could not listen: {problem}"
}
