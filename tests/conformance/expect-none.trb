use Process from "std/process"

/**
 * `Option.expect` panics with the message it was given and nothing else, at the line of `std/core` that writes the
 * panic - which is what makes `a[key]` and every other `expect` one behaviour decided in one place.
 */
fn portOf(name: String): Int? {
  if name == "http" {
    return Some 80
  }
  None
}

print portOf("http").expect("a port for http")
print portOf("gopher").expect("a port for gopher")

Process.exit 0
