use Process from "std/process"

/**
 * The three ranges as values, iterated, measured, shown and sliced with - all five spellings of one.
 *
 * **Which ends a range has is its type** (`std/core/src/range.trb`): `Range` iterates and has a length, `RangeFrom`
 * iterates forever, `RangeTo` does neither, and all three are `Bounds`, which is what a slice takes. `Show` writes the
 * *source* form rather than the fields: a reader writes `0..10`, so that is what both back ends print.
 *
 * A range of anything but `Int` is deliberately not here: stage 0's own `Range` holds two integers and nothing else, so
 * `"a".."c"` is a value it cannot build at all, and a program that uses one cannot be compared with the interpreter.
 * The list side of slicing is `collection-places.trb`.
 */

fn shown() {
  const half = 2..5
  print half
  const inclusive = 1..=3
  print inclusive
  const fromHere = 7..
  print fromHere
  const upTo = ..4
  print upTo
  const upToInclusive = ..=4
  print upToInclusive
}

fn measured() {
  const half = 2..5
  print half.length()
  const inclusive = 1..=3
  print inclusive.length()
  const backwards = 5..2
  print backwards.length()
  print backwards.isEmpty()
}

fn walked() {
  var sum = 0
  for value in 1..5 {
    sum = sum + value
  }
  print sum
  var inclusiveSum = 0
  for value in 1..=5 {
    inclusiveSum = inclusiveSum + value
  }
  print inclusiveSum
  var taken = 0
  for value in 0.. {
    if value > 3 {
      break
    }
    taken = taken + value
  }
  print taken
  const collected = (0..4).map({ _ * _ }).toList()
  print collected
}

/** `contains` is the default of `Bounds`, and an end the range does not have never excludes anything on its side. */
fn contained() {
  const half = 2..5
  print half.contains(2)
  print half.contains(5)
  const inclusive = 2..=5
  print inclusive.contains(5)
  const fromHere = 3..
  print "{fromHere.contains(2)} {fromHere.contains(1000000)}"
  const upTo = ..10
  print "{upTo.contains(-5)} {upTo.contains(10)}"
  const upToInclusive = ..=10
  print upToInclusive.contains(10)
}

/** All five spellings in brackets, on a `String`: the value in them becomes a `Bounds<Int>` where it is written. */
fn sliced() {
  const text = "abcdef"
  print text[1..3]
  print text[1..=3]
  print text[..2]
  print text[3..]
  print text[0..6]
}

shown()
measured()
walked()
contained()
sliced()

Process.exit 0
