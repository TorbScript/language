use Process from "std/process"

/**
 * **A captured `var` binding is the binding itself, and everything else a closure captures is a copy.** That is the one
 * place in the language where a variable is shared, so it is the one thing about a closure a program can observe - and
 * it only lasts as long as the binding does: a closure that captures a `var` stands straight as the argument of a call
 * that just calls it, and is never bound, stored or returned.
 *
 * What it pins: the closure sees what the scope wrote before the call, the scope sees what the closure wrote, two
 * closures of one call over the same binding see each other, a closure inside a closure reaches a binding from further
 * out, the binding of a `for` is fresh every turn (so a closure built in a turn keeps that turn's value), and a closure
 * that captures a `const` keeps a value nothing can reach any more.
 *
 * A closure that has to change something the *caller* holds does not capture it at all: it takes a `var` parameter,
 * which the last function shows.
 */

/** Runs `action` twice, and only calls it: a closure handed to it may capture a `var` binding. */
fn twice(action: () => Void) {
  action()
  action()
}

/** What `read` answers. */
fn reading(read: () => Int): Int {
  read()
}

/** Three steps, then the reading: two closures of one call, over one binding. */
fn stepsThenRead(step: () => Void, read: () => Int): Int {
  step()
  step()
  step()
  read()
}

fn sharedWithTheScope(): Int {
  var count = 1
  count = count * 10
  reading { count }
}

fn sharedWithTheClosure(): Int {
  var count = 0
  twice {
    count = count + 5
  }
  count
}

fn sharedBetweenTwo(): Int {
  var count = 0
  stepsThenRead({ count = count + 1 }, { count * 100 })
}

/** A closure inside a closure: the inner one changes a binding of the function around both. */
fn nested(): List<Int> {
  var count = 0
  var seen: List<Int> = []
  twice {
    [1, 2].forEach { step =>
      count = count + step
      seen.append count
    }
  }
  seen
}

/** The binding of a `for` is a new one every turn, so a closure built in one turn keeps that turn's value. */
fn perTurn(): List<Int> {
  var made: List<() => Int> = []
  for index in 0..3 {
    made.append({ index * 2 })
  }
  var result: List<Int> = []
  for closure in made {
    result.append closure()
  }
  result
}

type Point {
  x: Int
  y: Int
}

/** A `const` capture is a copy, and the closure still has it where the scope that made it is gone. */
fn ofAConstant(): () => Int {
  const point = Point 3, 4
  const numbers = [1, 2, 3]
  { point.x + point.y + numbers.length() }
}

/** What a closure may not capture, it takes: a `var` parameter is how a step changes what the caller holds. */
fn addedTo(var target: List<Int>, step: (Int) => Int) {
  for index in 0..3 {
    target.append step(index)
  }
}

print sharedWithTheScope()
print sharedWithTheClosure()
print sharedBetweenTwo()
print nested()
print perTurn()

const read = ofAConstant()

print read(), read()

var collected: List<Int> = []

addedTo collected, { _ + 100 }
print collected

Process.exit 0
