/**
 * **A program knows where its own executable is.** `Process.executablePath()` answers an absolute path with `/` between
 * its parts, and the path names a file that exists - what runs: the binary the conformance runner built as `prog`
 * (`prog.exe` on Windows), and the entry file itself where the VM runs the program, as an interpreter answers the path
 * of its script. The path itself differs from machine to machine, so only what holds everywhere is printed.
 */
use Process from "std/process"
use File from "std/fs"

match Process.executablePath() {
  Some(path) => {
    print File.exists(path)
    print path.contains("\\")
    const isBinary = path.endsWith("/prog") || path.endsWith("/prog.exe")
    print(isBinary || path.endsWith("/process-executable-path.trb"))
  }
  None => print "no executable path"
}
