/**
 * **A program knows where its own executable is.** `Process.executablePath()` answers an absolute path with `/` between
 * its parts, and the path names a file that exists - the binary that is running, which the conformance runner built
 * as `prog` (`prog.exe` on Windows). The path itself differs from machine to machine, so only what holds everywhere
 * is printed.
 */
use Process from "std/process"
use File from "std/fs"

match Process.executablePath() {
  Some(path) => {
    print File.exists(path)
    print path.contains("\\")
    print(path.endsWith("/prog") || path.endsWith("/prog.exe"))
  }
  None => print "no executable path"
}
