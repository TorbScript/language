/**
 * A `UInt64` above the largest `Int64` is a compile-time constant: a module's `const`, a field's default and a type's
 * `static`, written as a literal or made by `~`, `<<` and the other operators. The compiler holds it as its bits, the
 * native back end spells it as the number with a `u`, and the VM's constant pool holds the bits - both print the
 * number that was written.
 */

use initial, largest, high, prime, mixed, words, isHigh, Hasher from "./unsigned-constants/table"
use top, below, half, rest, power, product, logical, isSame from "./unsigned-constants/table"

print initial
print largest
print(largest == UInt64.maximum)
print high
print prime
print mixed
print words
print isHigh
print(initial - high)
const hasher = Hasher()
print hasher.state
print(hasher.mask == largest)
print Hasher.seed
print top
print below
print half
print rest
print power
print product
print logical
print isSame
