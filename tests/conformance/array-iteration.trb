use Process from "std/process"

/**
 * **`for` over an `Array` walks its items front to back, and the pipelines of `Iterate` work on one** - `map`,
 * `filter`, `fold`, `zip` - because `iterate()` answers an ordinary cursor. The cursor holds the array by value, so a
 * write to the array inside the loop does not change what the loop walks.
 */

var values: Array<Int, 4> = [1, 2, 3, 4]
var seen = 0
for value in values {
  values[3] = 40
  seen = seen + value
}
print seen
print values

const evens = values.filter({ _ % 2 == 0 }).toList()
print evens
const total = values.fold 0 { sum, value => sum + value }
print total
const pairs = values.zip(values).map({ pair => pair.0 * pair.1 }).toList()
print pairs

Process.exit seen
