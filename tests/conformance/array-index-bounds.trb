use Process from "std/process"

/**
 * `a[index]` past the end of an `Array`, which panics with the language's own message: `Indexed.at` is
 * `get(key).expect("Key does not exist")`, for an `Array` as for a `List`, and the direct read of an inline slot the
 * back end makes of it has to say the same thing at the same site.
 *
 * The index is computed, so the checker cannot see it - a literal `values[3]` would be a compile error instead.
 */

fn pick(values: Array<Int, 3>, index: Int): Int {
  values[index]
}

const values: Array<Int, 3> = [10, 20, 30]
print pick(values, 2)
print pick(values, 3)
print "not reached"

Process.exit 0
