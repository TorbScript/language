// A breakpoint in the top-level code, locals of a record and a list, a field evaluated, and a step into a function
type Point {
  x: Int
  y: Int
}

fn sum(values: List<Int>): Int {
  var total = 0
  for value in values {
    total = total + value
  }
  total
}

const origin = Point 1, 2
const numbers = [10, 20, 30]
const label = "sum"
const result = sum numbers
print "{label} {result} at {origin.x}"
