# The filter `panic` stops the program where it panics, with every frame in place; `exceptionInfo` says the message,
# and when the program goes on the panic ends it with 101, as it would without a debugger
{"seq":1,"type":"request","command":"initialize","arguments":{"adapterID":"torbscript","linesStartAt1":true,"columnsStartAt1":true,"pathFormat":"path"}}
{"seq":2,"type":"request","command":"launch","arguments":{"program":"{root}/main.trb","cwd":"{root}"}}
{"seq":3,"type":"request","command":"setExceptionBreakpoints","arguments":{"filters":["panic"]}}
{"seq":4,"type":"request","command":"configurationDone"}
{"seq":5,"type":"request","command":"exceptionInfo","arguments":{"threadId":1}}
{"seq":6,"type":"request","command":"stackTrace","arguments":{"threadId":1}}
{"seq":7,"type":"request","command":"scopes","arguments":{"frameId":1}}
{"seq":8,"type":"request","command":"variables","arguments":{"variablesReference":1}}
{"seq":9,"type":"request","command":"continue","arguments":{"threadId":1}}
