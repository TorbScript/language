// The tests a session debugs: a breakpoint in the body of one test, which a filter picks
use test, group from "std/test"

fn double(value: Int): Int {
  value * 2
}

group "Math" {
  test "doubles" {
    const doubled = double 21
    assert(doubled == 42)
  }

  test "halves" {
    const halved = 42 / 2
    assert(halved == 21)
  }
}
