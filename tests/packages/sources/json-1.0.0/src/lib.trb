/** A package of the registry fixture of `tools/packages.sh`: version 1.0.0 of `acme/json`. */

/** The version of the package, which the test prints to see which one the build took. */
public fn jsonVersion(): String {
  "1.0.0"
}

/** `text` as a JSON string literal. */
public fn quotedJson(text: String): String {
  "\"{text}\""
}
