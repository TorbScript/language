/**
 * A package of the registry fixture of `tools/packages.sh`: version 1.2.0 of `acme/json`, which imports `std/fs` - so
 * an update to it gains the capability `files`, and `torb update` asks for `--accept-capabilities`.
 */

use File, IoError from "std/fs"

/** The version of the package, which the test prints to see which one the build took. */
public fn jsonVersion(): String {
  "1.2.0"
}

/** `text` as a JSON string literal, with its quotes and backslashes escaped. */
public fn quotedJson(text: String): String {
  const escaped = text.replace("\\", "\\\\").replace("\"", "\\\"")
  "\"{escaped}\""
}

/** The text of a file as a JSON string literal. */
public fn quotedFile(path: String): Result<String, IoError> {
  Ok quotedJson(File.readText(path)?)
}
