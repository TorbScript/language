name = "torbscript/language"
version = "0.1.0"

// The language smoke programs: one long program per file, run with `torb run` and compared with its `.expected`.
// They exercise many constructs at once, which is what a conformance program deliberately does not do.
//
// They are valid TorbScript and are checked, which is why this is a workspace of its own whose only members are the
// standard library.
//
// A behaviour that has to be pinned on its own belongs in `../conformance/` instead.
workspace {
  members "../../std/*"
}
