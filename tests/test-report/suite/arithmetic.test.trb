// The first file of the suite of tools/test-report.sh: groups inside groups, a test that passes, one that fails with
// a line of its own printed before, and a group whose body prints - a filter that passes over it shows the line is gone

use test, group from "std/test"

group "Arithmetic" {
  test "adds" {
    assert(1 + 1 == 2)
  }

  group "Division" {
    test "divides" {
      assert(6 / 3 == 2)
    }

    test "fails on purpose" {
      print "a line the test prints"
      assert(7 / 2 == 4)
    }
  }
}

group "Other" {
  print "the body of the group Other runs"

  test "passes" {
    assert true
  }
}
