// The second file of the suite of tools/test-report.sh: names outside ASCII, which a filter names on the command line,
// and a name and a message the JSON report escapes

use test, group from "std/test"

group "Größe" {
  test "zählt Äpfel 日本" {
    assert("Äpfel" != "Apfel")
  }
}

test "a name with \"quotes\" and a \\ backslash" {
  panic "first line\nsecond line with \"quotes\"\tand a tab"
}
