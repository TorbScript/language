// Every semantic token kind this extension knows, in one file. Open it with "TorbScript: reload the extension"
// done (see README.md) and `torbscript.semanticHighlighting.enabled` on, to see `torb highlight`'s colors; turn
// the setting off (or rename the `torb` executable) to see the TextMate grammar's fallback colors instead.
//
// This is not a program that runs (a few lines only make sense highlighted, not evaluated) - it exists to be
// looked at, not `torb run`. It is therefore outside the `check` gate as well, and the only thing that applies to it is
// `torb parse`: it has to lex and parse, because `torb highlight` walks the syntax tree the parser builds.

use * as collections from "std/collections"                 // `collections`: `namespace`, here and at every use

const newList = collections.emptyList()                      // `collections`: `namespace`; `emptyList`: `function`,
                                                               // not `method` - a namespaced call is a free function

/**
 * A trait: `interface`. `Show` and `Compare` below are traits used as bounds: `interface` again, at their use.
 */
trait Describable {
  fn describe(self): String                                 // A required method: `method`, `static` is not set
}

/** A type: `type`. `Item` and `Size` are its generics: `typeParameter`, at their declaration and every use. */
shared type Buffer<Item, const Size: Int> with Describable {
  var length: Int = 0                                        // A `var` field: `property` + `mutable` (underline)
  const capacity: Int = Size                                 // A `const` field: `property`, no underline
  step: Item                                                 // A field without `var`: `property`, readonly

  case Empty                                                 // A case: `enumMember`
  case Full(item: Item)                                      // A case with a field: `enumMember` + `property`

  /** A method with `self`: `method`. `var self` also makes every `self` in its body `mutable` (underlined). */
  fn push(var self, value: Item) {
    length = length + 1                                      // A bare field write: `property`, `mutable`
    step = value                                              // Another bare field: `property`
  }

  /** A method without `self`: `method` + `static`. */
  fn withCapacity(size: Size): Buffer<Item, Size> {
    Self size                                                 // `Self` used as a constructor: left to TextMate
  }

  /** Calling another method of the same type bare: still `method` (implicit `self`). */
  fn isFull(self): Bool {
    length == capacity
  }

  fn describe(self): String {
    "Buffer({length}/{capacity})"                             // `length`/`capacity`: bare fields, `property`
  }
}

/** A free function: `function`, distinct from a `method`. `Value` is its own generic: `typeParameter`. */
fn identity<Value>(value: Value): Value {                    // `value`: `parameter`, at declaration and use
  const doubled = value                                      // `doubled`: `variable` (readonly - a `const`)
  var counter = 0                                             // `counter`: `variable` + `mutable` (underline)
  counter = counter + 1
  doubled
}

/** Command style and call style color the same: both calls to `identity` below are `function`. */
const a = identity(1)
const b = identity 2

/** A case used every documented way: `case`, `.Case`, `Type.Case`, and the four prelude cases bare. */
fn describeShape(shape: Shape): String {
  match shape {
    .Circle(radius) => "circle r={radius}"                   // `.Circle`: `enumMember`; `radius`: `variable`
    Shape.Rectangle(width, height) => "{width}x{height}"      // `Shape`: `type`, `Rectangle`: `enumMember`
    .Empty => "empty"
  }
}

fn firstWord(text: String): Result<String, String> {
  match text.split(" ").iterator().next() {
    Some(word) => Ok(word)                                    // Bare `Some`/`Ok`: `enumMember`, `defaultLibrary`
    None => Fail("empty")                                     // Bare `None`/`Fail`: `enumMember`, `defaultLibrary`
  }
}

/** Constructor labels are `property` (they name a field); a function call's labels are `parameter`. */
type Point {
  x: Int
  y: Int
}
fn moveTo(target: Point, to: Point) {}
const origin = Point(x: 0, y: 0)                             // `x`, `y`: `property`
moveTo(target: origin, to: Point(x: 1, y: 1))                // `target`, `to`: `parameter`

/** A dotted call is a method call, a bare one a function call - in both command style and call style. */
fn methodVsFunction(point: Point) {
  const shown = point.describe()                             // `describe`: `method` (through a value, not a type)
  const also = identity(shown)                                // `identity`: `function` (bare)
}

/** Closures, `for`, `if const`/`if var`, and a nested `fn` that cannot see the locals around it. */
fn scoping(items: List<Int>): Int {
  const outer = 10                                            // `outer`: `variable`
  const doubled = items.map { item => item * 2 }              // `item`: `parameter` (a closure parameter)
  for entry in doubled {                                       // `entry`: `variable`, scoped to the loop body
    print entry
  }
  if const first = doubled.first() {                          // `first`: `variable`, visible only in the `then`
    print first
  }

  fn helper(): Int {
    // `outer` is not in scope here: a nested `fn` is not a closure. It gets no (wrong) token at all.
    42
  }
  helper() + doubled.length()
}
