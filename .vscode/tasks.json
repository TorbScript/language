{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "torb: check workspace",
      "detail": "torb check .. - the whole repository, \"no problems\" when it is clean",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--release", "-q", "--", "run", "../compiler", "check", ".."],
      "options": {
        "cwd": "${workspaceFolder}/bootstrap"
      },
      "group": "build",
      "problemMatcher": {
        "base": "$torb",
        "fileLocation": ["relative", "${workspaceFolder}/bootstrap"]
      }
    },
    {
      "label": "torb: test compiler",
      "detail": "torb test ../compiler/tests - the TorbScript tests of the compiler, run on stage 0",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--release", "-q", "--", "test", "../compiler/tests"],
      "options": {
        "cwd": "${workspaceFolder}/bootstrap"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
