{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "torb: check workspace",
      "detail": "torb check . - the whole repository, \"no problems\" when it is clean",
      "type": "shell",
      "command": "build/release/torb",
      "args": ["check", "."],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": {
        "base": "$torb",
        "fileLocation": ["relative", "${workspaceFolder}"]
      }
    },
    {
      "label": "torb: test compiler",
      "detail": "torb test compiler/tests - the TorbScript tests of the compiler",
      "type": "shell",
      "command": "build/release/torb",
      "args": ["test", "compiler/tests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
