name "torbscript/example-game-engine"
version "0.1.0"
authors "Torben Köhn"

const binary = name.substringAfter("/") ?? name   // Read before `build { }`: only the innermost receiver is implicit

build {
  target "release"
  input "src/main.trb"
  output "build/{target}/{binary}"
}
test {
  input "tests"
  coverageThreshold 80
}
