use Vector2 from "./math/vector2"
use Component, ComponentKind, Entity from "./ecs/component"
use World, System from "./ecs/world"

const gravity = Vector2(0.0, 9.81)

public fn movement(world: World, deltaTime: Float): World {
  world.mapEntities([ComponentKind.Transform, ComponentKind.Velocity]) {
    match (entity.position(), entity.velocity()) {
      (Some(position), Some(velocity)) => entity.attached(.Transform(position + velocity * deltaTime))
      _ => entity
    }
  }
}

public fn falling(world: World, deltaTime: Float): World {
  world.mapEntities([ComponentKind.Velocity]) {
    const velocity = entity.velocity() ?? Vector2.zero
    entity.attached(.Velocity(velocity + gravity * deltaTime))
  }
}

public fn collisions(world: World, deltaTime: Float): World {
  const bodies = world.query(ComponentKind.Transform, ComponentKind.Collider, ComponentKind.Health)

  bodies.fold(world) { current, body =>
    const hits = bodies.filter { other => other.id != body.id && touches(body, other) }.count()
    if hits == 0 {
      return current                     // Returns from the closure, not from `collisions`
    }
    current.updated(body.id) { damage(entity, amount: hits * 10) }
  }
}

/** Removes everything without health left. */
public fn cleanup(world: World, deltaTime: Float): World {
  world.query(ComponentKind.Health)
    .filter { (_.health() ?? 0) <= 0 }
    .fold(world) { current, entity => current.despawned(entity.id) }
}

/** Systems are values: build new ones out of existing ones. */
public fn onlyEvery(seconds: Float, system: System): System {
  { world, deltaTime =>
    const before = (world.time / seconds).floor()
    const after = ((world.time + deltaTime) / seconds).floor()
    if after > before { system(world, seconds) } else { world }
  }
}

fn touches(a: Entity, b: Entity): Bool {
  match (a.position(), b.position(), radius(a), radius(b)) {
    (Some(p1), Some(p2), Some(r1), Some(r2)) => p1.distanceTo(p2) <= r1 + r2
    _ => false
  }
}

fn radius(entity: Entity): Float? {
  match entity.components.get(ComponentKind.Collider) {
    Some(.Collider(radius)) => Some(radius)
    _ => None
  }
}

fn damage(entity: Entity, amount: Int): Entity {
  match entity.components.get(ComponentKind.Health) {
    Some(.Health(current, maximum)) => entity.attached(.Health((current - amount).max(0), maximum))
    _ => entity
  }
}
