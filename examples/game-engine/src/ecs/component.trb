/**
 * What an entity is built from: [Component] is the data, [ComponentKind] says which case a value is without
 * matching on it, and [Entity] is the bag of components a world steps forward one frame at a time.
 */

use Vector2 from "../math/vector2"

/** Components have no `var` fields. Systems replace them instead of changing them. */
public type Component {
  case Transform(position: Vector2, rotation: Float = 0.0)
  case Velocity(value: Vector2)
  case Sprite(texture: String, layer: Int = 0)
  case Health(current: Int, maximum: Int)
  case Collider(radius: Float)
  case Tag(name: String)

  /** Components are stored by kind, an entity has at most one component of each kind. */
  fn kind(): ComponentKind {
    match self {
      .Transform(_, _) => ComponentKind.Transform
      .Velocity(_) => ComponentKind.Velocity
      .Sprite(_, _) => ComponentKind.Sprite
      .Health(_, _) => ComponentKind.Health
      .Collider(_) => ComponentKind.Collider
      .Tag(_) => ComponentKind.Tag
    }
  }
}

/** Which [Component] case a value is, without carrying it: the key `Entity` stores a component under and `World.query` asks for. */
public type ComponentKind {
  case Transform
  case Velocity
  case Sprite
  case Health
  case Collider
  case Tag
}

/** An entity's identity, stable across every copy of the world it lives in - what a system stores instead of the entity itself. */
public type EntityId = Int

/**
 * One entity: an [EntityId] and the [Component]s attached to it, at most one of each [ComponentKind].
 *
 * `attach`/`detach` change it in place; `attached`/`detached` return a changed copy, for a system that works on
 * values instead.
 */
public type Entity {
  id: EntityId
  private(var) components: Map<ComponentKind, Component> = [:]

  var fn attach(component: Component) {
    components[component.kind()] = component
  }

  var fn detach(kind: ComponentKind) {
    components.remove kind
  }

  fn attached(component: Component): Entity {
    var result = self
    result.attach component
    result
  }

  fn detached(kind: ComponentKind): Entity {
    var result = self
    result.detach kind
    result
  }

  fn has(kind: ComponentKind): Bool {
    components.containsKey kind
  }

  fn position(): Vector2? {
    match components.get(ComponentKind.Transform) {
      Some(.Transform(position, _)) => Some position
      _ => None
    }
  }

  fn velocity(): Vector2? {
    match components.get(ComponentKind.Velocity) {
      Some(.Velocity(value)) => Some value
      _ => None
    }
  }

  fn health(): Int? {
    match components.get(ComponentKind.Health) {
      Some(.Health(current, _)) => Some current
      _ => None
    }
  }
}
