/**
 * The scene DSL: [scene] builds a [World] out of nested `entity { }` blocks, one builder `var` per level, and each
 * builder's commands add [Component]s to whatever is currently open.
 *
 * Builders are where changing in place is the natural fit; what comes out at the end is a value a system passes on.
 */

use Vector2 from "./math/vector2"
use Component from "./ecs/component"
use World from "./ecs/world"

/** The commands inside an `entity { }` block: each one adds a [Component] to the entity being built. */
public type EntityBuilder {
  private(var) components: List<Component> = []

  fn at(var self, x: Float, y: Float, rotation: Float = 0.0) {
    components.add(.Transform(Vector2(x, y), rotation))
  }

  fn moving(var self, x: Float, y: Float) {
    components.add(.Velocity(Vector2(x, y)))
  }

  fn sprite(var self, texture: String, layer: Int = 0) {
    components.add(.Sprite(texture, layer))
  }

  fn health(var self, maximum: Int) {
    components.add(.Health(current: maximum, maximum: maximum))
  }

  fn collider(var self, radius: Float) {
    components.add(.Collider(radius))
  }

  fn tag(var self, name: String) {
    components.add(.Tag(name))
  }

}

/** The commands at the top level of a [scene]: `entity { }` adds one entity to the world being built. */
public type SceneBuilder {
  private(var) world: World = World()

  fn entity(var self, build: (var self: EntityBuilder) => Void) {
    var builder = EntityBuilder()
    build builder
    world.spawn(...builder.components)
  }

}

/**
 * Builds a [World] out of nested `entity { }` blocks.
 *
 * # Examples
 *
 *     const world = scene {
 *       entity {
 *         tag "player"
 *       }
 *     }
 *     print world.entities.length()
 */
public fn scene(build: (var self: SceneBuilder) => Void): World {
  var builder = SceneBuilder()
  build builder
  builder.world
}
