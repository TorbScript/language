/** Immutable 2D vector. Value semantics, structural equality, freely shareable between tasks. */
public type Vector2 with Add, Subtract, Negate, Multiply<Float> {
  x: Float
  y: Float

  const zero = Vector2(0.0, 0.0)
  const up = Vector2(0.0, -1.0)
  const down = Vector2(0.0, 1.0)
  const left = Vector2(-1.0, 0.0)
  const right = Vector2(1.0, 0.0)

  fn add(self, other: Vector2): Vector2 { Vector2(x + other.x, y + other.y) }
  fn subtract(self, other: Vector2): Vector2 { Vector2(x - other.x, y - other.y) }
  fn multiply(self, other: Float): Vector2 { Vector2(x * other, y * other) }
  fn negate(self): Vector2 { Vector2(-x, -y) }

  fn dot(self, other: Vector2): Float {
    x * other.x + y * other.y
  }

  fn length(self): Float {
    dot(self).squareRoot()
  }

  fn distanceTo(self, other: Vector2): Float {
    (other - self).length()
  }

  fn normalized(self): Vector2 {
    const magnitude = length()
    if magnitude == 0.0 { Vector2.zero } else { self * (1.0 / magnitude) }
  }
}

extend Vector2 with From<(Float, Float)> {
  fn from(value: (Float, Float)): Vector2 {
    Vector2(value.0, value.1)
  }
}
