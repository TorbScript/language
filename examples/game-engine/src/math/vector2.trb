/** 2D vector math: [Vector2] and the arithmetic traits it implements. */

/** Immutable 2D vector. Value semantics, structural equality, freely shareable between tasks. */
public type Vector2 with Add, Subtract, Negate, Multiply<Float> {
  x: Float
  y: Float

  static zero = Vector2 0.0, 0.0
  static up = Vector2(0.0, -1.0)
  static down = Vector2 0.0, 1.0
  static left = Vector2(-1.0, 0.0)
  static right = Vector2 1.0, 0.0

  fn add(other: Vector2): Vector2 { Vector2(x + other.x, y + other.y) }
  fn subtract(other: Vector2): Vector2 { Vector2(x - other.x, y - other.y) }
  fn multiply(other: Float): Vector2 { Vector2(x * other, y * other) }
  fn negate(): Vector2 { Vector2(-x, -y) }

  fn dot(other: Vector2): Float {
    x * other.x + y * other.y
  }

  fn length(): Float {
    dot(self).squareRoot()
  }

  fn distanceTo(other: Vector2): Float {
    (other - self).length()
  }

  fn normalized(): Vector2 {
    const magnitude = length()
    if magnitude == 0.0 { Vector2.zero } else { self * (1.0 / magnitude) }
  }
}

/** Builds a [Vector2] from an `(x, y)` tuple: what `.into()` uses. */
extend Vector2 with From<(Float, Float)> {
  static fn from(value: (Float, Float)): Vector2 {
    Vector2 value.0, value.1
  }
}
