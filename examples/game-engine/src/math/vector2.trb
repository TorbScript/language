/** 2D vector math: [Vector2] and the arithmetic traits it implements. */

/** Immutable 2D vector. Value semantics, structural equality, freely shareable between tasks. */
public type Vector2 with Add, Subtract, Negate, Multiply<Float> {
  x: Float
  y: Float

  static zero = Self 0.0, 0.0
  static up = Self(0.0, -1.0)
  static down = Self 0.0, 1.0
  static left = Self(-1.0, 0.0)
  static right = Self 1.0, 0.0

  fn add(other: Self): Self { Self(x + other.x, y + other.y) }
  fn subtract(other: Self): Self { Self(x - other.x, y - other.y) }
  fn multiply(other: Float): Self { Self(x * other, y * other) }
  fn negate(): Self { Self(-x, -y) }

  fn dot(other: Self): Float {
    x * other.x + y * other.y
  }

  fn length(): Float {
    dot(self).squareRoot()
  }

  fn distanceTo(other: Self): Float {
    (other - self).length()
  }

  fn normalized(): Self {
    const magnitude = length()
    if magnitude == 0.0 { Self.zero } else { self * (1.0 / magnitude) }
  }
}

/** Builds a [Vector2] from an `(x, y)` tuple: what `.into()` uses. */
extend Vector2 with From<(Float, Float)> {
  static fn from(value: (Float, Float)): Self {
    Self value.0, value.1
  }
}
