/**
 * What a library that is generic over a number type runs into, in as few lines as it takes: an operator on a generic
 * type, a `const` of a generic type, a numeric literal in a body generic over its number type, and a constant the
 * number type itself carries (`Item.zero`, `Item.one`). `torb check .` answers "no problems", and `torb run .` builds
 * and runs it. `docs/design/LINEAR.md` section 12, items 2, 10 and 14, is the list this comes from, and `std/linear` is
 * written around it; the package is the regression test for all of them.
 */

use Numeric from "std/number"
use Add from "std/core"

/**
 * A number in a wrapper, generic over the number, with the arithmetic through the trait the operator goes through: the
 * smallest type that has the shape `Vector2` has.
 */
public type Pair<Item: Numeric = Float> with Add {
  /** The only field. */
  value: Item

  /**
   * The wrapper of nothing, for every number type: `Numeric` requires `static zero: Self`, and this reads it through the
   * parameter.
   */
  static zero: Self = Pair Item.zero

  /** The same wrapper built from a literal, which adapts to the parameter's type. */
  static fn nothing(): Self {
    Pair 0
  }

  fn add(other: Self): Self {
    Pair(value + other.value)
  }
}

/** A trait constant in a generic body: `Item.one` is the `one` of whichever number type `Item` is. */
public fn incremented<Item: Numeric>(value: Item): Item {
  value + Item.one
}

/** A literal in a generic body, reached through an operator: `2` adapts to `Item`. */
public fn doubled<Item: Numeric>(value: Item): Item {
  value * 2
}

/** A box whose constant needs no literal: one value per item type. */
public type Box<Item> {
  /** What is in it. */
  items: List<Item>

  /** The empty box, one value per item type. */
  static empty: Self = Box([])
}

// An operator on a generic type, and the method form of the same call beside it: one function, either way
const one = Pair 1
const sum = one + one
print "{sum} {one.add(one)}"

// A `const` of a generic type, once per type argument
print "{Box<Int>.empty.items} {Box<String>.empty.items}"

// The constants of the number type, and literals, in a generic body
print "{incremented(1)} {incremented(0.5)} {doubled(3)} {doubled(1.5)}"

// The same one level in: a static member of a generic type whose body holds a literal
const empty: Pair<Float> = Pair.nothing()
print empty

// A constant of a generic type over the number's own zero: the bare name is the declared default, `Float`, and the
// expected type or a written argument picks another instance
const grid: Pair<Int> = Pair.zero
print "{Pair.zero} {grid} {Pair<UInt8>.zero}"
