name "torbscript/generic-scalar"
version "0.1.0"

// What a library that is generic over a number type used to run into. Every line here type checks, builds and runs -
// `torb check .`, `torb build .` and `torb run .` are all green - and this package is now the regression test for
// `docs/design/LINEAR.md` section 12, items 2 and 14.
build {
  input "src/main.trb"
}
