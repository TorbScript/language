/**
 * A configuration script for `ServerConfig`, loaded and run by `main.trb` through `Sandbox.load`.
 *
 * Its body is a closure of type `(var self: ServerConfig) => Void`: it is type checked against `ServerConfig` (try
 * `prot = 8080` or `port = "8080"`), it can reach nothing but what `ServerConfig` exposes - no IO, no network, no
 * clock - and it is still real code: bindings, loops, conditions, functions all work. `server-config.trb` declares
 * the vocabulary it writes in (`host`, `port`, `database { }`, `route`, `logging { }`).
 */

const apiVersion = "v1"
const resources = ["users", "orders", "invoices"]

const secure = true

// `secret` is exposed by ServerConfig, the script cannot read the environment itself. It is read here and not inside
// `database { }`, because only the innermost receiver is implicit.
const databasePassword = secret "DB_PASSWORD"

host = "0.0.0.0"
port = if secure { 8443 } else { 8080 }
tls = secure

database {
  url = "postgres://localhost:5432/mydb"
  username = "myuser"
  password = databasePassword            // Read above: inside this block the receiver is the DatabaseConfig
  poolSize = 20
}

route "/health", to: "health"

for resource in resources {
  route "/api/{apiVersion}/{resource}", to: resource
}

logging {
  level = .Debug                         // A field is written with `=`, and a case keeps its dot
  if secure {                            // `tls` is not visible here: only the innermost receiver is implicit
    redact "password", "token"
  }
}
