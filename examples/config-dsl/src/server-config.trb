/**
 * The vocabulary of `config.trb`.
 *
 * Settings and sections are `var` fields. A setting is written with `=` (`port = 8443`); a section is a field
 * configured in place (`database { ... }`). Only what is more than that (`route`, `redact`, `secret`) is a method.
 */

/** A path mounted to a handler name, added by the `route` command. */
public type Route {
  path: String
  handler: String
}

/** The severity a log line carries. `logging { level = .Debug }` sets it for the whole section. */
public type LogLevel {
  case Debug
  case Info
  case Warn
  case Error
}

/** The `database { }` section: where to connect and how many connections to keep open. */
public type DatabaseConfig {
  var url: String = ""
  var username: String = ""
  var password: String = ""
  var poolSize: Int = 10
}

/** The `logging { }` section: the level, and the keys `redact` hides from whatever reads this config. */
public type LoggingConfig {
  var level: LogLevel = .Info
  protected var redacted: Set<String> = []    // Readable for the application, only `redact` writes

  var fn redact(...keys: String) {
    for key in keys {
      redacted.insert key
    }
  }
}

/**
 * The receiver `config.trb` configures: host, port, TLS, a [DatabaseConfig] and a [LoggingConfig] section, and the
 * routes `route` adds. `secret` is the only way a script reaches outside of what is written here.
 */
public type ServerConfig {
  var host: String = "localhost"
  var port: Int = 8080
  var tls: Bool = false
  var database: DatabaseConfig = DatabaseConfig()
  var logging: LoggingConfig = LoggingConfig()
  protected var routes: List<Route> = []
  private secrets: Map<String, String> = [:]

  /** The host application decides which secrets a config script can see. */
  static fn withSecrets(secrets: Map<String, String>): ServerConfig {
    Self secrets: secrets
  }

  var fn route(path: String, to: String) {
    routes.append Route(path, handler: to)
  }

  fn secret(key: String): String {
    secrets.get(key) ?? ""
  }

  fn validate(): Result<ServerConfig, ConfigError> {
    if database.url.isBlank() {
      return Fail ConfigError("database.url is required")
    }
    if tls && port == 80 {
      return Fail ConfigError("tls on port 80 is not supported")
    }
    self
  }
}

/** Why [ServerConfig.validate] refused a configuration. */
public type ConfigError {
  message: String
}
