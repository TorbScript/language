/**
 * Loads `config.trb` into a [ServerConfig] and prints what it produced.
 *
 * `loadConfig` is the sandboxed path: a file, checked against `ServerConfig` and run with [Sandbox]. `testConfig`
 * writes the same vocabulary inline, for a caller that needs no file at all.
 */

use Sandbox, SandboxError from "std/sandbox"
// `16.megabytes()` is a member `std/sandbox` adds to `Int64`, which `std/number` owns - so this file names it
use Int64.megabytes from "std/sandbox"
use Environment from "std/os"
use ServerConfig, ConfigError from "./server-config"

/** Everything that can keep the server from starting: the script itself failed, or what it produced does not validate. */
type StartupError {
  case Script(cause: SandboxError)
  case Config(cause: ConfigError)
}

// Both cases wrap exactly one error, so `From<SandboxError>` and `From<ConfigError>` are generated and `?` converts.

/**
 * Parses and type checks `config.trb` against [ServerConfig], runs it in a sandbox, and validates the result.
 *
 * # Errors
 *
 * `StartupError.Script` if the file does not parse, does not type check against `ServerConfig`, or panics while it
 * runs; `StartupError.Config` if the config it produced does not validate.
 */
fn loadConfig(): Result<ServerConfig, StartupError> {
  // Parses and type checks the file against ServerConfig. The result is a Script<ServerConfig>: loading reports what
  // is wrong with the file, `apply` what goes wrong while it runs (a limit, or a panic inside the script).
  //
  // The path is a literal, so `torb check` checks `config.trb` against ServerConfig as part of this project. A path
  // that is only known while the program runs is checked by the sandbox instead, when it loads the file.
  //
  // What a script can do is decided here, where it is loaded. Without the block it could not do any IO at all;
  // this one may read files below ./config. The limits guard against `loop {}`.
  const script = Sandbox.load<ServerConfig>("./config.trb") {
    files readOnly: "./config"
    limits steps: 1_000_000, memory: 16.megabytes()
  }?

  var config = ServerConfig.withSecrets(["DB_PASSWORD": Environment.get("DB_PASSWORD") ?? ""])
  script.apply(config)?
  Ok(config.validate()?)
}

/** The same vocabulary as `config.trb`, written inline instead of loaded from a file. */
fn testConfig(): ServerConfig {
  var config = ServerConfig()
  const configure: (var self: ServerConfig) => Void = {
    port = 9999
    database {
      url = "sqlite::memory:"
    }
  }
  configure config
  config
}

match loadConfig() {
  Ok(config) => {
    print "Listening on {config.host}:{config.port} (tls: {config.tls})"
    for route in config.routes {
      print "  {route.path} -> {route.handler}"
    }
  }
  Fail(.Script(cause)) => print "config.trb:{cause.line}: {cause.message}"
  Fail(.Config(cause)) => print "Invalid configuration: {cause.message}"
}
