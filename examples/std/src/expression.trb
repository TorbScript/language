/**
 * Quoted expressions. If a parameter or binding has the type `Expression<T>`, the compiler type checks the argument as
 * an ordinary `T` and then passes it together with its expression tree. See "Quoted Expressions" in CONCEPT.md.
 *
 * `Expression` values can only be created by the compiler. `ExpressionNode` trees are plain data and can be built,
 * matched and transformed by everybody.
 */
public native type Expression<T> {
  /** Static data, created at compile time. */
  tree: ExpressionNode
  /** The source text of the quoted expression: `"_.age >= minAge"` */
  source: String
  location: SourceLocation

  /** The ordinary value (for function types: the closure). Evaluated at most once. */
  native fn value(self): T

  /** The values of the captured variables, in the order of their `Captured.index`. Converted on demand. */
  native fn captures(self): List<Data>
}

public type SourceLocation with Show {
  file: String
  line: Int
  column: Int

  fn show(self): String {
    "{file}:{line}:{column}"
  }
}

/** A description of a type. Data, not reflection: there is no way back from a `TypeReference` to a type. */
public type TypeReference with Show {
  name: String
  arguments: List<TypeReference> = []

  fn show(self): String {
    if arguments.isEmpty() {
      return name
    }
    const inner = String.join(arguments.map { _.show() }, separator: ", ")
    "{name}<{inner}>"
  }
}

public type UnaryOperator {
  case Negate
  case Not
}

public type BinaryOperator {
  case Add
  case Subtract
  case Multiply
  case Divide
  case Remainder
  case Equal
  case NotEqual
  case Less
  case LessOrEqual
  case Greater
  case GreaterOrEqual
  case And
  case Or
}

/**
 * Names are already resolved and everything is typed: implicit `_`, named closure parameters, receivers and
 * implicit `self` show up as explicit `Parameter`, `Field` and `Call` nodes.
 *
 * Open type: matches need a `_` arm, new node kinds can be added without breaking providers.
 */
public open type ExpressionNode {
  case Literal(value: Data, of: TypeReference)
  case Parameter(index: Int, name: String, of: TypeReference)
  case Captured(index: Int, name: String, of: TypeReference)
  case Field(target: ExpressionNode, name: String, of: TypeReference)
  case Call(target: ExpressionNode?, owner: TypeReference, method: String, arguments: List<ExpressionNode>, of: TypeReference)
  case Construct(arguments: List<ExpressionNode>, of: TypeReference)
  case Unary(operator: UnaryOperator, operand: ExpressionNode, of: TypeReference)
  case Binary(operator: BinaryOperator, left: ExpressionNode, right: ExpressionNode, of: TypeReference)
  case Conditional(condition: ExpressionNode, then: ExpressionNode, otherwise: ExpressionNode, of: TypeReference)
  case Lambda(parameters: List<String>, body: ExpressionNode, of: TypeReference)
  case Items(items: List<ExpressionNode>, of: TypeReference)

  /** All `Captured` nodes below this node, e.g. to explain a failed assertion. */
  fn capturedNodes(self): List<ExpressionNode> {
    match self {
      Captured(_, _, _) => [self]
      Field(target, _, _) => target.capturedNodes()
      Call(target, _, _, arguments, _) =>
        (target.map { _.capturedNodes() } ?? []) + arguments.flatMap { _.capturedNodes() }.toList()
      Construct(arguments, _) => arguments.flatMap { _.capturedNodes() }.toList()
      Unary(_, operand, _) => operand.capturedNodes()
      Binary(_, left, right, _) => left.capturedNodes() + right.capturedNodes()
      Conditional(condition, then, otherwise, _) =>
        condition.capturedNodes() + then.capturedNodes() + otherwise.capturedNodes()
      Lambda(_, body, _) => body.capturedNodes()
      Items(items, _) => items.flatMap { _.capturedNodes() }.toList()
      _ => []
    }
  }
}

/**
 *     assert(adults.length() > limit)
 *     // Assertion failed: adults.length() > limit   (adults = [...], limit = 5)   at main.trb:12:1
 */
public fn assert(condition: Expression<Bool>) {
  if condition.value() {
    return
  }
  const values = condition.captures()
  const details = condition.tree.capturedNodes().map { node =>
    match node {
      Captured(index, name, _) => "{name} = {values[index]}"
      _ => ""
    }
  }
  const explanation = String.join(details, separator: ", ")
  panic "Assertion failed: {condition.source}   ({explanation})   at {condition.location}"
}
