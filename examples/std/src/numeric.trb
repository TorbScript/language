
trait NumericOps {
  add(other: numeric): numeric
  subtract(other: numeric): numeric
  multiply(other: numeric): numeric
  divide(other: numeric): numeric
  modulo(other: numeric): numeric
  negate(): numeric
}

trait Numeric
  with NumericOps {}

const type Byte {}

const type SByte {}

const type Short {}

const type UShort {}

const type Int {}

const type UInt {}

const type Long {}

const type ULong {}

const type Decimal {}

const type Float {}

const type Double {}

extend Byte with NumericOps {
  native {}
}

extend SByte with NumericOps {
  native {}
}

extend Short with NumericOps {
  native {}
}

extend UShort with NumericOps {
  native {}
}

extend Int with NumericOps {
  native {}
}
extend UInt with NumericOps {
  native {}
}

extend Long with NumericOps {
  native {}
}

extend ULong with NumericOps {
  native {}
}

extend Decimal with NumericOps {
  native {}
}

extend Float with NumericOps {
  native {}
}

extend Double with NumericOps {
  native {}
}
