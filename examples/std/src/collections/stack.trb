use From from "../convert"
use Collection, MutableCollection from "./collection"

// --- Traits ------------------------------------------------------------------------------------------

/** Any stack, for reading. Iterates from top to bottom. */
public trait StackView<T>
  with Collection<T>
{
  fn peek(self): T? {
    first()
  }
}

/**
 * Persistent LIFO stack.
 *
 *     var stack = Stack.of(1, 2)
 *     stack = stack.push(3)
 *     if const Some((top, rest)) = stack.pop() { ... }
 */
public trait Stack<T>
  with StackView<T>
{
  /** The last item ends up on top. */
  fn of(...items: T): Stack<T> {
    ListStack.from(items)
  }

  fn push(self, value: T): Stack<T>

  /** The top element and the remaining stack, or `None` if the stack is empty. */
  fn pop(self): (T, Stack<T>)?
}

extend<T> Stack<T> with From<Iterable<T>> {
  fn from(items: Iterable<T>): Stack<T> {
    ListStack.from(items)
  }
}

/**
 * LIFO stack that is changed in place - the one for hot loops: no allocation per `push`.
 *
 *     var pending: MutableStack<Node> = ArrayStack()
 *     pending.push(root)
 *     while const Some(node) = pending.pop() { ... }
 */
public trait MutableStack<T>
  with StackView<T>, MutableCollection<T>
{
  fn of(...items: T): MutableStack<T> {
    var stack = ArrayStack<T>()
    stack.addAll(items)
    stack
  }

  fn push(var self, value: T)
  fn pop(var self): T?

  /** `add` is `push`, so a stack can be filled like every other mutable collection. */
  fn add(var self, value: T) {
    push(value)
  }
}

// --- Implementations, written in plain TorbScript ------------------------------------------------------------

public type ListStack<T> with Stack<T>, From<Iterable<T>> {
  private items: List<T> = []

  fn from(items: Iterable<T>): ListStack<T> {
    Self(items.toList())
  }

  fn push(self, value: T): Stack<T> {
    Self(items.add(value))
  }

  fn pop(self): (T, Stack<T>)? {
    items.last().map { top => (top, Self(items.removeAt(length() - 1))) }
  }

  fn length(self): Int {
    items.length()
  }

  fn iterator(self): Iterator<T> {
    items.reversed().iterator()
  }
}

public var type ArrayStack<T> with MutableStack<T> {
  private var items: MutableList<T> = ArrayList()

  fn push(var self, value: T) {
    items.add(value)
  }

  fn pop(var self): T? {
    items.removeAt(items.length() - 1)
  }

  fn clear(var self) {
    items.clear()
  }

  fn length(self): Int {
    items.length()
  }

  fn iterator(self): Iterator<T> {
    (0..length()).map { items[length() - 1 - _] }.iterator()
  }
}
