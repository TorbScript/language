use Hash from "../compare"
use Indexed, MutableIndexed from "../operators"
use From from "../convert"
use Collection, MutableCollection from "./collection"

// --- Traits ------------------------------------------------------------------------------------------

/**
 * Any map. Whether it is a value or somebody's mutable object is unknown, so it can only be read.
 * As a collection it consists of `(key, value)` tuples.
 */
public trait MapView<Key, Value>
  with Collection<(Key, Value)>, Indexed<Key, Value>
{
  fn containsKey(self, key: Key): Bool {
    get(key).isSome()
  }

  fn keys(self): Iterable<Key> {
    map { entry => entry.0 }
  }

  fn values(self): Iterable<Value> {
    map { entry => entry.1 }
  }
}

/**
 * Persistent mapping from keys to values. This is the type of the literal `["a": 1, "b": 2]`.
 *
 * The trait asks nothing of `Key`. What a key has to be able to do is a matter of the implementation
 * (`TrieMap` needs `Hash`, a sorted map needs `Compare`), so only the factories carry a bound.
 */
public trait Map<Key, Value>
  with MapView<Key, Value>
{
  /** `Map.of(("a", 1), ("b", 2))` */
  fn of(...entries: (Key, Value)): Map<Key, Value> where Key: Hash {
    TrieMap.from(entries)
  }

  fn set(self, key: Key, value: Value): Map<Key, Value>
  fn remove(self, key: Key): Map<Key, Value>

  fn merge(self, other: Iterable<(Key, Value)>): Map<Key, Value> {
    other.fold(self) { result, entry => result.set(entry.0, entry.1) }
  }

  fn mapValues<U>(self, transform: (value: Value) => U): Map<Key, U> where Key: Hash {
    Map.from(map { entry => (entry.0, transform(entry.1)) })
  }
}

extend<Key: Hash, Value> Map<Key, Value> with From<Iterable<(Key, Value)>> {
  fn from(entries: Iterable<(Key, Value)>): Map<Key, Value> {
    TrieMap.from(entries)
  }
}

/** Mapping that is changed in place. `add((key, value))` is `set(key, value)`. */
public trait MutableMap<Key, Value>
  with MapView<Key, Value>, MutableCollection<(Key, Value)>, MutableIndexed<Key, Value>
{
  fn of(...entries: (Key, Value)): MutableMap<Key, Value> where Key: Hash {
    HashMap.from(entries)
  }

  fn remove(var self, key: Key): Value?

  fn add(var self, entry: (Key, Value)) {
    set(entry.0, entry.1)
  }

  /** `cache.getOrSet(key) { expensive(key) }` */
  fn getOrSet(var self, key: Key, create: () => Value): Value {
    if const Some(existing) = get(key) {
      return existing
    }
    const value = create()
    set(key, value)
    value
  }

  /** The snapshot: a value that nobody can change anymore. */
  fn toMap(self): Map<Key, Value> where Key: Hash {
    Map.from(self)
  }
}

extend<Key: Hash, Value> MutableMap<Key, Value> with From<Iterable<(Key, Value)>> {
  fn from(entries: Iterable<(Key, Value)>): MutableMap<Key, Value> {
    HashMap.from(entries)
  }
}

// --- Implementations -----------------------------------------------------------------------------------

/** Hash array mapped trie. Iterates in insertion order. */
public native type TrieMap<Key: Hash, Value>
  with Map<Key, Value>, From<Iterable<(Key, Value)>>
{
  native fn from(entries: Iterable<(Key, Value)>): TrieMap<Key, Value>

  native fn length(self): Int
  native fn get(self, key: Key): Value?
  native fn iterator(self): Iterator<(Key, Value)>

  native fn set(self, key: Key, value: Value): Map<Key, Value>
  native fn remove(self, key: Key): Map<Key, Value>
}

/** Hash table. Iterates in insertion order. */
public native var type HashMap<Key: Hash, Value>
  with MutableMap<Key, Value>, From<Iterable<(Key, Value)>>
{
  native fn from(entries: Iterable<(Key, Value)>): HashMap<Key, Value>
  native fn withCapacity(capacity: Int): HashMap<Key, Value>

  native fn length(self): Int
  native fn get(self, key: Key): Value?
  native fn iterator(self): Iterator<(Key, Value)>

  native fn set(var self, key: Key, value: Value)
  native fn remove(var self, key: Key): Value?
  native fn clear(var self)
}
