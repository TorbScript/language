use IndexOps, ArrayOps from "../array.trb"

trait MapOps<Key, Value>
with
  IndexOps<Key, Value>,
  ArrayOps<Value>
{
  containsKey(key: Key): bool
  set(key: Key, value: Value): void
  remove(key: Key): void
}

trait Map<Key, Value>
  with MapOps<Key, Value> {}

type HashMap<Key, Value> with Map<Key, Value>
  where Key implements Hash
{
  native {}
}

const type ArrayMap<Key, Value> with Map<Key, Value> {
  native {}
}

const type BTreeMap<Key, Value> with Map<Key, Value> {
  native {}
}
