use From from "../convert"
use Collection, MutableCollection from "./collection"

// --- Traits ------------------------------------------------------------------------------------------

/** Any queue, for reading. Iterates in the order of `dequeue`. */
public trait QueueView<T>
  with Collection<T>
{
  fn peek(self): T? {
    first()
  }
}

/**
 * Persistent FIFO queue.
 *
 *     var queue = Queue.of("first", "second")
 *     while const Some((next, rest)) = queue.dequeue() { ...; queue = rest }
 */
public trait Queue<T>
  with QueueView<T>
{
  fn of(...items: T): Queue<T> {
    ListQueue.from(items)
  }

  fn enqueue(self, value: T): Queue<T>

  /** The next element and the remaining queue, or `None` if the queue is empty. */
  fn dequeue(self): (T, Queue<T>)?
}

extend<T> Queue<T> with From<Iterable<T>> {
  fn from(items: Iterable<T>): Queue<T> {
    ListQueue.from(items)
  }
}

/**
 * FIFO queue that is changed in place - the one for work lists, schedulers and breadth-first searches.
 *
 *     var pending: MutableQueue<Job> = ArrayQueue()
 *     pending.enqueue(job)
 *     while const Some(next) = pending.dequeue() { ... }
 */
public trait MutableQueue<T>
  with QueueView<T>, MutableCollection<T>
{
  fn of(...items: T): MutableQueue<T> {
    var queue = ArrayQueue<T>()
    queue.addAll(items)
    queue
  }

  fn enqueue(var self, value: T)
  fn dequeue(var self): T?

  /** `add` is `enqueue`, so a queue can be filled like every other mutable collection. */
  fn add(var self, value: T) {
    enqueue(value)
  }
}

// --- Implementations, written in plain TorbScript ------------------------------------------------------------

/** Two-list "banker's queue". `enqueue` is O(1), `dequeue` is amortized O(1). */
public type ListQueue<T> with Queue<T>, From<Iterable<T>> {
  private front: List<T> = []    // Next elements to dequeue, in reverse order (last = next)
  private back: List<T> = []     // Newly enqueued elements

  fn from(items: Iterable<T>): ListQueue<T> {
    Self(back: items.toList())
  }

  fn enqueue(self, value: T): Queue<T> {
    copy(back: back.add(value))
  }

  fn dequeue(self): (T, Queue<T>)? {
    match (front, back) {
      ([], []) => None
      ([], _) => Self(front: back.reversed()).dequeue()
      _ => front.last().map { next => (next, copy(front: front.removeAt(front.length() - 1))) }
    }
  }

  fn length(self): Int {
    front.length() + back.length()
  }

  fn iterator(self): Iterator<T> {
    front.reversed().addAll(back).iterator()
  }
}

/** Ring buffer on top of `Array`. Nothing is moved and nothing is allocated until the buffer is full. */
public var type ArrayQueue<T> with MutableQueue<T> {
  private var slots: Array<T?> = Array.filled(16, None)
  private var head: Int = 0
  private var count: Int = 0

  fn enqueue(var self, value: T) {
    if count == slots.length() {
      grow()
    }
    slots[slot(count)] = Some(value)
    count = count + 1
  }

  fn dequeue(var self): T? {
    const next = slots[head]?            // Empty queue: the slot is `None`
    slots[head] = None                   // Release the value
    head = slot(1)
    count = count - 1
    Some(next)
  }

  fn clear(var self) {
    slots = Array.filled(16, None)
    head = 0
    count = 0
  }

  fn length(self): Int {
    count
  }

  fn iterator(self): Iterator<T> {
    (0..count).filterMap { slots[slot(_)] }.iterator()
  }

  private fn slot(self, offset: Int): Int {
    (head + offset) % slots.length()
  }

  private fn grow(var self) {
    var larger: Array<T?> = Array.filled(slots.length() * 2, None)
    for offset in 0..count {
      larger[offset] = slots[slot(offset)]
    }
    slots = larger
    head = 0
  }
}
