trait IndexOps<Key, Value> {
  get(index: Key): Value
  set(index: Key, value: Value): void
}

trait ArrayOps<Value> {
  length(): int
  contains(value: Value): bool
  indexOf(value: Value): int
}

const type Array<Value> {}

extend Array<Value> with IndexOps<int, Value> {
  native {}
}

extend Array<Value> with ArrayOps<Value> {
  native {}
}
