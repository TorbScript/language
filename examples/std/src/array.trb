use MutableIndexed from "./operators"
use ListView from "./collections/list"

/**
 * Fixed-size, mutable, contiguous memory. The low-level building block for the collections.
 * Application code usually wants `List` or `MutableList`.
 */
public native var type Array<T>
  with ListView<T>, MutableIndexed<Int, T>
{
  native fn filled(length: Int, value: T): Array<T>
  native fn from(items: Iterable<T>): Array<T>

  native fn copyTo(self, var target: Array<T>, offset: Int = 0)
  native fn resized(self, length: Int, fill: T): Array<T>
}
