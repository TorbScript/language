use Compare, Hash from "./compare"
use From from "./convert"
use Add from "./operators"
use Collector, groupingBy from "./collectors"
use Mapped, Filtered, FilterMapped, MappedWhile, FlatMapped, Taken, Skipped, TakenWhile, Zipped, Sorted from "./stages"

/** A cursor over a sequence. Iterators are stateful, so implementations are `var type`s. */
public trait Iterator<T> {
  fn next(var self): T?
}

public trait Length {
  fn length(self): Int

  fn isEmpty(self): Bool {
    length() == 0
  }

  fn isNotEmpty(self): Bool {
    !isEmpty()
  }
}

/**
 * Everything that works with `for ... in` and the spread operator (`...`). Only `iterator` is required.
 *
 * A pipeline has three parts, like in Java and Rust:
 *
 *     source            .filter { ... }.map { ... }.take(10)          .toList()
 *     any Iterable      lazy stages: nothing runs, nothing is stored   terminal operation: pulls the values through
 *
 * Stages are values (an `Iterable` again), so a pipeline can be passed around, extended and iterated more than once.
 * Where the values end up is decided by the terminal operation alone - usually `collect` with a `Collector`.
 */
public trait Iterable<T> {
  fn iterator(self): Iterator<T>

  // --- Lazy stages -----------------------------------------------------------------------------

  fn map<U>(self, transform: (value: T) => U): Iterable<U> {
    Mapped(self, transform)
  }

  fn filter(self, predicate: (value: T) => Bool): Iterable<T> {
    Filtered(self, predicate)
  }

  fn flatMap<U>(self, transform: (value: T) => Iterable<U>): Iterable<U> {
    FlatMapped(self, transform)
  }

  /** `map` and `filter` in one: keeps the values of all `Some`. The bridge for functions that return an Option. */
  fn filterMap<U>(self, transform: (value: T) => U?): Iterable<U> {
    FilterMapped(self, transform)
  }

  /** Like `filterMap`, but ends the pipeline at the first `None`. */
  fn mapWhile<U>(self, transform: (value: T) => U?): Iterable<U> {
    MappedWhile(self, transform)
  }

  fn take(self, amount: Int): Iterable<T> {
    Taken(self, amount)
  }

  fn skip(self, amount: Int): Iterable<T> {
    Skipped(self, amount)
  }

  fn takeWhile(self, predicate: (value: T) => Bool): Iterable<T> {
    TakenWhile(self, predicate)
  }

  fn zip<U>(self, other: Iterable<U>): Iterable<(T, U)> {
    Zipped(self, other)
  }

  /** `(0, first), (1, second), ...` */
  fn indexed(self): Iterable<(Int, T)> {
    Zipped(0.., self)
  }

  /** Lazy as a stage, but has to buffer all values as soon as it is iterated. */
  fn sortBy<K: Compare>(self, key: (value: T) => K): Iterable<T> {
    Sorted(self, key)
  }

  // --- Terminal operations ------------------------------------------------------------------------

  /** The general terminal operation. See `std/collectors`. */
  fn collect<Result>(self, collector: Collector<T, Result>): Result {
    var accumulator = collector.start()
    for value in self {
      accumulator.add(value)
    }
    accumulator.finish()
  }

  /**
   * Collects into whatever can be created from an Iterable: `.to<Set<Int>>()`, or
   * `const names: List<String> = pipeline.to()`. No special trait needed, this is plain `From<Iterable<T>>`.
   */
  fn to<Target: From<Iterable<T>>>(self): Target {
    Target.from(self)
  }

  fn toList(self): List<T> {
    to<List<T>>()
  }

  fn toSet(self): Set<T> where T: Hash {
    to<Set<T>>()
  }

  fn forEach(self, action: (value: T) => Void) {
    for value in self {
      action(value)
    }
  }

  fn fold<State>(self, initial: State, combine: (State, T) => State): State {
    var state = initial
    for value in self {
      state = combine(state, value)
    }
    state
  }

  /** Stops pulling as soon as a value is found. */
  fn find(self, predicate: (value: T) => Bool): T? {
    for value in self {
      if predicate(value) {
        return Some(value)
      }
    }
    None
  }

  fn first(self): T? {
    iterator().next()
  }

  fn any(self, predicate: (value: T) => Bool): Bool {
    find(predicate).isSome()
  }

  fn all(self, predicate: (value: T) => Bool): Bool {
    !any { !predicate(_) }
  }

  fn count(self): Int {
    fold(0) { total, _ => total + 1 }
  }

  fn sum(self): T where T: Add + From<Int> {
    fold(T.from(0)) { a, b => a + b }
  }

  /** Shorthand for `collect(groupingBy(key))` */
  fn groupBy<K: Hash>(self, key: (value: T) => K): Map<K, List<T>> {
    collect(groupingBy(key))
  }
}
