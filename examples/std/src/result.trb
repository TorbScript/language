use Show, From from "./convert"
use Iterable from "./iteration"

/**
 * The result of an operation that can fail.
 *
 * The postfix `?` operator unwraps `Ok` or returns the `Error` from the surrounding function.
 * If the error types differ, the error is converted with `From`.
 *
 * `map`, `flatMap`, `forEach` mean the same as everywhere else (see "One Vocabulary" in CONCEPT.md) and work
 * on the `Ok` side. A Result is a value, not a pipeline: they run immediately.
 */
public type Result<T, E> {
  case Ok(value: T)
  case Error(error: E)

  fn isOk(self): Bool {
    match self {
      Ok(_) => true
      Error(_) => false
    }
  }

  fn isError(self): Bool {
    !isOk()
  }

  fn map<U>(self, transform: (value: T) => U): Result<U, E> {
    match self {
      Ok(value) => Ok(transform(value))
      Error(error) => Error(error)
    }
  }

  fn mapError<F>(self, transform: (error: E) => F): Result<T, F> {
    match self {
      Ok(value) => Ok(value)
      Error(error) => Error(transform(error))
    }
  }

  fn flatMap<U>(self, transform: (value: T) => Result<U, E>): Result<U, E> {
    match self {
      Ok(value) => transform(value)
      Error(error) => Error(error)
    }
  }

  fn forEach(self, action: (value: T) => Void) {
    if const Ok(value) = self {
      action(value)
    }
  }

  fn toList(self): List<T> {
    ok().toList()
  }

  fn ok(self): T? {
    match self {
      Ok(value) => Some(value)
      Error(_) => None
    }
  }

  fn orElse(self, fallback: lazy T): T {
    match self {
      Ok(value) => value
      Error(_) => fallback
    }
  }

  fn expect(self, message: String): T where E: Show {
    match self {
      Ok(value) => value
      Error(error) => panic "{message}: {error}"
    }
  }
}

/**
 * All or the first error: `lines.map { Int.parse(_) }.to<Result<List<Int>, NumberParseError>>()`
 * Stops pulling at the first `Error`. This is what `traverse`/`sequence` is in languages with higher-kinded types.
 */
extend<T, E, Target: From<Iterable<T>>> Result<Target, E> with From<Iterable<Result<T, E>>> {
  fn from(value: Iterable<Result<T, E>>): Result<Target, E> {
    var failure: E? = None
    const target = Target.from(value.mapWhile { item =>
      match item {                       // The pipeline is lazy: this runs while `Target.from` pulls
        Ok(success) => Some(success)
        Error(error) => {
          failure = Some(error)
          None
        }
      }
    })
    match failure {
      Some(error) => Error(error)
      None => Ok(target)
    }
  }
}
