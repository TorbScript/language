/** Infallible conversion. Implement this one, `Into` comes for free. */
public trait From<T> {
  fn from(value: T): Self
}

public trait Into<T> {
  fn into(self): T
}

extend<T, U> T with Into<U> where U: From<T> {
  fn into(self): U {
    U.from(self)
  }
}

/** Fallible conversion. */
public trait TryFrom<T, E> {
  fn tryFrom(value: T): Result<Self, E>
}

/** Fallible conversion from text: `Int.parse "42"`, `Email.parse "info@example.test"` */
public trait Parse<E> {
  fn parse(text: String): Result<Self, E>
}

/** Used by string interpolation. Generated for every `type`. */
public trait Show {
  fn show(self): String
}
