/**
 * The closed data model that replaces reflection.
 * Formats (JSON, TOML, database rows, ...) are libraries over `Data` and never see types.
 */
public type Data {
  case Nothing
  case Boolean(value: Bool)
  case Integer(value: Int)
  case Number(value: Float)
  case Text(value: String)
  case Sequence(items: List<Data>)
  case Record(fields: Map<String, Data>)
  case Variant(name: String, fields: Map<String, Data>)

  /** `data.at("address", "city")` */
  fn at(self, ...path: String): Data? {
    path.fold(Some(self)) { current, key =>
      match current {
        Some(Record(fields)) => fields.get(key)
        Some(Variant(_, fields)) => fields.get(key)
        _ => None
      }
    }
  }
}

public type DataError {
  case Missing(field: String)
  case Mismatch(expected: String, actual: Data)
  case Invalid(field: String, reason: String)
}

/** Generated for every `type` whose fields are all `ToData`. */
public trait ToData {
  fn toData(self): Data
}

/**
 * Generated for every `type` whose constructor is usable from outside and whose fields are all `FromData`.
 * Types with a private constructor write it by hand, so their invariants hold for decoded values, too.
 */
public trait FromData {
  fn fromData(data: Data): Result<Self, DataError>
}

// --- The leaves, written by hand ---------------------------------------------------------

extend Bool with ToData, FromData {
  fn toData(self): Data { Boolean(self) }

  fn fromData(data: Data): Result<Bool, DataError> {
    match data {
      Boolean(value) => Ok(value)
      other => Error(Mismatch("Boolean", other))
    }
  }
}

extend Int64 with ToData, FromData {
  fn toData(self): Data { Integer(self) }

  fn fromData(data: Data): Result<Int64, DataError> {
    match data {
      Integer(value) => Ok(value)
      other => Error(Mismatch("Integer", other))
    }
  }
}

extend Float64 with ToData, FromData {
  fn toData(self): Data { Number(self) }

  fn fromData(data: Data): Result<Float64, DataError> {
    match data {
      Number(value) => Ok(value)
      Integer(value) => Ok(Float64.from(value))
      other => Error(Mismatch("Number", other))
    }
  }
}

extend String with ToData, FromData {
  fn toData(self): Data { Text(self) }

  fn fromData(data: Data): Result<String, DataError> {
    match data {
      Text(value) => Ok(value)
      other => Error(Mismatch("Text", other))
    }
  }
}

// --- Containers: conditional implementations ------------------------------------------------

extend<T> Option<T> with ToData where T: ToData {
  fn toData(self): Data {
    match self {
      Some(value) => value.toData()
      None => Nothing
    }
  }
}

extend<T> Option<T> with FromData where T: FromData {
  fn fromData(data: Data): Result<T?, DataError> {
    match data {
      Nothing => Ok(None)
      other => T.fromData(other).map { Some(_) }
    }
  }
}

extend<T> List<T> with ToData where T: ToData {
  fn toData(self): Data {
    Sequence(map { _.toData() }.toList())
  }
}

extend<T> List<T> with FromData where T: FromData {
  fn fromData(data: Data): Result<List<T>, DataError> {
    match data {
      Sequence(items) => items.fold(Ok([])) { result, item => Ok(result?.add(T.fromData(item)?)) }
      other => Error(Mismatch("Sequence", other))
    }
  }
}

extend<V> Map<String, V> with ToData where V: ToData {
  fn toData(self): Data {
    Record(mapValues { _.toData() })
  }
}
