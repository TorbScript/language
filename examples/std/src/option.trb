use Result from "./result"
use From from "./convert"
use Iterable from "./iteration"

/**
 * A value that may be absent. `T?` is sugar for `Option<T>`.
 *
 * `map`, `flatMap`, `filter`, `forEach` mean the same as everywhere else (see "One Vocabulary" in CONCEPT.md).
 * An Option is a value, not a pipeline: they run immediately.
 */
public type Option<T> {
  case Some(value: T)
  case None

  fn isSome(self): Bool {
    match self {
      Some(_) => true
      None => false
    }
  }

  fn isNone(self): Bool {
    !isSome()
  }

  fn map<U>(self, transform: (value: T) => U): U? {
    match self {
      Some(value) => Some(transform(value))
      None => None
    }
  }

  fn flatMap<U>(self, transform: (value: T) => U?): U? {
    match self {
      Some(value) => transform(value)
      None => None
    }
  }

  fn filter(self, predicate: (value: T) => Bool): T? {
    match self {
      Some(value) if predicate(value) => self
      _ => None
    }
  }

  fn forEach(self, action: (value: T) => Void) {
    if const Some(value) = self {
      action(value)
    }
  }

  /** Into the world of pipelines: a list with no or one element. */
  fn toList(self): List<T> {
    match self {
      Some(value) => [value]
      None => []
    }
  }

  /** The `??` operator. The fallback is only evaluated when needed. */
  fn orElse(self, fallback: lazy T): T {
    match self {
      Some(value) => value
      None => fallback
    }
  }

  fn okOr<E>(self, error: lazy E): Result<T, E> {
    match self {
      Some(value) => Ok(value)
      None => Error(error)
    }
  }

  /** For cases where absence is a bug. */
  fn expect(self, message: String): T {
    match self {
      Some(value) => value
      None => panic message
    }
  }
}

/**
 * All or nothing: `names.map { findUser(_) }.to<List<User>?>()` is `Some(users)` if every user was found.
 * Stops pulling at the first `None`.
 */
extend<T, Target: From<Iterable<T>>> Option<Target> with From<Iterable<T?>> {
  fn from(value: Iterable<T?>): Target? {
    var complete = true
    const target = Target.from(value.mapWhile { item =>
      complete = item.isSome()           // The pipeline is lazy: this runs while `Target.from` pulls
      item
    })
    if complete { Some(target) } else { None }
  }
}
