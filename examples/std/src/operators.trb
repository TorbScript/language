/** `a + b` */
public trait Add<Rhs = Self, Output = Self> {
  fn add(self, other: Rhs): Output
}

/** `a - b` */
public trait Subtract<Rhs = Self, Output = Self> {
  fn subtract(self, other: Rhs): Output
}

/** `a * b` */
public trait Multiply<Rhs = Self, Output = Self> {
  fn multiply(self, other: Rhs): Output
}

/** `a / b` */
public trait Divide<Rhs = Self, Output = Self> {
  fn divide(self, other: Rhs): Output
}

/** `a % b` */
public trait Remainder<Rhs = Self, Output = Self> {
  fn remainder(self, other: Rhs): Output
}

/** `-a` */
public trait Negate {
  fn negate(self): Self
}

/** `a[key]` */
public trait Indexed<Key, Value> {
  fn get(self, key: Key): Value?

  /** `a[key]` panics if the key does not exist. Use `get` if absence is expected. */
  fn at(self, key: Key): Value {
    get(key).expect("Key does not exist")
  }
}

/** `a[key] = value` */
public trait MutableIndexed<Key, Value> with Indexed<Key, Value> {
  fn set(var self, key: Key, value: Value)
}
