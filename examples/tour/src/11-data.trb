// Types and values are strictly separate: there is no runtime reflection.
// What reflection is usually needed for is covered by the generated traits `Encode` and `Decode`.

use Json, JsonValue, JsonError from "std/json"

type ParseError {
  message: String
}

// Private constructor: `Email` has an invariant, so `Decode` is NOT generated. It is written by hand
// and goes through `parse` - a decoded Email is as valid as any other.
type Email {
  private value: String

  fn parse(text: String): Result<Email, ParseError> {
    if !text.contains("@") {
      return Error(ParseError("'{text}' is not an email address"))
    }
    Ok(Self(text.toLowerCase()))
  }
}

extend Email with Encode, Decode {
  fn encode(self, var encoder: Encoder) {
    encoder.string(value)                // An Email is a string on the wire, not a record with one field
  }

  fn decode(var decoder: Decoder): Result<Email, DecodeError> {
    const text = decoder.string()?
    Email.parse(text).mapError { DecodeError(_.message) }
  }
}

type Role {
  case Admin
  case Member(since: Int)
}

// Public constructor, all fields are Encode/Decode: both traits are generated.
type User {
  name: String
  email: Email
  role: Role = Member(since: 2026)
  tags: List<String> = []
}

const user = User("Ada", Email.parse("ada@example.test")?, tags: ["math"])

// --- Formats are ordinary libraries: implementations of `Encoder` and `Decoder` ------------------------

const text = Json.encode(user)
print text    // {"name":"Ada","email":"ada@example.test","role":{"Member":{"since":2026}},"tags":["math"]}

// Raw strings (`r"..."`) do not interpolate, so braces need no escaping
match Json.decode<User>(r"""{"name": "Grace", "email": "not-an-email"}""") {
  Ok(decoded) => print "Hello {decoded.name}"
  Error(error) => print "Rejected: {error}"          // Rejected: email: 'not-an-email' is not an email address
}

// This is what the compiler generates for `User`. Nothing in it is special, it could be written by hand:
//
//   fn encode(self, var encoder: Encoder) {
//     encoder.record("User") { fields =>
//       fields.field("name", name)
//       fields.field("email", email)
//       fields.field("role", role)
//       fields.field("tags", tags)
//     }
//   }
//
//   fn decode(var decoder: Decoder): Result<User, DecodeError> {
//     decoder.record("User") { fields =>
//       Ok(User(
//         name: fields.field("name")?,
//         email: fields.field("email")?,
//         role: fields.fieldOr("role", Member(since: 2026))?,
//         tags: fields.fieldOr("tags", [])?,
//       ))
//     }
//   }

// --- A different wire format: write the functions by hand, there are no annotations -------------

type LegacyUser {
  name: String
  mail: String
}

extend LegacyUser with Decode {
  fn decode(var decoder: Decoder): Result<LegacyUser, DecodeError> {
    decoder.record("LegacyUser") { fields =>
      const contact: LegacyContact = fields.field("contact")?
      Ok(LegacyUser(name: fields.field("user_name")?, mail: contact.mail))
    }
  }
}

type LegacyContact {
  mail: String
}

extend LegacyContact with Decode {
  fn decode(var decoder: Decoder): Result<LegacyContact, DecodeError> {
    decoder.record("LegacyContact") { fields =>
      Ok(LegacyContact(mail: fields.field("e_mail")?))
    }
  }
}

// --- When you want to look at a document without knowing its type: that is a library type ------------------

// `JsonValue` is an ordinary ADT of std/json (and `Encode`/`Decode` itself). Nothing in the language knows it.
fn diff(before: JsonValue, after: JsonValue, path: String = ""): List<String> {
  match (before, after) {
    // Directly inside of a `match`, a line that starts with `.` is the next arm: a chain goes into a block
    (.Object(a), .Object(b)) => {
      a.keys().toSet().union(b.keys())
        .flatMap { key => diff(a.get(key) ?? .Null, b.get(key) ?? .Null, "{path}/{key}") }
        .toList()
    }
    (a, b) if a == b => []
    _ => ["{path}: {before} -> {after}"]
  }
}

const renamed = user.copy(name: "Ada Lovelace", tags: ["math", "engines"])
for change in diff(Json.value(user), Json.value(renamed)) {
  print change
}

// For messages and debugging every `Encode` value can be described
print describe(user)                     // User(name: "Ada", email: "ada@example.test", role: Member(since: 2026), tags: ["math"])
