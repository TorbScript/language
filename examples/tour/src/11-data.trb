/**
 * Data without reflection: `Encode`/`Decode` generated from a public constructor, written by hand where an
 * invariant or an older wire format needs it, and `JsonValue` for looking at a document without a type.
 */

// Types and values are strictly separate: there is no runtime reflection.
// What reflection is usually needed for is covered by the generated traits `Encode`, `Decode` and `Describe`.

use Json, JsonValue, JsonError from "std/json"
use structureOf from "std/encoding"

/** Why [Email.tryFrom] refused a value. */
type ParseError {
  message: String
}

// Private constructor: `Email` has an invariant, so `Decode` is NOT generated. It is written by hand
// and goes through `tryFrom` - a decoded Email is as valid as any other.
/** An email address with a private constructor: `Decode` is written by hand and goes through `tryFrom`. */
type Email with TryFrom<String, ParseError> {
  private value: String

  static fn tryFrom(value: String): Result<Email, ParseError> {
    if !value.contains("@") {
      return Fail ParseError("'{value}' is not an email address")
    }
    Ok Self(value.toLowerCase())
  }
}

/** An Email is a plain string on the wire, not a record with one field. */
extend Email with Encode, Decode {
  fn encode<Target: Encoder>(var target: Target) {
    target.string value                 // An Email is a string on the wire, not a record with one field
  }

  static fn decode<Source: Decoder>(var source: Source): Result<Email, DecodeError> {
    const text = source.string()?
    Email.tryFrom(text).mapError { DecodeError _.message }
  }
}

/** A user's role: an admin, or a member since a given year. */
type Role {
  case Admin
  case Member(since: Int)
}

// Public constructor, all fields are Encode/Decode: all three forms are generated.
/** A user with a public constructor and only `Encode`/`Decode`-able fields, so both traits are generated. */
type User {
  name: String
  email: Email
  role: Role = .Member(since: 2026)
  tags: List<String> = []
}

const user = User("Ada", Email.tryFrom("ada@example.test")?, tags: ["math"])

// --- Formats are ordinary libraries: implementations of `Encoder` and `Decoder` ------------------------

const json = Json()
const text = json.encode user
print text    // {"name":"Ada","email":"ada@example.test","role":{"Member":{"since":2026}},"tags":["math"]}

// Raw strings (`r"..."`) do not interpolate, so braces need no escaping
match json.decode<User>(r"""{"name": "Grace", "email": "not-an-email"}""") {
  Ok(decoded) => print "Hello {decoded.name}"
  Fail(error) => print "Rejected: {error}"          // Rejected: email: 'not-an-email' is not an email address
}

// A convention of the format is an option of the format, never a word on the type
/** A setting whose field names are two words, to show the naming option of the format. */
type Setting {
  logLabel: String
  maximumSize: Int = 10
}

const snake = Json naming: .SnakeCase
print snake.encode(Setting("audit"))                                  // {"log_label":"audit","maximum_size":10}
print snake.decode<Setting>(r"""{"log_label": "trace"}""")          // Ok(Setting(logLabel: "trace", maximumSize: 10))

// This is what the compiler generates for `User`. Nothing in it is special, it could be written by hand:
//
//   fn encode<Target: Encoder>(var target: Target) {
//     target.record "torbscript/example-tour/11-data/User"
//     target.field "name"
//     name.encode target
//     target.field "email"
//     email.encode target
//     ...
//     target.finish()
//   }
//
// and `decode` reads the same fields back, taking the default where one is missing.

// --- A different wire format: write the functions by hand, there are no annotations -------------

/** The shape this program works with; the wire format it decodes from is older and nests the mail under `contact`. */
type LegacyUser {
  name: String
  mail: String
}

/** Reads the `LegacyUser` shape by hand: there is no annotation to bridge `mail` and the nested `contact.e_mail`. */
extend LegacyUser with Decode {
  static fn decode<Source: Decoder>(var source: Source): Result<LegacyUser, DecodeError> {
    source.record("LegacyUser")?
    if !source.field("user_name")? {
      return Fail DecodeError("a value is needed").inside("user_name")
    }
    const name = source.string()?
    if !source.field("contact")? {
      return Fail DecodeError("a value is needed").inside("contact")
    }
    const contact = LegacyContact.decode(source)?
    source.finish()?
    Ok LegacyUser(name: name, mail: contact.mail)
  }
}

/** The nested `contact` object of this older wire format. */
type LegacyContact {
  mail: String
}

/** Reads the field name this older format actually uses: `e_mail`, not `mail`. */
extend LegacyContact with Decode {
  static fn decode<Source: Decoder>(var source: Source): Result<LegacyContact, DecodeError> {
    source.record("LegacyContact")?
    if !source.field("e_mail")? {
      return Fail DecodeError("a value is needed").inside("e_mail")
    }
    const mail = source.string()?
    source.finish()?
    Ok LegacyContact(mail: mail)
  }
}

const legacy = json.decode<LegacyUser>(r"""{"user_name": "Linus", "contact": {"e_mail": "linus@example.test"}}""")
print legacy                                          // Ok(LegacyUser(name: "Linus", mail: "linus@example.test"))

// --- When you want to look at a document without knowing its type: that is a library type ------------------

// `JsonValue` is an ordinary ADT of std/json. Nothing in the language knows it.
/** The paths where two JSON documents differ, recursing into objects and stopping where values are already equal. */
fn diff(before: JsonValue, after: JsonValue, path: String = ""): List<String> {
  match (before, after) {
    // Directly inside of a `match`, a line that starts with `.` is the next arm: a chain goes into a block
    (.Object(a), .Object(b)) => {
      a.keys().toSet().union(b.keys())
        .flatMap { key => diff(a.get(key) ?? .Null, b.get(key) ?? .Null, "{path}/{key}") }
        .toList()
    }
    (a, b) if a == b => []
    _ => ["{path}: {before} -> {after}"]
  }
}

const renamed = user.copy name: "Ada Lovelace", tags: ["math", "engines"]
for change in diff(json.value(user), json.value(renamed)) {
  print change
}

// For messages and debugging every `Encode` value can be rendered
print rendered(user)                     // User(name: "Ada", email: "ada@example.test", role: Member(since: 2026), tags: ["math"])

// And every type describes itself without a value: what a schema, a table or a `--help` text is built from
print structureOf<Setting>()
