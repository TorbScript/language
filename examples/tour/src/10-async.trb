// DRAFT - see "Concurrency" in CONCEPT.md

use * as http from "std/http"
use HttpError from "std/http"
use sleep from "std/time"

type User {
  id: Int
  name: String
}

type Post {
  title: String
}

// There is no `async` keyword. A function that returns a `Task` may `await()`, and its body produces the value.
// `await()` is a method on Task and composes with `?`.
fn fetchUser(id: Int): Task<Result<User, HttpError>> {
  // A `Response` owns one end of a stream and is read once, so it is a shared object in a `var` binding
  var response = http.get("https://example.test/users/{id}").await()?
  response.json<User>().await()
}

fn fetchPosts(userId: Int): Task<Result<List<Post>, HttpError>> {
  var response = http.get("https://example.test/users/{userId}/posts").await()?
  response.json<List<Post>>().await()
}

// Sequential
fn loadProfile(id: Int): Task<Result<String, HttpError>> {
  const user = fetchUser(id).await()?
  const posts = fetchPosts(user.id).await()?
  Ok "{user.name} wrote {posts.length()} posts"
}

// Concurrent: start both tasks, then wait for both
fn loadProfileFast(id: Int): Task<Result<String, HttpError>> {
  const (userResult, postsResult) = all(fetchUser(id), fetchPosts(id)).await()
  const user = userResult?
  const posts = postsResult?
  Ok "{user.name} wrote {posts.length()} posts"
}

// Parallel computation. Values are copied into tasks, which is cheap: slices and copies share their storage.
const numbers = List.from(1..=1_000_000)
const chunks = [numbers[0..500_000], numbers[500_000..]]

// Stages are lazy: without `toList()` nothing would be spawned until somebody iterates - one task at a time.
const tasks = chunks.map { chunk => spawn { chunk.sum() } }.toList()   // List<Task<Int>>, all running

// Channels connect tasks. A `Channel` is a `shared type`; other shared objects never cross task boundaries.
// It is a stream in memory, and one holder has both of its ends (see docs/STREAMS.md).
const channel = Channel<Int>(capacity: 10)

const producer = spawn {
  var writing = channel.sink()
  for i in 0..5 {
    writing.add(i).await()?
    sleep(0.1).await()
  }
  writing.finish().await()
}

// Collectors are push-based and shared between `Iterable` and `Source`, so the same `summing` works for values
// that arrive over time
const consumer = spawn {
  var reading = channel.source()
  reading.collect(summing { _ }).await()
}

// Top-level `await()` is allowed in entry files and scripts
const total = tasks.map { _.await() }.sum()
print "sum: {total}, consumed: {consumer.await().orElse(0)}, sent: {producer.await().isOk()}"

match loadProfile(1).await() {
  Ok(profile) => print profile
  Fail(error) => print "Failed: {error}"
}
