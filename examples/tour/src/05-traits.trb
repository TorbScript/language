/**
 * Traits: required and default methods, implementing at declaration or with `extend`, supertraits, bounds, traits
 * as types, and the built-in traits behind operators, `Equals`/`Hash`/`Show` and indexing.
 */

/** Something with an area and a name; `describe` is a default built out of both. */
trait Shape {
  fn area(): Float                   // Required

  fn describe(): String {            // Default implementation
    "{name()} with area {area()}"
  }

  fn name(): String
}

// Implement at the declaration...
/** Implements [Shape] at its own declaration. */
type Square with Shape {
  side: Float

  fn area(): Float { side * side }
  fn name(): String { "Square" }
}

/** A circle, with [Shape] implemented afterwards below instead of at the declaration. */
type Circle {
  radius: Float
}

// ...or afterwards
/** Implements [Shape] for a type that did not declare it itself. */
extend Circle with Shape {
  fn area(): Float { Float.pi * radius * radius }
  fn name(): String { "Circle" }
}

// Extension methods without a trait. Only visible where they are imported.
/** An extension method with no trait behind it: `shout` is visible only where this module is imported. */
extend String {
  fn shout(): String {
    "{toUpperCase()}!"
  }
}

print "hello".shout()

// Supertraits
/** Something with a name - the supertrait [Greeter] below builds a greeting out of it. */
trait Named {
  fn name(): String
}

/** Greets by name; `greet` is a default that needs nothing but [Named.name]. */
trait Greeter with Named {
  fn greet(): String {
    "Hello, {name()}"
  }
}

// Bounds: inline or with `where`
/** The largest area among `shapes`, for any item type that implements [Shape]. */
fn largestArea<Item: Shape>(shapes: List<Item>): Float {
  shapes.map { _.area() }.fold(0.0) { a, b => a.max b }
}

/** Prints `items` in sorted order, with the bound written as a `where` clause instead of inline. */
fn printSorted<Item>(items: List<Item>) where Item: Compare & Show {
  const sorted = items.sorted { _ }      // Not inside the `for` head: there a `{` starts the body
  for item in sorted {
    print item
  }
}

// A trait can be used as a type. The list can hold different shapes.
const shapes: List<Shape> = [Square(2.0), Circle(1.0)]
for shape in shapes {
  print shape.describe()
}

// Operators are traits
/** Operators are traits: implementing `Add`, `Subtract`, `Negate` and `Multiply` is what gives `+`, `-`, unary `-` and `*` a meaning. */
type Vector2 with Add, Subtract, Negate, Multiply<Float> {
  x: Float
  y: Float

  fn add(other: Vector2): Vector2 { Vector2(x + other.x, y + other.y) }
  fn subtract(other: Vector2): Vector2 { Vector2(x - other.x, y - other.y) }
  fn negate(): Vector2 { Vector2(-x, -y) }
  fn multiply(other: Float): Vector2 { Vector2(x * other, y * other) }
}

const v = (Vector2(1.0, 2.0) + Vector2(3.0, 4.0)) * 2.0
print(-v)                                // Vector2(x: -8.0, y: -12.0). `print -v` would be a subtraction.

// `Equals`, `Hash` and `Show` are generated for types, but can be written by hand
/** `Equals` and `Hash` are generated by default; here they are written by hand instead, so equality ignores case. */
type CaseInsensitive with Equals, Hash {
  text: String

  fn equals(other: CaseInsensitive): Bool {
    text.toLowerCase() == other.text.toLowerCase()
  }

  fn hash(): Int {
    text.toLowerCase().hash()
  }
}

// Generic extension with a condition
/** A generic extension with a condition: `totalArea` only exists on a `List` whose items implement [Shape]. */
extend<Item> List<Item> where Item: Shape {
  fn totalArea(): Float {
    map { _.area() }.sum()
  }
}

print([Square(1.0), Square(2.0)].totalArea())

// Indexing is a trait, too
/** Indexing is a trait too: `MutableIndexed` is what `grid[(1, 1)] = "x"` and reading `grid[(1, 1)]` call. */
type Grid<Cell> with MutableIndexed<(Int, Int), Cell> {
  width: Int
  private var cells: List<Cell>

  static fn filled(width: Int, height: Int, value: Cell): Grid<Cell> {
    Self width, List.filled(width * height, value)
  }

  fn get(key: (Int, Int)): Cell? {
    cells.get(key.1 * width + key.0)
  }

  var fn set(key: (Int, Int), value: Cell) {
    cells[key.1 * width + key.0] = value
  }
}

var grid = Grid.filled 3, 3, value: "."
grid[(1, 1)] = "x"
print grid[(1, 1)]
