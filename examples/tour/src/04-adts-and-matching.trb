/**
 * Algebraic data types and pattern matching: `case`, exhaustive `match`, guards, alternatives, ranges, list and
 * tuple patterns, and `if const` for testing a single case.
 */

// Variants are declared with `case` inside of a type
/** A shape is one of three cases; `area` matches on all of them, and `match` must cover every one. */
type Shape {
  case Circle(radius: Float)
  case Rectangle(width: Float, height: Float)
  case Empty

  fn area(self): Float {
    match self {
      .Circle(radius) => Float.pi * radius * radius
      .Rectangle(width, height) => width * height
      .Empty => 0.0
    }
  }
}

const shapes = [Shape.Circle(2.0), Shape.Rectangle(2.0, 3.0), Shape.Empty]
const unit: Shape = .Circle(1.0)         // Where the type is known, `.Case` is enough

// Generic and recursive ADTs
/** A binary search tree: `Leaf` or a `Node` with a left and right subtree, generic over its value. */
type Tree<Value> {
  case Leaf
  case Node(left: Tree<Value>, value: Value, right: Tree<Value>)

  fn inserted(self, item: Value): Tree<Value> where Value: Compare {
    match self {
      .Leaf => .Node(.Leaf, item, .Leaf)
      .Node(left, value, right) if item < value => .Node(left.inserted(item), value, right)
      .Node(left, value, right) if item > value => .Node(left, value, right.inserted(item))
      _ => self
    }
  }

  fn toList(self): List<Value> {
    match self {
      .Leaf => []
      .Node(left, value, right) => left.toList().added(value).addedAll(right.toList())
    }
  }
}

const tree = [5, 3, 8, 1].fold(Tree<Int>.Leaf) { result, n => result.inserted n }
print tree.toList()                      // [1, 3, 5, 8]

// `match` is an expression and must be exhaustive
/** Classifies `value` by a literal, alternatives (`|`), a range, and a guard, tried in that order. */
fn describe(value: Int): String {
  match value {
    0 => "zero"                          // Literal
    1 | 2 | 3 => "small"                 // Alternatives
    4..=9 => "medium"                    // Range
    n if n < 0 => "negative ({n})"       // Binding with guard
    _ => "large"                         // Wildcard
  }
}

// Tuples, types and nested patterns
/** A point, destructured by pattern below instead of read field by field. */
type Point {
  x: Int
  y: Int
}

/** Matches a tuple of `(shape, position)` at once, with a guard and a nested pattern on each side. */
fn locate(shape: Shape, position: Point): String {
  match (shape, position) {
    (.Empty, _) => "nothing anywhere"
    (_, Point(x: 0, y: 0)) => "something at the origin"
    (.Circle(r), Point(x, y)) if r > 10.0 => "a big circle at {x}/{y}"
    (_, Point(x, y)) => "something at {x}/{y}"
  }
}

// List patterns
/** A list pattern for each shape a list can have: empty, one item, two, or a first item with the rest. */
fn summarize(items: List<String>): String {
  match items {
    [] => "nothing"
    [only] => only
    [first, second] => "{first} and {second}"
    [first, ...rest] => "{first} and {rest.length()} more"
  }
}

// Patterns in bindings
const (quotient, remainder) = (7 / 2, 7 % 2)
const Point(x, y) = Point 3, 4

// Patterns in conditions
/** Looks `name` up in a tiny table of one, for `if const` below to match against. */
fn findShape(name: String): Shape? {
  match name {
    "unit" => Some unit
    _ => None
  }
}

if const Some(.Circle(radius)) = findShape("unit") {
  print "Found a circle with radius {radius}"
}

// A block body in a match arm
for shape in shapes {
  match shape {
    .Empty => print "skipped"
    other => {
      const area = other.area()
      print "area: {area}"
    }
  }
}
