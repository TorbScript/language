use Clock from "std/time"
use File from "std/fs"

const temperature = 23

// `if` is an expression
const feeling = if temperature < 10 {
  "cold"
} else if temperature < 25 {
  "pleasant"
} else {
  "hot"
}

// Loops
for i in 0..3 {
  print i
}

var attempts = 0
while attempts < 10 {
  attempts = attempts + 1
  if attempts % 2 == 0 {
    continue
  }
  if attempts > 6 {
    break
  }
  print "attempt {attempts}"
}

// `{ ... }` is a closure. `do` evaluates a block immediately. It is a function, not a keyword:
//   fn do<T>(body: () => T): T { body() }
const initialized = do {
  const base = [1, 2, 3]
  const extended = base.add(4).add(5)
  extended.remove(2)
}

// --- Control structures are just functions ------------------------------------------------

fn unless(condition: Bool, body: () => Void) {
  if !condition {
    body()
  }
}

fn repeat(times: Int, body: (index: Int) => Void) {
  for index in 0..times {
    body(index)
  }
}

fn measure<T>(label: String, body: () => T): T {
  const start = Clock.now()
  const result = body()
  print "{label} took {Clock.now() - start}"
  result
}

unless initialized.isEmpty() {           // The trailing closure belongs to `unless`, the outermost command
  print "not empty"
}

repeat 3 {
  print "iteration {index}"              // `repeat` names its closure parameter
}

const sorted = measure "sorting" {
  initialized.sortBy { -_ }
}

// From the standard library
const response = retry 3 {
  fetchStatus()
}

// A top-level `?` in a script ends the script with the error
const content = using File.open("notes.txt")? { file =>
  file.readAll()
}

// --- `lazy` parameters: evaluated at most once, and only if needed -------------------------

fn debug(enabled: Bool, message: lazy String) {
  if enabled {
    print "[debug] {message}"
  }
}

fn expensiveDump(): String {
  print "building the dump..."
  "state: {initialized}"
}

debug(false, expensiveDump())            // `expensiveDump` is never called
debug(true, expensiveDump())

const missing: String? = None
const fallback = missing ?? expensiveDump()   // `??` is `Option.orElse(fallback: lazy T)`

// Helpers for this example
fn fetchStatus(): Result<Int, String> {
  Ok(200)
}
