/**
 * Control flow: `if`/`for`/`while` as expressions and loops, `do` for an immediate block, control structures
 * written as ordinary functions, and `lazy` parameters evaluated at most once and only when needed.
 */

use Clock from "std/time"
use File from "std/fs"

const temperature = 23

// `if` is an expression
const feeling = if temperature < 10 {
  "cold"
} else if temperature < 25 {
  "pleasant"
} else {
  "hot"
}

// Loops
for i in 0..3 {
  print i
}

var attempts = 0
while attempts < 10 {
  attempts = attempts + 1
  if attempts % 2 == 0 {
    continue
  }
  if attempts > 6 {
    break
  }
  print "attempt {attempts}"
}

// `{ ... }` is a closure. `do` evaluates a block immediately. It is a function, not a keyword:
//   fn do<Value>(body: () => Value): Value { body() }
const initialized = do {
  const base = [1, 2, 3]
  const extended = base.added(4).added(5)
  extended.removed 2
}

// --- Control structures are just functions ------------------------------------------------

/** `if` inverted, written as an ordinary function: a new control structure needs no keyword. */
fn unless(condition: Bool, body: () => Void) {
  if !condition {
    body()
  }
}

/** Calls `body` `times` times with the index - `repeat 3 { ... }` reads like a loop but is a function call. */
fn repeat(times: Int, body: (index: Int) => Void) {
  for index in 0..times {
    body index
  }
}

/** Runs `body`, prints how long it took, and returns its result unchanged. */
fn measure<Value>(label: String, body: () => Value): Value {
  const start = Clock.now()
  const result = body()
  print "{label} took {Clock.now() - start}"
  result
}

unless initialized.isEmpty() {           // The trailing closure belongs to `unless`, the outermost command
  print "not empty"
}

repeat 3 {
  print "iteration {index}"              // `repeat` names its closure parameter
}

const sorted = measure "sorting" {
  initialized.sorted { -_ }
}

// From the standard library
const response = retry 3 {
  fetchStatus()
}

// A top-level `?` in a script ends the script with the error
const content = using(File.open("notes.txt")?) { file =>
  file.readAll()
}

// --- `lazy` parameters: evaluated at most once, and only if needed -------------------------

/** Prints `message` if `enabled`; `lazy` means the argument is evaluated only when it is actually needed. */
fn debug(enabled: Bool, message: lazy String) {
  if enabled {
    print "[debug] {message}"
  }
}

/** A `lazy` argument for the calls below: the print inside shows exactly when it does or does not run. */
fn expensiveDump(): String {
  print "building the dump..."
  "state: {initialized}"
}

debug false, expensiveDump()            // `expensiveDump` is never called
debug true, expensiveDump()

const missing: String? = None
const fallback = missing ?? expensiveDump()   // `??` is `Option.orElse(fallback: lazy Value)`

// Helpers for this example
/** A stand-in status check for the `retry` example above. */
fn fetchStatus(): Result<Int, String> {
  Ok 200
}
