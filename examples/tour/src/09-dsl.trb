/**
 * Receiver closures: a closure whose first parameter is `self` resolves names against it, exactly like inside a
 * method. Builds an HTML DSL and a property-command config below, both without any special syntax of their own.
 */

// A receiver closure is a closure whose first parameter is called `self`.
// Inside of it, names resolve against the receiver - exactly like inside of a method.

// --- An HTML builder -----------------------------------------------------------------

/** A builder for one HTML element: attributes and children are added by calling methods on the receiver. */
type Element {
  tag: String
  private var attributes: Map<String, String> = [:]
  private var children: List<Node> = []

  var fn attribute(name: String, value: String) {
    attributes[name] = value
  }

  var fn text(content: String) {
    children.append Node.Text(content)
  }

  // One generic child function...
  var fn element(tag: String, build: (var self: Self) => Void) {
    var child = Self tag
    build child                         // The receiver is passed as the first argument and changed in place
    children.append Node.Child(child)
  }

  // ...and some vocabulary on top of it
  var fn div(build: (var self: Self) => Void) { element "div", build }
  var fn ul(build: (var self: Self) => Void) { element "ul", build }
  var fn li(build: (var self: Self) => Void) { element "li", build }
  var fn h1(content: String) { element "h1" { text content } }

  fn render(indent: String = ""): String {
    const attributeText = attributes.map { entry => " {entry.key}=\"{entry.value}\"" }.joined()
    const inner = children.map { _.render(indent + "  ") }.joined(separator: "\n")
    "{indent}<{tag}{attributeText}>\n{inner}\n{indent}</{tag}>"
  }
}

/** A child of an [Element]: either text or another element. */
type Node {
  case Text(content: String)
  case Child(element: Element)

  fn render(indent: String): String {
    match self {
      .Text(content) => "{indent}{content}"
      .Child(element) => element.render indent
    }
  }
}

/** Builds a page by running `build` against a fresh root `Element`. */
fn html(build: (var self: Element) => Void): Element {
  var root = Element "html"
  build root
  root
}

const features = ["functional-first", "statically typed", "its own config format"]

const page = html {
  div {
    attribute "class", "content"
    h1 "TorbScript"
    ul {
      for feature in features {          // It is just code: loops, conditions, functions
        li { text feature }
      }
    }
  }
}

print page.render()

// --- Property commands ----------------------------------------------------------------
// A field is written only with `=`: `port = 8080`, `onStart = { ... }`. The one property command left is a trailing
// block on a field whose value is a record - `limits { ... }` applies the receiver closure to the field's value,
// configuring it in place. No setters, no section methods.

/** The `limits { }` section of a [ServerOptions]. */
type Limits {
  var maxConnections: Int = 100
  var timeoutSeconds: Int = 30
}

/** The receiver `serve` configures: every field is set with `=`, and a record field's block configures it in place. */
type ServerOptions {
  var host: String = "localhost"
  var port: Int = 8080
  var tls: Bool = false
  var limits: Limits = Limits()
  var onStart: () => Void = {}
}

/** Builds a [ServerOptions] by running `configure` against a fresh one. */
fn serve(configure: (var self: ServerOptions) => Void): ServerOptions {
  var options = ServerOptions()
  configure options
  options
}

const options = serve {
  host = "0.0.0.0"
  port = 8443
  tls = port == 8443                     // Fields are readable, too
  limits {
    maxConnections = 500
  }
  onStart = { print "started" }          // Calling a function in a field still needs `()`
}
options.onStart()

// --- Only the innermost receiver is implicit ---------------------------------------------

const explicit = html { root =>          // Naming the parameter gives the receiver a name
  root.attribute "lang", "en"
  root.div {
    text "inside the div"                // `self` is the div
    // attribute "lang", "en"            // Would set the attribute on the div
    // root.attribute "lang", "en"       // Compile error: `root` is being changed by `div` right now
  }
}
