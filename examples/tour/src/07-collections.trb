/**
 * Collections: persistent `List`/`Map`/`Set` values plus mutable `HashMap`/`Stack`/`Queue`, slices, `Iterate` for
 * a type of your own, and the pipeline of lazy stages, terminal operations and collectors that queries them.
 */

use File from "std/fs"

// --- Collections are values: the binding decides about mutation ------------------

const numbers = [1, 2, 3]                // List<Int>
var buffer = numbers                     // A copy. (The storage is shared until one of them is written to.)
buffer.append 4
buffer[0] = 10
print numbers                            // [1, 2, 3]
print buffer                             // [10, 2, 3, 4]
// numbers.append(4)                     // Compile error: `append` needs a `var`. Did you mean `appended`?

// Verbs change in place, their participles return a changed copy and work everywhere
const more = numbers.appended(4).appended(5).removed(2)      // [1, 3, 4, 5]

var ages = ["Ada": 36, "Grace": 45]      // Map<String, Int>
ages["Linus"] = 28
ages.remove "Ada"
const younger = ages.updated "Grace", 44              // The participle of `set` is `set`, so: `updated`

// Set operations are nouns. They never change anything.
const primes = Set.of 2, 3, 5, 7
const evenPrimes = primes.intersection Set.of(2, 4, 6)

var cache: Map<Int, String> = [:]
const label = cache.getOrInsert 42, "stored once"    // The fallback is `lazy`: only built on a miss
var groups: Map<Int, List<String>> = [:]
groups.update 1, [] { names => names.append "Ada" }    // The one that changes what is stored, in place
print "{label} {groups}"

// Creation
const a = List.of 1, 2, 3
const b = List.of(...primes)             // Spread any Iterate
const c = List.from primes
const d = primes.toList()
const nested = List.of([1, 2], [3])      // List<List<Int>>: variadics never unpack implicitly

// A literal adapts to what is expected of it: an `Array` is filled inline (no list, no iterator in between), and any
// `From<Iterate<Item>>` target is built from the list - the same targets `to<Target>()` accepts.
const corners: Array<Int, 4> = [1, 2, 3, 4]           // Exactly 4 items, or a compile error
const wider: Array<Int, 6> = [...corners, 5, 6]       // A spread of another Array: the sizes add up to 6
const ramp: Array<Int, 4> = Array.generated { _ * 2 } // Every slot from its index; `Size` from the annotation
const unique: Set<Int> = [1, 2, 2, 3]                 // Set.from([1, 2, 2, 3]) - {1, 2, 3}

// --- Traits in signatures, implementations at construction -------------------------------------

// `List`, `Set`, `Map`, `Stack` and `Queue` are traits. Literals and factories pick the default implementation,
// a different one is chosen where the value is constructed.
var index: Map<String, Int> = HashMap()  // Flat hash table instead of the default trie

// Without `var` a parameter is read-only. Any map will do, and nobody can change it while you hold it.
/** Greets `name` by its title in `titles`, or "dear" if it has none. Any `Map` implementation works here. */
fn greet(name: String, titles: Map<String, String>): String {
  const title = titles.get(name) ?? "dear"
  "Hello {title} {name}"
}

print greet("Ada", titles: ["Ada": "Countess"])

// Less specific: `Iterate<Item> & Length` accepts every kind - a signature asks for the smallest thing it uses
/** How many items `items` has - a `List`, a `Set` or a `Map` alike. */
fn describe<Item>(items: Iterate<Item> & Length): String {
  if items.isEmpty() { "nothing" } else { "{items.length()} items" }
}

print describe(numbers)
print describe(ages)                     // A Map iterates over (key, value) tuples

// A `var` parameter works on the caller's collection, whatever implementation it is
/** Inserts the squares up to `upTo` into `target`, whichever kind of set the caller passes. */
fn insertSquares(var target: Set<Int>, upTo: Int) {
  target.insertAll((1..=upTo).map { _ * _ })
}

var squares = Set.of 2
insertSquares squares, upTo: 3
print describe(squares)                 // 4 items - the caller's set really grew

// --- Slices -------------------------------------------------------------------------------------

var samples = [5, 3, 9, 1, 7, 2]
const middle = samples[1..4]             // [3, 9, 1] - shares the storage, starts at index 0 again
samples[0] = 0
print middle                             // Still [3, 9, 1]: a slice is a value, not a window

samples[1..4].sort { _ }                 // A range is a `var` path, too: sorts this part in place
print samples                            // [0, 1, 3, 9, 7, 2]

/** Overwrites every item of `target` with zero; a slice like `samples[0..2]` is a `var` path too. */
fn fillWithZeros(var target: List<Int>) {
  for index in 0..target.length() {
    target[index] = 0
  }
}

fillWithZeros samples[0..2]             // Works on this part of the caller's list

// --- Iteration ----------------------------------------------------------------------

for number in numbers {
  print number
}

for (name, age) in ages {                // Maps iterate over (key, value) tuples
  print "{name} is {age}"
}

for i in 0..numbers.length() {
  print "{i}: {numbers[i]}"
}

// Your own types take part by implementing `Iterate`
/** The state of one countdown in progress: an `Iterator<Int>` that counts down to zero and then stops. */
type CountdownIterator with Iterator<Int> {
  var current: Int

  var fn next(): Int? {
    if current <= 0 {
      return None
    }
    current = current - 1
    Some(current + 1)
  }
}

/** Counts down from `start`; every `for` or pipeline over it gets a fresh [CountdownIterator]. */
type Countdown with Iterate<Int> {
  start: Int

  fn iterate(): Iterator<Int> {
    CountdownIterator start
  }
}

for n in Countdown(3) {
  print n                                // 3, 2, 1
}
const odd = Countdown(5).filter { _ % 2 == 1 }.toList()   // [5, 3, 1] - the pipeline comes with `Iterate`
print odd

// --- Pipelines: source -> lazy stages -> terminal operation ------------------------------

/** A row for the pipeline and collector examples below. */
type Employee {
  name: String
  department: String
  salary: Int
  age: Int
}

const employees = [
  Employee("Ada", "Engineering", 120, 36),
  Employee("Grace", "Engineering", 130, 45),
  Employee("Linus", "Operations", 90, 28),
  Employee("Margaret", "Research", 140, 52),
]

// Stages (`filter`, `map`, `sorted`, `take`, ...) are lazy and store nothing. They describe the pipeline.
const seniorEngineers = employees
  .filter { _.department == "Engineering" && _.age >= 40 }
  .sorted { _.name }
  .map { "{_.name} ({_.age})" }          // Iterate<String> - nothing has happened yet

// A terminal operation pulls the values through. Where they end up is its decision alone.
print seniorEngineers.toList()                           // ["Grace (45)"]
print seniorEngineers.to<Set<String>>()                  // Any `From<Iterate<Item>>` works as a target
print seniorEngineers.collect(joining(", ", prefix: "Seniors: "))

const best = employees.sorted { -_.salary }.take(2).map { _.name }.toList()
const anyoneYoung = employees.any { _.age < 30 }         // Stops at the first match
const total = employees.fold 0 { sum, employee => sum + employee.salary }

// --- Collectors: reusable descriptions of "what to do with the values" ----------------------

const headcount = employees.collect counting()
const payroll = employees.collect(summing { _.salary })
const averageAge = employees.collect(averaging { Float.from _.age })          // Float?
const oldest = employees.collect(maxBy { _.age })                          // Employee?
const (veterans, others) = employees.collect(partitioningBy { _.age >= 40 })

// Grouping takes a downstream collector per group
const byDepartment = employees.collect(groupingBy { _.department })            // Map<String, List<Employee>>
const salaryByDepartment = employees.collect(groupingBy { employee: Employee => employee.department }.then(summing { _.salary }))
const topEarners = employees.collect(groupingBy { employee: Employee => employee.department }.then(maxBy { _.salary }))
const teams = employees.collect(groupingBy { employee: Employee => employee.department }.then(into<Set<Employee>>()))

print salaryByDepartment                 // ["Engineering": 250, "Operations": 90, "Research": 140]

// An accumulator is a value: name it, pass it around, collect with it twice - each run fills its own copy
const salaryStatistics = groupingBy { employee: Employee => employee.department }.then(averaging { Float.from _.salary })
print employees.collect(salaryStatistics)
print(employees.filter { _.age < 50 }.collect(salaryStatistics))

// Your own accumulator: a fold with a final step...
/** An accumulator of your own: folds values into a list, then finishes by sorting it and taking the middle one. */
fn median<Item>(value: (value: Item) => Int): Accumulator<Item, Int?> {
  collector([], finish: { values: List<Int> => values.sorted { _ }.skip(values.length() / 2).first() }) {
    values, item => values.appended value(item)
  }
}

print employees.collect(median { _.salary })

// ...or, if it needs more than that, a type with `var` fields that is an `Accumulator` (see std/collectors: `groupingBy`)

// --- Streaming: values are pulled one by one, only as far as needed ----------------------------

const firstBigSquare = (1..)             // An infinite source
  .map { _ * _ }
  .filter { _ % 7 == 0 }
  .find { _ > 1000 }                     // Some(1764) - computed 42 squares, stored none

// A stream is the same idea over values that have to be waited for (docs/STREAMS.md): the stages are the same
// `Stage` values, `Accumulator` is shared, and only `await()` and `?` are added
var log = File.open("server.log")?
const errors = log
  .lines()                               // A `Source<String, IoError>`: the file is never in memory as a whole
  .filter({ _.contains "ERROR" })
  .take(5)                               // Stops reading after the fifth match
  .toList()
  .await()?

// --- Stack and queue ------------------------------------------------------------------------

// The words everybody knows: `enqueue`/`dequeue` on a queue, `push`/`pop` on a stack, `peek` on both
var pending = Queue.of 1
while const Some(number) = pending.dequeue() {
  if number < 100 {
    pending.enqueue(number * 3)
  }
}

var brackets = Stack<Char>.of()
brackets.push '('
print brackets.pop()                  // Some('(')

// A copy keeps the old version: history, undo, backtracking
const stack = Stack.of 1, 2, 3
var rest = stack
if const Some(top) = rest.pop() {
  print "top: {top}, remaining: {rest.length()}, before: {stack.length()}, next: {rest.peek()}"
}
