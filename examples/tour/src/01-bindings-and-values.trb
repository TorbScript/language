/**
 * Bindings and values: `const`/`var`, the numeric and string literals, tuples, ranges, and `Option` as the
 * language's only form of absence.
 */

// Line comment
/* Block comment. It ends at the first star-slash, block comments do not nest. */

/** Doc comment for `answer`. */
const answer = 42            // Immutable binding, type `Int` is inferred
var counter = 0              // Mutable binding
counter = counter + 1
print counter                // 1. A change nobody reads afterwards is a compile error, here as in every body

const ratio: Float = 1       // Literals adapt to the expected type
const byte: UInt8 = 0xFF
const million = 1_000_000
const mask = 0b1010_1010
const avogadro = 6.022e23

// var nothing               // Compile error: bindings must be initialized
// var later: Int            // Compile error: no implied default value
// answer = 43               // Compile error: `answer` is const

// Strings
const name = "World"
const greeting = "Hello, {name}! 1 + 1 is {1 + 1}"
const braces = "A literal \{brace}"
const letter = 'A'
const text = """
  Multi-line strings strip the common indentation.
  Interpolation works here too: {greeting}
  """

// Tuples
const pair = (1, "one")
const (number, word) = pair          // Destructuring
const alsoNumber = pair.0

// Ranges: the ends a range has are its type
const exclusive = 0..10              // Range<Int>, 0 to 9
const inclusive = 0..=10             // Range<Int>, 0 to 10
const endless = 3..                  // RangeFrom<Int>, counts on forever
const upTo = ..10                    // RangeTo<Int>, bounds and no sequence

// Options: there is no null
const maybe: Int? = 5          // `Int?` is `Option<Int>`
const nothing: Int? = None
const value = nothing ?? 0           // Default
const doubled = maybe.map { _ * 2 }  // Some(10)

// No implicit numeric conversions
const precise = Float.from(answer) * 1.5
const small = Int32.tryFrom answer  // Result<Int32, NumberRangeError>

// List and map literals are values like everything else: a `const` never changes, a `var` can be changed in place
const list = [1, 2, 3]                       // List<Int>
const dictionary = ["a": 1, "b": 2]          // Map<String, Int>
const emptyList: List<String> = []
const emptyMap: Map<String, Int> = [:]

print greeting
print "list: {list}, first: {list[0]}, a: {dictionary["a"]}"
