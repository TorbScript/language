/**
 * Format d: a Protobuf-like packed binary format. Field numbers come from a mapping, numbers are varints, nesting is
 * length-delimited, and this is the one format in the lab that writes its **own `Decoder`** instead of buffering into an
 * `EncodedValue` - because a binary stream is read straight off the wire, which is the case the vocabulary exists for.
 *
 *     const packed = Packed.format({ format => format.numbers("lab/Price", ["currency", "amount"]) })?
 *     const bytes = packed.encode order
 *     const back = packed.decode(Order.decode, bytes)?
 *
 * Without a mapping a field's number is its position in the declaration, counting from one - the default that needs no
 * word at all. A mapping fixes the numbers, which is what a wire format needs when a field is added or reordered.
 *
 * **A byte here is an `Int64`.** The language has no way to make a `UInt8` out of a number at run time - there is no
 * `UInt8.tryFrom(Int64)`, and there is no way back from bytes to a `String` either - so a byte-oriented format cannot be
 * written in TorbScript today. Everything else about this format is real; `docs/design/ENCODING.md` lists the two missing
 * conversions first among what the language must provide.
 */

use DecodeError, Describe, Encode, Encoder, Decoder, Structures, structureOf from "./vocabulary"

/** What a mapping got wrong, found once when the format is built. */
public type PackedProblem with Show, Error {
  typeName: String
  field: String

  fn show(): String {
    "`{typeName}` has no field `{field}`"
  }
}

/** The DSL: the field numbers of one type, in the order the numbers run. */
public type PackedFormat {
  protected var numbering: Map<String, List<String>> = [:]
  protected var described: Map<String, List<String>> = [:]

  /**
   * `numbers<Price> { field 1, { _.currency }  field 2, { _.amount } }` in the design. The list form here says the same
   * thing: the number of a field is its position in this list, counting from one.
   */
  var fn numbers(typeName: String, fields: List<String>) {
    numbering.set typeName, fields
  }

  /** The lab needs the type's own fields to check the mapping against; a type argument would carry both. */
  var fn checked(typeName: String, describe: (var target: Structures) => Void) {
    const structure = structureOf describe
    described.set typeName, structure.recordFields().map({ _.name() }).toList()
  }
}

/** The packed format: the numbering, and one entry in each direction. */
public type Packed {
  private numbering: Map<String, List<String>> = [:]

  static fn format(define: (var format: PackedFormat) => Void): Result<Self, PackedProblem> {
    var built = PackedFormat()
    define built
    for (typeName, fields) in built.numbering {
      const known = built.described.get(typeName) ?? []
      if known.isEmpty() {
        continue
      }
      for name in fields {
        if !known.contains(name) {
          return Fail PackedProblem(typeName, name)
        }
      }
    }
    Self built.numbering
  }

  fn encode<Value: Encode>(value: Value): List<Int64> {
    var target = PackedEncoder numbering: numbering
    value.encode target
    target.output
  }

  fn decode<Value>(
    read: (var source: PackedDecoder) => Result<Value, DecodeError>,
    bytes: List<Int64>,
  ): Result<Value, DecodeError> {
    var source = PackedDecoder bytes, numbering: numbering
    read source
  }
}

const varintWire: Int64 = 0
const blockWire: Int64 = 2

/**
 * An `Encoder` that writes the packed form. Every open record buffers its own bytes, because a nested record is written
 * behind its own length and the length is only known once the record is finished.
 */
public type PackedEncoder with Encoder {
  var output: List<Int64> = []
  numbering: Map<String, List<String>> = [:]
  private var frames: List<PackedFrame> = []

  var fn nothing() {
    // An absent field is not on the wire at all: no key, no payload, and the reader falls back to the default
  }

  var fn bool(value: Bool) {
    varint(if value { 1 } else { 0 })
  }

  var fn int(value: Int64) {
    varint zigzag(value)
  }

  /** No `UInt8.tryFrom(Int64)`, so a count travels as its decimal text. See the module comment. */
  var fn unsigned(value: UInt64) {
    string "{value}"
  }

  /** No bit access to a `Float64` either, so a number travels as its decimal text. */
  var fn float(value: Float64) {
    string "{value}"
  }

  var fn string(value: String) {
    const codes = value.chars().map({ Int64.from _ }).toList()
    var payload: List<Int64> = []
    for code in codes {
      appendVarint payload, code
    }
    block payload
  }

  var fn bytes(value: List<UInt8>) {
    var payload: List<Int64> = []
    for byte in value {
      appendVarint payload, Int64.from(byte)
    }
    block payload
  }

  var fn sequence(length: Int?) {
    const _length = length
    open PackedFrameKind.Items
  }

  var fn map(length: Int?) {
    const _length = length
    open PackedFrameKind.Items
  }

  var fn record(typeName: String) {
    open PackedFrameKind.Fields(numbering.get(typeName) ?? [])
  }

  /** A case is field number one, its own fields follow from two: a `oneof` without a schema to agree on. */
  var fn variant(typeName: String, name: String) {
    open PackedFrameKind.Fields(numbering.get(typeName) ?? [])
    const last = frames.length() - 1
    frames[last].number = 1
    string name
  }

  var fn field(name: String) {
    const last = frames.length() - 1
    const fields = match frames[last].kind {
      .Fields(names) => names
      _ => []
    }
    const position = fields.indexOf name
    frames[last].number = match position {
      Some(index) => index + 1
      None => frames[last].number + 1
    }
  }

  var fn finish() {
    const last = frames.length() - 1
    const frame = frames[last]
    frames = frames.removedAt last
    match frame.kind {
      // A sequence writes its item count in front, so a reader knows when to stop without a terminator
      .Items => {
        var payload: List<Int64> = []
        appendVarint payload, frame.count
        payload.appendAll frame.bytes
        block payload
      }
      .Fields(_) => block frame.bytes
    }
  }

  private var fn open(kind: PackedFrameKind) {
    frames.append PackedFrame(kind)
  }

  /** One varint value, with its key when it sits in a record. */
  private var fn varint(value: Int64) {
    var payload: List<Int64> = []
    appendVarint payload, value
    put payload, varintWire
  }

  /** One length-delimited block: the length, then the payload. */
  private var fn block(payload: List<Int64>) {
    var body: List<Int64> = []
    appendVarint body, payload.length()
    body.appendAll payload
    put body, blockWire
  }

  private var fn put(payload: List<Int64>, wire: Int64) {
    if frames.isEmpty() {
      output.appendAll payload
      return
    }
    const last = frames.length() - 1
    match frames[last].kind {
      // An item of a sequence carries no key: the type knows what it is reading
      .Items => {
        frames[last].bytes.appendAll(payload)
        frames[last].count = frames[last].count + 1
      }
      // Field number zero: no `field` was announced, so this is a wrapper's one value and carries no key
      .Fields(_) => {
        const number = frames[last].number
        if number == 0 {
          frames[last].bytes.appendAll(payload)
          return
        }
        var key: List<Int64> = []
        appendVarint(key, number * 8 + wire)
        frames[last].bytes.appendAll(key)
        frames[last].bytes.appendAll(payload)
      }
    }
  }
}

/** One open sequence, map, record or variant of `PackedEncoder`, buffering its own bytes until its length is known. */
type PackedFrame {
  kind: PackedFrameKind
  var bytes: List<Int64> = []
  var number: Int64 = 0
  var count: Int = 0
}

/** Whether a `PackedFrame` counts items (`Items`) or field numbers by name (`Fields`). */
type PackedFrameKind {
  case Items
  case Fields(names: List<String>)
}

/** Seven bits per byte, the eighth says "one more follows". */
fn appendVarint(var target: List<Int64>, value: Int64) {
  var rest = value
  while rest >= 128 {
    target.append(rest % 128 + 128)
    rest = rest / 128
  }
  target.append rest
}

/** A signed number as a non-negative one, so a small negative number stays small. */
fn zigzag(value: Int64): Int64 {
  if value >= 0 {
    return value * 2
  }
  value * -2 - 1
}

/** The reverse of `zigzag`: a non-negative wire number back to the signed number it stands for. */
fn unzigzag(value: Int64): Int64 {
  if value % 2 == 0 {
    return value / 2
  }
  (value + 1) / -2
}

/**
 * A `Decoder` that reads the packed form straight off the stream. Fields arrive in ascending number order, so looking
 * for one is a forward scan: a smaller number is skipped, a larger one means the field is not there and the scan stops
 * before it. Nothing is buffered and nothing is parsed twice.
 */
public type PackedDecoder with Decoder {
  input: List<Int64>
  private var position: Int = 0
  numbering: Map<String, List<String>> = [:]
  private var frames: List<PackedCursor> = []

  var fn nothing(): Bool {
    // The field was not on the wire at all, so `field` already answered `false` and this is never reached for a record
    false
  }

  var fn bool(): Result<Bool, DecodeError> {
    readVarint()? != 0
  }

  var fn int(): Result<Int64, DecodeError> {
    unzigzag(readVarint()?)
  }

  var fn unsigned(): Result<UInt64, DecodeError> {
    const text = string()?
    Fail DecodeError("`{text}` cannot become a count: the language has no `UInt64.tryFrom` for the lab to call")
  }

  var fn float(): Result<Float64, DecodeError> {
    const text = string()?
    Float64.tryFrom(text).mapError { _ => DecodeError "`{text}` is not a number" }
  }

  var fn string(): Result<String, DecodeError> {
    const length = readVarint()?
    const end = position + length
    var out: List<Char> = []
    while position < end {
      const code = readVarint()?
      const character = Char.tryFrom(code).mapError({ _ => DecodeError "{code} is not a character" })?
      out.append character
    }
    String.from out
  }

  var fn bytes(): Result<List<UInt8>, DecodeError> {
    const text = string()?
    Fail DecodeError("`{text}` cannot become bytes: the language has no `UInt8.tryFrom(Int64)`")
  }

  var fn sequence(): Result<Int?, DecodeError> {
    const _length = readVarint()?
    const count = readVarint()?
    frames.append PackedCursor(.Items, remaining: count)
    Ok Some(count)
  }

  var fn map(): Result<Int?, DecodeError> {
    sequence()
  }

  var fn hasNext(): Result<Bool, DecodeError> {
    if frames.isEmpty() {
      return false
    }
    const last = frames.length() - 1
    const remaining = frames[last].remaining
    if remaining <= 0 {
      return false
    }
    frames[last].remaining = remaining - 1
    true
  }

  /** Every record carries its own length, the outermost one too: a message can be concatenated with the next. */
  var fn record(typeName: String): Result<Void, DecodeError> {
    const names = numbering.get(typeName) ?? []
    const length = readVarint()?
    frames.append PackedCursor(.Fields(names), end: position + length)
    Ok void
  }

  var fn variant(typeName: String): Result<String, DecodeError> {
    record(typeName)?
    if !field("")? {
      return Fail DecodeError("a case was expected")
    }
    string()
  }

  var fn field(name: String): Result<Bool, DecodeError> {
    const last = frames.length() - 1
    if last < 0 {
      return Fail DecodeError("no record is open")
    }
    const wanted = numberOf frames[last], name
    frames[last].number = wanted
    while position < frames[last].end {
      const mark = position
      const key = readVarint()?
      const number = key / 8
      const wire = key % 8
      if number == wanted {
        return true
      }
      if number > wanted {
        position = mark
        return false
      }
      skip(wire)?
    }
    false
  }

  var fn finish(): Result<Void, DecodeError> {
    if frames.isEmpty() {
      return Fail DecodeError("nothing is open")
    }
    const last = frames.length() - 1
    const frame = frames[last]
    frames = frames.removedAt last
    if const .Fields(_) = frame.kind {
      position = frame.end
    }
    Ok void
  }

  private fn numberOf(frame: PackedCursor, name: String): Int64 {
    const names = match frame.kind {
      .Fields(found) => found
      _ => []
    }
    match names.indexOf(name) {
      Some(index) => index + 1
      None => frame.number + 1
    }
  }

  private var fn skip(wire: Int64): Result<Void, DecodeError> {
    if wire == varintWire {
      const _value = readVarint()?
      return Ok void
    }
    const length = readVarint()?
    position = position + length
    Ok void
  }

  private var fn readVarint(): Result<Int64, DecodeError> {
    var result: Int64 = 0
    var scale: Int64 = 1
    while position < input.length() {
      const byte = input[position]
      position = position + 1
      result = result + (byte % 128) * scale
      if byte < 128 {
        return result
      }
      scale = scale * 128
    }
    Fail DecodeError("the bytes end inside a number")
  }
}

/** One open sequence, map, record or variant of `PackedDecoder`, with the position `hasNext` and `field` read from. */
type PackedCursor {
  kind: PackedCursorKind
  end: Int = 0
  var number: Int64 = 0
  var remaining: Int = 0
}

/** Whether a `PackedCursor` counts items (`Items`) or looks a field up by name among its numbers (`Fields`). */
type PackedCursorKind {
  case Items
  case Fields(names: List<String>)
}
