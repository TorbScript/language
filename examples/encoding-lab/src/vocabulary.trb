/**
 * The vocabulary of the encoding concept `docs/ENCODING.md` specifies, declared here so the lab can run against it
 * without touching `std/encoding` (four other agents work there).
 *
 * One principle carries everything: **a value is its constructor call**, and the compiler offers that call in three
 * forms - written (`Encode`), read (`Decode`) and described without a value (`Describe`). The three traits have the
 * same shape, the three format-side traits have the same method names, and nothing in a format ever sees a type.
 *
 * Every method of `Encoder`, `Decoder` and `Describer` is free of type parameters and free of closures, so an
 * implementation is a straight-line state machine and a derived `encode` is straight-line code. What opens
 * (`sequence`, `map`, `record`, `variant`, and `optional`/`variantCase` on the describing side) is closed by `finish`.
 *
 * `Encoder`, `Decoder` and `Describer` appear only as **bounds** (`<Target: Encoder>`), never as types: a format hands
 * its own concrete encoder over and gets it back, which a trait-typed `var` parameter could not do.
 */

// --- What a value is: three forms of one constructor -----------------------------------------------------------------

/**
 * A value writes itself. Derived exactly when the constructor is usable from outside, over exactly its parameters.
 *
 * The target is a **bound**, not a trait type: a format owns its encoder, hands it over as a `var` path and reads the
 * result out of it afterwards.
 */
public trait Encode {
  fn encode<Target: Encoder>(var target: Target)
}

/** A value reads itself back. Derived under the same condition as `Encode`, so what is written can always be read. */
public trait Decode {
  static fn decode<Source: Decoder>(var source: Source): Result<Self, DecodeError>
}

/**
 * A type describes its structure **without a value**: what schema-driven formats need (SQL DDL, Protobuf, JSON
 * Schema, OpenAPI, CLI help, a form). It is the same constructor again, with the doc comment of every field and
 * whether the field has a default.
 */
public trait Describe {
  static fn describe<Target: Describer>(var target: Target)
}

/** What went wrong reading a value, with the field chain it went wrong in. */
public type DecodeError with Show, Error {
  message: String
  path: List<String> = []

  /** `error.inside("price")`: an error collects its path on the way out, so the message names the field chain. */
  fn inside(segment: String): DecodeError {
    copy path: path.inserted(0, segment)
  }

  fn show(): String {
    if path.isEmpty() {
      return message
    }
    const location = path.joined separator: "."
    "{location}: {message}"
  }
}

// --- What a format implements: writing -------------------------------------------------------------------------------

/**
 * The methods are named after the types of the language, so a format learns no second vocabulary. Narrow numbers are
 * widened on the way in and checked on the way back, so nothing is lost.
 *
 * `record`, `variant`, `sequence` and `map` open; `finish` closes the innermost of them. A field's name is announced
 * with `field` and its value is written right after.
 */
public trait Encoder {
  var fn nothing()
  var fn bool(value: Bool)
  var fn int(value: Int64)
  var fn unsigned(value: UInt64)
  var fn float(value: Float64)
  var fn string(value: String)
  var fn bytes(value: List<UInt8>)

  /** `length` is known for a collection and unknown for a pipeline: a binary format writes it in front. */
  var fn sequence(length: Int?)
  var fn map(length: Int?)
  /** `typeName` is the qualified name of the declaration, which is how a format finds a mapping for this one type. */
  var fn record(typeName: String)
  var fn variant(typeName: String, name: String)
  var fn field(name: String)
  var fn finish()
}

// --- What a format implements: reading ------------------------------------------------------------------------------

/**
 * Reading is driven by the type: it asks for what it expects and gets an error when something else is there. A format
 * with unordered fields buffers one record at a time; a sequence streams.
 */
public trait Decoder {
  /** Consumes a "nothing" if one is there. This is how `Option` decides between `None` and `Some`. */
  var fn nothing(): Bool

  var fn bool(): Result<Bool, DecodeError>
  var fn int(): Result<Int64, DecodeError>
  var fn unsigned(): Result<UInt64, DecodeError>
  var fn float(): Result<Float64, DecodeError>
  var fn string(): Result<String, DecodeError>
  var fn bytes(): Result<List<UInt8>, DecodeError>

  /** Opens a sequence and answers its length where the format writes one in front. */
  var fn sequence(): Result<Int?, DecodeError>
  var fn map(): Result<Int?, DecodeError>
  /** `true` while one more item of the open sequence or one more entry of the open map follows. */
  var fn hasNext(): Result<Bool, DecodeError>
  var fn record(typeName: String): Result<Void, DecodeError>
  /** Opens a variant and answers which case is there. */
  var fn variant(typeName: String): Result<String, DecodeError>
  /** Positions on the field `name`. `false` when the input has no such field: the field's default applies. */
  var fn field(name: String): Result<Bool, DecodeError>
  var fn finish(): Result<Void, DecodeError>
}

// --- What a format implements: describing ---------------------------------------------------------------------------

/**
 * The same method names again, without values. `record` and `variant` answer a `Bool`: `false` means "this type is
 * already known here", which is what makes a type that contains itself terminate - the name has been handed over
 * before the answer, so the target can refer to the type it declined.
 */
public trait Describer {
  var fn bool()
  var fn int()
  var fn unsigned()
  var fn float()
  var fn string()
  var fn bytes()

  /** The description that follows is the one that may be absent. */
  var fn optional()
  var fn sequence()
  var fn map()
  var fn record(typeName: String): Bool
  var fn variant(typeName: String): Bool
  /** One case of the open variant. Its fields follow, and `finish` closes it. */
  var fn variantCase(name: String)
  /** The next description belongs to this field. */
  var fn field(description: FieldDescription)
  var fn finish()
}

/** What the compiler knows about one constructor parameter, and a schema or a help text needs. */
public type FieldDescription {
  name: String
  /** The field's doc comment, as written. This is what an `@description` annotation is for in other languages. */
  documentation: String = ""
  default: FieldDefault = FieldDefault.Required
}

/** Whether a field may be missing, and what it is then. */
public type FieldDefault {
  /** No default: the field has to be there. */
  case Required
  /** A default that is evaluated at every construction, so it is not data anybody could print. */
  case Computed
  /** A default that is static data, and this is it. */
  case Constant(value: EncodedValue)
}

// --- The scalars describe themselves --------------------------------------------------------------------------------

/**
 * `Bool` writes, reads and describes itself through the vocabulary's own `bool` method.
 *
 * A scalar has no fields to derive from, so its three forms are written directly instead of generated from a
 * constructor.
 */
extend Bool with Encode, Decode, Describe {
  fn encode<Target: Encoder>(var target: Target) {
    target.bool self
  }

  static fn decode<Source: Decoder>(var source: Source): Result<Bool, DecodeError> {
    source.bool()
  }

  static fn describe<Target: Describer>(var target: Target) {
    target.bool()
  }
}

/** `Int64` writes, reads and describes itself through the vocabulary's own `int` method, the same way `Bool` does. */
extend Int64 with Encode, Decode, Describe {
  fn encode<Target: Encoder>(var target: Target) {
    target.int self
  }

  static fn decode<Source: Decoder>(var source: Source): Result<Int64, DecodeError> {
    source.int()
  }

  static fn describe<Target: Describer>(var target: Target) {
    target.int()
  }
}

/** `Float64` writes, reads and describes itself through the vocabulary's own `float` method. */
extend Float64 with Encode, Decode, Describe {
  fn encode<Target: Encoder>(var target: Target) {
    target.float self
  }

  static fn decode<Source: Decoder>(var source: Source): Result<Float64, DecodeError> {
    source.float()
  }

  static fn describe<Target: Describer>(var target: Target) {
    target.float()
  }
}

/** `String` writes, reads and describes itself through the vocabulary's own `string` method. */
extend String with Encode, Decode, Describe {
  fn encode<Target: Encoder>(var target: Target) {
    target.string self
  }

  static fn decode<Source: Decoder>(var source: Source): Result<String, DecodeError> {
    source.string()
  }

  static fn describe<Target: Describer>(var target: Target) {
    target.string()
  }
}

// --- The collections describe themselves ----------------------------------------------------------------------------

/** A list encodes as a `sequence`: its length in front, then every item written with its own `encode`. */
extend<Item: Encode> List<Item> with Encode {
  fn encode<Target: Encoder>(var target: Target) {
    target.sequence Some(length())
    for item in self {
      item.encode target
    }
    target.finish()
  }
}

/** A list describes as a `sequence` around its item's structure: the shape is one item, repeated. */
extend<Item: Describe> List<Item> with Describe {
  static fn describe<Target: Describer>(var target: Target) {
    target.sequence()
    Item.describe target
    target.finish()
  }
}

/** `Some` encodes as its value; `None` encodes as `nothing()`, so the field's default applies on the way back in. */
extend<Value: Encode> Option<Value> with Encode {
  fn encode<Target: Encoder>(var target: Target) {
    match self {
      Some(value) => value.encode target
      None => target.nothing()
    }
  }
}

/** An optional value describes as `optional()` around the value's own structure. */
extend<Value: Describe> Option<Value> with Describe {
  static fn describe<Target: Describer>(var target: Target) {
    target.optional()
    Value.describe target
    target.finish()
  }
}

/*
 * The decoding side of a generic type is the one place the lab cannot run as written. The compiler's derived code is
 *
 *     fn decode<Source: Decoder>(var source: Source): Result<List<Item>, DecodeError> {
 *       ...
 *       items.append Item.decode(source)?
 *     }
 *
 * and `Item.decode` is a static trait member reached through a bound. The checker resolves it - `extend<Item: Decode>
 * List<Item> with Decode` type checks - but the back end has nothing that runs it. So the two functions below take
 * the element's own `decode` as an ordinary function value, which is the same call with the one lookup written out.
 * `docs/ENCODING.md`, "What the language and the compiler must provide", asks for it.
 */

/** `List<Item>.decode`, with the element's `decode` handed in. */
public fn decodeSequence<Item, Source: Decoder>(
  var source: Source,
  item: (var inner: Source) => Result<Item, DecodeError>,
): Result<List<Item>, DecodeError> {
  const _length = source.sequence()?
  var items: List<Item> = []
  var index = 0
  while source.hasNext()? {
    const value = item(source).mapError({ _.inside "{index}" })?
    items.append value
    index = index + 1
  }
  source.finish()?
  Ok items
}

/**
 * Writes one value into the target. The compiler's derived code says `amount.encode target` directly; the lab routes
 * every field through this one function, whose receiver is a **bound** and not a concrete type.
 *
 * The reason is a checker limit, not a design decision: `std/encoding`'s `Encode` is implemented for `Float64`,
 * `String`, `List` and `Option` too, and until extension visibility decides which `Encode` a file means, both traits
 * are candidates for `amount.encode`. Overload resolution then compares the caller's type parameter with the trait
 * method's own by identity and rejects both. Through a bound there is exactly one candidate and no overload set.
 * `docs/ENCODING.md`, "What the language and the compiler must provide", asks for the two halves of this.
 */
public fn encoded<Value: Encode, Target: Encoder>(value: Value, var target: Target) {
  value.encode target
}

/**
 * One field of the open record that the input has to have. The error carries the field's name, which is how a message
 * ends up naming the whole chain (`price.currency: a text is needed`).
 */
public fn requiredField<Value, Source: Decoder>(
  var source: Source,
  name: String,
  read: (var inner: Source) => Result<Value, DecodeError>,
): Result<Value, DecodeError> {
  if !source.field(name)? {
    return Fail DecodeError("a value is needed").inside(name)
  }
  read(source).mapError { _.inside name }
}

/**
 * One field that has a default, so it may be missing. `fallback` is `lazy`: a default is evaluated at every
 * construction, and a value that is not missing must not pay for one.
 */
public fn optionalField<Value, Source: Decoder>(
  var source: Source,
  name: String,
  fallback: lazy Value,
  read: (var inner: Source) => Result<Value, DecodeError>,
): Result<Value, DecodeError> {
  if !source.field(name)? {
    return Ok fallback
  }
  read(source).mapError { _.inside name }
}

/** `Option<Value>.decode`, with the value's `decode` handed in. */
public fn decodeOptional<Value, Source: Decoder>(
  var source: Source,
  value: (var inner: Source) => Result<Value, DecodeError>,
): Result<Value?, DecodeError> {
  if source.nothing() {
    return Ok None
  }
  Ok Some(value(source)?)
}

// --- A value without its type: what replaces `List<Encode>` ---------------------------------------------------------

/**
 * Any `Encode` value, held without its type. This is the answer to "what does a `List<Encode>` become once `Encode`
 * has a type parameter and is no longer usable as a type": not nothing, and not a tree every value travels through -
 * an ordinary ADT that is built by an ordinary `Encoder` (`Values` below), for the three places that need to hold a
 * value they have no type for: a quotation's captures, a field default in a schema, and `describe`.
 */
public type EncodedValue with Show {
  case Nothing
  case Bool(value: Bool)
  case Int(value: Int64)
  case Unsigned(value: UInt64)
  case Float(value: Float64)
  case String(value: String)
  case Bytes(value: List<UInt8>)
  case Sequence(items: List<EncodedValue>)
  case Mapping(entries: List<EncodedValue>)
  case Record(typeName: String, fields: List<EncodedField>)
  case Variant(typeName: String, name: String, fields: List<EncodedField>)

  /** `EncodedValue.of(user)` - the value's own `encode` is an instance method, so no bound has to be looked up. */
  static fn of<Value: Encode>(value: Value): EncodedValue {
    var builder = Values()
    value.encode builder
    builder.result()
  }

  fn show(): String {
    match self {
      .Nothing => "None"
      .Bool(value) => "{value}"
      .Int(value) => "{value}"
      .Unsigned(value) => "{value}"
      .Float(value) => "{value}"
      .String(value) => "\"{value}\""
      .Bytes(value) => "{value.length()} bytes"
      .Sequence(items) => showItems items
      .Mapping(entries) => showItems entries
      .Record(typeName, fields) => "{shortName(typeName)}({showFields(fields)})"
      .Variant(_, name, fields) => if fields.isEmpty() { name } else { "{name}({showFields(fields)})" }
    }
  }

  /** The unquoted text of a scalar, which is what a SQL default and a `--help` line want. */
  fn plain(): String {
    match self {
      .String(value) => value
      other => other.show()
    }
  }
}

/**
 * An `EncodedValue` writes itself into any encoder, which is what makes it useful: a captured value can be bound as a
 * SQL parameter, and a document nobody has a type for can be written out again.
 */
extend EncodedValue with Encode {
  fn encode<Target: Encoder>(var target: Target) {
    match self {
      .Nothing => target.nothing()
      .Bool(value) => target.bool value
      .Int(value) => target.int value
      .Unsigned(value) => target.unsigned value
      .Float(value) => target.float value
      .String(value) => target.string value
      .Bytes(value) => target.bytes value
      .Sequence(items) => {
        target.sequence Some(items.length())
        for item in items {
          encoded item, target
        }
        target.finish()
      }
      .Mapping(entries) => {
        target.map Some(entries.length() / 2)
        for entry in entries {
          encoded entry, target
        }
        target.finish()
      }
      .Record(typeName, fields) => {
        target.record typeName
        writeFields fields, target
        target.finish()
      }
      .Variant(typeName, name, fields) => {
        target.variant typeName, name
        writeFields fields, target
        target.finish()
      }
    }
  }
}

/** Writes every field of a record or variant: its name, announced through `field`, then its value's own `encode`. */
fn writeFields<Target: Encoder>(fields: List<EncodedField>, var target: Target) {
  for field in fields {
    target.field field.name
    encoded field.value, target
  }
}

/** One named field of an `EncodedValue.Record` or `.Variant`, in the shape `Encoder.field` and `Decoder.field` use. */
public type EncodedField {
  name: String
  value: EncodedValue

  fn show(): String {
    "{name}: {value.show()}"
  }
}

/** The fields of a record or variant as `name: value` text, comma separated: what `EncodedValue.show` puts inside the parentheses. */
fn showFields(fields: List<EncodedField>): String {
  const parts = fields.map { _.show() }
  parts.joined separator: ", "
}

/** The items of a sequence or a mapping as `show`n text inside brackets. */
fn showItems(items: List<EncodedValue>): String {
  const parts = items.map { _.show() }
  const inner = parts.joined separator: ", "
  "[{inner}]"
}

/** `"lab/orders/Price"` reads as `Price` in a message: the package is context a reader already has. */
public fn shortName(typeName: String): String {
  const parts = typeName.split "/"
  parts.last() ?? typeName
}

/** Any `Encode` value as readable text: `Price(amount: 19.99, currency: "EUR")`. */
public fn describe<Value: Encode>(value: Value): String {
  EncodedValue.of(value).show()
}

/** An `Encoder` that builds an `EncodedValue`. It is a format like any other, and it is the only one with no bytes. */
public type Values with Encoder {
  private var frames: List<ValueFrame> = []
  private var finished: EncodedValue? = None

  fn result(): EncodedValue {
    match finished {
      Some(value) => value
      None => panic "nothing was encoded"
    }
  }

  var fn nothing() {
    complete EncodedValue.Nothing
  }

  var fn bool(value: Bool) {
    complete EncodedValue.Bool(value)
  }

  var fn int(value: Int64) {
    complete EncodedValue.Int(value)
  }

  var fn unsigned(value: UInt64) {
    complete EncodedValue.Unsigned(value)
  }

  var fn float(value: Float64) {
    complete EncodedValue.Float(value)
  }

  var fn string(value: String) {
    complete EncodedValue.String(value)
  }

  var fn bytes(value: List<UInt8>) {
    complete EncodedValue.Bytes(value)
  }

  var fn sequence(length: Int?) {
    const _length = length
    frames.append ValueFrame(.Sequence)
  }

  var fn map(length: Int?) {
    const _length = length
    frames.append ValueFrame(.Mapping)
  }

  var fn record(typeName: String) {
    frames.append ValueFrame(.Record(typeName))
  }

  var fn variant(typeName: String, name: String) {
    frames.append ValueFrame(.Variant(typeName, name))
  }

  var fn field(name: String) {
    const last = frames.length() - 1
    frames[last].pending = Some name
  }

  var fn finish() {
    const last = frames.length() - 1
    const frame = frames[last]
    frames = frames.removedAt last
    const value = match frame.kind {
      .Sequence => EncodedValue.Sequence frame.children
      .Mapping => EncodedValue.Mapping frame.children
      // A record that announced no field is a wrapper, and a wrapper IS its value: the name lives in `Structure`,
      // which is where a schema looks for it
      .Record(typeName) => if frame.fields.isEmpty() && frame.children.length() == 1 {
        frame.children[0]
      } else {
        EncodedValue.Record typeName, frame.fields
      }
      .Variant(typeName, name) => EncodedValue.Variant typeName, name, frame.fields
    }
    complete value
  }

  private var fn complete(value: EncodedValue) {
    if frames.isEmpty() {
      finished = Some value
      return
    }
    const last = frames.length() - 1
    match frames[last].pending {
      Some(name) => {
        frames[last].fields.append(EncodedField(name, value))
        frames[last].pending = None
      }
      None => frames[last].children.append(value)
    }
  }
}

/** One open `sequence`, `map`, `record` or `variant` of `Values`, with what has been written into it so far. */
type ValueFrame {
  kind: ValueFrameKind
  var children: List<EncodedValue> = []
  var fields: List<EncodedField> = []
  var pending: String? = None
}

/** What a `ValueFrame` is open as. Which case it is decides how `Values.finish` closes it into an `EncodedValue`. */
type ValueFrameKind {
  case Sequence
  case Mapping
  case Record(typeName: String)
  case Variant(typeName: String, name: String)
}

// --- Reading out of an `EncodedValue`: the `Decoder` every buffering format shares ----------------------------------

/**
 * A `Decoder` over an `EncodedValue`. Every format whose input has to be buffered anyway - a text format with
 * unordered fields, a tabular row, a command line - parses into an `EncodedValue` and hands it to this one decoder
 * instead of writing a state machine of its own. In the lab that is JSON, CSV, XML, the command line and logfmt; only
 * the packed binary format, which is read straight off the wire, writes its own `Decoder`.
 *
 * `lenient` is what a text format needs: XML, CSV and a command line have no numbers, only text, so `int()` and
 * `float()` parse what they are given instead of rejecting it. It is an option of the **format**, decided once, and
 * not a question any type has to ask (which is what serde's `is_human_readable` made every type do).
 */
public type ValueDecoder with Decoder {
  private var root: EncodedValue?
  private var frames: List<ValueCursor> = []
  private lenient: Bool = false

  static fn of(value: EncodedValue, lenient: Bool = false): ValueDecoder {
    Self root: Some(value), lenient: lenient
  }

  var fn nothing(): Bool {
    match peek() {
      Some(.Nothing) => {
        const _taken = take()
        true
      }
      _ => false
    }
  }

  var fn bool(): Result<Bool, DecodeError> {
    match take()? {
      .Bool(value) => Ok value
      .String(text) => {
        if !lenient {
          return Fail DecodeError("a truth value is needed")
        }
        Ok(text == "true")
      }
      other => Fail DecodeError("a truth value is needed, not {other.show()}")
    }
  }

  var fn int(): Result<Int64, DecodeError> {
    match take()? {
      .Int(value) => Ok value
      .Float(value) => Int64.tryFrom(value).mapError({ _ => DecodeError "{value} is not a whole number" })
      .String(text) => parseInteger text, lenient
      other => Fail DecodeError("a whole number is needed, not {other.show()}")
    }
  }

  var fn unsigned(): Result<UInt64, DecodeError> {
    match take()? {
      .Unsigned(value) => Ok value
      other => Fail DecodeError("a count is needed, not {other.show()}")
    }
  }

  var fn float(): Result<Float64, DecodeError> {
    match take()? {
      .Float(value) => Ok value
      .Int(value) => Ok Float64.from(value)
      .String(text) => parseFloating text, lenient
      other => Fail DecodeError("a number is needed, not {other.show()}")
    }
  }

  var fn string(): Result<String, DecodeError> {
    match take()? {
      .String(value) => Ok value
      other => {
        if !lenient {
          return Fail DecodeError("a text is needed, not {other.show()}")
        }
        Ok other.plain()
      }
    }
  }

  var fn bytes(): Result<List<UInt8>, DecodeError> {
    match take()? {
      .Bytes(value) => Ok value
      .String(text) => Ok text.bytes().toList()
      other => Fail DecodeError("bytes are needed, not {other.show()}")
    }
  }

  var fn sequence(): Result<Int?, DecodeError> {
    match take()? {
      .Sequence(items) => {
        frames.append ValueCursor(.Items, items: items)
        Ok Some(items.length())
      }
      /*
       * A lenient format has no brackets: XML writes one `<tags>` element per item and a single item is
       * indistinguishable from a single value. So one value is a sequence of one, and an absent one is empty.
       */
      other => {
        if !lenient {
          return Fail DecodeError("a sequence is needed, not {other.show()}")
        }
        const items = match other {
          .Nothing => []
          only => [only]
        }
        frames.append ValueCursor(.Items, items: items)
        Ok Some(items.length())
      }
    }
  }

  var fn map(): Result<Int?, DecodeError> {
    match take()? {
      .Mapping(entries) => {
        frames.append ValueCursor(.Items, items: entries)
        Ok Some(entries.length() / 2)
      }
      other => Fail DecodeError("a map is needed, not {other.show()}")
    }
  }

  var fn hasNext(): Result<Bool, DecodeError> {
    if frames.isEmpty() {
      return Ok false
    }
    const frame = frames[frames.length() - 1]
    Ok(frame.index < frame.items.length())
  }

  /**
   * The name is not compared: a tabular row and an XML element do not carry one, and a type asked for this one.
   *
   * A bare value where a record was asked for is a **wrapper** (`with Encode by value`): the value comes back as the
   * one thing the record holds, which is exactly what the writing side put there.
   */
  var fn record(typeName: String): Result<Void, DecodeError> {
    const _typeName = typeName
    match take()? {
      .Record(_, fields) => {
        frames.append ValueCursor(.Fields, fields: fields)
        Ok void
      }
      only => {
        frames.append ValueCursor(.Items, items: [only])
        Ok void
      }
    }
  }

  var fn variant(typeName: String): Result<String, DecodeError> {
    const _typeName = typeName
    match take()? {
      .Variant(_, name, fields) => {
        frames.append ValueCursor(.Fields, fields: fields)
        Ok name
      }
      // A format that writes a case without fields as a bare text reads back the same way
      .String(name) => {
        frames.append ValueCursor(.Fields)
        Ok name
      }
      /*
       * Externally tagged, which is what a text format writes: `{"Rejected": {"reason": "..."}}`. One field, whose name
       * is the case and whose value holds its fields. No mapping and no option decides this - it is the one shape a
       * record with exactly one field can be read as, and a case is never written any other way.
       */
      .Record(_, fields) => {
        const only = match fields.first() {
          Some(found) => found
          None => {
            return Fail DecodeError("a variant is needed, not an empty record")
          }
        }
        if fields.length() != 1 {
          return Fail DecodeError("a variant has one case, this record has {fields.length()} fields")
        }
        match only.value {
          .Record(_, inner) => frames.append ValueCursor(.Fields, fields: inner)
          _ => frames.append ValueCursor(.Fields)
        }
        Ok only.name
      }
      other => Fail DecodeError("a variant is needed, not {other.show()}")
    }
  }

  var fn field(name: String): Result<Bool, DecodeError> {
    const last = frames.length() - 1
    if last < 0 {
      return Fail DecodeError("no record is open")
    }
    match frames[last].fields.find({ _.name == name }) {
      Some(found) => {
        frames[last].selected = Some found.value
        Ok true
      }
      None => Ok false
    }
  }

  var fn finish(): Result<Void, DecodeError> {
    if frames.isEmpty() {
      return Fail DecodeError("nothing is open")
    }
    frames = frames.removedAt(frames.length() - 1)
    Ok void
  }

  /** The value the next read consumes, without consuming it. */
  private fn peek(): EncodedValue? {
    if frames.isEmpty() {
      return root
    }
    const frame = frames[frames.length() - 1]
    if const Some(selected) = frame.selected {
      return Some selected
    }
    if frame.index < frame.items.length() {
      return Some frame.items[frame.index]
    }
    None
  }

  private var fn take(): Result<EncodedValue, DecodeError> {
    if frames.isEmpty() {
      const found = match root {
        Some(value) => value
        None => {
          return Fail DecodeError("there is nothing left to read")
        }
      }
      root = None
      return Ok found
    }
    const last = frames.length() - 1
    if const Some(selected) = frames[last].selected {
      frames[last].selected = None
      return Ok selected
    }
    const index = frames[last].index
    if index >= frames[last].items.length() {
      return Fail DecodeError("there is nothing left to read")
    }
    frames[last].index = index + 1
    Ok frames[last].items[index]
  }
}

/** One open `sequence`, `map`, `record` or `variant` of `ValueDecoder`, with the position `hasNext` and `field` read from. */
type ValueCursor {
  kind: ValueCursorKind
  items: List<EncodedValue> = []
  fields: List<EncodedField> = []
  var index: Int = 0
  var selected: EncodedValue? = None
}

/** Whether a `ValueCursor` reads by position (`Items`, a sequence or a map) or by name (`Fields`, a record or variant). */
type ValueCursorKind {
  case Items
  case Fields
}

/** Parses a whole number out of text, for a lenient format whose input has no numeric type of its own. */
fn parseInteger(text: String, lenient: Bool): Result<Int64, DecodeError> {
  if !lenient {
    return Fail DecodeError("a whole number is needed")
  }
  match Int64.tryFrom(text) {
    Ok(value) => Ok value
    Fail(_) => Fail DecodeError("`{text}` is not a whole number")
  }
}

/** Parses a number out of text, for a lenient format whose input has no numeric type of its own. */
fn parseFloating(text: String, lenient: Bool): Result<Float64, DecodeError> {
  if !lenient {
    return Fail DecodeError("a number is needed")
  }
  match Float64.tryFrom(text) {
    Ok(value) => Ok value
    Fail(_) => Fail DecodeError("`{text}` is not a number")
  }
}

// --- A structure without a value: the convenience layer over `Describe` ---------------------------------------------

/**
 * What a `Describe` walk builds when a format wants a value instead of a visitor. Every schema format wants one -
 * a DDL statement, a `.proto` file, a JSON Schema, a `--help` text - and walking a tree is easier than writing a
 * state machine, so the conversion is written once here instead of once per format.
 *
 * Recursion is a `Reference`: the second time a type is opened the walk hands back its name and stops.
 */
public type Structure {
  case Boolean
  case Integer
  case Natural
  case Floating
  case Text
  case Binary
  case Optional(of: Structure)
  case Sequence(of: Structure)
  case Mapping(key: Structure, value: Structure)
  case Record(typeName: String, fields: List<StructureField>)
  /** A type that is its one value (`with Encode by value`). It keeps its name, so a format can map it. */
  case Wrapper(typeName: String, of: Structure)
  case Variant(typeName: String, cases: List<StructureCase>)
  /** A type that is already being described further up: the schema refers to it by name. */
  case Reference(typeName: String)

  /** The fields of a record, or nothing for everything else: what a tabular or a row-shaped format starts from. */
  fn recordFields(): List<StructureField> {
    match self {
      .Record(_, found) => found
      _ => []
    }
  }

  fn declaredName(): String {
    match self {
      .Record(name, _) => name
      .Wrapper(name, _) => name
      .Variant(name, _) => name
      .Reference(name) => name
      _ => ""
    }
  }

  /** `Int?` and `Int` describe the same column, so a schema asks what is underneath before it asks what it is. */
  fn withoutOptional(): Structure {
    match self {
      .Optional(inner) => inner
      other => other
    }
  }

  fn isOptional(): Bool {
    match self {
      .Optional(_) => true
      _ => false
    }
  }
}

/** One field of a `Structure.Record`: its description and the structure of the value it holds. */
public type StructureField {
  description: FieldDescription
  of: Structure

  fn name(): String {
    description.name
  }

  /** A field with a default may be missing from the input, which is what "required" means to a schema. */
  fn isRequired(): Bool {
    match description.default {
      .Required => !of.isOptional()
      _ => false
    }
  }

  fn defaultValue(): EncodedValue? {
    match description.default {
      .Constant(value) => Some value
      _ => None
    }
  }
}

/** One case of a `Structure.Variant`: its name and the structure of its own fields. */
public type StructureCase {
  name: String
  fields: List<StructureField>
}

/**
 * `structureOf(Order.describe)`. The design writes `structureOf<Order>()` and calls `Value.describe target` through
 * the bound; the lab takes the type's own static member as a function value instead - a method reference, which is
 * one of the four bridges between types and values.
 */
public fn structureOf(describe: (var target: Structures) => Void): Structure {
  var builder = Structures()
  describe builder
  builder.result()
}

/** A `Describer` that builds a `Structure`. The mirror image of `Values`, and the same state machine. */
public type Structures with Describer {
  private var frames: List<StructureFrame> = []
  private var finished: Structure? = None
  /** Every record and variant name that has been opened, so a type that contains itself stops at a `Reference`. */
  private var known: List<String> = []

  fn result(): Structure {
    match finished {
      Some(value) => value
      None => panic "nothing was described"
    }
  }

  var fn bool() {
    complete Structure.Boolean
  }

  var fn int() {
    complete Structure.Integer
  }

  var fn unsigned() {
    complete Structure.Natural
  }

  var fn float() {
    complete Structure.Floating
  }

  var fn string() {
    complete Structure.Text
  }

  var fn bytes() {
    complete Structure.Binary
  }

  var fn optional() {
    frames.append StructureFrame(.Optional)
  }

  var fn sequence() {
    frames.append StructureFrame(.Sequence)
  }

  var fn map() {
    frames.append StructureFrame(.Mapping)
  }

  var fn record(typeName: String): Bool {
    if known.contains(typeName) {
      complete Structure.Reference(typeName)
      return false
    }
    known.append typeName
    frames.append StructureFrame(.Record(typeName))
    true
  }

  var fn variant(typeName: String): Bool {
    if known.contains(typeName) {
      complete Structure.Reference(typeName)
      return false
    }
    known.append typeName
    frames.append StructureFrame(.Variant(typeName))
    true
  }

  var fn variantCase(name: String) {
    frames.append StructureFrame(.VariantCase(name))
  }

  var fn field(description: FieldDescription) {
    const last = frames.length() - 1
    frames[last].pending = Some description
  }

  var fn finish() {
    const last = frames.length() - 1
    const frame = frames[last]
    frames = frames.removedAt last
    match frame.kind {
      .Optional => complete Structure.Optional(frame.children[0])
      .Sequence => complete Structure.Sequence(frame.children[0])
      .Mapping => complete Structure.Mapping(frame.children[0], frame.children[1])
      .Record(typeName) => complete recordOf(typeName, frame)
      .Variant(typeName) => complete Structure.Variant(typeName, frame.cases)
      .VariantCase(name) => addCase StructureCase(name, frame.fields)
    }
  }

  /** A record that announced no field, but does hold one description, is a wrapper around it. */
  private fn recordOf(typeName: String, frame: StructureFrame): Structure {
    if frame.fields.isEmpty() && frame.children.length() == 1 {
      return Structure.Wrapper typeName, frame.children[0]
    }
    Structure.Record typeName, frame.fields
  }

  private var fn addCase(found: StructureCase) {
    const last = frames.length() - 1
    frames[last].cases.append(found)
  }

  private var fn complete(value: Structure) {
    if frames.isEmpty() {
      finished = Some value
      return
    }
    const last = frames.length() - 1
    match frames[last].pending {
      Some(description) => {
        frames[last].fields.append(StructureField(description, value))
        frames[last].pending = None
      }
      None => frames[last].children.append(value)
    }
  }
}

/** One open `Structure` of `Structures`, with what has been described into it so far. */
type StructureFrame {
  kind: StructureFrameKind
  var children: List<Structure> = []
  var fields: List<StructureField> = []
  var cases: List<StructureCase> = []
  var pending: FieldDescription? = None
}

/** What a `StructureFrame` is open as. Which case it is decides how `Structures.finish` closes it into a `Structure`. */
type StructureFrameKind {
  case Optional
  case Sequence
  case Mapping
  case Record(typeName: String)
  case Variant(typeName: String)
  case VariantCase(name: String)
}
