/**
 * `Urn`, the one refinement of [Uri] this design keeps as a type: it has two members - the namespace identifier and
 * the namespace-specific string - that a `Uri` has no place for, and `urn:uuid:` is what joins an identifier to a
 * URI.
 *
 * It holds the `Uri` it came from, so the way back is total: `Uri` has `From<Urn>` and `Urn` has
 * `TryFrom<Uri, UriError>`, which is one conversion pair **for `Urn`** and none for `Uri`.
 */

use Uri, UriError from "./uri"

/** `urn:<namespace>:<specific>` per RFC 8141, with the namespace identifier lower case. */
public type Urn with Show, Equals, Hash, Compare {
  /** The `Uri` this was read from, which is what makes the way back total. [Urn.uri] reads it. */
  private storedUri: Uri
  /** The namespace identifier, lower case. [Urn.namespace] reads it. */
  private storedNamespace: String
  /** Everything after the second `:`. [Urn.specific] reads it. */
  private storedSpecific: String

  /** The URI this name is. */
  fn uri(): Uri {
    storedUri
  }

  /** The namespace identifier, lower case: `uuid` in `urn:uuid:...`. */
  fn namespace(): String {
    storedNamespace
  }

  /** The namespace-specific string: everything after the second `:`. */
  fn specific(): String {
    storedSpecific
  }

  /** `urn:<namespace>:<specific>`, which is what the `Uri` behind it shows as. */
  fn show(): String {
    storedUri.show()
  }

  /** By namespace first, then by the specific string. */
  fn compare(other: Urn): Ordering {
    const answer = storedNamespace.compare other.storedNamespace
    if answer != .Equal {
      return answer
    }
    storedSpecific.compare other.storedSpecific
  }
}

/**
 * A `Uri` read as a URN.
 *
 * # Errors
 *
 * - [UriError.NotAUrn] where the scheme is not `urn`, or where what follows it is not `<namespace>:<specific>`.
 */
extend Urn with TryFrom<Uri, UriError> {
  static fn tryFrom(value: Uri): Result<Urn, UriError> {
    if value.scheme() != Some("urn") {
      return Fail UriError.NotAUrn(value.show())
    }
    const body = value.path()
    const namespace = body.substringBefore(":") ?? ""
    const specific = body.substringAfter(":") ?? ""
    if namespace.isEmpty() || specific.isEmpty() {
      return Fail UriError.NotAUrn(value.show())
    }
    Ok Urn(value, namespace.toLowerCase(), specific)
  }
}

/** The way back, and it is total because a `Urn` holds the `Uri` it was read from. */
extend Uri with From<Urn> {
  static fn from(value: Urn): Uri {
    value.uri()
  }
}
