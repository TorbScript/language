/**
 * The probe of the scheme-driven driver layer: one capability trait, two drivers, and a registry that is an
 * ordinary value the program builds - no reflection, no self-registration, no import side effect.
 */

use Uri from "./uri"
use File from "std/fs"
use Path from "std/path"

/**
 * The schemes a driver answers to, which is what every registry dispatches on. It declares no scheme of its own,
 * so it belongs beside `Uri` rather than in any one capability's package.
 */
public trait Schemes {
  /** The schemes this driver answers to, lower case. */
  fn schemes(): List<String>
}

/** What a storage driver refuses with. */
public type StorageFailure with Show, Error {
  /** No driver in the registry answers to the scheme, and the registry says which ones it knows. */
  case UnknownScheme(uri: String, known: List<String>)
  /** The driver answers to the scheme and the reference is still not one it can reach. */
  case NotAddressable(uri: String, reason: String)
  /** Nothing is stored under the reference. */
  case NotFound(uri: String)
  /** The driver reached the store and the store refused. */
  case Refused(uri: String, reason: String)

  fn show(): String {
    match self {
      .UnknownScheme(uri, known) => "no driver for `{uri}`: the registry knows {known.joined(separator: ", ")}"
      .NotAddressable(uri, reason) => "`{uri}` is not addressable: {reason}"
      .NotFound(uri) => "nothing is stored at `{uri}`"
      .Refused(uri, reason) => "`{uri}` was refused: {reason}"
    }
  }
}

/**
 * Reading and writing bytes somewhere a URI names. One trait per capability, and the scheme picks the driver:
 * `file:` and `memory:` are the two a standard library can carry, `s3:` and `webdav:` are packages of their own.
 */
public trait Storage with Schemes {
  /** The text stored at `uri`. */
  fn read(uri: Uri): Result<String, StorageFailure>

  /** Whether anything is stored at `uri`. */
  fn exists(uri: Uri): Result<Bool, StorageFailure>

  /** The references directly below `uri`. */
  fn list(uri: Uri): Result<List<Uri>, StorageFailure>

  /** Stores `text` at `uri`, replacing whatever was there. */
  var fn write(uri: Uri, text: String): Result<Void, StorageFailure>

  /** Removes whatever is stored at `uri`. */
  var fn delete(uri: Uri): Result<Void, StorageFailure>

  /** One storage over several drivers, chosen by `uri.scheme()`. The registry is itself a [Storage]. */
  static fn registry(drivers: List<Storage>): Storage {
    Registry.of drivers
  }
}

/**
 * A storage that picks a driver by the scheme of every reference it is handed.
 *
 * The drivers are a `var List` and the table maps a scheme to an **index** into it, so that a writing member
 * reaches the driver through the path (`storedDrivers[index].write(...)`) instead of binding a copy of it. A
 * `Map<String, Storage>` whose value is bound to a local is the copy trap, and this probe measured it: the write
 * answered `Ok` and the read after it answered `NotFound`.
 */
public type Registry with Storage {
  private var storedDrivers: List<Storage>
  private storedSchemes: Map<String, Int>

  /** The registry a program builds: `Storage.registry([FileStorage(), MemoryStorage()])`. */
  static fn of(drivers: List<Storage>): Registry {
    var table: Map<String, Int> = [:]
    for (index, driver) in drivers.indexed() {
      for scheme in driver.schemes() {
        table.set scheme, index
      }
    }
    Self drivers, table
  }

  /** Every scheme the registry answers to, sorted, which is what an unknown one is reported against. */
  fn schemes(): List<String> {
    storedSchemes.keys().sorted({ _ }).toList()
  }

  fn read(uri: Uri): Result<String, StorageFailure> {
    const index = indexOf(uri)?
    storedDrivers[index].read(uri)
  }

  fn exists(uri: Uri): Result<Bool, StorageFailure> {
    const index = indexOf(uri)?
    storedDrivers[index].exists(uri)
  }

  fn list(uri: Uri): Result<List<Uri>, StorageFailure> {
    const index = indexOf(uri)?
    storedDrivers[index].list(uri)
  }

  var fn write(uri: Uri, text: String): Result<Void, StorageFailure> {
    const index = indexOf(uri)?
    storedDrivers[index].write(uri, text)
  }

  var fn delete(uri: Uri): Result<Void, StorageFailure> {
    const index = indexOf(uri)?
    storedDrivers[index].delete(uri)
  }

  /** Where the driver for the scheme of `uri` is, or the failure that lists what the registry knows. */
  fn indexOf(uri: Uri): Result<Int, StorageFailure> {
    const scheme = uri.scheme() ?? ""
    match storedSchemes.get(scheme) {
      Some(index) => Ok index
      None => Fail StorageFailure.UnknownScheme(uri.show(), schemes())
    }
  }
}

/**
 * A driver that keeps everything in this process: the `memory:` scheme, and what a test writes against.
 *
 * It is the one driver whose state is inside the value, and therefore the one that measures the copy rule: the
 * registry reaches it through `storedDrivers[index]` and never binds it to a local.
 */
public type MemoryStorage with Storage {
  private var storedEntries: Map<String, String> = [:]

  fn schemes(): List<String> {
    ["memory"]
  }

  fn read(uri: Uri): Result<String, StorageFailure> {
    const key = keyOf(uri)?
    match storedEntries.get(key) {
      Some(text) => Ok text
      None => Fail StorageFailure.NotFound(uri.show())
    }
  }

  fn exists(uri: Uri): Result<Bool, StorageFailure> {
    Ok storedEntries.containsKey(keyOf(uri)?)
  }

  fn list(uri: Uri): Result<List<Uri>, StorageFailure> {
    const prefix = keyOf(uri)?
    var found: List<Uri> = []
    for key in storedEntries.keys().sorted({ _ }) {
      if key.startsWith(prefix) {
        found.add(Uri.tryFrom("memory:{key}").mapError({ _ => StorageFailure.NotAddressable key, "not a reference" })?)
      }
    }
    Ok found
  }

  var fn write(uri: Uri, text: String): Result<Void, StorageFailure> {
    const key = keyOf(uri)?
    storedEntries.set key, text
    Ok void
  }

  var fn delete(uri: Uri): Result<Void, StorageFailure> {
    const key = keyOf(uri)?
    storedEntries.remove key
    Ok void
  }

  /** The path of a `memory:` reference, and a failure for every other scheme. */
  fn keyOf(uri: Uri): Result<String, StorageFailure> {
    if uri.scheme() != Some("memory") {
      return Fail StorageFailure.NotAddressable(uri.show(), "`memory:` is the scheme this driver answers to")
    }
    Ok uri.path()
  }
}

/**
 * A driver that needs configuration: a region and a pair of credentials, which are in the **driver value** and not
 * in the reference. `s3://bucket/key` names a resource and nothing else, so it can be written in a manifest, logged
 * and compared; the secret is handed to the driver once, where a reader of the program can see where it came from.
 *
 * It reaches no network - this is a probe - and it is here for the shape: a configured driver is a value with
 * fields, and building the registry is where the configuration is named.
 */
public type ObjectStorage with Storage {
  /** The region, which is configuration and not part of the reference. */
  region: String
  private storedKeyIdentifier: String
  private storedSecret: String

  /** The credentials come from the environment at the one place the program builds its registry. */
  static fn of(region: String, keyIdentifier: String, secret: String): ObjectStorage {
    Self region, keyIdentifier, secret
  }

  fn schemes(): List<String> {
    ["s3"]
  }

  fn read(uri: Uri): Result<String, StorageFailure> {
    Fail StorageFailure.Refused(uri.show(), reach(uri))
  }

  fn exists(uri: Uri): Result<Bool, StorageFailure> {
    Fail StorageFailure.Refused(uri.show(), reach(uri))
  }

  fn list(uri: Uri): Result<List<Uri>, StorageFailure> {
    Fail StorageFailure.Refused(uri.show(), reach(uri))
  }

  var fn write(uri: Uri, text: String): Result<Void, StorageFailure> {
    Fail StorageFailure.Refused(uri.show(), "{reach(uri)}, and it would have written {text.byteLength()} bytes")
  }

  var fn delete(uri: Uri): Result<Void, StorageFailure> {
    Fail StorageFailure.Refused(uri.show(), reach(uri))
  }

  /** What a driver with credentials would do, written out so that the probe can print it. */
  fn reach(uri: Uri): String {
    const bucket = uri.host() ?? ""
    "bucket {bucket.showNested()} in {region.showNested()} as {storedKeyIdentifier.showNested()}, and this probe has no network"
  }
}

/** A driver that consumes `std/fs`: the `file:` scheme, and the one `Path` in the whole layer. */
public type FileStorage with Storage {
  fn schemes(): List<String> {
    ["file"]
  }

  fn read(uri: Uri): Result<String, StorageFailure> {
    const path = pathOf(uri)?
    File.readText(path).mapError({ problem => StorageFailure.Refused uri.show(), problem.show() })
  }

  fn exists(uri: Uri): Result<Bool, StorageFailure> {
    Ok File.exists(pathOf(uri)?)
  }

  fn list(uri: Uri): Result<List<Uri>, StorageFailure> {
    const path = pathOf(uri)?
    const names = File.list(path).mapError({ problem => StorageFailure.Refused uri.show(), problem.show() })?
    var found: List<Uri> = []
    for name in names {
      const below = Uri.tryFrom("{uri.show()}/{name}").mapError({ problem => StorageFailure.NotAddressable name, problem.show() })?
      found.add below
    }
    Ok found
  }

  var fn write(uri: Uri, text: String): Result<Void, StorageFailure> {
    const path = pathOf(uri)?
    File.writeText(path, text).mapError({ problem => StorageFailure.Refused uri.show(), problem.show() })
  }

  var fn delete(uri: Uri): Result<Void, StorageFailure> {
    Fail StorageFailure.Refused(uri.show(), "`std/fs` has no `remove` today")
  }

  /** The `Path` of a `file:` reference, which is the one conversion this whole layer needs. */
  fn pathOf(uri: Uri): Result<String, StorageFailure> {
    const path = Path.tryFrom(uri).mapError({ problem => StorageFailure.NotAddressable uri.show(), problem.show() })?
    Ok path.show()
  }
}
