/**
 * The bridge between [Path] and [Uri], and the probe of the capsule rule behind it: **neither direction is a
 * `From`**, so `Path` is not a second conversion pair of `Uri` and `Uri` keeps the one it has with `String`.
 *
 * `Uri.tryFrom(path)` is fallible only for a UNC share whose server name is not ASCII, which is the same gap IDNA
 * closes; `Path.tryFrom(uri)` is fallible for every URI that is not a `file:` URI.
 */

use Path, Root from "std/path"
use Uri, UriError, encodedSegment, percentDecoded from "./uri"

/** A `Path` written as a `file:` URI: the root becomes the authority and the first segment, the rest is encoded. */
extend Uri with TryFrom<Path, UriError> {
  static fn tryFrom(value: Path): Result<Uri, UriError> {
    var encoded: List<String> = []
    for component in value.components() {
      encoded.append encodedSegment(component)
    }
    const body = encoded.joined separator: "/"
    match value.root() {
      None => Uri.tryFrom body
      Some(.Unix) => Uri.tryFrom "file:///{body}"
      Some(.Drive(letter)) => Uri.tryFrom "file:///{letter}:/{body}"
      Some(.Share(server, share)) => Uri.tryFrom "file://{server}/{encodedSegment(share)}/{body}"
    }
  }
}

/** A `file:` URI read back as a `Path`, and a relative reference read as a relative path. */
extend Path with TryFrom<Uri, UriError> {
  static fn tryFrom(value: Uri): Result<Path, UriError> {
    if value.scheme().isSome() && value.scheme() != Some("file") {
      return Fail UriError.NotAFile(value.show())
    }
    var decoded: List<String> = []
    for segment in value.segments() {
      decoded.append(percentDecoded(segment)?)
    }
    const body = decoded.joined separator: "/"
    const host = value.host() ?? ""
    if !host.isEmpty() {
      return Ok Path.from("//{host}/{body}")
    }
    if value.scheme().isNone() && !value.path().startsWith("/") {
      return Ok Path.from(body)
    }
    // `file:///C:/x` carries its drive in the first segment, and `Path.from` reads a drive only at the front.
    const first = decoded.first() ?? ""
    if first.byteLength() == 2 && first.endsWith(":") {
      return Ok Path.from(body)
    }
    Ok Path.from("/{body}")
  }
}

/** The `Path` to `Uri` direction, named so that a reader of the probe's output sees which way it went. */
public fn fileUriOf(path: Path): Result<Uri, UriError> {
  Uri.tryFrom path
}

/** The `Uri` to `Path` direction. */
public fn pathOf(uri: Uri): Result<Path, UriError> {
  Path.tryFrom uri
}
