/** Translates expression trees to SQL. Pure: a tree and its captures go in, a fragment comes out. */

/** Why a query could not be translated to SQL: an [ExpressionNode] this provider does not support. */
public type QueryError {
  case Unsupported(what: String)
}

/** A piece of SQL with the values for its `?` placeholders. The driver binds them with its own `Encoder`: an
 * `EncodedValue` writes itself into any encoder. */
public type Fragment {
  sql: String
  parameters: List<EncodedValue> = []

  static fn raw(sql: String): Self {
    Self sql
  }

  static fn parameter(value: EncodedValue): Self {
    Self "?", [value]
  }

  /** `a.join(" AND ", b)` -> `(a AND b)` */
  fn join(keyword: String, other: Self): Self {
    Self "({sql} {keyword} {other.sql})", parameters.appendedAll(other.parameters)
  }

  fn wrap(before: String, after: String = ""): Self {
    copy sql: "{before}{sql}{after}"
  }
}

/** A fragment shows its SQL and how many parameters it binds; the values stay out of a log line. */
extend Fragment with Show {
  fn show(): String {
    if parameters.isEmpty() {
      return sql
    }
    "{sql} with {parameters.length()} parameters"
  }
}

/**
 * Turns one node of an [Expression]'s tree into a [Fragment] of SQL, recursively over its children.
 *
 * # Errors
 *
 * [QueryError.Unsupported] for a node kind this provider does not translate: a method call it does not recognize, or
 * any node outside the small subset handled here.
 */
public fn translate(node: ExpressionNode, captures: List<EncodedValue>): Result<Fragment, QueryError> {
  match node {
    // `_.age`: a field of the row parameter is a column
    .Field(.Parameter(_, _, _), name, _) => Fragment.raw name

    // Values never end up in the SQL text, always in the parameters
    .Literal(value, _) => Fragment.parameter value
    .Captured(index, _, _) => Fragment.parameter captures[index]

    .Unary(.Not, operand, _) => (translate(operand, captures)?).wrap("NOT (", ")")
    .Unary(.Negate, operand, _) => (translate(operand, captures)?).wrap("-")
    .Unary(.BitwiseNot, operand, _) => (translate(operand, captures)?).wrap("~")

    .Binary(operator, left, right, _) => {
      const a = translate(left, captures)?
      const b = translate(right, captures)?
      combined operator, a, b
    }

    // A few methods this provider knows
    .Call(Some(target), _, "startsWith", [prefix], _) => {
      const column = translate(target, captures)?
      column.join "LIKE", (translate(prefix, captures)?).wrap("", " || '%'")
    }
    .Call(Some(target), _, "contains", [part], _) => {
      const column = translate(target, captures)?
      column.join "LIKE", (translate(part, captures)?).wrap("'%' || ", " || '%'")
    }
    .Call(Some(target), _, "toLowerCase", [], _) => (translate(target, captures)?).wrap("LOWER(", ")")
    .Call(Some(target), _, "isSome", [], _) => (translate(target, captures)?).wrap("", " IS NOT NULL")

    .Conditional(condition, then, otherwise, _) => {
      const c = translate(condition, captures)?
      const t = translate(then, captures)?
      const o = translate(otherwise, captures)?
      Fragment(
        "CASE WHEN {c.sql} THEN {t.sql} ELSE {o.sql} END",
        c.parameters.appendedAll(t.parameters).appendedAll(o.parameters),
      )
    }

    // Everything else - and every node kind that is added in the future
    .Call(_, owner, method, _, _) => Fail QueryError.Unsupported("{owner}.{method}()")
    _ => Fail QueryError.Unsupported("this kind of expression")
  }
}

/**
 * Two fragments combined by a [BinaryOperator]: the SQL operator between them, `AND`/`OR` included alongside the
 * arithmetic and comparison ones - and `POWER(a, b)` for a power, which SQL writes as a function.
 */
fn combined(operator: BinaryOperator, left: Fragment, right: Fragment): Fragment {
  match operator {
    .Add => left.join "+", right
    .Subtract => left.join "-", right
    .Multiply => left.join "*", right
    .Divide => left.join "/", right
    .Remainder => left.join "%", right
    .Power => Fragment "POWER({left.sql}, {right.sql})", left.parameters.appendedAll(right.parameters)
    .BitwiseAnd => left.join "&", right
    .BitwiseOr => left.join "|", right
    .BitwiseExclusiveOr => left.join "#", right
    .ShiftLeft => left.join "<<", right
    .ShiftRight => left.join ">>", right
    .Equal => left.join "=", right
    .NotEqual => left.join "<>", right
    .Less => left.join "<", right
    .LessOrEqual => left.join "<=", right
    .Greater => left.join ">", right
    .GreaterOrEqual => left.join ">=", right
    .And => left.join "AND", right
    .Or => left.join "OR", right
  }
}
