use Query from "./query"

type User {
  id: Int
  name: String
  age: Int
  active: Bool
  nickname: String? = None
}

const minAge = 18
const initial = "A"

// --- In memory: `Iterable.filter(predicate: (value: Item) => Bool)` - the closures are executed ---------------

const localUsers = [
  User(1, "Ada", 36, active: true),
  User(2, "Alan", 41, active: false),
  User(3, "Grace", 17, active: true),
]

const local = localUsers
  .filter { _.age >= minAge && _.active }
  .filter { _.name.startsWith initial }
  .sorted { _.name }
  .take(10)
  .toList()                              // In memory, the pipeline is lazy until a terminal operation

print local                             // [User(id: 1, name: "Ada", ...)]

// --- Database: `Query.filter(predicate: Expression<(row: Row) => Bool>)` - the closures are translated -----------------
// Same code. The parameter type decides how the argument is read.

const remote = Query<User>("users")
  .filter { _.age >= minAge && _.active }
  .filter { _.name.startsWith initial }
  .sorted { _.name }
  .take(10)

match remote.toSql() {
  Ok(statement) => {
    print statement.sql
    // SELECT * FROM users WHERE ((age >= ?) AND active) AND (name LIKE ? || '%') ORDER BY name LIMIT 10
    print statement.parameters.length()
    // 2                                   Captured values are parameters, never SQL text
  }
  Fail(error) => print "Cannot translate: {error}"
}

// --- What a provider does not understand is its error, at runtime ----------------------------------------------

fn isLucky(name: String): Bool {
  name.chars().count() % 7 == 0
}

const unsupported = Query<User>("users").filter { isLucky _.name }
print unsupported.toSql()                // Fail(Unsupported("main.isLucky()"))

// --- What is not an expression cannot be quoted, at compile time -------------------------------------------------

// Query<User>("users").filter {
//   const limit = minAge * 2            // Compile error: a quoted closure must be a single expression
//   _.age >= limit
// }

// var counter: List<Int> = []
// Query<User>("users").filter { _.id == counter.length() }
//                                       // Compile error: captured `counter` is not `Encode`

// --- Quotations are values ---------------------------------------------------------------------------------------

const isAdult: Expression<(row: User) => Bool> = { _.age >= minAge }

print isAdult.source                     // "_.age >= minAge"
print describe(isAdult.captures())       // [Integer(18)] - captures are `Encode`, and `describe` renders one
print isAdult.value()(localUsers[2])     // false - the ordinary closure is still there

const adults = Query<User>("users").filter(isAdult)

// --- Not only closures: `fn assert(condition: Expression<Bool>)` ----------------------------------------------------------

assert(local.length() == 1)
assert(local.length() > minAge)
// Assertion failed: local.length() > minAge   (local = [User(...)], minAge = 18)   at main.trb:79:1
