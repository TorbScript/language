/**
 * The query builder: [Query] records `filter`/`sorted`/`take` as [Quoted] expressions instead of running them, and
 * `toSql` translates them through `sql.trb` only when the caller finally asks for the statement.
 */

use Fragment, QueryError, translate from "./sql"

/** What a query keeps of a quotation: the static tree and the captured values of this particular call. */
type Quoted {
  tree: ExpressionNode
  captures: List<EncodedValue>

  static fn of<Row>(expression: Expression<Row>): Self {
    Self expression.tree, expression.captures()
  }

  /** `{ _.age >= 18 }` arrives as a `Lambda` node, the translator wants its body. */
  fn body(): ExpressionNode {
    match tree {
      .Lambda(_, body, _) => body
      other => other
    }
  }

  fn toSql(): Result<Fragment, QueryError> {
    translate body(), captures
  }
}

/**
 * A description of a query. Has the same vocabulary as `Iterate` - but its parameters are `Expression`,
 * so the closures are not executed, they are translated.
 */
public type Query<Row> {
  table: String
  private conditions: List<Quoted> = []
  private ordering: List<Quoted> = []
  private limit: Int? = None

  fn filter(predicate: Expression<(row: Row) => Bool>): Self {
    copy conditions: conditions.appended(Quoted.of(predicate))
  }

  fn sorted<Key: Compare>(by: Expression<(row: Row) => Key>): Self {
    copy ordering: ordering.appended(Quoted.of(by))
  }

  fn take(amount: Int): Self {
    copy limit: amount
  }

  fn toSql(): Result<Fragment, QueryError> {
    var statement = Fragment.raw "SELECT * FROM {table}"

    var keyword = " WHERE "
    for condition in conditions {
      const fragment = condition.toSql()?
      statement = Fragment(
        statement.sql + keyword + fragment.sql,
        statement.parameters.appendedAll(fragment.parameters),
      )
      keyword = " AND "
    }

    keyword = " ORDER BY "
    for key in ordering {
      const fragment = key.toSql()?
      statement = Fragment(
        statement.sql + keyword + fragment.sql,
        statement.parameters.appendedAll(fragment.parameters),
      )
      keyword = ", "
    }

    if const Some(amount) = limit {
      statement = statement.wrap "", " LIMIT {amount}"
    }
    statement
  }
}
