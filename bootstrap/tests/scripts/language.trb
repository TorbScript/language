// Traits with default methods, implemented at the declaration and afterwards
trait Shape {
  fn area(): Float

  fn describe(): String {
    "{name()} with area {area()}"
  }

  fn name(): String {
    "Shape"
  }
}

type Square with Shape {
  side: Float

  fn area(): Float {
    side * side
  }
}

type Circle {
  radius: Float
}

extend Circle with Shape {
  fn area(): Float {
    3.0 * radius * radius
  }

  fn name(): String {
    "Circle"
  }
}

const shapes: List<Shape> = [Square(2), Circle(1.0)]
for shape in shapes {
  print shape.describe()
}

// Extension methods on built-in types
extend String {
  fn shout(): String {
    "{toUpperCase()}!"
  }
}

print "hello".shout()

// Errors: `?` converts through the case that wraps the error
type ConfigError {
  message: String
}

type AppError {
  case Config(cause: ConfigError)
  case Startup(message: String)
}

fn loadConfig(path: String): Result<Int, ConfigError> {
  if path.isEmpty() {
    return Fail ConfigError("no path")
  }
  Ok path.byteLength()
}

fn start(path: String): Result<Int, AppError> {
  const size = loadConfig(path)?
  Ok(size * 2)
}

print start("app.trb"), start("")
print AppError.from(ConfigError("direct"))

// Lazy parameters are evaluated at most once, and only when used
var evaluations = 0

fn expensive(): Int {
  evaluations = evaluations + 1
  42
}

fn pick(useIt: Bool, value: lazy Int): Int {
  if useIt {
    value + value
  } else {
    0
  }
}

print pick(false, expensive()), pick(true, expensive()), evaluations
print(None ?? expensive(), Some(1).orElse(expensive()), evaluations)

// Receiver closures, property commands and `var` parameters of closures: the configuration DSL
type Database {
  var url: String = ""
  var poolSize: Int = 1
}

type Server {
  var port: Int = 80
  var database: Database = Database()
  var routes: List<String> = []
  var onStart: () => String = { "default" }

  var fn route(path: String) {
    routes.add path
  }
}

fn server(configure: (var self: Server) => Void): Server {
  var result = Server()
  configure result
  result
}

const configured = server {
  port 8080
  database {
    url "postgres://localhost"
    poolSize 4
  }
  route "/health"
  route "/users"
  // A closure that a field keeps outlives the call, so it may not capture the receiver: a reference is second-class
  onStart { "started" }
}
print configured.port, configured.database, configured.routes, configured.onStart()

// Value semantics: copies are independent, paths change in place
type Counter {
  var count: Int = 0

  var fn increment() {
    count = count + 1
  }
}

var counters = [Counter(), Counter()]
var first = counters[0]
first.increment()
counters[1].increment()
counters[1].increment()
print first.count, counters.map({ _.count }).toList()

var samples = [5, 3, 9, 1, 7]
samples[1..4].sort({ _ })
print samples, samples[..2], samples.sorted({ 0 - _ }).toList()

fn fill(var target: List<Int>, amount: Int) {
  for index in 0..amount {
    target.add index
  }
}

var buffer: List<Int> = []
fill buffer, 3
const snapshot = buffer
fill buffer, 2
print snapshot, buffer

// Patterns
fn classify(values: List<Int>): String {
  match values {
    [] => "empty"
    [only] => "one: {only}"
    [first, ..., last] if last - first > 2 => "from {first} to {last}"
    [first, ...rest] => "many, starting with {first} and {rest.length()} more"
  }
}

print classify([]), classify([1]), classify([1, 2, 3]), classify([1, 2, 3, 4, 5])

const (quotient, remainder) = (7 / 2, 7 % 2)
const range = (lowest: 1, highest: 9)
print quotient, remainder, range.lowest, range.1, range

// A `fn` inside of a block is hoisted and sees its parameters and the file, not the bindings around it: what it needs
// from the caller is a parameter, and a list it fills is a `var` one
fn outer(limit: Int): List<Int> {
  var seen: List<Int> = []
  visit seen, 0, limit
  seen
}

fn visit(var seen: List<Int>, value: Int, limit: Int) {
  if value < limit {
    seen.add value
    visit(seen, value + 1, limit)
  }
}

print outer(4)

// Sets and maps iterate in insertion order
var tags = Set.of "b", "a", "b", "c"
tags.remove "a"
print tags, tags.contains("c"), tags.union(["z"]).length()
var lengths: Map<String, Int> = [:]
for word in ["one", "three"] {
  lengths.set word, word.byteLength()
}
print lengths, lengths.keys().toList(), lengths["three"]

// Cases: `.Case` where the type is known, `Type.Case` everywhere, or imported by name
type Signal {
  case Red
  case Green
  case Blinking(interval: Int)

  fn next(): Signal {
    match self {
      Red => .Green
      .Green => .Blinking(2)
      .Blinking(_) => .Red
    }
  }
}

// A case is imported by its path. Without `from` the path is resolved in this file's own scope, which is what a file
// that declares the type itself needs
use Signal.Red, Signal.Blinking
// `as` gives an import a local name of its own, for a case as much as for a type
use Signal.Green as Go

var signal: Signal = .Red
signal = signal.next()
print(signal, signal == .Green, signal.next(), Blinking(5).next() == Red, Go == signal)
signal = .Blinking(7)
const described = match signal {
  .Blinking(interval) if interval > 5 => "slow"
  other => "something else: {other}"
}
print described

// An imported case needs nothing in front of it in a pattern either: a binding would have to start lowercase
const label = match signal {
  Red => "red"
  Go => "green"
  Blinking(interval) => "blinking {interval}"
}
print label

// `void` is the one value of `Void`, as `true` and `false` are the values of `Bool`
const done: Result<Void, String> = Ok(void)
print(done == Ok(void), void == void)

// `.Case` inside a list, a tuple or `Some(...)` resolves element-wise against the other side of `==`/`!=`
const signals: List<Signal> = [signal, Red]
print(signals == [.Blinking(7), .Red])
print(signals == [.Blinking(3), .Red])
print(signals != [.Blinking(3), .Red])
print((signal, "info") == (.Blinking(7), "info"))
print(Some(signal) == Some(.Blinking(7)))

// Multi-line strings: dedented by the indentation of their first line, the leading line break gone, interpolated
// values never dedented
const audience = "world"
const greeting = """
  Hello, {audience}!
  Second line.
  """
print greeting

// Raw multi-line strings are dedented too, but their escapes and braces stay literal
const pattern = r"""
  literal braces {like this} and backslashes \n stay as written
  """
print pattern

// `by` binds to one element of the `with` list, and the element may be an `&` group: `Add` and `Subtract` are
// delegated together to `value`, `Compare` is delegated on its own, `max` (a default member of the trait) stays the
// trait's. The three traits are the prelude's, which is what makes `a + b` and `a > b` mean them
type Seconds with Add & Subtract by value, Compare by value {
  value: Int
}

const total = Seconds(5) + Seconds(2)
const difference = Seconds(5) - Seconds(2)
const longer = Seconds(5).max(Seconds(2))
print(total, difference, longer, Seconds(5) > Seconds(2))
