name "torbscript/stage-0-scripts"
version "0.1.0"

// The regression scripts of stage 0 (`bootstrap/crates/torb-cli/tests/self_hosted.rs`): one long program per file,
// run by the interpreter and compared with its `.expected`. They are valid TorbScript and are checked, which is why
// this is a workspace of its own whose only members are the standard library - a second `check` in the gate list
// (`compiler/CONTRIBUTING.md`) reaches it.
//
// A behaviour that both back ends have to agree on belongs in `../native/` instead: these scripts run on stage 0 only.
workspace {
  members "../../../std/*"
}

test {
  input "."
}
