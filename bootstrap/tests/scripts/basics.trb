type Point {
  var x: Int
  var y: Int

  fn area(self): Int {
    x * y
  }

  fn translate(var self, deltaX: Int = 0, deltaY: Int = 0) {
    x = x + deltaX
    y = y + deltaY
  }

  fn translated(self, deltaX: Int = 0, deltaY: Int = 0): Point {
    copy(x: x + deltaX, y: y + deltaY)
  }

  fn square(size: Int): Self {
    Self(size, size)
  }

  const origin = Point(0, 0)
}

type Shape {
  case Circle(radius: Float)
  case Rectangle(width: Float, height: Float)
  case Empty

  fn area(self): Float {
    match self {
      .Circle(radius) => Float.pi * radius * radius
      .Rectangle(width, height) => width * height
      .Empty => 0.0
    }
  }
}

fn incrementTwice(var target: Point) {
  target.translate(deltaX: 1)
  target.translate(deltaX: 1)
}

var p = Point(x: 10, y: 20)
const q = p
p.x = 20
p.translate(deltaX: 5)
print "p = {p}, q = {q}, area = {p.area()}"
print q.translated(deltaY: 1)
print Point.square(3), Point.origin

var points = [Point(1, 1), Point(2, 2)]
points[0].x = 100
incrementTwice(points[1])
points.add(Point(3, 3))
print points

const shapes = [Shape.Circle(1.0), Shape.Rectangle(2.0, 3.0), Shape.Empty]
print shapes.map({ _.area() })

var counts: Map<String, Int> = [:]
for word in "a b a c b a".split(" ") {
  counts[word] = (counts.get(word) ?? 0) + 1
}
print counts

const description = match 7 {
  0 => "zero"
  1 | 2 | 3 => "small"
  4..=9 => "medium"
  _ => "large"
}
print description

fn parse(text: String): Result<Int, NumberParseError> {
  const value = Int.parse(text)?
  Ok(value * 2)
}
print parse("21"), parse("x")

const names = ["Zoe", "Adam", "Mia"]
print names.sorted({ _ }).map({ "{_}!" }), names.first()?.byteLength()
print String.join(names, separator: ", ")

var total = 0
const addToTotal = { amount: Int => total = total + amount }
addToTotal(5)
addToTotal(7)
print total
