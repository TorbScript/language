use Process from "std/process"

/**
 * `Result.expect` panics with the message **and** the error behind it, so the message says what was expected and the
 * error says what happened. The two `expect` are two files of `std/core`, and the frame says which one.
 */
type ConfigError {
  key: String

  fn show(self): String {
    "there is no value for {key}"
  }
}

fn valueOf(key: String): Result<Int, ConfigError> {
  if key == "port" {
    return Ok 8080
  }
  Fail ConfigError(key)
}

print valueOf("port").expect("a port")
print valueOf("host").expect("a host")

Process.exit 0
