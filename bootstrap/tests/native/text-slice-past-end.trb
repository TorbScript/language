use Process from "std/process"

/**
 * A slice of a text is measured in **bytes**, and an offset past the end panics with the byte count of the text - not
 * with its length in characters, which is a different number for every text that is not ASCII.
 */
fn upTo(text: String, limit: Int): String {
  text[0..limit]
}

const text = "grüß"

print text.byteLength()
print upTo(text, 4)
print upTo(text, 9)

Process.exit 0
