/**
 * What a failed `assert` shows for every kind of scalar it can have read.
 *
 * The language says a failed assertion names the source of the condition and every value the condition read from around
 * it. A scalar is shown by its value, in the words a value is described in: `the Int 1`, `the String "hi"`,
 * `the Char 'a'`, `the Float 1.5`, `the Bool true` - a text and a character quoted, a number bare. Both implementations
 * write the same line for each of them, which is what this pins.
 *
 * A capture that is **not** a scalar is its name and its type instead, and that is the one thing the two do not agree
 * on: `bootstrap/tests/native/binary-only/` holds it and the README says why.
 *
 * Every assertion here fails on purpose, so the run recovers five panics and the leak gate does not apply to it.
 */
use Process from "std/process"
use test from "std/test"

test "an integer" {
  const count = 1
  const wanted = 2
  assert(count == wanted)
}

test "a text" {
  const word = "hi"
  const wanted = "ho"
  assert(word == wanted)
}

test "a character" {
  const letter = 'a'
  const wanted = 'b'
  assert(letter == wanted)
}

test "a float" {
  const ratio = 1.5
  const wanted = 2.25
  assert(ratio == wanted)
}

test "a boolean" {
  const flag = true
  const wanted = false
  assert(flag == wanted)
}

Process.exit 0
