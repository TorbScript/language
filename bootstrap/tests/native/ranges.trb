use Process from "std/process"

/**
 * A `Range` as a value, iterated, measured and shown - all four spellings of one.
 *
 * `Range<Int>.iterator` and `length` are **TorbScript** since the fourth round of 5.7 (`RangeIterator` in
 * `std/core/src/range.trb`), and `Show` writes the *source* form rather than the fields: a reader writes `0..10`, so that
 * is what both back ends print. Keeping the two identical is what made stage 0 remember whether a start was written and
 * whether the range was inclusive at all.
 *
 * A range of anything but `Int` is deliberately not here: stage 0's own `Range` holds two integers and nothing else, so
 * `"a".."c"` is a value it cannot build at all, and a program that uses one cannot be compared with the interpreter.
 */

fn shown() {
  const half = 2..5
  print half
  const inclusive = 1..=3
  print inclusive
  const fromHere = 7..
  print fromHere
  const upTo = ..4
  print upTo
}

fn measured() {
  const half = 2..5
  print half.length()
  const inclusive = 1..=3
  print inclusive.length()
  const backwards = 5..2
  print backwards.length()
  print backwards.isEmpty()
}

fn walked() {
  var sum = 0
  for value in 1..5 {
    sum = sum + value
  }
  print sum
  var inclusiveSum = 0
  for value in 1..=5 {
    inclusiveSum = inclusiveSum + value
  }
  print inclusiveSum
  var taken = 0
  for value in 0.. {
    if value > 3 {
      break
    }
    taken = taken + value
  }
  print taken
  const collected = (0..4).map({ _ * _ }).toList()
  print collected
}

fn contained() {
  const half = 2..5
  print half.contains(2)
  print half.contains(5)
  const inclusive = 2..=5
  print inclusive.contains(5)
}

shown()
measured()
walked()
contained()

Process.exit 0
