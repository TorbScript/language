/**
 * The generated `compare` of a **tuple**: lexicographic, field by field, each field through its own `Compare`.
 *
 * A tuple is the one shape the checker derives an order for - an order over a `type` is a decision and not a structure
 * (TYPECHECKER 4.4) - and it is what `sorted { (a, b) }` and `sort({ (_.length(), _) })` are built on, so the compiler's
 * own passes sort by one at three places. Before this the generated body refused everything but a number, a `String` and
 * a `Char`.
 *
 * What is under test is the lexicographic rule itself: the first field that is not equal decides, a tuple whose first
 * fields agree falls through to the next one, and two tuples that agree everywhere are equal. The widths are mixed on
 * purpose (an `Int`, a `String`, a `Char`, a `Bool`-free `Float`, and a tuple inside a tuple) because each field goes
 * through a *different* member.
 */
fn pairs() {
  const first = (1, "b")
  print(first < (2, "a"))
  print(first < (1, "c"))
  print(first < (1, "b"))
  print(first > (1, "a"))
  print(first > (0, "z"))
  print(first == (1, "b"))
  print(first <= (1, "b"))
  print(first >= (1, "b"))
}

/**
 * The `Ordering` itself, through the one door the checker opens for a tuple: `sorted`, which calls `compare`. A tuple has
 * no `compare` *member* - the checker gives it the operators and nothing else - while stage 0 answers one, which is one
 * more entry on 5.14's list of differences between the two.
 */
fn ordering() {
  const rows = [(2, "a"), (1, "z"), (1, "b"), (2, "a")]
  print rows.sorted({ _ }).toList()
}

/**
 * A `Float64` field is **not** here, and its absence is a finding of its own: `Float64.compare` is the one `.Runtime`
 * comparison of the manifest (a total order with `nan` above everything is no comparison intrinsic), and it answers
 * `int32_t` where the declaration answers `Ordering` - so it needs a wrapper that builds the three cases out of a sign,
 * which is a shape `NativeResult` does not have yet. Nothing of the compiler compares a float, so it blocks no build.
 */
fn triples() {
  const first = (1, 'a', "m")
  print(first < (1, 'a', "n"))
  print(first < (1, 'b', "a"))
  print(first > (1, 'a', "l"))
  print(first == (1, 'a', "m"))
}

fn nested() {
  const first = ((1, 2), "x")
  print(first < ((1, 3), "a"))
  print(first > ((1, 1), "z"))
  print(first < ((1, 2), "y"))
  print(first == ((1, 2), "x"))
}

fn sorting() {
  var words = ["pear", "fig", "apple", "kiwi"]
  words.sort({ (_.byteLength(), _) })
  print words
  var numbers = [3, 1, 2]
  numbers.sort({ (0 - _, _) })
  print numbers
}

fn single() {
  // A one-field tuple is the degenerate case, and it is exactly the field's own order
  print((1, 2) < (1, 3))
  print(("a", 1) < ("b", 0))
}

pairs()
ordering()
triples()
nested()
sorting()
single()
