/**
 * `test` and `group` of `std/test`, and what a run of them writes.
 *
 * A test is a name and a closure, and a group is a name and a closure of tests: one line per test, `  ok      ` and the
 * name, with the groups it stands in in front of it and ` > ` between them. Groups nest freely, so a suite is organized
 * the way its subject is, and a `test` outside every group is its bare name.
 *
 * Nothing about the format is a back end's own: both implementations write these lines from the same place, so a test
 * file reads the same way whoever ran it.
 */
use Process from "std/process"
use test, group from "std/test"

group "numbers" {
  test "adds" {
    const left = 2
    const right = 3
    assert(left + right == 5)
  }

  group "order" {
    test "compares" {
      const smaller = 1
      const larger = 2
      assert(smaller < larger)
    }
  }
}

test "outside every group" {
  const written = "torb"
  assert(written.byteLength() == 4)
}

Process.exit 0
