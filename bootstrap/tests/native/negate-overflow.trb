use Process from "std/process"

/**
 * The one overflow of a unary operator: the smallest `Int64` has no positive counterpart, so `-value` leaves the range
 * of the type. The message names `-`, and `absolute()` is the same panic for the same reason.
 */
fn negated(value: Int): Int {
  0 - value
}

const smallest = 0 - 9223372036854775807 - 1

print smallest

Process.exit negated(smallest)
