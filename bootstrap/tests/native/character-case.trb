use Process from "std/process"

/**
 * **Case mapping is the simple one-to-one mapping of one code point, over ASCII and the letters of Latin-1.**
 *
 * A `Char` is one code point and answers one, so a character whose uppercase is *two* code points is answered unchanged:
 * `ß` stays `ß`, and `SS` is what a future `String` mapping with the full tables will write. `ÿ` is the one Latin-1
 * letter whose partner lies above Latin-1 (`Ÿ`), `×` and `÷` are symbols and not letters, and everything above Latin-1
 * is left alone until the full Unicode tables arrive.
 *
 * `String.toUpperCase` is the same mapping per character, so a text is exactly as many bytes as it was.
 */
fn mappedCharacters(text: String): String {
  var upper = ""
  for character in text.chars() {
    upper = upper + "{character.toUpperCase()}"
  }
  upper
}

fn loweredCharacters(text: String): String {
  var lower = ""
  for character in text.chars() {
    lower = lower + "{character.toLowerCase()}"
  }
  lower
}

print mappedCharacters("grüß dich, ärmel")
print loweredCharacters("GRÜSS DICH, ÄRMEL")
print "grüß dich".toUpperCase()
print "GRÜSS DICH".toLowerCase()
print("grüß dich".toUpperCase().byteLength() == "grüß dich".byteLength())
// A symbol and a letter above Latin-1 are answered unchanged
print mappedCharacters("a×b÷c"), mappedCharacters("αΩ")
print 'ÿ'.toUpperCase(), 'Ÿ'.toLowerCase()
print 'ß'.toUpperCase(), 'ß'.isLetter(), '7'.isDigit(), '×'.isLetter()

Process.exit 0
