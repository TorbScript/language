# Serves the read side of torb.dev and packages.torb.dev: install.sh, install.ps1, /download/... (what release-sync
# writes) and /index, /archives, /docs of the registry (docs/design/RELEASE.md section 7.11, "reading is static
# files"). Nothing here writes; release-sync and the registry's own write service are the only writers of /srv/torb.
#
#   docker build -f tools/deploy/Dockerfile.static -t torb-static .
#
# Built from the repository root so it can copy tools/install.sh and tools/install.ps1 onto the site.

FROM nginx:1.27-alpine
COPY tools/install.sh /usr/share/nginx/html/install.sh
COPY tools/install.ps1 /usr/share/nginx/html/install.ps1
COPY tools/deploy/nginx.conf /etc/nginx/conf.d/default.conf
# /srv/torb is a volume in docker-compose.example.yml: this image never writes it, only serves it
