# The settings of tools/deploy/compose.example.yml. Copy to `.env` next to `compose.yml` and fill in; `.env` holds
# secrets and is never committed. docs/contributing/releasing.md, "The root server", says where each value comes from.

# The images: a version (0.2.0), `latest` for the newest stable release, or `nightly`
TORB_VERSION=latest
# Where the data lives on the host: download/, registry/, database/, index-mirror/ below it
TORB_DATA=/srv/torb

# The Traefik that already runs on the machine: the Docker network it watches, its HTTPS entrypoint and its
# certificate resolver, as its own configuration names them
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# release-sync: the forge and repository the releases come from (the defaults need no change), a read-only token only
# while the repository is private (empty for a public one), and the secret of the forge's webhook
# (`openssl rand -hex 32`, entered in the webhook too). The public signing key is ./cosign.pub beside compose.yml.
RELEASE_SYNC_FORGE=forgejo
RELEASE_SYNC_URL=https://git.torb.dev
RELEASE_SYNC_REPOSITORY=torbscript/language
RELEASE_SYNC_TOKEN=
RELEASE_SYNC_WEBHOOK_SECRET=

# The registry: the operator's token (any long random string, e.g. `openssl rand -hex 32`) while accounts are created;
# empty afterwards
REGISTRY_ADMINISTRATOR_TOKEN=
# The Forgejo instances whose Actions may publish through trusted publishing, by issuer; GitHub Actions always may
REGISTRY_FORGEJO_ISSUERS=https://git.torb.dev/api/actions
# The seed of the key every record of the index is signed with: `docker compose run --rm registry signing-key` prints
# one. Keep a copy off the machine. The successor's public key is set only while a new key is announced
REGISTRY_SIGNING_KEY=
REGISTRY_SIGNING_KEY_SUCCESSOR=
# The index mirror: the path of a clone of the public index repository inside the container, and whether to push
REGISTRY_MIRROR=
REGISTRY_MIRROR_PUSH=0

# Backups: S3-compatible object storage at another provider (Litestream for the database, restic for the files). The
# endpoint is a URL, e.g. https://s3.eu-central-003.backblazeb2.com; the bucket exists already
BACKUP_ENDPOINT=
BACKUP_REGION=auto
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=
