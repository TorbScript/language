# ghcr.io/torbscript/release-sync: pulls GitHub releases onto the server behind torb.dev/download (tools/release-sync,
# docs/design/RELEASE.md section 7.11), built from a release - never from a checkout. The build context is a directory
# with the release's assets:
#
#   torb-<version>-linux-x64.tar.gz     the toolchain the build stage compiles with (linux-arm64 for an arm64 image)
#   torb-<version>-linux-arm64.tar.gz
#   torb-<version>-source.tar.gz        `git archive` of the tag, for tools/release-sync
#
#   docker buildx build -f tools/deploy/Dockerfile.release-sync --build-arg VERSION=0.2.0 \
#     --platform linux/amd64,linux/arm64 dist/
#
# The runtime stage has exactly the tools the program shells out to: curl for downloads, sha256sum (coreutils) for
# hashing, openssl for the webhook's HMAC, and cosign for the signature - a release release-sync cannot verify is
# refused, so cosign is not optional here.

FROM debian:bookworm-slim AS build
ARG VERSION
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY torb-${VERSION}-source.tar.gz torb-${VERSION}-linux-*.tar.gz /dist/
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) target=linux-x64 ;; \
      arm64) target=linux-arm64 ;; \
      *) echo "no toolchain is released for $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    mkdir -p /opt/torb /src; \
    tar -xzf "/dist/torb-$VERSION-$target.tar.gz" -C /opt/torb --strip-components=1; \
    tar -xzf "/dist/torb-$VERSION-source.tar.gz" -C /src --strip-components=1
WORKDIR /src
RUN /opt/torb/bin/torb build tools/release-sync/src/main.trb --release --output /out/release-sync

FROM debian:bookworm-slim
ARG VERSION
ARG TARGETARCH
# cosign has no Debian package: a pinned release, checked against the SHA-256 its own release lists
ARG COSIGN_VERSION=2.4.1
ARG COSIGN_SHA256_AMD64=8b24b946dd5809c6bd93de08033bcf6bc0ed7d336b7785787c080f574b89249b
ARG COSIGN_SHA256_ARM64=3b2e2e3854d0356c45fe6607047526ccd04742d20bd44afb5be91fa2a6e7cb4a
LABEL org.opencontainers.image.title="release-sync" \
      org.opencontainers.image.description="Pulls signed TorbScript releases onto the server behind torb.dev/download" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MIT"
RUN set -eu; \
    apt-get update && apt-get install -y --no-install-recommends ca-certificates curl openssl coreutils; \
    rm -rf /var/lib/apt/lists/*; \
    case "$TARGETARCH" in \
      amd64) sum="$COSIGN_SHA256_AMD64" ;; \
      arm64) sum="$COSIGN_SHA256_ARM64" ;; \
      *) echo "no cosign for $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/cosign \
      "https://github.com/sigstore/cosign/releases/download/v$COSIGN_VERSION/cosign-linux-$TARGETARCH"; \
    echo "$sum  /usr/local/bin/cosign" | sha256sum -c -; \
    chmod 755 /usr/local/bin/cosign; \
    mkdir -p /srv/torb/download; \
    chown 1000:1000 /srv/torb/download
COPY --from=build /out/release-sync /usr/local/bin/release-sync
ENV RELEASE_SYNC_ROOT=/srv/torb \
    RELEASE_SYNC_LISTEN=0.0.0.0:8088
USER 1000:1000
EXPOSE 8088
ENTRYPOINT ["/usr/local/bin/release-sync"]
