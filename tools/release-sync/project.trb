// Pulls the forge's releases (git.torb.dev) onto the host that serves torb.dev/download, verified and placed under
// <root>/download/<version>/ (docs/design/RELEASE.md section 7.11). Nobody's workspace member: checked and tested on
// its own, the way any standalone package is (`torb check tools/release-sync`).
name = "release-sync"
version = "0.1.0"

build {
  input = "src/main.trb"
}
test {
  input = "tests"
}
