/**
 * What a tag says about its release, and which releases the periodic check places: the version and the channel of a
 * tag, the order of two versions of one channel, and - from the newest releases the forge lists - the newest stable
 * release, the newest preview and the nightlies of the last thirty days, the ones `<root>/download/` keeps
 * (docs/design/RELEASE.md, "Channels": 30 days of nightly archives). Everything here decides without the network or
 * the disk.
 */

use Ordering from "std/core"
use ReleaseInfo from "./forge"

/** How many days of nightlies the periodic check places: the thirty days the forge keeps a nightly for. */
public const nightlyDays = 30

/** `v0.2.0` -> `0.2.0`; a nightly's tag (`nightly-20260925`) has no `v` and is already the version. */
public fn versionOf(tag: String): String {
  if tag.startsWith("v") {
    tag.sliceBytes 1, tag.byteLength()
  } else {
    tag
  }
}

/**
 * The channel `versions.txt` lists a version under: `nightly` for `nightly-YYYYMMDD`, `preview` for a pre-release - a
 * `-` after the numbers, `0.1.0-rc.1`, `1.0.0-beta.2`, `2.0.0-alpha.1` - and `stable` for every other tagged release.
 */
public fn channelOf(version: String): String {
  if version.startsWith("nightly-") {
    "nightly"
  } else if version.contains("-") {
    "preview"
  } else {
    "stable"
  }
}

/**
 * The order of two versions, the newer one greater, by SemVer's precedence: the numbers before the first `-` segment by
 * segment (`0.10.0` after `0.9.0`), then a release after every pre-release of its numbers (`0.1.0-rc.1` before
 * `0.1.0`), and two pre-releases identifier by identifier - so `alpha` < `beta` < `rc`, and `rc.2` < `rc.10`. A
 * nightly's date is in its name, so two nightlies compare by their dates.
 */
public fn compareVersions(first: String, second: String): Ordering {
  const (firstNumbers, firstPreRelease) = splitPreRelease first
  const (secondNumbers, secondPreRelease) = splitPreRelease second
  const order = compareIdentifiers firstNumbers.split(".").toList(), secondNumbers.split(".").toList()
  if order != Ordering.Equal {
    return order
  }
  match (firstPreRelease, secondPreRelease) {
    (None, None) => Ordering.Equal
    (None, Some(_)) => Ordering.Greater
    (Some(_), None) => Ordering.Less
    (Some(one), Some(other)) => compareIdentifiers one.split(".").toList(), other.split(".").toList()
  }
}

/** `0.1.0-rc.1` -> `0.1.0` and `rc.1`, split at the first `-`; a version without one has no pre-release. */
fn splitPreRelease(version: String): (String, String?) {
  match version.splitOnce("-") {
    Some((numbers, rest)) => (numbers, Some(rest))
    None => (version, None)
  }
}

/**
 * Two lists of identifiers, one pair at a time: two numbers as numbers, a number before a word, two words as text -
 * and where one list is the start of the other, the shorter one first (semver.org, "Precedence").
 */
fn compareIdentifiers(first: List<String>, second: List<String>): Ordering {
  var index = 0
  while index < first.length() && index < second.length() {
    const order = match (Int.tryFrom(first[index]).ok(), Int.tryFrom(second[index]).ok()) {
      (Some(left), Some(right)) => left.compare right
      (Some(_), None) => Ordering.Less
      (None, Some(_)) => Ordering.Greater
      (None, None) => first[index].compare second[index]
    }
    if order != Ordering.Equal {
      return order
    }
    index = index + 1
  }
  first.length().compare(second.length())
}

/** A version that sorts as [compareVersions] orders it: the key of the stable and preview lines of `versions.txt`. */
type VersionKey with Compare {
  version: String

  fn compare(other: Self): Ordering {
    compareVersions version, other.version
  }
}

/**
 * `versions.txt` with `version` of `channel` in it - its old line, if any, replaced - and every line in the order the
 * installers read it: `install.sh` and `install.ps1` take the first line of their channel, so each channel's lines come
 * newest first - stable, then preview, then nightly - whatever order the releases were placed in. A line of another
 * shape is kept, after them.
 */
public fn listedVersions(before: String, version: String, channel: String): String {
  var stable: List<String> = []
  var preview: List<String> = []
  var nightly: List<String> = []
  var other: List<String> = []
  for line in before.lines() {
    const words = line.trim().split(" ").filter({ !_.isEmpty() }).toList()
    if words.isEmpty() || words[0] == version {
      continue
    }
    if words.length() == 2 && words[1] == "stable" {
      stable.append words[0]
    } else if words.length() == 2 && words[1] == "preview" {
      preview.append words[0]
    } else if words.length() == 2 && words[1] == "nightly" {
      nightly.append words[0]
    } else {
      other.append line.trim()
    }
  }
  match channel {
    "stable" => stable.append version
    "preview" => preview.append version
    "nightly" => nightly.append version
    _ => other.append "{version} {channel}"
  }
  const newestFirst: List<String> = [
    ...stable.sorted({ VersionKey _ }).reversed().map({ "{_} stable" }),
    ...preview.sorted({ VersionKey _ }).reversed().map({ "{_} preview" }),
    ...nightly.sorted({ _ }).reversed().map({ "{_} nightly" }),
    ...other,
  ]
  "{newestFirst.joined(separator: "\n")}\n"
}

/** The first stable version of a `versions.txt` [listedVersions] wrote: the newest stable release. */
public fn newestStableIn(list: String): String? {
  for line in list.lines() {
    const words = line.trim().split(" ").filter({ !_.isEmpty() }).toList()
    if words.length() == 2 && words[1] == "stable" {
      return words[0]
    }
  }
  None
}

/**
 * The day of a nightly, counted from 1970-01-01: `nightly-20260928` is 20724. `None` for a tag that is no nightly of
 * the form `nightly-YYYYMMDD`, or names no day of the calendar.
 */
public fn nightlyDay(tag: String): Int? {
  const digits = tag.withoutPrefix("nightly-")?
  if digits.byteLength() != 8 {
    return None
  }
  const year = Int.tryFrom(digits.sliceBytes(0, 4)).ok()?
  const month = Int.tryFrom(digits.sliceBytes(4, 6)).ok()?
  const day = Int.tryFrom(digits.sliceBytes(6, 8)).ok()?
  if month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month) {
    return None
  }
  daysFromCivil year, month, day
}

/** How many days `month` of `year` has in the Gregorian calendar. */
fn daysInMonth(year: Int, month: Int): Int {
  match month {
    2 => if (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 { 29 } else { 28 }
    4 | 6 | 9 | 11 => 30
    _ => 31
  }
}

/**
 * The days from 1970-01-01 to `year`-`month`-`day` in the proleptic Gregorian calendar: Howard Hinnant's
 * `days_from_civil`, the inverse of what `std/time` shows a `Timestamp` with, for a year from 1 on.
 */
fn daysFromCivil(year: Int, month: Int, day: Int): Int {
  const shiftedYear = if month <= 2 { year - 1 } else { year }
  const era = shiftedYear / 400
  const yearOfEra = shiftedYear - era * 400
  const shiftedMonth = if month > 2 { month - 3 } else { month + 9 }
  const dayOfYear = (153 * shiftedMonth + 2) / 5 + day - 1
  const dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear
  era * 146_097 + dayOfEra - 719_468
}

/**
 * Which of `releases` - the newest ones the forge lists, in any order - the periodic check places, oldest first: every
 * nightly of the `days` days that end with the newest nightly listed, the newest preview (a release candidate, beta or
 * alpha: [channelOf]), and the newest stable release (neither a draft nor a prerelease). Drafts never. The window is
 * counted from the newest nightly rather than from the clock of this machine, so a check that runs while no nightly has
 * been made for a while still places the last ones.
 */
public fn releasesToSync(releases: List<ReleaseInfo>, days: Int = nightlyDays): List<ReleaseInfo> {
  var newestStable: ReleaseInfo? = None
  var newestPreview: ReleaseInfo? = None
  var nightlies: List<(Int, ReleaseInfo)> = []
  for release in releases {
    if release.draft {
      continue
    }
    const channel = channelOf versionOf(release.tagName)
    if channel == "nightly" {
      if const Some(day) = nightlyDay(release.tagName) {
        nightlies.append((day, release))
      }
    } else if channel == "preview" {
      newestPreview = newerOf release, newestPreview
    } else if !release.prerelease {
      newestStable = newerOf release, newestStable
    }
  }
  const lastDay = nightlies.fold(0, { newest, entry => newest.max entry.0 })
  var chosen = nightlies.filter({ lastDay - _.0 < days }).sorted({ _.0 }).map({ _.1 }).toList()
  if const Some(release) = newestPreview {
    chosen.append release
  }
  if const Some(release) = newestStable {
    chosen.append release
  }
  chosen
}

/** `release`, or `found` where that is the newer of the two by [compareVersions]. */
fn newerOf(release: ReleaseInfo, found: ReleaseInfo?): ReleaseInfo {
  match found {
    Some(other) => {
      if compareVersions(versionOf(release.tagName), versionOf(other.tagName)) == Ordering.Greater {
        release
      } else {
        other
      }
    }
    None => release
  }
}
