/**
 * The one call this program makes to GitHub: the release of a tag, with its assets - through the REST API, with the
 * read-only token, so it works on the private repository the same way it will on the public one
 * (docs/contributing/releasing.md, "a private repository needs GH_TOKEN"). What the webhook sends is not trusted for
 * its asset list; this call is always made instead, once a webhook or the periodic check names a tag to look at.
 */

use Uri from "std/uri"
use get as httpGet from "std/http"
use Headers from "std/http"
use Json from "std/json"
use Naming from "std/encoding"

/** One asset of a release: its name, and the API URL that answers its bytes with `Accept: application/octet-stream`. */
public type ReleaseAsset {
  name: String
  url: String
}

/** A release, as much of GitHub's answer as this program reads. */
public type ReleaseInfo {
  tagName: String
  assets: List<ReleaseAsset>
}

/** What GitHub's "release published" webhook posts: the action, and the same release shape as the API. */
public type ReleaseEvent {
  action: String
  release: ReleaseInfo
}

const json = Json naming: Naming.SnakeCase

/** The body GitHub's "release published" webhook posts, decoded - `action` and `release.tag_name` are all this reads. */
public fn parseReleaseEvent(text: String): Result<ReleaseEvent, String> {
  json.decode<ReleaseEvent>(text).mapError({ _.show() })
}

/** `GET /repos/<owner>/<name>/releases/tags/<tag>`, with the token if there is one. */
public fn fetchRelease(repository: String, tag: String, token: String?): Task<Result<ReleaseInfo, String>> {
  fetchReleaseAt("https://api.github.com/repos/{repository}/releases/tags/{tag}", token).await()
}

/** `GET /repos/<owner>/<name>/releases/latest`, the same shape. */
public fn fetchLatestRelease(repository: String, token: String?): Task<Result<ReleaseInfo, String>> {
  fetchReleaseAt("https://api.github.com/repos/{repository}/releases/latest", token).await()
}

fn fetchReleaseAt(url: String, token: String?): Task<Result<ReleaseInfo, String>> {
  match Uri.tryFrom(url) {
    Fail(error) => Fail error.show()
    Ok(uri) => {
      match httpGet(uri, headers: githubHeaders(token, "application/vnd.github+json")).await() {
        Fail(error) => Fail error.show()
        Ok(response) => {
          if !response.status.isSuccess() {
            Fail "{url}: {response.status.show()}"
          } else {
            match response.body.text().await() {
              Fail(error) => Fail error.show()
              Ok(text) => match json.decode<ReleaseInfo>(text) {
                Ok(info) => Ok info
                Fail(error) => Fail error.show()
              }
            }
          }
        }
      }
    }
  }
}

fn githubHeaders(token: String?, accept: String): Headers {
  var headers = Headers()
  headers.set "Accept", accept
  headers.set "User-Agent", "torbscript-release-sync"
  match token {
    Some(value) => headers.set "Authorization", "Bearer {value}"
    None => void
  }
  headers
}
