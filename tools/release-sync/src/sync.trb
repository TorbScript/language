/**
 * The one thing this program does: given a release (from the webhook or the periodic check), download its assets
 * (with the read-only token, where there is one), verify `SHA256SUMS` and its cosign signature, and place the result
 * under `<root>/download/<version>/`, updating `versions.txt` and `latest` (docs/design/RELEASE.md section 7.11).
 *
 * Downloading shells out to `curl`; hashing is `std/digest` over the file's chunks, and moving, linking and rewriting
 * the list of versions is `std/fs` - `rename` for a move, a symbolic link renamed over `latest`, and
 * `writeTextAtomically` for `versions.txt`, so the web server in front never reads half a list. The signature is checked
 * by calling the `cosign` binary, never reimplemented: **a release with no `cosign` on the machine, no public key to check
 * it against, or a signature that does not verify, is refused and nothing is placed.**
 *
 * **A directory under the version's name is always complete.** A release is downloaded into a directory of its own in
 * the scratch directory, which is on the file system of `<root>/download/` (`<root>/download/.incoming` unless
 * `RELEASE_SYNC_SCRATCH` says otherwise), and once it is verified that whole directory is renamed to
 * `<root>/download/<version>` in one step: the web server finds the version complete or not at all, never an empty or a
 * half-filled directory. A placement that fails after the rename - `versions.txt` or `latest` cannot be written - is
 * undone, so the periodic check, which asks whether the version is placed (`isPlaced`), tries it again; and whatever
 * an attempt leaves in the scratch directory is removed when it ends, and when the program starts.
 */

use File, IoError, Permissions from "std/fs"
use Sha256 from "std/digest"
use Process from "std/process"
use Config, defaultScratchOf from "./config"
use ReleaseInfo, ReleaseAsset, ReleaseSource from "./forge"
use expectedHash, isSignature from "./verify"
use releasesToSync, listedVersions, newestStableIn from "./versions"
public use versionOf, channelOf from "./versions"

/** The start of the name of one attempt's directory in the scratch directory: `release-sync-0.2.0-...`. */
const attemptPrefix = "release-sync-"

/** Where a version's old directory waits while its new one is renamed in: `<root>/download/.<version>.replaced`. */
const replacedSuffix = ".replaced"

/**
 * Whether `<root>/download/<version>/` is there and holds `SHA256SUMS` - the periodic check's "nothing to do". A
 * directory under the version's name is complete since placing renames it there whole, and asking for `SHA256SUMS`,
 * which every placed release has, also sees through the empty directory a failed placement left before it did.
 */
public fn isPlaced(root: String, version: String): Bool {
  File.exists "{root}/download/{version}/SHA256SUMS"
}

/**
 * Of the newest releases the forge lists, the ones the periodic check syncs: those [releasesToSync] chooses - the
 * newest stable release and the nightlies of the last thirty days - that are not placed yet, oldest first.
 */
public fn missingReleases(releases: List<ReleaseInfo>, root: String): List<ReleaseInfo> {
  releasesToSync(releases).filter({ !isPlaced(root, versionOf(_.tagName)) }).toList()
}

/**
 * The identity `cosign verify-blob` checks a keyless certificate of GitHub against - release.yml's or nightly.yml's,
 * by the tag's shape. Only for releases made on GitHub; the forge's are signed with the project's key.
 */
public fn certificateIdentity(repository: String, tag: String): String {
  if tag.startsWith("v") {
    "https://github.com/{repository}/.github/workflows/release.yml@refs/tags/{tag}"
  } else {
    "https://github.com/{repository}/.github/workflows/nightly.yml@refs/heads/main"
  }
}

/** Runs `program` to its end; `Fail` names the command and what it wrote to standard error. */
fn run(program: String, arguments: List<String>): Task<Result<Void, String>> {
  match Process.run(program, arguments).await() {
    Ok(output) => {
      if output.isSuccess() {
        Ok void
      } else {
        Fail "{program} {arguments.joined(separator: " ")} failed: {output.standardError.trim()}"
      }
    }
    Fail(error) => Fail "{program} could not be started: {error.show()}"
  }
}

/** `curl` of one asset, from where and with the headers its forge answers it (`Forge.downloadUrl`, `downloadHeaders`). */
fn downloadAsset(asset: ReleaseAsset, source: ReleaseSource, destination: String): Task<Result<Void, String>> {
  const url = source.forge.downloadUrl asset
  if url.isEmpty() {
    return Fail "the forge named no download URL for {asset.name}"
  }
  var arguments: List<String> = ["-fsSL", "--retry", "3"]
  for header in source.forge.downloadHeaders(source.token) {
    arguments.append "-H"
    arguments.append header
  }
  arguments.append "-o"
  arguments.append destination
  arguments.append url
  run("curl", arguments).await()
}

/** Every asset of `release` downloaded into `directory`, under its own name. */
public fn downloadRelease(release: ReleaseInfo, source: ReleaseSource, directory: String): Task<Result<Void, String>> {
  match File.createDirectory(directory) {
    Fail(error) => { return Fail error.show() }
    Ok(_) => void
  }
  for asset in release.assets {
    match downloadAsset(asset, source, "{directory}/{asset.name}").await() {
      Fail(message) => { return Fail message }
      Ok(_) => void
    }
  }
  Ok void
}

/** The SHA-256 of the file at `path` in lowercase hexadecimal, read chunk by chunk on the blocking pool. */
fn sha256Of(path: String): Task<Result<String, String>> {
  const hashed = hashedFile(path).await()
  hashed.mapError({ "{path} could not be hashed: {_.message}" })
}

fn hashedFile(path: String): Task<Result<String, IoError>> {
  using file = File.open(path)?
  var chunks = file.chunks()
  var hasher = Sha256()
  while const Some(chunk) = chunks.next().await()? {
    hasher.add chunk
  }
  Ok hasher.finished().hex()
}

/**
 * Every archive `release` names checked against `SHA256SUMS` in `directory` - refuses where the file is missing from
 * the sums, where the sums themselves are missing, or where a computed hash does not match.
 */
public fn verifyHashes(release: ReleaseInfo, directory: String): Task<Result<Void, String>> {
  const sumsPath = "{directory}/SHA256SUMS"
  const sums = match File.readText(sumsPath) {
    Ok(text) => text
    Fail(error) => { return Fail "no SHA256SUMS: {error.show()}" }
  }
  for asset in release.assets {
    if isSignature(asset.name) {
      continue
    }
    const expected = match expectedHash(sums, asset.name) {
      Some(hash) => hash
      None => { return Fail "{asset.name} is not listed in SHA256SUMS" }
    }
    const actual = match sha256Of("{directory}/{asset.name}").await() {
      Ok(hash) => hash
      Fail(message) => { return Fail message }
    }
    if actual.toLowerCase() != expected.toLowerCase() {
      return Fail "{asset.name}: expected sha256 {expected}, got {actual}"
    }
  }
  Ok void
}

/**
 * `cosign verify-blob` of `SHA256SUMS`: against `SHA256SUMS.sig` and the project's public key where the configuration
 * names one (every release of the forge - docs/design/RELEASE.md, "Signing"), and against GitHub's keyless bundle
 * `SHA256SUMS.sigstore.json` and the identity of the workflow that made the release where it names none (a release
 * made on GitHub). The key's signature is not in a transparency log - the forge's identity is not one Sigstore's
 * certificate authority knows - so the log is not asked for. `cosign` missing from the machine, or the key file
 * missing, is answered the same as a signature that does not verify: `Fail`, and nothing is placed - a release this
 * program cannot check the signature of is not published as if it had.
 */
public fn verifySignature(directory: String, config: Config, tag: String): Task<Result<Void, String>> {
  match config.cosignKey {
    Some(key) => {
      if !File.exists(key) {
        return Fail "the public key {key} is not there (RELEASE_SYNC_COSIGN_KEY): no release is placed without checking its signature"
      }
      run("cosign", [
        "verify-blob",
        "--key", key,
        "--signature", "{directory}/SHA256SUMS.sig",
        "--insecure-ignore-tlog=true",
        "{directory}/SHA256SUMS",
      ]).await()
    }
    None => {
      run("cosign", [
        "verify-blob",
        "--bundle", "{directory}/SHA256SUMS.sigstore.json",
        "--certificate-identity", certificateIdentity(config.repository, tag),
        "--certificate-oidc-issuer", "https://token.actions.githubusercontent.com",
        "{directory}/SHA256SUMS",
      ]).await()
    }
  }
}

/**
 * Renames the verified download `sourceDirectory` - holding the release's assets and nothing else - to
 * `<root>/download/<version>` in one step, then updates `versions.txt` (the version's old line, if any, replaced) and,
 * for the newest stable release only, `latest` (a symlink to the version's directory - a nightly has no "latest", only
 * `/docs/nightly/` on the site, which this program does not touch).
 *
 * A directory already under the version's name - the release published again, or an empty one a placement left before
 * placing was one step - is set aside first and removed once the new one is in place. Where `versions.txt` or `latest`
 * cannot be written, everything is undone: the download goes back to `sourceDirectory`, the old directory and the old
 * `versions.txt` come back, and the periodic check tries again later.
 */
public fn place(release: ReleaseInfo, sourceDirectory: String, root: String): Task<Result<Void, String>> {
  const version = versionOf release.tagName
  placed(sourceDirectory, root, version, channelOf(version)).mapError({ describedFailure _, root })
}

/**
 * What a failed placement says: the failure itself, and for a rename across file systems what to change - the scratch
 * directory has to be on the file system of `<root>/download/`, because a release is placed by one rename, and no
 * system renames across file systems.
 */
public fn describedFailure(problem: IoError, root: String): String {
  if !problem.isCrossDevice() {
    return problem.show()
  }
  "{problem.show()}: the scratch directory is on another file system than {root}/download, and a release is placed by "
    + "renaming its directory there in one step - set RELEASE_SYNC_SCRATCH to a directory on that file system, "
    + "or leave it unset for {defaultScratchOf(root)}"
}

/** [place], with every step a function of `std/fs` that fails with an `IoError`. */
fn placed(sourceDirectory: String, root: String, version: String, channel: String): Result<Void, IoError> {
  const download = "{root}/download"
  const destination = "{download}/{version}"
  const replaced = "{download}/.{version}{replacedSuffix}"
  File.createDirectory(download)?
  // The download's directory was its owner's alone while nothing in it was verified; the web server reads it now
  File.setPermissions(sourceDirectory, Permissions(0b111_101_101))?
  // What a placement stopped half way left: the next one sets its own old directory aside there
  File.removeDirectory(replaced)?
  const replacing = File.linkMetadata(destination).isOk()
  if replacing {
    File.rename(destination, replaced)?
  }
  if const Fail(problem) = File.rename(sourceDirectory, destination) {
    if replacing {
      const _ = File.rename replaced, destination
    }
    return Fail problem
  }
  if const Fail(problem) = listedAndLinked(root, version, channel) {
    const _ = File.rename destination, sourceDirectory
    if replacing {
      const _ = File.rename replaced, destination
    }
    return Fail problem
  }
  const _ = File.removeDirectory replaced
  Ok void
}

/**
 * `versions.txt` rewritten with `version` in it (`listedVersions`: each channel newest first) and, where it is the
 * newest stable release, `latest` pointed at it; where `latest` fails, `versions.txt` is put back as it was, so a
 * failure changes neither.
 */
fn listedAndLinked(root: String, version: String, channel: String): Result<Void, IoError> {
  const listPath = "{root}/download/versions.txt"
  const before = File.readText(listPath).ok()
  const after = listedVersions(before ?? "", version, channel)
  File.writeTextAtomically(listPath, after)?
  // `latest` is the newest stable release: an older one placed later - a patch of an earlier line, or a release the
  // periodic check caught up with - leaves it where it is
  if channel != "stable" || newestStableIn(after) != version {
    return Ok void
  }
  if const Fail(problem) = pointLatestAt(root, version) {
    const _ = match before {
      Some(text) => File.writeTextAtomically listPath, text
      None => File.remove listPath
    }
    return Fail problem
  }
  Ok void
}

/**
 * `<root>/download/latest` made a symbolic link to `version`: a new link beside it, renamed over the old one in one
 * step, so a request never finds `latest` missing - which `ln -sfn` cannot promise, because it removes the old link
 * first. A link that cannot be renamed there is removed again.
 */
fn pointLatestAt(root: String, version: String): Result<Void, IoError> {
  const staging = "{root}/download/.latest-{version}"
  if File.linkMetadata(staging).isOk() {
    File.remove(staging)?
  }
  File.createSymbolicLink(staging, version)?
  if const Fail(problem) = File.rename(staging, "{root}/download/latest") {
    const _ = File.remove staging
    return Fail problem
  }
  Ok void
}

/**
 * What attempts that did not end left behind - the program was stopped while it downloaded or placed: every
 * `release-sync-*` directory in `scratch` and every `.<version>.replaced` directory in `<root>/download/`. Run when the
 * program starts, before any attempt of its own; the names of what was removed, for the log.
 */
public fn removeLeftovers(root: String, scratch: String): Result<List<String>, IoError> {
  var removed: List<String> = []
  if File.isDirectory(scratch) {
    for name in File.list(scratch)? {
      if name.startsWith(attemptPrefix) {
        File.removeDirectory("{scratch}/{name}")?
        removed.append "{scratch}/{name}"
      }
    }
  }
  const download = "{root}/download"
  if File.isDirectory(download) {
    for name in File.list(download)? {
      if name.startsWith(".") && name.endsWith(replacedSuffix) {
        File.removeDirectory("{download}/{name}")?
        removed.append "{download}/{name}"
      }
    }
  }
  removed
}

/**
 * The whole thing, for one release: download, verify, place - `Fail` at the first step that does not check out. The
 * download goes to a directory of its own in `config.scratch`, a hidden directory the site never serves
 * (`tools/deploy/nginx.conf`) and which only its owner may read until it is verified, so nothing unverified is ever
 * reachable from outside. Whatever the attempt leaves there - a refused download, a placement undone - is removed when
 * it ends; a placed release has been renamed out of it.
 */
public fn syncRelease(release: ReleaseInfo, config: Config): Task<Result<Void, String>> {
  const version = versionOf release.tagName
  const created = File.createDirectory(config.scratch).flatMap({
    File.createTemporaryDirectory prefix: "{attemptPrefix}{version}-", inside: config.scratch
  })
  const attempt = match created {
    Ok(path) => path
    Fail(problem) => {
      return Fail "no directory for the download in {config.scratch} (RELEASE_SYNC_SCRATCH): {problem.show()}"
    }
  }
  const outcome = fetchedAndPlaced(release, config, attempt).await()
  const _ = File.removeDirectory attempt
  outcome
}

/** [syncRelease] in the directory of one attempt. */
fn fetchedAndPlaced(release: ReleaseInfo, config: Config, directory: String): Task<Result<Void, String>> {
  downloadRelease(release, config.source(), directory).await()?
  verifyHashes(release, directory).await()?
  verifySignature(directory, config, release.tagName).await()?
  place(release, directory, config.root).await()
}
