/**
 * The one thing this program does: given a release (from the webhook or the periodic check), download its assets
 * (with the read-only token, where there is one), verify `SHA256SUMS` and its cosign signature, and place the result
 * under `<root>/download/<version>/`, updating `versions.txt` and `latest` (docs/design/RELEASE.md section 7.11).
 *
 * Downloading shells out to `curl`; hashing is `std/digest` over the file's chunks, and moving, linking and rewriting
 * the list of versions is `std/fs` - `rename` for a move, a symbolic link renamed over `latest`, and
 * `writeTextAtomically` for `versions.txt`, so the web server in front never reads half a list. The signature is checked
 * by calling the `cosign` binary, never reimplemented: **a release with no `cosign` on the machine, no public key to check
 * it against, or a signature that does not verify, is refused and nothing is placed.**
 */

use File, IoError from "std/fs"
use Sha256 from "std/digest"
use Process from "std/process"
use Config from "./config"
use ReleaseInfo, ReleaseAsset, ReleaseSource from "./forge"
use expectedHash, isSignature from "./verify"

/** `v0.2.0` -> `0.2.0`; a nightly's tag (`nightly-20260925`) has no `v` and is already the version. */
public fn versionOf(tag: String): String {
  if tag.startsWith("v") {
    tag.sliceBytes 1, tag.byteLength()
  } else {
    tag
  }
}

/** `stable` for a tagged release, `nightly` for `nightly-YYYYMMDD` - the same two channels `versions.txt` lists. */
public fn channelOf(version: String): String {
  if version.startsWith("nightly-") {
    "nightly"
  } else {
    "stable"
  }
}

/**
 * The identity `cosign verify-blob` checks a keyless certificate of GitHub against - release.yml's or nightly.yml's,
 * by the tag's shape. Only for releases made on GitHub; the forge's are signed with the project's key.
 */
public fn certificateIdentity(repository: String, tag: String): String {
  if tag.startsWith("v") {
    "https://github.com/{repository}/.github/workflows/release.yml@refs/tags/{tag}"
  } else {
    "https://github.com/{repository}/.github/workflows/nightly.yml@refs/heads/main"
  }
}

/** Runs `program` to its end; `Fail` names the command and what it wrote to standard error. */
fn run(program: String, arguments: List<String>): Task<Result<Void, String>> {
  match Process.run(program, arguments).await() {
    Ok(output) => {
      if output.isSuccess() {
        Ok void
      } else {
        Fail "{program} {arguments.joined(separator: " ")} failed: {output.standardError.trim()}"
      }
    }
    Fail(error) => Fail "{program} could not be started: {error.show()}"
  }
}

/** `curl` of one asset, from where and with the headers its forge answers it (`Forge.downloadUrl`, `downloadHeaders`). */
fn downloadAsset(asset: ReleaseAsset, source: ReleaseSource, destination: String): Task<Result<Void, String>> {
  const url = source.forge.downloadUrl asset
  if url.isEmpty() {
    return Fail "the forge named no download URL for {asset.name}"
  }
  var arguments: List<String> = ["-fsSL", "--retry", "3"]
  for header in source.forge.downloadHeaders(source.token) {
    arguments.append "-H"
    arguments.append header
  }
  arguments.append "-o"
  arguments.append destination
  arguments.append url
  run("curl", arguments).await()
}

/** Every asset of `release` downloaded into `directory`, under its own name. */
public fn downloadRelease(release: ReleaseInfo, source: ReleaseSource, directory: String): Task<Result<Void, String>> {
  match File.createDirectory(directory) {
    Fail(error) => { return Fail error.show() }
    Ok(_) => void
  }
  for asset in release.assets {
    match downloadAsset(asset, source, "{directory}/{asset.name}").await() {
      Fail(message) => { return Fail message }
      Ok(_) => void
    }
  }
  Ok void
}

/** The SHA-256 of the file at `path` in lowercase hexadecimal, read chunk by chunk on the blocking pool. */
fn sha256Of(path: String): Task<Result<String, String>> {
  const hashed = hashedFile(path).await()
  hashed.mapError({ "{path} could not be hashed: {_.message}" })
}

fn hashedFile(path: String): Task<Result<String, IoError>> {
  using file = File.open(path)?
  var chunks = file.chunks()
  var hasher = Sha256()
  while const Some(chunk) = chunks.next().await()? {
    hasher.add chunk
  }
  Ok hasher.finished().hex()
}

/**
 * Every archive `release` names checked against `SHA256SUMS` in `directory` - refuses where the file is missing from
 * the sums, where the sums themselves are missing, or where a computed hash does not match.
 */
public fn verifyHashes(release: ReleaseInfo, directory: String): Task<Result<Void, String>> {
  const sumsPath = "{directory}/SHA256SUMS"
  const sums = match File.readText(sumsPath) {
    Ok(text) => text
    Fail(error) => { return Fail "no SHA256SUMS: {error.show()}" }
  }
  for asset in release.assets {
    if isSignature(asset.name) {
      continue
    }
    const expected = match expectedHash(sums, asset.name) {
      Some(hash) => hash
      None => { return Fail "{asset.name} is not listed in SHA256SUMS" }
    }
    const actual = match sha256Of("{directory}/{asset.name}").await() {
      Ok(hash) => hash
      Fail(message) => { return Fail message }
    }
    if actual.toLowerCase() != expected.toLowerCase() {
      return Fail "{asset.name}: expected sha256 {expected}, got {actual}"
    }
  }
  Ok void
}

/**
 * `cosign verify-blob` of `SHA256SUMS`: against `SHA256SUMS.sig` and the project's public key where the configuration
 * names one (every release of the forge - docs/design/RELEASE.md, "Signing"), and against GitHub's keyless bundle
 * `SHA256SUMS.sigstore.json` and the identity of the workflow that made the release where it names none (a release
 * made on GitHub). The key's signature is not in a transparency log - the forge's identity is not one Sigstore's
 * certificate authority knows - so the log is not asked for. `cosign` missing from the machine, or the key file
 * missing, is answered the same as a signature that does not verify: `Fail`, and nothing is placed - a release this
 * program cannot check the signature of is not published as if it had.
 */
public fn verifySignature(directory: String, config: Config, tag: String): Task<Result<Void, String>> {
  match config.cosignKey {
    Some(key) => {
      if !File.exists(key) {
        return Fail "the public key {key} is not there (RELEASE_SYNC_COSIGN_KEY): no release is placed without checking its signature"
      }
      run("cosign", [
        "verify-blob",
        "--key", key,
        "--signature", "{directory}/SHA256SUMS.sig",
        "--insecure-ignore-tlog=true",
        "{directory}/SHA256SUMS",
      ]).await()
    }
    None => {
      run("cosign", [
        "verify-blob",
        "--bundle", "{directory}/SHA256SUMS.sigstore.json",
        "--certificate-identity", certificateIdentity(config.repository, tag),
        "--certificate-oidc-issuer", "https://token.actions.githubusercontent.com",
        "{directory}/SHA256SUMS",
      ]).await()
    }
  }
}

/**
 * Moves every file of `directory` into `<root>/download/<version>/`, then updates `versions.txt` (the version's old
 * line, if any, replaced) and, for a stable release only, `latest` (a symlink to the version's directory - a nightly
 * has no "latest", only `/docs/nightly/` on the site, which this program does not touch).
 */
public fn place(release: ReleaseInfo, sourceDirectory: String, root: String): Task<Result<Void, String>> {
  const version = versionOf release.tagName
  const channel = channelOf version
  const destination = "{root}/download/{version}"
  placed(release, sourceDirectory, root, destination, version, channel).mapError({ _.show() })
}

/** [place], with every step a function of `std/fs` that fails with an `IoError`. */
fn placed(
  release: ReleaseInfo,
  sourceDirectory: String,
  root: String,
  destination: String,
  version: String,
  channel: String,
): Result<Void, IoError> {
  File.createDirectory(destination)?
  for asset in release.assets {
    File.rename("{sourceDirectory}/{asset.name}", "{destination}/{asset.name}")?
  }
  updateVersionsList("{root}/download/versions.txt", version, channel)?
  if channel == "stable" {
    pointLatestAt root, version
  } else {
    Ok void
  }
}

/**
 * `<root>/download/latest` made a symbolic link to `version`: a new link beside it, renamed over the old one in one
 * step, so a request never finds `latest` missing - which `ln -sfn` cannot promise, because it removes the old link first.
 */
fn pointLatestAt(root: String, version: String): Result<Void, IoError> {
  const staging = "{root}/download/.latest-{version}"
  if File.linkMetadata(staging).isOk() {
    File.remove(staging)?
  }
  File.createSymbolicLink(staging, version)?
  File.rename staging, "{root}/download/latest"
}

/** Rewrites `path`: `version`'s previous line (if any) removed, then `"<version> <channel>"` put at the top. */
fn updateVersionsList(path: String, version: String, channel: String): Result<Void, IoError> {
  const before = File.readText(path).ok() ?? ""
  var kept: List<String> = []
  for line in before.lines() {
    if line.trim().isEmpty() {
      continue
    }
    const first = line.trim().split(" ").first() ?? ""
    if first != version {
      kept.append line
    }
  }
  const rebuilt = ["{version} {channel}", ...kept].joined(separator: "\n")
  File.writeTextAtomically path, "{rebuilt}\n"
}

/**
 * The whole thing, for one release: download, verify, place - `Fail` at the first step that does not check out. The
 * download goes to `config.scratch` (the container's own `/tmp`), never below `<root>`, which the site serves: nothing
 * unverified is ever reachable from outside.
 */
public fn syncRelease(release: ReleaseInfo, config: Config): Task<Result<Void, String>> {
  const scratch = "{config.scratch}/release-sync-{versionOf(release.tagName)}"
  match run("rm", ["-rf", scratch]).await() {
    Fail(message) => { return Fail message }
    Ok(_) => void
  }
  match downloadRelease(release, config.source(), scratch).await() {
    Fail(message) => { return Fail message }
    Ok(_) => void
  }
  match verifyHashes(release, scratch).await() {
    Fail(message) => { return Fail message }
    Ok(_) => void
  }
  match verifySignature(scratch, config, release.tagName).await() {
    Fail(message) => { return Fail message }
    Ok(_) => void
  }
  const placed = place(release, scratch, config.root).await()
  const _ = run("rm", ["-rf", scratch]).await()
  placed
}
