/**
 * The one HTTP endpoint this program answers: the forge's "release published" webhook, POSTed to `/webhook` and
 * signed with the HMAC-SHA256 of its body - `X-Forgejo-Signature` (the bare hex) from Forgejo, `X-Hub-Signature-256`
 * (`sha256=<hex>`) from GitHub (docs/design/RELEASE.md section 7.11). The payload names a tag; what is actually synced
 * is the release of that tag as the forge's API answers it, never the webhook's own asset list, which nothing here
 * signs or trusts.
 */

use Request, Response, Status, Handler, HttpError from "std/http"
use Process from "std/process"
use Config from "./config"
use parseReleaseEvent from "./forge"
use shouldSync, claimedSignature, sameDigest from "./verify"
use syncRelease from "./sync"
use spawn from "std/task"

/** `openssl dgst -sha256 -hmac <secret>` over `body`, fed through standard input - the hex digest, lower case. */
fn hmacSha256(secret: String, body: String): Task<Result<String, String>> {
  match Process.run("openssl", ["dgst", "-sha256", "-hmac", secret], input: body).await() {
    Fail(error) => Fail "openssl could not be started: {error.show()}"
    Ok(output) => {
      if !output.isSuccess() {
        Fail "openssl dgst failed: {output.standardError.trim()}"
      } else {
        // "(stdin)= <hex>", or "SHA2-256(stdin)= <hex>" on a newer openssl - the hex is everything after the last "="
        const text = output.standardOutput.trim()
        match text.lastIndexOf("=") {
          None => Fail "openssl dgst printed no digest: {text}"
          Some(at) => Ok text[(text.indexAfter(at) ?? text.end())..].trim()
        }
      }
    }
  }
}

/** The handler `Server.listen` is given: everything but `POST /webhook` is `404`, and a bad signature is `401`. */
public fn handler(config: Config): Handler {
  { request: Request => handle(config, request).await() }
}

fn handle(config: Config, request: Request): Task<Result<Response, HttpError>> {
  if request.path() != "/webhook" {
    return Ok Response.of(Status.notFound)
  }
  const body = match request.body.text().await() {
    Fail(_) => { return Ok Response.text("could not read the body", status: Status.badRequest) }
    Ok(text) => text
  }
  match config.webhookSecret {
    None => void
    Some(secret) => {
      const claimed = claimedSignature request.headers.get("X-Forgejo-Signature"), request.headers.get("X-Hub-Signature-256")
      const computed = match hmacSha256(secret, body).await() {
        Fail(message) => { return Ok Response.text(message, status: Status.internalServerError) }
        Ok(hex) => hex
      }
      if !(claimed.map({ sameDigest computed, _ }) ?? false) {
        return Ok Response.text("bad signature", status: Status.unauthorized)
      }
    }
  }
  const event = match parseReleaseEvent(body) {
    Fail(message) => { return Ok Response.text(message, status: Status.badRequest) }
    Ok(found) => found
  }
  if !shouldSync(event) {
    return Ok Response.text("ignored: action \"{event.action}\"")
  }
  const tag = event.release.tagName
  // The answer goes out at once: the forge gives a delivery seconds, and downloading a release takes longer. What
  // happened is in the log, and a sync that failed is tried again by the periodic check where it is a stable release
  const _ = spawn { syncTag(config, tag).await() }
  Ok Response.text("syncing {tag}", status: Status.accepted)
}

/**
 * The release of `tag` as the forge's API answers it, downloaded, verified and placed. The webhook's own payload names
 * the assets too, but they are never trusted: this is the same call the periodic check makes.
 */
fn syncTag(config: Config, tag: String): Task<Void> {
  match config.source().release(tag).await() {
    Fail(message) => printError "release-sync: {tag} could not be read from the forge: {message}"
    Ok(release) => {
      match syncRelease(release, config).await() {
        Fail(message) => printError "release-sync: syncing {tag} failed: {message}"
        Ok(_) => print "release-sync: synced {tag}"
      }
    }
  }
}
