/**
 * `release-sync`: pulls the releases of the forge (git.torb.dev; GitHub by configuration) onto the machine that serves
 * `torb.dev/download` and `packages.torb.dev` (docs/design/RELEASE.md section 7.11, "the root server pulls, CI never
 * pushes"). Listens for the forge's "release published" webhook, and besides it polls for whatever the webhook missed.
 * `tools/deploy/compose.example.yml` runs this behind Traefik.
 */

use SocketAddress from "std/network"
use Server from "std/http"
use sleep from "std/time"
use spawn from "std/task"
use Config from "./config"
use handler from "./webhook"
use syncRelease, missingReleases, removeLeftovers from "./sync"

/** How many of the newest releases the periodic check asks the forge for: a month of nightlies, and the releases. */
const recentCount = 50

/**
 * At the start and then every `pollSeconds`: every release that should be under `<root>/download/` and is not - in case
 * its webhook never arrived, this program was down for it, or its placement failed, which leaves no directory under the
 * version's name. The forge does not deliver a webhook again by itself, so this is what places a release whose
 * delivery was lost, a nightly as well as a stable release.
 */
fn poll(config: Config): Task<Void> {
  loop {
    check(config).await()
    sleep(Float64.from(config.pollSeconds)).await()
  }
}

/**
 * One periodic check: the newest releases the forge lists, and of those the newest stable one, the newest preview and
 * the nightlies of the last thirty days, each synced unless it is placed already (`missingReleases`). Says nothing
 * where there is nothing to do - also while the repository has no release at all.
 */
fn check(config: Config): Task<Void> {
  match config.source().recentReleases(recentCount).await() {
    Fail(message) => printError "release-sync: the periodic check could not reach the forge: {message}"
    Ok(releases) => {
      for release in missingReleases(releases, config.root, config.source()).await() {
        print "release-sync: the periodic check found {release.tagName}, not yet placed - syncing"
        match syncRelease(release, config).await() {
          Fail(message) => printError "release-sync: syncing {release.tagName} failed: {message}"
          Ok(_) => print "release-sync: synced {release.tagName}"
        }
      }
    }
  }
}

const config = Config.fromEnvironment()
print "release-sync: listening on {config.listenAddress}, watching {config.repository} on {config.url}, polling every {config.pollSeconds}s"
match removeLeftovers(config.root, config.scratch) {
  Ok(removed) => {
    for path in removed {
      print "release-sync: removed {path}, left by an attempt that did not end"
    }
  }
  Fail(problem) => printError "release-sync: what earlier attempts left could not be removed: {problem.show()}"
}
const address = SocketAddress.tryFrom(config.listenAddress)?
var server = Server.listen(address, handler(config))?
const polling = spawn { poll(config).await() }
server.serve().await()?
polling.cancel()
