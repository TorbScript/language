/**
 * Tests for `src/versions.trb`: the order of two versions, the day a nightly names, which of the newest releases the
 * periodic check places, and `versions.txt` kept in the order the installers read it - each channel newest first,
 * whatever order its releases were placed in.
 */

use test, group from "std/test"
use Ordering from "std/core"
use ReleaseInfo from "../src/forge"
use compareVersions, nightlyDay, releasesToSync, listedVersions, newestStableIn from "../src/versions"

/** The tags of `releases`, in their order. */
fn tagsOf(releases: List<ReleaseInfo>): List<String> {
  releases.map({ _.tagName }).toList()
}

group "the order of two versions" {
  test "stable versions compare number by number" {
    assert(compareVersions("0.10.0", "0.9.0") == Ordering.Greater)
    assert(compareVersions("0.2.0", "0.2.1") == Ordering.Less)
    assert(compareVersions("1.0.0", "1.0.0") == Ordering.Equal)
    assert(compareVersions("1.0", "1.0.1") == Ordering.Less)
  }

  test "nightlies compare by their date" {
    assert(compareVersions("nightly-20261001", "nightly-20260930") == Ordering.Greater)
  }
}

group "the day of a nightly" {
  test "the days from 1970-01-01, across months and a leap day" {
    assert(nightlyDay("nightly-19700101") == 0)
    assert(nightlyDay("nightly-20260928") == 20724)
    assert(nightlyDay("nightly-20240301") == nightlyDay("nightly-20240228").map({ _ + 2 }))
    assert(nightlyDay("nightly-20261001") == nightlyDay("nightly-20260930").map({ _ + 1 }))
  }

  test "a tag that names no day of the calendar is none" {
    assert(nightlyDay("v0.2.0") == None)
    assert(nightlyDay("nightly") == None)
    assert(nightlyDay("nightly-2026092") == None)
    assert(nightlyDay("nightly-20260230") == None)
    assert(nightlyDay("nightly-20261301") == None)
  }
}

group "which releases the periodic check places" {
  test "the newest stable release and the nightlies of thirty days, oldest first" {
    const releases = [
      ReleaseInfo("nightly-20260929", draft: true, prerelease: true),
      ReleaseInfo("nightly-20260928", prerelease: true),
      ReleaseInfo("v0.3.0-rc.1", prerelease: true),
      ReleaseInfo("nightly-20260927", prerelease: true),
      ReleaseInfo("v0.10.0"),
      ReleaseInfo("nightly-20260830", prerelease: true),
      ReleaseInfo("nightly-20260829", prerelease: true),
      ReleaseInfo("v0.9.0"),
    ]
    assert(tagsOf(releasesToSync(releases)) == ["nightly-20260830", "nightly-20260927", "nightly-20260928", "v0.10.0"])
  }

  test "no release at all, or only drafts, is nothing to place" {
    assert releasesToSync([]).isEmpty()
    assert releasesToSync([ReleaseInfo("v0.1.0", draft: true)]).isEmpty()
  }

  test "without a stable release the nightlies are still placed, and without a nightly the stable one" {
    assert(tagsOf(releasesToSync([ReleaseInfo("nightly-20260928", prerelease: true)])) == ["nightly-20260928"])
    assert(tagsOf(releasesToSync([ReleaseInfo("v0.1.0"), ReleaseInfo("v0.2.0")])) == ["v0.2.0"])
  }
}

group "versions.txt" {
  test "each channel newest first, stable before nightly, whatever order they came in" {
    var list = ""
    list = listedVersions list, "nightly-20260927", "nightly"
    list = listedVersions list, "0.2.0", "stable"
    list = listedVersions list, "nightly-20260926", "nightly"
    list = listedVersions list, "0.10.0", "stable"
    list = listedVersions list, "0.9.0", "stable"
    assert(list == "0.10.0 stable\n0.9.0 stable\n0.2.0 stable\nnightly-20260927 nightly\nnightly-20260926 nightly\n")
    assert(newestStableIn(list) == "0.10.0")
  }

  test "a version placed again has one line, and a line of another shape is kept" {
    const before = "0.2.0 stable\n# kept\nnightly-20260927 nightly\n"
    const after = listedVersions before, "0.2.0", "stable"
    assert(after == "0.2.0 stable\nnightly-20260927 nightly\n# kept\n")
  }

  test "a list with no stable release names none" {
    assert(newestStableIn("nightly-20260927 nightly\n") == None)
  }
}
