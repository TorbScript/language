/*
 * torb.rc - the icon and the version of the released torb.exe (docs/design/RELEASE.md section 4, docs/design/BRAND.md
 * section 11 "Binary icons"): what Explorer, the taskbar, the task manager and the file's properties show.
 *
 * `sh tools/windows/resource.sh <object>` compiles it with the version of project.trb, from the repository root, into an
 * object file that only the release links (.forgejo/actions/portable). The bootstrap, the fixpoint - which compares the
 * C, never a binary - and every program `torb build` writes never see it: a program belongs to its author and carries
 * no TorbScript icon.
 *
 * torb-version.h is written by resource.sh: TORB_VERSION_MAJOR, TORB_VERSION_MINOR, TORB_VERSION_PATCH and
 * TORB_VERSION_TEXT, the version as project.trb writes it.
 */

#include <winver.h>
#include "torb-version.h"

/* The Orb: 16, 24, 32 and 48 px drawn on their own pixel grids, and 256 px in the depth gradient */
1 ICON "brand/icons/torb.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TORB_VERSION_MAJOR, TORB_VERSION_MINOR, TORB_VERSION_PATCH, 0
PRODUCTVERSION TORB_VERSION_MAJOR, TORB_VERSION_MINOR, TORB_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    /* U.S. English, Unicode */
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "TorbScript toolchain"
      VALUE "FileVersion", TORB_VERSION_TEXT
      VALUE "InternalName", "torb"
      VALUE "LegalCopyright", L"Copyright (c) 2026 Torben K\x00F6hn. MIT License"
      VALUE "OriginalFilename", "torb.exe"
      VALUE "ProductName", "TorbScript"
      VALUE "ProductVersion", TORB_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
