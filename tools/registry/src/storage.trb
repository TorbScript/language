/**
 * Where the registry keeps what it serves: the index files and the archives (docs/design/RELEASE.md section 7.11, "the
 * write service stores through the storage layer of docs/design/URI.md section 11"). A reference is a `Uri`, and its
 * scheme picks the driver: `file:` today, `s3:` once the registry outgrows one disk - a change of `REGISTRY_STORAGE`
 * and of the drivers `main.trb` names, and of nothing that reads the files.
 *
 * The shapes are URI.md section 11's - a capability trait, a driver per scheme, a registry that is itself a `Storage`
 * and names what it knows when a scheme is unknown - with the members the registry uses. It lives here and not in
 * `std/storage` by that section's own rule: a capability trait belongs in `std` once `std` ships two drivers for it,
 * and this is one. `delete` is left out, because nothing here deletes: a published archive is never removed by a
 * program (section 7.3), and the moderators' removal is done by hand.
 */

use File, IoError from "std/fs"
use ran from "./program"
use Uri from "std/uri"
use Path from "std/path"
use Bytes, textOf from "std/stream"

/** The schemes a driver answers to, lower case (URI.md section 11). */
public trait Schemes {
  fn schemes(): List<String>
}

/** What a storage refuses with. Every case carries the reference as `show()` wrote it, so a secret is redacted. */
public type StorageFailure with Show, Error {
  case UnknownScheme(uri: String, known: List<String>)
  case NotAddressable(uri: String, reason: String)
  case NotFound(uri: String)
  case NotText(uri: String, reason: String)
  case Refused(uri: String, reason: String)

  fn show(): String {
    match self {
      .UnknownScheme(uri, known) => "no driver for `{uri}`: the registry knows {known.joined(separator: ", ")}"
      .NotAddressable(uri, reason) => "`{uri}` is not a reference this driver can reach: {reason}"
      .NotFound(uri) => "nothing is stored at `{uri}`"
      .NotText(uri, reason) => "`{uri}` is not text: {reason}"
      .Refused(uri, reason) => "`{uri}` was refused: {reason}"
    }
  }
}

/** Bytes at a reference, wherever the scheme reaches. */
public shared trait Storage with Schemes {
  /** The bytes stored at `uri`. */
  fn read(uri: Uri): Task<Result<Bytes, StorageFailure>>

  /** Whether anything is stored at `uri`. */
  fn exists(uri: Uri): Task<Result<Bool, StorageFailure>>

  /** Stores `content` at `uri`, replacing whatever was there - whole or not at all, where the driver can. */
  var fn write(uri: Uri, content: Bytes): Task<Result<Void, StorageFailure>>

  /** The bytes read as UTF-8, which is the ninety-percent call. */
  fn readText(uri: Uri): Task<Result<String, StorageFailure>> {
    const content = read(uri).await()?
    textOf(content).mapError({ problem => StorageFailure.NotText uri.show(), problem.show() })
  }
}

/**
 * `file:` - the local disk, through `std/fs`. A write goes to `<path>.part` first and is then moved over the file with
 * `mv`, so a reader or a crash never sees half an index: `std/fs` has no rename yet, and `mv` within one directory is
 * the system's `rename(2)`.
 */
public shared type FileStorage with Storage {
  fn schemes(): List<String> {
    ["file"]
  }

  fn read(uri: Uri): Task<Result<Bytes, StorageFailure>> {
    const path = pathOf(uri)?
    if !File.exists(path) {
      return Fail StorageFailure.NotFound(uri.show())
    }
    var file = File.open(path).mapError({ refused uri, _ })?
    var bytes: List<UInt8> = []
    var chunks = file.chunks()
    loop {
      match chunks.next().await() {
        Fail(problem) => {
          return Fail refused(uri, problem)
        }
        Ok(None) => {
          break
        }
        Ok(Some(chunk)) => bytes.appendAll chunk
      }
    }
    Ok bytes
  }

  fn exists(uri: Uri): Task<Result<Bool, StorageFailure>> {
    Ok File.exists(pathOf(uri)?)
  }

  var fn write(uri: Uri, content: Bytes): Task<Result<Void, StorageFailure>> {
    const path = pathOf(uri)?
    const directory = Path.from(path).parent().map({ String.from _ }) ?? "."
    File.createDirectory(directory).mapError({ refused uri, _ })?
    const staging = "{path}.part"
    written(staging, content).await().mapError({ refused uri, _ })?
    match ran("mv", ["-f", staging, path]).await() {
      Fail(problem) => Fail StorageFailure.Refused(uri.show(), "`mv` could not be started: {problem}")
      Ok(output) => {
        if output.isSuccess() {
          Ok void
        } else {
          Fail StorageFailure.Refused(uri.show(), "`mv` failed: {output.standardError.trim()}")
        }
      }
    }
  }
}

/** One storage over several drivers, chosen by the reference's scheme: itself a [Storage] (URI.md section 11). */
public shared type Storages with Storage {
  private var drivers: List<Storage>

  /** The storage over `drivers`: the program names every driver it can reach, and nothing registers itself. */
  static fn of(drivers: List<Storage>): Storages {
    Storages drivers
  }

  fn schemes(): List<String> {
    var known: List<String> = []
    for driver in drivers {
      known.appendAll driver.schemes()
    }
    known
  }

  fn read(uri: Uri): Task<Result<Bytes, StorageFailure>> {
    const index = driverOf(uri)?
    drivers[index].read(uri).await()
  }

  fn exists(uri: Uri): Task<Result<Bool, StorageFailure>> {
    const index = driverOf(uri)?
    drivers[index].exists(uri).await()
  }

  var fn write(uri: Uri, content: Bytes): Task<Result<Void, StorageFailure>> {
    const index = driverOf(uri)?
    drivers[index].write(uri, content).await()
  }

  /** Which driver answers to the scheme of `uri`. */
  private fn driverOf(uri: Uri): Result<Int, StorageFailure> {
    const scheme = uri.scheme().toLowerCase()
    for index in 0..drivers.length() {
      if drivers[index].schemes().contains(scheme) {
        return Ok index
      }
    }
    Fail StorageFailure.UnknownScheme(uri.show(), schemes())
  }
}

/** The path a `file:` reference names, as `std/fs` spells it. */
fn pathOf(uri: Uri): Result<String, StorageFailure> {
  match Path.tryFrom(uri) {
    Ok(path) => Ok String.from(path)
    Fail(problem) => Fail StorageFailure.NotAddressable(uri.show(), problem.show())
  }
}

/** `content` written into a new file at `path`, which is closed when this answers - Windows moves no open file. */
fn written(path: String, content: Bytes): Task<Result<Void, IoError>> {
  var file = File.create(path)?
  file.add(content).await()?
  file.end().await()
}

fn refused(uri: Uri, problem: IoError): StorageFailure {
  StorageFailure.Refused uri.show(), problem.show()
}
