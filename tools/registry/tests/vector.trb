/**
 * A key and two tokens made once with Node's `crypto`, so the verification of this registry is checked against an
 * implementation that is not its own: a 2048-bit RSA key (`test-key-1`), and two tokens with the claims of a GitHub
 * Actions job of `acme/http` running `release.yml` for the tag `v1.2.5` in the environment `release`, signed `RS256`
 * by it for the audience `packages.torb.dev`. [token] was issued at [issued] and lives 900 seconds; [lastingToken] has
 * the same claims and expires in 2100, for the tests that run against the database's real clock.
 *
 * The same for Forgejo Actions: a second key (`test-key-2`) and [forgejoToken], the claims of a job of `acme/http`
 * on the Forgejo `git.example.test` running `release.yml` for the tag `v1.2.5` on a push, issued at [issued] by
 * `https://git.example.test/api/actions` for the audience `packages.torb.dev` and expiring in 2100.
 */

use JsonWebKey, JsonWebKeySet from "../src/oidc"

public const modulus = "tA61gFvHLYjPP9Q9rPgfRJV-Wzq2r3RAxsqGgp2R2gT9P8zLH_-N4yZ7VKmCEulRF0K1yAVhvu__DaPBC6dsBwmXl1V95VmvhJGgxHIQefNB-QtQZU0IhheGVSXax2-ZADkQT52Btw3Hj-UFtPosrtR-xfAxW7beqJajQNHiazMS4OZbbyhHX4A19qcNuReYRYnogwss7dMDb3363WRLGbQFYG9LpKjObyBdNQQLRCIo7IQkl8XNxG7Re6tKUjpcB02Iy3JefwefyGFzpgT0HKScs9sv550xuYtNGkGIVQFwa_FDh4tTVwvVH3likFyRtKr7G0uf7UMVmvNUmuYj4Q"

