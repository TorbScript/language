public const lastingToken = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5LTEifQ..DMtvAK3D1EQU4VmA5dtRpkZFcVSmDvSx4588Vd5JqokJ9y8aoQ-pvtJ52a5EvfVVqgKDccvHgFLdVU4HwoSOPY1BM_t8LFv7b4gtDrm8OOyCUnBMalvBb4RW51z2Cgpiyoln7hH16ass_os0eUE207xXTnJUZ2hvXOpstAdX9-zDHtTS4Ni8ATSAtFkQix6RzayA0KQfa6c62S-ncAdEoXs1-r1Uh2Qhfda-ESSeDQHuPZjIuPObXBvNsPP8el41yokR7dwa5hsgv0Ik3GA99sQqsFD0FgDawJoAxAC-4L-LWQfTjRnPxHROYE3PVU5UhA4Ac0RbQrRhIMSxrZaSbw"

/** The second [token] was issued at. */
public const issued = 1790000000

/** The audience both tokens name. */
public const audience = "packages.torb.dev"

/** The key set of the test key. A function and not a constant: a constant of a record from another module does not build natively yet. */
public fn keySet(): JsonWebKeySet {
  JsonWebKeySet([JsonWebKey("RSA", kid: "test-key-1", alg: "RS256", n: modulus, e: "AQAB")])
}

/** The key set as an issuer's `/.well-known/jwks` answers it. */
public fn keySetText(): String {
  "\{\"keys\":[\{\"kty\":\"RSA\",\"kid\":\"test-key-1\",\"alg\":\"RS256\",\"use\":\"sig\",\"n\":\"{modulus}\",\"e\":\"AQAB\"\}]\}"
}

/** The modulus of the Forgejo test key, `test-key-2`. */
public const forgejoModulus = "tEHxig4MB5xe13I80rvub4i5KCAemm0sPiFYuf4GfGVy_Hm487accByb2T9wA8d2GP_LTf4_Ge0bmMydmx9dlttfFrhI_plKqwokLq582wijZUs_xlGIRE8DGP3W4e65tzRmhGyTrLU6RfmYaQO2WHgp1cPVckfEjH-1jZyMH8ZLITxW_7f5laDJ0omn9WMrgntwkcbxM0zaXXgv4Z58gwgjn1jQVdTiLlBpDlgmPDOkbJtrbP3xMWAcic6Lcm035faitiGHGZyfySIGHhp_Xt0J6WOAecAWb14eSfjMrIUujqi3Uf3VYain3iiISNB9VQxfQoM1RXgb5zpzEvq_cQ"

/** A Forgejo Actions token of `acme/http`'s `release.yml` for `refs/tags/v1.2.5`, signed by `test-key-2`. */
public const forgejoToken = "eyJhbGciOiJSUzI1NiIsImtpZCI6InRlc3Qta2V5LTIiLCJ0eXAiOiJKV1QifQ..d_qCqGLbrPw3aBflVpUBk4gAugUYeoiNWG8u8LN8g8K1qJ_rFvCXCylAjEeDpFANnrgbC7g7WrXj1lm3Kwdht24Fjtq6v72F29uEll3MjJ5S_A6Yy75OJlcRSfZGPDGKrb1QQ2a1fNe20iDrKeIPWESuWYJwDpcyydPdflDcY6O-itwlrpQx9DR4eHJzrXoCDniqgFt99oIb6cb4JvdJ094jZOqrsouUDGAcH8qouj5JCr4pl866ioQZ5cShvfYjWCv7HeSn8DRx8JTW9AXXedLWOiw3wYLakRKE3ekI3XsCSNMYodJNekxPWdwUP96YEu5uCPCXPQdFVDoOSis8mQ"

/** Who issued [forgejoToken]: the Forgejo at `git.example.test`. */
public const forgejoIssuer = "https://git.example.test/api/actions"

/** The key set of the Forgejo test key. */
public fn forgejoKeySet(): JsonWebKeySet {
  JsonWebKeySet([JsonWebKey("RSA", kid: "test-key-2", alg: "RS256", n: forgejoModulus, e: "AQAB")])
}

/** The Forgejo key set as its `/api/actions/.well-known/keys` answers it. */
public fn forgejoKeySetText(): String {
  "\{\"keys\":[\{\"alg\":\"RS256\",\"e\":\"AQAB\",\"kid\":\"test-key-2\",\"kty\":\"RSA\",\"n\":\"{forgejoModulus}\",\"use\":\"sig\"\}]\}"
}

/** The discovery document of the Forgejo, its key set at `keys`. */
public fn forgejoDiscoveryText(keys: String): String {
  "\{\"issuer\":\"{forgejoIssuer}\",\"jwks_uri\":\"{keys}\",\"id_token_signing_alg_values_supported\":[\"RS256\"]\}"
}
