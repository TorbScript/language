/**
 * Trusted publishing without the network: a token of GitHub Actions and one of Forgejo Actions verified against their
 * key sets, and matched against a package's trusted publishers, with the keys and the tokens `./vector` holds, which
 * Node made.
 */

use test, group from "std/test"
use base64Decoded, base64UrlEncoded from "../src/base64"
use RsaPublicKey, verifiesSha256 from "../src/rsa"
use JsonWebKey, JsonWebKeySet, TrustedPublisher, TrustedIssuer, IdentityClaims, githubIssuer, issuerOf, verifiedClaims, publisherMatches, publisherName, refMatches from "../src/oidc"
use forgejoIssuersOf from "../src/config"
use modulus, token, issued, audience, keySet, forgejoToken, forgejoIssuer, forgejoKeySet from "./vector"

/** The token with one segment replaced. */
fn withSegment(index: Int, replacement: String): String {
  var parts = token.split "."
  parts[index] = replacement
  parts.joined separator: "."
}

/** The bytes of a text. */
fn bytesOf(text: String): List<UInt8> {
  text.bytes().toList()
}

group "Base64" {
  test "reads both alphabets, with and without padding" {
    assert(base64Decoded("aGVsbG8=") == Ok(bytesOf("hello")))
    assert(base64Decoded("aGVsbG8") == Ok(bytesOf("hello")))
    assert(base64Decoded("-_8") == Ok([UInt8.tryFrom(251).ok() ?? 0, UInt8.tryFrom(255).ok() ?? 0]))
    assert(base64Decoded("+/8=") == base64Decoded("-_8"))
  }

  test "refuses what no encoder writes" {
    assert base64Decoded("a").isError()
    assert base64Decoded("aGV*").isError()
    assert base64Decoded("aG=Vs").isError()
  }

  test "writes the URL-safe alphabet without padding, and reads it back" {
    assert(base64UrlEncoded(bytesOf("hello")) == "aGVsbG8")
    const bytes = bytesOf "any carnal pleas?>"
    assert(base64Decoded(base64UrlEncoded(bytes)) == Ok(bytes))
  }
}

group "RSASSA-PKCS1-v1_5 with SHA-256" {
  const parts = token.split "."
  const key = RsaPublicKey(base64Decoded(modulus).ok() ?? [], base64Decoded("AQAB").ok() ?? [])
  const signature = base64Decoded(parts[2]).ok() ?? []
  const signed = bytesOf "{parts[0]}.{parts[1]}"

  test "a signature Node made verifies" {
    assert verifiesSha256(key, signed, signature)
  }

  test "one changed byte of the message does not" {
    assert(!verifiesSha256(key, bytesOf("{parts[0]}.{parts[1]}x"), signature))
  }

  test "one changed byte of the signature does not" {
    var changed = signature
    changed[100] = UInt8.tryFrom((Int.from(changed[100]) + 1) & 255).ok() ?? 0
    assert(!verifiesSha256(key, signed, changed))
  }

  test "a signature of the wrong length, or a short modulus, is refused" {
    assert(!verifiesSha256(key, signed, signature[0..255].toList()))
    const short = RsaPublicKey key.modulus[0..128].toList(), key.exponent
    assert(!verifiesSha256(short, signed, signature[0..128].toList()))
  }
}

group "a GitHub Actions token" {
  test "verifies, and its claims are read" {
    match verifiedClaims(token, keySet(), githubIssuer, audience, issued + 10) {
      Ok(claims) => {
        assert(claims.repository == "acme/http")
        assert(claims.jobWorkflowRef == "acme/http/.github/workflows/release.yml@refs/tags/v1.2.5")
        assert(claims.environment == "release")
        assert(claims.ref == "refs/tags/v1.2.5")
      }
      Fail(problem) => assert(problem == "")
    }
  }

  test "is refused once it expired, give or take a minute" {
    assert verifiedClaims(token, keySet(), githubIssuer, audience, issued + 900 + 60).isOk()
    match verifiedClaims(token, keySet(), githubIssuer, audience, issued + 900 + 61) {
      Ok(_) => assert false
      Fail(problem) => assert problem.contains("expired")
    }
  }

  test "is refused before it is valid" {
    assert verifiedClaims(token, keySet(), githubIssuer, audience, issued - 3600).isError()
  }

  test "is refused for another audience" {
    match verifiedClaims(token, keySet(), githubIssuer, "packages.example.test", issued) {
      Ok(_) => assert false
      Fail(problem) => assert problem.contains("packages.example.test")
    }
  }

  test "is refused with claims it was not signed with" {
    const forged = base64UrlEncoded bytesOf("\{\"iss\":\"https://token.actions.githubusercontent.com\",\"aud\":\"packages.torb.dev\",\"exp\":1790000900,\"repository\":\"evil/http\"\}")
    match verifiedClaims(withSegment(1, forged), keySet(), githubIssuer, audience, issued) {
      Ok(_) => assert false
      Fail(problem) => assert problem.contains("does not verify")
    }
  }

  test "is refused without a key of its kid, and with another algorithm" {
    const otherKeys = JsonWebKeySet([JsonWebKey("RSA", kid: "another", n: modulus, e: "AQAB")])
    assert verifiedClaims(token, otherKeys, githubIssuer, audience, issued).isError()
    const none = base64UrlEncoded bytesOf("\{\"alg\":\"none\",\"kid\":\"test-key-1\"\}")
    match verifiedClaims(withSegment(0, none), keySet(), githubIssuer, audience, issued) {
      Ok(_) => assert false
      Fail(problem) => assert problem.contains("`none`")
    }
  }

  test "is refused when it is not three segments" {
    assert verifiedClaims("abc.def", keySet(), githubIssuer, audience, issued).isError()
  }
}

group "matching a trusted publisher" {
  const github = TrustedIssuer.github "unused"
  const claims = IdentityClaims(
    "https://token.actions.githubusercontent.com",
    audience,
    issued + 900,
    repository: "acme/http",
    jobWorkflowRef: "acme/http/.github/workflows/release.yml@refs/tags/v1.2.5",
    environment: "release",
  )

  test "the repository and the workflow file" {
    assert publisherMatches(claims, TrustedPublisher("acme/http", "release.yml"), github)
    assert publisherMatches(claims, TrustedPublisher("Acme/HTTP", "release.yml"), github)
  }

  test "another workflow of the same repository is not it" {
    assert(!publisherMatches(claims, TrustedPublisher("acme/http", "ci.yml"), github))
    assert(!publisherMatches(claims, TrustedPublisher("acme/http", "release"), github))
  }

  test "another repository is not it" {
    assert(!publisherMatches(claims, TrustedPublisher("acme/http2", "release.yml"), github))
  }

  test "an environment, where one is named, has to be the job's" {
    assert publisherMatches(claims, TrustedPublisher("acme/http", "release.yml", "release"), github)
    assert(!publisherMatches(claims, TrustedPublisher("acme/http", "release.yml", "staging"), github))
  }

  test "a repository of a Forgejo is never a publisher for a GitHub token" {
    assert(!publisherMatches(claims, TrustedPublisher("git.example.test/acme/http", "release.yml"), github))
  }
}

group "a Forgejo Actions token" {
  test "verifies against the Forgejo's key set, and its claims are read" {
    match verifiedClaims(forgejoToken, forgejoKeySet(), forgejoIssuer, audience, issued + 10) {
      Ok(claims) => {
        assert(claims.repository == "acme/http")
        assert(claims.workflow == "release.yml")
        assert(claims.workflowRef == "acme/http/.forgejo/workflows/release.yml@refs/tags/v1.2.5")
        assert(claims.ref == "refs/tags/v1.2.5")
        assert(claims.eventName == "push")
      }
      Fail(problem) => assert(problem == "")
    }
  }

  test "names its issuer before it is verified" {
    assert(issuerOf(forgejoToken) == Ok(forgejoIssuer))
    assert(issuerOf(token) == Ok(githubIssuer))
    assert issuerOf("abc.def").isError()
  }

  test "is refused as a token of another issuer, and with GitHub's key set" {
    match verifiedClaims(forgejoToken, forgejoKeySet(), githubIssuer, audience, issued + 10) {
      Ok(_) => assert false
      Fail(problem) => assert problem.contains("git.example.test")
    }
    assert verifiedClaims(forgejoToken, keySet(), forgejoIssuer, audience, issued + 10).isError()
  }
}

group "a Forgejo the registry trusts" {
  test "is named by its issuer https://<host>/api/actions" {
    match TrustedIssuer.forgejo("https://git.torb.dev/api/actions") {
      Some(issuer) => {
        assert(issuer.host == "git.torb.dev")
        assert(!issuer.isGithub())
        assert(issuer.discovery() == "https://git.torb.dev/api/actions/.well-known/openid-configuration")
      }
      None => assert false
    }
  }

  test "an issuer of another shape is none" {
    assert TrustedIssuer.forgejo("http://git.torb.dev/api/actions").isNone()
    assert TrustedIssuer.forgejo("https://git.torb.dev/api").isNone()
    assert TrustedIssuer.forgejo("https://git.torb.dev/sub/api/actions").isNone()
  }

  test "REGISTRY_FORGEJO_ISSUERS: separated by spaces or commas, and a wrong one left out" {
    const issuers = forgejoIssuersOf "https://git.torb.dev/api/actions, https://codeberg.org/api/actions git.example.test"
    assert(issuers.map({ _.host }).toList() == ["git.torb.dev", "codeberg.org"])
    assert forgejoIssuersOf("").isEmpty()
  }
}

group "matching a trusted publisher of a Forgejo" {
  const forgejo = TrustedIssuer.forgejo(forgejoIssuer) ?? TrustedIssuer.github("unused")
  const claims = IdentityClaims(
    forgejoIssuer,
    audience,
    4102444800,
    repository: "acme/http",
    ref: "refs/tags/v1.2.5",
    workflow: "release.yml",
    workflowRef: "acme/http/.forgejo/workflows/release.yml@refs/tags/v1.2.5",
  )

  test "the host, the repository and the workflow file" {
    assert publisherMatches(claims, TrustedPublisher("git.example.test/acme/http", "release.yml"), forgejo)
    assert publisherMatches(claims, TrustedPublisher("Git.Example.Test/Acme/HTTP", "release.yml"), forgejo)
  }

  test "the same repository on GitHub or on another Forgejo is not it" {
    assert(!publisherMatches(claims, TrustedPublisher("acme/http", "release.yml"), forgejo))
    assert(!publisherMatches(claims, TrustedPublisher("codeberg.org/acme/http", "release.yml"), forgejo))
  }

  test "another workflow is not it" {
    assert(!publisherMatches(claims, TrustedPublisher("git.example.test/acme/http", "ci.yml"), forgejo))
  }

  test "a publisher that names an environment never matches: Forgejo's tokens name none" {
    assert(!publisherMatches(claims, TrustedPublisher("git.example.test/acme/http", "release.yml", "release"), forgejo))
  }

  test "a ref, where one is named, exactly or by its prefix" {
    assert(publisherMatches(
      claims,
      TrustedPublisher("git.example.test/acme/http", "release.yml", ref: "refs/tags/v*"),
      forgejo,
    ))
    assert(publisherMatches(
      claims,
      TrustedPublisher("git.example.test/acme/http", "release.yml", ref: "refs/tags/v1.2.5"),
      forgejo,
    ))
    assert(
      !publisherMatches(
        claims,
        TrustedPublisher("git.example.test/acme/http", "release.yml", ref: "refs/heads/main"),
        forgejo,
      ),
    )
  }

  test "a GitHub token is never a publisher of a Forgejo" {
    const github = TrustedIssuer.github "unused"
    assert(!publisherMatches(claims, TrustedPublisher("git.example.test/acme/http", "release.yml"), github))
  }

  test "the publisher's name says which forge" {
    assert(
      publisherName(claims, forgejo)
        == "forgejo:git.example.test/acme/http/.forgejo/workflows/release.yml@refs/tags/v1.2.5",
    )
  }

  test "refMatches: any ref where none is named, a prefix where it ends in *" {
    assert refMatches("refs/heads/main", "")
    assert refMatches("refs/tags/v2.0.0", "refs/tags/*")
    assert(!refMatches("refs/tags/v2.0.0", "refs/tags/v1*"))
  }
}
