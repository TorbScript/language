// The write service of packages.torb.dev (docs/design/RELEASE.md sections 7.2, 7.4 and 7.11): publish, yank, owners,
// tokens and trusted publishing over HTTP, SQLite for its accounts, and the static index and archives written through
// a storage driver. Nobody's workspace member: checked and tested on its own (`torb check tools/registry`).
//
// It reads a published archive with the toolchain's own package code - the tree hash, the limits, the lock, the index
// format and the refusals of `torb publish --dry-run` - so the compiler is a `path:` dependency and never a copy.
name = "torbscript/registry"
version = "0.1.0"
description = "The write service of packages.torb.dev: publish, yank, owners, tokens and trusted publishing"
license = "MIT"

source "torbscript/compiler", path: "../../compiler"

dependencies {
  runtime "torbscript/compiler"
}
